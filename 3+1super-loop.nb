In[183]:=",ExpressionUUID->"ce66a23a-0b24-4340-ae23-d0eea1ba30e3"]
}, Open  ]],

Cell[TextData[{
 "S-4, the round trip: a symbol, printed again, gives exactly the box it was \
made from (",
 StyleBox["ToBoxes[symbol, StandardForm]",
  FontFamily->"Source Code Pro"],
 "). This is the other half of the symbolization: input box to symbol (S-2) \
and symbol to output box (S-4)."
}], "Text",ExpressionUUID->"4cafb9ad-4d13-42d8-b2d8-4727e19370f1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"roundTrip", " ", "=", " ", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{"r", ",", " ", 
       RowBox[{"Replace", "[", 
        RowBox[{
         RowBox[{"r", "[", "\"\<symbol\>\"", "]"}], ",", " ", 
         RowBox[{
          RowBox[{"HoldComplete", "[", "s_", "]"}], " ", ":>", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"ToBoxes", "[", 
             RowBox[{
              RowBox[{"Unevaluated", "[", "s", "]"}], ",", " ", 
              "StandardForm"}], "]"}], " ", "===", " ", 
            RowBox[{"r", "[", "\"\<boxes\>\"", "]"}]}], ")"}]}]}], "]"}]}], 
      "]"}], ",", " ", "symbolTable"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-4\>\"", ",", 
    " ", "\"\<every symbol prints as the box it was made from\>\"", ",", " ", 
    
    RowBox[{"And", " ", "@@", " ", "roundTrip"}], ",", " ", 
    RowBox[{"Count", "[", 
     RowBox[{"roundTrip", ",", " ", "True"}], "]"}]}], "]"}], ";"}]}], "Input",\

 CellLabel->
  "In[186]:=",ExpressionUUID->"2bbbd30a-a581-4ff5-9ce0-8c9a097ea072"],

Cell[BoxData[
 StyleBox[
  TemplateBox[{
    StyleBox["\"PASS  \"", Bold, 
     RGBColor[0, 
