Cell["\<\
Twelve symbols chosen from the nine groups, as the notebook now prints them, \
with their internal names:\
\>", "Text",ExpressionUUID->"984a365e-75eb-4018-8c79-8b90987ef15e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"RawBoxes", "[", 
           RowBox[{"#", "[", "\"\<boxes\>\"", "]"}], "]"}], ",", " ", 
          RowBox[{"#", "[", "\"\<kind\>\"", "]"}], ",", " ", 
          RowBox[{"Replace", "[", 
           RowBox[{
            RowBox[{"#", "[", "\"\<symbol\>\"", "]"}], ",", " ", 
            RowBox[{
             RowBox[{"HoldComplete", "[", "s_", "]"}], " ", ":>", " ", 
             RowBox[{"SymbolName", "[", 
              RowBox[{"Unevaluated", "[", "s", "]"}], "]"}]}]}], "]"}]}], 
         "}"}], " ", "&"}], ",", "\n", "    ", 
       RowBox[{"symbolTable", "[", 
        RowBox[{"[", 
         RowBox[{"Round", "[", 
          RowBox[{"Range", "[", 
           RowBox[{"1", ",", " ", 
            RowBox[{"Length", "[", "symbolTable", "]"}], ",", " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Length", "[", "symbolTable", "]"}], " ", "-", " ", 
               "1"}], ")"}], "/", "11"}]}], "]"}], "]"}], "]"}], "]"}]}], 
      "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"#", ",", " ", "Bold"}], "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<symbol\>\"", ",", " ", "\"\<kind\>\"", ",", 
        " ", "\"\<internal name\>\""}], "}"}]}]}], "]"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}]], "Input",
