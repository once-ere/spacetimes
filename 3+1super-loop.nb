Cell[CellGroupData[{

Cell["GS-14: the super-loop form of the field equations", "Subsection",ExpressionUUID->"4f912548-93f3-4737-bd41-1b0c4c7cf4b4"],

Cell[TextData[{
 "The Weyl isodoublet of a spinor charge ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     StyleBox["y",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     SubscriptBox[
      StyleBox["e",
       FontWeight->"Bold",
       FontSlant->"Plain"], "4"]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"37e02b31-f64e-4d75-956b-ce580a307afa"]], "InlineFormula",
  ExpressionUUID->"f1d128e0-505d-4129-b4a0-2bac84f6b58c"],
 " (with a bi-quaternion ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    StyleBox["y",
     FontWeight->"Bold",
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "59262cbb-4066-43ae-b688-089c5aa880de"]], "InlineFormula",ExpressionUUID->
  "06cc5e51-8304-4647-b6f6-1f6ca60f3be4"],
 ") is ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubsuperscriptBox["\[Psi]", "LL", "\[Prime]"], 
     RowBox[{"(", 
      StyleBox["y",
       FontWeight->"Bold",
       FontSlant->"Plain"], ")"}], "\[LongEqual]", 
     SubsuperscriptBox[
      StyleBox["E",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "LL", 
      RowBox[{"-", "1"}]], 
     SubscriptBox[
      StyleBox["M", "TI"], "LL"], 
     SuperscriptBox[
      RowBox[{"(", 
       StyleBox["y",
        FontWeight->"Bold",
        FontSlant->"Plain"], ")"}], 
      StyleBox["T", "TI"]]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"c7805195-7607-48d1-a8fb-2d19267b964c"]], "InlineFormula",
  ExpressionUUID->"c5de14f9-333d-44a1-a04e-da56be9c1fdf"],
 ", and the Dirac isodoublet ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox["\[CapitalPsi]", "LL"], 
     RowBox[{"[", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["b",
         FontWeight->"Bold",
         FontSlant->"Plain"], "LL", "-"], ",", 
       SubsuperscriptBox[
        StyleBox["b",
         FontWeight->"Bold",
         FontSlant->"Plain"], "LL", "+"]}], "]"}]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"5a140d1d-c68a-4e66-aa11-7fcb42a70622"]], 
  "InlineFormula",ExpressionUUID->"c8e6836e-7c40-410b-b311-98be83380e82"],
 " of the two spinor charges ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubsuperscriptBox[
      StyleBox["b",
       FontWeight->"Bold",
       FontSlant->"Plain"], "LL", "\[PlusMinus]"], 
     SubscriptBox[
      StyleBox["e",
       FontWeight->"Bold",
       FontSlant->"Plain"], "4"]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"5a46c542-acc7-485a-8bcd-4f99de7c7b81"]], "InlineFormula",
  ExpressionUUID->"759ac143-802c-453f-81ad-9031da6a9ee1"],
 " has the upper block ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubsuperscriptBox["\[Psi]", "LL", "\[Prime]"], "(", 
     SubsuperscriptBox[
      StyleBox["b",
       FontWeight->"Bold",
       FontSlant->"Plain"], "LL", "-"], ")"}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"bf7f8026-618a-4515-95f7-c3e149aa2a52"]], 
  "InlineFormula",ExpressionUUID->"ee93c385-ab7e-425d-b9f9-803336ba2e52"],
 " (components 1 to 4) and the lower block ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubsuperscriptBox["\[Psi]", "LL", "\[Prime]"], "(", 
     SubsuperscriptBox[
      StyleBox["b",
       FontWeight->"Bold",
       FontSlant->"Plain"], "LL", "+"], ")"}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"86686150-2618-4e24-87ef-d3bb1a441c89"]], 
  "InlineFormula",ExpressionUUID->"f924306e-2290-418e-8a26-7ef4dceddd35"],
 " (components 5 to 8). The check shows, with random bi-quaternions: (a) a \
frame matrix acting on a Weyl isodoublet is a right multiplication of the \
spinor charge, ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["M", "TI"], "LL"], 
     RowBox[{"(", 
      StyleBox["x",
       FontWeight->"Bold",
       FontSlant->"Plain"], ")"}], 
     SubsuperscriptBox["\[Psi]", "LL", "\[Prime]"], 
     RowBox[{"(", 
      StyleBox["y",
       FontWeight->"Bold",
       FontSlant->"Plain"], ")"}], "\[LongEqual]", 
     SubsuperscriptBox["\[Psi]", "LL", "\[Prime]"], 
     RowBox[{"(", 
      RowBox[{
       StyleBox["y",
        FontWeight->"Bold",
        FontSlant->"Plain"], 
       OverscriptBox[
        StyleBox["x",
         FontWeight->"Bold",
         FontSlant->"Plain"], "_"]}], ")"}]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"ec64fa4a-4df9-4953-9333-3b6121e4d0d1"]], 
  "InlineFormula",ExpressionUUID->"1b9a199d-98ae-4741-9999-09f16ba29c94"],
 ", in agreement with the Cayley-Dickson product ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       StyleBox["a",
        FontWeight->"Bold",
        FontSlant->"Plain"], "+", 
       StyleBox["b",
        FontWeight->"Bold",
        FontSlant->"Plain"], 
       SubscriptBox[
        StyleBox["e",
         FontWeight->"Bold",
         FontSlant->"Plain"], "4"]}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       StyleBox["c",
        FontWeight->"Bold",
        FontSlant->"Plain"], "+", 
       StyleBox["d",
        FontWeight->"Bold",
        FontSlant->"Plain"], 
       SubscriptBox[
        StyleBox["e",
         FontWeight->"Bold",
         FontSlant->"Plain"], "4"]}], ")"}], "\[LongEqual]", 
     RowBox[{"(", 
      RowBox[{
       StyleBox["a",
        FontWeight->"Bold",
        FontSlant->"Plain"], 
       StyleBox["c",
        FontWeight->"Bold",
        FontSlant->"Plain"], "-", 
       OverscriptBox[
        StyleBox["d",
         FontWeight->"Bold",
         FontSlant->"Plain"], "_"], 
       StyleBox["b",
        FontWeight->"Bold",
        FontSlant->"Plain"]}], ")"}], "+", 
     RowBox[{"(", 
      RowBox[{
       StyleBox["d",
        FontWeight->"Bold",
        FontSlant->"Plain"], 
       StyleBox["a",
        FontWeight->"Bold",
        FontSlant->"Plain"], "+", 
       StyleBox["b",
        FontWeight->"Bold",
        FontSlant->"Plain"], 
       OverscriptBox[
        StyleBox["c",
         FontWeight->"Bold",
         FontSlant->"Plain"], "_"]}], ")"}], 
     SubscriptBox[
      StyleBox["e",
       FontWeight->"Bold",
       FontSlant->"Plain"], "4"]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"6ddcfee1-1486-4b36-9004-6f77c3952a25"]], "InlineFormula",
  ExpressionUUID->"6bb10e61-2433-4cff-ab7c-8da3d9708c0a"],
 ", which gives ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       StyleBox["y",
        FontWeight->"Bold",
        FontSlant->"Plain"], 
       SubscriptBox[
        StyleBox["e",
         FontWeight->"Bold",
         FontSlant->"Plain"], "4"]}], ")"}], 
     StyleBox["x",
      FontWeight->"Bold",
      FontSlant->"Plain"], "\[LongEqual]", 
     RowBox[{"(", 
      RowBox[{
       StyleBox["y",
        FontWeight->"Bold",
        FontSlant->"Plain"], 
       OverscriptBox[
        StyleBox["x",
         FontWeight->"Bold",
         FontSlant->"Plain"], "_"]}], ")"}], 
     SubscriptBox[
      StyleBox["e",
       FontWeight->"Bold",
       FontSlant->"Plain"], "4"]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"b7cb6f64-581f-48a7-9fc4-5a4bdebc34db"]], "InlineFormula",
  ExpressionUUID->"f414bcb5-e4f4-49ca-bde6-539d41587038"],
 "; (b) the Dirac matrices exchange the two spinor charges and multiply them \
by the frame, ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubsuperscriptBox["\[Gamma]", "LL", 
      StyleBox["p", "TI"]], 
     RowBox[{"[", 
      StyleBox["f",
       FontWeight->"Bold",
       FontSlant->"Plain"], "]"}], 
     SubscriptBox["\[CapitalPsi]", "LL"], 
     RowBox[{"[", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["b",
         FontWeight->"Bold",
         FontSlant->"Plain"], "LL", "-"], ",", 
       SubsuperscriptBox[
        StyleBox["b",
         FontWeight->"Bold",
         FontSlant->"Plain"], "LL", "+"]}], "]"}], "\[LongEqual]", 
     SubscriptBox["\[CapitalPsi]", "LL"], 
     RowBox[{"[", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["b",
         FontWeight->"Bold",
         FontSlant->"Plain"], "LL", "+"], 
       SubscriptBox[
        OverscriptBox[
         StyleBox["f",
          FontWeight->"Bold",
          FontSlant->"Plain"], "_"], 
        StyleBox["p", "TI"]], ",", 
       SubsuperscriptBox[
        StyleBox["b",
         FontWeight->"Bold",
         FontSlant->"Plain"], "LL", "-"], 
       SubscriptBox[
        StyleBox["f",
         FontWeight->"Bold",
         FontSlant->"Plain"], 
        StyleBox["p", "TI"]]}], "]"}]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"c56151cf-85f8-4c44-bf64-3f66f0725865"]], "InlineFormula",
  ExpressionUUID->"5980f881-2a89-4280-9a75-c08b33e8fa28"],
 "; (c) the gauge group acts by the automorphisms of the super-loop: ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubscriptBox[
     StyleBox["\[ScriptCapitalU]",
      FontSlant->"Plain"], "LL"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"d94e3e22-0537-40bd-9f4c-9f180de1052d"]], "InlineFormula",
  ExpressionUUID->"c6c6d6c2-5e26-4392-8797-fc5f6eb4a6fd"],
 " with ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["U",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "LL"], "\[LongEqual]", 
     SubscriptBox[
      StyleBox["M", "TI"], "LL"], 
     RowBox[{"(", 
      StyleBox["v",
       FontWeight->"Bold",
       FontSlant->"Plain"], ")"}]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"f679e8e1-da24-4219-898a-8da2f3381127"]], "InlineFormula",
  ExpressionUUID->"e478ecdd-a63e-4779-9a0d-faa7b2302545"],
 " replaces ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], "LL", "+"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"57a2cb10-5c59-4aba-88ff-b2c2ced7d42b"]], "InlineFormula",
  ExpressionUUID->"f79ea1ec-ddaa-4d77-8bd8-6bafe49cdd7f"],
 " by ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{
       StyleBox["i", "TI"], 
       SubsuperscriptBox["\[Theta]", "LL", "F"]}]], 
     StyleBox["v",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     SubsuperscriptBox[
      StyleBox["b",
       FontWeight->"Bold",
       FontSlant->"Plain"], "LL", "+"], 
     OverscriptBox[
      StyleBox["g",
       FontWeight->"Bold",
       FontSlant->"Plain"], "_"]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"43543163-7f32-4dea-9411-d7f001aa5188"]], "InlineFormula",
  ExpressionUUID->"8837a13f-5dca-455c-9d17-519fc45434be"],
 " and ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], "LL", "-"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"73ce8a36-421c-4635-81e7-1e6741929e57"]], "InlineFormula",
  ExpressionUUID->"a8cea8f7-2b1b-45b8-8e53-52bd0c0ed1f0"],
 " by ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{
       StyleBox["i", "TI"], 
       SubsuperscriptBox["\[Theta]", "LL", "F"]}]], 
     StyleBox["v",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     SubsuperscriptBox[
      StyleBox["b",
       FontWeight->"Bold",
       FontSlant->"Plain"], "LL", "-"], 
     SuperscriptBox[
      StyleBox["g",
       FontWeight->"Bold",
       FontSlant->"Plain"], "\[Dagger]"]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"bfa85dfa-6f53-4d50-b6be-484e83fdc03e"]], 
  "InlineFormula",ExpressionUUID->"a236ff7f-446e-453c-b258-b0a906f28631"],
 " (and ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     OverscriptBox[
      StyleBox["g",
       FontWeight->"Bold",
       FontSlant->"Plain"], "~"], "\[LongEqual]", 
     SuperscriptBox[
      StyleBox["g",
       FontWeight->"Bold",
       FontSlant->"Plain"], "*"]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"3499a9d8-a58c-44d1-a839-82fec788f4f9"]], "InlineFormula",
  ExpressionUUID->"0a06c1ef-4d94-42de-aa15-84bb127948d0"],
 "); (d) the covariant derivative acts through the derivations of ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubscriptBox[
     StyleBox["\[DoubleStruckCapitalB]",
      FontSlant->"Plain"], "LL"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"fdd281bd-d5f9-4ceb-8efe-8cbd5f9fd167"]], "InlineFormula",
  ExpressionUUID->"72b23455-d31a-4ca8-a62c-c4fe8f3f967c"],
 ": on ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], "LL", "+"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"388c3d07-2e86-4840-a338-33c013dc98a9"]], "InlineFormula",
  ExpressionUUID->"66d83231-128f-4b47-ae82-9a5fd72e275f"],
 " it is ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox["\[PartialD]", 
      StyleBox["p", "TI"]], 
     SubsuperscriptBox[
      StyleBox["b",
       FontWeight->"Bold",
       FontSlant->"Plain"], "LL", "+"], "-", 
     SubsuperscriptBox[
      StyleBox["b",
       FontWeight->"Bold",
       FontSlant->"Plain"], "LL", "+"], 
     SubsuperscriptBox[
      StyleBox["u",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      RowBox[{"LL", ",", 
       StyleBox["p", "TI"]}], "\[Omega]"], "+", 
     SubsuperscriptBox[
      StyleBox["g", "TI"], "LL", "v"], 
     SubsuperscriptBox[
      StyleBox["t",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      RowBox[{"LL", ",", 
       StyleBox["p", "TI"]}], "A"], 
     SubsuperscriptBox[
      StyleBox["b",
       FontWeight->"Bold",
       FontSlant->"Plain"], "LL", "+"], "-", 
     StyleBox["i", "TI"], 
     SubsuperscriptBox[
      StyleBox["g", "TI"], "LL", "F"], 
     SubsuperscriptBox[
      StyleBox["A", "TI"], 
      RowBox[{"LL", ",", 
       StyleBox["p", "TI"]}], "F"], 
     SubsuperscriptBox[
      StyleBox["b",
       FontWeight->"Bold",
       FontSlant->"Plain"], "LL", "+"]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"2d34fcd8-2fac-496f-aefa-22d9fa1caf7b"]], "InlineFormula",
  ExpressionUUID->"51c1b0e9-2708-439e-96ae-7028de2b13ce"],
 " with ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubsuperscriptBox[
      StyleBox["t",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      RowBox[{"LL", ",", 
       StyleBox["p", "TI"]}], "A"], "\[LongEqual]", 
     UnderscriptBox["\[Sum]", "\[Iota]",
      LimitsPositioning->True], 
     SubsuperscriptBox[
      StyleBox["A", "TI"], 
      RowBox[{"LL", ",", 
       StyleBox["p", "TI"]}], "\[Iota]"], 
     SubscriptBox[
      StyleBox["e",
       FontWeight->"Bold",
       FontSlant->"Plain"], "\[Iota]"], "/", "2"}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"6dcc7d38-8f09-427e-8a72-0ced34cfd867"]], 
  "InlineFormula",ExpressionUUID->"60a83e6a-bda5-42de-b9a4-eaf055ab5253"],
 ", and on ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], "LL", "-"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"b0f55442-1d6c-41e4-bc5b-68d77697ec25"]], "InlineFormula",
  ExpressionUUID->"4165141f-d2c1-411a-8ed5-b19dc7a6b126"],
 " the same with ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["u",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     RowBox[{"LL", ",", 
      StyleBox["p", "TI"]}], 
     RowBox[{"\[Omega]", "*"}]], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"19f09ce4-7b36-4528-8b06-ad13606ae5a7"]], "InlineFormula",
  ExpressionUUID->"7fc97959-c214-4843-80d4-3fbdcfe6c4e4"],
 " in place of ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["u",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     RowBox[{"LL", ",", 
      StyleBox["p", "TI"]}], "\[Omega]"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"e1ca809c-7fe0-4fb7-8ece-5f60d042d4e5"]], "InlineFormula",
  ExpressionUUID->"8b3f2c2e-d784-4995-8ddc-847036c176ea"],
 "; (e) the Dirac operator is the right multiplication by the frame, ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     UnderscriptBox["\[Sum]", 
      StyleBox["p", "TI"],
      LimitsPositioning->True], 
     SubsuperscriptBox["\[Gamma]", "LL", 
      StyleBox["p", "TI"]], 
     SubsuperscriptBox["\[Del]", 
      StyleBox["p", "TI"], "LL"], 
     SubscriptBox["\[CapitalPsi]", "LL"], "\[LongEqual]", 
     SubscriptBox["\[CapitalPsi]", "LL"], 
     RowBox[{"[", 
      RowBox[{
       UnderscriptBox["\[Sum]", 
        StyleBox["p", "TI"],
        LimitsPositioning->True], 
       RowBox[{"(", 
        RowBox[{
         SubsuperscriptBox["\[Del]", 
          StyleBox["p", "TI"], "LL"], 
         SubsuperscriptBox[
          StyleBox["b",
           FontWeight->"Bold",
           FontSlant->"Plain"], "LL", "+"]}], ")"}], 
       SubscriptBox[
        OverscriptBox[
         StyleBox["f",
          FontWeight->"Bold",
          FontSlant->"Plain"], "_"], 
        StyleBox["p", "TI"]], ",", 
       UnderscriptBox["\[Sum]", 
        StyleBox["p", "TI"],
        LimitsPositioning->True], 
       RowBox[{"(", 
        RowBox[{
         SubsuperscriptBox["\[Del]", 
          StyleBox["p", "TI"], "LL"], 
         SubsuperscriptBox[
          StyleBox["b",
           FontWeight->"Bold",
           FontSlant->"Plain"], "LL", "-"]}], ")"}], 
       SubscriptBox[
        StyleBox["f",
         FontWeight->"Bold",
         FontSlant->"Plain"], 
        StyleBox["p", "TI"]]}], "]"}]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"98ba42ff-5302-417e-a4cb-664c989f251f"]], "InlineFormula",
  ExpressionUUID->"cafe1d61-7cc8-4863-a8a8-002fedb861e7"],
 ", the right multiplications ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["R", "TI"], 
     SubscriptBox[
      OverscriptBox[
       StyleBox["f",
        FontWeight->"Bold",
        FontSlant->"Plain"], "_"], 
      StyleBox["p", "TI"]], "LL"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"9be25559-7bfd-4f46-b948-ba799a1f29ed"]], "InlineFormula",
  ExpressionUUID->"7a510268-b125-47fa-9808-9e0a6988ec15"],
 " and ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["R", "TI"], 
     SubscriptBox[
      StyleBox["f",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      StyleBox["p", "TI"]], "LL"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"0fe505b2-1ac5-49a2-8e19-6ba101aa0e1f"]], "InlineFormula",
  ExpressionUUID->"bc4dfda0-13ff-43a0-9b4b-14a1feb125ce"],
 " applied to the covariant derivatives of the charges."
}], "Text",ExpressionUUID->"38f30cd3-6798-4d24-adfd-4e0878afe0e7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"rbq", "[", "]"}], " ", ":=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"t2UnitC", "[", "]"}], ",", " ", 
     RowBox[{"{", "4", "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"zero4", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"0", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"bqDev", "[", 
    RowBox[{"x_", ",", " ", "y_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Max", "[", 
    RowBox[{"Abs", "[", 
     RowBox[{"x", " ", "-", " ", "y"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"devA", " ", "=", " ", "0."}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"x", " ", "=", " ", 
         RowBox[{"rbq", "[", "]"}]}], ",", " ", "y", ",", " ", "lhs", ",", 
        " ", "ycx", ",", " ", "prod"}], "}"}], ",", "\n", "   ", 
      RowBox[{
       RowBox[{"y", " ", "=", " ", 
        RowBox[{"rbq", "[", "]"}]}], ";", "\n", "   ", 
       RowBox[{"lhs", " ", "=", " ", 
        RowBox[{
         RowBox[{"t2mq", "[", "x", "]"}], " ", ".", " ", 
         RowBox[{"t2psiPrime", "[", "y", "]"}]}]}], ";", "\n", "   ", 
       RowBox[{"ycx", " ", "=", " ", 
        RowBox[{"t2bqMul", "[", 
         RowBox[{"y", ",", " ", 
          RowBox[{"t2bqConj", "[", "x", "]"}]}], "]"}]}], ";", "\n", "   ", 
       RowBox[{"devA", " ", "=", " ", 
        RowBox[{"Max", "[", 
         RowBox[{"devA", ",", " ", 
          RowBox[{"fro", "[", 
           RowBox[{"lhs", " ", "-", " ", 
            RowBox[{"t2psiPrime", "[", "ycx", "]"}]}], "]"}]}], "]"}]}], ";", 
       "\n", "   ", 
       RowBox[{"prod", " ", "=", " ", 
        RowBox[{"t2bioctMul", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"zero4", ",", " ", "y"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "zero4"}], "}"}]}], "]"}]}], ";", "\n", 
       "   ", 
       RowBox[{"devA", " ", "=", " ", 
        RowBox[{"Max", "[", 
         RowBox[{"devA", ",", " ", 
          RowBox[{"bqDev", "[", 
           RowBox[{
            RowBox[{"prod", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", " ", "zero4"}], "]"}], ",", 
          " ", 
          RowBox[{"bqDev", "[", 
           RowBox[{
            RowBox[{"prod", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", " ", "ycx"}], "]"}]}], 
         "]"}]}]}]}], "]"}], ",", " ", 
    RowBox[{"{", "50", "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"devB", " ", "=", " ", "0."}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "f", ",", " ", "gfr", ",", " ", "bsm", ",", " ", "bsp", ",", " ", 
        "psi"}], "}"}], ",", "\n", "   ", 
      RowBox[{
       RowBox[{"f", " ", "=", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"trial", " ", "==", " ", "0"}], ",", " ", 
          "t2canonicalFrame", ",", " ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Module", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"x0", " ", "=", " ", 
                RowBox[{"t2Unit", "[", "]"}]}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"x0", ",", " ", 
                RowBox[{"I", " ", 
                 RowBox[{"t2Unit", "[", "]"}]}], ",", " ", 
                RowBox[{"I", " ", 
                 RowBox[{"t2Unit", "[", "]"}]}], ",", " ", 
                RowBox[{"I", " ", 
                 RowBox[{"t2Unit", "[", "]"}]}]}], "}"}]}], "]"}], ",", " ", 
            RowBox[{"{", "4", "}"}]}], "]"}]}], "]"}]}], ";", "\n", "   ", 
       RowBox[{"gfr", " ", "=", " ", 
        RowBox[{"t2gammasFromFrame", "[", "f", "]"}]}], ";", "\n", "   ", 
       RowBox[{"bsm", " ", "=", " ", 
        RowBox[{"rbq", "[", "]"}]}], ";", " ", 
       RowBox[{"bsp", " ", "=", " ", 
        RowBox[{"rbq", "[", "]"}]}], ";", "\n", "   ", 
       RowBox[{"psi", " ", "=", " ", 
        RowBox[{"t2diracFromCharges", "[", 
         RowBox[{"bsm", ",", " ", "bsp"}], "]"}]}], ";", "\n", "   ", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"devB", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"devB", ",", " ", 
            RowBox[{"Norm", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"t2lift4", "[", 
