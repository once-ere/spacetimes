                    RowBox[{"(", 
                    SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], ")"}], 
                    "2"]}], ")"}], "2"]}], TraditionalForm], 
             "\", used for comparison; its coupling \"", 
             FormBox[
              RowBox[{
                SubsuperscriptBox["\[Lambda]", "LL", "H"], "\[LongEqual]", 
