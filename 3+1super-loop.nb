               FontFamily->"Source Sans Pro",
               FontSize->9.5,ExpressionUUID->
               "8381cfec-8a6d-4bb7-b4bb-4fd6cf024e28"],
              ImageSize->290]},
            {
             PaneBox[
              TemplateBox[{
                SubscriptBox["\[GothicP]", "LL"], "\", \"", 
                TagBox[
                 StyleBox["r", FontWeight -> "Bold", FontSlant -> "Plain"], 
                 "SL31Bold"], "\", \"", 
                SuperscriptBox[
                 TagBox[
                  StyleBox["r", FontWeight -> "Bold", FontSlant -> "Plain"], 
                  "SL31Bold"], "\[Prime]"]},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              StyleBox["\<\"p_LL rP rP'\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[Cell[TextData[{
               "the translations of the family ",
               Cell[BoxData[
                FormBox[
                 SubsuperscriptBox[
                  StyleBox["\[ScriptCapitalF]",
                   FontSlant->"Plain"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
                  StyleBox["B",
                   FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "c9ec9971-072e-47a7-9afd-8900b26fa4c8"],
               ": the real space of the Hermitian bi-quaternions ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  StyleBox["r",
                   FontWeight->"Bold",
                   FontSlant->"Plain"], "\[LongEqual]", 
                  SuperscriptBox[
                   StyleBox["r",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], "\[Dagger]"]}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "b6f41005-02bd-4af4-bb07-b25af535f103"],
               " (dimension 4), on which ",
               Cell[BoxData[
                FormBox[
                 SubscriptBox[
                  StyleBox["\[GothicL]",
                   FontSlant->"Plain"], 
                  StyleBox["LL",
                   FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "44a7ccc9-2697-400e-b111-38f563f66445"],
               " acts by ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  RowBox[{"[", 
                   RowBox[{
                    StyleBox["u",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], ",", 
                    StyleBox["r",
                    FontWeight->"Bold",
                    FontSlant->"Plain"]}], "]"}], "\[LongEqual]", 
                  StyleBox["u",
                   FontWeight->"Bold",
                   FontSlant->"Plain"], 
                  StyleBox["r",
                   FontWeight->"Bold",
                   FontSlant->"Plain"], "+", 
                  StyleBox["r",
                   FontWeight->"Bold",
                   FontSlant->"Plain"], 
                  SuperscriptBox[
                   StyleBox["u",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], "\[Dagger]"]}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "d46f68bb-9659-49ef-8bc6-fcb2c4e9bfd8"]
              }], "Text",
               FontFamily->"Source Sans Pro",
               FontSize->9.5,ExpressionUUID->
               "36327d67-d6c6-486d-9fec-541256cd851a"],
              ImageSize->290]},
            {
             PaneBox[
              TemplateBox[{
                SubsuperscriptBox["c", "LL", "tw"], "\", \"", 
                SubsuperscriptBox["c", "LL", "sl"], "\", \"", 
                SubsuperscriptBox["c", "LL", "PP"], "\", \"", 
                SubsuperscriptBox["c", "LL", "Ps"], "\", \"", 
                SubsuperscriptBox["c", "LL", "sP"], "\", \"", 
                SubsuperscriptBox["c", "LL", "TT"], "\", \"", 
                SubsuperscriptBox["c", "LL", "Ts"], "\", \"", 
                SubsuperscriptBox["c", "LL", "sT"]},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              
              StyleBox["\<\"c_tw c_sl c_PP c_Ps c_sP c_TT c_Ts c_sT csP cTT \
ctw_re ctw_im csl_re csl_im cPP_re cPP_im cPs_re cPs_im cTs_re cTs_im csT_re \
csT_im\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[Cell[TextData[{
               "the coefficients of the families: ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  RowBox[{"[", 
                   RowBox[{
                    StyleBox["u",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], ",", 
                    StyleBox["b",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], 
                    SubscriptBox[
                    StyleBox["e",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], "4"]}], "]"}], "\[LongEqual]", 
                  SubsuperscriptBox[
                   StyleBox["c", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"], 
                   StyleBox["tw",
                    FontSlant->"Plain"]], 
                  RowBox[{"(", 
                   RowBox[{
                    SubscriptBox[
                    StyleBox["W", "TI"], 
                    StyleBox["LL",
                    FontSlant->"Plain"]], 
                    RowBox[{"(", 
                    StyleBox["u",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], ")"}], 
                    StyleBox["b",
                    FontWeight->"Bold",
                    FontSlant->"Plain"]}], ")"}], 
                  SubscriptBox[
                   StyleBox["e",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], "4"]}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "3db89ffc-802d-436a-963f-0edcf55c6220"],
               " (the twist), ",
