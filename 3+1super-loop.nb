          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            RowBox[{
              SubsuperscriptBox["\[Chi]", "LL", "f"], "(", 
              SubsuperscriptBox["\[Omega]", "LL", "B"], ")"}], "\", \"", 
            RowBox[{
              SubsuperscriptBox["\[CapitalGamma]", "LL", "f"], "(", 
              SubsuperscriptBox["\[Omega]", "LL", "B"], ")"}], "\", \"", 
            SubsuperscriptBox["\[CapitalGamma]", "LL", "G"], "\", \"", 
            SubsuperscriptBox["\[CapitalGamma]", "LL", "m"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"chi_f Gamma_f Gamma_bdg Gamma_G Gamma_m\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the pair susceptibility of a direction ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              OverscriptBox[
               StyleBox["u", "TI"], "\[RightVector]"], 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["f",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "f71446cb-4c72-4d85-9983-2a95f198d2d7"],
           " of the condensed vacuum at the frequency ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[Omega]", 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["B",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "0a1b48f6-856a-414f-9c96-ae64b5496ccb"],
           " and zero wave number, and the kernel of the direction, ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox["\[CapitalGamma]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["f",
                FontSlant->"Plain"]], "\[LongEqual]", 
              SuperscriptBox[
               RowBox[{"\[LeftBracketingBar]", 
                SubsuperscriptBox[
                 OverscriptBox[
                  StyleBox["u", "TI"], "\[RightVector]"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["f",
                  FontSlant->"Plain"]], "\[RightBracketingBar]"}], "2"], "/", 
              
              SubscriptBox[
               StyleBox["G", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"]], "-", 
              SubsuperscriptBox["\[Chi]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["f",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "2fd0bb3c-3b13-4591-aee8-5a6c3515053c"],
           ": minus the coefficient of the time average of ",
           Cell[BoxData[
            FormBox[
             SuperscriptBox[
              RowBox[{"(", 
               SubsuperscriptBox["\[Delta]", 
                StyleBox["LL",
                 FontSlant->"Plain"], 
                StyleBox["f",
                 FontSlant->"Plain"]], ")"}], "2"], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "28d500c8-93c7-4681-a580-c8a868924ce6"],
           " in the effective action per duration and volume (plain text ",
           StyleBox["Gamma_bdg",
            FontFamily->"Source Code Pro"],
           
           ": the kernel computed from the Bogoliubov matrices); the kernels \
of the three Goldstone directions and of the three massive directions, ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox["\[CapitalGamma]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["G",
                FontSlant->"Plain"]], "\[LongEqual]", 
              RowBox[{"-", 
               SuperscriptBox[
                RowBox[{"(", 
                 SubsuperscriptBox["\[Omega]", 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
                  StyleBox["B",
                   FontSlant->"Plain"]], ")"}], "2"]}], 
              SubscriptBox["\[CapitalUpsilon]", 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "21849392-7849-4566-8258-130ce369f7eb"],
           " and ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox["\[CapitalGamma]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["m",
                FontSlant->"Plain"]], "\[LongEqual]", 
              RowBox[{"(", 
               RowBox[{"4", 
                SubsuperscriptBox["\[CapitalDelta]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], "2"], "-", 
                SuperscriptBox[
                 RowBox[{"(", 
                  SubsuperscriptBox["\[Omega]", 
                   StyleBox["LL",
                    FontSlant->"Plain"], 
                   StyleBox["B",
                    FontSlant->"Plain"]], ")"}], "2"]}], ")"}], 
              SubscriptBox["\[CapitalUpsilon]", 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "ab55fbad-5c54-4e3d-bc33-ca3faf43cfde"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "bf1b369e-94e9-4b1b-a383-96da195ab878"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            RowBox[{
              SubscriptBox["\[CapitalUpsilon]", "LL"], "(", 
              SubsuperscriptBox["\[Omega]", "LL", "B"], ")"}], "\", \"", 
            SubsuperscriptBox["\[CapitalUpsilon]", "LL", 
             RowBox[{"(", "1", ")"}]], "\", \"", 
            SubsuperscriptBox["c", "LL", "w"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"Upsilon Upsilon_1\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the common factor of the kernels of the condensed vacuum, ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubscriptBox["\[CapitalUpsilon]", 
               StyleBox["LL",
                FontSlant->"Plain"]], "\[LongEqual]", "2", "\[ThinSpace]", 
              SubscriptBox["\[Integral]", 
               RowBox[{
                SubscriptBox[
                 StyleBox["q", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"]], "<", 
                SubscriptBox["\[CapitalLambda]", 
                 StyleBox["LL",
                  FontSlant->"Plain"]]}]], "\[ThinSpace]", 
              SuperscriptBox[
               StyleBox["d", "TI"], "3"], 
              SubscriptBox[
               StyleBox["q", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"]], 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"2", "\[Pi]"}], ")"}], 
               RowBox[{"-", "3"}]], 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{
                 SubsuperscriptBox[
                  StyleBox["E", "TI"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
                  StyleBox["c",
                   FontSlant->"Plain"]], 
                 RowBox[{"(", 
                  RowBox[{"4", 
                   SuperscriptBox[
                    RowBox[{"(", 
                    SubsuperscriptBox[
                    StyleBox["E", "TI"], 
                    StyleBox["LL",
                    FontSlant->"Plain"], 
                    StyleBox["c",
                    FontSlant->"Plain"]], ")"}], "2"], "-", 
                   SuperscriptBox[
                    RowBox[{"(", 
                    SubsuperscriptBox["\[Omega]", 
                    StyleBox["LL",
                    FontSlant->"Plain"], 
                    StyleBox["B",
                    FontSlant->"Plain"]], ")"}], "2"]}], ")"}]}], ")"}], 
               RowBox[{"-", "1"}]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "711aa8ff-c4da-446b-b284-d4b211188643"],
           ", with ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubscriptBox["\[CapitalUpsilon]", 
               StyleBox["LL",
                FontSlant->"Plain"]], 
              RowBox[{"(", "0", ")"}], "\[LongEqual]", 
              SubsuperscriptBox[
               StyleBox["Z", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["t",
                FontSlant->"Plain"]], 
              RowBox[{"(", 
               SubscriptBox["\[CapitalDelta]", 
                StyleBox["LL",
                 FontSlant->"Plain"]], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "61f1971a-e142-42ef-b16c-309d16de2c61"],
           "; its derivative with respect to ",
           Cell[BoxData[
            FormBox[
             SuperscriptBox[
              RowBox[{"(", 
               SubsuperscriptBox["\[Omega]", 
                StyleBox["LL",
                 FontSlant->"Plain"], 
                StyleBox["B",
                 FontSlant->"Plain"]], ")"}], "2"], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "9ebd5012-fffb-4936-a3ef-bbab449709e0"],
           " at zero; and the positive number ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["c", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["w",
                FontSlant->"Plain"]], "\[LongEqual]", 
              SuperscriptBox[
               RowBox[{"(", 
                SubsuperscriptBox[
                 StyleBox["M", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["q",
                  FontSlant->"Plain"]], ")"}], "2"], "-", 
              SuperscriptBox[
               RowBox[{"(", 
                SubsuperscriptBox["\[Omega]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["B",
                  FontSlant->"Plain"]], ")"}], "2"], "/", "4"}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "9fc6bca9-d6c4-4c7e-8b3d-c788f760f871"],
           
           ", used in the proof that the kernels of the Goldstone and of the \
massive directions are ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              RowBox[{"-", 
               SuperscriptBox[
                RowBox[{"(", 
                 SubsuperscriptBox["\[Omega]", 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
                  StyleBox["B",
                   FontSlant->"Plain"]], ")"}], "2"]}], 
              SubscriptBox["\[CapitalUpsilon]", 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "41006bc8-2a69-4967-b81b-bdd8453b101c"],
           " and ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              RowBox[{"(", 
               RowBox[{"4", 
                SubsuperscriptBox["\[CapitalDelta]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], "2"], "-", 
                SuperscriptBox[
                 RowBox[{"(", 
                  SubsuperscriptBox["\[Omega]", 
                   StyleBox["LL",
                    FontSlant->"Plain"], 
                   StyleBox["B",
                    FontSlant->"Plain"]], ")"}], "2"]}], ")"}], 
              SubscriptBox["\[CapitalUpsilon]", 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "8734656f-6303-4e99-951b-54c102408e72"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "f2b314ba-1f5f-495b-9575-11b34118701c"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox[
             OverscriptBox["d", "\[RightVector]"], "LL", "u"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the SFBS field in the unitary gauge, the column of the SFBSv \
parametrization, ",
           Cell[BoxData[
            FormBox[
             RowBox[{"(", 
              RowBox[{
               StyleBox["i", "TI"], "\[ThinSpace]", 
               SubsuperscriptBox[
                StyleBox["c", "TI"], 
                RowBox[{
                 StyleBox["LL",
                  FontSlant->"Plain"], ",", "1"}], 
                StyleBox["n",
                 FontSlant->"Plain"]], ",", "\[ThinSpace]", 
               StyleBox["i", "TI"], "\[ThinSpace]", 
               SubsuperscriptBox[
                StyleBox["c", "TI"], 
                RowBox[{
                 StyleBox["LL",
                  FontSlant->"Plain"], ",", "2"}], 
                StyleBox["n",
                 FontSlant->"Plain"]], ",", "\[ThinSpace]", 
               SubsuperscriptBox["\[CapitalDelta]", 
                StyleBox["LL",
                 FontSlant->"Plain"], 
                StyleBox["vac",
                 FontSlant->"Plain"]], "+", 
               SubsuperscriptBox[
                StyleBox["h", "TI"], 
                StyleBox["LL",
                 FontSlant->"Plain"], 
                StyleBox["a",
                 FontSlant->"Plain"]]}], ")"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "afcfcc12-7ed6-408a-80ad-b5e9099fb943"],
           
           ": the field after the gauge transformation that removes the three \
Goldstone fields"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "4a1ce43c-fcc0-4f1e-8d07-9e69acc12442"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["V", 
             RowBox[{"LL", ",", "p"}], "F"], "\", \"", 
            SubsuperscriptBox["V", 
             RowBox[{"LL", ",", "p"}], "\[Iota]"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"V V^iota VF\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the gauge potentials in the unitary gauge, the vector fields of \
definite mass: ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["V", "TI"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}], 
               StyleBox["F",
                FontSlant->"Plain"]], "\[LongEqual]", 
              SubsuperscriptBox[
               StyleBox["A", "TI"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}], 
               StyleBox["F",
                FontSlant->"Plain"]], "-", 
              SubscriptBox["\[PartialD]", 
               StyleBox["p", "TI"]], 
              SubsuperscriptBox["\[CurlyTheta]", 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", "0"}], 
               StyleBox["G",
                FontSlant->"Plain"]], "/", 
              SubsuperscriptBox[
               StyleBox["g", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["F",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "cc9ba81f-625d-4aaf-a701-6fbc838570a9"],
           " and ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              UnderscriptBox["\[Sum]", "\[Iota]",
               LimitsPositioning->True], "\[ThinSpace]", 
              SubsuperscriptBox[
               StyleBox["V", "TI"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}], "\[Iota]"], 
              SubsuperscriptBox["\[Tau]", "\[Iota]", 
               StyleBox["LL",
                FontSlant->"Plain"]], "/", "2", "\[LongEqual]", 
              SuperscriptBox[
               RowBox[{"(", 
                SubsuperscriptBox[
                 StyleBox["U",
                  FontFamily->"Helvetica",
                  FontSlant->"Plain"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["G",
                  FontSlant->"Plain"]], ")"}], "\[Dagger]"], 
