               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[Cell[TextData[{
               "elements of ",
               Cell[BoxData[
                FormBox[
                 SubscriptBox[
                  StyleBox["\[DoubleStruckCapitalB]",
                   FontSlant->"Plain"], 
                  StyleBox["LL",
                   FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "2ab9be47-7ed5-48ee-9c70-2ed65697531c"],
               " (bi-octonions); ",
               Cell[BoxData[
                FormBox[
                 StyleBox["w",
                  FontWeight->"Bold",
