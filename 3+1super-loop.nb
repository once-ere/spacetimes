           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the mass of the SFBS boson of the normal vacuum: the frequency ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[Omega]", 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["B",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "aafb7602-1fe0-4744-9cdb-a368bf9d772b"],
           " below the threshold ",
           Cell[BoxData[
            FormBox[
             RowBox[{"2", 
              SubscriptBox[
               StyleBox["m", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "8821aba5-4ca3-4cda-9c05-28aa5dd18e60"],
           " with ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox["\[Chi]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["pr",
                FontSlant->"Plain"]], 
              RowBox[{"(", 
               RowBox[{
                SubsuperscriptBox["\[Omega]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["B",
                  FontSlant->"Plain"]], ",", "0"}], ")"}], "\[LongEqual]", 
              "1", "/", 
              SubscriptBox[
               StyleBox["G", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "1b81bc4c-2896-473f-9083-c7777126518f"],
           " (plain text ",
           StyleBox["M_B_GL",
            FontFamily->"Source Code Pro"],
           ": the Ginzburg-Landau mass ",
           Cell[BoxData[
            FormBox[
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{
                SubsuperscriptBox[
                 StyleBox["a", "TI"], 
                 StyleBox["LL",
