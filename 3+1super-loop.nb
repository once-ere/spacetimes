            FontSlant->"Plain"]], "-", 
          SubsuperscriptBox[
           OverscriptBox["\[Delta]", "\[RightVector]"], 
           StyleBox["LL",
            FontSlant->"Plain"], 
           StyleBox["j", "TI"]]}], ")"}], "\[Dagger]"], 
