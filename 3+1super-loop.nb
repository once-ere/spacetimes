               RowBox[{"fv", " ", "=", " ", 
                RowBox[{"Table", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"a1", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", " ", 
                    RowBox[{"q", " ", "+", " ", "1"}], ",", " ", 
