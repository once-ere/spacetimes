     OverscriptBox[
      StyleBox["s", "TI"], "\[RightVector]"], 
     StyleBox["LL",
      FontSlant->"Plain"]], ")"}], "-", 
   RowBox[{"(", 
    RowBox[{
     SubscriptBox[
      StyleBox["A",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["LL",
        FontSlant->"Plain"], ",", "0"}]], 
     RowBox[{"(", 
      SubscriptBox[
