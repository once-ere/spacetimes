            RowBox[{
             RowBox[{"-", "ell"}], " ", "gf", " ", "b"}], "]"}]}]}]}], ";", 
        "\n", "   ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"cx", ",", " ", "sx"}], "}"}], " ", "=", " ", 
