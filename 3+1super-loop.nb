            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "070451e4-fc8b-47be-a50a-16e7ade071c6"],
           ", ",
           Cell[BoxData[
            FormBox[
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{
                SubsuperscriptBox[
                 StyleBox["m", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], "2"], "+", 
                SubsuperscriptBox["\[CapitalDelta]", 
