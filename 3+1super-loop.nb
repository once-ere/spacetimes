               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["G",
                FontSlant->"Plain"]], "-", 
              RowBox[{"(", 
               RowBox[{
                StyleBox["i", "TI"], "/", 
                SubsuperscriptBox[
                 StyleBox["g", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["v",
                  FontSlant->"Plain"]]}], ")"}], 
              RowBox[{"(", 
               RowBox[{
                SubscriptBox["\[PartialD]", 
                 StyleBox["p", "TI"]], 
                SuperscriptBox[
                 RowBox[{"(", 
                  SubsuperscriptBox[
                   StyleBox["U",
                    FontFamily->"Helvetica",
                    FontSlant->"Plain"], 
                   StyleBox["LL",
                    FontSlant->"Plain"], 
                   StyleBox["G",
                    FontSlant->"Plain"]], ")"}], "\[Dagger]"]}], ")"}], 
              SubsuperscriptBox[
               StyleBox["U",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["G",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "20e6f333-b33d-4794-932e-b1a99f5ef8f3"],
           "; to first order ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["V", "TI"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}], "\[Iota]"], "\[LongEqual]", 
              SubsuperscriptBox[
               StyleBox["A", "TI"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}], "\[Iota]"], "-", 
              SubscriptBox["\[PartialD]", 
               StyleBox["p", "TI"]], 
              SubsuperscriptBox["\[CurlyTheta]", 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", "\[Iota]"}], 
               StyleBox["G",
                FontSlant->"Plain"]], "/", 
              SubsuperscriptBox[
               StyleBox["g", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["v",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "83b317b0-4fa6-4af1-a1f2-5be55fd52aa3"],
           " (",
           Cell[BoxData[
            FormBox[
             RowBox[{"\[Iota]", "\[LongEqual]", "1", ",", "2"}], 
