               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[
              StyleBox[
               TemplateBox[{"\"groups: the complex \"", 
                 FormBox[
                  RowBox[{"2", "\[Cross]", "2"}], TraditionalForm], 
                 "\" matrices of determinant 1 (the unit bi-quaternions), \
equal to the connected double cover of the Lorentz group of \"", 
                 FormBox[
                  RowBox[{"3", "+", "1"}], TraditionalForm], 
                 "\" dimensions; the complex orthogonal group of four \
dimensions; the compact exceptional group \"", 
                 FormBox[
                  SubscriptBox[
                   StyleBox["G", FontSlant -> "Plain"], "2"], 
                  TraditionalForm], "\" (automorphisms of \"", 
                 FormBox[
                  StyleBox["O", FontSlant -> "Plain"], TraditionalForm], 
                 "\") and its complex form (automorphisms of \"", 
                 FormBox[
                  SubscriptBox[
                   StyleBox["B", FontSlant -> "Plain"], "LL"], 
                  TraditionalForm], "\"); the Lorentz group of \"", 
                 FormBox[
                  RowBox[{"7", "+", "1"}], TraditionalForm], 
                 "\" dimensions; the spin groups of seven dimensions (compact \
and complex); the real \"", 
                 FormBox[
                  RowBox[{"2", "\[Cross]", "2"}], TraditionalForm], 
                 "\" matrices of determinant 1, the double cover of the \
Lorentz group of \"", 
                 FormBox[
                  RowBox[{"2", "+", "1"}], TraditionalForm], 
                 "\" dimensions; the special unitary group of two dimensions; \
the phases; the group of two elements\""},
                "RowDefault"],
               StripOnInput->False,
               FontFamily->"Source Sans Pro",
               FontSize->9.5],
              ImageSize->290]},
            {
             PaneBox[
              TemplateBox[{
                RowBox[{"\[GothicS]\[GothicO]", "(", "3", ",", "1", ")"}], 
                "\", \"", 
                RowBox[{"\[GothicS]\[GothicO]", "(", "1", ",", "7", ")"}], 
                "\", \"", 
                RowBox[{"\[GothicS]\[GothicO]", "(", "4", ",", "1", ")"}], 
                "\", \"", 
                RowBox[{"\[GothicS]\[GothicO]", "(", "8", ")"}], "\", \"", 
                RowBox[{"\[GothicS]\[GothicO]", "(", "4", ",", "4", ")"}], 
                "\", \"", 
                
                RowBox[{
