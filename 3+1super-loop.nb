               OverscriptBox["d", "\[RightVector]"], "LL"], ")"}], "\", \"", 
            SubsuperscriptBox["\[Lambda]", "LL", "H"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"Omega_H lambda_H\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[
          StyleBox[
           
           TemplateBox[{
            "\"the potential of the Higgs form with the minimum on \"", 
             FormBox[
              SubsuperscriptBox[
               StyleBox["V", "TI"], "LL", "vac"], TraditionalForm], "\", \"", 
             
             FormBox[
              RowBox[{
                SubsuperscriptBox["\[Lambda]", "LL", "H"], 
                SuperscriptBox[
                 RowBox[{"(", 
                   RowBox[{"|", 
                    SubscriptBox[
                    OverscriptBox[
                    StyleBox["d", "TI"], "\[RightVector]"], "LL"], 
                    SuperscriptBox["|", "2"], "-", 
                    SuperscriptBox[
                    RowBox[{"(", 
                    SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], ")"}], 
                    "2"]}], ")"}], "2"]}], TraditionalForm], 
             "\", used for comparison; its coupling \"", 
             FormBox[
              RowBox[{
                SubsuperscriptBox["\[Lambda]", "LL", "H"], "\[LongEqual]", 
                SubsuperscriptBox["\[CapitalOmega]", "LL", 
                 RowBox[{"s", "(", "2", ")"}]], "/", 
                RowBox[{"(", 
                  RowBox[{"4", 
                    SuperscriptBox[
                    RowBox[{"(", 
                    SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], ")"}], 
                    "2"]}], ")"}]}], TraditionalForm], 
             "\" gives it the curvature of the computed potential along \"", 
             FormBox[
              SubsuperscriptBox[
               StyleBox["h", "TI"], "LL", "a"], TraditionalForm]},
            "RowDefault"],
           StripOnInput->False,
           FontFamily->"Source Sans Pro",
           FontSize->9.5],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["\[ScriptCapitalL]", "LL", "kin"]},
