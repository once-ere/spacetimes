Cell[TextData[{
 "S-10, the longitudinal vector boson. For a plane wave of wave number ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["k", "TI"], "LL", "B"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"95e46b53-92f4-49be-9859-c3cb2764c5e3"]], "InlineFormula",
  ExpressionUUID->"09db7436-fbce-4e4a-9a12-2dac0b057600"],
 " and frequency ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[Omega]", "LL", "B"], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"2d1e58b3-ce73-464c-90a8-13713793878d"]], 
  "InlineFormula",ExpressionUUID->"be54b622-796f-49c6-8ccc-27d10621a898"],
 " the time component and the longitudinal component of a massive vector \
field obey two linear equations; their determinant is ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox[
          StyleBox["k", "TI"], "LL", "B"], ")"}], "2"], "+", 
       RowBox[{"(", 
        RowBox[{
         SubsuperscriptBox[
          StyleBox["Z", "TI"], "LL", "t"], "/", 
         SubsuperscriptBox[
          StyleBox["Z", "TI"], "LL", "s"]}], ")"}], 
       SuperscriptBox[
        StyleBox["M", "TI"], "2"]}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox["\[Omega]", "LL", "B"], ")"}], "2"], "-", 
       SuperscriptBox[
        StyleBox["M", "TI"], "2"]}], ")"}], "-", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox[
         StyleBox["k", "TI"], "LL", "B"], 
        SubsuperscriptBox["\[Omega]", "LL", "B"]}], ")"}], "2"]}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "84cc07e7-e138-49d3-ac56-f74a4e20d21e"]], "InlineFormula",ExpressionUUID->
  "402e3997-39ba-4e6f-af01-b622cfb4a162"],
 " with ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     StyleBox["M", "TI"], "\[LongEqual]", 
     SubsuperscriptBox[
      StyleBox["M", "TI"], "LL", "W"]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"240c633b-18dc-430d-8d16-ce88affaea39"]], "InlineFormula",
  ExpressionUUID->"1bc77972-6ab7-418f-be05-31f671d8e50e"],
 ". The cell checks with ",
 StyleBox["Factor",
  FontFamily->"Source Code Pro"],
 " and ",
 StyleBox["Solve",
  FontFamily->"Source Code Pro"],
 " that it vanishes exactly for ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox["\[Omega]", "LL", "B"], ")"}], "2"], "\[LongEqual]", 
     
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["M", "TI"], "LL", "W"], ")"}], "2"], "+", 
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["Z", "TI"], "LL", "s"], "/", 
       SubsuperscriptBox[
        StyleBox["Z", "TI"], "LL", "t"]}], ")"}], 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["k", "TI"], "LL", "B"], ")"}], "2"]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"31b07844-5881-4d82-97ce-39e4f8e435a8"]], 
  "InlineFormula",ExpressionUUID->"a0803680-ad2b-4e0c-a66f-aeae8cd900d7"],
 ": the absorbed Goldstone boson moves with the velocity ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["Z", "TI"], "LL", "s"], "/", 
       SubsuperscriptBox[
        StyleBox["Z", "TI"], "LL", "t"]}], ")"}], 
     RowBox[{"1", "/", "2"}]], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"edbe0705-fb5a-4132-857b-f887d4f8dd30"]], "InlineFormula",
  ExpressionUUID->"2abcdd2d-8d34-4237-b42b-76c09c604e0d"],
 "."
}], "Text",ExpressionUUID->"48633993-d49d-43d4-a4dc-2d50d571c5fd"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"det", " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SubsuperscriptBox["k", "LL", "B"], "^", "2"}], " ", "+", " ", 
        RowBox[{
         RowBox[{
          SubsuperscriptBox["Z", "LL", "t"], "/", 
          SubsuperscriptBox["Z", "LL", "s"]}], " ", 
         RowBox[{
          SubsuperscriptBox["M", "LL", "W"], "^", "2"}]}]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SubsuperscriptBox["\[Omega]", "LL", "B"], "^", "2"}], " ", "-", " ", 
        
        RowBox[{
         SubsuperscriptBox["M", "LL", "W"], "^", "2"}]}], ")"}]}], " ", "-", 
     "\n", "   ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox["k", "LL", "B"], " ", 
        SubsuperscriptBox["\[Omega]", "LL", "B"]}], ")"}], "^", "2"}]}]}], 
   ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Solve", " ", "needs", " ", "a", " ", "symbol", " ", "as", " ", 
    RowBox[{"unknown", ":", " ", 
     RowBox[{
     "the", " ", "square", " ", "of", " ", "the", " ", "frequency", " ", "is",
       " ", "called", " ", "w"}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{"root", " ", "=", " ", 
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"det", " ", "/.", " ", 
       RowBox[{
        SubsuperscriptBox["\[Omega]", "LL", "B"], " ", "->", " ", 
        RowBox[{"Sqrt", "[", "w", "]"}]}]}], ")"}], " ", "==", " ", "0"}], ",",
     " ", "w"}], "]"}]}]}], "Input",
 CellLabel->
  "In[129]:=",ExpressionUUID->"b47e4db6-e7d4-4419-8735-ab1b52dfd051"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"w", "\[Rule]", 
    FractionBox[
     RowBox[{
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox["k", "LL", "B"], ")"}], "2"], " ", 
       SubsuperscriptBox["Z", "LL", "s"]}], "+", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox["M", "LL", "W"], ")"}], "2"], " ", 
       SubsuperscriptBox["Z", "LL", "t"]}]}], 
     SubsuperscriptBox["Z", "LL", "t"]]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{4.003995304143896*^9},
 CellLabel->
  "Out[130]=",ExpressionUUID->"07079f4f-6ed3-48c4-a497-305d0398204f"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-10\>\"", ",", 
    " ", "\"\<the determinant of the time and longitudinal equations vanishes \
exactly at omega_B^2 = M_W^2 + (Z_s/Z_t) k_B^2\>\"", ",", "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", "root", "]"}], " ", "==", " ", "1"}], " ", "&&", 
     " ", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"w", " ", "/.", " ", 
          RowBox[{"First", "[", "root", "]"}]}], ")"}], " ", "-", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           SubsuperscriptBox["M", "LL", "W"], "^", "2"}], " ", "+", " ", 
          RowBox[{
           RowBox[{
            SubsuperscriptBox["Z", "LL", "s"], "/", 
            SubsuperscriptBox["Z", "LL", "t"]}], " ", 
           RowBox[{
            SubsuperscriptBox["k", "LL", "B"], "^", "2"}]}]}], ")"}]}], "]"}],
       " ", "===", " ", "0"}]}], ",", "\n", "  ", 
    RowBox[{"Factor", "[", "det", "]"}]}], "]"}], ";"}]], "Input",
 CellLabel->
  "In[131]:=",ExpressionUUID->"18ef37d2-ed0b-42a8-8063-486c2eacaaf0"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   StyleBox["\<\"PASS  \"\>",
    StripOnInput->False,
