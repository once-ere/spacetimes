Cell[CellGroupData[{

Cell["I.5 The single symbols and their kinds", "Section",ExpressionUUID->"84d88dc3-c51e-4f80-8a2d-efcb3bcacb54"],

Cell[TextData[{
 "An entry may list several symbols, for example \"",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubscriptBox[
     StyleBox["m", "TI"], "LL"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"cd11138f-0cc0-4e6b-a273-8394a9d4cba1"]], "InlineFormula",
  ExpressionUUID->"020fa005-691b-47ad-b7fd-816f61137e09"],
 ", ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubscriptBox["\[Mu]", "LL"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"b21360d1-2c96-4924-8427-49b3789942bd"]], "InlineFormula",
  ExpressionUUID->"31851ba3-0260-4156-87c0-7d2a68ed65a7"],
 ", ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubscriptBox["\[CapitalLambda]", "LL"], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"37745682-7960-42d8-b2c2-cdd47e694925"]], 
  "InlineFormula",ExpressionUUID->"1f0f90cb-02ff-4c11-b98c-41b23f3f7c3f"],
 "\" (the mass of the spinor charges, the chemical potential and the momentum \
cutoff). The next cell takes every TeX segment between dollar signs, splits \
it into single items, converts each into boxes, and classifies it. The kinds \
are: symbol (one fixed object, such as ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"86782af1-dfa8-4cf9-a6e3-720e2d2838e8"]], 
  "InlineFormula",ExpressionUUID->"c6e2cb8e-5c2b-44cd-975c-a2d34cf7fc8b"],
 "); family (a symbol with a running index, such as ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[Tau]", "\[Iota]", "LL"], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"384770ae-ff9f-41ca-aaf9-4b9597cb35d6"]], 
  "InlineFormula",ExpressionUUID->"b68929c3-5f23-41d9-80d8-ea493c50a10d"],
 " with ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{"\[Iota]", "\[LongEqual]", "1", ",", "2", ",", "3"}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "5c227fbd-5cd2-4a03-b6d4-1eae284a3066"]], "InlineFormula",ExpressionUUID->
  "6deede6f-8187-4090-b816-d029af8a7ac0"],
 "); function and function family (a symbol followed by its argument, such as \
",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["W", "TI"], "LL"], "(", 
     StyleBox["u",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"e236ea70-e3c8-4889-825b-02282976277c"]], "InlineFormula",
  ExpressionUUID->"a9d94157-f6df-4370-a16a-24a01522cc94"],
 "); letter (a single letter such as ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    StyleBox["D", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "a41cb209-0268-4639-87ca-eb6de36aa5e0"]], "InlineFormula",ExpressionUUID->
  "4d9ac971-2fa7-465a-beb2-e5bb2b7396a7"],
 ", the number of space dimensions); index and primed index (",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "46def5ef-253c-4765-9cf3-31eda887100a"]], "InlineFormula",ExpressionUUID->
  "0b9af2ba-a737-4be4-8976-748a9cfe9aa8"],
 ", ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SuperscriptBox[
     StyleBox["p", "TI"], "\[Prime]"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"b1472a5d-3cc4-40ae-bb17-fdc196245a91"]], "InlineFormula",
  ExpressionUUID->"7fe913e5-305e-45f8-b606-5c87453ade3e"],
 ", ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    StyleBox["j", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "22b40797-d3c4-4ba9-87f1-537edcc84ec6"]], "InlineFormula",ExpressionUUID->
  "0c1ca981-5b9d-4c6d-8643-79ba7c151321"],
 ", ",
 Cell[BoxData[Cell[BoxData[
   FormBox["\[Iota]", TraditionalForm]], "InlineFormula",ExpressionUUID->
   "544ef8eb-446d-4a1f-a4f5-b7789c397977"]], "InlineFormula",ExpressionUUID->
  "a4254901-d92c-433b-9713-1d7c9cdb4f5d"],
 ", ...); set (",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    StyleBox["\[DoubleStruckCapitalR]",
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "3172667b-2712-454c-8bdf-7e2894ab3b48"]], "InlineFormula",ExpressionUUID->
  "e06e6179-0720-4e66-810d-10c62cf85048"],
 ", ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    StyleBox["\[DoubleStruckCapitalC]",
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "b22ddc30-fede-4239-b12b-2c0182d9f6d4"]], "InlineFormula",ExpressionUUID->
  "b222e1b2-6bfe-4f09-a66e-5f3909415812"],
 ", ...); group (",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{"SL", "(", 
     RowBox[{"2", ",", 
      StyleBox["\[DoubleStruckCapitalC]",
       FontSlant->"Plain"]}], ")"}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"53526deb-647b-40f1-ae3c-dd76dea4db0c"]], "InlineFormula",
  ExpressionUUID->"09327d7f-8596-4ffb-bfb8-25a6509bd13f"],
 ", ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{"SU", 
     SubscriptBox[
      RowBox[{"(", "2", ")"}], "v"]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"a2b1a928-eee1-4ac7-81ba-ea76a9bd0a88"]], "InlineFormula",
  ExpressionUUID->"4e61d3d8-f4e9-4806-bf6f-d7e121888727"],
 ", ...); ket; operator (tr, det, the transpose, the tensor product, ...); \
expression (a combination such as ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SuperscriptBox[
     RowBox[{"(", 
      SubscriptBox[
       StyleBox["T", "TI"], "LL"], ")"}], "2"], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"77d133ca-7d2f-44f7-89c9-7ecb3509e25f"]], 
  "InlineFormula",ExpressionUUID->"aaa7c5cf-4d2e-4485-bbfe-e3bd07d683af"],
 "); imaginary unit. Entries that are not written in TeX at all are the \
labels of the machine checks and of the hypotheses of the no-go theorems; \
they are names, not symbols, and are kept as text."
}], "Text",ExpressionUUID->"f86da453-3de1-4f8b-8aa5-110729c67487"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "every", " ", "TeX", " ", "segment", " ", "of", " ", "every", " ", 
    RowBox[{"entry", ":", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"entry", " ", "number"}], ",", " ", "segment"}], "}"}]}]}], 
   " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"segments", " ", "=", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{"e", ",", " ", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"e", "[", "\"\<entry\>\"", "]"}], ",", " ", "#"}], 
               "}"}], " ", "&"}], ",", " ", 
             RowBox[{"StringCases", "[", 
              RowBox[{
               RowBox[{"e", "[", "\"\<symbol\>\"", "]"}], ",", " ", 
               RowBox[{
                RowBox[{"\"\<$\>\"", " ", "~~", " ", 
                 RowBox[{"Shortest", "[", "x__", "]"}], " ", "~~", 
                 " ", "\"\<$\>\""}], " ", ":>", " ", "x"}]}], "]"}]}], 
            "]"}]}], "]"}], ",", " ", "SL31Registry"}], "]"}], ",", " ", 
       "1"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"the", " ", "entries", " ", "without", " ", "any", " ", 
     RowBox[{"TeX", ":", " ", "labels"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"labelEntries", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{"SL31Registry", ",", " ", 
       RowBox[{
        RowBox[{"!", " ", 
         RowBox[{"StringContainsQ", "[", 
          RowBox[{
           RowBox[{"#", "[", "\"\<symbol\>\"", "]"}], ",", " ", "\"\<$\>\""}],
           "]"}]}], " ", "&"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "split", " ", "every", " ", "segment", " ", "into", " ", "single", " ", 
     "items", " ", "and", " ", "convert", " ", "each", " ", "item"}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"items", " ", "=", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{"s", ",", " ", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"<|", 
               RowBox[{
                RowBox[{"\"\<entry\>\"", " ", "->", " ", 
                 RowBox[{"s", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
                RowBox[{"\"\<tex\>\"", " ", "->", " ", "#"}], ",", " ", 
                RowBox[{"\"\<boxes\>\"", " ", "->", " ", 
                 RowBox[{"SL31TeXToBoxes", "[", "#", "]"}]}]}], "|>"}], " ", 
              "&"}], ",", " ", 
             RowBox[{"SL31SplitTeX", "[", 
              RowBox[{"s", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "]"}]}], "]"}], ",", 
         " ", "segments"}], "]"}], ",", " ", "1"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"items", " ", "=", " ", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Append", "[", 
         RowBox[{"#", ",", " ", 
          RowBox[{"\"\<kind\>\"", " ", "->", " ", 
           RowBox[{"SL31Classify", "[", 
            RowBox[{
             RowBox[{"#", "[", "\"\<tex\>\"", "]"}], ",", " ", 
             RowBox[{"#", "[", "\"\<boxes\>\"", "]"}]}], "]"}]}]}], "]"}], 
        " ", "&"}], ",", " ", "items"}], "]"}]}], ";"}], "\n", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", "[", "segments", "]"}], ",", " ", 
     RowBox[{"Length", "[", "items", "]"}], ",", " ", 
     RowBox[{"Length", "[", "labelEntries", "]"}]}], "}"}]}]}]], "Input",
 CellLabel->"In[78]:=",ExpressionUUID->"41def2e8-2109-4011-a666-80aa69adb897"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"434", ",", "449", ",", "2"}], "}"}]], "Output",
 CellChangeTimes->{4.0039953028612537`*^9},
 CellLabel->"Out[82]=",ExpressionUUID->"9c9e285a-4c76-4059-b983-c856233f75c6"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "how", " ", "many", " ", "items", " ", "of", " ", "each", " ", "kind"}], 
   " ", "*)"}], "\n", 
  RowBox[{"ReverseSort", "[", 
   RowBox[{"Counts", "[", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"#", "[", "\"\<kind\>\"", "]"}], " ", "&"}], ",", " ", 
      "items"}], "]"}], "]"}], "]"}]}]], "Input",
 CellLabel->"In[83]:=",ExpressionUUID->"125e4212-1c73-4936-b248-452a0d63ecd2"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"symbol\"\>", "\[Rule]", "289"}], ",", 
   RowBox[{"\<\"family\"\>", "\[Rule]", "56"}], ",", 
   RowBox[{"\<\"function\"\>", "\[Rule]", "37"}], ",", 
   RowBox[{"\<\"group\"\>", "\[Rule]", "30"}], ",", 
   RowBox[{"\<\"operator\"\>", "\[Rule]", "13"}], ",", 
   RowBox[{"\<\"function family\"\>", "\[Rule]", "7"}], ",", 
   RowBox[{"\<\"set\"\>", "\[Rule]", "4"}], ",", 
   RowBox[{"\<\"index\"\>", "\[Rule]", "3"}], ",", 
   RowBox[{"\<\"primed index\"\>", "\[Rule]", "3"}], ",", 
   RowBox[{"\<\"imaginary unit\"\>", "\[Rule]", "2"}], ",", 
   RowBox[{"\<\"expression\"\>", "\[Rule]", "2"}], ",", 
   RowBox[{"\<\"ket\"\>", "\[Rule]", "2"}], ",", 
   RowBox[{"\<\"letter\"\>", "\[Rule]", "1"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{4.0039953028639193`*^9},
 CellLabel->"Out[83]=",ExpressionUUID->"c5609490-558a-4488-8f86-1722a7cff010"]
}, Open  ]]
