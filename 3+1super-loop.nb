                FormBox[
                 RowBox[{
                  SubscriptBox[
                   StyleBox["\[GothicL]",
                    FontSlant->"Plain"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]], "\[CirclePlus]", 
