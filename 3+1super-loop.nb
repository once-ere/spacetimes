              StyleBox["\<\"\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[Cell[TextData[{
               "a linear map from ",
               Cell[BoxData[
                FormBox[
                 SubscriptBox[
                  StyleBox["\[GothicM]",
                   FontSlant->"Plain"], 
                  StyleBox["LL",
                   FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "8b3449f1-7dd5-4553-afe4-3e6113213687"],
               
               " to the linear operators (matrices) on a vector space that \
turns brackets into commutators, ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubscriptBox["\[CurlyRho]", 
                   StyleBox["LL",
                    FontSlant->"Plain"]], 
                  RowBox[{"(", 
                   RowBox[{"[", 
                    RowBox[{
                    StyleBox["x",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], ",", 
                    StyleBox["y",
                    FontWeight->"Bold",
                    FontSlant->"Plain"]}], "]"}], ")"}], "\[LongEqual]", 
                  SubscriptBox["\[CurlyRho]", 
                   StyleBox["LL",
                    FontSlant->"Plain"]], 
                  RowBox[{"(", 
                   StyleBox["x",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], ")"}], 
                  SubscriptBox["\[CurlyRho]", 
                   StyleBox["LL",
                    FontSlant->"Plain"]], 
                  RowBox[{"(", 
                   StyleBox["y",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], ")"}], "-", 
                  SubscriptBox["\[CurlyRho]", 
                   StyleBox["LL",
                    FontSlant->"Plain"]], 
                  RowBox[{"(", 
                   StyleBox["y",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], ")"}], 
