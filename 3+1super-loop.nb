                  StyleBox["LL",
                   FontSlant->"Plain"], ",", "3"}], 
                 StyleBox["F",
                  FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "16d9e7e4-11af-453b-98f9-14c4afaa6bab"],
           ": the shift of the kinetic momentum of both members of a pair"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "20634d59-34ab-4da3-b475-0194491086d3"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
