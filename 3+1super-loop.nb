      RowBox[{"{", 
       RowBox[{"s", ",", " ", "0", ",", " ", 
        RowBox[{"ns", " ", "-", " ", "1"}]}], "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", "\n", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"fl2", "[", 
         RowBox[{"[", 
          RowBox[{"\"\<v0\>\"", ",", " ", 
           RowBox[{"s", " ", "+", " ", "1"}]}], "]"}], "]"}], " ", "=", " ", 
        RowBox[{
         RowBox[{"gs", "[", 
          RowBox[{"[", 
           RowBox[{"s", " ", "+", " ", "1"}], "]"}], "]"}], " ", ".", " ", 
         RowBox[{"fl", "[", 
          RowBox[{"[", 
           RowBox[{"\"\<v0\>\"", ",", " ", 
            RowBox[{"s", " ", "+", " ", "1"}]}], "]"}], "]"}], " ", ".", " ", 
         
         RowBox[{"ConjugateTranspose", "[", 
          RowBox[{"gs", "[", 
           RowBox[{"[", 
            RowBox[{"s", " ", "+", " ", "1"}], "]"}], "]"}], "]"}]}]}], ";", 
       "\n", "  ", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"sp", " ", "=", " ", 
             RowBox[{"t2neighbour", "[", 
              RowBox[{"lat", ",", " ", "s", ",", " ", "j", ",", " ", "True"}],
               "]"}]}], "}"}], ",", "\n", "    ", 
           RowBox[{
            RowBox[{"fl2", "[", 
             RowBox[{"[", 
              RowBox[{"\"\<links\>\"", ",", " ", 
               RowBox[{"s", " ", "+", " ", "1"}], ",", " ", 
               RowBox[{"j", " ", "+", " ", "1"}]}], "]"}], "]"}], " ", "=", 
            " ", 
            RowBox[{
             RowBox[{"gs", "[", 
              RowBox[{"[", 
               RowBox[{"s", " ", "+", " ", "1"}], "]"}], "]"}], " ", ".", " ", 
             RowBox[{"fl", "[", 
              RowBox[{"[", 
               RowBox[{"\"\<links\>\"", ",", " ", 
                RowBox[{"s", " ", "+", " ", "1"}], ",", " ", 
                RowBox[{"j", " ", "+", " ", "1"}]}], "]"}], "]"}], " ", ".", 
             " ", 
             RowBox[{"ConjugateTranspose", "[", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"sp", " ", "===", " ", "None"}], ",", " ", 
                RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", " ", 
                RowBox[{"gs", "[", 
                 RowBox[{"[", 
                  RowBox[{"sp", " ", "+", " ", "1"}], "]"}], "]"}]}], "]"}], 
              "]"}]}]}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"j", ",", " ", "0", ",", " ", "2"}], "}"}]}], "]"}]}], ",", 
      "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"s", ",", " ", "0", ",", " ", 
        RowBox[{"ns", " ", "-", " ", "1"}]}], "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"hl2", " ", "=", " ", 
     RowBox[{"t2dense", "[", 
      RowBox[{"lat", ",", " ", "fl2"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gcov", " ", "=", " ", 
     RowBox[{"fro", "[", 
      RowBox[{"hl2", " ", "-", " ", 
       RowBox[{"gbig", " ", ".", " ", "hl", " ", ".", " ", 
        RowBox[{"ConjugateTranspose", "[", "gbig", "]"}]}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"the", " ", "free", " ", "one"}], "-", 
      RowBox[{"dimensional", " ", 
       RowBox[{"lattice", ":", " ", 
        RowBox[{
         RowBox[{"the", " ", "spectrum"}], " ", "+", 
         RowBox[{"-", "eps_lat"}]}]}]}]}], ",", " ", 
     RowBox[{
      RowBox[{"each", " ", "eight", " ", "times"}], ";", " ", 
      RowBox[{"the", " ", "doubler"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"lat1", " ", "=", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<n\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1", ",", " ", "12"}], "}"}]}], ",", " ", 
       RowBox[{"\"\<ell\>\"", " ", "->", " ", "0.5"}], ",", " ", 
       RowBox[{"\"\<periodic\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"True", ",", " ", "True", ",", " ", "True"}], "}"}]}], ",", 
       " ", 
       RowBox[{"\"\<wilson\>\"", " ", "->", " ", "1.0"}], ",", " ", 
       RowBox[{"\"\<mass\>\"", " ", "->", " ", "mass"}], ",", " ", 
       RowBox[{"\"\<mu\>\"", " ", "->", " ", "0."}]}], "|>"}]}], ";"}], "\n", 
   
   RowBox[{
    RowBox[{"ev1", " ", "=", " ", 
     RowBox[{"First", "[", 
      RowBox[{"t2eigh", "[", 
       RowBox[{"t2dense", "[", 
        RowBox[{"lat1", ",", " ", 
         RowBox[{"t2trivialFields", "[", "12", "]"}]}], "]"}], "]"}], "]"}]}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"expect1", " ", "=", " ", 
     RowBox[{"Sort", "[", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"e", " ", "=", " ", 
             RowBox[{"t2epsLat", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"0.", ",", " ", "0.", ",", " ", 
                 RowBox[{"2", " ", "Pi", " ", 
                  RowBox[{"kk", "/", 
                   RowBox[{"(", 
                    RowBox[{"12", " ", "0.5"}], ")"}]}]}]}], "}"}], ",", " ", 
               "0.5", ",", " ", "mass", ",", " ", "1.0", ",", " ", 
               RowBox[{"{", 
                RowBox[{"False", ",", " ", "False", ",", " ", "True"}], 
                "}"}]}], "]"}]}], "}"}], ",", " ", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"e", ",", " ", 
               RowBox[{"-", "e"}]}], "}"}], ",", " ", 
             RowBox[{"{", "8", "}"}]}], "]"}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"kk", ",", " ", "0", ",", " ", "11"}], "}"}]}], "]"}], 
       "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"disp", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{"ev1", " ", "-", " ", "expect1"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"doublerOk", " ", "=", " ", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"t2epsLat", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0.", ",", " ", "0.", ",", " ", 
            RowBox[{"Pi", "/", "0.5"}]}], "}"}], ",", " ", "0.5", ",", " ", 
          "mass", ",", " ", "1.0", ",", " ", 
          RowBox[{"{", 
           RowBox[{"False", ",", " ", "False", ",", " ", "True"}], "}"}]}], 
         "]"}], " ", "-", " ", 
        RowBox[{"(", 
         RowBox[{"mass", " ", "+", " ", 
          RowBox[{"2", "/", "0.5"}]}], ")"}]}], "]"}], " ", "<", " ", 
      "1*^-12"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "the", " ", "spectral", " ", "radius", " ", "of", " ", "H_lat", " ", 
     "and", " ", "its", " ", "bound", " ", 
     RowBox[{"B", "^", "H"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"rho", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{"First", "[", 
        RowBox[{"t2eigh", "[", "hl", "]"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"bound", " ", "=", " ", 
     RowBox[{"t2normBound", "[", 
      RowBox[{"lat", ",", " ", "fl"}], "]"}]}], ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<GS-10\>\"", ",", 
     " ", "\"\<the lattice operator H_lat on a 3 x 2 x 4 lattice (dx = 0.7, \
r_W = 1, periodic in x and z) with random links, potentials and order \
parameters is Hermitian, particle-hole symmetric and exactly gauge covariant; \
on a free periodic chain of 12 sites its spectrum is +-eps_lat, each eight \
times; the Wilson term lifts the doubler to m + 2 r_W/dx; the spectral radius \
stays below the bound Hbound (tolerance 1e-10)\>\"", ",", "\n", "  ", 
     RowBox[{
      RowBox[{"herm", " ", "<", " ", "1*^-10"}], " ", "&&", " ", 
      RowBox[{"ph", " ", "<", " ", "1*^-10"}], " ", "&&", " ", 
      RowBox[{"gcov", " ", "<", " ", "1*^-10"}], " ", "&&", " ", 
      RowBox[{"disp", " ", "<", " ", "1*^-10"}], " ", "&&", " ", "doublerOk", 
      " ", "&&", " ", 
      RowBox[{"rho", " ", "<=", " ", "bound"}]}], ",", "\n", "  ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<Hermiticity \>\"", ",", " ", "herm", ",", 
        " ", "\"\<, particle-hole \>\"", ",", " ", "ph", ",", 
        " ", "\"\<, gauge covariance \>\"", ",", " ", "gcov", ",", 
        " ", "\"\<, dispersion \>\"", ",", " ", "disp", ",", 
        " ", "\"\<; spectral radius \>\"", ",", " ", 
        RowBox[{"NumberForm", "[", 
         RowBox[{"rho", ",", " ", 
          RowBox[{"{", 
           RowBox[{"6", ",", " ", "4"}], "}"}]}], "]"}], ",", 
        " ", "\"\< <= bound \>\"", ",", " ", 
        RowBox[{"NumberForm", "[", 
         RowBox[{"bound", ",", " ", 
          RowBox[{"{", 
           RowBox[{"6", ",", " ", "4"}], "}"}]}], "]"}], ",", "\n", 
        "    ", "\"\< (original: 0.0e0, 0.0e0, 1.8e-13, 1.4e-14; 8.4349 <= \
17.5474)\>\""}], "}"}], "]"}]}], "]"}]}]}]], "Input",
 CellLabel->
  "In[429]:=",ExpressionUUID->"224a933e-60ff-46e0-a7b2-7f078d74a91c"],

Cell[BoxData[
 StyleBox[
  TemplateBox[{
    StyleBox["\"PASS  \"", Bold, 
     RGBColor[0, 
      Rational[2, 3], 0], StripOnInput -> False], "\"GS-10: \"", 
    "\"the lattice operator H_lat on a 3 x 2 x 4 lattice (dx = 0.7, r_W = 1, \
periodic in x and z) with random links, potentials and order parameters is \
Hermitian, particle-hole symmetric and exactly gauge covariant; on a free \
periodic chain of 12 sites its spectrum is +-eps_lat, each eight times; the \
Wilson term lifts the doubler to m + 2 r_W/dx; the spectral radius stays \
below the bound Hbound (tolerance 1e-10)\"", 
    "\"  -- Hermiticity 0., particle-hole 0., gauge covariance 1.75349e-13, \
dispersion 2.84217e-14; spectral radius 8.4349 <= bound 17.5474 (original: \
0.0e0, 0.0e0, 1.8e-13, 1.4e-14; 8.4349 <= 17.5474)\""},
   "RowDefault"],
  StripOnInput->False,
  LineIndent->0]], "Print",
 CellChangeTimes->{4.004025491609192*^9},
 CellLabel->
