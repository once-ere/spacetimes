                   StyleBox["e",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], "7"]}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "1f5845d0-7edd-4ac5-9518-b6f1c41cc4e3"]
              }], "Text",
               FontFamily->"Source Sans Pro",
               FontSize->9.5,ExpressionUUID->
               "eb6fda4e-78bd-49f5-add5-96f0e8fb0551"],
              ImageSize->290]},
            {
             PaneBox[
              
              TemplateBox[{
               "\[DoubleStruckCapitalR]", "\", \"", "\[DoubleStruckCapitalC]"},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              StyleBox["\<\"R C R^8 C^3 C^8\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[Cell[TextData[{
               "the real and the complex numbers (plain text: ",
               StyleBox["R^8",
                FontFamily->"Source Code Pro"],
               ", ",
               StyleBox["C^3",
                FontFamily->"Source Code Pro"],
               ", ",
               StyleBox["C^8",
                FontFamily->"Source Code Pro"],
               " are the real or complex vector spaces of that dimension)"
              }], "Text",
               FontFamily->"Source Sans Pro",
               FontSize->9.5,ExpressionUUID->
               "ad393403-44f9-461a-bd75-d751f29d816b"],
              ImageSize->290]},
            {
             PaneBox[
              TemplateBox[{"p", "\", \"", 
                SuperscriptBox["p", "\[Prime]"]},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              StyleBox["\<\"p p' p1 p2 p3\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[Cell[TextData[{
               "a summation index over the basis of an algebra (values ",
               Cell[BoxData[
                FormBox[
                 RowBox[{"0", ",", "\[Ellipsis]", ",", "7"}], 
                 TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "446252d1-0372-4d70-87f0-4436f182866b"],
               ", or ",
               Cell[BoxData[
                FormBox[
                 RowBox[{"0", ",", "\[Ellipsis]", ",", "3"}], 
                 TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "09fadf55-8adc-47f0-a217-9c819e87ddb2"],
               
               " for the quaternions): in Revision_SuperLoop it labels the \
units ",
               Cell[BoxData[
                FormBox[
                 SubscriptBox[
                  StyleBox["e",
                   FontWeight->"Bold",
                   FontSlant->"Plain"], 
                  StyleBox["p", "TI"]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "b61c5137-7b76-4d04-93e0-d813ab5e59e3"],
               " of ",
               Cell[BoxData[
                FormBox[
                 SubscriptBox[
                  StyleBox["\[DoubleStruckCapitalB]",
                   FontSlant->"Plain"], 
                  StyleBox["LL",
                   FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "6993ed5a-4557-4906-bdb0-b52f3ef5aec3"],
               ", the coefficients ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubsuperscriptBox["\[Xi]", 
                   StyleBox["p", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]], 
                  RowBox[{"(", 
                   StyleBox["x",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], ")"}]}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "4671b93a-6611-42fa-b334-a77f52e7648f"],
               ", the coordinates ",
               Cell[BoxData[
                FormBox[
                 SubsuperscriptBox[
                  StyleBox["x", "TI"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
                  StyleBox["p", "TI"]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "1d6f4dda-5f5b-4e92-ad2e-0a89e25387d7"],
               " of ",
               Cell[BoxData[
                FormBox[
                 SubsuperscriptBox[
                  StyleBox["\[DoubleStruckCapitalR]",
                   FontSlant->"Plain"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
                  RowBox[{"1", ",", "7"}]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "aa58699d-3155-4db6-ae36-6d36de7d12a3"],
               " and ",
               Cell[BoxData[
                FormBox[
                 SubsuperscriptBox[
                  StyleBox["\[DoubleStruckCapitalR]",
                   FontSlant->"Plain"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
                  RowBox[{"1", ",", "3"}]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "78f35e70-7d0e-4ad8-b113-880e5d7af491"],
               " and the Dirac matrices ",
               Cell[BoxData[
                FormBox[
                 SubsuperscriptBox["\[Gamma]", 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
                  StyleBox["p", "TI"]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "549caf5c-1f8a-4540-95e0-5b2b4821dfa7"],
               " (",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  StyleBox["p", "TI"], "\[LongEqual]", "0", ",", "1", ",", 
                  "2", ",", "3"}], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "5ceeec9c-45ff-48be-a375-f6ff93e0dba1"],
               "); ",
               Cell[BoxData[
                FormBox[
                 SuperscriptBox[
                  StyleBox["p", "TI"], "\[Prime]"], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "e142e90c-a2cb-42ea-8019-f34a3f146bf5"],
               " is a second index of the same kind (plain text ",
               StyleBox["p1",
                FontFamily->"Source Code Pro"],
               ", ",
               StyleBox["p2",
                FontFamily->"Source Code Pro"],
               ", ",
               StyleBox["p3",
                FontFamily->"Source Code Pro"],
               ": three such indices)"
              }], "Text",
               FontFamily->"Source Sans Pro",
               FontSize->9.5,ExpressionUUID->
               "5be8c10f-c390-4dc4-93e6-539eeb5ca1c9"],
              ImageSize->290]},
            {
             PaneBox[
              TemplateBox[{"\[Iota]", "\", \"", 
                SuperscriptBox["\[Iota]", "\[Prime]"], "\", \"", 
                SuperscriptBox["\[Iota]", "\[Prime]\[Prime]"]},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              StyleBox["\<\"iota\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[Cell[TextData[{
               
               "the isospin index, values 1, 2, 3: it labels the isospin \
generators ",
               Cell[BoxData[
                FormBox[
                 SubsuperscriptBox[
                  StyleBox["T", "TI"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "47b482a5-3b08-4fd4-8dc9-1377d0a61883"],
               ", the Pauli matrices ",
               Cell[BoxData[
                FormBox[
                 SubsuperscriptBox["\[Tau]", "\[Iota]", 
                  StyleBox["LL",
                   FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "e9062369-fd99-4dfa-abf0-dae47cd09b98"],
               " on the isospin index of a field, the pair channels ",
               Cell[BoxData[
                FormBox[
                 SubsuperscriptBox[
                  StyleBox["K",
                   FontFamily->"Helvetica",
                   FontSlant->"Plain"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "74d1e829-c226-447c-bb51-0cc810cd9b80"],
               ", ",
               Cell[BoxData[
                FormBox[
                 SubsuperscriptBox[
                  StyleBox["K",
                   FontFamily->"Helvetica",
                   FontSlant->"Plain"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
                  RowBox[{"\[Prime]", "\[Iota]"}]], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "25c86c10-28bd-4a83-889c-37ad67521f37"],
               ", the pair operators ",
               Cell[BoxData[
                FormBox[
                 SubsuperscriptBox["\[CapitalPi]", 
                  StyleBox["LL",
                   FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "4260e498-d9ae-4f5a-b35f-6e369e803f0c"],
               " and the components ",
               Cell[BoxData[
                FormBox[
                 SubsuperscriptBox[
                  StyleBox["d", "TI"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], 
