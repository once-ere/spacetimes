               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[Cell[TextData[{
               "the Jacobiator ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubscriptBox[
                   StyleBox["Jac",
                    FontSlant->"Plain"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]], 
                  RowBox[{"(", 
                   RowBox[{
                    StyleBox["x",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], ",", 
                    StyleBox["y",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], ",", 
                    StyleBox["z",
                    FontWeight->"Bold",
                    FontSlant->"Plain"]}], ")"}], "\[LongEqual]", 
                  RowBox[{"[", 
                   RowBox[{
                    RowBox[{"[", 
                    RowBox[{
                    StyleBox["x",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], ",", 
                    StyleBox["y",
                    FontWeight->"Bold",
                    FontSlant->"Plain"]}], "]"}], ",", 
                    StyleBox["z",
                    FontWeight->"Bold",
                    FontSlant->"Plain"]}], "]"}], "+", 
                  RowBox[{"[", 
                   RowBox[{
                    RowBox[{"[", 
                    RowBox[{
                    StyleBox["y",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], ",", 
                    StyleBox["z",
                    FontWeight->"Bold",
                    FontSlant->"Plain"]}], "]"}], ",", 
                    StyleBox["x",
                    FontWeight->"Bold",
                    FontSlant->"Plain"]}], "]"}], "+", 
                  RowBox[{"[", 
                   RowBox[{
                    RowBox[{"[", 
                    RowBox[{
                    StyleBox["z",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], ",", 
                    StyleBox["x",
                    FontWeight->"Bold",
                    FontSlant->"Plain"]}], "]"}], ",", 
                    StyleBox["y",
                    FontWeight->"Bold",
                    FontSlant->"Plain"]}], "]"}]}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "e912d426-acc6-47bc-90ae-d3aeae153656"],
               
               " of a bracket; it vanishes identically exactly in a Lie \
algebra"
              }], "Text",
               FontFamily->"Source Sans Pro",
               FontSize->9.5,ExpressionUUID->
               "41a66b09-e847-4aa5-b5ed-a7612cec009a"],
              ImageSize->290]},
            {
