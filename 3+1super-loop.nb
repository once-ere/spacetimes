    {
     TagBox[GridBox[{
        {
         StyleBox["\<\"3 Operators on the super-loop and their \
eigenvalues\"\>",
          StripOnInput->False,
          FontSize->12,
          FontWeight->Bold]},
        {
         TagBox[GridBox[{
            {
             StyleBox["\<\"symbol\"\>",
              StripOnInput->False,
              FontFamily->"Source Sans Pro",
              FontWeight->Bold], 
             StyleBox["\<\"plain-text names\"\>",
              StripOnInput->False,
              FontFamily->"Source Sans Pro",
              FontWeight->Bold], 
             StyleBox["\<\"meaning\"\>",
              StripOnInput->False,
              FontFamily->"Source Sans Pro",
              FontWeight->Bold]},
            {
             PaneBox[
              TemplateBox[{
                SubscriptBox["Q", "LL"]},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              StyleBox["\<\"Q_LL\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[
              StyleBox[
               TemplateBox[{"\"the electric charge, \"", 
                 FormBox[
                  RowBox[{
                    SubscriptBox[
                    StyleBox["Q", "TI"], "LL"], "\[LongEqual]", 
                    SubsuperscriptBox[
                    StyleBox["T", "TI"], "LL", "3"]}], TraditionalForm], 
                 "\": eigenvalues \"", 
                 FormBox["0", TraditionalForm], "\" on \"", 
                 FormBox[
                  RowBox[{
                    StyleBox["C", FontSlant -> "Plain"], "\[CircleTimes]", 
                    StyleBox["H", FontSlant -> "Plain"]}], TraditionalForm], 
                 "\" and \"", 
                 FormBox[
                  FractionBox[
                   RowBox[{"\[PlusMinus]", "1"}], "2"], TraditionalForm], 
                 "\" on the spinor charges\""},
                "RowDefault"],
               StripOnInput->False,
               FontFamily->"Source Sans Pro",
               FontSize->9.5],
              ImageSize->290]},
            {
             PaneBox[
              TemplateBox[{
                SubsuperscriptBox["T", "LL", "\[Iota]"], "\", \"", 
                SuperscriptBox[
                 RowBox[{"(", 
                   SubscriptBox["T", "LL"], ")"}], "2"]},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              
              StyleBox["\<\"T_LL^iota T_LL^iota' T_LL^iota'' T_LL^3 \
T_LL^2\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[
              StyleBox[
               TemplateBox[{"\"the isospin generators \"", 
                 FormBox[
                  RowBox[{
                    SubsuperscriptBox[
                    StyleBox["T", "TI"], "LL", "\[Iota]"], "\[LongEqual]", 
                    StyleBox["i", "TI"], " ", 
                    SubsuperscriptBox[
                    StyleBox["D", "TI"], "LL", "v"], 
                    RowBox[{"(", 
                    RowBox[{
                    SubscriptBox[
                    StyleBox["e", FontSlant -> "Bold"], "\[Iota]"], "/", 
                    "2"}], ")"}]}], TraditionalForm], "\", Hermitian, \"", 
                 FormBox[
                  RowBox[{
                    RowBox[{"[", 
                    RowBox[{
                    SubsuperscriptBox[
                    StyleBox["T", "TI"], "LL", "1"], ",", 
                    SubsuperscriptBox[
                    StyleBox["T", "TI"], "LL", "2"]}], "]"}], "\[LongEqual]", 
                    
                    StyleBox["i", "TI"], 
                    SubsuperscriptBox[
                    StyleBox["T", "TI"], "LL", "3"]}], TraditionalForm], 
                 "\" and cyclically, and the isospin Casimir \"", 
                 FormBox[
                  RowBox[{
                    SuperscriptBox[
                    RowBox[{"(", 
                    SubscriptBox[
                    StyleBox["T", "TI"], "LL"], ")"}], "2"], "\[LongEqual]", 
                    UnderscriptBox[
                    "\[Sum]", "\[Iota]", LimitsPositioning -> True], 
                    SuperscriptBox[
                    RowBox[{"(", 
                    SubsuperscriptBox[
                    StyleBox["T", "TI"], "LL", "\[Iota]"], ")"}], "2"]}], 
                  TraditionalForm]},
                "RowDefault"],
               StripOnInput->False,
               FontFamily->"Source Sans Pro",
               FontSize->9.5],
              ImageSize->290]},
            {
             PaneBox[
              TemplateBox[{
                SubscriptBox["Cas", "LL"]},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              StyleBox["\<\"Cas_LL\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[
              StyleBox[
               TemplateBox[{"\"the Casimir operator of the rotations, \"", 
                 FormBox[
                  RowBox[{
                    SubscriptBox[
                    StyleBox["Cas", FontSlant -> "Plain"], "LL"], 
                    "\[LongEqual]", "-", 
                    UnderscriptBox["\[Sum]", 
                    StyleBox["j", "TI"], LimitsPositioning -> True], 
                    SubscriptBox[
                    StyleBox["D", "TI"], "LL"], 
                    SuperscriptBox[
                    RowBox[{"(", 
                    SubsuperscriptBox[
                    StyleBox["J", "TI"], "LL", 
                    StyleBox["j", "TI"]], ")"}], "2"]}], TraditionalForm], 
                 "\"; its eigenvalue is 0 for spin 0, 3/4 for spin 1/2 and 2 \
for spin 1\""},
                "RowDefault"],
               StripOnInput->False,
               FontFamily->"Source Sans Pro",
               FontSize->9.5],
              ImageSize->290]}
