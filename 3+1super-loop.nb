          StyleBox[
           TemplateBox[{"\"the change of the \"", 
             FormBox[
              RowBox[{"16", "\[Cross]", "16"}], TraditionalForm], 
             "\" Bogoliubov matrix per unit of \"", 
             FormBox[
              SubsuperscriptBox["\[Delta]", "LL", "f"], TraditionalForm], 
             "\", \"", 
             FormBox[
              RowBox[{"(", 
                Cell[
                 BoxData[
                  FormBox[
                   GridBox[{{
                    Cell[
                    TextData[{" ", 
                    Cell["0", "InlineFormula"], " "}]], 
                    Cell[
                    TextData[{" ", 
                    Cell[
                    BoxData[
                    RowBox[{
                    SubscriptBox[
                    StyleBox["P", FontSlant -> "Plain"], "LL"], "(", 
                    SubsuperscriptBox[
                    OverscriptBox[
                    StyleBox["u", "TI"], "\[RightVector]"], "LL", "f"], 
                    ")"}]], "InlineFormula"], " "}]]}, {
                    Cell[
                    TextData[{" ", 
