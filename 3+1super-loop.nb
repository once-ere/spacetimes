                   StyleBox["x",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], ")"}], "\[ThinSpace]", 
                  SubsuperscriptBox["\[Xi]", 
                   StyleBox["p", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]], 
                  RowBox[{"(", 
                   StyleBox["y",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], ")"}]}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "e83be065-c39a-4c90-b648-f20a4fbb6783"],
               ", ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubscriptBox[
                   StyleBox["N", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]], 
                  RowBox[{"(", 
                   RowBox[{
                    StyleBox["x",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], ",", 
                    StyleBox["x",
                    FontWeight->"Bold",
                    FontSlant->"Plain"]}], ")"}], "\[LongEqual]", 
