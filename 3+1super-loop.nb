            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "78188e0e-bcc2-49d2-a5d7-00fa11f43f44"],
           ") and ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["V", "TI"], 
