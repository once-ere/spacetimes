Cell[TextData[{
 "S-11, the sum over the isospin index with the generators ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubsuperscriptBox[
      StyleBox["T", "TI"], "LL", "\[Iota]"], "\[LongEqual]", 
     SubsuperscriptBox["\[Tau]", "\[Iota]", "LL"], "/", "2"}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "2233aeda-1fd6-4525-8540-5d6431bfe59d"]], "InlineFormula",ExpressionUUID->
  "d0b725d5-ebaf-44c3-bcc4-cedcd36cf946"],
 ": the Casimir ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       SubscriptBox[
        StyleBox["T", "TI"], "LL"], ")"}], "2"], "\[LongEqual]", 
     UnderscriptBox["\[Sum]", "\[Iota]",
      LimitsPositioning->True], 
     SubsuperscriptBox[
      StyleBox["T", "TI"], "LL", "\[Iota]"], 
     SubsuperscriptBox[
      StyleBox["T", "TI"], "LL", "\[Iota]"]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"1b37f32b-d1ae-4228-adad-504775384782"]], 
  "InlineFormula",ExpressionUUID->"f6f45457-07f7-4800-9a1f-e2eff33322a7"],
 " of the isospin one-half is ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    FractionBox["3", "4"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "cc8e10f2-537e-4f51-b504-1d1b5cf01837"]], "InlineFormula",ExpressionUUID->
  "eb559f58-0172-4d46-8dda-f3f38245baac"],
 " times the unit matrix. The components ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubsuperscriptBox["\[Tau]", "1", "LL"], ",", 
     SubsuperscriptBox["\[Tau]", "2", "LL"], ",", 
     SubsuperscriptBox["\[Tau]", "3", "LL"]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"db3f93ab-6c8e-42fb-8877-dfcef84509d0"]], 
  "InlineFormula",ExpressionUUID->"d9711485-7622-4e59-b40e-c50d6404d67e"],
 " and ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubsuperscriptBox[
      StyleBox["T", "TI"], "LL", "1"], ",", 
     SubsuperscriptBox[
      StyleBox["T", "TI"], "LL", "2"], ",", 
     SubsuperscriptBox[
      StyleBox["T", "TI"], "LL", "3"]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"d7c03f90-e1bd-41aa-87c8-8c4c92c43bd0"]], "InlineFormula",
  ExpressionUUID->"d18eadbb-a50c-49ef-8565-3b4616f52403"],
 " are symbolized; the generators are defined from the Pauli matrices by \
rules."
}], "Text",ExpressionUUID->"5cbe7f70-ecc3-4041-8bb6-caa437c28d67"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"taus", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ReleaseHold", "[", 
      RowBox[{"SL31Instance", "[", 
       RowBox[{
        RowBox[{
        "SL31SymbolBoxes", "[", "\"\<\\\\tau^{\\\\rm LL}_\\\\iota\>\"", "]"}],
         ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<\[Iota]\>\"", " ", "->", " ", 
          RowBox[{"ToString", "[", "k", "]"}]}], "}"}]}], "]"}], "]"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Ts", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ReleaseHold", "[", 
      RowBox[{"SL31Instance", "[", 
       RowBox[{
        RowBox[{
        "SL31SymbolBoxes", "[", "\"\<T^\\\\iota_{\\\\rm LL}\>\"", "]"}], ",", 
        " ", 
        RowBox[{"{", 
         RowBox[{"\"\<\[Iota]\>\"", " ", "->", " ", 
          RowBox[{"ToString", "[", "k", "]"}]}], "}"}]}], "]"}], "]"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"casimir", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Ts", "[", 
         RowBox[{"[", "k", "]"}], "]"}], " ", ".", " ", 
        RowBox[{"Ts", "[", 
         RowBox[{"[", "k", "]"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}], " ", "/.", " ", 
     RowBox[{"Thread", "[", 
      RowBox[{"Ts", " ", "->", " ", 
       RowBox[{"taus", "/", "2"}]}], "]"}]}], " ", "/.", " ", 
    RowBox[{"Thread", "[", 
     RowBox[{"taus", " ", "->", " ", "pauliValues"}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-11\>\"", ",", 
    " ", "\"\<the sum over iota of T^iota_LL T^iota_LL (with T = tau/2 for \
the symbolized components) is 3/4 times the unit matrix\>\"", ",", "\n", "  ", 
    RowBox[{"casimir", " ", "===", " ", 
     RowBox[{
      RowBox[{"3", "/", "4"}], " ", 
      RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], ",", " ", "casimir"}], 
   "]"}], ";"}]}], "Input",
 CellLabel->
  "In[132]:=",ExpressionUUID->"cb882e29-b568-4033-a991-9c6b749910a6"],

