     SubscriptBox["\[GothicM]", "LL"]},
    {"\<\"\\\\lvert\\\\Phi^{\\\\rm SF}_{\\\\rm LL}\\\\rangle\"\>", 
     StyleBox["\<\"RowBox[{\\\"|\\\", \
SubsuperscriptBox[\\\"\[CapitalPhi]\\\", \\\"LL\\\", \\\"SF\\\"], \\\"\
\[RightAngleBracket]\\\"}]\"\>",
      StripOnInput->False,
