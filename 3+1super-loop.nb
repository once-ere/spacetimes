                 OverscriptBox[
                  StyleBox["c", "TI"], "^"], 
                 RowBox[{"LL", ",", 
                   SuperscriptBox[
                    StyleBox["k", "TI"], "\[Prime]"]}]]}], TraditionalForm]},
