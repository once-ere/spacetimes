Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"GS", "-", "13"}], ":", " ", 
     RowBox[{
     "the", " ", "initial", " ", "state", " ", "from", " ", "a", " ", 
      "generator", " ", "of", " ", "its", " ", "own", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"seed", " ", "2026111713"}], ")"}], ".", "  ", "The"}], " ", 
      "state", " ", "of", " ", "the", " ", "main", " ", "generator", " ", 
      "is", " ", "kept", "\n", "   ", "and", " ", "restored"}]}], ",", " ", 
    RowBox[{
    "so", " ", "that", " ", "the", " ", "random", " ", "numbers", " ", "of", " ",
      "the", " ", "later", " ", "checks", " ", "are", " ", "those", " ", "of",
      " ", "the", " ", "original", " ", "program"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"rngKept13", " ", "=", " ", "t2rngState"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"t2Seed", "[", "2026111713", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"w0IDA13", " ", "=", " ", 
