        RowBox[{"explicitly", ":", " ", 
         RowBox[{
         "by", " ", "default", " ", "the", " ", "Notation", " ", "package", "\n",
           "   ", "takes", " ", "the", " ", "working", " ", "form", " ", 
          "from", " ", "the", " ", "notebook", " ", "that", " ", "holds", " ",
           "the", " ", "input", " ", 
          RowBox[{"(", 
           RowBox[{"InputNotebook", "[", "]"}], ")"}]}]}]}]}], ";", " ", 
      RowBox[{
      "when", " ", "the", "\n", "   ", "notebook", " ", "is", " ", 
       "evaluated", " ", "without", " ", "a", " ", "selected", " ", "input", " ",
        "notebook", " ", "this", " ", "gives", " ", "$Failed"}]}], ",", " ", 
     RowBox[{
     "and", " ", "the", " ", "parsing", "\n", "   ", "rule", " ", "would", " ",
       "then", " ", "be", " ", "stored", " ", "for", " ", "the", " ", "form", 
      " ", "$Failed", " ", "and", " ", "never", " ", 
      RowBox[{"used", "."}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"SL31Symbolize", "[", "b_", "]"}], " ", ":=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Notation`Symbolize", "[", 
        RowBox[{
         RowBox[{"Notation`ParsedBoxWrapper", "[", "b", "]"}], ",", " ", 
         RowBox[{"Notation`WorkingForm", " ", "->", " ", "StandardForm"}], ",",
          "\n", "     ", 
         RowBox[{"Notation`SymbolizeRootName", " ", "->", " ", 
          RowBox[{"SL31NameOf", "[", "b", "]"}]}]}], "]"}], ";", "\n", "   ", 
       
       RowBox[{"SL31SymbolOf", "[", "b", "]"}]}], ")"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"SL31SymbolOf", "[", "b_", "]"}], " ", ":=", " ", 
     RowBox[{"MakeExpression", "[", 
      RowBox[{"b", ",", " ", "StandardForm"}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"components", ":", " ", 
     RowBox[{
     "replace", " ", "running", " ", "indices", " ", "in", " ", "the", " ", 
      "scripts", " ", "by", " ", "values"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"replaceIndex", "[", 
      RowBox[{"b_", ",", " ", "rules_List"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"r", " ", "=", " ", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], " ", "->", " ", 
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], ")"}], " ", "&"}], ",", " ", 
           "rules"}], "]"}]}], "}"}], ",", "\n", "  ", 
       RowBox[{"b", " ", "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"SubscriptBox", "[", 
            RowBox[{"x_", ",", " ", "s_"}], "]"}], " ", ":>", " ", 
           RowBox[{"SubscriptBox", "[", 
            RowBox[{"x", ",", " ", 
             RowBox[{"s", " ", "/.", " ", "r"}]}], "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{"SuperscriptBox", "[", 
            RowBox[{"x_", ",", " ", "s_"}], "]"}], " ", ":>", " ", 
           RowBox[{"SuperscriptBox", "[", 
            RowBox[{"x", ",", " ", 
             RowBox[{"s", " ", "/.", " ", "r"}]}], "]"}]}], ",", "\n", 
          "        ", 
          RowBox[{
           RowBox[{"SubsuperscriptBox", "[", 
            RowBox[{"x_", ",", " ", "s1_", ",", " ", "s2_"}], "]"}], " ", ":>",
            " ", 
           RowBox[{"SubsuperscriptBox", "[", 
            RowBox[{"x", ",", " ", 
             RowBox[{"s1", " ", "/.", " ", "r"}], ",", " ", 
             RowBox[{"s2", " ", "/.", " ", "r"}]}], "]"}]}]}], "}"}]}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"SL31Instance", "[", 
      RowBox[{"b_", ",", " ", "rules_List"}], "]"}], " ", ":=", " ", 
     RowBox[{"SL31Symbolize", "[", 
      RowBox[{"replaceIndex", "[", 
       RowBox[{"b", ",", " ", "rules"}], "]"}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "boxes", " ", "that", " ", "are", " ", "symbolized", " ", 
      "for", " ", "a", " ", "registered", " ", "TeX", " ", "item"}], ",", " ", 
     RowBox[{"by", " ", 
      RowBox[{"kind", ":", "\n", "   ", 
       RowBox[{
        RowBox[{"-", " ", "a"}], " ", "single", " ", "letter", " ", 
        RowBox[{"(", 
         RowBox[{"D", ",", " ", 
          RowBox[{"the", " ", "dimension", " ", "count"}]}], ")"}], " ", "is",
         " ", "wrapped", " ", "in", " ", 
        RowBox[{"TagBox", "[", 
         RowBox[{"..", ",", " ", "\"\<SL31Plain\>\""}], "]"}]}]}]}], ",", " ", 
     RowBox[{
      RowBox[{
      "so", " ", "that", " ", "the", "\n", "     ", "ordinary", " ", "letter",
        " ", 
       RowBox[{"(", 
        RowBox[{
        "for", " ", "example", " ", "the", " ", "derivative", " ", "D", " ", 
         "of", " ", "the", " ", "Wolfram", " ", "Language"}], ")"}], " ", 
       "keeps", " ", "its", " ", "meaning"}], ";", "\n", "   ", 
      RowBox[{
       RowBox[{"-", " ", "a"}], " ", "group", " ", "name"}]}], ",", " ", 
     RowBox[{
     "a", " ", "ket", " ", "or", " ", "another", " ", "expression", " ", 
      "whose", " ", "boxes", " ", "begin", " ", "with", " ", "RowBox", " ", 
      "is", " ", "wrapped", " ", "in", "\n", "     ", 
      RowBox[{"TagBox", "[", 
       RowBox[{"..", ",", " ", "\"\<SL31Name\>\""}], "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{
      "because", " ", "the", " ", "Notation", " ", "package", " ", "cannot", " ",
        "symbolize", " ", "a", " ", "RowBox"}], ";", "\n", "   ", 
      RowBox[{
       RowBox[{"-", " ", "a"}], " ", "function", " ", "symbol", " ", "W", 
       RowBox[{"(", "u", ")"}], " ", "gives", " ", "the", " ", "boxes", " ", 
       "of", " ", "its", " ", "head", " ", "W"}], ";", "\n", "   ", 
      RowBox[{
       RowBox[{"-", " ", "every"}], " ", "other", " ", "kind", " ", "gives", " ",
        "its", " ", "boxes", " ", 
       RowBox[{"unchanged", "."}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"SL31Symbolized", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<symbol\>\"", ",", " ", "\"\<family\>\"", ",", 
       " ", "\"\<function\>\"", ",", " ", "\"\<function family\>\"", ",", 
       " ", "\"\<letter\>\"", ",", " ", "\"\<group\>\"", ",", 
       " ", "\"\<ket\>\"", ",", " ", "\"\<expression\>\"", ",", 
       " ", "\"\<primed index\>\""}], "}"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "the", " ", "innermost", " ", "base", " ", "of", " ", "a", " ", "box", " ",
      "with", " ", "scripts", " ", "or", " ", "an", " ", "accent"}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"baseOf", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
        "SubscriptBox", " ", "|", " ", "SuperscriptBox", " ", "|", " ", 
         "SubsuperscriptBox", " ", "|", " ", "OverscriptBox"}], ")"}], "[", 
       RowBox[{"x_", ",", " ", "__"}], "]"}], "]"}], " ", ":=", " ", 
     RowBox[{"baseOf", "[", "x", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"baseOf", "[", "x_", "]"}], " ", ":=", " ", "x"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "a", " ", "box", " ", "whose", " ", "base", " ", "is", " ", "an", " ", 
      "operator", " ", "sign"}], ",", " ", 
     RowBox[{
      RowBox[{"such", " ", "as", " ", "the", " ", "partial"}], "-", 
      RowBox[{"derivative", " ", "sign", " ", "or", " ", "nabla"}]}], ",", 
     " ", 
     RowBox[{
     "would", " ", "be", "\n", "   ", "read", " ", "by", " ", "the", " ", 
      "front", " ", "end", " ", "as", " ", "an", " ", "operator", " ", 
      "applied", " ", "to", " ", "what", " ", "follows", " ", "it"}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"operatorBaseQ", "[", "b_", "]"}], " ", ":=", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", " ", "=", " ", 
         RowBox[{"baseOf", "[", "b", "]"}]}], "}"}], ",", " ", 
       RowBox[{
        RowBox[{"StringQ", "[", "x", "]"}], " ", "&&", " ", 
        RowBox[{"x", " ", "=!=", " ", "\"\<\>\""}], " ", "&&", " ", 
        RowBox[{"!", " ", 
         RowBox[{"LetterQ", "[", 
          RowBox[{"StringTake", "[", 
           RowBox[{"x", ",", " ", "1"}], "]"}], "]"}]}], " ", "&&", " ", 
        RowBox[{"!", " ", 
         RowBox[{"DigitQ", "[", 
          RowBox[{"StringTake", "[", 
           RowBox[{"x", ",", " ", "1"}], "]"}], "]"}]}]}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"TagBox", "[", 
       RowBox[{"..", ",", " ", "\"\<SL31Name\>\"", ",", " ", 
        RowBox[{"SyntaxForm", " ", "->", " ", "\"\<symbol\>\""}]}], "]"}], " ",
       "makes", " ", "the", " ", "front", " ", "end", " ", "treat", " ", 
      "its", " ", "content", " ", "as", " ", "ONE", "\n", "   ", "operand"}], 
     ",", " ", 
     RowBox[{"like", " ", "a", " ", "symbol"}], ",", " ", 
     RowBox[{"wherever", " ", "it", " ", "stands"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"asName", "[", "b_", "]"}], " ", ":=", " ", 
     RowBox[{"TagBox", "[", 
      RowBox[{"b", ",", " ", "\"\<SL31Name\>\"", ",", " ", 
       RowBox[{"SyntaxForm", " ", "->", " ", "\"\<symbol\>\""}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"SL31SymbolBoxes", "[", "tex_String", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"b", " ", "=", " ", 
          RowBox[{"SL31TeXToBoxes", "[", "tex", "]"}]}], ",", " ", "k", ",", 
         " ", "r"}], "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"k", " ", "=", " ", 
         RowBox[{"SL31Classify", "[", 
          RowBox[{"tex", ",", " ", "b"}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"r", " ", "=", " ", 
         RowBox[{"Switch", "[", 
          RowBox[{"k", ",", "\n", "    ", "\"\<letter\>\"", ",", " ", 
           RowBox[{"TagBox", "[", 
            RowBox[{"b", ",", " ", "\"\<SL31Plain\>\""}], "]"}], ",", "\n", 
           "    ", "\"\<expression\>\"", ",", " ", 
           RowBox[{"asName", "[", "b", "]"}], ",", "\n", "    ", 
           RowBox[{"\"\<group\>\"", " ", "|", " ", "\"\<ket\>\""}], ",", " ", 
           
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Head", "[", "b", "]"}], " ", "===", " ", "RowBox"}], ",",
              " ", 
             RowBox[{"asName", "[", "b", "]"}], ",", " ", "b"}], "]"}], ",", 
           "\n", "    ", 
           
           RowBox[{"\"\<function\>\"", " ", "|", 
            " ", "\"\<function family\>\""}], ",", " ", 
           RowBox[{"SL31Head", "[", "b", "]"}], ",", "\n", "    ", "_", ",", 
           " ", "b"}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Head", "[", "r", "]"}], " ", "=!=", " ", "TagBox"}], " ",
            "&&", " ", 
           RowBox[{"operatorBaseQ", "[", "r", "]"}]}], ",", " ", 
          RowBox[{"asName", "[", "r", "]"}], ",", " ", "r"}], "]"}]}]}], 
      "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "boxes", " ", "of", " ", "a", " ", "registered", " ", "TeX", 
      " ", "symbol"}], ",", " ", 
     RowBox[{
     "with", " ", "optional", " ", "index", " ", "values", " ", "given", " ", 
      "as", " ", "TeX", " ", "strings"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"SL31`Build`symbolBoxes", "[", 
      RowBox[{"tex_String", ",", " ", "rules___Rule"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"b", " ", "=", " ", 
         RowBox[{"SL31SymbolBoxes", "[", "tex", "]"}]}], "}"}], ",", "\n", 
       "  ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", "rules", "}"}], " ", "===", " ", 
          RowBox[{"{", "}"}]}], ",", " ", "b", ",", " ", 
         RowBox[{"replaceIndex", "[", 
          RowBox[{"b", ",", " ", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"SL31TeXToBoxes", "[", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "]"}], " ", "->", " ", 
               RowBox[{"SL31TeXToBoxes", "[", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], "]"}]}], " ", "&"}], ",", 
             " ", 
             RowBox[{"{", "rules", "}"}]}], "]"}]}], "]"}]}], "]"}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"LL", "[", 
      RowBox[{"tex_String", ",", " ", "rules___Rule"}], "]"}], " ", ":=", " ", 
     RowBox[{"ReleaseHold", "[", 
      RowBox[{"SL31SymbolOf", "[", 
       RowBox[{"SL31`Build`symbolBoxes", "[", 
        RowBox[{"tex", ",", " ", "rules"}], "]"}], "]"}], "]"}]}], ";"}], 
   "\n", "\n", 
   RowBox[{
    RowBox[{"End", "[", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"EndPackage", "[", "]"}], ";"}]}]}]], "Input",
 CellLabel->"In[16]:=",ExpressionUUID->"f6c616e3-9c56-4188-99c8-877c67ea4312"],

Cell["\<\
A first look at the reader: the TeX of six registered symbols and the boxes \
that it builds, shown both as boxes and as they are displayed.\
\>", "Text",ExpressionUUID->"fe3a2b49-5d25-4066-9d0c-032235dcc065"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"examples", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<\\\\Delta^{\\\\rm vac}_{\\\\rm LL}\>\"", ",", 
     " ", "\"\<A^\\\\iota_{{\\\\rm LL},p}\>\"", ",", 
     " ", "\"\<\\\\mathsf N^{\\\\rm g}_{\\\\rm LL}(\\\\vec d_{\\\\rm LL})\>\"",
      ",", "\n", "   ", "\"\<\\\\vec d^{\\\\,*}_{\\\\rm LL}\>\"", ",", 
     " ", "\"\<\\\\mathfrak m_{\\\\rm LL}\>\"", ",", 
     " ", "\"\<\\\\lvert\\\\Phi^{\\\\rm SF}_{\\\\rm LL}\\\\rangle\>\""}], 
    "}"}]}], ";"}], "\n", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"#", ",", " ", 
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"ToString", "[", 
             RowBox[{
              RowBox[{"SL31TeXToBoxes", "[", "#", "]"}], ",", " ", 
              "InputForm"}], "]"}], ",", " ", 
            RowBox[{"FontFamily", " ", "->", " ", "\"\<Source Code Pro\>\""}],
             ",", " ", "9"}], "]"}], ",", " ", 
          RowBox[{"RawBoxes", "[", 
           RowBox[{"SL31TeXToBoxes", "[", "#", "]"}], "]"}]}], "}"}], " ", 
        "&"}], ",", " ", "examples"}], "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"#", ",", " ", "Bold"}], "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<TeX\>\"", ",", " ", "\"\<boxes\>\"", ",", 
        " ", "\"\<displayed\>\""}], "}"}]}]}], "]"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}]}], "Input",
 CellLabel->"In[73]:=",ExpressionUUID->"71c4237f-1642-401c-96d4-d51a2fc91c18"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     StyleBox["\<\"TeX\"\>",
      StripOnInput->False,
      FontWeight->Bold], 
     StyleBox["\<\"boxes\"\>",
      StripOnInput->False,
      FontWeight->Bold], 
     StyleBox["\<\"displayed\"\>",
      StripOnInput->False,
      FontWeight->Bold]},
    {"\<\"\\\\Delta^{\\\\rm vac}_{\\\\rm LL}\"\>", 
     StyleBox["\<\"SubsuperscriptBox[\\\"\[CapitalDelta]\\\", \\\"LL\\\", \
\\\"vac\\\"]\"\>",
      StripOnInput->False,
      FontFamily->"Source Code Pro",
      FontSize->9], 
     SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"]},
    {"\<\"A^\\\\iota_{{\\\\rm LL},p}\"\>", 
     StyleBox["\<\"SubsuperscriptBox[\\\"A\\\", RowBox[{\\\"LL\\\", \
\\\",\\\", \\\"p\\\"}], \\\"\[Iota]\\\"]\"\>",
      StripOnInput->False,
      FontFamily->"Source Code Pro",
      FontSize->9], 
     SubsuperscriptBox["A", 
      RowBox[{"LL", ",", "p"}], "\[Iota]"]},
    {"\<\"\\\\mathsf N^{\\\\rm g}_{\\\\rm LL}(\\\\vec d_{\\\\rm LL})\"\>", 
     StyleBox["\<\"RowBox[{SubsuperscriptBox[TagBox[StyleBox[\\\"N\\\", \
FontFamily -> \\\"Helvetica\\\", FontSlant -> \\\"Plain\\\"], \
\\\"SL31SansSerif\\\"], \\\"LL\\\", \\\"g\\\"], \\\"(\\\", \
SubscriptBox[OverscriptBox[\\\"d\\\", \\\"\[RightVector]\\\"], \\\"LL\\\"], \
\\\")\\\"}]\"\>",
      StripOnInput->False,
      FontFamily->"Source Code Pro",
      FontSize->9], 
     RowBox[{
      SubsuperscriptBox[
       TagBox[
        StyleBox["N",
         FontFamily->"Helvetica",
         FontSlant->"Plain"],
        "SL31SansSerif"], "LL", "g"], "(", 
      SubscriptBox[
       OverscriptBox["d", "\[RightVector]"], "LL"], ")"}]},
    {"\<\"\\\\vec d^{\\\\,*}_{\\\\rm LL}\"\>", 
     StyleBox["\<\"SubsuperscriptBox[OverscriptBox[\\\"d\\\", \\\"\
\[RightVector]\\\"], \\\"LL\\\", \\\"*\\\"]\"\>",
      StripOnInput->False,
      FontFamily->"Source Code Pro",
      FontSize->9], 
     SubsuperscriptBox[
      OverscriptBox["d", "\[RightVector]"], "LL", "*"]},
    {"\<\"\\\\mathfrak m_{\\\\rm LL}\"\>", 
     StyleBox["\<\"SubscriptBox[\\\"\[GothicM]\\\", \\\"LL\\\"]\"\>",
      StripOnInput->False,
      FontFamily->"Source Code Pro",
