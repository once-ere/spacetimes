                FontSize->1.1 Inherited,ExpressionUUID->
                "4c9767f3-3225-4596-bb68-7aae36522cbc"]
              }], "Text",
               FontFamily->"Source Sans Pro",
               FontSize->9.5,ExpressionUUID->
               "4ac14434-4938-4aa4-ba4a-ca7d79bf5b79"],
              ImageSize->290]},
            {
             PaneBox[
              TemplateBox[{
                TagBox[
                 StyleBox["u", FontWeight -> "Bold", FontSlant -> "Plain"], 
