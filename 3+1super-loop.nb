Cell[BoxData[
 TagBox[GridBox[{
    {
     StyleBox["\<\"check\"\>",
      StripOnInput->False,
      FontWeight->Bold], 
     StyleBox["\<\"result\"\>",
      StripOnInput->False,
      FontWeight->Bold], 
     StyleBox["\<\"statement\"\>",
      StripOnInput->False,
      FontWeight->Bold]},
    {"\<\"T2-SYM\"\>", 
     StyleBox["\<\"PASS\"\>",
      StripOnInput->False,
      LineColor->RGBColor[0, 
        Rational[2, 3], 0],
      FrontFaceColor->RGBColor[0, 
        Rational[2, 3], 0],
      BackFaceColor->RGBColor[0, 
        Rational[2, 3], 0],
      GraphicsColor->RGBColor[0, 
        Rational[2, 3], 0],
      FontColor->RGBColor[0, 
        Rational[2, 3], 
        0]], "\<\"every component of a registered family that is typed in an \
input cell of the notebook (collected from the source by the builder) is read \
as one atomic symbol, and its TeX is written from its printed form, without \
the internal name\"\>"},
    {"\<\"T2-RNG\"\>", 
     StyleBox["\<\"PASS\"\>",
      StripOnInput->False,
      LineColor->RGBColor[0, 
        Rational[2, 3], 0],
      FrontFaceColor->RGBColor[0, 
        Rational[2, 3], 0],
      BackFaceColor->RGBColor[0, 
        Rational[2, 3], 0],
      GraphicsColor->RGBColor[0, 
        Rational[2, 3], 0],
      FontColor->RGBColor[0, 
        Rational[2, 3], 
        0]], "\<\"the generator SplitMix64 gives, for the seed 2026111707, \
the integers and the uniform numbers of the original algorithm\"\>"},
    {"\<\"T2-LINALG\"\>", 
     StyleBox["\<\"PASS\"\>",
      StripOnInput->False,
      LineColor->RGBColor[0, 
        Rational[2, 3], 0],
      FrontFaceColor->RGBColor[0, 
        Rational[2, 3], 0],
      BackFaceColor->RGBColor[0, 
        Rational[2, 3], 0],
      GraphicsColor->RGBColor[0, 
        Rational[2, 3], 0],
      FontColor->RGBColor[0, 
        Rational[2, 3], 
        0]], "\<\"the rewritten eigensolver and matrix exponential of cmat.rs \
agree with Eigenvalues and MatrixExp of the Wolfram Language\"\>"},
    {"\<\"T2-IDA\"\>", 
     StyleBox["\<\"PASS\"\>",
      StripOnInput->False,
      LineColor->RGBColor[0, 
        Rational[2, 3], 0],
      FrontFaceColor->RGBColor[0, 
        Rational[2, 3], 0],
      BackFaceColor->RGBColor[0, 
        Rational[2, 3], 0],
      GraphicsColor->RGBColor[0, 
        Rational[2, 3], 0],
      FontColor->RGBColor[0, 
        Rational[2, 3], 
        0]], "\<\"the integrator IDA of SUNDIALS, used through NDSolve with \
Method -> \\\"IDA\\\": (a) on the decaying exponential (rtol = 1e-8, atol = \
1e-10, x_LL^0 from 0 to 25) the exact local error of every internal step is \
at most the tolerance rtol |value| + atol of the step, and the largest ratio \
of the local error to this tolerance exceeds 1/128 both while the solution is \
above 10 atol/rtol and after it has fallen below atol/(10 rtol): the \
tolerances of IDA are 10^-PrecisionGoal and 10^-AccuracyGoal; (b) on a \
Hermitian 2 x 2 matrix (rtol = 1e-10, atol = 1e-12, 21 output times up to 10) \
every local error is at most budget_step = rtol (norm of the state) + atol \
sqrt(4), the largest deviation from the solution by MatrixExp is at most \
budget_out, and the states of NDSolve are the cubic Hermite polynomials of \
the stored values and derivatives (tolerance 1e-12); (c) the function \
t2evolveIDAChecked, which makes these measurements for the checks of the \
later chapters, gives the same states and the same bounds as (b); the sum of \
its measured local errors is at most budget, and the largest deviation is at \
most the bound made with this sum in place of budget, which is at most \
budget_out\"\>"},
    {"\<\"GS-1\"\>", 
     StyleBox["\<\"PASS\"\>",
      StripOnInput->False,
      LineColor->RGBColor[0, 
        Rational[2, 3], 0],
      FrontFaceColor->RGBColor[0, 
        Rational[2, 3], 0],
      BackFaceColor->RGBColor[0, 
        Rational[2, 3], 0],
      GraphicsColor->RGBColor[0, 
        Rational[2, 3], 0],
      FontColor->RGBColor[0, 
        Rational[2, 3], 
        0]], "\<\"the Dirac matrices are built from the frame of R^(1,3)_LL; \
Clifford relations; gamma_ch = diag(-1,-1,1,1), C_LL = diag(eps2, -eps2), \
alpha^j = diag(-sigma_j, sigma_j), eps2 = M_LL(-e2)\"\>"},
    {"\<\"GS-2\"\>", 
     StyleBox["\<\"PASS\"\>",
      StripOnInput->False,
      LineColor->RGBColor[0, 
        Rational[2, 3], 0],
      FrontFaceColor->RGBColor[0, 
        Rational[2, 3], 0],
      BackFaceColor->RGBColor[0, 
        Rational[2, 3], 0],
      GraphicsColor->RGBColor[0, 
        Rational[2, 3], 0],
      FontColor->RGBColor[0, 
        Rational[2, 3], 
        0]], "\<\"the Lorentz generators of the super-loop on the Dirac \
spinor, sgen(J^j) = diag(-i sigma_j/2, -i sigma_j/2) = gamma^j' gamma^j''/2, \
sgen(K^j) = diag(-sigma_j/2, sigma_j/2) = gamma^0 gamma^j/2; the 27 relations \
of so(3,1); 24 intertwining relations [gamma^p, sgen(u)] = sum V(u)[p][q] \
gamma^q\"\>"},
    {"\<\"GS-3\"\>", 
     StyleBox["\<\"PASS\"\>",
      StripOnInput->False,
      LineColor->RGBColor[0, 
        Rational[2, 3], 0],
      FrontFaceColor->RGBColor[0, 
        Rational[2, 3], 0],
      BackFaceColor->RGBColor[0, 
        Rational[2, 3], 0],
      GraphicsColor->RGBColor[0, 
        Rational[2, 3], 0],
      FontColor->RGBColor[0, 
        Rational[2, 3], 
        0]], "\<\"the gauge group SL(2,C) as a change of representation: \
Sspin^-1 gamma^p Sspin = sum Lmat[p][q] gamma^q and Sspin gamma^p[f] Sspin^-1 \
= gamma^p[gLt f gLt^dag] for 200 random gL and random Hermitian frames \
(tolerance 1e-10)\"\>"},
    {"\<\"GS-4\"\>", 
     StyleBox["\<\"PASS\"\>",
      StripOnInput->False,
      LineColor->RGBColor[0, 
        Rational[2, 3], 0],
      FrontFaceColor->RGBColor[0, 
        Rational[2, 3], 0],
      BackFaceColor->RGBColor[0, 
        Rational[2, 3], 0],
      GraphicsColor->RGBColor[0, 
        Rational[2, 3], 0],
      FontColor->RGBColor[0, 
        Rational[2, 3], 
        0]], "\<\"isospin T^iota obeys [T^a, T^b] = i eps T^c and commutes \
with the Lorentz generators; the pair matrices Kch_iota are antisymmetric, \
Lorentz invariant and an isospin vector (100 random gL and U); Psi^T Kch Psi \
= 0 for a c-number spinor (tolerance 1e-10)\"\>"},
    {"\<\"GS-5\"\>", 
     StyleBox["\<\"PASS\"\>",
      StripOnInput->False,
      LineColor->RGBColor[0, 
        Rational[2, 3], 0],
      FrontFaceColor->RGBColor[0, 
        Rational[2, 3], 0],
      BackFaceColor->RGBColor[0, 
        Rational[2, 3], 0],
      GraphicsColor->RGBColor[0, 
        Rational[2, 3], 0],
      FontColor->RGBColor[0, 
        Rational[2, 3], 
        0]], "\<\"gauge covariance of the covariant derivative: nabla'_p \
(Ucal Psi) = Ucal nabla_p Psi for Ucal(x) = exp(i thF) Sspin(gL(x)) (x) U(x), \
with the transformed AF, Av and Gamma (20 random points, central differences \
with the step 1e-5; relative tolerance 1e-7)\"\>"},
    {"\<\"GS-6\"\>", 
     StyleBox["\<\"PASS\"\>",
      StripOnInput->False,
      LineColor->RGBColor[0, 
        Rational[2, 3], 0],
      FrontFaceColor->RGBColor[0, 
        Rational[2, 3], 0],
      BackFaceColor->RGBColor[0, 
        Rational[2, 3], 0],
      GraphicsColor->RGBColor[0, 
        Rational[2, 3], 0],
      FontColor->RGBColor[0, 
        Rational[2, 3], 
        0]], "\<\"the commutator of two covariant derivatives is the \
curvature of the gauge group: [nabla_p, nabla_q] Psi = (Rc_pq - i g_v \
Fv^iota_pq T^iota - i g_F FF_pq) Psi (20 random points, all 12 ordered pairs; \
central differences with the step 1e-4; relative tolerance 1e-6)\"\>"},
    {"\<\"GS-7\"\>", 
     StyleBox["\<\"PASS\"\>",
      StripOnInput->False,
      LineColor->RGBColor[0, 
        Rational[2, 3], 0],
      FrontFaceColor->RGBColor[0, 
        Rational[2, 3], 0],
      BackFaceColor->RGBColor[0, 
        Rational[2, 3], 0],
      GraphicsColor->RGBColor[0, 
        Rational[2, 3], 0],
      FontColor->RGBColor[0, 
        Rational[2, 3], 
        0]], "\<\"the super-loop form of the Dirac operator: gamma^p nabla_p \
has the Weyl blocks M_LL(D) and M_LL(conj D) and no diagonal blocks; \
(gamma.nabla)^2 = eta nabla nabla + (1/4)[gamma^p, gamma^q][nabla_p, \
nabla_q]; for a free plane wave M_LL(D) M_LL(conj D) = -N_LL(k) sigma_0 (50 \
random momenta and fields; tolerance 1e-12)\"\>"},
    {"\<\"GS-8\"\>", 
     StyleBox["\<\"PASS\"\>",
      StripOnInput->False,
      LineColor->RGBColor[0, 
        Rational[2, 3], 0],
      FrontFaceColor->RGBColor[0, 
        Rational[2, 3], 0],
      BackFaceColor->RGBColor[0, 
        Rational[2, 3], 0],
      GraphicsColor->RGBColor[0, 
        Rational[2, 3], 0],
      FontColor->RGBColor[0, 
        Rational[2, 3], 
        0]], "\<\"the Dirac-Bogoliubov-de Gennes operator H_DB(q) with \
constant gauge fields is Hermitian and particle-hole symmetric (50 random \
momenta, fields and order parameters); for the polar order parameter (0, 0, \
Delta) its spectrum is +-E^(+-), each four times (30 random momenta; m = 0.4, \
mu = 0.3; tolerance 1e-10)\"\>"},
    {"\<\"GS-9\"\>", 
     StyleBox["\<\"PASS\"\>",
      StripOnInput->False,
      LineColor->RGBColor[0, 
        Rational[2, 3], 0],
      FrontFaceColor->RGBColor[0, 
        Rational[2, 3], 0],
      BackFaceColor->RGBColor[0, 
        Rational[2, 3], 0],
      GraphicsColor->RGBColor[0, 
        Rational[2, 3], 0],
      FontColor->RGBColor[0, 
        Rational[2, 3], 
        0]], "\<\"the self-consistency of the mean field: for the polar order \
parameter the sum over the eight positive-energy eigenvectors of psi_p^T \
Kch_3 conj(psi_h) equals -2 Delta (1/E^+ + 1/E^-), so that the mode-sum form \
of the mean-field equations gives the gap equation 1/G = int d^3q/(2 pi)^3 \
(1/E^+ + 1/E^-) (30 random momenta; tolerance 1e-10)\"\>"},
    {"\<\"GS-10\"\>", 
     StyleBox["\<\"PASS\"\>",
      StripOnInput->False,
      LineColor->RGBColor[0, 
        Rational[2, 3], 0],
      FrontFaceColor->RGBColor[0, 
        Rational[2, 3], 0],
      BackFaceColor->RGBColor[0, 
        Rational[2, 3], 0],
      GraphicsColor->RGBColor[0, 
        Rational[2, 3], 0],
      FontColor->RGBColor[0, 
        Rational[2, 3], 
        0]], "\<\"the lattice operator H_lat on a 3 x 2 x 4 lattice (dx = \
0.7, r_W = 1, periodic in x and z) with random links, potentials and order \
parameters is Hermitian, particle-hole symmetric and exactly gauge covariant; \
on a free periodic chain of 12 sites its spectrum is +-eps_lat, each eight \
times; the Wilson term lifts the doubler to m + 2 r_W/dx; the spectral radius \
stays below the bound Hbound (tolerance 1e-10)\"\>"},
    {"\<\"GS-11\"\>", 
     StyleBox["\<\"PASS\"\>",
      StripOnInput->False,
      LineColor->RGBColor[0, 
        Rational[2, 3], 0],
      FrontFaceColor->RGBColor[0, 
        Rational[2, 3], 0],
      BackFaceColor->RGBColor[0, 
        Rational[2, 3], 0],
      GraphicsColor->RGBColor[0, 
        Rational[2, 3], 0],
      FontColor->RGBColor[0, 
        Rational[2, 3], 
        0]], "\<\"the Hermitian eigensolver of t2core (Householder reduction \
and implicit QL), rewritten above: for random Hermitian matrices of the \
dimensions 7, 64 and 200 the eigenvectors are orthonormal and reproduce the \
matrix (relative tolerance 1e-11)\"\>"},
    {"\<\"GS-12\"\>", 
     StyleBox["\<\"PASS\"\>",
      StripOnInput->False,
      LineColor->RGBColor[0, 
        Rational[2, 3], 0],
      FrontFaceColor->RGBColor[0, 
        Rational[2, 3], 0],
      BackFaceColor->RGBColor[0, 
        Rational[2, 3], 0],
      GraphicsColor->RGBColor[0, 
        Rational[2, 3], 0],
      FontColor->RGBColor[0, 
        Rational[2, 3], 
        0]], "\<\"the printed formulas agree with the matrices that they \
describe: the entries of Ppair (symbolic d), of the blocks of sgen(u_p) and \
of Gamma_p, the expansions of the covariant derivatives, the sixteen \
equations of the Dirac-Bogoliubov-de Gennes system, the pair operators Pi and \
the eight exact equations, each evaluated for numbers assigned to its symbols \
and compared with the matrix computation (tolerance 1e-12)\"\>"},
    {"\<\"GS-13\"\>", 
     StyleBox["\<\"PASS\"\>",
      StripOnInput->False,
      LineColor->RGBColor[0, 
        Rational[2, 3], 0],
      FrontFaceColor->RGBColor[0, 
        Rational[2, 3], 0],
      BackFaceColor->RGBColor[0, 
        Rational[2, 3], 0],
      GraphicsColor->RGBColor[0, 
        Rational[2, 3], 0],
      FontColor->RGBColor[0, 
        Rational[2, 3], 
        0]], "\<\"time integration: the lattice equations (i times the \
derivative of the Nambu mode w_lat with respect to the time x_LL^0 equals \
H_lat w_lat) are integrated by IDA (SUNDIALS, through NDSolve with Method -> \
\\\"IDA\\\": backward differentiation formulas of the orders 1 to 5 with \
local error control and Newton's method; the tolerance of every real unknown \
is rtol times its modulus plus atol) in place of CVODE of the original \
program; on the 3 x 2 x 4 lattice of GS-10 (384 complex components), from the \
random initial state of the norm 1 of the original program, for each of rtol \
= 1e-8, 1e-10, 1e-12 (atol = rtol/100): (1) the exact local error local_error \
of every internal step is at most budget_step = rtol (norm of the state) + \
atol sqrt(768); (2) the states at the 41 output times x_LL^0 = 0, 0.5, ..., \
20 are the cubic Hermite polynomials of the stored values and derivatives \
(tolerance 1e-12), and their largest relative deviation from the exact \
spectral solution w_exact is at most budget_out = (1 + h_IDA E_max/4) budget \
+ h_IDA deriv_residual/4 + (h_IDA E_max)^4/384 with budget = N_steps \
budget_step; (3) the largest deviation decreases from rtol = 1e-8 to 1e-10 to \
1e-12; (4) for rtol = 1e-12 it stays below 1e-9, and the norm of the state \
changes by less than 1e-10\"\>"},
    {"\<\"GS-14\"\>", 
     StyleBox["\<\"PASS\"\>",
      StripOnInput->False,
      LineColor->RGBColor[0, 
        Rational[2, 3], 0],
      FrontFaceColor->RGBColor[0, 
        Rational[2, 3], 0],
      BackFaceColor->RGBColor[0, 
        Rational[2, 3], 0],
      GraphicsColor->RGBColor[0, 
        Rational[2, 3], 0],
      FontColor->RGBColor[0, 
        Rational[2, 3], 
        0]], "\<\"the super-loop form of the Dirac isodoublet and of its \
field equations: (a) a frame matrix is the right multiplication of the spinor \
charge; (b) gamma^p[f] Psi(bSm, bSp) = Psi(bSp conj f_p, bSm f_p); (c) the \
gauge group acts by the automorphisms of the super-loop; (d) the covariant \
derivative acts through the derivations of B_LL; (e) the Dirac operator is \
sum_p R_(f_p) nabla_p (tolerance 1e-12, 1e-10 for (c))\"\>"},
    {"\<\"GS-15\"\>", 
     StyleBox["\<\"PASS\"\>",
      StripOnInput->False,
      LineColor->RGBColor[0, 
        Rational[2, 3], 0],
      FrontFaceColor->RGBColor[0, 
        Rational[2, 3], 0],
      BackFaceColor->RGBColor[0, 
        Rational[2, 3], 0],
      GraphicsColor->RGBColor[0, 
        Rational[2, 3], 0],
      FontColor->RGBColor[0, 
        Rational[2, 3], 
        0]], "\<\"the Lorentz connection is fixed by the frame: for an \
x-dependent Lorentz transformation the connection -(d_p Sspin) Sspin^-1 has \
the form sgen(u), the Dirac matrices of the transformed frame are covariantly \
constant and the curvature vanishes (20 random points; tolerance 1e-6); the \
24 commutators [sgen(J^j), gamma^q], [sgen(K^j), gamma^q] have the rank 6 \
(smallest Gram eigenvalue > 1e-6)\"\>"},
    {"\<\"GS-16\"\>", 
     StyleBox["\<\"PASS\"\>",
      StripOnInput->False,
      LineColor->RGBColor[0, 
        Rational[2, 3], 0],
      FrontFaceColor->RGBColor[0, 
        Rational[2, 3], 0],
      BackFaceColor->RGBColor[0, 
        Rational[2, 3], 0],
      GraphicsColor->RGBColor[0, 
        Rational[2, 3], 0],
      FontColor->RGBColor[0, 
        Rational[2, 3], 
        0]], "\<\"the lattice operator of the solvers on plane waves: on a \
periodic chain of 24 sites (dx = 0.5, m = 0.4) the image of a plane wave is a \
plane wave of the same momentum, and the 16 x 16 matrix of the images has the \
eigenvalues -eps_lat (eightfold) and +eps_lat (eightfold) at all 24 momenta, \
for r_W = 0 and 1 (tolerance 1e-12)\"\>"},
    {"\<\"T2-DATA-1\"\>", 
     StyleBox["\<\"PASS\"\>",
      StripOnInput->False,
      LineColor->RGBColor[0, 
        Rational[2, 3], 0],
      FrontFaceColor->RGBColor[0, 
        Rational[2, 3], 0],
      BackFaceColor->RGBColor[0, 
        Rational[2, 3], 0],
      GraphicsColor->RGBColor[0, 
        Rational[2, 3], 0],
      FontColor->RGBColor[0, 
        Rational[2, 3], 
        0]], "\<\"the numbers of the figures agree with the data files \
written by the original program t2_fields: the 48 eigenvalues of the lattice \
operator and the 802 points of the curves of Figure 1 (tolerance 5.1e-11, \
half a unit of the last printed decimal); the file of the integrations by \
CVODE of Figure 2 has the 41 output times of GS-13 (tolerance 5.1e-5), and \
its relative deviations from the exact solution are below 1e-13 at x_LL^0 = \
0, stay below 1e-9 for rtol = 1e-12, and their largest values decrease from \
rtol = 1e-8 to 1e-10 to 1e-12, as the original check GS-13 states\"\>"}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Top}}},
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Output",
 CellChangeTimes->{4.004025506290551*^9},
 CellLabel->
  "Out[627]=",ExpressionUUID->"1d490a84-6e63-4e11-a818-3a65df061edb"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
II.3 Item [2]: analytic solutions of the field equations, and the checks AS-1 \
to AS-10 (program t2_analytic)\
\>", "Section",ExpressionUUID->"4ca86928-70ca-40cf-9e2d-f3098a9a6fbb"],

Cell[TextData[{
 "The program t2_analytic (t2analytic/src/main.rs) answers item [2] of Test \
2, which asks for an analysis of the field equations and for analytic \
solutions of simple cases. It solves the mean-field (Dirac-Bogoliubov-de \
Gennes) equations exactly in four cases and checks every solution twice: \
against the continuum equations, and against the lattice operator ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalH]",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["lat",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bb790ed0-37a6-420c-99bc-c2f7ecb7491b"],
 " of chapter II.1.4, the operator that the solvers of the items [3] and [5] \
integrate. The solutions are therefore also test problems with known answers \
for those solvers. The cases are: A, free spinor charges in constant gauge \
potentials (checks AS-1 and AS-2); B, the uniform polar superfluid (AS-3 to \
AS-6); C, a domain wall of the pair field (AS-7 to AS-9); D, constant \
magnetic fields (AS-10). The rewriting below keeps the order of the original \
program, because its random numbers are drawn in that order from one \
generator with the seed 2026111708; the checks AS-3, AS-7 and AS-8 draw \
random numbers, the others draw none. Every check prints one line with PASS \
or FAIL. The statement is that of the original report (in the two checks with \
a time integration, AS-2 and AS-4, it names IDA in place of CVODE and states \
what is required of IDA); the numbers in the details are the results of the \
Wolfram Language, followed by the values of the original report."
}], "Text",ExpressionUUID->"a6c4266f-62a7-4dcd-a0a2-f0b59152a9be"],

Cell[TextData[{
 StyleBox["The equations.",
  FontWeight->"Bold"],
 " All four cases are computed in the canonical gauge, in which the spin \
connection vanishes (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalGamma]", 
     StyleBox["p", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7fe33fcb-0511-4e06-8749-2ac52c0e5d71"],
 "); a gauge transformation carries every solution into any other gauge. A \
mode has the particle part ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Psi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1c4a2078-b34a-4132-a746-0181a8262b05"],
 " and the hole part ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Psi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["h",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0c2a29a7-6bd1-4c8f-aa4d-0ce8dfa28a1d"],
 ", each with the eight components of chapter II.1.3 (the components 1, 3, 5, \
7 have isospin up, the components 2, 4, 6, 8 isospin down). The mean-field \
equations are"
}], "Text",ExpressionUUID->"e34d0a20-b261-411c-8bcc-4c24fbc7f8f8"],

Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox["i", "TI"], 
   SubscriptBox["\[PartialD]", "0"], 
   SubsuperscriptBox["\[Psi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p",
     FontSlant->"Plain"]], "\[LongEqual]", 
   RowBox[{"(", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["h", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], "\[Del]"], "-", 
     SubscriptBox[
      StyleBox["A",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["LL",
        FontSlant->"Plain"], ",", "0"}]], "-", 
     SubscriptBox["\[Mu]", 
      StyleBox["LL",
       FontSlant->"Plain"]]}], ")"}], 
   SubsuperscriptBox["\[Psi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p",
     FontSlant->"Plain"]], "+", 
   SubscriptBox[
    StyleBox["P",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   SubsuperscriptBox["\[Psi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["h",
     FontSlant->"Plain"]]}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"9714cc99-585b-4d5f-a8ed-b885b80cd255"],

Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox["i", "TI"], 
   SubscriptBox["\[PartialD]", "0"], 
   SubsuperscriptBox["\[Psi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["h",
     FontSlant->"Plain"]], "\[LongEqual]", 
   SubsuperscriptBox[
    StyleBox["P",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Dagger]"], 
   SubsuperscriptBox["\[Psi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p",
     FontSlant->"Plain"]], "-", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["h", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "\[Del]"], "-", 
      SubscriptBox[
       StyleBox["A",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["LL",
         FontSlant->"Plain"], ",", "0"}]], "-", 
      SubscriptBox["\[Mu]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}], "*"], 
   SubsuperscriptBox["\[Psi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["h",
     FontSlant->"Plain"]]}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"4f0f7f7b-8020-4c39-9c97-e8e4517cd43d"],

Cell[TextData[{
 "with the covariant Dirac Hamiltonian ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["h", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Del]"], "\[LongEqual]", 
    RowBox[{"-", 
     StyleBox["i", "TI"]}], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", 
     StyleBox["j", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]], 
    SubsuperscriptBox["\[Del]", 
     StyleBox["j", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "+", 
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3d072296-92c9-4716-8ec7-a6ae1fe1133e"],
 ", the covariant derivative ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Del]", 
     StyleBox["j", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubscriptBox["\[PartialD]", 
     StyleBox["j", "TI"]], "-", 
    StyleBox["i", "TI"], 
    SubscriptBox[
     StyleBox["A",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["j", "TI"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "34c48ff0-266c-4a0f-a98c-d03c3177afc9"],
 ", the gauge matrices ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["A",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", "\[Iota]",
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], "\[Iota]"], 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Iota]"], "+", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], 
     StyleBox["F",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "8"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "596d9ebc-306c-4f69-9a7d-de9548fcd208"],
 " of the potentials, the chemical potential ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Mu]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "49e24f1f-bf9c-4c64-ba9d-8925ec7f7976"],
 ", and the pairing block ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["P",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", "\[Iota]",
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Iota]"], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "\[Iota]"], ")"}], "\[Dagger]"]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fed7ba13-042d-456a-9995-8d73e8bad3a7"],
 " of the order parameter ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["d", "TI"], "\[RightVector]"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["d", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "1"], ",", 
      SubsuperscriptBox[
       StyleBox["d", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "2"], ",", 
      SubsuperscriptBox[
       StyleBox["d", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a6203b78-517f-4102-98c4-bcfafee9b80c"],
 ". The matrices ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]], "\[LongEqual]", 
    StyleBox["diag",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       SubsuperscriptBox["\[Sigma]", 
        StyleBox["j", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"]]}], ",", 
      SubsuperscriptBox["\[Sigma]", 
       StyleBox["j", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f722c4c1-821d-46c9-b31d-b2992ab28e59"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], "0"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5ec2320b-e962-43cf-a9ad-92a9d5e9db62"],
 " act on the Dirac index, the potentials on the isospin index. The operator \
on the right side is the Dirac-Bogoliubov-de Gennes operator ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalH]",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["DB",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "eab5077b-a92c-4b79-b0b4-431be966a964"],
 "; a stationary mode depends on the time through the factor ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["exp",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       StyleBox["i", "TI"]}], 
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       RowBox[{
        StyleBox["LL",
         FontSlant->"Plain"], ",", 
        StyleBox["n", "TI"]}], 
       StyleBox["qp",
        FontSlant->"Plain"]], 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "0"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "270ab173-d0ea-4de8-aa64-4e4d4d2ab02f"],
 ", and its energy ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["E", "TI"], 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["n", "TI"]}], 
    StyleBox["qp",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f78c7220-8251-47a0-b930-c5f4483d5aa8"],
 " is an eigenvalue of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalH]",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["DB",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3a3f7e8f-ad69-4b7a-b598-3803a6ad4d3a"],
 ". If all fields are constant in space, the modes are plane waves, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["exp",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["i", "TI"], "\[ThinSpace]", 
      UnderscriptBox["\[Sum]", 
       StyleBox["j", "TI"],
       LimitsPositioning->True], "\[ThinSpace]", 
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["j", "TI"]], 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["j", "TI"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d27e883a-d160-4ec1-adb1-0c7d1385eedb"],
 " times a constant vector of 16 components, and the field equations are the \
eigenvalue problem of a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"16", "\[Times]", "16"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3a5b4f82-1f30-44f6-9d04-96521626a530"],
 " matrix."
}], "Text",ExpressionUUID->"97af060b-26bc-4a7c-b911-15d9816535b6"],

Cell[TextData[{
 StyleBox["The lattice of the checks.",
  FontWeight->"Bold"],
 " Every lattice of this chapter is a periodic chain (a ring) of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["x",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9ecbc6e9-8ab1-47d9-909e-0044a1bb85d2"],
 " sites along ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "1"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "50c7ab4b-af77-4d6f-a149-f851344b3aac"],
 ", with the spacing ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[ScriptL]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["x",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fc4dd037-4342-43fd-a6f4-c9f0a25805cd"],
 " and the Wilson coefficient ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["W",
      FontSlant->"Plain"]], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1542ac77-56c1-49db-ab30-e143bbf56914"],
 ". Its allowed momenta ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["q", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "1"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7d58b956-c354-4ad6-94a9-b23f5fe30d38"],
 " are the integer multiples of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Pi]", "/", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["n", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["x",
        FontSlant->"Plain"]], 
      SubsuperscriptBox["\[ScriptL]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["x",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ca28e344-5696-46ee-a0b7-dcafa6d857af"],
 "; the function ",
 StyleBox["t2chainMomentum",
  FontFamily->"Source Code Pro"],
 " returns the allowed momentum with a given number (counted from 0) in the \
interval from ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "\[Pi]"}], "/", 
    SubsuperscriptBox["\[ScriptL]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["x",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "53f4a865-f39b-4806-b391-da1ac58e0bc6"],
 " (excluded) to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Pi]", "/", 
    SubsuperscriptBox["\[ScriptL]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["x",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7327d7ee-099c-4b30-b35f-82b3bd8f753b"],
 " (included). If the fields are the same on every site, the lattice operator \
maps a plane wave to a plane wave of the same momentum, as in check GS-16; \
the function ",
 StyleBox["t2planeMatrix",
  FontFamily->"Source Code Pro"],
 " applies the operator to the 16 plane waves of one momentum (one for each \
component of a site) and returns the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"16", "\[Times]", "16"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fd8b3396-06e5-41ce-83b5-60e778780e1f"],
 " matrix of their images at the first site. The function ",
 StyleBox["t2h8",
  FontFamily->"Source Code Pro"],
 " returns the matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["h",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["q", "TI"], "\[RightVector]"], 
      StyleBox["LL",
       FontSlant->"Plain"]], ")"}], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", 
     StyleBox["j", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]], 
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]], "+", 
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "650eba53-8e54-4277-8587-28a335adfcd1"],
 " of a plane wave of the continuum, as an ",
 Cell[BoxData[
  FormBox[
   RowBox[{"8", "\[Times]", "8"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "697905c2-66e5-41cb-b658-b4f02704e925"],
 " matrix (it acts as the unit matrix on the isospin index). The cell also \
sets the seed and the matrices that several checks use; they are exact (their \
entries are the integers 0, 1, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c1289f20-671b-423b-8930-cc103364cd52"],
 " and the imaginary unit)."
}], "Text",ExpressionUUID->"cce8d6e3-7378-4616-9b0f-e9bc560aaaf1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "the", " ", "seed", " ", "of", " ", "the", " ", "program", " ", 
    "t2_analytic"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"t2Seed", "[", "2026111708", "]"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", "couplings", " ", 
      RowBox[{"g", "^", "v"}]}], ",", " ", 
     RowBox[{
      RowBox[{"g", "^", "F"}], " ", "and", " ", "the", " ", "mass", " ", 
      RowBox[{"m", ":", " ", 
       RowBox[{
       "the", " ", "same", " ", "numbers", " ", "as", " ", "in", " ", 
        "chapter", " ", "II", ".2", " ", 
        RowBox[{"(", 
         RowBox[{
         "the", " ", "original", " ", "program", " ", "sets", " ", "them", " ",
           "again"}], ")"}]}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"gv", " ", "=", " ", "0.7"}], ";", " ", 
    RowBox[{"gf", " ", "=", " ", "0.45"}], ";", " ", 
    RowBox[{"mass", " ", "=", " ", "0.4"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "a", " ", "chain", " ", "has", " ", "more", " ", "than", " ", "one", " ",
       "site", " ", "only", " ", "in", " ", "the", " ", "direction", " ", 
      RowBox[{"x", "^", "1"}]}], ":", " ", 
     RowBox[{
     "the", " ", "argument", " ", "of", " ", "t2epsLat", " ", "and", " ", 
      "t2hLatPlane", " ", "that", " ", "says", " ", "so"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"asChainActive", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"True", ",", " ", "False", ",", " ", "False"}], "}"}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", "places", " ", "of", " ", "the", " ", "isospin"}], "-", 
     RowBox[{"up", " ", "and", " ", "of", " ", "the", " ", "isospin"}], "-", 
     RowBox[{
     "down", " ", "components", " ", "among", " ", "the", " ", "eight", " ", 
      "components", " ", "of", " ", "a", " ", "site"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"asUpIndex", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "3", ",", " ", "5", ",", " ", "7"}], "}"}]}], ";",
     " ", 
    RowBox[{"asDownIndex", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "4", ",", " ", "6", ",", " ", "8"}], "}"}]}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "matrices", " ", "that", " ", "several", " ", "checks", " ", 
      
      RowBox[{"use", ":", " ", 
       RowBox[{"the", " ", "pair", " ", "matrix", " ", 
        RowBox[{"K", "^", "3"}], " ", "of", " ", "the", " ", "third", " ", 
        "isospin", " ", "direction", " ", "and", " ", "its", " ", "Hermitian",
         "\n", "   ", "conjugate"}]}]}], ",", " ", 
     RowBox[{"the", " ", "matrices", " ", 
      RowBox[{"alpha", "^", "1"}]}], ",", " ", 
     RowBox[{"alpha", "^", "2"}], ",", " ", 
     RowBox[{
      RowBox[{"alpha", "^", "3"}], " ", "and", " ", "beta", " ", "on", " ", 
      "the", " ", "eight", " ", "components", " ", 
      RowBox[{"(", 
       RowBox[{"Dirac", " ", 
        RowBox[{"(", "x", ")"}], " ", "isospin"}], ")"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"asK3", " ", "=", " ", 
     RowBox[{"t2kpair", "[", "3", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"asK3dag", " ", "=", " ", 
     RowBox[{"ConjugateTranspose", "[", "asK3", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"asAlpha", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"t2lift4", "[", 
        RowBox[{"t2alpha", "[", "j", "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"asBeta", " ", "=", " ", 
     RowBox[{"t2lift4", "[", "t2beta", "]"}]}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{" ", 
     RowBox[{
      RowBox[{
      "the", " ", "allowed", " ", "momentum", " ", "number", " ", "kq", " ", 
       RowBox[{"(", 
        RowBox[{"0", ",", " ", "1", ",", " ", "...", ",", " ", 
         RowBox[{"nsites", " ", "-", " ", "1"}]}], ")"}], " ", "of", " ", "a",
        " ", "periodic", " ", "chain", " ", "of", " ", "nsites", " ", "sites",
        " ", "with", " ", "the", " ", "spacing", " ", "ell"}], ",", "\n", 
      "   ", 
      RowBox[{"in", " ", "the", " ", "interval", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "pi"}], "/", "ell"}], ",", " ", 
         RowBox[{"pi", "/", "ell"}]}]}]}]}], "]"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2chainMomentum", "[", 
      RowBox[{"kq_Integer", ",", " ", "nsites_Integer", ",", " ", "ell_"}], 
      "]"}], " ", ":=", " ", 
     RowBox[{"2.", " ", "Pi", " ", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"kq", " ", "<=", " ", 
          RowBox[{"Quotient", "[", 
           RowBox[{"nsites", ",", " ", "2"}], "]"}]}], ",", " ", "kq", ",", 
         " ", 
         RowBox[{"kq", " ", "-", " ", "nsites"}]}], "]"}], "/", 
       RowBox[{"(", 
        RowBox[{"nsites", " ", "ell"}], ")"}]}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
      "the", " ", "16", " ", "x", " ", "16", " ", "matrix", " ", "of", " ", 
       "the", " ", "lattice", " ", "operator", " ", "on", " ", "the", " ", 
       "plane", " ", "waves", " ", "exp", 
       RowBox[{"(", 
        RowBox[{"i", " ", "q", " ", 
         RowBox[{"x", "^", "1"}]}], ")"}], " ", "e_b", " ", "of", " ", "a", " ",
        "periodic", " ", "chain", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"b", " ", "=", " ", 
          RowBox[{
           RowBox[{"1", ".."}], "16"}]}], ",", " ", 
         RowBox[{
         "the", "\n", "   ", "components", " ", "of", " ", "a", " ", 
          "site"}]}], ")"}]}], ":", " ", 
      RowBox[{
      "with", " ", "fields", " ", "that", " ", "are", " ", "the", " ", "same",
        " ", "on", " ", "every", " ", "site"}]}], ",", " ", 
     RowBox[{
      RowBox[{
      "the", " ", "image", " ", "of", " ", "a", " ", "plane", " ", "wave", " ",
        "is", " ", "a", " ", "plane", " ", "wave", " ", "of", "\n", "   ", 
       "the", " ", "same", " ", "momentum"}], ";", " ", 
      RowBox[{
      "its", " ", "16", " ", "components", " ", "at", " ", "the", " ", 
       "first", " ", "site", " ", "are", " ", "the", " ", "column", " ", 
       RowBox[{"b", ".", "  ", "The"}], " ", "16", " ", "plane", " ", "waves",
        " ", "are", " ", "the", " ", "columns", " ", "of", "\n", "   ", "the",
        " ", "matrix", " ", "planeWaves"}]}], ",", " ", 
     RowBox[{
     "to", " ", "which", " ", "t2apply", " ", "applies", " ", "the", " ", 
      "operator", " ", "column", " ", "by", " ", "column"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2planeMatrix", "[", 
      RowBox[{"lattice_", ",", " ", "fields_", ",", " ", "q_"}], "]"}], " ", ":=",
      " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"nsites", " ", "=", " ", 
          RowBox[{"t2nsites", "[", "lattice", "]"}]}], ",", " ", 
         "planeWaves"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"planeWaves", " ", "=", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Mod", "[", 
                RowBox[{
                 RowBox[{"row", " ", "-", " ", "1"}], ",", " ", "16"}], "]"}],
                " ", "+", " ", "1"}], " ", "==", " ", "b"}], ",", " ", 
             RowBox[{"Exp", "[", 
              RowBox[{"I", " ", "q", " ", 
               RowBox[{"lattice", "[", "\"\<ell\>\"", "]"}], " ", 
               RowBox[{"Quotient", "[", 
                RowBox[{
                 RowBox[{"row", " ", "-", " ", "1"}], ",", " ", "16"}], 
                "]"}]}], "]"}], ",", " ", 
             RowBox[{"0.", " ", "I"}]}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"row", ",", " ", 
             RowBox[{"16", " ", "nsites"}]}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"b", ",", " ", "16"}], "}"}]}], "]"}]}], ";", "\n", "   ", 
        RowBox[{
         RowBox[{"t2apply", "[", 
          RowBox[{"lattice", ",", " ", "fields", ",", " ", "planeWaves"}], 
          "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"1", " ", ";;", " ", "16"}], "]"}], "]"}]}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"h", 
       RowBox[{"(", "q", ")"}]}], " ", "=", " ", 
      RowBox[{
       RowBox[{"sum_j", " ", 
        RowBox[{"alpha", "^", "j"}], " ", "q_j"}], " ", "+", " ", 
       RowBox[{"beta", " ", "m", " ", "on", " ", "Dirac", " ", 
        RowBox[{"(", "x", ")"}], " ", "isospin", " ", 
        RowBox[{"(", 
         RowBox[{"8", " ", "x", " ", "8"}], ")"}]}]}]}], ",", " ", 
     RowBox[{
      RowBox[{"the", " ", "plane"}], "-", 
      RowBox[{
      "wave", " ", "Hamiltonian", " ", "of", " ", "the", " ", 
       "continuum"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2h8", "[", 
      RowBox[{"q_List", ",", " ", "m_"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"m", " ", "asBeta"}], " ", "+", " ", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"q", "[", 
          RowBox[{"[", "j", "]"}], "]"}], " ", 
         RowBox[{"asAlpha", "[", 
          RowBox[{"[", "j", "]"}], "]"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "numbers", " ", "in", " ", "the", " ", "details", " ", "of", " ", "the", 
      " ", 
      RowBox[{"checks", ":", " ", 
       RowBox[{
       "two", " ", "significant", " ", "digits", " ", "with", " ", "a", " ", 
        "power", " ", "of", " ", "ten"}]}]}], ";", " ", 
     RowBox[{"a", " ", "fixed", " ", "number", " ", "of", " ", "decimals"}]}],
     " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"asSci", "[", 
      RowBox[{"x_", "?", "NumericQ"}], "]"}], " ", ":=", " ", 
     RowBox[{"ScientificForm", "[", 
      RowBox[{"x", ",", " ", "2"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"asSci", "[", "l_List", "]"}], " ", ":=", " ", 
     RowBox[{"Row", "[", 
      RowBox[{"Riffle", "[", 
       RowBox[{
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"ScientificForm", "[", 
            RowBox[{"#", ",", " ", "2"}], "]"}], " ", "&"}], ",", " ", "l"}], 
         "]"}], ",", " ", "\"\<, \>\""}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"asFix", "[", 
      RowBox[{
       RowBox[{"x_", "?", "NumericQ"}], ",", " ", "decimals_Integer"}], "]"}],
      " ", ":=", " ", 
     RowBox[{"NumberForm", "[", 
      RowBox[{"x", ",", " ", 
       RowBox[{"{", 
        RowBox[{"20", ",", " ", "decimals"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "largest", " ", "deviation", " ", "of", " ", "the", " ", 
      "columns", " ", "cols", " ", "of", " ", "two", " ", "lists", " ", "of", 
      " ", "rows"}], ";", " ", 
     RowBox[{
     "Infinity", " ", "if", " ", "the", " ", "lists", " ", "have", " ", 
      "different", " ", "dimensions"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2rowsDeviation", "[", 
      RowBox[{"rowsHere_", ",", " ", "rowsOriginal_", ",", " ", "cols_"}], 
      "]"}], " ", ":=", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Dimensions", "[", "rowsHere", "]"}], " ", "===", " ", 
        RowBox[{"Dimensions", "[", "rowsOriginal", "]"}]}], ",", "\n", "   ", 
       
       RowBox[{"Max", "[", 
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"rowsHere", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "cols"}], "]"}], "]"}], " ", "-", " ", 
          RowBox[{"rowsOriginal", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "cols"}], "]"}], "]"}]}], "]"}], "]"}], ",",
        " ", "Infinity"}], "]"}]}], ";"}]}]}]], "Input",
 CellLabel->
  "In[628]:=",ExpressionUUID->"3564ca69-19e6-4020-b1c4-423156cbf049"],

Cell[CellGroupData[{

Cell["\<\
Case A: free spinor charges in constant gauge potentials (checks AS-1 and \
AS-2)\
\>", "Subsection",ExpressionUUID->"cc7d8059-4d11-4e30-89a5-6b8c0fdca17e"],

Cell[TextData[{
 StyleBox["The fields.",
  FontWeight->"Bold"],
 " No pair field (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["d", "TI"], "\[RightVector]"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b10945fa-89af-4a22-94d0-e3e78b08ab54"],
 "), and constant potentials of the fermion number and of the third isospin \
direction, ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["A", "TI"], 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}], 
    StyleBox["F",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f7ed3d56-8ed3-4202-a89e-3d1557e99d7e"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["A", "TI"], 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a896d4a4-4c75-47d2-b33c-cf1358d14bb6"],
 ", with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], "1"], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], "2"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "144bc38c-424b-49f2-b01d-0afe9422dece"],
 ". The generator ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7504528a-2cc3-4dc3-90fc-c18ddd3f3e0f"],
 " is diagonal, so the gauge matrix ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["A",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8a9ece1c-0ee8-4d97-9638-673956a0a5a4"],
 " is diagonal in the isospin index: it has the eigenvalue ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["A",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], "\[UpArrow]"], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], 
     StyleBox["F",
      FontSlant->"Plain"]], "+", 
    FractionBox["1", "2"], 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], "3"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ff0ed340-44cc-42cb-9191-1a75afdeb014"],
 " on the isospin-up components (the charge ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["Q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "3"], "\[LongEqual]", 
    RowBox[{"+", 
     FractionBox["1", "2"]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dd7c00b8-674e-4bd2-aeba-9aa0a13fea47"],
 ") and the eigenvalue ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["A",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], "\[DownArrow]"], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], 
     StyleBox["F",
      FontSlant->"Plain"]], "-", 
    FractionBox["1", "2"], 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], "3"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "21322d61-c3fb-4b68-8db2-67767040767c"],
 " on the isospin-down components (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["Q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"-", 
     FractionBox["1", "2"]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fa66a02c-c19f-4ca1-81ab-329869332ea6"],
 "). The field strengths vanish."
}], "Text",ExpressionUUID->"cb6fa3dc-9cb8-4b36-a422-d9729facb199"],

Cell[TextData[{
 StyleBox["The solution.",
  FontWeight->"Bold"],
 " Take a particle of isospin up, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Psi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p",
      FontSlant->"Plain"]], "\[LongEqual]", 
    StyleBox["exp",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["i", "TI"], "\[ThinSpace]", 
      UnderscriptBox["\[Sum]", 
       StyleBox["j", "TI"],
       LimitsPositioning->True], "\[ThinSpace]", 
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["j", "TI"]], 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["j", "TI"]], "-", 
      StyleBox["i", "TI"], 
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       RowBox[{
        StyleBox["LL",
         FontSlant->"Plain"], ",", 
        StyleBox["n", "TI"]}], 
       StyleBox["qp",
        FontSlant->"Plain"]], 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "0"]}], ")"}], 
    SubsuperscriptBox["\[Chi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["pw",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a277160c-2610-46d7-9eea-f66396d9db61"],
 " with a constant spinor ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Chi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["pw",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0ad13b97-365b-4719-9887-40dd599ab530"],
 " (a Dirac spinor times the isospin vector ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", ",", "0"}], ")"}], 
    StyleBox["T", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f951e2d6-4445-445d-82af-8ae26dba5173"],
 "), and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Psi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["h",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "06b9f93d-5d66-4ebe-b10d-a377d2310fda"],
 ". The covariant derivative gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Del]", 
     StyleBox["j", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Psi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p",
      FontSlant->"Plain"]], "\[LongEqual]", 
    StyleBox["i", "TI"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["j", "TI"]], "-", 
      SubsuperscriptBox[
       StyleBox["A",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["LL",
         FontSlant->"Plain"], ",", 
        StyleBox["j", "TI"]}], "\[UpArrow]"]}], ")"}], 
    SubsuperscriptBox["\[Psi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f1a4250f-97ef-4199-8148-dde8aed5db34"],
 ", and the field equations become the eigenvalue problem ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["E", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["n", "TI"]}], 
     StyleBox["qp",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Chi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["pw",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       StyleBox["j", "TI"],
       LimitsPositioning->True], "\[ThinSpace]", 
      SubsuperscriptBox["\[Alpha]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["j", "TI"]], 
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox[
         StyleBox["q", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], 
         StyleBox["j", "TI"]], "-", 
        SubsuperscriptBox[
         StyleBox["A",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], 
         RowBox[{
          StyleBox["LL",
           FontSlant->"Plain"], ",", 
          StyleBox["j", "TI"]}], "\[UpArrow]"]}], ")"}], "+", 
      SubscriptBox["\[Beta]", 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      SubscriptBox[
       StyleBox["m", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]], "-", 
      SubsuperscriptBox[
       StyleBox["A",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["LL",
         FontSlant->"Plain"], ",", "0"}], "\[UpArrow]"], "-", 
      SubscriptBox["\[Mu]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}], 
    SubsuperscriptBox["\[Chi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["pw",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4253aefe-849d-4e35-bed8-a95ab8d0890a"],
 ". The Dirac matrices obey ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[Alpha]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["j", "TI"]], ")"}], "2"], "\[LongEqual]", 
    SubsuperscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"], "2"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "22c334af-e982-446c-8a9f-862928d02821"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]], 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     SuperscriptBox[
      StyleBox["j", "TI"], "\[Prime]"]], "+", 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     SuperscriptBox[
      StyleBox["j", "TI"], "\[Prime]"]], 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "42e78662-93b8-45ac-91b3-ea16c50d7a2a"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["j", "TI"], "\[NotEqual]", 
    SuperscriptBox[
     StyleBox["j", "TI"], "\[Prime]"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3a1b4f43-5f5d-44a4-bd6f-e91a8f5e73fc"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]], 
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "+", 
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cc7d2c41-ff94-4d9c-b9e0-cddaaf39fc4f"],
 " (check GS-1). The matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["j", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["j", "TI"]], "-", 
      SubsuperscriptBox[
       StyleBox["A",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["LL",
         FontSlant->"Plain"], ",", 
        StyleBox["j", "TI"]}], "\[UpArrow]"]}], ")"}], "+", 
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c95d88af-da12-4c2a-96a1-c019ff767626"],
 " therefore squares to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["j", "TI"],
     LimitsPositioning->True], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["q", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], 
        StyleBox["j", "TI"]], "-", 
       SubsuperscriptBox[
        StyleBox["A",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["LL",
          FontSlant->"Plain"], ",", 
         StyleBox["j", "TI"]}], "\[UpArrow]"]}], ")"}], "2"], "+", 
    SubsuperscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7c0c7600-22c1-4d29-b3c2-87a5eb13d181"],
 " times the unit matrix, and its eigenvalues are the two square roots of \
this number, each twice. A hole (with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Psi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7c915a6a-9d29-406b-8773-f88081685748"],
 ") obeys the second field equation, whose operator ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["h", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], "\[Del]"], "-", 
       SubscriptBox[
        StyleBox["A",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["LL",
          FontSlant->"Plain"], ",", "0"}]], "-", 
       SubscriptBox["\[Mu]", 
        StyleBox["LL",
         FontSlant->"Plain"]]}], ")"}], "*"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0ffcb0f8-7032-4235-8654-41821c5bd57f"],
 " contains the charges with the opposite sign. The energies of the \
isospin-up components are, each twice,"
}], "Text",ExpressionUUID->"0be7367d-bd7c-451b-a4db-024454fbb352"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["E", "TI"], 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["n", "TI"]}], 
    StyleBox["qp",
     FontSlant->"Plain"]], "\[LongEqual]", 
   RowBox[{"\[PlusMinus]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       UnderscriptBox["\[Sum]", 
        StyleBox["j", "TI"],
        LimitsPositioning->True], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubsuperscriptBox[
           StyleBox["q", "TI"], 
           StyleBox["LL",
            FontSlant->"Plain"], 
           StyleBox["j", "TI"]], "-", 
          SubsuperscriptBox[
           StyleBox["A",
            FontFamily->"Helvetica",
            FontSlant->"Plain"], 
           RowBox[{
            StyleBox["LL",
             FontSlant->"Plain"], ",", 
            StyleBox["j", "TI"]}], "\[UpArrow]"]}], ")"}], "2"], "+", 
       SubsuperscriptBox[
        StyleBox["m", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], "2"]}], ")"}], 
     RowBox[{"1", "/", "2"}]]}], "-", 
   SubsuperscriptBox[
    StyleBox["A",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", "0"}], "\[UpArrow]"], "-", 
   SubscriptBox["\[Mu]", 
    StyleBox["LL",
     FontSlant->"Plain"]], "   ", 
   StyleBox[
    RowBox[{"(", "particles", ")"}],
    FontSlant->"Plain"], ",", "      ", 
   SubsuperscriptBox[
    StyleBox["E", "TI"], 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["n", "TI"]}], 
    StyleBox["qp",
     FontSlant->"Plain"]], "\[LongEqual]", 
   RowBox[{"\[MinusPlus]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       UnderscriptBox["\[Sum]", 
        StyleBox["j", "TI"],
        LimitsPositioning->True], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubsuperscriptBox[
           StyleBox["q", "TI"], 
           StyleBox["LL",
            FontSlant->"Plain"], 
           StyleBox["j", "TI"]], "+", 
          SubsuperscriptBox[
           StyleBox["A",
            FontFamily->"Helvetica",
            FontSlant->"Plain"], 
           RowBox[{
            StyleBox["LL",
             FontSlant->"Plain"], ",", 
            StyleBox["j", "TI"]}], "\[UpArrow]"]}], ")"}], "2"], "+", 
       SubsuperscriptBox[
        StyleBox["m", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], "2"]}], ")"}], 
     RowBox[{"1", "/", "2"}]]}], "+", 
   SubsuperscriptBox[
    StyleBox["A",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", "0"}], "\[UpArrow]"], "+", 
   SubscriptBox["\[Mu]", 
    StyleBox["LL",
     FontSlant->"Plain"]], "   ", 
   StyleBox[
    RowBox[{"(", "holes", ")"}],
    FontSlant->"Plain"]}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"5d214984-4229-4baa-9efa-b92175deff42"],

Cell[TextData[{
 "and those of the isospin-down components are the same with ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["A",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}], "\[DownArrow]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5d1e3185-e97f-4df0-bba8-c291a2155946"],
 " in place of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["A",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}], "\[UpArrow]"], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "408ebc1c-6dc2-4eb8-b8ce-cbaaba43f345"],
 ". On the lattice the square roots are replaced by the lattice energy ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CurlyEpsilon]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["lat",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8810de39-81b1-4321-8c6b-ce2fe0d7d3be"],
 " of check GS-16 at the shifted momenta. This is exact: the link matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["U",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", "1"}], 
     StyleBox["link",
      FontSlant->"Plain"]], "\[LongEqual]", 
    StyleBox["exp",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       StyleBox["i", "TI"]}], 
      SubsuperscriptBox["\[ScriptL]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["x",
        FontSlant->"Plain"]], 
      SubscriptBox[
       StyleBox["A",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["LL",
         FontSlant->"Plain"], ",", "1"}]]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d3beb748-8783-4b47-a199-b629b4e89e0a"],
 " multiplies the plane wave at the next site by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["exp",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       StyleBox["i", "TI"]}], 
      SubsuperscriptBox["\[ScriptL]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["x",
        FontSlant->"Plain"]], 
      SubsuperscriptBox[
       StyleBox["A",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["LL",
         FontSlant->"Plain"], ",", "1"}], "\[UpArrow]"]}], ")"}]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "df6dce8b-6eef-494f-95fa-3ec2ed4f537e"],
 ", which shifts the momentum in the differences of the lattice operator by \
exactly ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["A",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", "1"}], "\[UpArrow]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8c61c2f4-15ac-489a-a448-7654cd40caf1"],
 "."
}], "Text",ExpressionUUID->"e9d16d14-2c18-4ac0-98e3-43d7cfc1a7a0"],

Cell[TextData[{
 StyleBox["What it shows.",
  FontWeight->"Bold"],
 " The space components of a potential shift the momentum (minimal coupling): \
the plane wave with the label ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["q", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "1"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0b5976b0-f017-4c40-8101-d6e45412710f"],
 " has its lowest energy at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["A",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", "1"}], "\[UpArrow]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f3a06c35-8d27-46b0-afa1-7874cceeaff3"],
 ". The time component shifts the energy, exactly as a change of the chemical \
potential would. In infinite space a gauge transformation removes both \
shifts. On a ring the gauge function would have to be periodic, and it is \
periodic only if ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["exp",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["i", "TI"], 
      SubscriptBox[
       StyleBox["A",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["LL",
         FontSlant->"Plain"], ",", "1"}]], 
      SubsuperscriptBox[
       StyleBox["n", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["x",
        FontSlant->"Plain"]], 
      SubsuperscriptBox["\[ScriptL]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["x",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "03a54e3e-cc59-4dbe-afab-67e726ada629"],
 " is the unit matrix. This matrix is the product of the link matrices around \
the ring (a Wilson loop), which no gauge transformation changes; if it is not \
the unit matrix, the ring encloses a flux, and the energies at the allowed \
momenta are truly shifted (the Aharonov-Bohm effect). Check AS-1 uses a ring \
of 32 sites (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[ScriptL]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["x",
      FontSlant->"Plain"]], "\[LongEqual]", "0.5"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7c0c0077-f3e2-4cd4-81bb-c1f5139736e7"],
 ", circumference 16, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0.4"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "29ceb72e-1405-4c27-82f9-ff97480ba186"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Mu]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0.2"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "10e86c00-54cd-4ee0-9294-42b548ca381d"],
 ") with the potentials ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", "1"}], "3"], "\[LongEqual]", "0.8"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c290e551-e8fe-4c9e-9cca-e8ef65e7c11c"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", "1"}], 
     StyleBox["F",
      FontSlant->"Plain"]], "\[LongEqual]", "0.6"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b6b0cede-9601-4fb3-aefc-c99e4fddaf77"],
 " in the links and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", "0"}], "3"], "\[LongEqual]", "0.5"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "06173c62-742b-47e1-bf54-44328bee5a09"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", "0"}], 
     StyleBox["F",
      FontSlant->"Plain"]], "\[LongEqual]", "0.3"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f6b0f7ba-b4a2-420a-b31d-6a9976944bbd"],
 " in the potential matrix, so that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["A",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", "1"}], "\[UpArrow]"], "\[LongEqual]", 
    "0.55"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6f952a58-7f27-41ca-b43f-05ba9ddb0dd1"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["A",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", "1"}], "\[DownArrow]"], "\[LongEqual]", 
    RowBox[{"-", "0.01"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c3b8ff55-4a90-49e1-9d3c-0d8436dfd1c6"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["A",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", "0"}], "\[UpArrow]"], "\[LongEqual]", 
    "0.31"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7061db21-8767-4cb5-bfbb-52a7e958bd1b"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["A",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", "0"}], "\[DownArrow]"], "\[LongEqual]", 
    RowBox[{"-", "0.04"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3b7a4aa3-a15e-4a8e-9a04-6e4d3c9481fa"],
 ". For every allowed momentum it compares the 16 eigenvalues of ",
 StyleBox["t2planeMatrix",
  FontFamily->"Source Code Pro"],
 " with the formula, restricts the particle block (the rows and columns 1 to \
8) to each isospin component and compares its four eigenvalues with the \
formula, and checks that the particle block does not connect the two isospin \
components. Figure 3(a) shows the energies of the particle block."
}], "Text",ExpressionUUID->"9e45f018-26a7-4698-8243-dbbc49b532cc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"AS", "-", "1"}], ":", " ", 
     RowBox[{"the", " ", "potentials", " ", 
      RowBox[{"Av", "^", "3"}], "_", "1"}]}], ",", " ", 
    RowBox[{"AF_", "1", " ", 
     RowBox[{"(", 
      RowBox[{"in", " ", "the", " ", "links"}], ")"}]}], ",", " ", 
    RowBox[{
     RowBox[{"Av", "^", "3"}], "_", "0"}], ",", " ", 
    RowBox[{"AF_", "0", " ", 
     RowBox[{"(", 
      RowBox[{"in", " ", "the", " ", "potential", " ", "matrix"}], ")"}]}], ",",
     " ", 
    RowBox[{
     RowBox[{"the", " ", "chemical", " ", "potential"}], ";", "\n", "   ", 
     RowBox[{
     "a", " ", "chain", " ", "of", " ", "32", " ", "sites", " ", "with", " ", 
      "the", " ", "spacing", " ", "0.5"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "as1Av31", ",", " ", "as1AF1", ",", " ", "as1Av30", ",", " ", "as1AF0", 
       ",", " ", "as1Mu"}], "}"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
      "0.8", ",", " ", "0.6", ",", " ", "0.5", ",", " ", "0.3", ",", " ", 
       "0.2"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"as1N", ",", " ", "as1Ell"}], "}"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"32", ",", " ", "0.5"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as1Lat", " ", "=", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<n\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"as1N", ",", " ", "1", ",", " ", "1"}], "}"}]}], ",", " ", 
       RowBox[{"\"\<ell\>\"", " ", "->", " ", "as1Ell"}], ",", " ", 
       RowBox[{"\"\<periodic\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"True", ",", " ", "False", ",", " ", "False"}], "}"}]}], ",",
        " ", 
       RowBox[{"\"\<wilson\>\"", " ", "->", " ", "1.0"}], ",", " ", 
       RowBox[{"\"\<mass\>\"", " ", "->", " ", "mass"}], ",", " ", 
       RowBox[{"\"\<mu\>\"", " ", "->", " ", "as1Mu"}]}], "|>"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as1Fields", " ", "=", " ", 
     RowBox[{"t2trivialFields", "[", "as1N", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"as1Fields", "[", 
         RowBox[{"[", 
          RowBox[{"\"\<links\>\"", ",", " ", "site", ",", " ", "1"}], "]"}], 
         "]"}], " ", "=", " ", 
        RowBox[{"t2link", "[", 
         RowBox[{"gv", ",", " ", "gf", ",", " ", 
          RowBox[{"{", 
           RowBox[{"0.", ",", " ", "0.", ",", " ", "as1Av31"}], "}"}], ",", 
          " ", "as1AF1", ",", " ", "as1Ell"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{
        RowBox[{"as1Fields", "[", 
         RowBox[{"[", 
          RowBox[{"\"\<v0\>\"", ",", " ", "site"}], "]"}], "]"}], " ", "=", 
        " ", 
        RowBox[{"t2potential", "[", 
         RowBox[{"gv", ",", " ", "gf", ",", " ", 
          RowBox[{"{", 
           RowBox[{"0.", ",", " ", "0.", ",", " ", "as1Av30"}], "}"}], ",", 
          " ", "as1AF0"}], "]"}]}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"site", ",", " ", "as1N"}], "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "Acal_p", " ", "of", " ", "the", " ", "isospin", " ", "component", " ", 
      "with", " ", "the", " ", "charge", " ", "qq"}], " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"+", "1"}], "/", "2"}], " ", 
         RowBox[{"(", "up", ")"}], " ", "or"}], " ", "-", 
        RowBox[{
         RowBox[{"1", "/", "2"}], " ", 
         RowBox[{"(", "down", ")"}]}]}], ":", " ", "p"}], " ", "=", " ", 
      RowBox[{
       RowBox[{"1", " ", "and", " ", "p"}], " ", "=", " ", "0"}]}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"as1Acal1", "[", "qq_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"gf", " ", "as1AF1"}], " ", "+", " ", 
      RowBox[{"qq", " ", "gv", " ", "as1Av31"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"as1Acal0", "[", "qq_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"gf", " ", "as1AF0"}], " ", "+", " ", 
      RowBox[{"qq", " ", "gv", " ", "as1Av30"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as1Dev", " ", "=", " ", "0."}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", "rows", " ", 
      RowBox[{"{", 
       RowBox[{"q", ",", " ", "Q_LL", ",", " ", "E_qp"}], "}"}], " ", "of", " ",
       "the", " ", "points", " ", "of", " ", "Figure", " ", "3", 
      RowBox[{"(", "a", ")"}]}], ",", " ", 
     RowBox[{
     "in", " ", "the", " ", "order", " ", "of", " ", "the", " ", "original", " ",
       "data", " ", "file"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"as1LatticeRows", " ", "=", " ", 
     RowBox[{"{", "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"q", " ", "=", " ", 
           RowBox[{"t2chainMomentum", "[", 
            RowBox[{"kq", ",", " ", "as1N", ",", " ", "as1Ell"}], "]"}]}], ",",
           " ", "m16", ",", " ", "ev", ",", " ", "expect", ",", " ", 
          "pblock"}], "}"}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{"m16", " ", "=", " ", 
          RowBox[{"t2planeMatrix", "[", 
           RowBox[{"as1Lat", ",", " ", "as1Fields", ",", " ", "q"}], "]"}]}], 
         ";", "\n", "   ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{"all", " ", "16", " ", 
            RowBox[{"eigenvalues", ":", " ", 
             RowBox[{"particles", " ", "+", 
              RowBox[{
               RowBox[{"-", "eps_lat"}], 
               RowBox[{"(", 
                RowBox[{"q", " ", "-", " ", 
                 RowBox[{"Acal_", "1"}]}], ")"}]}], " ", "-", " ", 
              RowBox[{"Acal_", "0"}], " ", "-", " ", "mu"}]}]}], ",", " ", 
           RowBox[{"holes", " ", "-", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"+", 
                RowBox[{"-", "eps_lat"}]}], 
               RowBox[{"(", 
                RowBox[{"q", " ", "+", " ", 
                 RowBox[{"Acal_", "1"}]}], ")"}]}], " ", "-", " ", 
              RowBox[{"Acal_", "0"}], " ", "-", " ", "mu"}], ")"}]}], ",", 
           " ", 
           RowBox[{"each", " ", "twice"}]}], " ", "*)"}], "\n", "   ", 
         RowBox[{"ev", " ", "=", " ", 
          RowBox[{"First", "[", 
           RowBox[{"t2eigh", "[", "m16", "]"}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"expect", " ", "=", " ", 
          RowBox[{"Sort", "[", 
           RowBox[{"Flatten", "[", 
            RowBox[{"Table", "[", "\n", "       ", 
             RowBox[{
              RowBox[{"With", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"ep", " ", "=", " ", 
                   RowBox[{"t2epsLat", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"q", " ", "-", " ", 
                    RowBox[{"as1Acal1", "[", "qq", "]"}]}], ",", " ", "0.", ",",
                     " ", "0."}], "}"}], ",", " ", "as1Ell", ",", " ", "mass",
                     ",", " ", "1.0", ",", " ", "asChainActive"}], "]"}]}], ",",
                   "\n", "         ", 
                  RowBox[{"eh", " ", "=", " ", 
                   RowBox[{"t2epsLat", "[", 
