       RowBox[{"1", " ", ";;", " ", "3"}], "]"}], "]"}]}], "]"}], ",", " ", 
   RowBox[{"Spacings", " ", "->", " ", "2"}]}], "]"}]], "Input",
 CellLabel->
  "In[225]:=",ExpressionUUID->"36eb04f7-da9d-4204-bd14-2178d5a4dfcc"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TagBox[GridBox[{
        {
         StyleBox["\<\"1 Indices, conventions and number sets\"\>",
          StripOnInput->False,
          FontSize->12,
          FontWeight->Bold]},
        {
         TagBox[GridBox[{
            {
             StyleBox["\<\"symbol\"\>",
              StripOnInput->False,
              FontFamily->"Source Sans Pro",
              FontWeight->Bold], 
             StyleBox["\<\"plain-text names\"\>",
              StripOnInput->False,
              FontFamily->"Source Sans Pro",
              FontWeight->Bold], 
             StyleBox["\<\"meaning\"\>",
              StripOnInput->False,
              FontFamily->"Source Sans Pro",
              FontWeight->Bold]},
            {
             PaneBox[
              TemplateBox[{"i", "\", \"", "j"},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              StyleBox["\<\"j j' j''\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[Cell[TextData[{
               
               "index of space-like coordinates; values 1, 2, 3 (ordinary \
space) unless a sum is said to run over all space-like coordinates of the \
spacetime. In Revision_SuperLoop only ",
               Cell[BoxData[
                FormBox[
                 StyleBox["j", "TI"], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "cf3235ee-faaa-4561-8a67-353951bff204"],
               
               " is used as an index, with the values 1, 2, 3, and with \
primes (",
               Cell[BoxData[
                FormBox[
                 SuperscriptBox[
                  StyleBox["j", "TI"], "\[Prime]"], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "5dc62fc0-d4bf-41fc-a2f2-47f0ac6d85af"],
               ", ",
               Cell[BoxData[
                FormBox[
                 SuperscriptBox[
                  StyleBox["j", "TI"], "\[Prime]\[Prime]"], TraditionalForm]],
                 "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "684e8f71-0164-49f1-8c0e-2de8913ea7a6"],
               
               ") where two or three such indices are needed: it labels the \
three imaginary quaternion units ",
               Cell[BoxData[
                FormBox[
                 SubscriptBox[
                  StyleBox["e",
                   FontWeight->"Bold",
                   FontSlant->"Plain"], 
                  StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "280b8b08-ac17-4c82-b7ee-7b681d47665e"],
               ", which correspond to the three space directions of ",
               Cell[BoxData[
                FormBox[
                 SubsuperscriptBox[
                  StyleBox["\[DoubleStruckCapitalR]",
                   FontSlant->"Plain"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
                  RowBox[{"1", ",", "3"}]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "cb949201-df33-43aa-9037-595681a064da"],
               ", the coordinates ",
               Cell[BoxData[
                FormBox[
                 SubsuperscriptBox[
                  StyleBox["x", "TI"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
                  StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "dfe22152-ba8a-4898-8c2b-04b4ce55d483"],
               ", the momentum components ",
               Cell[BoxData[
                FormBox[
                 SubsuperscriptBox[
                  StyleBox["q", "TI"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
                  StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "54ade942-cbe3-419d-9ade-feb2a35bd57c"],
               ", the rotation and boost generators ",
               Cell[BoxData[
                FormBox[
                 SubsuperscriptBox[
                  StyleBox["J", "TI"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
                  StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "ae8bc3e0-af16-4f61-be2f-40745c4ef713"],
               ", ",
               Cell[BoxData[
                FormBox[
                 SubsuperscriptBox[
                  StyleBox["K", "TI"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
                  StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "ef47560d-2881-457e-9653-9ab3b496cf55"],
               ", and the Pauli matrices ",
               Cell[BoxData[
                FormBox[
                 SubsuperscriptBox["\[Sigma]", 
                  StyleBox["j", "TI"], 
                  StyleBox["LL",
                   FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "94add0c2-7565-4e8e-9c42-f677685d06e8"],
               " and Dirac matrices ",
               Cell[BoxData[
                FormBox[
                 SubsuperscriptBox["\[Alpha]", 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
                  StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "f4d4058d-ab7d-43f4-b57b-b320ed0cf07b"],
               ", ",
               Cell[BoxData[
                FormBox[
                 SubsuperscriptBox["\[Gamma]", 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
                  StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "cf343d1c-afcf-4b79-9ebb-550633124d44"],
               ". The letter ",
               Cell[BoxData[
                FormBox[
                 StyleBox["i", "TI"], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "fd02f969-0661-4517-8548-b384bec62e60"],
               " is the imaginary unit (entry ",
               Cell[BoxData[
                FormBox[
                 StyleBox["i", "TI"], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "d6b5c712-c1c5-4b61-aa28-d51f1def837f"],
               "); the isospin index is ",
               Cell[BoxData[
                FormBox["\[Iota]", TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "209769e3-4923-49ba-81a5-1f1ce70b4387"],
               " (a different letter)."
              }], "Text",
               FontFamily->"Source Sans Pro",
               FontSize->9.5,ExpressionUUID->
               "41a557a8-9c74-48bf-93ad-067600f11218"],
              ImageSize->290]},
            {
             PaneBox[
              TemplateBox[{"D"},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              StyleBox["\<\"D\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[Cell[TextData[{
               
               "the number of space dimensions in which the particles of \
matter have momentum: 7 (all space coordinates of 7+1), 4 (fields that do not \
depend on ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  RowBox[{
                   StyleBox["x", "TI"], "\[InvisibleSpace]", "5"}], ",", 
                  RowBox[{
                   StyleBox["x", "TI"], "\[InvisibleSpace]", "6"}], ",", 
                  RowBox[{
                   StyleBox["x", "TI"], "\[InvisibleSpace]", "7"}]}], 
                 TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "08b53243-1166-4ad3-a0f5-d3abac5ecd85"],
               ") or 3 (fields that depend on ordinary space only). ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubscriptBox[
                   StyleBox["V", "TI"], 
                   StyleBox["D", "TI"]], "\[LongEqual]", 
                  SuperscriptBox["\[Pi]", 
                   RowBox[{
                    StyleBox["D", "TI"], "/", "2"}]], "/", 
                  SubscriptBox["\[CapitalGamma]", 
                   StyleBox["E",
                    FontSlant->"Plain"]], 
                  RowBox[{"(", 
                   RowBox[{
                    StyleBox["D", "TI"], "/", "2", "+", "1"}], ")"}]}], 
                 TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "9b5974b2-04c5-41cd-b704-4f78dd5981fc"],
               " is the volume and ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubscriptBox[
                   StyleBox["A", "TI"], 
                   StyleBox["D", "TI"]], "\[LongEqual]", 
                  StyleBox["D", "TI"], "\[ThinSpace]", 
                  SubscriptBox[
                   StyleBox["V", "TI"], 
                   StyleBox["D", "TI"]]}], TraditionalForm]], "InlineFormula",
                
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "75f39c0e-0e6f-40e9-81a4-0907bdfb232e"],
               " the area of the unit ball in ",
               Cell[BoxData[
                FormBox[
                 StyleBox["D", "TI"], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "8c2d890c-1f35-411c-a2ef-081ab71c3ee1"],
               " dimensions (",
               Cell[BoxData[
                FormBox[
                 SubscriptBox["\[CapitalGamma]", 
                  StyleBox["E",
                   FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "9f8981a2-b77c-4c08-bb6e-bda55092b6ee"],
               ": Euler's gamma function). In the super-loop revision ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  StyleBox["D", "TI"], "\[LongEqual]", "3"}], 
                 TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "bc44f484-272b-4181-8eb1-63313fa546f1"],
               " for the four-dimensional world of the superfluid and ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  StyleBox["D", "TI"], "\[LongEqual]", "7"}], 
                 TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "056b3b59-1d23-4413-b231-8b741603b6f0"],
               
               " for the eight-dimensional manifolds; the value 4, the \
coordinates ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  RowBox[{
                   StyleBox["x", "TI"], "\[InvisibleSpace]", "5"}], ",", 
                  RowBox[{
                   StyleBox["x", "TI"], "\[InvisibleSpace]", "6"}], ",", 
                  RowBox[{
                   StyleBox["x", "TI"], "\[InvisibleSpace]", "7"}]}], 
                 TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "a3e8cb32-cb49-4752-b8c6-080d59c671de"],
               
               " and the volume and the area of the unit ball do not occur. \
In the kinetic Lagrangian of the superfluid boson singlet state ",
               Cell[BoxData[
                FormBox[
                 StyleBox["D", "TI"], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "7c1e2cc1-9f7f-4099-90a7-d07bf86301af"],
               
               " is also continued away from 3: in dimensional regularization \
the momentum integrals are taken in ",
               Cell[BoxData[
                FormBox[
                 StyleBox["D", "TI"], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "42271059-5ab2-4144-a3cf-2fcf1b9b2ff1"],
               " space dimensions."
              }], "Text",
               FontFamily->"Source Sans Pro",
               FontSize->9.5,ExpressionUUID->
               "e26e7629-4857-4113-ae0e-a753b3fb138c"],
              ImageSize->290]},
            {
             PaneBox[
              TemplateBox[{"i"},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              StyleBox["\<\"\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[Cell[TextData[{
               "the imaginary unit, ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SuperscriptBox[
                   StyleBox["i", "TI"], "2"], "\[LongEqual]", 
                  RowBox[{"-", "1"}]}], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "096abe64-dc70-4bf5-83c8-209945547443"],
               "; in ",
               Cell[BoxData[
                FormBox[
                 SubscriptBox[
                  StyleBox["\[DoubleStruckCapitalB]",
                   FontSlant->"Plain"], 
                  StyleBox["LL",
                   FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "e9e75c4b-ba90-4282-9eae-600c4ca4dd83"],
               
               " it is the imaginary unit of the complex coefficients: it \
commutes and associates with every bi-octonion and is not one of the units ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubscriptBox[
                   StyleBox["e",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], "1"], ",", "\[Ellipsis]", ",", 
