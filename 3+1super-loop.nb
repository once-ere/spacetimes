         RowBox[{"(*", " ", "primes", " ", "*)"}], "\n", "    ", 
         RowBox[{"RegularExpression", "[", "\"\<\\\\s+\>\"", "]"}], ",", 
         "               ", 
         RowBox[{"(*", " ", 
          RowBox[{"white", " ", 
           RowBox[{"space", ":", " ", 
            RowBox[{"dropped", " ", "later"}]}]}], " ", "*)"}], "\n", "    ", 
         
         RowBox[{"RegularExpression", "[", "\"\<.\>\"", "]"}]}], "}"}]}], 
      "]"}]}], ";"}], "                ", 
   RowBox[{"(*", " ", 
    RowBox[{"any", " ", "other", " ", "single", " ", "character"}], " ", 
    "*)"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", " ", "2."}]}]}]}]}], " ", "Characters", " ", "for", " ",
      "the", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"commands", " ", "--"}], "--"}], "--"}], "--"}], "--"}]}], 
    " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"cmd", " ", "=", " ", 
     RowBox[{"<|", "\n", "  ", 
      RowBox[{
       RowBox[{"\"\<\\\\alpha\>\"", " ", "->", " ", "\"\<\[Alpha]\>\""}], ",",
        " ", 
       RowBox[{"\"\<\\\\beta\>\"", " ", "->", " ", "\"\<\[Beta]\>\""}], ",", 
       " ", 
       RowBox[{"\"\<\\\\gamma\>\"", " ", "->", " ", "\"\<\[Gamma]\>\""}], ",",
        " ", 
       RowBox[{"\"\<\\\\delta\>\"", " ", "->", " ", "\"\<\[Delta]\>\""}], ",",
        "\n", "  ", 
       RowBox[{"\"\<\\\\epsilon\>\"", " ", "->", " ", "\"\<\[Epsilon]\>\""}], 
       ",", " ", 
       RowBox[{"\"\<\\\\varepsilon\>\"", " ", "->", 
        " ", "\"\<\[CurlyEpsilon]\>\""}], ",", " ", 
       RowBox[{"\"\<\\\\zeta\>\"", " ", "->", " ", "\"\<\[Zeta]\>\""}], ",", 
       " ", 
       RowBox[{"\"\<\\\\eta\>\"", " ", "->", " ", "\"\<\[Eta]\>\""}], ",", 
       "\n", "  ", 
       RowBox[{"\"\<\\\\theta\>\"", " ", "->", " ", "\"\<\[Theta]\>\""}], ",",
        " ", 
       RowBox[{"\"\<\\\\vartheta\>\"", " ", "->", 
        " ", "\"\<\[CurlyTheta]\>\""}], ",", " ", 
       RowBox[{"\"\<\\\\iota\>\"", " ", "->", " ", "\"\<\[Iota]\>\""}], ",", 
       " ", 
       RowBox[{"\"\<\\\\kappa\>\"", " ", "->", " ", "\"\<\[Kappa]\>\""}], ",",
        "\n", "  ", 
       RowBox[{"\"\<\\\\varkappa\>\"", " ", "->", 
        " ", "\"\<\[CurlyKappa]\>\""}], ",", " ", 
       RowBox[{"\"\<\\\\lambda\>\"", " ", "->", " ", "\"\<\[Lambda]\>\""}], ",",
        " ", 
       RowBox[{"\"\<\\\\mu\>\"", " ", "->", " ", "\"\<\[Mu]\>\""}], ",", " ", 
       
       RowBox[{"\"\<\\\\nu\>\"", " ", "->", " ", "\"\<\[Nu]\>\""}], ",", "\n",
        "  ", 
