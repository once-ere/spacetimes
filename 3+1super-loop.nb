           "the three angles of an isospin rotation, ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubscriptBox[
               StyleBox["U",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"]], "\[LongEqual]", 
              StyleBox["exp",
               FontSlant->"Plain"], 
              RowBox[{"(", 
               RowBox[{
                StyleBox["i", "TI"], "\[ThinSpace]", 
                UnderscriptBox["\[Sum]", "\[Iota]",
                 LimitsPositioning->True], "\[ThinSpace]", 
                SubsuperscriptBox["\[Theta]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], "\[Iota]"], 
                SubsuperscriptBox["\[Tau]", "\[Iota]", 
                 StyleBox["LL",
                  FontSlant->"Plain"]], "/", "2"}], ")"}]}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "ba358314-ef24-40ae-8f4c-07caa562361b"],
           "; ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[Theta]", 
              StyleBox["LL",
               FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "35ceace2-dcc3-423c-91cc-a6e05d9ef310"],
           " alone gives the rotations ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              StyleBox["exp",
               FontSlant->"Plain"], 
              RowBox[{"(", 
               RowBox[{
                StyleBox["i", "TI"], 
                SubsuperscriptBox["\[Theta]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], "3"], 
                SubscriptBox[
                 StyleBox["Q", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "b2560b9d-d1b3-4008-a01b-283fa8be8fc3"],
           " of the electric charge (plain text ",
           StyleBox["al",
            FontFamily->"Source Code Pro"],
           ")"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "1f8ceda4-64e6-415e-b70f-1e172594f3e9"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox[
             OverscriptBox["d", "\[RightVector]"], "LL", "tr"]},
