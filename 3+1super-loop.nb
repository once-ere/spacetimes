In[535]:=",ExpressionUUID->"5ef55c9b-734b-418d-a5a8-7e3c1b452bd4"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["GS-14: the super-loop form of the field equations", "Subsection",ExpressionUUID->"dff3712f-a561-4bbf-a370-413a0b9be68d"],

Cell[TextData[{
 "The Weyl isodoublet of a spinor charge ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["y",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d29e6ced-a1a1-4522-b918-f33c98019963"],
 " (with a bi-quaternion ",
 Cell[BoxData[
  FormBox[
   StyleBox["y",
    FontWeight->"Bold",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c7cadaa4-1fa5-4ead-8063-a1c926a0c7e1"],
 ") is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Psi]", 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Prime]"], 
    RowBox[{"(", 
     StyleBox["y",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["E",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     RowBox[{"-", "1"}]], 
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      StyleBox["y",
       FontWeight->"Bold",
       FontSlant->"Plain"], ")"}], 
     StyleBox["T", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c39413c7-a9b8-4930-8e87-8117fd28873e"],
 ", and the Dirac isodoublet ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"[", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["b",
        FontWeight->"Bold",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "-"], ",", 
      SubsuperscriptBox[
       StyleBox["b",
        FontWeight->"Bold",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "+"]}], "]"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "71a674c6-f655-4020-b00b-f768238119e3"],
 " of the two spinor charges ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[PlusMinus]"], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e67d2d22-0bc3-42ec-807d-b373cd789d8b"],
 " has the upper block ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Psi]", 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Prime]"], 
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["b",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], "-"], ")"}]}], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b9e7d22d-cef0-4335-ba21-1109ded876ee"],
 " (components 1 to 4) and the lower block ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Psi]", 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Prime]"], 
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["b",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], "+"], ")"}]}], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "173b6875-5def-4835-8918-93a4cd54ecc3"],
 " (components 5 to 8). The check shows, with random bi-quaternions: (a) a \
frame matrix acting on a Weyl isodoublet is a right multiplication of the \
spinor charge, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["x",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    SubsuperscriptBox["\[Psi]", 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Prime]"], 
    RowBox[{"(", 
     StyleBox["y",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[LongEqual]", 
    SubsuperscriptBox["\[Psi]", 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Prime]"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["y",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      OverscriptBox[
       StyleBox["x",
        FontWeight->"Bold",
        FontSlant->"Plain"], "_"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "16ce2ef5-5e83-445b-863f-564b73fdb4fc"],
 ", in agreement with the Cayley-Dickson product ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      StyleBox["a",
       FontWeight->"Bold",
       FontSlant->"Plain"], "+", 
      StyleBox["b",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      SubscriptBox[
       StyleBox["e",
        FontWeight->"Bold",
        FontSlant->"Plain"], "4"]}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["c",
       FontWeight->"Bold",
       FontSlant->"Plain"], "+", 
      StyleBox["d",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      SubscriptBox[
       StyleBox["e",
        FontWeight->"Bold",
        FontSlant->"Plain"], "4"]}], ")"}], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["a",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      StyleBox["c",
       FontWeight->"Bold",
       FontSlant->"Plain"], "-", 
      OverscriptBox[
       StyleBox["d",
        FontWeight->"Bold",
        FontSlant->"Plain"], "_"], 
      StyleBox["b",
       FontWeight->"Bold",
       FontSlant->"Plain"]}], ")"}], "+", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["d",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      StyleBox["a",
       FontWeight->"Bold",
       FontSlant->"Plain"], "+", 
      StyleBox["b",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      OverscriptBox[
       StyleBox["c",
        FontWeight->"Bold",
        FontSlant->"Plain"], "_"]}], ")"}], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "794e1771-e4cb-4549-b537-1bdb1c51c582"],
 ", which gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      StyleBox["y",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      SubscriptBox[
       StyleBox["e",
        FontWeight->"Bold",
        FontSlant->"Plain"], "4"]}], ")"}], 
    StyleBox["x",
     FontWeight->"Bold",
     FontSlant->"Plain"], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["y",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      OverscriptBox[
       StyleBox["x",
        FontWeight->"Bold",
        FontSlant->"Plain"], "_"]}], ")"}], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ee0d641a-5f41-4890-8010-2b73a494beef"],
 "; (b) the Dirac matrices exchange the two spinor charges and multiply them \
by the frame, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p", "TI"]], 
    RowBox[{"[", 
     StyleBox["f",
      FontWeight->"Bold",
      FontSlant->"Plain"], "]"}], 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"[", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["b",
        FontWeight->"Bold",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "-"], ",", 
      SubsuperscriptBox[
       StyleBox["b",
        FontWeight->"Bold",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "+"]}], "]"}], "\[LongEqual]", 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"[", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["b",
        FontWeight->"Bold",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "+"], 
      SubscriptBox[
       OverscriptBox[
        StyleBox["f",
         FontWeight->"Bold",
         FontSlant->"Plain"], "_"], 
       StyleBox["p", "TI"]], ",", 
      SubsuperscriptBox[
       StyleBox["b",
        FontWeight->"Bold",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "-"], 
      SubscriptBox[
       StyleBox["f",
        FontWeight->"Bold",
        FontSlant->"Plain"], 
       StyleBox["p", "TI"]]}], "]"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "df7f6c17-1a13-4006-838c-aaccbe597209"],
 "; (c) the gauge group acts by the automorphisms of the super-loop: ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["\[ScriptCapitalU]",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a6b34193-0603-46dd-91b9-ad4492d56828"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["U",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["v",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "490f48d5-f193-46ac-9917-c148567a34ed"],
 " replaces ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["b",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "+"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "18115038-afea-4462-847d-06ceb7de0c18"],
 " by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      StyleBox["i", "TI"], 
      SubsuperscriptBox["\[Theta]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["F",
        FontSlant->"Plain"]]}]], 
    StyleBox["v",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    SubsuperscriptBox[
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "+"], 
    OverscriptBox[
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], "_"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e96c906a-8f8b-404f-acb8-0cb4c9a29d90"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["b",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "-"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d99721e5-4d3f-42cc-bdad-916c9e47950d"],
 " by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      StyleBox["i", "TI"], 
      SubsuperscriptBox["\[Theta]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["F",
        FontSlant->"Plain"]]}]], 
    StyleBox["v",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    SubsuperscriptBox[
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "-"], 
    SuperscriptBox[
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], "\[Dagger]"]}], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "14e129f7-1c9b-4082-9a98-9f1abaefbfd3"],
 " (and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], "~"], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], "*"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1878b151-6e01-4ed1-9f8c-05056117c89e"],
 "); (d) the covariant derivative acts through the derivations of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["\[DoubleStruckCapitalB]",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9ac79303-af59-4571-8250-a68375888bc6"],
 ": on ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["b",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "+"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2b2ccb6c-54a3-40f8-a548-44d477134197"],
 " it is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", 
     StyleBox["p", "TI"]], 
    SubsuperscriptBox[
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "+"], "-", 
    SubsuperscriptBox[
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "+"], 
    SubsuperscriptBox[
     StyleBox["u",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], "\[Omega]"], "+", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["t",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], 
     StyleBox["A",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "+"], "-", 
    StyleBox["i", "TI"], 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], 
     StyleBox["F",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "+"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8bf47805-7593-44e4-a840-9030c172ea6b"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["t",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], 
     StyleBox["A",
      FontSlant->"Plain"]], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", "\[Iota]",
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], "\[Iota]"], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "\[Iota]"], "/", "2"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d1773f2e-a2b7-4116-99b6-4d338dd350e8"],
 ", and on ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["b",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "-"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "383641ea-e550-4491-83ca-5cefeb7ad642"],
 " the same with ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["u",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}], 
    RowBox[{"\[Omega]", "*"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2e5cff95-5c43-4f8c-902a-1e150218718d"],
 " in place of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["u",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}], "\[Omega]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b4b8e858-6413-4074-9d59-9389b711e783"],
 "; (e) the Dirac operator is the right multiplication by the frame, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["p", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p", "TI"]], 
    SubsuperscriptBox["\[Del]", 
     StyleBox["p", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"[", 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       StyleBox["p", "TI"],
       LimitsPositioning->True], 
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox["\[Del]", 
         StyleBox["p", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"]], 
        SubsuperscriptBox[
         StyleBox["b",
          FontWeight->"Bold",
          FontSlant->"Plain"], 
         StyleBox["LL",
          FontSlant->"Plain"], "+"]}], ")"}], 
      SubscriptBox[
       OverscriptBox[
        StyleBox["f",
         FontWeight->"Bold",
         FontSlant->"Plain"], "_"], 
       StyleBox["p", "TI"]], ",", 
      UnderscriptBox["\[Sum]", 
       StyleBox["p", "TI"],
       LimitsPositioning->True], 
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox["\[Del]", 
         StyleBox["p", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"]], 
        SubsuperscriptBox[
         StyleBox["b",
          FontWeight->"Bold",
          FontSlant->"Plain"], 
         StyleBox["LL",
          FontSlant->"Plain"], "-"]}], ")"}], 
      SubscriptBox[
       StyleBox["f",
        FontWeight->"Bold",
        FontSlant->"Plain"], 
       StyleBox["p", "TI"]]}], "]"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "261f82f6-e9b3-433e-bc8a-0c81d02bd449"],
 ", the right multiplications ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["R", "TI"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["f",
       FontWeight->"Bold",
       FontSlant->"Plain"], "_"], 
     StyleBox["p", "TI"]], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a5d70df7-bfc4-4e16-9342-f3c48c01e815"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["R", "TI"], 
    SubscriptBox[
     StyleBox["f",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["p", "TI"]], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f32e6f08-f12f-4936-86c2-93723564089c"],
 " applied to the covariant derivatives of the charges."
}], "Text",ExpressionUUID->"6c760682-c465-4713-b8e7-8da455f6658e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
