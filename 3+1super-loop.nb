     " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"etas", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ReleaseHold", "[", 
      RowBox[{"SL31Instance", "[", 
       RowBox[{
        RowBox[{
        "SL31SymbolBoxes", "[", "\"\<\\\\eta^{\\\\rm LL}_{pp'}\>\"", "]"}], ",",
         " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\"\<p\>\"", " ", "->", " ", 
           RowBox[{"ToString", "[", "a", "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{"SuperscriptBox", "[", 
            RowBox[{"\"\<p\>\"", ",", " ", "\"\<\[Prime]\>\""}], "]"}], " ", "->",
            " ", 
           RowBox[{"ToString", "[", "b", "]"}]}]}], "}"}]}], "]"}], "]"}], ",",
      " ", 
     RowBox[{"{", 
      RowBox[{"a", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"b", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"quadratic", " ", "=", " ", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"etas", "[", 
       RowBox[{"[", 
        RowBox[{"a", ",", " ", "b"}], "]"}], "]"}], " ", 
      RowBox[{"xs", "[", 
       RowBox[{"[", "a", "]"}], "]"}], " ", 
      RowBox[{"xs", "[", 
       RowBox[{"[", "b", "]"}], "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"a", ",", " ", "4"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"b", ",", " ", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"minkowski", " ", "=", " ", 
   RowBox[{"Expand", "[", 
    RowBox[{"quadratic", " ", "/.", " ", 
     RowBox[{"Thread", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", "etas", "]"}], " ", "->", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{"DiagonalMatrix", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", 
           RowBox[{"-", "1"}], ",", " ", 
           RowBox[{"-", "1"}], ",", " ", 
           RowBox[{"-", "1"}]}], "}"}], "]"}], "]"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Length", "[", "quadratic", "]"}], ",", " ", "minkowski"}], 
  "}"}]}], "Input",
 CellLabel->
  "In[188]:=",ExpressionUUID->"a3c00979-efd3-4c84-a64e-1a282f8f17db"],

