       OverscriptBox[
        SubscriptBox[
         TagBox[
          StyleBox["D", FontWeight -> "Bold", FontSlant -> "Plain"], 
          "SL31Bold"], "LL"], "_"], "\") = \"", 
       TagBox[
        RowBox[{"(", "\[NoBreak]", 
          GridBox[{{
             RowBox[{
               
               TemplateBox[{"\"\[Del]\"", "0", "\"LL\""}, "Subsuperscript", 
                SyntaxForm -> SubsuperscriptBox], "-", 
               
