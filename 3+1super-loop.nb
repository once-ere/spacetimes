               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "a98bc3ed-a555-4106-8c28-9226bd53db03"],
           ", ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["u",
                FontWeight->"Bold",
                FontSlant->"Plain"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}], "\[Omega]"], "\[LongEqual]", 
