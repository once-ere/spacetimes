           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "b738e8ad-0d1c-48f1-82f6-c9bce4b87a7e"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["\[Del]", "p", "LL"], "\", \"", 
