               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[
              StyleBox[
               TemplateBox[{"\"groups: the complex \"", 
                 FormBox[
                  RowBox[{"2", "\[Cross]", "2"}], TraditionalForm], 
                 "\" matrices of determinant 1 (the unit bi-quaternions), \
equal to the connected double cover of the Lorentz group of \"", 
                 FormBox[
                  RowBox[{"3", "+", "1"}], TraditionalForm], 
                 "\" dimensions; the complex orthogonal group of four \
dimensions; the compact exceptional group \"", 
                 FormBox[
                  SubscriptBox[
                   StyleBox["G", FontSlant -> "Plain"], "2"], 
                  TraditionalForm], "\" (automorphisms of \"", 
                 FormBox[
                  StyleBox["O", FontSlant -> "Plain"], TraditionalForm], 
                 "\") and its complex form (automorphisms of \"", 
                 FormBox[
                  SubscriptBox[
                   StyleBox["B", FontSlant -> "Plain"], "LL"], 
                  TraditionalForm], "\"); the Lorentz group of \"", 
                 FormBox[
                  RowBox[{"7", "+", "1"}], TraditionalForm], 
                 "\" dimensions; the spin groups of seven dimensions (compact \
and complex); the real \"", 
                 FormBox[
                  RowBox[{"2", "\[Cross]", "2"}], TraditionalForm], 
                 "\" matrices of determinant 1, the double cover of the \
Lorentz group of \"", 
                 FormBox[
                  RowBox[{"2", "+", "1"}], TraditionalForm], 
                 "\" dimensions; the special unitary group of two dimensions; \
the phases; the group of two elements\""},
                "RowDefault"],
               StripOnInput->False,
               FontFamily->"Source Sans Pro",
               FontSize->9.5],
              ImageSize->290]},
            {
             PaneBox[
              TemplateBox[{
                RowBox[{"\[GothicS]\[GothicO]", "(", "3", ",", "1", ")"}], 
                "\", \"", 
                RowBox[{"\[GothicS]\[GothicO]", "(", "1", ",", "7", ")"}], 
                "\", \"", 
                RowBox[{"\[GothicS]\[GothicO]", "(", "4", ",", "1", ")"}], 
                "\", \"", 
                RowBox[{"\[GothicS]\[GothicO]", "(", "8", ")"}], "\", \"", 
                RowBox[{"\[GothicS]\[GothicO]", "(", "4", ",", "4", ")"}], 
                "\", \"", 
                
                RowBox[{
                 "\[GothicS]\[GothicO]", "(", "8", ",", 
                  "\[DoubleStruckCapitalC]", ")"}], "\", \"", 
                RowBox[{"\[GothicS]\[GothicO]", "(", "3", ")"}], "\", \"", 
                RowBox[{"\[GothicS]\[GothicO]", "(", "4", ")"}], "\", \"", 
                RowBox[{"\[GothicS]\[GothicO]", "(", "2", ",", "1", ")"}], 
                "\", \"", 
                
                RowBox[{
                 "\[GothicS]\[GothicL]", "(", "2", ",", 
                  "\[DoubleStruckCapitalR]", ")"}], "\", \"", 
                RowBox[{"\[GothicS]\[GothicL]", "(", "2", ")"}], "\", \"", 
                RowBox[{"\[GothicS]\[GothicU]", "(", "2", ")"}], "\", \"", 
                
                RowBox[{
                 "\[GothicS]\[GothicP]\[GothicI]\[GothicN]", "(", "7", ")"}], 
                "\", \"", 
                SubscriptBox["\[GothicG]", "2"], "\", \"", 
                RowBox[{
                  SubscriptBox["\[GothicG]", "2"], "(", 
                  "\[DoubleStruckCapitalC]", ")"}]},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              
              StyleBox["\<\"so(3,1) so(1,7) so(4,1) so(8) so(4,4) so(8,C) \
so(3) so(4) so(2,1) sl(2,R) sl(2) su(2) spin(7) g2 g2(C)\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[
              StyleBox[
               TemplateBox[{"\"Lie algebras: of the Lorentz groups of \"", 
                 FormBox[
                  RowBox[{"3", "+", "1"}], TraditionalForm], "\" and \"", 
                 FormBox[
                  RowBox[{"7", "+", "1"}], TraditionalForm], 
                 "\" dimensions; of the de Sitter group (signature of the \
Killing form: 4 positive, 6 negative); of the linear maps that preserve a \
definite real, a \"", 
                 FormBox[
                  RowBox[{"(", 
                    RowBox[{"4", ",", "4"}], ")"}], TraditionalForm], 
                 "\" and a complex quadratic form in eight dimensions; of the \
rotations of three-dimensional space and of four-dimensional Euclidean space; \
of the Lorentz group of \"", 
                 FormBox[
                  RowBox[{"2", "+", "1"}], TraditionalForm], 
                 "\" dimensions, equal to \"", 
                 FormBox[
                  RowBox[{
                    RowBox[{
                    StyleBox["s", "TI"], 
                    StyleBox["l", "TI"]}], "(", 
                    RowBox[{"2", ",", 
                    StyleBox["R", FontSlant -> "Plain"]}], ")"}], 
                  TraditionalForm], "\"; \"", 
                 FormBox[
                  RowBox[{
                    RowBox[{
                    StyleBox["s", "TI"], 
                    StyleBox["l", "TI"]}], "(", "2", ")"}], TraditionalForm], 
                 "\" the simple Lie algebra of dimension 3 over any field; \
\"", 
                 FormBox[
                  RowBox[{
                    RowBox[{
                    StyleBox["s", "TI"], 
                    StyleBox["u", "TI"]}], "(", "2", ")"}], TraditionalForm], 
                 "\" isospin; \"", 
                 FormBox[
                  RowBox[{
                    RowBox[{
                    StyleBox["s", "TI"], 
                    StyleBox["p", "TI"], 
                    StyleBox["i", "TI"], 
                    StyleBox["n", "TI"]}], "(", "7", ")"}], TraditionalForm], 
                 "\" of dimension 21; the exceptional Lie algebra \"", 
                 FormBox[
                  SubscriptBox[
                   StyleBox["g", "TI"], "2"], TraditionalForm], 
                 "\" (compact, dimension 14) and its complex form (real \
dimension 28)\""},
                "RowDefault"],
               StripOnInput->False,
               FontFamily->"Source Sans Pro",
               FontSize->9.5],
              ImageSize->290]},
            {
             PaneBox[
              
              TemplateBox[{
               "tr", "\", \"", "det", "\", \"", "diag", "\", \"", "Re", 
                "\", \"", "Im"},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              
              StyleBox["\<\"tr det diag Re Im exp ln sqrt sum int span \
dim\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[
              
              StyleBox["\<\"trace, determinant, the diagonal matrix with the \
listed entries, real part, imaginary part (also: the imaginary part of an \
algebra, the span of its imaginary units); plain text `exp`, `ln`, `sqrt`, \
`sum`, `int`, `span`, `dim`: the exponential, natural logarithm, square root, \
a sum, an integral, the set of real linear combinations, a dimension\"\>",
               StripOnInput->False,
               FontFamily->"Source Sans Pro",
               FontSize->9.5],
              ImageSize->290]},
            {
             PaneBox[
              TemplateBox[{
                SuperscriptBox["", "T"], "\", \"", "\[CircleTimes]", "\", \"",
                 "\[CirclePlus]", "\", \"", "\[SmallCircle]", "\", \"", 
                RowBox[{"\[LeftAngleBracket]", "\[RightAngleBracket]"}]},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              StyleBox["\<\"(x) ^T o\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[
              StyleBox[
               
               TemplateBox[{
                "\"transpose; tensor product and direct sum (plain text `(x)` \
for \"", 
                 FormBox["\[CircleTimes]", TraditionalForm], 
                 "\"); composition of maps; expectation value in the ground \
state; the Hermitian conjugate of the preceding terms\""},
                "RowDefault"],
               StripOnInput->False,
               FontFamily->"Source Sans Pro",
               FontSize->9.5],
              ImageSize->290]},
            {
             PaneBox[
              
              StyleBox["\<\"A-1, ..., R-6; G-1, ..., G-12; LL-S1, ..., LL-H1; \
X-1, ..., X-10; Z-1, ..., Z-8; Theorems R, L, M, SF1, ..., SF4\"\>",
               StripOnInput->False,
               FontSize->9],
              ImageSize->125], 
             PaneBox[
              StyleBox["\<\"\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[
              
              StyleBox["\<\"the identifiers of the machine checks of the \
project (letters: A associativity, L Lorentz super-loop, Q operators and \
eigenvalues, C the inversion element, M Malcev classification, G Groebner \
bases, N manifolds, S superfluid, R renormalizability, LL-S symbols, LL-H \
self-containedness, X the examples of the spin-zero superfluid, Z the 3+1 \
manifold and the renormalizability of the Yukawa form) and the labels of the \
theorems of the project; they are names, not mathematical symbols\"\>",
               StripOnInput->False,
               FontFamily->"Source Sans Pro",
               FontSize->9.5],
              ImageSize->290]},
            {
             PaneBox[
              StyleBox["\<\"H-grp, H-op, H-Lie, H-gr, H-dyn\"\>",
               StripOnInput->False,
