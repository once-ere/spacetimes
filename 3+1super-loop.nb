                    SubsuperscriptBox[
                    StyleBox["g", "TI"], "LL", "v"], 
                    SubscriptBox[
                    StyleBox["a", FontSlant -> "Plain"], 
                    RowBox[{"LL", ",", 
                    StyleBox["j", "TI"]}]], "+", 
                    SubsuperscriptBox[
                    StyleBox["g", "TI"], "LL", "F"], 
                    SubsuperscriptBox[
                    StyleBox["A", "TI"], 
                    RowBox[{"LL", ",", 
                    StyleBox["j", "TI"]}], "F"], 
                    SubsuperscriptBox["\[Sigma]", "0", "LL"]}], ")"}]}], 
                ")"}], TraditionalForm], 
