            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "819cc239-1277-4a18-b91d-338aadbff968"],
           " (an element of ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              StyleBox["Im",
               FontSlant->"Plain"], "\[ThinSpace]", 
              StyleBox["\[DoubleStruckCapitalH]",
               FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "63974957-be36-4c7b-9d27-519c2e726575"],
           ", like ",
           Cell[BoxData[
            FormBox[
             StyleBox["t",
              FontWeight->"Bold",
              FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "815b5f58-bc39-4205-b4ab-a2eeb8353ebb"],
           "), with ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubscriptBox[
               StyleBox["M", "TI"], 
