         PaneBox[
          StyleBox["\<\"W_g\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the condensation function of one sector, ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["W", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["g",
                FontSlant->"Plain"]], 
              RowBox[{"(", 
               SubsuperscriptBox["\[CapitalDelta]", 
                StyleBox["LL",
                 FontSlant->"Plain"], "2"], ")"}], "\[LongEqual]", "\[Integral]", 
              SuperscriptBox[
               StyleBox["d", "TI"], "3"], 
              SubscriptBox[
               StyleBox["q", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"]], 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"2", "\[Pi]"}], ")"}], 
               RowBox[{"-", "3"}]], 
              RowBox[{"(", 
               RowBox[{
                SubsuperscriptBox[
                 StyleBox["E", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], "+"], "+", 
                SubsuperscriptBox[
                 StyleBox["E", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], "-"], "-", 
                RowBox[{"\[LeftBracketingBar]", 
                 RowBox[{
                  SubscriptBox["\[CurlyEpsilon]", 
                   StyleBox["LL",
                    FontSlant->"Plain"]], "+", 
                  SubscriptBox["\[Mu]", 
                   StyleBox["LL",
                    FontSlant->"Plain"]]}], "\[RightBracketingBar]"}], "-", 
                RowBox[{"\[LeftBracketingBar]", 
                 RowBox[{
                  SubscriptBox["\[CurlyEpsilon]", 
                   StyleBox["LL",
                    FontSlant->"Plain"]], "-", 
                  SubscriptBox["\[Mu]", 
                   StyleBox["LL",
                    FontSlant->"Plain"]]}], "\[RightBracketingBar]"}]}], 
               ")"}]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "678e37be-e310-4dca-b86d-b264c3e71e4a"],
           " with the gap ",
           Cell[BoxData[
            FormBox[
             SubscriptBox["\[CapitalDelta]", 
              StyleBox["LL",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
