           RowBox[{"t2rngState", " ", "+", " ", "16^^9E3779B97F4A7C15"}], ",",
            " ", 
           RowBox[{"2", "^", "64"}]}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"z", " ", "=", " ", "t2rngState"}], ";", "\n", "   ", 
        RowBox[{"z", " ", "=", " ", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"BitXor", "[", 
             RowBox[{"z", ",", " ", 
              RowBox[{"BitShiftRight", "[", 
               RowBox[{"z", ",", " ", "30"}], "]"}]}], "]"}], " ", 
            "16^^BF58476D1CE4E5B9"}], ",", " ", 
           RowBox[{"2", "^", "64"}]}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"z", " ", "=", " ", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"BitXor", "[", 
             RowBox[{"z", ",", " ", 
              RowBox[{"BitShiftRight", "[", 
               RowBox[{"z", ",", " ", "27"}], "]"}]}], "]"}], " ", 
            "16^^94D049BB133111EB"}], ",", " ", 
           RowBox[{"2", "^", "64"}]}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"BitXor", "[", 
         RowBox[{"z", ",", " ", 
          RowBox[{"BitShiftRight", "[", 
           RowBox[{"z", ",", " ", "31"}], "]"}]}], "]"}]}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{" ", 
       RowBox[{"a", " ", "uniform", " ", "number", " ", 
        RowBox[{"in", " ", "[", 
         RowBox[{
          RowBox[{"-", "1"}], ",", " ", "1"}]}]}], ")"}], ":", " ", 
      RowBox[{"the", " ", "upper", " ", "53", " ", "bits"}]}], ",", " ", 
     RowBox[{"as", " ", "an", " ", "exact", " ", "rational"}], ",", " ", 
     RowBox[{"converted", " ", "to", " ", "a", " ", "double"}]}], " ", "*)"}],
    "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2Unit", "[", "]"}], " ", ":=", " ", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{"2", " ", 
        RowBox[{
         RowBox[{"BitShiftRight", "[", 
          RowBox[{
           RowBox[{"t2NextU64", "[", "]"}], ",", " ", "11"}], "]"}], "/", 
         RowBox[{"2", "^", "53"}]}]}], " ", "-", " ", "1"}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{" ", 
      RowBox[{
       RowBox[{"a", " ", "random", " ", "complex", " ", "number", " ", "re"}],
        " ", "+", " ", 
