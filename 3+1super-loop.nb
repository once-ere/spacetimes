            FormBox[
             RowBox[{"(", 
              RowBox[{"1", ",", "0", ",", "0"}], ")"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "3e4bc0a7-8350-42fe-8c0a-66b2196ae2c3"],
