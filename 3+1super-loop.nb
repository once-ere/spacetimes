                FontSlant->"Plain"]], "\[LongEqual]", 
              UnderscriptBox["\[Sum]", "\[Iota]",
               LimitsPositioning->True], "\[ThinSpace]", 
              SubsuperscriptBox[
               StyleBox["A", "TI"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}], "\[Iota]"], 
              SubscriptBox[
               StyleBox["e",
                FontWeight->"Bold",
                FontSlant->"Plain"], "\[Iota]"], "/", "2"}], 
