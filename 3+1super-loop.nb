  "d4c69202-99cc-4cb8-8639-ad13011812f3"],
 " sites with the spacing ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[ScriptL]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["x",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7e3f7e79-af37-4b1c-922e-5735a1b66a9d"],
 " (called ell in the code). A site ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["s", "TI"], "\[RightVector]"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["s", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "1"], ",", 
      SubsuperscriptBox[
       StyleBox["s", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "2"], ",", 
      SubsuperscriptBox[
       StyleBox["s", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a5e1c644-30ba-41b9-84a3-91c002c10d33"],
 " has integer coordinates counted from 0, and the code gives it the number \
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["s", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], "+", 
    SubsuperscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["x",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["s", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "2"], "+", 
      SubsuperscriptBox[
       StyleBox["n", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["y",
        FontSlant->"Plain"]], 
      SubsuperscriptBox[
       StyleBox["s", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5c6563f1-9549-4a6f-9257-e823b0e956a1"],
 "; ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    OverscriptBox["\[Delta]", "\[RightVector]"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "591f7503-faca-402c-974d-5ec174f40677"],
 " is the step to the next site in the direction ",
 Cell[BoxData[
  FormBox[
   StyleBox["j", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "efffdd01-db80-4510-96f8-df4a4ac957ed"],
 ". On every site a mode has 16 complex components: the particle part ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Psi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bfb596eb-ce08-4398-b4a3-4d362b723372"],
 " (8 components) and the hole part ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Psi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["h",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e2367a32-61d9-4289-a5af-e84afb92368b"],
 " (8). The gauge fields live on the links: the link from ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox[
     StyleBox["s", "TI"], "\[RightVector]"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "32f7ae54-9068-46f6-a262-f60b8d6f71ef"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["s", "TI"], "\[RightVector]"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "+", 
    SubsuperscriptBox[
     OverscriptBox["\[Delta]", "\[RightVector]"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5586230e-9509-421a-9cf2-92a7bbad025f"],
 " carries the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Times]", "2"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8061de31-d91a-4d30-bae9-a09934fb5f15"],
 " isospin matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["U",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["j", "TI"]}], 
     StyleBox["link",
