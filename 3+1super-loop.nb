        OverscriptBox[
         StyleBox["A", "TI"], "\[RightVector]"], 
        RowBox[{
         StyleBox["LL",
          FontSlant->"Plain"], ",", 
         StyleBox["j", "TI"]}], 
        StyleBox["v",
         FontSlant->"Plain"]], "\[RightBracketingBar]"}]}], ")"}]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ab8fb741-31a7-4e65-a346-60ea7c0331c6"],
 ", which ",
 StyleBox["t2link",
  FontFamily->"Source Code Pro"],
 " evaluates. The particle row of the lattice Dirac-Bogoliubov-de Gennes \
operator ",
