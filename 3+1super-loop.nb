         PaneBox[
          StyleBox[
           TemplateBox[{"\"the pair matrix element \"", 
             FormBox[
              RowBox[{"tr", "(", 
                RowBox[{
                  SubsuperscriptBox[
                   StyleBox["Y", FontSlant -> "Plain"], "LL", "+"], 
                  RowBox[{"(", 
                    RowBox[{
