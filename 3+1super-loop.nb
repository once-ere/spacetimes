             RowBox[{"cx", " ", "+", " ", 
              RowBox[{"I", " ", "sx", " ", "n3"}]}]}], "}"}]}], "}"}]}]}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "2", " ", "x", " ", "2", " ", "potential", " ", "matrix", " ",
       "gv", " ", 
      RowBox[{
       RowBox[{"A0", ".", "tau"}], "/", "2"}]}], " ", "+", " ", 
     RowBox[{"gf", " ", "A0F"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2potential", "[", 
