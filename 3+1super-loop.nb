              StyleBox["\<\"J_LL^j K_LL^j J_LL^j' K_LL^j' J_LL^j'' K_LL^j'' \
J_LL^3\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[Cell[TextData[{
               "the rotation and boost generators of ",
               Cell[BoxData[
                FormBox[
                 SubscriptBox[
                  StyleBox["\[GothicL]",
                   FontSlant->"Plain"], 
                  StyleBox["LL",
                   FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "ee23feb5-6e3e-4203-b788-f3d37fb2d917"],
               ", ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubsuperscriptBox[
                   StyleBox["J", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"], 
                   StyleBox["j", "TI"]], "\[LongEqual]", 
                  SubscriptBox[
                   StyleBox["e",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], 
                   StyleBox["j", "TI"]], "/", "2"}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "8e3a3a04-2350-4230-9f2d-60f480573f02"],
               " and ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubsuperscriptBox[
                   StyleBox["K", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"], 
                   StyleBox["j", "TI"]], "\[LongEqual]", 
                  StyleBox["i", "TI"], "\[ThinSpace]", 
                  SubscriptBox[
                   StyleBox["e",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], 
                   StyleBox["j", "TI"]], "/", "2"}], TraditionalForm]], 
