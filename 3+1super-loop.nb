Cell[CellGroupData[{

Cell["I.6 Symbolizing every symbol", "Section",ExpressionUUID->"aaf8ebfb-fb14-4fd0-bfd8-42d1c936162d"],

Cell[TextData[{
 "Now every item of the kinds symbol, family, function, function family, \
letter, primed index, group, ket and expression is symbolized: ",
 StyleBox["SL31Symbolize",
  FontFamily->"Source Code Pro"],
 " calls ",
 StyleBox["Symbolize",
  FontFamily->"Source Code Pro"],
 " with the explicit working form and with a readable name built from the \
letters, the scripts and the alphabet, and returns the new symbol, held. \
Items whose boxes coincide are ONE symbol and are symbolized once: a function \
symbol written with different arguments, such as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["x",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f699a5c8-3e05-4220-82d2-d37691c48375"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["x",
       FontWeight->"Bold",
       FontSlant->"Plain"], ",", 
      StyleBox["y",
       FontWeight->"Bold",
       FontSlant->"Plain"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5200866a-32a2-4a95-8f77-69a93453cc1e"],
 ", has the one head ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["N", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cdcfe986-9225-4a66-93c0-6d4942740e20"],
 " (symbolizing the same box twice would only replace the first \
symbolization, with a warning of the Notation package). For every new symbol \
the cell also stores its meaning as the usage message (so that ",
 StyleBox["?symbol",
  FontFamily->"Source Code Pro"],
 " prints it), and a formatting rule for ",
 StyleBox["TraditionalForm",
  FontFamily->"Source Code Pro"],
 ": ",
 StyleBox["TeXForm",
  FontFamily->"Source Code Pro"],
 " writes TeX from the ",
 StyleBox["TraditionalForm",
  FontFamily->"Source Code Pro"],
 " boxes of an expression, so with this rule the symbol is written in TeX \
with its printed form and not with its internal name."
}], "Text",ExpressionUUID->"e096b82e-ef0e-4b3f-9a0e-5b215c85d11e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", "items", " ", "that", " ", "are", " ", "symbolized"}],
     ",", " ", 
    RowBox[{"each", " ", "TeX", " ", "item", " ", "once"}]}], " ", "*)"}], 
  "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"toSymbolize", " ", "=", " ", 
     RowBox[{"DeleteDuplicatesBy", "[", 
      RowBox[{
       RowBox[{"Select", "[", 
        RowBox[{"items", ",", " ", 
         RowBox[{
          RowBox[{"MemberQ", "[", 
           RowBox[{"SL31Symbolized", ",", " ", 
            RowBox[{"#", "[", "\"\<kind\>\"", "]"}]}], "]"}], " ", "&"}]}], 
        "]"}], ",", " ", 
       RowBox[{
        RowBox[{"#", "[", "\"\<tex\>\"", "]"}], " ", "&"}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "items", " ", "with", " ", "the", " ", "same", " ", "boxes", " ", "are", " ",
      "one", " ", 
     RowBox[{"symbol", ":", " ", 
      RowBox[{
      "they", " ", "are", " ", "gathered", " ", "into", " ", "groups"}]}]}], 
    " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"byBoxes", " ", "=", " ", 
     RowBox[{"GatherBy", "[", 
      RowBox[{"toSymbolize", ",", " ", 
       RowBox[{
        RowBox[{"SL31SymbolBoxes", "[", 
         RowBox[{"#", "[", "\"\<tex\>\"", "]"}], "]"}], " ", "&"}]}], "]"}]}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"meaningOf", " ", "=", " ", 
     RowBox[{"Association", "[", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", "\"\<entry\>\"", "]"}], " ", "->", " ", 
          RowBox[{"#", "[", "\"\<meaning\>\"", "]"}]}], " ", "&"}], ",", " ", 
        "SL31Registry"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"symbolize", " ", "every", " ", "group"}], ";", " ", 
      RowBox[{"record", " ", "the", " ", "TeX", " ", "items"}]}], ",", " ", 
     RowBox[{"the", " ", "entries"}], ",", " ", 
     RowBox[{"the", " ", "kind"}], ",", " ", 
     RowBox[{
     "the", " ", "boxes", " ", "and", " ", "the", " ", "held", " ", 
      "symbol"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"symbolTable", " ", "=", " ", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{"group", ",", " ", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"b", " ", "=", " ", 
              RowBox[{"SL31SymbolBoxes", "[", 
               RowBox[{
                RowBox[{"First", "[", "group", "]"}], "[", "\"\<tex\>\"", 
                "]"}], "]"}]}], ",", " ", "h", ",", " ", "texs", ",", " ", 
             "entries"}], "}"}], ",", "\n", "      ", 
           RowBox[{
            RowBox[{"texs", " ", "=", " ", 
             RowBox[{"Map", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"#", "[", "\"\<tex\>\"", "]"}], " ", "&"}], ",", " ", 
               "group"}], "]"}]}], ";", "\n", "      ", 
            RowBox[{"entries", " ", "=", " ", 
             RowBox[{"DeleteDuplicates", "[", 
              RowBox[{"Map", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"#", "[", "\"\<entry\>\"", "]"}], " ", "&"}], ",", 
                " ", "group"}], "]"}], "]"}]}], ";", "\n", "      ", 
            RowBox[{"h", " ", "=", " ", 
             RowBox[{"SL31Symbolize", "[", "b", "]"}]}], ";", "\n", "      ", 
            
            RowBox[{"(*", " ", 
             RowBox[{"the", " ", "usage", " ", 
              RowBox[{"message", ":", " ", 
               RowBox[{
               "the", " ", "TeX", " ", "items", " ", "of", " ", "the", " ", 
                "symbol", " ", "and", " ", "the", " ", "meanings", " ", "of", 
                " ", "their", " ", "entries"}]}]}], " ", "*)"}], "\n", 
            "      ", 
            RowBox[{"Replace", "[", 
             RowBox[{"h", ",", " ", 
              RowBox[{
               RowBox[{"HoldComplete", "[", "s_Symbol", "]"}], " ", ":>", 
               "\n", "        ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"MessageName", "[", 
                  RowBox[{"s", ",", " ", "\"\<usage\>\""}], "]"}], " ", "=", 
                 " ", 
                 RowBox[{
                  RowBox[{"StringRiffle", "[", 
                   RowBox[{"texs", ",", " ", "\"\<, \>\""}], "]"}], " ", "<>",
                   " ", "\"\<: \>\"", " ", "<>", " ", 
                  RowBox[{"StringRiffle", "[", 
                   RowBox[{
                    RowBox[{"Map", "[", 
                    RowBox[{"meaningOf", ",", " ", "entries"}], "]"}], ",", 
                    " ", "\"\< | \>\""}], "]"}]}]}], ")"}]}]}], "]"}], ";", 
            "\n", "      ", 
            RowBox[{"(*", " ", 
             RowBox[{
              RowBox[{"TraditionalForm", " ", 
               RowBox[{"(", 
                RowBox[{"and", " ", "therefore", " ", "TeXForm"}], ")"}], " ",
                "shows", " ", "the", " ", "printed", " ", "form"}], ",", " ", 
              
              RowBox[{"not", " ", "the", " ", "internal", " ", "name"}]}], 
             " ", "*)"}], "\n", "      ", 
            RowBox[{"Replace", "[", 
             RowBox[{"h", ",", " ", 
              RowBox[{
               RowBox[{"HoldComplete", "[", "s_Symbol", "]"}], " ", ":>", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"MakeBoxes", "[", 
                  RowBox[{"s", ",", " ", "TraditionalForm"}], "]"}], " ", "=",
                  " ", "b"}], ")"}]}]}], "]"}], ";", "\n", "      ", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<entries\>\"", " ", "->", " ", "entries"}], ",", 
              " ", 
              RowBox[{"\"\<tex\>\"", " ", "->", " ", 
               RowBox[{"First", "[", "texs", "]"}]}], ",", " ", 
              RowBox[{"\"\<texAll\>\"", " ", "->", " ", "texs"}], ",", " ", 
              RowBox[{"\"\<kind\>\"", " ", "->", " ", 
               RowBox[{
                RowBox[{"First", "[", "group", "]"}], "[", "\"\<kind\>\"", 
                "]"}]}], ",", "\n", "        ", 
              RowBox[{"\"\<boxes\>\"", " ", "->", " ", "b"}], ",", " ", 
              RowBox[{"\"\<symbol\>\"", " ", "->", " ", "h"}]}], "|>"}]}]}], 
          "]"}]}], "]"}], ",", "\n", "   ", "byBoxes"}], "]"}]}], ";"}], "\n", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", "[", "toSymbolize", "]"}], ",", " ", 
     RowBox[{"Length", "[", "symbolTable", "]"}]}], "}"}]}]}]], "Input",
 CellLabel->
  "In[153]:=",ExpressionUUID->"2a9093cf-2b58-4da6-afa8-4368162ed0e4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"445", ",", "440"}], "}"}]], "Output",
 CellChangeTimes->{4.004025486064664*^9},
 CellLabel->
  "Out[157]=",ExpressionUUID->"fdab84ed-fcf4-4aa3-8b33-03d83f842fc0"]
}, Open  ]],

