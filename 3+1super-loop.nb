In[213]:=",ExpressionUUID->"4e568d17-5929-4b3e-adc5-8650a3c27845"]
}, Open  ]],

Cell["\<\
S-12, uniqueness of the plain-text names: no plain-text name of the registry \
belongs to two different entries (the programs and data files can therefore \
always be read back without ambiguity), and every name maps to one entry.\
\>", "Text",ExpressionUUID->"8e694c4c-30df-4536-bc5b-6a64aa79b41d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"nameToEntries", " ", "=", " ", 
   RowBox[{"GroupBy", "[", 
    RowBox[{
     RowBox[{"Flatten", "[", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{"e", ",", " ", 
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"#", " ", "->", " ", 
              RowBox[{"e", "[", "\"\<entry\>\"", "]"}]}], " ", "&"}], ",", 
            " ", 
            RowBox[{"e", "[", "\"\<names\>\"", "]"}]}], "]"}]}], "]"}], ",", 
        " ", "SL31Registry"}], "]"}], "]"}], ",", " ", 
     RowBox[{"First", " ", "->", " ", "Last"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"shared", " ", "=", " ", 
   RowBox[{"Select", "[", 
    RowBox[{"nameToEntries", ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", 
        RowBox[{"DeleteDuplicates", "[", "#", "]"}], "]"}], " ", ">", " ", 
       "1"}], " ", "&"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-12\>\"", ",", 
    " ", "\"\<no plain-text name is registered for two different entries\>\"",
     ",", "\n", "  ", 
    RowBox[{"shared", " ", "===", " ", 
     RowBox[{"<|", "|>"}]}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Length", "[", "nameToEntries", "]"}], ",", " ", 
      RowBox[{"Normal", "[", "shared", "]"}]}], "}"}]}], "]"}], 
  ";"}]}], "Input",
 CellLabel->
  "In[217]:=",ExpressionUUID->"36620298-4f3f-4064-9078-ea4bb4102331"],

Cell[BoxData[
 StyleBox[
  TemplateBox[{
    StyleBox["\"PASS  \"", Bold, 
     RGBColor[0, 
      Rational[2, 3], 0], StripOnInput -> False], "\"S-12: \"", 
    "\"no plain-text name is registered for two different entries\"", 
    "\"  -- \"", 
    RowBox[{"{", 
      RowBox[{"612", ",", 
        RowBox[{"{", "}"}]}], "}"}]},
   "RowDefault"],
  StripOnInput->False,
  LineIndent->0]], "Print",
 CellChangeTimes->{4.004025486393807*^9},
 CellLabel->
  "During evaluation of \
In[217]:=",ExpressionUUID->"965a31cb-6fdc-4e61-95a3-7199df24b1f7"]
}, Open  ]],

Cell[TextData[{
 "S-13, the kinds that are not symbolized. The imaginary unit ",
 Cell[BoxData[
  FormBox[
   StyleBox["i", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ab67ced4-c6c9-4b65-a649-f5bb39b0b567"],
 " is the Wolfram symbol ",
 StyleBox["I",
  FontFamily->"Source Code Pro"],
 "; the number sets ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[DoubleStruckCapitalR]",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c9c8faaa-1fd1-48ca-8f72-2144b87fff07"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[DoubleStruckCapitalC]",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c3802825-40e7-4032-bf59-d5ed4b086448"],
 " are the Wolfram domains ",
 StyleBox["Reals",
  FontFamily->"Source Code Pro"],
 " and ",
 StyleBox["Complexes",
  FontFamily->"Source Code Pro"],
 " (which the Wolfram Language prints as double-struck letters); the \
operators correspond to Wolfram functions: tr is ",
 StyleBox["Tr",
  FontFamily->"Source Code Pro"],
 ", det is ",
 StyleBox["Det",
  FontFamily->"Source Code Pro"],
 ", diag is ",
 StyleBox["DiagonalMatrix",
  FontFamily->"Source Code Pro"],
 ", Re and Im are ",
 StyleBox["Re",
  FontFamily->"Source Code Pro"],
 " and ",
 StyleBox["Im",
  FontFamily->"Source Code Pro"],
 ", the tensor product ",
 Cell[BoxData[
  FormBox["\[CircleTimes]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5cbe9881-6ab4-4084-9c10-9f1371c1867e"],
 " is ",
 StyleBox["KroneckerProduct",
  FontFamily->"Source Code Pro"],
 ", the transpose ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["", 
    StyleBox["T", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "425bea3b-0c5f-4e20-8c7c-2c4273ac85ab"],
 " is ",
 StyleBox["Transpose",
  FontFamily->"Source Code Pro"],
 ". The test checks each correspondence on the Pauli matrices."
}], "Text",ExpressionUUID->"765b0646-e8e7-4121-8239-756ec533ecbf"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"p1", " ", "=", " ", 
   RowBox[{"pauliValues", "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";", " ", 
  RowBox[{"p2", " ", "=", " ", 
   RowBox[{"pauliValues", "[", 
    RowBox[{"[", "2", "]"}], "]"}]}], ";", " ", 
  RowBox[{"p3", " ", "=", " ", 
   RowBox[{"pauliValues", "[", 
    RowBox[{"[", "3", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"correspondences", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"I", "^", "2"}], " ", "==", " ", 
      RowBox[{"-", "1"}]}], ",", " ", 
     RowBox[{"Element", "[", 
      RowBox[{
       RowBox[{"Sqrt", "[", "2", "]"}], ",", " ", "Reals"}], "]"}], ",", " ", 
     
     RowBox[{"Element", "[", 
      RowBox[{"I", ",", " ", "Complexes"}], "]"}], ",", " ", 
     RowBox[{"!", " ", 
      RowBox[{"Element", "[", 
       RowBox[{"I", ",", " ", "Reals"}], "]"}]}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"Tr", "[", "p3", "]"}], " ", "==", " ", "0"}], ",", " ", 
     RowBox[{
      RowBox[{"Det", "[", "p1", "]"}], " ", "==", " ", 
      RowBox[{"-", "1"}]}], ",", " ", 
     RowBox[{
      RowBox[{"DiagonalMatrix", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", 
         RowBox[{"-", "1"}]}], "}"}], "]"}], " ", "==", " ", "p3"}], ",", " ", 
     RowBox[{
      RowBox[{"Re", "[", "p2", "]"}], " ", "==", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}]}], ",", " ", 
     RowBox[{
      RowBox[{"Im", "[", "p2", "]"}], " ", "==", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", 
          RowBox[{"-", "1"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "0"}], "}"}]}], "}"}]}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"p1", ",", " ", "p3"}], "]"}], " ", ".", " ", 
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"p1", ",", " ", "p3"}], "]"}]}], " ", "==", " ", 
      RowBox[{"IdentityMatrix", "[", "4", "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{"Transpose", "[", "p2", "]"}], " ", "==", " ", 
      RowBox[{"-", "p2"}]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-13\>\"", ",", 
    " ", "\"\<the imaginary unit, the number sets and the operators \
correspond to I, Reals, Complexes, Tr, Det, DiagonalMatrix, Re, Im, \
KroneckerProduct, Transpose\>\"", ",", "\n", "  ", 
    RowBox[{"And", " ", "@@", " ", "correspondences"}], ",", " ", 
    "correspondences"}], "]"}], ";"}]}], "Input",
 CellLabel->
  "In[220]:=",ExpressionUUID->"3009aa90-51cb-4edf-bb39-db908a2e0dab"],

Cell[BoxData[
 StyleBox[
  TemplateBox[{
    StyleBox["\"PASS  \"", Bold, 
     RGBColor[0, 
      Rational[2, 3], 0], StripOnInput -> False], "\"S-13: \"", 
    "\"the imaginary unit, the number sets and the operators correspond to I, \
Reals, Complexes, Tr, Det, DiagonalMatrix, Re, Im, KroneckerProduct, \
Transpose\"", "\"  -- \"", 
    RowBox[{"{", 
      RowBox[{
       "True", ",", "True", ",", "True", ",", "True", ",", "True", ",", 
