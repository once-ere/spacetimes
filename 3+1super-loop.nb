                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "b3fd0e32-0241-48d6-966e-16df99a185f0"],
               " isospin), whose ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubsuperscriptBox["\[Gamma]", 
                   StyleBox["LL",
                    FontSlant->"Plain"], 
                   StyleBox["ch",
                    FontSlant->"Plain"]], "\[LongEqual]", 
