Cell[CellGroupData[{

Cell["\<\
Case C: a domain wall of the pair field (checks AS-7 to AS-9)\
\>", "Subsection",ExpressionUUID->"b5a4f345-7e03-4fe1-b3d9-b5bc7c94896b"],

Cell[TextData[{
 StyleBox["The fields.",
  FontWeight->"Bold"],
 " No gauge fields, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Mu]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "10f6e3a0-4d11-46f7-80ba-b06b7c963172"],
 ", and a real pair field along the third isospin direction that depends on \
",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "1"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a7f80fe5-3c43-44a7-b467-221ec59a2ee1"],
 " and changes its sign: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["d", "TI"], "\[RightVector]"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{"0", ",", "0", ",", 
      SubscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["x", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], "1"], ")"}]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0379b501-0e22-4af9-981c-82e6db986a88"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["x", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], "1"], ")"}], "\[LongEqual]", 
    SubsuperscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Infinity]"], "\[ThinSpace]", 
    StyleBox["tanh",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "1"], "/", 
      SubsuperscriptBox["\[ScriptL]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["K",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4fd5e87e-5318-4970-905d-43185df923fe"],
 ". Two superfluid domains with opposite signs of the order parameter meet at \
a wall of the width ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[ScriptL]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["K",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bb63d1fd-c037-4e81-87fc-0fb9a4d3079a"],
 " (a kink); ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalDelta]", 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Infinity]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "55bc9e73-af36-4ebd-ac7b-d62cb7b7721a"],
 " is the gap far from the wall. The fields do not depend on ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cdce497c-5f94-4975-b78e-b32a2925174b"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7b7dc8b0-f722-4157-8b72-800cbc2ccfba"],
 ", and the modes are plane waves ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["exp",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["i", "TI"], 
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox[
         StyleBox["q", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], "2"], 
        SubsuperscriptBox[
         StyleBox["x", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], "2"], "+", 
        SubsuperscriptBox[
         StyleBox["q", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], "3"], 
        SubsuperscriptBox[
         StyleBox["x", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], "3"]}], ")"}]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bf476ea6-f917-43c8-928b-b510c458f204"],
 " along the wall; first ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "2"], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "3"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fd1cdee8-b104-46f2-90e0-6692d8d935b6"],
 "."
}], "Text",ExpressionUUID->"ee89a501-a333-42a3-a18b-5b25d29744c8"],

Cell[TextData[{
 StyleBox["Four facts about the matrices.",
  FontWeight->"Bold"],
 " With ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "3"], "\[LongEqual]", 
    StyleBox["diag",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["E",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"]], ",", 
      SubscriptBox[
       StyleBox["E",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}], "\[CircleTimes]", 
    SubsuperscriptBox["\[Tau]", "1", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d61585b7-f015-484d-8bc6-84f908b007a2"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], "\[LongEqual]", 
    StyleBox["diag",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       SubsuperscriptBox["\[Sigma]", "1", 
        StyleBox["LL",
         FontSlant->"Plain"]]}], ",", 
      SubsuperscriptBox["\[Sigma]", "1", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "44882de4-0089-4887-936e-36f0536982ab"],
 ": (1) ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox[
         StyleBox["K",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], 
         StyleBox["LL",
          FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"], ")"}], "2"], "\[LongEqual]", 
    RowBox[{"-", 
     SubscriptBox[
      StyleBox["1",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "8"]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8379d65e-5b87-4633-9012-7c08cd84fffb"],
 "; (2) ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"], 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], "\[LongEqual]", 
    RowBox[{"-", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["K",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["LL",
         FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"]}]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "89548351-e0d5-449c-bba8-a6f345c237ed"],
 ", because ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Sigma]", "1", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["E",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Sigma]", "1", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"-", 
     SubscriptBox[
      StyleBox["E",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"]]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "29be098c-2442-4956-91d6-04cdc1ada58c"],
 "; (3) ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"], 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], "\[LongEqual]", 
    RowBox[{"-", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["K",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["LL",
         FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"]}], 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], 
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0fc1976a-7d08-4a3b-b53e-164922a8abee"],
 ", because ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Beta]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2992d653-cfc9-46a0-8cc1-1e2f81369519"],
 " commutes with ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6fd3825f-ac26-429c-a1fb-9bc524c013fe"],
 " and anticommutes with ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Alpha]", 
    StyleBox["LL",
     FontSlant->"Plain"], "1"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a434ae70-e555-4e97-bab9-e9e3ec0253ba"],
 "; (4) ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Alpha]", 
    StyleBox["LL",
     FontSlant->"Plain"], "1"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f0f21f2a-8882-4bf2-8cc4-47d2fbf75b7f"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Beta]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6cf51025-8aef-4162-a055-41c000216faf"],
 " are real."
}], "Text",ExpressionUUID->"fba31103-cb37-4ac2-98e0-aa4c6e1bee57"],

Cell[TextData[{
 StyleBox["The bound states.",
  FontWeight->"Bold"],
 " Let the profile ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CurlyPhi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["K",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3de7dca3-6850-4a76-8526-ce32dc28a48d"],
 " solve ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], 
    SubsuperscriptBox["\[CurlyPhi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]], "/", 
    StyleBox["d", "TI"], 
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], "\[LongEqual]", 
    RowBox[{"-", 
     SubscriptBox["\[CapitalDelta]", 
      StyleBox["LL",
       FontSlant->"Plain"]]}], 
    SubsuperscriptBox["\[CurlyPhi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c4f45db2-f634-43c3-b9b4-fbe54b1947ec"],
 "; for the kink this is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CurlyPhi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["x", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], "1"], ")"}], "\[LongEqual]", 
    StyleBox["cosh",
     FontSlant->"Plain"], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["x", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], "1"], "/", 
       SubsuperscriptBox["\[ScriptL]", 
        StyleBox["LL",
         FontSlant->"Plain"], 
        StyleBox["K",
         FontSlant->"Plain"]]}], ")"}], 
     RowBox[{
      RowBox[{"-", 
       SubsuperscriptBox["\[CapitalDelta]", 
        StyleBox["LL",
         FontSlant->"Plain"], "\[Infinity]"]}], 
      SubsuperscriptBox["\[ScriptL]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["K",
        FontSlant->"Plain"]]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c19eddef-9fee-4558-93d0-2006d844eb86"],
 ". Let ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Chi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["K",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c6846119-abaf-4920-9d13-b61be3dbc9a6"],
 " be a constant spinor of eight components with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Chi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"\[PlusMinus]", 
     SubsuperscriptBox["\[Chi]", 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["K",
       FontSlant->"Plain"]]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "195b60f3-eb10-4e59-9f82-eef76a870b05"],
 ". Then the mode"
}], "Text",ExpressionUUID->"6a5f2033-5652-4b06-b454-a59c80cd7a21"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["\[Psi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p",
     FontSlant->"Plain"]], "\[LongEqual]", 
   SubsuperscriptBox["\[CurlyPhi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["K",
     FontSlant->"Plain"]], 
   SubsuperscriptBox["\[Chi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["K",
     FontSlant->"Plain"]], ",", "      ", 
   SubsuperscriptBox["\[Psi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["h",
     FontSlant->"Plain"]], "\[LongEqual]", 
   StyleBox["i", "TI"], 
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"], 
   SubsuperscriptBox["\[Alpha]", 
    StyleBox["LL",
     FontSlant->"Plain"], "1"], 
   SubsuperscriptBox["\[CurlyPhi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["K",
     FontSlant->"Plain"]], 
   SubsuperscriptBox["\[Chi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["K",
     FontSlant->"Plain"]], ",", "      ", 
   SubsuperscriptBox[
    StyleBox["E", "TI"], 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["n", "TI"]}], 
    StyleBox["qp",
     FontSlant->"Plain"]], "\[LongEqual]", 
   RowBox[{"\[PlusMinus]", 
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}]}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"59abb68e-e489-4aa3-ac75-7475ece40778"],

Cell[TextData[{
 "is a stationary solution of the field equations. Proof. The particle row is \
the sum of three terms. Because ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], 
    SubsuperscriptBox["\[CurlyPhi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]], "/", 
    StyleBox["d", "TI"], 
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], "\[LongEqual]", 
    RowBox[{"-", 
     SubscriptBox["\[CapitalDelta]", 
      StyleBox["LL",
       FontSlant->"Plain"]]}], 
    SubsuperscriptBox["\[CurlyPhi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "77944e47-c13a-48fa-a8f2-8b247444de1b"],
 ", the first term is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     StyleBox["i", "TI"]}], 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], 
    SubscriptBox["\[PartialD]", "1"], 
    SubsuperscriptBox["\[Psi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p",
      FontSlant->"Plain"]], "\[LongEqual]", 
    StyleBox["i", "TI"], 
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[CurlyPhi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], 
    SubsuperscriptBox["\[Chi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f074a1f2-32ec-4ef1-8fc0-0d3b7dea4604"],
 ". The second is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Psi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"\[PlusMinus]", 
     SubscriptBox[
      StyleBox["m", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"]]}], 
    SubsuperscriptBox["\[Psi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "66843f97-6aa1-4b12-a246-0f232941071b"],
 ". The third is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"], 
    SubsuperscriptBox["\[Psi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["h",
      FontSlant->"Plain"]], "\[LongEqual]", 
    StyleBox["i", "TI"], 
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[CurlyPhi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox[
         StyleBox["K",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], 
         StyleBox["LL",
          FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"], ")"}], "2"], 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], 
    SubsuperscriptBox["\[Chi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d3746006-0ba8-43ce-b083-94d36bc9a126"],
 ", which by fact (1) is minus the first. The particle row is therefore ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[PlusMinus]", 
     SubscriptBox[
      StyleBox["m", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"]]}], 
    SubsuperscriptBox["\[Psi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6cfdc68e-5344-4fbc-9119-4687d0c76c3c"],
 ". The hole row, with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["P",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Dagger]"], "\[LongEqual]", 
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "3"], "\[LongEqual]", 
    RowBox[{"-", 
     SubscriptBox["\[CapitalDelta]", 
      StyleBox["LL",
       FontSlant->"Plain"]]}], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4475ddcf-5c5a-4524-bd2b-23ee6e20ed28"],
 " and the real matrices of fact (4), is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "3"], 
    SubsuperscriptBox["\[Psi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p",
      FontSlant->"Plain"]], "-", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["i", "TI"], 
      SubsuperscriptBox["\[Alpha]", 
       StyleBox["LL",
        FontSlant->"Plain"], "1"], 
      SubscriptBox["\[PartialD]", "1"], "+", 
      SubscriptBox["\[Beta]", 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      SubscriptBox[
       StyleBox["m", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}], 
    SubsuperscriptBox["\[Psi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["h",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "05c2d756-956f-4ead-8854-2929b24cffd4"],
 ", again three terms. The first is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "3"], 
    SubsuperscriptBox["\[Psi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"-", 
     SubscriptBox["\[CapitalDelta]", 
      StyleBox["LL",
       FontSlant->"Plain"]]}], 
    SubsuperscriptBox["\[CurlyPhi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"], 
    SubsuperscriptBox["\[Chi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "23f63e70-1867-469d-8d44-e042991c56b3"],
 ". The second is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     StyleBox["i", "TI"]}], 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], 
    SubscriptBox["\[PartialD]", "1"], 
    SubsuperscriptBox["\[Psi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["h",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"-", 
     SubscriptBox["\[CapitalDelta]", 
      StyleBox["LL",
       FontSlant->"Plain"]]}], 
    SubsuperscriptBox["\[CurlyPhi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"], 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], 
    SubsuperscriptBox["\[Chi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fe8a56c9-3ff2-4c02-8096-ff9fd8b471eb"],
 ", which by fact (2) is minus the first. The third is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     SubscriptBox["\[Beta]", 
      StyleBox["LL",
       FontSlant->"Plain"]]}], 
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Psi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["h",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"-", 
     StyleBox["i", "TI"]}], 
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[CurlyPhi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]], 
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"], 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], 
    SubsuperscriptBox["\[Chi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e02e2e83-e3c6-43fa-9c60-a65b0ac84865"],
 ", which by fact (3) is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["i", "TI"], 
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[CurlyPhi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"], 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], 
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Chi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"\[PlusMinus]", 
     SubscriptBox[
      StyleBox["m", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"]]}], 
    SubsuperscriptBox["\[Psi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["h",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c6ba519e-fa12-47a3-be18-b3d09cb43b6d"],
 ". The hole row is therefore ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[PlusMinus]", 
     SubscriptBox[
      StyleBox["m", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"]]}], 
    SubsuperscriptBox["\[Psi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["h",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ccc5f637-e987-4556-b520-7d80f96924e0"],
 ", and the proof is complete."
}], "Text",ExpressionUUID->"939c5f98-d0e6-4294-8481-f61f787fda7b"],

Cell[TextData[{
 "The profile falls off like ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["exp",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       SubsuperscriptBox["\[CapitalDelta]", 
        StyleBox["LL",
         FontSlant->"Plain"], "\[Infinity]"]}], 
      RowBox[{"\[LeftBracketingBar]", 
       SubsuperscriptBox[
        StyleBox["x", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], "1"], "\[RightBracketingBar]"}]}], ")"}]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9c912712-077b-43ce-a1ab-e1b444ea5cda"],
 " on both sides of the wall, because ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalDelta]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "21e83641-25a9-40f3-8bbc-f1750adab2a2"],
 " has opposite signs on the two sides: the state is bound to the wall. The \
spinors with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Chi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"+", 
     SubsuperscriptBox["\[Chi]", 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["K",
       FontSlant->"Plain"]]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "77098c8c-ea37-4c0e-98ee-ed3f034fb0fb"],
 " form a space of four dimensions, and so do those with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Chi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"-", 
     SubsuperscriptBox["\[Chi]", 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["K",
       FontSlant->"Plain"]]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "72b08c02-22ac-4dda-b1de-5e2ca7c123c5"],
 ": every wall carries four bound states of the energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", 
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "180c8685-1856-448c-963e-404cd213649c"],
 " and four of the energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ce4632e2-1236-4dca-9504-bc21c0aadcf1"],
 ". Their energy does not depend on the shape of the profile, only on its \
change of sign (the mechanism of Jackiw and Rebbi, here for the pair field of \
the spinor charges). For an antikink, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"-", 
     SubsuperscriptBox["\[CapitalDelta]", 
      StyleBox["LL",
       FontSlant->"Plain"], "\[Infinity]"]}], "\[ThinSpace]", 
    StyleBox["tanh",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "1"], "/", 
      SubsuperscriptBox["\[ScriptL]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["K",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5a01196c-7536-4d37-86c8-f87d6c2a2fa9"],
 ", the bound states have the same profile and the same energies, and the \
hole part has the opposite sign. Check AS-7 verifies the four facts, and the \
sixteen component equations of the mode at 50 random points with random \
spinors ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Chi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["K",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "27ef30a2-4c28-43ac-a237-79f8bf67e35a"],
 " (a random vector projected on the eigenspace of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Beta]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8998883e-a6c8-43b2-a779-d09ef35076e0"],
 " with the eigenvalue ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1f8a676c-ae9b-487e-9b42-8f60498da328"],
 " or ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8fb8eb12-6dd5-437b-9c0d-e7a54881e067"],
 "), for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Infinity]"], "\[LongEqual]", "1"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "43eec8fc-c14b-4251-953e-b2a0e9ee1488"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[ScriptL]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "08c7c6f5-60b2-4a11-be36-65c87db6e042"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0.4"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "553ab353-31de-414f-a1f7-551e175c0dbf"],
 "."
}], "Text",ExpressionUUID->"d400f60e-d82f-419f-9bc6-7cca30c981e9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"AS", "-", "7"}], ":", " ", 
    RowBox[{
    "the", " ", "identities", " ", "of", " ", "the", " ", "8", " ", "x", " ", 
     "8", " ", "matrices", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"asK3dag", " ", "is", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"K", "^", "3"}], ")"}], "^", "dag"}]}], ",", " ", 
       RowBox[{
        RowBox[{"asAlpha", "[", 
         RowBox[{"[", "1", "]"}], "]"}], " ", "is", " ", 
        RowBox[{"alpha", "^", "1"}]}], ",", " ", 
       RowBox[{"asBeta", " ", "is", " ", "beta"}]}], ")"}]}]}], " ", "*)"}], 
  "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"as7IdDev", " ", "=", " ", 
     RowBox[{
      RowBox[{"fro", "[", 
       RowBox[{
        RowBox[{"asK3dag", " ", ".", " ", "asK3dag"}], " ", "+", " ", 
        RowBox[{"IdentityMatrix", "[", "8", "]"}]}], "]"}], " ", "+", " ", 
      RowBox[{"fro", "[", 
       RowBox[{
        RowBox[{"ConjugateTranspose", "[", "asK3dag", "]"}], " ", "+", " ", 
        "asK3dag"}], "]"}], " ", "+", "\n", "   ", 
      RowBox[{"fro", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"asAlpha", "[", 
          RowBox[{"[", "1", "]"}], "]"}], " ", ".", " ", "asK3dag", " ", ".", 
         " ", 
         RowBox[{"asAlpha", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], " ", "+", " ", "asK3dag"}], "]"}],
       " ", "+", " ", 
      RowBox[{"fro", "[", 
       RowBox[{
        RowBox[{"asBeta", " ", ".", " ", "asK3dag", " ", ".", " ", 
         RowBox[{"asAlpha", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], " ", "+", " ", 
        RowBox[{"asK3dag", " ", ".", " ", 
         RowBox[{"asAlpha", "[", 
          RowBox[{"[", "1", "]"}], "]"}], " ", ".", " ", "asBeta"}]}], "]"}], 
      " ", "+", "\n", "   ", 
      RowBox[{"fro", "[", 
       RowBox[{
        RowBox[{"asAlpha", "[", 
         RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", 
        RowBox[{"Conjugate", "[", 
         RowBox[{"asAlpha", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "]"}], " ", "+", " ", 
      RowBox[{"fro", "[", 
       RowBox[{"asBeta", " ", "-", " ", 
        RowBox[{"Conjugate", "[", "asBeta", "]"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"the", " ", "kink", " ", "of", " ", "case", " ", 
     RowBox[{"C", ":", " ", 
      RowBox[{
      "the", " ", "gap", " ", "far", " ", "from", " ", "the", " ", "wall", " ",
        "and", " ", "the", " ", "width", " ", "of", " ", "the", " ", 
       "wall"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"asCDinf", ",", " ", "asCEllK"}], "}"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"1.0", ",", " ", "1.0"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as7Dev", " ", "=", " ", "0."}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"x", " ", "=", " ", 
           RowBox[{"4.", " ", 
            RowBox[{"t2Unit", "[", "]"}]}]}], ",", " ", "gap", ",", " ", 
          "phi", ",", " ", "dphi", ",", " ", "y", ",", " ", "sg", ",", " ", 
          "chi", ",", " ", "eta", ",", " ", "u", ",", " ", "du", ",", " ", 
          "v", ",", " ", "dv", ",", " ", "rowP", ",", " ", "rowH"}], "}"}], ",",
         "\n", "   ", 
        RowBox[{
         RowBox[{"gap", " ", "=", " ", 
          RowBox[{"asCDinf", " ", 
           RowBox[{"Tanh", "[", 
            RowBox[{"x", "/", "asCEllK"}], "]"}]}]}], ";", "\n", "   ", 
         RowBox[{"phi", " ", "=", " ", 
          RowBox[{
           RowBox[{"Cosh", "[", 
            RowBox[{"x", "/", "asCEllK"}], "]"}], "^", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "asCDinf"}], " ", "asCEllK"}], ")"}]}]}], ";", "\n",
          "   ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{"the", " ", "derivative", " ", "of", " ", "the", " ", 
            RowBox[{"profile", ":", " ", 
             RowBox[{"phi_K", "'"}]}]}], " ", "=", " ", 
           RowBox[{
            RowBox[{"-", "Delta"}], " ", "phi_K"}]}], " ", "*)"}], "\n", 
         "   ", 
         RowBox[{"dphi", " ", "=", " ", 
          RowBox[{
           RowBox[{"-", "gap"}], " ", "phi"}]}], ";", "\n", "   ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{"chi_K", ":", " ", 
            RowBox[{
            "a", " ", "random", " ", "vector", " ", "projected", " ", "on", " ",
              "the", " ", "eigenspace", " ", "beta"}]}], " ", "=", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"+", "1"}], " ", 
             RowBox[{"(", 
              RowBox[{"even", " ", "trials"}], ")"}], " ", "or"}], " ", "-", 
            RowBox[{"1", " ", 
             RowBox[{"(", 
              RowBox[{"odd", " ", "trials"}], ")"}]}]}]}], " ", "*)"}], "\n", 
         "   ", 
         RowBox[{"y", " ", "=", " ", 
          RowBox[{"t2RndVec", "[", "8", "]"}]}], ";", "\n", "   ", 
         RowBox[{"sg", " ", "=", " ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"EvenQ", "[", "trial", "]"}], ",", " ", "1.", ",", " ", 
            RowBox[{"-", "1."}]}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"chi", " ", "=", " ", 
          RowBox[{"0.5", " ", 
           RowBox[{"(", 
            RowBox[{"y", " ", "+", " ", 
             RowBox[{"sg", " ", 
              RowBox[{"asBeta", " ", ".", " ", "y"}]}]}], ")"}]}]}], ";", 
         "\n", "   ", 
         RowBox[{"(*", " ", 
          RowBox[{"i", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"K", "^", "3"}], ")"}], "^", "dag"}], " ", 
           RowBox[{"alpha", "^", "1"}], " ", "chi_K"}], " ", "*)"}], "\n", 
         "   ", 
         RowBox[{"eta", " ", "=", " ", 
          RowBox[{"I", " ", 
           RowBox[{"asK3dag", " ", ".", " ", 
            RowBox[{"asAlpha", "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", ".", " ", "chi"}]}]}], ";", 
         "\n", "   ", 
         RowBox[{"u", " ", "=", " ", 
          RowBox[{"phi", " ", "chi"}]}], ";", " ", 
         RowBox[{"du", " ", "=", " ", 
          RowBox[{"dphi", " ", "chi"}]}], ";", " ", 
         RowBox[{"v", " ", "=", " ", 
          RowBox[{"phi", " ", "eta"}]}], ";", " ", 
         RowBox[{"dv", " ", "=", " ", 
          RowBox[{"dphi", " ", "eta"}]}], ";", "\n", "   ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"the", " ", "particle", " ", "row"}], " ", "-", 
            RowBox[{"i", " ", 
             RowBox[{"alpha", "^", "1"}], " ", 
             RowBox[{"psi_p", "'"}]}], " ", "+", " ", 
            RowBox[{"m", " ", "beta", " ", "psi_p"}], " ", "+", " ", 
            RowBox[{"Delta", " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"K", "^", "3"}], ")"}], "^", "dag"}], " ", "psi_h"}]}],
            ",", " ", 
           RowBox[{
           "minus", " ", "the", " ", "energy", " ", "times", " ", "psi_p"}]}],
           " ", "*)"}], "\n", "   ", 
         RowBox[{"rowP", " ", "=", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "I"}], " ", 
            RowBox[{
             RowBox[{"asAlpha", "[", 
              RowBox[{"[", "1", "]"}], "]"}], " ", ".", " ", "du"}]}], " ", "+",
            " ", 
           RowBox[{"mass", " ", 
            RowBox[{"asBeta", " ", ".", " ", "u"}]}], " ", "+", " ", 
           RowBox[{"gap", " ", 
            RowBox[{"asK3dag", " ", ".", " ", "v"}]}], " ", "-", " ", 
           RowBox[{"sg", " ", "mass", " ", "u"}]}]}], ";", "\n", "   ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"the", " ", "hole", " ", "row", " ", "Delta", " ", 
             RowBox[{"K", "^", "3"}], " ", "psi_p"}], " ", "-", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"i", " ", "conj", 
               RowBox[{"(", 
                RowBox[{"alpha", "^", "1"}], ")"}], " ", 
               RowBox[{"psi_h", "'"}]}], " ", "+", " ", 
              RowBox[{"m", " ", "conj", 
               RowBox[{"(", "beta", ")"}], " ", "psi_h"}]}], ")"}]}], ",", 
           " ", 
           RowBox[{
           "minus", " ", "the", " ", "energy", " ", "times", " ", "psi_h"}]}],
           " ", "*)"}], "\n", "   ", 
         RowBox[{"rowH", " ", "=", " ", 
          RowBox[{
           RowBox[{"gap", " ", 
            RowBox[{
             RowBox[{"ConjugateTranspose", "[", "asK3dag", "]"}], " ", ".", 
             " ", "u"}]}], " ", "-", " ", 
           RowBox[{"I", " ", 
            RowBox[{
             RowBox[{"Conjugate", "[", 
              RowBox[{"asAlpha", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "]"}], " ", ".", " ", "dv"}]}],
            " ", "-", " ", 
           RowBox[{"mass", " ", 
            RowBox[{
             RowBox[{"Conjugate", "[", "asBeta", "]"}], " ", ".", " ", 
             "v"}]}], " ", "-", " ", 
           RowBox[{"sg", " ", "mass", " ", "v"}]}]}], ";", "\n", "   ", 
         RowBox[{"as7Dev", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"as7Dev", ",", " ", 
            RowBox[{"Max", "[", 
             RowBox[{"Abs", "[", "rowP", "]"}], "]"}], ",", " ", 
            RowBox[{"Max", "[", 
             RowBox[{"Abs", "[", "rowH", "]"}], "]"}]}], "]"}]}]}]}], "]"}], ",",
       "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"trial", ",", " ", "0", ",", " ", "49"}], "}"}]}], "]"}], 
    ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<AS-7\>\"", ",", 
     " ", "\"\<the bound states of a domain wall (kink) of the pair field \
(case C), in the continuum: the 8 x 8 matrices (Dirac (x) isospin) satisfy \
(Kch_3^dag)^2 = -1, (Kch_3^dag)^dag = -Kch_3^dag, alpha_LL^1 Kch_3^dag \
alpha_LL^1 = -Kch_3^dag and beta_LL Kch_3^dag alpha_LL^1 = -Kch_3^dag \
alpha_LL^1 beta_LL, and alpha_LL^1 and beta_LL are real (tolerance 1e-13); \
for the kink dvec = (0, 0, Delta(x_LL^1)) with Delta(x_LL^1) = Delta_inf \
tanh(x_LL^1/ell_K) (Delta_inf = 1, ell_K = 1) and mu = 0, the mode psi_p = \
phi_K chi_K, psi_h = i Kch_3^dag alpha_LL^1 phi_K chi_K with phi_K = \
cosh(x_LL^1/ell_K)^(-Delta_inf ell_K) (so that d phi_K/d x_LL^1 = -Delta \
phi_K) and a constant chi_K with beta_LL chi_K = +chi_K or -chi_K satisfies \
the sixteen component equations with the energy +m or -m at 50 random points \
(m = 0.4, random chi_K; tolerance 1e-12)\>\"", ",", "\n", "  ", 
     RowBox[{
      RowBox[{"as7IdDev", " ", "<", " ", "1*^-13"}], " ", "&&", " ", 
      RowBox[{"as7Dev", " ", "<", " ", "1*^-12"}]}], ",", "\n", "  ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<deviations of the identities \>\"", ",", " ", 
        RowBox[{"asSci", "[", "as7IdDev", "]"}], ",", 
        " ", "\"\<, of the equations \>\"", ",", " ", 
        RowBox[{"asSci", "[", "as7Dev", "]"}], ",", 
        " ", "\"\< (original: 0.0e0, 8.3e-17)\>\""}], "}"}], "]"}]}], 
    "]"}]}]}]], "Input",
 CellLabel->
  "In[737]:=",ExpressionUUID->"099df806-14d1-4846-8216-2bb1d7a5df92"],

Cell[BoxData[
 StyleBox[
  TemplateBox[{
    StyleBox["\"PASS  \"", Bold, 
     RGBColor[0, 
      Rational[2, 3], 0], StripOnInput -> False], "\"AS-7: \"", 
    "\"the bound states of a domain wall (kink) of the pair field (case C), \
in the continuum: the 8 x 8 matrices (Dirac (x) isospin) satisfy \
(Kch_3^dag)^2 = -1, (Kch_3^dag)^dag = -Kch_3^dag, alpha_LL^1 Kch_3^dag \
alpha_LL^1 = -Kch_3^dag and beta_LL Kch_3^dag alpha_LL^1 = -Kch_3^dag \
alpha_LL^1 beta_LL, and alpha_LL^1 and beta_LL are real (tolerance 1e-13); \
for the kink dvec = (0, 0, Delta(x_LL^1)) with Delta(x_LL^1) = Delta_inf \
tanh(x_LL^1/ell_K) (Delta_inf = 1, ell_K = 1) and mu = 0, the mode psi_p = \
phi_K chi_K, psi_h = i Kch_3^dag alpha_LL^1 phi_K chi_K with phi_K = \
cosh(x_LL^1/ell_K)^(-Delta_inf ell_K) (so that d phi_K/d x_LL^1 = -Delta \
phi_K) and a constant chi_K with beta_LL chi_K = +chi_K or -chi_K satisfies \
the sixteen component equations with the energy +m or -m at 50 random points \
(m = 0.4, random chi_K; tolerance 1e-12)\"", 
    "\"  -- deviations of the identities 0, of the equations 7.8e-17 \
(original: 0.0e0, 8.3e-17)\""},
   "RowDefault"],
  StripOnInput->False,
  LineIndent->0]], "Print",
 CellChangeTimes->{4.004025510075839*^9},
