               FontSize->9.5,ExpressionUUID->
               "06b204db-1929-4c92-9154-fcaf0642991a"],
              ImageSize->290]},
            {
             PaneBox[
              TemplateBox[{
                TagBox[
                 StyleBox["a", FontWeight -> "Bold", FontSlant -> "Plain"], 
                 "SL31Bold"], "\", \"", 
                TagBox[
                 StyleBox["b", FontWeight -> "Bold", FontSlant -> "Plain"], 
                 "SL31Bold"], "\", \"", 
                TagBox[
                 StyleBox["c", FontWeight -> "Bold", FontSlant -> "Plain"], 
                 "SL31Bold"], "\", \"", 
                TagBox[
                 StyleBox["d", FontWeight -> "Bold", FontSlant -> "Plain"], 
                 "SL31Bold"], "\", \"", 
                SuperscriptBox[
                 TagBox[
                  StyleBox["b", FontWeight -> "Bold", FontSlant -> "Plain"], 
                  "SL31Bold"], "\[Prime]"]},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              StyleBox["\<\"aH bS cH dS bS'\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[Cell[TextData[{
               "bi-quaternions: elements of ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  StyleBox["\[DoubleStruckCapitalC]",
                   FontSlant->"Plain"], "\[CircleTimes]", 
                  StyleBox["\[DoubleStruckCapitalH]",
                   FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "3d1a477b-134e-4752-8ef7-5244f500d4d2"],
               ", the complex combinations of ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubscriptBox[
                   StyleBox["e",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], "0"], ",", 
                  SubscriptBox[
                   StyleBox["e",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], "1"], ",", 
                  SubscriptBox[
                   StyleBox["e",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], "2"], ",", 
                  SubscriptBox[
                   StyleBox["e",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], "3"]}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "b1baf5c6-6b6b-4794-a6ea-741072f50bdf"],
               "; every bi-octonion is written ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  StyleBox["x",
                   FontWeight->"Bold",
                   FontSlant->"Plain"], "\[LongEqual]", 
                  StyleBox["a",
                   FontWeight->"Bold",
                   FontSlant->"Plain"], "+", 
                  StyleBox["b",
                   FontWeight->"Bold",
                   FontSlant->"Plain"], "\[ThinSpace]", 
                  SubscriptBox[
                   StyleBox["e",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], "4"]}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "23cd76fa-6dfc-4915-a452-463c3ec458f8"],
               " (Cayley-Dickson form), and ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  StyleBox["b",
                   FontWeight->"Bold",
                   FontSlant->"Plain"], "\[ThinSpace]", 
                  SubscriptBox[
                   StyleBox["e",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], "4"]}], TraditionalForm]], 
