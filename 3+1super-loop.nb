                   " ", ":>", " ", "f"}], ",", " ", "Infinity"}], "]"}]}], 
               "}"}], ",", "\n", "        ", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"c", " ", "===", " ", 
                 RowBox[{"{", "}"}]}], ",", " ", 
                
                RowBox[{"\"\<$\>\"", " ", "<>", " ", "m", " ", "<>", 
                 " ", "\"\<$\>\""}], ",", " ", 
                RowBox[{"RawBoxes", "[", 
                 RowBox[{"First", "[", "c", "]"}], "]"}]}], "]"}]}], 
             "]"}]}]}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Head", "[", "r", "]"}], " ", "===", " ", 
           "StringExpression"}], ",", " ", 
          RowBox[{"Row", "[", 
           RowBox[{"List", " ", "@@", " ", "r"}], "]"}], ",", " ", "r"}], 
