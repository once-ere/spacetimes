             RowBox[{"f", "\[Prime]"}]]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"H_f\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[
          StyleBox[
           TemplateBox[{"\"the change of the \"", 
             FormBox[
              RowBox[{"16", "\[Cross]", "16"}], TraditionalForm], 
             "\" Bogoliubov matrix per unit of \"", 
             FormBox[
              SubsuperscriptBox["\[Delta]", "LL", "f"], TraditionalForm], 
             "\", \"", 
             FormBox[
              RowBox[{"(", 
                Cell[
                 BoxData[
                  FormBox[
                   GridBox[{{
                    Cell[
                    TextData[{" ", 
                    Cell["0", "InlineFormula"], " "}]], 
                    Cell[
                    TextData[{" ", 
                    Cell[
                    BoxData[
                    RowBox[{
                    SubscriptBox[
                    StyleBox["P", FontSlant -> "Plain"], "LL"], "(", 
                    SubsuperscriptBox[
                    OverscriptBox[
                    StyleBox["u", "TI"], "\[RightVector]"], "LL", "f"], 
                    ")"}]], "InlineFormula"], " "}]]}, {
                    Cell[
                    TextData[{" ", 
                    Cell[
                    BoxData[
                    RowBox[{
                    SubscriptBox[
                    StyleBox["P", FontSlant -> "Plain"], "LL"], 
                    SuperscriptBox[
                    RowBox[{"(", 
                    SubsuperscriptBox[
                    OverscriptBox[
                    StyleBox["u", "TI"], "\[RightVector]"], "LL", "f"], ")"}],
                     "\[Dagger]"]}]], "InlineFormula"], " "}]], 
                    Cell[
                    TextData[{" ", 
                    Cell["0", "InlineFormula"], " "}]]}}], TraditionalForm]]],
                 ")"}], TraditionalForm], "\", where \"", 
             FormBox[
              RowBox[{
                SubscriptBox[
                 StyleBox["P", FontSlant -> "Plain"], "LL"], "(", 
                SubsuperscriptBox[
                 OverscriptBox[
                  StyleBox["u", "TI"], "\[RightVector]"], "LL", "f"], ")"}], 
              TraditionalForm], "\" is the pairing block with \"", 
             FormBox[
              SubsuperscriptBox[
               OverscriptBox[
                StyleBox["u", "TI"], "\[RightVector]"], "LL", "f"], 
              TraditionalForm], "\" in place of \"", 
             FormBox[
              SubscriptBox[
               OverscriptBox[
                StyleBox["d", "TI"], "\[RightVector]"], "LL"], 
              TraditionalForm], "\"; and the same for \"", 
             FormBox[
              SubsuperscriptBox[
               OverscriptBox[
                StyleBox["u", "TI"], "\[RightVector]"], "LL", 
               SuperscriptBox["f", "\[Prime]"]], TraditionalForm]},
            "RowDefault"],
           StripOnInput->False,
           FontFamily->"Source Sans Pro",
           FontSize->9.5],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            RowBox[{
              SubsuperscriptBox["\[Chi]", "LL", "f"], "(", 
              SubsuperscriptBox["\[Omega]", "LL", "B"], ")"}], "\", \"", 
            RowBox[{
              SubsuperscriptBox["\[CapitalGamma]", "LL", "f"], "(", 
              SubsuperscriptBox["\[Omega]", "LL", "B"], ")"}], "\", \"", 
            SubsuperscriptBox["\[CapitalGamma]", "LL", "G"], "\", \"", 
            SubsuperscriptBox["\[CapitalGamma]", "LL", "m"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"chi_f Gamma_f Gamma_bdg Gamma_G Gamma_m\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[
          StyleBox[
           TemplateBox[{"\"the pair susceptibility of a direction \"", 
             FormBox[
              SubsuperscriptBox[
               OverscriptBox[
                StyleBox["u", "TI"], "\[RightVector]"], "LL", "f"], 
              TraditionalForm], 
             "\" of the condensed vacuum at the frequency \"", 
             FormBox[
              SubsuperscriptBox["\[Omega]", "LL", "B"], TraditionalForm], 
             "\" and zero wave number, and the kernel of the direction, \"", 
             FormBox[
              RowBox[{
                SubsuperscriptBox["\[CapitalGamma]", "LL", "f"], 
                "\[LongEqual]", "|", 
                SubsuperscriptBox[
                 OverscriptBox[
                  StyleBox["u", "TI"], "\[RightVector]"], "LL", "f"], 
                SuperscriptBox["|", "2"], "/", 
                SubscriptBox[
                 StyleBox["G", "TI"], "LL"], "-", 
                SubsuperscriptBox["\[Chi]", "LL", "f"]}], TraditionalForm], 
             "\": minus the coefficient of the time average of \"", 
             FormBox[
              SuperscriptBox[
               RowBox[{"(", 
                 SubsuperscriptBox["\[Delta]", "LL", "f"], ")"}], "2"], 
              TraditionalForm], 
             "\" in the effective action per duration and volume (plain text \
`Gamma_bdg`: the kernel computed from the Bogoliubov matrices); the kernels \
of the three Goldstone directions and of the three massive directions, \"", 
             FormBox[
              RowBox[{
                SubsuperscriptBox["\[CapitalGamma]", "LL", "G"], 
                "\[LongEqual]", "-", 
                SuperscriptBox[
                 RowBox[{"(", 
                   SubsuperscriptBox["\[Omega]", "LL", "B"], ")"}], "2"], 
                SubscriptBox["\[CapitalUpsilon]", "LL"]}], TraditionalForm], 
             "\" and \"", 
             FormBox[
              RowBox[{
                SubsuperscriptBox["\[CapitalGamma]", "LL", "m"], 
                "\[LongEqual]", 
                RowBox[{"(", 
                  RowBox[{"4", 
                    SubsuperscriptBox["\[CapitalDelta]", "LL", "2"], "-", 
                    SuperscriptBox[
                    RowBox[{"(", 
                    SubsuperscriptBox["\[Omega]", "LL", "B"], ")"}], "2"]}], 
                  ")"}], 
                SubscriptBox["\[CapitalUpsilon]", "LL"]}], TraditionalForm]},
            "RowDefault"],
           StripOnInput->False,
           FontFamily->"Source Sans Pro",
           FontSize->9.5],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            RowBox[{
              SubscriptBox["\[CapitalUpsilon]", "LL"], "(", 
              SubsuperscriptBox["\[Omega]", "LL", "B"], ")"}], "\", \"", 
            SubsuperscriptBox["\[CapitalUpsilon]", "LL", 
             RowBox[{"(", "1", ")"}]], "\", \"", 
            SubsuperscriptBox["c", "LL", "w"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"Upsilon Upsilon_1\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[
          StyleBox[
           
           TemplateBox[{
            "\"the common factor of the kernels of the condensed vacuum, \"", 
             
             FormBox[
              RowBox[{
                SubscriptBox["\[CapitalUpsilon]", "LL"], "\[LongEqual]", "2", 
                
                SubscriptBox["\[Integral]", 
                 RowBox[{
                   SubscriptBox[
                    StyleBox["q", "TI"], "LL"], "<", 
                   SubscriptBox["\[CapitalLambda]", "LL"]}]], 
                SuperscriptBox[
                 StyleBox["d", "TI"], "3"], 
                SubscriptBox[
                 StyleBox["q", "TI"], "LL"], 
                SuperscriptBox[
                 RowBox[{"(", 
                   RowBox[{"2", "\[Pi]"}], ")"}], "-3"], 
                SuperscriptBox[
                 RowBox[{"(", 
                   RowBox[{
                    SubsuperscriptBox[
                    StyleBox["E", "TI"], "LL", "c"], "(", 
                    RowBox[{"4", 
                    SuperscriptBox[
                    RowBox[{"(", 
                    SubsuperscriptBox[
                    StyleBox["E", "TI"], "LL", "c"], ")"}], "2"], "-", 
                    SuperscriptBox[
                    RowBox[{"(", 
                    SubsuperscriptBox["\[Omega]", "LL", "B"], ")"}], "2"]}], 
                    ")"}], ")"}], "-1"]}], TraditionalForm], "\", with \"", 
             FormBox[
              RowBox[{
                SubscriptBox["\[CapitalUpsilon]", "LL"], 
                RowBox[{"(", "0", ")"}], "\[LongEqual]", 
                SubsuperscriptBox[
                 StyleBox["Z", "TI"], "LL", "t"], 
                RowBox[{"(", 
                  SubscriptBox["\[CapitalDelta]", "LL"], ")"}]}], 
              TraditionalForm], "\"; its derivative with respect to \"", 
             FormBox[
              SuperscriptBox[
               RowBox[{"(", 
                 SubsuperscriptBox["\[Omega]", "LL", "B"], ")"}], "2"], 
              TraditionalForm], "\" at zero; and the positive number \"", 
             FormBox[
              RowBox[{
                SubsuperscriptBox[
                 StyleBox["c", "TI"], "LL", "w"], "\[LongEqual]", 
                SuperscriptBox[
                 RowBox[{"(", 
                   SubsuperscriptBox[
                    StyleBox["M", "TI"], "LL", "q"], ")"}], "2"], "-", 
                SuperscriptBox[
                 RowBox[{"(", 
                   SubsuperscriptBox["\[Omega]", "LL", "B"], ")"}], "2"], "/",
                 "4"}], TraditionalForm], 
             "\", used in the proof that the kernels of the Goldstone and of \
the massive directions are \"", 
             FormBox[
              RowBox[{"-", 
                SuperscriptBox[
                 RowBox[{"(", 
                   SubsuperscriptBox["\[Omega]", "LL", "B"], ")"}], "2"], 
                SubscriptBox["\[CapitalUpsilon]", "LL"]}], TraditionalForm], 
             "\" and \"", 
             FormBox[
              RowBox[{
                RowBox[{"(", 
                  RowBox[{"4", 
                    SubsuperscriptBox["\[CapitalDelta]", "LL", "2"], "-", 
                    SuperscriptBox[
                    RowBox[{"(", 
                    SubsuperscriptBox["\[Omega]", "LL", "B"], ")"}], "2"]}], 
                  ")"}], 
                SubscriptBox["\[CapitalUpsilon]", "LL"]}], TraditionalForm]},
            "RowDefault"],
           StripOnInput->False,
           FontFamily->"Source Sans Pro",
           FontSize->9.5],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox[
             OverscriptBox["d", "\[RightVector]"], "LL", "u"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[
          StyleBox[
           
           TemplateBox[{
            "\"the SFBS field in the unitary gauge, the column of the SFBSv \
parametrization, \"", 
             FormBox[
              RowBox[{"(", 
                RowBox[{
                  StyleBox["i", "TI"], " ", 
                  SubsuperscriptBox[
                   StyleBox["c", "TI"], 
                   RowBox[{"LL", ",", "1"}], "n"], ", ", 
                  StyleBox["i", "TI"], " ", 
                  SubsuperscriptBox[
                   StyleBox["c", "TI"], 
                   RowBox[{"LL", ",", "2"}], "n"], ", ", 
                  SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], "+", 
                  SubsuperscriptBox[
                   StyleBox["h", "TI"], "LL", "a"]}], ")"}], TraditionalForm],
              "\": the field after the gauge transformation that removes the \
three Goldstone fields\""},
            "RowDefault"],
           StripOnInput->False,
           FontFamily->"Source Sans Pro",
           FontSize->9.5],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["V", 
             RowBox[{"LL", ",", "p"}], "F"], "\", \"", 
            SubsuperscriptBox["V", 
             RowBox[{"LL", ",", "p"}], "\[Iota]"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"V V^iota VF\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[
          StyleBox[
           
           TemplateBox[{
            "\"the gauge potentials in the unitary gauge, the vector fields \
of definite mass: \"", 
             FormBox[
              RowBox[{
                SubsuperscriptBox[
                 StyleBox["V", "TI"], 
                 RowBox[{"LL", ",", 
                   StyleBox["p", "TI"]}], "F"], "\[LongEqual]", 
                SubsuperscriptBox[
                 StyleBox["A", "TI"], 
                 RowBox[{"LL", ",", 
                   StyleBox["p", "TI"]}], "F"], "-", 
                SubscriptBox["\[PartialD]", 
                 StyleBox["p", "TI"]], 
                SubsuperscriptBox["\[CurlyTheta]", 
                 RowBox[{"LL", ",", "0"}], "G"], "/", 
                SubsuperscriptBox[
                 StyleBox["g", "TI"], "LL", "F"]}], TraditionalForm], 
             "\" and \"", 
             FormBox[
              RowBox[{
                UnderscriptBox[
                "\[Sum]", "\[Iota]", LimitsPositioning -> True], 
                SubsuperscriptBox[
                 StyleBox["V", "TI"], 
                 RowBox[{"LL", ",", 
                   StyleBox["p", "TI"]}], "\[Iota]"], 
                SubsuperscriptBox["\[Tau]", "\[Iota]", "LL"], "/", "2", 
                "\[LongEqual]", 
                SuperscriptBox[
                 RowBox[{"(", 
                   SubsuperscriptBox[
                    StyleBox["U", FontSlant -> "Plain"], "LL", "G"], ")"}], 
                 "\[Dagger]"], 
                SubscriptBox[
                 StyleBox["a", FontSlant -> "Plain"], 
                 RowBox[{"LL", ",", 
                   StyleBox["p", "TI"]}]], 
                SubsuperscriptBox[
                 StyleBox["U", FontSlant -> "Plain"], "LL", "G"], "-", 
                RowBox[{"(", 
                  RowBox[{
                    StyleBox["i", "TI"], "/", 
                    SubsuperscriptBox[
                    StyleBox["g", "TI"], "LL", "v"]}], ")"}], 
                RowBox[{"(", 
                  RowBox[{
                    SubscriptBox["\[PartialD]", 
                    StyleBox["p", "TI"]], 
                    SuperscriptBox[
                    RowBox[{"(", 
                    SubsuperscriptBox[
                    StyleBox["U", FontSlant -> "Plain"], "LL", "G"], ")"}], 
                    "\[Dagger]"]}], ")"}], 
                SubsuperscriptBox[
                 StyleBox["U", FontSlant -> "Plain"], "LL", "G"]}], 
              TraditionalForm], "\"; to first order \"", 
             FormBox[
              RowBox[{
                SubsuperscriptBox[
                 StyleBox["V", "TI"], 
                 RowBox[{"LL", ",", 
                   StyleBox["p", "TI"]}], "\[Iota]"], "\[LongEqual]", 
                SubsuperscriptBox[
                 StyleBox["A", "TI"], 
                 RowBox[{"LL", ",", 
                   StyleBox["p", "TI"]}], "\[Iota]"], "-", 
                SubscriptBox["\[PartialD]", 
                 StyleBox["p", "TI"]], 
                SubsuperscriptBox["\[CurlyTheta]", 
                 RowBox[{"LL", ",", "\[Iota]"}], "G"], "/", 
                SubsuperscriptBox[
                 StyleBox["g", "TI"], "LL", "v"]}], TraditionalForm], 
             "\" (\"", 
             FormBox[
              RowBox[{"\[Iota]", "\[LongEqual]", "1", ",", "2"}], 
              TraditionalForm], "\") and \"", 
             FormBox[
              RowBox[{
                SubsuperscriptBox[
                 StyleBox["V", "TI"], 
                 RowBox[{"LL", ",", 
                   StyleBox["p", "TI"]}], "3"], "\[LongEqual]", 
                SubsuperscriptBox[
                 StyleBox["A", "TI"], 
                 RowBox[{"LL", ",", 
                   StyleBox["p", "TI"]}], "3"]}], TraditionalForm], 
             "\", the photon\""},
            "RowDefault"],
           StripOnInput->False,
           FontFamily->"Source Sans Pro",
           FontSize->9.5],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["W", 
             RowBox[{"LL", ",", "p"}], "\[PlusMinus]"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"W_+ W_-\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[
          StyleBox[
           TemplateBox[{"\"the charged massive vector fields, \"", 
             FormBox[
              RowBox[{
                RowBox[{"(", 
                  RowBox[{
                    SubsuperscriptBox[
                    StyleBox["V", "TI"], 
                    RowBox[{"LL", ",", 
                    StyleBox["p", "TI"]}], "1"], "\[MinusPlus]", 
                    StyleBox["i", "TI"], 
                    SubsuperscriptBox[
                    StyleBox["V", "TI"], 
                    RowBox[{"LL", ",", 
                    StyleBox["p", "TI"]}], "2"]}], ")"}], "/", 
                SqrtBox["2"]}], TraditionalForm], 
             "\", of the electric charges \"", 
             FormBox[
              RowBox[{"\[PlusMinus]", "1"}], TraditionalForm]},
            "RowDefault"],
           StripOnInput->False,
           FontFamily->"Source Sans Pro",
           FontSize->9.5],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox[
             TagBox[
              StyleBox["M", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
              "SL31SansSerif"], "LL", "t"], "\", \"", 
            SubsuperscriptBox[
             TagBox[
              StyleBox["M", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
              "SL31SansSerif"], "LL", "s"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[
          StyleBox[
           
           TemplateBox[{
            "\"the mass matrices of the time and of the space components of \
the four vector fields \"", 
             FormBox[
              RowBox[{"(", 
                RowBox[{
                  SubsuperscriptBox[
                   StyleBox["V", "TI"], 
                   RowBox[{"LL", ",", 
                    StyleBox["p", "TI"]}], "F"], ",", 
                  SubsuperscriptBox[
                   StyleBox["V", "TI"], 
                   RowBox[{"LL", ",", 
                    StyleBox["p", "TI"]}], "1"], ",", 
                  SubsuperscriptBox[
                   StyleBox["V", "TI"], 
                   RowBox[{"LL", ",", 
                    StyleBox["p", "TI"]}], "2"], ",", 
                  SubsuperscriptBox[
                   StyleBox["V", "TI"], 
                   RowBox[{"LL", ",", 
                    StyleBox["p", "TI"]}], "3"]}], ")"}], TraditionalForm], 
             "\" in the vacuum: \"", 
             FormBox[
              RowBox[{"2", 
                SubsuperscriptBox[
                 StyleBox["Z", "TI"], "LL", "t"]}], TraditionalForm], 
             "\" and \"", 
             FormBox[
              RowBox[{"2", 
                SubsuperscriptBox[
                 StyleBox["Z", "TI"], "LL", "s"]}], TraditionalForm], 
             "\" times the contact matrix of the vacuum, \"", 
             FormBox[
              RowBox[{"diag", 
                RowBox[{"(", 
                  RowBox[{"4", 
                    SuperscriptBox[
                    RowBox[{"(", 
                    SubsuperscriptBox[
                    StyleBox["g", "TI"], "LL", "F"], ")"}], "2"], ",", 
                    SuperscriptBox[
                    RowBox[{"(", 
                    SubsuperscriptBox[
                    StyleBox["g", "TI"], "LL", "v"], ")"}], "2"], ",", 
                    SuperscriptBox[
                    RowBox[{"(", 
                    SubsuperscriptBox[
                    StyleBox["g", "TI"], "LL", "v"], ")"}], "2"], ",", "0"}], 
                  ")"}], 
                SuperscriptBox[
                 RowBox[{"(", 
                   SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], ")"}], 
                 "2"]}], TraditionalForm], 
             "\"; the quadratic Lagrangian contains one half of the first and \
minus one half of the second, each between the row and the column of the \
components\""},
            "RowDefault"],
           StripOnInput->False,
           FontFamily->"Source Sans Pro",
           FontSize->9.5],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["M", "LL", "W"], "\", \"", 
            SubsuperscriptBox["M", "LL", "F"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"M_W M_F M_W_time M_F_time\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[
          StyleBox[
           TemplateBox[{"\"the rest masses of the charged vector fields \"", 
             FormBox[
              SubsuperscriptBox[
               StyleBox["W", "TI"], 
               RowBox[{"LL", ",", 
                 StyleBox["p", "TI"]}], "\[PlusMinus]"], TraditionalForm], 
             "\" and of the fermion-number vector field \"", 
             FormBox[
              SubsuperscriptBox[
               StyleBox["V", "TI"], 
               RowBox[{"LL", ",", 
                 StyleBox["p", "TI"]}], "F"], TraditionalForm], "\", \"", 
             FormBox[
              RowBox[{
                SuperscriptBox[
                 RowBox[{"(", 
                   SubsuperscriptBox[
                    StyleBox["M", "TI"], "LL", "W"], ")"}], "2"], 
                "\[LongEqual]", "2", 
                SubsuperscriptBox[
                 StyleBox["Z", "TI"], "LL", "s"], 
                SuperscriptBox[
                 RowBox[{"(", 
                   SubsuperscriptBox[
                    StyleBox["g", "TI"], "LL", "v"], ")"}], "2"], 
                SuperscriptBox[
                 RowBox[{"(", 
                   SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], ")"}], 
                 "2"]}], TraditionalForm], "\" and \"", 
             FormBox[
              RowBox[{
                SuperscriptBox[
                 RowBox[{"(", 
                   SubsuperscriptBox[
                    StyleBox["M", "TI"], "LL", "F"], ")"}], "2"], 
                "\[LongEqual]", "8", 
                SubsuperscriptBox[
                 StyleBox["Z", "TI"], "LL", "s"], 
                SuperscriptBox[
                 RowBox[{"(", 
                   SubsuperscriptBox[
                    StyleBox["g", "TI"], "LL", "F"], ")"}], "2"], 
                SuperscriptBox[
                 RowBox[{"(", 
                   SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], ")"}], 
                 "2"]}], TraditionalForm], 
             "\" (plain text `M_W_time`, `M_F_time`: the masses of the time \
components, with \"", 
             FormBox[
              SubsuperscriptBox[
               StyleBox["Z", "TI"], "LL", "t"], TraditionalForm], 
             "\" in place of \"", 
             FormBox[
              SubsuperscriptBox[
               StyleBox["Z", "TI"], "LL", "s"], TraditionalForm], "\")\""},
            "RowDefault"],
           StripOnInput->False,
           FontFamily->"Source Sans Pro",
           FontSize->9.5],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["\[Theta]", "LL", "mix"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          
          StyleBox["\<\"theta_mix theta_mix_vacuum theta_mix_saddle \
theta_mix_pred\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[
          StyleBox[
           
           TemplateBox[{
            "\"the mixing angle: the angle between the massless gauge field \
(the null vector of the mass matrix) and the axis of the potential \"", 
             FormBox[
              SubsuperscriptBox[
               StyleBox["A", "TI"], 
               RowBox[{"LL", ",", 
                 StyleBox["p", "TI"]}], "3"], TraditionalForm], 
             "\" in the plane of \"", 
             FormBox[
              SubsuperscriptBox[
               StyleBox["A", "TI"], 
               RowBox[{"LL", ",", 
                 StyleBox["p", "TI"]}], "F"], TraditionalForm], "\" and \"", 
             FormBox[
              SubsuperscriptBox[
               StyleBox["A", "TI"], 
               RowBox[{"LL", ",", 
                 StyleBox["p", "TI"]}], "3"], TraditionalForm], 
             "\"; zero in the vacuum, \"", 
             FormBox[
              RowBox[{"arctan", "(", 
                RowBox[{
                  SubsuperscriptBox[
                   StyleBox["g", "TI"], "LL", "v"], "/", 
                  RowBox[{"(", 
                    RowBox[{"2", 
                    SubsuperscriptBox[
                    StyleBox["g", "TI"], "LL", "F"]}], ")"}]}], ")"}], 
              TraditionalForm], 
             "\" at the non-unitary saddle point (plain text: the values \
found at the vacuum and at the saddle point, and the prediction)\""},
            "RowDefault"],
           StripOnInput->False,
           FontFamily->"Source Sans Pro",
           FontSize->9.5],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["\[ScriptCapitalL]", "LL", 
             RowBox[{"(", "2", ")"}]]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[
          
          StyleBox["\<\"the part of the second order, in the fields of SFBSv \
and the gauge potentials, of the effective Lagrangian of the superfluid boson \
singlet state together with the Yang-Mills and Maxwell terms of the gauge \
fields\"\>",
           StripOnInput->False,
           FontFamily->"Source Sans Pro",
           FontSize->9.5],
          ImageSize->290]}
       },
       AutoDelete->False,
