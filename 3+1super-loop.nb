                RowBox[{"(", 
                  RowBox[{
                    SubsuperscriptBox["\[Psi]", 
                    RowBox[{"LL", ",", 
                    StyleBox["n", "TI"]}], "p"], 
                    SubsuperscriptBox[
                    OverscriptBox[
                    StyleBox["a", "TI"], "^"], 
                    RowBox[{"LL", ",", 
                    StyleBox["n", "TI"]}], "qp"], "+", 
                    SuperscriptBox[
                    RowBox[{"(", 
                    SubsuperscriptBox["\[Psi]", 
                    RowBox[{"LL", ",", 
                    StyleBox["n", "TI"]}], "h"], ")"}], "*"], 
                    SuperscriptBox[
                    RowBox[{"(", 
                    SubsuperscriptBox[
                    OverscriptBox[
                    StyleBox["a", "TI"], "^"], 
                    RowBox[{"LL", ",", 
                    StyleBox["n", "TI"]}], "qp"], ")"}], "\[Dagger]"]}], 
                  ")"}]}], TraditionalForm], 
             "\"; the quasi-particle vacuum is annihilated by every \"", 
             FormBox[
              SubsuperscriptBox[
               OverscriptBox[
                StyleBox["a", "TI"], "^"], 
               RowBox[{"LL", ",", 
                 StyleBox["n", "TI"]}], "qp"], TraditionalForm]},
