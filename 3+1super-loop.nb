         RowBox[{"y", ",", " ", 
          RowBox[{"t2bqConj", "[", "x", "]"}]}], "]"}]}], ";", "\n", "   ", 
       RowBox[{"devA", " ", "=", " ", 
        RowBox[{"Max", "[", 
