               FontSize->9.5,ExpressionUUID->
               "f54b0d0f-5a51-4ee5-b718-0ca458b10a86"],
              ImageSize->290]},
            {
             PaneBox[
              TemplateBox[{
                SubscriptBox["\[CurlyRho]", "LL"], "\", \"", 
