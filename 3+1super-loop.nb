                 "\" isospin each acts as \"", 
                 FormBox[
                  RowBox[{"\[CircleTimes]", 
                    SubsuperscriptBox["\[Sigma]", "0", "LL"]}], 
                  TraditionalForm], "\")\""},
                "RowDefault"],
               StripOnInput->False,
               FontFamily->"Source Sans Pro",
               FontSize->9.5],
