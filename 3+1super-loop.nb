            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "3d5307e5-6343-4c73-a77c-85ebae8eb8ff"],
           " in the vacuum: ",
           Cell[BoxData[
            FormBox[
             RowBox[{"2", 
              SubsuperscriptBox[
               StyleBox["Z", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["t",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "fe12d01d-1389-4fbd-b70c-9ff1f64d2f56"],
           " and ",
           Cell[BoxData[
            FormBox[
             RowBox[{"2", 
              SubsuperscriptBox[
               StyleBox["Z", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["s",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "49830ab6-e82c-4405-a3b7-1866b5a6fbdb"],
           " times the contact matrix of the vacuum, ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              StyleBox["diag",
               FontSlant->"Plain"], 
              RowBox[{"(", 
               RowBox[{"4", 
                SuperscriptBox[
