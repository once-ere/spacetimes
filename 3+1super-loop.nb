              RowBox[{"8", "\[Cross]", "8"}], TraditionalForm], 
             "\" curvature of the spin connection, \"", 
             FormBox[
              RowBox[{
                SubsuperscriptBox[
                 StyleBox["R", FontSlant -> "Plain"], 
                 RowBox[{
                   StyleBox["p", "TI"], 
