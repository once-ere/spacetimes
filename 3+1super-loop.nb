       SubsuperscriptBox["V", 
        RowBox[{"LL", ",", "p"}], "\[Iota]"], ",", " ", 
       SubsuperscriptBox["W", 
        RowBox[{"LL", ",", "p"}], "\[PlusMinus]"], ",", " ", 
       SubsuperscriptBox[
        TagBox[
         StyleBox["M",
