        FontSlant->"Plain"], "0"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8c7c9f35-5054-4ad9-9a1e-e20576b1b63d"],
 " (the derivative of the unknown is minus the unknown, the initial value is \
1), integrated from 0 to 25 with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["tol",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox["10", 
     RowBox[{"-", "8"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0ec795a7-a75e-4265-b5a2-6287e5ae95ec"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["tol",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox["10", 
     RowBox[{"-", "10"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7f67dfa6-7529-42d5-8ceb-0b8b6ee6410c"],
 ". The solution falls from 1 to about ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "11"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a7b0f3ca-5cdf-4185-af5d-28d36fc31e8e"],
 ". While it is much larger than ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["tol",
      FontSlant->"Plain"]], "/", 
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["tol",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox["10", 
     RowBox[{"-", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6f71a517-b397-4623-ba46-9ae3055de539"],
 ", the tolerance of a step is ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["tol",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "59c7ffd2-9693-4d4a-89af-378de940bba0"],
 " times the modulus of the solution; when it is much smaller, the tolerance \
is ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["tol",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a8245a67-5073-4397-8087-8ebbb75c68ec"],
 ". The check requires that the exact local error of every internal step is \
at most the tolerance of the step, and that in each of the two regimes the \
largest ratio of the local error to the tolerance exceeds 1/128. The second \
requirement shows that the tolerances are the stated ones and not smaller \
ones: by its rule for the doubling of a step, IDA at the order 5 doubles the \
step as soon as its estimate falls below 1/128 of the tolerance. Part (b) \
tests ",
 StyleBox["t2evolveIDA",
  FontFamily->"Source Code Pro"],
 " and ",
 StyleBox["t2localErrorsIDA",
  FontFamily->"Source Code Pro"],
 " on a Hermitian ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Times]", "2"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9179b678-b607-4b00-8992-8785fcf7b6e9"],
 " matrix, integrated from 0 to 10 with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["tol",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox["10", 
     RowBox[{"-", "10"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f9423427-785a-4262-a205-0e4cb6ec51f4"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["tol",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox["10", 
     RowBox[{"-", "12"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6f2f5e54-ce2a-4daf-be67-6372150b3eca"],
 " and compared at 21 output times with the solution by the matrix \
exponential (",
 StyleBox["MatrixExp",
  FontFamily->"Source Code Pro"],
 "): every ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Delta]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["loc",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a5e953a5-f5f5-4128-97bd-ce35f4ddbfd2"],
 " is at most ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["loc",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f5f8efa7-1472-4768-b9ba-984cabc55bc4"],
 ", the largest deviation at the output times is at most ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["out",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e894b909-d3d8-4d0f-bbc3-5131f91051ba"],
 ", and the states of ",
 StyleBox["NDSolve",
  FontFamily->"Source Code Pro"],
 " are the cubic Hermite polynomials of the stored values and derivatives \
(tolerance ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "12"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "01db0c2d-be8d-4335-acda-5dd95406d29b"],
 "). Part (c): the function ",
 StyleBox["t2evolveIDAChecked",
  FontFamily->"Source Code Pro"],
 " puts the integration and these measurements together for the checks of the \
later chapters. It computes the eigenvalues and the eigenvectors of the \
matrix itself, and returns the bounds ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["loc",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dff1f2f6-620d-4770-9e93-b33e9f0f58af"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["err",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4a540e25-e695-4d78-98bf-610f832dda86"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["out",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ba99adec-f54f-4697-966b-dc7109fcb4a1"],
 " for a state of any norm, the sum of the measured local errors, and the \
bound of the deviation at the output times that is made with this sum in \
place of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["err",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ef68cfd4-4ea5-49ce-84c9-6e51adceb37e"],
 ". Applied to the problem of part (b) it must give the same states and the \
same bounds; the sum of the local errors must be at most ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["err",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e1a95878-cee7-4fe0-a674-623d417afd71"],
 " (every one of them is at most ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["loc",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "caa55d41-d026-4a62-9853-d34f261c30ef"],
 "), and the largest deviation must be at most the bound made with the sum."
}], "Text",ExpressionUUID->"178c9780-bf54-4d00-a2a5-5dae999e8234"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"T2", "-", 
      RowBox[{"IDA", " ", 
       RowBox[{"(", "a", ")"}]}]}], ":", " ", 
     RowBox[{
     "the", " ", "local", " ", "errors", " ", "that", " ", "IDA", " ", 
      "accepts", " ", "on", " ", "the", " ", "decaying", " ", 
      "exponential"}]}], ",", " ", 
    RowBox[{"rtol", " ", "=", " ", 
     RowBox[{
      RowBox[{"1", "e"}], "-", "8"}]}], ",", " ", 
    RowBox[{"atol", " ", "=", " ", 
     RowBox[{
      RowBox[{"1", "e"}], "-", "10"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rtolDecay", ",", " ", "atolDecay"}], "}"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"1.*^-8", ",", " ", "1.*^-10"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"solDecay", " ", "=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"yD", ",", " ", "tD"}], "}"}], ",", " ", 
       RowBox[{"NDSolveValue", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"yD", "'"}], "[", "tD", "]"}], " ", "==", " ", 
            RowBox[{"-", 
             RowBox[{"yD", "[", "tD", "]"}]}]}], ",", " ", 
           RowBox[{
            RowBox[{"yD", "[", "0", "]"}], " ", "==", " ", "1."}]}], "}"}], ",",
          " ", "yD", ",", " ", 
         RowBox[{"{", 
          RowBox[{"tD", ",", " ", "0", ",", " ", "25"}], "}"}], ",", " ", 
         RowBox[{"Method", " ", "->", " ", "\"\<IDA\>\""}], ",", "\n", 
         "     ", 
         RowBox[{"PrecisionGoal", " ", "->", " ", 
          RowBox[{"-", 
           RowBox[{"Log10", "[", "rtolDecay", "]"}]}]}], ",", " ", 
         RowBox[{"AccuracyGoal", " ", "->", " ", 
          RowBox[{"-", 
           RowBox[{"Log10", "[", "atolDecay", "]"}]}]}]}], "]"}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"gridDecay", " ", "=", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{"solDecay", "[", "\"\<Grid\>\"", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"valsDecay", " ", "=", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{"solDecay", "[", "\"\<ValuesOnGrid\>\"", "]"}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "exact", " ", "local", " ", "error", " ", "of", " ", "every",
       " ", 
      RowBox[{"step", ":", " ", 
       RowBox[{
       "the", " ", "computed", " ", "value", " ", "at", " ", "its", " ", 
        "end", " ", "minus", " ", "the", " ", "exact", " ", "solution", " ", 
        "from", " ", "the", " ", "computed", " ", "value", "\n", "   ", "at", 
        " ", "its", " ", "beginning"}]}]}], ";", " ", 
     RowBox[{
      RowBox[{
      "and", " ", "its", " ", "ratio", " ", "to", " ", "the", " ", 
       "tolerance", " ", "rtol"}], " ", "|", "value", "|", " ", 
      RowBox[{
       RowBox[{"+", " ", "atol"}], " ", "of", " ", "the", " ", "step"}]}]}], 
    " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"localDecay", " ", "=", " ", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"Rest", "[", "valsDecay", "]"}], " ", "-", " ", 
       RowBox[{
        RowBox[{"Most", "[", "valsDecay", "]"}], " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"-", 
          RowBox[{"Differences", "[", "gridDecay", "]"}]}], "]"}]}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ratioDecay", " ", "=", " ", 
     RowBox[{"localDecay", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"rtolDecay", " ", 
         RowBox[{"Abs", "[", 
          RowBox[{"Most", "[", "valsDecay", "]"}], "]"}]}], " ", "+", " ", 
        "atolDecay"}], ")"}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"the", " ", "two", " ", 
       RowBox[{"regimes", ":", " ", 
        RowBox[{"the", " ", "solution", " ", "above", " ", "100", " ", 
         RowBox[{"atol", "/", "rtol"}]}]}]}], " ", "=", " ", 
      RowBox[{
      "1", " ", "never", " ", "holds", " ", "after", " ", "the", " ", "start",
        " ", 
       RowBox[{"(", 
        RowBox[{
        "the", " ", "solution", " ", "is", " ", "at", " ", "most", " ", "1"}],
         ")"}]}]}], ",", " ", 
     RowBox[{
      RowBox[{
      "so", " ", "the", "\n", "   ", "relative", " ", "regime", " ", "is", " ",
        "taken", " ", "as", " ", "the", " ", "solution", " ", "above", " ", 
       "10", " ", 
       RowBox[{"atol", "/", "rtol"}]}], " ", "=", " ", "0.1"}], ",", " ", 
     RowBox[{
      RowBox[{
      "the", " ", "absolute", " ", "regime", " ", "as", " ", "the", " ", 
       "solution", " ", "below", "\n", "   ", 
       RowBox[{"atol", "/", 
        RowBox[{"(", 
         RowBox[{"10", " ", "rtol"}], ")"}]}]}], " ", "=", " ", "0.001"}]}], 
    " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"relDecay", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Pick", "[", 
       RowBox[{"ratioDecay", ",", " ", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#", " ", ">", " ", 
            RowBox[{"10", " ", 
             RowBox[{"atolDecay", "/", "rtolDecay"}]}]}], " ", "&"}], ",", 
          " ", 
          RowBox[{"Abs", "[", 
           RowBox[{"Most", "[", "valsDecay", "]"}], "]"}]}], "]"}]}], "]"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"absDecay", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Pick", "[", 
       RowBox[{"ratioDecay", ",", " ", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#", " ", "<", " ", 
            RowBox[{"atolDecay", "/", 
             RowBox[{"(", 
              RowBox[{"10", " ", "rtolDecay"}], ")"}]}]}], " ", "&"}], ",", 
          " ", 
          RowBox[{"Abs", "[", 
           RowBox[{"Most", "[", "valsDecay", "]"}], "]"}]}], "]"}]}], "]"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"T2", "-", 
      RowBox[{"IDA", " ", 
       RowBox[{"(", "b", ")"}]}]}], ":", " ", 
     RowBox[{
     "t2evolveIDA", " ", "on", " ", "a", " ", "Hermitian", " ", "2", " ", "x",
       " ", "2", " ", "matrix", " ", "against", " ", "the", " ", "matrix", " ",
       "exponential"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"hmTwo", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0.3", ",", " ", 
         RowBox[{"0.5", " ", "-", " ", 
          RowBox[{"0.2", " ", "I"}]}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"0.5", " ", "+", " ", 
          RowBox[{"0.2", " ", "I"}]}], ",", " ", 
         RowBox[{"-", "0.7"}]}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"w0Two", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"0.6", ",", " ", 
       RowBox[{"0.8", " ", "I"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"toutsTwo", " ", "=", " ", 
     RowBox[{"Range", "[", 
      RowBox[{"0.", ",", " ", "10.", ",", " ", "0.5"}], "]"}]}], ";"}], "\n", 
   
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"evTwo", ",", " ", "vvTwo"}], "}"}], " ", "=", " ", 
     RowBox[{"t2eigh", "[", "hmTwo", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rtolTwo", ",", " ", "atolTwo"}], "}"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"1.*^-10", ",", " ", "1.*^-12"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"runTwo", " ", "=", " ", 
     RowBox[{"t2evolveIDA", "[", 
      RowBox[{
      "hmTwo", ",", " ", "w0Two", ",", " ", "toutsTwo", ",", " ", "rtolTwo", ",",
        " ", "atolTwo", ",", " ", 
       RowBox[{"t2localErrorsIDA", "[", 
        RowBox[{
        "evTwo", ",", " ", "vvTwo", ",", " ", "rtolTwo", ",", " ", 
         "atolTwo"}], "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"devTwo", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Norm", "[", 
          RowBox[{"#1", " ", "-", " ", 
           RowBox[{
            RowBox[{"MatrixExp", "[", 
             RowBox[{
              RowBox[{"-", "I"}], " ", "hmTwo", " ", "#2"}], "]"}], " ", ".", 
            " ", "w0Two"}]}], "]"}], " ", "&"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"runTwo", "[", "\"\<states\>\"", "]"}], ",", " ", 
          "toutsTwo"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"blocTwo", " ", "=", " ", 
     RowBox[{
      RowBox[{"rtolTwo", " ", 
       RowBox[{"runTwo", "[", 
        RowBox[{"[", 
         RowBox[{"\"\<analysis\>\"", ",", " ", "\"\<largestNorm\>\""}], "]"}],
         "]"}]}], " ", "+", " ", 
      RowBox[{"atolTwo", " ", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"2.", " ", "2"}], "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"berrTwo", " ", "=", " ", 
     RowBox[{
      RowBox[{"runTwo", "[", "\"\<steps\>\"", "]"}], " ", "blocTwo"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"boutTwo", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", " ", "+", " ", 
         RowBox[{
          RowBox[{"runTwo", "[", "\"\<hmax\>\"", "]"}], " ", 
          RowBox[{
           RowBox[{"Max", "[", 
            RowBox[{"Abs", "[", "evTwo", "]"}], "]"}], "/", "4"}]}]}], ")"}], 
       " ", "berrTwo"}], " ", "+", " ", 
      RowBox[{
       RowBox[{"runTwo", "[", "\"\<hmax\>\"", "]"}], " ", 
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"runTwo", "[", "\"\<residualAt\>\"", "]"}], "]"}], "/", 
        "4"}]}], " ", "+", "\n", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"runTwo", "[", "\"\<hmax\>\"", "]"}], " ", 
           RowBox[{"Max", "[", 
            RowBox[{"Abs", "[", "evTwo", "]"}], "]"}]}], ")"}], "^", "4"}], "/",
         "384"}], " ", 
       RowBox[{"runTwo", "[", 
        RowBox[{"[", 
         RowBox[{"\"\<analysis\>\"", ",", " ", "\"\<largestNorm\>\""}], "]"}],
         "]"}]}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"T2", "-", 
      RowBox[{"IDA", " ", 
       RowBox[{"(", "c", ")"}]}]}], ":", " ", 
     RowBox[{
     "the", " ", "function", " ", "t2evolveIDAChecked", " ", "repeats", " ", 
      "the", " ", "integration", " ", "of", " ", 
      RowBox[{"(", "b", ")"}], " ", "and", " ", "must", " ", "give", " ", 
      "the", " ", "same", " ", "states", " ", "and", " ", "bounds"}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"checkedTwo", " ", "=", " ", 
     RowBox[{"t2evolveIDAChecked", "[", 
      RowBox[{
      "hmTwo", ",", " ", "w0Two", ",", " ", "toutsTwo", ",", " ", "rtolTwo", ",",
        " ", "atolTwo"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sameTwo", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"checkedTwo", "[", "\"\<states\>\"", "]"}], " ", "==", " ", 
       RowBox[{"runTwo", "[", "\"\<states\>\"", "]"}]}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"checkedTwo", "[", "\"\<steps\>\"", "]"}], " ", "==", " ", 
       RowBox[{"runTwo", "[", "\"\<steps\>\"", "]"}]}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"checkedTwo", "[", "\"\<bloc\>\"", "]"}], " ", "==", " ", 
       "blocTwo"}], " ", "&&", "\n", "   ", 
      RowBox[{
       RowBox[{"checkedTwo", "[", "\"\<berr\>\"", "]"}], " ", "==", " ", 
       "berrTwo"}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"checkedTwo", "[", "\"\<bout\>\"", "]"}], " ", "==", " ", 
       "boutTwo"}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"checkedTwo", "[", "\"\<ratio\>\"", "]"}], " ", "==", " ", 
       RowBox[{"runTwo", "[", 
        RowBox[{"[", 
         RowBox[{"\"\<analysis\>\"", ",", " ", "\"\<largestRatio\>\""}], 
         "]"}], "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sumTwo", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"checkedTwo", "[", "\"\<sumloc\>\"", "]"}], " ", "<=", " ", 
       "berrTwo"}], " ", "&&", " ", 
      RowBox[{"devTwo", " ", "<=", " ", 
       RowBox[{"checkedTwo", "[", "\"\<bsum\>\"", "]"}], " ", "<=", " ", 
       "boutTwo"}]}]}], ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<T2-IDA\>\"", ",", 
     " ", "\"\<the integrator IDA of SUNDIALS, used through NDSolve with \
Method -> \\\"IDA\\\": (a) on the decaying exponential (rtol = 1e-8, atol = \
1e-10, x_LL^0 from 0 to 25) the exact local error of every internal step is \
at most the tolerance rtol |value| + atol of the step, and the largest ratio \
of the local error to this tolerance exceeds 1/128 both while the solution is \
above 10 atol/rtol and after it has fallen below atol/(10 rtol): the \
tolerances of IDA are 10^-PrecisionGoal and 10^-AccuracyGoal; (b) on a \
Hermitian 2 x 2 matrix (rtol = 1e-10, atol = 1e-12, 21 output times up to 10) \
every local error is at most budget_step = rtol (norm of the state) + atol \
sqrt(4), the largest deviation from the solution by MatrixExp is at most \
budget_out, and the states of NDSolve are the cubic Hermite polynomials of \
the stored values and derivatives (tolerance 1e-12); (c) the function \
t2evolveIDAChecked, which makes these measurements for the checks of the \
later chapters, gives the same states and the same bounds as (b); the sum of \
its measured local errors is at most budget, and the largest deviation is at \
most the bound made with this sum in place of budget, which is at most \
budget_out\>\"", ",", "\n", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"Max", "[", "ratioDecay", "]"}], " ", "<=", " ", "1"}], " ", "&&",
       " ", 
      RowBox[{"relDecay", " ", ">", " ", 
       RowBox[{"1", "/", "128"}]}], " ", "&&", " ", 
      RowBox[{"absDecay", " ", ">", " ", 
       RowBox[{"1", "/", "128"}]}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"runTwo", "[", 
        RowBox[{"[", 
         RowBox[{"\"\<analysis\>\"", ",", " ", "\"\<largestRatio\>\""}], 
         "]"}], "]"}], " ", "<=", " ", "1"}], " ", "&&", " ", 
      RowBox[{"devTwo", " ", "<=", " ", "boutTwo"}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"Max", "[", 
        RowBox[{"runTwo", "[", "\"\<hermiteAt\>\"", "]"}], "]"}], " ", "<", 
       " ", "1*^-12"}], " ", "&&", " ", "sameTwo", " ", "&&", " ", "sumTwo"}],
      ",", "\n", "  ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<(a) \>\"", ",", " ", 
        RowBox[{"Length", "[", "localDecay", "]"}], ",", 
        " ", "\"\< steps, largest ratio of a local error to its tolerance \
\>\"", ",", " ", 
        RowBox[{"NumberForm", "[", 
         RowBox[{
          RowBox[{"Max", "[", "ratioDecay", "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"4", ",", " ", "3"}], "}"}]}], "]"}], ",", 
        " ", "\"\< (relative regime \>\"", ",", " ", 
        RowBox[{"NumberForm", "[", 
         RowBox[{"relDecay", ",", " ", 
          RowBox[{"{", 
           RowBox[{"4", ",", " ", "3"}], "}"}]}], "]"}], ",", "\n", 
        "    ", "\"\<, absolute regime \>\"", ",", " ", 
        RowBox[{"NumberForm", "[", 
         RowBox[{"absDecay", ",", " ", 
          RowBox[{"{", 
           RowBox[{"4", ",", " ", "3"}], "}"}]}], "]"}], ",", 
        " ", "\"\<); (b) \>\"", ",", " ", 
        RowBox[{"runTwo", "[", "\"\<steps\>\"", "]"}], ",", 
        " ", "\"\< steps, \>\"", ",", " ", 
        RowBox[{"runTwo", "[", "\"\<evaluations\>\"", "]"}], ",", 
        " ", "\"\< evaluations, largest local_error/budget_step \>\"", ",", 
        "\n", "    ", 
        RowBox[{"NumberForm", "[", 
         RowBox[{
          RowBox[{"runTwo", "[", 
           RowBox[{"[", 
            RowBox[{"\"\<analysis\>\"", ",", " ", "\"\<largestRatio\>\""}], 
            "]"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"4", ",", " ", "3"}], "}"}]}], "]"}], ",", 
        " ", "\"\<, largest deviation \>\"", ",", " ", 
        RowBox[{"ScientificForm", "[", 
         RowBox[{"devTwo", ",", " ", "2"}], "]"}], ",", 
        " ", "\"\< <= budget_out \>\"", ",", " ", 
        RowBox[{"ScientificForm", "[", 
         RowBox[{"boutTwo", ",", " ", "2"}], "]"}], ",", "\n", 
        "    ", "\"\<, Hermite polynomials within \>\"", ",", " ", 
        RowBox[{"ScientificForm", "[", 
         RowBox[{
          RowBox[{"Max", "[", 
           RowBox[{"runTwo", "[", "\"\<hermiteAt\>\"", "]"}], "]"}], ",", " ",
           "2"}], "]"}], ",", 
        " ", "\"\<; (c) the same states and bounds: \>\"", ",", " ", 
        "sameTwo", ",", " ", "\"\<; sum of the local errors \>\"", ",", " ", 
        RowBox[{"ScientificForm", "[", 
         RowBox[{
          RowBox[{"checkedTwo", "[", "\"\<sumloc\>\"", "]"}], ",", " ", "2"}],
          "]"}], ",", " ", "\"\< <= budget \>\"", ",", " ", 
        RowBox[{"ScientificForm", "[", 
         RowBox[{"berrTwo", ",", " ", "2"}], "]"}], ",", "\n", 
        "    ", "\"\<, largest deviation \>\"", ",", " ", 
        RowBox[{"ScientificForm", "[", 
         RowBox[{"devTwo", ",", " ", "2"}], "]"}], ",", 
        " ", "\"\< <= bound with the sum \>\"", ",", " ", 
        RowBox[{"ScientificForm", "[", 
         RowBox[{
          RowBox[{"checkedTwo", "[", "\"\<bsum\>\"", "]"}], ",", " ", "2"}], 
         "]"}]}], "}"}], "]"}]}], "]"}]}]}]], "Input",
 CellLabel->
  "In[331]:=",ExpressionUUID->"31c73a18-71df-4657-9980-cae63921b59e"],

Cell[BoxData[
 StyleBox[
  TemplateBox[{
    StyleBox["\"PASS  \"", Bold, 
     RGBColor[0, 
      Rational[2, 3], 0], StripOnInput -> False], "\"T2-IDA: \"", 
    "\"the integrator IDA of SUNDIALS, used through NDSolve with Method -> \\\
\"IDA\\\": (a) on the decaying exponential (rtol = 1e-8, atol = 1e-10, x_LL^0 \
from 0 to 25) the exact local error of every internal step is at most the \
tolerance rtol |value| + atol of the step, and the largest ratio of the local \
error to this tolerance exceeds 1/128 both while the solution is above 10 \
atol/rtol and after it has fallen below atol/(10 rtol): the tolerances of IDA \
are 10^-PrecisionGoal and 10^-AccuracyGoal; (b) on a Hermitian 2 x 2 matrix \
(rtol = 1e-10, atol = 1e-12, 21 output times up to 10) every local error is \
at most budget_step = rtol (norm of the state) + atol sqrt(4), the largest \
deviation from the solution by MatrixExp is at most budget_out, and the \
states of NDSolve are the cubic Hermite polynomials of the stored values and \
derivatives (tolerance 1e-12); (c) the function t2evolveIDAChecked, which \
makes these measurements for the checks of the later chapters, gives the same \
states and the same bounds as (b); the sum of its measured local errors is at \
most budget, and the largest deviation is at most the bound made with this \
sum in place of budget, which is at most budget_out\"", 
    "\"  -- (a) 458 steps, largest ratio of a local error to its tolerance \
0.495 (relative regime 0.495, absolute regime 0.315); (b) 910 steps, 1088 \
evaluations, largest local_error/budget_step 0.471, largest deviation 1.6e-9 \
<= budget_out 9.4e-8, Hermite polynomials within 1.3e-16; (c) the same states \
and bounds: True; sum of the local errors 7.3e-9 <= budget 9.3e-8, largest \
deviation 1.6e-9 <= bound with the sum 8.3e-9\""},
