                  SubscriptBox[
                   StyleBox["K", FontSlant -> "Plain"], "12"], 
                  TraditionalForm], "\" is the entry of \"", 
                 FormBox[
                  StyleBox["K", FontSlant -> "Plain"], TraditionalForm], 
                 "\" in row 1 and column 2\""},
                "RowDefault"],
               StripOnInput->False,
               FontFamily->"Source Sans Pro",
               FontSize->9.5],
              ImageSize->290]},
