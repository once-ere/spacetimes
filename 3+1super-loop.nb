            StyleBox["s", "TI"], "\[RightVector]"], 
           StyleBox["LL",
            FontSlant->"Plain"]], "-", 
          SubsuperscriptBox[
           OverscriptBox["\[Delta]", "\[RightVector]"], 
           StyleBox["LL",
            FontSlant->"Plain"], 
           StyleBox["j", "TI"]]}], ")"}], "\[Dagger]"], 
       SubsuperscriptBox["\[Psi]", 
        StyleBox["LL",
         FontSlant->"Plain"], 
        StyleBox["p",
         FontSlant->"Plain"]], 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox[
          OverscriptBox[
           StyleBox["s", "TI"], "\[RightVector]"], 
          StyleBox["LL",
           FontSlant->"Plain"]], "-", 
         SubsuperscriptBox[
          OverscriptBox["\[Delta]", "\[RightVector]"], 
          StyleBox["LL",
           FontSlant->"Plain"], 
          StyleBox["j", "TI"]]}], ")"}]}], ")"}], "-", 
     FractionBox[
      SubsuperscriptBox[
       StyleBox["r", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["W",
        FontSlant->"Plain"]], 
      RowBox[{"2", 
       SubsuperscriptBox["\[ScriptL]", 
        StyleBox["LL",
         FontSlant->"Plain"], 
        StyleBox["x",
         FontSlant->"Plain"]]}]], 
     SubscriptBox["\[Beta]", 
      StyleBox["LL",
       FontSlant->"Plain"]], 
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["U",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["LL",
          FontSlant->"Plain"], ",", 
         StyleBox["j", "TI"]}], 
        StyleBox["link",
         FontSlant->"Plain"]], 
       RowBox[{"(", 
        SubscriptBox[
         OverscriptBox[
          StyleBox["s", "TI"], "\[RightVector]"], 
         StyleBox["LL",
          FontSlant->"Plain"]], ")"}], 
       SubsuperscriptBox["\[Psi]", 
        StyleBox["LL",
         FontSlant->"Plain"], 
        StyleBox["p",
         FontSlant->"Plain"]], 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox[
          OverscriptBox[
           StyleBox["s", "TI"], "\[RightVector]"], 
          StyleBox["LL",
           FontSlant->"Plain"]], "+", 
         SubsuperscriptBox[
          OverscriptBox["\[Delta]", "\[RightVector]"], 
          StyleBox["LL",
           FontSlant->"Plain"], 
          StyleBox["j", "TI"]]}], ")"}], "+", 
       SubsuperscriptBox[
        StyleBox["U",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["LL",
          FontSlant->"Plain"], ",", 
         StyleBox["j", "TI"]}], 
        StyleBox["link",
         FontSlant->"Plain"]], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubscriptBox[
           OverscriptBox[
            StyleBox["s", "TI"], "\[RightVector]"], 
           StyleBox["LL",
            FontSlant->"Plain"]], "-", 
          SubsuperscriptBox[
           OverscriptBox["\[Delta]", "\[RightVector]"], 
           StyleBox["LL",
            FontSlant->"Plain"], 
           StyleBox["j", "TI"]]}], ")"}], "\[Dagger]"], 
       SubsuperscriptBox["\[Psi]", 
        StyleBox["LL",
         FontSlant->"Plain"], 
        StyleBox["p",
         FontSlant->"Plain"]], 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox[
          OverscriptBox[
           StyleBox["s", "TI"], "\[RightVector]"], 
          StyleBox["LL",
           FontSlant->"Plain"]], "-", 
         SubsuperscriptBox[
          OverscriptBox["\[Delta]", "\[RightVector]"], 
          StyleBox["LL",
           FontSlant->"Plain"], 
          StyleBox["j", "TI"]]}], ")"}], "-", "2", 
       SubsuperscriptBox["\[Psi]", 
        StyleBox["LL",
         FontSlant->"Plain"], 
        StyleBox["p",
         FontSlant->"Plain"]], 
       RowBox[{"(", 
        SubscriptBox[
         OverscriptBox[
          StyleBox["s", "TI"], "\[RightVector]"], 
         StyleBox["LL",
          FontSlant->"Plain"]], ")"}]}], ")"}]}], "]"}], "+", 
   SubscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   SubscriptBox["\[Beta]", 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   SubsuperscriptBox["\[Psi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p",
     FontSlant->"Plain"]], 
   RowBox[{"(", 
