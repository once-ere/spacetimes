         "the", " ", "eigenvectors", " ", "in", " ", "the", "\n", "   ", 
          "columns"}]}], ")"}], " ", "and", " ", "the", " ", "spectral", " ", 
       "sum"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"e13", ",", " ", "v13"}], "}"}], " ", "=", " ", 
     RowBox[{"t2eigh", "[", "hl", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"eMax13", " ", "=", " ", 
