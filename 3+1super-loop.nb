                    SubsuperscriptBox["\[Gamma]", "LL", "3"], "\[LongEqual]", 
                    
                    StyleBox["diag", FontSlant -> "Plain"], 
                    RowBox[{"(", 
                    RowBox[{"-1", ",", "-1", ",", "1", ",", "1"}], ")"}]}], 
                  TraditionalForm], "\"; the charge-conjugation matrix \"", 
                 FormBox[
                  RowBox[{
                    SubscriptBox[
                    StyleBox["C", "TI"], "LL"], "\[LongEqual]", 
