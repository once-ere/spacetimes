                "\[Sum]", "\[Iota]", LimitsPositioning -> True], 
                SubsuperscriptBox[
                 StyleBox["A", "TI"], 
                 RowBox[{"LL", ",", 
                   StyleBox["p", "TI"]}], "\[Iota]"], 
                SubscriptBox[
                 StyleBox["e", FontSlant -> "Bold"], "\[Iota]"], "/", "2"}], 
              TraditionalForm], "\" (an element of \"", 
             FormBox[
              RowBox[{"Im", " ", 
