                    RowBox[{
                    SubscriptBox["\[CapitalPsi]", "LL"], 
                    RowBox[{"(", 
                    SubscriptBox[
                    OverscriptBox[
                    StyleBox["q", "TI"], "\[RightVector]"], "LL"], ")"}], ",", 
                    SubsuperscriptBox["\[CapitalPsi]", "LL", "*"], 
                    RowBox[{"(", 
                    RowBox[{"-", 
                    SubscriptBox[
                    OverscriptBox[
                    StyleBox["q", "TI"], "\[RightVector]"], "LL"]}], ")"}]}], 
                    ")"}]}], TraditionalForm], "\" on which it acts\""},
                "RowDefault"],
               StripOnInput->False,
               FontFamily->"Source Sans Pro",
               FontSize->9.5],
              ImageSize->290]},
            {
             PaneBox[
              TemplateBox[{
                SubscriptBox[
                 TagBox[
                  StyleBox[
                  "D", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
