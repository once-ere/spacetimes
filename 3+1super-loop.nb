                    RowBox[{"--", 
                    RowBox[{
                    "--", "--"}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]\
}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"BeginPackage", "[", "\"\<SL31`\>\"", "]"}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"SL31TeXFormula", "::", "usage"}], " ", "=", 
     " ", "\"\<SL31TeXFormula[tex] converts the TeX of a formula into \
two-dimensional Wolfram boxes for display: fractions, roots, sums and \
integrals with their limits, accents, matrices, delimiters, and every letter \
in its alphabet (italic, upright, bold, sans-serif, double-struck, script, \
Gothic).\>\""}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"SL31TeXFormulaProblems", "::", "usage"}], " ", "=", 
     " ", "\"\<SL31TeXFormulaProblems[tex] lists what the reader of formulas \
could not read in tex: unknown commands, missing arguments, unmatched braces. \
The empty list means that the whole formula was read.\>\""}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"SL31FormulaCell", "::", "usage"}], " ", "=", 
     " ", "\"\<SL31FormulaCell[tex] returns the inline cell that shows the \
formula tex inside a text.\>\""}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"SL31TextData", "::", "usage"}], " ", "=", 
     " ", "\"\<SL31TextData[text] converts a text with formulas between \
dollar signs, code between backquotes and bold text between double asterisks \
into the content of a text cell.\>\""}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"SL31TextFormulas", "::", "usage"}], " ", "=", 
     " ", "\"\<SL31TextFormulas[text] lists the TeX of the formulas that \
SL31TextData finds in text.\>\""}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"SL31TextBoxes", "::", "usage"}], " ", "=", 
     " ", "\"\<SL31TextBoxes[text, options] returns the boxes of an inline \
text cell that shows text (converted by SL31TextData); the options are cell \
options such as FontSize.\>\""}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"SL31FormulaReading", "::", "usage"}], " ", "=", 
     " ", "\"\<SL31FormulaReading[boxes] writes boxes on one line, so that \
two readings of a formula can be compared: a fraction as frac{a}{b}, a root \
as sqrt{a}, scripts as _{..} and ^{..}, an accent as over{a}{accent}, a \
matrix as grid[a&b;c&d], and a bold or sans-serif letter as <bf:b> or <sf:N>; \
spaces, the italic and upright styles and the grouping of rows are left \
out.\>\""}], ";"}], "\n", "\n", 
