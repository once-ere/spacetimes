                  FontSlant->"Plain"]]}], ")"}], 
              SubsuperscriptBox[
               StyleBox["R",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["v",
                FontSlant->"Plain"]], 
              RowBox[{"(", 
