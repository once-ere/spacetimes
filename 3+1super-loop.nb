Cell[CellGroupData[{

Cell["I.6 Symbolizing every symbol", "Section",ExpressionUUID->"2163113f-e887-4d64-8164-12a5ba82e626"],

Cell[TextData[{
 "Now every item of the kinds symbol, family, function, function family, \
letter, primed index, group, ket and expression is symbolized: ",
 StyleBox["SL31Symbolize",
  FontFamily->"Source Code Pro"],
 " calls ",
 StyleBox["Symbolize",
  FontFamily->"Source Code Pro"],
 " with the explicit working form and with a readable name built from the \
letters, the scripts and the alphabet, and returns the new symbol, held. \
Items whose boxes coincide are ONE symbol and are symbolized once: a function \
symbol written with different arguments, such as ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["N", "TI"], "LL"], "(", 
     StyleBox["x",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"f59e3f89-daa3-4272-aa43-a047a55e9b26"]], "InlineFormula",
  ExpressionUUID->"0414f7de-6369-4e7c-99a6-34524ddb77d3"],
 " and ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["N", "TI"], "LL"], "(", 
     RowBox[{
      StyleBox["x",
       FontWeight->"Bold",
       FontSlant->"Plain"], ",", 
      StyleBox["y",
       FontWeight->"Bold",
       FontSlant->"Plain"]}], ")"}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"1d15a9fe-a945-4dfd-bc58-dc3af2362cb0"]], "InlineFormula",
  ExpressionUUID->"44a18d78-a8e7-4569-8add-9303b5ced8da"],
 ", has the one head ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubscriptBox[
     StyleBox["N", "TI"], "LL"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"497cedcf-d6a7-48a9-bab8-8474ab0db8e1"]], "InlineFormula",
  ExpressionUUID->"2a920456-89a0-484f-afcc-66a490ca2e01"],
 " (symbolizing the same box twice would only replace the first \
symbolization, with a warning of the Notation package). For every new symbol \
the cell also stores its meaning as the usage message (so that ",
 StyleBox["?symbol",
  FontFamily->"Source Code Pro"],
 " prints it), and a formatting rule for ",
 StyleBox["TraditionalForm",
  FontFamily->"Source Code Pro"],
 ": ",
 StyleBox["TeXForm",
  FontFamily->"Source Code Pro"],
 " writes TeX from the ",
 StyleBox["TraditionalForm",
  FontFamily->"Source Code Pro"],
 " boxes of an expression, so with this rule the symbol is written in TeX \
with its printed form and not with its internal name."
}], "Text",ExpressionUUID->"703d65c6-26b6-4145-83f9-f0ff90dceb94"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", "items", " ", "that", " ", "are", " ", "symbolized"}],
     ",", " ", 
    RowBox[{"each", " ", "TeX", " ", "item", " ", "once"}]}], " ", "*)"}], 
  "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"toSymbolize", " ", "=", " ", 
     RowBox[{"DeleteDuplicatesBy", "[", 
      RowBox[{
       RowBox[{"Select", "[", 
        RowBox[{"items", ",", " ", 
         RowBox[{
          RowBox[{"MemberQ", "[", 
           RowBox[{"SL31Symbolized", ",", " ", 
            RowBox[{"#", "[", "\"\<kind\>\"", "]"}]}], "]"}], " ", "&"}]}], 
        "]"}], ",", " ", 
       RowBox[{
        RowBox[{"#", "[", "\"\<tex\>\"", "]"}], " ", "&"}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "items", " ", "with", " ", "the", " ", "same", " ", "boxes", " ", "are", " ",
      "one", " ", 
     RowBox[{"symbol", ":", " ", 
      RowBox[{
      "they", " ", "are", " ", "gathered", " ", "into", " ", "groups"}]}]}], 
    " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"byBoxes", " ", "=", " ", 
     RowBox[{"GatherBy", "[", 
      RowBox[{"toSymbolize", ",", " ", 
       RowBox[{
        RowBox[{"SL31SymbolBoxes", "[", 
         RowBox[{"#", "[", "\"\<tex\>\"", "]"}], "]"}], " ", "&"}]}], "]"}]}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"meaningOf", " ", "=", " ", 
     RowBox[{"Association", "[", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", "\"\<entry\>\"", "]"}], " ", "->", " ", 
          RowBox[{"#", "[", "\"\<meaning\>\"", "]"}]}], " ", "&"}], ",", " ", 
        "SL31Registry"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"symbolize", " ", "every", " ", "group"}], ";", " ", 
      RowBox[{"record", " ", "the", " ", "TeX", " ", "items"}]}], ",", " ", 
     RowBox[{"the", " ", "entries"}], ",", " ", 
     RowBox[{"the", " ", "kind"}], ",", " ", 
     RowBox[{
     "the", " ", "boxes", " ", "and", " ", "the", " ", "held", " ", 
      "symbol"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"symbolTable", " ", "=", " ", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{"group", ",", " ", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"b", " ", "=", " ", 
              RowBox[{"SL31SymbolBoxes", "[", 
               RowBox[{
                RowBox[{"First", "[", "group", "]"}], "[", "\"\<tex\>\"", 
                "]"}], "]"}]}], ",", " ", "h", ",", " ", "texs", ",", " ", 
             "entries"}], "}"}], ",", "\n", "      ", 
           RowBox[{
            RowBox[{"texs", " ", "=", " ", 
             RowBox[{"Map", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"#", "[", "\"\<tex\>\"", "]"}], " ", "&"}], ",", " ", 
               "group"}], "]"}]}], ";", "\n", "      ", 
            RowBox[{"entries", " ", "=", " ", 
             RowBox[{"DeleteDuplicates", "[", 
              RowBox[{"Map", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"#", "[", "\"\<entry\>\"", "]"}], " ", "&"}], ",", 
                " ", "group"}], "]"}], "]"}]}], ";", "\n", "      ", 
            RowBox[{"h", " ", "=", " ", 
             RowBox[{"SL31Symbolize", "[", "b", "]"}]}], ";", "\n", "      ", 
            
            RowBox[{"(*", " ", 
             RowBox[{"the", " ", "usage", " ", 
              RowBox[{"message", ":", " ", 
               RowBox[{
               "the", " ", "TeX", " ", "items", " ", "of", " ", "the", " ", 
                "symbol", " ", "and", " ", "the", " ", "meanings", " ", "of", 
                " ", "their", " ", "entries"}]}]}], " ", "*)"}], "\n", 
            "      ", 
            RowBox[{"Replace", "[", 
             RowBox[{"h", ",", " ", 
              RowBox[{
               RowBox[{"HoldComplete", "[", "s_Symbol", "]"}], " ", ":>", 
               "\n", "        ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"MessageName", "[", 
                  RowBox[{"s", ",", " ", "\"\<usage\>\""}], "]"}], " ", "=", 
                 " ", 
                 RowBox[{
                  RowBox[{"StringRiffle", "[", 
                   RowBox[{"texs", ",", " ", "\"\<, \>\""}], "]"}], " ", "<>",
                   " ", "\"\<: \>\"", " ", "<>", " ", 
                  RowBox[{"StringRiffle", "[", 
                   RowBox[{
                    RowBox[{"Map", "[", 
                    RowBox[{"meaningOf", ",", " ", "entries"}], "]"}], ",", 
                    " ", "\"\< | \>\""}], "]"}]}]}], ")"}]}]}], "]"}], ";", 
            "\n", "      ", 
            RowBox[{"(*", " ", 
             RowBox[{
              RowBox[{"TraditionalForm", " ", 
               RowBox[{"(", 
                RowBox[{"and", " ", "therefore", " ", "TeXForm"}], ")"}], " ",
                "shows", " ", "the", " ", "printed", " ", "form"}], ",", " ", 
              
              RowBox[{"not", " ", "the", " ", "internal", " ", "name"}]}], 
             " ", "*)"}], "\n", "      ", 
            RowBox[{"Replace", "[", 
             RowBox[{"h", ",", " ", 
              RowBox[{
               RowBox[{"HoldComplete", "[", "s_Symbol", "]"}], " ", ":>", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"MakeBoxes", "[", 
                  RowBox[{"s", ",", " ", "TraditionalForm"}], "]"}], " ", "=",
                  " ", "b"}], ")"}]}]}], "]"}], ";", "\n", "      ", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<entries\>\"", " ", "->", " ", "entries"}], ",", 
              " ", 
              RowBox[{"\"\<tex\>\"", " ", "->", " ", 
               RowBox[{"First", "[", "texs", "]"}]}], ",", " ", 
              RowBox[{"\"\<texAll\>\"", " ", "->", " ", "texs"}], ",", " ", 
              RowBox[{"\"\<kind\>\"", " ", "->", " ", 
               RowBox[{
                RowBox[{"First", "[", "group", "]"}], "[", "\"\<kind\>\"", 
                "]"}]}], ",", "\n", "        ", 
              RowBox[{"\"\<boxes\>\"", " ", "->", " ", "b"}], ",", " ", 
              RowBox[{"\"\<symbol\>\"", " ", "->", " ", "h"}]}], "|>"}]}]}], 
          "]"}]}], "]"}], ",", "\n", "   ", "byBoxes"}], "]"}]}], ";"}], "\n", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", "[", "toSymbolize", "]"}], ",", " ", 
     RowBox[{"Length", "[", "symbolTable", "]"}]}], "}"}]}]}]], "Input",
 CellLabel->"In[84]:=",ExpressionUUID->"350ff7b2-a7d5-480b-921f-a5c783583ba7"],

