   "\[InvisibleSpace]", "\<\": \"\>", 
   "\[InvisibleSpace]", "\<\"the Lorentz generators of the super-loop on the \
Dirac spinor, sgen(J^j) = diag(-i sigma_j/2, -i sigma_j/2) = gamma^j' \
gamma^j''/2, sgen(K^j) = diag(-sigma_j/2, sigma_j/2) = gamma^0 gamma^j/2; the \
27 relations of so(3,1); 24 intertwining relations [gamma^p, sgen(u)] = sum \
V(u)[p][q] gamma^q\"\>", "\[InvisibleSpace]", 
   TemplateBox[{"\"  -- \"", 
     TemplateBox[{
      "27", "\" commutation relations, \"", "24", 
       "\" intertwining relations (original: 27 and 24)\""}, "RowDefault"]},
    "RowDefault"]}],
  SequenceForm[
   Style["PASS  ", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0]], "GS-2", ": ", 
   "the Lorentz generators of the super-loop on the Dirac spinor, sgen(J^j) = \
diag(-i sigma_j/2, -i sigma_j/2) = gamma^j' gamma^j''/2, sgen(K^j) = \
diag(-sigma_j/2, sigma_j/2) = gamma^0 gamma^j/2; the 27 relations of so(3,1); \
24 intertwining relations [gamma^p, sgen(u)] = sum V(u)[p][q] gamma^q", 
   Row[{"  -- ", 
     Row[{
      27, " commutation relations, ", 24, 
       " intertwining relations (original: 27 and 24)"}]}]],
