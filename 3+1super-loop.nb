         PaneBox[
          StyleBox["\<\"u_f delta_f\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[
          StyleBox[
           
           TemplateBox[{
            "\"a fixed complex unit vector, the direction of a deviation \"", 
             
             FormBox[
              RowBox[{
                SubsuperscriptBox["\[Delta]", "LL", "f"], 
                RowBox[{"(", 
                  SubscriptBox[
                   StyleBox["x", "TI"], "LL"], ")"}], " ", 
                SubsuperscriptBox[
                 OverscriptBox[
                  StyleBox["u", "TI"], "\[RightVector]"], "LL", "f"]}], 
              TraditionalForm], "\" of the field from the vacuum \"", 
             FormBox[
              RowBox[{"(", 
                RowBox[{"0", ",", "0", ",", 
                  SubscriptBox["\[CapitalDelta]", "LL"]}], ")"}], 
              TraditionalForm], "\", one of the six directions \"", 
             FormBox[
              RowBox[{"(", 
                RowBox[{"1", ",", "0", ",", "0"}], ")"}], TraditionalForm], 
             "\", \"", 
             FormBox[
              RowBox[{"(", 
                RowBox[{"0", ",", "1", ",", "0"}], ")"}], TraditionalForm], 
             "\", \"", 
             FormBox[
              RowBox[{"(", 
                RowBox[{"0", ",", "0", ",", 
                  StyleBox["i", "TI"]}], ")"}], TraditionalForm], 
             "\" (Goldstone) and \"", 
             FormBox[
              RowBox[{"(", 
                RowBox[{
                  StyleBox["i", "TI"], ",", "0", ",", "0"}], ")"}], 
              TraditionalForm], "\", \"", 
             FormBox[
              RowBox[{"(", 
                RowBox[{"0", ",", 
                  StyleBox["i", "TI"], ",", "0"}], ")"}], TraditionalForm], 
             "\", \"", 
             FormBox[
              RowBox[{"(", 
                RowBox[{"0", ",", "0", ",", "1"}], ")"}], TraditionalForm], 
             "\" (massive); a second such direction; and the small real \
amplitude of the deviation, a function of space and time\""},
            "RowDefault"],
           StripOnInput->False,
           FontFamily->"Source Sans Pro",
           FontSize->9.5],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox[
             TagBox[
              StyleBox["H", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
              "SL31SansSerif"], "LL", "f"], "\", \"", 
            SubsuperscriptBox[
             TagBox[
              StyleBox["H", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
