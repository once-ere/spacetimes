                    StyleBox["x", "TI"], "LL"], ")"}], 
                 StyleBox["T", "TI"]], 
                SubsuperscriptBox[
                 StyleBox["K", FontSlant -> "Plain"], "LL", "\[Iota]"], 
                SubscriptBox["\[CapitalPsi]", "LL"], 
                RowBox[{"(", 
                  SubscriptBox[
                   StyleBox["x", "TI"], "LL"], ")"}]}], TraditionalForm], 
             "\", which annihilates two spinor charges at the point \"", 
             FormBox[
              SubscriptBox[
               StyleBox["x", "TI"], "LL"], TraditionalForm], 
             "\"; its integral over space, with the plane waves normalized in \
a box, is the operator \"", 
             FormBox[
              SubsuperscriptBox["\[CapitalPi]", "LL", "\[Iota]"], 
              TraditionalForm], "\" of the momenta\""},
            "RowDefault"],
           StripOnInput->False,
           FontFamily->"Source Sans Pro",
           FontSize->9.5],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["\[ScriptCapitalJ]", "LL", 
