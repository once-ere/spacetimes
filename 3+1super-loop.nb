      RowBox[{"t2dim", "[", "lat", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"t2rngState", " ", "=", " ", "rngKept13"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"w0IDA13", " ", "=", " ", 
     RowBox[{"w0IDA13", "/", 
      RowBox[{"Norm", "[", "w0IDA13", "]"}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"the", " ", "exact", " ", 
     RowBox[{"solution", ":", " ", 
      RowBox[{
      "the", " ", "eigenvalues", " ", "and", " ", "eigenvectors", " ", "of", " ",
        "H_lat", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"t2eigh", ":", " ", 
          RowBox[{"ascending", " ", "eigenvalues"}]}], ",", " ", 
