         "   ", 
         RowBox[{"(*", " ", 
          RowBox[{
          "the", " ", "particle", " ", "block", " ", "does", " ", "not", " ", 
           "mix", " ", "the", " ", "two", " ", "isospin", " ", "components", " ", 
           RowBox[{"(", 
            RowBox[{
            "the", " ", "potentials", " ", "point", " ", "along", " ", "tau_",
              "3"}], ")"}]}], " ", "*)"}], "\n", "   ", 
         RowBox[{"as1Dev", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"as1Dev", ",", " ", 
            RowBox[{"Max", "[", 
             RowBox[{"Abs", "[", 
              RowBox[{"pblock", "[", 
               RowBox[{"[", 
