Cell[CellGroupData[{

Cell["GS-16: the lattice operator on plane waves", "Subsection",ExpressionUUID->"9c377397-835e-4491-bd0a-d83e67645de3"],

Cell[TextData[{
 "On a periodic chain of 24 sites along ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "1"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a9caac35-6f64-4a8d-a668-43d829f5be48"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[ScriptL]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["x",
      FontSlant->"Plain"]], "\[LongEqual]", "0.5"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cd704e68-b58b-4657-81d2-8556c3750062"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0.4"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "48e544a1-2b33-4686-81fb-f41a4d78b8b5"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Mu]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b802596f-e087-4fd8-baf3-c31afa421abc"],
 ", no gauge fields, no pairing) the lattice operator ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalH]",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["lat",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "61951849-c9fa-48cd-862b-4b17093576dc"],
 " of the solvers maps a plane wave, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["exp",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["i", "TI"], 
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "1"], 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "1"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b9f8f474-20c8-483b-a631-25d0125b04c7"],
 " times one of the 16 unit vectors of a site, to a plane wave of the same \
momentum, and the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"16", "\[Times]", "16"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "91a509b2-4033-44ca-8a28-87b3e1824a9a"],
 " matrix of these images has the eigenvalues ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SubsuperscriptBox["\[CurlyEpsilon]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["lat",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c0a3ddd6-4aa9-44a1-a52b-ea84538d8db0"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", 
    SubsuperscriptBox["\[CurlyEpsilon]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["lat",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9abef8c0-7dac-4486-a7b0-88b281be3c49"],
 ", each eight times, at all 24 allowed momenta ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], "\[LongEqual]", "2", "\[Pi]", "\[Kappa]", "/", 
    RowBox[{"(", 
     RowBox[{"24", 
      SubsuperscriptBox["\[ScriptL]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["x",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7e1089c1-4c63-4f84-aad4-8b0131d130c9"],
 " (integers ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Kappa]", "\[LongEqual]", 
    RowBox[{"-", "11"}], ",", "\[Ellipsis]", ",", "12"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7e999253-b6e8-4100-9fff-62205cbe8b8e"],
 "), for the Wilson coefficients ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["W",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4fe2895b-4444-4c1e-8df1-845f752ec6ec"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["W",
      FontSlant->"Plain"]], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4468c4df-8ebb-41e5-911b-af71daf420a7"],
 ". The energy of a free particle on the lattice is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CurlyEpsilon]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["lat",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["q", "TI"], "\[RightVector]"], 
      StyleBox["LL",
       FontSlant->"Plain"]], ")"}], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       UnderscriptBox["\[Sum]", 
        StyleBox["j", "TI"],
        LimitsPositioning->True], "\[ThinSpace]", 
       SuperscriptBox[
        StyleBox["sin",
         FontSlant->"Plain"], "2"], 
       RowBox[{"(", 
        RowBox[{
         SubsuperscriptBox[
          StyleBox["q", "TI"], 
          StyleBox["LL",
           FontSlant->"Plain"], 
          StyleBox["j", "TI"]], 
         SubsuperscriptBox["\[ScriptL]", 
          StyleBox["LL",
           FontSlant->"Plain"], 
          StyleBox["x",
           FontSlant->"Plain"]]}], ")"}], "/", 
       SuperscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox["\[ScriptL]", 
          StyleBox["LL",
           FontSlant->"Plain"], 
          StyleBox["x",
           FontSlant->"Plain"]], ")"}], "2"], "+", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubscriptBox[
           StyleBox["m", "TI"], 
           StyleBox["LL",
            FontSlant->"Plain"]], "+", 
          RowBox[{"(", 
           RowBox[{
            SubsuperscriptBox[
             StyleBox["r", "TI"], 
             StyleBox["LL",
              FontSlant->"Plain"], 
             StyleBox["W",
              FontSlant->"Plain"]], "/", 
            SubsuperscriptBox["\[ScriptL]", 
             StyleBox["LL",
              FontSlant->"Plain"], 
             StyleBox["x",
              FontSlant->"Plain"]]}], ")"}], "\[ThinSpace]", 
          UnderscriptBox["\[Sum]", 
           StyleBox["j", "TI"],
           LimitsPositioning->True], 
          RowBox[{"(", 
           RowBox[{"1", "-", 
            StyleBox["cos",
             FontSlant->"Plain"], 
            RowBox[{"(", 
             RowBox[{
              SubsuperscriptBox[
               StyleBox["q", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["j", "TI"]], 
              SubsuperscriptBox["\[ScriptL]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["x",
                FontSlant->"Plain"]]}], ")"}]}], ")"}]}], ")"}], "2"]}], 
      ")"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "35028901-d876-49a3-a4cb-3ad7b08a3965"],
 ", the sums running over the directions with more than one site. At ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], 
    SubsuperscriptBox["\[ScriptL]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["x",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"\[PlusMinus]", "\[Pi]"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0b1b524c-d1b7-4dfe-8b53-eaa6a11a19b6"],
 " the sine vanishes again: without the Wilson term (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["W",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3e49d91e-5cd7-4321-a076-b3cd77f9da19"],
 ") the energy returns to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "226fa2ab-8e71-4ec9-b9a4-a07e57aa9774"],
 " there (a second, spurious particle, the doubler); with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["W",
      FontSlant->"Plain"]], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6dad8820-b9e5-434d-911d-074fd7ff27d5"],
 " it is lifted to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "+", "2", 
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["W",
      FontSlant->"Plain"]], "/", 
    SubsuperscriptBox["\[ScriptL]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["x",
      FontSlant->"Plain"]], "\[LongEqual]", "4.4"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1ed1adbb-2322-4642-8715-a46480f17640"],
 ". Figure 1 shows these eigenvalues with the formula and with the continuum \
energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CurlyEpsilon]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["q", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], "2"], "+", 
       SubsuperscriptBox[
        StyleBox["m", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], "2"]}], ")"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bcd4676f-d311-4b7c-8c3f-e42c02565cf7"],
 " (the figures stand in the subsection after the data files of the original \
program)."
}], "Text",ExpressionUUID->"cb98957a-8be3-49aa-9cbb-1f2acf756ec9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"mFig", ",", " ", "dxFig", ",", " ", "nFig"}], "}"}], " ", "=", 
    " ", 
    RowBox[{"{", 
     RowBox[{"0.4", ",", " ", "0.5", ",", " ", "24"}], "}"}]}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", "1", ")"}], " ", "the", " ", 
     RowBox[{"curves", ":", " ", 
      RowBox[{
      "the", " ", "continuum", " ", "energy", " ", "and", " ", "eps_lat", " ",
        "for", " ", "r_W"}]}]}], " ", "=", " ", 
    RowBox[{
    "0", " ", "and", " ", "1", " ", "on", " ", "401", " ", "momenta"}]}], " ",
    "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"curves", " ", "=", " ", 
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"q", " ", "=", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "Pi"}], "/", "dxFig"}], " ", "+", " ", 
             RowBox[{"2", " ", 
              RowBox[{"Pi", "/", "dxFig"}], " ", 
              RowBox[{"i", "/", "400."}]}]}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"rw", ",", " ", "q", ",", " ", 
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{"q", "^", "2"}], " ", "+", " ", 
              RowBox[{"mFig", "^", "2"}]}], "]"}], ",", " ", 
            RowBox[{"t2epsLat", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"q", ",", " ", "0.", ",", " ", "0."}], "}"}], ",", " ",
               "dxFig", ",", " ", "mFig", ",", " ", "rw", ",", " ", 
              RowBox[{"{", 
               RowBox[{"True", ",", " ", "False", ",", " ", "False"}], 
               "}"}]}], "]"}]}], "}"}]}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"rw", ",", " ", 
          RowBox[{"{", 
           RowBox[{"0.", ",", " ", "1."}], "}"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", "0", ",", " ", "400"}], "}"}]}], "]"}], ",", 
      " ", "1"}], "]"}]}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"(", "2", ")"}], " ", "the", " ", 
    RowBox[{"points", ":", " ", 
     RowBox[{
     "the", " ", "largest", " ", "eigenvalue", " ", "of", " ", "the", " ", 
      "operator", " ", "on", " ", "the", " ", "plane", " ", "waves", " ", 
      "of", " ", "the", " ", "24", " ", "allowed", " ", "momenta"}]}]}], " ", 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"dispDev", " ", "=", " ", "0."}], ";"}], "\n", 
 RowBox[{
  RowBox[{"points", " ", "=", " ", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"lat1", " ", "=", " ", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<n\>\"", " ", "->", " ", 
               RowBox[{"{", 
                RowBox[{"nFig", ",", " ", "1", ",", " ", "1"}], "}"}]}], ",", 
              " ", 
              RowBox[{"\"\<ell\>\"", " ", "->", " ", "dxFig"}], ",", " ", 
              RowBox[{"\"\<periodic\>\"", " ", "->", " ", 
               RowBox[{"{", 
                RowBox[{"True", ",", " ", "False", ",", " ", "False"}], 
                "}"}]}], ",", " ", 
              RowBox[{"\"\<wilson\>\"", " ", "->", " ", "rw"}], ",", " ", 
              RowBox[{"\"\<mass\>\"", " ", "->", " ", "mFig"}], ",", " ", 
              RowBox[{"\"\<mu\>\"", " ", "->", " ", "0."}]}], "|>"}]}], ",", 
           "\n", "      ", "kk", ",", " ", "q", ",", " ", "w", ",", " ", 
           "out", ",", " ", "m16", ",", " ", "ev", ",", " ", "el"}], "}"}], ",",
          "\n", "     ", 
         RowBox[{
          RowBox[{"kk", " ", "=", " ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"kq", " ", "<=", " ", 
              RowBox[{"nFig", "/", "2"}]}], ",", " ", "kq", ",", " ", 
             RowBox[{"kq", " ", "-", " ", "nFig"}]}], "]"}]}], ";", "\n", 
          "     ", 
          RowBox[{"q", " ", "=", " ", 
           RowBox[{"2", " ", "Pi", " ", 
            RowBox[{"kk", "/", 
             RowBox[{"(", 
              RowBox[{"nFig", " ", "dxFig"}], ")"}]}]}]}], ";", "\n", "     ", 
          RowBox[{"(*", " ", 
           RowBox[{
            RowBox[{"the", " ", "16", " ", "plane", " ", "waves"}], ",", " ", 
            
            RowBox[{"one", " ", "per", " ", "unit", " ", "vector", " ", "b"}],
             ",", " ", 
            RowBox[{
            "as", " ", "the", " ", "columns", " ", "of", " ", "a", " ", 
             "matrix"}]}], " ", "*)"}], "\n", "     ", 
          RowBox[{"w", " ", "=", " ", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"Mod", "[", 
                  RowBox[{
                   RowBox[{"r", " ", "-", " ", "1"}], ",", " ", "16"}], "]"}],
                  " ", "+", " ", "1"}], " ", "==", " ", "b"}], ",", " ", 
               RowBox[{"Exp", "[", 
                RowBox[{"I", " ", "q", " ", "dxFig", " ", 
                 RowBox[{"Quotient", "[", 
                  RowBox[{
                   RowBox[{"r", " ", "-", " ", "1"}], ",", " ", "16"}], 
                  "]"}]}], "]"}], ",", " ", 
               RowBox[{"0.", " ", "I"}]}], "]"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"r", ",", " ", 
               RowBox[{"16", " ", "nFig"}]}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"b", ",", " ", "16"}], "}"}]}], "]"}]}], ";", "\n", 
          "     ", 
          RowBox[{"out", " ", "=", " ", 
           RowBox[{"t2apply", "[", 
            RowBox[{"lat1", ",", " ", 
             RowBox[{"t2trivialFields", "[", "nFig", "]"}], ",", " ", "w"}], 
            "]"}]}], ";", "\n", "     ", 
          RowBox[{"m16", " ", "=", " ", 
           RowBox[{"out", "[", 
            RowBox[{"[", 
             RowBox[{"1", " ", ";;", " ", "16"}], "]"}], "]"}]}], ";", "\n", 
          "     ", 
          RowBox[{"dispDev", " ", "=", " ", 
           RowBox[{"Max", "[", 
            RowBox[{"dispDev", ",", " ", 
             RowBox[{"Max", "[", 
              RowBox[{"Abs", "[", 
               RowBox[{
                RowBox[{"out", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"16", " ", 
                    RowBox[{"(", 
                    RowBox[{"nFig", " ", "-", " ", "1"}], ")"}]}], " ", "+", 
                    " ", "1"}], " ", ";;", " ", 
                   RowBox[{"16", " ", "nFig"}]}], "]"}], "]"}], " ", "-", " ", 
                RowBox[{"m16", " ", 
                 RowBox[{"Exp", "[", 
                  RowBox[{"I", " ", "q", " ", "dxFig", " ", 
                   RowBox[{"(", 
                    RowBox[{"nFig", " ", "-", " ", "1"}], ")"}]}], "]"}]}]}], 
               "]"}], "]"}]}], "]"}]}], ";", "\n", "     ", 
          RowBox[{"ev", " ", "=", " ", 
           RowBox[{"First", "[", 
            RowBox[{"t2eigh", "[", "m16", "]"}], "]"}]}], ";", "\n", "     ", 
          
          RowBox[{"el", " ", "=", " ", 
           RowBox[{"t2epsLat", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"q", ",", " ", "0.", ",", " ", "0."}], "}"}], ",", " ", 
             "dxFig", ",", " ", "mFig", ",", " ", "rw", ",", " ", 
             RowBox[{"{", 
              RowBox[{"True", ",", " ", "False", ",", " ", "False"}], "}"}]}],
             "]"}]}], ";", "\n", "     ", 
          RowBox[{"dispDev", " ", "=", " ", 
           RowBox[{"Max", "[", 
            RowBox[{"dispDev", ",", " ", 
             RowBox[{"Max", "[", 
              RowBox[{"Abs", "[", 
               RowBox[{"ev", " ", "-", " ", 
                RowBox[{"Join", "[", 
                 RowBox[{
                  RowBox[{"ConstantArray", "[", 
                   RowBox[{
                    RowBox[{"-", "el"}], ",", " ", "8"}], "]"}], ",", " ", 
                  RowBox[{"ConstantArray", "[", 
                   RowBox[{"el", ",", " ", "8"}], "]"}]}], "]"}]}], "]"}], 
              "]"}]}], "]"}]}], ";", "\n", "     ", 
          RowBox[{"{", 
           RowBox[{"rw", ",", " ", "q", ",", " ", 
            RowBox[{"ev", "[", 
             RowBox[{"[", "16", "]"}], "]"}]}], "}"}]}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"{", 
        RowBox[{"rw", ",", " ", 
         RowBox[{"{", 
          RowBox[{"0.", ",", " ", "1."}], "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"kq", ",", " ", "0", ",", " ", 
         RowBox[{"nFig", " ", "-", " ", "1"}]}], "}"}]}], "]"}], ",", " ", 
     "1"}], "]"}]}], ";"}], "\n", 
 RowBox[{"SL31Check", "[", 
  RowBox[{"\"\<GS-16\>\"", ",", 
   " ", "\"\<the lattice operator of the solvers on plane waves: on a \
periodic chain of 24 sites (dx = 0.5, m = 0.4) the image of a plane wave is a \
plane wave of the same momentum, and the 16 x 16 matrix of the images has the \
eigenvalues -eps_lat (eightfold) and +eps_lat (eightfold) at all 24 momenta, \
for r_W = 0 and 1 (tolerance 1e-12)\>\"", ",", "\n", "  ", 
   RowBox[{"dispDev", " ", "<", " ", "1*^-12"}], ",", " ", 
   RowBox[{"Row", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<largest deviation \>\"", ",", " ", "dispDev", ",", 
      " ", "\"\< (original: 1.4e-14)\>\""}], "}"}], "]"}]}], "]"}]}], "Input",\

