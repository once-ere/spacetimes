  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "465365e9-dc72-4f52-8713-a67764eb3860"],
 ", is"
}], "Text",ExpressionUUID->"0500cf3a-faef-437d-b206-10dd8da810be"],

Cell[BoxData[
 FormBox[
  RowBox[{
   UnderscriptBox["\[Sum]", 
    StyleBox["j", "TI"],
    LimitsPositioning->True], 
   RowBox[{"[", 
