Cell[TextData[{
 "S-9, algebra with the symbols of the Higgs mechanism of the superfluid \
boson singlet state. The rest masses of the two charged vector bosons and of \
the vector boson of the fermion number are ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["M", "TI"], "LL", "W"], ")"}], "2"], "\[LongEqual]", "2", 
     SubsuperscriptBox[
      StyleBox["Z", "TI"], "LL", "s"], 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["g", "TI"], "LL", "v"], ")"}], "2"], 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], ")"}], "2"]}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "968acf34-a127-4218-9a9c-fbaeb61b4333"]], "InlineFormula",ExpressionUUID->
  "f8b82437-f665-44bd-aac9-bcbe85917960"],
 " and ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["M", "TI"], "LL", "F"], ")"}], "2"], "\[LongEqual]", "8", 
     SubsuperscriptBox[
      StyleBox["Z", "TI"], "LL", "s"], 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["g", "TI"], "LL", "F"], ")"}], "2"], 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], ")"}], "2"]}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "decf5db8-eabc-46dd-967a-66adb677d694"]], "InlineFormula",ExpressionUUID->
  "1173f863-2c2e-453c-a8c0-d02023962205"],
 ", where ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["Z", "TI"], "LL", "s"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"6fdf3cc2-30f2-42b3-8cf1-3a2c4c639339"]], "InlineFormula",
  ExpressionUUID->"bd32dcf3-8e31-4620-99f0-8933b2a82e24"],
 " is the stiffness of the space derivatives and ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["g", "TI"], "LL", "v"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"92b2e5e3-ec2d-4229-be84-cc3d7a7e6cca"]], "InlineFormula",
  ExpressionUUID->"a2a05a4a-4670-4d94-9c04-6fa38d819757"],
 ", ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["g", "TI"], "LL", "F"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"08c37452-b139-4aa4-a2da-ad7e119b853c"]], "InlineFormula",
  ExpressionUUID->"aacb4ca9-e3c5-40b6-afe0-7cedcc00db1c"],
 " are the gauge couplings. The cell checks with ",
 StyleBox["Simplify",
  FontFamily->"Source Code Pro"],
 " that the ratio of the squared masses is ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{"4", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox[
         StyleBox["g", "TI"], "LL", "F"], "/", 
        SubsuperscriptBox[
         StyleBox["g", "TI"], "LL", "v"]}], ")"}], "2"]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"416988bd-1426-4a43-a1a5-1f312ffbe7a4"]], 
  "InlineFormula",ExpressionUUID->"44e02964-850d-40bd-b60b-60872fce3325"],
 ", independent of the stiffness and of the gap, and with ",
 StyleBox["Solve",
  FontFamily->"Source Code Pro"],
 " that the gap can be recovered from ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["M", "TI"], "LL", "W"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"ca876a8c-1a83-4055-acdb-8105f69329cc"]], "InlineFormula",
  ExpressionUUID->"85e2bd47-68b9-43c5-aef9-d17812cfdbc0"],
 "."
}], "Text",ExpressionUUID->"519ac147-0376-4726-9a12-a0f16d81f691"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"massRules", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      SubsuperscriptBox["M", "LL", "W"], " ", "->", " ", 
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{"2", " ", 
         SubsuperscriptBox["Z", "LL", "s"]}], "]"}], " ", 
       SubsuperscriptBox["g", "LL", "v"], " ", 
       SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"]}]}], ",", "\n", 
     "   ", 
     RowBox[{
      SubsuperscriptBox["M", "LL", "F"], " ", "->", " ", 
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{"8", " ", 
         SubsuperscriptBox["Z", "LL", "s"]}], "]"}], " ", 
       SubsuperscriptBox["g", "LL", "F"], " ", 
       SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"]}]}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{"ratio", " ", "=", " ", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox["M", "LL", "F"], "/", 
       SubsuperscriptBox["M", "LL", "W"]}], ")"}], "^", "2"}], " ", "/.", " ",
     "massRules"}], "]"}]}]}], "Input",
 CellLabel->
  "In[125]:=",ExpressionUUID->"bf25ff6a-1c78-4359-99a3-ca20cc2a30a5"],

