Cell[TextData[{
 "S-6, arithmetic with symbols and values: the coupling ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f0fd303a-ce27-4a85-96e6-2466318ccb2a"],
 ", the mass ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "35813c92-3249-4af2-8cf8-0694415d6c6b"],
 " and the cutoff ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalLambda]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "96f99b06-9a2a-4682-8b86-53d9ef9a9a7f"],
 " of the spinor charges receive the values used throughout Test 2 (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0.2"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7a7b65d4-ac1f-4621-8214-caa1ab8fe4ce"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "165b3ede-718a-4f35-aaf9-652b4b9f8213"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "22.5"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "17d82b4f-80b9-4add-81b2-f8e052007794"],
 ", units in which the cutoff is 1). The gap of the condensed vacuum at zero \
chemical potential solves the gap equation ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[CapitalLambda]", 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         SubsuperscriptBox["\[CapitalLambda]", 
          StyleBox["LL",
           FontSlant->"Plain"], "2"], "+", 
         SuperscriptBox[
          RowBox[{"(", 
           SubsuperscriptBox[
            StyleBox["M", "TI"], 
            StyleBox["LL",
             FontSlant->"Plain"], 
            StyleBox["q",
             FontSlant->"Plain"]], ")"}], "2"]}], ")"}], 
       RowBox[{"1", "/", "2"}]], "-", 
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox[
         StyleBox["M", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], 
         StyleBox["q",
          FontSlant->"Plain"]], ")"}], "2"], "\[ThinSpace]", 
      StyleBox["arsinh",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[CapitalLambda]", 
         StyleBox["LL",
          FontSlant->"Plain"]], "/", 
        SubsuperscriptBox[
         StyleBox["M", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], 
         StyleBox["q",
          FontSlant->"Plain"]]}], ")"}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"2", 
      SuperscriptBox["\[Pi]", "2"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ddeb7f4f-8b06-4aef-9c67-44dae2ecc725"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["q",
        FontSlant->"Plain"]], ")"}], "2"], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "2"], "+", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["vac",
        FontSlant->"Plain"]], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "535f1735-6b69-4ba9-9c03-1302027fa823"],
 ". The cell writes this equation with the symbolized symbols, gives them \
values only inside ",
 StyleBox["Block",
  FontFamily->"Source Code Pro"],
 " (so that they stay free symbols outside), solves for the gap with ",
 StyleBox["FindRoot",
  FontFamily->"Source Code Pro"],
 ", and compares with the value 0.2094933033 found by the Rust program of \
Test 2. It also checks the derived masses ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    SubsuperscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["vac",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3d189058-e509-472b-9a87-0a53af275bc3"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["q",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9a4f81c4-87f6-40ac-9e02-5e944a48d474"],
 "."
}], "Text",ExpressionUUID->"2b42e875-fdc0-41a3-b565-299833fef97f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"gapEquation", " ", "=", " ", 
  RowBox[{
   RowBox[{"1", "/", 
    SubscriptBox["G", "LL"]}], " ", "==", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[CapitalLambda]", "LL"], " ", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{
          SubscriptBox["\[CapitalLambda]", "LL"], "^", "2"}], " ", "+", " ", 
         RowBox[{
          SubscriptBox["m", "LL"], "^", "2"}], " ", "+", " ", 
         RowBox[{
          SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], "^", "2"}]}], 
        "]"}]}], " ", "-", "\n", "     ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SubscriptBox["m", "LL"], "^", "2"}], " ", "+", " ", 
         RowBox[{
          SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], "^", "2"}]}], 
        ")"}], " ", 
       RowBox[{"ArcSinh", "[", 
        RowBox[{
         SubscriptBox["\[CapitalLambda]", "LL"], "/", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{
            SubscriptBox["m", "LL"], "^", "2"}], " ", "+", " ", 
           RowBox[{
            SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], "^", "2"}]}], 
          "]"}]}], "]"}]}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"2", " ", 
      RowBox[{"Pi", "^", "2"}]}], ")"}]}]}]}]], "Input",
 CellLabel->
  "In[191]:=",ExpressionUUID->"57f6ea3d-1fd3-443f-b991-1ade436d940a"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", 
   SubscriptBox["G", "LL"]], "\[Equal]", 
  FractionBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[CapitalLambda]", "LL"], " ", 
     SqrtBox[
      RowBox[{
       SubsuperscriptBox["m", "LL", "2"], "+", 
       SuperscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], ")"}], "2"], "+", 
       
       SubsuperscriptBox["\[CapitalLambda]", "LL", "2"]}]]}], "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox["m", "LL", "2"], "+", 
       SuperscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], ")"}], "2"]}], 
      ")"}], " ", 
     RowBox[{"ArcSinh", "[", 
      FractionBox[
       SubscriptBox["\[CapitalLambda]", "LL"], 
       SqrtBox[
        RowBox[{
         SubsuperscriptBox["m", "LL", "2"], "+", 
         SuperscriptBox[
          RowBox[{"(", 
           SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], ")"}], "2"]}]]],
       "]"}]}]}], 
   RowBox[{"2", " ", 
    SuperscriptBox["\[Pi]", "2"]}]]}]], "Output",
 CellChangeTimes->{4.004025486218039*^9},
 CellLabel->
  "Out[191]=",ExpressionUUID->"b4d44210-1b6e-4c65-8dfd-b85b3e4f34a5"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"exact", " ", "values", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"45", "/", "2"}], ",", " ", 
       RowBox[{"1", "/", "5"}], ",", " ", "1"}], ")"}]}], ",", " ", 
    RowBox[{
    "so", " ", "that", " ", "FindRoot", " ", "can", " ", "work", " ", "with", 
     " ", "30", " ", "digits"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"gapValue", " ", "=", " ", 
     RowBox[{"Block", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          SubscriptBox["G", "LL"], " ", "=", " ", 
          RowBox[{"45", "/", "2"}]}], ",", " ", 
         RowBox[{
          SubscriptBox["m", "LL"], " ", "=", " ", 
          RowBox[{"1", "/", "5"}]}], ",", " ", 
         RowBox[{
          SubscriptBox["\[CapitalLambda]", "LL"], " ", "=", " ", "1"}]}], 
        "}"}], ",", "\n", "   ", 
       RowBox[{
        SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], " ", "/.", " ", 
        RowBox[{"FindRoot", "[", 
         RowBox[{"gapEquation", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], ",", " ", 
            "0.2"}], "}"}], ",", " ", 
          RowBox[{"WorkingPrecision", " ", "->", " ", "30"}], ",", " ", 
          RowBox[{"AccuracyGoal", " ", "->", " ", "20"}]}], "]"}]}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"SL31Check", "[", 
     RowBox[{"\"\<S-6\>\"", ",", 
      " ", "\"\<the gap equation written with the symbols gives the gap of \
the condensed vacuum 0.2094933033 at G = 22.5, m = 0.2, cutoff 1; 2 Delta_vac \
= 0.4189866 and 2 M_q = 0.5792666\>\"", ",", "\n", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"gapValue", " ", "-", " ", "0.2094933033"}], "]"}], " ", "<",
         " ", "1*^-10"}], " ", "&&", " ", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"2", " ", "gapValue"}], " ", "-", " ", "0.4189866"}], "]"}],
         " ", "<", " ", "1*^-7"}], " ", "&&", " ", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"2", " ", 
           RowBox[{"Sqrt", "[", 
            RowBox[{"0.04", " ", "+", " ", 
             RowBox[{"gapValue", "^", "2"}]}], "]"}]}], " ", "-", " ", 
          "0.5792666"}], "]"}], " ", "<", " ", "1*^-7"}]}], ",", "\n", "  ", 
      RowBox[{"N", "[", 
       RowBox[{"gapValue", ",", " ", "12"}], "]"}]}], "]"}], 
    ";"}]}]}]], "Input",
 CellLabel->
  "In[192]:=",ExpressionUUID->"ead9cf2a-c910-4475-854b-6cb57d53e85c"],

Cell[BoxData[
 StyleBox[
  TemplateBox[{
    StyleBox["\"PASS  \"", Bold, 
     RGBColor[0, 
      Rational[2, 3], 0], StripOnInput -> False], "\"S-6: \"", 
    "\"the gap equation written with the symbols gives the gap of the \
condensed vacuum 0.2094933033 at G = 22.5, m = 0.2, cutoff 1; 2 Delta_vac = \
0.4189866 and 2 M_q = 0.5792666\"", "\"  -- \"", 
    "0.20949330326994829539714623230134206044`12."},
   "RowDefault"],
  StripOnInput->False,
