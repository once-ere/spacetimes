Cell[TextData[{
 "S-6, arithmetic with symbols and values: the coupling ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubscriptBox[
     StyleBox["G", "TI"], "LL"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"a55dba7c-753c-43e9-8046-9c6f75527b41"]], "InlineFormula",
  ExpressionUUID->"5822461d-3a0e-4f97-80f8-87d3993e3155"],
 ", the mass ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubscriptBox[
     StyleBox["m", "TI"], "LL"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"85d591df-418c-468b-8f46-bffb95f2d7c0"]], "InlineFormula",
  ExpressionUUID->"fb911ba7-4593-4b86-bd57-6ed5173264a6"],
 " and the cutoff ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubscriptBox["\[CapitalLambda]", "LL"], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"e509d38a-f623-4c14-a8da-66b0e644bfdc"]], 
  "InlineFormula",ExpressionUUID->"c5459255-916e-409b-8349-8c5c0b0d5f62"],
 " of the spinor charges receive the values used throughout Test 2 (",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["m", "TI"], "LL"], "\[LongEqual]", "0.2"}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"f21e73c7-4097-4c5b-abda-5c9b816f9074"]], 
  "InlineFormula",ExpressionUUID->"55275bcd-479b-4d26-ad82-124c232f9132"],
 ", ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox["\[CapitalLambda]", "LL"], "\[LongEqual]", "1"}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "53da4943-262a-4ce0-b12f-5ca62d5cbae0"]], "InlineFormula",ExpressionUUID->
  "09cd436a-35cb-4156-b098-712161e4a725"],
 ", ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["G", "TI"], "LL"], "\[LongEqual]", "22.5"}], TraditionalForm]],
    "InlineFormula",ExpressionUUID->"3199030b-57cf-4179-a94e-bb54311cc6ff"]], 
  "InlineFormula",ExpressionUUID->"6de14178-a385-4569-8b77-b19f2a4169d2"],
 ", units in which the cutoff is 1). The gap of the condensed vacuum at zero \
chemical potential solves the gap equation ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{"1", "/", 
     SubscriptBox[
      StyleBox["G", "TI"], "LL"], "\[LongEqual]", 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[CapitalLambda]", "LL"], 
       SubscriptBox[
        StyleBox["E", "TI"], "\[CapitalLambda]"], "-", 
       SuperscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox[
          StyleBox["M", "TI"], "LL", "q"], ")"}], "2"], " ", "arsinh", 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["\[CapitalLambda]", "LL"], "/", 
         SubsuperscriptBox[
          StyleBox["M", "TI"], "LL", "q"]}], ")"}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"2", 
       SuperscriptBox["\[Pi]", "2"]}], ")"}]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"dc758e94-ad70-43b2-b5a0-3bcc3ebcbd69"]], 
  "InlineFormula",ExpressionUUID->"d0e3b8a2-a528-48c1-995f-9991996cb363"],
 " with ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["M", "TI"], "LL", "q"], ")"}], "2"], "\[LongEqual]", 
     SubsuperscriptBox[
      StyleBox["m", "TI"], "LL", "2"], "+", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], ")"}], "2"]}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "13562953-a2e6-446e-982f-fbfafba0ce64"]], "InlineFormula",ExpressionUUID->
  "e825f656-c31d-4b8a-9a5e-ff62bb711a9d"],
 " and ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["E", "TI"], "\[CapitalLambda]"], "\[LongEqual]", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox["\[CapitalLambda]", "LL", "2"], "+", 
        SuperscriptBox[
         RowBox[{"(", 
          SubsuperscriptBox[
           StyleBox["M", "TI"], "LL", "q"], ")"}], "2"]}], ")"}], 
      RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"b11021ff-5ade-4475-812b-e4d8e8420597"]], "InlineFormula",
  ExpressionUUID->"c75b5691-b905-478d-b266-56393cd93f5c"],
 ". The cell writes this equation with the symbolized symbols, gives them \
values only inside ",
 StyleBox["Block",
  FontFamily->"Source Code Pro"],
 " (so that they stay free symbols outside), solves for the gap with ",
 StyleBox["FindRoot",
  FontFamily->"Source Code Pro"],
 ", and compares with the value 0.2094933033 found by the Rust program of \
Test 2. It also checks the derived masses ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{"2", 
     SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"460a3922-aec4-4f24-8911-c666907210af"]], 
