                 OverscriptBox[
                  StyleBox["c", "TI"], "^"], 
                 RowBox[{"LL", ",", 
                   StyleBox["k", "TI"]}]]}], TraditionalForm], 
             "\"; and the isospin of the site \"", 
             FormBox[
              RowBox[{
