                  RowBox[{"16", "\[Cross]", "16"}], TraditionalForm], 
                 "\" Bogoliubov-de Gennes matrix \"", 
                 FormBox[
                  RowBox[{
                    SubscriptBox[
                    StyleBox["H", FontSlant -> "Plain"], "LL"], 
                    "\[LongEqual]", 
                    RowBox[{"(", 
                    Cell[
                    BoxData[
                    FormBox[
                    GridBox[{{
                    Cell[
                    TextData[{" ", 
                    Cell[
                    BoxData[
                    RowBox[{
                    SubscriptBox[
                    StyleBox["h", FontSlant -> "Plain"], "LL"], 
                    RowBox[{"(", 
                    SubscriptBox[
                    OverscriptBox[
                    StyleBox["q", "TI"], "\[RightVector]"], "LL"], ")"}], "-", 
                    SubscriptBox["\[Mu]", "LL"]}]], "InlineFormula"], " "}]], 
                    
                    Cell[
                    TextData[{" ", 
                    Cell[
                    BoxData[
                    SubscriptBox[
                    StyleBox["P", FontSlant -> "Plain"], "LL"]], 
                    "InlineFormula"], " "}]]}, {
                    Cell[
                    TextData[{" ", 
                    Cell[
                    BoxData[
                    SubsuperscriptBox[
                    StyleBox["P", FontSlant -> "Plain"], "LL", "\[Dagger]"]], 
                    "InlineFormula"], " "}]], 
                    Cell[
                    TextData[{" ", 
                    Cell[
                    BoxData[
                    RowBox[{"-", 
                    SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{
                    SubscriptBox[
                    StyleBox["h", FontSlant -> "Plain"], "LL"], 
                    RowBox[{"(", 
                    RowBox[{"-", 
                    SubscriptBox[
                    OverscriptBox[
                    StyleBox["q", "TI"], "\[RightVector]"], "LL"]}], ")"}], 
                    "-", 
                    SubscriptBox["\[Mu]", "LL"]}], ")"}], 
                    StyleBox["T", "TI"]]}]], "InlineFormula"], " "}]]}}], 
                    TraditionalForm]]], ")"}]}], TraditionalForm], 
                 "\" and the Nambu spinor \"", 
                 FormBox[
                  RowBox[{
                    SubscriptBox[
                    StyleBox["N", "TI"], "LL"], "\[LongEqual]", 
