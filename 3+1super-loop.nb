                    StyleBox["y",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], ",", 
                    StyleBox["z",
                    FontWeight->"Bold",
                    FontSlant->"Plain"]}], "]"}], ",", 
                    StyleBox["x",
                    FontWeight->"Bold",
                    FontSlant->"Plain"]}], "]"}], "+", 
                  RowBox[{"[", 
