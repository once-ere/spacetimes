              StyleBox["\<\"J_LL^j K_LL^j J_LL^j' K_LL^j' J_LL^j'' K_LL^j'' \
J_LL^3\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[Cell[TextData[{
               "the rotation and boost generators of ",
               Cell[BoxData[
                FormBox[
                 SubscriptBox[
                  StyleBox["\[GothicL]",
                   FontSlant->"Plain"], 
                  StyleBox["LL",
                   FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "ac4f148d-6606-46d0-9496-18f232c0a09b"],
               ", ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubsuperscriptBox[
                   StyleBox["J", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"], 
                   StyleBox["j", "TI"]], "\[LongEqual]", 
                  SubscriptBox[
                   StyleBox["e",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], 
                   StyleBox["j", "TI"]], "/", "2"}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "00e539e5-5911-406d-99b4-58d02602efbd"],
               " and ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubsuperscriptBox[
                   StyleBox["K", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"], 
                   StyleBox["j", "TI"]], "\[LongEqual]", 
                  StyleBox["i", "TI"], "\[ThinSpace]", 
                  SubscriptBox[
                   StyleBox["e",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], 
                   StyleBox["j", "TI"]], "/", "2"}], TraditionalForm]], 
