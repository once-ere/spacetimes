              RowBox[{
                SubscriptBox[
                 OverscriptBox[
                  StyleBox["s", "TI"], "\[RightVector]"], "LL"], "+", 
                SubsuperscriptBox[
                 OverscriptBox["\[Delta]", "\[RightVector]"], "LL", 
                 StyleBox["j", "TI"]]}], TraditionalForm], "\", the \"", 
             FormBox[
              RowBox[{"2", "\[Cross]", "2"}], TraditionalForm], 
             "\" isospin matrix \"", 
             FormBox[
              RowBox[{"exp", "(", 
                RowBox[{"-", 
