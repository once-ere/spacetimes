              RowBox[{
                SuperscriptBox[
                 RowBox[{"(", 
                   SubsuperscriptBox[
                    StyleBox["M", "TI"], "LL", "F"], ")"}], "2"], 
                "\[LongEqual]", "8", 
                SubsuperscriptBox[
                 StyleBox["Z", "TI"], "LL", "s"], 
                SuperscriptBox[
                 RowBox[{"(", 
                   SubsuperscriptBox[
