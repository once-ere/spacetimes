            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "5d2658ad-9a78-4b74-bf2f-536b1e99f114"],
           " Bogoliubov matrix per unit of ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[Delta]", 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["f",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "ebdb1df5-8494-4362-840a-f9fdcbe1cb2e"],
           ", ",
           Cell[BoxData[
            FormBox[
             RowBox[{"(", "\[NoBreak]", GridBox[{
                {"0", 
                 RowBox[{
                  SubscriptBox[
                   StyleBox["P",
                    FontFamily->"Helvetica",
                    FontSlant->"Plain"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]], 
                  RowBox[{"(", 
