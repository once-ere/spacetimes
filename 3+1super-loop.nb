              }], "Text",
               FontFamily->"Source Sans Pro",
               FontSize->9.5,ExpressionUUID->
               "22007504-2cd8-4551-b0cb-5a64a2bb549b"],
              ImageSize->290]},
            {
             PaneBox[
              TemplateBox[{
                SubscriptBox[
                 OverscriptBox["q", "\[RightVector]"], "LL"], "\", \"", 
                SubscriptBox["q", "LL"], "\", \"", 
                SubsuperscriptBox["q", "LL", "j"]},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              StyleBox["\<\"q\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[Cell[TextData[{
               "the momentum of a particle in the space of ",
               Cell[BoxData[
                FormBox[
                 SubsuperscriptBox[
                  StyleBox["\[DoubleStruckCapitalR]",
                   FontSlant->"Plain"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
                  RowBox[{"1", ",", "3"}]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "ca167857-e3be-4708-aed3-5f891b56a95c"],
               ", its length and its components"
              }], "Text",
               FontFamily->"Source Sans Pro",
               FontSize->9.5,ExpressionUUID->
               "8e39da89-1880-41d1-8911-d07ea213a49f"],
              ImageSize->290]},
            {
             PaneBox[
              TemplateBox[{
                SubscriptBox["m", "LL"], "\", \"", 
                SubscriptBox["\[Mu]", "LL"], "\", \"", 
                SubscriptBox["\[CapitalLambda]", "LL"]},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              StyleBox["\<\"m mu Lambda\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[Cell[TextData[{
               
               "the mass of the spinor charges, the chemical potential, and \
the momentum cutoff (",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubscriptBox[
                   StyleBox["q", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]], "<", 
                  SubscriptBox["\[CapitalLambda]", 
                   StyleBox["LL",
                    FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "c5e0cb18-a197-46c2-bc3b-4a08ce640168"],
               "; ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubscriptBox["\[CapitalLambda]", 
                   StyleBox["LL",
                    FontSlant->"Plain"]], "\[LongEqual]", "1"}], 
                 TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "22bee057-da2c-420e-9e94-72eaed5bbbcf"],
               " sets the units, except where it varies)"
              }], "Text",
               FontFamily->"Source Sans Pro",
               FontSize->9.5,ExpressionUUID->
               "79ad60e0-e7ee-4017-b10e-f0a88f0e6428"],
              ImageSize->290]},
            {
             PaneBox[
              TemplateBox[{
                SubscriptBox["\[CurlyEpsilon]", "LL"], "\", \"", 
                SubsuperscriptBox["E", "LL", "\[PlusMinus]"], "\", \"", 
                SubsuperscriptBox[
                 OverscriptBox["E", "~"], "LL", "\[PlusMinus]"]},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              
              StyleBox["\<\"eps E^+ E^- E^(+-) E_minus_polar E_plus_polar \
Etilde^+ Etilde^- Etilde^(+-) Etilde_minus Etilde_plus\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[Cell[TextData[{
               "the energy ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubscriptBox["\[CurlyEpsilon]", 
                   StyleBox["LL",
                    FontSlant->"Plain"]], "\[LongEqual]", 
                  SuperscriptBox[
                   RowBox[{"(", 
                    RowBox[{
                    SubsuperscriptBox[
                    StyleBox["q", "TI"], 
                    StyleBox["LL",
                    FontSlant->"Plain"], "2"], "+", 
                    SubsuperscriptBox[
                    StyleBox["m", "TI"], 
                    StyleBox["LL",
                    FontSlant->"Plain"], "2"]}], ")"}], 
                   RowBox[{"1", "/", "2"}]]}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "b71185c3-c681-476e-a12c-c0ae52b0aedc"],
               ", the quasi-particle energies of the scalar channel ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubsuperscriptBox[
                   StyleBox["E", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"], "\[PlusMinus]"], "\[LongEqual]", 
                  SuperscriptBox[
                   RowBox[{"[", 
                    RowBox[{
                    SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{
                    SubscriptBox["\[CurlyEpsilon]", 
                    StyleBox["LL",
                    FontSlant->"Plain"]], "\[PlusMinus]", 
                    SubscriptBox["\[Mu]", 
                    StyleBox["LL",
                    FontSlant->"Plain"]]}], ")"}], "2"], "+", 
                    SubsuperscriptBox["\[CapitalDelta]", 
                    StyleBox["LL",
                    FontSlant->"Plain"], "2"]}], "]"}], 
                   RowBox[{"1", "/", "2"}]]}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "eb1a4b3a-4f7c-4e99-884b-0446c04c0ff2"],
               ", a function of the gap (written ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubsuperscriptBox[
                   StyleBox["E", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"], "\[PlusMinus]"], 
                  RowBox[{"(", 
                   SubsuperscriptBox["\[CapitalDelta]", 
                    StyleBox["LL",
                    FontSlant->"Plain"], "+"], ")"}]}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "24750e32-83ec-4fef-ae52-3d9a0d2ae254"],
               " and ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubsuperscriptBox[
                   StyleBox["E", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"], "\[PlusMinus]"], 
                  RowBox[{"(", 
                   SubsuperscriptBox["\[CapitalDelta]", 
                    StyleBox["LL",
                    FontSlant->"Plain"], "-"], ")"}]}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "61b8f24b-f094-4700-83aa-315352f33481"],
               " when ",
               Cell[BoxData[
                FormBox[
                 SubscriptBox["\[CapitalDelta]", 
                  StyleBox["LL",
                   FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "6929a6ac-491b-4d86-be3e-39266c4e16fc"],
               
               " is replaced by one of the two gaps of a general state), and \
those of the pseudoscalar channel, ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SuperscriptBox[
                   RowBox[{"(", 
                    SubsuperscriptBox[
                    OverscriptBox[
                    StyleBox["E", "TI"], "~"], 
                    StyleBox["LL",
                    FontSlant->"Plain"], "\[PlusMinus]"], ")"}], "2"], "\[LongEqual]", 
                  SubsuperscriptBox["\[CurlyEpsilon]", 
                   StyleBox["LL",
                    FontSlant->"Plain"], "2"], "+", 
                  SubsuperscriptBox["\[Mu]", 
                   StyleBox["LL",
                    FontSlant->"Plain"], "2"], "+", 
                  SubsuperscriptBox["\[CapitalDelta]", 
                   StyleBox["LL",
                    FontSlant->"Plain"], "2"], "\[PlusMinus]", "2", 
                  SuperscriptBox[
                   RowBox[{"[", 
                    RowBox[{
                    SubsuperscriptBox["\[Mu]", 
                    StyleBox["LL",
                    FontSlant->"Plain"], "2"], 
                    SubsuperscriptBox["\[CurlyEpsilon]", 
                    StyleBox["LL",
                    FontSlant->"Plain"], "2"], "+", 
                    SubsuperscriptBox[
                    StyleBox["m", "TI"], 
                    StyleBox["LL",
                    FontSlant->"Plain"], "2"], 
                    SubsuperscriptBox["\[CapitalDelta]", 
                    StyleBox["LL",
                    FontSlant->"Plain"], "2"]}], "]"}], 
                   RowBox[{"1", "/", "2"}]]}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "4196f5e8-4bd9-4fc7-b226-7e1f6d802c12"]
              }], "Text",
               FontFamily->"Source Sans Pro",
               FontSize->9.5,ExpressionUUID->
               "80d4c941-ccec-4eeb-8eea-16f77af0f63e"],
              ImageSize->290]},
            {
             PaneBox[
              TemplateBox[{
                SubscriptBox["G", "LL"], "\", \"", 
                SubsuperscriptBox["G", "LL", "crit"]},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              StyleBox["\<\"G G_crit G_over_Gcrit_m0 G_crit_mu0_m0\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[Cell[TextData[{
               
               "the coupling of the attractive spin-zero contact interaction \
(dimension mass",
               Cell[BoxData[
                FormBox[
                 SuperscriptBox["", 
                  RowBox[{"-", "2"}]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "79299e20-3323-47fe-b331-c721ac6c0827"],
               ") and its critical value at ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubscriptBox["\[Mu]", 
                   StyleBox["LL",
                    FontSlant->"Plain"]], "\[LongEqual]", "0"}], 
                 TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "827c7a6e-ac35-4a23-85d2-d280bafa0b09"],
               ", above which the vacuum condenses"
              }], "Text",
               FontFamily->"Source Sans Pro",
               FontSize->9.5,ExpressionUUID->
               "4ee976c5-95e6-4f71-99e6-ffa11a0c1980"],
              ImageSize->290]},
            {
             PaneBox[
              TemplateBox[{
                SubsuperscriptBox["\[ScriptCapitalH]", "LL", "sf"]},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              StyleBox["\<\"Hsf\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[Cell[TextData[{
               "the Hamiltonian of the superfluid, ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  UnderscriptBox["\[Sum]", 
                   SubscriptBox[
                    OverscriptBox[
                    StyleBox["q", "TI"], "\[RightVector]"], 
                    StyleBox["LL",
                    FontSlant->"Plain"]],
                   LimitsPositioning->True], "\[ThinSpace]", 
                  SubsuperscriptBox["\[CapitalPsi]", 
                   StyleBox["LL",
                    FontSlant->"Plain"], "\[Dagger]"], 
                  RowBox[{"(", 
                   RowBox[{
                    SubscriptBox[
                    StyleBox["h",
                    FontFamily->"Helvetica",
                    FontSlant->"Plain"], 
                    StyleBox["LL",
                    FontSlant->"Plain"]], "-", 
                    SubscriptBox["\[Mu]", 
                    StyleBox["LL",
                    FontSlant->"Plain"]]}], ")"}], 
                  SubscriptBox["\[CapitalPsi]", 
                   StyleBox["LL",
                    FontSlant->"Plain"]], "-", 
                  FractionBox["1", "4"], 
                  SubscriptBox[
                   StyleBox["G", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]], "\[ThinSpace]", 
                  UnderscriptBox["\[Sum]", "\[Iota]",
                   LimitsPositioning->True], 
                  SuperscriptBox[
                   RowBox[{"(", 
                    SubsuperscriptBox["\[CapitalPi]", 
                    StyleBox["LL",
                    FontSlant->"Plain"], "\[Iota]"], ")"}], "\[Dagger]"], 
                  SubsuperscriptBox["\[CapitalPi]", 
                   StyleBox["LL",
                    FontSlant->"Plain"], "\[Iota]"]}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "fcf821ea-cee7-4920-b4f4-d0d0c31407dc"]
              }], "Text",
               FontFamily->"Source Sans Pro",
               FontSize->9.5,ExpressionUUID->
               "6497048f-bd3c-4e9b-a348-2f5f2483f391"],
              ImageSize->290]},
            {
             PaneBox[
              TemplateBox[{
                RowBox[{
                  SubscriptBox[
                   TagBox[
                    StyleBox[
                    "h", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
                    "SL31SansSerif"], "LL"], "(", 
                  SubscriptBox[
                   OverscriptBox["q", "\[RightVector]"], "LL"], ")"}]},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              StyleBox["\<\"h(q)\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[Cell[TextData[{
               "the ",
               Cell[BoxData[
                FormBox[
                 RowBox[{"8", "\[Times]", "8"}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "2a219fc8-fb84-4e09-859e-2698c45df5e4"],
               " Hamiltonian matrix of a plane wave, ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  UnderscriptBox["\[Sum]", 
                   StyleBox["j", "TI"],
                   LimitsPositioning->True], "\[ThinSpace]", 
                  SubsuperscriptBox["\[Alpha]", 
                   StyleBox["LL",
                    FontSlant->"Plain"], 
                   StyleBox["j", "TI"]], 
                  SubsuperscriptBox[
                   StyleBox["q", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"], 
                   StyleBox["j", "TI"]], "+", 
                  SubscriptBox["\[Beta]", 
                   StyleBox["LL",
                    FontSlant->"Plain"]], 
                  SubscriptBox[
                   StyleBox["m", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "3f2f3496-3a17-4007-888c-9f7a28a2549d"],
               " (times ",
               Cell[BoxData[
                FormBox[
                 SubsuperscriptBox["\[Sigma]", "0", 
                  StyleBox["LL",
                   FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "61052061-8ed7-4e92-850d-7d0c4bb6e75b"],
               " on the isospin index); eigenvalues ",
               Cell[BoxData[
                FormBox[
                 RowBox[{"\[PlusMinus]", 
                  SubscriptBox["\[CurlyEpsilon]", 
                   StyleBox["LL",
                    FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "b2c43cf4-5a6e-435e-8ae8-2dc2dc720c76"]
              }], "Text",
               FontFamily->"Source Sans Pro",
               FontSize->9.5,ExpressionUUID->
               "26aeeb02-7b32-4392-8943-f9f47228068d"],
              ImageSize->290]},
            {
             PaneBox[
              TemplateBox[{
                SubscriptBox[
                 OverscriptBox["d", "\[RightVector]"], "LL"], "\", \"", 
                SubsuperscriptBox["d", "LL", "\[Iota]"], "\", \"", 
                SubscriptBox["\[Zeta]", "LL"]},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              StyleBox["\<\"dvec d_iota abs_dvec_at_min zeta\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[Cell[TextData[{
               "the order parameter, the isospin vector ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubscriptBox[
                   OverscriptBox[
                    StyleBox["d", "TI"], "\[RightVector]"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]], "\[LongEqual]", 
                  RowBox[{"(", 
                   RowBox[{
                    SubsuperscriptBox[
                    StyleBox["d", "TI"], 
                    StyleBox["LL",
                    FontSlant->"Plain"], "1"], ",", 
                    SubsuperscriptBox[
                    StyleBox["d", "TI"], 
                    StyleBox["LL",
                    FontSlant->"Plain"], "2"], ",", 
                    SubsuperscriptBox[
                    StyleBox["d", "TI"], 
                    StyleBox["LL",
                    FontSlant->"Plain"], "3"]}], ")"}], "\[Element]", 
                  SuperscriptBox[
                   StyleBox["\[DoubleStruckCapitalC]",
                    FontSlant->"Plain"], "3"]}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "cd85ef75-81ae-4cd8-a485-94b08ceb779e"],
               " with ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubsuperscriptBox[
                   StyleBox["d", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"], "\[Iota]"], "\[LongEqual]", 
                  RowBox[{"-", 
                   FractionBox["1", "2"]}], 
                  SubscriptBox[
                   StyleBox["G", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]], 
                  RowBox[{"\[LeftAngleBracket]", 
                   SubsuperscriptBox["\[CapitalPi]", 
                    StyleBox["LL",
                    FontSlant->"Plain"], "\[Iota]"], 
                   "\[RightAngleBracket]"}]}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "85151f09-2264-4410-acee-eb730574d379"],
               ", and its non-unitarity ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  RowBox[{
                   SubscriptBox["\[Zeta]", 
                    StyleBox["LL",
                    FontSlant->"Plain"]], "\[LongEqual]", 
                   RowBox[{
                    RowBox[{"\[LeftBracketingBar]", 
                    RowBox[{
                    SubscriptBox[
                    OverscriptBox[
                    StyleBox["d", "TI"], "\[RightVector]"], 
                    StyleBox["LL",
                    FontSlant->"Plain"]], "\[Times]", 
                    SubsuperscriptBox[
                    OverscriptBox[
                    StyleBox["d", "TI"], "\[RightVector]"], 
                    StyleBox["LL",
                    FontSlant->"Plain"], 
                    RowBox[{"\[ThinSpace]", "*"}]]}], 
                    "\[RightBracketingBar]"}], "/", 
                    SuperscriptBox[
                    RowBox[{"\[LeftBracketingBar]", 
                    SubscriptBox[
                    OverscriptBox[
                    StyleBox["d", "TI"], "\[RightVector]"], 
                    StyleBox["LL",
                    FontSlant->"Plain"]], "\[RightBracketingBar]"}], "2"]}]}],
                   "\[Element]", 
                  RowBox[{"[", 
                   RowBox[{"0", ",", "1"}], "]"}]}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "3733b7db-c4aa-415a-bea4-77ba78297634"],
               " (plain text ",
               StyleBox["cross(dvec, dvec^*)",
                FontFamily->"Source Code Pro"],
               ": the cross product)"
              }], "Text",
               FontFamily->"Source Sans Pro",
               FontSize->9.5,ExpressionUUID->
               "1b423f23-d0f4-4525-9bb9-04f879205bae"],
              ImageSize->290]},
            {
             PaneBox[
              TemplateBox[{
                SubscriptBox["\[CapitalDelta]", "LL"], "\", \"", 
                SubsuperscriptBox["\[CapitalDelta]", "LL", "\[PlusMinus]"]},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              StyleBox["\<\"Delta Delta_+ Delta_- Delta_(+-)\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[Cell[TextData[{
               "the gap: ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubscriptBox["\[CapitalDelta]", 
                   StyleBox["LL",
                    FontSlant->"Plain"]], "\[LongEqual]", 
                  RowBox[{"\[LeftBracketingBar]", 
                   SubscriptBox[
                    OverscriptBox[
                    StyleBox["d", "TI"], "\[RightVector]"], 
                    StyleBox["LL",
                    FontSlant->"Plain"]], "\[RightBracketingBar]"}]}], 
                 TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "a3413812-29a1-4676-a29e-2a4402f3f224"],
               " for a unitary state, and the two gaps ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SuperscriptBox[
                   RowBox[{"(", 
                    SubsuperscriptBox["\[CapitalDelta]", 
                    StyleBox["LL",
                    FontSlant->"Plain"], "\[PlusMinus]"], ")"}], "2"], "\[LongEqual]", 
                  SuperscriptBox[
                   RowBox[{"\[LeftBracketingBar]", 
                    SubscriptBox[
                    OverscriptBox[
                    StyleBox["d", "TI"], "\[RightVector]"], 
                    StyleBox["LL",
                    FontSlant->"Plain"]], "\[RightBracketingBar]"}], "2"], 
                  RowBox[{"(", 
                   RowBox[{"1", "\[PlusMinus]", 
                    SubscriptBox["\[Zeta]", 
                    StyleBox["LL",
                    FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "99a22f35-3283-4705-a529-c04c767219c2"],
               " of a general state"
              }], "Text",
               FontFamily->"Source Sans Pro",
               FontSize->9.5,ExpressionUUID->
               "7c16efab-c491-4fae-8ec2-540f9abe42c7"],
              ImageSize->290]},
            {
             PaneBox[
              TemplateBox[{
                SubscriptBox[
                 TagBox[
                  StyleBox[
                  "P", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
                  "SL31SansSerif"], "LL"], "\", \"", 
                RowBox[{
                  SubscriptBox[
                   TagBox[
                    StyleBox[
                    "H", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
                    "SL31SansSerif"], "LL"], "(", 
                  SubscriptBox[
                   OverscriptBox["q", "\[RightVector]"], "LL"], ")"}], 
                "\", \"", 
                RowBox[{
                  SubscriptBox["\[ScriptCapitalN]", "LL"], "(", 
                  SubscriptBox[
                   OverscriptBox["q", "\[RightVector]"], "LL"], ")"}]},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              StyleBox["\<\"Ppair H_BdG\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[Cell[TextData[{
               "the pairing block ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubscriptBox[
                   StyleBox["P",
                    FontFamily->"Helvetica",
                    FontSlant->"Plain"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]], "\[LongEqual]", 
                  UnderscriptBox["\[Sum]", "\[Iota]",
                   LimitsPositioning->True], "\[ThinSpace]", 
                  SubsuperscriptBox[
                   StyleBox["d", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"], "\[Iota]"], 
                  SuperscriptBox[
                   RowBox[{"(", 
                    SubsuperscriptBox[
                    StyleBox["K",
                    FontFamily->"Helvetica",
                    FontSlant->"Plain"], 
                    StyleBox["LL",
                    FontSlant->"Plain"], "\[Iota]"], ")"}], "\[Dagger]"]}], 
                 TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "fccf53c6-61e8-4a4e-aaf1-d2e319d911df"],
               ", the ",
               Cell[BoxData[
                FormBox[
                 RowBox[{"16", "\[Times]", "16"}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "558a3e55-30ed-4ddd-9531-144f0b610e51"],
               " Bogoliubov-de Gennes matrix ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubscriptBox[
                   StyleBox["H",
                    FontFamily->"Helvetica",
                    FontSlant->"Plain"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]], "\[LongEqual]", 
                  RowBox[{"(", "\[NoBreak]", GridBox[{
                    {
                    RowBox[{
                    SubscriptBox[
                    StyleBox["h",
                    FontFamily->"Helvetica",
                    FontSlant->"Plain"], 
                    StyleBox["LL",
                    FontSlant->"Plain"]], 
                    RowBox[{"(", 
                    SubscriptBox[
                    OverscriptBox[
                    StyleBox["q", "TI"], "\[RightVector]"], 
                    StyleBox["LL",
                    FontSlant->"Plain"]], ")"}], "-", 
