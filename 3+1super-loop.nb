  "During evaluation of \
In[209]:=",ExpressionUUID->"ec331ad8-300d-48a0-82d5-e3dbce6d1ab7"]
}, Open  ]],

Cell[TextData[{
 "S-10, the longitudinal vector boson. For a plane wave of wave number ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["k", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["B",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fd75193d-7ae3-4f08-9ca6-ba4dc2a656aa"],
 " and frequency ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Omega]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["B",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "800f6a59-8e16-44a4-b1d2-f21a0804134e"],
 " the time component and the longitudinal component of a massive vector \
field obey two linear equations; their determinant is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox[
         StyleBox["k", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], 
         StyleBox["B",
          FontSlant->"Plain"]], ")"}], "2"], "+", 
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox[
         StyleBox["Z", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], 
         StyleBox["t",
          FontSlant->"Plain"]], "/", 
        SubsuperscriptBox[
         StyleBox["Z", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], 
         StyleBox["s",
          FontSlant->"Plain"]]}], ")"}], 
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox[
         StyleBox["M", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], 
         StyleBox["W",
          FontSlant->"Plain"]], ")"}], "2"]}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox["\[Omega]", 
         StyleBox["LL",
          FontSlant->"Plain"], 
         StyleBox["B",
          FontSlant->"Plain"]], ")"}], "2"], "-", 
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox[
         StyleBox["M", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], 
         StyleBox["W",
          FontSlant->"Plain"]], ")"}], "2"]}], ")"}], "-", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["k", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], 
        StyleBox["B",
         FontSlant->"Plain"]], 
       SubsuperscriptBox["\[Omega]", 
        StyleBox["LL",
         FontSlant->"Plain"], 
        StyleBox["B",
         FontSlant->"Plain"]]}], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fa2d9e84-ad5c-4595-8e6b-e965a2777abb"],
 ", with the mass ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["M", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["W",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "aa24f8e0-f0bc-4d9b-a5df-280651d4a65a"],
 " of the vector boson. The cell checks with ",
 StyleBox["Factor",
  FontFamily->"Source Code Pro"],
 " and ",
 StyleBox["Solve",
  FontFamily->"Source Code Pro"],
 " that it vanishes exactly for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[Omega]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["B",
        FontSlant->"Plain"]], ")"}], "2"], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["W",
        FontSlant->"Plain"]], ")"}], "2"], "+", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["Z", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["s",
        FontSlant->"Plain"]], "/", 
      SubsuperscriptBox[
       StyleBox["Z", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["t",
        FontSlant->"Plain"]]}], ")"}], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["k", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["B",
        FontSlant->"Plain"]], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "67f2c409-7ade-4639-bd87-d53d584ff3d7"],
 ": the absorbed Goldstone boson moves with the velocity ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["Z", "TI"], 
       StyleBox["LL",
