                   StyleBox["\[GothicS]",
                    FontSlant->"Plain"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "81a740b1-bbd1-41c3-9f2c-c191d4b68c66"],
               " (dimension 14), ",
               Cell[BoxData[
                FormBox[
                 SubsuperscriptBox[
                  StyleBox["\[ScriptCapitalF]",
                   FontSlant->"Plain"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
