              StyleBox["\<\"vI\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[Cell["\<\
a unit (bi-)quaternion that rotates the isospin of the spinor charges (from \
the left)\
\>", "Text",
               FontFamily->"Source Sans Pro",
               FontSize->9.5,ExpressionUUID->
               "d451e434-80c7-4caf-a840-7f54a97e4be5"],
              ImageSize->290]},
            {
             PaneBox[
              TemplateBox[{
                SubscriptBox["\[GothicM]", "LL"], "\", \"", 
                SubscriptBox["\[GothicL]", "LL"], "\", \"", 
                SubscriptBox["\[GothicS]", "LL"]},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              StyleBox["\<\"m_LL l_LL s_LL\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[Cell[TextData[{
               "the Malcev algebra of the super-loop, ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubscriptBox[
                   StyleBox["\[GothicM]",
                    FontSlant->"Plain"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]], "\[LongEqual]", 
                  StyleBox["\[DoubleStruckCapitalC]",
                   FontSlant->"Plain"], "\[CircleTimes]", 
                  StyleBox["Im",
                   FontSlant->"Plain"], "\[ThinSpace]", 
                  StyleBox["\[DoubleStruckCapitalO]",
                   FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "ebc0e1ca-ad79-480b-a9b3-ff2b393c5102"],
               " with the commutator (real dimension 14), its Lorentz part ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubscriptBox[
                   StyleBox["\[GothicL]",
                    FontSlant->"Plain"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]], "\[LongEqual]", 
                  StyleBox["\[DoubleStruckCapitalC]",
                   FontSlant->"Plain"], "\[CircleTimes]", 
                  StyleBox["Im",
                   FontSlant->"Plain"], "\[ThinSpace]", 
                  StyleBox["\[DoubleStruckCapitalH]",
                   FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "93cc0afd-4395-49d3-99e7-53f5180ed51a"],
               " (6, a Lie algebra isomorphic to ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  StyleBox["\[GothicS]\[GothicO]",
                   FontSlant->"Plain"], 
                  RowBox[{"(", 
                   RowBox[{"3", ",", "1"}], ")"}]}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "11902814-8a13-48bc-a179-a098dccb9d88"],
               "), and the space of spinor charges ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubscriptBox[
                   StyleBox["\[GothicS]",
                    FontSlant->"Plain"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]], "\[LongEqual]", 
                  RowBox[{"(", 
                   RowBox[{
                    StyleBox["\[DoubleStruckCapitalC]",
                    FontSlant->"Plain"], "\[CircleTimes]", 
                    StyleBox["\[DoubleStruckCapitalH]",
                    FontSlant->"Plain"]}], ")"}], "\[ThinSpace]", 
                  SubscriptBox[
                   StyleBox["e",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], "4"]}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "3e9a57eb-9d84-4571-b57e-09e0b4d8791b"],
               " (8); ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubscriptBox[
                   StyleBox["\[GothicM]",
                    FontSlant->"Plain"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]], "\[LongEqual]", 
                  SubscriptBox[
                   StyleBox["\[GothicL]",
                    FontSlant->"Plain"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]], "\[CirclePlus]", 
                  SubscriptBox[
                   StyleBox["\[GothicS]",
                    FontSlant->"Plain"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "07ef1ec9-08b8-493f-8e6e-d57e5f65a0fe"]
              }], "Text",
               FontFamily->"Source Sans Pro",
               FontSize->9.5,ExpressionUUID->
               "623cab32-8516-4232-8609-1257c553d2b0"],
              ImageSize->290]},
            {
             PaneBox[
              TemplateBox[{
                SubsuperscriptBox["J", "LL", "j"], "\", \"", 
