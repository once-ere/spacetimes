               FontFamily->"Source Sans Pro",
               FontSize->9.5,ExpressionUUID->
               "89011520-279a-4d72-9ee3-fbfa9275d9aa"],
              ImageSize->290]},
            {
             PaneBox[
              TemplateBox[{
                RowBox[{
                  SubscriptBox["N", "LL"], "(", 
