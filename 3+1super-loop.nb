        StyleBox["LL",
         FontSlant->"Plain"], ",", 
        StyleBox["j", "TI"]}], 
       StyleBox["F",
        FontSlant->"Plain"]]}]], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["cos",
       FontSlant->"Plain"], 
