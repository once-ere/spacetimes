       RowBox[{
       "the", " ", "formula", " ", "on", " ", "401", " ", "momenta"}]}], ";", 
      " ", 
      RowBox[{
       RowBox[{"branch", " ", "1"}], ":", " ", 
       RowBox[{
       "the", " ", "positive", "\n", "   ", "square", " ", "root"}]}]}], ",", 
     " ", 
     RowBox[{
      RowBox[{"-", "1"}], ":", " ", 
      RowBox[{"the", " ", "negative", " ", "one"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"as1CurveRows", " ", "=", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", "\n", "    ", 
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"q", " ", "=", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "Pi"}], "/", "as1Ell"}], " ", "+", " ", 
