               "]"}], " ", "<", " ", "1.*^-8"}]}]}], "]"}]}], ";", "\n", 
         "   ", 
         RowBox[{"Do", "[", "\n", "    ", 
          RowBox[{
           RowBox[{"Module", "[", 
