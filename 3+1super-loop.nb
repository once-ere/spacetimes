                   FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "4fa8c26b-5385-4fee-9244-8a45da517a80"],
               
               "; a Moufang loop (not a group), and a manifold of real \
dimension 14"
              }], "Text",
               FontFamily->"Source Sans Pro",
               FontSize->9.5,ExpressionUUID->
               "6bc0e628-9328-42d0-9564-cadc7cc9b558"],
              ImageSize->290]},
            {
