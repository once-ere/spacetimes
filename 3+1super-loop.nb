          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the field strengths and the curvature: ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["F",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"], 
                SuperscriptBox[
                 StyleBox["p", "TI"], "\[Prime]"]}], "\[Iota]"], "\[LongEqual]", 
              SubscriptBox["\[PartialD]", 
               StyleBox["p", "TI"]], 
              SubsuperscriptBox[
               StyleBox["A", "TI"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                SuperscriptBox[
                 StyleBox["p", "TI"], "\[Prime]"]}], "\[Iota]"], "-", 
              SubscriptBox["\[PartialD]", 
               SuperscriptBox[
                StyleBox["p", "TI"], "\[Prime]"]], 
              SubsuperscriptBox[
               StyleBox["A", "TI"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}], "\[Iota]"], "+", 
              SubsuperscriptBox[
               StyleBox["g", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["v",
                FontSlant->"Plain"]], "\[ThinSpace]", 
              UnderscriptBox["\[Sum]", 
               RowBox[{
                SuperscriptBox["\[Iota]", "\[Prime]"], ",", 
                SuperscriptBox["\[Iota]", "\[Prime]\[Prime]"]}],
               LimitsPositioning->True], "\[ThinSpace]", 
              SubsuperscriptBox["\[Epsilon]", 
               RowBox[{"\[Iota]", 
                SuperscriptBox["\[Iota]", "\[Prime]"], 
                SuperscriptBox["\[Iota]", "\[Prime]\[Prime]"]}], 
               StyleBox["LL",
                FontSlant->"Plain"]], 
              SubsuperscriptBox[
               StyleBox["A", "TI"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}], 
               SuperscriptBox["\[Iota]", "\[Prime]"]], 
              SubsuperscriptBox[
               StyleBox["A", "TI"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                SuperscriptBox[
                 StyleBox["p", "TI"], "\[Prime]"]}], 
               SuperscriptBox["\[Iota]", "\[Prime]\[Prime]"]]}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "4d0f65ef-78e8-4c5f-8618-60d4ca6377c5"],
           ", ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["F",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"], 
                SuperscriptBox[
                 StyleBox["p", "TI"], "\[Prime]"]}], 
               StyleBox["F",
                FontSlant->"Plain"]], "\[LongEqual]", 
              SubscriptBox["\[PartialD]", 
               StyleBox["p", "TI"]], 
              SubsuperscriptBox[
               StyleBox["A", "TI"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                SuperscriptBox[
                 StyleBox["p", "TI"], "\[Prime]"]}], 
               StyleBox["F",
                FontSlant->"Plain"]], "-", 
              SubscriptBox["\[PartialD]", 
               SuperscriptBox[
                StyleBox["p", "TI"], "\[Prime]"]], 
              SubsuperscriptBox[
               StyleBox["A", "TI"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}], 
               StyleBox["F",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "1f1baf7b-5b35-4009-826d-34ba962bfcfb"],
           ", and the ",
           Cell[BoxData[
            FormBox[
             RowBox[{"8", "\[Times]", "8"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "fa8247c2-4732-4e89-9230-302d58889f75"],
           " curvature of the spin connection, ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["R",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               RowBox[{
                StyleBox["p", "TI"], 
                SuperscriptBox[
                 StyleBox["p", "TI"], "\[Prime]"]}], 
               StyleBox["LL",
                FontSlant->"Plain"]], "\[LongEqual]", 
              SubscriptBox["\[PartialD]", 
               StyleBox["p", "TI"]], 
              SubsuperscriptBox["\[CapitalGamma]", 
               SuperscriptBox[
                StyleBox["p", "TI"], "\[Prime]"], 
               StyleBox["LL",
                FontSlant->"Plain"]], "-", 
              SubscriptBox["\[PartialD]", 
               SuperscriptBox[
                StyleBox["p", "TI"], "\[Prime]"]], 
              SubsuperscriptBox["\[CapitalGamma]", 
               StyleBox["p", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"]], "+", 
              SubsuperscriptBox["\[CapitalGamma]", 
               StyleBox["p", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"]], 
              SubsuperscriptBox["\[CapitalGamma]", 
               SuperscriptBox[
                StyleBox["p", "TI"], "\[Prime]"], 
               StyleBox["LL",
                FontSlant->"Plain"]], "-", 
              SubsuperscriptBox["\[CapitalGamma]", 
               SuperscriptBox[
                StyleBox["p", "TI"], "\[Prime]"], 
               StyleBox["LL",
                FontSlant->"Plain"]], 
              SubsuperscriptBox["\[CapitalGamma]", 
               StyleBox["p", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "fac9777c-cfac-4d06-8098-32551309104a"],
           "; the commutator of two covariant derivatives is ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["R",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               RowBox[{
                StyleBox["p", "TI"], 
                SuperscriptBox[
                 StyleBox["p", "TI"], "\[Prime]"]}], 
               StyleBox["LL",
                FontSlant->"Plain"]], "-", 
              StyleBox["i", "TI"], "\[ThinSpace]", 
              SubsuperscriptBox[
               StyleBox["g", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["v",
                FontSlant->"Plain"]], "\[ThinSpace]", 
              UnderscriptBox["\[Sum]", "\[Iota]",
               LimitsPositioning->True], "\[ThinSpace]", 
              SubsuperscriptBox[
               StyleBox["F",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"], 
                SuperscriptBox[
                 StyleBox["p", "TI"], "\[Prime]"]}], "\[Iota]"], 
              SubsuperscriptBox[
               StyleBox["T", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], "\[Iota]"], "-", 
              StyleBox["i", "TI"], "\[ThinSpace]", 
              SubsuperscriptBox[
               StyleBox["g", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["F",
                FontSlant->"Plain"]], 
              SubsuperscriptBox[
               StyleBox["F",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"], 
                SuperscriptBox[
                 StyleBox["p", "TI"], "\[Prime]"]}], 
               StyleBox["F",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "e70a5cf2-fac3-440f-a891-a717df2b475f"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "ed81350e-a340-4b96-84ad-8b1478d4629a"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubscriptBox["\[CapitalPsi]", 
             RowBox[{"LL", ",", "1"}]], "\", \"", 
            SubscriptBox["\[CapitalPsi]", 
             RowBox[{"LL", ",", "2"}]], "\", \"", 
            SubscriptBox["\[CapitalPsi]", 
             RowBox[{"LL", ",", "3"}]], "\", \"", 
            SubscriptBox["\[CapitalPsi]", 
             RowBox[{"LL", ",", "4"}]], "\", \"", 
            SubscriptBox["\[CapitalPsi]", 
             RowBox[{"LL", ",", "5"}]], "\", \"", 
            SubscriptBox["\[CapitalPsi]", 
             RowBox[{"LL", ",", "6"}]], "\", \"", 
            SubscriptBox["\[CapitalPsi]", 
             RowBox[{"LL", ",", "7"}]], "\", \"", 
            SubscriptBox["\[CapitalPsi]", 
             RowBox[{"LL", ",", "8"}]], "\", \"", 
            SubsuperscriptBox["\[CapitalPsi]", "LL", "\[PlusMinus]"], 
            "\", \"", 
            SubscriptBox[
             OverscriptBox["\[CapitalPsi]", "_"], "LL"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"Psi_LL^+ Psi_LL^-\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the eight components of ",
           Cell[BoxData[
            FormBox[
             SubscriptBox["\[CapitalPsi]", 
              StyleBox["LL",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "e4484eb7-aa20-4086-af14-0c47fadf7412"],
           
           ": components 1 and 2 are the first Dirac component with isospin \
up and down, 3 and 4 the second, 5 and 6 the third, 7 and 8 the fourth; ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[CapitalPsi]", 
              StyleBox["LL",
               FontSlant->"Plain"], "-"], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "f493ad0c-5a75-444b-9216-5a61a22ab90d"],
           " (components 1 to 4, chirality ",
           Cell[BoxData[
            FormBox[
             RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "219140d7-e5dd-401c-a090-659ba72fb327"],
           ") and ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[CapitalPsi]", 
              StyleBox["LL",
               FontSlant->"Plain"], "+"], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "675d64f2-4424-4291-9d8b-1bf23a763b5e"],
           " (components 5 to 8, chirality ",
           Cell[BoxData[
            FormBox[
             RowBox[{"+", "1"}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "970c2801-0cc8-44e3-bd9e-af26249346bc"],
           ") are the two Weyl isodoublets; ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubscriptBox[
               OverscriptBox["\[CapitalPsi]", "_"], 
               StyleBox["LL",
                FontSlant->"Plain"]], "\[LongEqual]", 
              SubsuperscriptBox["\[CapitalPsi]", 
               StyleBox["LL",
                FontSlant->"Plain"], "\[Dagger]"], 
              RowBox[{"(", 
               RowBox[{
                SubsuperscriptBox["\[Gamma]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], "0"], "\[CircleTimes]", 
                SubsuperscriptBox["\[Sigma]", "0", 
                 StyleBox["LL",
                  FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "9588e7eb-e0b9-4441-ad68-ccea3d2a9e57"],
           " is the Dirac adjoint"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "d127b18b-7b94-4c00-bb5c-55e8f4206673"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["\[Psi]", "LL", "p"], "\", \"", 
            SubsuperscriptBox["\[Psi]", "LL", "h"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"psi_p psi_h\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the particle and the hole component (eight complex functions \
each, in the order of the components of ",
           Cell[BoxData[
            FormBox[
             SubscriptBox["\[CapitalPsi]", 
              StyleBox["LL",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "2c8bc57d-b4b8-4f5b-bcfa-f1a87ec9de9f"],
           ") of a mode of the mean-field equations: ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[Psi]", 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["p",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "499ed3b8-6228-4c33-bba3-eb636ae596ac"],
           " transforms like ",
           Cell[BoxData[
            FormBox[
             SubscriptBox["\[CapitalPsi]", 
              StyleBox["LL",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "b8e00174-1fb9-4aa5-b369-454ebc3be26f"],
           " and ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[Psi]", 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["h",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "19e21e4b-1b1d-49e8-ba75-3404804e5b75"],
           " like ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[CapitalPsi]", 
              StyleBox["LL",
               FontSlant->"Plain"], "*"], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "489b3242-f792-4652-abda-aa0fe855a2e8"],
           "; a component is written ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[Psi]", 
              RowBox[{
               StyleBox["LL",
                FontSlant->"Plain"], ",", 
               StyleBox["k", "TI"]}], 
              StyleBox["p",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "2178860c-7e38-4c33-bbab-82e57e48b8f3"],
           ", and a numbered mode ",
           Cell[BoxData[
            FormBox[
             RowBox[{"(", 
              RowBox[{
               SubsuperscriptBox["\[Psi]", 
                RowBox[{
                 StyleBox["LL",
                  FontSlant->"Plain"], ",", 
                 StyleBox["n", "TI"]}], 
                StyleBox["p",
                 FontSlant->"Plain"]], ",", 
               SubsuperscriptBox["\[Psi]", 
                RowBox[{
                 StyleBox["LL",
                  FontSlant->"Plain"], ",", 
                 StyleBox["n", "TI"]}], 
                StyleBox["h",
                 FontSlant->"Plain"]]}], ")"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "e5e19d2c-6914-42af-a79a-73884268ae9d"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "2d9a8498-ccea-49f7-80c6-435e36bbd896"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["\[ScriptCapitalH]", "LL", "DB"], "\", \"", 
            SubsuperscriptBox["h", "LL", "\[Del]"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"H_DB h_nabla\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the Dirac-Bogoliubov-de Gennes operator of the mean-field \
equations: the ",
           Cell[BoxData[
            FormBox[
             RowBox[{"2", "\[Times]", "2"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "b32708ff-a0d3-46e7-b416-6af195d8926a"],
           " block matrix (blocks of ",
           Cell[BoxData[
            FormBox[
             RowBox[{"8", "\[Times]", "8"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "e304b192-2da4-43bd-85a3-f51c82d1c6b3"],
           ") with the upper left block ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["h", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], "\[Del]"], "-", 
              StyleBox["i", "TI"], 
              SubsuperscriptBox["\[CapitalGamma]", "0", 
               StyleBox["LL",
                FontSlant->"Plain"]], "-", 
              SubscriptBox[
               StyleBox["A",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", "0"}]], "-", 
              SubscriptBox["\[Mu]", 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "0a135530-80b3-44d1-8bb0-12292d6c82ee"],
           ", the upper right block ",
           Cell[BoxData[
            FormBox[
             SubscriptBox[
              StyleBox["P",
               FontFamily->"Helvetica",
               FontSlant->"Plain"], 
              StyleBox["LL",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "c6ad91a2-8c51-4e2d-b9f0-6ff8567376f3"],
           ", the lower left block ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["P",
               FontFamily->"Helvetica",
               FontSlant->"Plain"], 
              StyleBox["LL",
               FontSlant->"Plain"], "\[Dagger]"], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "2f195871-b01a-4e05-947c-1c4b85bc60fe"],
           " and the lower right block ",
           Cell[BoxData[
            FormBox[
             RowBox[{"-", 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{
                 SubsuperscriptBox[
                  StyleBox["h", "TI"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], "\[Del]"], "-", 
                 StyleBox["i", "TI"], 
                 SubsuperscriptBox["\[CapitalGamma]", "0", 
                  StyleBox["LL",
                   FontSlant->"Plain"]], "-", 
                 SubscriptBox[
                  StyleBox["A",
                   FontFamily->"Helvetica",
                   FontSlant->"Plain"], 
                  RowBox[{
                   StyleBox["LL",
                    FontSlant->"Plain"], ",", "0"}]], "-", 
                 SubscriptBox["\[Mu]", 
                  StyleBox["LL",
                   FontSlant->"Plain"]]}], ")"}], "*"]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "3c3bde28-4367-4a24-b34a-ee82682339af"],
           ", with the covariant Dirac Hamiltonian ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["h", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], "\[Del]"], "\[LongEqual]", 
              RowBox[{"-", 
               StyleBox["i", "TI"]}], "\[ThinSpace]", 
              UnderscriptBox["\[Sum]", 
               StyleBox["j", "TI"],
               LimitsPositioning->True], "\[ThinSpace]", 
              SubsuperscriptBox["\[Alpha]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["j", "TI"]], 
              SubsuperscriptBox["\[Del]", 
               StyleBox["j", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"]], "+", 
              SubscriptBox["\[Beta]", 
               StyleBox["LL",
                FontSlant->"Plain"]], 
              SubscriptBox[
               StyleBox["m", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "23c81f40-60ce-4ab7-b21d-ecb2ca4ba2b5"],
           " (",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[Alpha]", 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "fb1b87c3-808e-4e18-84d4-cd4811f8ce6a"],
           " and ",
           Cell[BoxData[
            FormBox[
             SubscriptBox["\[Beta]", 
              StyleBox["LL",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "ed890905-585b-402e-a56e-5c0f28c982c4"],
           " acting on the Dirac index); on a plane wave ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              StyleBox["exp",
               FontSlant->"Plain"], 
              RowBox[{"(", 
               RowBox[{
                StyleBox["i", "TI"], "\[ThinSpace]", 
                UnderscriptBox["\[Sum]", 
                 StyleBox["j", "TI"],
                 LimitsPositioning->True], "\[ThinSpace]", 
                SubsuperscriptBox[
                 StyleBox["q", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["j", "TI"]], 
                SubsuperscriptBox[
                 StyleBox["x", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["j", "TI"]]}], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "f19d5487-a711-4353-b4ef-b308739f9f69"],
           " with constant fields it is a ",
           Cell[BoxData[
            FormBox[
             RowBox[{"16", "\[Times]", "16"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "fcae3b4d-0c1a-4045-befc-76b4c6a789c4"],
           " matrix ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["\[ScriptCapitalH]",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["DB",
                FontSlant->"Plain"]], 
              RowBox[{"(", 
               SubscriptBox[
                OverscriptBox[
                 StyleBox["q", "TI"], "\[RightVector]"], 
                StyleBox["LL",
                 FontSlant->"Plain"]], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "5235ff94-a3f6-4d0e-ace6-8d0615318a5b"],
           " (plain text ",
           StyleBox["H_DB(q)",
            FontFamily->"Source Code Pro"],
           "), which without gauge fields equals ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubscriptBox[
               StyleBox["H",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"]], 
              RowBox[{"(", 
               SubscriptBox[
                OverscriptBox[
                 StyleBox["q", "TI"], "\[RightVector]"], 
                StyleBox["LL",
                 FontSlant->"Plain"]], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "20bb5c58-80cb-46b4-95c8-ac4fbce0840e"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "ddb5d734-b913-45e8-8a9a-d166f36232e1"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox[
             OverscriptBox["a", "^"], 
             RowBox[{"LL", ",", "n"}], "qp"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"a_qp\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the annihilation operator of the quasi-particle of a numbered \
mode of the mean-field equations (constant in time): ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubscriptBox["\[CapitalPsi]", 
               StyleBox["LL",
                FontSlant->"Plain"]], "\[LongEqual]", 
              UnderscriptBox["\[Sum]", 
               StyleBox["n", "TI"],
               LimitsPositioning->True], 
              RowBox[{"(", 
               RowBox[{
                SubsuperscriptBox["\[Psi]", 
                 RowBox[{
                  StyleBox["LL",
                   FontSlant->"Plain"], ",", 
                  StyleBox["n", "TI"]}], 
                 StyleBox["p",
                  FontSlant->"Plain"]], 
                SubsuperscriptBox[
                 OverscriptBox[
                  StyleBox["a", "TI"], "^"], 
                 RowBox[{
                  StyleBox["LL",
                   FontSlant->"Plain"], ",", 
                  StyleBox["n", "TI"]}], 
                 StyleBox["qp",
                  FontSlant->"Plain"]], "+", 
                SuperscriptBox[
                 RowBox[{"(", 
                  SubsuperscriptBox["\[Psi]", 
                   RowBox[{
                    StyleBox["LL",
                    FontSlant->"Plain"], ",", 
                    StyleBox["n", "TI"]}], 
                   StyleBox["h",
                    FontSlant->"Plain"]], ")"}], "*"], 
                SuperscriptBox[
                 RowBox[{"(", 
                  SubsuperscriptBox[
                   OverscriptBox[
                    StyleBox["a", "TI"], "^"], 
                   RowBox[{
                    StyleBox["LL",
                    FontSlant->"Plain"], ",", 
                    StyleBox["n", "TI"]}], 
                   StyleBox["qp",
                    FontSlant->"Plain"]], ")"}], "\[Dagger]"]}], ")"}]}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "d7de94c2-81f0-4bdb-a4b4-751d2a3c6ab5"],
           "; the quasi-particle vacuum is annihilated by every ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              OverscriptBox[
               StyleBox["a", "TI"], "^"], 
              RowBox[{
               StyleBox["LL",
                FontSlant->"Plain"], ",", 
               StyleBox["n", "TI"]}], 
              StyleBox["qp",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "c49d87dc-355a-468c-babe-d49e7c1b4680"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "057eb19c-3317-4db5-8394-54c5795d13a7"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["E", 
             RowBox[{"LL", ",", "n"}], "qp"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"E_qp\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the energy of a numbered mode of the mean-field equations in a \
stationary state, an eigenvalue of ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["\[ScriptCapitalH]",
               FontSlant->"Plain"], 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["DB",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "fed4fa5a-bab2-4bde-bc1d-203fdc23e2f9"],
           
           "; the mean-field ground state is the vacuum of the \
quasi-particles of the modes with ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["E", "TI"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["n", "TI"]}], 
               StyleBox["qp",
                FontSlant->"Plain"]], ">", "0"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "8c66da97-b3cd-4181-bee1-af35cd60fbd0"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "4e168712-d78c-43d1-af30-96bc252e330f"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            RowBox[{
              SubsuperscriptBox["\[CapitalPi]", "LL", "\[Iota]"], "(", 
              SubscriptBox["x", "LL"], ")"}]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"Pi_iota(x)\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the local pair operator ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox["\[CapitalPi]", 
               StyleBox["LL",
                FontSlant->"Plain"], "\[Iota]"], 
              RowBox[{"(", 
               SubscriptBox[
                StyleBox["x", "TI"], 
                StyleBox["LL",
                 FontSlant->"Plain"]], ")"}], "\[LongEqual]", 
              SubscriptBox["\[CapitalPsi]", 
               StyleBox["LL",
                FontSlant->"Plain"]], 
              SuperscriptBox[
               RowBox[{"(", 
                SubscriptBox[
                 StyleBox["x", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"]], ")"}], 
               StyleBox["T", "TI"]], 
              SubsuperscriptBox[
               StyleBox["K",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"], "\[Iota]"], 
              SubscriptBox["\[CapitalPsi]", 
               StyleBox["LL",
                FontSlant->"Plain"]], 
              RowBox[{"(", 
               SubscriptBox[
                StyleBox["x", "TI"], 
                StyleBox["LL",
                 FontSlant->"Plain"]], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "fc93f918-1b19-4b24-ad80-eb242f1b2571"],
           ", which annihilates two spinor charges at the point ",
           Cell[BoxData[
            FormBox[
             SubscriptBox[
              StyleBox["x", "TI"], 
              StyleBox["LL",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "dcbac73d-6478-40bb-8a73-f788e323fe37"],
           
           "; its integral over space, with the plane waves normalized in a \
box, is the operator ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[CapitalPi]", 
              StyleBox["LL",
               FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "af958c39-b6fa-4c65-a33f-4c3cf89e85eb"],
           " of the momenta"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "189c70cd-50a3-4395-9fb8-4b09c7f47b6f"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["\[ScriptCapitalJ]", "LL", 
             RowBox[{"F", ",", "p"}]], "\", \"", 
            SubsuperscriptBox["\[ScriptCapitalJ]", "LL", 
             RowBox[{"\[Iota]", ",", "p"}]]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"JF_LL Jv_LL\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the currents that are the sources of the gauge fields, ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["\[ScriptCapitalJ]",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               RowBox[{
                StyleBox["F",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}]], "\[LongEqual]", 
              SubsuperscriptBox[
               StyleBox["g", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["F",
                FontSlant->"Plain"]], 
              SubscriptBox[
               OverscriptBox["\[CapitalPsi]", "_"], 
               StyleBox["LL",
                FontSlant->"Plain"]], 
              SubsuperscriptBox["\[Gamma]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["p", "TI"]], 
              SubscriptBox["\[CapitalPsi]", 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "c83d282e-4fed-47f7-b2b1-a707cb6f9ad6"],
           " and ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["\[ScriptCapitalJ]",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               RowBox[{"\[Iota]", ",", 
                StyleBox["p", "TI"]}]], "\[LongEqual]", 
              SubsuperscriptBox[
               StyleBox["g", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["v",
                FontSlant->"Plain"]], 
              SubscriptBox[
               OverscriptBox["\[CapitalPsi]", "_"], 
               StyleBox["LL",
                FontSlant->"Plain"]], 
              SubsuperscriptBox["\[Gamma]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["p", "TI"]], 
              SubsuperscriptBox[
               StyleBox["T", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], "\[Iota]"], 
              SubscriptBox["\[CapitalPsi]", 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "86f70d58-b5c2-4c6b-b293-2d5f4d354620"],
           " (",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[Gamma]", 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["p", "TI"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "7e9cb61d-3b49-497c-b96c-914671cff693"],
           " acting on the Dirac index)"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "e45a345b-9b94-4533-ab61-c7344cfd7bfa"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["\[ScriptCapitalL]", "LL", "\[Del]"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"Lagr_nabla\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the gauge-invariant Lagrangian density of the gauge-covariant \
spinor field: the contact form ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["\[ScriptCapitalL]",
               FontSlant->"Plain"], 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["c",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "d3065fd1-84f4-4e03-b185-d82d31088324"],
           " with the covariant derivative ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[Del]", 
              StyleBox["p", "TI"], 
              StyleBox["LL",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "c501f00c-5f4f-4fa3-b87a-3f6c95c7f430"],
           " in place of ",
           Cell[BoxData[
            FormBox[
             SubscriptBox["\[PartialD]", 
              StyleBox["p", "TI"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "ddaadc1a-885c-4621-9204-b83c2e87bd87"],
           ", plus the Lagrangian density of the gauge fields"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "92c3b6e1-50fd-4aae-be79-ee30959c8cdf"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["\[ScriptL]", "LL", "x"], "\", \"", 
            SubsuperscriptBox["\[ScriptL]", "LL", "t"], "\", \"", 
            SubsuperscriptBox["r", "LL", "W"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"dx dt r_W\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell["\<\
the lattice spacing (the same in the three directions), a time step of the \
lattice equations (a fixed step of the first version of Test 2, or the \
interval between the output times of an integration by CVODE or by IDA, which \
choose their own internal steps), and the coefficient of the Wilson term of \
the lattice equations\
\>", "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "f6caa96f-ff80-4aa2-bb08-3934b74401a2"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["n", "LL", "x"], "\", \"", 
            SubsuperscriptBox["n", "LL", "y"], "\", \"", 
            SubsuperscriptBox["n", "LL", "z"], "\", \"", 
            SubscriptBox[
             OverscriptBox["s", "\[RightVector]"], "LL"], "\", \"", 
            SubsuperscriptBox[
             OverscriptBox["\[Delta]", "\[RightVector]"], "LL", "j"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"nx ny nz site delta_j\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the numbers of lattice sites in the directions ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["x", "TI"], 
              StyleBox["LL",
               FontSlant->"Plain"], "1"], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "8e1a57de-b216-4fb3-b4e9-4c6a27e71589"],
           ", ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["x", "TI"], 
              StyleBox["LL",
               FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "384d283f-901c-47df-a61b-6532d193e6fe"],
           ", ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["x", "TI"], 
              StyleBox["LL",
               FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "a429b2fe-6468-4fb8-b3eb-c79cd5586005"],
           "; a lattice site ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubscriptBox[
               OverscriptBox[
                StyleBox["s", "TI"], "\[RightVector]"], 
               StyleBox["LL",
                FontSlant->"Plain"]], "\[LongEqual]", 
              RowBox[{"(", 
               RowBox[{
                SubsuperscriptBox[
                 StyleBox["s", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], "1"], ",", 
                SubsuperscriptBox[
                 StyleBox["s", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], "2"], ",", 
                SubsuperscriptBox[
                 StyleBox["s", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], "3"]}], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "b7ca7b8f-1016-4e08-a3f4-e69b8d430106"],
           ", whose integer coordinates ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["s", "TI"], 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "7848d656-3d14-40cd-8bdc-9f75bd5c3c89"],
           
           " run from 0 to the number of sites of their direction minus 1, at \
the point ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["x", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["j", "TI"]], "\[LongEqual]", 
              SubsuperscriptBox[
               StyleBox["s", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["j", "TI"]], 
              SubsuperscriptBox["\[ScriptL]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["x",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "3adf2898-2860-4803-8692-36e27960549c"],
           "; and the step to the next site in the direction ",
           Cell[BoxData[
            FormBox[
             StyleBox["j", "TI"], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "66f958d9-35da-4ace-8387-e87dea0c87b7"],
           ", the unit vector ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              OverscriptBox["\[Delta]", "\[RightVector]"], 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "a79925f7-9945-4b98-921b-391e13a05f2c"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "4fcd0bdc-0f4e-42d1-bd03-534da289ed98"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            RowBox[{
              SubsuperscriptBox[
               TagBox[
                StyleBox[
                "U", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
                "SL31SansSerif"], 
               RowBox[{"LL", ",", "j"}], "link"], "(", 
              SubscriptBox[
               OverscriptBox["s", "\[RightVector]"], "LL"], ")"}]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"Ulink Ulink_j\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the link matrix of the lattice from the site ",
           Cell[BoxData[
            FormBox[
             SubscriptBox[
              OverscriptBox[
               StyleBox["s", "TI"], "\[RightVector]"], 
              StyleBox["LL",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "c94097a0-a3e2-485d-a0f9-c3ddd293c2d8"],
           " to the site ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubscriptBox[
               OverscriptBox[
                StyleBox["s", "TI"], "\[RightVector]"], 
               StyleBox["LL",
                FontSlant->"Plain"]], "+", 
              SubsuperscriptBox[
               OverscriptBox["\[Delta]", "\[RightVector]"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["j", "TI"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "77f0b485-475b-42d1-bb36-9a1881ff28d3"],
           ", the ",
           Cell[BoxData[
            FormBox[
             RowBox[{"2", "\[Times]", "2"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "b10dff85-95d7-42ed-bda4-ed307a9632ef"],
           " isospin matrix ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              StyleBox["exp",
               FontSlant->"Plain"], 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", 
                 StyleBox["i", "TI"]}], 
                SubsuperscriptBox["\[ScriptL]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["x",
                  FontSlant->"Plain"]], 
                RowBox[{"(", 
                 RowBox[{
                  SubsuperscriptBox[
                   StyleBox["g", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"], 
                   StyleBox["v",
                    FontSlant->"Plain"]], 
                  SubscriptBox[
                   StyleBox["a",
                    FontFamily->"Helvetica",
                    FontSlant->"Plain"], 
                   RowBox[{
                    StyleBox["LL",
                    FontSlant->"Plain"], ",", 
                    StyleBox["j", "TI"]}]], "+", 
                  SubsuperscriptBox[
                   StyleBox["g", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"], 
                   StyleBox["F",
                    FontSlant->"Plain"]], 
                  SubsuperscriptBox[
                   StyleBox["A", "TI"], 
                   RowBox[{
                    StyleBox["LL",
                    FontSlant->"Plain"], ",", 
                    StyleBox["j", "TI"]}], 
                   StyleBox["F",
                    FontSlant->"Plain"]], 
                  SubsuperscriptBox["\[Sigma]", "0", 
                   StyleBox["LL",
                    FontSlant->"Plain"]]}], ")"}]}], ")"}]}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "d434f31f-524e-474d-8004-aabfb863da10"],
           
           " of the potentials at the site: the parallel transport of the \
isospin and of the phase over one lattice step"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "a62d87cf-6efd-4b4e-b5b6-6a50d08a1d02"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["\[ScriptCapitalH]", "LL", "lat"], "\", \"", 
            SubsuperscriptBox["\[CurlyEpsilon]", "LL", "lat"], "\", \"", 
            SubsuperscriptBox["B", "LL", "H"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"H_lat eps_lat Hbound\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the lattice form of ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["\[ScriptCapitalH]",
               FontSlant->"Plain"], 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["DB",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "9547c64d-57c4-4391-95a3-630cba02e55e"],
           
           " (a matrix of 16 rows per site), the energy of a free particle on \
the lattice, and the bound on the largest eigenvalue magnitude of ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["\[ScriptCapitalH]",
               FontSlant->"Plain"], 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["lat",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "7ee7a9f4-fe5d-4511-b84d-2fd6d2bbad5e"],
           
           " (the first version of Test 2 chose its fixed time step from it; \
the solvers now use it in the bounds of their checks of the energy)"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "9ea783f9-238d-4820-8778-cc3a7d7ed2cb"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox[
             TagBox[
              StyleBox["G", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
              "SL31SansSerif"], "LL", "site"], "\", \"", 
            SubsuperscriptBox[
             TagBox[
              StyleBox["X", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
              "SL31SansSerif"], "LL", "ph"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"Gsite Xph\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the gauge transformation of the lattice equations, which acts at \
each site as ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              StyleBox["exp",
               FontSlant->"Plain"], 
              RowBox[{"(", 
               RowBox[{
                StyleBox["i", "TI"], 
                SubsuperscriptBox["\[Theta]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["F",
                  FontSlant->"Plain"]]}], ")"}], 
              SubscriptBox[
               StyleBox["U",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "426f5782-9e0d-400c-a223-121a2e6949ac"],
           
           " on the isospin index of the particle component and as its \
complex conjugate on the hole component; and the exchange of the particle and \
the hole component, ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["X",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["ph",
                FontSlant->"Plain"]], "\[LongEqual]", 
              RowBox[{"(", "\[NoBreak]", GridBox[{
                 {"0", 
                  SubscriptBox[
                   StyleBox["1",
                    FontFamily->"Helvetica",
                    FontSlant->"Plain"], "8"]},
                 {
                  SubscriptBox[
                   StyleBox["1",
                    FontFamily->"Helvetica",
                    FontSlant->"Plain"], "8"], "0"}
                },
                
                GridBoxAlignment->{
                 "Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
                GridBoxSpacings->{"Columns" -> {
                    Offset[0.27999999999999997`], {
                    Offset[0.7]}, 
                    Offset[0.27999999999999997`]}, "Rows" -> {
                    Offset[0.2], {
                    Offset[0.4]}, 
                    Offset[0.2]}}], "\[NoBreak]", ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "1822b2c0-4ca1-46ca-b03a-0b8197a3e957"],
           ", with which the particle-hole symmetry reads ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["X",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["ph",
                FontSlant->"Plain"]], 
              SuperscriptBox[
               RowBox[{"(", 
                SubsuperscriptBox[
                 StyleBox["\[ScriptCapitalH]",
                  FontSlant->"Plain"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["DB",
                  FontSlant->"Plain"]], ")"}], "*"], 
              SubsuperscriptBox[
               StyleBox["X",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["ph",
                FontSlant->"Plain"]], "\[LongEqual]", 
              RowBox[{"-", 
               SubsuperscriptBox[
                StyleBox["\[ScriptCapitalH]",
                 FontSlant->"Plain"], 
                StyleBox["LL",
                 FontSlant->"Plain"], 
                StyleBox["DB",
                 FontSlant->"Plain"]]}]}], TraditionalForm]], "InlineFormula",
            
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "a4253ff7-2b28-4467-831b-6ca1e49f660d"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "fb45cb09-7229-4ac6-9d18-1f7c7c5e54cd"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox[
             TagBox[
              StyleBox["A", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
              "SL31SansSerif"], 
             RowBox[{"LL", ",", "p"}], "\[UpArrow]"], "\", \"", 
            SubsuperscriptBox[
             TagBox[
              StyleBox["A", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
              "SL31SansSerif"], 
             RowBox[{"LL", ",", "p"}], "\[DownArrow]"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          
          StyleBox["\<\"Acal_up Acal_down Acal_up_0 Acal_up_1 Acal_down_0 \
Acal_down_1\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the two eigenvalues of ",
           Cell[BoxData[
            FormBox[
             SubscriptBox[
              StyleBox["A",
               FontFamily->"Helvetica",
               FontSlant->"Plain"], 
              RowBox[{
               StyleBox["LL",
                FontSlant->"Plain"], ",", 
               StyleBox["p", "TI"]}]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "12d6e576-8f1f-4783-ac9a-9ea38212b876"],
           
           " when the isospin potentials point along the third isospin \
direction (",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["A", "TI"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}], "1"], "\[LongEqual]", 
              SubsuperscriptBox[
               StyleBox["A", "TI"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}], "2"], "\[LongEqual]", "0"}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "d90ca203-0555-4ad7-8d0d-ebd31dd2bbde"],
           "): ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["A",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}], "\[UpArrow]"], "\[LongEqual]", 
              SubsuperscriptBox[
               StyleBox["g", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["F",
                FontSlant->"Plain"]], 
              SubsuperscriptBox[
               StyleBox["A", "TI"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}], 
               StyleBox["F",
                FontSlant->"Plain"]], "+", 
              FractionBox["1", "2"], 
              SubsuperscriptBox[
               StyleBox["g", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["v",
                FontSlant->"Plain"]], 
              SubsuperscriptBox[
               StyleBox["A", "TI"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}], "3"]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "1a255a1a-e0d3-4bb2-9764-447c6c16c8d9"],
           " on the isospin-up components (",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubscriptBox[
               StyleBox["Q", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"]], "\[LongEqual]", 
              RowBox[{"+", 
               FractionBox["1", "2"]}]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "899e8a19-6e00-48ac-a8ea-607c5073877e"],
           ") and ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["A",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}], "\[DownArrow]"], "\[LongEqual]", 
              SubsuperscriptBox[
               StyleBox["g", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["F",
                FontSlant->"Plain"]], 
              SubsuperscriptBox[
               StyleBox["A", "TI"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}], 
               StyleBox["F",
                FontSlant->"Plain"]], "-", 
              FractionBox["1", "2"], 
              SubsuperscriptBox[
               StyleBox["g", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["v",
                FontSlant->"Plain"]], 
              SubsuperscriptBox[
               StyleBox["A", "TI"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}], "3"]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "c4efb9bb-a019-48aa-8e04-8c6c8daf878e"],
           " on the isospin-down components (",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubscriptBox[
               StyleBox["Q", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"]], "\[LongEqual]", 
              RowBox[{"-", 
               FractionBox["1", "2"]}]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "fa92a381-cc03-4681-ab36-1c7a2374f288"],
           
           "); constant potentials of a space direction shift the momentum of \
a component, those of the time direction its energy"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "4c0e1f48-0fad-4e07-bbb6-4eea16fedd3d"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["\[Omega]", "LL", "pr"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"omega_pr\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the angular frequency with which the isospin of a mode turns in a \
constant isospin potential of the time direction, ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox["\[Omega]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["pr",
                FontSlant->"Plain"]], "\[LongEqual]", 
              SubsuperscriptBox[
               StyleBox["g", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["v",
                FontSlant->"Plain"]], 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{
                 UnderscriptBox["\[Sum]", "\[Iota]",
                  LimitsPositioning->True], 
                 SuperscriptBox[
                  RowBox[{"(", 
                   SubsuperscriptBox[
                    StyleBox["A", "TI"], 
                    RowBox[{
                    StyleBox["LL",
                    FontSlant->"Plain"], ",", "0"}], "\[Iota]"], ")"}], 
                  "2"]}], ")"}], 
               RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
            
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "c30e484b-c4d9-4a28-a6c6-98e7d3e14043"],
           
           "; the axis of the rotation is the direction of the potential in \
isospin space"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "5ad14d66-9d18-449b-b126-49c14aeb140c"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["P", "LL", "\[UpArrow]"], "\", \"", 
            SubsuperscriptBox["P", "LL", "h"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          
          StyleBox["\<\"P_up P_up_cvode P_up_rk4 P_up_exact P_hole \
P_hole_cvode P_hole_rk4 P_hole_exact\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the probability of isospin up of a mode, the fraction of its norm \
",
           Cell[BoxData[
            FormBox[
             RowBox[{"\[Integral]", "\[ThinSpace]", 
              SuperscriptBox[
               StyleBox["d", "TI"], "3"], 
              SubscriptBox[
               OverscriptBox[
                StyleBox["x", "TI"], "\[RightVector]"], 
               StyleBox["LL",
                FontSlant->"Plain"]], 
              RowBox[{"(", 
               RowBox[{
                SuperscriptBox[
                 RowBox[{"\[LeftBracketingBar]", 
                  SubsuperscriptBox["\[Psi]", 
                   StyleBox["LL",
                    FontSlant->"Plain"], 
                   StyleBox["p",
                    FontSlant->"Plain"]], "\[RightBracketingBar]"}], "2"], "+", 
                SuperscriptBox[
                 RowBox[{"\[LeftBracketingBar]", 
                  SubsuperscriptBox["\[Psi]", 
                   StyleBox["LL",
                    FontSlant->"Plain"], 
                   StyleBox["h",
                    FontSlant->"Plain"]], "\[RightBracketingBar]"}], "2"]}], 
               ")"}]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "9c339b18-3a52-468c-be5c-14f13b8a2308"],
           
           " that lies in the isospin-up components, and the probability of \
the hole, the fraction that lies in ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[Psi]", 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["h",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "021835d2-c0c1-4660-b8e9-c8348fc5c093"],
           "; both are functions of the time ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["x", "TI"], 
              StyleBox["LL",
               FontSlant->"Plain"], "0"], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "66df6683-5e33-4096-968a-2d9e3fcc8017"],
           " (in the plain-text names the suffix ",
           StyleBox["_cvode",
            FontFamily->"Source Code Pro"],
           
           " marks the values of the integration of the lattice equations by \
CVODE, ",
           StyleBox["_rk4",
            FontFamily->"Source Code Pro"],
           
           " those of the integration by the fixed-step Runge-Kutta method of \
the first version of the original programs, and ",
           StyleBox["_exact",
            FontFamily->"Source Code Pro"],
           " those of the exact solution)"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "ef68a3e2-4e5b-40fc-a3f5-14c4120f20f8"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["\[Chi]", "LL", "pw"], "\", \"", 
            SubsuperscriptBox["\[CurlyTheta]", "LL", "B"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"chi_pw theta_B\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the constant 8-component spinor (Dirac index and isospin) of a \
plane-wave solution, a normalized eigenvector of ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubscriptBox[
               StyleBox["h",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"]], 
              RowBox[{"(", 
               SubscriptBox[
                OverscriptBox[
                 StyleBox["q", "TI"], "\[RightVector]"], 
                StyleBox["LL",
                 FontSlant->"Plain"]], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "6cb10ce8-0c35-4d0d-a29d-7b5b26e03631"],
           
           " or of its lattice form; and the Bogoliubov angle of a plane-wave \
mode of the uniform polar superfluid, ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SuperscriptBox[
               StyleBox["cos",
                FontSlant->"Plain"], "2"], "\[ThinSpace]", 
              SubsuperscriptBox["\[CurlyTheta]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["B",
                FontSlant->"Plain"]], "\[LongEqual]", 
              FractionBox["1", "2"], 
              RowBox[{"(", 
               RowBox[{"1", "+", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"\[PlusMinus]", 
                   SubscriptBox["\[CurlyEpsilon]", 
                    StyleBox["LL",
                    FontSlant->"Plain"]]}], "-", 
                  SubscriptBox["\[Mu]", 
                   StyleBox["LL",
                    FontSlant->"Plain"]]}], ")"}], "/", 
                SubsuperscriptBox[
                 StyleBox["E", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], "\[MinusPlus]"]}], ")"}]}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "9c53b473-2e07-486c-a146-c50f289646b8"],
           " for an eigenvector of the energy ",
           Cell[BoxData[
            FormBox[
             RowBox[{"\[PlusMinus]", 
              SubscriptBox["\[CurlyEpsilon]", 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "1639ca1b-442d-4db6-a173-d2ba0c866e29"],
           ", which divides the mode into its particle part ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              StyleBox["cos",
               FontSlant->"Plain"], "\[ThinSpace]", 
              SubsuperscriptBox["\[CurlyTheta]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["B",
                FontSlant->"Plain"]], "\[ThinSpace]", 
              SubsuperscriptBox["\[Chi]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["pw",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "e603dac3-c586-4c8a-a7cc-59764c0ba50a"],
           " and its hole part ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              StyleBox["sin",
               FontSlant->"Plain"], "\[ThinSpace]", 
              SubsuperscriptBox["\[CurlyTheta]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["B",
                FontSlant->"Plain"]], "\[ThinSpace]", 
              SubsuperscriptBox[
               StyleBox["K",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"], "3"], 
              SubsuperscriptBox["\[Chi]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["pw",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "6249eacc-f9b6-43a7-9bed-a3a55c92b1f0"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "dec76166-3416-4853-b39d-2cf4bd9c9d27"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["\[CapitalDelta]", "LL", "\[Infinity]"], 
            "\", \"", 
            SubsuperscriptBox["\[ScriptL]", "LL", "K"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"Delta_inf ell_K\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the value of the gap far from a domain wall (kink) of the pair \
field, and the width of the wall: the kink ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["d", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], "\[Iota]"], "\[LongEqual]", 
              RowBox[{"(", 
               RowBox[{"0", ",", "0", ",", 
                SubscriptBox["\[CapitalDelta]", 
                 StyleBox["LL",
                  FontSlant->"Plain"]], 
                RowBox[{"(", 
                 SubsuperscriptBox[
                  StyleBox["x", "TI"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], "1"], ")"}]}], ")"}]}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "29ec1d33-7eb5-4fef-91d5-67b9db25fc34"],
           " with ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubscriptBox["\[CapitalDelta]", 
               StyleBox["LL",
                FontSlant->"Plain"]], 
              RowBox[{"(", 
               SubsuperscriptBox[
                StyleBox["x", "TI"], 
                StyleBox["LL",
                 FontSlant->"Plain"], "1"], ")"}], "\[LongEqual]", 
              SubsuperscriptBox["\[CapitalDelta]", 
               StyleBox["LL",
                FontSlant->"Plain"], "\[Infinity]"], "\[ThinSpace]", 
              StyleBox["tanh",
               FontSlant->"Plain"], 
              RowBox[{"(", 
               RowBox[{
                SubsuperscriptBox[
                 StyleBox["x", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], "1"], "/", 
                SubsuperscriptBox["\[ScriptL]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["K",
                  FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "99d961bd-1fa1-4bde-ab96-6803cb7d3973"],
           " changes the sign of the pair field at ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["x", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], "1"], "\[LongEqual]", "0"}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "30f56191-0f00-49f6-bc1d-58289cf10773"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "2a6affd0-c594-4d28-bc33-87b1a61b9bf3"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["\[CurlyPhi]", "LL", "K"], "\", \"", 
            SubsuperscriptBox["\[Chi]", "LL", "K"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"phi_K chi_K\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the profile and the constant spinor of a bound state of a kink of \
the pair field: ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox["\[CurlyPhi]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["K",
                FontSlant->"Plain"]], 
              RowBox[{"(", 
               SubsuperscriptBox[
                StyleBox["x", "TI"], 
                StyleBox["LL",
                 FontSlant->"Plain"], "1"], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "22e66f4c-ae93-4f9c-b1fa-b2941deb9488"],
           " solves ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              StyleBox["d", "TI"], 
              SubsuperscriptBox["\[CurlyPhi]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["K",
                FontSlant->"Plain"]], "/", 
              StyleBox["d", "TI"], 
              SubsuperscriptBox[
               StyleBox["x", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], "1"], "\[LongEqual]", 
              RowBox[{"-", 
               SubscriptBox["\[CapitalDelta]", 
                StyleBox["LL",
                 FontSlant->"Plain"]]}], 
              RowBox[{"(", 
               SubsuperscriptBox[
                StyleBox["x", "TI"], 
                StyleBox["LL",
                 FontSlant->"Plain"], "1"], ")"}], 
              SubsuperscriptBox["\[CurlyPhi]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["K",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "f363a139-c059-4e58-a802-f1834e65edbe"],
           ", so that ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox["\[CurlyPhi]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["K",
                FontSlant->"Plain"]], "\[LongEqual]", 
              StyleBox["cosh",
               FontSlant->"Plain"], 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{
                 SubsuperscriptBox[
                  StyleBox["x", "TI"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], "1"], "/", 
                 SubsuperscriptBox["\[ScriptL]", 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
                  StyleBox["K",
                   FontSlant->"Plain"]]}], ")"}], 
               RowBox[{
                RowBox[{"-", 
                 SubsuperscriptBox["\[CapitalDelta]", 
                  StyleBox["LL",
                   FontSlant->"Plain"], "\[Infinity]"]}], 
                SubsuperscriptBox["\[ScriptL]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["K",
                  FontSlant->"Plain"]]}]]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "8109884b-82c7-44f6-9b92-5184ef5342cb"],
           " for the kink of the width ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[ScriptL]", 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["K",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "3649e5e1-6a58-4e00-9ae9-5eca2315f837"],
           "; ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[Chi]", 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["K",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "b1375796-2544-461d-bfb0-7a67eb51ade3"],
           " is a constant 8-component spinor with ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubscriptBox["\[Beta]", 
               StyleBox["LL",
                FontSlant->"Plain"]], 
              SubsuperscriptBox["\[Chi]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["K",
                FontSlant->"Plain"]], "\[LongEqual]", 
              RowBox[{"\[PlusMinus]", 
               SubsuperscriptBox["\[Chi]", 
                StyleBox["LL",
                 FontSlant->"Plain"], 
                StyleBox["K",
                 FontSlant->"Plain"]]}]}], TraditionalForm]], "InlineFormula",
            
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "10c46e07-0c87-4cde-9130-afd8143510bb"],
           "; the bound state is ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                SubsuperscriptBox["\[Psi]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["p",
                  FontSlant->"Plain"]], ",", 
                SubsuperscriptBox["\[Psi]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["h",
                  FontSlant->"Plain"]]}], ")"}], "\[LongEqual]", 
              RowBox[{"(", 
               RowBox[{
                SubsuperscriptBox["\[CurlyPhi]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["K",
                  FontSlant->"Plain"]], 
                SubsuperscriptBox["\[Chi]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["K",
                  FontSlant->"Plain"]], ",", "\[ThinSpace]", 
                StyleBox["i", "TI"], 
                SuperscriptBox[
                 RowBox[{"(", 
                  SubsuperscriptBox[
                   StyleBox["K",
                    FontFamily->"Helvetica",
                    FontSlant->"Plain"], 
                   StyleBox["LL",
                    FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"], 
                SubsuperscriptBox["\[Alpha]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], "1"], 
                SubsuperscriptBox["\[CurlyPhi]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["K",
                  FontSlant->"Plain"]], 
                SubsuperscriptBox["\[Chi]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["K",
                  FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "639e2521-a97b-48ee-8c61-d31b3b447775"],
           ", with the energy ",
           Cell[BoxData[
            FormBox[
             RowBox[{"\[PlusMinus]", 
              SubscriptBox[
               StyleBox["m", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "132dd163-37c4-4045-81f8-cf67d77639bd"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "d8f44105-e1d6-4b81-bfff-63369802ea1f"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox[
             TagBox[
              StyleBox["Q", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
              "SL31SansSerif"], "LL", "K"], "\", \"", 
            SubsuperscriptBox["k", "LL", "K"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"Qmat_K k_K\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the constant Hermitian ",
           Cell[BoxData[
            FormBox[
             RowBox[{"16", "\[Times]", "16"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "c6fa2db5-3004-4ef3-9d2e-2d7f5753f688"],
           " matrix ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["Q",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["K",
                FontSlant->"Plain"]], "\[LongEqual]", 
              RowBox[{"(", "\[NoBreak]", GridBox[{
                 {"0", 
                  RowBox[{
                   RowBox[{"-", 
                    StyleBox["i", "TI"]}], 
                   SubsuperscriptBox["\[Alpha]", 
                    StyleBox["LL",
                    FontSlant->"Plain"], "1"], 
                   SuperscriptBox[
                    RowBox[{"(", 
                    SubsuperscriptBox[
                    StyleBox["K",
                    FontFamily->"Helvetica",
                    FontSlant->"Plain"], 
                    StyleBox["LL",
                    FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"]}]},
                 {
                  RowBox[{
                   RowBox[{"-", 
                    StyleBox["i", "TI"]}], 
                   SubsuperscriptBox["\[Alpha]", 
                    StyleBox["LL",
                    FontSlant->"Plain"], "1"], 
                   SubsuperscriptBox[
                    StyleBox["K",
                    FontFamily->"Helvetica",
                    FontSlant->"Plain"], 
                    StyleBox["LL",
                    FontSlant->"Plain"], "3"]}], "0"}
                },
                
                GridBoxAlignment->{
                 "Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
                GridBoxSpacings->{"Columns" -> {
                    Offset[0.27999999999999997`], {
                    Offset[0.7]}, 
                    Offset[0.27999999999999997`]}, "Rows" -> {
                    Offset[0.2], {
                    Offset[0.4]}, 
                    Offset[0.2]}}], "\[NoBreak]", ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "2ec5755f-9949-4f66-aa06-7aea20f3ba5c"],
           " (blocks of ",
           Cell[BoxData[
            FormBox[
             RowBox[{"8", "\[Times]", "8"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "592f15f5-5039-4918-b1cd-e6aa5dd4ad79"],
           "), with ",
           Cell[BoxData[
            FormBox[
             SuperscriptBox[
              RowBox[{"(", 
               SubsuperscriptBox[
                StyleBox["Q",
                 FontFamily->"Helvetica",
                 FontSlant->"Plain"], 
                StyleBox["LL",
                 FontSlant->"Plain"], 
                StyleBox["K",
                 FontSlant->"Plain"]], ")"}], "2"], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "e38f64d6-390e-403c-be63-5aaf3e74905b"],
           
           " the unit matrix and the trace 0, through which the square of the \
Dirac-Bogoliubov-de Gennes operator of a wall of the pair field depends on \
the slope of the gap: ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SuperscriptBox[
               RowBox[{"(", 
                SubsuperscriptBox[
                 StyleBox["\[ScriptCapitalH]",
                  FontSlant->"Plain"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["DB",
                  FontSlant->"Plain"]], ")"}], "2"], "\[LongEqual]", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", 
                 SuperscriptBox[
                  StyleBox["d", "TI"], "2"]}], "/", 
                StyleBox["d", "TI"], 
                SuperscriptBox[
                 RowBox[{"(", 
                  SubsuperscriptBox[
                   StyleBox["x", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"], "1"], ")"}], "2"], "+", 
                SuperscriptBox[
                 RowBox[{"(", 
                  SubsuperscriptBox[
                   StyleBox["q", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"], "2"], ")"}], "2"], "+", 
                SuperscriptBox[
                 RowBox[{"(", 
                  SubsuperscriptBox[
                   StyleBox["q", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"], "3"], ")"}], "2"], "+", 
                SubsuperscriptBox[
                 StyleBox["m", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], "2"], "+", 
                SubsuperscriptBox["\[CapitalDelta]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], "2"]}], ")"}], "+", 
              RowBox[{"(", 
               RowBox[{
                StyleBox["d", "TI"], 
                SubscriptBox["\[CapitalDelta]", 
                 StyleBox["LL",
                  FontSlant->"Plain"]], "/", 
                StyleBox["d", "TI"], 
                SubsuperscriptBox[
                 StyleBox["x", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], "1"]}], ")"}], "\[ThinSpace]", 
              SubsuperscriptBox[
               StyleBox["Q",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["K",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "b39ded2c-0963-4c9c-b048-3aae38044668"],
           "; and the number ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["k", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["K",
                FontSlant->"Plain"]], "\[LongEqual]", "0", ",", "1", ",", "2",
               ",", "\[Ellipsis]"}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "3b2901c9-ede2-4860-be93-f1b9c6bce01a"],
           " of a bound state of a kink, below ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox["\[CapitalDelta]", 
               StyleBox["LL",
                FontSlant->"Plain"], "\[Infinity]"], 
              SubsuperscriptBox["\[ScriptL]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["K",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "6bccf2a3-2fe4-47c9-bf4f-bf6e3e0926c3"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "4733a04c-9631-4e4a-9672-fbd355701a35"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["E", "LL", "R"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"E_R\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the Rayleigh quotient of a trial mode on the lattice: the \
expectation value of ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["\[ScriptCapitalH]",
               FontSlant->"Plain"], 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["lat",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "09a3a2fa-3dec-4749-a32c-cb58d2415ec1"],
           
           " in the mode divided by the norm of the mode; it approximates the \
eigenvalue nearest to it with an error of second order in the residual of the \
mode"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "5deade3e-a302-44c5-9160-1abb79399adf"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["B", "LL", "\[UpArrow]"], "\", \"", 
            SubsuperscriptBox["B", "LL", "\[DownArrow]"], "\", \"", 
            SubsuperscriptBox["n", "LL", "L"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"B_up B_down n_L\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the magnetic fields that the isospin-up and the isospin-down \
components feel in the constant field strengths ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["F",
               FontFamily->"Helvetica",
               FontSlant->"Plain"], 
              RowBox[{
               StyleBox["LL",
                FontSlant->"Plain"], ",", "12"}], 
              StyleBox["F",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "280c95af-204c-4225-9783-b61bc494071e"],
           " (of the phase group) and ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["F",
               FontFamily->"Helvetica",
               FontSlant->"Plain"], 
              RowBox[{
               StyleBox["LL",
                FontSlant->"Plain"], ",", "12"}], "3"], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "b2500288-65a5-450d-8f30-1aee732b871b"],
           " (of the third isospin direction), ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["B", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], "\[UpArrow]"], "\[LongEqual]", 
              SubsuperscriptBox[
               StyleBox["g", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["F",
                FontSlant->"Plain"]], 
              SubsuperscriptBox[
               StyleBox["F",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", "12"}], 
               StyleBox["F",
                FontSlant->"Plain"]], "+", 
              FractionBox["1", "2"], 
              SubsuperscriptBox[
               StyleBox["g", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["v",
                FontSlant->"Plain"]], 
              SubsuperscriptBox[
               StyleBox["F",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", "12"}], "3"]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "b8b86da9-bd51-43db-89ec-0612117e4652"],
           " and ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["B", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], "\[DownArrow]"], "\[LongEqual]", 
              SubsuperscriptBox[
               StyleBox["g", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["F",
                FontSlant->"Plain"]], 
              SubsuperscriptBox[
               StyleBox["F",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", "12"}], 
               StyleBox["F",
                FontSlant->"Plain"]], "-", 
              FractionBox["1", "2"], 
              SubsuperscriptBox[
               StyleBox["g", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["v",
                FontSlant->"Plain"]], 
              SubsuperscriptBox[
               StyleBox["F",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", "12"}], "3"]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "06f51611-876b-455f-b11d-06d51c474b19"],
           " (the fields point along ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["x", "TI"], 
              StyleBox["LL",
               FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "4afaabe9-de02-4334-a385-1af0aca10d14"],
           "); and the number ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["n", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["L",
                FontSlant->"Plain"]], "\[LongEqual]", "0", ",", "1", ",", "2",
               ",", "\[Ellipsis]"}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "2680c9dd-2729-44f1-bbb8-40fec701f068"],
           " of a Landau level, of the energies ",
           Cell[BoxData[
            FormBox[
             RowBox[{"\[PlusMinus]", 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{
                 SubsuperscriptBox[
                  StyleBox["m", "TI"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], "2"], "+", 
                 SuperscriptBox[
                  RowBox[{"(", 
                   SubsuperscriptBox[
                    StyleBox["q", "TI"], 
                    StyleBox["LL",
                    FontSlant->"Plain"], "3"], ")"}], "2"], "+", "2", 
                 SubsuperscriptBox[
                  StyleBox["n", "TI"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
                  StyleBox["L",
                   FontSlant->"Plain"]], 
                 RowBox[{"\[LeftBracketingBar]", 
                  SubsuperscriptBox[
                   StyleBox["B", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"], "\[UpArrow]"], 
                  "\[RightBracketingBar]"}]}], ")"}], 
               RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
            
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "3b8e4a4d-b265-4b50-a908-e747e890aacc"],
           " for isospin up and likewise with ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["B", "TI"], 
              StyleBox["LL",
               FontSlant->"Plain"], "\[DownArrow]"], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "c420312b-8a92-484c-9c3c-87a3271fa5eb"],
           " for isospin down"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "013e1428-7e04-488f-ae99-da015e209eb8"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["n", "LL", "act"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"n_act\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the number of active directions of a lattice problem, the \
directions with more than one site (1, 2 or 3); the mode functions of a \
problem with ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["n", "TI"], 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["act",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "1ad0f213-87ad-4d11-a034-c2cb8e5f936f"],
           " active directions are normalized to ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              UnderscriptBox["\[Sum]", 
               SubscriptBox[
                OverscriptBox[
                 StyleBox["s", "TI"], "\[RightVector]"], 
                StyleBox["LL",
                 FontSlant->"Plain"]],
               LimitsPositioning->True], 
              SuperscriptBox[
               RowBox[{"(", 
                SubsuperscriptBox["\[ScriptL]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["x",
                  FontSlant->"Plain"]], ")"}], 
               SubsuperscriptBox[
                StyleBox["n", "TI"], 
                StyleBox["LL",
                 FontSlant->"Plain"], 
                StyleBox["act",
                 FontSlant->"Plain"]]], 
              RowBox[{"(", 
               RowBox[{
                SuperscriptBox[
                 RowBox[{"\[LeftBracketingBar]", 
                  SubsuperscriptBox["\[Psi]", 
                   StyleBox["LL",
                    FontSlant->"Plain"], 
                   StyleBox["p",
                    FontSlant->"Plain"]], "\[RightBracketingBar]"}], "2"], "+", 
                SuperscriptBox[
                 RowBox[{"\[LeftBracketingBar]", 
                  SubsuperscriptBox["\[Psi]", 
                   StyleBox["LL",
                    FontSlant->"Plain"], 
                   StyleBox["h",
                    FontSlant->"Plain"]], "\[RightBracketingBar]"}], "2"]}], 
               ")"}], "\[LongEqual]", "1"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "c84e74e6-b701-49f1-933a-e86a1fab3049"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "981929e4-100b-43c7-9dc1-0415f03c054b"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["N", "LL", "F"], "\", \"", 
            SubsuperscriptBox["E", "LL", "MF"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"N_F E_MF\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the fermion number of a self-consistent lattice state, the sum \
over its modes and over the sites of the squared hole components ",
           Cell[BoxData[
            FormBox[
             SuperscriptBox[
              RowBox[{"\[LeftBracketingBar]", 
               SubsuperscriptBox["\[Psi]", 
                StyleBox["LL",
                 FontSlant->"Plain"], 
                StyleBox["h",
                 FontSlant->"Plain"]], "\[RightBracketingBar]"}], "2"], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "d06c8d65-5ce7-469b-90ac-a6943ef54289"],
           
           " (conserved by the self-consistent evolution), and the mean-field \
energy functional, the sum over the modes of the expectation values of ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["\[ScriptCapitalH]",
               FontSlant->"Plain"], 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["lat",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "68242882-b667-4fd6-8434-179d7031eed5"],
           " without the pair field plus ",
           Cell[BoxData[
            FormBox[
             RowBox[{"2", 
              SuperscriptBox[
               RowBox[{"(", 
                SubsuperscriptBox["\[ScriptL]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["x",
                  FontSlant->"Plain"]], ")"}], 
               SubsuperscriptBox[
                StyleBox["n", "TI"], 
                StyleBox["LL",
                 FontSlant->"Plain"], 
                StyleBox["act",
                 FontSlant->"Plain"]]], "/", 
              SubscriptBox[
               StyleBox["G", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "a996a45a-279d-45d0-bb0d-f17c0476bf62"],
           " times the sum over the sites of ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              UnderscriptBox["\[Sum]", "\[Iota]",
               LimitsPositioning->True], 
              SuperscriptBox[
               RowBox[{"\[LeftBracketingBar]", 
                SubsuperscriptBox[
                 StyleBox["d", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], "\[Iota]"], "\[RightBracketingBar]"}], 
               "2"]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "272ccbbd-e818-4c19-a85b-9a006e993f4d"],
           " (conserved in time-independent gauge fields)"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "987b9c23-111b-4236-a1e8-2743d2c599de"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox[
             TagBox[
              StyleBox["W", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
              "SL31SansSerif"], "LL", "m"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"W_modes\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell["\<\
the matrix whose columns are the modes of a self-consistent lattice state \
(unit vectors with 16 components per site); the self-consistent evolution \
moves all columns together\
\>", "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "a7697519-b85b-4264-bd30-cf3527794e69"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["\[ScriptCapitalM]", "LL", "sc"], "\", \"", 
            SubsuperscriptBox["y", "LL", "A"], "\", \"", 
            SubsuperscriptBox["r", "LL", "A"], "\", \"", 
            SubsuperscriptBox["Y", "LL", "A"], "\", \"", 
            SubsuperscriptBox["R", "LL", "A"], "\", \"", 
            SubsuperscriptBox["c", "LL", "A"], "\", \"", 
            SubsuperscriptBox["a", "LL", "A"], "\", \"", 
            SubsuperscriptBox["n", "LL", "it"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"M_sc y_A r_A Y_A R_A c_A a_A n_it\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the self-consistency map, which takes a pair field to ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              RowBox[{"-", 
               FractionBox["1", "2"]}], 
              SubscriptBox[
               StyleBox["G", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "b35891d3-1ae5-47d5-bb86-2d3ab625cc27"],
           
           " times the pair expectation of the positive-energy eigenvectors \
of ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["\[ScriptCapitalH]",
               FontSlant->"Plain"], 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["lat",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "4b59af59-c14e-4ce6-a1ac-a81ec91dbd89"],
           " with that pair field, divided by ",
           Cell[BoxData[
            FormBox[
             SuperscriptBox[
              RowBox[{"(", 
               SubsuperscriptBox["\[ScriptL]", 
                StyleBox["LL",
                 FontSlant->"Plain"], 
                StyleBox["x",
                 FontSlant->"Plain"]], ")"}], 
              SubsuperscriptBox[
               StyleBox["n", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["act",
                FontSlant->"Plain"]]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "0ceb6c06-f835-4674-ae3e-560429d216ee"],
           
           "; the quantities of the Anderson iteration for its fixed point: \
the iterate (the real and imaginary parts of all ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["d", "TI"], 
              StyleBox["LL",
               FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "c57d2f00-e657-4008-89cc-adcec45f3e29"],
           
           " on all sites, as one real vector), its residual (the map applied \
to the iterate, minus the iterate), the matrices whose columns are the \
differences of successive iterates and of successive residuals, the \
coefficients of the least-squares combination, the damping factor, and the \
number of the iteration"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "332d8b5c-bda8-4ad8-a2cd-815962542991"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox[
             OverscriptBox["x", "\[RightVector]"], "LL", "c"], "\", \"", 
            SubsuperscriptBox["w", "LL", "pk"], "\", \"", 
            SubsuperscriptBox[
             OverscriptBox["q", "\[RightVector]"], "LL", "pk"], "\", \"", 
            SubsuperscriptBox["\[Chi]", "LL", "pk"], "\", \"", 
            SubsuperscriptBox["s", "LL", "br"], "\", \"", 
            RowBox[{
              SubsuperscriptBox[
               TagBox[
                StyleBox[
                "Z", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
                "SL31SansSerif"], "LL", "\[PlusMinus]"], "(", 
              SubscriptBox[
               OverscriptBox["q", "\[RightVector]"], "LL"], ")"}]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"x_c w_pk q_pk chi_pk s_br Zproj\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the Gaussian wave packet of the solvers: its centre, its width \
(the standard deviation of its density), its central momentum, its \
8-component spinor (the projection of a reference spinor of definite spin and \
isospin on the chosen branch at the central momentum), the sign ",
           Cell[BoxData[
            FormBox[
             RowBox[{"\[PlusMinus]", "1"}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "2e4ffeb7-72d2-4565-99b5-8f826238a7b4"],
           " of the chosen branch ",
           Cell[BoxData[
            FormBox[
             RowBox[{"\[PlusMinus]", 
              SubsuperscriptBox["\[CurlyEpsilon]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["lat",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "14ef4a94-b252-40cd-85b5-d0434d43075e"],
           ", and the projectors ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              FractionBox["1", "2"], 
              RowBox[{"(", 
               RowBox[{
                SubscriptBox[
                 StyleBox["1",
                  FontFamily->"Helvetica",
                  FontSlant->"Plain"], "4"], "\[PlusMinus]", 
                SubsuperscriptBox[
                 StyleBox["h",
                  FontFamily->"Helvetica",
                  FontSlant->"Plain"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["lat",
                  FontSlant->"Plain"]], 
                RowBox[{"(", 
                 SubscriptBox[
                  OverscriptBox[
                   StyleBox["q", "TI"], "\[RightVector]"], 
                  StyleBox["LL",
                   FontSlant->"Plain"]], ")"}], "/", 
                SubsuperscriptBox["\[CurlyEpsilon]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["lat",
                  FontSlant->"Plain"]], 
                RowBox[{"(", 
                 SubscriptBox[
                  OverscriptBox[
                   StyleBox["q", "TI"], "\[RightVector]"], 
                  StyleBox["LL",
                   FontSlant->"Plain"]], ")"}]}], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "914185ba-9fb6-4050-90ef-a7dc95b9458d"],
           
           " on the two branches of the free lattice operator at the momentum \
",
           Cell[BoxData[
            FormBox[
             SubscriptBox[
              OverscriptBox[
               StyleBox["q", "TI"], "\[RightVector]"], 
              StyleBox["LL",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "20eba80b-e80c-4bbb-828a-96c9d0ff3c63"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "b36a3834-db0a-4e3f-942c-43086bfe4e55"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            RowBox[{
              SubsuperscriptBox[
               TagBox[
                StyleBox[
                "h", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
                "SL31SansSerif"], "LL", "lat"], "(", 
              SubscriptBox[
               OverscriptBox["q", "\[RightVector]"], "LL"], ")"}]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"h_lat_q\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the ",
           Cell[BoxData[
            FormBox[
             RowBox[{"4", "\[Times]", "4"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "9b777cd7-c035-445a-9c6e-8251c03fd0e7"],
           
           " matrix of the free lattice operator (without isospin) on the \
plane wave ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              StyleBox["exp",
               FontSlant->"Plain"], 
              RowBox[{"(", 
               RowBox[{
                StyleBox["i", "TI"], 
                SubscriptBox[
                 OverscriptBox[
                  StyleBox["q", "TI"], "\[RightVector]"], 
                 StyleBox["LL",
                  FontSlant->"Plain"]], "\[CenterDot]", 
                SubscriptBox[
                 OverscriptBox[
                  StyleBox["x", "TI"], "\[RightVector]"], 
                 StyleBox["LL",
                  FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "5e200e34-2d9a-4230-9a64-2e555edf2864"],
           ": ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              UnderscriptBox["\[Sum]", 
               StyleBox["j", "TI"],
               LimitsPositioning->True], "\[ThinSpace]", 
              SubsuperscriptBox["\[Alpha]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["j", "TI"]], "\[ThinSpace]", 
              StyleBox["sin",
               FontSlant->"Plain"], 
              RowBox[{"(", 
               RowBox[{
                SubsuperscriptBox[
                 StyleBox["q", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["j", "TI"]], 
                SubsuperscriptBox["\[ScriptL]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["x",
                  FontSlant->"Plain"]]}], ")"}], "/", 
              SubsuperscriptBox["\[ScriptL]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["x",
                FontSlant->"Plain"]], "+", 
              SubscriptBox["\[Beta]", 
               StyleBox["LL",
                FontSlant->"Plain"]], 
              RowBox[{"(", 
               RowBox[{
                SubscriptBox[
                 StyleBox["m", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"]], "+", 
                RowBox[{"(", 
                 RowBox[{
                  SubsuperscriptBox[
                   StyleBox["r", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"], 
                   StyleBox["W",
                    FontSlant->"Plain"]], "/", 
                  SubsuperscriptBox["\[ScriptL]", 
                   StyleBox["LL",
                    FontSlant->"Plain"], 
                   StyleBox["x",
                    FontSlant->"Plain"]]}], ")"}], "\[ThinSpace]", 
                UnderscriptBox["\[Sum]", 
                 StyleBox["j", "TI"],
                 LimitsPositioning->True], 
                RowBox[{"(", 
                 RowBox[{"1", "-", 
                  StyleBox["cos",
                   FontSlant->"Plain"], 
                  RowBox[{"(", 
                   RowBox[{
                    SubsuperscriptBox[
                    StyleBox["q", "TI"], 
                    StyleBox["LL",
                    FontSlant->"Plain"], 
                    StyleBox["j", "TI"]], 
                    SubsuperscriptBox["\[ScriptL]", 
                    StyleBox["LL",
                    FontSlant->"Plain"], 
                    StyleBox["x",
                    FontSlant->"Plain"]]}], ")"}]}], ")"}]}], ")"}]}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "4399557f-3f14-485a-91af-41386256b131"],
           ", the sums over the active directions; its square is ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox["\[CurlyEpsilon]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["lat",
                FontSlant->"Plain"]], 
              SuperscriptBox[
               RowBox[{"(", 
                SubscriptBox[
                 OverscriptBox[
                  StyleBox["q", "TI"], "\[RightVector]"], 
                 StyleBox["LL",
                  FontSlant->"Plain"]], ")"}], "2"]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "4feebe75-59e0-4e70-80e2-26116278e88c"],
           " times ",
           Cell[BoxData[
            FormBox[
             SubscriptBox[
              StyleBox["1",
               FontFamily->"Helvetica",
               FontSlant->"Plain"], "4"], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "d8c9c999-c553-4bcb-ac1c-11c43232e02d"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "1983b586-5b60-4a30-8478-af0332957656"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox[
             OverscriptBox["v", "\[RightVector]"], "LL", "g"], "\", \"", 
            SubsuperscriptBox[
             OverscriptBox["v", "_"], "LL", "g"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"v_g v_g_mean\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the group velocity, the gradient of ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[CurlyEpsilon]", 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["lat",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "425b855d-b3bc-4915-84de-2d12e8efdc58"],
           " with respect to ",
           Cell[BoxData[
            FormBox[
             SubscriptBox[
              OverscriptBox[
               StyleBox["q", "TI"], "\[RightVector]"], 
              StyleBox["LL",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "06f9a685-222c-4049-9cdc-95212348e3aa"],
           ", and its mean over the distribution of momenta of a wave packet"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "3f31b4fd-de03-4b96-9a61-4e7a7783bab5"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["\[ScriptL]", "LL", "B"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"l_B\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the magnetic length ",
           Cell[BoxData[
            FormBox[
             SuperscriptBox[
              RowBox[{"\[LeftBracketingBar]", 
               SubsuperscriptBox[
                StyleBox["B", "TI"], 
                StyleBox["LL",
                 FontSlant->"Plain"], "\[UpArrow]"], 
               "\[RightBracketingBar]"}], 
              RowBox[{
               RowBox[{"-", "1"}], "/", "2"}]], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "efd99dac-5b61-4a92-8e54-5b8bf6e34966"],
           " of the isospin-up component in a constant magnetic field"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "a9d45f1e-8ef7-42fe-81b7-a0167635c73e"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["G", "LL", "\[Prime]"], "\", \"", 
            SubscriptBox[
             OverscriptBox["\[CapitalDelta]", "_"], "LL"], "\", \"", 
            SubsuperscriptBox["\[Omega]", "LL", "H"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"G_quench Delta_mean omega_H\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the coupling after a quench (the coupling is changed from ",
           Cell[BoxData[
            FormBox[
             SubscriptBox[
              StyleBox["G", "TI"], 
              StyleBox["LL",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "703d9fbd-ac58-4dc4-8578-6a7cddd101e5"],
           " to ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["G", "TI"], 
              StyleBox["LL",
               FontSlant->"Plain"], "\[Prime]"], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "86e254fe-012d-4749-b12f-99625f18d5ec"],
           " at ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["x", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], "0"], "\[LongEqual]", "0"}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "e0e2d553-430e-492a-8e43-6bc955c78f1c"],
           "); the mean over the time of the gap ",
           Cell[BoxData[
            FormBox[
             RowBox[{"\[LeftBracketingBar]", 
              SubscriptBox[
               OverscriptBox[
                StyleBox["d", "TI"], "\[RightVector]"], 
               StyleBox["LL",
                FontSlant->"Plain"]], "\[RightBracketingBar]"}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "200d61ad-d2fc-412c-a2e2-1c34d6ec8f12"],
           
           " after the quench; and the angular frequency of the amplitude \
oscillation of the pair field (the amplitude mode, the analogue of the Higgs \
boson)"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "4453203f-2343-453d-bff5-6771fdfdfbd8"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["u", "LL", "Bl"], "\", \"", 
            SubsuperscriptBox["v", "LL", "Bl"], "\", \"", 
            SubsuperscriptBox[
             OverscriptBox["b", "\[RightVector]"], "LL", "Bl"], "\", \"", 
            SubsuperscriptBox[
             OverscriptBox["h", "\[RightVector]"], "LL", "Bl"], "\", \"", 
            SubsuperscriptBox[
             OverscriptBox["b", "\[RightVector]"], "LL", "fl"], "\", \"", 
            SubsuperscriptBox["\[CapitalDelta]", "LL", "fl"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"u_Bl v_Bl b_Bl h_Bl b_fl Delta_fl\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the two complex coefficients of a state of the plane spanned by \
the particle vector ",
           Cell[BoxData[
            FormBox[
             RowBox[{"(", 
              RowBox[{
               SubsuperscriptBox["\[Chi]", 
                StyleBox["LL",
                 FontSlant->"Plain"], 
                StyleBox["pw",
                 FontSlant->"Plain"]], ",", "0"}], ")"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "1b419f59-a9fd-49a6-8596-9ac13d3b8d95"],
           " and the hole vector ",
           Cell[BoxData[
            FormBox[
             RowBox[{"(", 
              RowBox[{"0", ",", 
               SubsuperscriptBox[
                StyleBox["K",
                 FontFamily->"Helvetica",
                 FontSlant->"Plain"], 
                StyleBox["LL",
                 FontSlant->"Plain"], "3"], 
               SubsuperscriptBox["\[Chi]", 
                StyleBox["LL",
                 FontSlant->"Plain"], 
                StyleBox["pw",
                 FontSlant->"Plain"]]}], ")"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "f04b49c2-a096-4f2c-b6b9-240f3394df19"],
           " of a plane wave, on which the mean-field operator acts as the ",
           Cell[BoxData[
            FormBox[
             RowBox[{"2", "\[Times]", "2"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "b8f54d54-1af6-48bb-9c4c-0849836d44e2"],
           " matrix with the rows ",
           Cell[BoxData[
            FormBox[
             RowBox[{"(", 
              RowBox[{
               RowBox[{"\[PlusMinus]", 
                SubscriptBox["\[CurlyEpsilon]", 
                 StyleBox["LL",
                  FontSlant->"Plain"]]}], "-", 
               SubscriptBox["\[Mu]", 
                StyleBox["LL",
                 FontSlant->"Plain"]], ",", 
               SubscriptBox["\[CapitalDelta]", 
                StyleBox["LL",
                 FontSlant->"Plain"]]}], ")"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "1e08f93e-a77d-49af-9825-6c756fede026"],
           " and ",
           Cell[BoxData[
            FormBox[
             RowBox[{"(", 
              RowBox[{
               SubscriptBox["\[CapitalDelta]", 
                StyleBox["LL",
                 FontSlant->"Plain"]], ",", 
               RowBox[{"-", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"\[PlusMinus]", 
                   SubscriptBox["\[CurlyEpsilon]", 
                    StyleBox["LL",
                    FontSlant->"Plain"]]}], "-", 
                  SubscriptBox["\[Mu]", 
                   StyleBox["LL",
                    FontSlant->"Plain"]]}], ")"}]}]}], ")"}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "71a492ce-088b-4bfa-9be1-bf5b0b84e2df"],
           "; the Bloch vector of that state, the expectation values of ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[Sigma]", "1", 
              StyleBox["LL",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "e47a9d58-fb62-4f5f-a5b2-f75a42cb90a9"],
           ", ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[Sigma]", "2", 
              StyleBox["LL",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "29b02b93-2c6d-4578-82db-d9dc89241ea2"],
           ", ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[Sigma]", "3", 
              StyleBox["LL",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "2574f930-d57a-488f-8d49-1208f0b0dc95"],
           " in it, and the vector of the coefficients of that ",
           Cell[BoxData[
            FormBox[
             RowBox[{"2", "\[Times]", "2"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "217f216e-9088-4b1b-9d0b-f33225f05889"],
           
           " matrix in the Pauli matrices, about which it precesses; their \
small deviations from the ground state in the linearized equations: the \
deviation of the Bloch vector and of the gap"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "3ad1599b-c25d-4f47-bece-4b0556feac04"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox[
             TagBox[
              StyleBox["K", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
              "SL31SansSerif"], "LL", "g"], "\", \"", 
            SubsuperscriptBox[
             TagBox[
              StyleBox["K", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
              "SL31SansSerif"], "LL", 
             RowBox[{"g", "\[Prime]"}]]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"Kgen Kgen'\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "two general pair matrices: complex ",
           Cell[BoxData[
            FormBox[
             RowBox[{"8", "\[Times]", "8"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "d8b80629-bd6d-4c4b-8d58-ab77df98872d"],
           " matrices with which ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox["\[CapitalPsi]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["T", "TI"]], 
              SubsuperscriptBox[
               StyleBox["K",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["g",
                FontSlant->"Plain"]], 
              SubscriptBox["\[CapitalPsi]", 
               StyleBox["LL",
                FontSlant->"Plain"]], "\[LongEqual]", 
              UnderscriptBox["\[Sum]", 
               RowBox[{
                StyleBox["k", "TI"], ",", 
                SuperscriptBox[
                 StyleBox["k", "TI"], "\[Prime]"]}],
               LimitsPositioning->True], 
              SubscriptBox[
               RowBox[{"(", 
                SubsuperscriptBox[
                 StyleBox["K",
                  FontFamily->"Helvetica",
                  FontSlant->"Plain"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["g",
                  FontSlant->"Plain"]], ")"}], 
               RowBox[{
                StyleBox["k", "TI"], 
                SuperscriptBox[
                 StyleBox["k", "TI"], "\[Prime]"]}]], 
              SubscriptBox["\[CapitalPsi]", 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["k", "TI"]}]], 
              SubscriptBox["\[CapitalPsi]", 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                SuperscriptBox[
                 StyleBox["k", "TI"], "\[Prime]"]}]]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "5f3682a7-279b-40b0-8bfe-f303c208231e"],
           
           " annihilates two spinor charges at one point; only the \
antisymmetric part of a pair matrix contributes, because the components of ",
           Cell[BoxData[
            FormBox[
             SubscriptBox["\[CapitalPsi]", 
              StyleBox["LL",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "e84ed4d6-e9cf-408b-b439-18fdedee3ff3"],
           " anticommute"
