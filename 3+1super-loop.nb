                    StyleBox["y", FontSlant -> "Bold"]}], ")"}]}], 
                  TraditionalForm], "\" of a Lie algebra, where \"", 
                 FormBox[
                  RowBox[{
                    StyleBox["ad", FontSlant -> "Plain"], " ", 
                    StyleBox["x", FontSlant -> "Bold"]}], TraditionalForm], 
                 "\" is the matrix of the map \"", 
                 FormBox[
                  RowBox[{
                    StyleBox["y", FontSlant -> "Bold"], "\[RightTeeArrow]", 
                    RowBox[{"[", 
                    RowBox[{
                    StyleBox["x", FontSlant -> "Bold"], ",", 
                    StyleBox["y", FontSlant -> "Bold"]}], "]"}]}], 
                  TraditionalForm]},
                "RowDefault"],
               StripOnInput->False,
               FontFamily->"Source Sans Pro",
               FontSize->9.5],
              ImageSize->290]}
           },
           AutoDelete->False,
           GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Top}}},
