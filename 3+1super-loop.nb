Cell[CellGroupData[{

Cell["\<\
GS-3 and GS-4: finite transformations, isospin and the pair matrices\
\>", "Subsection",ExpressionUUID->"a8035de4-086f-4abc-90f4-03267f2cd628"],

Cell[TextData[{
 "GS-3 is the change of representation of the gauge group ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SL", "TI"], 
    RowBox[{"(", 
     RowBox[{"2", ",", 
      StyleBox["\[DoubleStruckCapitalC]",
       FontSlant->"Plain"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "350ea037-0aba-4690-8d97-39cfd973abe2"],
 ": for a unit bi-quaternion ",
 Cell[BoxData[
  FormBox[
   StyleBox["g",
    FontWeight->"Bold",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b9e449f9-93d1-4d4e-9c7d-8c934f44975a"],
 " the spinor matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["S",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[LongEqual]", 
    StyleBox["diag",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      RowBox[{"(", 
       OverscriptBox[
        StyleBox["g",
         FontWeight->"Bold",
         FontSlant->"Plain"], "~"], ")"}], ",", 
      SubscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      RowBox[{"(", 
       StyleBox["g",
        FontWeight->"Bold",
        FontSlant->"Plain"], ")"}]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6f354d6d-93bd-47de-bac7-7803146c8f78"],
 ", with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], "~"], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      SuperscriptBox[
       StyleBox["g",
        FontWeight->"Bold",
        FontSlant->"Plain"], "\[Dagger]"], ")"}], 
     RowBox[{"-", "1"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "21010e69-8c51-4a21-ae10-14937b08edd9"],
 " and so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     OverscriptBox[
      StyleBox["g",
       FontWeight->"Bold",
       FontSlant->"Plain"], "~"], ")"}], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["M", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"]], 
       SuperscriptBox[
        RowBox[{"(", 
         StyleBox["g",
          FontWeight->"Bold",
          FontSlant->"Plain"], ")"}], "\[Dagger]"]}], ")"}], 
     RowBox[{"-", "1"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3e721505-1030-498c-851c-ad1800c7b4d4"],
 ", satisfies ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["S",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      StyleBox["g",
       FontWeight->"Bold",
       FontSlant->"Plain"], ")"}], 
     RowBox[{"-", "1"}]], 
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p", "TI"]], 
    SubscriptBox[
     StyleBox["S",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", 
     SuperscriptBox[
      StyleBox["p", "TI"], "\[Prime]"],
     LimitsPositioning->True], 
    SubscriptBox[
     RowBox[{"[", 
      RowBox[{
       SubscriptBox[
        StyleBox["L",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["LL",
         FontSlant->"Plain"]], 
       RowBox[{"(", 
        StyleBox["g",
         FontWeight->"Bold",
         FontSlant->"Plain"], ")"}]}], "]"}], 
     RowBox[{
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], 
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     SuperscriptBox[
      StyleBox["p", "TI"], "\[Prime]"]]}], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cebb7551-5834-4363-a251-1c47dd624a77"],
 " with the real Lorentz matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"[", 
      RowBox[{
       SubscriptBox[
        StyleBox["L",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["LL",
         FontSlant->"Plain"]], 
       RowBox[{"(", 
        StyleBox["g",
         FontWeight->"Bold",
         FontSlant->"Plain"], ")"}]}], "]"}], 
     RowBox[{
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], "\[LongEqual]", 
    FractionBox["1", "2"], 
    StyleBox["Re",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["\[Sigma]", 
       StyleBox["p", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      SubscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      RowBox[{"(", 
       StyleBox["g",
        FontWeight->"Bold",
        FontSlant->"Plain"], ")"}], 
      SubsuperscriptBox["\[Sigma]", 
       SuperscriptBox[
        StyleBox["p", "TI"], "\[Prime]"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      SubscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      SuperscriptBox[
       RowBox[{"(", 
        StyleBox["g",
         FontWeight->"Bold",
         FontSlant->"Plain"], ")"}], "\[Dagger]"]}], ")"}]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "465106e3-7f83-44c8-8e89-1e1c37d0f197"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["S",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p", "TI"]], 
    RowBox[{"[", 
     StyleBox["f",
      FontWeight->"Bold",
      FontSlant->"Plain"], "]"}], 
    SubscriptBox[
     StyleBox["S",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      StyleBox["g",
       FontWeight->"Bold",
       FontSlant->"Plain"], ")"}], 
     RowBox[{"-", "1"}]], "\[LongEqual]", 
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p", "TI"]], 
    RowBox[{"[", 
     RowBox[{
      OverscriptBox[
       StyleBox["g",
        FontWeight->"Bold",
        FontSlant->"Plain"], "~"], 
      StyleBox["f",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      SuperscriptBox[
       OverscriptBox[
        StyleBox["g",
         FontWeight->"Bold",
         FontSlant->"Plain"], "~"], "\[Dagger]"]}], "]"}]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0c8fa830-589d-4e91-a673-1ebc73d8aabc"],
 " for random Hermitian frames ",
 Cell[BoxData[
  FormBox[
   StyleBox["f",
    FontWeight->"Bold",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9ceb1b4e-77e6-4152-a099-74faf4fd23dd"],
 ". GS-4 checks the isospin algebra, the antisymmetry and the invariance of \
the pair matrices ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0504f324-adc5-4d61-a2de-2c6de9737e49"],
 ", and that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["T", "TI"]], 
    SubsuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Iota]"], 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9fda3559-04a0-4f65-a4c4-3683594b8a74"],
 " for a commuting (c-number) spinor, for which the antisymmetric matrix \
gives zero."
}], "Text",ExpressionUUID->"d98f1485-17b6-49c6-97e9-cee606a9fc30"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"GS", "-", "3"}], ":", " ", 
      RowBox[{
       RowBox[{"200", " ", "random", " ", "unit", " ", "bi"}], "-", 
       "quaternions"}]}], ";", " ", 
     RowBox[{"for", " ", "each"}]}], ",", " ", 
    RowBox[{"a", " ", "random", " ", "Hermitian", " ", "frame", " ", 
     RowBox[{"(", 
      RowBox[{
      "the", " ", "random", " ", "numbers", " ", "in", " ", "the", " ", 
       "order", " ", "of", " ", "t2_fields"}], ")"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"worst3", " ", "=", " ", "0."}], ";", " ", 
    RowBox[{"worst3b", " ", "=", " ", "0."}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "mg", ",", " ", "s4", ",", " ", "s4i", ",", " ", "l", ",", " ", "f", 
          ",", " ", "gf", ",", " ", "mgt", ",", " ", "f2", ",", " ", "gf2"}], 
         "}"}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{"mg", " ", "=", " ", 
          RowBox[{"t2randSL2C", "[", "]"}]}], ";", "\n", "   ", 
         RowBox[{"s4", " ", "=", " ", 
          RowBox[{"t2spinRep", "[", "mg", "]"}]}], ";", "\n", "   ", 
         RowBox[{"s4i", " ", "=", " ", 
          RowBox[{"ArrayFlatten", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"ConjugateTranspose", "[", "mg", "]"}], ",", " ", 
               "0"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"0", ",", " ", 
               RowBox[{"t2inv2", "[", "mg", "]"}]}], "}"}]}], "}"}], "]"}]}], 
         ";", "\n", "   ", 
         RowBox[{"worst3", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"worst3", ",", " ", 
            RowBox[{"fro", "[", 
             RowBox[{
              RowBox[{"s4", " ", ".", " ", "s4i"}], " ", "-", " ", 
              RowBox[{"IdentityMatrix", "[", "4", "]"}]}], "]"}]}], "]"}]}], ";",
          "\n", "   ", 
         RowBox[{"l", " ", "=", " ", 
          RowBox[{"t2lmat", "[", "mg", "]"}]}], ";", "\n", "   ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{"worst3", " ", "=", " ", 
            RowBox[{"Max", "[", 
             RowBox[{"worst3", ",", " ", 
              RowBox[{"fro", "[", 
               RowBox[{
                RowBox[{"s4i", " ", ".", " ", 
                 RowBox[{"g", "[", 
                  RowBox[{"[", 
                   RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}], " ", ".", 
                 " ", "s4"}], " ", "-", " ", 
                RowBox[{"Sum", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"l", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"p", " ", "+", " ", "1"}], ",", " ", 
                    RowBox[{"q", " ", "+", " ", "1"}]}], "]"}], "]"}], " ", 
                   RowBox[{"g", "[", 
                    RowBox[{"[", 
                    RowBox[{"q", " ", "+", " ", "1"}], "]"}], "]"}]}], ",", 
                  " ", 
                  RowBox[{"{", 
                   RowBox[{"q", ",", " ", "0", ",", " ", "3"}], "}"}]}], 
                 "]"}]}], "]"}]}], "]"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}], ";", 
         "\n", "   ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"the", " ", "frame", " ", "f_p"}], " ", "=", " ", 
            RowBox[{
             RowBox[{"x0", " ", "e0"}], " ", "+", " ", 
             RowBox[{"i", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"x1", " ", "e1"}], " ", "+", " ", 
                RowBox[{"x2", " ", "e2"}], " ", "+", " ", 
                RowBox[{"x3", " ", "e3"}]}], ")"}]}]}]}], ",", " ", 
           RowBox[{
           "real", " ", "x", " ", "drawn", " ", "p", " ", "by", " ", "p"}]}], 
          " ", "*)"}], "\n", "   ", 
         RowBox[{"f", " ", "=", " ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Module", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"x0", " ", "=", " ", 
                RowBox[{"t2Unit", "[", "]"}]}], "}"}], ",", " ", 
              RowBox[{"Prepend", "[", 
               RowBox[{
                RowBox[{"Table", "[", 
                 RowBox[{
                  RowBox[{"I", " ", 
                   RowBox[{"t2Unit", "[", "]"}]}], ",", " ", 
                  RowBox[{"{", "3", "}"}]}], "]"}], ",", " ", "x0"}], "]"}]}],
              "]"}], ",", " ", 
            RowBox[{"{", "4", "}"}]}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"gf", " ", "=", " ", 
          RowBox[{"t2gammasFromFrame", "[", "f", "]"}]}], ";", "\n", "   ", 
         RowBox[{"mgt", " ", "=", " ", 
          RowBox[{"t2inv2", "[", 
           RowBox[{"ConjugateTranspose", "[", "mg", "]"}], "]"}]}], ";", "\n",
          "   ", 
         RowBox[{"f2", " ", "=", " ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"With", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"x", " ", "=", " ", 
                RowBox[{"t2coords", "[", 
                 RowBox[{"mgt", " ", ".", " ", 
                  RowBox[{"t2mq", "[", 
                   RowBox[{"f", "[", 
                    RowBox[{"[", "p", "]"}], "]"}], "]"}], " ", ".", " ", 
                  RowBox[{"ConjugateTranspose", "[", "mgt", "]"}]}], "]"}]}], 
               "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"x", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
                RowBox[{"I", " ", 
                 RowBox[{"x", "[", 
                  RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", 
                RowBox[{"I", " ", 
                 RowBox[{"x", "[", 
                  RowBox[{"[", "3", "]"}], "]"}]}], ",", " ", 
                RowBox[{"I", " ", 
                 RowBox[{"x", "[", 
                  RowBox[{"[", "4", "]"}], "]"}]}]}], "}"}]}], "]"}], ",", 
            " ", 
            RowBox[{"{", 
             RowBox[{"p", ",", " ", "4"}], "}"}]}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"gf2", " ", "=", " ", 
          RowBox[{"t2gammasFromFrame", "[", "f2", "]"}]}], ";", "\n", "   ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{"worst3b", " ", "=", " ", 
            RowBox[{"Max", "[", 
             RowBox[{"worst3b", ",", " ", 
              RowBox[{"fro", "[", 
               RowBox[{
                RowBox[{"s4", " ", ".", " ", 
                 RowBox[{"gf", "[", 
                  RowBox[{"[", "p", "]"}], "]"}], " ", ".", " ", "s4i"}], " ",
                 "-", " ", 
                RowBox[{"gf2", "[", 
                 RowBox[{"[", "p", "]"}], "]"}]}], "]"}]}], "]"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"p", ",", " ", "4"}], "}"}]}], "]"}]}]}], "]"}], ",", 
      "\n", "  ", 
      RowBox[{"{", "200", "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<GS-3\>\"", ",", 
     " ", "\"\<the gauge group SL(2,C) as a change of representation: \
Sspin^-1 gamma^p Sspin = sum Lmat[p][q] gamma^q and Sspin gamma^p[f] Sspin^-1 \
= gamma^p[gLt f gLt^dag] for 200 random gL and random Hermitian frames \
(tolerance 1e-10)\>\"", ",", "\n", "  ", 
     RowBox[{
      RowBox[{"worst3", " ", "<", " ", "1*^-10"}], " ", "&&", " ", 
      RowBox[{"worst3b", " ", "<", " ", "1*^-10"}]}], ",", " ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<largest deviations \>\"", ",", " ", "worst3", ",", 
        " ", "\"\< and \>\"", ",", " ", "worst3b", ",", 
        " ", "\"\< (original: 5.8e-14 and 6.6e-14)\>\""}], "}"}], "]"}]}], 
    "]"}]}]}]], "Input",
 CellLabel->
  "In[354]:=",ExpressionUUID->"793cc29f-59e4-4fa4-b59a-e60e79259e4a"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   StyleBox["\<\"PASS  \"\>",
    StripOnInput->False,
    LineColor->RGBColor[0, 
      Rational[2, 3], 0],
    FrontFaceColor->RGBColor[0, 
      Rational[2, 3], 0],
    BackFaceColor->RGBColor[0, 
      Rational[2, 3], 0],
    GraphicsColor->RGBColor[0, 
      Rational[2, 3], 0],
    FontWeight->Bold,
    FontColor->RGBColor[0, 
      Rational[2, 3], 0]], "\[InvisibleSpace]", "\<\"GS-3\"\>", 
   "\[InvisibleSpace]", "\<\": \"\>", 
   "\[InvisibleSpace]", "\<\"the gauge group SL(2,C) as a change of \
representation: Sspin^-1 gamma^p Sspin = sum Lmat[p][q] gamma^q and Sspin \
gamma^p[f] Sspin^-1 = gamma^p[gLt f gLt^dag] for 200 random gL and random \
Hermitian frames (tolerance 1e-10)\"\>", "\[InvisibleSpace]", 
   TemplateBox[{"\"  -- \"", 
     TemplateBox[{
      "\"largest deviations \"", "5.1331770670859876`*^-14", "\" and \"", 
       "7.214775591174576`*^-14", "\" (original: 5.8e-14 and 6.6e-14)\""}, 
      "RowDefault"]},
    "RowDefault"]}],
  SequenceForm[
   Style["PASS  ", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0]], "GS-3", ": ", 
   "the gauge group SL(2,C) as a change of representation: Sspin^-1 gamma^p \
Sspin = sum Lmat[p][q] gamma^q and Sspin gamma^p[f] Sspin^-1 = gamma^p[gLt f \
gLt^dag] for 200 random gL and random Hermitian frames (tolerance 1e-10)", 
   Row[{"  -- ", 
     Row[{
      "largest deviations ", 5.1331770670859876`*^-14, " and ", 
