                    FontWeight->"Bold",
                    FontSlant->"Plain"]}], ")"}], "\[LongEqual]", 
                  StyleBox["tr",
                   FontSlant->"Plain"], 
                  RowBox[{"(", 
                   RowBox[{
                    StyleBox["ad",
                    FontSlant->"Plain"], "\[ThinSpace]", 
                    StyleBox["x",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], "\[ThinSpace]", 
                    StyleBox["ad",
                    FontSlant->"Plain"], "\[ThinSpace]", 
