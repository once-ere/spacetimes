Cell[TextData[{
 "S-13, the kinds that are not symbolized. The imaginary unit ",
 Cell[BoxData[
  FormBox[
   StyleBox["i", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "49aa2f06-1034-45d3-bc56-1813aba64cef"],
 " is the Wolfram symbol ",
 StyleBox["I",
  FontFamily->"Source Code Pro"],
 "; the number sets ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[DoubleStruckCapitalR]",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bef902e3-82b3-4548-9ac3-2f7e42229a66"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[DoubleStruckCapitalC]",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8909e898-f39d-41b1-beb9-077f2079534a"],
 " are the Wolfram domains ",
 StyleBox["Reals",
  FontFamily->"Source Code Pro"],
 " and ",
 StyleBox["Complexes",
  FontFamily->"Source Code Pro"],
 " (which the Wolfram Language prints as double-struck letters); the \
operators correspond to Wolfram functions: tr is ",
 StyleBox["Tr",
  FontFamily->"Source Code Pro"],
 ", det is ",
 StyleBox["Det",
  FontFamily->"Source Code Pro"],
 ", diag is ",
 StyleBox["DiagonalMatrix",
  FontFamily->"Source Code Pro"],
 ", Re and Im are ",
 StyleBox["Re",
  FontFamily->"Source Code Pro"],
 " and ",
 StyleBox["Im",
  FontFamily->"Source Code Pro"],
 ", the tensor product ",
 Cell[BoxData[
  FormBox["\[CircleTimes]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8c61218e-81fe-42db-a413-40955bf9338d"],
 " is ",
 StyleBox["KroneckerProduct",
  FontFamily->"Source Code Pro"],
 ", the transpose ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["", 
    StyleBox["T", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6ce2205a-192d-4af5-b0c7-45fec5daa07d"],
 " is ",
 StyleBox["Transpose",
  FontFamily->"Source Code Pro"],
 ". The test checks each correspondence on the Pauli matrices."
}], "Text",ExpressionUUID->"0defb365-1d48-4e6a-af78-964308925930"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"p1", " ", "=", " ", 
   RowBox[{"pauliValues", "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";", " ", 
  RowBox[{"p2", " ", "=", " ", 
   RowBox[{"pauliValues", "[", 
    RowBox[{"[", "2", "]"}], "]"}]}], ";", " ", 
  RowBox[{"p3", " ", "=", " ", 
   RowBox[{"pauliValues", "[", 
    RowBox[{"[", "3", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"correspondences", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"I", "^", "2"}], " ", "==", " ", 
      RowBox[{"-", "1"}]}], ",", " ", 
     RowBox[{"Element", "[", 
      RowBox[{
       RowBox[{"Sqrt", "[", "2", "]"}], ",", " ", "Reals"}], "]"}], ",", " ", 
     
     RowBox[{"Element", "[", 
      RowBox[{"I", ",", " ", "Complexes"}], "]"}], ",", " ", 
     RowBox[{"!", " ", 
      RowBox[{"Element", "[", 
       RowBox[{"I", ",", " ", "Reals"}], "]"}]}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"Tr", "[", "p3", "]"}], " ", "==", " ", "0"}], ",", " ", 
     RowBox[{
      RowBox[{"Det", "[", "p1", "]"}], " ", "==", " ", 
      RowBox[{"-", "1"}]}], ",", " ", 
     RowBox[{
      RowBox[{"DiagonalMatrix", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", 
         RowBox[{"-", "1"}]}], "}"}], "]"}], " ", "==", " ", "p3"}], ",", " ", 
     RowBox[{
      RowBox[{"Re", "[", "p2", "]"}], " ", "==", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}]}], ",", " ", 
     RowBox[{
      RowBox[{"Im", "[", "p2", "]"}], " ", "==", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", 
          RowBox[{"-", "1"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "0"}], "}"}]}], "}"}]}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"p1", ",", " ", "p3"}], "]"}], " ", ".", " ", 
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"p1", ",", " ", "p3"}], "]"}]}], " ", "==", " ", 
      RowBox[{"IdentityMatrix", "[", "4", "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{"Transpose", "[", "p2", "]"}], " ", "==", " ", 
      RowBox[{"-", "p2"}]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-13\>\"", ",", 
    " ", "\"\<the imaginary unit, the number sets and the operators \
correspond to I, Reals, Complexes, Tr, Det, DiagonalMatrix, Re, Im, \
KroneckerProduct, Transpose\>\"", ",", "\n", "  ", 
    RowBox[{"And", " ", "@@", " ", "correspondences"}], ",", " ", 
    "correspondences"}], "]"}], ";"}]}], "Input",
 CellLabel->
  "In[208]:=",ExpressionUUID->"0739b65c-8695-4ce3-9006-f0079de904c8"],

