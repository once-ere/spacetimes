              StripOnInput->False,
              FontFamily->"Source Sans Pro",
              FontWeight->Bold]},
            {
             PaneBox[
              
              TemplateBox[{
               "\[DoubleStruckCapitalH]", "\", \"", "\[DoubleStruckCapitalO]"},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              StyleBox["\<\"H O\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[
              StyleBox[
               
               TemplateBox[{
                "\"the quaternions and the octonions: the real combinations \
of \"", 
                 FormBox[
                  RowBox[{
                    SubscriptBox[
                    StyleBox["e", FontSlant -> "Bold"], "0"], ",", 
                    "\[Ellipsis]", ",", 
                    SubscriptBox[
                    StyleBox["e", FontSlant -> "Bold"], "3"]}], 
                  TraditionalForm], "\" and of \"", 
                 FormBox[
                  RowBox[{
                    SubscriptBox[
                    StyleBox["e", FontSlant -> "Bold"], "0"], ",", 
                    "\[Ellipsis]", ",", 
                    SubscriptBox[
                    StyleBox["e", FontSlant -> "Bold"], "7"]}], 
                  TraditionalForm], "\"; \"", 
                 FormBox[
                  RowBox[{"Im", " ", 
                    StyleBox["H", FontSlant -> "Plain"]}], TraditionalForm], 
                 "\" and \"", 
                 FormBox[
                  RowBox[{"Im", " ", 
                    StyleBox["O", FontSlant -> "Plain"]}], TraditionalForm], 
                 "\" are their imaginary parts, the real combinations of \"", 
                 
                 FormBox[
                  RowBox[{
                    SubscriptBox[
                    StyleBox["e", FontSlant -> "Bold"], "1"], ",", 
                    SubscriptBox[
                    StyleBox["e", FontSlant -> "Bold"], "2"], ",", 
                    SubscriptBox[
                    StyleBox["e", FontSlant -> "Bold"], "3"]}], 
                  TraditionalForm], "\" and of \"", 
                 FormBox[
                  RowBox[{
                    SubscriptBox[
                    StyleBox["e", FontSlant -> "Bold"], "1"], ",", 
                    "\[Ellipsis]", ",", 
                    SubscriptBox[
                    StyleBox["e", FontSlant -> "Bold"], "7"]}], 
                  TraditionalForm], 
                 "\" (plain text `Im H`, `Im O`; `C (x) H` is \"", 
                 FormBox[
                  RowBox[{
                    StyleBox["C", FontSlant -> "Plain"], "\[CircleTimes]", 
                    StyleBox["H", FontSlant -> "Plain"]}], TraditionalForm], 
                 "\", the bi-quaternions)\""},
                "RowDefault"],
               StripOnInput->False,
               FontFamily->"Source Sans Pro",
               FontSize->9.5],
              ImageSize->290]},
            {
             PaneBox[
              TemplateBox[{
                SubscriptBox["\[DoubleStruckCapitalB]", "LL"]},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              StyleBox["\<\"B_LL\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[
              StyleBox[
               TemplateBox[{"\"the bi-octonions \"", 
                 FormBox[
                  RowBox[{
                    StyleBox["C", FontSlant -> "Plain"], "\[CircleTimes]", 
                    StyleBox["O", FontSlant -> "Plain"]}], TraditionalForm], 
                 "\": the complex combinations \"", 
                 FormBox[
                  RowBox[{
                    StyleBox["x", FontSlant -> "Bold"], "\[LongEqual]", 
