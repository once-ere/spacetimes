              FontWeight->Bold], 
             StyleBox["\<\"plain-text names\"\>",
              StripOnInput->False,
              FontFamily->"Source Sans Pro",
              FontWeight->Bold], 
             StyleBox["\<\"meaning\"\>",
              StripOnInput->False,
              FontFamily->"Source Sans Pro",
              FontWeight->Bold]},
            {
             PaneBox[
              TemplateBox[{
                SubsuperscriptBox["\[ScriptCapitalF]", "LL", "A"], "\", \"", 
