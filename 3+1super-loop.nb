              SubscriptBox["\"\[CapitalPsi]\"", "\"LL\""], "\")\""}, 
             "RowDefault"], "1"]}], "-", 
         RowBox[{
           SubscriptBox["\"\[Mu]\"", "\"LL\""], " ", 
           SubscriptBox["\"\[CapitalPsi]\"", 
            TemplateBox[{"\"LL,\"", "1"}, "RowDefault"]]}], "-", 
         RowBox[{
           RowBox[{"(", 
             RowBox[{
               RowBox[{
                 
                 TemplateBox[{"\"g\"", "\"LL\"", "\"F\""}, "Subsuperscript", 
                  SyntaxForm -> SubsuperscriptBox], " ", 
                 TemplateBox[{"\"A\"", 
                   TemplateBox[{"\"LL,\"", "\"0\""}, "RowDefault"], "\"F\""}, 
                  "Subsuperscript", SyntaxForm -> SubsuperscriptBox]}], "+", 
               RowBox[{
                 FractionBox["1", "2"], " ", 
                 
                 TemplateBox[{"\"g\"", "\"LL\"", "\"v\""}, "Subsuperscript", 
                  SyntaxForm -> SubsuperscriptBox], " ", 
                 TemplateBox[{"\"A\"", 
                   TemplateBox[{"\"LL,\"", "\"0\""}, "RowDefault"], "3"}, 
                  "Subsuperscript", SyntaxForm -> SubsuperscriptBox]}]}], 
             ")"}], " ", 
           SubscriptBox["\"\[CapitalPsi]\"", 
            TemplateBox[{"\"LL,\"", "1"}, "RowDefault"]]}], "-", 
         RowBox[{
           RowBox[{"(", 
             RowBox[{
               RowBox[{
                 FractionBox["1", "2"], " ", 
                 
                 TemplateBox[{"\"g\"", "\"LL\"", "\"v\""}, "Subsuperscript", 
                  SyntaxForm -> SubsuperscriptBox], " ", 
                 TemplateBox[{"\"A\"", 
                   TemplateBox[{"\"LL,\"", "\"0\""}, "RowDefault"], "1"}, 
                  "Subsuperscript", SyntaxForm -> SubsuperscriptBox]}], "-", 
               RowBox[{
                 FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", 
                 
                 TemplateBox[{"\"g\"", "\"LL\"", "\"v\""}, "Subsuperscript", 
                  SyntaxForm -> SubsuperscriptBox], " ", 
                 TemplateBox[{"\"A\"", 
                   TemplateBox[{"\"LL,\"", "\"0\""}, "RowDefault"], "2"}, 
                  "Subsuperscript", SyntaxForm -> SubsuperscriptBox]}]}], 
             ")"}], " ", 
           SubscriptBox["\"\[CapitalPsi]\"", 
            TemplateBox[{"\"LL,\"", "2"}, "RowDefault"]]}], "+", 
         RowBox[{
           SubscriptBox["\"m\"", "\"LL\""], " ", 
           SubscriptBox["\"\[CapitalPsi]\"", 
            TemplateBox[{"\"LL,\"", "5"}, "RowDefault"]]}], "-", 
         RowBox[{
           FractionBox["1", "2"], " ", 
           SubscriptBox["\"G\"", "\"LL\""], " ", 
           RowBox[{"(", 
             RowBox[{
               RowBox[{
                 
                 TemplateBox[{"\"\[CapitalPi]\"", "\"LL\"", "1"}, 
                  "Subsuperscript", SyntaxForm -> SubsuperscriptBox], " ", 
                 TemplateBox[{"\"\[CapitalPsi]\"", 
                   TemplateBox[{"\"LL,\"", "3"}, "RowDefault"], "\"*\""}, 
                  "Subsuperscript", SyntaxForm -> SubsuperscriptBox]}], "-", 
               RowBox[{"\[ImaginaryI]", " ", 
                 TemplateBox[{"\"\[CapitalPi]\"", "\"LL\"", "2"}, 
                  "Subsuperscript", SyntaxForm -> SubsuperscriptBox], " ", 
                 TemplateBox[{"\"\[CapitalPsi]\"", 
                   TemplateBox[{"\"LL,\"", "3"}, "RowDefault"], "\"*\""}, 
                  "Subsuperscript", SyntaxForm -> SubsuperscriptBox]}], "-", 
               RowBox[{
                 
                 TemplateBox[{"\"\[CapitalPi]\"", "\"LL\"", "3"}, 
                  "Subsuperscript", SyntaxForm -> SubsuperscriptBox], " ", 
                 TemplateBox[{"\"\[CapitalPsi]\"", 
                   TemplateBox[{"\"LL,\"", "4"}, "RowDefault"], "\"*\""}, 
                  "Subsuperscript", SyntaxForm -> SubsuperscriptBox]}]}], 
             ")"}]}], "-", 
         RowBox[{"\[ImaginaryI]", " ", 
           RowBox[{"(", 
             RowBox[{
               RowBox[{
                 SubscriptBox["\"\[CapitalPsi]\"", 
                  TemplateBox[{"\"LL,\"", "3"}, "RowDefault"]], " ", 
                 RowBox[{"(", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"-", 
                    FractionBox["1", "2"]}], " ", "\[ImaginaryI]", " ", 
                    TemplateBox[{"\"\[Omega]\"", 
                    TemplateBox[{"\"LL,\"", "\"0\""}, "RowDefault"], "1"}, 
                    "Subsuperscript", SyntaxForm -> SubsuperscriptBox]}], "-", 
                    FractionBox[
                    TemplateBox[{"\"\[Omega]\"", 
                    TemplateBox[{"\"LL,\"", "\"0\""}, "RowDefault"], "2"}, 
                    "Subsuperscript", SyntaxForm -> SubsuperscriptBox], "2"], 
                    "-", 
                    FractionBox[
                    TemplateBox[{"\"\[CurlyPi]\"", 
                    TemplateBox[{"\"LL,\"", "\"0\""}, "RowDefault"], "1"}, 
                    "Subsuperscript", SyntaxForm -> SubsuperscriptBox], "2"], 
                    "+", 
                    RowBox[{
                    FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", 
                    TemplateBox[{"\"\[CurlyPi]\"", 
                    TemplateBox[{"\"LL,\"", "\"0\""}, "RowDefault"], "2"}, 
                    "Subsuperscript", SyntaxForm -> SubsuperscriptBox]}]}], 
                   ")"}]}], "+", 
               RowBox[{
                 SubscriptBox["\"\[CapitalPsi]\"", 
                  TemplateBox[{"\"LL,\"", "1"}, "RowDefault"]], " ", 
                 RowBox[{"(", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"-", 
                    FractionBox["1", "2"]}], " ", "\[ImaginaryI]", " ", 
                    TemplateBox[{"\"\[Omega]\"", 
                    TemplateBox[{"\"LL,\"", "\"0\""}, "RowDefault"], "3"}, 
                    "Subsuperscript", SyntaxForm -> SubsuperscriptBox]}], "-", 
                    FractionBox[
                    TemplateBox[{"\"\[CurlyPi]\"", 
                    TemplateBox[{"\"LL,\"", "\"0\""}, "RowDefault"], "3"}, 
                    "Subsuperscript", SyntaxForm -> SubsuperscriptBox], 
                    "2"]}], ")"}]}]}], ")"}]}]}]},
      "RowDefault"]},
    {
     TemplateBox[{
       SubscriptBox["M", "LL"], "\"(\"", 
       SubscriptBox[
        TagBox[
         StyleBox["D", FontWeight -> "Bold", FontSlant -> "Plain"], 
         "SL31Bold"], "LL"], "\") = \"", 
       TagBox[
        RowBox[{"(", "\[NoBreak]", 
          GridBox[{{
             RowBox[{
               
               TemplateBox[{"\"\[Del]\"", "0", "\"LL\""}, "Subsuperscript", 
                SyntaxForm -> SubsuperscriptBox], "+", 
               
               TemplateBox[{"\"\[Del]\"", "3", "\"LL\""}, "Subsuperscript", 
                SyntaxForm -> SubsuperscriptBox]}], 
             RowBox[{
               
               TemplateBox[{"\"\[Del]\"", "1", "\"LL\""}, "Subsuperscript", 
                SyntaxForm -> SubsuperscriptBox], "-", 
               RowBox[{"\[ImaginaryI]", " ", 
                 
                 TemplateBox[{"\"\[Del]\"", "2", "\"LL\""}, "Subsuperscript", 
                  SyntaxForm -> SubsuperscriptBox]}]}]}, {
             RowBox[{
               
               TemplateBox[{"\"\[Del]\"", "1", "\"LL\""}, "Subsuperscript", 
                SyntaxForm -> SubsuperscriptBox], "+", 
               RowBox[{"\[ImaginaryI]", " ", 
                 
                 TemplateBox[{"\"\[Del]\"", "2", "\"LL\""}, "Subsuperscript", 
                  SyntaxForm -> SubsuperscriptBox]}]}], 
             RowBox[{
               
               TemplateBox[{"\"\[Del]\"", "0", "\"LL\""}, "Subsuperscript", 
                SyntaxForm -> SubsuperscriptBox], "-", 
               
               TemplateBox[{"\"\[Del]\"", "3", "\"LL\""}, "Subsuperscript", 
                SyntaxForm -> SubsuperscriptBox]}]}}, RowSpacings -> 1, 
           ColumnSpacings -> 1, RowAlignments -> Baseline, ColumnAlignments -> 
           Center], "\[NoBreak]", ")"}], 
        Function[BoxForm`e$, 
         MatrixForm[BoxForm`e$]]], "\",   \"", 
       SubscriptBox["M", "LL"], "\"(\"", 
       OverscriptBox[
        SubscriptBox[
         TagBox[
          StyleBox["D", FontWeight -> "Bold", FontSlant -> "Plain"], 
          "SL31Bold"], "LL"], "_"], "\") = \"", 
       TagBox[
        RowBox[{"(", "\[NoBreak]", 
          GridBox[{{
             RowBox[{
               
               TemplateBox[{"\"\[Del]\"", "0", "\"LL\""}, "Subsuperscript", 
                SyntaxForm -> SubsuperscriptBox], "-", 
               
               TemplateBox[{"\"\[Del]\"", "3", "\"LL\""}, "Subsuperscript", 
                SyntaxForm -> SubsuperscriptBox]}], 
             RowBox[{
               RowBox[{"-", 
                 
                 TemplateBox[{"\"\[Del]\"", "1", "\"LL\""}, "Subsuperscript", 
                  SyntaxForm -> SubsuperscriptBox]}], "+", 
               RowBox[{"\[ImaginaryI]", " ", 
                 
                 TemplateBox[{"\"\[Del]\"", "2", "\"LL\""}, "Subsuperscript", 
                  SyntaxForm -> SubsuperscriptBox]}]}]}, {
             RowBox[{
               RowBox[{"-", 
                 
                 TemplateBox[{"\"\[Del]\"", "1", "\"LL\""}, "Subsuperscript", 
                  SyntaxForm -> SubsuperscriptBox]}], "-", 
               RowBox[{"\[ImaginaryI]", " ", 
                 
                 TemplateBox[{"\"\[Del]\"", "2", "\"LL\""}, "Subsuperscript", 
                  SyntaxForm -> SubsuperscriptBox]}]}], 
             RowBox[{
               
               TemplateBox[{"\"\[Del]\"", "0", "\"LL\""}, "Subsuperscript", 
                SyntaxForm -> SubsuperscriptBox], "+", 
               
               TemplateBox[{"\"\[Del]\"", "3", "\"LL\""}, "Subsuperscript", 
                SyntaxForm -> SubsuperscriptBox]}]}}, RowSpacings -> 1, 
           ColumnSpacings -> 1, RowAlignments -> Baseline, ColumnAlignments -> 
           Center], "\[NoBreak]", ")"}], 
        Function[BoxForm`e$, 
         MatrixForm[BoxForm`e$]]]},
      "RowDefault"]}
   },
   DefaultBaseStyle->"Column",
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
   GridBoxSpacings->{"Columns" -> {{Automatic}}, "Rows" -> {{1}}}],
  "Column"]], "Output",
 CellChangeTimes->{4.004025495254837*^9},
