          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            RowBox[{
              SubsuperscriptBox["\[Chi]", "LL", "f"], "(", 
              SubsuperscriptBox["\[Omega]", "LL", "B"], ")"}], "\", \"", 
            RowBox[{
              SubsuperscriptBox["\[CapitalGamma]", "LL", "f"], "(", 
              SubsuperscriptBox["\[Omega]", "LL", "B"], ")"}], "\", \"", 
            SubsuperscriptBox["\[CapitalGamma]", "LL", "G"], "\", \"", 
            SubsuperscriptBox["\[CapitalGamma]", "LL", "m"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"chi_f Gamma_f Gamma_bdg Gamma_G Gamma_m\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the pair susceptibility of a direction ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              OverscriptBox[
               StyleBox["u", "TI"], "\[RightVector]"], 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["f",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "6c028a95-bdac-4e1c-b8a9-e65c31b5b734"],
           " of the condensed vacuum at the frequency ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[Omega]", 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["B",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "f3f9be9b-2702-45ce-a1ab-15c3aeebdac5"],
           " and zero wave number, and the kernel of the direction, ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox["\[CapitalGamma]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["f",
                FontSlant->"Plain"]], "\[LongEqual]", 
              SuperscriptBox[
               RowBox[{"\[LeftBracketingBar]", 
                SubsuperscriptBox[
                 OverscriptBox[
                  StyleBox["u", "TI"], "\[RightVector]"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["f",
                  FontSlant->"Plain"]], "\[RightBracketingBar]"}], "2"], "/", 
              
              SubscriptBox[
               StyleBox["G", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"]], "-", 
              SubsuperscriptBox["\[Chi]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["f",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "38f9875d-5bc6-47f8-81d7-1439dba2ef9b"],
           ": minus the coefficient of the time average of ",
           Cell[BoxData[
            FormBox[
             SuperscriptBox[
              RowBox[{"(", 
               SubsuperscriptBox["\[Delta]", 
                StyleBox["LL",
                 FontSlant->"Plain"], 
                StyleBox["f",
                 FontSlant->"Plain"]], ")"}], "2"], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "4f6f8e09-9c60-4dd0-8760-893df0da0979"],
           " in the effective action per duration and volume (plain text ",
           StyleBox["Gamma_bdg",
            FontFamily->"Source Code Pro"],
           
           ": the kernel computed from the Bogoliubov matrices); the kernels \
of the three Goldstone directions and of the three massive directions, ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox["\[CapitalGamma]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["G",
                FontSlant->"Plain"]], "\[LongEqual]", 
              RowBox[{"-", 
               SuperscriptBox[
                RowBox[{"(", 
                 SubsuperscriptBox["\[Omega]", 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
                  StyleBox["B",
                   FontSlant->"Plain"]], ")"}], "2"]}], 
              SubscriptBox["\[CapitalUpsilon]", 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "d05f581b-8a7f-4003-8f8f-318ec50294b0"],
           " and ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox["\[CapitalGamma]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["m",
                FontSlant->"Plain"]], "\[LongEqual]", 
              RowBox[{"(", 
               RowBox[{"4", 
                SubsuperscriptBox["\[CapitalDelta]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], "2"], "-", 
                SuperscriptBox[
                 RowBox[{"(", 
                  SubsuperscriptBox["\[Omega]", 
                   StyleBox["LL",
                    FontSlant->"Plain"], 
                   StyleBox["B",
                    FontSlant->"Plain"]], ")"}], "2"]}], ")"}], 
              SubscriptBox["\[CapitalUpsilon]", 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "fb8c0b2d-5756-4523-b4bc-831f35cdf384"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "d8a9560b-c3f5-41ea-9072-c84da520d132"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            RowBox[{
              SubscriptBox["\[CapitalUpsilon]", "LL"], "(", 
              SubsuperscriptBox["\[Omega]", "LL", "B"], ")"}], "\", \"", 
            SubsuperscriptBox["\[CapitalUpsilon]", "LL", 
             RowBox[{"(", "1", ")"}]], "\", \"", 
            SubsuperscriptBox["c", "LL", "w"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"Upsilon Upsilon_1\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the common factor of the kernels of the condensed vacuum, ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubscriptBox["\[CapitalUpsilon]", 
               StyleBox["LL",
                FontSlant->"Plain"]], "\[LongEqual]", "2", "\[ThinSpace]", 
              SubscriptBox["\[Integral]", 
               RowBox[{
                SubscriptBox[
                 StyleBox["q", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"]], "<", 
                SubscriptBox["\[CapitalLambda]", 
                 StyleBox["LL",
                  FontSlant->"Plain"]]}]], "\[ThinSpace]", 
              SuperscriptBox[
               StyleBox["d", "TI"], "3"], 
              SubscriptBox[
               StyleBox["q", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"]], 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"2", "\[Pi]"}], ")"}], 
               RowBox[{"-", "3"}]], 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{
                 SubsuperscriptBox[
                  StyleBox["E", "TI"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
                  StyleBox["c",
                   FontSlant->"Plain"]], 
                 RowBox[{"(", 
                  RowBox[{"4", 
                   SuperscriptBox[
                    RowBox[{"(", 
                    SubsuperscriptBox[
                    StyleBox["E", "TI"], 
                    StyleBox["LL",
                    FontSlant->"Plain"], 
                    StyleBox["c",
                    FontSlant->"Plain"]], ")"}], "2"], "-", 
                   SuperscriptBox[
                    RowBox[{"(", 
                    SubsuperscriptBox["\[Omega]", 
                    StyleBox["LL",
                    FontSlant->"Plain"], 
                    StyleBox["B",
                    FontSlant->"Plain"]], ")"}], "2"]}], ")"}]}], ")"}], 
               RowBox[{"-", "1"}]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "49287e0c-79b8-468d-8b3b-7336ff0837c6"],
           ", with ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubscriptBox["\[CapitalUpsilon]", 
               StyleBox["LL",
                FontSlant->"Plain"]], 
              RowBox[{"(", "0", ")"}], "\[LongEqual]", 
              SubsuperscriptBox[
               StyleBox["Z", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["t",
                FontSlant->"Plain"]], 
              RowBox[{"(", 
               SubscriptBox["\[CapitalDelta]", 
                StyleBox["LL",
                 FontSlant->"Plain"]], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "5cbcc37f-ca2b-479e-bb17-7076f157bd52"],
           "; its derivative with respect to ",
           Cell[BoxData[
            FormBox[
             SuperscriptBox[
              RowBox[{"(", 
               SubsuperscriptBox["\[Omega]", 
                StyleBox["LL",
                 FontSlant->"Plain"], 
                StyleBox["B",
                 FontSlant->"Plain"]], ")"}], "2"], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "1b75c7d4-7b5c-4ba6-8186-a6ae68c1c73d"],
           " at zero; and the positive number ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["c", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["w",
                FontSlant->"Plain"]], "\[LongEqual]", 
              SuperscriptBox[
               RowBox[{"(", 
                SubsuperscriptBox[
                 StyleBox["M", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["q",
                  FontSlant->"Plain"]], ")"}], "2"], "-", 
              SuperscriptBox[
               RowBox[{"(", 
                SubsuperscriptBox["\[Omega]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["B",
                  FontSlant->"Plain"]], ")"}], "2"], "/", "4"}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "c2519529-d125-4420-876f-eadafc1a52c1"],
           
           ", used in the proof that the kernels of the Goldstone and of the \
massive directions are ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              RowBox[{"-", 
               SuperscriptBox[
                RowBox[{"(", 
                 SubsuperscriptBox["\[Omega]", 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
                  StyleBox["B",
                   FontSlant->"Plain"]], ")"}], "2"]}], 
              SubscriptBox["\[CapitalUpsilon]", 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "5cc87cac-32d8-4473-b98d-034a0d3a00b7"],
           " and ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              RowBox[{"(", 
               RowBox[{"4", 
                SubsuperscriptBox["\[CapitalDelta]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], "2"], "-", 
                SuperscriptBox[
                 RowBox[{"(", 
                  SubsuperscriptBox["\[Omega]", 
                   StyleBox["LL",
                    FontSlant->"Plain"], 
                   StyleBox["B",
                    FontSlant->"Plain"]], ")"}], "2"]}], ")"}], 
              SubscriptBox["\[CapitalUpsilon]", 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "4190ebce-7c5e-48ef-9aa6-b02dd7e96504"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "6aeefbde-b86f-4393-bac4-fc1680ce4b0f"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox[
             OverscriptBox["d", "\[RightVector]"], "LL", "u"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the SFBS field in the unitary gauge, the column of the SFBSv \
parametrization, ",
           Cell[BoxData[
            FormBox[
             RowBox[{"(", 
              RowBox[{
               StyleBox["i", "TI"], "\[ThinSpace]", 
               SubsuperscriptBox[
                StyleBox["c", "TI"], 
                RowBox[{
                 StyleBox["LL",
                  FontSlant->"Plain"], ",", "1"}], 
                StyleBox["n",
                 FontSlant->"Plain"]], ",", "\[ThinSpace]", 
               StyleBox["i", "TI"], "\[ThinSpace]", 
               SubsuperscriptBox[
                StyleBox["c", "TI"], 
                RowBox[{
                 StyleBox["LL",
                  FontSlant->"Plain"], ",", "2"}], 
                StyleBox["n",
                 FontSlant->"Plain"]], ",", "\[ThinSpace]", 
               SubsuperscriptBox["\[CapitalDelta]", 
                StyleBox["LL",
                 FontSlant->"Plain"], 
                StyleBox["vac",
                 FontSlant->"Plain"]], "+", 
               SubsuperscriptBox[
                StyleBox["h", "TI"], 
                StyleBox["LL",
                 FontSlant->"Plain"], 
                StyleBox["a",
                 FontSlant->"Plain"]]}], ")"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "08d38a3b-8c88-428d-b2cf-09e6dbc76be6"],
           
           ": the field after the gauge transformation that removes the three \
Goldstone fields"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "6ab31385-cf1d-48b8-8d23-20a886f6d9d0"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["V", 
             RowBox[{"LL", ",", "p"}], "F"], "\", \"", 
            SubsuperscriptBox["V", 
             RowBox[{"LL", ",", "p"}], "\[Iota]"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"V V^iota VF\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the gauge potentials in the unitary gauge, the vector fields of \
definite mass: ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["V", "TI"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}], 
               StyleBox["F",
                FontSlant->"Plain"]], "\[LongEqual]", 
              SubsuperscriptBox[
               StyleBox["A", "TI"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}], 
               StyleBox["F",
                FontSlant->"Plain"]], "-", 
              SubscriptBox["\[PartialD]", 
               StyleBox["p", "TI"]], 
              SubsuperscriptBox["\[CurlyTheta]", 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", "0"}], 
               StyleBox["G",
                FontSlant->"Plain"]], "/", 
              SubsuperscriptBox[
               StyleBox["g", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["F",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "d2b1c6d4-2e2f-4f66-bd6a-752520a9f5b5"],
           " and ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              UnderscriptBox["\[Sum]", "\[Iota]",
               LimitsPositioning->True], "\[ThinSpace]", 
              SubsuperscriptBox[
               StyleBox["V", "TI"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}], "\[Iota]"], 
              SubsuperscriptBox["\[Tau]", "\[Iota]", 
               StyleBox["LL",
                FontSlant->"Plain"]], "/", "2", "\[LongEqual]", 
              SuperscriptBox[
               RowBox[{"(", 
                SubsuperscriptBox[
                 StyleBox["U",
                  FontFamily->"Helvetica",
                  FontSlant->"Plain"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["G",
                  FontSlant->"Plain"]], ")"}], "\[Dagger]"], 
              SubscriptBox[
               StyleBox["a",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}]], 
              SubsuperscriptBox[
               StyleBox["U",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["G",
                FontSlant->"Plain"]], "-", 
              RowBox[{"(", 
               RowBox[{
                StyleBox["i", "TI"], "/", 
                SubsuperscriptBox[
                 StyleBox["g", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["v",
                  FontSlant->"Plain"]]}], ")"}], 
              RowBox[{"(", 
               RowBox[{
                SubscriptBox["\[PartialD]", 
                 StyleBox["p", "TI"]], 
                SuperscriptBox[
                 RowBox[{"(", 
                  SubsuperscriptBox[
                   StyleBox["U",
                    FontFamily->"Helvetica",
                    FontSlant->"Plain"], 
                   StyleBox["LL",
                    FontSlant->"Plain"], 
                   StyleBox["G",
                    FontSlant->"Plain"]], ")"}], "\[Dagger]"]}], ")"}], 
              SubsuperscriptBox[
               StyleBox["U",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["G",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "b4a070fa-628e-49c5-a416-38f36d18bcb7"],
           "; to first order ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["V", "TI"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}], "\[Iota]"], "\[LongEqual]", 
              SubsuperscriptBox[
               StyleBox["A", "TI"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}], "\[Iota]"], "-", 
              SubscriptBox["\[PartialD]", 
               StyleBox["p", "TI"]], 
              SubsuperscriptBox["\[CurlyTheta]", 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", "\[Iota]"}], 
               StyleBox["G",
                FontSlant->"Plain"]], "/", 
              SubsuperscriptBox[
               StyleBox["g", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["v",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "eb0e8b27-444b-480f-b50c-5f3092698cf0"],
           " (",
           Cell[BoxData[
            FormBox[
             RowBox[{"\[Iota]", "\[LongEqual]", "1", ",", "2"}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "ad47aef4-658f-425d-93d5-dac5823cd583"],
           ") and ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["V", "TI"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}], "3"], "\[LongEqual]", 
              SubsuperscriptBox[
               StyleBox["A", "TI"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}], "3"]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "7c11b5a5-33d4-4d6b-aeb8-e5af407fbfc5"],
           ", the photon"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "761c103d-69ef-4227-a573-fefc81011277"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["W", 
             RowBox[{"LL", ",", "p"}], "\[PlusMinus]"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"W_+ W_-\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the charged massive vector fields, ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                SubsuperscriptBox[
                 StyleBox["V", "TI"], 
                 RowBox[{
                  StyleBox["LL",
                   FontSlant->"Plain"], ",", 
                  StyleBox["p", "TI"]}], "1"], "\[MinusPlus]", 
                StyleBox["i", "TI"], 
                SubsuperscriptBox[
                 StyleBox["V", "TI"], 
                 RowBox[{
                  StyleBox["LL",
                   FontSlant->"Plain"], ",", 
                  StyleBox["p", "TI"]}], "2"]}], ")"}], "/", 
              SqrtBox["2"]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "5dcbb720-d02e-4b24-a029-c40994cfb001"],
           ", of the electric charges ",
           Cell[BoxData[
            FormBox[
             RowBox[{"\[PlusMinus]", "1"}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "8f41a02e-4562-4882-9ed5-7447eff57b96"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "dcd99cfe-708a-43e7-be4a-4ec1996a24da"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox[
             TagBox[
              StyleBox["M", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
              "SL31SansSerif"], "LL", "t"], "\", \"", 
            SubsuperscriptBox[
             TagBox[
              StyleBox["M", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
              "SL31SansSerif"], "LL", "s"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the mass matrices of the time and of the space components of the \
four vector fields ",
           Cell[BoxData[
            FormBox[
             RowBox[{"(", 
              RowBox[{
               SubsuperscriptBox[
                StyleBox["V", "TI"], 
                RowBox[{
                 StyleBox["LL",
                  FontSlant->"Plain"], ",", 
                 StyleBox["p", "TI"]}], 
                StyleBox["F",
                 FontSlant->"Plain"]], ",", 
               SubsuperscriptBox[
                StyleBox["V", "TI"], 
                RowBox[{
                 StyleBox["LL",
                  FontSlant->"Plain"], ",", 
                 StyleBox["p", "TI"]}], "1"], ",", 
               SubsuperscriptBox[
                StyleBox["V", "TI"], 
                RowBox[{
                 StyleBox["LL",
                  FontSlant->"Plain"], ",", 
                 StyleBox["p", "TI"]}], "2"], ",", 
               SubsuperscriptBox[
                StyleBox["V", "TI"], 
                RowBox[{
                 StyleBox["LL",
                  FontSlant->"Plain"], ",", 
                 StyleBox["p", "TI"]}], "3"]}], ")"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "3cea3da8-363a-4035-8c25-49fe02b6c435"],
           " in the vacuum: ",
           Cell[BoxData[
            FormBox[
             RowBox[{"2", 
              SubsuperscriptBox[
               StyleBox["Z", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["t",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "828a67a2-e143-4a15-a0ad-945fcd25cc15"],
           " and ",
           Cell[BoxData[
            FormBox[
             RowBox[{"2", 
              SubsuperscriptBox[
               StyleBox["Z", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["s",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "f5f97f38-8297-4d37-bbb7-e722db29bd62"],
           " times the contact matrix of the vacuum, ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              StyleBox["diag",
               FontSlant->"Plain"], 
              RowBox[{"(", 
               RowBox[{"4", 
                SuperscriptBox[
                 RowBox[{"(", 
                  SubsuperscriptBox[
                   StyleBox["g", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"], 
                   StyleBox["F",
                    FontSlant->"Plain"]], ")"}], "2"], ",", 
                SuperscriptBox[
                 RowBox[{"(", 
                  SubsuperscriptBox[
                   StyleBox["g", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"], 
                   StyleBox["v",
                    FontSlant->"Plain"]], ")"}], "2"], ",", 
                SuperscriptBox[
                 RowBox[{"(", 
                  SubsuperscriptBox[
                   StyleBox["g", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"], 
                   StyleBox["v",
                    FontSlant->"Plain"]], ")"}], "2"], ",", "0"}], ")"}], 
              SuperscriptBox[
               RowBox[{"(", 
                SubsuperscriptBox["\[CapitalDelta]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["vac",
                  FontSlant->"Plain"]], ")"}], "2"]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "4532f7f3-9ece-48e9-bbd2-b8890be7da30"],
           
           "; the quadratic Lagrangian contains one half of the first and \
minus one half of the second, each between the row and the column of the \
components"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "50ff4dc1-b8a3-45d2-9d12-86201209bfe7"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["M", "LL", "W"], "\", \"", 
            SubsuperscriptBox["M", "LL", "F"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"M_W M_F M_W_time M_F_time\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the rest masses of the charged vector fields ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["W", "TI"], 
              RowBox[{
               StyleBox["LL",
                FontSlant->"Plain"], ",", 
               StyleBox["p", "TI"]}], "\[PlusMinus]"], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "bd123736-0d72-41e3-9cca-ce314d3b12e6"],
           " and of the fermion-number vector field ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["V", "TI"], 
              RowBox[{
               StyleBox["LL",
                FontSlant->"Plain"], ",", 
               StyleBox["p", "TI"]}], 
              StyleBox["F",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "87fee384-b9fa-4401-b8bd-b401509dc8f3"],
           ", ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SuperscriptBox[
               RowBox[{"(", 
                SubsuperscriptBox[
                 StyleBox["M", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["W",
                  FontSlant->"Plain"]], ")"}], "2"], "\[LongEqual]", "2", 
              SubsuperscriptBox[
               StyleBox["Z", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["s",
                FontSlant->"Plain"]], 
              SuperscriptBox[
               RowBox[{"(", 
                SubsuperscriptBox[
                 StyleBox["g", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["v",
                  FontSlant->"Plain"]], ")"}], "2"], 
              SuperscriptBox[
               RowBox[{"(", 
                SubsuperscriptBox["\[CapitalDelta]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["vac",
                  FontSlant->"Plain"]], ")"}], "2"]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "cb920285-e7cb-4fec-a378-c12ad6d91719"],
           " and ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SuperscriptBox[
               RowBox[{"(", 
                SubsuperscriptBox[
                 StyleBox["M", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["F",
                  FontSlant->"Plain"]], ")"}], "2"], "\[LongEqual]", "8", 
              SubsuperscriptBox[
               StyleBox["Z", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["s",
                FontSlant->"Plain"]], 
              SuperscriptBox[
               RowBox[{"(", 
                SubsuperscriptBox[
                 StyleBox["g", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["F",
                  FontSlant->"Plain"]], ")"}], "2"], 
              SuperscriptBox[
               RowBox[{"(", 
                SubsuperscriptBox["\[CapitalDelta]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["vac",
                  FontSlant->"Plain"]], ")"}], "2"]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "61275682-fed9-468e-9805-357854a471ca"],
           " (plain text ",
           StyleBox["M_W_time",
            FontFamily->"Source Code Pro"],
           ", ",
           StyleBox["M_F_time",
            FontFamily->"Source Code Pro"],
           ": the masses of the time components, with ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["Z", "TI"], 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["t",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "34079ea9-9090-4b5b-811f-51160e884125"],
           " in place of ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["Z", "TI"], 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["s",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "cf17a315-7219-47a5-a6e5-6d3bb497d616"],
           ")"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "ba82c843-4014-4a24-b36e-968f4ac30924"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["\[Theta]", "LL", "mix"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          
          StyleBox["\<\"theta_mix theta_mix_vacuum theta_mix_saddle \
theta_mix_pred\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the mixing angle: the angle between the massless gauge field (the \
null vector of the mass matrix) and the axis of the potential ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["A", "TI"], 
              RowBox[{
               StyleBox["LL",
                FontSlant->"Plain"], ",", 
               StyleBox["p", "TI"]}], "3"], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "a28fa7ce-6a95-42be-8ecb-2c122e4284a2"],
           " in the plane of ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["A", "TI"], 
              RowBox[{
               StyleBox["LL",
                FontSlant->"Plain"], ",", 
               StyleBox["p", "TI"]}], 
              StyleBox["F",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "d5b3770f-c040-492d-9e55-0e7e55990bfe"],
           " and ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["A", "TI"], 
              RowBox[{
               StyleBox["LL",
                FontSlant->"Plain"], ",", 
               StyleBox["p", "TI"]}], "3"], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "83fc60f8-6f26-4655-8846-507026385663"],
           "; zero in the vacuum, ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              StyleBox["arctan",
               FontSlant->"Plain"], 
              RowBox[{"(", 
               RowBox[{
                SubsuperscriptBox[
                 StyleBox["g", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["v",
                  FontSlant->"Plain"]], "/", 
                RowBox[{"(", 
                 RowBox[{"2", 
                  SubsuperscriptBox[
                   StyleBox["g", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"], 
                   StyleBox["F",
                    FontSlant->"Plain"]]}], ")"}]}], ")"}]}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "33d23a46-5762-404d-84a0-b935d8cd2220"],
           
           " at the non-unitary saddle point (plain text: the values found at \
the vacuum and at the saddle point, and the prediction)"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "92dad919-05a1-4e98-9e77-0b4d4cd08cf4"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["\[ScriptCapitalL]", "LL", 
             RowBox[{"(", "2", ")"}]]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell["\<\
the part of the second order, in the fields of SFBSv and the gauge \
potentials, of the effective Lagrangian of the superfluid boson singlet state \
together with the Yang-Mills and Maxwell terms of the gauge fields\
\>", "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "36755c08-9551-4209-af3b-b6d00ddf8337"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["w", "LL", "lat"], "\", \"", 
            SubsuperscriptBox["w", "LL", "cmp"], "\", \"", 
            SubsuperscriptBox["n", "LL", "cpx"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"w_lat w_cmp n_complex\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "a Nambu mode on the lattice written as one complex vector, the 16 \
components of ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[Psi]", 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["p",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "5f35bb62-27f5-4373-b4e5-bdab8783a376"],
           " and ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[Psi]", 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["h",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "77efb1e2-ce1c-491c-9d0d-7b2784de117b"],
           
           " on every site, the sites one after the other, so that the \
lattice equations read ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              StyleBox["i", "TI"], "\[ThinSpace]", 
              SubscriptBox["\[PartialD]", "0"], 
              SubsuperscriptBox[
               StyleBox["w", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["lat",
                FontSlant->"Plain"]], "\[LongEqual]", 
              SubsuperscriptBox[
               StyleBox["\[ScriptCapitalH]",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["lat",
                FontSlant->"Plain"]], 
              SubsuperscriptBox[
               StyleBox["w", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["lat",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "a0c39915-67d8-4f33-b9e3-19af4dd5b80b"],
           " (for the self-consistent evolution the columns of ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["W",
               FontFamily->"Helvetica",
               FontSlant->"Plain"], 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["m",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "895ea09e-5f87-4775-a0cd-43d8ebad78ab"],
           
           " one after the other); one complex component of it; and the \
number of its complex components, ",
           Cell[BoxData[
            FormBox["16", TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "1c113c9d-ad0d-4691-be17-1845eea7322d"],
           " times the number of sites (times the number of modes)"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "d3eda5dd-1b9f-43aa-a5e6-4c75b18edbcc"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["r", "LL", "tol"], "\", \"", 
            SubsuperscriptBox["a", "LL", "tol"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"rtol atol\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the relative and the absolute tolerance of a time integration by \
CVODE (the programs of Test 2) or by IDA (the notebook of Test 2 in the \
Wolfram Language, which calls it through the function ",
           StyleBox["NDSolve",
            FontFamily->"Source Code Pro"],
           
           "), two integrators of the suite SUNDIALS: the estimated local \
error of every internal step is accepted only if its weighted \
root-mean-square norm is at most 1 (the square root of the mean, over the \
real unknowns, of the squares of the estimated errors, each multiplied by the \
weight of its unknown). The programs of Test 2 give CVODE the weight ",
           Cell[BoxData[
            FormBox[
             RowBox[{"1", "/", 
              RowBox[{"(", 
               RowBox[{
                SubsuperscriptBox[
                 StyleBox["r", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["tol",
                  FontSlant->"Plain"]], 
                RowBox[{"\[LeftBracketingBar]", 
                 SubsuperscriptBox[
                  StyleBox["w", "TI"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
                  StyleBox["cmp",
                   FontSlant->"Plain"]], "\[RightBracketingBar]"}], "+", 
                SubsuperscriptBox[
                 StyleBox["a", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["tol",
                  FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "5c10b412-ea64-498e-aecb-d871b5257abf"],
           
           " for the real and for the imaginary part of every complex \
component ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["w", "TI"], 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["cmp",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "d4112f4f-7fe5-420f-b959-f9179f04992b"],
           
           " of the state; IDA has for every real unknown the weight 1 \
divided by the sum of ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["r", "TI"], 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["tol",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "67434b8c-90d5-4537-805c-870f4b1afbcb"],
           " times the modulus of this unknown and ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["a", "TI"], 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["tol",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "5d99268f-95ed-4aa7-a925-02ac123cbcdc"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "a434e28c-4ef3-4106-a052-c7e21957fb6e"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["h", "LL", "CV"], "\", \"", 
            SubsuperscriptBox["q", "LL", "CV"], "\", \"", 
            SubsuperscriptBox["h", "LL", "IDA"], "\", \"", 
            SubsuperscriptBox["N", "LL", "st"], "\", \"", 
            SubsuperscriptBox["N", "LL", "ev"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"h_CV q_CV h_IDA N_steps N_evals\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the size and the order of an internal step of CVODE (both chosen \
by CVODE, the order from 1 to 12 for the Adams-Moulton formulas); the size of \
an internal step of IDA (chosen by IDA, which uses the backward \
differentiation formulas of the orders 1 to 5 and lengthens a step only by \
doubling it); the number of internal steps of an integration and the number \
of evaluations of its right side ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              RowBox[{"-", 
               StyleBox["i", "TI"]}], 
              SubsuperscriptBox[
               StyleBox["\[ScriptCapitalH]",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["lat",
                FontSlant->"Plain"]], 
              SubsuperscriptBox[
               StyleBox["w", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["lat",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "450b14c9-cdae-46ca-828a-3f8658216e19"],
           
           " (the cost; one step of the classical Runge-Kutta method of \
fourth order needs 4 evaluations)"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "8ccc6eeb-8363-4708-9bab-2341462bd081"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["B", "LL", "err"], "\", \"", 
            SubsuperscriptBox["\[Delta]", "LL", "rel"], "\", \"", 
            SubsuperscriptBox["w", "LL", "ex"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"budget max_deviation w_exact\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the accumulated local error that the tolerances of an integration \
allow, ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["B", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["err",
                FontSlant->"Plain"]], "\[LongEqual]", 
              SubsuperscriptBox[
               StyleBox["N", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["st",
                FontSlant->"Plain"]], 
              SubsuperscriptBox[
               StyleBox["B", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["loc",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "a652c1f9-e8b5-4ada-887e-605cf9c3679c"],
           ", which is ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["N", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["st",
                FontSlant->"Plain"]], 
              SqrtBox["2"], "\[ThinSpace]", 
              RowBox[{"(", 
               RowBox[{
                SubsuperscriptBox[
                 StyleBox["r", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["tol",
                  FontSlant->"Plain"]], 
                RowBox[{"\[LeftDoubleBracketingBar]", 
                 SubsuperscriptBox[
                  StyleBox["w", "TI"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
                  StyleBox["lat",
                   FontSlant->"Plain"]], "\[RightDoubleBracketingBar]"}], "+", 
                SubsuperscriptBox[
                 StyleBox["a", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["tol",
                  FontSlant->"Plain"]], 
                SqrtBox[
                 SubsuperscriptBox[
                  StyleBox["n", "TI"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
                  StyleBox["cpx",
                   FontSlant->"Plain"]]]}], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "5aed60a8-8076-40a3-a02e-49dfd1288e6c"],
           " with the weights of CVODE for a state of the norm ",
           Cell[BoxData[
            FormBox[
             RowBox[{"\[LeftDoubleBracketingBar]", 
              SubsuperscriptBox[
               StyleBox["w", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["lat",
                FontSlant->"Plain"]], "\[RightDoubleBracketingBar]"}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "606ec3cc-eb5d-40c0-9282-8ef19f7096b7"],
           
           ", the expected size of the global error of a unitary evolution; \
and the relative deviation of a computed state from the exact solution, ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              RowBox[{"\[LeftDoubleBracketingBar]", 
               RowBox[{
                SubsuperscriptBox[
                 StyleBox["w", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["lat",
                  FontSlant->"Plain"]], "-", 
                SubsuperscriptBox[
                 StyleBox["w", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["ex",
                  FontSlant->"Plain"]]}], "\[RightDoubleBracketingBar]"}], "/", 
              RowBox[{"\[LeftDoubleBracketingBar]", 
               SubsuperscriptBox[
                StyleBox["w", "TI"], 
                StyleBox["LL",
                 FontSlant->"Plain"], 
                StyleBox["ex",
                 FontSlant->"Plain"]], "\[RightDoubleBracketingBar]"}]}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "a1612c35-e691-4407-825a-953efa976dbc"],
           ", with the exact solution ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["w", "TI"], 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["ex",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "d491b693-b0aa-4358-8447-20ba708c89e4"],
           " of the same equations"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "1654ec57-8b08-4e3f-a751-c018a2dc82f4"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["B", "LL", "loc"], "\", \"", 
            SubsuperscriptBox["\[Delta]", "LL", "loc"], "\", \"", 
            SubsuperscriptBox["E", "LL", "max"], "\", \"", 
            SubsuperscriptBox["r", "LL", "der"], "\", \"", 
            SubsuperscriptBox["B", "LL", "out"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          
          StyleBox["\<\"budget_step local_error E_max deriv_residual \
budget_out\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the local error that the tolerances allow in one internal step: \
if the error of every real unknown equals its tolerance (the inverse of its \
weight), the norm of the error is the norm of the vector of the tolerances, \
which by the triangle inequality is at most ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SqrtBox["2"], "\[ThinSpace]", 
              RowBox[{"(", 
               RowBox[{
                SubsuperscriptBox[
                 StyleBox["r", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["tol",
                  FontSlant->"Plain"]], 
                RowBox[{"\[LeftDoubleBracketingBar]", 
                 SubsuperscriptBox[
                  StyleBox["w", "TI"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
                  StyleBox["lat",
                   FontSlant->"Plain"]], "\[RightDoubleBracketingBar]"}], "+", 
                SubsuperscriptBox[
                 StyleBox["a", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["tol",
                  FontSlant->"Plain"]], 
                SqrtBox[
                 SubsuperscriptBox[
                  StyleBox["n", "TI"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
                  StyleBox["cpx",
                   FontSlant->"Plain"]]]}], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "cc2c9ec0-97b0-4739-baca-8a36e8fdb0b2"],
           " with the weights of CVODE and at most ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["r", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["tol",
                FontSlant->"Plain"]], 
              RowBox[{"\[LeftDoubleBracketingBar]", 
               SubsuperscriptBox[
                StyleBox["w", "TI"], 
                StyleBox["LL",
                 FontSlant->"Plain"], 
                StyleBox["lat",
                 FontSlant->"Plain"]], "\[RightDoubleBracketingBar]"}], "+", 
              SubsuperscriptBox[
               StyleBox["a", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["tol",
                FontSlant->"Plain"]], 
              SqrtBox[
               RowBox[{"2", 
                SubsuperscriptBox[
                 StyleBox["n", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["cpx",
                  FontSlant->"Plain"]]}]]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "a58ee396-553e-42ca-8f53-2568d2e81ce3"],
           " with the weights of IDA, and these two numbers are ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["B", "TI"], 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["loc",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "acd9dfc8-89a8-4245-9f85-eb4c536f26ea"],
           
           "; the exact local error of an internal step, the norm of the \
difference between the computed state at the end of the step and the exact \
solution that starts from the computed state at its beginning (a unitary \
evolution changes the norm of no vector, so the deviation after ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["N", "TI"], 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["st",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "b35f9f5b-1c4e-4d6e-9a69-79655e63e9c5"],
           
           " steps is at most the sum of the local errors of the steps, and \
at most ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["B", "TI"], 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["err",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "f6dbe068-c26c-4581-97ca-513a2385437d"],
           " if no ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[Delta]", 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["loc",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "d544455f-67e6-4d5b-baa4-61a010dc87b5"],
           " exceeds ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["B", "TI"], 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["loc",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "e96cacfb-5de0-4fde-a9ae-520e37674c0c"],
           "); the largest modulus of the eigenvalues ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["E", "TI"], 
              RowBox[{
               StyleBox["LL",
                FontSlant->"Plain"], ",", 
               StyleBox["n", "TI"]}], 
              StyleBox["qp",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "3b7cc778-92a9-4fc1-b64e-71d827aa801b"],
           " of ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["\[ScriptCapitalH]",
               FontSlant->"Plain"], 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["lat",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "b92afcfc-983a-4fcb-bd1f-a944e38134d4"],
           
           "; the norm of the difference, at the end of an internal step of \
IDA, between the derivative that ",
           StyleBox["NDSolve",
            FontFamily->"Source Code Pro"],
           " stores and ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              RowBox[{"-", 
               StyleBox["i", "TI"]}], 
              SubsuperscriptBox[
               StyleBox["\[ScriptCapitalH]",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["lat",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "47e424b3-c4f0-4c8b-9984-bac6be871888"],
           
           " applied to the stored state (it is not zero, because the \
iteration that solves the equations of a step stops at a tolerance); and the \
bound of the deviation from the exact solution of a state of the norm 1 that ",
           StyleBox["NDSolve",
            FontFamily->"Source Code Pro"],
           
           " returns between the ends of an internal step of IDA, by the \
polynomial of the third degree with the stored values and derivatives at the \
two ends, ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["B", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["out",
                FontSlant->"Plain"]], "\[LongEqual]", 
              RowBox[{"(", 
               RowBox[{"1", "+", 
                FractionBox["1", "4"], 
                SubsuperscriptBox[
                 StyleBox["h", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["IDA",
                  FontSlant->"Plain"]], 
                SubsuperscriptBox[
                 StyleBox["E", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["max",
                  FontSlant->"Plain"]]}], ")"}], 
              SubsuperscriptBox[
               StyleBox["B", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["err",
                FontSlant->"Plain"]], "+", 
              FractionBox["1", "4"], 
              SubsuperscriptBox[
               StyleBox["h", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["IDA",
                FontSlant->"Plain"]], 
              SubsuperscriptBox[
               StyleBox["r", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["der",
                FontSlant->"Plain"]], "+", 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{
                 SubsuperscriptBox[
                  StyleBox["h", "TI"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
                  StyleBox["IDA",
                   FontSlant->"Plain"]], 
                 SubsuperscriptBox[
                  StyleBox["E", "TI"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
                  StyleBox["max",
                   FontSlant->"Plain"]]}], ")"}], "4"], "/", "384"}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "50fcbdc6-0c90-4bef-bc51-7a6fe59001b7"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "f5a03cb4-1e00-45d3-b7e1-109ca8f54c22"],
          ImageSize->290]}
       },
       AutoDelete->False,
       GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Top}}},
       GridBoxBackground->{"Columns" -> {{None}}, "Rows" -> {
           GrayLevel[0.85]}},
       GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
       GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
       
       GridBoxSpacings->{"Columns" -> {{1}}, "Rows" -> {{0.6}}}],
      "Grid"]}
   },
   DefaultBaseStyle->"Column",
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Column"]], "Output",
 CellChangeTimes->{4.004014797987957*^9},
 CellLabel->
  "Out[227]=",ExpressionUUID->"ef3833f0-ad22-40de-99f2-e085369a54f5"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["I.9 Summary of the tests of Part I", "Section",ExpressionUUID->"fd64255b-0126-4042-9204-ddf8b4d6457b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"#", "[", "\"\<name\>\"", "]"}], ",", " ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"#", "[", "\"\<pass\>\"", "]"}], ",", " ", "\"\<PASS\>\"",
             ",", " ", "\"\<FAIL\>\""}], "]"}], ",", " ", 
          RowBox[{"#", "[", "\"\<statement\>\"", "]"}]}], "}"}], " ", "&"}], ",",
        " ", "SL31`Test`$Results"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"#", ",", " ", "Bold"}], "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<test\>\"", ",", " ", "\"\<result\>\"", ",", 
        " ", "\"\<statement\>\""}], "}"}]}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}]], "Input",
 CellLabel->
  "In[228]:=",ExpressionUUID->"0501f4bf-c033-465a-9d1d-934da2b8a971"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     StyleBox["\<\"test\"\>",
      StripOnInput->False,
      FontWeight->Bold], 
     StyleBox["\<\"result\"\>",
      StripOnInput->False,
      FontWeight->Bold], 
     StyleBox["\<\"statement\"\>",
      StripOnInput->False,
      FontWeight->Bold]},
    {"\<\"S-1\"\>", "\<\"PASS\"\>", "\<\"every one of the TeX items of the \
registry is converted into a box structure\"\>"},
    {"\<\"S-2\"\>", "\<\"PASS\"\>", "\<\"every symbolized box is read as one \
atomic symbol (head Symbol)\"\>"},
    {"\<\"S-0\"\>", "\<\"PASS\"\>", "\<\"every string inside the symbolized \
boxes is one token for the front end, so that typed symbols reach the kernel \
unchanged\"\>"},
    {"\<\"S-14\"\>", "\<\"PASS\"\>", "\<\"every symbol typed in its printed \
form is read as one atomic symbol, the one created from its registry TeX\"\>"},
    {"\<\"S-3\"\>", "\<\"PASS\"\>", "\<\"different boxes give different \
symbols, and the boxes stay different after the removal of style boxes\"\>"},
    {"\<\"S-4\"\>", "\<\"PASS\"\>", "\<\"every symbol prints as the box it \
was made from\"\>"},
    {"\<\"S-5\"\>", "\<\"PASS\"\>", "\<\"the TeX of every symbol is written \
from its printed form, without the internal name\"\>"},
    {"\<\"S-6\"\>", "\<\"PASS\"\>", "\<\"the gap equation written with the \
symbols gives the gap of the condensed vacuum 0.2094933033 at G = 22.5, m = \
0.2, cutoff 1; 2 Delta_vac = 0.4189866 and 2 M_q = 0.5792666\"\>"},
    {"\<\"S-7\"\>", "\<\"PASS\"\>", "\<\"sum over j of sigma^LL_j sigma^LL_j \
= 3 times the unit matrix, and sigma_j sigma_j' = delta_jj' + i sum_j'' \
epsilon_jj'j'' sigma_j'' for all nine pairs (components as symbolized \
symbols)\"\>"},
    {"\<\"S-8\"\>", "\<\"PASS\"\>", "\<\"the double sum of eta^LL_pp' x^p \
x^p' over p, p' = 0..3 (16 + 4 symbolized components) is (x^0)^2 - (x^1)^2 - \
(x^2)^2 - (x^3)^2\"\>"},
    {"\<\"S-9\"\>", "\<\"PASS\"\>", "\<\"(M^F_LL / M^W_LL)^2 = 4 (g^F_LL / \
g^v_LL)^2 and the gap follows from M^W_LL (algebra with symbolized symbols)\"\
\>"},
    {"\<\"S-10\"\>", "\<\"PASS\"\>", "\<\"the determinant of the time and \
longitudinal equations vanishes exactly at omega_B^2 = M_W^2 + (Z_s/Z_t) \
k_B^2\"\>"},
    {"\<\"S-11\"\>", "\<\"PASS\"\>", "\<\"the sum over iota of T^iota_LL \
T^iota_LL (with T = tau/2 for the symbolized components) is 3/4 times the \
unit matrix\"\>"},
    {"\<\"S-12\"\>", "\<\"PASS\"\>", "\<\"no plain-text name is registered \
for two different entries\"\>"},
    {"\<\"S-13\"\>", "\<\"PASS\"\>", "\<\"the imaginary unit, the number sets \
and the operators correspond to I, Reals, Complexes, Tr, Det, DiagonalMatrix, \
Re, Im, KroneckerProduct, Transpose\"\>"},
    {"\<\"S-15\"\>", "\<\"PASS\"\>", "\<\"the reader of formulas reads 18 \
formulas of known reading correctly, converts every formula of the meanings \
of the registry without a problem, with one fraction box for every fraction \
command and one root box for every root command, and sets a number that \
directly follows a letter as part of a name (x5), not as a factor\"\>"}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Output",
 CellChangeTimes->{4.004014798044546*^9},
 CellLabel->
  "Out[228]=",ExpressionUUID->"ebd04c1f-b660-4ba7-891d-bc0b4ea369be"]
}, Open  ]],

