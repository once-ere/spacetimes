   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", " ", "=", " ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"t2Unit", "[", "]"}], ",", " ", 
            RowBox[{"{", "4", "}"}]}], "]"}]}], ",", " ", "gp"}], "}"}], ",", 
       "\n", "   ", 
       RowBox[{
        RowBox[{"gp", " ", "=", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"conn15", "[", 
            RowBox[{"x", ",", " ", "p"}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], ";",
         "\n", "   ", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"up", " ", "=", " ", 
               RowBox[{"gp", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"p", " ", "+", " ", "1"}], ",", " ", 
                  RowBox[{"1", " ", ";;", " ", "2"}], ",", " ", 
                  RowBox[{"1", " ", ";;", " ", "2"}]}], "]"}], "]"}]}], ",", 
              " ", 
              RowBox[{"lo", " ", "=", " ", 
               RowBox[{"gp", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"p", " ", "+", " ", "1"}], ",", " ", 
                  RowBox[{"3", " ", ";;", " ", "4"}], ",", " ", 
                  RowBox[{"3", " ", ";;", " ", "4"}]}], "]"}], "]"}]}], ",", 
              " ", "off"}], "}"}], ",", "\n", "      ", 
            RowBox[{
             RowBox[{"off", " ", "=", " ", 
              RowBox[{
               RowBox[{"fro", "[", 
                RowBox[{"gp", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{"p", " ", "+", " ", "1"}], ",", " ", 
                   RowBox[{"1", " ", ";;", " ", "2"}], ",", " ", 
                   RowBox[{"3", " ", ";;", " ", "4"}]}], "]"}], "]"}], "]"}], 
               " ", "+", " ", 
               RowBox[{"fro", "[", 
                RowBox[{"gp", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{"p", " ", "+", " ", "1"}], ",", " ", 
                   RowBox[{"3", " ", ";;", " ", "4"}], ",", " ", 
                   RowBox[{"1", " ", ";;", " ", "2"}]}], "]"}], "]"}], 
                "]"}]}]}], ";", "\n", "      ", 
             RowBox[{"dev15form", " ", "=", " ", 
              RowBox[{"Max", "[", 
               RowBox[{"dev15form", ",", " ", "off", ",", " ", 
                RowBox[{"fro", "[", 
                 RowBox[{"up", " ", "+", " ", 
                  RowBox[{"ConjugateTranspose", "[", "lo", "]"}]}], "]"}], ",",
                 " ", 
                RowBox[{"Abs", "[", 
                 RowBox[{"Tr", "[", "lo", "]"}], "]"}]}], "]"}]}], ";", "\n", 
             "      ", 
             RowBox[{"Do", "[", "\n", "       ", 
              RowBox[{
               RowBox[{
                RowBox[{"dev15const", " ", "=", " ", 
                 RowBox[{"Max", "[", 
                  RowBox[{"dev15const", ",", " ", 
                   RowBox[{"fro", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"gam15", "[", 
                    RowBox[{
                    RowBox[{"shift", "[", 
                    RowBox[{"x", ",", " ", "p", ",", " ", "h15"}], "]"}], ",",
                     " ", "q"}], "]"}], " ", "-", " ", 
                    RowBox[{"gam15", "[", 
                    RowBox[{
                    RowBox[{"shift", "[", 
                    RowBox[{"x", ",", " ", "p", ",", " ", 
                    RowBox[{"-", "h15"}]}], "]"}], ",", " ", "q"}], "]"}]}], 
                    ")"}], " ", 
                    RowBox[{"(", 
                    RowBox[{"0.5", "/", "h15"}], ")"}]}], " ", "+", " ", 
                    RowBox[{"comm", "[", 
                    RowBox[{
                    RowBox[{"gp", "[", 
                    RowBox[{"[", 
                    RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}], ",", " ", 
                    RowBox[{"gam15", "[", 
                    RowBox[{"x", ",", " ", "q"}], "]"}]}], "]"}]}], "]"}]}], 
                  "]"}]}], ";", "\n", "       ", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"q", " ", "!=", " ", "p"}], ",", "\n", "        ", 
                  RowBox[{"dev15curv", " ", "=", " ", 
                   RowBox[{"Max", "[", 
                    RowBox[{"dev15curv", ",", " ", 
                    RowBox[{"fro", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"conn15", "[", 
                    RowBox[{
                    RowBox[{"shift", "[", 
                    RowBox[{"x", ",", " ", "p", ",", " ", "h15"}], "]"}], ",",
                     " ", "q"}], "]"}], " ", "-", " ", 
                    RowBox[{"conn15", "[", 
                    RowBox[{
                    RowBox[{"shift", "[", 
                    RowBox[{"x", ",", " ", "p", ",", " ", 
                    RowBox[{"-", "h15"}]}], "]"}], ",", " ", "q"}], "]"}]}], 
                    ")"}], " ", 
                    RowBox[{"(", 
                    RowBox[{"0.5", "/", "h15"}], ")"}]}], " ", "-", "\n", 
                    "            ", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"conn15", "[", 
                    RowBox[{
                    RowBox[{"shift", "[", 
                    RowBox[{"x", ",", " ", "q", ",", " ", "h15"}], "]"}], ",",
                     " ", "p"}], "]"}], " ", "-", " ", 
                    RowBox[{"conn15", "[", 
                    RowBox[{
                    RowBox[{"shift", "[", 
                    RowBox[{"x", ",", " ", "q", ",", " ", 
                    RowBox[{"-", "h15"}]}], "]"}], ",", " ", "p"}], "]"}]}], 
                    ")"}], " ", 
                    RowBox[{"(", 
                    RowBox[{"0.5", "/", "h15"}], ")"}]}], " ", "+", " ", 
                    RowBox[{"comm", "[", 
                    RowBox[{
                    RowBox[{"gp", "[", 
                    RowBox[{"[", 
                    RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}], ",", " ", 
                    RowBox[{"gp", "[", 
                    RowBox[{"[", 
                    RowBox[{"q", " ", "+", " ", "1"}], "]"}], "]"}]}], 
                    "]"}]}], "]"}]}], "]"}]}]}], "]"}]}], ",", "\n", 
               "       ", 
               RowBox[{"{", 
                RowBox[{"q", ",", " ", "0", ",", " ", "3"}], "}"}]}], 
              "]"}]}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}]}], 
      "]"}], ",", " ", 
     RowBox[{"{", "20", "}"}]}], "]"}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"uniqueness", ":", " ", 
     RowBox[{
      RowBox[{"the", " ", "real"}], "-", 
      RowBox[{"linear", " ", "map", " ", "u"}]}]}], " ", "->", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{"sgen", 
         RowBox[{"(", "u", ")"}]}], ",", " ", 
        RowBox[{"gamma", "^", "q"}]}], "]"}], ")"}], "_q", " ", "has", " ", 
     "the", " ", "rank", " ", "6", " ", "on", " ", "the", " ", "six", " ", 
     "generators"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"cols15", " ", "=", " ", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{"gen", ",", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Flatten", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Re", "[", "#", "]"}], ",", " ", 
               RowBox[{"Im", "[", "#", "]"}]}], "}"}], " ", "&"}], " ", "/@", 
            " ", 
            RowBox[{"Flatten", "[", 
             RowBox[{"comm", "[", 
              RowBox[{"gen", ",", " ", 
               RowBox[{"t2gamma", "[", "q", "]"}]}], "]"}], "]"}]}], "]"}], ",",
           " ", 
          RowBox[{"{", 
           RowBox[{"q", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}], 
        "]"}]}], "]"}], ",", " ", 
     RowBox[{"Join", "[", 
      RowBox[{"sj", ",", " ", "sk"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gram15", " ", "=", " ", 
   RowBox[{"N", "[", 
    RowBox[{"cols15", " ", ".", " ", 
     RowBox[{"Transpose", "[", "cols15", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gev15", " ", "=", " ", 
   RowBox[{"First", "[", 
    RowBox[{"t2eigh", "[", "gram15", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"SL31Check", "[", 
  RowBox[{"\"\<GS-15\>\"", ",", 
   " ", "\"\<the Lorentz connection is fixed by the frame: for an x-dependent \
Lorentz transformation the connection -(d_p Sspin) Sspin^-1 has the form \
sgen(u), the Dirac matrices of the transformed frame are covariantly constant \
and the curvature vanishes (20 random points; tolerance 1e-6); the 24 \
commutators [sgen(J^j), gamma^q], [sgen(K^j), gamma^q] have the rank 6 \
(smallest Gram eigenvalue > 1e-6)\>\"", ",", "\n", "  ", 
   RowBox[{
    RowBox[{"dev15form", " ", "<", " ", "1*^-6"}], " ", "&&", " ", 
    RowBox[{"dev15const", " ", "<", " ", "1*^-6"}], " ", "&&", " ", 
    RowBox[{"dev15curv", " ", "<", " ", "1*^-6"}], " ", "&&", " ", 
    RowBox[{
     RowBox[{"gev15", "[", 
      RowBox[{"[", "1", "]"}], "]"}], " ", ">", " ", "1*^-6"}]}], ",", "\n", 
   "  ", 
   RowBox[{"Row", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<largest deviations \>\"", ",", " ", "dev15form", ",", 
      " ", "\"\<, \>\"", ",", " ", "dev15const", ",", " ", "\"\<, \>\"", ",", 
      " ", "dev15curv", ",", " ", "\"\<; smallest Gram eigenvalue \>\"", ",", 
      " ", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{"gev15", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"5", ",", " ", "3"}], "}"}]}], "]"}], ",", 
      " ", "\"\< (original: 1.0e-9, 3.6e-8, 8.0e-9; 8.000)\>\""}], "}"}], 
    "]"}]}], "]"}]}], "Input",
 CellLabel->
  "In[437]:=",ExpressionUUID->"6844803c-4138-4897-a468-e1fb0e8f3fbc"],

