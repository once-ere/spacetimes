                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "d240b4c9-2c60-4813-9442-5446b2f201cc"],
               ", ",
               Cell[BoxData[
                FormBox[
                 SubsuperscriptBox[
                  StyleBox["\[ScriptCapitalF]",
                   FontSlant->"Plain"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
