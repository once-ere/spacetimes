                 FontSlant->"Plain"]]}], ")"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "16387bab-5445-4f81-b585-2c8ee6084937"],
           ": the gauge transformations ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubscriptBox[
               OverscriptBox[
                StyleBox["d", "TI"], "\[RightVector]"], 
               StyleBox["LL",
                FontSlant->"Plain"]], "\[RightTeeArrow]", 
              StyleBox["exp",
               FontSlant->"Plain"], 
              RowBox[{"(", 
               RowBox[{"2", 
