          " ", "\"\<the part of the second order, in the fields of SFBSv and \
the gauge potentials, of the effective Lagrangian of the superfluid boson \
singlet state together with the Yang-Mills and Maxwell terms of the gauge \
fields\>\""}], ",", " ", 
         RowBox[{"\"\<meaningEdited\>\"", " ", "->", " ", "True"}], ",", " ", 
         
         RowBox[{"\"\<origin\>\"", " ", "->", 
          " ", "\"\<new (Revision_SuperLoop)\>\""}]}], "|>"}]}], "\n", 
      "}"}]}], ";"}], "\n", "\n", 
   RowBox[{"Length", "[", "SL31Registry", "]"}]}]}]], "Input",
 CellLabel->"In[75]:=",ExpressionUUID->"10bb193e-60d7-4d13-8238-356b6572f320"],

Cell[BoxData["199"], "Output",
 CellChangeTimes->{4.003995302718812*^9},
 CellLabel->"Out[76]=",ExpressionUUID->"62b1d42b-2a65-4c11-b164-65e774d0c034"]
}, Open  ]],

