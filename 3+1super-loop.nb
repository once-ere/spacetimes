  FontFamily->"Source Code Pro"],
 " (the full tests of the eigensolver are the check GS-11 below)."
}], "Text",ExpressionUUID->"3f8cb6bd-fc82-45e7-b033-8c4484002725"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"t2Seed", "[", "12345", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"t2testH", " ", "=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"z", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"t2UnitC", "[", "]"}], ",", " ", 
         RowBox[{"{", "9", "}"}], ",", " ", 
         RowBox[{"{", "9", "}"}]}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"z", " ", "+", " ", 
      RowBox[{"ConjugateTranspose", "[", "z", "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"t2testM", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"t2UnitC", "[", "]"}], ",", " ", 
     RowBox[{"{", "3", "}"}], ",", " ", 
     RowBox[{"{", "3", "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"t2testVals", ",", " ", "t2testVecs"}], "}"}], " ", "=", " ", 
   RowBox[{"t2eigh", "[", "t2testH", "]"}]}], ";"}], "\n", 
 RowBox[{"SL31Check", "[", 
  RowBox[{"\"\<T2-LINALG\>\"", ",", 
   " ", "\"\<the rewritten eigensolver and matrix exponential of cmat.rs \
agree with Eigenvalues and MatrixExp of the Wolfram Language\>\"", ",", "\n", 
   "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{"t2testVals", " ", "-", " ", 
        RowBox[{"Sort", "[", 
         RowBox[{"Re", "[", 
          RowBox[{"Eigenvalues", "[", "t2testH", "]"}], "]"}], "]"}]}], "]"}],
       "]"}], " ", "<", " ", "1*^-12"}], " ", "&&", "\n", "   ", 
    RowBox[{
     RowBox[{"Norm", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"t2testVecs", " ", ".", " ", 
         RowBox[{"DiagonalMatrix", "[", "t2testVals", "]"}], " ", ".", " ", 
         RowBox[{"ConjugateTranspose", "[", "t2testVecs", "]"}]}], " ", "-", 
        " ", "t2testH"}], ",", " ", "\"\<Frobenius\>\""}], "]"}], " ", "<", 
     " ", "1*^-12"}], " ", "&&", "\n", "   ", 
    RowBox[{
     RowBox[{"Norm", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"t2expm", "[", "t2testM", "]"}], " ", "-", " ", 
        RowBox[{"MatrixExp", "[", "t2testM", "]"}]}], ",", 
       " ", "\"\<Frobenius\>\""}], "]"}], " ", "<", " ", "1*^-13"}]}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{"t2testVals", " ", "-", " ", 
        RowBox[{"Sort", "[", 
         RowBox[{"Re", "[", 
          RowBox[{"Eigenvalues", "[", "t2testH", "]"}], "]"}], "]"}]}], "]"}],
       "]"}], ",", " ", 
     RowBox[{"Norm", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"t2expm", "[", "t2testM", "]"}], " ", "-", " ", 
        RowBox[{"MatrixExp", "[", "t2testM", "]"}]}], ",", 
       " ", "\"\<Frobenius\>\""}], "]"}]}], "}"}]}], "]"}]}], "Input",
 CellLabel->
  "In[264]:=",ExpressionUUID->"70e9a55f-7079-499e-8daf-d89b06960620"],

