             RowBox[{"\"\<\\\\_\>\"", " ", "->", " ", "\"\<_\>\""}]}], "]"}], 
           ",", " ", 
           RowBox[{
            RowBox[{"\"\<$\>\"", " ", "~~", " ", 
             RowBox[{"Shortest", "[", "m__", "]"}], " ", "~~", 
             " ", "\"\<$\>\""}], " ", ":>", " ", 
            RowBox[{"With", "[", 
             RowBox[{
              RowBox[{"{", 
