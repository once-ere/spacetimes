Cell[TextData[{
 "S-6, arithmetic with symbols and values: the coupling ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "aaa69207-141c-43a8-a8de-30a049db456c"],
 ", the mass ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dc9ddedf-b566-4087-b8de-26924831de53"],
 " and the cutoff ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalLambda]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "84005ae6-5d35-44ea-ac3a-0972a4172868"],
 " of the spinor charges receive the values used throughout Test 2 (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0.2"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f11ab852-c531-4fdf-b578-90042664a854"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2340fc86-b1bf-4971-9bad-ad283447cb8e"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "22.5"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "79838e99-eb08-4cc9-9cfc-4ef79a8f6f15"],
 ", units in which the cutoff is 1). The gap of the condensed vacuum at zero \
chemical potential solves the gap equation ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[CapitalLambda]", 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      SubscriptBox[
       StyleBox["E", "TI"], "\[CapitalLambda]"], "-", 
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox[
         StyleBox["M", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], 
         StyleBox["q",
          FontSlant->"Plain"]], ")"}], "2"], "\[ThinSpace]", 
      StyleBox["arsinh",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[CapitalLambda]", 
         StyleBox["LL",
          FontSlant->"Plain"]], "/", 
        SubsuperscriptBox[
         StyleBox["M", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], 
         StyleBox["q",
          FontSlant->"Plain"]]}], ")"}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"2", 
      SuperscriptBox["\[Pi]", "2"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3e85aba6-bf84-469a-9215-ae06a76fc1a6"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["q",
        FontSlant->"Plain"]], ")"}], "2"], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "2"], "+", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["vac",
        FontSlant->"Plain"]], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "67f7b156-67d3-42a2-9fae-98d75bfb4664"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["E", "TI"], "\[CapitalLambda]"], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox["\[CapitalLambda]", 
        StyleBox["LL",
         FontSlant->"Plain"], "2"], "+", 
       SuperscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox[
          StyleBox["M", "TI"], 
          StyleBox["LL",
           FontSlant->"Plain"], 
          StyleBox["q",
           FontSlant->"Plain"]], ")"}], "2"]}], ")"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4daa2fd6-3e19-4f37-83f2-001c83809dc3"],
 ". The cell writes this equation with the symbolized symbols, gives them \
values only inside ",
 StyleBox["Block",
  FontFamily->"Source Code Pro"],
 " (so that they stay free symbols outside), solves for the gap with ",
 StyleBox["FindRoot",
  FontFamily->"Source Code Pro"],
 ", and compares with the value 0.2094933033 found by the Rust program of \
Test 2. It also checks the derived masses ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    SubsuperscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["vac",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e18630bc-f0bf-43e8-85ad-645bc56ad098"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["q",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2b8d4891-f487-490f-bf38-d5a787940916"],
 "."
}], "Text",ExpressionUUID->"6cc79581-0d35-43da-9296-bd728d70303d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"gapEquation", " ", "=", " ", 
  RowBox[{
   RowBox[{"1", "/", 
    SubscriptBox["G", "LL"]}], " ", "==", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[CapitalLambda]", "LL"], " ", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{
          SubscriptBox["\[CapitalLambda]", "LL"], "^", "2"}], " ", "+", " ", 
         RowBox[{
          SubscriptBox["m", "LL"], "^", "2"}], " ", "+", " ", 
         RowBox[{
          SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], "^", "2"}]}], 
        "]"}]}], " ", "-", "\n", "     ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SubscriptBox["m", "LL"], "^", "2"}], " ", "+", " ", 
         RowBox[{
          SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], "^", "2"}]}], 
        ")"}], " ", 
       RowBox[{"ArcSinh", "[", 
        RowBox[{
         SubscriptBox["\[CapitalLambda]", "LL"], "/", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{
            SubscriptBox["m", "LL"], "^", "2"}], " ", "+", " ", 
           RowBox[{
            SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], "^", "2"}]}], 
          "]"}]}], "]"}]}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"2", " ", 
      RowBox[{"Pi", "^", "2"}]}], ")"}]}]}]}]], "Input",
 CellLabel->
  "In[179]:=",ExpressionUUID->"f93429de-910d-452b-98df-4ad10ea4fb80"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", 
   SubscriptBox["G", "LL"]], "\[Equal]", 
  FractionBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[CapitalLambda]", "LL"], " ", 
     SqrtBox[
      RowBox[{
       SubsuperscriptBox["m", "LL", "2"], "+", 
       SuperscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], ")"}], "2"], "+", 
       
       SubsuperscriptBox["\[CapitalLambda]", "LL", "2"]}]]}], "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox["m", "LL", "2"], "+", 
       SuperscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], ")"}], "2"]}], 
      ")"}], " ", 
     RowBox[{"ArcSinh", "[", 
      FractionBox[
       SubscriptBox["\[CapitalLambda]", "LL"], 
       SqrtBox[
        RowBox[{
         SubsuperscriptBox["m", "LL", "2"], "+", 
         SuperscriptBox[
          RowBox[{"(", 
           SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], ")"}], "2"]}]]],
       "]"}]}]}], 
   RowBox[{"2", " ", 
    SuperscriptBox["\[Pi]", "2"]}]]}]], "Output",
 CellChangeTimes->{4.004014796025681*^9},
 CellLabel->
  "Out[179]=",ExpressionUUID->"2f5d901e-0812-4e15-813b-0036d46a12eb"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"exact", " ", "values", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"45", "/", "2"}], ",", " ", 
       RowBox[{"1", "/", "5"}], ",", " ", "1"}], ")"}]}], ",", " ", 
    RowBox[{
    "so", " ", "that", " ", "FindRoot", " ", "can", " ", "work", " ", "with", 
     " ", "30", " ", "digits"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"gapValue", " ", "=", " ", 
     RowBox[{"Block", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          SubscriptBox["G", "LL"], " ", "=", " ", 
          RowBox[{"45", "/", "2"}]}], ",", " ", 
         RowBox[{
          SubscriptBox["m", "LL"], " ", "=", " ", 
          RowBox[{"1", "/", "5"}]}], ",", " ", 
         RowBox[{
          SubscriptBox["\[CapitalLambda]", "LL"], " ", "=", " ", "1"}]}], 
        "}"}], ",", "\n", "   ", 
       RowBox[{
        SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], " ", "/.", " ", 
        RowBox[{"FindRoot", "[", 
         RowBox[{"gapEquation", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], ",", " ", 
            "0.2"}], "}"}], ",", " ", 
          RowBox[{"WorkingPrecision", " ", "->", " ", "30"}], ",", " ", 
          RowBox[{"AccuracyGoal", " ", "->", " ", "20"}]}], "]"}]}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"SL31Check", "[", 
     RowBox[{"\"\<S-6\>\"", ",", 
      " ", "\"\<the gap equation written with the symbols gives the gap of \
the condensed vacuum 0.2094933033 at G = 22.5, m = 0.2, cutoff 1; 2 Delta_vac \
= 0.4189866 and 2 M_q = 0.5792666\>\"", ",", "\n", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"gapValue", " ", "-", " ", "0.2094933033"}], "]"}], " ", "<",
         " ", "1*^-10"}], " ", "&&", " ", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"2", " ", "gapValue"}], " ", "-", " ", "0.4189866"}], "]"}],
         " ", "<", " ", "1*^-7"}], " ", "&&", " ", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"2", " ", 
           RowBox[{"Sqrt", "[", 
            RowBox[{"0.04", " ", "+", " ", 
             RowBox[{"gapValue", "^", "2"}]}], "]"}]}], " ", "-", " ", 
          "0.5792666"}], "]"}], " ", "<", " ", "1*^-7"}]}], ",", "\n", "  ", 
      RowBox[{"N", "[", 
       RowBox[{"gapValue", ",", " ", "12"}], "]"}]}], "]"}], 
    ";"}]}]}]], "Input",
 CellLabel->
  "In[180]:=",ExpressionUUID->"b51b4fdd-080f-401a-ad6c-14ac6f336da9"],

