                RowBox[{"False", ",", " ", "False", ",", " ", "True"}], 
                "}"}]}], "]"}]}], "}"}], ",", " ", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"e", ",", " ", 
               RowBox[{"-", "e"}]}], "}"}], ",", " ", 
             RowBox[{"{", "8", "}"}]}], "]"}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"kk", ",", " ", "0", ",", " ", "11"}], "}"}]}], "]"}], 
       "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"disp", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{"ev1", " ", "-", " ", "expect1"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"doublerOk", " ", "=", " ", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"t2epsLat", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0.", ",", " ", "0.", ",", " ", 
            RowBox[{"Pi", "/", "0.5"}]}], "}"}], ",", " ", "0.5", ",", " ", 
          "mass", ",", " ", "1.0", ",", " ", 
          RowBox[{"{", 
           RowBox[{"False", ",", " ", "False", ",", " ", "True"}], "}"}]}], 
         "]"}], " ", "-", " ", 
        RowBox[{"(", 
         RowBox[{"mass", " ", "+", " ", 
          RowBox[{"2", "/", "0.5"}]}], ")"}]}], "]"}], " ", "<", " ", 
      "1*^-12"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "the", " ", "spectral", " ", "radius", " ", "of", " ", "H_lat", " ", 
     "and", " ", "its", " ", "bound", " ", 
     RowBox[{"B", "^", "H"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"rho", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{"First", "[", 
        RowBox[{"t2eigh", "[", "hl", "]"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"bound", " ", "=", " ", 
     RowBox[{"t2normBound", "[", 
      RowBox[{"lat", ",", " ", "fl"}], "]"}]}], ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<GS-10\>\"", ",", 
     " ", "\"\<the lattice operator H_lat on a 3 x 2 x 4 lattice (dx = 0.7, \
r_W = 1, periodic in x and z) with random links, potentials and order \
parameters is Hermitian, particle-hole symmetric and exactly gauge covariant; \
on a free periodic chain of 12 sites its spectrum is +-eps_lat, each eight \
times; the Wilson term lifts the doubler to m + 2 r_W/dx; the spectral radius \
stays below the bound Hbound (tolerance 1e-10)\>\"", ",", "\n", "  ", 
     RowBox[{
      RowBox[{"herm", " ", "<", " ", "1*^-10"}], " ", "&&", " ", 
      RowBox[{"ph", " ", "<", " ", "1*^-10"}], " ", "&&", " ", 
      RowBox[{"gcov", " ", "<", " ", "1*^-10"}], " ", "&&", " ", 
      RowBox[{"disp", " ", "<", " ", "1*^-10"}], " ", "&&", " ", "doublerOk", 
      " ", "&&", " ", 
      RowBox[{"rho", " ", "<=", " ", "bound"}]}], ",", "\n", "  ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<Hermiticity \>\"", ",", " ", "herm", ",", 
        " ", "\"\<, particle-hole \>\"", ",", " ", "ph", ",", 
        " ", "\"\<, gauge covariance \>\"", ",", " ", "gcov", ",", 
        " ", "\"\<, dispersion \>\"", ",", " ", "disp", ",", 
        " ", "\"\<; spectral radius \>\"", ",", " ", 
        RowBox[{"NumberForm", "[", 
         RowBox[{"rho", ",", " ", 
          RowBox[{"{", 
           RowBox[{"6", ",", " ", "4"}], "}"}]}], "]"}], ",", 
        " ", "\"\< <= bound \>\"", ",", " ", 
        RowBox[{"NumberForm", "[", 
         RowBox[{"bound", ",", " ", 
          RowBox[{"{", 
           RowBox[{"6", ",", " ", "4"}], "}"}]}], "]"}], ",", "\n", 
        "    ", "\"\< (original: 0.0e0, 0.0e0, 1.8e-13, 1.4e-14; 8.4349 <= \
17.5474)\>\""}], "}"}], "]"}]}], "]"}]}]}]], "Input",
 CellLabel->
  "In[413]:=",ExpressionUUID->"7330c95c-ada9-45a3-bc17-71da9ec68289"],

