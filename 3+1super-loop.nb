    RowBox[{
     RowBox[{"t2hMinusV", "[", 
      RowBox[{"lat_", ",", " ", "fl_", ",", " ", "f_", ",", " ", "s_"}], 
      "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ps", " ", "=", " ", 
          RowBox[{"f", "[", "s", "]"}]}], ",", " ", "out", ",", " ", 
         RowBox[{"inv2l", " ", "=", " ", 
          RowBox[{"0.5", "/", 
           RowBox[{"lat", "[", "\"\<ell\>\"", "]"}]}]}], ",", " ", "rw", ",", 
         " ", "wf", ",", " ", "wb", ",", " ", "sp", ",", " ", "sm"}], "}"}], ",",
        "\n", "   ", 
       RowBox[{
        RowBox[{"rw", " ", "=", " ", 
         RowBox[{
          RowBox[{"lat", "[", "\"\<wilson\>\"", "]"}], " ", "inv2l"}]}], ";", 
        "\n", "   ", 
        RowBox[{"out", " ", "=", " ", 
         RowBox[{
          RowBox[{"lat", "[", "\"\<mass\>\"", "]"}], " ", 
          RowBox[{"t2beta8", " ", ".", " ", "ps"}]}]}], ";", "\n", "   ", 
        RowBox[{"Do", "[", "\n", "    ", 
         RowBox[{
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"lat", "[", "\"\<n\>\"", "]"}], "[", 
