                    OverscriptBox[
                    StyleBox["u", "TI"], "\[RightVector]"], 
                    StyleBox["LL",
                    FontSlant->"Plain"], 
                    StyleBox["f",
                    FontSlant->"Plain"]], ")"}]}]},
                {
                 RowBox[{
                  SubscriptBox[
                   StyleBox["P",
                    FontFamily->"Helvetica",
                    FontSlant->"Plain"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]], 
                  SuperscriptBox[
                   RowBox[{"(", 
                    SubsuperscriptBox[
                    OverscriptBox[
                    StyleBox["u", "TI"], "\[RightVector]"], 
                    StyleBox["LL",
                    FontSlant->"Plain"], 
                    StyleBox["f",
                    FontSlant->"Plain"]], ")"}], "\[Dagger]"]}], "0"}
               },
               
               GridBoxAlignment->{
                "Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
               GridBoxSpacings->{"Columns" -> {
                   Offset[0.27999999999999997`], {
                    Offset[0.7]}, 
                   Offset[0.27999999999999997`]}, "Rows" -> {
                   Offset[0.2], {
                    Offset[0.4]}, 
                   Offset[0.2]}}], "\[NoBreak]", ")"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "2b2fcbe5-d45f-4a48-8097-9428e6077567"],
           ", where ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubscriptBox[
               StyleBox["P",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"]], 
              RowBox[{"(", 
               SubsuperscriptBox[
                OverscriptBox[
                 StyleBox["u", "TI"], "\[RightVector]"], 
                StyleBox["LL",
                 FontSlant->"Plain"], 
                StyleBox["f",
                 FontSlant->"Plain"]], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "007381ff-0397-419f-a838-c9966c66066a"],
           " is the pairing block with ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              OverscriptBox[
               StyleBox["u", "TI"], "\[RightVector]"], 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["f",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "a1c6bae9-4b37-4ba0-bb90-36b76a5f4f85"],
           " in place of ",
           Cell[BoxData[
            FormBox[
             SubscriptBox[
              OverscriptBox[
               StyleBox["d", "TI"], "\[RightVector]"], 
              StyleBox["LL",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "0bf862a9-28a3-4eaa-b942-a507306c2d3c"],
           "; and the same for ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              OverscriptBox[
               StyleBox["u", "TI"], "\[RightVector]"], 
              StyleBox["LL",
