                   FontWeight->"Bold",
                   FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "1a265589-ce56-4e03-a5ff-9c6928672129"],
               " and ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  StyleBox["y",
                   FontWeight->"Bold",
                   FontSlant->"Plain"], "\[RightTeeArrow]", 
