            " ", 
            RowBox[{"e", "[", "\"\<names\>\"", "]"}]}], "]"}]}], "]"}], ",", 
        " ", "SL31Registry"}], "]"}], "]"}], ",", " ", 
     RowBox[{"First", " ", "->", " ", "Last"}]}], "]"}]}], ";"}], "\n", 
