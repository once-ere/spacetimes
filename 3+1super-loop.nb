  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4385a72b-1f74-420e-b10d-c9d53377be0f"],
 " and the boost components ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CurlyPi]", 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}], 
    StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "25fe3a10-7d02-4bef-9f83-374db254d36c"],
 "; the spinor field ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7d15fe9a-eec8-454c-9231-c00600a72738"],
 " is a sum of three plane waves. A gauge transformation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["\[ScriptCapitalU]",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    StyleBox["exp",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["i", "TI"], 
      SubsuperscriptBox["\[Theta]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["F",
        FontSlant->"Plain"]]}], ")"}], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["S",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[CircleTimes]", 
    SubscriptBox[
     StyleBox["U",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "71070623-1c3d-418b-8443-703b009d3c05"],
 " is applied, whose phase ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Theta]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["F",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a8eaa949-7a89-4860-a5f6-51cf301f45a9"],
 ", isospin rotation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["U",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    StyleBox["exp",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["i", "TI"], "\[ThinSpace]", 
      UnderscriptBox["\[Sum]", "\[Iota]",
       LimitsPositioning->True], "\[ThinSpace]", 
      SubsuperscriptBox["\[Theta]", 
       StyleBox["LL",
        FontSlant->"Plain"], "\[Iota]"], 
      SubsuperscriptBox["\[Tau]", "\[Iota]", 
       StyleBox["LL",
        FontSlant->"Plain"]], "/", "2"}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "37840d69-7a68-469a-983e-9eff8fde48ec"],
 " and unit bi-quaternion ",
 Cell[BoxData[
  FormBox[
   StyleBox["g",
    FontWeight->"Bold",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7b020b51-4444-48b9-92c3-d2ac1b248a76"],
 " (with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[LongEqual]", 
    StyleBox["exp",
     FontSlant->"Plain"], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["u",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fa95fd7d-33f3-40a9-be24-2bc82045db43"],
 " for a Lorentz generator ",
 Cell[BoxData[
  FormBox[
   StyleBox["u",
    FontWeight->"Bold",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c9fceba4-0869-47c2-bd64-c8960ff804ac"],
 ") depend on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dd2ee6da-c330-4024-93d5-618bd2a71157"],
 " through ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Theta]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["F",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a167a2a9-73e9-4181-ba38-f553353eafc2"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Theta]", 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "847053b3-632d-493c-8c57-4e13d1a3e31e"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["u",
    FontWeight->"Bold",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "17237c24-07d9-4e37-8da7-f5c8aa471011"],
 ", which are linear in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e3de39e8-5ff0-4d03-926a-f8cd367a8dd8"],
 ". The transformed fields are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], 
     StyleBox["F",
      FontSlant->"Plain"]], "+", 
    SubscriptBox["\[PartialD]", 
     StyleBox["p", "TI"]], 
    SubsuperscriptBox["\[Theta]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]], "/", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a791080d-2aab-410a-b7a1-e5e060650ad1"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["U",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["a",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}]], 
    SubsuperscriptBox[
     StyleBox["U",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     RowBox[{"-", "1"}]], "-", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["i", "TI"], "/", 
      SubsuperscriptBox[
       StyleBox["g", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["v",
        FontSlant->"Plain"]]}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[PartialD]", 
       StyleBox["p", "TI"]], 
      SubscriptBox[
       StyleBox["U",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}], 
    SubsuperscriptBox[
     StyleBox["U",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     RowBox[{"-", "1"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "504a84eb-a0c5-4efb-a5a8-f94f2d46393c"],
 " in place of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["a",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}]], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", "\[Iota]",
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], "\[Iota]"], 
    SubsuperscriptBox["\[Tau]", "\[Iota]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "/", "2"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d6e14017-ca00-4b69-bda9-a30b2012df0c"],
 ", and, on the Dirac index, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["S",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    SubscriptBox[
     StyleBox["s",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["u",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["LL",
        FontSlant->"Plain"], ",", 
       StyleBox["p", "TI"]}], "\[Omega]"], ")"}], 
    SubscriptBox[
     StyleBox["S",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      StyleBox["g",
       FontWeight->"Bold",
       FontSlant->"Plain"], ")"}], 
     RowBox[{"-", "1"}]], "-", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[PartialD]", 
       StyleBox["p", "TI"]], 
      SubscriptBox[
       StyleBox["S",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      RowBox[{"(", 
       StyleBox["g",
        FontWeight->"Bold",
        FontSlant->"Plain"], ")"}]}], ")"}], 
    SubscriptBox[
     StyleBox["S",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      StyleBox["g",
       FontWeight->"Bold",
       FontSlant->"Plain"], ")"}], 
     RowBox[{"-", "1"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0e3d0014-c35a-4886-bc67-ac958bd9a982"],
 " in place of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["s",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["u",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["LL",
        FontSlant->"Plain"], ",", 
       StyleBox["p", "TI"]}], "\[Omega]"], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c7db3257-927c-4ff5-b3e2-bf1d6c31c595"],
 ". GS-5 checks that the covariant derivative made of the transformed fields, \
applied to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["\[ScriptCapitalU]",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8956886d-32f9-4fc5-9f94-7c334f7effb7"],
 ", equals ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["\[ScriptCapitalU]",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Del]", 
     StyleBox["p", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c25bc868-1c39-40f8-b54c-d50444504d8b"],
 " at 20 random points; the derivatives of the gauge functions are computed \
by central differences with the step ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "5"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2d36a653-5cda-4b6b-b9ce-88b0c4967961"],
 ". GS-6 checks that the commutator of two covariant derivatives is the \
curvature, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"[", 
     RowBox[{
      SubsuperscriptBox["\[Del]", 
       StyleBox["p", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]], ",", 
      SubsuperscriptBox["\[Del]", 
       SuperscriptBox[
        StyleBox["p", "TI"], "\[Prime]"], 
       StyleBox["LL",
        FontSlant->"Plain"]]}], "]"}], 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["R",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["p", "TI"], 
        SuperscriptBox[
         StyleBox["p", "TI"], "\[Prime]"]}], 
       StyleBox["LL",
        FontSlant->"Plain"]], "-", 
      StyleBox["i", "TI"], 
      SubsuperscriptBox[
       StyleBox["g", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["v",
        FontSlant->"Plain"]], "\[ThinSpace]", 
      UnderscriptBox["\[Sum]", "\[Iota]",
       LimitsPositioning->True], "\[ThinSpace]", 
      SubsuperscriptBox[
       StyleBox["F",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["LL",
         FontSlant->"Plain"], ",", 
        StyleBox["p", "TI"], 
        SuperscriptBox[
         StyleBox["p", "TI"], "\[Prime]"]}], "\[Iota]"], 
      SubsuperscriptBox[
       StyleBox["T", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "\[Iota]"], "-", 
      StyleBox["i", "TI"], 
      SubsuperscriptBox[
       StyleBox["g", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["F",
        FontSlant->"Plain"]], 
      SubsuperscriptBox[
       StyleBox["F",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["LL",
         FontSlant->"Plain"], ",", 
        StyleBox["p", "TI"], 
        SuperscriptBox[
         StyleBox["p", "TI"], "\[Prime]"]}], 
       StyleBox["F",
        FontSlant->"Plain"]]}], ")"}], 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1df19b4c-36b0-48ef-a9b8-1f3f1380c4bd"],
 ", with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["R",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubscriptBox["\[PartialD]", 
     StyleBox["p", "TI"]], 
    SubsuperscriptBox["\[CapitalGamma]", 
     SuperscriptBox[
      StyleBox["p", "TI"], "\[Prime]"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "-", 
    SubscriptBox["\[PartialD]", 
     SuperscriptBox[
      StyleBox["p", "TI"], "\[Prime]"]], 
    SubsuperscriptBox["\[CapitalGamma]", 
     StyleBox["p", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "+", 
    SubsuperscriptBox["\[CapitalGamma]", 
     StyleBox["p", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[CapitalGamma]", 
     SuperscriptBox[
      StyleBox["p", "TI"], "\[Prime]"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "-", 
    SubsuperscriptBox["\[CapitalGamma]", 
     SuperscriptBox[
      StyleBox["p", "TI"], "\[Prime]"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[CapitalGamma]", 
     StyleBox["p", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b4e1d84f-a488-4c62-9f38-816ff31654e8"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["F",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}], "\[Iota]"], "\[LongEqual]", 
    SubscriptBox["\[PartialD]", 
     StyleBox["p", "TI"]], 
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}], "\[Iota]"], "-", 
    SubscriptBox["\[PartialD]", 
     SuperscriptBox[
      StyleBox["p", "TI"], "\[Prime]"]], 
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], "\[Iota]"], "+", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      SuperscriptBox["\[Iota]", "\[Prime]"], ",", 
      SuperscriptBox["\[Iota]", "\[Prime]\[Prime]"]}],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox["\[Epsilon]", 
     RowBox[{"\[Iota]", 
      SuperscriptBox["\[Iota]", "\[Prime]"], 
      SuperscriptBox["\[Iota]", "\[Prime]\[Prime]"]}], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], 
     SuperscriptBox["\[Iota]", "\[Prime]"]], 
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}], 
     SuperscriptBox["\[Iota]", "\[Prime]\[Prime]"]]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "012d668d-0cc9-4b52-83a1-5572529bd02f"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["F",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}], 
     StyleBox["F",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubscriptBox["\[PartialD]", 
     StyleBox["p", "TI"]], 
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}], 
     StyleBox["F",
      FontSlant->"Plain"]], "-", 
    SubscriptBox["\[PartialD]", 
     SuperscriptBox[
