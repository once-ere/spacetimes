Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"GS", "-", "4"}], ":", " ", "isospin"}], ",", " ", 
    RowBox[{
    "Lorentz", " ", "invariance", " ", "and", " ", "isospin", " ", 
     "covariance", " ", "of", " ", "the", " ", "pair", " ", "matrices"}], ",",
     " ", 
    RowBox[{
     RowBox[{"the", " ", "c"}], "-", 
     RowBox[{"number", " ", "spinor"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"t", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"t2tiso", "[", "i", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"k", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"t2kpair", "[", "i", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"isoOk", " ", "=", " ", 
     RowBox[{
      RowBox[{"And", " ", "@@", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"fro", "[", 
            RowBox[{
             RowBox[{"comm", "[", 
              RowBox[{
               RowBox[{"t", "[", 
                RowBox[{"[", "a", "]"}], "]"}], ",", " ", 
               RowBox[{"t", "[", 
                RowBox[{"[", "b", "]"}], "]"}]}], "]"}], " ", "-", " ", 
             RowBox[{"Sum", "[", 
              RowBox[{
               RowBox[{"I", " ", 
                RowBox[{"t2eps3", "[", 
                 RowBox[{"a", ",", " ", "b", ",", " ", "c"}], "]"}], " ", 
                RowBox[{"t", "[", 
                 RowBox[{"[", "c", "]"}], "]"}]}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"c", ",", " ", "3"}], "}"}]}], "]"}]}], "]"}], " ", "<",
            " ", "tol"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"a", ",", " ", "3"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"b", ",", " ", "3"}], "}"}]}], "]"}], "]"}]}], " ", "&&", 
      "\n", "   ", 
      RowBox[{"And", " ", "@@", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"fro", "[", 
             RowBox[{"comm", "[", 
              RowBox[{
               RowBox[{"t", "[", 
                RowBox[{"[", "a", "]"}], "]"}], ",", " ", 
               RowBox[{"t2lift4", "[", 
                RowBox[{"sj", "[", 
                 RowBox[{"[", "u", "]"}], "]"}], "]"}]}], "]"}], "]"}], " ", "<",
             " ", "tol"}], " ", "&&", " ", 
           RowBox[{
            RowBox[{"fro", "[", 
             RowBox[{"comm", "[", 
              RowBox[{
               RowBox[{"t", "[", 
                RowBox[{"[", "a", "]"}], "]"}], ",", " ", 
               RowBox[{"t2lift4", "[", 
                RowBox[{"sk", "[", 
                 RowBox[{"[", "u", "]"}], "]"}], "]"}]}], "]"}], "]"}], " ", "<",
             " ", "tol"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"a", ",", " ", "3"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"u", ",", " ", "3"}], "}"}]}], "]"}], "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"kkOk", " ", "=", " ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{"k", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"fro", "[", 
          RowBox[{"#", " ", "+", " ", 
           RowBox[{"Transpose", "[", "#", "]"}]}], "]"}], " ", "<", " ", 
         "tol"}], " ", "&"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"worst4", " ", "=", " ", "0."}], ";", " ", 
