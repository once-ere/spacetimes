                    Offset[0.2], {
                    Offset[0.4]}, 
                    Offset[0.2]}}], "\[NoBreak]", ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "d7c4d691-09bb-41b0-bb90-c72fe0fd525e"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "25c939f5-8c1e-472b-a2a5-4a5ecdbbcb8b"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox[
             TagBox[
              StyleBox["F", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
              "SL31SansSerif"], 
             RowBox[{"LL", ",", "p", 
               SuperscriptBox["p", "\[Prime]"]}], "\[Iota]"], "\", \"", 
            SubsuperscriptBox[
             TagBox[
              StyleBox["F", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
              "SL31SansSerif"], 
             RowBox[{"LL", ",", "p", 
               SuperscriptBox["p", "\[Prime]"]}], "F"], "\", \"", 
            SubsuperscriptBox[
             TagBox[
              StyleBox["R", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
              "SL31SansSerif"], 
             RowBox[{"p", 
               SuperscriptBox["p", "\[Prime]"]}], "LL"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"Fv_LL FF_LL Rc_LL\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the field strengths and the curvature: ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["F",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"], 
                SuperscriptBox[
                 StyleBox["p", "TI"], "\[Prime]"]}], "\[Iota]"], "\[LongEqual]", 
              SubscriptBox["\[PartialD]", 
               StyleBox["p", "TI"]], 
              SubsuperscriptBox[
               StyleBox["A", "TI"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                SuperscriptBox[
                 StyleBox["p", "TI"], "\[Prime]"]}], "\[Iota]"], "-", 
              SubscriptBox["\[PartialD]", 
               SuperscriptBox[
                StyleBox["p", "TI"], "\[Prime]"]], 
              SubsuperscriptBox[
               StyleBox["A", "TI"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}], "\[Iota]"], "+", 
              SubsuperscriptBox[
               StyleBox["g", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["v",
                FontSlant->"Plain"]], "\[ThinSpace]", 
              UnderscriptBox["\[Sum]", 
               RowBox[{
                SuperscriptBox["\[Iota]", "\[Prime]"], ",", 
                SuperscriptBox["\[Iota]", "\[Prime]\[Prime]"]}],
               LimitsPositioning->True], "\[ThinSpace]", 
              SubsuperscriptBox["\[Epsilon]", 
               RowBox[{"\[Iota]", 
                SuperscriptBox["\[Iota]", "\[Prime]"], 
                SuperscriptBox["\[Iota]", "\[Prime]\[Prime]"]}], 
               StyleBox["LL",
                FontSlant->"Plain"]], 
              SubsuperscriptBox[
               StyleBox["A", "TI"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}], 
               SuperscriptBox["\[Iota]", "\[Prime]"]], 
              SubsuperscriptBox[
               StyleBox["A", "TI"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                SuperscriptBox[
                 StyleBox["p", "TI"], "\[Prime]"]}], 
               SuperscriptBox["\[Iota]", "\[Prime]\[Prime]"]]}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "05b67730-b2e2-4304-a983-aa1b76b9e6a1"],
           ", ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["F",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"], 
                SuperscriptBox[
                 StyleBox["p", "TI"], "\[Prime]"]}], 
               StyleBox["F",
                FontSlant->"Plain"]], "\[LongEqual]", 
              SubscriptBox["\[PartialD]", 
               StyleBox["p", "TI"]], 
              SubsuperscriptBox[
               StyleBox["A", "TI"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                SuperscriptBox[
                 StyleBox["p", "TI"], "\[Prime]"]}], 
               StyleBox["F",
                FontSlant->"Plain"]], "-", 
              SubscriptBox["\[PartialD]", 
               SuperscriptBox[
                StyleBox["p", "TI"], "\[Prime]"]], 
              SubsuperscriptBox[
               StyleBox["A", "TI"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}], 
               StyleBox["F",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "ed517fbf-3d70-4666-8a94-5493f83dfa1a"],
           ", and the ",
           Cell[BoxData[
            FormBox[
             RowBox[{"8", "\[Times]", "8"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "4534b197-0a7e-4a7b-8dbf-ce0425186d34"],
           " curvature of the spin connection, ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["R",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               RowBox[{
                StyleBox["p", "TI"], 
                SuperscriptBox[
                 StyleBox["p", "TI"], "\[Prime]"]}], 
               StyleBox["LL",
                FontSlant->"Plain"]], "\[LongEqual]", 
              SubscriptBox["\[PartialD]", 
               StyleBox["p", "TI"]], 
              SubsuperscriptBox["\[CapitalGamma]", 
               SuperscriptBox[
                StyleBox["p", "TI"], "\[Prime]"], 
               StyleBox["LL",
                FontSlant->"Plain"]], "-", 
              SubscriptBox["\[PartialD]", 
               SuperscriptBox[
                StyleBox["p", "TI"], "\[Prime]"]], 
              SubsuperscriptBox["\[CapitalGamma]", 
               StyleBox["p", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"]], "+", 
              SubsuperscriptBox["\[CapitalGamma]", 
               StyleBox["p", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"]], 
              SubsuperscriptBox["\[CapitalGamma]", 
               SuperscriptBox[
                StyleBox["p", "TI"], "\[Prime]"], 
               StyleBox["LL",
                FontSlant->"Plain"]], "-", 
              SubsuperscriptBox["\[CapitalGamma]", 
               SuperscriptBox[
                StyleBox["p", "TI"], "\[Prime]"], 
               StyleBox["LL",
                FontSlant->"Plain"]], 
              SubsuperscriptBox["\[CapitalGamma]", 
               StyleBox["p", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "98781d25-fd5b-4c5d-9e2f-5221245bfdb6"],
           "; the commutator of two covariant derivatives is ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["R",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               RowBox[{
                StyleBox["p", "TI"], 
                SuperscriptBox[
                 StyleBox["p", "TI"], "\[Prime]"]}], 
               StyleBox["LL",
                FontSlant->"Plain"]], "-", 
              StyleBox["i", "TI"], "\[ThinSpace]", 
              SubsuperscriptBox[
               StyleBox["g", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["v",
                FontSlant->"Plain"]], "\[ThinSpace]", 
              UnderscriptBox["\[Sum]", "\[Iota]",
               LimitsPositioning->True], "\[ThinSpace]", 
              SubsuperscriptBox[
               StyleBox["F",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"], 
                SuperscriptBox[
                 StyleBox["p", "TI"], "\[Prime]"]}], "\[Iota]"], 
              SubsuperscriptBox[
               StyleBox["T", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], "\[Iota]"], "-", 
              StyleBox["i", "TI"], "\[ThinSpace]", 
              SubsuperscriptBox[
               StyleBox["g", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["F",
                FontSlant->"Plain"]], 
              SubsuperscriptBox[
               StyleBox["F",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"], 
                SuperscriptBox[
                 StyleBox["p", "TI"], "\[Prime]"]}], 
               StyleBox["F",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "65e5a009-4f19-4abb-b3c0-46a5c8677394"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "6f6a023d-45a5-47f9-a576-37e320489f16"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubscriptBox["\[CapitalPsi]", 
             RowBox[{"LL", ",", "1"}]], "\", \"", 
            SubscriptBox["\[CapitalPsi]", 
             RowBox[{"LL", ",", "2"}]], "\", \"", 
            SubscriptBox["\[CapitalPsi]", 
             RowBox[{"LL", ",", "3"}]], "\", \"", 
            SubscriptBox["\[CapitalPsi]", 
             RowBox[{"LL", ",", "4"}]], "\", \"", 
            SubscriptBox["\[CapitalPsi]", 
             RowBox[{"LL", ",", "5"}]], "\", \"", 
            SubscriptBox["\[CapitalPsi]", 
             RowBox[{"LL", ",", "6"}]], "\", \"", 
            SubscriptBox["\[CapitalPsi]", 
             RowBox[{"LL", ",", "7"}]], "\", \"", 
            SubscriptBox["\[CapitalPsi]", 
             RowBox[{"LL", ",", "8"}]], "\", \"", 
            SubsuperscriptBox["\[CapitalPsi]", "LL", "\[PlusMinus]"], 
            "\", \"", 
            SubscriptBox[
             OverscriptBox["\[CapitalPsi]", "_"], "LL"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"Psi_LL^+ Psi_LL^-\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the eight components of ",
           Cell[BoxData[
            FormBox[
             SubscriptBox["\[CapitalPsi]", 
              StyleBox["LL",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "02566bf8-51b1-4b97-b97a-2dfc6494ed72"],
           
           ": components 1 and 2 are the first Dirac component with isospin \
up and down, 3 and 4 the second, 5 and 6 the third, 7 and 8 the fourth; ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[CapitalPsi]", 
              StyleBox["LL",
               FontSlant->"Plain"], "-"], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "744c9354-15c6-435f-9715-7946ac08477f"],
           " (components 1 to 4, chirality ",
           Cell[BoxData[
            FormBox[
             RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "f9e8e5d8-d6e6-4897-bc7e-8f89f276d89c"],
           ") and ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[CapitalPsi]", 
              StyleBox["LL",
               FontSlant->"Plain"], "+"], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "2486028f-adee-4889-828d-336b4de5d486"],
           " (components 5 to 8, chirality ",
           Cell[BoxData[
            FormBox[
             RowBox[{"+", "1"}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "96fb8e96-e0f6-48fe-9b82-de1de78eae7b"],
           ") are the two Weyl isodoublets; ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubscriptBox[
               OverscriptBox["\[CapitalPsi]", "_"], 
               StyleBox["LL",
                FontSlant->"Plain"]], "\[LongEqual]", 
              SubsuperscriptBox["\[CapitalPsi]", 
               StyleBox["LL",
                FontSlant->"Plain"], "\[Dagger]"], 
              RowBox[{"(", 
               RowBox[{
                SubsuperscriptBox["\[Gamma]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], "0"], "\[CircleTimes]", 
                SubsuperscriptBox["\[Sigma]", "0", 
                 StyleBox["LL",
                  FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "6cf7cc18-60b9-4617-bd4a-7c0653bc5cd4"],
           " is the Dirac adjoint"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "81039a28-45da-48b6-b764-5da200f3cf77"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["\[Psi]", "LL", "p"], "\", \"", 
            SubsuperscriptBox["\[Psi]", "LL", "h"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"psi_p psi_h\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the particle and the hole component (eight complex functions \
each, in the order of the components of ",
           Cell[BoxData[
            FormBox[
             SubscriptBox["\[CapitalPsi]", 
              StyleBox["LL",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "d78fc6bc-5f9c-47bc-8fb6-147c5bf1a6c9"],
           ") of a mode of the mean-field equations: ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[Psi]", 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["p",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "d90219d4-d581-4561-abab-969d03baeff4"],
           " transforms like ",
           Cell[BoxData[
            FormBox[
             SubscriptBox["\[CapitalPsi]", 
              StyleBox["LL",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "974a5d95-45f9-4f1d-b84e-41b87305fb80"],
           " and ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[Psi]", 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["h",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "5ea8df52-2106-4b36-bda0-bd1a61d22daf"],
           " like ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[CapitalPsi]", 
              StyleBox["LL",
               FontSlant->"Plain"], "*"], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "0c02d924-8bc2-460c-97ef-c53934bffad7"],
           "; a component is written ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[Psi]", 
              RowBox[{
               StyleBox["LL",
                FontSlant->"Plain"], ",", 
               StyleBox["k", "TI"]}], 
              StyleBox["p",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "f261781e-6e9e-4be3-aea6-a22e38cce75a"],
           ", and a numbered mode ",
           Cell[BoxData[
            FormBox[
             RowBox[{"(", 
              RowBox[{
               SubsuperscriptBox["\[Psi]", 
                RowBox[{
                 StyleBox["LL",
                  FontSlant->"Plain"], ",", 
                 StyleBox["n", "TI"]}], 
                StyleBox["p",
                 FontSlant->"Plain"]], ",", 
               SubsuperscriptBox["\[Psi]", 
                RowBox[{
                 StyleBox["LL",
                  FontSlant->"Plain"], ",", 
                 StyleBox["n", "TI"]}], 
                StyleBox["h",
                 FontSlant->"Plain"]]}], ")"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "6fe9f7ff-5647-4078-a348-1094e951fa0d"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "fdc92d37-bf82-4e7b-b335-9b7b64aade52"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["\[ScriptCapitalH]", "LL", "DB"], "\", \"", 
            SubsuperscriptBox["h", "LL", "\[Del]"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"H_DB h_nabla\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the Dirac-Bogoliubov-de Gennes operator of the mean-field \
equations: the ",
           Cell[BoxData[
            FormBox[
             RowBox[{"2", "\[Times]", "2"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "bae2a8bd-5b36-4158-84e2-ac4d0481b600"],
           " block matrix (blocks of ",
           Cell[BoxData[
            FormBox[
             RowBox[{"8", "\[Times]", "8"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "197a669d-abb6-4ef7-8f09-18fd7d34f973"],
           ") with the upper left block ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["h", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], "\[Del]"], "-", 
              StyleBox["i", "TI"], 
              SubsuperscriptBox["\[CapitalGamma]", "0", 
               StyleBox["LL",
                FontSlant->"Plain"]], "-", 
              SubscriptBox[
               StyleBox["A",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", "0"}]], "-", 
              SubscriptBox["\[Mu]", 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "cb9e3c3c-3ae4-4066-8e7d-bc5ca7002e4d"],
           ", the upper right block ",
           Cell[BoxData[
            FormBox[
             SubscriptBox[
              StyleBox["P",
               FontFamily->"Helvetica",
               FontSlant->"Plain"], 
              StyleBox["LL",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "b1495515-ee70-499a-a744-47d1bc6a1c2f"],
           ", the lower left block ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["P",
               FontFamily->"Helvetica",
               FontSlant->"Plain"], 
              StyleBox["LL",
               FontSlant->"Plain"], "\[Dagger]"], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "86438075-fdf5-4a09-80ff-1930633e850b"],
           " and the lower right block ",
           Cell[BoxData[
            FormBox[
             RowBox[{"-", 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{
                 SubsuperscriptBox[
                  StyleBox["h", "TI"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], "\[Del]"], "-", 
                 StyleBox["i", "TI"], 
                 SubsuperscriptBox["\[CapitalGamma]", "0", 
                  StyleBox["LL",
                   FontSlant->"Plain"]], "-", 
                 SubscriptBox[
                  StyleBox["A",
                   FontFamily->"Helvetica",
                   FontSlant->"Plain"], 
                  RowBox[{
                   StyleBox["LL",
                    FontSlant->"Plain"], ",", "0"}]], "-", 
                 SubscriptBox["\[Mu]", 
                  StyleBox["LL",
                   FontSlant->"Plain"]]}], ")"}], "*"]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "906b647b-e6db-4b66-b699-371a8a0d4cf0"],
           ", with the covariant Dirac Hamiltonian ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["h", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], "\[Del]"], "\[LongEqual]", 
              RowBox[{"-", 
               StyleBox["i", "TI"]}], "\[ThinSpace]", 
              UnderscriptBox["\[Sum]", 
               StyleBox["j", "TI"],
               LimitsPositioning->True], "\[ThinSpace]", 
              SubsuperscriptBox["\[Alpha]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["j", "TI"]], 
              SubsuperscriptBox["\[Del]", 
               StyleBox["j", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"]], "+", 
              SubscriptBox["\[Beta]", 
               StyleBox["LL",
                FontSlant->"Plain"]], 
              SubscriptBox[
               StyleBox["m", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "bd399b27-7bed-4c74-b61b-f7f261f6383f"],
           " (",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[Alpha]", 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "65d9feb9-520e-4a1a-a7e6-b49759eed4d0"],
           " and ",
           Cell[BoxData[
            FormBox[
             SubscriptBox["\[Beta]", 
              StyleBox["LL",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "e58a3b25-2219-4c4b-a658-46f18b8fd6fa"],
           " acting on the Dirac index); on a plane wave ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              StyleBox["exp",
               FontSlant->"Plain"], 
              RowBox[{"(", 
               RowBox[{
                StyleBox["i", "TI"], "\[ThinSpace]", 
                UnderscriptBox["\[Sum]", 
                 StyleBox["j", "TI"],
                 LimitsPositioning->True], "\[ThinSpace]", 
                SubsuperscriptBox[
                 StyleBox["q", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["j", "TI"]], 
                SubsuperscriptBox[
                 StyleBox["x", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["j", "TI"]]}], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "859a3edc-ba9e-4a32-9f46-52b947c8175b"],
           " with constant fields it is a ",
           Cell[BoxData[
            FormBox[
             RowBox[{"16", "\[Times]", "16"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "377fd2b0-a5ed-45f2-a8e7-4b3e7d3528cb"],
           " matrix ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["\[ScriptCapitalH]",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["DB",
                FontSlant->"Plain"]], 
              RowBox[{"(", 
               SubscriptBox[
                OverscriptBox[
                 StyleBox["q", "TI"], "\[RightVector]"], 
                StyleBox["LL",
                 FontSlant->"Plain"]], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "6fa2c027-ca25-4870-a8ba-6d7e483e9b9f"],
           " (plain text ",
           StyleBox["H_DB(q)",
            FontFamily->"Source Code Pro"],
           "), which without gauge fields equals ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubscriptBox[
               StyleBox["H",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"]], 
              RowBox[{"(", 
               SubscriptBox[
                OverscriptBox[
                 StyleBox["q", "TI"], "\[RightVector]"], 
                StyleBox["LL",
                 FontSlant->"Plain"]], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "291c0875-3977-418e-84e6-cba062656917"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "85cd85f6-9f88-472c-b69a-ad68e026ecd5"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox[
             OverscriptBox["a", "^"], 
             RowBox[{"LL", ",", "n"}], "qp"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"a_qp\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the annihilation operator of the quasi-particle of a numbered \
mode of the mean-field equations (constant in time): ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubscriptBox["\[CapitalPsi]", 
               StyleBox["LL",
                FontSlant->"Plain"]], "\[LongEqual]", 
              UnderscriptBox["\[Sum]", 
               StyleBox["n", "TI"],
               LimitsPositioning->True], 
              RowBox[{"(", 
               RowBox[{
                SubsuperscriptBox["\[Psi]", 
                 RowBox[{
                  StyleBox["LL",
                   FontSlant->"Plain"], ",", 
                  StyleBox["n", "TI"]}], 
                 StyleBox["p",
                  FontSlant->"Plain"]], 
                SubsuperscriptBox[
                 OverscriptBox[
                  StyleBox["a", "TI"], "^"], 
                 RowBox[{
                  StyleBox["LL",
                   FontSlant->"Plain"], ",", 
                  StyleBox["n", "TI"]}], 
                 StyleBox["qp",
                  FontSlant->"Plain"]], "+", 
                SuperscriptBox[
                 RowBox[{"(", 
                  SubsuperscriptBox["\[Psi]", 
                   RowBox[{
                    StyleBox["LL",
                    FontSlant->"Plain"], ",", 
                    StyleBox["n", "TI"]}], 
                   StyleBox["h",
                    FontSlant->"Plain"]], ")"}], "*"], 
                SuperscriptBox[
                 RowBox[{"(", 
                  SubsuperscriptBox[
                   OverscriptBox[
                    StyleBox["a", "TI"], "^"], 
                   RowBox[{
                    StyleBox["LL",
                    FontSlant->"Plain"], ",", 
                    StyleBox["n", "TI"]}], 
                   StyleBox["qp",
                    FontSlant->"Plain"]], ")"}], "\[Dagger]"]}], ")"}]}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "f8d77c56-705f-4a4c-aafd-b4cb419bcf34"],
           "; the quasi-particle vacuum is annihilated by every ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              OverscriptBox[
               StyleBox["a", "TI"], "^"], 
              RowBox[{
               StyleBox["LL",
                FontSlant->"Plain"], ",", 
               StyleBox["n", "TI"]}], 
              StyleBox["qp",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "dca29b17-8786-4c2e-9ffa-80ac34d1df66"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "ed276581-0c4c-41da-baeb-f23c303fb1cf"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["E", 
             RowBox[{"LL", ",", "n"}], "qp"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"E_qp\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the energy of a numbered mode of the mean-field equations in a \
stationary state, an eigenvalue of ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["\[ScriptCapitalH]",
               FontSlant->"Plain"], 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["DB",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "61648d15-b361-4db8-a017-e374787fff45"],
           
           "; the mean-field ground state is the vacuum of the \
quasi-particles of the modes with ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["E", "TI"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["n", "TI"]}], 
               StyleBox["qp",
                FontSlant->"Plain"]], ">", "0"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "485061ff-f8ab-4109-9dbc-70322c15881b"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "737e56fc-8c06-44e0-afc0-ac2c0064a114"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            RowBox[{
              SubsuperscriptBox["\[CapitalPi]", "LL", "\[Iota]"], "(", 
              SubscriptBox["x", "LL"], ")"}]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"Pi_iota(x)\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the local pair operator ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox["\[CapitalPi]", 
               StyleBox["LL",
                FontSlant->"Plain"], "\[Iota]"], 
              RowBox[{"(", 
               SubscriptBox[
                StyleBox["x", "TI"], 
                StyleBox["LL",
                 FontSlant->"Plain"]], ")"}], "\[LongEqual]", 
              SubscriptBox["\[CapitalPsi]", 
               StyleBox["LL",
                FontSlant->"Plain"]], 
              SuperscriptBox[
               RowBox[{"(", 
                SubscriptBox[
                 StyleBox["x", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"]], ")"}], 
               StyleBox["T", "TI"]], 
              SubsuperscriptBox[
               StyleBox["K",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"], "\[Iota]"], 
              SubscriptBox["\[CapitalPsi]", 
               StyleBox["LL",
                FontSlant->"Plain"]], 
              RowBox[{"(", 
               SubscriptBox[
                StyleBox["x", "TI"], 
                StyleBox["LL",
                 FontSlant->"Plain"]], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "3d2266cd-4fb4-48b0-aa4d-121fa114896e"],
           ", which annihilates two spinor charges at the point ",
           Cell[BoxData[
            FormBox[
             SubscriptBox[
              StyleBox["x", "TI"], 
              StyleBox["LL",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "fac57037-107b-4015-ac17-161f8fc1cce5"],
           
           "; its integral over space, with the plane waves normalized in a \
box, is the operator ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[CapitalPi]", 
              StyleBox["LL",
               FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "a96c5c01-8893-4868-9c93-16594ea3c057"],
           " of the momenta"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "58215f4a-5eaf-4038-8da9-b6eec835d5de"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["\[ScriptCapitalJ]", "LL", 
             RowBox[{"F", ",", "p"}]], "\", \"", 
            SubsuperscriptBox["\[ScriptCapitalJ]", "LL", 
             RowBox[{"\[Iota]", ",", "p"}]]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"JF_LL Jv_LL\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the currents that are the sources of the gauge fields, ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["\[ScriptCapitalJ]",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               RowBox[{
                StyleBox["F",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}]], "\[LongEqual]", 
              SubsuperscriptBox[
               StyleBox["g", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["F",
                FontSlant->"Plain"]], 
              SubscriptBox[
               OverscriptBox["\[CapitalPsi]", "_"], 
               StyleBox["LL",
                FontSlant->"Plain"]], 
              SubsuperscriptBox["\[Gamma]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["p", "TI"]], 
              SubscriptBox["\[CapitalPsi]", 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "954c25af-7a69-4758-92bd-b7f2dc1f0643"],
           " and ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["\[ScriptCapitalJ]",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               RowBox[{"\[Iota]", ",", 
                StyleBox["p", "TI"]}]], "\[LongEqual]", 
              SubsuperscriptBox[
               StyleBox["g", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["v",
                FontSlant->"Plain"]], 
              SubscriptBox[
               OverscriptBox["\[CapitalPsi]", "_"], 
               StyleBox["LL",
                FontSlant->"Plain"]], 
              SubsuperscriptBox["\[Gamma]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["p", "TI"]], 
              SubsuperscriptBox[
               StyleBox["T", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], "\[Iota]"], 
              SubscriptBox["\[CapitalPsi]", 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "2a7bde30-4229-4d19-bc94-1c920c7445b1"],
           " (",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[Gamma]", 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["p", "TI"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "4bb7159f-976e-4c0b-ba3f-a47783025716"],
           " acting on the Dirac index)"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "11bba2f6-9eaf-431c-b1f9-0486e9882d0e"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["\[ScriptCapitalL]", "LL", "\[Del]"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"Lagr_nabla\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the gauge-invariant Lagrangian density of the gauge-covariant \
spinor field: the contact form ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["\[ScriptCapitalL]",
               FontSlant->"Plain"], 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["c",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "21ce9630-33f7-4b9d-839e-0ecea7aacd99"],
           " with the covariant derivative ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[Del]", 
              StyleBox["p", "TI"], 
              StyleBox["LL",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "914174a4-9f51-4048-939e-b9bd540c18e7"],
           " in place of ",
           Cell[BoxData[
            FormBox[
             SubscriptBox["\[PartialD]", 
              StyleBox["p", "TI"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "15070699-aa3f-4ac9-8d68-fb5c4501241b"],
           ", plus the Lagrangian density of the gauge fields"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "6cc18ee9-a265-4f04-9d39-6303c5222372"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["\[ScriptL]", "LL", "x"], "\", \"", 
            SubsuperscriptBox["\[ScriptL]", "LL", "t"], "\", \"", 
            SubsuperscriptBox["r", "LL", "W"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"dx dt r_W\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell["\<\
the lattice spacing (the same in the three directions), a time step of the \
lattice equations (a fixed step of the first version of Test 2, or the \
interval between the output times of an integration by CVODE or by IDA, which \
choose their own internal steps), and the coefficient of the Wilson term of \
the lattice equations\
\>", "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "6cd82456-a09a-4faf-951f-135fc7e80b0c"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["n", "LL", "x"], "\", \"", 
            SubsuperscriptBox["n", "LL", "y"], "\", \"", 
            SubsuperscriptBox["n", "LL", "z"], "\", \"", 
            SubscriptBox[
             OverscriptBox["s", "\[RightVector]"], "LL"], "\", \"", 
            SubsuperscriptBox[
             OverscriptBox["\[Delta]", "\[RightVector]"], "LL", "j"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"nx ny nz site delta_j\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the numbers of lattice sites in the directions ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["x", "TI"], 
              StyleBox["LL",
               FontSlant->"Plain"], "1"], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "229724fd-36d1-470b-a7a5-89541418fa78"],
           ", ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["x", "TI"], 
              StyleBox["LL",
               FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "f505310a-067b-4296-8762-bcb23d634910"],
           ", ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["x", "TI"], 
              StyleBox["LL",
               FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "96a0d936-abd8-4115-8b9d-00f11ab93c9f"],
           "; a lattice site ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubscriptBox[
               OverscriptBox[
                StyleBox["s", "TI"], "\[RightVector]"], 
               StyleBox["LL",
                FontSlant->"Plain"]], "\[LongEqual]", 
              RowBox[{"(", 
               RowBox[{
                SubsuperscriptBox[
                 StyleBox["s", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], "1"], ",", 
                SubsuperscriptBox[
                 StyleBox["s", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], "2"], ",", 
                SubsuperscriptBox[
                 StyleBox["s", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], "3"]}], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "d430897e-cdab-4522-b28c-1d1471a6c049"],
           ", whose integer coordinates ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["s", "TI"], 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "a306e509-d65a-4554-9a39-d19436f598f8"],
           
           " run from 0 to the number of sites of their direction minus 1, at \
the point ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["x", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["j", "TI"]], "\[LongEqual]", 
              SubsuperscriptBox[
               StyleBox["s", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["j", "TI"]], 
              SubsuperscriptBox["\[ScriptL]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["x",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "1e79e69f-3dce-44fb-889e-ce7a2db98f47"],
           "; and the step to the next site in the direction ",
           Cell[BoxData[
            FormBox[
             StyleBox["j", "TI"], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "fc5df9bd-5a76-4ed2-9f38-5dc5b4386100"],
           ", the unit vector ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              OverscriptBox["\[Delta]", "\[RightVector]"], 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "d37bdfe9-3378-4f24-bce7-63584f5c701b"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "d1c6004c-d907-49e5-8f5f-a7084a4227c4"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            RowBox[{
              SubsuperscriptBox[
               TagBox[
                StyleBox[
                "U", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
                "SL31SansSerif"], 
               RowBox[{"LL", ",", "j"}], "link"], "(", 
              SubscriptBox[
               OverscriptBox["s", "\[RightVector]"], "LL"], ")"}]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"Ulink Ulink_j\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the link matrix of the lattice from the site ",
           Cell[BoxData[
            FormBox[
             SubscriptBox[
              OverscriptBox[
               StyleBox["s", "TI"], "\[RightVector]"], 
              StyleBox["LL",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "8c5ed418-0868-4533-a4ec-1123013164a0"],
           " to the site ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubscriptBox[
               OverscriptBox[
                StyleBox["s", "TI"], "\[RightVector]"], 
               StyleBox["LL",
                FontSlant->"Plain"]], "+", 
              SubsuperscriptBox[
               OverscriptBox["\[Delta]", "\[RightVector]"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["j", "TI"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "f101f97e-4933-408e-a7a7-954c5238054a"],
           ", the ",
           Cell[BoxData[
            FormBox[
             RowBox[{"2", "\[Times]", "2"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "e999d986-b0e4-4284-8805-50d1cbef0f09"],
           " isospin matrix ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              StyleBox["exp",
               FontSlant->"Plain"], 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", 
                 StyleBox["i", "TI"]}], 
                SubsuperscriptBox["\[ScriptL]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["x",
                  FontSlant->"Plain"]], 
                RowBox[{"(", 
                 RowBox[{
                  SubsuperscriptBox[
                   StyleBox["g", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"], 
                   StyleBox["v",
                    FontSlant->"Plain"]], 
                  SubscriptBox[
                   StyleBox["a",
                    FontFamily->"Helvetica",
                    FontSlant->"Plain"], 
                   RowBox[{
                    StyleBox["LL",
                    FontSlant->"Plain"], ",", 
                    StyleBox["j", "TI"]}]], "+", 
                  SubsuperscriptBox[
                   StyleBox["g", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"], 
                   StyleBox["F",
                    FontSlant->"Plain"]], 
                  SubsuperscriptBox[
                   StyleBox["A", "TI"], 
                   RowBox[{
                    StyleBox["LL",
                    FontSlant->"Plain"], ",", 
                    StyleBox["j", "TI"]}], 
                   StyleBox["F",
                    FontSlant->"Plain"]], 
                  SubsuperscriptBox["\[Sigma]", "0", 
                   StyleBox["LL",
                    FontSlant->"Plain"]]}], ")"}]}], ")"}]}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "bca36961-a927-4d95-99c6-69464a58273e"],
           
           " of the potentials at the site: the parallel transport of the \
isospin and of the phase over one lattice step"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "7cb366a5-f999-44ca-a7ae-fee6fc6ad8df"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["\[ScriptCapitalH]", "LL", "lat"], "\", \"", 
            SubsuperscriptBox["\[CurlyEpsilon]", "LL", "lat"], "\", \"", 
            SubsuperscriptBox["B", "LL", "H"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"H_lat eps_lat Hbound\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the lattice form of ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["\[ScriptCapitalH]",
               FontSlant->"Plain"], 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["DB",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "72a6e139-30c1-4341-9223-78ce82e8a48b"],
           
           " (a matrix of 16 rows per site), the energy of a free particle on \
the lattice, and the bound on the largest eigenvalue magnitude of ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["\[ScriptCapitalH]",
               FontSlant->"Plain"], 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["lat",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "06395472-dcf3-4c30-ab14-981b6339e4ab"],
           
           " (the first version of Test 2 chose its fixed time step from it; \
the solvers now use it in the bounds of their checks of the energy)"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "fcba41de-4e8d-410b-802b-291a07df2c3d"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox[
             TagBox[
              StyleBox["G", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
              "SL31SansSerif"], "LL", "site"], "\", \"", 
            SubsuperscriptBox[
             TagBox[
              StyleBox["X", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
              "SL31SansSerif"], "LL", "ph"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"Gsite Xph\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the gauge transformation of the lattice equations, which acts at \
each site as ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              StyleBox["exp",
               FontSlant->"Plain"], 
              RowBox[{"(", 
               RowBox[{
                StyleBox["i", "TI"], 
                SubsuperscriptBox["\[Theta]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["F",
                  FontSlant->"Plain"]]}], ")"}], 
              SubscriptBox[
               StyleBox["U",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "13c78807-f2c2-46f3-895e-e06662ad1e35"],
           
           " on the isospin index of the particle component and as its \
complex conjugate on the hole component; and the exchange of the particle and \
the hole component, ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["X",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["ph",
                FontSlant->"Plain"]], "\[LongEqual]", 
              RowBox[{"(", "\[NoBreak]", GridBox[{
                 {"0", 
                  SubscriptBox[
                   StyleBox["1",
                    FontFamily->"Helvetica",
                    FontSlant->"Plain"], "8"]},
                 {
                  SubscriptBox[
                   StyleBox["1",
                    FontFamily->"Helvetica",
                    FontSlant->"Plain"], "8"], "0"}
                },
                
                GridBoxAlignment->{
                 "Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
                GridBoxSpacings->{"Columns" -> {
                    Offset[0.27999999999999997`], {
                    Offset[0.7]}, 
                    Offset[0.27999999999999997`]}, "Rows" -> {
                    Offset[0.2], {
                    Offset[0.4]}, 
                    Offset[0.2]}}], "\[NoBreak]", ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "b9aeb782-6c94-4282-9ec8-dcf4560bcfd8"],
           ", with which the particle-hole symmetry reads ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["X",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["ph",
                FontSlant->"Plain"]], 
              SuperscriptBox[
               RowBox[{"(", 
                SubsuperscriptBox[
                 StyleBox["\[ScriptCapitalH]",
                  FontSlant->"Plain"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["DB",
                  FontSlant->"Plain"]], ")"}], "*"], 
              SubsuperscriptBox[
               StyleBox["X",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["ph",
                FontSlant->"Plain"]], "\[LongEqual]", 
              RowBox[{"-", 
               SubsuperscriptBox[
                StyleBox["\[ScriptCapitalH]",
                 FontSlant->"Plain"], 
                StyleBox["LL",
                 FontSlant->"Plain"], 
                StyleBox["DB",
                 FontSlant->"Plain"]]}]}], TraditionalForm]], "InlineFormula",
            
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "6c6e0347-f4ab-4208-94d2-df8b0f1c4555"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "3aa0add5-d979-45b5-94d1-43a636a24a9b"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox[
             TagBox[
              StyleBox["A", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
              "SL31SansSerif"], 
             RowBox[{"LL", ",", "p"}], "\[UpArrow]"], "\", \"", 
            SubsuperscriptBox[
             TagBox[
              StyleBox["A", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
              "SL31SansSerif"], 
             RowBox[{"LL", ",", "p"}], "\[DownArrow]"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          
          StyleBox["\<\"Acal_up Acal_down Acal_up_0 Acal_up_1 Acal_down_0 \
Acal_down_1\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the two eigenvalues of ",
           Cell[BoxData[
            FormBox[
             SubscriptBox[
              StyleBox["A",
               FontFamily->"Helvetica",
               FontSlant->"Plain"], 
              RowBox[{
               StyleBox["LL",
                FontSlant->"Plain"], ",", 
               StyleBox["p", "TI"]}]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "e9497c26-659c-43bf-83a0-793e4c3fa635"],
           
           " when the isospin potentials point along the third isospin \
direction (",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["A", "TI"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}], "1"], "\[LongEqual]", 
              SubsuperscriptBox[
               StyleBox["A", "TI"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}], "2"], "\[LongEqual]", "0"}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "2ecdd065-0881-4843-ad09-fd14a567c3a8"],
           "): ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["A",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}], "\[UpArrow]"], "\[LongEqual]", 
              SubsuperscriptBox[
               StyleBox["g", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["F",
                FontSlant->"Plain"]], 
              SubsuperscriptBox[
               StyleBox["A", "TI"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}], 
               StyleBox["F",
                FontSlant->"Plain"]], "+", 
              FractionBox["1", "2"], 
              SubsuperscriptBox[
               StyleBox["g", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["v",
                FontSlant->"Plain"]], 
              SubsuperscriptBox[
               StyleBox["A", "TI"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}], "3"]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "80585598-10ae-42d0-8af0-5977e9ef64b1"],
           " on the isospin-up components (",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubscriptBox[
               StyleBox["Q", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"]], "\[LongEqual]", 
              RowBox[{"+", 
               FractionBox["1", "2"]}]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "cd9fc66e-6678-44d0-8513-82d3bf8da757"],
           ") and ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["A",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}], "\[DownArrow]"], "\[LongEqual]", 
              SubsuperscriptBox[
               StyleBox["g", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["F",
                FontSlant->"Plain"]], 
              SubsuperscriptBox[
               StyleBox["A", "TI"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}], 
               StyleBox["F",
                FontSlant->"Plain"]], "-", 
              FractionBox["1", "2"], 
              SubsuperscriptBox[
               StyleBox["g", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["v",
                FontSlant->"Plain"]], 
              SubsuperscriptBox[
               StyleBox["A", "TI"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}], "3"]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "df5d702d-253e-40c2-b069-c42683a7f8a5"],
           " on the isospin-down components (",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubscriptBox[
               StyleBox["Q", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"]], "\[LongEqual]", 
              RowBox[{"-", 
               FractionBox["1", "2"]}]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "fd378835-5c67-44ff-9c82-c530d5b1391f"],
           
           "); constant potentials of a space direction shift the momentum of \
a component, those of the time direction its energy"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "17c464cc-b3e7-44c2-9cf7-a41b8474482b"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["\[Omega]", "LL", "pr"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"omega_pr\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the angular frequency with which the isospin of a mode turns in a \
constant isospin potential of the time direction, ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox["\[Omega]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["pr",
                FontSlant->"Plain"]], "\[LongEqual]", 
              SubsuperscriptBox[
               StyleBox["g", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["v",
                FontSlant->"Plain"]], 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{
                 UnderscriptBox["\[Sum]", "\[Iota]",
                  LimitsPositioning->True], 
                 SuperscriptBox[
                  RowBox[{"(", 
                   SubsuperscriptBox[
                    StyleBox["A", "TI"], 
                    RowBox[{
                    StyleBox["LL",
                    FontSlant->"Plain"], ",", "0"}], "\[Iota]"], ")"}], 
                  "2"]}], ")"}], 
               RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
            
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "cec00405-5bd2-4dd9-9781-e2f71a570a51"],
           
           "; the axis of the rotation is the direction of the potential in \
isospin space"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "f9d55823-1958-42d5-9bf1-8fd7f852983c"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["P", "LL", "\[UpArrow]"], "\", \"", 
            SubsuperscriptBox["P", "LL", "h"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          
          StyleBox["\<\"P_up P_up_cvode P_up_rk4 P_up_exact P_hole \
P_hole_cvode P_hole_rk4 P_hole_exact\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the probability of isospin up of a mode, the fraction of its norm \
",
           Cell[BoxData[
            FormBox[
             RowBox[{"\[Integral]", "\[ThinSpace]", 
              SuperscriptBox[
               StyleBox["d", "TI"], "3"], 
              SubscriptBox[
               OverscriptBox[
                StyleBox["x", "TI"], "\[RightVector]"], 
               StyleBox["LL",
                FontSlant->"Plain"]], 
              RowBox[{"(", 
               RowBox[{
                SuperscriptBox[
                 RowBox[{"\[LeftBracketingBar]", 
                  SubsuperscriptBox["\[Psi]", 
                   StyleBox["LL",
                    FontSlant->"Plain"], 
                   StyleBox["p",
                    FontSlant->"Plain"]], "\[RightBracketingBar]"}], "2"], "+", 
                SuperscriptBox[
                 RowBox[{"\[LeftBracketingBar]", 
                  SubsuperscriptBox["\[Psi]", 
                   StyleBox["LL",
                    FontSlant->"Plain"], 
                   StyleBox["h",
                    FontSlant->"Plain"]], "\[RightBracketingBar]"}], "2"]}], 
               ")"}]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "f592a18d-6cf9-48fb-9fb8-85443bc9a3a2"],
           
           " that lies in the isospin-up components, and the probability of \
the hole, the fraction that lies in ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[Psi]", 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["h",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "da4c8c79-2ebe-41f1-99c0-bc8bccd456cb"],
           "; both are functions of the time ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["x", "TI"], 
              StyleBox["LL",
               FontSlant->"Plain"], "0"], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "64335de3-6d89-4b5b-b528-c06a96eefb64"],
           " (in the plain-text names the suffix ",
           StyleBox["_cvode",
            FontFamily->"Source Code Pro"],
           
           " marks the values of the integration of the lattice equations by \
CVODE, ",
           StyleBox["_rk4",
            FontFamily->"Source Code Pro"],
           
           " those of the integration by the fixed-step Runge-Kutta method of \
the first version of the original programs, and ",
           StyleBox["_exact",
            FontFamily->"Source Code Pro"],
           " those of the exact solution)"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "74d321c3-e435-4df4-a82a-e7eb7c95d194"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["\[Chi]", "LL", "pw"], "\", \"", 
            SubsuperscriptBox["\[CurlyTheta]", "LL", "B"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"chi_pw theta_B\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the constant 8-component spinor (Dirac index and isospin) of a \
plane-wave solution, a normalized eigenvector of ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubscriptBox[
               StyleBox["h",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"]], 
              RowBox[{"(", 
               SubscriptBox[
                OverscriptBox[
                 StyleBox["q", "TI"], "\[RightVector]"], 
                StyleBox["LL",
                 FontSlant->"Plain"]], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "e4115394-fbc0-42db-99c4-447084818ec4"],
           
           " or of its lattice form; and the Bogoliubov angle of a plane-wave \
mode of the uniform polar superfluid, ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SuperscriptBox[
               StyleBox["cos",
                FontSlant->"Plain"], "2"], "\[ThinSpace]", 
              SubsuperscriptBox["\[CurlyTheta]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["B",
                FontSlant->"Plain"]], "\[LongEqual]", 
              FractionBox["1", "2"], 
              RowBox[{"(", 
               RowBox[{"1", "+", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"\[PlusMinus]", 
                   SubscriptBox["\[CurlyEpsilon]", 
                    StyleBox["LL",
                    FontSlant->"Plain"]]}], "-", 
                  SubscriptBox["\[Mu]", 
                   StyleBox["LL",
                    FontSlant->"Plain"]]}], ")"}], "/", 
                SubsuperscriptBox[
                 StyleBox["E", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], "\[MinusPlus]"]}], ")"}]}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "a0c2332c-cde4-4efe-b859-d70d55765bc9"],
           " for an eigenvector of the energy ",
           Cell[BoxData[
            FormBox[
             RowBox[{"\[PlusMinus]", 
              SubscriptBox["\[CurlyEpsilon]", 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "1043f0b5-90bf-461a-8224-f7fd59afa178"],
           ", which divides the mode into its particle part ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              StyleBox["cos",
               FontSlant->"Plain"], "\[ThinSpace]", 
              SubsuperscriptBox["\[CurlyTheta]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["B",
                FontSlant->"Plain"]], "\[ThinSpace]", 
              SubsuperscriptBox["\[Chi]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["pw",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "5c932725-8e35-4bad-80d0-b76d83a0f779"],
           " and its hole part ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              StyleBox["sin",
               FontSlant->"Plain"], "\[ThinSpace]", 
              SubsuperscriptBox["\[CurlyTheta]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["B",
                FontSlant->"Plain"]], "\[ThinSpace]", 
              SubsuperscriptBox[
               StyleBox["K",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"], "3"], 
              SubsuperscriptBox["\[Chi]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["pw",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "fb26cd2a-f246-4113-8bf2-79d4e94b9ca1"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "2faefb2c-7bea-4d0a-9f33-1e2729e610cb"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["\[CapitalDelta]", "LL", "\[Infinity]"], 
            "\", \"", 
            SubsuperscriptBox["\[ScriptL]", "LL", "K"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"Delta_inf ell_K\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the value of the gap far from a domain wall (kink) of the pair \
field, and the width of the wall: the kink ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["d", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], "\[Iota]"], "\[LongEqual]", 
              RowBox[{"(", 
               RowBox[{"0", ",", "0", ",", 
                SubscriptBox["\[CapitalDelta]", 
                 StyleBox["LL",
                  FontSlant->"Plain"]], 
                RowBox[{"(", 
                 SubsuperscriptBox[
                  StyleBox["x", "TI"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], "1"], ")"}]}], ")"}]}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "dfa15c7f-f6b7-4257-9b41-e93b430f637b"],
           " with ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubscriptBox["\[CapitalDelta]", 
               StyleBox["LL",
                FontSlant->"Plain"]], 
              RowBox[{"(", 
               SubsuperscriptBox[
                StyleBox["x", "TI"], 
                StyleBox["LL",
                 FontSlant->"Plain"], "1"], ")"}], "\[LongEqual]", 
              SubsuperscriptBox["\[CapitalDelta]", 
               StyleBox["LL",
                FontSlant->"Plain"], "\[Infinity]"], "\[ThinSpace]", 
              StyleBox["tanh",
               FontSlant->"Plain"], 
              RowBox[{"(", 
               RowBox[{
                SubsuperscriptBox[
                 StyleBox["x", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], "1"], "/", 
                SubsuperscriptBox["\[ScriptL]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["K",
                  FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "b174bef2-8604-481c-bdb5-26ee5a2f10c2"],
           " changes the sign of the pair field at ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["x", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], "1"], "\[LongEqual]", "0"}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "d8a4f41a-7153-46a3-b13d-a22a318e7664"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "1a0b1217-7834-47bf-8c0f-b6c6859f39b5"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["\[CurlyPhi]", "LL", "K"], "\", \"", 
            SubsuperscriptBox["\[Chi]", "LL", "K"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"phi_K chi_K\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the profile and the constant spinor of a bound state of a kink of \
the pair field: ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox["\[CurlyPhi]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["K",
                FontSlant->"Plain"]], 
              RowBox[{"(", 
               SubsuperscriptBox[
                StyleBox["x", "TI"], 
                StyleBox["LL",
                 FontSlant->"Plain"], "1"], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "41d6a9d6-dc72-41ea-a359-b189c44fe2f5"],
           " solves ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              StyleBox["d", "TI"], 
              SubsuperscriptBox["\[CurlyPhi]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["K",
                FontSlant->"Plain"]], "/", 
              StyleBox["d", "TI"], 
              SubsuperscriptBox[
               StyleBox["x", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], "1"], "\[LongEqual]", 
              RowBox[{"-", 
               SubscriptBox["\[CapitalDelta]", 
                StyleBox["LL",
                 FontSlant->"Plain"]]}], 
              RowBox[{"(", 
               SubsuperscriptBox[
                StyleBox["x", "TI"], 
                StyleBox["LL",
                 FontSlant->"Plain"], "1"], ")"}], 
              SubsuperscriptBox["\[CurlyPhi]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["K",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "9b0f48c6-31d7-45b4-84a3-b6e8e3b3269b"],
           ", so that ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox["\[CurlyPhi]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["K",
                FontSlant->"Plain"]], "\[LongEqual]", 
              StyleBox["cosh",
               FontSlant->"Plain"], 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{
                 SubsuperscriptBox[
                  StyleBox["x", "TI"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], "1"], "/", 
                 SubsuperscriptBox["\[ScriptL]", 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
                  StyleBox["K",
                   FontSlant->"Plain"]]}], ")"}], 
               RowBox[{
                RowBox[{"-", 
                 SubsuperscriptBox["\[CapitalDelta]", 
                  StyleBox["LL",
                   FontSlant->"Plain"], "\[Infinity]"]}], 
                SubsuperscriptBox["\[ScriptL]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["K",
                  FontSlant->"Plain"]]}]]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "0d069732-3f74-46c4-8391-82472df353c8"],
           " for the kink of the width ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[ScriptL]", 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["K",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "803859c2-039d-43cb-978c-cd006ec808fd"],
           "; ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[Chi]", 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["K",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "8c0d7acd-d17d-4f25-8819-a977642143f8"],
           " is a constant 8-component spinor with ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubscriptBox["\[Beta]", 
               StyleBox["LL",
                FontSlant->"Plain"]], 
              SubsuperscriptBox["\[Chi]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["K",
                FontSlant->"Plain"]], "\[LongEqual]", 
              RowBox[{"\[PlusMinus]", 
               SubsuperscriptBox["\[Chi]", 
                StyleBox["LL",
                 FontSlant->"Plain"], 
                StyleBox["K",
                 FontSlant->"Plain"]]}]}], TraditionalForm]], "InlineFormula",
            
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "9b021d38-e777-4e66-b94d-4ef8497da0e9"],
           "; the bound state is ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                SubsuperscriptBox["\[Psi]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["p",
                  FontSlant->"Plain"]], ",", 
                SubsuperscriptBox["\[Psi]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["h",
                  FontSlant->"Plain"]]}], ")"}], "\[LongEqual]", 
              RowBox[{"(", 
               RowBox[{
                SubsuperscriptBox["\[CurlyPhi]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["K",
                  FontSlant->"Plain"]], 
                SubsuperscriptBox["\[Chi]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["K",
                  FontSlant->"Plain"]], ",", "\[ThinSpace]", 
                StyleBox["i", "TI"], 
                SuperscriptBox[
                 RowBox[{"(", 
                  SubsuperscriptBox[
                   StyleBox["K",
                    FontFamily->"Helvetica",
                    FontSlant->"Plain"], 
                   StyleBox["LL",
                    FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"], 
                SubsuperscriptBox["\[Alpha]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], "1"], 
                SubsuperscriptBox["\[CurlyPhi]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["K",
                  FontSlant->"Plain"]], 
                SubsuperscriptBox["\[Chi]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["K",
                  FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "17e8a839-dd8a-4516-afe8-58126cb2f7a1"],
           ", with the energy ",
           Cell[BoxData[
            FormBox[
             RowBox[{"\[PlusMinus]", 
              SubscriptBox[
               StyleBox["m", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "81c8475e-5f73-4386-9f92-d6dd3e1b4c3e"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "90d76f89-9920-43c2-abb3-60351edd7356"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox[
             TagBox[
              StyleBox["Q", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
              "SL31SansSerif"], "LL", "K"], "\", \"", 
            SubsuperscriptBox["k", "LL", "K"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"Qmat_K k_K\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the constant Hermitian ",
           Cell[BoxData[
            FormBox[
             RowBox[{"16", "\[Times]", "16"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "577e7c1f-9279-4b84-95c2-3246edf9d826"],
           " matrix ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["Q",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["K",
                FontSlant->"Plain"]], "\[LongEqual]", 
              RowBox[{"(", "\[NoBreak]", GridBox[{
                 {"0", 
                  RowBox[{
                   RowBox[{"-", 
                    StyleBox["i", "TI"]}], 
                   SubsuperscriptBox["\[Alpha]", 
                    StyleBox["LL",
                    FontSlant->"Plain"], "1"], 
                   SuperscriptBox[
                    RowBox[{"(", 
                    SubsuperscriptBox[
                    StyleBox["K",
                    FontFamily->"Helvetica",
                    FontSlant->"Plain"], 
                    StyleBox["LL",
                    FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"]}]},
                 {
                  RowBox[{
                   RowBox[{"-", 
                    StyleBox["i", "TI"]}], 
                   SubsuperscriptBox["\[Alpha]", 
                    StyleBox["LL",
                    FontSlant->"Plain"], "1"], 
                   SubsuperscriptBox[
                    StyleBox["K",
                    FontFamily->"Helvetica",
                    FontSlant->"Plain"], 
                    StyleBox["LL",
                    FontSlant->"Plain"], "3"]}], "0"}
                },
                
                GridBoxAlignment->{
                 "Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
                GridBoxSpacings->{"Columns" -> {
                    Offset[0.27999999999999997`], {
                    Offset[0.7]}, 
                    Offset[0.27999999999999997`]}, "Rows" -> {
                    Offset[0.2], {
                    Offset[0.4]}, 
                    Offset[0.2]}}], "\[NoBreak]", ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "f5efd066-c7f9-475c-a6f2-608ee1bfe618"],
           " (blocks of ",
           Cell[BoxData[
            FormBox[
             RowBox[{"8", "\[Times]", "8"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "0029d669-6391-4569-a8ae-34a56c9398b5"],
           "), with ",
           Cell[BoxData[
            FormBox[
             SuperscriptBox[
              RowBox[{"(", 
               SubsuperscriptBox[
                StyleBox["Q",
                 FontFamily->"Helvetica",
                 FontSlant->"Plain"], 
                StyleBox["LL",
                 FontSlant->"Plain"], 
                StyleBox["K",
                 FontSlant->"Plain"]], ")"}], "2"], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "669ca583-976a-4fda-9df6-66ef7b04a733"],
           
           " the unit matrix and the trace 0, through which the square of the \
Dirac-Bogoliubov-de Gennes operator of a wall of the pair field depends on \
the slope of the gap: ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SuperscriptBox[
               RowBox[{"(", 
                SubsuperscriptBox[
                 StyleBox["\[ScriptCapitalH]",
                  FontSlant->"Plain"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["DB",
                  FontSlant->"Plain"]], ")"}], "2"], "\[LongEqual]", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", 
                 SuperscriptBox[
                  StyleBox["d", "TI"], "2"]}], "/", 
                StyleBox["d", "TI"], 
                SuperscriptBox[
                 RowBox[{"(", 
                  SubsuperscriptBox[
                   StyleBox["x", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"], "1"], ")"}], "2"], "+", 
                SuperscriptBox[
                 RowBox[{"(", 
                  SubsuperscriptBox[
                   StyleBox["q", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"], "2"], ")"}], "2"], "+", 
                SuperscriptBox[
                 RowBox[{"(", 
                  SubsuperscriptBox[
                   StyleBox["q", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"], "3"], ")"}], "2"], "+", 
                SubsuperscriptBox[
                 StyleBox["m", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], "2"], "+", 
                SubsuperscriptBox["\[CapitalDelta]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], "2"]}], ")"}], "+", 
              RowBox[{"(", 
               RowBox[{
                StyleBox["d", "TI"], 
                SubscriptBox["\[CapitalDelta]", 
                 StyleBox["LL",
                  FontSlant->"Plain"]], "/", 
                StyleBox["d", "TI"], 
                SubsuperscriptBox[
                 StyleBox["x", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], "1"]}], ")"}], "\[ThinSpace]", 
              SubsuperscriptBox[
               StyleBox["Q",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["K",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "aedadabb-ab78-4845-aacd-e588d14e0d93"],
           "; and the number ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["k", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["K",
                FontSlant->"Plain"]], "\[LongEqual]", "0", ",", "1", ",", "2",
               ",", "\[Ellipsis]"}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "5255bc97-9fd3-4fa2-8a90-5ba5ce79dad6"],
           " of a bound state of a kink, below ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox["\[CapitalDelta]", 
               StyleBox["LL",
                FontSlant->"Plain"], "\[Infinity]"], 
              SubsuperscriptBox["\[ScriptL]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["K",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "1c174e17-61cf-444a-a131-4f3de1ec8be1"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "48673bf8-f735-4d97-9b2c-81205596e36c"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["E", "LL", "R"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"E_R\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the Rayleigh quotient of a trial mode on the lattice: the \
expectation value of ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["\[ScriptCapitalH]",
               FontSlant->"Plain"], 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["lat",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "3871888b-553f-4ebb-b3d1-4e543d9bf8ad"],
           
           " in the mode divided by the norm of the mode; it approximates the \
eigenvalue nearest to it with an error of second order in the residual of the \
mode"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "4351ebe1-2ca0-48b3-a37c-7b47da01683b"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["B", "LL", "\[UpArrow]"], "\", \"", 
            SubsuperscriptBox["B", "LL", "\[DownArrow]"], "\", \"", 
            SubsuperscriptBox["n", "LL", "L"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"B_up B_down n_L\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the magnetic fields that the isospin-up and the isospin-down \
components feel in the constant field strengths ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["F",
               FontFamily->"Helvetica",
               FontSlant->"Plain"], 
              RowBox[{
               StyleBox["LL",
                FontSlant->"Plain"], ",", "12"}], 
              StyleBox["F",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "6d3b4f1d-15de-4821-93cb-070a80c88720"],
           " (of the phase group) and ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["F",
               FontFamily->"Helvetica",
               FontSlant->"Plain"], 
              RowBox[{
               StyleBox["LL",
                FontSlant->"Plain"], ",", "12"}], "3"], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "a06dbf3c-3681-4902-867a-951f2231df08"],
           " (of the third isospin direction), ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["B", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], "\[UpArrow]"], "\[LongEqual]", 
              SubsuperscriptBox[
               StyleBox["g", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["F",
                FontSlant->"Plain"]], 
              SubsuperscriptBox[
               StyleBox["F",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", "12"}], 
               StyleBox["F",
                FontSlant->"Plain"]], "+", 
              FractionBox["1", "2"], 
              SubsuperscriptBox[
               StyleBox["g", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["v",
                FontSlant->"Plain"]], 
              SubsuperscriptBox[
               StyleBox["F",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", "12"}], "3"]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "a92945d7-9eeb-4336-b315-bdf34d51d7b9"],
           " and ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["B", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], "\[DownArrow]"], "\[LongEqual]", 
              SubsuperscriptBox[
               StyleBox["g", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["F",
                FontSlant->"Plain"]], 
              SubsuperscriptBox[
               StyleBox["F",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", "12"}], 
               StyleBox["F",
                FontSlant->"Plain"]], "-", 
              FractionBox["1", "2"], 
              SubsuperscriptBox[
               StyleBox["g", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["v",
                FontSlant->"Plain"]], 
              SubsuperscriptBox[
               StyleBox["F",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", "12"}], "3"]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "ef0067c6-651c-443d-9505-0c8b749101e7"],
           " (the fields point along ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["x", "TI"], 
              StyleBox["LL",
               FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "e8eaa463-8af7-4ddc-9e19-71b60fac8cd9"],
           "); and the number ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["n", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["L",
                FontSlant->"Plain"]], "\[LongEqual]", "0", ",", "1", ",", "2",
               ",", "\[Ellipsis]"}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "35870777-4179-4ad2-a341-a9f7a15f16d0"],
           " of a Landau level, of the energies ",
           Cell[BoxData[
            FormBox[
             RowBox[{"\[PlusMinus]", 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{
                 SubsuperscriptBox[
                  StyleBox["m", "TI"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], "2"], "+", 
                 SuperscriptBox[
                  RowBox[{"(", 
                   SubsuperscriptBox[
                    StyleBox["q", "TI"], 
                    StyleBox["LL",
                    FontSlant->"Plain"], "3"], ")"}], "2"], "+", "2", 
                 SubsuperscriptBox[
                  StyleBox["n", "TI"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
                  StyleBox["L",
                   FontSlant->"Plain"]], 
                 RowBox[{"\[LeftBracketingBar]", 
                  SubsuperscriptBox[
                   StyleBox["B", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"], "\[UpArrow]"], 
                  "\[RightBracketingBar]"}]}], ")"}], 
               RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
            
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "800b8d78-1fc5-4427-ab85-12ba4763ddb8"],
           " for isospin up and likewise with ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["B", "TI"], 
              StyleBox["LL",
               FontSlant->"Plain"], "\[DownArrow]"], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "c6500dc1-a028-4149-ad0a-f3089abed3da"],
           " for isospin down"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "51ab7da5-c4c5-4bbf-9c69-8fafe0859f43"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["n", "LL", "act"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"n_act\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the number of active directions of a lattice problem, the \
directions with more than one site (1, 2 or 3); the mode functions of a \
problem with ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["n", "TI"], 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["act",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "38853763-94a3-4fe4-896b-56ccfeed9a6e"],
           " active directions are normalized to ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              UnderscriptBox["\[Sum]", 
               SubscriptBox[
                OverscriptBox[
                 StyleBox["s", "TI"], "\[RightVector]"], 
                StyleBox["LL",
                 FontSlant->"Plain"]],
               LimitsPositioning->True], 
              SuperscriptBox[
               RowBox[{"(", 
                SubsuperscriptBox["\[ScriptL]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["x",
                  FontSlant->"Plain"]], ")"}], 
               SubsuperscriptBox[
                StyleBox["n", "TI"], 
                StyleBox["LL",
                 FontSlant->"Plain"], 
                StyleBox["act",
                 FontSlant->"Plain"]]], 
              RowBox[{"(", 
               RowBox[{
                SuperscriptBox[
                 RowBox[{"\[LeftBracketingBar]", 
                  SubsuperscriptBox["\[Psi]", 
                   StyleBox["LL",
                    FontSlant->"Plain"], 
                   StyleBox["p",
                    FontSlant->"Plain"]], "\[RightBracketingBar]"}], "2"], "+", 
                SuperscriptBox[
                 RowBox[{"\[LeftBracketingBar]", 
                  SubsuperscriptBox["\[Psi]", 
                   StyleBox["LL",
                    FontSlant->"Plain"], 
                   StyleBox["h",
                    FontSlant->"Plain"]], "\[RightBracketingBar]"}], "2"]}], 
               ")"}], "\[LongEqual]", "1"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "d57f9866-3463-45f1-bf5d-4bbf1c726164"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "047a2584-6827-4f17-a0a4-b45f264047f6"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["N", "LL", "F"], "\", \"", 
            SubsuperscriptBox["E", "LL", "MF"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"N_F E_MF\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the fermion number of a self-consistent lattice state, the sum \
over its modes and over the sites of the squared hole components ",
           Cell[BoxData[
            FormBox[
             SuperscriptBox[
              RowBox[{"\[LeftBracketingBar]", 
               SubsuperscriptBox["\[Psi]", 
                StyleBox["LL",
                 FontSlant->"Plain"], 
                StyleBox["h",
                 FontSlant->"Plain"]], "\[RightBracketingBar]"}], "2"], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "506d6714-db77-4d8f-8e65-0bd2ef872092"],
           
           " (conserved by the self-consistent evolution), and the mean-field \
energy functional, the sum over the modes of the expectation values of ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["\[ScriptCapitalH]",
               FontSlant->"Plain"], 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["lat",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "fa7d5bb2-ee76-44de-9858-0b48de78bb86"],
           " without the pair field plus ",
           Cell[BoxData[
            FormBox[
             RowBox[{"2", 
              SuperscriptBox[
               RowBox[{"(", 
                SubsuperscriptBox["\[ScriptL]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["x",
                  FontSlant->"Plain"]], ")"}], 
               SubsuperscriptBox[
                StyleBox["n", "TI"], 
                StyleBox["LL",
                 FontSlant->"Plain"], 
                StyleBox["act",
                 FontSlant->"Plain"]]], "/", 
              SubscriptBox[
               StyleBox["G", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "3d29fb96-7fc7-4422-9e33-362d21fc614d"],
           " times the sum over the sites of ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              UnderscriptBox["\[Sum]", "\[Iota]",
               LimitsPositioning->True], 
              SuperscriptBox[
               RowBox[{"\[LeftBracketingBar]", 
                SubsuperscriptBox[
                 StyleBox["d", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], "\[Iota]"], "\[RightBracketingBar]"}], 
               "2"]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "8a560d32-cec6-491d-8a73-8789279894c2"],
           " (conserved in time-independent gauge fields)"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "f357287b-afdf-43d6-a856-49f479bb1df6"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox[
             TagBox[
              StyleBox["W", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
              "SL31SansSerif"], "LL", "m"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"W_modes\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell["\<\
the matrix whose columns are the modes of a self-consistent lattice state \
(unit vectors with 16 components per site); the self-consistent evolution \
moves all columns together\
\>", "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "f4a09807-4ccd-4b60-8b21-3fcf61d1e86d"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["\[ScriptCapitalM]", "LL", "sc"], "\", \"", 
            SubsuperscriptBox["y", "LL", "A"], "\", \"", 
            SubsuperscriptBox["r", "LL", "A"], "\", \"", 
            SubsuperscriptBox["Y", "LL", "A"], "\", \"", 
            SubsuperscriptBox["R", "LL", "A"], "\", \"", 
            SubsuperscriptBox["c", "LL", "A"], "\", \"", 
            SubsuperscriptBox["a", "LL", "A"], "\", \"", 
            SubsuperscriptBox["n", "LL", "it"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"M_sc y_A r_A Y_A R_A c_A a_A n_it\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the self-consistency map, which takes a pair field to ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              RowBox[{"-", 
               FractionBox["1", "2"]}], 
              SubscriptBox[
               StyleBox["G", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "a3a3382f-1b17-4565-ac89-0cc56d296be9"],
           
           " times the pair expectation of the positive-energy eigenvectors \
of ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["\[ScriptCapitalH]",
               FontSlant->"Plain"], 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["lat",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "446af6f5-1b96-4e9b-abb0-c39ccc19a372"],
           " with that pair field, divided by ",
           Cell[BoxData[
            FormBox[
             SuperscriptBox[
              RowBox[{"(", 
               SubsuperscriptBox["\[ScriptL]", 
                StyleBox["LL",
                 FontSlant->"Plain"], 
                StyleBox["x",
                 FontSlant->"Plain"]], ")"}], 
              SubsuperscriptBox[
               StyleBox["n", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["act",
                FontSlant->"Plain"]]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "64d7d7f4-16ff-4341-9fd7-31565442e1ed"],
           
           "; the quantities of the Anderson iteration for its fixed point: \
the iterate (the real and imaginary parts of all ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["d", "TI"], 
              StyleBox["LL",
               FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "421f7e32-9009-48ac-90e2-ce7dfc0b2566"],
           
           " on all sites, as one real vector), its residual (the map applied \
to the iterate, minus the iterate), the matrices whose columns are the \
differences of successive iterates and of successive residuals, the \
coefficients of the least-squares combination, the damping factor, and the \
number of the iteration"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "29b473f6-61a4-4c1d-8bc7-d9dc4ecbcc4b"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox[
             OverscriptBox["x", "\[RightVector]"], "LL", "c"], "\", \"", 
            SubsuperscriptBox["w", "LL", "pk"], "\", \"", 
            SubsuperscriptBox[
             OverscriptBox["q", "\[RightVector]"], "LL", "pk"], "\", \"", 
            SubsuperscriptBox["\[Chi]", "LL", "pk"], "\", \"", 
            SubsuperscriptBox["s", "LL", "br"], "\", \"", 
            RowBox[{
              SubsuperscriptBox[
               TagBox[
                StyleBox[
                "Z", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
                "SL31SansSerif"], "LL", "\[PlusMinus]"], "(", 
              SubscriptBox[
               OverscriptBox["q", "\[RightVector]"], "LL"], ")"}]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"x_c w_pk q_pk chi_pk s_br Zproj\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the Gaussian wave packet of the solvers: its centre, its width \
(the standard deviation of its density), its central momentum, its \
8-component spinor (the projection of a reference spinor of definite spin and \
isospin on the chosen branch at the central momentum), the sign ",
           Cell[BoxData[
            FormBox[
             RowBox[{"\[PlusMinus]", "1"}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "ec44da1f-60cf-4ca7-80e6-4dad0926096d"],
           " of the chosen branch ",
           Cell[BoxData[
            FormBox[
             RowBox[{"\[PlusMinus]", 
              SubsuperscriptBox["\[CurlyEpsilon]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["lat",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "c71313eb-589a-4934-b8d8-e0a76498029f"],
           ", and the projectors ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              FractionBox["1", "2"], 
              RowBox[{"(", 
               RowBox[{
                SubscriptBox[
                 StyleBox["1",
                  FontFamily->"Helvetica",
                  FontSlant->"Plain"], "4"], "\[PlusMinus]", 
                SubsuperscriptBox[
                 StyleBox["h",
                  FontFamily->"Helvetica",
                  FontSlant->"Plain"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["lat",
                  FontSlant->"Plain"]], 
                RowBox[{"(", 
                 SubscriptBox[
                  OverscriptBox[
                   StyleBox["q", "TI"], "\[RightVector]"], 
                  StyleBox["LL",
                   FontSlant->"Plain"]], ")"}], "/", 
                SubsuperscriptBox["\[CurlyEpsilon]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["lat",
                  FontSlant->"Plain"]], 
                RowBox[{"(", 
                 SubscriptBox[
                  OverscriptBox[
                   StyleBox["q", "TI"], "\[RightVector]"], 
                  StyleBox["LL",
                   FontSlant->"Plain"]], ")"}]}], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "1649a665-14d3-45c4-b3bf-e9a534adf71c"],
           
           " on the two branches of the free lattice operator at the momentum \
",
           Cell[BoxData[
            FormBox[
             SubscriptBox[
              OverscriptBox[
               StyleBox["q", "TI"], "\[RightVector]"], 
              StyleBox["LL",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "3e87c538-95dc-4f4d-a4f6-da9e7f7fbc1f"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "d64bc3b9-cf60-4991-bc6b-2e19e694c090"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            RowBox[{
              SubsuperscriptBox[
               TagBox[
                StyleBox[
                "h", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
                "SL31SansSerif"], "LL", "lat"], "(", 
              SubscriptBox[
               OverscriptBox["q", "\[RightVector]"], "LL"], ")"}]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"h_lat_q\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the ",
           Cell[BoxData[
            FormBox[
             RowBox[{"4", "\[Times]", "4"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "ccde2950-61b7-4026-8de9-59538e05ea7d"],
           
           " matrix of the free lattice operator (without isospin) on the \
plane wave ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              StyleBox["exp",
               FontSlant->"Plain"], 
              RowBox[{"(", 
               RowBox[{
                StyleBox["i", "TI"], 
                SubscriptBox[
                 OverscriptBox[
                  StyleBox["q", "TI"], "\[RightVector]"], 
                 StyleBox["LL",
                  FontSlant->"Plain"]], "\[CenterDot]", 
                SubscriptBox[
                 OverscriptBox[
                  StyleBox["x", "TI"], "\[RightVector]"], 
                 StyleBox["LL",
                  FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "1fcb119d-cb5e-485b-8e44-e51f2f741404"],
           ": ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              UnderscriptBox["\[Sum]", 
               StyleBox["j", "TI"],
               LimitsPositioning->True], "\[ThinSpace]", 
              SubsuperscriptBox["\[Alpha]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["j", "TI"]], "\[ThinSpace]", 
              StyleBox["sin",
               FontSlant->"Plain"], 
              RowBox[{"(", 
               RowBox[{
                SubsuperscriptBox[
                 StyleBox["q", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["j", "TI"]], 
                SubsuperscriptBox["\[ScriptL]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["x",
                  FontSlant->"Plain"]]}], ")"}], "/", 
              SubsuperscriptBox["\[ScriptL]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["x",
                FontSlant->"Plain"]], "+", 
              SubscriptBox["\[Beta]", 
               StyleBox["LL",
                FontSlant->"Plain"]], 
              RowBox[{"(", 
               RowBox[{
                SubscriptBox[
                 StyleBox["m", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"]], "+", 
                RowBox[{"(", 
                 RowBox[{
                  SubsuperscriptBox[
                   StyleBox["r", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"], 
                   StyleBox["W",
                    FontSlant->"Plain"]], "/", 
                  SubsuperscriptBox["\[ScriptL]", 
                   StyleBox["LL",
                    FontSlant->"Plain"], 
                   StyleBox["x",
                    FontSlant->"Plain"]]}], ")"}], "\[ThinSpace]", 
                UnderscriptBox["\[Sum]", 
                 StyleBox["j", "TI"],
                 LimitsPositioning->True], 
                RowBox[{"(", 
                 RowBox[{"1", "-", 
                  StyleBox["cos",
                   FontSlant->"Plain"], 
                  RowBox[{"(", 
                   RowBox[{
                    SubsuperscriptBox[
                    StyleBox["q", "TI"], 
                    StyleBox["LL",
                    FontSlant->"Plain"], 
                    StyleBox["j", "TI"]], 
                    SubsuperscriptBox["\[ScriptL]", 
                    StyleBox["LL",
                    FontSlant->"Plain"], 
                    StyleBox["x",
                    FontSlant->"Plain"]]}], ")"}]}], ")"}]}], ")"}]}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "4a08a9b9-81ad-4c77-bb7d-ce90206de662"],
           ", the sums over the active directions; its square is ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox["\[CurlyEpsilon]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["lat",
                FontSlant->"Plain"]], 
              SuperscriptBox[
               RowBox[{"(", 
                SubscriptBox[
                 OverscriptBox[
                  StyleBox["q", "TI"], "\[RightVector]"], 
                 StyleBox["LL",
                  FontSlant->"Plain"]], ")"}], "2"]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "bce53b71-e073-4944-bffa-92c1ee9a3433"],
           " times ",
           Cell[BoxData[
            FormBox[
             SubscriptBox[
              StyleBox["1",
               FontFamily->"Helvetica",
               FontSlant->"Plain"], "4"], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "caf1ba08-3be5-4e3c-b86c-a7611ddd744b"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "59ffb422-b088-4484-82a0-7564f7c239f6"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox[
             OverscriptBox["v", "\[RightVector]"], "LL", "g"], "\", \"", 
            SubsuperscriptBox[
             OverscriptBox["v", "_"], "LL", "g"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"v_g v_g_mean\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the group velocity, the gradient of ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[CurlyEpsilon]", 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["lat",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "8ea300e9-da86-40de-9fd5-143e47e3db9c"],
           " with respect to ",
           Cell[BoxData[
            FormBox[
             SubscriptBox[
              OverscriptBox[
               StyleBox["q", "TI"], "\[RightVector]"], 
              StyleBox["LL",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "507cbe62-a215-4ec5-a6c1-5bbae1c21ea7"],
           ", and its mean over the distribution of momenta of a wave packet"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "d8a717b6-781f-4f75-902d-d27a0ff98e76"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["\[ScriptL]", "LL", "B"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"l_B\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the magnetic length ",
           Cell[BoxData[
            FormBox[
             SuperscriptBox[
              RowBox[{"\[LeftBracketingBar]", 
               SubsuperscriptBox[
                StyleBox["B", "TI"], 
                StyleBox["LL",
                 FontSlant->"Plain"], "\[UpArrow]"], 
               "\[RightBracketingBar]"}], 
              RowBox[{
               RowBox[{"-", "1"}], "/", "2"}]], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "2d3c02f4-7329-4dc1-bfef-abdfffca4d35"],
           " of the isospin-up component in a constant magnetic field"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "95bc52dc-e241-4f20-8a15-16ca7fa60581"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["G", "LL", "\[Prime]"], "\", \"", 
            SubscriptBox[
             OverscriptBox["\[CapitalDelta]", "_"], "LL"], "\", \"", 
            SubsuperscriptBox["\[Omega]", "LL", "H"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"G_quench Delta_mean omega_H\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the coupling after a quench (the coupling is changed from ",
           Cell[BoxData[
            FormBox[
             SubscriptBox[
              StyleBox["G", "TI"], 
              StyleBox["LL",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "54de126f-08c6-4e3e-95d8-bc0510a3d0f5"],
           " to ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["G", "TI"], 
              StyleBox["LL",
               FontSlant->"Plain"], "\[Prime]"], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "824bb642-54a7-450b-a3c1-e0363a4f0106"],
           " at ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["x", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], "0"], "\[LongEqual]", "0"}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "f242792c-19fc-46c9-9b92-88a3120f8f42"],
           "); the mean over the time of the gap ",
           Cell[BoxData[
            FormBox[
             RowBox[{"\[LeftBracketingBar]", 
              SubscriptBox[
               OverscriptBox[
                StyleBox["d", "TI"], "\[RightVector]"], 
               StyleBox["LL",
                FontSlant->"Plain"]], "\[RightBracketingBar]"}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "83a4c0c0-3ae1-4e63-a44a-8b89d7f8ca9a"],
           
           " after the quench; and the angular frequency of the amplitude \
oscillation of the pair field (the amplitude mode, the analogue of the Higgs \
boson)"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "11fb59af-39cf-4a5c-a89d-84f8b57c642f"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["u", "LL", "Bl"], "\", \"", 
            SubsuperscriptBox["v", "LL", "Bl"], "\", \"", 
            SubsuperscriptBox[
             OverscriptBox["b", "\[RightVector]"], "LL", "Bl"], "\", \"", 
            SubsuperscriptBox[
             OverscriptBox["h", "\[RightVector]"], "LL", "Bl"], "\", \"", 
            SubsuperscriptBox[
             OverscriptBox["b", "\[RightVector]"], "LL", "fl"], "\", \"", 
            SubsuperscriptBox["\[CapitalDelta]", "LL", "fl"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"u_Bl v_Bl b_Bl h_Bl b_fl Delta_fl\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the two complex coefficients of a state of the plane spanned by \
the particle vector ",
           Cell[BoxData[
            FormBox[
             RowBox[{"(", 
              RowBox[{
               SubsuperscriptBox["\[Chi]", 
                StyleBox["LL",
                 FontSlant->"Plain"], 
                StyleBox["pw",
                 FontSlant->"Plain"]], ",", "0"}], ")"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "fe1276bc-8642-4e3b-8c8f-15abccd0e16d"],
           " and the hole vector ",
           Cell[BoxData[
            FormBox[
             RowBox[{"(", 
              RowBox[{"0", ",", 
               SubsuperscriptBox[
                StyleBox["K",
                 FontFamily->"Helvetica",
                 FontSlant->"Plain"], 
                StyleBox["LL",
                 FontSlant->"Plain"], "3"], 
               SubsuperscriptBox["\[Chi]", 
                StyleBox["LL",
                 FontSlant->"Plain"], 
                StyleBox["pw",
                 FontSlant->"Plain"]]}], ")"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "c654b720-0901-4a6b-a18a-764313d45682"],
           " of a plane wave, on which the mean-field operator acts as the ",
           Cell[BoxData[
            FormBox[
             RowBox[{"2", "\[Times]", "2"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "b664d566-a9e2-476b-af81-09b004d67a93"],
           " matrix with the rows ",
           Cell[BoxData[
            FormBox[
             RowBox[{"(", 
              RowBox[{
               RowBox[{"\[PlusMinus]", 
                SubscriptBox["\[CurlyEpsilon]", 
                 StyleBox["LL",
                  FontSlant->"Plain"]]}], "-", 
               SubscriptBox["\[Mu]", 
                StyleBox["LL",
                 FontSlant->"Plain"]], ",", 
               SubscriptBox["\[CapitalDelta]", 
                StyleBox["LL",
                 FontSlant->"Plain"]]}], ")"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "e9d5f792-ff90-42b0-8e1f-05ddc1dcc532"],
           " and ",
           Cell[BoxData[
            FormBox[
             RowBox[{"(", 
              RowBox[{
               SubscriptBox["\[CapitalDelta]", 
                StyleBox["LL",
                 FontSlant->"Plain"]], ",", 
               RowBox[{"-", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"\[PlusMinus]", 
                   SubscriptBox["\[CurlyEpsilon]", 
                    StyleBox["LL",
                    FontSlant->"Plain"]]}], "-", 
                  SubscriptBox["\[Mu]", 
                   StyleBox["LL",
                    FontSlant->"Plain"]]}], ")"}]}]}], ")"}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "a4afb66e-a791-4a6a-91ec-8a4f0028f9bc"],
           "; the Bloch vector of that state, the expectation values of ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[Sigma]", "1", 
              StyleBox["LL",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "a307e33f-cd70-45be-a3c5-22d2c8feeac0"],
           ", ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[Sigma]", "2", 
              StyleBox["LL",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "47530999-2278-405e-bd9a-4540913ab588"],
           ", ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[Sigma]", "3", 
              StyleBox["LL",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "ed30ffad-f074-4760-b4a5-e7bbdd3c0571"],
           " in it, and the vector of the coefficients of that ",
           Cell[BoxData[
            FormBox[
             RowBox[{"2", "\[Times]", "2"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "93edfe5e-0c9d-4794-843e-cf978bb04ce5"],
           
           " matrix in the Pauli matrices, about which it precesses; their \
small deviations from the ground state in the linearized equations: the \
deviation of the Bloch vector and of the gap"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "d36f0db7-e5cc-4e0b-997c-75ec4d8b657f"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox[
             TagBox[
              StyleBox["K", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
              "SL31SansSerif"], "LL", "g"], "\", \"", 
            SubsuperscriptBox[
             TagBox[
              StyleBox["K", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
              "SL31SansSerif"], "LL", 
             RowBox[{"g", "\[Prime]"}]]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"Kgen Kgen'\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "two general pair matrices: complex ",
           Cell[BoxData[
            FormBox[
             RowBox[{"8", "\[Times]", "8"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "f636eeb4-763e-4f50-b4b7-8a3b4acd20db"],
           " matrices with which ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox["\[CapitalPsi]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["T", "TI"]], 
              SubsuperscriptBox[
               StyleBox["K",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["g",
                FontSlant->"Plain"]], 
              SubscriptBox["\[CapitalPsi]", 
               StyleBox["LL",
                FontSlant->"Plain"]], "\[LongEqual]", 
              UnderscriptBox["\[Sum]", 
               RowBox[{
                StyleBox["k", "TI"], ",", 
                SuperscriptBox[
                 StyleBox["k", "TI"], "\[Prime]"]}],
               LimitsPositioning->True], 
              SubscriptBox[
               RowBox[{"(", 
                SubsuperscriptBox[
                 StyleBox["K",
                  FontFamily->"Helvetica",
                  FontSlant->"Plain"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["g",
                  FontSlant->"Plain"]], ")"}], 
               RowBox[{
                StyleBox["k", "TI"], 
                SuperscriptBox[
                 StyleBox["k", "TI"], "\[Prime]"]}]], 
              SubscriptBox["\[CapitalPsi]", 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["k", "TI"]}]], 
              SubscriptBox["\[CapitalPsi]", 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                SuperscriptBox[
                 StyleBox["k", "TI"], "\[Prime]"]}]]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "03b2864e-6269-4d68-bb02-dfdebd4ce623"],
           
           " annihilates two spinor charges at one point; only the \
antisymmetric part of a pair matrix contributes, because the components of ",
           Cell[BoxData[
            FormBox[
             SubscriptBox["\[CapitalPsi]", 
              StyleBox["LL",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "023c4b5a-4e5b-4352-8056-efc9de83b5dd"],
           " anticommute"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "496d4132-0a40-4882-9eba-07d980c3e5b3"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox[
             TagBox[
              StyleBox["V", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
              "SL31SansSerif"], "LL", "\[PlusMinus]"], "\", \"", 
            SubsuperscriptBox[
             TagBox[
              StyleBox["B", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
              "SL31SansSerif"], "LL", "W"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"Vblock BW\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the isospin factors of the two Weyl blocks of a Lorentz-invariant \
pair matrix, which is ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              StyleBox["diag",
               FontSlant->"Plain"], 
              RowBox[{"(", 
               RowBox[{
                SubscriptBox[
                 StyleBox["E",
                  FontFamily->"Helvetica",
                  FontSlant->"Plain"], 
                 StyleBox["LL",
                  FontSlant->"Plain"]], "\[CircleTimes]", 
                SubsuperscriptBox[
                 StyleBox["V",
                  FontFamily->"Helvetica",
                  FontSlant->"Plain"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], "-"], ",", 
                SubscriptBox[
                 StyleBox["E",
                  FontFamily->"Helvetica",
                  FontSlant->"Plain"], 
                 StyleBox["LL",
                  FontSlant->"Plain"]], "\[CircleTimes]", 
                SubsuperscriptBox[
                 StyleBox["V",
                  FontFamily->"Helvetica",
                  FontSlant->"Plain"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], "+"]}], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "0cd11eda-0773-47b3-a1d1-d38869efe759"],
           " with two symmetric complex ",
           Cell[BoxData[
            FormBox[
             RowBox[{"2", "\[Times]", "2"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "9e353e5e-465f-4c01-ab34-d626f7e49e5d"],
           " matrices ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["V",
               FontFamily->"Helvetica",
               FontSlant->"Plain"], 
              StyleBox["LL",
               FontSlant->"Plain"], "\[PlusMinus]"], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "ccb3963d-b884-48d2-852f-7aaa19b190b1"],
           " on the isospin index; and a complex ",
           Cell[BoxData[
            FormBox[
             RowBox[{"2", "\[Times]", "2"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "51630c84-5e69-47d8-84fd-9e0b741cff3c"],
           " matrix on the Weyl index, the Weyl factor of a term of a ",
           Cell[BoxData[
            FormBox[
             RowBox[{"4", "\[Times]", "4"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "704ffb64-4c1e-418c-98d8-16a66d08c8e9"],
           
           " block of a pair matrix (in the proof that the Lorentz-invariant \
pairs have this form)"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "1b837fea-fcf1-450b-9a79-65d18bbaba7a"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox[
             TagBox[
              StyleBox["K", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
              "SL31SansSerif"], "LL", 
             RowBox[{"(", "+", "1", ")"}]], "\", \"", 
            SubsuperscriptBox[
             TagBox[
              StyleBox["K", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
              "SL31SansSerif"], "LL", 
             RowBox[{"(", "0", ")"}]], "\", \"", 
            SubsuperscriptBox[
             TagBox[
              StyleBox["K", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
              "SL31SansSerif"], "LL", 
             RowBox[{"(", "-", "1", ")"}]], "\", \"", 
            SubsuperscriptBox["\[CapitalPi]", "LL", 
             RowBox[{"(", "+", "1", ")"}]], "\", \"", 
            SubsuperscriptBox["\[CapitalPi]", "LL", 
             RowBox[{"(", "0", ")"}]], "\", \"", 
            SubsuperscriptBox["\[CapitalPi]", "LL", 
             RowBox[{"(", "-", "1", ")"}]]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"K(+1) K(0) K(-1) Pi(+1) Pi(0) Pi(-1)\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the scalar pair matrices of definite electric charge, ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["K",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               RowBox[{"(", 
                RowBox[{"\[PlusMinus]", "1"}], ")"}]], "\[LongEqual]", 
              RowBox[{"(", 
               RowBox[{
                SubsuperscriptBox[
                 StyleBox["K",
                  FontFamily->"Helvetica",
                  FontSlant->"Plain"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], "1"], "\[MinusPlus]", 
                StyleBox["i", "TI"], 
                SubsuperscriptBox[
                 StyleBox["K",
                  FontFamily->"Helvetica",
                  FontSlant->"Plain"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], "2"]}], ")"}], "/", 
              SqrtBox["2"]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "81a52920-a085-4ca7-bbdb-224eacaeee02"],
           " and ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["K",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               RowBox[{"(", "0", ")"}]], "\[LongEqual]", 
              SubsuperscriptBox[
               StyleBox["K",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"], "3"]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "066071d1-4bb2-4a51-9576-bdb15208fba6"],
           ", and the pair operators ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[CapitalPi]", 
              StyleBox["LL",
               FontSlant->"Plain"], 
              RowBox[{"(", 
               RowBox[{"+", "1"}], ")"}]], TraditionalForm]], "InlineFormula",
            
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "62ab6c6d-8f98-4bd9-87e9-bb850a0e7c47"],
           ", ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[CapitalPi]", 
              StyleBox["LL",
               FontSlant->"Plain"], 
              RowBox[{"(", "0", ")"}]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "762e5250-1244-4624-98e7-994dfd64d92e"],
           ", ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[CapitalPi]", 
              StyleBox["LL",
               FontSlant->"Plain"], 
              RowBox[{"(", 
               RowBox[{"-", "1"}], ")"}]], TraditionalForm]], "InlineFormula",
            
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "31a22d13-f50f-46bc-a5fd-43b31461d419"],
           " made with them, which annihilate a pair of the electric charge ",
           
           Cell[BoxData[
            FormBox[
             RowBox[{"+", "1"}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "8c158799-ee08-4fb0-b9e0-b14993b75be3"],
           " (two isospin-up charges), ",
           Cell[BoxData[
            FormBox["0", TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "89cc5539-7f81-437c-bb26-57ad6dd138c7"],
           " (one isospin-up and one isospin-down charge) and ",
           Cell[BoxData[
            FormBox[
             RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "54391de6-e88c-498a-8caa-60252e6c1677"],
           " (two isospin-down charges)"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "84061185-8a48-4df9-a87c-7575b119b5eb"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["S", "LL", "sp"], "\", \"", 
            SubsuperscriptBox["I", "LL", "v"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"S_sp I_v\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the spin and the isospin of a state of two spinor charges: the \
sums of the squares of the three total spin generators and of the three total \
isospin generators have the eigenvalues ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["S", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["sp",
                FontSlant->"Plain"]], 
              RowBox[{"(", 
               RowBox[{
                SubsuperscriptBox[
                 StyleBox["S", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["sp",
                  FontSlant->"Plain"]], "+", "1"}], ")"}]}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "8238010a-16dd-4910-b6a5-acb8a21f89f2"],
           " and ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["I", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["v",
                FontSlant->"Plain"]], 
              RowBox[{"(", 
               RowBox[{
                SubsuperscriptBox[
                 StyleBox["I", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["v",
                  FontSlant->"Plain"]], "+", "1"}], ")"}]}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "aa52edef-155a-41be-8dc7-3847bee00bf1"],
           "; the superfluid boson singlet has ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["S", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["sp",
                FontSlant->"Plain"]], "\[LongEqual]", "0"}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "972b2c02-b038-44a8-88f7-b532af5eb811"],
           " (spin singlet) and ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["I", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["v",
                FontSlant->"Plain"]], "\[LongEqual]", "1"}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "e2dda0e7-899d-4d53-9677-bebad725303c"],
           " (isospin triplet)"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "3db6e4b6-f37e-4e7d-bf7c-71d598bcc9aa"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            RowBox[{
              SubscriptBox[
               OverscriptBox["c", "^"], 
               RowBox[{"LL", ",", "k"}]], "(", 
              SubscriptBox[
               OverscriptBox["s", "\[RightVector]"], "LL"], ")"}], "\", \"", 
            RowBox[{
              SubsuperscriptBox[
               OverscriptBox["\[CapitalPi]", "^"], "LL", "\[Iota]"], "(", 
              SubscriptBox[
               OverscriptBox["s", "\[RightVector]"], "LL"], ")"}], "\", \"", 
            RowBox[{
              SubsuperscriptBox[
               OverscriptBox["n", "^"], "LL", "F"], "(", 
              SubscriptBox[
               OverscriptBox["s", "\[RightVector]"], "LL"], ")"}], "\", \"", 
            RowBox[{
              SubsuperscriptBox[
               OverscriptBox["n", "^"], "LL", "\[Iota]"], "(", 
              SubscriptBox[
               OverscriptBox["s", "\[RightVector]"], "LL"], ")"}]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"c_site Pi_site n_F_site n_iota_site\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "operators of one lattice site ",
           Cell[BoxData[
            FormBox[
             SubscriptBox[
              OverscriptBox[
               StyleBox["s", "TI"], "\[RightVector]"], 
              StyleBox["LL",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "513ec133-1ec9-4b6f-ac1f-a73f2b9c4259"],
           " (a cell of the volume ",
           Cell[BoxData[
            FormBox[
             SuperscriptBox[
              RowBox[{"(", 
               SubsuperscriptBox["\[ScriptL]", 
                StyleBox["LL",
                 FontSlant->"Plain"], 
                StyleBox["x",
                 FontSlant->"Plain"]], ")"}], "3"], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "5831980d-5269-4a1e-8d41-cb14e4391120"],
           "): the annihilation operators ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubscriptBox[
               OverscriptBox[
                StyleBox["c", "TI"], "^"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["k", "TI"]}]], 
              RowBox[{"(", 
               SubscriptBox[
                OverscriptBox[
                 StyleBox["s", "TI"], "\[RightVector]"], 
                StyleBox["LL",
                 FontSlant->"Plain"]], ")"}], "\[LongEqual]", 
              SuperscriptBox[
               RowBox[{"(", 
                SubsuperscriptBox["\[ScriptL]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["x",
                  FontSlant->"Plain"]], ")"}], 
               RowBox[{"3", "/", "2"}]], 
              SubscriptBox["\[CapitalPsi]", 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["k", "TI"]}]], 
              RowBox[{"(", 
               SubscriptBox[
                OverscriptBox[
                 StyleBox["s", "TI"], "\[RightVector]"], 
                StyleBox["LL",
                 FontSlant->"Plain"]], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "b7bf64ce-9f23-4b4c-9af9-b27ffd9e4502"],
           
           " of the eight components, which obey the canonical \
anticommutation relations; the pair operator of the site ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               OverscriptBox["\[CapitalPi]", "^"], 
               StyleBox["LL",
                FontSlant->"Plain"], "\[Iota]"], "\[LongEqual]", 
              UnderscriptBox["\[Sum]", 
               RowBox[{
                StyleBox["k", "TI"], ",", 
                SuperscriptBox[
                 StyleBox["k", "TI"], "\[Prime]"]}],
               LimitsPositioning->True], 
              SubscriptBox[
               RowBox[{"(", 
                SubsuperscriptBox[
                 StyleBox["K",
                  FontFamily->"Helvetica",
                  FontSlant->"Plain"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], "\[Iota]"], ")"}], 
               RowBox[{
                StyleBox["k", "TI"], 
                SuperscriptBox[
                 StyleBox["k", "TI"], "\[Prime]"]}]], 
              SubscriptBox[
               OverscriptBox[
                StyleBox["c", "TI"], "^"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["k", "TI"]}]], 
              SubscriptBox[
               OverscriptBox[
                StyleBox["c", "TI"], "^"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                SuperscriptBox[
                 StyleBox["k", "TI"], "\[Prime]"]}]]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "40d32d9d-282f-4c43-8eed-be6049bba0af"],
           "; the number of spinor charges on the site ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               OverscriptBox[
                StyleBox["n", "TI"], "^"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["F",
                FontSlant->"Plain"]], "\[LongEqual]", 
              UnderscriptBox["\[Sum]", 
               StyleBox["k", "TI"],
               LimitsPositioning->True], "\[ThinSpace]", 
              SubsuperscriptBox[
               OverscriptBox[
                StyleBox["c", "TI"], "^"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["k", "TI"]}], "\[Dagger]"], 
              SubscriptBox[
               OverscriptBox[
                StyleBox["c", "TI"], "^"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["k", "TI"]}]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "69320c88-a350-47a0-b07b-edee3f697c79"],
           "; and the isospin of the site ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               OverscriptBox[
                StyleBox["n", "TI"], "^"], 
               StyleBox["LL",
                FontSlant->"Plain"], "\[Iota]"], "\[LongEqual]", 
              UnderscriptBox["\[Sum]", 
               RowBox[{
                StyleBox["k", "TI"], ",", 
                SuperscriptBox[
                 StyleBox["k", "TI"], "\[Prime]"]}],
               LimitsPositioning->True], "\[ThinSpace]", 
              SubsuperscriptBox[
               OverscriptBox[
                StyleBox["c", "TI"], "^"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["k", "TI"]}], "\[Dagger]"], 
              SubscriptBox[
               RowBox[{"(", 
                SubsuperscriptBox[
                 StyleBox["T", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], "\[Iota]"], ")"}], 
               RowBox[{
                StyleBox["k", "TI"], 
                SuperscriptBox[
                 StyleBox["k", "TI"], "\[Prime]"]}]], 
              SubscriptBox[
               OverscriptBox[
                StyleBox["c", "TI"], "^"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                SuperscriptBox[
                 StyleBox["k", "TI"], "\[Prime]"]}]]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "38bcceb9-9c16-4425-9c6e-3b983bd36509"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "da62e7c4-91c5-40a7-ac6c-1d5591bf00b2"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox[
             OverscriptBox["H", "^"], "LL", "q"], "\", \"", 
            RowBox[{"|", 
              SubsuperscriptBox["\[CapitalPhi]", "LL", "SF"], 
              "\[RightAngleBracket]"}], "\", \"", 
            RowBox[{"|", 
              SubsuperscriptBox["\[CapitalPhi]", "LL", "N"], 
              "\[RightAngleBracket]"}]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"H_q SF_state Dirac_sea\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the part of the mean-field Hamiltonian of the uniform polar state \
that belongs to one pair of momenta ",
           Cell[BoxData[
            FormBox[
             SubscriptBox[
              OverscriptBox[
               StyleBox["q", "TI"], "\[RightVector]"], 
              StyleBox["LL",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "13320255-10cc-48c0-b4bf-8b1240ff303b"],
           ", ",
           Cell[BoxData[
            FormBox[
             RowBox[{"-", 
              SubscriptBox[
               OverscriptBox[
                StyleBox["q", "TI"], "\[RightVector]"], 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "89b3e15e-49e6-4aa4-897a-0ebff08f9bef"],
           
           " (an operator on 16 fermion modes); the superfluid boson singlet \
state, its ground state, a coherent state of pairs; and the normal state from \
which it is built, the Dirac sea of these modes (every state of energy ",
           Cell[BoxData[
            FormBox[
             RowBox[{"-", 
              SubscriptBox["\[CurlyEpsilon]", 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "a58ca527-ee36-4cb8-9909-8c6a08b16c5b"],
           " filled, every state of energy ",
           Cell[BoxData[
            FormBox[
             RowBox[{"+", 
              SubscriptBox["\[CurlyEpsilon]", 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "9ad39d6d-0af0-4a72-83ab-23d63463f303"],
           " empty)"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "23dea689-d80b-4ad2-a63b-f26665b66ff4"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            RowBox[{
              SubsuperscriptBox[
               OverscriptBox["B", "^"], "LL", "p"], "(", 
              SubscriptBox[
               OverscriptBox["q", "\[RightVector]"], "LL"], ")"}], "\", \"", 
            RowBox[{
              SubsuperscriptBox[
               OverscriptBox["B", "^"], "LL", "a"], "(", 
              SubscriptBox[
               OverscriptBox["q", "\[RightVector]"], "LL"], ")"}], "\", \"", 
            SubsuperscriptBox["t", "LL", "p"], "\", \"", 
            SubsuperscriptBox["t", "LL", "a"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"B_p B_a t_p t_a\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the pair operators of the momenta ",
           Cell[BoxData[
            FormBox[
             SubscriptBox[
              OverscriptBox[
               StyleBox["q", "TI"], "\[RightVector]"], 
              StyleBox["LL",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "c8239f57-9511-4c58-ac7d-011604910e97"],
           " and ",
           Cell[BoxData[
            FormBox[
             RowBox[{"-", 
              SubscriptBox[
               OverscriptBox[
                StyleBox["q", "TI"], "\[RightVector]"], 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "64a51e54-598c-4ddb-ab5b-3c7f279eb73c"],
           " in the scalar isospin channel of ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["K",
               FontFamily->"Helvetica",
               FontSlant->"Plain"], 
              StyleBox["LL",
               FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "6d183c55-087e-4faa-8a26-df4f30d279bd"],
           ": ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               OverscriptBox[
                StyleBox["B", "TI"], "^"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["p",
                FontSlant->"Plain"]], 
              SuperscriptBox[
               RowBox[{"(", 
                SubscriptBox[
                 OverscriptBox[
                  StyleBox["q", "TI"], "\[RightVector]"], 
                 StyleBox["LL",
                  FontSlant->"Plain"]], ")"}], "\[Dagger]"]}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "45b76ba0-8b78-4664-9a29-fe44a6b8de95"],
           
           " creates a pair of spinor charges of positive energy (particles), \
",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               OverscriptBox[
                StyleBox["B", "TI"], "^"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["a",
                FontSlant->"Plain"]], 
              SuperscriptBox[
               RowBox[{"(", 
                SubscriptBox[
                 OverscriptBox[
                  StyleBox["q", "TI"], "\[RightVector]"], 
                 StyleBox["LL",
                  FontSlant->"Plain"]], ")"}], "\[Dagger]"]}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "43b65b8e-0cf9-4f08-a2ea-b91b6e103e9e"],
           
           " removes a pair from the states of negative energy (creates a \
pair of antiparticles); and their weights ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["t", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["p",
                FontSlant->"Plain"]], "\[LongEqual]", 
              SubscriptBox["\[CapitalDelta]", 
               StyleBox["LL",
                FontSlant->"Plain"]], "/", 
              RowBox[{"(", 
               RowBox[{
                SubsuperscriptBox[
                 StyleBox["E", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], "-"], "+", 
                SubscriptBox["\[CurlyEpsilon]", 
                 StyleBox["LL",
                  FontSlant->"Plain"]], "-", 
                SubscriptBox["\[Mu]", 
                 StyleBox["LL",
                  FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "cd39f42c-bc22-46e4-806f-f8c28863811a"],
           " and ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["t", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["a",
                FontSlant->"Plain"]], "\[LongEqual]", 
              SubscriptBox["\[CapitalDelta]", 
               StyleBox["LL",
                FontSlant->"Plain"]], "/", 
              RowBox[{"(", 
               RowBox[{
                SubsuperscriptBox[
                 StyleBox["E", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], "+"], "+", 
                SubscriptBox["\[CurlyEpsilon]", 
                 StyleBox["LL",
                  FontSlant->"Plain"]], "+", 
                SubscriptBox["\[Mu]", 
                 StyleBox["LL",
                  FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "44399ff5-b4ce-41c2-86a1-767d8f11bf56"],
           " in the superfluid boson singlet state"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "de3143bf-ee33-477e-bf45-bfcedd612d7c"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            RowBox[{
              SubsuperscriptBox[
               TagBox[
                StyleBox[
                "Y", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
                "SL31SansSerif"], "LL", "\[PlusMinus]"], "(", 
              SubscriptBox[
               OverscriptBox["q", "\[RightVector]"], "LL"], ")"}], "\", \"", 
            SubscriptBox[
             OverscriptBox["f", "^"], "LL"], "\", \"", 
            SubsuperscriptBox[
             OverscriptBox["f", "^"], "LL", "\[Prime]"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"Yproj f_state f_partner\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the projectors ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              FractionBox["1", "2"], 
              RowBox[{"(", 
               RowBox[{
                SubscriptBox[
                 StyleBox["1",
                  FontFamily->"Helvetica",
                  FontSlant->"Plain"], "8"], "\[PlusMinus]", 
                SubscriptBox[
                 StyleBox["h",
                  FontFamily->"Helvetica",
                  FontSlant->"Plain"], 
                 StyleBox["LL",
                  FontSlant->"Plain"]], 
                RowBox[{"(", 
                 SubscriptBox[
                  OverscriptBox[
                   StyleBox["q", "TI"], "\[RightVector]"], 
                  StyleBox["LL",
                   FontSlant->"Plain"]], ")"}], "/", 
                SubscriptBox["\[CurlyEpsilon]", 
                 StyleBox["LL",
                  FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "56f6ab1d-a084-44eb-ba7d-c407b461a1d1"],
           " on the states of energy ",
           Cell[BoxData[
            FormBox[
             RowBox[{"\[PlusMinus]", 
              SubscriptBox["\[CurlyEpsilon]", 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "ace3397d-1146-42fb-9939-629d4a8abd22"],
           
           " of the plane-wave Hamiltonian (rank 4 each); and the \
annihilation operators of a spinor charge in an eigenstate of ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubscriptBox[
               StyleBox["h",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"]], 
              RowBox[{"(", 
               SubscriptBox[
                OverscriptBox[
                 StyleBox["q", "TI"], "\[RightVector]"], 
                StyleBox["LL",
                 FontSlant->"Plain"]], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "792a79d3-86fc-443a-bca9-64fda84ebb8b"],
           " and in its partner state of the momentum ",
           Cell[BoxData[
            FormBox[
             RowBox[{"-", 
              SubscriptBox[
               OverscriptBox[
                StyleBox["q", "TI"], "\[RightVector]"], 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "f2aa61a1-c060-469d-bc4a-231dcb56ad65"],
           " (the complex conjugate of ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["K",
               FontFamily->"Helvetica",
               FontSlant->"Plain"], 
              StyleBox["LL",
               FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "37c61b12-dd82-4cbb-822d-2a40f882a2dd"],
           " times the eigenvector)"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "e1f1ce84-1484-4527-99e6-9e736192e65b"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["\[ScriptCapitalL]", "LL", "HS"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"Lagr_HS\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the Lagrangian density of the gauge-covariant spinor field after \
the Hubbard-Stratonovich identity: the Lagrangian ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["\[ScriptCapitalL]",
               FontSlant->"Plain"], 
              StyleBox["LL",
               FontSlant->"Plain"], "\[Del]"], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "ea9f435d-a048-4df3-be66-57be399bfcc5"],
           " with its pairing term replaced by ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              RowBox[{"-", 
               UnderscriptBox["\[Sum]", "\[Iota]",
                LimitsPositioning->True]}], 
              SuperscriptBox[
               RowBox[{"\[LeftBracketingBar]", 
                SubsuperscriptBox[
                 StyleBox["d", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], "\[Iota]"], "\[RightBracketingBar]"}], 
               "2"], "/", 
              SubscriptBox[
               StyleBox["G", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"]], "-", 
              FractionBox["1", "2"], "\[ThinSpace]", 
              UnderscriptBox["\[Sum]", "\[Iota]",
               LimitsPositioning->True], 
              RowBox[{"(", 
               RowBox[{
                SuperscriptBox[
                 RowBox[{"(", 
                  SubsuperscriptBox[
                   StyleBox["d", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"], "\[Iota]"], ")"}], "*"], 
                SubsuperscriptBox["\[CapitalPi]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], "\[Iota]"], "+", 
                SubsuperscriptBox[
                 StyleBox["d", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], "\[Iota]"], 
                SuperscriptBox[
                 RowBox[{"(", 
                  SubsuperscriptBox["\[CapitalPi]", 
                   StyleBox["LL",
                    FontSlant->"Plain"], "\[Iota]"], ")"}], "\[Dagger]"]}], 
               ")"}]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "d648177d-a86c-488e-9e45-7f0ed558288e"],
           ", in which ",
           Cell[BoxData[
            FormBox[
             SubscriptBox[
              OverscriptBox[
               StyleBox["d", "TI"], "\[RightVector]"], 
              StyleBox["LL",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "ab906ad1-00bb-4171-8113-596486e1841c"],
           " is an independent complex isovector field"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "cb869b2a-ec7a-4db4-90e3-f0f5a29caf92"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["\[Del]", 
             RowBox[{"LL", ",", "p"}], "B"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"nablaB nablaB_p\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the gauge-covariant derivative of the SFBS field, ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox["\[Del]", 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}], 
               StyleBox["B",
                FontSlant->"Plain"]], 
              SubscriptBox[
               OverscriptBox[
                StyleBox["d", "TI"], "\[RightVector]"], 
               StyleBox["LL",
                FontSlant->"Plain"]], "\[LongEqual]", 
              SubscriptBox["\[PartialD]", 
               StyleBox["p", "TI"]], 
              SubscriptBox[
               OverscriptBox[
                StyleBox["d", "TI"], "\[RightVector]"], 
               StyleBox["LL",
                FontSlant->"Plain"]], "-", "2", 
              StyleBox["i", "TI"], "\[ThinSpace]", 
              SubsuperscriptBox[
               StyleBox["g", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["F",
                FontSlant->"Plain"]], 
              SubsuperscriptBox[
               StyleBox["A", "TI"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}], 
               StyleBox["F",
                FontSlant->"Plain"]], 
              SubscriptBox[
               OverscriptBox[
                StyleBox["d", "TI"], "\[RightVector]"], 
               StyleBox["LL",
                FontSlant->"Plain"]], "+", 
              SubsuperscriptBox[
               StyleBox["g", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["v",
                FontSlant->"Plain"]], 
              SubsuperscriptBox[
               StyleBox["\[ScriptCapitalA]",
                FontSlant->"Plain"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}], 
               StyleBox["v",
                FontSlant->"Plain"]], 
              SubscriptBox[
               OverscriptBox[
                StyleBox["d", "TI"], "\[RightVector]"], 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "eb552349-815f-463a-ba24-724ffd018790"],
           " (fermion number 2, isospin vector, Lorentz scalar)"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "d499e92f-e825-4626-a0d8-9384904e38c4"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["\[ScriptCapitalA]", 
             RowBox[{"LL", ",", "p"}], "v"], "\", \"", 
            SubsuperscriptBox[
             OverscriptBox["A", "\[RightVector]"], 
             RowBox[{"LL", ",", "p"}], "v"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"Avec_matrix Avec_p\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the isospin potential of the direction ",
           Cell[BoxData[
            FormBox[
             StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "c50414c2-d5bd-4618-a54c-1f3f808af517"],
           " in the vector representation: the vector ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               OverscriptBox[
                StyleBox["A", "TI"], "\[RightVector]"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}], 
               StyleBox["v",
                FontSlant->"Plain"]], "\[LongEqual]", 
              RowBox[{"(", 
               RowBox[{
                SubsuperscriptBox[
                 StyleBox["A", "TI"], 
                 RowBox[{
                  StyleBox["LL",
                   FontSlant->"Plain"], ",", 
                  StyleBox["p", "TI"]}], "1"], ",", 
                SubsuperscriptBox[
                 StyleBox["A", "TI"], 
                 RowBox[{
                  StyleBox["LL",
                   FontSlant->"Plain"], ",", 
                  StyleBox["p", "TI"]}], "2"], ",", 
                SubsuperscriptBox[
                 StyleBox["A", "TI"], 
                 RowBox[{
                  StyleBox["LL",
                   FontSlant->"Plain"], ",", 
                  StyleBox["p", "TI"]}], "3"]}], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "62b8d284-2984-45cb-a3b9-e69008c4f7ea"],
           " and the real antisymmetric ",
           Cell[BoxData[
            FormBox[
             RowBox[{"3", "\[Times]", "3"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "fbf4331d-a8e3-4102-b9ed-baf5f6168a0f"],
           " matrix with the entries ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubscriptBox[
               RowBox[{"(", 
                SubsuperscriptBox[
                 StyleBox["\[ScriptCapitalA]",
                  FontSlant->"Plain"], 
                 RowBox[{
                  StyleBox["LL",
                   FontSlant->"Plain"], ",", 
                  StyleBox["p", "TI"]}], 
                 StyleBox["v",
                  FontSlant->"Plain"]], ")"}], 
               RowBox[{"\[Iota]", 
                SuperscriptBox["\[Iota]", "\[Prime]\[Prime]"]}]], "\[LongEqual]", 
              UnderscriptBox["\[Sum]", 
               SuperscriptBox["\[Iota]", "\[Prime]"],
               LimitsPositioning->True], "\[ThinSpace]", 
              SubsuperscriptBox["\[Epsilon]", 
               RowBox[{"\[Iota]", 
                SuperscriptBox["\[Iota]", "\[Prime]"], 
                SuperscriptBox["\[Iota]", "\[Prime]\[Prime]"]}], 
               StyleBox["LL",
                FontSlant->"Plain"]], 
              SubsuperscriptBox[
               StyleBox["A", "TI"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}], 
               SuperscriptBox["\[Iota]", "\[Prime]"]]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "59bc2e1c-666c-4587-be2d-57778497ba37"],
           ", so that ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["\[ScriptCapitalA]",
                FontSlant->"Plain"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}], 
               StyleBox["v",
                FontSlant->"Plain"]], 
              SubscriptBox[
               OverscriptBox[
                StyleBox["d", "TI"], "\[RightVector]"], 
               StyleBox["LL",
                FontSlant->"Plain"]], "\[LongEqual]", 
              SubsuperscriptBox[
               OverscriptBox[
                StyleBox["A", "TI"], "\[RightVector]"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}], 
               StyleBox["v",
                FontSlant->"Plain"]], "\[Times]", 
              SubscriptBox[
               OverscriptBox[
                StyleBox["d", "TI"], "\[RightVector]"], 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "8d7e15c9-a87b-4822-b999-aedab0e86ef7"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "c23f1f97-7dac-414c-878e-aa191a06a3d8"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["\[CapitalPsi]", "LL", "a"], "\", \"", 
            SubsuperscriptBox["\[CapitalPsi]", "LL", "b"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"Psi_a Psi_b\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "two arbitrary eight-component fields that transform like ",
           Cell[BoxData[
            FormBox[
             SubscriptBox["\[CapitalPsi]", 
              StyleBox["LL",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "94e3e94e-6f6e-44b4-b0d7-279d128c75ec"],
           "; used in the Leibniz rule of the covariant derivative of the SFBS"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "86e3edb5-d4c7-444e-bbfb-90be22354489"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["\[ScriptCapitalS]", "LL", "B"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"S_B\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the effective action of the SFBS: ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              StyleBox["exp",
               FontSlant->"Plain"], 
              RowBox[{"(", 
               RowBox[{
                StyleBox["i", "TI"], 
                SubsuperscriptBox[
                 StyleBox["\[ScriptCapitalS]",
                  FontSlant->"Plain"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["B",
                  FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "ab66d96f-dec2-44e8-9d61-102dd9f7776b"],
           " is the functional integral over the spinor field of ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              StyleBox["exp",
               FontSlant->"Plain"], 
              RowBox[{"(", 
               RowBox[{
                StyleBox["i", "TI"], "\[ThinSpace]", "\[Integral]", 
                "\[ThinSpace]", 
                SuperscriptBox[
                 StyleBox["d", "TI"], "4"], 
                SubscriptBox[
                 StyleBox["x", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"]], "\[ThinSpace]", 
                SubsuperscriptBox[
                 StyleBox["\[ScriptCapitalL]",
                  FontSlant->"Plain"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["HS",
                  FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "de77e47d-4126-4603-960c-72ff2abe9af9"],
           " at given ",
           Cell[BoxData[
            FormBox[
             SubscriptBox[
              OverscriptBox[
               StyleBox["d", "TI"], "\[RightVector]"], 
              StyleBox["LL",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "5f5fbf9b-6c46-4c87-8303-c43760178cc1"],
           " and given gauge fields"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "d7dc16ee-9f3e-47cb-8848-e1330e9c7a5a"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["\[ScriptCapitalL]", "LL", "B"], "\", \"", 
            SubsuperscriptBox["Z", "LL", "t"], "\", \"", 
            SubsuperscriptBox["Z", "LL", "s"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"Lagr_B Z_t Z_s Z_t0 Z_s0\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the effective Lagrangian density of the SFBS to second order in \
the derivatives, ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["Z", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["t",
                FontSlant->"Plain"]], "\[ThinSpace]", 
              UnderscriptBox["\[Sum]", "\[Iota]",
               LimitsPositioning->True], 
              SuperscriptBox[
               RowBox[{"\[LeftBracketingBar]", 
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{
                   SubsuperscriptBox["\[Del]", 
                    RowBox[{
                    StyleBox["LL",
                    FontSlant->"Plain"], ",", "0"}], 
                    StyleBox["B",
                    FontSlant->"Plain"]], 
                   SubscriptBox[
                    OverscriptBox[
                    StyleBox["d", "TI"], "\[RightVector]"], 
                    StyleBox["LL",
                    FontSlant->"Plain"]]}], ")"}], "\[Iota]"], 
                "\[RightBracketingBar]"}], "2"], "-", 
              SubsuperscriptBox[
               StyleBox["Z", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["s",
                FontSlant->"Plain"]], "\[ThinSpace]", 
              UnderscriptBox["\[Sum]", 
               StyleBox["j", "TI"],
               LimitsPositioning->True], "\[ThinSpace]", 
              UnderscriptBox["\[Sum]", "\[Iota]",
               LimitsPositioning->True], 
              SuperscriptBox[
               RowBox[{"\[LeftBracketingBar]", 
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{
                   SubsuperscriptBox["\[Del]", 
                    RowBox[{
                    StyleBox["LL",
                    FontSlant->"Plain"], ",", 
                    StyleBox["j", "TI"]}], 
                    StyleBox["B",
                    FontSlant->"Plain"]], 
                   SubscriptBox[
                    OverscriptBox[
                    StyleBox["d", "TI"], "\[RightVector]"], 
                    StyleBox["LL",
                    FontSlant->"Plain"]]}], ")"}], "\[Iota]"], 
                "\[RightBracketingBar]"}], "2"], "-", 
              SubscriptBox["\[CapitalOmega]", 
               StyleBox["LL",
                FontSlant->"Plain"]], 
              RowBox[{"(", 
               SubscriptBox[
                OverscriptBox[
                 StyleBox["d", "TI"], "\[RightVector]"], 
                StyleBox["LL",
                 FontSlant->"Plain"]], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "845f9080-4a42-4548-99b7-b2b4e708d0e7"],
           
           ", and its stiffness coefficients of the time derivatives and of \
the space derivatives; they depend on the vacuum about which the expansion is \
made, written as the argument: ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["Z", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["t",
                FontSlant->"Plain"]], 
              RowBox[{"(", "0", ")"}]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "fc96c8d5-e692-4f01-898a-256fbd97ef15"],
           ", ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["Z", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["s",
                FontSlant->"Plain"]], 
              RowBox[{"(", "0", ")"}]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "f511dae7-92a2-4ba7-a298-652b4db0f4f2"],
           " in the normal vacuum (plain text ",
           StyleBox["Z_t0",
            FontFamily->"Source Code Pro"],
           ", ",
           StyleBox["Z_s0",
            FontFamily->"Source Code Pro"],
           ")"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "3398e7a8-a40e-46ee-81af-cf27a05fdc5e"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            RowBox[{
              SubsuperscriptBox["\[Chi]", "LL", "pr"], "(", 
              SubsuperscriptBox["\[Omega]", "LL", "B"], ",", 
              SubsuperscriptBox["k", "LL", "B"], ")"}]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"chi_pr chi_pr_GL\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the pair susceptibility of the vacuum: the coefficient of ",
           Cell[BoxData[
            FormBox[
             SuperscriptBox[
              RowBox[{"\[LeftBracketingBar]", 
               SubscriptBox[
                OverscriptBox[
                 StyleBox["d", "TI"], "\[RightVector]"], 
                StyleBox["LL",
                 FontSlant->"Plain"]], "\[RightBracketingBar]"}], "2"], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "8721290d-bbb2-4984-abe1-96b9bfc724c5"],
           
           " that the spinor field contributes to the effective action, per \
duration and volume, of a plane wave of the SFBS field with the frequency ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[Omega]", 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["B",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "d43b4eac-3499-4309-946e-f4cc52789b92"],
           " and the wave number ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["k", "TI"], 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["B",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "e617682d-773c-4495-a792-46360b703a11"],
           " (plain text ",
           StyleBox["chi_pr_GL",
            FontFamily->"Source Code Pro"],
           ": its derivative expansion to second order)"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "312cf257-576c-4c79-b40e-7d415f1bfe85"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["\[Omega]", "LL", "B"], "\", \"", 
            SubsuperscriptBox[
             OverscriptBox["k", "\[RightVector]"], "LL", "B"], "\", \"", 
            SubsuperscriptBox["k", "LL", "B"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"omega_B k_B omega_B_KG\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the frequency, the wave vector and the wave number of a plane \
wave of the SFBS field (plain text ",
           StyleBox["omega_B_KG",
            FontFamily->"Source Code Pro"],
           
           ": the frequency of the Klein-Gordon form of the effective field \
equation)"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "607437d9-0faf-4ffb-a95b-8b13b0f129b9"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            RowBox[{
              SubsuperscriptBox["M", "LL", "pr"], "(", 
              SubscriptBox[
               OverscriptBox["q", "\[RightVector]"], "LL"], ",", 
              SubsuperscriptBox[
               OverscriptBox["k", "\[RightVector]"], "LL", "B"], ")"}], 
            "\", \"", 
            RowBox[{
              SubscriptBox["\[CurlyEpsilon]", "LL"], "(", "+", ")"}], 
            "\", \"", 
            RowBox[{
              SubscriptBox["\[CurlyEpsilon]", "LL"], "(", "-", ")"}]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"M_pr eps(+) eps(-)\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the pair matrix element ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              StyleBox["tr",
               FontSlant->"Plain"], 
              RowBox[{"(", 
               RowBox[{
                SubsuperscriptBox[
                 StyleBox["Y",
                  FontFamily->"Helvetica",
                  FontSlant->"Plain"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], "+"], 
                RowBox[{"(", 
                 RowBox[{
                  SubscriptBox[
                   OverscriptBox[
                    StyleBox["q", "TI"], "\[RightVector]"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]], "+", 
                  SubsuperscriptBox[
                   OverscriptBox[
                    StyleBox["k", "TI"], "\[RightVector]"], 
                   StyleBox["LL",
                    FontSlant->"Plain"], 
                   StyleBox["B",
                    FontSlant->"Plain"]], "/", "2"}], ")"}], 
                SubsuperscriptBox[
                 StyleBox["Y",
                  FontFamily->"Helvetica",
                  FontSlant->"Plain"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], "+"], 
                RowBox[{"(", 
                 RowBox[{
                  SubscriptBox[
                   OverscriptBox[
                    StyleBox["q", "TI"], "\[RightVector]"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]], "-", 
                  SubsuperscriptBox[
                   OverscriptBox[
                    StyleBox["k", "TI"], "\[RightVector]"], 
                   StyleBox["LL",
                    FontSlant->"Plain"], 
                   StyleBox["B",
                    FontSlant->"Plain"]], "/", "2"}], ")"}]}], ")"}]}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "8fa38ae2-2209-48b0-9439-df18c07f3d4d"],
           " of two spinor charges with the relative momentum ",
           Cell[BoxData[
            FormBox[
             SubscriptBox[
              OverscriptBox[
               StyleBox["q", "TI"], "\[RightVector]"], 
              StyleBox["LL",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "beb6e327-804f-4d13-9227-2aae9074a451"],
           " and the total momentum ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              OverscriptBox[
               StyleBox["k", "TI"], "\[RightVector]"], 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["B",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "736e7300-9783-48db-8b07-04685f86f371"],
           ", and the energies ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubscriptBox["\[CurlyEpsilon]", 
               StyleBox["LL",
                FontSlant->"Plain"]], 
              RowBox[{"(", "\[PlusMinus]", ")"}], "\[LongEqual]", 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{
                 SuperscriptBox[
                  RowBox[{"\[LeftBracketingBar]", 
                   RowBox[{
                    SubscriptBox[
                    OverscriptBox[
                    StyleBox["q", "TI"], "\[RightVector]"], 
                    StyleBox["LL",
                    FontSlant->"Plain"]], "\[PlusMinus]", 
                    SubsuperscriptBox[
                    OverscriptBox[
                    StyleBox["k", "TI"], "\[RightVector]"], 
                    StyleBox["LL",
                    FontSlant->"Plain"], 
                    StyleBox["B",
                    FontSlant->"Plain"]], "/", "2"}], 
                   "\[RightBracketingBar]"}], "2"], "+", 
                 SubsuperscriptBox[
                  StyleBox["m", "TI"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], "2"]}], ")"}], 
               RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
            
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "4614559b-180c-4d9b-9297-b8c640b66a65"],
           " of the two charges"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "d5b514e8-0fac-4b63-b7d1-f6637d0d1db2"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            RowBox[{
              SubsuperscriptBox[
               TagBox[
                StyleBox[
                "H", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
                "SL31SansSerif"], "LL", "mod"], "(", 
              SubscriptBox[
               OverscriptBox["q", "\[RightVector]"], "LL"], ")"}]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"H_mod\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the ",
           Cell[BoxData[
            FormBox[
             RowBox[{"16", "\[Times]", "16"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "1d21c38a-deb6-4f2e-8908-5a958df7c20e"],
           " Bogoliubov matrix of the static pair field ",
           Cell[BoxData[
            FormBox[
             RowBox[{"(", 
              RowBox[{"0", ",", "0", ",", 
               SubsuperscriptBox[
                StyleBox["d", "TI"], 
                StyleBox["LL",
                 FontSlant->"Plain"], "3"], "\[ThinSpace]", 
               StyleBox["exp",
                FontSlant->"Plain"], 
               RowBox[{"(", 
                RowBox[{
                 StyleBox["i", "TI"], 
                 SubsuperscriptBox[
                  OverscriptBox[
                   StyleBox["k", "TI"], "\[RightVector]"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
                  StyleBox["B",
                   FontSlant->"Plain"]], "\[CenterDot]", 
                 SubscriptBox[
                  OverscriptBox[
                   StyleBox["x", "TI"], "\[RightVector]"], 
                  StyleBox["LL",
                   FontSlant->"Plain"]]}], ")"}]}], ")"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "6aa368fd-85e2-44f1-b53d-75c3d4b16edf"],
           " for the relative momentum ",
           Cell[BoxData[
            FormBox[
             SubscriptBox[
              OverscriptBox[
               StyleBox["q", "TI"], "\[RightVector]"], 
              StyleBox["LL",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "62d9f8fa-71e4-4448-b93a-0854e777f188"],
           ", acting on the Nambu pair ",
           Cell[BoxData[
            FormBox[
             RowBox[{"(", 
              RowBox[{
               SubscriptBox["\[CapitalPsi]", 
                StyleBox["LL",
                 FontSlant->"Plain"]], 
               RowBox[{"(", 
                RowBox[{
                 SubscriptBox[
                  OverscriptBox[
                   StyleBox["q", "TI"], "\[RightVector]"], 
                  StyleBox["LL",
                   FontSlant->"Plain"]], "+", 
                 SubsuperscriptBox[
                  OverscriptBox[
                   StyleBox["k", "TI"], "\[RightVector]"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
                  StyleBox["B",
                   FontSlant->"Plain"]], "/", "2"}], ")"}], ",", 
               SubscriptBox["\[CapitalPsi]", 
                StyleBox["LL",
                 FontSlant->"Plain"]], 
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{
                  SubsuperscriptBox[
                   OverscriptBox[
                    StyleBox["k", "TI"], "\[RightVector]"], 
                   StyleBox["LL",
                    FontSlant->"Plain"], 
                   StyleBox["B",
                    FontSlant->"Plain"]], "/", "2", "-", 
                  SubscriptBox[
                   OverscriptBox[
                    StyleBox["q", "TI"], "\[RightVector]"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]]}], ")"}], "*"]}], ")"}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "419910fd-df82-4cad-8445-f83939819394"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "58a72dc1-dd1c-4a47-82b4-ff7095a1a52a"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["G", "LL", "bd"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"G_bind\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the binding coupling, ",
           Cell[BoxData[
            FormBox[
             RowBox[{"1", "/", 
              SubsuperscriptBox[
               StyleBox["G", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["bd",
                FontSlant->"Plain"]], "\[LongEqual]", 
              SubsuperscriptBox["\[Chi]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["pr",
                FontSlant->"Plain"]], 
              RowBox[{"(", 
               RowBox[{"2", 
                SubscriptBox[
                 StyleBox["m", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"]], ",", "0"}], ")"}]}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "e941e0c1-2316-4d91-bfaf-8505c14441df"],
           ": for ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["G", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["bd",
                FontSlant->"Plain"]], "<", 
              SubscriptBox[
               StyleBox["G", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"]], "<", 
              SubsuperscriptBox[
               StyleBox["G", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["crit",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "ece8d372-105f-4671-afd7-cd07f2bf7faf"],
           
           " the SFBS of the normal vacuum is a bound state of two spinor \
charges"
