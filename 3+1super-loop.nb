               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[Cell[TextData[{
               "the energy ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubscriptBox["\[CurlyEpsilon]", 
                   StyleBox["LL",
                    FontSlant->"Plain"]], "\[LongEqual]", 
                  SuperscriptBox[
                   RowBox[{"(", 
                    RowBox[{
                    SubsuperscriptBox[
                    StyleBox["q", "TI"], 
                    StyleBox["LL",
                    FontSlant->"Plain"], "2"], "+", 
                    SubsuperscriptBox[
                    StyleBox["m", "TI"], 
                    StyleBox["LL",
                    FontSlant->"Plain"], "2"]}], ")"}], 
                   RowBox[{"1", "/", "2"}]]}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "2fbe28d4-e781-48bf-914d-387cbb373932"],
               ", the quasi-particle energies of the scalar channel ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubsuperscriptBox[
                   StyleBox["E", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"], "\[PlusMinus]"], "\[LongEqual]", 
                  SuperscriptBox[
                   RowBox[{"[", 
                    RowBox[{
                    SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{
                    SubscriptBox["\[CurlyEpsilon]", 
                    StyleBox["LL",
                    FontSlant->"Plain"]], "\[PlusMinus]", 
                    SubscriptBox["\[Mu]", 
                    StyleBox["LL",
                    FontSlant->"Plain"]]}], ")"}], "2"], "+", 
                    SubsuperscriptBox["\[CapitalDelta]", 
                    StyleBox["LL",
                    FontSlant->"Plain"], "2"]}], "]"}], 
                   RowBox[{"1", "/", "2"}]]}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "2ca1c0d8-905c-4d6d-8775-0d595e03be72"],
               ", a function of the gap (written ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubsuperscriptBox[
                   StyleBox["E", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"], "\[PlusMinus]"], 
                  RowBox[{"(", 
                   SubsuperscriptBox["\[CapitalDelta]", 
                    StyleBox["LL",
                    FontSlant->"Plain"], "+"], ")"}]}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "913a2989-4e43-464f-9e65-c8508208ce38"],
               " and ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubsuperscriptBox[
                   StyleBox["E", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"], "\[PlusMinus]"], 
                  RowBox[{"(", 
                   SubsuperscriptBox["\[CapitalDelta]", 
                    StyleBox["LL",
                    FontSlant->"Plain"], "-"], ")"}]}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "b9e8bc43-741b-487a-a775-850323f80b78"],
               " when ",
               Cell[BoxData[
                FormBox[
                 SubscriptBox["\[CapitalDelta]", 
                  StyleBox["LL",
                   FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "4ebbfd46-b69d-44b3-a4cf-7c1fabeb2902"],
               
               " is replaced by one of the two gaps of a general state), and \
those of the pseudoscalar channel, ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SuperscriptBox[
                   RowBox[{"(", 
                    SubsuperscriptBox[
                    OverscriptBox[
                    StyleBox["E", "TI"], "~"], 
                    StyleBox["LL",
                    FontSlant->"Plain"], "\[PlusMinus]"], ")"}], "2"], "\[LongEqual]", 
                  SubsuperscriptBox["\[CurlyEpsilon]", 
                   StyleBox["LL",
                    FontSlant->"Plain"], "2"], "+", 
                  SubsuperscriptBox["\[Mu]", 
                   StyleBox["LL",
                    FontSlant->"Plain"], "2"], "+", 
                  SubsuperscriptBox["\[CapitalDelta]", 
                   StyleBox["LL",
                    FontSlant->"Plain"], "2"], "\[PlusMinus]", "2", 
                  SuperscriptBox[
                   RowBox[{"[", 
                    RowBox[{
                    SubsuperscriptBox["\[Mu]", 
                    StyleBox["LL",
                    FontSlant->"Plain"], "2"], 
                    SubsuperscriptBox["\[CurlyEpsilon]", 
                    StyleBox["LL",
                    FontSlant->"Plain"], "2"], "+", 
                    SubsuperscriptBox[
                    StyleBox["m", "TI"], 
                    StyleBox["LL",
                    FontSlant->"Plain"], "2"], 
                    SubsuperscriptBox["\[CapitalDelta]", 
                    StyleBox["LL",
                    FontSlant->"Plain"], "2"]}], "]"}], 
                   RowBox[{"1", "/", "2"}]]}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "89fa6021-6e87-4d89-be6d-f5eb1bcf2949"]
              }], "Text",
               FontFamily->"Source Sans Pro",
               FontSize->9.5,ExpressionUUID->
               "07c79ab1-cac4-4917-8537-dc6df5c24f03"],
              ImageSize->290]},
            {
             PaneBox[
              TemplateBox[{
                SubscriptBox["G", "LL"], "\", \"", 
                SubsuperscriptBox["G", "LL", "crit"]},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              StyleBox["\<\"G G_crit G_over_Gcrit_m0 G_crit_mu0_m0\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[Cell[TextData[{
               
               "the coupling of the attractive spin-zero contact interaction \
(dimension mass",
               Cell[BoxData[
                FormBox[
                 SuperscriptBox["", 
                  RowBox[{"-", "2"}]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "0a6cf2cc-603f-4a98-82a5-7b93b482a206"],
               ") and its critical value at ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubscriptBox["\[Mu]", 
                   StyleBox["LL",
                    FontSlant->"Plain"]], "\[LongEqual]", "0"}], 
                 TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "69bb4c98-fc49-4670-b56a-281394f8bdd2"],
               ", above which the vacuum condenses"
              }], "Text",
               FontFamily->"Source Sans Pro",
               FontSize->9.5,ExpressionUUID->
               "5ccb2bb1-50f4-4098-8411-be2bbb3972f8"],
              ImageSize->290]},
            {
             PaneBox[
              TemplateBox[{
                SubsuperscriptBox["\[ScriptCapitalH]", "LL", "sf"]},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              StyleBox["\<\"Hsf\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[Cell[TextData[{
               "the Hamiltonian of the superfluid, ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  UnderscriptBox["\[Sum]", 
                   SubscriptBox[
                    OverscriptBox[
                    StyleBox["q", "TI"], "\[RightVector]"], 
                    StyleBox["LL",
                    FontSlant->"Plain"]],
                   LimitsPositioning->True], "\[ThinSpace]", 
                  SubsuperscriptBox["\[CapitalPsi]", 
                   StyleBox["LL",
                    FontSlant->"Plain"], "\[Dagger]"], 
                  RowBox[{"(", 
                   RowBox[{
                    SubscriptBox[
                    StyleBox["h",
                    FontFamily->"Helvetica",
                    FontSlant->"Plain"], 
                    StyleBox["LL",
                    FontSlant->"Plain"]], "-", 
                    SubscriptBox["\[Mu]", 
                    StyleBox["LL",
                    FontSlant->"Plain"]]}], ")"}], 
                  SubscriptBox["\[CapitalPsi]", 
                   StyleBox["LL",
                    FontSlant->"Plain"]], "-", 
                  FractionBox["1", "4"], 
                  SubscriptBox[
                   StyleBox["G", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]], "\[ThinSpace]", 
                  UnderscriptBox["\[Sum]", "\[Iota]",
                   LimitsPositioning->True], 
                  SuperscriptBox[
                   RowBox[{"(", 
                    SubsuperscriptBox["\[CapitalPi]", 
                    StyleBox["LL",
                    FontSlant->"Plain"], "\[Iota]"], ")"}], "\[Dagger]"], 
                  SubsuperscriptBox["\[CapitalPi]", 
                   StyleBox["LL",
                    FontSlant->"Plain"], "\[Iota]"]}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "2f3ef73c-5b21-4468-9c7a-055588945947"]
              }], "Text",
               FontFamily->"Source Sans Pro",
               FontSize->9.5,ExpressionUUID->
               "572e82da-f215-42e6-965a-c5d6ea16d96b"],
              ImageSize->290]},
            {
             PaneBox[
              TemplateBox[{
                RowBox[{
                  SubscriptBox[
                   TagBox[
                    StyleBox[
                    "h", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
                    "SL31SansSerif"], "LL"], "(", 
                  SubscriptBox[
                   OverscriptBox["q", "\[RightVector]"], "LL"], ")"}]},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              StyleBox["\<\"h(q)\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[Cell[TextData[{
               "the ",
               Cell[BoxData[
                FormBox[
                 RowBox[{"8", "\[Times]", "8"}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "1dac1628-a5eb-4a6a-9e50-acf88dd27b97"],
               " Hamiltonian matrix of a plane wave, ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  UnderscriptBox["\[Sum]", 
                   StyleBox["j", "TI"],
                   LimitsPositioning->True], "\[ThinSpace]", 
                  SubsuperscriptBox["\[Alpha]", 
                   StyleBox["LL",
                    FontSlant->"Plain"], 
                   StyleBox["j", "TI"]], 
                  SubsuperscriptBox[
                   StyleBox["q", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"], 
                   StyleBox["j", "TI"]], "+", 
                  SubscriptBox["\[Beta]", 
                   StyleBox["LL",
                    FontSlant->"Plain"]], 
                  SubscriptBox[
                   StyleBox["m", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "c939d5e3-d293-4c9a-85ed-bef9aaa91e30"],
               " (times ",
               Cell[BoxData[
                FormBox[
                 SubsuperscriptBox["\[Sigma]", "0", 
                  StyleBox["LL",
                   FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "03fd02da-ef2d-4265-86e3-6867d6838bdb"],
               " on the isospin index); eigenvalues ",
               Cell[BoxData[
                FormBox[
                 RowBox[{"\[PlusMinus]", 
                  SubscriptBox["\[CurlyEpsilon]", 
                   StyleBox["LL",
                    FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "1d0a3061-99cf-4fbf-b7a6-b1dc5ac91d6e"]
              }], "Text",
               FontFamily->"Source Sans Pro",
               FontSize->9.5,ExpressionUUID->
               "7d3421ff-aa1a-45bc-a3f4-545e3da44318"],
              ImageSize->290]},
            {
             PaneBox[
              TemplateBox[{
                SubscriptBox[
                 OverscriptBox["d", "\[RightVector]"], "LL"], "\", \"", 
                SubsuperscriptBox["d", "LL", "\[Iota]"], "\", \"", 
                SubscriptBox["\[Zeta]", "LL"]},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              StyleBox["\<\"dvec d_iota abs_dvec_at_min zeta\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[Cell[TextData[{
               "the order parameter, the isospin vector ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubscriptBox[
                   OverscriptBox[
                    StyleBox["d", "TI"], "\[RightVector]"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]], "\[LongEqual]", 
                  RowBox[{"(", 
                   RowBox[{
                    SubsuperscriptBox[
                    StyleBox["d", "TI"], 
                    StyleBox["LL",
                    FontSlant->"Plain"], "1"], ",", 
                    SubsuperscriptBox[
                    StyleBox["d", "TI"], 
                    StyleBox["LL",
                    FontSlant->"Plain"], "2"], ",", 
                    SubsuperscriptBox[
                    StyleBox["d", "TI"], 
                    StyleBox["LL",
                    FontSlant->"Plain"], "3"]}], ")"}], "\[Element]", 
                  SuperscriptBox[
                   StyleBox["\[DoubleStruckCapitalC]",
                    FontSlant->"Plain"], "3"]}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "8e3e0e9e-811d-4a54-9bb0-ab1c4143c556"],
               " with ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubsuperscriptBox[
                   StyleBox["d", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"], "\[Iota]"], "\[LongEqual]", 
                  RowBox[{"-", 
                   FractionBox["1", "2"]}], 
                  SubscriptBox[
                   StyleBox["G", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]], 
                  RowBox[{"\[LeftAngleBracket]", 
                   SubsuperscriptBox["\[CapitalPi]", 
                    StyleBox["LL",
                    FontSlant->"Plain"], "\[Iota]"], 
                   "\[RightAngleBracket]"}]}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "e41e463c-302e-42d0-b8b5-baa2256a927f"],
               ", and its non-unitarity ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  RowBox[{
                   SubscriptBox["\[Zeta]", 
                    StyleBox["LL",
                    FontSlant->"Plain"]], "\[LongEqual]", 
                   RowBox[{
                    RowBox[{"\[LeftBracketingBar]", 
                    RowBox[{
                    SubscriptBox[
                    OverscriptBox[
                    StyleBox["d", "TI"], "\[RightVector]"], 
                    StyleBox["LL",
                    FontSlant->"Plain"]], "\[Times]", 
                    SubsuperscriptBox[
                    OverscriptBox[
                    StyleBox["d", "TI"], "\[RightVector]"], 
                    StyleBox["LL",
                    FontSlant->"Plain"], 
                    RowBox[{"\[ThinSpace]", "*"}]]}], 
                    "\[RightBracketingBar]"}], "/", 
                    SuperscriptBox[
                    RowBox[{"\[LeftBracketingBar]", 
                    SubscriptBox[
                    OverscriptBox[
                    StyleBox["d", "TI"], "\[RightVector]"], 
                    StyleBox["LL",
                    FontSlant->"Plain"]], "\[RightBracketingBar]"}], "2"]}]}],
                   "\[Element]", 
                  RowBox[{"[", 
                   RowBox[{"0", ",", "1"}], "]"}]}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "94641fb9-bb41-4764-84d8-2e889a3f412d"],
               " (plain text ",
               StyleBox["cross(dvec, dvec^*)",
                FontFamily->"Source Code Pro"],
               ": the cross product)"
              }], "Text",
               FontFamily->"Source Sans Pro",
               FontSize->9.5,ExpressionUUID->
               "9260931f-87c6-41c9-8351-c67498ac9a63"],
              ImageSize->290]},
            {
             PaneBox[
              TemplateBox[{
                SubscriptBox["\[CapitalDelta]", "LL"], "\", \"", 
                SubsuperscriptBox["\[CapitalDelta]", "LL", "\[PlusMinus]"]},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              StyleBox["\<\"Delta Delta_+ Delta_- Delta_(+-)\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[Cell[TextData[{
               "the gap: ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubscriptBox["\[CapitalDelta]", 
                   StyleBox["LL",
                    FontSlant->"Plain"]], "\[LongEqual]", 
                  RowBox[{"\[LeftBracketingBar]", 
                   SubscriptBox[
                    OverscriptBox[
                    StyleBox["d", "TI"], "\[RightVector]"], 
                    StyleBox["LL",
                    FontSlant->"Plain"]], "\[RightBracketingBar]"}]}], 
                 TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "05afab2f-d198-4a31-aa89-70ae38659841"],
               " for a unitary state, and the two gaps ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SuperscriptBox[
                   RowBox[{"(", 
                    SubsuperscriptBox["\[CapitalDelta]", 
                    StyleBox["LL",
                    FontSlant->"Plain"], "\[PlusMinus]"], ")"}], "2"], "\[LongEqual]", 
                  SuperscriptBox[
                   RowBox[{"\[LeftBracketingBar]", 
                    SubscriptBox[
                    OverscriptBox[
                    StyleBox["d", "TI"], "\[RightVector]"], 
                    StyleBox["LL",
                    FontSlant->"Plain"]], "\[RightBracketingBar]"}], "2"], 
                  RowBox[{"(", 
                   RowBox[{"1", "\[PlusMinus]", 
                    SubscriptBox["\[Zeta]", 
                    StyleBox["LL",
                    FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "c3ed9374-8853-4f36-b8f5-9a3cda8ad5b1"],
               " of a general state"
              }], "Text",
               FontFamily->"Source Sans Pro",
               FontSize->9.5,ExpressionUUID->
               "4e82c534-4321-43f4-a9e0-532acd9b17ff"],
              ImageSize->290]},
            {
             PaneBox[
              TemplateBox[{
                SubscriptBox[
                 TagBox[
                  StyleBox[
                  "P", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
                  "SL31SansSerif"], "LL"], "\", \"", 
                RowBox[{
                  SubscriptBox[
                   TagBox[
                    StyleBox[
                    "H", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
                    "SL31SansSerif"], "LL"], "(", 
                  SubscriptBox[
                   OverscriptBox["q", "\[RightVector]"], "LL"], ")"}], 
                "\", \"", 
                RowBox[{
                  SubscriptBox["\[ScriptCapitalN]", "LL"], "(", 
                  SubscriptBox[
                   OverscriptBox["q", "\[RightVector]"], "LL"], ")"}]},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              StyleBox["\<\"Ppair H_BdG\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[Cell[TextData[{
               "the pairing block ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubscriptBox[
                   StyleBox["P",
                    FontFamily->"Helvetica",
                    FontSlant->"Plain"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]], "\[LongEqual]", 
                  UnderscriptBox["\[Sum]", "\[Iota]",
                   LimitsPositioning->True], "\[ThinSpace]", 
                  SubsuperscriptBox[
                   StyleBox["d", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"], "\[Iota]"], 
                  SuperscriptBox[
                   RowBox[{"(", 
                    SubsuperscriptBox[
                    StyleBox["K",
                    FontFamily->"Helvetica",
                    FontSlant->"Plain"], 
                    StyleBox["LL",
                    FontSlant->"Plain"], "\[Iota]"], ")"}], "\[Dagger]"]}], 
                 TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "9949d84e-88eb-4d8a-a54f-e7a24eca137a"],
               ", the ",
               Cell[BoxData[
                FormBox[
                 RowBox[{"16", "\[Times]", "16"}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "5482d38f-c1ff-4869-8074-d0cfb6fca9ce"],
               " Bogoliubov-de Gennes matrix ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubscriptBox[
                   StyleBox["H",
                    FontFamily->"Helvetica",
                    FontSlant->"Plain"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]], "\[LongEqual]", 
                  RowBox[{"(", "\[NoBreak]", GridBox[{
                    {
                    RowBox[{
                    SubscriptBox[
                    StyleBox["h",
                    FontFamily->"Helvetica",
                    FontSlant->"Plain"], 
                    StyleBox["LL",
                    FontSlant->"Plain"]], 
                    RowBox[{"(", 
                    SubscriptBox[
                    OverscriptBox[
                    StyleBox["q", "TI"], "\[RightVector]"], 
                    StyleBox["LL",
                    FontSlant->"Plain"]], ")"}], "-", 
                    SubscriptBox["\[Mu]", 
                    StyleBox["LL",
                    FontSlant->"Plain"]]}], 
                    SubscriptBox[
                    StyleBox["P",
                    FontFamily->"Helvetica",
                    FontSlant->"Plain"], 
                    StyleBox["LL",
                    FontSlant->"Plain"]]},
                    {
                    SubsuperscriptBox[
                    StyleBox["P",
                    FontFamily->"Helvetica",
                    FontSlant->"Plain"], 
                    StyleBox["LL",
                    FontSlant->"Plain"], "\[Dagger]"], 
                    RowBox[{"-", 
                    SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{
                    SubscriptBox[
                    StyleBox["h",
                    FontFamily->"Helvetica",
                    FontSlant->"Plain"], 
