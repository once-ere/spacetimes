          StyleBox["\<\"Lagr_kin L_kin\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[
          StyleBox[
           
           TemplateBox[{
            "\"the kinetic Lagrangian of the SFBS, the part of \"", 
             FormBox[
              SubsuperscriptBox[
               StyleBox["L", "TI"], "LL", "B"], TraditionalForm], 
             "\" that contains the derivatives, \"", 
             FormBox[
              RowBox[{
                SubsuperscriptBox[
                 StyleBox["Z", "TI"], "LL", "t"], 
                UnderscriptBox[
                "\[Sum]", "\[Iota]", LimitsPositioning -> True], "|", 
                SuperscriptBox[
                 RowBox[{"(", 
                   RowBox[{
                    SubsuperscriptBox["\[Del]", 
                    RowBox[{"LL", ",", "0"}], "B"], 
                    SubscriptBox[
                    OverscriptBox[
                    StyleBox["d", "TI"], "\[RightVector]"], "LL"]}], ")"}], 
                 "\[Iota]"], 
                SuperscriptBox["|", "2"], "-", 
                SubsuperscriptBox[
                 StyleBox["Z", "TI"], "LL", "s"], 
                UnderscriptBox["\[Sum]", 
                 StyleBox["j", "TI"], LimitsPositioning -> True], 
                UnderscriptBox[
                "\[Sum]", "\[Iota]", LimitsPositioning -> True], "|", 
                SuperscriptBox[
                 RowBox[{"(", 
                   RowBox[{
                    SubsuperscriptBox["\[Del]", 
                    RowBox[{"LL", ",", 
                    StyleBox["j", "TI"]}], "B"], 
                    SubscriptBox[
                    OverscriptBox[
                    StyleBox["d", "TI"], "\[RightVector]"], "LL"]}], ")"}], 
                 "\[Iota]"], 
                SuperscriptBox["|", "2"]}], TraditionalForm], 
             "\", so that \"", 
             FormBox[
              RowBox[{
                SubsuperscriptBox[
                 StyleBox["L", "TI"], "LL", "B"], "\[LongEqual]", 
                SubsuperscriptBox[
                 StyleBox["L", "TI"], "LL", "kin"], "-", 
                SubscriptBox["\[CapitalOmega]", "LL"], 
                RowBox[{"(", 
                  SubscriptBox[
                   OverscriptBox[
                    StyleBox["d", "TI"], "\[RightVector]"], "LL"], ")"}]}], 
              TraditionalForm]},
            "RowDefault"],
           StripOnInput->False,
           FontFamily->"Source Sans Pro",
           FontSize->9.5],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            RowBox[{
              SubsuperscriptBox[
               TagBox[
                StyleBox[
                "N", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
                "SL31SansSerif"], "LL", "g"], "(", 
              SubscriptBox[
               OverscriptBox["d", "\[RightVector]"], "LL"], ")"}], "\", \"", 
            RowBox[{
              SubsuperscriptBox[
               TagBox[
                StyleBox[
                "N", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
                "SL31SansSerif"], "LL", "v"], "(", 
              SubscriptBox[
               OverscriptBox["d", "\[RightVector]"], "LL"], ")"}], "\", \"", 
            SubsuperscriptBox[
             OverscriptBox["w", "\[RightVector]"], "LL", "n"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"N_g N_v w_n\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[
          StyleBox[
           TemplateBox[{"\"the contact matrix: the real symmetric \"", 
             FormBox[
              RowBox[{"4", "\[Cross]", "4"}], TraditionalForm], 
             "\" matrix of the terms of \"", 
             FormBox[
              RowBox[{
                UnderscriptBox[
                "\[Sum]", "\[Iota]", LimitsPositioning -> True], "|", 
                SuperscriptBox[
                 RowBox[{"(", 
                   RowBox[{
                    SubsuperscriptBox["\[Del]", 
                    RowBox[{"LL", ",", 
                    StyleBox["p", "TI"]}], "B"], 
                    SubscriptBox[
                    OverscriptBox[
                    StyleBox["d", "TI"], "\[RightVector]"], "LL"]}], ")"}], 
                 "\[Iota]"], 
                SuperscriptBox["|", "2"]}], TraditionalForm], 
             "\" that are quadratic in the potentials \"", 
             FormBox[
              RowBox[{"(", 
                RowBox[{
                  SubsuperscriptBox[
                   StyleBox["A", "TI"], 
                   RowBox[{"LL", ",", 
                    StyleBox["p", "TI"]}], "F"], ",", 
                  SubsuperscriptBox[
                   StyleBox["A", "TI"], 
                   RowBox[{"LL", ",", 
                    StyleBox["p", "TI"]}], "1"], ",", 
                  SubsuperscriptBox[
                   StyleBox["A", "TI"], 
                   RowBox[{"LL", ",", 
                    StyleBox["p", "TI"]}], "2"], ",", 
                  SubsuperscriptBox[
                   StyleBox["A", "TI"], 
                   RowBox[{"LL", ",", 
                    StyleBox["p", "TI"]}], "3"]}], ")"}], TraditionalForm], 
             "\", with the corner entry \"", 
             FormBox[
              RowBox[{"4", 
                SuperscriptBox[
                 RowBox[{"(", 
                   SubsuperscriptBox[
                    StyleBox["g", "TI"], "LL", "F"], ")"}], "2"], "|", 
                SubscriptBox[
                 OverscriptBox[
                  StyleBox["d", "TI"], "\[RightVector]"], "LL"], 
                SuperscriptBox["|", "2"]}], TraditionalForm], 
             "\", the first row and column \"", 
             FormBox[
              RowBox[{"4", 
                SubsuperscriptBox[
                 StyleBox["g", "TI"], "LL", "F"], 
                SubsuperscriptBox[
                 StyleBox["g", "TI"], "LL", "v"], 
                SuperscriptBox[
                 RowBox[{"(", 
                   SubsuperscriptBox[
                    StyleBox["w", "TI"], "LL", "n"], ")"}], "\[Iota]"]}], 
              TraditionalForm], "\" and the isospin block \"", 
             FormBox[
              RowBox[{
                SuperscriptBox[
                 RowBox[{"(", 
                   SubsuperscriptBox[
                    StyleBox["g", "TI"], "LL", "v"], ")"}], "2"], 
                SubsuperscriptBox[
                 StyleBox["N", FontSlant -> "Plain"], "LL", "v"]}], 
              TraditionalForm], "\", whose entries are \"", 
             FormBox[
              RowBox[{"|", 
                SubscriptBox[
                 OverscriptBox[
                  StyleBox["d", "TI"], "\[RightVector]"], "LL"], 
                SuperscriptBox["|", "2"], "-", "|", 
                SubsuperscriptBox[
                 StyleBox["d", "TI"], "LL", "\[Iota]"], 
                SuperscriptBox["|", "2"]}], TraditionalForm], 
             "\" on the diagonal and \"", 
             FormBox[
              RowBox[{"-", "Re", 
                RowBox[{"(", 
                  RowBox[{
                    SubsuperscriptBox[
                    StyleBox["d", "TI"], "LL", "\[Iota]"], 
                    SuperscriptBox[
                    RowBox[{"(", 
                    SubsuperscriptBox[
                    StyleBox["d", "TI"], "LL", 
                    SuperscriptBox["\[Iota]", "\[Prime]"]], ")"}], "*"]}], 
                  ")"}]}], TraditionalForm], 
             "\" off it; and the real vector \"", 
             FormBox[
              RowBox[{
                SubsuperscriptBox[
                 OverscriptBox[
                  StyleBox["w", "TI"], "\[RightVector]"], "LL", "n"], 
                "\[LongEqual]", "Re", " ", 
                SubscriptBox[
                 OverscriptBox[
                  StyleBox["d", "TI"], "\[RightVector]"], "LL"], "\[Cross]", 
                "Im", " ", 
                SubscriptBox[
                 OverscriptBox[
                  StyleBox["d", "TI"], "\[RightVector]"], "LL"]}], 
              TraditionalForm], "\", zero for the polar fields\""},
            "RowDefault"],
           StripOnInput->False,
           FontFamily->"Source Sans Pro",
           FontSize->9.5],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["E", "LL", "c"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"E_c E_Lambda\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[
          StyleBox[
           
           TemplateBox[{
            "\"the quasi-particle energy of the condensed vacuum \"", 
             FormBox[
              RowBox[{"(", 
                RowBox[{"0", ",", "0", ",", 
                  SubscriptBox["\[CapitalDelta]", "LL"]}], ")"}], 
              TraditionalForm], "\" at \"", 
             FormBox[
              RowBox[{
                SubscriptBox["\[Mu]", "LL"], "\[LongEqual]", "0"}], 
              TraditionalForm], "\", \"", 
             FormBox[
              RowBox[{
                SubsuperscriptBox[
                 StyleBox["E", "TI"], "LL", "c"], "\[LongEqual]", 
                SuperscriptBox[
                 RowBox[{"(", 
                   RowBox[{
                    SubsuperscriptBox[
                    StyleBox["q", "TI"], "LL", "2"], "+", 
                    SuperscriptBox[
                    RowBox[{"(", 
                    SubsuperscriptBox[
                    StyleBox["M", "TI"], "LL", "q"], ")"}], "2"]}], ")"}], 
                 RowBox[{"1", "/", "2"}]]}], TraditionalForm], 
             "\", an eigenvalue of \"", 
             FormBox[
              RowBox[{
                SubscriptBox[
                 StyleBox["H", FontSlant -> "Plain"], "LL"], "(", 
                SubscriptBox[
                 OverscriptBox[
                  StyleBox["q", "TI"], "\[RightVector]"], "LL"], ")"}], 
              TraditionalForm], "\" eight times with each sign; \"", 
             FormBox[
              RowBox[{
                SubsuperscriptBox[
                 StyleBox["E", "TI"], "LL", "c"], "(", 
                SubscriptBox["\[CapitalLambda]", "LL"], ")"}], 
              TraditionalForm], "\" is its value at \"", 
             FormBox[
              RowBox[{
                SubscriptBox[
                 StyleBox["q", "TI"], "LL"], "\[LongEqual]", 
                SubscriptBox["\[CapitalLambda]", "LL"]}], TraditionalForm], 
             "\" (plain text `E_Lambda`)\""},
            "RowDefault"],
           StripOnInput->False,
           FontFamily->"Source Sans Pro",
           FontSize->9.5],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox[
             OverscriptBox["a", "\[RightVector]"], "LL", "F"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"a_F\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[
          StyleBox[
           
           TemplateBox[{
            "\"the fermion-number coupling times the space components of a \
constant fermion-number potential, \"", 
             FormBox[
              RowBox[{
                SubsuperscriptBox[
                 OverscriptBox[
                  StyleBox["a", "TI"], "\[RightVector]"], "LL", "F"], 
                "\[LongEqual]", 
                SubsuperscriptBox[
                 StyleBox["g", "TI"], "LL", "F"], 
                RowBox[{"(", 
                  RowBox[{
                    SubsuperscriptBox[
                    StyleBox["A", "TI"], 
                    RowBox[{"LL", ",", "1"}], "F"], ",", 
                    SubsuperscriptBox[
                    StyleBox["A", "TI"], 
                    RowBox[{"LL", ",", "2"}], "F"], ",", 
                    SubsuperscriptBox[
                    StyleBox["A", "TI"], 
                    RowBox[{"LL", ",", "3"}], "F"]}], ")"}]}], 
              TraditionalForm], 
             "\": the shift of the kinetic momentum of both members of a pair\
\""},
            "RowDefault"],
           StripOnInput->False,
           FontFamily->"Source Sans Pro",
           FontSize->9.5],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox[
             OverscriptBox["u", "\[RightVector]"], "LL", "f"], "\", \"", 
            SubsuperscriptBox[
             OverscriptBox["u", "\[RightVector]"], "LL", 
             RowBox[{"f", "\[Prime]"}]], "\", \"", 
            SubsuperscriptBox["\[Delta]", "LL", "f"]},
           "RowDefault"],
