  RowBox[{"(*", " ", 
   RowBox[{
   "the", " ", "number", " ", "of", " ", "entries", " ", "in", " ", "each", " ",
     "of", " ", "the", " ", "nine", " ", "groups"}], " ", "*)"}], "\n", 
  RowBox[{"KeySort", "[", 
   RowBox[{"Counts", "[", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"#", "[", "\"\<group\>\"", "]"}], " ", "&"}], ",", " ", 
      "SL31Registry"}], "]"}], "]"}], "]"}]}]], "Input",
