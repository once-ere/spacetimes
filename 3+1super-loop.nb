      RowBox[{
       RowBox[{"as9Ev", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"First", "[", "as9Plus", "]"}], " ", "-", " ", "1"}], "]"}],
         "]"}], " ", "<", " ", "as9ER", " ", "<", " ", 
       RowBox[{"as9Ev", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"Last", "[", "as9Plus", "]"}], " ", "+", " ", "1"}], "]"}], 
        "]"}]}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Kato", " ", "and", " ", 
      RowBox[{"Temple", ":", " ", 
       RowBox[{
        RowBox[{"the", " ", "16", " ", "moduli", " ", "lie", " ", "within", " ", 
         RowBox[{
          RowBox[{"r", "^", "2"}], "/", "delta"}]}], " ", "+", " ", 
        RowBox[{"spread", " ", "of", " ", "E_R"}]}]}]}], ";", " ", 
     RowBox[{
     "spread", " ", "is", " ", "the", " ", "largest", " ", "minus", " ", 
      "the", " ", "smallest", " ", "modulus"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"as9Moduli", " ", "=", " ", 
     RowBox[{"Abs", "[", 
      RowBox[{"as9Ev", "[", 
       RowBox[{"[", "as9Inside", "]"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as9Spread", " ", "=", " ", 
     RowBox[{
      RowBox[{"Max", "[", "as9Moduli", "]"}], " ", "-", " ", 
      RowBox[{"Min", "[", "as9Moduli", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as9WorstBound", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{"as9Moduli", " ", "-", " ", "as9ER"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as9TolE", " ", "=", " ", 
     RowBox[{
      RowBox[{"as9Residual", " ", 
       RowBox[{"as9Residual", "/", "as9Delta"}]}], " ", "+", " ", 
      "as9Spread"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Davis", " ", "and", " ", 
     RowBox[{"Kahan", ":", " ", 
      RowBox[{
      "the", " ", "part", " ", "of", " ", "the", " ", "analytic", " ", 
       "state", " ", "outside", " ", "the", " ", "eight", " ", "eigenvectors",
        " ", "has", " ", "at", " ", "most", " ", "the", " ", "norm", " ", 
       RowBox[{"r", "/", "delta"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"as9Outside", " ", "=", " ", 
     RowBox[{"as9Convergence", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", " ", "5"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as9TolOut", " ", "=", " ", 
     RowBox[{"as9Residual", "/", "as9Delta"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "the", " ", "requirement", " ", "for", " ", "the", " ", "densities"}], 
    " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"as9TolBC", " ", "=", " ", 
     RowBox[{"0.5", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"as9Residual", "/", "as9Delta"}], ")"}], "^", "2"}]}]}], 
    ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<AS-9\>\"", ",", 
     " ", "\"\<the bound states of the domain wall on the lattice (case C): \
on a ring of length 24 (60 sites, dx = 0.4, r_W = 1, m = 0.4, mu = 0) with \
the kink-antikink profile Delta(x_LL^1) = tanh(x_LL^1 - 6) tanh(18 - x_LL^1), \
the lattice operator has exactly 16 eigenvalues inside 0.8 times the \
continuum threshold (m^2 + Delta_inf^2)^(1/2), eight positive and eight \
negative (four per wall and sign); with the relative residual r of the \
analytic bound state at dx = 0.4 and the distance delta from its Rayleigh \
quotient E_R to the nearest eigenvalue outside the cluster of the eight \
positive bound states, which lies between the neighbours of the cluster: (1) \
the moduli of the 16 eigenvalues lie within r^2/delta + spread of E_R, where \
spread is the largest minus the smallest of the 16 moduli (the theorem of \
Kato and Temple: one eigenvalue of the cluster lies at most r^2/delta above \
E_R and one at most r^2/delta below); (2) the part of the normalized analytic \
state outside the space of the eight eigenvectors near +m has at most the \
norm r/delta (the theorem of Davis and Kahan); (3) the summed density of the \
eight states near +m agrees with the analytic density of the bound states of \
the two walls at second order in r, 1 - (Bhattacharyya coefficient of the two \
normalized densities) < (1/2) (r/delta)^2 (a requirement of the check on the \
scale of (2), not a theorem; the Bhattacharyya coefficient is the sum over \
the sites of the square root of the product of the two densities, each \
normalized to the sum 1); for the analytic bound state of the kink (chi_K \
with the components 1 and 5 equal to 1/sqrt 2 and the others zero, beta_LL \
chi_K = chi_K) on rings with dx = 0.4, 0.2, 0.1, 0.05 the Rayleigh quotient \
E_R equals the exact lattice formula m + (r_W/(2 dx)) sum (phi_K(s+1) - \
phi_K(s))^2 / sum phi_K(s)^2 (tolerance 1e-12), (E_R - m)/(r_W dx) tends to \
1/6 (within 1 per cent at dx = 0.05, the difference decreasing by a factor \
between 3.5 and 4.5 at each halving of dx: the Wilson term shifts the bound \
state at first order in dx, by r_W dx/6, with a correction of order dx^3), \
and the relative residual decreases at least by the factor 0.6 at each \
halving of dx\>\"", ",", "\n", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", "as9Inside", "]"}], " ", "==", " ", "16"}], " ",
       "&&", " ", 
      RowBox[{
       RowBox[{"Length", "[", "as9Plus", "]"}], " ", "==", " ", "8"}], " ", "&&",
       " ", "as9Between", " ", "&&", " ", 
      RowBox[{"as9WorstBound", " ", "<=", " ", "as9TolE"}], " ", "&&", " ", 
      RowBox[{"as9Outside", " ", "<=", " ", "as9TolOut"}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"1.", " ", "-", " ", "as9BC"}], " ", "<", " ", "as9TolBC"}], 
      " ", "&&", " ", 
      RowBox[{"as9DevFormula", " ", "<", " ", "1*^-12"}], " ", "&&", " ", 
      "as9FirstOrder", " ", "&&", " ", "as9ResidualFalls", " ", "&&", "\n", 
      "   ", 
      RowBox[{"as9BetaDev", " ", "<", " ", "1*^-15"}]}], ",", "\n", "  ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Length", "[", "as9Inside", "]"}], ",", 
        " ", "\"\< bound states (\>\"", ",", " ", 
        RowBox[{"Length", "[", "as9Plus", "]"}], ",", 
        " ", "\"\< positive); largest | |E| - E_R | = \>\"", ",", " ", 
        RowBox[{"asFix", "[", 
         RowBox[{"as9WorstBound", ",", " ", "5"}], "]"}], ",", 
        " ", "\"\< (bound r^2/delta + spread = \>\"", ",", " ", 
        RowBox[{"asFix", "[", 
         RowBox[{"as9TolE", ",", " ", "5"}], "]"}], ",", 
        " ", "\"\<, delta = \>\"", ",", "\n", "    ", 
        RowBox[{"asFix", "[", 
         RowBox[{"as9Delta", ",", " ", "4"}], "]"}], ",", 
        " ", "\"\<, spread = \>\"", ",", " ", 
        RowBox[{"asSci", "[", "as9Spread", "]"}], ",", 
        " ", "\"\<); part of the analytic state outside the eight \
eigenvectors \>\"", ",", " ", 
        RowBox[{"asFix", "[", 
         RowBox[{"as9Outside", ",", " ", "4"}], "]"}], ",", 
        " ", "\"\< (bound r/delta = \>\"", ",", "\n", "    ", 
        RowBox[{"asFix", "[", 
         RowBox[{"as9TolOut", ",", " ", "4"}], "]"}], ",", 
        " ", "\"\<); 1 - Bhattacharyya coefficient = \>\"", ",", " ", 
        RowBox[{"ScientificForm", "[", 
         RowBox[{
          RowBox[{"1.", " ", "-", " ", "as9BC"}], ",", " ", "3"}], "]"}], ",",
         " ", "\"\< (required below \>\"", ",", " ", 
        RowBox[{"ScientificForm", "[", 
         RowBox[{"as9TolBC", ",", " ", "3"}], "]"}], ",", 
        " ", "\"\<); E_R = \>\"", ",", "\n", "    ", 
        RowBox[{"Row", "[", 
         RowBox[{"Riffle", "[", 
          RowBox[{
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"asFix", "[", 
               RowBox[{"#", ",", " ", "6"}], "]"}], " ", "&"}], ",", " ", 
             RowBox[{"as9Convergence", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], "]"}], ",", 
           " ", "\"\<, \>\""}], "]"}], "]"}], ",", 
        " ", "\"\<; (E_R - m)/dx = \>\"", ",", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"Riffle", "[", 
          RowBox[{
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"asFix", "[", 
               RowBox[{"#", ",", " ", "5"}], "]"}], " ", "&"}], ",", " ", 
             "as9Ratios"}], "]"}], ",", " ", "\"\<, \>\""}], "]"}], "]"}], ",",
         " ", "\"\<; residuals \>\"", ",", "\n", "    ", 
        RowBox[{"Row", "[", 
         RowBox[{"Riffle", "[", 
          RowBox[{
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"ScientificForm", "[", 
               RowBox[{"#", ",", " ", "3"}], "]"}], " ", "&"}], ",", " ", 
             RowBox[{"as9Convergence", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", " ", "3"}], "]"}], "]"}]}], "]"}], ",", 
           " ", "\"\<, \>\""}], "]"}], "]"}], ",", 
        " ", "\"\<; deviation from the lattice formula \>\"", ",", " ", 
        RowBox[{"asSci", "[", "as9DevFormula", "]"}], ",", "\n", 
        "    ", "\"\< (original: 16 bound states (8 positive); 0.00312 (bound \
0.02260, delta = 0.6139, spread = 3.8e-14); 0.0841 (bound 0.1919); 1.12e-3 \
(required below 1.84e-2); E_R = 0.465443, 0.433178, 0.416647, 0.408331; (E_R \
- m)/dx = 0.16361, 0.16589, 0.16647, 0.16662; residuals 1.18e-1, 5.94e-2, \
2.98e-2, 1.49e-2; 3.8e-15)\>\""}], "}"}], "]"}]}], "]"}]}]}]], "Input",
 CellLabel->
  "In[755]:=",ExpressionUUID->"f9bbe950-c477-4929-a558-4028ae42a776"],

Cell[BoxData[
 StyleBox[
  TemplateBox[{
    StyleBox["\"PASS  \"", Bold, 
     RGBColor[0, 
      Rational[2, 3], 0], StripOnInput -> False], "\"AS-9: \"", 
    "\"the bound states of the domain wall on the lattice (case C): on a ring \
of length 24 (60 sites, dx = 0.4, r_W = 1, m = 0.4, mu = 0) with the \
kink-antikink profile Delta(x_LL^1) = tanh(x_LL^1 - 6) tanh(18 - x_LL^1), the \
lattice operator has exactly 16 eigenvalues inside 0.8 times the continuum \
threshold (m^2 + Delta_inf^2)^(1/2), eight positive and eight negative (four \
per wall and sign); with the relative residual r of the analytic bound state \
at dx = 0.4 and the distance delta from its Rayleigh quotient E_R to the \
nearest eigenvalue outside the cluster of the eight positive bound states, \
which lies between the neighbours of the cluster: (1) the moduli of the 16 \
eigenvalues lie within r^2/delta + spread of E_R, where spread is the largest \
minus the smallest of the 16 moduli (the theorem of Kato and Temple: one \
eigenvalue of the cluster lies at most r^2/delta above E_R and one at most \
r^2/delta below); (2) the part of the normalized analytic state outside the \
space of the eight eigenvectors near +m has at most the norm r/delta (the \
theorem of Davis and Kahan); (3) the summed density of the eight states near \
+m agrees with the analytic density of the bound states of the two walls at \
second order in r, 1 - (Bhattacharyya coefficient of the two normalized \
densities) < (1/2) (r/delta)^2 (a requirement of the check on the scale of \
(2), not a theorem; the Bhattacharyya coefficient is the sum over the sites \
of the square root of the product of the two densities, each normalized to \
the sum 1); for the analytic bound state of the kink (chi_K with the \
components 1 and 5 equal to 1/sqrt 2 and the others zero, beta_LL chi_K = \
chi_K) on rings with dx = 0.4, 0.2, 0.1, 0.05 the Rayleigh quotient E_R \
equals the exact lattice formula m + (r_W/(2 dx)) sum (phi_K(s+1) - \
phi_K(s))^2 / sum phi_K(s)^2 (tolerance 1e-12), (E_R - m)/(r_W dx) tends to \
1/6 (within 1 per cent at dx = 0.05, the difference decreasing by a factor \
between 3.5 and 4.5 at each halving of dx: the Wilson term shifts the bound \
state at first order in dx, by r_W dx/6, with a correction of order dx^3), \
and the relative residual decreases at least by the factor 0.6 at each \
halving of dx\"", 
    "\"  -- 16 bound states (8 positive); largest | |E| - E_R | = 0.00312 \
(bound r^2/delta + spread = 0.02260, delta = 0.6139, spread = 4.3e-14); part \
of the analytic state outside the eight eigenvectors 0.0841 (bound r/delta = \
0.1919); 1 - Bhattacharyya coefficient = 1.12e-3 (required below 1.84e-2); \
E_R = 0.465443, 0.433178, 0.416647, 0.408331; (E_R - m)/dx = 0.16361, \
0.16589, 0.16647, 0.16662; residuals 1.18e-1, 5.94e-2, 2.98e-2, 1.49e-2; \
deviation from the lattice formula 5.6e-16 (original: 16 bound states (8 \
positive); 0.00312 (bound 0.02260, delta = 0.6139, spread = 3.8e-14); 0.0841 \
(bound 0.1919); 1.12e-3 (required below 1.84e-2); E_R = 0.465443, 0.433178, \
0.416647, 0.408331; (E_R - m)/dx = 0.16361, 0.16589, 0.16647, 0.16662; \
residuals 1.18e-1, 5.94e-2, 2.98e-2, 1.49e-2; 3.8e-15)\""},
