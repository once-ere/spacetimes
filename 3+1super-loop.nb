       FontSlant->"Plain"]], ")"}], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", "\[Iota]",
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", "0"}], "\[Iota]"], 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Iota]"], "+", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", "0"}], 
     StyleBox["F",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "8"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4c9833c3-93b9-40ca-9699-2e540907a129"],
 " is the potential of the time direction at the site and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["P",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["s", "TI"], "\[RightVector]"], 
      StyleBox["LL",
       FontSlant->"Plain"]], ")"}], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", "\[Iota]",
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Iota]"], 
    RowBox[{"(", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["s", "TI"], "\[RightVector]"], 
      StyleBox["LL",
       FontSlant->"Plain"]], ")"}], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "\[Iota]"], ")"}], "\[Dagger]"]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3ef06a4e-3e18-4742-9ec5-a130fa1ef790"],
 " the pairing block; a direction without a neighbour (a Dirichlet boundary) \
contributes zero. The function ",
 StyleBox["t2apply",
  FontFamily->"Source Code Pro"],
 " applies the operator to a vector, or, column by column, to a matrix whose \
columns are vectors; ",
 StyleBox["t2dense",
  FontFamily->"Source Code Pro"],
 " applies it to the unit matrix and so returns the whole matrix."
}], "Text",ExpressionUUID->"5d168634-3127-4cbf-8c28-aa2027b30602"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "the", " ", "closed", " ", "form", " ", "of", " ", "the", " ", "link", " ",
     "matrix", " ", "exp", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "i"}], " ", "ell", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"gv", " ", 
         RowBox[{
          RowBox[{"a", ".", "tau"}], "/", "2"}]}], " ", "+", " ", 
