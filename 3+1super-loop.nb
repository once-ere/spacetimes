Cell[TextData[{
 "The library module sym.rs is a small symbolic algebra: linear combinations \
of monomials (TeX strings) with exact complex coefficients (the real and the \
imaginary part of a coefficient are rational numbers), used by the programs \
to print the matrices and the component equations in TeX and to evaluate \
every printed formula numerically. The Wolfram Language is itself a symbolic \
algebra with exact Gaussian rationals, so this module needs no rewriting: in \
check GS-12 below the same formulas are built from symbols and evaluated in \
the same way. For example, the TeX of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Sigma]", "2", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "28ecf309-b18f-4487-b87d-d8fb4fb6d491"],
 " written by ",
 StyleBox["TeXForm",
  FontFamily->"Source Code Pro"],
 ":"
}], "Text",ExpressionUUID->"ad882505-ccfe-4439-a45c-3edcf6a2598d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ToString", "[", 
  RowBox[{"TeXForm", "[", 
   RowBox[{"MatrixForm", "[", 
    RowBox[{"t2sigma", "[", "2", "]"}], "]"}], "]"}], "]"}]], "Input",
 CellLabel->
  "In[327]:=",ExpressionUUID->"fd231216-41d0-4fb6-983c-68c1c85d5d32"],

Cell[BoxData["\<\"\\\\left(\\n\\\\begin{array}{cc}\\n 0 & -i \\\\\\\\\\n i & \
0 \\\\\\\\\\n\\\\end{array}\\n\\\\right)\"\>"], "Output",
 CellChangeTimes->{4.004025488563322*^9},
 CellLabel->
  "Out[327]=",ExpressionUUID->"5a5ac2b6-c733-4a4e-9eb2-5031dd00e948"]
}, Open  ]]
}, Open  ]],

