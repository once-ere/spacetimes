                 FormBox[
                  StyleBox["j", "TI"], TraditionalForm], 
                 "\" is used as an index, with the values 1, 2, 3, and with \
primes (\"", 
                 FormBox[
                  SuperscriptBox[
                   StyleBox["j", "TI"], "\[Prime]"], TraditionalForm], 
                 "\", \"", 
                 FormBox[
                  SuperscriptBox[
                   StyleBox["j", "TI"], "\[Prime]\[Prime]"], TraditionalForm],
                  "\") where two or three such indices are needed: it labels \
the three imaginary quaternion units \"", 
                 FormBox[
                  SubscriptBox[
                   StyleBox["e", FontSlant -> "Bold"], 
                   StyleBox["j", "TI"]], TraditionalForm], 
                 "\", which correspond to the three space directions of \"", 
                 FormBox[
                  SubsuperscriptBox[
                   StyleBox["R", FontSlant -> "Plain"], "LL", 
                   RowBox[{"1", ",", "3"}]], TraditionalForm], 
                 "\", the coordinates \"", 
                 FormBox[
                  SubsuperscriptBox[
                   StyleBox["x", "TI"], "LL", 
                   StyleBox["j", "TI"]], TraditionalForm], 
                 "\", the momentum components \"", 
                 FormBox[
                  SubsuperscriptBox[
                   StyleBox["q", "TI"], "LL", 
                   StyleBox["j", "TI"]], TraditionalForm], 
                 "\", the rotation and boost generators \"", 
                 FormBox[
                  SubsuperscriptBox[
                   StyleBox["J", "TI"], "LL", 
                   StyleBox["j", "TI"]], TraditionalForm], "\", \"", 
                 FormBox[
                  SubsuperscriptBox[
                   StyleBox["K", "TI"], "LL", 
                   StyleBox["j", "TI"]], TraditionalForm], 
                 "\", and the Pauli matrices \"", 
                 FormBox[
                  SubsuperscriptBox["\[Sigma]", 
                   StyleBox["j", "TI"], "LL"], TraditionalForm], 
                 "\" and Dirac matrices \"", 
                 FormBox[
                  SubsuperscriptBox["\[Alpha]", "LL", 
                   StyleBox["j", "TI"]], TraditionalForm], "\", \"", 
                 FormBox[
                  SubsuperscriptBox["\[Gamma]", "LL", 
                   StyleBox["j", "TI"]], TraditionalForm], 
                 "\". The letter \"", 
                 FormBox[
                  StyleBox["i", "TI"], TraditionalForm], 
                 "\" is the imaginary unit (entry \"", 
                 FormBox[
                  StyleBox["i", "TI"], TraditionalForm], 
                 "\"); the isospin index is \"", 
                 FormBox["\[Iota]", TraditionalForm], 
                 "\" (a different letter).\""},
                "RowDefault"],
               StripOnInput->False,
               FontFamily->"Source Sans Pro",
               FontSize->9.5],
              ImageSize->290]},
            {
             PaneBox[
              TemplateBox[{"D"},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              StyleBox["\<\"D\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[
              StyleBox[
               
               TemplateBox[{
                "\"the number of space dimensions in which the particles of \
matter have momentum: 7 (all space coordinates of 7+1), 4 (fields that do not \
depend on \"", 
                 FormBox[
                  RowBox[{
                    StyleBox["x", "TI"], "5", ",", 
                    StyleBox["x", "TI"], "6", ",", 
                    StyleBox["x", "TI"], "7"}], TraditionalForm], 
                 "\") or 3 (fields that depend on ordinary space only). \"", 
                 FormBox[
                  RowBox[{
                    SubscriptBox[
                    StyleBox["V", "TI"], 
                    StyleBox["D", "TI"]], "\[LongEqual]", 
                    SuperscriptBox["\[Pi]", 
                    RowBox[{
                    StyleBox["D", "TI"], "/", "2"}]], "/", 
                    SubscriptBox["\[CapitalGamma]", "E"], 
                    RowBox[{"(", 
                    RowBox[{
                    StyleBox["D", "TI"], "/", "2", "+", "1"}], ")"}]}], 
                  TraditionalForm], "\" is the volume and \"", 
                 FormBox[
                  RowBox[{
                    SubscriptBox[
                    StyleBox["A", "TI"], 
                    StyleBox["D", "TI"]], "\[LongEqual]", 
                    StyleBox["D", "TI"], " ", 
                    SubscriptBox[
                    StyleBox["V", "TI"], 
                    StyleBox["D", "TI"]]}], TraditionalForm], 
                 "\" the area of the unit ball in \"", 
                 FormBox[
                  StyleBox["D", "TI"], TraditionalForm], "\" dimensions (\"", 
                 
                 FormBox[
                  SubscriptBox["\[CapitalGamma]", "E"], TraditionalForm], 
                 "\": Euler's gamma function). In the super-loop revision \"", 
                 FormBox[
                  RowBox[{
                    StyleBox["D", "TI"], "\[LongEqual]", "3"}], 
                  TraditionalForm], 
                 "\" for the four-dimensional world of the superfluid and \"", 
                 FormBox[
                  RowBox[{
                    StyleBox["D", "TI"], "\[LongEqual]", "7"}], 
                  TraditionalForm], 
                 "\" for the eight-dimensional manifolds; the value 4, the \
coordinates \"", 
                 FormBox[
                  RowBox[{
                    StyleBox["x", "TI"], "5", ",", 
                    StyleBox["x", "TI"], "6", ",", 
                    StyleBox["x", "TI"], "7"}], TraditionalForm], 
                 "\" and the volume and the area of the unit ball do not \
occur. In the kinetic Lagrangian of the superfluid boson singlet state \"", 
                 FormBox[
                  StyleBox["D", "TI"], TraditionalForm], 
                 "\" is also continued away from 3: in dimensional \
regularization the momentum integrals are taken in \"", 
                 FormBox[
                  StyleBox["D", "TI"], TraditionalForm], 
                 "\" space dimensions.\""},
                "RowDefault"],
               StripOnInput->False,
               FontFamily->"Source Sans Pro",
               FontSize->9.5],
              ImageSize->290]},
