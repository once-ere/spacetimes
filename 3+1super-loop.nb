            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "8eb7707c-7acb-45fd-9095-8836c24adc97"],
           " Bogoliubov matrix per unit of ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[Delta]", 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["f",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "f65dca22-8013-470c-8b5b-b8c601ef37e6"],
           ", ",
           Cell[BoxData[
            FormBox[
             RowBox[{"(", "\[NoBreak]", GridBox[{
                {"0", 
                 RowBox[{
                  SubscriptBox[
                   StyleBox["P",
                    FontFamily->"Helvetica",
                    FontSlant->"Plain"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]], 
                  RowBox[{"(", 
