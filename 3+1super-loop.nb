                SyntaxForm -> SubsuperscriptBox]}], 
             RowBox[{
               RowBox[{"-", 
                 
                 TemplateBox[{"\"\[Del]\"", "1", "\"LL\""}, "Subsuperscript", 
                  SyntaxForm -> SubsuperscriptBox]}], "+", 
               RowBox[{"\[ImaginaryI]", " ", 
                 
                 TemplateBox[{"\"\[Del]\"", "2", "\"LL\""}, "Subsuperscript", 
                  SyntaxForm -> SubsuperscriptBox]}]}]}, {
             RowBox[{
               RowBox[{"-", 
                 
                 TemplateBox[{"\"\[Del]\"", "1", "\"LL\""}, "Subsuperscript", 
                  SyntaxForm -> SubsuperscriptBox]}], "-", 
               RowBox[{"\[ImaginaryI]", " ", 
                 
                 TemplateBox[{"\"\[Del]\"", "2", "\"LL\""}, "Subsuperscript", 
                  SyntaxForm -> SubsuperscriptBox]}]}], 
             RowBox[{
               
