Cell[TextData[{
 "The library module sym.rs is a small symbolic algebra: linear combinations \
of monomials (TeX strings) with exact coefficients ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], "+", 
    StyleBox["bi", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e1f7f0e8-9b27-42c8-9f6e-35074d1db369"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], ",", 
    StyleBox["b", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "328da438-4726-4dc0-9348-542a515f186d"],
 " rational), used by the programs to print the matrices and the component \
equations in TeX and to evaluate every printed formula numerically. The \
Wolfram Language is itself a symbolic algebra with exact Gaussian rationals, \
so this module needs no rewriting: in check GS-12 below the same formulas are \
built from symbols and evaluated in the same way. For example, the TeX of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Sigma]", "2", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bc39d6d6-c3a3-4448-ab4a-d6ece136cc81"],
 " written by ",
 StyleBox["TeXForm",
  FontFamily->"Source Code Pro"],
 ":"
}], "Text",ExpressionUUID->"51bccae9-8241-47e7-b29d-30c77744929e"],

