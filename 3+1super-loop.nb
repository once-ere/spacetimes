             RowBox[{
              SubscriptBox["\[Mu]", 
               StyleBox["LL",
                FontSlant->"Plain"]], "\[LongEqual]", "0"}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "0d564085-c754-46d3-abde-888a66e6ea86"],
           ", ",
           Cell[BoxData[
            FormBox[
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{
                SubsuperscriptBox[
                 StyleBox["m", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], "2"], "+", 
                SubsuperscriptBox["\[CapitalDelta]", 
