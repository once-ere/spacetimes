Cell[CellGroupData[{

Cell["I.7 Verification tests of the symbols", "Section",ExpressionUUID->"ea4ebec4-3c37-4ded-bf3c-c8cc50a0f054"],

Cell[TextData[{
 "Every test below has a name (S-1, S-2, ...), states in words what it \
checks, computes it, and records PASS or FAIL with the numbers that decide it \
in the list ",
 StyleBox["SL31`Test`$Results",
  FontFamily->"Source Code Pro"],
 ". The function ",
 StyleBox["SL31Check[name, statement, condition, details]",
  FontFamily->"Source Code Pro"],
 " does the recording and prints one line."
}], "Text",ExpressionUUID->"3a516ce8-f2f6-4f54-87e4-39e9203b684c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SL31`Test`$Results", " ", "=", " ", 
   RowBox[{"{", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"SL31Check", "[", 
    RowBox[{
    "name_String", ",", " ", "statement_String", ",", " ", "ok_", ",", " ", 
     RowBox[{"details_", " ", ":", " ", "\"\<\>\""}]}], "]"}], " ", ":=", " ", 
   RowBox[{"(", "\n", "   ", 
    RowBox[{
     RowBox[{"AppendTo", "[", 
      RowBox[{"SL31`Test`$Results", ",", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<name\>\"", " ", "->", " ", "name"}], ",", " ", 
         RowBox[{"\"\<pass\>\"", " ", "->", " ", 
          RowBox[{"TrueQ", "[", "ok", "]"}]}], ",", " ", 
         RowBox[{"\"\<statement\>\"", " ", "->", " ", "statement"}], ",", " ", 
         RowBox[{"\"\<details\>\"", " ", "->", " ", "details"}]}], "|>"}]}], 
      "]"}], ";", "\n", "   ", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "the", " ", "details", " ", "are", " ", "printed", " ", "as", " ", 
        "an", " ", "expression"}], ",", " ", 
       RowBox[{
       "so", " ", "that", " ", "the", " ", "symbols", " ", "appear", " ", 
        "in", " ", "their", " ", "printed", " ", "form"}]}], " ", "*)"}], 
     "\n", "   ", 
     RowBox[{"Print", "[", 
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"TrueQ", "[", "ok", "]"}], ",", " ", "\"\<PASS  \>\"", ",",
            " ", "\"\<FAIL  \>\""}], "]"}], ",", " ", "Bold", ",", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"TrueQ", "[", "ok", "]"}], ",", " ", 
           RowBox[{"Darker", "[", "Green", "]"}], ",", " ", "Red"}], "]"}]}], 
        "]"}], ",", " ", "name", ",", " ", "\"\<: \>\"", ",", " ", 
       "statement", ",", "\n", "     ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"details", " ", "===", " ", "\"\<\>\""}], ",", 
         " ", "\"\<\>\"", ",", " ", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<  -- \>\"", ",", " ", "details"}], "}"}], "]"}]}], 
        "]"}]}], "]"}]}], ")"}]}], ";"}]}], "Input",
 CellLabel->
  "In[160]:=",ExpressionUUID->"05041db6-44d6-480e-ab42-305996e8cd6f"],

Cell["\<\
S-1 and S-2: every TeX item was converted into boxes (no item failed), and \
every symbolized box is now read as one atomic symbol.\
\>", "Text",ExpressionUUID->"f896655a-cb5d-4f29-9cba-c8c65bb407c1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-1\>\"", ",", 
    " ", "\"\<every one of the TeX items of the registry is converted into a \
box structure\>\"", ",", "\n", "  ", 
    RowBox[{"AllTrue", "[", 
     RowBox[{"items", ",", " ", 
      RowBox[{
       RowBox[{"FreeQ", "[", 
        RowBox[{
         RowBox[{"#", "[", "\"\<boxes\>\"", "]"}], ",", " ", 
         RowBox[{"$Failed", " ", "|", " ", "Null"}]}], "]"}], " ", "&"}]}], 
     "]"}], ",", " ", 
    RowBox[{"Length", "[", "items", "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-2\>\"", ",", 
    " ", "\"\<every symbolized box is read as one atomic symbol (head Symbol)\
\>\"", ",", "\n", "  ", 
    RowBox[{"AllTrue", "[", 
     RowBox[{"symbolTable", ",", " ", 
      RowBox[{
       RowBox[{"MatchQ", "[", 
        RowBox[{
         RowBox[{"#", "[", "\"\<symbol\>\"", "]"}], ",", " ", 
         RowBox[{"HoldComplete", "[", "_Symbol", "]"}]}], "]"}], " ", "&"}]}],
      "]"}], ",", "\n", "  ", 
    RowBox[{"Count", "[", 
     RowBox[{"symbolTable", ",", " ", 
      RowBox[{"r_", " ", "/;", " ", 
       RowBox[{"MatchQ", "[", 
        RowBox[{
         RowBox[{"r", "[", "\"\<symbol\>\"", "]"}], ",", " ", 
         RowBox[{"HoldComplete", "[", "_Symbol", "]"}]}], "]"}]}]}], "]"}]}], 
   "]"}], ";"}]}], "Input",
 CellLabel->
  "In[162]:=",ExpressionUUID->"462e8bf7-4209-4521-a3e2-2f266c467178"],

