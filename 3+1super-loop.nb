                   StyleBox["p", "TI"]}], "\[Omega]"], "\[LongEqual]", 
                UnderscriptBox["\[Sum]", 
                 StyleBox["j", "TI"], LimitsPositioning -> True], 
                RowBox[{"(", 
                  RowBox[{
                    SubsuperscriptBox["\[Omega]", 
                    RowBox[{"LL", ",", 
                    StyleBox["p", "TI"]}], 
                    StyleBox["j", "TI"]], 
                    SubsuperscriptBox[
                    StyleBox["J", "TI"], "LL", 
                    StyleBox["j", "TI"]], "+", 
                    SubsuperscriptBox["\[CurlyPi]", 
                    RowBox[{"LL", ",", 
                    StyleBox["p", "TI"]}], 
                    StyleBox["j", "TI"]], 
                    SubsuperscriptBox[
                    StyleBox["K", "TI"], "LL", 
                    StyleBox["j", "TI"]]}], ")"}]}], TraditionalForm], 
             "\", with the real rotation components \"", 
             FormBox[
              SubsuperscriptBox["\[Omega]", 
               RowBox[{"LL", ",", 
                 StyleBox["p", "TI"]}], 
