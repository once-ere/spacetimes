                  RowBox[{
                    SubsuperscriptBox[
                    StyleBox["K", FontSlant -> "Plain"], "LL", "\[Iota]"], 
                    "\[LongEqual]", 
                    SubscriptBox[
                    StyleBox["C", "TI"], "LL"], 
                    SubsuperscriptBox["\[Gamma]", "LL", "ch"], 
                    "\[CircleTimes]", 
                    SubscriptBox[
                    StyleBox["E", FontSlant -> "Plain"], "LL"], 
                    SubsuperscriptBox["\[Tau]", "\[Iota]", "LL"]}], 
                  TraditionalForm], "\" (\"", 
                 FormBox[
                  SuperscriptBox["0", "+"], TraditionalForm], 
                 "\"), pseudoscalar \"", 
                 FormBox[
                  RowBox[{
                    SubsuperscriptBox[
                    StyleBox["K", FontSlant -> "Plain"], "LL", 
                    "\[Prime]\[Iota]"], "\[LongEqual]", 
                    SubscriptBox[
                    StyleBox["C", "TI"], "LL"], "\[CircleTimes]", 
                    SubscriptBox[
                    StyleBox["E", FontSlant -> "Plain"], "LL"], 
                    SubsuperscriptBox["\[Tau]", "\[Iota]", "LL"]}], 
                  TraditionalForm], "\" (\"", 
                 FormBox[
                  SuperscriptBox["0", "-"], TraditionalForm], 
                 "\"), and the \"", 
                 FormBox[
                  RowBox[{"16", "\[Cross]", "16"}], TraditionalForm], 
                 "\" singlet of two species \"", 
                 FormBox[
                  RowBox[{
                    SubsuperscriptBox[
                    StyleBox["K", FontSlant -> "Plain"], "LL", "s"], 
                    "\[LongEqual]", 
                    SubscriptBox[
                    StyleBox["C", "TI"], "LL"], 
                    SubsuperscriptBox["\[Gamma]", "LL", "ch"], 
                    "\[CircleTimes]", 
                    SubscriptBox[
                    StyleBox["E", FontSlant -> "Plain"], "LL"], 
                    "\[CircleTimes]", 
                    SubscriptBox[
                    StyleBox["E", FontSlant -> "Plain"], "LL"]}], 
                  TraditionalForm], 
                 "\" (the last factor on the species index); the plain-text \
name Kch alone, and the letter \"", 
                 FormBox[
                  StyleBox["K", FontSlant -> "Plain"], TraditionalForm], 
                 "\" without scripts, stand for any pair matrix (\"", 
                 FormBox[
                  RowBox[{"8", "\[Cross]", "8"}], TraditionalForm], 
                 "\" for one field, \"", 
                 FormBox[
                  RowBox[{"16", "\[Cross]", "16"}], TraditionalForm], 
                 "\" for two species), the pair of two spinor charges being \
\"", 
                 FormBox[
                  RowBox[{
                    SubsuperscriptBox["\[CapitalPsi]", "LL", 
