           StripOnInput->False,
           FontFamily->"Source Sans Pro",
           FontSize->9.5],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["\[Omega]", "LL", "pr"]},
