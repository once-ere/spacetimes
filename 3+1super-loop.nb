Cell[BoxData[
 TagBox[GridBox[{
    {
     StyleBox["\<\"9 Test 2: the gauge-covariant field equations of the \
spinor field and their solutions\"\>",
      StripOnInput->False,
      FontSize->12,
      FontWeight->Bold]},
    {
     TagBox[GridBox[{
        {
         StyleBox["\<\"symbol\"\>",
          StripOnInput->False,
