            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "910e0c5d-9834-412d-b49c-63ce68cb76d0"],
           " and ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SuperscriptBox[
               RowBox[{"(", 
                SubsuperscriptBox[
                 StyleBox["M", "TI"], 
