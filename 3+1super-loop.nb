           FontSize->9.5,ExpressionUUID->
           "06289082-db48-4071-afa1-aa80a32135b0"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            RowBox[{
              SubscriptBox["\[CapitalXi]", "LL"], "(", 
              SuperscriptBox[
               RowBox[{"(", 
                 SubsuperscriptBox["M", "LL", "q"], ")"}], "2"], ")"}], 
            "\", \"", 
