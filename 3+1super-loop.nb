               RowBox[{"Pi", "/", "as1Ell"}], " ", 
               RowBox[{"i", "/", "400."}]}]}]}], "}"}], ",", "\n", "     ", 
           RowBox[{"Flatten", "[", 
            RowBox[{
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"With", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"ep", " ", "=", " ", 
                   RowBox[{"t2epsLat", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"q", " ", "-", " ", 
