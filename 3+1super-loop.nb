    RowBox[{"2", 
     SubsuperscriptBox[
      StyleBox["M", "TI"], "LL", "q"]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"42a66b68-4ca2-4dcf-bf10-084898262053"]], "InlineFormula",
  ExpressionUUID->"2a420408-c804-4fca-9222-93a4411c1f52"],
 "."
}], "Text",ExpressionUUID->"84a08166-be7e-42a9-bbe7-72dbff4b1d12"],

