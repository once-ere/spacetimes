                    StyleBox["k", "TI"], "\[Prime]"]}]], 
                SubscriptBox[
                 OverscriptBox[
                  StyleBox["c", "TI"], "^"], 
                 RowBox[{"LL", ",", 
                   SuperscriptBox[
                    StyleBox["k", "TI"], "\[Prime]"]}]]}], TraditionalForm]},
            "RowDefault"],
           StripOnInput->False,
           FontFamily->"Source Sans Pro",
           FontSize->9.5],
          ImageSize->290]},
