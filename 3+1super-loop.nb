              RowBox[{"exp", 
                RowBox[{"(", 
                  RowBox[{
                    StyleBox["i", "TI"], 
                    SubsuperscriptBox["\[Theta]", "LL", "F"]}], ")"}], 
                SubscriptBox[
                 StyleBox["U", FontSlant -> "Plain"], "LL"]}], 
              TraditionalForm], 
             "\" on the isospin index of the particle component and as its \
complex conjugate on the hole component; and the exchange of the particle and \
the hole component, \"", 
             FormBox[
              RowBox[{
                SubsuperscriptBox[
                 StyleBox["X", FontSlant -> "Plain"], "LL", "ph"], 
                "\[LongEqual]", 
                RowBox[{"(", 
                  Cell[
                   BoxData[
                    FormBox[
                    GridBox[{{
                    Cell[
                    TextData[{" ", 
                    Cell["0", "InlineFormula"], " "}]], 
                    Cell[
                    TextData[{" ", 
                    Cell[
                    BoxData[
                    SubscriptBox[
                    StyleBox["1", FontSlant -> "Plain"], "8"]], 
                    "InlineFormula"], " "}]]}, {
                    Cell[
                    TextData[{" ", 
                    Cell[
                    BoxData[
                    SubscriptBox[
                    StyleBox["1", FontSlant -> "Plain"], "8"]], 
                    "InlineFormula"], " "}]], 
                    Cell[
                    TextData[{" ", 
                    Cell["0", "InlineFormula"], " "}]]}}], TraditionalForm]]],
                   ")"}]}], TraditionalForm], 
             "\", with which the particle-hole symmetry reads \"", 
             FormBox[
              RowBox[{
                SubsuperscriptBox[
                 StyleBox["X", FontSlant -> "Plain"], "LL", "ph"], 
                SuperscriptBox[
                 RowBox[{"(", 
                   SubsuperscriptBox[
                    StyleBox["H", "TI"], "LL", "DB"], ")"}], "*"], 
                SubsuperscriptBox[
                 StyleBox["X", FontSlant -> "Plain"], "LL", "ph"], 
                "\[LongEqual]", "-", 
                SubsuperscriptBox[
                 StyleBox["H", "TI"], "LL", "DB"]}], TraditionalForm]},
            "RowDefault"],
           StripOnInput->False,
           FontFamily->"Source Sans Pro",
           FontSize->9.5],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox[
             TagBox[
              StyleBox["A", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
