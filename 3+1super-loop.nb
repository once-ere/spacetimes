               FontSize->8],
              ImageSize->95], 
             PaneBox[
              StyleBox[
               
               TemplateBox[{
                "\"the ideals of polynomials in the real coefficients of a \
family generated by the Jacobi and by the Malcev identity; \"", 
                 FormBox[
                  SubsuperscriptBox[
                   StyleBox["w", "TI"], "LL", "sat"], TraditionalForm], 
                 "\" the auxiliary variable of the saturation (the points of \
the variety at which a given polynomial does not vanish are the points of the \
variety of the ideal enlarged by that polynomial times \"", 
                 FormBox[
                  SubsuperscriptBox[
                   StyleBox["w", "TI"], "LL", "sat"], TraditionalForm], 
                 "\", minus 1)\""},
                "RowDefault"],
               StripOnInput->False,
               FontFamily->"Source Sans Pro",
               FontSize->9.5],
              ImageSize->290]}
