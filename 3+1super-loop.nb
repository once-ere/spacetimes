                    RowBox[{"[", 
                    RowBox[{
                    StyleBox["x",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], ",", 
                    StyleBox["y",
                    FontWeight->"Bold",
                    FontSlant->"Plain"]}], "]"}], ",", 
