                RowBox[{"as10CountOk", " ", "=", " ", "False"}], ",", "\n", 
                "      ", 
                RowBox[{
                 RowBox[{"as10Dev", " ", "=", " ", 
                  RowBox[{"Max", "[", 
                   RowBox[{"as10Dev", ",", " ", 
                    RowBox[{"Max", "[", 
                    RowBox[{"Abs", "[", 
                    RowBox[{
                    RowBox[{"mine", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", " ", ";;", " ", 
                    RowBox[{"Length", "[", "expect", "]"}]}], "]"}], "]"}], 
                    " ", "-", " ", "expect"}], "]"}], "]"}]}], "]"}]}], ";", 
                 "\n", "      ", 
                 RowBox[{"(*", " ", 
                  RowBox[{
                  "the", " ", "next", " ", "kept", " ", "energy", " ", "lies",
                    " ", "above", " ", "the", " ", "level", " ", "10"}], " ", 
                  "*)"}], "\n", "      ", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"mine", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"Length", "[", "expect", "]"}], " ", "+", " ", 
                    "1"}], "]"}], "]"}], " ", "<", " ", 
                    RowBox[{
                    RowBox[{"Last", "[", "expect", "]"}], " ", "+", " ", 
                    "1.*^-9"}]}], ",", " ", 
                   RowBox[{"as10CountOk", " ", "=", " ", "False"}]}], "]"}], ";",
                  "\n", "      ", 
                 RowBox[{"Do", "[", 
                  RowBox[{
                   RowBox[{"AppendTo", "[", 
                    RowBox[{"as10LandauRows", ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"qq", ",", " ", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"i", " ", "==", " ", "1"}], ",", " ", "0", ",", 
                    " ", 
                    RowBox[{"Quotient", "[", 
                    RowBox[{"i", ",", " ", "2"}], "]"}]}], "]"}], ",", " ", 
                    RowBox[{"sg", " ", 
                    RowBox[{"mine", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], ",", " ", "1"}], 
                    "}"}]}], "]"}], ",", " ", 
                   RowBox[{"{", 
                    RowBox[{"i", ",", " ", 
                    RowBox[{"Length", "[", "expect", "]"}]}], "}"}]}], "]"}], 
                 ";", "\n", "      ", 
                 RowBox[{"Do", "[", 
                  RowBox[{
                   RowBox[{"AppendTo", "[", 
                    RowBox[{"as10LandauRows", ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"qq", ",", " ", "level", ",", " ", 
                    RowBox[{"sg", " ", 
                    RowBox[{"Sqrt", "[", 
                    RowBox[{
                    RowBox[{"mass", " ", "mass"}], " ", "+", " ", 
                    RowBox[{"2.", " ", "level", " ", "fieldAbs"}]}], "]"}]}], 
                    ",", " ", "0"}], "}"}]}], "]"}], ",", " ", 
                   RowBox[{"{", 
                    RowBox[{"level", ",", " ", "0", ",", " ", "10"}], "}"}]}],
                   "]"}]}]}], "]"}]}]}], "]"}], ",", "\n", "    ", 
           RowBox[{"{", 
            RowBox[{"sg", ",", " ", 
             RowBox[{"{", 
              RowBox[{"1.", ",", " ", 
               RowBox[{"-", "1."}]}], "}"}]}], "}"}]}], "]"}]}]}], "]"}], ",",
       "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"qq", ",", " ", 
        RowBox[{"{", 
         RowBox[{"0.5", ",", " ", 
          RowBox[{"-", "0.5"}]}], "}"}]}], "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"as10Bup", ",", " ", "as10Bdown"}], "}"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"gf", " ", "as10FF12"}], " ", "+", " ", 
        RowBox[{"0.5", " ", "gv", " ", "as10Fv12"}]}], ",", " ", 
       RowBox[{
        RowBox[{"gf", " ", "as10FF12"}], " ", "-", " ", 
        RowBox[{"0.5", " ", "gv", " ", "as10Fv12"}]}]}], "}"}]}], ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<AS-10\>\"", ",", 
     " ", "\"\<Landau levels (case D): for one isospin component (Q_LL = +1/2 \
or -1/2) in the constant magnetic fields FF_LL_12 = 1.2 of U(1)_F and \
Fv_LL^3_12 = 1.0 of the third isospin direction (Landau gauge AF_LL_2 = \
FF_LL_12 x_LL^1, Av_LL^3_2 = Fv_LL^3_12 x_LL^1; g_v = 0.7, g_F = 0.45), the \
component feels the magnetic field B_up = g_F FF_LL_12 + g_v Fv_LL^3_12/2 or \
B_down = g_F FF_LL_12 - g_v Fv_LL^3_12/2; the Dirac Hamiltonian alpha_LL^1 \
p_1 + alpha_LL^2 (p_2 - B_up x_LL^1) + beta_LL m at p_2 = p_3 = 0 (and the \
same with B_down), with the momentum operators p_j = -i d_j, diagonalized in \
a basis of 120 oscillator states of the frequency |B_up| (or |B_down|) (the \
states with a weight above 1e-8 on the ten highest oscillator states are \
discarded: for each isospin component they are the 40 states of the levels \
110 to 119, which the check does not use, and the two artefacts of the \
truncation, which have the energies +m and -m and live on the highest \
oscillator state), has the energies +m and -m once each and +-(m^2 + 2 n_L \
|B_up|)^(1/2) (or with |B_down|) twice each for n_L = 1 to 10, and no other \
energy below the level 10 (m = 0.4; tolerance 1e-10)\>\"", ",", "\n", "  ", 
     RowBox[{
      RowBox[{"as10Dev", " ", "<", " ", "1*^-10"}], " ", "&&", " ", 
      "as10CountOk", " ", "&&", " ", 
      RowBox[{"as10Discarded", " ", "==", " ", "84"}], " ", "&&", " ", 
      RowBox[{"as10DiscardedLevels", " ", "==", " ", "80"}], " ", "&&", " ", 
      RowBox[{"as10DiscardedAtMass", " ", "==", " ", "4"}]}], ",", "\n", "  ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<largest deviation \>\"", ",", " ", 
        RowBox[{"asSci", "[", "as10Dev", "]"}], ",", " ", "\"\<; B_up = \>\"",
         ",", " ", 
        RowBox[{"asFix", "[", 
         RowBox[{"as10Bup", ",", " ", "3"}], "]"}], ",", 
        " ", "\"\<, B_down = \>\"", ",", " ", 
        RowBox[{"asFix", "[", 
         RowBox[{"as10Bdown", ",", " ", "3"}], "]"}], ",", " ", "\"\<; \>\"", 
        ",", " ", "as10Discarded", ",", 
        " ", "\"\< discarded states, of them \>\"", ",", " ", 
        "as10DiscardedLevels", ",", "\n", 
        "    ", "\"\< at the levels 110 to 119 and \>\"", ",", " ", 
        "as10DiscardedAtMass", ",", 
        " ", "\"\< artefacts at +-m (original: 1.2e-14; B_up = 0.890, B_down \
= 0.190; 84 discarded states, of them 80 at the levels 110 to 119 and 4 \
artefacts at +-m)\>\""}], "}"}], "]"}]}], "]"}]}]}]], "Input",
 CellLabel->
  "In[799]:=",ExpressionUUID->"7e1457b0-fd1b-4eab-a09b-e0d20775642d"],

Cell[BoxData[
 StyleBox[
  TemplateBox[{
    StyleBox["\"PASS  \"", Bold, 
     RGBColor[0, 
      Rational[2, 3], 0], StripOnInput -> False], "\"AS-10: \"", 
    "\"Landau levels (case D): for one isospin component (Q_LL = +1/2 or \
-1/2) in the constant magnetic fields FF_LL_12 = 1.2 of U(1)_F and Fv_LL^3_12 \
= 1.0 of the third isospin direction (Landau gauge AF_LL_2 = FF_LL_12 x_LL^1, \
Av_LL^3_2 = Fv_LL^3_12 x_LL^1; g_v = 0.7, g_F = 0.45), the component feels \
the magnetic field B_up = g_F FF_LL_12 + g_v Fv_LL^3_12/2 or B_down = g_F \
FF_LL_12 - g_v Fv_LL^3_12/2; the Dirac Hamiltonian alpha_LL^1 p_1 + \
alpha_LL^2 (p_2 - B_up x_LL^1) + beta_LL m at p_2 = p_3 = 0 (and the same \
with B_down), with the momentum operators p_j = -i d_j, diagonalized in a \
basis of 120 oscillator states of the frequency |B_up| (or |B_down|) (the \
states with a weight above 1e-8 on the ten highest oscillator states are \
discarded: for each isospin component they are the 40 states of the levels \
110 to 119, which the check does not use, and the two artefacts of the \
truncation, which have the energies +m and -m and live on the highest \
oscillator state), has the energies +m and -m once each and +-(m^2 + 2 n_L \
|B_up|)^(1/2) (or with |B_down|) twice each for n_L = 1 to 10, and no other \
energy below the level 10 (m = 0.4; tolerance 1e-10)\"", 
    "\"  -- largest deviation 1.8e-14; B_up = 0.890, B_down = 0.190; 84 \
discarded states, of them 80 at the levels 110 to 119 and 4 artefacts at +-m \
(original: 1.2e-14; B_up = 0.890, B_down = 0.190; 84 discarded states, of \
them 80 at the levels 110 to 119 and 4 artefacts at +-m)\""},
   "RowDefault"],
  StripOnInput->False,
  LineIndent->0]], "Print",
 CellChangeTimes->{4.00402552082491*^9},
 CellLabel->
  "During evaluation of \
In[799]:=",ExpressionUUID->"44d9e4f8-b289-4fbe-9183-d8ac152447d2"]
