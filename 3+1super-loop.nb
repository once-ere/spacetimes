                   StyleBox["e",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], "4"]}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "9b1b02b9-6ffe-4daa-9831-38da66d88076"],
               " (Cayley-Dickson form), and ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
