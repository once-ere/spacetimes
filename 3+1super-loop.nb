       RowBox[{"kq", ",", " ", "0", ",", " ", 
        RowBox[{"as1N", " ", "-", " ", "1"}]}], "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"the", " ", "rows", " ", 
        RowBox[{"{", 
         RowBox[{
         "q", ",", " ", "Q_LL", ",", " ", "branch", ",", " ", "E_qp"}], "}"}],
         " ", "of", " ", "the", " ", "curves", " ", "of", " ", "Figure", " ", 
        "3", 
