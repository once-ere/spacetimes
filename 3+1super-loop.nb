     RowBox[{"{", "5", "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"mg15", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{"t2expm", "[", 
    RowBox[{
     RowBox[{"t2mq", "[", 
      RowBox[{"ulist", "[", 
       RowBox[{"[", "5", "]"}], "]"}], "]"}], " ", "+", " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"x", "[", 
         RowBox[{"[", "p", "]"}], "]"}], " ", 
        RowBox[{"t2mq", "[", 
         RowBox[{"ulist", "[", 
          RowBox[{"[", "p", "]"}], "]"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"p", ",", " ", "4"}], "}"}]}], "]"}]}], "]"}]}], ";"}], "\n", 

 RowBox[{
  RowBox[{
   RowBox[{"h15", " ", "=", " ", "1*^-4"}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"the", " ", "connection"}], " ", "-", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"d_p", " ", "Sspin"}], ")"}], " ", 
      RowBox[{"Sspin", "^", 
       RowBox[{"-", "1"}]}]}]}], ";", " ", 
    RowBox[{
    "the", " ", "scalar", " ", "factor", " ", "is", " ", "applied", " ", 
     "before", " ", "the", " ", "matrix", " ", "product", "\n", "   ", 
     RowBox[{"(", 
      RowBox[{
      "Dot", " ", "binds", " ", "more", " ", "strongly", " ", "than", " ", 
       "the", " ", "product", " ", "with", " ", "a", " ", "number"}], 
      ")"}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"conn15", "[", 
    RowBox[{"x_", ",", " ", "p_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{"0.5", "/", "h15"}], ")"}]}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"t2spinRep", "[", 
         RowBox[{"mg15", "[", 
          RowBox[{"shift", "[", 
           RowBox[{"x", ",", " ", "p", ",", " ", "h15"}], "]"}], "]"}], "]"}],
         " ", "-", " ", 
        RowBox[{"t2spinRep", "[", 
         RowBox[{"mg15", "[", 
          RowBox[{"shift", "[", 
           RowBox[{"x", ",", " ", "p", ",", " ", 
            RowBox[{"-", "h15"}]}], "]"}], "]"}], "]"}]}], ")"}]}], ")"}], 
    " ", ".", " ", 
    RowBox[{"t2spinRep", "[", 
     RowBox[{"t2inv2", "[", 
      RowBox[{"mg15", "[", "x", "]"}], "]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"gam15", "[", 
    RowBox[{"x_", ",", " ", "q_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"mg", " ", "=", " ", 
       RowBox[{"mg15", "[", "x", "]"}]}], "}"}], ",", " ", 
     RowBox[{
      RowBox[{"t2spinRep", "[", "mg", "]"}], " ", ".", " ", 
      RowBox[{"t2gamma", "[", "q", "]"}], " ", ".", " ", 
      RowBox[{"t2spinRep", "[", 
       RowBox[{"t2inv2", "[", "mg", "]"}], "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dev15form", " ", "=", " ", "0."}], ";", " ", 
  RowBox[{"dev15const", " ", "=", " ", "0."}], ";", " ", 
  RowBox[{"dev15curv", " ", "=", " ", "0."}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", " ", "=", " ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"t2Unit", "[", "]"}], ",", " ", 
            RowBox[{"{", "4", "}"}]}], "]"}]}], ",", " ", "gp"}], "}"}], ",", 
       "\n", "   ", 
       RowBox[{
        RowBox[{"gp", " ", "=", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"conn15", "[", 
            RowBox[{"x", ",", " ", "p"}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], ";",
         "\n", "   ", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"up", " ", "=", " ", 
               RowBox[{"gp", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"p", " ", "+", " ", "1"}], ",", " ", 
                  RowBox[{"1", " ", ";;", " ", "2"}], ",", " ", 
                  RowBox[{"1", " ", ";;", " ", "2"}]}], "]"}], "]"}]}], ",", 
              " ", 
              RowBox[{"lo", " ", "=", " ", 
               RowBox[{"gp", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"p", " ", "+", " ", "1"}], ",", " ", 
                  RowBox[{"3", " ", ";;", " ", "4"}], ",", " ", 
                  RowBox[{"3", " ", ";;", " ", "4"}]}], "]"}], "]"}]}], ",", 
              " ", "off"}], "}"}], ",", "\n", "      ", 
            RowBox[{
             RowBox[{"off", " ", "=", " ", 
              RowBox[{
               RowBox[{"fro", "[", 
                RowBox[{"gp", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{"p", " ", "+", " ", "1"}], ",", " ", 
                   RowBox[{"1", " ", ";;", " ", "2"}], ",", " ", 
                   RowBox[{"3", " ", ";;", " ", "4"}]}], "]"}], "]"}], "]"}], 
               " ", "+", " ", 
               RowBox[{"fro", "[", 
                RowBox[{"gp", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{"p", " ", "+", " ", "1"}], ",", " ", 
                   RowBox[{"3", " ", ";;", " ", "4"}], ",", " ", 
                   RowBox[{"1", " ", ";;", " ", "2"}]}], "]"}], "]"}], 
                "]"}]}]}], ";", "\n", "      ", 
             RowBox[{"dev15form", " ", "=", " ", 
              RowBox[{"Max", "[", 
               RowBox[{"dev15form", ",", " ", "off", ",", " ", 
                RowBox[{"fro", "[", 
                 RowBox[{"up", " ", "+", " ", 
                  RowBox[{"ConjugateTranspose", "[", "lo", "]"}]}], "]"}], ",",
                 " ", 
                RowBox[{"Abs", "[", 
                 RowBox[{"Tr", "[", "lo", "]"}], "]"}]}], "]"}]}], ";", "\n", 
             "      ", 
             RowBox[{"Do", "[", "\n", "       ", 
              RowBox[{
               RowBox[{
                RowBox[{"dev15const", " ", "=", " ", 
                 RowBox[{"Max", "[", 
                  RowBox[{"dev15const", ",", " ", 
                   RowBox[{"fro", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"gam15", "[", 
                    RowBox[{
                    RowBox[{"shift", "[", 
                    RowBox[{"x", ",", " ", "p", ",", " ", "h15"}], "]"}], ",",
                     " ", "q"}], "]"}], " ", "-", " ", 
                    RowBox[{"gam15", "[", 
                    RowBox[{
                    RowBox[{"shift", "[", 
                    RowBox[{"x", ",", " ", "p", ",", " ", 
                    RowBox[{"-", "h15"}]}], "]"}], ",", " ", "q"}], "]"}]}], 
                    ")"}], " ", 
                    RowBox[{"(", 
                    RowBox[{"0.5", "/", "h15"}], ")"}]}], " ", "+", " ", 
                    RowBox[{"comm", "[", 
                    RowBox[{
                    RowBox[{"gp", "[", 
                    RowBox[{"[", 
                    RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}], ",", " ", 
                    RowBox[{"gam15", "[", 
                    RowBox[{"x", ",", " ", "q"}], "]"}]}], "]"}]}], "]"}]}], 
                  "]"}]}], ";", "\n", "       ", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"q", " ", "!=", " ", "p"}], ",", "\n", "        ", 
                  RowBox[{"dev15curv", " ", "=", " ", 
                   RowBox[{"Max", "[", 
                    RowBox[{"dev15curv", ",", " ", 
                    RowBox[{"fro", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"conn15", "[", 
                    RowBox[{
                    RowBox[{"shift", "[", 
                    RowBox[{"x", ",", " ", "p", ",", " ", "h15"}], "]"}], ",",
                     " ", "q"}], "]"}], " ", "-", " ", 
                    RowBox[{"conn15", "[", 
                    RowBox[{
                    RowBox[{"shift", "[", 
                    RowBox[{"x", ",", " ", "p", ",", " ", 
                    RowBox[{"-", "h15"}]}], "]"}], ",", " ", "q"}], "]"}]}], 
                    ")"}], " ", 
                    RowBox[{"(", 
                    RowBox[{"0.5", "/", "h15"}], ")"}]}], " ", "-", "\n", 
                    "            ", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"conn15", "[", 
                    RowBox[{
                    RowBox[{"shift", "[", 
                    RowBox[{"x", ",", " ", "q", ",", " ", "h15"}], "]"}], ",",
                     " ", "p"}], "]"}], " ", "-", " ", 
                    RowBox[{"conn15", "[", 
                    RowBox[{
                    RowBox[{"shift", "[", 
                    RowBox[{"x", ",", " ", "q", ",", " ", 
                    RowBox[{"-", "h15"}]}], "]"}], ",", " ", "p"}], "]"}]}], 
                    ")"}], " ", 
                    RowBox[{"(", 
                    RowBox[{"0.5", "/", "h15"}], ")"}]}], " ", "+", " ", 
                    RowBox[{"comm", "[", 
                    RowBox[{
                    RowBox[{"gp", "[", 
                    RowBox[{"[", 
                    RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}], ",", " ", 
                    RowBox[{"gp", "[", 
                    RowBox[{"[", 
                    RowBox[{"q", " ", "+", " ", "1"}], "]"}], "]"}]}], 
                    "]"}]}], "]"}]}], "]"}]}]}], "]"}]}], ",", "\n", 
               "       ", 
               RowBox[{"{", 
                RowBox[{"q", ",", " ", "0", ",", " ", "3"}], "}"}]}], 
              "]"}]}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}]}], 
      "]"}], ",", " ", 
     RowBox[{"{", "20", "}"}]}], "]"}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"uniqueness", ":", " ", 
     RowBox[{
      RowBox[{"the", " ", "real"}], "-", 
      RowBox[{"linear", " ", "map", " ", "u"}]}]}], " ", "->", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{"sgen", 
         RowBox[{"(", "u", ")"}]}], ",", " ", 
        RowBox[{"gamma", "^", "q"}]}], "]"}], ")"}], "_q", " ", "has", " ", 
     "the", " ", "rank", " ", "6", " ", "on", " ", "the", " ", "six", " ", 
     "generators"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"cols15", " ", "=", " ", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{"gen", ",", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Flatten", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Re", "[", "#", "]"}], ",", " ", 
               RowBox[{"Im", "[", "#", "]"}]}], "}"}], " ", "&"}], " ", "/@", 
            " ", 
            RowBox[{"Flatten", "[", 
             RowBox[{"comm", "[", 
              RowBox[{"gen", ",", " ", 
               RowBox[{"t2gamma", "[", "q", "]"}]}], "]"}], "]"}]}], "]"}], ",",
           " ", 
          RowBox[{"{", 
           RowBox[{"q", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}], 
        "]"}]}], "]"}], ",", " ", 
     RowBox[{"Join", "[", 
      RowBox[{"sj", ",", " ", "sk"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gram15", " ", "=", " ", 
   RowBox[{"N", "[", 
    RowBox[{"cols15", " ", ".", " ", 
     RowBox[{"Transpose", "[", "cols15", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gev15", " ", "=", " ", 
   RowBox[{"First", "[", 
    RowBox[{"t2eigh", "[", "gram15", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"SL31Check", "[", 
  RowBox[{"\"\<GS-15\>\"", ",", 
   " ", "\"\<the Lorentz connection is fixed by the frame: for an x-dependent \
Lorentz transformation the connection -(d_p Sspin) Sspin^-1 has the form \
sgen(u), the Dirac matrices of the transformed frame are covariantly constant \
and the curvature vanishes (20 random points; tolerance 1e-6); the 24 \
commutators [sgen(J^j), gamma^q], [sgen(K^j), gamma^q] have the rank 6 \
(smallest Gram eigenvalue > 1e-6)\>\"", ",", "\n", "  ", 
   RowBox[{
    RowBox[{"dev15form", " ", "<", " ", "1*^-6"}], " ", "&&", " ", 
    RowBox[{"dev15const", " ", "<", " ", "1*^-6"}], " ", "&&", " ", 
    RowBox[{"dev15curv", " ", "<", " ", "1*^-6"}], " ", "&&", " ", 
    RowBox[{
     RowBox[{"gev15", "[", 
      RowBox[{"[", "1", "]"}], "]"}], " ", ">", " ", "1*^-6"}]}], ",", "\n", 
   "  ", 
   RowBox[{"Row", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<largest deviations \>\"", ",", " ", "dev15form", ",", 
      " ", "\"\<, \>\"", ",", " ", "dev15const", ",", " ", "\"\<, \>\"", ",", 
      " ", "dev15curv", ",", " ", "\"\<; smallest Gram eigenvalue \>\"", ",", 
      " ", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{"gev15", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"5", ",", " ", "3"}], "}"}]}], "]"}], ",", 
      " ", "\"\< (original: 1.0e-9, 3.6e-8, 8.0e-9; 8.000)\>\""}], "}"}], 
    "]"}]}], "]"}]}], "Input",
 CellLabel->
  "In[576]:=",ExpressionUUID->"77d47376-927c-494c-8da4-9613965200fb"],

Cell[BoxData[
 StyleBox[
  TemplateBox[{
    StyleBox["\"PASS  \"", Bold, 
     RGBColor[0, 
      Rational[2, 3], 0], StripOnInput -> False], "\"GS-15: \"", 
    "\"the Lorentz connection is fixed by the frame: for an x-dependent \
Lorentz transformation the connection -(d_p Sspin) Sspin^-1 has the form \
sgen(u), the Dirac matrices of the transformed frame are covariantly constant \
and the curvature vanishes (20 random points; tolerance 1e-6); the 24 \
commutators [sgen(J^j), gamma^q], [sgen(K^j), gamma^q] have the rank 6 \
(smallest Gram eigenvalue > 1e-6)\"", 
    "\"  -- largest deviations 1.03003e-9, 3.55302e-8, 7.9791e-9; smallest \
Gram eigenvalue 8.000 (original: 1.0e-9, 3.6e-8, 8.0e-9; 8.000)\""},
   "RowDefault"],
  StripOnInput->False,
  LineIndent->0]], "Print",
