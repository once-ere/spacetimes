     RowBox[{"StringCases", "[", 
      RowBox[{"s", ",", " ", 
       RowBox[{"{", "\n", "    ", 
        RowBox[{
         RowBox[{"RegularExpression", "[", "\"\<\\\\\\\\[A-Za-z]+\>\"", "]"}],
          ",", "      ", 
         RowBox[{"(*", " ", 
          RowBox[{"a", " ", "command", " ", "such", " ", 
