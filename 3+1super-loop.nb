    FontSlant->"Plain"], 
   RowBox[{"(", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["E", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], "-"], 
     SubsuperscriptBox[
      StyleBox["x", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], "0"]}], ")"}], "\[ThinSpace]", 
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], 
   SubsuperscriptBox["\[Chi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["pw",
     FontSlant->"Plain"]]}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"91ed703e-ab07-4e68-8087-0c71894995a3"],

Cell["(both times the plane wave). The probability of the hole is", "Text",ExpressionUUID->"5fb17028-2017-47a9-b57c-5d3a00260a6e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["P", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["h",
     FontSlant->"Plain"]], 
   RowBox[{"(", 
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "0"], ")"}], "\[LongEqual]", 
   SuperscriptBox[
    RowBox[{"(", 
     FractionBox[
      SubscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "-"]], ")"}], "2"], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["sin",
     FontSlant->"Plain"], "2"], 
   RowBox[{"(", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["E", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], "-"], 
     SubsuperscriptBox[
      StyleBox["x", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], "0"]}], ")"}]}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"f328f22a-e778-4645-9339-7a5274c67818"],

Cell[TextData[{
 "A bare particle is not a stationary state of the superfluid: the pair field \
converts it into a hole and back, with the angular frequency ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    SubsuperscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "-"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fe014b3e-eb08-4aaa-9e8d-955538864270"],
 " and the largest hole probability ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"]], "/", 
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "-"]}], ")"}], "2"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ecd1c82a-883f-428d-8546-545bee042f14"],
 ", which is 1 at the Fermi momentum and small far from it (the Rabi \
oscillation of a system with two states). Check AS-4 takes a ring of 16 sites \
with the parameters and the pair field of AS-3 and the positive-energy plane \
wave of isospin up at the allowed momentum number 1, integrates the lattice \
equations to the 101 output times ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "0"], "\[LongEqual]", "0", ",", "0.2", ",", 
    "\[Ellipsis]", ",", "20"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "960ce581-50ec-47b4-b04c-aff1e4772028"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[ScriptL]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["t",
      FontSlant->"Plain"]], "\[LongEqual]", "0.2"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "911955bf-4dcf-4fb0-bf84-906717cf75f2"],
 "), and compares the whole state with this solution, in which ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CurlyEpsilon]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["lat",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5bdeecc7-d754-4157-bdcf-85567f425eae"],
 " stands in place of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CurlyEpsilon]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0c25efd6-0128-46ee-ab1c-d6ce6dec96de"],
 ". The integrator, its tolerances and the requirements are those of check \
AS-2 (here the particle components with isospin down and the hole components \
with isospin up are exactly zero at all times, again half of the real \
unknowns). Figure 4(b) shows the probability of the hole."
}], "Text",ExpressionUUID->"e609d496-b169-4f07-a927-73c030b81438"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"AS", "-", "4"}], ":", " ", 
    RowBox[{
    "a", " ", "chain", " ", "of", " ", "16", " ", "sites", " ", "with", " ", 
     "the", " ", "uniform", " ", "pair", " ", "field", " ", 
     RowBox[{"(", 
      RowBox[{"0", ",", " ", "0", ",", " ", "Delta"}], ")"}], " ", "and", " ",
      "the", " ", "parameters", " ", "of", " ", "case", " ", "B"}]}], " ", 
   "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"as4N", " ", "=", " ", "16"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as4Lat", " ", "=", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<n\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"as4N", ",", " ", "1", ",", " ", "1"}], "}"}]}], ",", " ", 
       RowBox[{"\"\<ell\>\"", " ", "->", " ", "asBEll"}], ",", " ", 
       RowBox[{"\"\<periodic\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"True", ",", " ", "False", ",", " ", "False"}], "}"}]}], ",",
        " ", 
       RowBox[{"\"\<wilson\>\"", " ", "->", " ", "1.0"}], ",", " ", 
       RowBox[{"\"\<mass\>\"", " ", "->", " ", "mass"}], ",", " ", 
       RowBox[{"\"\<mu\>\"", " ", "->", " ", "asBMu"}]}], "|>"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as4Fields", " ", "=", " ", 
     RowBox[{"t2trivialFields", "[", "as4N", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"as4Fields", "[", 
        RowBox[{"[", 
         RowBox[{"\"\<d\>\"", ",", " ", "site"}], "]"}], "]"}], " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{"0.", ",", " ", "0.", ",", " ", "asBDelta"}], "}"}]}], ",", 
      " ", 
      RowBox[{"{", 
       RowBox[{"site", ",", " ", "as4N"}], "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "allowed", " ", "momentum", " ", "number", " ", "1"}], ";", 
     " ", 
     RowBox[{"chi_pw", ":", " ", 
      RowBox[{
      "the", " ", "Dirac", " ", "spinor", " ", "of", " ", "the", " ", 
       "largest", " ", "eigenvalue", " ", "eps_lat", " ", "with", " ", 
       "isospin", " ", "up"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"as4Q", " ", "=", " ", 
     RowBox[{"t2chainMomentum", "[", 
      RowBox[{"1", ",", " ", "as4N", ",", " ", "asBEll"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"as4E4", ",", " ", "as4V4"}], "}"}], " ", "=", " ", 
     RowBox[{"t2eigh", "[", 
      RowBox[{"t2hLatPlane", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"as4Q", ",", " ", "0.", ",", " ", "0."}], "}"}], ",", " ", 
        "asBEll", ",", " ", "mass", ",", " ", "1.0", ",", " ", 
        "asChainActive"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as4Eps", " ", "=", " ", 
     RowBox[{"as4E4", "[", 
      RowBox[{"[", "4", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as4Chi", " ", "=", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"as4V4", "[", 
           RowBox[{"[", 
            RowBox[{"a", ",", " ", "4"}], "]"}], "]"}], ",", " ", "0."}], 
         "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"a", ",", " ", "4"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as4KChi", " ", "=", " ", 
     RowBox[{"asK3", " ", ".", " ", "as4Chi"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"eps_lat", " ", "-", " ", 
     RowBox[{"mu", " ", "and", " ", "the", " ", "quasi"}], "-", 
     RowBox[{"particle", " ", "energy", " ", 
      RowBox[{"E", "^", "-"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"as4X", " ", "=", " ", 
     RowBox[{"as4Eps", " ", "-", " ", "asBMu"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as4E", " ", "=", " ", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"as4X", "^", "2"}], " ", "+", " ", 
       RowBox[{"asBDelta", "^", "2"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "exact", " ", "solution", " ", "at", " ", "the", " ", "time",
       " ", 
      RowBox[{"x0", ":", " ", 
       RowBox[{
       "the", " ", "particle", " ", "part", " ", "and", " ", "the", " ", 
        "hole", " ", "part"}]}]}], ",", " ", 
     RowBox[{"times", " ", "the", " ", "plane", " ", "wave"}]}], " ", "*)"}], 
   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"as4Exact", "[", 
      RowBox[{"x0_", "?", "NumericQ"}], "]"}], " ", ":=", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"cp", " ", "=", " ", 
          RowBox[{
           RowBox[{"Cos", "[", 
            RowBox[{"as4E", " ", "x0"}], "]"}], " ", "-", " ", 
           RowBox[{"I", " ", 
            RowBox[{"(", 
             RowBox[{"as4X", "/", "as4E"}], ")"}], " ", 
            RowBox[{"Sin", "[", 
             RowBox[{"as4E", " ", "x0"}], "]"}]}]}]}], ",", " ", 
         RowBox[{"ch", " ", "=", " ", 
          RowBox[{
           RowBox[{"-", "I"}], " ", 
           RowBox[{"(", 
            RowBox[{"asBDelta", "/", "as4E"}], ")"}], " ", 
           RowBox[{"Sin", "[", 
            RowBox[{"as4E", " ", "x0"}], "]"}]}]}]}], "}"}], ",", "\n", "   ", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"phaseSite", " ", "=", " ", 
              RowBox[{"Exp", "[", 
               RowBox[{"I", " ", "as4Q", " ", "asBEll", " ", "site"}], 
               "]"}]}], "}"}], ",", " ", 
            RowBox[{"Join", "[", 
             RowBox[{
              RowBox[{"cp", " ", "phaseSite", " ", "as4Chi"}], ",", " ", 
              RowBox[{"ch", " ", "phaseSite", " ", "as4KChi"}]}], "]"}]}], 
           "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"site", ",", " ", "0", ",", " ", 
            RowBox[{"as4N", " ", "-", " ", "1"}]}], "}"}]}], "]"}], "]"}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", "101", " ", "output", " ", "times", " ", "0"}], ",", 
     " ", "0.2", ",", " ", "...", ",", " ", 
     RowBox[{"20", ";", " ", 
      RowBox[{
       RowBox[{
       "the", " ", "integration", " ", "by", " ", "IDA", " ", "with", " ", 
        "the", " ", "tolerances", " ", "of", " ", "AS"}], "-", "2"}]}]}], " ",
     "*)"}], "\n", 
   RowBox[{
    RowBox[{"as4Touts", " ", "=", " ", 
     RowBox[{"0.2", " ", 
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", " ", "100"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as4H", " ", "=", " ", 
     RowBox[{"t2dense", "[", 
      RowBox[{"as4Lat", ",", " ", "as4Fields"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as4Run", " ", "=", " ", 
     RowBox[{"t2evolveIDAChecked", "[", 
      RowBox[{"as4H", ",", " ", 
       RowBox[{"as4Exact", "[", "0.", "]"}], ",", " ", "as4Touts", ",", " ", 
       "as2Rtol", ",", " ", "as2Atol"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as4ExactStates", " ", "=", " ", 
     RowBox[{"Map", "[", 
      RowBox[{"as4Exact", ",", " ", "as4Touts"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as4Deviations", " ", "=", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"AssociationQ", "[", "as4Run", "]"}], ",", " ", 
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Norm", "[", 
           RowBox[{"#1", " ", "-", " ", "#2"}], "]"}], " ", "&"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"as4Run", "[", "\"\<states\>\"", "]"}], ",", " ", 
           "as4ExactStates"}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"{", "Infinity", "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as4Norm", " ", "=", " ", 
     RowBox[{"Norm", "[", 
      RowBox[{"as4Exact", "[", "0.", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as4Dev", " ", "=", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"AssociationQ", "[", "as4Run", "]"}], ",", " ", 
       RowBox[{"Max", "[", 
        RowBox[{"as4Deviations", "/", 
         RowBox[{"Map", "[", 
          RowBox[{"Norm", ",", " ", "as4ExactStates"}], "]"}]}], "]"}], ",", 
       " ", "Infinity"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "the", " ", "probability", " ", "of", " ", "the", " ", "hole", " ", "of", 
     " ", "a", " ", 
     RowBox[{"state", ":", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
        "the", " ", "part", " ", "of", " ", "its", " ", "squared", " ", 
         "norm", " ", "in", " ", "the", " ", "hole", " ", "components", " ", 
         "9"}], ".."}], "16", " ", "of", " ", "every", " ", "site"}]}]}], " ",
     "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"as4Phole", "[", "w_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{"Partition", "[", 
            RowBox[{"w", ",", " ", "16"}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", 
             RowBox[{"9", " ", ";;", " ", "16"}]}], "]"}], "]"}], "]"}], 
         "]"}], "^", "2"}], "]"}], "/", 
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{"Abs", "[", "w", "]"}], "^", "2"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"the", " ", "rows", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x", "^", "0"}], ",", " ", 
       RowBox[{"P_hole", " ", "of", " ", "the", " ", "integration"}], ",", 
       " ", 
       RowBox[{"P_hole", " ", "exact"}]}], "}"}], " ", "of", " ", "Figure", " ",
      "4", 
     RowBox[{"(", "b", ")"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"as4RabiRows", " ", "=", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"AssociationQ", "[", "as4Run", "]"}], ",", "\n", "   ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"as4Touts", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
           RowBox[{"as4Phole", "[", 
            RowBox[{"as4Run", "[", 
             RowBox[{"[", 
              RowBox[{"\"\<states\>\"", ",", " ", "i"}], "]"}], "]"}], "]"}], 
           ",", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"asBDelta", "/", "as4E"}], ")"}], "^", "2"}], " ", 
            RowBox[{
             RowBox[{"Sin", "[", 
              RowBox[{"as4E", " ", 
               RowBox[{"as4Touts", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "^", "2"}]}]}], 
          "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", 
           RowBox[{"Length", "[", "as4Touts", "]"}]}], "}"}]}], "]"}], ",", 
       " ", 
       RowBox[{"{", "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<AS-4\>\"", ",", 
     " ", "\"\<the particle-hole (Rabi) oscillation of a particle injected \
into the uniform polar superfluid (case B): on a periodic chain of 16 sites \
(dx = 0.5, r_W = 1, m = 0.4, mu = 0.6) with the pair field dvec = (0, 0, \
0.3), the positive-energy lattice plane wave chi_pw of isospin up at the \
momentum 2 pi/(16 dx) evolves as (cos(E^- x_LL^0) - i ((eps_lat - mu)/E^-) \
sin(E^- x_LL^0)) (chi_pw, 0) - i (Delta/E^-) sin(E^- x_LL^0) (0, Kch_3 \
chi_pw), with E^- = ((eps_lat - mu)^2 + Delta^2)^(1/2): the probability of \
the hole is P_hole = (Delta/E^-)^2 sin^2(E^- x_LL^0); the integration of the \
lattice equations by IDA (SUNDIALS, through NDSolve with Method -> \
\\\"IDA\\\", in place of CVODE of the original program; rtol = 1e-12, atol = \
1e-14) agrees with this exact solution at the 101 output times x_LL^0 = 0, \
0.2, ..., 20: (1) the relative deviation of the whole state stays below 1e-9, \
the tolerance of the original check; (2) the states at the output times are \
the cubic Hermite polynomials of the stored values and derivatives (tolerance \
1e-12), and the largest deviation is at most the bound that follows from the \
measured exact local errors of the internal steps, (1 + h_IDA E_max/4) (sum \
of local_error) + h_IDA deriv_residual/4 + (h_IDA E_max)^4/384 (norm of the \
state); the numbers of steps and of evaluations of IDA and the largest ratio \
local_error/budget_step, with budget_step = rtol (norm of the state) + atol \
sqrt(512), are stated\>\"", ",", "\n", "  ", 
     RowBox[{
      RowBox[{"AssociationQ", "[", "as4Run", "]"}], " ", "&&", " ", 
      RowBox[{"as4Dev", " ", "<", " ", "1*^-9"}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"as4Run", "[", "\"\<hermite\>\"", "]"}], " ", "<", " ", 
       "1*^-12"}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"Max", "[", "as4Deviations", "]"}], " ", "<=", " ", 
       RowBox[{"as4Run", "[", "\"\<bsum\>\"", "]"}]}]}], ",", "\n", "  ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"AssociationQ", "[", "as4Run", "]"}], ",", "\n", "   ", 
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<largest relative deviation \>\"", ",", " ", 
          RowBox[{"asSci", "[", "as4Dev", "]"}], ",", 
          " ", "\"\< <= bound/(norm of the state) \>\"", ",", " ", 
          RowBox[{"asSci", "[", 
           RowBox[{
            RowBox[{"as4Run", "[", "\"\<bsum\>\"", "]"}], "/", "as4Norm"}], 
           "]"}], ",", 
          " ", "\"\<; (sum of local_error)/(norm of the state) \>\"", ",", 
          " ", 
          RowBox[{"asSci", "[", 
           RowBox[{
            RowBox[{"as4Run", "[", "\"\<sumloc\>\"", "]"}], "/", "as4Norm"}], 
           "]"}], ",", "\n", 
          "     ", "\"\<; largest local_error/budget_step \>\"", ",", " ", 
          RowBox[{"asSci", "[", 
           RowBox[{"as4Run", "[", "\"\<ratio\>\"", "]"}], "]"}], ",", "\n", 
          "     ", "\"\<; IDA: N_steps \>\"", ",", " ", 
          RowBox[{"as4Run", "[", "\"\<steps\>\"", "]"}], ",", 
          " ", "\"\<, N_evals \>\"", ",", " ", 
          RowBox[{"as4Run", "[", "\"\<evaluations\>\"", "]"}], ",", 
          " ", "\"\<, largest h_IDA \>\"", ",", " ", 
          RowBox[{"asSci", "[", 
           RowBox[{"as4Run", "[", "\"\<hmax\>\"", "]"}], "]"}], ",", 
          " ", "\"\<, largest deriv_residual \>\"", ",", " ", 
          RowBox[{"asSci", "[", 
           RowBox[{"as4Run", "[", "\"\<residual\>\"", "]"}], "]"}], ",", "\n",
           "     ", "\"\<, Hermite polynomials within \>\"", ",", " ", 
          RowBox[{"asSci", "[", 
           RowBox[{"as4Run", "[", "\"\<hermite\>\"", "]"}], "]"}], ",", 
          " ", "\"\<, E_max \>\"", ",", " ", 
          RowBox[{"asFix", "[", 
           RowBox[{
            RowBox[{"as4Run", "[", "\"\<emax\>\"", "]"}], ",", " ", "4"}], 
           "]"}], ",", " ", "\"\<; eps_lat = \>\"", ",", " ", 
          RowBox[{"asFix", "[", 
           RowBox[{"as4Eps", ",", " ", "6"}], "]"}], ",", 
          " ", "\"\<, E^- = \>\"", ",", " ", 
          RowBox[{"asFix", "[", 
           RowBox[{"as4E", ",", " ", "6"}], "]"}], ",", "\n", 
          "     ", "\"\<, largest P_hole = (Delta/E^-)^2 = \>\"", ",", " ", 
          RowBox[{"asFix", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"asBDelta", "/", "as4E"}], ")"}], "^", "2"}], ",", " ", 
            "6"}], "]"}], ",", "\n", 
          "     ", "\"\< (original program, CVODE: largest relative deviation \
4.7e-10, 486 steps, 963 evaluations of the right side; eps_lat = 0.943799, \
E^- = 0.456287, largest P_hole = 0.432281)\>\""}], "}"}], "]"}], ",", "\n", 
       "   ", "\"\<the integration by IDA failed\>\""}], "]"}]}], 
    "]"}]}]}]], "Input",
 CellLabel->
  "In[688]:=",ExpressionUUID->"89992390-3caa-4950-beab-d943e8e5fea3"],

Cell[BoxData[
 StyleBox[
  TemplateBox[{
    StyleBox["\"PASS  \"", Bold, 
     RGBColor[0, 
      Rational[2, 3], 0], StripOnInput -> False], "\"AS-4: \"", 
    "\"the particle-hole (Rabi) oscillation of a particle injected into the \
uniform polar superfluid (case B): on a periodic chain of 16 sites (dx = 0.5, \
r_W = 1, m = 0.4, mu = 0.6) with the pair field dvec = (0, 0, 0.3), the \
positive-energy lattice plane wave chi_pw of isospin up at the momentum 2 \
pi/(16 dx) evolves as (cos(E^- x_LL^0) - i ((eps_lat - mu)/E^-) sin(E^- \
x_LL^0)) (chi_pw, 0) - i (Delta/E^-) sin(E^- x_LL^0) (0, Kch_3 chi_pw), with \
E^- = ((eps_lat - mu)^2 + Delta^2)^(1/2): the probability of the hole is \
P_hole = (Delta/E^-)^2 sin^2(E^- x_LL^0); the integration of the lattice \
equations by IDA (SUNDIALS, through NDSolve with Method -> \\\"IDA\\\", in \
place of CVODE of the original program; rtol = 1e-12, atol = 1e-14) agrees \
with this exact solution at the 101 output times x_LL^0 = 0, 0.2, ..., 20: \
(1) the relative deviation of the whole state stays below 1e-9, the tolerance \
of the original check; (2) the states at the output times are the cubic \
Hermite polynomials of the stored values and derivatives (tolerance 1e-12), \
and the largest deviation is at most the bound that follows from the measured \
exact local errors of the internal steps, (1 + h_IDA E_max/4) (sum of \
local_error) + h_IDA deriv_residual/4 + (h_IDA E_max)^4/384 (norm of the \
state); the numbers of steps and of evaluations of IDA and the largest ratio \
local_error/budget_step, with budget_step = rtol (norm of the state) + atol \
sqrt(512), are stated\"", 
    "\"  -- largest relative deviation 5.8e-11 <= bound/(norm of the state) \
1.5e-7; (sum of local_error)/(norm of the state) 5.4e-11; largest \
local_error/budget_step 9.6e-1; IDA: N_steps 1194, N_evals 9429, largest \
h_IDA 1.7e-2, largest deriv_residual 5.2e-12, Hermite polynomials within \
4.8e-16, E_max 5.0090; eps_lat = 0.943799, E^- = 0.456287, largest P_hole = \
(Delta/E^-)^2 = 0.432281 (original program, CVODE: largest relative deviation \
4.7e-10, 486 steps, 963 evaluations of the right side; eps_lat = 0.943799, \
E^- = 0.456287, largest P_hole = 0.432281)\""},
   "RowDefault"],
  StripOnInput->False,
  LineIndent->0]], "Print",
