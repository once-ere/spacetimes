             RowBox[{"{", 
              RowBox[{
               RowBox[{"mine", " ", "=", " ", 
                RowBox[{"Sort", "[", 
                 RowBox[{"Abs", "[", 
                  RowBox[{"Select", "[", 
                   RowBox[{"kept", ",", " ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"#", " ", "sg"}], " ", ">", " ", "0"}], " ", 
                    "&"}]}], "]"}], "]"}], "]"}]}], ",", " ", "expect"}], 
              "}"}], ",", "\n", "     ", 
             RowBox[{"(*", " ", 
