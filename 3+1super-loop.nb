}, Open  ]],

Cell[TextData[{
 "S-9, algebra with the symbols of the Higgs mechanism of the superfluid \
boson singlet state. The rest masses of the two charged vector bosons and of \
the vector boson of the fermion number are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["W",
        FontSlant->"Plain"]], ")"}], "2"], "\[LongEqual]", "2", 
    SubsuperscriptBox[
     StyleBox["Z", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["s",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["g", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["v",
        FontSlant->"Plain"]], ")"}], "2"], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["vac",
        FontSlant->"Plain"]], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8720c118-7ac1-432f-98e1-2aeb1d190eba"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["F",
        FontSlant->"Plain"]], ")"}], "2"], "\[LongEqual]", "8", 
    SubsuperscriptBox[
     StyleBox["Z", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["s",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["g", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["F",
        FontSlant->"Plain"]], ")"}], "2"], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["vac",
        FontSlant->"Plain"]], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bb786e90-cb0d-4fc0-8e16-17afa626e965"],
 ", where ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["Z", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["s",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "90c7062d-86df-491b-9409-d99dc3517c6d"],
 " is the stiffness of the space derivatives and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["v",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "beb5e150-a3ad-4eb4-a2d5-3d1788400a68"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["F",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "22e252f2-7645-4899-aa99-a5ba4ba79c60"],
 " are the gauge couplings. The cell checks with ",
 StyleBox["Simplify",
  FontFamily->"Source Code Pro"],
 " that the ratio of the squared masses is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"4", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["g", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], 
        StyleBox["F",
         FontSlant->"Plain"]], "/", 
       SubsuperscriptBox[
        StyleBox["g", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], 
        StyleBox["v",
         FontSlant->"Plain"]]}], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "66632dcd-9af6-4c08-8839-583682ed4d16"],
 ", independent of the stiffness and of the gap, and with ",
 StyleBox["Solve",
  FontFamily->"Source Code Pro"],
 " that the gap can be recovered from ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["M", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["W",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "af5d796b-7849-4e5a-b91d-ff25bd4cffb2"],
 "."
}], "Text",ExpressionUUID->"a0a4a0e4-d127-4372-825a-f6228036af45"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"massRules", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      SubsuperscriptBox["M", "LL", "W"], " ", "->", " ", 
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{"2", " ", 
         SubsuperscriptBox["Z", "LL", "s"]}], "]"}], " ", 
       SubsuperscriptBox["g", "LL", "v"], " ", 
       SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"]}]}], ",", "\n", 
     "   ", 
     RowBox[{
      SubsuperscriptBox["M", "LL", "F"], " ", "->", " ", 
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{"8", " ", 
         SubsuperscriptBox["Z", "LL", "s"]}], "]"}], " ", 
       SubsuperscriptBox["g", "LL", "F"], " ", 
       SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"]}]}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{"ratio", " ", "=", " ", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox["M", "LL", "F"], "/", 
       SubsuperscriptBox["M", "LL", "W"]}], ")"}], "^", "2"}], " ", "/.", " ",
     "massRules"}], "]"}]}]}], "Input",
 CellLabel->
  "In[206]:=",ExpressionUUID->"b1b0feb3-7e02-4c8d-b779-8b2e94ced982"],

Cell[BoxData[
 FractionBox[
  RowBox[{"4", " ", 
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox["g", "LL", "F"], ")"}], "2"]}], 
  SuperscriptBox[
   RowBox[{"(", 
    SubsuperscriptBox["g", "LL", "v"], ")"}], "2"]]], "Output",
 CellChangeTimes->{4.004025486353923*^9},
 CellLabel->
  "Out[207]=",ExpressionUUID->"378d4ce3-c1ff-4890-9dd0-78f0cd9f42b7"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"gapFromMass", " ", "=", " ", 
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      SubsuperscriptBox["M", "LL", "W"], "^", "2"}], " ", "==", " ", 
     RowBox[{"2", " ", 
      SubsuperscriptBox["Z", "LL", "s"], " ", 
      RowBox[{
       SubsuperscriptBox["g", "LL", "v"], "^", "2"}], " ", 
      RowBox[{
       SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], "^", "2"}]}]}], ",",
     " ", 
    SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"]}], "]"}]}]], "Input",
 CellLabel->
  "In[208]:=",ExpressionUUID->"e1aa02cb-7a5b-41de-a813-842555e05489"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], "\[Rule]", 
     RowBox[{"-", 
      FractionBox[
       SubsuperscriptBox["M", "LL", "W"], 
       RowBox[{
        SqrtBox["2"], " ", 
        SubsuperscriptBox["g", "LL", "v"], " ", 
        SqrtBox[
         SubsuperscriptBox["Z", "LL", "s"]]}]]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], "\[Rule]", 
     FractionBox[
      SubsuperscriptBox["M", "LL", "W"], 
      RowBox[{
       SqrtBox["2"], " ", 
       SubsuperscriptBox["g", "LL", "v"], " ", 
       SqrtBox[
        SubsuperscriptBox["Z", "LL", "s"]]}]]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{4.004025486359922*^9},
 CellLabel->
  "Out[208]=",ExpressionUUID->"1b58123f-58f4-4742-8cce-4fb665249067"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-9\>\"", ",", 
    " ", "\"\<(M^F_LL / M^W_LL)^2 = 4 (g^F_LL / g^v_LL)^2 and the gap follows \
from M^W_LL (algebra with symbolized symbols)\>\"", ",", "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{"ratio", " ", "-", " ", 
        RowBox[{"4", " ", 
         RowBox[{
          RowBox[{
           SubsuperscriptBox["g", "LL", "F"], "^", "2"}], "/", 
          RowBox[{
           SubsuperscriptBox["g", "LL", "v"], "^", "2"}]}]}]}], "]"}], " ", "===",
       " ", "0"}], " ", "&&", " ", 
     RowBox[{
      RowBox[{"Length", "[", "gapFromMass", "]"}], " ", "==", " ", "2"}]}], ",",
     " ", "ratio"}], "]"}], ";"}]], "Input",
 CellLabel->
  "In[209]:=",ExpressionUUID->"3112008c-2b3d-4f49-b163-dadfa60f8515"],

Cell[BoxData[
 StyleBox[
  TemplateBox[{
    StyleBox["\"PASS  \"", Bold, 
     RGBColor[0, 
      Rational[2, 3], 0], StripOnInput -> False], "\"S-9: \"", 
    "\"(M^F_LL / M^W_LL)^2 = 4 (g^F_LL / g^v_LL)^2 and the gap follows from \
M^W_LL (algebra with symbolized symbols)\"", "\"  -- \"", 
    FractionBox[
     RowBox[{"4", " ", 
       SuperscriptBox[
        RowBox[{"(", 
          SubsuperscriptBox["g", "LL", "F"], ")"}], "2"]}], 
     SuperscriptBox[
      RowBox[{"(", 
        SubsuperscriptBox["g", "LL", "v"], ")"}], "2"]]},
   "RowDefault"],
  StripOnInput->False,
  LineIndent->0]], "Print",
 CellChangeTimes->{4.004025486362096*^9},
