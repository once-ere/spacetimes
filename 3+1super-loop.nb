                     "\[Dagger]"]}]], "InlineFormula"], " "}]], 
                    Cell[
                    TextData[{" ", 
                    Cell["0", "InlineFormula"], " "}]]}}], TraditionalForm]]],
                 ")"}], TraditionalForm], "\", where \"", 
             FormBox[
              RowBox[{
                SubscriptBox[
                 StyleBox["P", FontSlant -> "Plain"], "LL"], "(", 
