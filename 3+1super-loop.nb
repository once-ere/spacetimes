           FontSize->8],
          ImageSize->95], 
         PaneBox[
          StyleBox[
           TemplateBox[{"\"the local pair operator \"", 
             FormBox[
              RowBox[{
                SubsuperscriptBox["\[CapitalPi]", "LL", "\[Iota]"], 
