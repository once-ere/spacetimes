           FontSize->8],
          ImageSize->95], 
         PaneBox[
          StyleBox[
           TemplateBox[{"\"the constant Hermitian \"", 
             FormBox[
              RowBox[{"16", "\[Cross]", "16"}], TraditionalForm], 
             "\" matrix \"", 
             FormBox[
              RowBox[{
                SubsuperscriptBox[
                 StyleBox["Q", FontSlant -> "Plain"], "LL", "K"], 
                "\[LongEqual]", 
                RowBox[{"(", 
                  Cell[
                   BoxData[
                    FormBox[
                    GridBox[{{
                    Cell[
                    TextData[{" ", 
                    Cell["0", "InlineFormula"], " "}]], 
                    Cell[
                    TextData[{" ", 
                    Cell[
                    BoxData[
                    RowBox[{"-", 
                    StyleBox["i", "TI"], 
                    SubsuperscriptBox["\[Alpha]", "LL", "1"], 
                    SuperscriptBox[
                    RowBox[{"(", 
                    SubsuperscriptBox[
                    StyleBox["K", FontSlant -> "Plain"], "LL", "3"], ")"}], 
                    "\[Dagger]"]}]], "InlineFormula"], " "}]]}, {
                    Cell[
                    TextData[{" ", 
                    Cell[
                    BoxData[
                    RowBox[{"-", 
                    StyleBox["i", "TI"], 
                    SubsuperscriptBox["\[Alpha]", "LL", "1"], 
                    SubsuperscriptBox[
                    StyleBox["K", FontSlant -> "Plain"], "LL", "3"]}]], 
                    "InlineFormula"], " "}]], 
                    Cell[
                    TextData[{" ", 
                    Cell["0", "InlineFormula"], " "}]]}}], TraditionalForm]]],
                   ")"}]}], TraditionalForm], "\" (blocks of \"", 
             FormBox[
              RowBox[{"8", "\[Cross]", "8"}], TraditionalForm], 
             "\"), with \"", 
             FormBox[
              SuperscriptBox[
               RowBox[{"(", 
                 SubsuperscriptBox[
                  StyleBox["Q", FontSlant -> "Plain"], "LL", "K"], ")"}], 
               "2"], TraditionalForm], 
             "\" the unit matrix and the trace 0, through which the square of \
the Dirac-Bogoliubov-de Gennes operator of a wall of the pair field depends \
on the slope of the gap: \"", 
             FormBox[
              RowBox[{
                SuperscriptBox[
                 RowBox[{"(", 
                   SubsuperscriptBox[
                    StyleBox["H", "TI"], "LL", "DB"], ")"}], "2"], 
                "\[LongEqual]", 
                RowBox[{"(", 
                  RowBox[{"-", 
                    SuperscriptBox[
                    StyleBox["d", "TI"], "2"], "/", 
                    StyleBox["d", "TI"], 
                    SuperscriptBox[
                    RowBox[{"(", 
                    SubsuperscriptBox[
                    StyleBox["x", "TI"], "LL", "1"], ")"}], "2"], "+", 
                    SuperscriptBox[
                    RowBox[{"(", 
                    SubsuperscriptBox[
                    StyleBox["q", "TI"], "LL", "2"], ")"}], "2"], "+", 
                    SuperscriptBox[
                    RowBox[{"(", 
                    SubsuperscriptBox[
                    StyleBox["q", "TI"], "LL", "3"], ")"}], "2"], "+", 
                    SubsuperscriptBox[
                    StyleBox["m", "TI"], "LL", "2"], "+", 
                    SubsuperscriptBox["\[CapitalDelta]", "LL", "2"]}], ")"}], 
                "+", 
                RowBox[{"(", 
                  RowBox[{
                    StyleBox["d", "TI"], 
                    SubscriptBox["\[CapitalDelta]", "LL"], "/", 
                    StyleBox["d", "TI"], 
                    SubsuperscriptBox[
                    StyleBox["x", "TI"], "LL", "1"]}], ")"}], " ", 
                SubsuperscriptBox[
                 StyleBox["Q", FontSlant -> "Plain"], "LL", "K"]}], 
              TraditionalForm], "\"; and the number \"", 
             FormBox[
              RowBox[{
                SubsuperscriptBox[
                 StyleBox["k", "TI"], "LL", "K"], "\[LongEqual]", "0", ",", 
                "1", ",", "2", ",", "\[Ellipsis]"}], TraditionalForm], 
             "\" of a bound state of a kink, below \"", 
