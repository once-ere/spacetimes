Cell[BoxData[
 TagBox[GridBox[{
    {
     TagBox[GridBox[{
        {
         StyleBox["\<\"4 The covariant families and their classification\"\>",
          
          StripOnInput->False,
          FontSize->12,
          FontWeight->Bold]},
        {
         TagBox[GridBox[{
            {
             StyleBox["\<\"symbol\"\>",
              StripOnInput->False,
              FontFamily->"Source Sans Pro",
              FontWeight->Bold], 
             StyleBox["\<\"plain-text names\"\>",
              StripOnInput->False,
              FontFamily->"Source Sans Pro",
              FontWeight->Bold], 
             StyleBox["\<\"meaning\"\>",
              StripOnInput->False,
              FontFamily->"Source Sans Pro",
              FontWeight->Bold]},
            {
             PaneBox[
              TemplateBox[{
                SubsuperscriptBox["\[ScriptCapitalF]", "LL", "A"], "\", \"", 
                SubsuperscriptBox["\[ScriptCapitalF]", "LL", "B"], "\", \"", 
                SubsuperscriptBox["\[ScriptCapitalF]", "LL", "C"]},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              StyleBox["\<\"F_A F_B F_C\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[
              StyleBox[
               
               TemplateBox[{
                "\"the three families of covariant brackets: \"", 
                 FormBox[
                  SubsuperscriptBox[
                   StyleBox["F", "TI"], "LL", "A"], TraditionalForm], 
                 "\" on \"", 
                 FormBox[
                  RowBox[{
                    SubscriptBox[
                    StyleBox["l", "TI"], "LL"], "\[CirclePlus]", 
                    SubscriptBox[
                    StyleBox["s", "TI"], "LL"]}], TraditionalForm], 
                 "\" (dimension 14), \"", 
                 FormBox[
                  SubsuperscriptBox[
                   StyleBox["F", "TI"], "LL", "B"], TraditionalForm], 
                 "\" on \"", 
                 FormBox[
                  RowBox[{
                    SubscriptBox[
                    StyleBox["l", "TI"], "LL"], "\[CirclePlus]", 
                    SubscriptBox[
                    StyleBox["p", "TI"], "LL"], "\[CirclePlus]", 
                    SubscriptBox[
                    StyleBox["s", "TI"], "LL"]}], TraditionalForm], 
                 "\" (18), \"", 
                 FormBox[
                  SubsuperscriptBox[
                   StyleBox["F", "TI"], "LL", "C"], TraditionalForm], 
                 "\" on \"", 
                 FormBox[
                  RowBox[{
                    SubscriptBox[
                    StyleBox["l", "TI"], "LL"], "\[CirclePlus]", 
                    RowBox[{
                    StyleBox["s", "TI"], 
                    StyleBox["u", "TI"]}], 
                    RowBox[{"(", "2", ")"}], "\[CirclePlus]", 
                    SubscriptBox[
                    StyleBox["s", "TI"], "LL"]}], TraditionalForm], 
                 "\" (17)\""},
                "RowDefault"],
               StripOnInput->False,
               FontFamily->"Source Sans Pro",
               FontSize->9.5],
              ImageSize->290]},
            {
             PaneBox[
              TemplateBox[{
                SubscriptBox["\[GothicP]", "LL"], "\", \"", 
                TagBox[
                 StyleBox["r", FontWeight -> "Bold", FontSlant -> "Plain"], 
                 "SL31Bold"], "\", \"", 
                SuperscriptBox[
                 TagBox[
                  StyleBox["r", FontWeight -> "Bold", FontSlant -> "Plain"], 
                  "SL31Bold"], "\[Prime]"]},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              StyleBox["\<\"p_LL rP rP'\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[
              StyleBox[
               TemplateBox[{"\"the translations of the family \"", 
                 FormBox[
                  SubsuperscriptBox[
                   StyleBox["F", "TI"], "LL", "B"], TraditionalForm], 
                 "\": the real space of the Hermitian bi-quaternions \"", 
                 FormBox[
                  RowBox[{
                    StyleBox["r", FontSlant -> "Bold"], "\[LongEqual]", 
                    SuperscriptBox[
                    StyleBox["r", FontSlant -> "Bold"], "\[Dagger]"]}], 
                  TraditionalForm], "\" (dimension 4), on which \"", 
                 FormBox[
                  SubscriptBox[
                   StyleBox["l", "TI"], "LL"], TraditionalForm], 
                 "\" acts by \"", 
                 FormBox[
                  RowBox[{
                    RowBox[{"[", 
                    RowBox[{
                    StyleBox["u", FontSlant -> "Bold"], ",", 
                    StyleBox["r", FontSlant -> "Bold"]}], "]"}], 
                    "\[LongEqual]", 
                    StyleBox["u", FontSlant -> "Bold"], 
                    StyleBox["r", FontSlant -> "Bold"], "+", 
                    StyleBox["r", FontSlant -> "Bold"], 
                    SuperscriptBox[
                    StyleBox["u", FontSlant -> "Bold"], "\[Dagger]"]}], 
                  TraditionalForm]},
                "RowDefault"],
               StripOnInput->False,
               FontFamily->"Source Sans Pro",
               FontSize->9.5],
              ImageSize->290]},
            {
             PaneBox[
              TemplateBox[{
                SubsuperscriptBox["c", "LL", "tw"], "\", \"", 
                SubsuperscriptBox["c", "LL", "sl"], "\", \"", 
                SubsuperscriptBox["c", "LL", "PP"], "\", \"", 
                SubsuperscriptBox["c", "LL", "Ps"], "\", \"", 
                SubsuperscriptBox["c", "LL", "sP"], "\", \"", 
                SubsuperscriptBox["c", "LL", "TT"], "\", \"", 
                SubsuperscriptBox["c", "LL", "Ts"], "\", \"", 
                SubsuperscriptBox["c", "LL", "sT"]},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              
              StyleBox["\<\"c_tw c_sl c_PP c_Ps c_sP c_TT c_Ts c_sT csP cTT \
ctw_re ctw_im csl_re csl_im cPP_re cPP_im cPs_re cPs_im cTs_re cTs_im csT_re \
csT_im\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[
              StyleBox[
               TemplateBox[{"\"the coefficients of the families: \"", 
                 FormBox[
                  RowBox[{
                    RowBox[{"[", 
                    RowBox[{
                    StyleBox["u", FontSlant -> "Bold"], ",", 
                    StyleBox["b", FontSlant -> "Bold"], 
                    SubscriptBox[
                    StyleBox["e", FontSlant -> "Bold"], "4"]}], "]"}], 
                    "\[LongEqual]", 
                    SubsuperscriptBox[
                    StyleBox["c", "TI"], "LL", "tw"], 
                    RowBox[{"(", 
                    RowBox[{
                    SubscriptBox[
                    StyleBox["W", "TI"], "LL"], 
                    RowBox[{"(", 
                    StyleBox["u", FontSlant -> "Bold"], ")"}], 
                    StyleBox["b", FontSlant -> "Bold"]}], ")"}], 
                    SubscriptBox[
                    StyleBox["e", FontSlant -> "Bold"], "4"]}], 
                  TraditionalForm], "\" (the twist), \"", 
                 FormBox[
                  RowBox[{
                    RowBox[{"[", 
                    RowBox[{
                    StyleBox["b", FontSlant -> "Bold"], 
                    SubscriptBox[
                    StyleBox["e", FontSlant -> "Bold"], "4"], ",", 
                    SuperscriptBox[
                    StyleBox["b", FontSlant -> "Bold"], "\[Prime]"], 
                    SubscriptBox[
                    StyleBox["e", FontSlant -> "Bold"], "4"]}], "]"}], 
                    "\[Superset]", 
                    SubsuperscriptBox[
                    StyleBox["c", "TI"], "LL", "sl"], 
                    RowBox[{"(", 
                    RowBox[{
                    OverscriptBox[
                    StyleBox["b", FontSlant -> "Bold"], "_"], 
                    SuperscriptBox[
                    StyleBox["b", FontSlant -> "Bold"], "\[Prime]"], "-", 
                    SuperscriptBox[
                    OverscriptBox[
                    StyleBox["b", FontSlant -> "Bold"], "_"], "\[Prime]"], 
                    StyleBox["b", FontSlant -> "Bold"]}], ")"}]}], 
                  TraditionalForm], "\", \"", 
                 FormBox[
                  RowBox[{
                    RowBox[{"[", 
                    RowBox[{
                    StyleBox["r", FontSlant -> "Bold"], ",", 
                    SuperscriptBox[
                    StyleBox["r", FontSlant -> "Bold"], "\[Prime]"]}], "]"}], 
                    "\[LongEqual]", 
                    SubsuperscriptBox[
                    StyleBox["c", "TI"], "LL", "PP"], 
                    RowBox[{"(", 
                    RowBox[{
                    StyleBox["r", FontSlant -> "Bold"], 
                    SuperscriptBox[
                    OverscriptBox[
                    StyleBox["r", FontSlant -> "Bold"], "_"], "\[Prime]"], 
                    "-", 
                    SuperscriptBox[
                    StyleBox["r", FontSlant -> "Bold"], "\[Prime]"], 
                    OverscriptBox[
                    StyleBox["r", FontSlant -> "Bold"], "_"]}], ")"}]}], 
                  TraditionalForm], "\", \"", 
                 FormBox[
                  RowBox[{
                    RowBox[{"[", 
                    RowBox[{
                    StyleBox["r", FontSlant -> "Bold"], ",", 
                    StyleBox["b", FontSlant -> "Bold"], 
                    SubscriptBox[
                    StyleBox["e", FontSlant -> "Bold"], "4"]}], "]"}], 
                    "\[LongEqual]", 
                    SubsuperscriptBox[
                    StyleBox["c", "TI"], "LL", "Ps"], 
                    RowBox[{"(", 
                    RowBox[{
                    SuperscriptBox[
                    StyleBox["b", FontSlant -> "Bold"], "*"], 
                    OverscriptBox[
                    StyleBox["r", FontSlant -> "Bold"], "_"]}], ")"}], 
                    SubscriptBox[
                    StyleBox["e", FontSlant -> "Bold"], "4"]}], 
                  TraditionalForm], "\", \"", 
                 FormBox[
                  RowBox[{
                    RowBox[{"[", 
                    RowBox[{
                    StyleBox["b", FontSlant -> "Bold"], 
                    SubscriptBox[
                    StyleBox["e", FontSlant -> "Bold"], "4"], ",", 
                    SuperscriptBox[
                    StyleBox["b", FontSlant -> "Bold"], "\[Prime]"], 
                    SubscriptBox[
                    StyleBox["e", FontSlant -> "Bold"], "4"]}], "]"}], 
                    "\[Superset]", 
                    SubsuperscriptBox[
                    StyleBox["c", "TI"], "LL", "sP"], " ", 
                    StyleBox["i", "TI"], 
                    RowBox[{"(", 
                    RowBox[{
                    OverscriptBox[
                    StyleBox["b", FontSlant -> "Bold"], "_"], 
                    SuperscriptBox[
                    StyleBox["b", FontSlant -> "Bold"], 
                    RowBox[{"\[Prime]", "*"}]], "-", 
                    SuperscriptBox[
                    OverscriptBox[
                    StyleBox["b", FontSlant -> "Bold"], "_"], "\[Prime]"], 
                    SuperscriptBox[
                    StyleBox["b", FontSlant -> "Bold"], "*"]}], ")"}]}], 
                  TraditionalForm], "\", \"", 
                 FormBox[
                  RowBox[{
                    RowBox[{"[", 
                    RowBox[{
                    StyleBox["t", FontSlant -> "Bold"], ",", 
                    SuperscriptBox[
                    StyleBox["t", FontSlant -> "Bold"], "\[Prime]"]}], "]"}], 
                    "\[LongEqual]", 
                    SubsuperscriptBox[
                    StyleBox["c", "TI"], "LL", "TT"], 
                    RowBox[{"(", 
                    RowBox[{
                    StyleBox["t", FontSlant -> "Bold"], 
                    SuperscriptBox[
                    StyleBox["t", FontSlant -> "Bold"], "\[Prime]"], "-", 
                    SuperscriptBox[
                    StyleBox["t", FontSlant -> "Bold"], "\[Prime]"], 
                    StyleBox["t", FontSlant -> "Bold"]}], ")"}]}], 
                  TraditionalForm], "\", \"", 
                 FormBox[
                  RowBox[{
                    RowBox[{"[", 
                    RowBox[{
                    StyleBox["t", FontSlant -> "Bold"], ",", 
                    StyleBox["b", FontSlant -> "Bold"], 
                    SubscriptBox[
                    StyleBox["e", FontSlant -> "Bold"], "4"]}], "]"}], 
                    "\[LongEqual]", 
                    SubsuperscriptBox[
                    StyleBox["c", "TI"], "LL", "Ts"], 
                    RowBox[{"(", 
                    RowBox[{
                    StyleBox["t", FontSlant -> "Bold"], 
                    StyleBox["b", FontSlant -> "Bold"]}], ")"}], 
                    SubscriptBox[
                    StyleBox["e", FontSlant -> "Bold"], "4"]}], 
                  TraditionalForm], "\", \"", 
                 FormBox[
                  RowBox[{
                    RowBox[{"[", 
                    RowBox[{
                    StyleBox["b", FontSlant -> "Bold"], 
                    SubscriptBox[
                    StyleBox["e", FontSlant -> "Bold"], "4"], ",", 
                    SuperscriptBox[
                    StyleBox["b", FontSlant -> "Bold"], "\[Prime]"], 
                    SubscriptBox[
                    StyleBox["e", FontSlant -> "Bold"], "4"]}], "]"}], 
                    "\[Superset]", 
                    StyleBox["Re", FontSlant -> "Plain"], 
                    RowBox[{"[", 
                    RowBox[{
                    SubsuperscriptBox[
                    StyleBox["c", "TI"], "LL", "sT"], "(", 
                    RowBox[{
                    StyleBox["b", FontSlant -> "Bold"], 
                    SuperscriptBox[
                    OverscriptBox[
                    StyleBox["b", FontSlant -> "Bold"], "_"], "\[Prime]"], 
                    "-", 
                    SuperscriptBox[
                    StyleBox["b", FontSlant -> "Bold"], "\[Prime]"], 
                    OverscriptBox[
                    StyleBox["b", FontSlant -> "Bold"], "_"]}], ")"}], 
                    "]"}]}], TraditionalForm], "\"; complex except \"", 
                 FormBox[
                  SubsuperscriptBox[
                   StyleBox["c", "TI"], "LL", "sP"], TraditionalForm], 
                 "\", \"", 
                 FormBox[
                  SubsuperscriptBox[
                   StyleBox["c", "TI"], "LL", "TT"], TraditionalForm], 
                 "\" (real); plain text `ctw_re`, `ctw_im`: real and \
imaginary part of \"", 
                 FormBox[
                  SubsuperscriptBox[
                   StyleBox["c", "TI"], "LL", "tw"], TraditionalForm], 
                 "\", and likewise\""},
                "RowDefault"],
               StripOnInput->False,
               FontFamily->"Source Sans Pro",
               FontSize->9.5],
              ImageSize->290]},
            {
             PaneBox[
              TemplateBox[{
                SubsuperscriptBox["\[Lambda]", "LL", "sc"]},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              StyleBox["\<\"lambda_sc\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[
              StyleBox[
               TemplateBox[{"\"a complex number \"", 
                 FormBox[
                  RowBox[{"\[NotEqual]", "0"}], TraditionalForm], 
                 "\" by which the spinor charges are rescaled, \"", 
                 FormBox[
                  RowBox[{
                    StyleBox["b", FontSlant -> "Bold"], "\[RightTeeArrow]", 
                    SubsuperscriptBox["\[Lambda]", "LL", "sc"], 
                    StyleBox["b", FontSlant -> "Bold"]}], TraditionalForm]},
                "RowDefault"],
               StripOnInput->False,
               FontFamily->"Source Sans Pro",
               FontSize->9.5],
