                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "41b5bd25-a281-40b7-aba4-2170be8e6159"],
               ", ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubsuperscriptBox["\[Gamma]", 
                   StyleBox["LL",
                    FontSlant->"Plain"], 
                   StyleBox["j", "TI"]], "\[LongEqual]", 
                  RowBox[{"(", "\[NoBreak]", GridBox[{
                    {"0", 
                    SubsuperscriptBox["\[Sigma]", 
                    StyleBox["j", "TI"], 
                    StyleBox["LL",
                    FontSlant->"Plain"]]},
                    {
                    RowBox[{"-", 
                    SubsuperscriptBox["\[Sigma]", 
                    StyleBox["j", "TI"], 
                    StyleBox["LL",
                    FontSlant->"Plain"]]}], "0"}
                    },
                    
                    GridBoxAlignment->{
