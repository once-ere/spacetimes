            "05a0ba51-0ce0-478d-9933-e8c086afc4f0"],
           ": the smallest quasi-particle energy, at zero momentum"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "4bd221d7-40c9-409c-9d31-2d2554865dc4"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            RowBox[{
              SubsuperscriptBox["\[CapitalOmega]", "LL", "GL"], "(", 
