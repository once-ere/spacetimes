              FontWeight->Bold], 
             StyleBox["\<\"plain-text names\"\>",
              StripOnInput->False,
              FontFamily->"Source Sans Pro",
              FontWeight->Bold], 
             StyleBox["\<\"meaning\"\>",
              StripOnInput->False,
              FontFamily->"Source Sans Pro",
              FontWeight->Bold]},
            {
             PaneBox[
              TemplateBox[{"i", "\", \"", "j"},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              StyleBox["\<\"j j' j''\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[Cell[TextData[{
               
               "index of space-like coordinates; values 1, 2, 3 (ordinary \
space) unless a sum is said to run over all space-like coordinates of the \
spacetime. In Revision_SuperLoop only ",
               Cell[BoxData[
                FormBox[
                 StyleBox["j", "TI"], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "1f51ad20-f4c6-4005-bb47-20bfc56a9243"],
               
               " is used as an index, with the values 1, 2, 3, and with \
primes (",
               Cell[BoxData[
                FormBox[
                 SuperscriptBox[
                  StyleBox["j", "TI"], "\[Prime]"], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "4602fb1c-c2b0-4c4e-bc5f-7b03b01df978"],
               ", ",
               Cell[BoxData[
                FormBox[
                 SuperscriptBox[
                  StyleBox["j", "TI"], "\[Prime]\[Prime]"], TraditionalForm]],
                 "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "e1cc6776-1643-4972-9030-b822bc42cb3d"],
               
               ") where two or three such indices are needed: it labels the \
three imaginary quaternion units ",
               Cell[BoxData[
                FormBox[
                 SubscriptBox[
                  StyleBox["e",
                   FontWeight->"Bold",
                   FontSlant->"Plain"], 
                  StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "295dfc98-7557-4535-8324-84e4647d8e43"],
               ", which correspond to the three space directions of ",
               Cell[BoxData[
                FormBox[
                 SubsuperscriptBox[
                  StyleBox["\[DoubleStruckCapitalR]",
                   FontSlant->"Plain"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
                  RowBox[{"1", ",", "3"}]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "2a50da83-01f2-4958-8fcf-9e48f254139d"],
               ", the coordinates ",
               Cell[BoxData[
                FormBox[
                 SubsuperscriptBox[
                  StyleBox["x", "TI"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
                  StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "a4086472-c570-4da9-9d88-f38d4a7e1312"],
               ", the momentum components ",
               Cell[BoxData[
                FormBox[
                 SubsuperscriptBox[
                  StyleBox["q", "TI"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
                  StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "b145179c-ba65-452c-abb5-366f3b9f7a12"],
               ", the rotation and boost generators ",
               Cell[BoxData[
                FormBox[
                 SubsuperscriptBox[
                  StyleBox["J", "TI"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
                  StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "7fcd0eb7-01c0-4c34-9eaf-3fc6690304fd"],
               ", ",
               Cell[BoxData[
                FormBox[
                 SubsuperscriptBox[
                  StyleBox["K", "TI"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
                  StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "8f131746-5603-4599-b8d4-d07835228856"],
               ", and the Pauli matrices ",
               Cell[BoxData[
                FormBox[
                 SubsuperscriptBox["\[Sigma]", 
                  StyleBox["j", "TI"], 
                  StyleBox["LL",
                   FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "6760a8d8-47aa-4c6c-905f-7626c431a6d8"],
               " and Dirac matrices ",
               Cell[BoxData[
                FormBox[
                 SubsuperscriptBox["\[Alpha]", 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
                  StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "e77fda7c-3dce-4a64-b183-e0aebc858976"],
               ", ",
               Cell[BoxData[
                FormBox[
                 SubsuperscriptBox["\[Gamma]", 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
                  StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "26179399-4850-4423-b09f-3a2327d09082"],
               ". The letter ",
               Cell[BoxData[
                FormBox[
                 StyleBox["i", "TI"], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "72761bb5-d946-4a51-8aa5-11b85cfc2d8d"],
               " is the imaginary unit (entry ",
               Cell[BoxData[
                FormBox[
                 StyleBox["i", "TI"], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "0165d952-b010-4907-8d43-5bf5c507953c"],
               "); the isospin index is ",
               Cell[BoxData[
                FormBox["\[Iota]", TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "4d0a431d-db1d-42c0-bbda-af032e9b388a"],
               " (a different letter)."
              }], "Text",
               FontFamily->"Source Sans Pro",
               FontSize->9.5,ExpressionUUID->
               "1f8240ab-0c66-4c48-b8a7-095810fb5565"],
              ImageSize->290]},
            {
             PaneBox[
              TemplateBox[{"D"},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              StyleBox["\<\"D\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[Cell[TextData[{
               
               "the number of space dimensions in which the particles of \
matter have momentum: 7 (all space coordinates of 7+1), 4 (fields that do not \
depend on ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  RowBox[{
                   StyleBox["x", "TI"], "\[InvisibleSpace]", "5"}], ",", 
                  RowBox[{
                   StyleBox["x", "TI"], "\[InvisibleSpace]", "6"}], ",", 
                  RowBox[{
                   StyleBox["x", "TI"], "\[InvisibleSpace]", "7"}]}], 
                 TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "fea4f194-82aa-41a6-869d-608812107172"],
               ") or 3 (fields that depend on ordinary space only). ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubscriptBox[
                   StyleBox["V", "TI"], 
                   StyleBox["D", "TI"]], "\[LongEqual]", 
                  SuperscriptBox["\[Pi]", 
                   RowBox[{
                    StyleBox["D", "TI"], "/", "2"}]], "/", 
                  SubscriptBox["\[CapitalGamma]", 
                   StyleBox["E",
                    FontSlant->"Plain"]], 
                  RowBox[{"(", 
                   RowBox[{
                    StyleBox["D", "TI"], "/", "2", "+", "1"}], ")"}]}], 
                 TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "1c89842d-09cc-4c7e-bd97-f9f820f26464"],
               " is the volume and ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubscriptBox[
                   StyleBox["A", "TI"], 
                   StyleBox["D", "TI"]], "\[LongEqual]", 
                  StyleBox["D", "TI"], "\[ThinSpace]", 
                  SubscriptBox[
                   StyleBox["V", "TI"], 
                   StyleBox["D", "TI"]]}], TraditionalForm]], "InlineFormula",
                
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "4c43010a-4450-40e5-b1b4-8b8dadea4cf2"],
               " the area of the unit ball in ",
               Cell[BoxData[
                FormBox[
                 StyleBox["D", "TI"], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "5a437001-22d6-4880-a8c0-d94fd1ee17a3"],
               " dimensions (",
               Cell[BoxData[
                FormBox[
                 SubscriptBox["\[CapitalGamma]", 
                  StyleBox["E",
                   FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "cd3e67af-2665-4e70-a46d-e05b5ad7de8c"],
               ": Euler's gamma function). In the super-loop revision ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  StyleBox["D", "TI"], "\[LongEqual]", "3"}], 
                 TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "a7378c8b-be14-45e2-923b-08e38ef8c657"],
               " for the four-dimensional world of the superfluid and ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  StyleBox["D", "TI"], "\[LongEqual]", "7"}], 
                 TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "386740e7-ebe6-471c-ac74-18a315469cb1"],
               
               " for the eight-dimensional manifolds; the value 4, the \
coordinates ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  RowBox[{
                   StyleBox["x", "TI"], "\[InvisibleSpace]", "5"}], ",", 
                  RowBox[{
                   StyleBox["x", "TI"], "\[InvisibleSpace]", "6"}], ",", 
                  RowBox[{
                   StyleBox["x", "TI"], "\[InvisibleSpace]", "7"}]}], 
                 TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "37b2e22e-33ab-4357-9dd1-74ee0afc47e7"],
               
               " and the volume and the area of the unit ball do not occur. \
In the kinetic Lagrangian of the superfluid boson singlet state ",
               Cell[BoxData[
                FormBox[
                 StyleBox["D", "TI"], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "05464271-ea7e-4c99-a82c-74d243cf967c"],
               
               " is also continued away from 3: in dimensional regularization \
the momentum integrals are taken in ",
               Cell[BoxData[
                FormBox[
                 StyleBox["D", "TI"], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "77c6bd25-9866-4121-8ba6-a85a78ba37c2"],
               " space dimensions."
              }], "Text",
               FontFamily->"Source Sans Pro",
               FontSize->9.5,ExpressionUUID->
               "f89aa098-5eaf-4ddb-afb0-0d6e95bb5042"],
              ImageSize->290]},
            {
             PaneBox[
              TemplateBox[{"i"},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              StyleBox["\<\"\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[Cell[TextData[{
               "the imaginary unit, ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SuperscriptBox[
                   StyleBox["i", "TI"], "2"], "\[LongEqual]", 
                  RowBox[{"-", "1"}]}], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "90532bf5-a638-4bd5-bb9d-2fe1b00be932"],
               "; in ",
               Cell[BoxData[
                FormBox[
                 SubscriptBox[
                  StyleBox["\[DoubleStruckCapitalB]",
                   FontSlant->"Plain"], 
                  StyleBox["LL",
                   FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "06a179e9-46f8-4705-b740-05be184517d3"],
               
               " it is the imaginary unit of the complex coefficients: it \
commutes and associates with every bi-octonion and is not one of the units ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubscriptBox[
                   StyleBox["e",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], "1"], ",", "\[Ellipsis]", ",", 
                  SubscriptBox[
                   StyleBox["e",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], "7"]}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "c0561ef2-65ab-4508-855f-251b0f53677b"]
              }], "Text",
               FontFamily->"Source Sans Pro",
               FontSize->9.5,ExpressionUUID->
               "a65d4b3e-56a4-41a5-bf5c-98229f486e18"],
              ImageSize->290]},
            {
             PaneBox[
              
              TemplateBox[{
               "\[DoubleStruckCapitalR]", "\", \"", "\[DoubleStruckCapitalC]"},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              StyleBox["\<\"R C R^8 C^3 C^8\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[Cell[TextData[{
               "the real and the complex numbers (plain text: ",
               StyleBox["R^8",
                FontFamily->"Source Code Pro"],
               ", ",
               StyleBox["C^3",
                FontFamily->"Source Code Pro"],
               ", ",
               StyleBox["C^8",
                FontFamily->"Source Code Pro"],
               " are the real or complex vector spaces of that dimension)"
              }], "Text",
               FontFamily->"Source Sans Pro",
               FontSize->9.5,ExpressionUUID->
               "1b64379e-c926-4968-ae7f-57be96d6631b"],
              ImageSize->290]},
            {
             PaneBox[
              TemplateBox[{"p", "\", \"", 
                SuperscriptBox["p", "\[Prime]"]},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              StyleBox["\<\"p p' p1 p2 p3\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[Cell[TextData[{
               "a summation index over the basis of an algebra (values ",
               Cell[BoxData[
                FormBox[
                 RowBox[{"0", ",", "\[Ellipsis]", ",", "7"}], 
                 TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "a0bfb90a-6fbb-4bf1-ba13-f98d040bf9a4"],
               ", or ",
               Cell[BoxData[
                FormBox[
                 RowBox[{"0", ",", "\[Ellipsis]", ",", "3"}], 
                 TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "6f118ee4-c661-493f-9791-c208e00d1615"],
               
               " for the quaternions): in Revision_SuperLoop it labels the \
units ",
               Cell[BoxData[
                FormBox[
                 SubscriptBox[
                  StyleBox["e",
                   FontWeight->"Bold",
                   FontSlant->"Plain"], 
                  StyleBox["p", "TI"]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "f3b2f0c7-eb1f-40f1-b855-987cecf66ee7"],
               " of ",
               Cell[BoxData[
                FormBox[
                 SubscriptBox[
                  StyleBox["\[DoubleStruckCapitalB]",
                   FontSlant->"Plain"], 
                  StyleBox["LL",
                   FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "2a154945-1f37-48fa-b135-719ca4563027"],
               ", the coefficients ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubsuperscriptBox["\[Xi]", 
                   StyleBox["p", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]], 
                  RowBox[{"(", 
                   StyleBox["x",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], ")"}]}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "af9637e4-b36f-40a9-b938-73d2d2f8389d"],
               ", the coordinates ",
               Cell[BoxData[
                FormBox[
                 SubsuperscriptBox[
                  StyleBox["x", "TI"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
                  StyleBox["p", "TI"]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "671166f7-a962-4391-8065-5bbd9090dac7"],
               " of ",
               Cell[BoxData[
                FormBox[
                 SubsuperscriptBox[
                  StyleBox["\[DoubleStruckCapitalR]",
                   FontSlant->"Plain"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
                  RowBox[{"1", ",", "7"}]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "d900df1b-630b-463d-8fd0-65753ecff2dd"],
               " and ",
               Cell[BoxData[
                FormBox[
                 SubsuperscriptBox[
                  StyleBox["\[DoubleStruckCapitalR]",
                   FontSlant->"Plain"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
                  RowBox[{"1", ",", "3"}]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "6ecda769-a374-48dc-834a-d1333bcbdb73"],
               " and the Dirac matrices ",
               Cell[BoxData[
                FormBox[
                 SubsuperscriptBox["\[Gamma]", 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
                  StyleBox["p", "TI"]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "5f21a09f-13a9-4c88-928b-0baa831a8b90"],
               " (",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  StyleBox["p", "TI"], "\[LongEqual]", "0", ",", "1", ",", 
                  "2", ",", "3"}], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "1c747a7e-b8c3-45b7-a301-385886d073e2"],
               "); ",
               Cell[BoxData[
                FormBox[
                 SuperscriptBox[
                  StyleBox["p", "TI"], "\[Prime]"], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "12b646c0-c524-45b5-b92c-bf212451f5dd"],
               " is a second index of the same kind (plain text ",
               StyleBox["p1",
                FontFamily->"Source Code Pro"],
               ", ",
               StyleBox["p2",
                FontFamily->"Source Code Pro"],
               ", ",
               StyleBox["p3",
                FontFamily->"Source Code Pro"],
               ": three such indices)"
              }], "Text",
               FontFamily->"Source Sans Pro",
               FontSize->9.5,ExpressionUUID->
               "44dd0a96-b1cd-46ac-9cdb-6f95d4609056"],
              ImageSize->290]},
            {
             PaneBox[
              TemplateBox[{"\[Iota]", "\", \"", 
                SuperscriptBox["\[Iota]", "\[Prime]"], "\", \"", 
                SuperscriptBox["\[Iota]", "\[Prime]\[Prime]"]},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              StyleBox["\<\"iota\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[Cell[TextData[{
               
               "the isospin index, values 1, 2, 3: it labels the isospin \
generators ",
               Cell[BoxData[
                FormBox[
                 SubsuperscriptBox[
                  StyleBox["T", "TI"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "efd3ef44-fb70-4a72-8614-eb4432e6e666"],
               ", the Pauli matrices ",
               Cell[BoxData[
                FormBox[
                 SubsuperscriptBox["\[Tau]", "\[Iota]", 
                  StyleBox["LL",
                   FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "4322fc7b-25a9-458a-b8e6-4620df82cd78"],
               " on the isospin index of a field, the pair channels ",
               Cell[BoxData[
                FormBox[
                 SubsuperscriptBox[
                  StyleBox["K",
                   FontFamily->"Helvetica",
                   FontSlant->"Plain"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "326ff69d-edc2-408a-bcca-110d0ccde2c1"],
               ", ",
               Cell[BoxData[
                FormBox[
                 SubsuperscriptBox[
                  StyleBox["K",
                   FontFamily->"Helvetica",
                   FontSlant->"Plain"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
                  RowBox[{"\[Prime]", "\[Iota]"}]], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "149a007c-f73d-44f8-aaaf-6fb4b41c573f"],
               ", the pair operators ",
               Cell[BoxData[
                FormBox[
                 SubsuperscriptBox["\[CapitalPi]", 
                  StyleBox["LL",
                   FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "92e0857a-2848-4355-9390-e006d9ff0479"],
               " and the components ",
               Cell[BoxData[
                FormBox[
                 SubsuperscriptBox[
                  StyleBox["d", "TI"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "568e58bd-528d-4cd8-baa8-3a3b6e1a0d80"],
               
               " of the order parameter; it is an internal direction, not a \
direction in space (that is ",
               Cell[BoxData[
                FormBox[
                 StyleBox["j", "TI"], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "8ba798dd-c385-4727-bff4-b45d4214f92d"],
               ")"
              }], "Text",
               FontFamily->"Source Sans Pro",
               FontSize->9.5,ExpressionUUID->
               "b980cf72-56c5-41fa-bff5-9570612f47da"],
              ImageSize->290]},
            {
             PaneBox[
              TemplateBox[{
                SubsuperscriptBox["\[Epsilon]", 
                 RowBox[{"j", 
                   SuperscriptBox["j", "\[Prime]"], 
                   SuperscriptBox["j", "\[Prime]\[Prime]"]}], "LL"]},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              StyleBox["\<\"eps3\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[Cell[TextData[{
               "the Levi-Civita symbol: ",
               Cell[BoxData[
                FormBox[
                 RowBox[{"+", "1"}], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "0f804294-b05b-48b4-9047-2aaa2f2a337b"],
