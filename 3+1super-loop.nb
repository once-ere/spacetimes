                SubsuperscriptBox[
                 StyleBox["g", "TI"], "LL", "v"], 
                SuperscriptBox[
                 RowBox[{"(", 
                   SubsuperscriptBox[
                    StyleBox["w", "TI"], "LL", "n"], ")"}], "\[Iota]"]}], 
              TraditionalForm], "\" and the isospin block \"", 
             FormBox[
              RowBox[{
                SuperscriptBox[
                 RowBox[{"(", 
                   SubsuperscriptBox[
                    StyleBox["g", "TI"], "LL", "v"], ")"}], "2"], 
                SubsuperscriptBox[
                 StyleBox["N", FontSlant -> "Plain"], "LL", "v"]}], 
              TraditionalForm], "\", whose entries are \"", 
             FormBox[
              RowBox[{"|", 
                SubscriptBox[
                 OverscriptBox[
                  StyleBox["d", "TI"], "\[RightVector]"], "LL"], 
                SuperscriptBox["|", "2"], "-", "|", 
                SubsuperscriptBox[
                 StyleBox["d", "TI"], "LL", "\[Iota]"], 
                SuperscriptBox["|", "2"]}], TraditionalForm], 
             "\" on the diagonal and \"", 
             FormBox[
              RowBox[{"-", "Re", 
                RowBox[{"(", 
                  RowBox[{
                    SubsuperscriptBox[
                    StyleBox["d", "TI"], "LL", "\[Iota]"], 
                    SuperscriptBox[
                    RowBox[{"(", 
                    SubsuperscriptBox[
                    StyleBox["d", "TI"], "LL", 
                    SuperscriptBox["\[Iota]", "\[Prime]"]], ")"}], "*"]}], 
                  ")"}]}], TraditionalForm], 
             "\" off it; and the real vector \"", 
             FormBox[
              RowBox[{
                SubsuperscriptBox[
                 OverscriptBox[
                  StyleBox["w", "TI"], "\[RightVector]"], "LL", "n"], 
                "\[LongEqual]", "Re", " ", 
                SubscriptBox[
                 OverscriptBox[
                  StyleBox["d", "TI"], "\[RightVector]"], "LL"], "\[Cross]", 
                "Im", " ", 
                SubscriptBox[
                 OverscriptBox[
                  StyleBox["d", "TI"], "\[RightVector]"], "LL"]}], 
              TraditionalForm], "\", zero for the polar fields\""},
            "RowDefault"],
           StripOnInput->False,
           FontFamily->"Source Sans Pro",
           FontSize->9.5],
          ImageSize->290]},
        {
         PaneBox[
