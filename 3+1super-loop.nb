                    FontSlant->"Plain"], "2"], 
                  SubsuperscriptBox["\[Gamma]", 
                   StyleBox["LL",
                    FontSlant->"Plain"], "3"], "\[LongEqual]", 
                  StyleBox["diag",
                   FontSlant->"Plain"], 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"-", "1"}], ",", 
                    RowBox[{"-", "1"}], ",", "1", ",", "1"}], ")"}]}], 
                 TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "61a0b967-c06e-4296-a4b2-fd431347c1e7"],
               "; the charge-conjugation matrix ",
