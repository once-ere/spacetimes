              SubscriptBox[
               OverscriptBox[
                StyleBox["d", "TI"], "\[RightVector]"], "LL"], 
              TraditionalForm], "\"; and the same for \"", 
             FormBox[
              SubsuperscriptBox[
               OverscriptBox[
                StyleBox["u", "TI"], "\[RightVector]"], "LL", 
               SuperscriptBox["f", "\[Prime]"]], TraditionalForm]},
            "RowDefault"],
           StripOnInput->False,
           FontFamily->"Source Sans Pro",
           FontSize->9.5],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            RowBox[{
              SubsuperscriptBox["\[Chi]", "LL", "f"], "(", 
