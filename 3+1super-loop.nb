                  FontSlant->"Plain"], "3"]}], ")"}], "\[Times]", 
              SubscriptBox[
               OverscriptBox[
                StyleBox["d", "TI"], "\[RightVector]"], 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "a164d70a-57fa-4877-afdc-46447bc48285"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "5f2158a6-d80d-497d-831b-d0bd27d3806f"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["H", "LL", "vac"], "\", \"", 
            RowBox[{"U", 
              SubsuperscriptBox[
               RowBox[{"(", "1", ")"}], "LL", "Q"]}]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"H_vac U(1)^Q\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the stabilizer of the vacuum ",
           Cell[BoxData[
            FormBox[
             RowBox[{"(", 
              RowBox[{"0", ",", "0", ",", 
               SubsuperscriptBox["\[CapitalDelta]", 
                StyleBox["LL",
                 FontSlant->"Plain"], 
                StyleBox["vac",
                 FontSlant->"Plain"]]}], ")"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "e54c0c51-1c45-487a-8e43-b65a21fe2a93"],
           ": the gauge transformations ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubscriptBox[
               OverscriptBox[
                StyleBox["d", "TI"], "\[RightVector]"], 
               StyleBox["LL",
                FontSlant->"Plain"]], "\[RightTeeArrow]", 
              StyleBox["exp",
               FontSlant->"Plain"], 
              RowBox[{"(", 
               RowBox[{"2", 
                StyleBox["i", "TI"], 
                SubsuperscriptBox["\[Theta]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["F",
                  FontSlant->"Plain"]]}], ")"}], 
              SubsuperscriptBox[
               StyleBox["R",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["v",
                FontSlant->"Plain"]], 
              RowBox[{"(", 
               SubscriptBox[
                StyleBox["U",
                 FontFamily->"Helvetica",
                 FontSlant->"Plain"], 
                StyleBox["LL",
                 FontSlant->"Plain"]], ")"}], 
              SubscriptBox[
               OverscriptBox[
                StyleBox["d", "TI"], "\[RightVector]"], 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "9408356f-73e0-4b7e-8ad7-3148c2737ae9"],
           " that leave it unchanged, a group ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              StyleBox["O", "TI"], 
              RowBox[{"(", "2", ")"}]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "c9dd3e19-2c90-417e-97c5-b484057c8ab9"],
           " formed by the group ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              StyleBox["U", "TI"], 
              SubsuperscriptBox[
               RowBox[{"(", "1", ")"}], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["Q",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "a54fb764-880c-4478-8795-80da4f458551"],
           " of the electric charge (the rotations ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              StyleBox["exp",
               FontSlant->"Plain"], 
              RowBox[{"(", 
               RowBox[{
                StyleBox["i", "TI"], 
                SubsuperscriptBox["\[Theta]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], "3"], 
                SubscriptBox[
                 StyleBox["Q", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "add82708-9015-4da5-9f11-54720aad1371"],
           " about the third isospin axis) and the reflection ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox["\[Theta]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["F",
                FontSlant->"Plain"]], "\[LongEqual]", "\[Pi]", "/", "2"}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "68b730b0-67e2-4a34-9d80-1eb67ad22c9b"],
           ", ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubscriptBox[
               StyleBox["U",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"]], "\[LongEqual]", 
              StyleBox["i", "TI"], 
              SubsuperscriptBox["\[Tau]", "1", 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "5ea44212-d287-4cb0-ad78-895965415fe6"],
           ", which reverses the charge"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "76c692ee-651e-47bc-812f-c8c8618e7859"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            RowBox[{"S", "O", "(", "3", ")"}], "\", \"", 
            RowBox[{"O", "(", "2", ")"}]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"SO(3) O(2)\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the group of the rotations of three-dimensional space (here: of \
the isospin space; on the field ",
           Cell[BoxData[
            FormBox[
             SubscriptBox[
              OverscriptBox[
               StyleBox["d", "TI"], "\[RightVector]"], 
              StyleBox["LL",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "c3dbc5b3-82b9-4063-8d67-172d95e67839"],
           " the gauge transformations ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubscriptBox[
               OverscriptBox[
                StyleBox["d", "TI"], "\[RightVector]"], 
               StyleBox["LL",
                FontSlant->"Plain"]], "\[RightTeeArrow]", 
              StyleBox["exp",
               FontSlant->"Plain"], 
              RowBox[{"(", 
               RowBox[{"2", 
                StyleBox["i", "TI"], 
                SubsuperscriptBox["\[Theta]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["F",
                  FontSlant->"Plain"]]}], ")"}], 
              SubsuperscriptBox[
               StyleBox["R",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["v",
                FontSlant->"Plain"]], 
              RowBox[{"(", 
               SubscriptBox[
                StyleBox["U",
                 FontFamily->"Helvetica",
                 FontSlant->"Plain"], 
                StyleBox["LL",
                 FontSlant->"Plain"]], ")"}], 
              SubscriptBox[
               OverscriptBox[
                StyleBox["d", "TI"], "\[RightVector]"], 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "8ba9d445-c079-4f34-892e-a78e5aea424f"],
           " act as the phases times ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              StyleBox["SO", "TI"], 
              RowBox[{"(", "3", ")"}]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "4cececd8-7a6c-4764-99ea-1a4fe781998f"],
           "), and the group of the rotations and reflections of a plane"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "8ebbe611-d670-4c88-b49a-8dc9b77d108f"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["\[CurlyTheta]", 
             RowBox[{"LL", ",", "0"}], "G"], "\", \"", 
            SubsuperscriptBox["\[CurlyTheta]", 
             RowBox[{"LL", ",", "1"}], "G"], "\", \"", 
            SubsuperscriptBox["\[CurlyTheta]", 
             RowBox[{"LL", ",", "2"}], "G"], "\", \"", 
            SubsuperscriptBox["\[CurlyTheta]", "LL", "G"], "\", \"", 
            SubsuperscriptBox["\[CurlyPhi]", "LL", "G"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"thG0 thG1 thG2 thG phiG\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the three Goldstone fields of SFBSv: the phase ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[CurlyTheta]", 
              RowBox[{
               StyleBox["LL",
                FontSlant->"Plain"], ",", "0"}], 
              StyleBox["G",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "11bf12eb-0f65-44ab-bb62-607355071687"],
           " (the angle of the broken fermion number) and the angles ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[CurlyTheta]", 
              RowBox[{
               StyleBox["LL",
                FontSlant->"Plain"], ",", "1"}], 
              StyleBox["G",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "3cb6edb4-3db3-47e4-8945-90d5086a9058"],
           ", ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[CurlyTheta]", 
              RowBox[{
               StyleBox["LL",
                FontSlant->"Plain"], ",", "2"}], 
              StyleBox["G",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "8d0ca7aa-dd58-4896-b5bc-92db412ad323"],
           " of the broken isospin rotations about the first two axes; ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox["\[CurlyTheta]", 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", "1"}], 
               StyleBox["G",
                FontSlant->"Plain"]], "+", 
              StyleBox["i", "TI"], 
              SubsuperscriptBox["\[CurlyTheta]", 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", "2"}], 
               StyleBox["G",
                FontSlant->"Plain"]], "\[LongEqual]", 
              SubsuperscriptBox["\[CurlyTheta]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["G",
                FontSlant->"Plain"]], "\[ThinSpace]", 
              StyleBox["exp",
               FontSlant->"Plain"], 
              RowBox[{"(", 
               RowBox[{
                StyleBox["i", "TI"], 
                SubsuperscriptBox["\[CurlyPhi]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["G",
                  FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "ca2eae0a-85ca-4c07-868b-7825b43cb9e0"],
           " with ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox["\[CurlyTheta]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["G",
                FontSlant->"Plain"]], "\[GreaterEqual]", "0"}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "3ba229ec-fdb1-4d36-97ea-c234cbbf47c2"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "a197a353-0c9c-4c13-b31d-ad6f97378b5c"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox[
             TagBox[
              StyleBox["U", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
              "SL31SansSerif"], "LL", "G"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"UG U(thG1,thG2)\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the isospin rotation of the Goldstone fields of SFBSv, ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              StyleBox["exp",
               FontSlant->"Plain"], 
              RowBox[{"(", 
               RowBox[{
                FractionBox[
                 StyleBox["i", "TI"], "2"], 
                RowBox[{"(", 
                 RowBox[{
                  SubsuperscriptBox["\[CurlyTheta]", 
                   RowBox[{
                    StyleBox["LL",
                    FontSlant->"Plain"], ",", "1"}], 
                   StyleBox["G",
                    FontSlant->"Plain"]], 
                  SubsuperscriptBox["\[Tau]", "1", 
                   StyleBox["LL",
                    FontSlant->"Plain"]], "+", 
                  SubsuperscriptBox["\[CurlyTheta]", 
                   RowBox[{
                    StyleBox["LL",
                    FontSlant->"Plain"], ",", "2"}], 
                   StyleBox["G",
                    FontSlant->"Plain"]], 
                  SubsuperscriptBox["\[Tau]", "2", 
                   StyleBox["LL",
                    FontSlant->"Plain"]]}], ")"}]}], ")"}]}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "948ab32a-c271-47c2-a028-a0e35628681c"],
           ", a matrix of ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              StyleBox["SU", "TI"], 
              RowBox[{"(", "2", ")"}]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "a58233f8-1ef0-4901-9e75-ecfda691c21d"],
           " whose rotation turns the third isospin axis by the angle ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[CurlyTheta]", 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["G",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "a01a6151-f183-4cae-af9b-21c7a3c046a2"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "2182428c-78a3-4cfa-a949-9d62658fc7f9"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["h", "LL", "a"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"h_a\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the amplitude field of SFBSv: the change of the length of the \
real part of the field from ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[CapitalDelta]", 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["vac",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "40a557e6-11aa-4514-8e87-98a11b694881"],
           ", the analogue of the Higgs field; electrically neutral"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "ba9c555c-4817-44f4-974d-02181b26d0bc"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["c", 
             RowBox[{"LL", ",", "1"}], "n"], "\", \"", 
            SubsuperscriptBox["c", 
             RowBox[{"LL", ",", "2"}], "n"], "\", \"", 
            SubsuperscriptBox["\[CurlyRho]", "LL", "n"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"c_n1 c_n2 rho_n\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the two non-unitary fields of SFBSv, the components of an \
imaginary part orthogonal to the real part of the field (",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["c", "TI"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", "1"}], 
               StyleBox["n",
                FontSlant->"Plain"]], "\[MinusPlus]", 
              StyleBox["i", "TI"], "\[ThinSpace]", 
              SubsuperscriptBox[
               StyleBox["c", "TI"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", "2"}], 
               StyleBox["n",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "799363ba-d886-4d48-beb2-ee254045467f"],
           " carry the electric charge ",
           Cell[BoxData[
            FormBox[
             RowBox[{"\[PlusMinus]", "1"}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "185edcc8-15e7-4650-8025-9c35c65e9900"],
           "), and their modulus ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox["\[CurlyRho]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["n",
                FontSlant->"Plain"]], "\[LongEqual]", 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{
                 SuperscriptBox[
                  RowBox[{"(", 
                   SubsuperscriptBox[
                    StyleBox["c", "TI"], 
                    RowBox[{
                    StyleBox["LL",
                    FontSlant->"Plain"], ",", "1"}], 
                    StyleBox["n",
                    FontSlant->"Plain"]], ")"}], "2"], "+", 
                 SuperscriptBox[
                  RowBox[{"(", 
                   SubsuperscriptBox[
                    StyleBox["c", "TI"], 
                    RowBox[{
                    StyleBox["LL",
                    FontSlant->"Plain"], ",", "2"}], 
                    StyleBox["n",
                    FontSlant->"Plain"]], ")"}], "2"]}], ")"}], 
               RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
            
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "a0f2ad8c-9e8d-4913-b17c-a54aa8435245"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "6530ea75-6936-413f-9e23-f9a159cce87e"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            RowBox[{
              SubsuperscriptBox["\[CapitalOmega]", "LL", "H"], "(", 
              SubscriptBox[
               OverscriptBox["d", "\[RightVector]"], "LL"], ")"}], "\", \"", 
            SubsuperscriptBox["\[Lambda]", "LL", "H"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"Omega_H lambda_H\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the potential of the Higgs form with the minimum on ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["\[ScriptCapitalV]",
               FontSlant->"Plain"], 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["vac",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "9330e24c-87cc-4ede-824c-786c070a56bc"],
           ", ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox["\[Lambda]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["H",
                FontSlant->"Plain"]], 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{
                 SuperscriptBox[
                  RowBox[{"\[LeftBracketingBar]", 
                   SubscriptBox[
                    OverscriptBox[
                    StyleBox["d", "TI"], "\[RightVector]"], 
                    StyleBox["LL",
                    FontSlant->"Plain"]], "\[RightBracketingBar]"}], "2"], "-", 
                 SuperscriptBox[
                  RowBox[{"(", 
                   SubsuperscriptBox["\[CapitalDelta]", 
                    StyleBox["LL",
                    FontSlant->"Plain"], 
                    StyleBox["vac",
                    FontSlant->"Plain"]], ")"}], "2"]}], ")"}], "2"]}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "ac24a9f1-7f83-4f59-becd-5a31fc3dba16"],
           ", used for comparison; its coupling ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox["\[Lambda]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["H",
                FontSlant->"Plain"]], "\[LongEqual]", 
              SubsuperscriptBox["\[CapitalOmega]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               RowBox[{
                StyleBox["s",
                 FontSlant->"Plain"], 
                RowBox[{"(", "2", ")"}]}]], "/", 
              RowBox[{"(", 
               RowBox[{"4", 
                SuperscriptBox[
                 RowBox[{"(", 
                  SubsuperscriptBox["\[CapitalDelta]", 
                   StyleBox["LL",
                    FontSlant->"Plain"], 
                   StyleBox["vac",
                    FontSlant->"Plain"]], ")"}], "2"]}], ")"}]}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "d656ea37-0adf-4b64-88d0-e202a3c14cd6"],
           " gives it the curvature of the computed potential along ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["h", "TI"], 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["a",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "2304254a-74de-4505-b517-f031ec2a0387"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "4662f0b4-947c-4d09-8570-d58730983326"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["\[ScriptCapitalL]", "LL", "kin"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"Lagr_kin L_kin\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the kinetic Lagrangian of the SFBS, the part of ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["\[ScriptCapitalL]",
               FontSlant->"Plain"], 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["B",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "79ddf917-cc22-41fa-8686-bb86e81ded31"],
           " that contains the derivatives, ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["Z", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["t",
                FontSlant->"Plain"]], "\[ThinSpace]", 
              UnderscriptBox["\[Sum]", "\[Iota]",
               LimitsPositioning->True], 
              SuperscriptBox[
               RowBox[{"\[LeftBracketingBar]", 
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{
                   SubsuperscriptBox["\[Del]", 
                    RowBox[{
                    StyleBox["LL",
                    FontSlant->"Plain"], ",", "0"}], 
                    StyleBox["B",
                    FontSlant->"Plain"]], 
                   SubscriptBox[
                    OverscriptBox[
                    StyleBox["d", "TI"], "\[RightVector]"], 
                    StyleBox["LL",
                    FontSlant->"Plain"]]}], ")"}], "\[Iota]"], 
                "\[RightBracketingBar]"}], "2"], "-", 
              SubsuperscriptBox[
               StyleBox["Z", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["s",
                FontSlant->"Plain"]], "\[ThinSpace]", 
              UnderscriptBox["\[Sum]", 
               StyleBox["j", "TI"],
               LimitsPositioning->True], "\[ThinSpace]", 
              UnderscriptBox["\[Sum]", "\[Iota]",
               LimitsPositioning->True], 
              SuperscriptBox[
               RowBox[{"\[LeftBracketingBar]", 
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{
                   SubsuperscriptBox["\[Del]", 
                    RowBox[{
                    StyleBox["LL",
                    FontSlant->"Plain"], ",", 
                    StyleBox["j", "TI"]}], 
                    StyleBox["B",
                    FontSlant->"Plain"]], 
                   SubscriptBox[
                    OverscriptBox[
                    StyleBox["d", "TI"], "\[RightVector]"], 
                    StyleBox["LL",
                    FontSlant->"Plain"]]}], ")"}], "\[Iota]"], 
                "\[RightBracketingBar]"}], "2"]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "bc5f6dad-c122-4b21-885d-bbfa55db4eb6"],
           ", so that ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["\[ScriptCapitalL]",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["B",
                FontSlant->"Plain"]], "\[LongEqual]", 
              SubsuperscriptBox[
               StyleBox["\[ScriptCapitalL]",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["kin",
                FontSlant->"Plain"]], "-", 
              SubscriptBox["\[CapitalOmega]", 
               StyleBox["LL",
                FontSlant->"Plain"]], 
              RowBox[{"(", 
               SubscriptBox[
                OverscriptBox[
                 StyleBox["d", "TI"], "\[RightVector]"], 
                StyleBox["LL",
                 FontSlant->"Plain"]], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "12764bbf-449d-46f0-b227-98116af76ac0"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "dc5de387-c1a4-4a93-ad37-b51a481342db"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            RowBox[{
              SubsuperscriptBox[
               TagBox[
                StyleBox[
                "N", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
                "SL31SansSerif"], "LL", "g"], "(", 
              SubscriptBox[
               OverscriptBox["d", "\[RightVector]"], "LL"], ")"}], "\", \"", 
            RowBox[{
              SubsuperscriptBox[
               TagBox[
                StyleBox[
                "N", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
                "SL31SansSerif"], "LL", "v"], "(", 
              SubscriptBox[
               OverscriptBox["d", "\[RightVector]"], "LL"], ")"}], "\", \"", 
            SubsuperscriptBox[
             OverscriptBox["w", "\[RightVector]"], "LL", "n"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"N_g N_v w_n\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the contact matrix: the real symmetric ",
           Cell[BoxData[
            FormBox[
             RowBox[{"4", "\[Times]", "4"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "9242a924-10b7-466a-a1d6-2ec32fc225ac"],
           " matrix of the terms of ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              UnderscriptBox["\[Sum]", "\[Iota]",
               LimitsPositioning->True], 
              SuperscriptBox[
               RowBox[{"\[LeftBracketingBar]", 
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{
                   SubsuperscriptBox["\[Del]", 
                    RowBox[{
                    StyleBox["LL",
                    FontSlant->"Plain"], ",", 
                    StyleBox["p", "TI"]}], 
                    StyleBox["B",
                    FontSlant->"Plain"]], 
                   SubscriptBox[
                    OverscriptBox[
                    StyleBox["d", "TI"], "\[RightVector]"], 
                    StyleBox["LL",
                    FontSlant->"Plain"]]}], ")"}], "\[Iota]"], 
                "\[RightBracketingBar]"}], "2"]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "7b008609-4936-4ee5-8c07-1d5d342e7e51"],
           " that are quadratic in the potentials ",
           Cell[BoxData[
            FormBox[
             RowBox[{"(", 
              RowBox[{
               SubsuperscriptBox[
                StyleBox["A", "TI"], 
                RowBox[{
                 StyleBox["LL",
                  FontSlant->"Plain"], ",", 
                 StyleBox["p", "TI"]}], 
                StyleBox["F",
                 FontSlant->"Plain"]], ",", 
               SubsuperscriptBox[
                StyleBox["A", "TI"], 
                RowBox[{
                 StyleBox["LL",
                  FontSlant->"Plain"], ",", 
                 StyleBox["p", "TI"]}], "1"], ",", 
               SubsuperscriptBox[
                StyleBox["A", "TI"], 
                RowBox[{
                 StyleBox["LL",
                  FontSlant->"Plain"], ",", 
                 StyleBox["p", "TI"]}], "2"], ",", 
               SubsuperscriptBox[
                StyleBox["A", "TI"], 
                RowBox[{
                 StyleBox["LL",
                  FontSlant->"Plain"], ",", 
                 StyleBox["p", "TI"]}], "3"]}], ")"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "6ac86f33-ff46-40e4-94f2-390924d65158"],
           ", with the corner entry ",
           Cell[BoxData[
            FormBox[
             RowBox[{"4", 
              SuperscriptBox[
               RowBox[{"(", 
                SubsuperscriptBox[
                 StyleBox["g", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["F",
                  FontSlant->"Plain"]], ")"}], "2"], 
              SuperscriptBox[
               RowBox[{"\[LeftBracketingBar]", 
                SubscriptBox[
                 OverscriptBox[
                  StyleBox["d", "TI"], "\[RightVector]"], 
                 StyleBox["LL",
                  FontSlant->"Plain"]], "\[RightBracketingBar]"}], "2"]}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "5572f9c2-8842-4a24-b87a-565dc838f52a"],
           ", the first row and column ",
           Cell[BoxData[
            FormBox[
             RowBox[{"4", 
              SubsuperscriptBox[
               StyleBox["g", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["F",
                FontSlant->"Plain"]], 
              SubsuperscriptBox[
               StyleBox["g", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["v",
                FontSlant->"Plain"]], 
              SuperscriptBox[
               RowBox[{"(", 
                SubsuperscriptBox[
                 StyleBox["w", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["n",
                  FontSlant->"Plain"]], ")"}], "\[Iota]"]}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "e16db9e6-efca-4221-82e3-b7f0bb695b0a"],
           " and the isospin block ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SuperscriptBox[
               RowBox[{"(", 
                SubsuperscriptBox[
                 StyleBox["g", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["v",
                  FontSlant->"Plain"]], ")"}], "2"], 
              SubsuperscriptBox[
               StyleBox["N",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["v",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "3bc8a42b-2bd5-4f9b-b6c1-872edb4f51f8"],
           ", whose entries are ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SuperscriptBox[
               RowBox[{"\[LeftBracketingBar]", 
                SubscriptBox[
                 OverscriptBox[
                  StyleBox["d", "TI"], "\[RightVector]"], 
                 StyleBox["LL",
                  FontSlant->"Plain"]], "\[RightBracketingBar]"}], "2"], "-", 
              
              SuperscriptBox[
               RowBox[{"\[LeftBracketingBar]", 
                SubsuperscriptBox[
                 StyleBox["d", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], "\[Iota]"], "\[RightBracketingBar]"}], 
               "2"]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "43d3eea7-133c-4e0d-a14a-ba280dc33581"],
           " on the diagonal and ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              RowBox[{"-", 
               StyleBox["Re",
                FontSlant->"Plain"]}], 
              RowBox[{"(", 
               RowBox[{
                SubsuperscriptBox[
                 StyleBox["d", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], "\[Iota]"], 
                SuperscriptBox[
                 RowBox[{"(", 
                  SubsuperscriptBox[
                   StyleBox["d", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"], 
                   SuperscriptBox["\[Iota]", "\[Prime]"]], ")"}], "*"]}], 
               ")"}]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "49826d80-0781-4b5e-9d09-fbd636d0142c"],
           " off it; and the real vector ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               OverscriptBox[
                StyleBox["w", "TI"], "\[RightVector]"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["n",
                FontSlant->"Plain"]], "\[LongEqual]", 
              StyleBox["Re",
               FontSlant->"Plain"], "\[ThinSpace]", 
              SubscriptBox[
               OverscriptBox[
                StyleBox["d", "TI"], "\[RightVector]"], 
               StyleBox["LL",
                FontSlant->"Plain"]], "\[Times]", 
              StyleBox["Im",
               FontSlant->"Plain"], "\[ThinSpace]", 
              SubscriptBox[
               OverscriptBox[
                StyleBox["d", "TI"], "\[RightVector]"], 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "2e559d43-8343-4897-b6bd-0b63776f124c"],
           ", zero for the polar fields"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "eacd0c51-e84c-4434-b315-41d57bffdb10"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["E", "LL", "c"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"E_c E_Lambda\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the quasi-particle energy of the condensed vacuum ",
           Cell[BoxData[
            FormBox[
             RowBox[{"(", 
              RowBox[{"0", ",", "0", ",", 
               SubscriptBox["\[CapitalDelta]", 
                StyleBox["LL",
                 FontSlant->"Plain"]]}], ")"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "18039fa7-e6cc-4d0f-91ca-73d9ccc36add"],
           " at ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubscriptBox["\[Mu]", 
               StyleBox["LL",
                FontSlant->"Plain"]], "\[LongEqual]", "0"}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "95045ca2-d42f-4d4e-bab7-b7b1342bde33"],
           ", ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["E", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["c",
                FontSlant->"Plain"]], "\[LongEqual]", 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{
                 SubsuperscriptBox[
                  StyleBox["q", "TI"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], "2"], "+", 
                 SuperscriptBox[
                  RowBox[{"(", 
                   SubsuperscriptBox[
                    StyleBox["M", "TI"], 
                    StyleBox["LL",
                    FontSlant->"Plain"], 
                    StyleBox["q",
                    FontSlant->"Plain"]], ")"}], "2"]}], ")"}], 
               RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
            
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "632b16e4-b107-4e2b-94e7-bd412790904b"],
           ", an eigenvalue of ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubscriptBox[
               StyleBox["H",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"]], 
              RowBox[{"(", 
               SubscriptBox[
                OverscriptBox[
                 StyleBox["q", "TI"], "\[RightVector]"], 
                StyleBox["LL",
                 FontSlant->"Plain"]], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "5f57da50-fff1-47eb-98cd-e41af4353556"],
           " eight times with each sign; ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["E", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["c",
                FontSlant->"Plain"]], 
              RowBox[{"(", 
               SubscriptBox["\[CapitalLambda]", 
                StyleBox["LL",
                 FontSlant->"Plain"]], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "05909cad-9a84-422e-8599-2c030a8d1854"],
           " is its value at ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubscriptBox[
               StyleBox["q", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"]], "\[LongEqual]", 
              SubscriptBox["\[CapitalLambda]", 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "d63513ad-75a5-4be2-9cef-090a863abc81"],
           " (plain text ",
           StyleBox["E_Lambda",
            FontFamily->"Source Code Pro"],
           ")"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "582c8c6e-4bcf-4c48-9938-6298e2be6668"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox[
             OverscriptBox["a", "\[RightVector]"], "LL", "F"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"a_F\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the fermion-number coupling times the space components of a \
constant fermion-number potential, ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               OverscriptBox[
                StyleBox["a", "TI"], "\[RightVector]"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["F",
                FontSlant->"Plain"]], "\[LongEqual]", 
              SubsuperscriptBox[
               StyleBox["g", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["F",
                FontSlant->"Plain"]], 
              RowBox[{"(", 
               RowBox[{
                SubsuperscriptBox[
                 StyleBox["A", "TI"], 
                 RowBox[{
                  StyleBox["LL",
                   FontSlant->"Plain"], ",", "1"}], 
                 StyleBox["F",
                  FontSlant->"Plain"]], ",", 
                SubsuperscriptBox[
                 StyleBox["A", "TI"], 
                 RowBox[{
                  StyleBox["LL",
                   FontSlant->"Plain"], ",", "2"}], 
                 StyleBox["F",
                  FontSlant->"Plain"]], ",", 
                SubsuperscriptBox[
                 StyleBox["A", "TI"], 
                 RowBox[{
                  StyleBox["LL",
                   FontSlant->"Plain"], ",", "3"}], 
                 StyleBox["F",
                  FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "2ac3ffb1-3dbc-49a6-a1cc-3887ef10150a"],
           ": the shift of the kinetic momentum of both members of a pair"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
