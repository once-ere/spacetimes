                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "ce72bc5d-dfe7-42db-8e04-8d63ba06ecf7"],
               ", ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubsuperscriptBox["\[Gamma]", 
                   StyleBox["LL",
                    FontSlant->"Plain"], 
                   StyleBox["j", "TI"]], "\[LongEqual]", 
                  RowBox[{"(", "\[NoBreak]", GridBox[{
                    {"0", 
                    SubsuperscriptBox["\[Sigma]", 
                    StyleBox["j", "TI"], 
                    StyleBox["LL",
                    FontSlant->"Plain"]]},
                    {
                    RowBox[{"-", 
                    SubsuperscriptBox["\[Sigma]", 
                    StyleBox["j", "TI"], 
                    StyleBox["LL",
                    FontSlant->"Plain"]]}], "0"}
                    },
                    
                    GridBoxAlignment->{
                    "Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
                    GridBoxSpacings->{"Columns" -> {
                    Offset[0.27999999999999997`], {
                    Offset[0.7]}, 
