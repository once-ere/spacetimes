              ImageSize->125], 
             PaneBox[
              StyleBox["\<\"\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[
              
              StyleBox["\<\"the labels of the hypotheses of the no-go \
theorems: the symmetries form a group (H-grp), act as linear operators on the \
space of states (H-op), have generators that form a Lie algebra (H-Lie) or a \
Lie superalgebra (H-gr), and the dynamical hypotheses on the scattering \
matrix (H-dyn)\"\>",
               StripOnInput->False,
               FontFamily->"Source Sans Pro",
               FontSize->9.5],
              ImageSize->290]}
