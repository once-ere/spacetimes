          StripOnInput->False,
          FontFamily->"Source Sans Pro",
          FontWeight->Bold], 
         StyleBox["\<\"meaning\"\>",
          StripOnInput->False,
          FontFamily->"Source Sans Pro",
          FontWeight->Bold]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["\[Eta]", 
             RowBox[{"p", 
               SuperscriptBox["p", "\[Prime]"]}], "LL"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"eta\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[
          StyleBox[
           TemplateBox[{"\"the Minkowski metric of \"", 
             FormBox[
              SubsuperscriptBox[
               StyleBox["R", FontSlant -> "Plain"], "LL", 
               RowBox[{"1", ",", "3"}]], TraditionalForm], 
             "\" in the coordinates \"", 
             FormBox[
              SubsuperscriptBox[
               StyleBox["x", "TI"], "LL", 
               StyleBox["p", "TI"]], TraditionalForm], "\": \"", 
             FormBox[
              RowBox[{
                SubsuperscriptBox["\[Eta]", "00", "LL"], "\[LongEqual]", 
                "1"}], TraditionalForm], "\", \"", 
             FormBox[
              RowBox[{
                SubsuperscriptBox["\[Eta]", "11", "LL"], "\[LongEqual]", 
                SubsuperscriptBox["\[Eta]", "22", "LL"], "\[LongEqual]", 
                SubsuperscriptBox["\[Eta]", "33", "LL"], "\[LongEqual]", 
                "-1"}], TraditionalForm], "\" and \"", 
             FormBox[
              RowBox[{
                SubsuperscriptBox["\[Eta]", 
                 RowBox[{
                   StyleBox["p", "TI"], 
                   SuperscriptBox[
                    StyleBox["p", "TI"], "\[Prime]"]}], "LL"], "\[LongEqual]",
                 "0"}], TraditionalForm], "\" for \"", 
             FormBox[
              RowBox[{
                StyleBox["p", "TI"], "\[NotEqual]", 
                SuperscriptBox[
                 StyleBox["p", "TI"], "\[Prime]"]}], TraditionalForm], 
             "\"; it is its own inverse and raises and lowers the indices \"", 
             FormBox[
              StyleBox["p", "TI"], TraditionalForm], "\", \"", 
             FormBox[
              SuperscriptBox[
               StyleBox["p", "TI"], "\[Prime]"], TraditionalForm]},
            "RowDefault"],
           StripOnInput->False,
           FontFamily->"Source Sans Pro",
           FontSize->9.5],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubscriptBox["x", "LL"], "\", \"", 
            SubscriptBox[
             OverscriptBox["x", "\[RightVector]"], "LL"], "\", \"", 
            SubscriptBox["\[PartialD]", "p"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"x_LL xvec d_p\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[
          StyleBox[
           TemplateBox[{"\"a point of \"", 
             FormBox[
              SubsuperscriptBox[
               StyleBox["R", FontSlant -> "Plain"], "LL", 
               RowBox[{"1", ",", "3"}]], TraditionalForm], 
             "\" given by its coordinates, \"", 
             FormBox[
              RowBox[{
                SubscriptBox[
                 StyleBox["x", "TI"], "LL"], "\[LongEqual]", 
                RowBox[{"(", 
                  RowBox[{
                    SubsuperscriptBox[
                    StyleBox["x", "TI"], "LL", "0"], ",", 
                    SubsuperscriptBox[
                    StyleBox["x", "TI"], "LL", "1"], ",", 
                    SubsuperscriptBox[
                    StyleBox["x", "TI"], "LL", "2"], ",", 
                    SubsuperscriptBox[
                    StyleBox["x", "TI"], "LL", "3"]}], ")"}]}], 
              TraditionalForm], "\" (its Hermitian bi-quaternion is \"", 
             FormBox[
              RowBox[{
                SubsuperscriptBox[
                 StyleBox["x", "TI"], "LL", "0"], 
                SubscriptBox[
                 StyleBox["e", FontSlant -> "Bold"], "0"], "+", 
                StyleBox["i", "TI"], 
                UnderscriptBox["\[Sum]", 
                 StyleBox["j", "TI"], LimitsPositioning -> True], 
                SubsuperscriptBox[
                 StyleBox["x", "TI"], "LL", 
                 StyleBox["j", "TI"]], 
                SubscriptBox[
                 StyleBox["e", FontSlant -> "Bold"], 
                 StyleBox["j", "TI"]]}], TraditionalForm], 
             "\"), and its space part \"", 
             FormBox[
              RowBox[{
                SubscriptBox[
                 OverscriptBox[
                  StyleBox["x", "TI"], "\[RightVector]"], "LL"], 
                "\[LongEqual]", 
                RowBox[{"(", 
                  RowBox[{
                    SubsuperscriptBox[
                    StyleBox["x", "TI"], "LL", "1"], ",", 
                    SubsuperscriptBox[
                    StyleBox["x", "TI"], "LL", "2"], ",", 
                    SubsuperscriptBox[
                    StyleBox["x", "TI"], "LL", "3"]}], ")"}]}], 
              TraditionalForm], "\"; \"", 
             FormBox[
              SubsuperscriptBox[
               StyleBox["x", "TI"], "LL", "0"], TraditionalForm], 
             "\" is the time; \"", 
             FormBox[
              SubscriptBox["\[PartialD]", 
               StyleBox["p", "TI"]], TraditionalForm], 
             "\" is the partial derivative with respect to \"", 
             FormBox[
              SubsuperscriptBox[
               StyleBox["x", "TI"], "LL", 
               StyleBox["p", "TI"]], TraditionalForm], 
             "\" (plain text `d_p`)\""},
            "RowDefault"],
           StripOnInput->False,
           FontFamily->"Source Sans Pro",
           FontSize->9.5],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubscriptBox[
             TagBox[
              StyleBox["f", FontWeight -> "Bold", FontSlant -> "Plain"], 
              "SL31Bold"], "p"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"f_p f_0 f_j\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[
          StyleBox[
           TemplateBox[{"\"the frame of \"", 
             FormBox[
              SubsuperscriptBox[
               StyleBox["R", FontSlant -> "Plain"], "LL", 
               RowBox[{"1", ",", "3"}]], TraditionalForm], 
             "\": four Hermitian bi-quaternions \"", 
             FormBox[
              RowBox[{
                SubscriptBox[
                 StyleBox["f", FontSlant -> "Bold"], "0"], ",", "\[Ellipsis]",
                 ",", 
                SubscriptBox[
                 StyleBox["f", FontSlant -> "Bold"], "3"]}], TraditionalForm],
              "\" with \"", 
             FormBox[
              RowBox[{
                SubscriptBox[
                 StyleBox["N", "TI"], "LL"], 
                RowBox[{"(", 
                  RowBox[{
                    SubscriptBox[
                    StyleBox["f", FontSlant -> "Bold"], 
                    StyleBox["p", "TI"]], ",", 
                    SubscriptBox[
                    StyleBox["f", FontSlant -> "Bold"], 
                    SuperscriptBox[
                    StyleBox["p", "TI"], "\[Prime]"]]}], ")"}], 
                "\[LongEqual]", 
                SubsuperscriptBox["\[Eta]", 
                 RowBox[{
                   StyleBox["p", "TI"], 
                   SuperscriptBox[
                    StyleBox["p", "TI"], "\[Prime]"]}], "LL"]}], 
              TraditionalForm], "\", possibly depending on the point \"", 
             FormBox[
              SubscriptBox[
               StyleBox["x", "TI"], "LL"], TraditionalForm], 
             "\" (a vierbein); the canonical frame is \"", 
             FormBox[
              RowBox[{
                SubscriptBox[
                 StyleBox["f", FontSlant -> "Bold"], "0"], "\[LongEqual]", 
                SubscriptBox[
                 StyleBox["e", FontSlant -> "Bold"], "0"]}], TraditionalForm],
              "\", \"", 
             FormBox[
              RowBox[{
                SubscriptBox[
                 StyleBox["f", FontSlant -> "Bold"], 
                 StyleBox["j", "TI"]], "\[LongEqual]", 
                StyleBox["i", "TI"], " ", 
                SubscriptBox[
                 StyleBox["e", FontSlant -> "Bold"], 
                 StyleBox["j", "TI"]]}], TraditionalForm], "\", for which \"", 
             FormBox[
              RowBox[{
                SubscriptBox[
                 StyleBox["M", "TI"], "LL"], 
                RowBox[{"(", 
                  SubscriptBox[
                   StyleBox["f", FontSlant -> "Bold"], 
                   StyleBox["p", "TI"]], ")"}], "\[LongEqual]", 
                SubsuperscriptBox["\[Sigma]", 
                 StyleBox["p", "TI"], "LL"]}], TraditionalForm], "\", \"", 
             FormBox[
              RowBox[{
                SubscriptBox[
                 StyleBox["M", "TI"], "LL"], 
                RowBox[{"(", 
                  SubscriptBox[
                   OverscriptBox[
                    StyleBox["f", FontSlant -> "Bold"], "_"], "0"], ")"}], 
                "\[LongEqual]", 
                SubsuperscriptBox["\[Sigma]", "0", "LL"]}], TraditionalForm], 
             "\" and \"", 
             FormBox[
              RowBox[{
                SubscriptBox[
                 StyleBox["M", "TI"], "LL"], 
                RowBox[{"(", 
                  SubscriptBox[
                   OverscriptBox[
                    StyleBox["f", FontSlant -> "Bold"], "_"], 
                   StyleBox["j", "TI"]], ")"}], "\[LongEqual]", "-", 
                SubsuperscriptBox["\[Sigma]", 
                 StyleBox["j", "TI"], "LL"]}], TraditionalForm]},
            "RowDefault"],
           StripOnInput->False,
           FontFamily->"Source Sans Pro",
           FontSize->9.5],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            RowBox[{
              SubsuperscriptBox["\[Gamma]", "LL", "p"], "[", 
              TagBox[
               StyleBox["f", FontWeight -> "Bold", FontSlant -> "Plain"], 
               "SL31Bold"], "]"}]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"gamma_LL^p[f]\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[
          StyleBox[
           TemplateBox[{"\"the Dirac matrices of a frame, the \"", 
             FormBox[
              RowBox[{"4", "\[Cross]", "4"}], TraditionalForm], 
             "\" matrices with the \"", 
             FormBox[
              RowBox[{"2", "\[Cross]", "2"}], TraditionalForm], 
             "\" blocks \"", 
             FormBox[
              RowBox[{
                SubsuperscriptBox["\[Gamma]", "LL", 
                 StyleBox["p", "TI"]], 
                RowBox[{"[", 
                  StyleBox["f", FontSlant -> "Bold"], "]"}], "\[LongEqual]", 
                RowBox[{"(", 
                  Cell[
                   BoxData[
                    FormBox[
                    GridBox[{{
                    Cell[
                    TextData[{" ", 
                    Cell["0", "InlineFormula"], " "}]], 
                    Cell[
                    TextData[{" ", 
                    Cell[
                    BoxData[
                    RowBox[{
                    SubscriptBox[
                    StyleBox["M", "TI"], "LL"], "(", 
                    SubscriptBox[
                    StyleBox["f", FontSlant -> "Bold"], 
                    StyleBox["p", "TI"]], ")"}]], "InlineFormula"], " "}]]}, {
                    
                    Cell[
                    TextData[{" ", 
                    Cell[
                    BoxData[
                    RowBox[{
                    SubscriptBox[
                    StyleBox["M", "TI"], "LL"], "(", 
                    SubscriptBox[
                    OverscriptBox[
                    StyleBox["f", FontSlant -> "Bold"], "_"], 
                    StyleBox["p", "TI"]], ")"}]], "InlineFormula"], " "}]], 
                    Cell[
                    TextData[{" ", 
                    Cell["0", "InlineFormula"], " "}]]}}], TraditionalForm]]],
                   ")"}]}], TraditionalForm], "\"; they satisfy \"", 
             FormBox[
              RowBox[{
                SubsuperscriptBox["\[Gamma]", "LL", 
                 StyleBox["p", "TI"]], 
                RowBox[{"[", 
                  StyleBox["f", FontSlant -> "Bold"], "]"}], 
                SubsuperscriptBox["\[Gamma]", "LL", 
                 SuperscriptBox[
                  StyleBox["p", "TI"], "\[Prime]"]], 
                RowBox[{"[", 
                  StyleBox["f", FontSlant -> "Bold"], "]"}], "+", 
                SubsuperscriptBox["\[Gamma]", "LL", 
                 SuperscriptBox[
                  StyleBox["p", "TI"], "\[Prime]"]], 
                RowBox[{"[", 
                  StyleBox["f", FontSlant -> "Bold"], "]"}], 
                SubsuperscriptBox["\[Gamma]", "LL", 
                 StyleBox["p", "TI"]], 
                RowBox[{"[", 
                  StyleBox["f", FontSlant -> "Bold"], "]"}], "\[LongEqual]", 
                "2", 
                SubscriptBox[
                 StyleBox["N", "TI"], "LL"], 
                RowBox[{"(", 
                  RowBox[{
                    SubscriptBox[
                    StyleBox["f", FontSlant -> "Bold"], 
                    StyleBox["p", "TI"]], ",", 
                    SubscriptBox[
                    StyleBox["f", FontSlant -> "Bold"], 
                    SuperscriptBox[
                    StyleBox["p", "TI"], "\[Prime]"]]}], ")"}], " ", 
                SubscriptBox[
                 StyleBox["1", FontSlant -> "Plain"], "4"]}], 
              TraditionalForm], 
             "\"; for the canonical frame they are the matrices \"", 
             FormBox[
              SubsuperscriptBox["\[Gamma]", "LL", 
               StyleBox["p", "TI"]], TraditionalForm]},
            "RowDefault"],
           StripOnInput->False,
           FontFamily->"Source Sans Pro",
           FontSize->9.5],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            OverscriptBox[
             TagBox[
              StyleBox["g", FontWeight -> "Bold", FontSlant -> "Plain"], 
              "SL31Bold"], "~"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"gLt gLt^dag\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[
          StyleBox[
           TemplateBox[{"\"for a unit bi-quaternion \"", 
             FormBox[
              StyleBox["g", FontSlant -> "Bold"], TraditionalForm], "\": \"", 
             
             FormBox[
              RowBox[{
                OverscriptBox[
