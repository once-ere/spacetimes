Cell[CellGroupData[{

Cell["\<\
GS-5 and GS-6: gauge covariance and curvature of the covariant derivative\
\>", "Subsection",ExpressionUUID->"c7e948fa-de1b-48f2-b39a-d30aa8b56bca"],

Cell[TextData[{
 "Fields linear in the coordinates ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["x", "TI"], "LL"], "\[LongEqual]", 
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["x", "TI"], "LL", "0"], ",", 
       SubsuperscriptBox[
        StyleBox["x", "TI"], "LL", "1"], ",", 
       SubsuperscriptBox[
        StyleBox["x", "TI"], "LL", "2"], ",", 
       SubsuperscriptBox[
        StyleBox["x", "TI"], "LL", "3"]}], ")"}]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"7a3d4832-73ae-45ad-adf2-0712b80d6db3"]], 
  "InlineFormula",ExpressionUUID->"0ba5c1c7-f5dd-4904-b07c-97d459021a87"],
 " are drawn at random: the isospin potentials ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{"LL", ",", 
      StyleBox["p", "TI"]}], "\[Iota]"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"465a5948-13cb-492a-91fd-2eb7b66e41f5"]], "InlineFormula",
  ExpressionUUID->"624c1aea-2232-47ae-b9f9-ed28b3c8e46c"],
 ", the fermion-number potentials ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{"LL", ",", 
      StyleBox["p", "TI"]}], "F"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"70ac95e1-d5d3-440d-90a0-967d532a641a"]], "InlineFormula",
  ExpressionUUID->"550d76c5-0b48-43aa-a8a6-6b68f53ccf3c"],
 " and the Lorentz connection with the rotation components ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[Omega]", 
     RowBox[{"LL", ",", 
      StyleBox["p", "TI"]}], 
     StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "683bcc50-8f83-4ee9-9598-7892436eaff1"]], "InlineFormula",ExpressionUUID->
  "931d8800-002b-440d-9dc3-028f1759fa7c"],
 " and the boost components ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[CurlyPi]", 
     RowBox[{"LL", ",", 
      StyleBox["p", "TI"]}], 
     StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "6db26671-eebf-41ec-85ca-dd85faeecafa"]], "InlineFormula",ExpressionUUID->
  "e27c09b0-4c44-46f7-a661-83846fd6d6ab"],
 "; the spinor field ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubscriptBox["\[CapitalPsi]", "LL"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"31e79368-a0f3-4dc9-b8ed-db6b2dbf930e"]], "InlineFormula",
  ExpressionUUID->"08c0f970-66a7-4ba9-9b4b-cba86dfb37c9"],
 " is a sum of three plane waves. A gauge transformation ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["\[ScriptCapitalU]",
       FontSlant->"Plain"], "LL"], "\[LongEqual]", "exp", 
     RowBox[{"(", 
      RowBox[{
       StyleBox["i", "TI"], 
       SubsuperscriptBox["\[Theta]", "LL", "F"]}], ")"}], " ", 
     SubscriptBox[
      StyleBox["S",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "LL"], 
     RowBox[{"(", 
      StyleBox["g",
       FontWeight->"Bold",
       FontSlant->"Plain"], ")"}], "\[CircleTimes]", 
     SubscriptBox[
      StyleBox["U",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "LL"]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"3cadc584-5deb-47f6-882d-85022162b913"]], "InlineFormula",
  ExpressionUUID->"3a360c6d-63bf-4474-9c69-6c3e144752d8"],
 " is applied, whose phase ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[Theta]", "LL", "F"], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"801fb8ac-dde2-4c80-82f3-e801468085fe"]], 
  "InlineFormula",ExpressionUUID->"5f7a0b82-b50f-40be-bd3a-6a7f9699a150"],
 ", isospin rotation ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["U",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "LL"], "\[LongEqual]", "exp", 
     RowBox[{"(", 
      RowBox[{
       StyleBox["i", "TI"], 
       UnderscriptBox["\[Sum]", "\[Iota]",
        LimitsPositioning->True], 
       SubsuperscriptBox["\[Theta]", "LL", "\[Iota]"], 
       SubsuperscriptBox["\[Tau]", "\[Iota]", "LL"], "/", "2"}], ")"}]}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "3a8b5d23-9fcd-4bf1-ac30-17eaefe159cd"]], "InlineFormula",ExpressionUUID->
  "bcec1a45-3192-4b20-abb7-ecc89d4445df"],
 " and unit bi-quaternion ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    StyleBox["g",
     FontWeight->"Bold",
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "52b9e524-fde3-46f6-b8cf-078b99ceb159"]], "InlineFormula",ExpressionUUID->
  "0946dddf-ee4f-4931-bf9f-4c07fd24c9bd"],
 " (with ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["M", "TI"], "LL"], 
     RowBox[{"(", 
      StyleBox["g",
       FontWeight->"Bold",
       FontSlant->"Plain"], ")"}], "\[LongEqual]", "exp", 
     SubscriptBox[
      StyleBox["M", "TI"], "LL"], 
     RowBox[{"(", 
      StyleBox["u",
       FontWeight->"Bold",
       FontSlant->"Plain"], ")"}]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"8c3294aa-d48c-4087-9aa2-a66d2ccfe03d"]], "InlineFormula",
  ExpressionUUID->"24b4ed23-635f-40b3-9a96-30f0653b13ef"],
 " for a Lorentz generator ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    StyleBox["u",
     FontWeight->"Bold",
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "11837564-bff4-462a-b725-a68d7aa1791b"]], "InlineFormula",ExpressionUUID->
  "c245b73a-9666-4942-8379-0f32572ae6d8"],
 ") depend on ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubscriptBox[
     StyleBox["x", "TI"], "LL"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"910fefe5-6f9c-46bd-b4ac-cad35613b535"]], "InlineFormula",
  ExpressionUUID->"fc9da2f7-1d1c-485c-9769-899886452e70"],
 " through ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[Theta]", "LL", "F"], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"3f36c31d-eb43-4acf-93f4-305791115784"]], 
  "InlineFormula",ExpressionUUID->"6aa24dd8-eb3b-4374-b1e6-ea97b7a058f4"],
 ", ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[Theta]", "LL", "\[Iota]"], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"47f8282d-d260-433e-9346-1a54718e979f"]], 
  "InlineFormula",ExpressionUUID->"01496201-e012-46e2-b75c-52608e4951f3"],
 " and ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    StyleBox["u",
     FontWeight->"Bold",
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "8c453036-6fc1-4eef-8424-5112f0bd394b"]], "InlineFormula",ExpressionUUID->
  "536f8ef8-124c-47de-a16d-032799c88d1f"],
 ", which are linear in ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubscriptBox[
     StyleBox["x", "TI"], "LL"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"a5ad818d-224b-4489-93a6-70e45aa49e14"]], "InlineFormula",
  ExpressionUUID->"f7b35acd-d7d2-4bbe-a90c-da96c9d212ce"],
 ". The transformed fields are ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubsuperscriptBox[
      StyleBox["A", "TI"], 
      RowBox[{"LL", ",", 
       StyleBox["p", "TI"]}], "F"], "+", 
     SubscriptBox["\[PartialD]", 
      StyleBox["p", "TI"]], 
     SubsuperscriptBox["\[Theta]", "LL", "F"], "/", 
     SubsuperscriptBox[
      StyleBox["g", "TI"], "LL", "F"]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"048baec9-3d6f-4f2d-8096-bcd2257ab424"]], "InlineFormula",
  ExpressionUUID->"73b71890-6045-41a5-9107-783fc7cf0ac0"],
 ", ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["U",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "LL"], 
     SubscriptBox[
      StyleBox["a",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      RowBox[{"LL", ",", 
       StyleBox["p", "TI"]}]], 
     SubsuperscriptBox[
      StyleBox["U",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "LL", 
      RowBox[{"-", "1"}]], "-", 
     RowBox[{"(", 
      RowBox[{
       StyleBox["i", "TI"], "/", 
       SubsuperscriptBox[
        StyleBox["g", "TI"], "LL", "v"]}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[PartialD]", 
        StyleBox["p", "TI"]], 
       SubscriptBox[
        StyleBox["U",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], "LL"]}], ")"}], 
     SubsuperscriptBox[
      StyleBox["U",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "LL", 
      RowBox[{"-", "1"}]]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"42843673-f9a4-4c52-b176-9dd007e54b3b"]], "InlineFormula",
  ExpressionUUID->"90424e3f-5b9a-40e3-b39d-ea742443ec45"],
 " in place of ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["a",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      RowBox[{"LL", ",", 
       StyleBox["p", "TI"]}]], "\[LongEqual]", 
     UnderscriptBox["\[Sum]", "\[Iota]",
      LimitsPositioning->True], 
     SubsuperscriptBox[
      StyleBox["A", "TI"], 
      RowBox[{"LL", ",", 
       StyleBox["p", "TI"]}], "\[Iota]"], 
     SubsuperscriptBox["\[Tau]", "\[Iota]", "LL"], "/", "2"}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "5ae79155-7c03-4e8e-ab4e-e42388035e2b"]], "InlineFormula",ExpressionUUID->
  "36d20a47-a5bb-41af-bfd6-cb07e00409cb"],
 ", and, on the Dirac index, ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["S",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "LL"], 
     RowBox[{"(", 
      StyleBox["g",
       FontWeight->"Bold",
       FontSlant->"Plain"], ")"}], 
     SubscriptBox[
      StyleBox["s",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "LL"], 
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["u",
        FontWeight->"Bold",
        FontSlant->"Plain"], 
       RowBox[{"LL", ",", 
        StyleBox["p", "TI"]}], "\[Omega]"], ")"}], 
     SubscriptBox[
      StyleBox["S",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "LL"], 
     SuperscriptBox[
      RowBox[{"(", 
       StyleBox["g",
        FontWeight->"Bold",
        FontSlant->"Plain"], ")"}], 
      RowBox[{"-", "1"}]], "-", 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[PartialD]", 
        StyleBox["p", "TI"]], 
       SubscriptBox[
        StyleBox["S",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], "LL"], 
       RowBox[{"(", 
        StyleBox["g",
         FontWeight->"Bold",
         FontSlant->"Plain"], ")"}]}], ")"}], 
     SubscriptBox[
      StyleBox["S",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "LL"], 
     SuperscriptBox[
      RowBox[{"(", 
       StyleBox["g",
        FontWeight->"Bold",
        FontSlant->"Plain"], ")"}], 
      RowBox[{"-", "1"}]]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"98c8e211-46f3-421d-95f9-5e45af3613e7"]], "InlineFormula",
  ExpressionUUID->"bd4398b7-aa41-4b47-8ddf-b6dbaa950ec1"],
 " in place of ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["s",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "LL"], "(", 
     SubsuperscriptBox[
      StyleBox["u",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      RowBox[{"LL", ",", 
       StyleBox["p", "TI"]}], "\[Omega]"], ")"}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"ceaa18af-02e5-4fb8-80bd-2d79f05d35df"]], 
  "InlineFormula",ExpressionUUID->"84e2b162-42cc-4c01-b271-63d647d26bd6"],
