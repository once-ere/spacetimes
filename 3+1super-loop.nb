              RowBox[{"(", 
                RowBox[{
                  StyleBox["i", "TI"], ",", "0", ",", "0"}], ")"}], 
              TraditionalForm], "\", \"", 
             FormBox[
              RowBox[{"(", 
                RowBox[{"0", ",", 
                  StyleBox["i", "TI"], ",", "0"}], ")"}], TraditionalForm], 
             "\", \"", 
             FormBox[
              RowBox[{"(", 
                RowBox[{"0", ",", "0", ",", "1"}], ")"}], TraditionalForm], 
