          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            RowBox[{
              SubscriptBox["\[CapitalXi]", "LL"], "(", 
              SuperscriptBox[
               RowBox[{"(", 
                 SubsuperscriptBox["M", "LL", "q"], ")"}], "2"], ")"}], 
            "\", \"", 
            SubsuperscriptBox["\[CapitalXi]", "LL", 
