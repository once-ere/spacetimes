                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "c8335b4a-41c3-4794-98cd-efeb173623cb"],
               "; every bi-octonion is written ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  StyleBox["x",
                   FontWeight->"Bold",
                   FontSlant->"Plain"], "\[LongEqual]", 
                  StyleBox["a",
                   FontWeight->"Bold",
                   FontSlant->"Plain"], "+", 
                  StyleBox["b",
                   FontWeight->"Bold",
                   FontSlant->"Plain"], "\[ThinSpace]", 
