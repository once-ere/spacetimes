Cell[TextData[{
 "S-5, TeX: with its ",
 StyleBox["TraditionalForm",
  FontFamily->"Source Code Pro"],
 " rule, every symbol is written in TeX from its displayed boxes; the \
internal name, with its separator character, does not appear."
}], "Text",ExpressionUUID->"971a233c-21e9-4186-946c-e9c24c7f9db3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"texOut", " ", "=", " ", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{"r", ",", " ", 
       RowBox[{"Replace", "[", 
        RowBox[{
         RowBox[{"r", "[", "\"\<symbol\>\"", "]"}], ",", " ", 
         RowBox[{
          RowBox[{"HoldComplete", "[", "s_", "]"}], " ", ":>", " ", 
          RowBox[{"ToString", "[", 
           RowBox[{"TeXForm", "[", 
            RowBox[{"Unevaluated", "[", "s", "]"}], "]"}], "]"}]}]}], "]"}]}],
       "]"}], ",", " ", "symbolTable"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-5\>\"", ",", 
    " ", "\"\<the TeX of every symbol is written from its printed form, \
without the internal name\>\"", ",", "\n", "  ", 
    RowBox[{"AllTrue", "[", 
     RowBox[{"texOut", ",", " ", 
      RowBox[{
       RowBox[{"!", " ", 
        RowBox[{"StringContainsQ", "[", 
         RowBox[{"#", ",", " ", 
          
          RowBox[{"\"\<UnderBracket\>\"", " ", "|", 
           " ", "\"\<\[UnderBracket]\>\""}]}], "]"}]}], " ", "&"}]}], "]"}], ",",
     " ", 
    RowBox[{"Count", "[", 
     RowBox[{"texOut", ",", " ", 
      RowBox[{"x_", " ", "/;", " ", 
       RowBox[{"!", " ", 
        RowBox[{"StringContainsQ", "[", 
         RowBox[{"x", ",", " ", "\"\<UnderBracket\>\""}], "]"}]}]}]}], 
     "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{"TableForm", "[", 
  RowBox[{
   RowBox[{"Take", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", "\"\<tex\>\"", "]"}], " ", "&"}], ",", " ", 
          "symbolTable"}], "]"}], ",", " ", "texOut"}], "}"}], "]"}], ",", 
     " ", "8"}], "]"}], ",", " ", 
   RowBox[{"TableHeadings", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"None", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<registry TeX\>\"", ",", 
        " ", "\"\<TeXForm of the symbol\>\""}], "}"}]}], "}"}]}]}], 
  "]"}]}], "Input",
 CellLabel->
  "In[107]:=",ExpressionUUID->"abab106e-a598-4d93-acf3-e11a30a4405f"],

