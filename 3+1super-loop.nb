             OverscriptBox["u", "\[RightVector]"], "LL", 
             RowBox[{"f", "\[Prime]"}]], "\", \"", 
            SubsuperscriptBox["\[Delta]", "LL", "f"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"u_f delta_f\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "a fixed complex unit vector, the direction of a deviation ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox["\[Delta]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["f",
                FontSlant->"Plain"]], 
              RowBox[{"(", 
               SubscriptBox[
                StyleBox["x", "TI"], 
                StyleBox["LL",
                 FontSlant->"Plain"]], ")"}], "\[ThinSpace]", 
              SubsuperscriptBox[
               OverscriptBox[
                StyleBox["u", "TI"], "\[RightVector]"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["f",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "81c3ca31-c941-4f05-9f27-33331385a03b"],
           " of the field from the vacuum ",
           Cell[BoxData[
            FormBox[
             RowBox[{"(", 
              RowBox[{"0", ",", "0", ",", 
