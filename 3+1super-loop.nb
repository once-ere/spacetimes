      RowBox[{"as5DevClosed", " ", "<", " ", "1*^-10"}], " ", "&&", " ", 
      RowBox[{"as5GcritDev", " ", "<", " ", "1*^-8"}], " ", "&&", " ", 
      RowBox[{"as5DevRoot", " ", "<", " ", "1*^-9"}], " ", "&&", " ", 
      RowBox[{"as5Roots", " ", "==", " ", "11"}], " ", "&&", " ", 
      "as5BcsOk"}], ",", "\n", "  ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<largest deviations \>\"", ",", " ", 
        RowBox[{"asSci", "[", "as5DevClosed", "]"}], ",", " ", "\"\<, \>\"", ",",
         " ", 
        RowBox[{"asSci", "[", "as5GcritDev", "]"}], ",", " ", "\"\<, \>\"", ",",
         " ", 
        RowBox[{"asSci", "[", "as5DevRoot", "]"}], ",", " ", "\"\< (\>\"", ",",
         " ", "as5Roots", ",", 
        " ", "\"\< gaps); Delta at G = 1.5 G_crit, mu = 0: \>\"", ",", " ", 
        RowBox[{"asFix", "[", 
         RowBox[{"as5GapAt15", ",", " ", "6"}], "]"}], ",", "\n", 
        "    ", "\"\<; weak coupling at mu = 0.3, G/G_crit = 0.3, 0.4, 0.5: \
Delta = \>\"", ",", "\n", "    ", 
        RowBox[{"Row", "[", 
         RowBox[{"Riffle", "[", 
          RowBox[{
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Row", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"ScientificForm", "[", 
                  RowBox[{
                   RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", " ", "4"}], "]"}], ",",
                  " ", "\"\< (\>\"", ",", " ", 
                 RowBox[{"asSci", "[", 
                  RowBox[{"#", "[", 
                   RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", 
                 " ", "\"\<, scale \>\"", ",", " ", 
                 RowBox[{"asSci", "[", 
                  RowBox[{"#", "[", 
                   RowBox[{"[", "3", "]"}], "]"}], "]"}], ",", 
                 " ", "\"\<)\>\""}], "}"}], "]"}], " ", "&"}], ",", " ", 
             "as5Bcs"}], "]"}], ",", " ", "\"\<, \>\""}], "]"}], "]"}], ",", 
        "\n", "    ", "\"\< (original: 1.8e-15, 0.0e0, 2.2e-15 (11 gaps); \
0.675339; 9.985e-7 (-7.6e-11, scale 7.7e-11), 1.023e-4 (-5.3e-7, scale \
5.3e-7), 1.646e-3 (-9.5e-5, scale 9.6e-5))\>\""}], "}"}], "]"}]}], 
    "]"}]}]}]], "Input",
 CellLabel->
  "In[714]:=",ExpressionUUID->"a8763d98-4aaa-460b-9ff1-2cc232790480"],

Cell[BoxData[
 StyleBox[
  TemplateBox[{
    StyleBox["\"PASS  \"", Bold, 
     RGBColor[0, 
      Rational[2, 3], 0], StripOnInput -> False], "\"AS-5: \"", 
    "\"the gap equation in closed form for massless spinor charges (case B): \
int_(q<Lambda) d^3q/(2 pi)^3 (1/E^+ + 1/E^-) with E^(+-) = ((q +- mu)^2 + \
Delta^2)^(1/2) equals (1/(4 pi^2)) [(Lambda - 3 mu) E^+(Lambda) + (Lambda + 3 \
mu) E^-(Lambda) + (2 mu^2 - Delta^2) (asinh((Lambda + mu)/Delta) + \
asinh((Lambda - mu)/Delta))] for six pairs (mu, Delta) (relative deviation \
from composite Gauss-Legendre quadrature with 32 nodes per panel, tolerance \
1e-10); its limit Delta -> 0 at mu = 0 is Lambda^2/(2 pi^2), so that G_crit = \
2 pi^2/Lambda^2 (tolerance 1e-8); the gaps Delta(G) found from the closed \
form by bisection satisfy G int(...) = 1 with the integral computed by \
quadrature (the 11 of the 12 cases mu = 0, 0.3, 0.6 with G/G_crit = 0.6, 1.2, \
1.8, 2.4 that have a gap, tolerance 1e-9); and for mu > 0 and weak coupling \
(G < G_crit) the gap approaches the BCS form Delta = 2 (Lambda^2 - \
mu^2)^(1/2) exp(-3/2) exp(-(pi^2/mu^2) (1/G - 1/G_crit)), the relative \
deviation being smaller than twice the size (Delta^2/(2 mu^2)) ln(1/Delta) of \
the leading correction (mu = 0.3, G/G_crit = 0.3, 0.4, 0.5); Lambda = 1\"", 
    "\"  -- largest deviations 1.8e-15, 0, 1.7e-14 (11 gaps); Delta at G = \
1.5 G_crit, mu = 0: 0.675339; weak coupling at mu = 0.3, G/G_crit = 0.3, 0.4, \
0.5: Delta = 9.985e-7 (-7.6e-11, scale 7.7e-11), 1.023e-4 (-5.3e-7, scale \
5.3e-7), 1.646e-3 (-9.5e-5, scale 9.6e-5) (original: 1.8e-15, 0.0e0, 2.2e-15 \
(11 gaps); 0.675339; 9.985e-7 (-7.6e-11, scale 7.7e-11), 1.023e-4 (-5.3e-7, \
scale 5.3e-7), 1.646e-3 (-9.5e-5, scale 9.6e-5))\""},
   "RowDefault"],
  StripOnInput->False,
  LineIndent->0]], "Print",
 CellChangeTimes->{4.00402550960034*^9},
 CellLabel->
  "During evaluation of \
In[714]:=",ExpressionUUID->"648b81ca-873e-4ef0-8bc1-987d0a6d8438"]
}, Open  ]],

Cell[TextData[{
 StyleBox["The uniform state is an exact self-consistent solution on the \
lattice (check AS-6).",
  FontWeight->"Bold"],
 " The self-consistency condition of the mean field is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Iota]"], 
    RowBox[{"(", 
     SubscriptBox[
      StyleBox["x", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"]], ")"}], "\[LongEqual]", 
    RowBox[{"-", 
     FractionBox["1", "2"]}], 
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[ThinSpace]", "\[Sum]", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[Psi]", 
       RowBox[{
        StyleBox["LL",
         FontSlant->"Plain"], ",", 
        StyleBox["n", "TI"]}], 
       StyleBox["p",
        FontSlant->"Plain"]], ")"}], 
     StyleBox["T", "TI"]], 
    SubsuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Iota]"], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[Psi]", 
       RowBox[{
        StyleBox["LL",
         FontSlant->"Plain"], ",", 
        StyleBox["n", "TI"]}], 
       StyleBox["h",
        FontSlant->"Plain"]], ")"}], "*"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "38f0dccc-ad36-4066-8bf8-2e72d6ef2410"],
 ", where the sum runs over the modes with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["E", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["n", "TI"]}], 
     StyleBox["qp",
      FontSlant->"Plain"]], ">", "0"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9b465ef3-e2a6-42e6-83b2-9d2b79f4c6dc"],
 " and every mode is normalized so that the integral of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      SubsuperscriptBox["\[Psi]", 
       RowBox[{
        StyleBox["LL",
         FontSlant->"Plain"], ",", 
        StyleBox["n", "TI"]}], 
       StyleBox["p",
        FontSlant->"Plain"]], "\[RightBracketingBar]"}], "2"], "+", 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      SubsuperscriptBox["\[Psi]", 
       RowBox[{
        StyleBox["LL",
         FontSlant->"Plain"], ",", 
        StyleBox["n", "TI"]}], 
       StyleBox["h",
        FontSlant->"Plain"]], "\[RightBracketingBar]"}], "2"]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "46189d7a-c2e6-4631-8be1-92e00d762f71"],
 " over space is 1. On a chain the eigenvectors of the lattice operator are \
unit vectors, and the modes with this normalization are their components \
divided by ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox["\[ScriptL]", 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["x",
       FontSlant->"Plain"]], ")"}], 
    RowBox[{"1", "/", "2"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3ef3469e-efc5-4211-b46c-cc910044411d"],
 ". For the uniform polar state the eight positive-energy eigenvectors of one \
momentum contribute together ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "2"}], 
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     RowBox[{"1", "/", 
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "+"], "+", "1", "/", 
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "-"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2620fb11-89fb-413d-bc43-6b1417c0f912"],
 " to the sum of the third isospin direction (check GS-9), divided by ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["x",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c2485f54-dc9b-45f5-be3f-dfb35c0f35f9"],
 " because a unit vector spreads its norm over the sites of the chain, and \
nothing to the directions 1 and 2. The sum over the modes at every site is \
therefore ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "2"}], 
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["n", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["x",
        FontSlant->"Plain"]], ")"}], 
     RowBox[{"-", "1"}]], "\[ThinSpace]", "\[Sum]", 
    RowBox[{"(", 
     RowBox[{"1", "/", 
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "+"], "+", "1", "/", 
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "-"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0312c47f-1d6d-4067-83d5-3f804aed6ae1"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Iota]", "\[LongEqual]", "3"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fa29159d-6b06-4763-9f31-cfc87149924f"],
 ", the last sum running over the allowed momenta with ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CurlyEpsilon]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["lat",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d7a7fc93-ad22-47b0-8c28-6f06615fe4b0"],
 " in ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "\[PlusMinus]"], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "eb85d54f-0f4a-4b80-a399-165669371bed"],
 ", and 0 for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Iota]", "\[LongEqual]", "1", ",", "2"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "802545d7-0816-457f-87c6-c5bfa38bf3b8"],
 ". The self-consistency condition then returns the same pair field ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "0", ",", 
     SubscriptBox["\[CapitalDelta]", 
      StyleBox["LL",
       FontSlant->"Plain"]]}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "83b5584e-4981-475e-a810-ab2473817365"],
 " on every site exactly when"
}], "Text",ExpressionUUID->"2e7727fd-a433-408e-8af7-7a07187639d2"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox["1", 
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]]], "\[LongEqual]", 
   FractionBox["1", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["n", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["x",
       FontSlant->"Plain"]], 
     SubsuperscriptBox["\[ScriptL]", 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["x",
       FontSlant->"Plain"]]}]], "\[ThinSpace]", 
   UnderscriptBox["\[Sum]", 
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "1"],
    LimitsPositioning->True], 
   RowBox[{"(", 
    RowBox[{
     FractionBox["1", 
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "+"]], "+", 
     FractionBox["1", 
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "-"]]}], ")"}]}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"7ae72065-2e01-4ba7-a7e2-af64e17ea27a"],

Cell[TextData[{
 "the gap equation of the chain: the sum over the allowed momenta, divided by \
the circumference of the ring, stands in place of the integral over ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["q", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "1"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b3fd7baa-b11e-4209-9555-362363747543"],
 " divided by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Pi]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c747e89c-ea79-41f8-aa19-2da29fa6cb9e"],
 ". Check AS-6 computes the sum over the modes with the routine of the \
solvers (",
 StyleBox["t2anomalous",
  FontFamily->"Source Code Pro"],
 ") from the 128 positive-energy eigenvectors of the chain of 16 sites of \
check AS-4, compares it with the formula, and verifies that the \
self-consistency condition with the coupling of the displayed equation gives \
back ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalDelta]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "958ffd55-644b-4539-8267-41ecf96c9f2f"],
 " on every site: a fixed point that the self-consistent solvers of the items \
[3] and [5] must reproduce."
}], "Text",ExpressionUUID->"9799630e-2927-483a-899a-03b2fcf712c8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"AS", "-", "6"}], ":", " ", 
     RowBox[{
      RowBox[{
      "the", " ", "chain", " ", "and", " ", "the", " ", "pair", " ", "field", 
       " ", "of", " ", "AS"}], "-", 
      RowBox[{"4", " ", 
       RowBox[{"(", 
        RowBox[{
        "the", " ", "original", " ", "program", " ", "builds", " ", "the", " ",
          "same", " ", "chain", " ", "a", " ", "second", " ", "time"}], 
        ")"}]}]}]}], ";", " ", 
    RowBox[{
    "the", "\n", "   ", "eigenvectors", " ", "of", " ", "its", " ", 
     "positive", " ", "eigenvalues", " ", "are", " ", "the", " ", "modes"}]}],
    " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"as6Ev", ",", " ", "as6Vec"}], "}"}], " ", "=", " ", 
     RowBox[{"t2eigh", "[", "as4H", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as6Modes", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"as6Vec", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", "col"}], "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"col", ",", " ", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"Range", "[", 
            RowBox[{"Length", "[", "as6Ev", "]"}], "]"}], ",", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"as6Ev", "[", 
              RowBox[{"[", "#", "]"}], "]"}], " ", ">", " ", "0"}], " ", 
            "&"}]}], "]"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "sum", " ", "over", " ", "the", " ", "modes", " ", "of", " ", 
      RowBox[{"psi_p", "^", "T"}], " ", "Kch_iota", " ", "conj", 
      RowBox[{"(", "psi_h", ")"}], " ", "at", " ", "every", " ", "site"}], ",",
      " ", 
     RowBox[{
     "by", " ", "the", " ", "routine", " ", "of", " ", "the", " ", 
      "solvers"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"as6Pi", " ", "=", " ", 
     RowBox[{"t2anomalous", "[", 
      RowBox[{"as4N", ",", " ", "as6Modes"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "the", " ", "sum", " ", "over", " ", "the", " ", "16", " ", "allowed", " ",
      "momenta", " ", "of", " ", 
     RowBox[{
      RowBox[{"1", "/", 
       RowBox[{"E", "^", 
        RowBox[{"-", " ", 
         RowBox[{"+", " ", "1"}]}]}]}], "/", 
      RowBox[{"E", "^", 
       RowBox[{"+", " ", 
        RowBox[{"(", 
         RowBox[{"eps_lat", " ", "in", " ", "place", " ", "of", " ", "eps"}], 
         ")"}]}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"as6Sum", " ", "=", " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"el", " ", "=", " ", 
           RowBox[{"t2epsLat", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"t2chainMomentum", "[", 
                RowBox[{"kq", ",", " ", "as4N", ",", " ", "asBEll"}], "]"}], ",",
                " ", "0.", ",", " ", "0."}], "}"}], ",", " ", "asBEll", ",", 
             " ", "mass", ",", " ", "1.0", ",", " ", "asChainActive"}], 
            "]"}]}], "}"}], ",", "\n", "    ", 
         RowBox[{
          RowBox[{"1.", "/", 
           RowBox[{"Sqrt", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"el", " ", "-", " ", "asBMu"}], ")"}], "^", "2"}], " ",
              "+", " ", 
             RowBox[{"asBDelta", "^", "2"}]}], "]"}]}], " ", "+", " ", 
          RowBox[{"1.", "/", 
           RowBox[{"Sqrt", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"el", " ", "+", " ", "asBMu"}], ")"}], "^", "2"}], " ",
              "+", " ", 
             RowBox[{"asBDelta", "^", "2"}]}], "]"}]}]}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"kq", ",", " ", "0", ",", " ", 
         RowBox[{"as4N", " ", "-", " ", "1"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as6PiExpect", " ", "=", " ", 
     RowBox[{
      RowBox[{"-", "2."}], " ", "asBDelta", " ", 
      RowBox[{"as6Sum", "/", "as4N"}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "coupling", " ", "of", " ", "the", " ", "lattice", " ", 
      "gap", " ", "equation", " ", 
      RowBox[{"1", "/", "G"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"N", " ", "dx"}], ")"}]}], ")"}], " ", "sum_q", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"1", "/", 
         RowBox[{"E", "^", 
          RowBox[{"+", " ", 
           RowBox[{"+", " ", "1"}]}]}]}], "/", 
        RowBox[{"E", "^", "-"}]}], ")"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"as6G", " ", "=", " ", 
     RowBox[{"1.", "/", 
      RowBox[{"(", 
       RowBox[{"as6Sum", "/", 
        RowBox[{"(", 
         RowBox[{"as4N", " ", "asBEll"}], ")"}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as6DevSum", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"as6Pi", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], "]"}], ",", " ", 
       RowBox[{"Abs", "[", 
        RowBox[{"as6Pi", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}], ",", " ", 
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"as6Pi", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", " ", "3"}], "]"}], "]"}], " ", "-", " ", 
         "as6PiExpect"}], "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", "new", " ", "pair", " ", "field", " ", 
      RowBox[{"d", "^", "3"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{"G", "/", "2"}], ")"}]}], " ", 
       RowBox[{"Pi", "^", "3"}], " ", "with", " ", 
       RowBox[{"Pi", "^", "3"}]}], " ", "=", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"mode", " ", "sum"}], ")"}], "/", "dx"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"as6DevNew", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"as6Pi", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", " ", "3"}], "]"}], "]"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "0.5"}], " ", 
           RowBox[{"as6G", "/", "asBEll"}]}], ")"}]}], " ", "-", " ", 
        "asBDelta"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<AS-6\>\"", ",", 
     " ", "\"\<the uniform polar state is an exact self-consistent solution \
of the lattice mean-field equations (case B): on a periodic chain of 16 sites \
(dx = 0.5, r_W = 1, m = 0.4, mu = 0.6) with dvec = (0, 0, 0.3), the sum over \
the 128 positive-energy eigenvectors of the lattice operator (unit vectors, \
with the particle part psi_p and the hole part psi_h) of psi_p^T Kch_iota \
conj(psi_h), computed at every site by the routine of the solvers, is 0 for \
iota = 1, 2 and -2 Delta (1/16) sum_q (1/E^+ + 1/E^-) (eps_lat in place of \
eps, the 16 allowed momenta) for iota = 3 (tolerance 1e-12); with Pi_iota = \
dx^(-1) times this sum (the continuum normalization of a chain) and the \
coupling G given by the lattice gap equation 1/G = (1/(16 dx)) sum_q (1/E^+ + \
1/E^-), the self-consistency condition d_iota = -(G/2) Pi_iota gives back \
dvec = (0, 0, Delta) on every site (tolerance 1e-12): a fixed point that the \
self-consistent solvers must reproduce\>\"", ",", "\n", "  ", 
     RowBox[{
      RowBox[{"as6DevSum", " ", "<", " ", "1*^-12"}], " ", "&&", " ", 
      RowBox[{"as6DevNew", " ", "<", " ", "1*^-12"}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"Length", "[", "as6Modes", "]"}], " ", "==", " ", 
       RowBox[{"8", " ", "as4N"}]}]}], ",", "\n", "  ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Length", "[", "as6Modes", "]"}], ",", 
        " ", "\"\< positive modes; largest deviations \>\"", ",", " ", 
        RowBox[{"asSci", "[", "as6DevSum", "]"}], ",", 
        " ", "\"\< (mode sum), \>\"", ",", " ", 
        RowBox[{"asSci", "[", "as6DevNew", "]"}], ",", 
        " ", "\"\< (new dvec); G = \>\"", ",", " ", 
        RowBox[{"asFix", "[", 
         RowBox[{"as6G", ",", " ", "6"}], "]"}], ",", "\n", 
        "    ", "\"\< (original: 128 positive modes; 2.6e-15, 1.1e-15; G = \
0.432159)\>\""}], "}"}], "]"}]}], "]"}]}]}]], "Input",
 CellLabel->
  "In[728]:=",ExpressionUUID->"19e2a3db-f186-4a15-8540-28a7706a4611"],

Cell[BoxData[
 StyleBox[
  TemplateBox[{
    StyleBox["\"PASS  \"", Bold, 
     RGBColor[0, 
      Rational[2, 3], 0], StripOnInput -> False], "\"AS-6: \"", 
    "\"the uniform polar state is an exact self-consistent solution of the \
lattice mean-field equations (case B): on a periodic chain of 16 sites (dx = \
0.5, r_W = 1, m = 0.4, mu = 0.6) with dvec = (0, 0, 0.3), the sum over the \
128 positive-energy eigenvectors of the lattice operator (unit vectors, with \
the particle part psi_p and the hole part psi_h) of psi_p^T Kch_iota \
conj(psi_h), computed at every site by the routine of the solvers, is 0 for \
iota = 1, 2 and -2 Delta (1/16) sum_q (1/E^+ + 1/E^-) (eps_lat in place of \
eps, the 16 allowed momenta) for iota = 3 (tolerance 1e-12); with Pi_iota = \
dx^(-1) times this sum (the continuum normalization of a chain) and the \
coupling G given by the lattice gap equation 1/G = (1/(16 dx)) sum_q (1/E^+ + \
1/E^-), the self-consistency condition d_iota = -(G/2) Pi_iota gives back \
dvec = (0, 0, Delta) on every site (tolerance 1e-12): a fixed point that the \
self-consistent solvers must reproduce\"", 
    "\"  -- 128 positive modes; largest deviations 2.2e-15 (mode sum), \
9.4e-16 (new dvec); G = 0.432159 (original: 128 positive modes; 2.6e-15, \
1.1e-15; G = 0.432159)\""},
   "RowDefault"],
  StripOnInput->False,
  LineIndent->0]], "Print",
 CellChangeTimes->{4.004025509990058*^9},
 CellLabel->
  "During evaluation of \
In[728]:=",ExpressionUUID->"c94e3c53-294e-433b-834e-c0e6d20487dc"]
}, Open  ]]
