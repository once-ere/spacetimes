Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"GS", "-", "11"}], ":", " ", 
     RowBox[{
     "the", " ", "rewritten", " ", "eigensolver", " ", "on", " ", "random", " ",
       "Hermitian", " ", "matrices", " ", "of", " ", "the", " ", "dimensions",
       " ", "7"}]}], ",", " ", 
    RowBox[{"64", " ", "and", " ", "200"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"worst11", " ", "=", " ", "0."}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"a", " ", "=", " ", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{
             RowBox[{"0.", " ", "I"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"nn", ",", " ", "nn"}], "}"}]}], "]"}]}], ",", " ", 
          "ev", ",", " ", "v"}], "}"}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"z", " ", "=", " ", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"i", " ", "==", " ", "j"}], ",", " ", 
                 RowBox[{
                  RowBox[{"t2Unit", "[", "]"}], " ", "+", " ", 
                  RowBox[{"0.", " ", "I"}]}], ",", " ", 
                 RowBox[{"t2UnitC", "[", "]"}]}], "]"}]}], "}"}], ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"a", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", " ", "j"}], "]"}], "]"}], " ", "=", " ", 
               "z"}], ";", " ", 
              RowBox[{
               RowBox[{"a", "[", 
                RowBox[{"[", 
                 RowBox[{"j", ",", " ", "i"}], "]"}], "]"}], " ", "=", " ", 
               RowBox[{"Conjugate", "[", "z", "]"}]}]}]}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "nn"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"j", ",", " ", "i"}], "}"}]}], "]"}], ";", "\n", "   ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ev", ",", " ", "v"}], "}"}], " ", "=", " ", 
          RowBox[{"t2eigh", "[", "a", "]"}]}], ";", "\n", "   ", 
         RowBox[{"worst11", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"worst11", ",", " ", 
            RowBox[{
             RowBox[{"fro", "[", 
              RowBox[{
               RowBox[{"v", " ", ".", " ", 
                RowBox[{"DiagonalMatrix", "[", "ev", "]"}], " ", ".", " ", 
                RowBox[{"ConjugateTranspose", "[", "v", "]"}]}], " ", "-", 
               " ", "a"}], "]"}], "/", 
             RowBox[{"fro", "[", "a", "]"}]}], ",", " ", 
            RowBox[{"fro", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"ConjugateTranspose", "[", "v", "]"}], " ", ".", " ", 
               "v"}], " ", "-", " ", 
              RowBox[{"IdentityMatrix", "[", "nn", "]"}]}], "]"}]}], 
           "]"}]}]}]}], "]"}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"nn", ",", " ", 
        RowBox[{"{", 
         RowBox[{"7", ",", " ", "64", ",", " ", "200"}], "}"}]}], "}"}]}], 
     "]"}], ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<GS-11\>\"", ",", 
     " ", "\"\<the Hermitian eigensolver of t2core (Householder reduction and \
implicit QL), rewritten above: for random Hermitian matrices of the \
dimensions 7, 64 and 200 the eigenvectors are orthonormal and reproduce the \
matrix (relative tolerance 1e-11)\>\"", ",", "\n", "  ", 
     RowBox[{"worst11", " ", "<", " ", "1*^-11"}], ",", " ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<largest relative residual \>\"", ",", " ", "worst11", ",",
         " ", "\"\< (original: 6.0e-14)\>\""}], "}"}], "]"}]}], 
    "]"}]}]}]], "Input",
 CellLabel->
  "In[337]:=",ExpressionUUID->"dcc54d10-6b6a-4038-a237-92ef6ceff85e"],

