           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the gauge-covariant derivative of ",
           Cell[BoxData[
            FormBox[
             SubscriptBox["\[CapitalPsi]", 
              StyleBox["LL",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "860edbb6-25cc-4906-a751-82e4862eb292"],
           ", the ",
           Cell[BoxData[
            FormBox[
             RowBox[{"8", "\[Times]", "8"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "e9ecbbb7-54df-4bb3-b141-860dfb1c8daa"],
           " matrix of differential operators ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox["\[Del]", 
               StyleBox["p", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"]], "\[LongEqual]", 
              SubscriptBox["\[PartialD]", 
               StyleBox["p", "TI"]], "+", 
              SubsuperscriptBox["\[CapitalGamma]", 
               StyleBox["p", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"]], "-", 
              StyleBox["i", "TI"], "\[ThinSpace]", 
              SubscriptBox[
               StyleBox["A",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "c4ab9620-b87f-4697-a87f-cb6a2c617690"],
           ", and the covariant derivative of a field that transforms like ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[CapitalPsi]", 
              StyleBox["LL",
               FontSlant->"Plain"], "*"], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "5499913a-d156-4460-8968-0a1f806117b3"],
           " (the hole component), ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox["\[Del]", 
               StyleBox["p", "TI"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], "*"}]], "\[LongEqual]", 
              SubscriptBox["\[PartialD]", 
               StyleBox["p", "TI"]], "+", 
              SuperscriptBox[
               RowBox[{"(", 
                SubsuperscriptBox["\[CapitalGamma]", 
                 StyleBox["p", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"]], ")"}], "*"], "+", 
              StyleBox["i", "TI"], "\[ThinSpace]", 
              SuperscriptBox[
               RowBox[{"(", 
                SubscriptBox[
                 StyleBox["A",
                  FontFamily->"Helvetica",
                  FontSlant->"Plain"], 
                 RowBox[{
                  StyleBox["LL",
                   FontSlant->"Plain"], ",", 
                  StyleBox["p", "TI"]}]], ")"}], "*"]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "29ea02c9-74eb-46e5-9d75-75d4b189a74a"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "e4b92e5e-869e-4e53-92c6-39aaaaede53d"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubscriptBox[
             TagBox[
              StyleBox["D", FontWeight -> "Bold", FontSlant -> "Plain"], 
              "SL31Bold"], "LL"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"Dbq_LL\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the bi-quaternion of covariant derivatives, ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubscriptBox[
               StyleBox["D",
                FontWeight->"Bold",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"]], "\[LongEqual]", 
              UnderscriptBox["\[Sum]", 
               StyleBox["p", "TI"],
               LimitsPositioning->True], "\[ThinSpace]", 
              SubscriptBox[
               StyleBox["f",
                FontWeight->"Bold",
                FontSlant->"Plain"], 
               StyleBox["p", "TI"]], 
              SubsuperscriptBox["\[Del]", 
               StyleBox["p", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "a5c2fd85-7f34-4add-910d-83e24060d3ed"],
           
           " (bold upright like every bi-quaternion of this folder; it is not \
the Lorentz derivation ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubscriptBox[
               StyleBox["D", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"]], 
              RowBox[{"(", 
               StyleBox["u",
                FontWeight->"Bold",
                FontSlant->"Plain"], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "f7bb44fd-4d20-412f-b0d2-93423607db63"],
           ", which is italic and has an argument), with ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              UnderscriptBox["\[Sum]", 
               StyleBox["p", "TI"],
               LimitsPositioning->True], "\[ThinSpace]", 
              SubsuperscriptBox["\[Gamma]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["p", "TI"]], 
              SubsuperscriptBox["\[Del]", 
               StyleBox["p", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"]], "\[LongEqual]", 
              RowBox[{"(", "\[NoBreak]", GridBox[{
                 {"0", 
                  RowBox[{
                   SubscriptBox[
                    StyleBox["M", "TI"], 
                    StyleBox["LL",
                    FontSlant->"Plain"]], 
                   RowBox[{"(", 
                    SubscriptBox[
                    StyleBox["D",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], 
                    StyleBox["LL",
                    FontSlant->"Plain"]], ")"}]}]},
                 {
                  RowBox[{
                   SubscriptBox[
                    StyleBox["M", "TI"], 
                    StyleBox["LL",
                    FontSlant->"Plain"]], 
                   RowBox[{"(", 
                    SubscriptBox[
                    OverscriptBox[
                    StyleBox["D",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], "_"], 
                    StyleBox["LL",
                    FontSlant->"Plain"]], ")"}]}], "0"}
                },
                
                GridBoxAlignment->{
                 "Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
                GridBoxSpacings->{"Columns" -> {
