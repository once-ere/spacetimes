                  SubscriptBox["N", "LL"], "(", 
                  TagBox[
                   StyleBox["x", FontWeight -> "Bold", FontSlant -> "Plain"], 
                   "SL31Bold"], ",", 
                  TagBox[
                   StyleBox["y", FontWeight -> "Bold", FontSlant -> "Plain"], 
                   "SL31Bold"], ")"}]},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              StyleBox["\<\"N_LL\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[Cell[TextData[{
               "the complex norm ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubscriptBox[
                   StyleBox["N", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]], 
                  RowBox[{"(", 
                   StyleBox["x",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], ")"}], "\[LongEqual]", 
                  UnderscriptBox["\[Sum]", 
                   StyleBox["p", "TI"],
                   LimitsPositioning->True], "\[ThinSpace]", 
                  SubsuperscriptBox["\[Xi]", 
                   StyleBox["p", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]], 
                  SuperscriptBox[
                   RowBox[{"(", 
                    StyleBox["x",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], ")"}], "2"]}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "787461c3-72bb-4c5d-b2d3-3ae51622231e"],
               ", with ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  StyleBox["x",
                   FontWeight->"Bold",
                   FontSlant->"Plain"], 
                  OverscriptBox[
                   StyleBox["x",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], "_"], "\[LongEqual]", 
                  OverscriptBox[
                   StyleBox["x",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], "_"], 
                  StyleBox["x",
                   FontWeight->"Bold",
                   FontSlant->"Plain"], "\[LongEqual]", 
                  SubscriptBox[
                   StyleBox["N", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]], 
                  RowBox[{"(", 
                   StyleBox["x",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], ")"}], "\[ThinSpace]", 
                  SubscriptBox[
                   StyleBox["e",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], "0"]}], TraditionalForm]], 
