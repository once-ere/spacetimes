            "4614f598-4daf-4dfc-a6ab-b2c713dbe27c"],
           " in the effective potential of the normal vacuum, ",
           Cell[BoxData[
            FormBox[
             RowBox[{"1", "/", 
              SubscriptBox[
               StyleBox["G", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"]], "-", "1", "/", 
