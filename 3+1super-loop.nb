                  SubscriptBox["G", "2"], "(", "\[DoubleStruckCapitalC]", 
                  ")"}], "\", \"", 
                RowBox[{"S", "O", "(", "1", ",", "7", ")"}], "\", \"", 
                RowBox[{"S", "p", "i", "n", "(", "7", ")"}], "\", \"", 
                
                RowBox[{
                 "S", "p", "i", "n", "(", "7", ",", "\[DoubleStruckCapitalC]",
                   ")"}], "\", \"", 
                
                RowBox[{
                 "S", "L", "(", "2", ",", "\[DoubleStruckCapitalR]", ")"}], 
                "\", \"", 
                RowBox[{"S", "p", "i", "n", "(", "2", ",", "1", ")"}], 
                "\", \"", 
                RowBox[{"S", "U", "(", "2", ")"}], "\", \"", 
