         "hl", ",", " ", "w0IDA13", ",", " ", "touts13", ",", " ", "rt", ",", 
          " ", 
          RowBox[{"rt", "/", "100"}], ",", " ", 
          RowBox[{"t2localErrorsIDA", "[", 
           RowBox[{"e13", ",", " ", "v13", ",", " ", "rt", ",", " ", 
            RowBox[{"rt", "/", "100"}]}], "]"}]}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"rt", ",", " ", "rtols13"}], "}"}]}], "]"}], "]"}]}], ";"}], 
