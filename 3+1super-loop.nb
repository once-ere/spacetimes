 ", is"
}], "Text",ExpressionUUID->"00b46e2f-324e-463d-a34f-63dc54f18e92"],

Cell[BoxData[
 FormBox[
  RowBox[{
   UnderscriptBox["\[Sum]", 
    StyleBox["j", "TI"],
    LimitsPositioning->True], 
   RowBox[{"[", 
    RowBox[{
     RowBox[{"-", 
