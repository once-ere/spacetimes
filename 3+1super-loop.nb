                    FontWeight->"Bold",
                    FontSlant->"Plain"], 
                    SubscriptBox[
                    StyleBox["e",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], "4"]}], "_"], "\[LongEqual]", 
