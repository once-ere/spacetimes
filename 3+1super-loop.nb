                FontSlant->"Plain"]], 
              SuperscriptBox[
               RowBox[{"\[LeftBracketingBar]", 
                SubscriptBox[
                 OverscriptBox[
                  StyleBox["d", "TI"], "\[RightVector]"], 
                 StyleBox["LL",
                  FontSlant->"Plain"]], "\[RightBracketingBar]"}], "2"], "+", 
              
              SubsuperscriptBox[
               StyleBox["b", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["GL",
                FontSlant->"Plain"]], 
              RowBox[{"(", 
               RowBox[{"2", 
                SuperscriptBox[
                 RowBox[{"\[LeftBracketingBar]", 
