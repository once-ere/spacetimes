         RowBox[{"na", " ", "=", " ", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"a", " ", ".", " ", "a"}], "]"}]}], ",", " ", "x", ",", 
         " ", "ph", ",", " ", "cx", ",", " ", "sx", ",", " ", "n1", ",", " ", 
         "n2", ",", " ", "n3"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"x", " ", "=", " ", 
         RowBox[{"0.5", " ", "ell", " ", "gv", " ", "na"}]}], ";", "\n", 
        "   ", 
