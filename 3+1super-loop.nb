       RowBox[{"j", "''"}]}], "}"}], " ", 
     RowBox[{"(", 
      RowBox[{"j", ",", " ", 
       RowBox[{"j", "'"}], ",", " ", 
       RowBox[{
        RowBox[{"j", "''"}], " ", "=", " ", "1"}], ",", " ", "2", ",", " ", 
       "3"}], ")"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"sigma", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"ReleaseHold", "[", 
        RowBox[{"SL31Instance", "[", 
         RowBox[{
          RowBox[{
          "SL31SymbolBoxes", "[", "\"\<\\\\sigma^{\\\\rm LL}_j\>\"", "]"}], ",",
           " ", 
          RowBox[{"{", 
           RowBox[{"\"\<j\>\"", " ", "->", " ", 
            RowBox[{"ToString", "[", "k", "]"}]}], "}"}]}], "]"}], "]"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"eps", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"ReleaseHold", "[", 
        RowBox[{"SL31Instance", "[", 
         RowBox[{
          RowBox[{
          "SL31SymbolBoxes", "[", "\"\<\\\\epsilon^{\\\\rm LL}_{jj'j''}\>\"", 
           "]"}], ",", "\n", "      ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\"\<j\>\"", " ", "->", " ", 
             RowBox[{"ToString", "[", "a", "]"}]}], ",", " ", 
            RowBox[{
             RowBox[{"SuperscriptBox", "[", 
              RowBox[{"\"\<j\>\"", ",", " ", "\"\<\[Prime]\>\""}], "]"}], " ",
              "->", " ", 
             RowBox[{"ToString", "[", "b", "]"}]}], ",", " ", 
            RowBox[{
             RowBox[{"SuperscriptBox", "[", 
              RowBox[{"\"\<j\>\"", ",", " ", "\"\<\[Prime]\[Prime]\>\""}], 
              "]"}], " ", "->", " ", 
             RowBox[{"ToString", "[", "c", "]"}]}]}], "}"}]}], "]"}], "]"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"b", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"c", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"{", 
    RowBox[{"sigma", ",", " ", 
     RowBox[{"eps", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "]"}], "]"}], ",", " ", 
     RowBox[{"eps", "[", 
      RowBox[{"[", 
       RowBox[{"2", ",", " ", "1", ",", " ", "3"}], "]"}], "]"}]}], 
    "}"}]}]}]], "Input",
 CellLabel->
  "In[113]:=",ExpressionUUID->"4138d5ac-0703-4a6e-af6a-62eed9a1d7d6"],

