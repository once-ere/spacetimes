In[429]:=",ExpressionUUID->"90c673b6-3536-4c7b-a061-29aebff0babb"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"GS", "-", "11"}], ":", " ", 
     RowBox[{
     "the", " ", "rewritten", " ", "eigensolver", " ", "on", " ", "random", " ",
       "Hermitian", " ", "matrices", " ", "of", " ", "the", " ", "dimensions",
       " ", "7"}]}], ",", " ", 
    RowBox[{"64", " ", "and", " ", "200"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"worst11", " ", "=", " ", "0."}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"a", " ", "=", " ", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{
             RowBox[{"0.", " ", "I"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"nn", ",", " ", "nn"}], "}"}]}], "]"}]}], ",", " ", 
          "ev", ",", " ", "v"}], "}"}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"z", " ", "=", " ", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"i", " ", "==", " ", "j"}], ",", " ", 
                 RowBox[{
                  RowBox[{"t2Unit", "[", "]"}], " ", "+", " ", 
                  RowBox[{"0.", " ", "I"}]}], ",", " ", 
                 RowBox[{"t2UnitC", "[", "]"}]}], "]"}]}], "}"}], ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"a", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", " ", "j"}], "]"}], "]"}], " ", "=", " ", 
               "z"}], ";", " ", 
              RowBox[{
               RowBox[{"a", "[", 
                RowBox[{"[", 
                 RowBox[{"j", ",", " ", "i"}], "]"}], "]"}], " ", "=", " ", 
               RowBox[{"Conjugate", "[", "z", "]"}]}]}]}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "nn"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"j", ",", " ", "i"}], "}"}]}], "]"}], ";", "\n", "   ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ev", ",", " ", "v"}], "}"}], " ", "=", " ", 
          RowBox[{"t2eigh", "[", "a", "]"}]}], ";", "\n", "   ", 
         RowBox[{"worst11", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"worst11", ",", " ", 
            RowBox[{
             RowBox[{"fro", "[", 
              RowBox[{
               RowBox[{"v", " ", ".", " ", 
                RowBox[{"DiagonalMatrix", "[", "ev", "]"}], " ", ".", " ", 
                RowBox[{"ConjugateTranspose", "[", "v", "]"}]}], " ", "-", 
               " ", "a"}], "]"}], "/", 
             RowBox[{"fro", "[", "a", "]"}]}], ",", " ", 
            RowBox[{"fro", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"ConjugateTranspose", "[", "v", "]"}], " ", ".", " ", 
               "v"}], " ", "-", " ", 
              RowBox[{"IdentityMatrix", "[", "nn", "]"}]}], "]"}]}], 
           "]"}]}]}]}], "]"}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"nn", ",", " ", 
        RowBox[{"{", 
         RowBox[{"7", ",", " ", "64", ",", " ", "200"}], "}"}]}], "}"}]}], 
     "]"}], ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<GS-11\>\"", ",", 
     " ", "\"\<the Hermitian eigensolver of t2core (Householder reduction and \
implicit QL), rewritten above: for random Hermitian matrices of the \
dimensions 7, 64 and 200 the eigenvectors are orthonormal and reproduce the \
matrix (relative tolerance 1e-11)\>\"", ",", "\n", "  ", 
     RowBox[{"worst11", " ", "<", " ", "1*^-11"}], ",", " ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<largest relative residual \>\"", ",", " ", "worst11", ",",
         " ", "\"\< (original: 6.0e-14)\>\""}], "}"}], "]"}]}], 
    "]"}]}]}]], "Input",
 CellLabel->
  "In[451]:=",ExpressionUUID->"c26f313f-4272-4535-a598-d65637582330"],

Cell[BoxData[
 StyleBox[
  TemplateBox[{
    StyleBox["\"PASS  \"", Bold, 
     RGBColor[0, 
      Rational[2, 3], 0], StripOnInput -> False], "\"GS-11: \"", 
    "\"the Hermitian eigensolver of t2core (Householder reduction and \
implicit QL), rewritten above: for random Hermitian matrices of the \
dimensions 7, 64 and 200 the eigenvectors are orthonormal and reproduce the \
matrix (relative tolerance 1e-11)\"", 
    "\"  -- largest relative residual 6.48707e-14 (original: 6.0e-14)\""},
   "RowDefault"],
  StripOnInput->False,
  LineIndent->0]], "Print",
 CellChangeTimes->{4.004025495061371*^9},
 CellLabel->
  "During evaluation of \
In[451]:=",ExpressionUUID->"9b0817ca-6f44-46e1-beac-d403e0febb16"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["GS-12: the explicit matrices and the component equations", "Subsection",ExpressionUUID->"12fff8c0-5b5f-444a-b7ee-919919236563"],

Cell[TextData[{
 "The original program prints every matrix and every component equation of \
the field equations in TeX, with its small symbolic algebra, and evaluates \
each printed expression for numbers assigned to its symbols, comparing it \
with the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"8", "\[Times]", "8"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6dee65fc-2175-4abb-a14c-79622dfeded4"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"16", "\[Times]", "16"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cd90c0b2-515a-448c-a0e9-45d95b0c6ff6"],
 " matrix computation (check GS-12). Here the same expressions are built from \
symbols of the Wolfram Language, shown, and evaluated in the same way. The \
symbols: ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["d", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b321647b-694c-495e-8bd3-a9f951edf8f5"],
 " (the order parameter), ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Omega]", 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}], 
    StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f3bc7223-2d97-4a08-a103-f7f5fe990912"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CurlyPi]", 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}], 
    StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "42ca5ec5-bb08-492b-969f-c6d97774dcec"],
 " (the rotation and boost parts of the Lorentz connection in the direction \
",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a900ded5-4091-4557-a66a-369b0a00cff5"],
 "), ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["A", "TI"], 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}], "\[Iota]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2c96e8cf-b3b0-4471-946c-ec9df40d2d74"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["A", "TI"], 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}], 
    StyleBox["F",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4b50c539-d69f-4f27-996d-1b2213902305"],
 " (the gauge potentials), ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["v",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "742677bd-e43b-4751-985e-d2fecb53b8ff"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["F",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e6d7cb5f-dab6-4062-9312-17f5937a357b"],
 " (the couplings), ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Psi]", 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["k", "TI"]}], 
    StyleBox["p",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c33279a4-b36e-43c0-a719-4e8229b06146"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Psi]", 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["k", "TI"]}], 
    StyleBox["h",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "eb6a60b5-1775-4823-ac78-b9e9f00456cb"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPsi]", 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["k", "TI"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d75dc1ff-bb17-4132-9f95-2a987d99406e"],
 " (the components; the number of a component, the last letter of the \
subscript, runs from 1 to 8), ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a2682706-f39d-40eb-849f-e992d66d6269"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Mu]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "db73601c-d548-4ebf-b11d-cd5ce519dc96"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "440b45b3-877c-4296-96eb-9e15be26b346"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalPi]", 
    StyleBox["LL",
