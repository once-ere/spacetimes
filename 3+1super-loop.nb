                SubsuperscriptBox["\[CurlyTheta]", 
                 RowBox[{"LL", ",", "\[Iota]"}], "G"], "/", 
                SubsuperscriptBox[
                 StyleBox["g", "TI"], "LL", "v"]}], TraditionalForm], 
             "\" (\"", 
             FormBox[
              RowBox[{"\[Iota]", "\[LongEqual]", "1", ",", "2"}], 
              TraditionalForm], "\") and \"", 
             FormBox[
              RowBox[{
                SubsuperscriptBox[
                 StyleBox["V", "TI"], 
                 RowBox[{"LL", ",", 
                   StyleBox["p", "TI"]}], "3"], "\[LongEqual]", 
                SubsuperscriptBox[
                 StyleBox["A", "TI"], 
                 RowBox[{"LL", ",", 
                   StyleBox["p", "TI"]}], "3"]}], TraditionalForm], 
             "\", the photon\""},
            "RowDefault"],
           StripOnInput->False,
           FontFamily->"Source Sans Pro",
           FontSize->9.5],
          ImageSize->290]},
        {
