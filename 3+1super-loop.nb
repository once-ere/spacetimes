       SubsuperscriptBox["\[ScriptL]", 
        StyleBox["LL",
         FontSlant->"Plain"], 
        StyleBox["x",
         FontSlant->"Plain"]]}]], 
     SubscriptBox["\[Beta]", 
      StyleBox["LL",
       FontSlant->"Plain"]], 
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["U",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["LL",
          FontSlant->"Plain"], ",", 
         StyleBox["j", "TI"]}], 
        StyleBox["link",
         FontSlant->"Plain"]], 
       RowBox[{"(", 
        SubscriptBox[
         OverscriptBox[
          StyleBox["s", "TI"], "\[RightVector]"], 
         StyleBox["LL",
          FontSlant->"Plain"]], ")"}], 
       SubsuperscriptBox["\[Psi]", 
        StyleBox["LL",
         FontSlant->"Plain"], 
        StyleBox["p",
         FontSlant->"Plain"]], 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox[
          OverscriptBox[
           StyleBox["s", "TI"], "\[RightVector]"], 
          StyleBox["LL",
           FontSlant->"Plain"]], "+", 
