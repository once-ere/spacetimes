diag(-i sigma_j/2, -i sigma_j/2) = gamma^j' gamma^j''/2, sgen(K^j) = \
diag(-sigma_j/2, sigma_j/2) = gamma^0 gamma^j/2; the 27 relations of so(3,1); \
24 intertwining relations [gamma^p, sgen(u)] = sum V(u)[p][q] gamma^q", 
   Row[{"  -- ", 
     Row[{
      27, " commutation relations, ", 24, 
       " intertwining relations (original: 27 and 24)"}]}]],
  Editable->False]], "Print",
 CellChangeTimes->{4.003995309356821*^9},
 CellLabel->
  "During evaluation of \
In[249]:=",ExpressionUUID->"d18401c8-6739-4f40-ba4a-e57e32f066b3"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
GS-3 and GS-4: finite transformations, isospin and the pair matrices\
\>", "Subsection",ExpressionUUID->"db294f3d-bac7-478a-9fbb-740c1d73dc9b"],

Cell[TextData[{
 "GS-3 is the change of representation of the gauge group ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     StyleBox["S", "TI"], 
     StyleBox["L", "TI"], 
     RowBox[{"(", 
      RowBox[{"2", ",", 
       StyleBox["\[DoubleStruckCapitalC]",
        FontSlant->"Plain"]}], ")"}]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"07812e01-4f7c-4ed7-9209-52ed17b5cb61"]], "InlineFormula",
  ExpressionUUID->"9b974515-9e6f-45a0-b5c6-707b8c23733c"],
 ": for a unit bi-quaternion ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    StyleBox["g",
     FontWeight->"Bold",
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "7a331e05-433f-40a8-a62e-003a832a338c"]], "InlineFormula",ExpressionUUID->
  "fcb5ad60-2783-4722-ac26-a01159ed8322"],
 " the spinor matrix ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["S",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "LL"], 
     RowBox[{"(", 
      StyleBox["g",
       FontWeight->"Bold",
       FontSlant->"Plain"], ")"}], "\[LongEqual]", 
     StyleBox["diag",
      FontSlant->"Plain"], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["M", "TI"], "LL"], 
       RowBox[{"(", 
        OverscriptBox[
         StyleBox["g",
          FontWeight->"Bold",
          FontSlant->"Plain"], "~"], ")"}], ",", 
       SubscriptBox[
        StyleBox["M", "TI"], "LL"], 
       RowBox[{"(", 
        StyleBox["g",
         FontWeight->"Bold",
         FontSlant->"Plain"], ")"}]}], ")"}]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"31bf7a5b-17dd-4f01-8018-dd37ff8287e1"]], 
  "InlineFormula",ExpressionUUID->"b99c62c5-e442-448e-83d6-46f22ed2090f"],
 ", with ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     OverscriptBox[
      StyleBox["g",
       FontWeight->"Bold",
       FontSlant->"Plain"], "~"], "\[LongEqual]", 
     SuperscriptBox[
      RowBox[{"(", 
       SuperscriptBox[
        StyleBox["g",
         FontWeight->"Bold",
         FontSlant->"Plain"], "\[Dagger]"], ")"}], 
      RowBox[{"-", "1"}]]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"b3b9a6aa-60e1-4b1a-aeae-9734eb85b3f8"]], "InlineFormula",
  ExpressionUUID->"27fcb23f-5716-43bc-89ec-79a4d75e8149"],
 " and so ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["M", "TI"], "LL"], 
     RowBox[{"(", 
      OverscriptBox[
       StyleBox["g",
        FontWeight->"Bold",
        FontSlant->"Plain"], "~"], ")"}], "\[LongEqual]", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubscriptBox[
         StyleBox["M", "TI"], "LL"], 
        SuperscriptBox[
         RowBox[{"(", 
          StyleBox["g",
           FontWeight->"Bold",
           FontSlant->"Plain"], ")"}], "\[Dagger]"]}], ")"}], 
      RowBox[{"-", "1"}]]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"1b5a0d7b-8dbc-453c-bdff-b12951c23cce"]], "InlineFormula",
  ExpressionUUID->"1e14816a-b0ed-4ed9-8d1c-602629ab9283"],
 ", satisfies ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["S",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "LL"], 
     SuperscriptBox[
      RowBox[{"(", 
       StyleBox["g",
        FontWeight->"Bold",
        FontSlant->"Plain"], ")"}], 
      RowBox[{"-", "1"}]], 
     SubsuperscriptBox["\[Gamma]", "LL", 
      StyleBox["p", "TI"]], 
     SubscriptBox[
      StyleBox["S",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "LL"], 
     RowBox[{"(", 
      StyleBox["g",
       FontWeight->"Bold",
       FontSlant->"Plain"], ")"}], "\[LongEqual]", 
     UnderscriptBox["\[Sum]", 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"],
      LimitsPositioning->True], 
     SubscriptBox[
      RowBox[{"[", 
       RowBox[{
        SubscriptBox[
         StyleBox["L",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], "LL"], "(", 
        StyleBox["g",
         FontWeight->"Bold",
         FontSlant->"Plain"], ")"}], "]"}], 
      RowBox[{
       StyleBox["p", "TI"], 
       SuperscriptBox[
        StyleBox["p", "TI"], "\[Prime]"]}]], 
     SubsuperscriptBox["\[Gamma]", "LL", 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"7622903b-fdd7-4016-ac06-b3f0a1239f94"]], 
  "InlineFormula",ExpressionUUID->"cca19173-1279-4dd3-b9f0-e5fbf1218051"],
 " with the real Lorentz matrix ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    FractionBox[
     RowBox[{
      SubscriptBox[
       RowBox[{"[", 
        RowBox[{
         SubscriptBox[
          StyleBox["L",
           FontFamily->"Helvetica",
           FontSlant->"Plain"], "LL"], "(", 
         StyleBox["g",
          FontWeight->"Bold",
          FontSlant->"Plain"], ")"}], "]"}], 
       RowBox[{
        StyleBox["p", "TI"], 
        SuperscriptBox[
         StyleBox["p", "TI"], "\[Prime]"]}]], "\[LongEqual]", "1"}], 
     RowBox[{"2", "Re", " ", "tr", 
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox["\[Sigma]", 
         StyleBox["p", "TI"], "LL"], 
        SubscriptBox[
         StyleBox["M", "TI"], "LL"], 
        RowBox[{"(", 
         StyleBox["g",
          FontWeight->"Bold",
          FontSlant->"Plain"], ")"}], 
        SubsuperscriptBox["\[Sigma]", 
         SuperscriptBox[
          StyleBox["p", "TI"], "\[Prime]"], "LL"], 
        SubscriptBox[
         StyleBox["M", "TI"], "LL"], 
        SuperscriptBox[
         RowBox[{"(", 
          StyleBox["g",
           FontWeight->"Bold",
           FontSlant->"Plain"], ")"}], "\[Dagger]"]}], ")"}]}]], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "4824a8ec-628c-46da-8d00-0178dafc00fe"]], "InlineFormula",ExpressionUUID->
  "4c698d1e-8062-4bc1-ac42-ae2de927dc35"],
 ", and ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["S",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "LL"], 
     RowBox[{"(", 
      StyleBox["g",
       FontWeight->"Bold",
       FontSlant->"Plain"], ")"}], 
     SubsuperscriptBox["\[Gamma]", "LL", 
      StyleBox["p", "TI"]], 
     RowBox[{"[", 
      StyleBox["f",
       FontWeight->"Bold",
       FontSlant->"Plain"], "]"}], 
     SubscriptBox[
      StyleBox["S",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "LL"], 
     SuperscriptBox[
      RowBox[{"(", 
       StyleBox["g",
        FontWeight->"Bold",
        FontSlant->"Plain"], ")"}], 
      RowBox[{"-", "1"}]], "\[LongEqual]", 
     SubsuperscriptBox["\[Gamma]", "LL", 
      StyleBox["p", "TI"]], 
     RowBox[{"[", 
      RowBox[{
       OverscriptBox[
        StyleBox["g",
         FontWeight->"Bold",
         FontSlant->"Plain"], "~"], 
       StyleBox["f",
        FontWeight->"Bold",
        FontSlant->"Plain"], 
       SuperscriptBox[
        OverscriptBox[
         StyleBox["g",
          FontWeight->"Bold",
          FontSlant->"Plain"], "~"], "\[Dagger]"]}], "]"}]}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "e7d86e79-4b2a-4c6d-a939-b857760d7209"]], "InlineFormula",ExpressionUUID->
  "c136fd0b-ad34-422d-a601-f5b1e378d65f"],
 " for random Hermitian frames ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    StyleBox["f",
     FontWeight->"Bold",
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "55642c13-89f6-4a4e-b80c-f46b72bbde80"]], "InlineFormula",ExpressionUUID->
  "9433e029-204f-456b-be63-79be250acc0b"],
 ". GS-4 checks the isospin algebra, the antisymmetry and the invariance of \
the pair matrices ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "LL", "\[Iota]"], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"edb4ac55-10fb-485c-b7e5-29b4e554154b"]], 
  "InlineFormula",ExpressionUUID->"c14b6801-12c0-4322-8406-a03b9a70c903"],
 ", and that ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubsuperscriptBox["\[CapitalPsi]", "LL", 
      StyleBox["T", "TI"]], 
     SubsuperscriptBox[
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "LL", "\[Iota]"], 
     SubscriptBox["\[CapitalPsi]", "LL"], "\[LongEqual]", "0"}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "a7a37536-9793-4b29-a636-7372761ffb15"]], "InlineFormula",ExpressionUUID->
  "3f93aa4a-a2f2-4a31-93be-424429de7e88"],
 " for a commuting (c-number) spinor, for which the antisymmetric matrix \
gives zero."
}], "Text",ExpressionUUID->"c599aa99-df89-4513-bc21-15a25e36a25d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"GS", "-", "3"}], ":", " ", 
      RowBox[{
       RowBox[{"200", " ", "random", " ", "unit", " ", "bi"}], "-", 
       "quaternions"}]}], ";", " ", 
     RowBox[{"for", " ", "each"}]}], ",", " ", 
    RowBox[{"a", " ", "random", " ", "Hermitian", " ", "frame", " ", 
     RowBox[{"(", 
      RowBox[{
      "the", " ", "random", " ", "numbers", " ", "in", " ", "the", " ", 
       "order", " ", "of", " ", "t2_fields"}], ")"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"worst3", " ", "=", " ", "0."}], ";", " ", 
    RowBox[{"worst3b", " ", "=", " ", "0."}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "mg", ",", " ", "s4", ",", " ", "s4i", ",", " ", "l", ",", " ", "f", 
          ",", " ", "gf", ",", " ", "mgt", ",", " ", "f2", ",", " ", "gf2"}], 
         "}"}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{"mg", " ", "=", " ", 
          RowBox[{"t2randSL2C", "[", "]"}]}], ";", "\n", "   ", 
         RowBox[{"s4", " ", "=", " ", 
          RowBox[{"t2spinRep", "[", "mg", "]"}]}], ";", "\n", "   ", 
         RowBox[{"s4i", " ", "=", " ", 
          RowBox[{"ArrayFlatten", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"ConjugateTranspose", "[", "mg", "]"}], ",", " ", 
               "0"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"0", ",", " ", 
               RowBox[{"t2inv2", "[", "mg", "]"}]}], "}"}]}], "}"}], "]"}]}], 
         ";", "\n", "   ", 
         RowBox[{"worst3", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"worst3", ",", " ", 
            RowBox[{"fro", "[", 
             RowBox[{
              RowBox[{"s4", " ", ".", " ", "s4i"}], " ", "-", " ", 
              RowBox[{"IdentityMatrix", "[", "4", "]"}]}], "]"}]}], "]"}]}], ";",
          "\n", "   ", 
         RowBox[{"l", " ", "=", " ", 
          RowBox[{"t2lmat", "[", "mg", "]"}]}], ";", "\n", "   ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{"worst3", " ", "=", " ", 
            RowBox[{"Max", "[", 
             RowBox[{"worst3", ",", " ", 
              RowBox[{"fro", "[", 
               RowBox[{
                RowBox[{"s4i", " ", ".", " ", 
                 RowBox[{"g", "[", 
                  RowBox[{"[", 
                   RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}], " ", ".", 
                 " ", "s4"}], " ", "-", " ", 
                RowBox[{"Sum", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"l", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"p", " ", "+", " ", "1"}], ",", " ", 
                    RowBox[{"q", " ", "+", " ", "1"}]}], "]"}], "]"}], " ", 
                   RowBox[{"g", "[", 
                    RowBox[{"[", 
                    RowBox[{"q", " ", "+", " ", "1"}], "]"}], "]"}]}], ",", 
                  " ", 
                  RowBox[{"{", 
                   RowBox[{"q", ",", " ", "0", ",", " ", "3"}], "}"}]}], 
                 "]"}]}], "]"}]}], "]"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}], ";", 
         "\n", "   ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"the", " ", "frame", " ", "f_p"}], " ", "=", " ", 
            RowBox[{
             RowBox[{"x0", " ", "e0"}], " ", "+", " ", 
             RowBox[{"i", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"x1", " ", "e1"}], " ", "+", " ", 
                RowBox[{"x2", " ", "e2"}], " ", "+", " ", 
                RowBox[{"x3", " ", "e3"}]}], ")"}]}]}]}], ",", " ", 
           RowBox[{
           "real", " ", "x", " ", "drawn", " ", "p", " ", "by", " ", "p"}]}], 
          " ", "*)"}], "\n", "   ", 
         RowBox[{"f", " ", "=", " ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Module", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"x0", " ", "=", " ", 
                RowBox[{"t2Unit", "[", "]"}]}], "}"}], ",", " ", 
              RowBox[{"Prepend", "[", 
               RowBox[{
                RowBox[{"Table", "[", 
                 RowBox[{
                  RowBox[{"I", " ", 
                   RowBox[{"t2Unit", "[", "]"}]}], ",", " ", 
                  RowBox[{"{", "3", "}"}]}], "]"}], ",", " ", "x0"}], "]"}]}],
              "]"}], ",", " ", 
            RowBox[{"{", "4", "}"}]}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"gf", " ", "=", " ", 
          RowBox[{"t2gammasFromFrame", "[", "f", "]"}]}], ";", "\n", "   ", 
         RowBox[{"mgt", " ", "=", " ", 
          RowBox[{"t2inv2", "[", 
           RowBox[{"ConjugateTranspose", "[", "mg", "]"}], "]"}]}], ";", "\n",
          "   ", 
         RowBox[{"f2", " ", "=", " ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"With", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"x", " ", "=", " ", 
                RowBox[{"t2coords", "[", 
                 RowBox[{"mgt", " ", ".", " ", 
                  RowBox[{"t2mq", "[", 
                   RowBox[{"f", "[", 
                    RowBox[{"[", "p", "]"}], "]"}], "]"}], " ", ".", " ", 
                  RowBox[{"ConjugateTranspose", "[", "mgt", "]"}]}], "]"}]}], 
               "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"x", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
                RowBox[{"I", " ", 
                 RowBox[{"x", "[", 
                  RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", 
                RowBox[{"I", " ", 
                 RowBox[{"x", "[", 
                  RowBox[{"[", "3", "]"}], "]"}]}], ",", " ", 
                RowBox[{"I", " ", 
                 RowBox[{"x", "[", 
                  RowBox[{"[", "4", "]"}], "]"}]}]}], "}"}]}], "]"}], ",", 
            " ", 
            RowBox[{"{", 
             RowBox[{"p", ",", " ", "4"}], "}"}]}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"gf2", " ", "=", " ", 
          RowBox[{"t2gammasFromFrame", "[", "f2", "]"}]}], ";", "\n", "   ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{"worst3b", " ", "=", " ", 
            RowBox[{"Max", "[", 
             RowBox[{"worst3b", ",", " ", 
              RowBox[{"fro", "[", 
               RowBox[{
                RowBox[{"s4", " ", ".", " ", 
                 RowBox[{"gf", "[", 
                  RowBox[{"[", "p", "]"}], "]"}], " ", ".", " ", "s4i"}], " ",
                 "-", " ", 
                RowBox[{"gf2", "[", 
                 RowBox[{"[", "p", "]"}], "]"}]}], "]"}]}], "]"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"p", ",", " ", "4"}], "}"}]}], "]"}]}]}], "]"}], ",", 
      "\n", "  ", 
      RowBox[{"{", "200", "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<GS-3\>\"", ",", 
     " ", "\"\<the gauge group SL(2,C) as a change of representation: \
Sspin^-1 gamma^p Sspin = sum Lmat[p][q] gamma^q and Sspin gamma^p[f] Sspin^-1 \
= gamma^p[gLt f gLt^dag] for 200 random gL and random Hermitian frames \
(tolerance 1e-10)\>\"", ",", "\n", "  ", 
     RowBox[{
      RowBox[{"worst3", " ", "<", " ", "1*^-10"}], " ", "&&", " ", 
      RowBox[{"worst3b", " ", "<", " ", "1*^-10"}]}], ",", " ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<largest deviations \>\"", ",", " ", "worst3", ",", 
        " ", "\"\< and \>\"", ",", " ", "worst3b", ",", 
        " ", "\"\< (original: 5.8e-14 and 6.6e-14)\>\""}], "}"}], "]"}]}], 
    "]"}]}]}]], "Input",
 CellLabel->
  "In[256]:=",ExpressionUUID->"06ff5a3f-c6b6-4f98-9af9-21f017267009"],

