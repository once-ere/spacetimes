            "9b073fc6-85b7-4eb4-b132-9aefac0d3617"],
           
           " (massive); a second such direction; and the small real amplitude \
of the deviation, a function of space and time"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "596c87e6-143f-4090-bf57-803571cd6718"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox[
             TagBox[
              StyleBox["H", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
