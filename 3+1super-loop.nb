In[212]:=",ExpressionUUID->"4c6a8e2b-35e7-4b2e-a347-bd5a0593dc23"]
}, Open  ]],

Cell[TextData[{
 "S-11, the sum over the isospin index with the generators ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Iota]"], "\[LongEqual]", 
    SubsuperscriptBox["\[Tau]", "\[Iota]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "/", "2"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f03b60e9-69e1-4497-b369-90e6a3cad10b"],
 ": the Casimir ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SubscriptBox[
       StyleBox["T", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]], ")"}], "2"], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", "\[Iota]",
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Iota]"], 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Iota]"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c4fedbcc-5cf0-4006-b606-8b155788c528"],
 " of the isospin one-half is ",
 Cell[BoxData[
  FormBox[
   FractionBox["3", "4"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4edffabd-bce4-4ca2-86c5-2ba7068adba9"],
 " times the unit matrix. The components ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Tau]", "1", 
     StyleBox["LL",
      FontSlant->"Plain"]], ",", 
    SubsuperscriptBox["\[Tau]", "2", 
     StyleBox["LL",
      FontSlant->"Plain"]], ",", 
    SubsuperscriptBox["\[Tau]", "3", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ae07e3ac-1442-4893-80a6-dcafa5291d53"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], ",", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "2"], ",", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "3"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1482b39d-67ed-46a3-8f6b-226c7ea00a24"],
 " are symbolized; the generators are defined from the Pauli matrices by \
rules."
}], "Text",ExpressionUUID->"c7f07efd-ccae-4e66-b2a9-e1d7a1ba6446"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"taus", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ReleaseHold", "[", 
      RowBox[{"SL31Instance", "[", 
       RowBox[{
        RowBox[{
        "SL31SymbolBoxes", "[", "\"\<\\\\tau^{\\\\rm LL}_\\\\iota\>\"", "]"}],
         ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<\[Iota]\>\"", " ", "->", " ", 
          RowBox[{"ToString", "[", "k", "]"}]}], "}"}]}], "]"}], "]"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Ts", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ReleaseHold", "[", 
      RowBox[{"SL31Instance", "[", 
       RowBox[{
        RowBox[{
        "SL31SymbolBoxes", "[", "\"\<T^\\\\iota_{\\\\rm LL}\>\"", "]"}], ",", 
        " ", 
        RowBox[{"{", 
         RowBox[{"\"\<\[Iota]\>\"", " ", "->", " ", 
          RowBox[{"ToString", "[", "k", "]"}]}], "}"}]}], "]"}], "]"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"casimir", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Ts", "[", 
         RowBox[{"[", "k", "]"}], "]"}], " ", ".", " ", 
        RowBox[{"Ts", "[", 
         RowBox[{"[", "k", "]"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}], " ", "/.", " ", 
     RowBox[{"Thread", "[", 
      RowBox[{"Ts", " ", "->", " ", 
       RowBox[{"taus", "/", "2"}]}], "]"}]}], " ", "/.", " ", 
    RowBox[{"Thread", "[", 
     RowBox[{"taus", " ", "->", " ", "pauliValues"}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-11\>\"", ",", 
    " ", "\"\<the sum over iota of T^iota_LL T^iota_LL (with T = tau/2 for \
the symbolized components) is 3/4 times the unit matrix\>\"", ",", "\n", "  ", 
    RowBox[{"casimir", " ", "===", " ", 
     RowBox[{
      RowBox[{"3", "/", "4"}], " ", 
      RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], ",", " ", "casimir"}], 
   "]"}], ";"}]}], "Input",
 CellLabel->
  "In[213]:=",ExpressionUUID->"d8303623-aa48-4159-b2ed-db17bb34abf3"],

Cell[BoxData[
 StyleBox[
  TemplateBox[{
    StyleBox["\"PASS  \"", Bold, 
     RGBColor[0, 
      Rational[2, 3], 0], StripOnInput -> False], "\"S-11: \"", 
    "\"the sum over iota of T^iota_LL T^iota_LL (with T = tau/2 for the \
symbolized components) is 3/4 times the unit matrix\"", "\"  -- \"", 
    RowBox[{"{", 
      RowBox[{
        RowBox[{"{", 
          RowBox[{
            FractionBox["3", "4"], ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
          RowBox[{"0", ",", 
            FractionBox["3", "4"]}], "}"}]}], "}"}]},
