          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"H_DB h_nabla\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[
          StyleBox[
           
           TemplateBox[{
            "\"the Dirac-Bogoliubov-de Gennes operator of the mean-field \
equations: the \"", 
             FormBox[
              RowBox[{"2", "\[Cross]", "2"}], TraditionalForm], 
             "\" block matrix (blocks of \"", 
             FormBox[
              RowBox[{"8", "\[Cross]", "8"}], TraditionalForm], 
             "\") with the upper left block \"", 
             FormBox[
              RowBox[{
                SubsuperscriptBox[
                 StyleBox["h", "TI"], "LL", "\[Del]"], "-", 
                StyleBox["i", "TI"], 
                SubsuperscriptBox["\[CapitalGamma]", "0", "LL"], "-", 
                SubscriptBox[
                 StyleBox["A", FontSlant -> "Plain"], 
                 RowBox[{"LL", ",", "0"}]], "-", 
                SubscriptBox["\[Mu]", "LL"]}], TraditionalForm], 
             "\", the upper right block \"", 
             FormBox[
              SubscriptBox[
               StyleBox["P", FontSlant -> "Plain"], "LL"], TraditionalForm], 
             "\", the lower left block \"", 
             FormBox[
              SubsuperscriptBox[
               StyleBox["P", FontSlant -> "Plain"], "LL", "\[Dagger]"], 
              TraditionalForm], "\" and the lower right block \"", 
             FormBox[
              RowBox[{"-", 
                SuperscriptBox[
                 RowBox[{"(", 
                   RowBox[{
                    SubsuperscriptBox[
                    StyleBox["h", "TI"], "LL", "\[Del]"], "-", 
                    StyleBox["i", "TI"], 
                    SubsuperscriptBox["\[CapitalGamma]", "0", "LL"], "-", 
                    SubscriptBox[
                    StyleBox["A", FontSlant -> "Plain"], 
                    RowBox[{"LL", ",", "0"}]], "-", 
                    SubscriptBox["\[Mu]", "LL"]}], ")"}], "*"]}], 
              TraditionalForm], "\", with the covariant Dirac Hamiltonian \"", 
             FormBox[
              RowBox[{
                SubsuperscriptBox[
                 StyleBox["h", "TI"], "LL", "\[Del]"], "\[LongEqual]", "-", 
                StyleBox["i", "TI"], 
                UnderscriptBox["\[Sum]", 
                 StyleBox["j", "TI"], LimitsPositioning -> True], 
                SubsuperscriptBox["\[Alpha]", "LL", 
                 StyleBox["j", "TI"]], 
                SubsuperscriptBox["\[Del]", 
                 StyleBox["j", "TI"], "LL"], "+", 
                SubscriptBox["\[Beta]", "LL"], 
                SubscriptBox[
                 StyleBox["m", "TI"], "LL"]}], TraditionalForm], "\" (\"", 
             FormBox[
              SubsuperscriptBox["\[Alpha]", "LL", 
               StyleBox["j", "TI"]], TraditionalForm], "\" and \"", 
             FormBox[
              SubscriptBox["\[Beta]", "LL"], TraditionalForm], 
             "\" acting on the Dirac index); on a plane wave \"", 
             FormBox[
              RowBox[{"exp", "(", 
                RowBox[{
                  StyleBox["i", "TI"], 
                  UnderscriptBox["\[Sum]", 
                   StyleBox["j", "TI"], LimitsPositioning -> True], 
                  SubsuperscriptBox[
                   StyleBox["q", "TI"], "LL", 
                   StyleBox["j", "TI"]], 
                  SubsuperscriptBox[
                   StyleBox["x", "TI"], "LL", 
                   StyleBox["j", "TI"]]}], ")"}], TraditionalForm], 
             "\" with constant fields it is a \"", 
             FormBox[
              RowBox[{"16", "\[Cross]", "16"}], TraditionalForm], 
             "\" matrix \"", 
             FormBox[
              RowBox[{
                SubsuperscriptBox[
                 StyleBox["H", "TI"], "LL", "DB"], "(", 
                SubscriptBox[
                 OverscriptBox[
                  StyleBox["q", "TI"], "\[RightVector]"], "LL"], ")"}], 
              TraditionalForm], 
             "\" (plain text `H_DB(q)`), which without gauge fields equals \
\"", 
             FormBox[
              RowBox[{
                SubscriptBox[
                 StyleBox["H", FontSlant -> "Plain"], "LL"], "(", 
                SubscriptBox[
                 OverscriptBox[
                  StyleBox["q", "TI"], "\[RightVector]"], "LL"], ")"}], 
              TraditionalForm]},
            "RowDefault"],
           StripOnInput->False,
           FontFamily->"Source Sans Pro",
           FontSize->9.5],
          ImageSize->290]},
        {
