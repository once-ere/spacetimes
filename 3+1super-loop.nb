                FormBox[
                 SubscriptBox[
                  StyleBox["\[DoubleStruckCapitalB]",
                   FontSlant->"Plain"], 
                  StyleBox["LL",
                   FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "ebca5ea4-33c8-4aff-96ed-79b2ba6e2e55"],
               ": a linear map with ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubscriptBox[
                   StyleBox["\[ScriptCapitalD]",
                    FontSlant->"Plain"], 
