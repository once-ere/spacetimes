Cell[TextData[{
 "S-8, a double sum with a metric: the Minkowski square. The family ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "77e86e7a-b1da-4379-9eaa-a162227ee1dd"],
 " (the coordinates of space-time, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["p", "TI"], "\[LongEqual]", "0", ",", "1", ",", "2", ",", "3"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8cd439f0-933a-4a2b-aad4-63d4f898f5bd"],
 ") and the metric ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Eta]", 
    RowBox[{
     StyleBox["p", "TI"], 
     SuperscriptBox[
      StyleBox["p", "TI"], "\[Prime]"]}], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7fa302f3-93fe-4d3d-a4e5-3f6798be6f63"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5241ae58-1b62-4cc1-a85b-caa39b292f36"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["p", "TI"], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["p", "TI"], "\[Prime]"], "\[LongEqual]", "0"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "adf0f172-3021-4faa-a569-8605fdb68c54"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "528e90c2-9b63-4105-9073-f880fad8faa2"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["p", "TI"], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["p", "TI"], "\[Prime]"], "\[LongEqual]", "1", ",", "2", ",", 
    "3"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "62b71786-30b1-47cf-88f2-95b1897aba25"],
 ", zero otherwise) are symbolized component by component; the double sum ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["p", "TI"], ",", 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox["\[Eta]", 
     RowBox[{
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p", "TI"]], 
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     SuperscriptBox[
      StyleBox["p", "TI"], "\[Prime]"]]}], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9550fb79-bb53-438e-857e-3f91c8d1ea54"],
 " is formed with the 16 components of the metric as free symbols, then the \
metric receives its values and the sum must become ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "0"], ")"}], "2"], "-", 
    UnderscriptBox["\[Sum]", 
     StyleBox["j", "TI"],
     LimitsPositioning->True], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["j", "TI"]], ")"}], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ac3de6de-fb03-47bb-b2b8-4d142894e473"],
 ", with the coordinate components remaining free symbols. The test is \
algebraic: ",
 StyleBox["Expand",
  FontFamily->"Source Code Pro"],
 " and a comparison of polynomials in the four coordinate symbols."
}], "Text",ExpressionUUID->"c00a271b-3f64-4863-8960-dda6055bbbd4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"xs", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ReleaseHold", "[", 
      RowBox[{"SL31Instance", "[", 
       RowBox[{
        RowBox[{"SL31SymbolBoxes", "[", "\"\<x^p_{\\\\rm LL}\>\"", "]"}], ",",
         " ", 
        RowBox[{"{", 
         RowBox[{"\"\<p\>\"", " ", "->", " ", 
          RowBox[{"ToString", "[", "k", "]"}]}], "}"}]}], "]"}], "]"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"etas", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ReleaseHold", "[", 
      RowBox[{"SL31Instance", "[", 
       RowBox[{
        RowBox[{
        "SL31SymbolBoxes", "[", "\"\<\\\\eta^{\\\\rm LL}_{pp'}\>\"", "]"}], ",",
         " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\"\<p\>\"", " ", "->", " ", 
           RowBox[{"ToString", "[", "a", "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{"SuperscriptBox", "[", 
            RowBox[{"\"\<p\>\"", ",", " ", "\"\<\[Prime]\>\""}], "]"}], " ", "->",
            " ", 
           RowBox[{"ToString", "[", "b", "]"}]}]}], "}"}]}], "]"}], "]"}], ",",
      " ", 
     RowBox[{"{", 
      RowBox[{"a", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"b", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"quadratic", " ", "=", " ", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"etas", "[", 
       RowBox[{"[", 
        RowBox[{"a", ",", " ", "b"}], "]"}], "]"}], " ", 
      RowBox[{"xs", "[", 
       RowBox[{"[", "a", "]"}], "]"}], " ", 
      RowBox[{"xs", "[", 
       RowBox[{"[", "b", "]"}], "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"a", ",", " ", "4"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"b", ",", " ", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"minkowski", " ", "=", " ", 
   RowBox[{"Expand", "[", 
    RowBox[{"quadratic", " ", "/.", " ", 
     RowBox[{"Thread", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", "etas", "]"}], " ", "->", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{"DiagonalMatrix", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", 
           RowBox[{"-", "1"}], ",", " ", 
           RowBox[{"-", "1"}], ",", " ", 
           RowBox[{"-", "1"}]}], "}"}], "]"}], "]"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Length", "[", "quadratic", "]"}], ",", " ", "minkowski"}], 
  "}"}]}], "Input",
 CellLabel->
  "In[200]:=",ExpressionUUID->"cf24c4ef-ac10-4851-b3b9-6c1675500d3e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"16", ",", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["x", "LL", "0"], ")"}], "2"], "-", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["x", "LL", "1"], ")"}], "2"], "-", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["x", "LL", "2"], ")"}], "2"], "-", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["x", "LL", "3"], ")"}], "2"]}]}], "}"}]], "Output",
 CellChangeTimes->{4.004025486345792*^9},
 CellLabel->
  "Out[204]=",ExpressionUUID->"6249dce4-e890-4a35-8758-6f5d95fb23ce"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-8\>\"", ",", 
    " ", "\"\<the double sum of eta^LL_pp' x^p x^p' over p, p' = 0..3 (16 + 4 \
symbolized components) is (x^0)^2 - (x^1)^2 - (x^2)^2 - (x^3)^2\>\"", ",", 
    "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"Expand", "[", 
       RowBox[{"minkowski", " ", "-", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"xs", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "^", "2"}], " ", "-", " ", 
          RowBox[{
           RowBox[{"xs", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "^", "2"}], " ", "-", " ", 
          RowBox[{
           RowBox[{"xs", "[", 
            RowBox[{"[", "3", "]"}], "]"}], "^", "2"}], " ", "-", " ", 
          RowBox[{
           RowBox[{"xs", "[", 
            RowBox[{"[", "4", "]"}], "]"}], "^", "2"}]}], ")"}]}], "]"}], " ",
       "===", " ", "0"}], " ", "&&", " ", 
     RowBox[{
      RowBox[{"Length", "[", "quadratic", "]"}], " ", "==", " ", "16"}]}], ",",
     " ", "minkowski"}], "]"}], ";"}]], "Input",
 CellLabel->
  "In[205]:=",ExpressionUUID->"61f5e8e6-afed-4a70-a33f-d6d52227af4d"],

Cell[BoxData[
 StyleBox[
  TemplateBox[{
    StyleBox["\"PASS  \"", Bold, 
     RGBColor[0, 
      Rational[2, 3], 0], StripOnInput -> False], "\"S-8: \"", 
    "\"the double sum of eta^LL_pp' x^p x^p' over p, p' = 0..3 (16 + 4 \
symbolized components) is (x^0)^2 - (x^1)^2 - (x^2)^2 - (x^3)^2\"", 
    "\"  -- \"", 
    RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
         SubsuperscriptBox["x", "LL", "0"], ")"}], "2"], "-", 
      SuperscriptBox[
       RowBox[{"(", 
         SubsuperscriptBox["x", "LL", "1"], ")"}], "2"], "-", 
      SuperscriptBox[
       RowBox[{"(", 
         SubsuperscriptBox["x", "LL", "2"], ")"}], "2"], "-", 
      SuperscriptBox[
       RowBox[{"(", 
         SubsuperscriptBox["x", "LL", "3"], ")"}], "2"]}]},
   "RowDefault"],
  StripOnInput->False,
  LineIndent->0]], "Print",
