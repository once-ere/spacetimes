                    StyleBox["A", "TI"], 
                    RowBox[{"LL", ",", 
                    StyleBox["p", "TI"]}], "3"]}], ")"}]}], TraditionalForm], 
             "\" and the real antisymmetric \"", 
             FormBox[
              RowBox[{"3", "\[Cross]", "3"}], TraditionalForm], 
             "\" matrix with the entries \"", 
             FormBox[
              RowBox[{
                SubscriptBox[
                 RowBox[{"(", 
