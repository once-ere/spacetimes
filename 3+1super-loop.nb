          StyleBox["\<\"\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the first-order change of the field ",
           Cell[BoxData[
            FormBox[
             SubscriptBox[
              OverscriptBox[
               StyleBox["d", "TI"], "\[RightVector]"], 
              StyleBox["LL",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "3bc9a9fe-f23f-43b8-907b-c2f57e2f01e1"],
           " under the gauge transformation ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubscriptBox[
               OverscriptBox[
                StyleBox["d", "TI"], "\[RightVector]"], 
               StyleBox["LL",
                FontSlant->"Plain"]], "\[RightTeeArrow]", 
              StyleBox["exp",
               FontSlant->"Plain"], 
              RowBox[{"(", 
               RowBox[{"2", 
                StyleBox["i", "TI"], 
                SubsuperscriptBox["\[Theta]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["F",
                  FontSlant->"Plain"]]}], ")"}], 
              SubsuperscriptBox[
               StyleBox["R",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["v",
                FontSlant->"Plain"]], 
              RowBox[{"(", 
               SubscriptBox[
                StyleBox["U",
                 FontFamily->"Helvetica",
                 FontSlant->"Plain"], 
                StyleBox["LL",
                 FontSlant->"Plain"]], ")"}], 
              SubscriptBox[
               OverscriptBox[
                StyleBox["d", "TI"], "\[RightVector]"], 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "df425f30-e894-4b77-a018-14d4c231b16e"],
           " with the small angles ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[Theta]", 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["F",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "9f89dd94-2a32-4b93-8d60-4260288f39a1"],
           ", ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[Theta]", 
              StyleBox["LL",
               FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "aa657976-2176-4787-9dca-73d26fb9ba16"],
           ": ",
           Cell[BoxData[
            FormBox[
             RowBox[{"2", 
              StyleBox["i", "TI"], 
              SubsuperscriptBox["\[Theta]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["F",
                FontSlant->"Plain"]], 
              SubscriptBox[
               OverscriptBox[
                StyleBox["d", "TI"], "\[RightVector]"], 
               StyleBox["LL",
                FontSlant->"Plain"]], "-", 
              RowBox[{"(", 
               RowBox[{
                SubsuperscriptBox["\[Theta]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], "1"], ",", 
                SubsuperscriptBox["\[Theta]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], "2"], ",", 
                SubsuperscriptBox["\[Theta]", 
