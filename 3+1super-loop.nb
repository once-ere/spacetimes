Cell[TextData[{
 "S-8, a double sum with a metric: the Minkowski square. The family ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["x", "TI"], "LL", 
     StyleBox["p", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "c8d644cf-bda5-46ac-b6d2-c0221cbf6824"]], "InlineFormula",ExpressionUUID->
  "a9a162e4-462b-41c3-b0d2-ff1f20519a44"],
 " (the coordinates of space-time, ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     StyleBox["p", "TI"], "\[LongEqual]", "0", ",", "1", ",", "2", ",", "3"}],
     TraditionalForm]], "InlineFormula",ExpressionUUID->
   "56a07a2b-edf0-4a17-ac07-1b72593bd8dd"]], "InlineFormula",ExpressionUUID->
  "2e4b5e01-5d34-41ba-91bd-508beb844e0c"],
 ") and the metric ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[Eta]", 
     RowBox[{
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}], "LL"], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"cc5003f3-7dba-44ff-82f5-8dfe3840c9b3"]], 
  "InlineFormula",ExpressionUUID->"45ab12bd-5515-4ef2-9b3c-654bd38b5836"],
 " (",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{"+", "1"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "4a41c4fe-06f6-4402-a505-b07bb62da3c9"]], "InlineFormula",ExpressionUUID->
  "87568784-2007-417a-93fd-3a75280b7499"],
 " for ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     StyleBox["p", "TI"], "\[LongEqual]", 
     SuperscriptBox[
      StyleBox["p", "TI"], "\[Prime]"], "\[LongEqual]", "0"}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "d069bbdc-8333-4371-877e-d341ece586ee"]], "InlineFormula",ExpressionUUID->
  "cbc93e9b-6638-4e9a-84b5-4ba77af3f9f4"],
 ", ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "2c1b643d-04ff-4470-8cd1-0f817b2cc060"]], "InlineFormula",ExpressionUUID->
  "3daff5ef-8e09-47aa-85ad-08b1ad2e47a1"],
 " for ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     StyleBox["p", "TI"], "\[LongEqual]", 
     SuperscriptBox[
      StyleBox["p", "TI"], "\[Prime]"], "\[LongEqual]", "1", ",", "2", ",", 
     "3"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "7004add2-ea7d-4a9b-933c-47acac383cd6"]], "InlineFormula",ExpressionUUID->
  "34f7a8d6-0d1e-4387-b7f9-4bf5be0159c0"],
 ", zero otherwise) are symbolized component by component; the double sum ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{
       StyleBox["p", "TI"], ",", 
       SuperscriptBox[
        StyleBox["p", "TI"], "\[Prime]"]}],
      LimitsPositioning->True], 
     SubsuperscriptBox["\[Eta]", 
      RowBox[{
       StyleBox["p", "TI"], 
       SuperscriptBox[
        StyleBox["p", "TI"], "\[Prime]"]}], "LL"], 
     SubsuperscriptBox[
      StyleBox["x", "TI"], "LL", 
      StyleBox["p", "TI"]], 
     SubsuperscriptBox[
      StyleBox["x", "TI"], "LL", 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"397535ef-4c2f-4222-b7ec-cfb9020a13e1"]], 
  "InlineFormula",ExpressionUUID->"c81af694-c483-455d-8147-dc4cb38aa05a"],
 " is formed with the 16 components of the metric as free symbols, then the \
metric receives its values and the sum must become ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["x", "TI"], "LL", "0"], ")"}], "2"], "-", 
     UnderscriptBox["\[Sum]", 
      StyleBox["j", "TI"],
      LimitsPositioning->True], 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["x", "TI"], "LL", 
        StyleBox["j", "TI"]], ")"}], "2"]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"95d76b91-ec68-4b91-8e18-8032c2f00cd7"]], 
  "InlineFormula",ExpressionUUID->"bb214078-8bac-413e-8cd0-073cc551b666"],
 ", with the coordinate components remaining free symbols. The test is \
algebraic: ",
 StyleBox["Expand",
  FontFamily->"Source Code Pro"],
 " and a comparison of polynomials in the four coordinate symbols."
}], "Text",ExpressionUUID->"0c26e581-0a2b-443b-bf39-c44e555c4e7f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"xs", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ReleaseHold", "[", 
      RowBox[{"SL31Instance", "[", 
       RowBox[{
        RowBox[{"SL31SymbolBoxes", "[", "\"\<x^p_{\\\\rm LL}\>\"", "]"}], ",",
         " ", 
        RowBox[{"{", 
         RowBox[{"\"\<p\>\"", " ", "->", " ", 
          RowBox[{"ToString", "[", "k", "]"}]}], "}"}]}], "]"}], "]"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"etas", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ReleaseHold", "[", 
      RowBox[{"SL31Instance", "[", 
       RowBox[{
        RowBox[{
        "SL31SymbolBoxes", "[", "\"\<\\\\eta^{\\\\rm LL}_{pp'}\>\"", "]"}], ",",
         " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\"\<p\>\"", " ", "->", " ", 
           RowBox[{"ToString", "[", "a", "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{"SuperscriptBox", "[", 
            RowBox[{"\"\<p\>\"", ",", " ", "\"\<\[Prime]\>\""}], "]"}], " ", "->",
            " ", 
           RowBox[{"ToString", "[", "b", "]"}]}]}], "}"}]}], "]"}], "]"}], ",",
      " ", 
     RowBox[{"{", 
      RowBox[{"a", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"b", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"quadratic", " ", "=", " ", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"etas", "[", 
       RowBox[{"[", 
        RowBox[{"a", ",", " ", "b"}], "]"}], "]"}], " ", 
      RowBox[{"xs", "[", 
       RowBox[{"[", "a", "]"}], "]"}], " ", 
      RowBox[{"xs", "[", 
       RowBox[{"[", "b", "]"}], "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"a", ",", " ", "4"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"b", ",", " ", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"minkowski", " ", "=", " ", 
   RowBox[{"Expand", "[", 
    RowBox[{"quadratic", " ", "/.", " ", 
     RowBox[{"Thread", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", "etas", "]"}], " ", "->", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{"DiagonalMatrix", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", 
           RowBox[{"-", "1"}], ",", " ", 
           RowBox[{"-", "1"}], ",", " ", 
           RowBox[{"-", "1"}]}], "}"}], "]"}], "]"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Length", "[", "quadratic", "]"}], ",", " ", "minkowski"}], 
  "}"}]}], "Input",
 CellLabel->
  "In[119]:=",ExpressionUUID->"863a11bb-e72e-4f41-b172-57e8632539b4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"16", ",", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["x", "LL", "0"], ")"}], "2"], "-", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["x", "LL", "1"], ")"}], "2"], "-", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["x", "LL", "2"], ")"}], "2"], "-", 
