              StyleBox["\<\"q\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[Cell[TextData[{
               "the momentum of a particle in the space of ",
               Cell[BoxData[
                FormBox[
                 SubsuperscriptBox[
                  StyleBox["\[DoubleStruckCapitalR]",
                   FontSlant->"Plain"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
                  RowBox[{"1", ",", "3"}]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "b549e143-fa0a-459f-ba17-ac335a0861f5"],
               ", its length and its components"
              }], "Text",
               FontFamily->"Source Sans Pro",
               FontSize->9.5,ExpressionUUID->
               "90d4625b-94b1-4ff8-a1a6-0826b005eb0a"],
              ImageSize->290]},
            {
             PaneBox[
              TemplateBox[{
                SubscriptBox["m", "LL"], "\", \"", 
                SubscriptBox["\[Mu]", "LL"], "\", \"", 
                SubscriptBox["\[CapitalLambda]", "LL"]},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              StyleBox["\<\"m mu Lambda\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[Cell[TextData[{
               
               "the mass of the spinor charges, the chemical potential, and \
the momentum cutoff (",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubscriptBox[
                   StyleBox["q", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]], "<", 
                  SubscriptBox["\[CapitalLambda]", 
                   StyleBox["LL",
                    FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "9c6cbb1e-9bac-4c07-98d2-a0cf7a8b7497"],
               "; ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubscriptBox["\[CapitalLambda]", 
                   StyleBox["LL",
                    FontSlant->"Plain"]], "\[LongEqual]", "1"}], 
                 TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "c85b4ee7-7a2a-4fc4-a422-91a3c8e3c65b"],
               " sets the units, except where it varies)"
              }], "Text",
               FontFamily->"Source Sans Pro",
               FontSize->9.5,ExpressionUUID->
               "f105d173-8a06-429b-934f-ec3142d921ed"],
              ImageSize->290]},
            {
             PaneBox[
              TemplateBox[{
                SubscriptBox["\[CurlyEpsilon]", "LL"], "\", \"", 
                SubsuperscriptBox["E", "LL", "\[PlusMinus]"], "\", \"", 
                SubsuperscriptBox[
                 OverscriptBox["E", "~"], "LL", "\[PlusMinus]"]},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              
              StyleBox["\<\"eps E^+ E^- E^(+-) E_minus_polar E_plus_polar \
