         FontSlant->"Plain"], ",", 
        StyleBox["j", "TI"]}], "\[Iota]"], 
      SubsuperscriptBox["\[Tau]", "\[Iota]", 
       StyleBox["LL",
        FontSlant->"Plain"]], "/", 
      RowBox[{"\[LeftBracketingBar]", 
       SubsuperscriptBox[
        OverscriptBox[
         StyleBox["A", "TI"], "\[RightVector]"], 
        RowBox[{
         StyleBox["LL",
          FontSlant->"Plain"], ",", 
         StyleBox["j", "TI"]}], 
        StyleBox["v",
         FontSlant->"Plain"]], "\[RightBracketingBar]"}]}], ")"}]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3105148a-1b9a-4d06-a3cf-8885eb9fdf9f"],
 ", which ",
 StyleBox["t2link",
  FontFamily->"Source Code Pro"],
 " evaluates. The particle row of the lattice Dirac-Bogoliubov-de Gennes \
operator ",
