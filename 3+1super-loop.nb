                    RowBox[{
                    RowBox[{"3", " ", "+", " ", "j"}], ",", " ", 
                    RowBox[{"p", " ", "+", " ", "1"}], ",", " ", 
                    RowBox[{"q", " ", "+", " ", "1"}]}], "]"}], "]"}], ",", 
                    " ", 
                    RowBox[{"{", 
                    RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}], "}"}]}], ";",
                "\n", "     ", 
               RowBox[{"rr", " ", "=", " ", 
                RowBox[{
                 RowBox[{"t2spinGen", "[", 
