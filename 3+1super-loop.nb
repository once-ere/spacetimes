               FontSize->8],
              ImageSize->95], 
             PaneBox[Cell[TextData[{
               "the commutator ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  StyleBox["x",
                   FontWeight->"Bold",
                   FontSlant->"Plain"], 
                  StyleBox["y",
                   FontWeight->"Bold",
                   FontSlant->"Plain"], "-", 
                  StyleBox["y",
                   FontWeight->"Bold",
                   FontSlant->"Plain"], 
                  StyleBox["x",
                   FontWeight->"Bold",
                   FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "64760094-1b5e-4630-9501-6fd4d086ee0f"],
               " and the associator ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  RowBox[{"(", 
                   StyleBox[
                    RowBox[{"x", "y"}],
                    FontWeight->"Bold",
                    FontSlant->"Plain"], ")"}], 
                  StyleBox["z",
                   FontWeight->"Bold",
                   FontSlant->"Plain"], "-", 
                  StyleBox["x",
                   FontWeight->"Bold",
                   FontSlant->"Plain"], 
                  RowBox[{"(", 
                   StyleBox[
                    RowBox[{"y", "z"}],
                    FontWeight->"Bold",
                    FontSlant->"Plain"], ")"}]}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "26058989-03a1-4d3f-9068-102b5bb6cf6e"],
               
               " of bi-octonions (the same brackets of other elements are \
defined at their place: the bracket of an algebra ",
               Cell[BoxData[
                FormBox[
                 SubsuperscriptBox[
                  StyleBox["\[ScriptCapitalF]",
                   FontSlant->"Plain"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
                  StyleBox["A",
                   FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "efe34c32-6f55-408a-8b43-0e10ba65666a"],
               ", ",
               Cell[BoxData[
                FormBox[
                 SubsuperscriptBox[
                  StyleBox["\[ScriptCapitalF]",
                   FontSlant->"Plain"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
                  StyleBox["B",
                   FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "13d441bb-d4d1-41c1-8a60-d48e134c9390"],
               ", ",
               Cell[BoxData[
                FormBox[
                 SubsuperscriptBox[
                  StyleBox["\[ScriptCapitalF]",
                   FontSlant->"Plain"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
