Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"GS", "-", "4"}], ":", " ", "isospin"}], ",", " ", 
    RowBox[{
    "Lorentz", " ", "invariance", " ", "and", " ", "isospin", " ", 
     "covariance", " ", "of", " ", "the", " ", "pair", " ", "matrices"}], ",",
     " ", 
    RowBox[{
     RowBox[{"the", " ", "c"}], "-", 
     RowBox[{"number", " ", "spinor"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"t", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"t2tiso", "[", "i", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"k", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"t2kpair", "[", "i", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"isoOk", " ", "=", " ", 
     RowBox[{
      RowBox[{"And", " ", "@@", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"fro", "[", 
            RowBox[{
             RowBox[{"comm", "[", 
              RowBox[{
               RowBox[{"t", "[", 
                RowBox[{"[", "a", "]"}], "]"}], ",", " ", 
               RowBox[{"t", "[", 
                RowBox[{"[", "b", "]"}], "]"}]}], "]"}], " ", "-", " ", 
             RowBox[{"Sum", "[", 
              RowBox[{
               RowBox[{"I", " ", 
                RowBox[{"t2eps3", "[", 
                 RowBox[{"a", ",", " ", "b", ",", " ", "c"}], "]"}], " ", 
                RowBox[{"t", "[", 
                 RowBox[{"[", "c", "]"}], "]"}]}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"c", ",", " ", "3"}], "}"}]}], "]"}]}], "]"}], " ", "<",
            " ", "tol"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"a", ",", " ", "3"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"b", ",", " ", "3"}], "}"}]}], "]"}], "]"}]}], " ", "&&", 
      "\n", "   ", 
      RowBox[{"And", " ", "@@", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"fro", "[", 
             RowBox[{"comm", "[", 
              RowBox[{
               RowBox[{"t", "[", 
                RowBox[{"[", "a", "]"}], "]"}], ",", " ", 
               RowBox[{"t2lift4", "[", 
                RowBox[{"sj", "[", 
                 RowBox[{"[", "u", "]"}], "]"}], "]"}]}], "]"}], "]"}], " ", "<",
             " ", "tol"}], " ", "&&", " ", 
           RowBox[{
            RowBox[{"fro", "[", 
             RowBox[{"comm", "[", 
              RowBox[{
               RowBox[{"t", "[", 
                RowBox[{"[", "a", "]"}], "]"}], ",", " ", 
               RowBox[{"t2lift4", "[", 
                RowBox[{"sk", "[", 
                 RowBox[{"[", "u", "]"}], "]"}], "]"}]}], "]"}], "]"}], " ", "<",
             " ", "tol"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"a", ",", " ", "3"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"u", ",", " ", "3"}], "}"}]}], "]"}], "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"kkOk", " ", "=", " ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{"k", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"fro", "[", 
          RowBox[{"#", " ", "+", " ", 
           RowBox[{"Transpose", "[", "#", "]"}]}], "]"}], " ", "<", " ", 
         "tol"}], " ", "&"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"worst4", " ", "=", " ", "0."}], ";", " ", 
    RowBox[{"cnum", " ", "=", " ", "0."}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "mg", ",", " ", "s8", ",", " ", "th", ",", " ", "u2", ",", " ", "u8",
           ",", " ", "r", ",", " ", "psi"}], "}"}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{"mg", " ", "=", " ", 
          RowBox[{"t2randSL2C", "[", "]"}]}], ";", "\n", "   ", 
         RowBox[{"s8", " ", "=", " ", 
          RowBox[{"t2lift4", "[", 
           RowBox[{"t2spinRep", "[", "mg", "]"}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"th", " ", "=", " ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"3", " ", 
             RowBox[{"t2Unit", "[", "]"}]}], ",", " ", 
            RowBox[{"{", "3", "}"}]}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"u2", " ", "=", " ", 
          RowBox[{"t2su2", "[", "th", "]"}]}], ";", " ", 
         RowBox[{"u8", " ", "=", " ", 
          RowBox[{"t2lift2", "[", "u2", "]"}]}], ";", " ", 
         RowBox[{"r", " ", "=", " ", 
          RowBox[{"t2adjoint", "[", "u2", "]"}]}], ";", "\n", "   ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{"worst4", " ", "=", " ", 
            RowBox[{"Max", "[", 
             RowBox[{"worst4", ",", " ", 
              RowBox[{"fro", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Transpose", "[", "s8", "]"}], " ", ".", " ", 
                 RowBox[{"k", "[", 
                  RowBox[{"[", "a", "]"}], "]"}], " ", ".", " ", "s8"}], " ", 
                "-", " ", 
                RowBox[{"k", "[", 
                 RowBox[{"[", "a", "]"}], "]"}]}], "]"}], ",", "\n", "      ", 
              RowBox[{"fro", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Transpose", "[", "u8", "]"}], " ", ".", " ", 
                 RowBox[{"k", "[", 
                  RowBox[{"[", "a", "]"}], "]"}], " ", ".", " ", "u8"}], " ", 
                "-", " ", 
                RowBox[{"Sum", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"r", "[", 
                    RowBox[{"[", 
                    RowBox[{"a", ",", " ", "b"}], "]"}], "]"}], " ", 
                   RowBox[{"k", "[", 
                    RowBox[{"[", "b", "]"}], "]"}]}], ",", " ", 
                  RowBox[{"{", 
                   RowBox[{"b", ",", " ", "3"}], "}"}]}], "]"}]}], "]"}]}], 
             "]"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"a", ",", " ", "3"}], "}"}]}], "]"}], ";", "\n", "   ", 
         RowBox[{"psi", " ", "=", " ", 
          RowBox[{"t2RndVec", "[", "8", "]"}]}], ";", "\n", "   ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{"cnum", " ", "=", " ", 
            RowBox[{"Max", "[", 
             RowBox[{"cnum", ",", " ", 
              RowBox[{"Abs", "[", 
               RowBox[{"psi", " ", ".", " ", 
                RowBox[{"k", "[", 
                 RowBox[{"[", "a", "]"}], "]"}], " ", ".", " ", "psi"}], 
               "]"}]}], "]"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"a", ",", " ", "3"}], "}"}]}], "]"}]}]}], "]"}], ",", 
      "\n", "  ", 
      RowBox[{"{", "100", "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<GS-4\>\"", ",", 
     " ", "\"\<isospin T^iota obeys [T^a, T^b] = i eps T^c and commutes with \
the Lorentz generators; the pair matrices Kch_iota are antisymmetric, Lorentz \
invariant and an isospin vector (100 random gL and U); Psi^T Kch Psi = 0 for \
a c-number spinor (tolerance 1e-10)\>\"", ",", "\n", "  ", 
     RowBox[{"isoOk", " ", "&&", " ", "kkOk", " ", "&&", " ", 
      RowBox[{"worst4", " ", "<", " ", "1*^-10"}], " ", "&&", " ", 
      RowBox[{"cnum", " ", "<", " ", "1*^-12"}]}], ",", " ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<largest deviation \>\"", ",", " ", "worst4", ",", 
        " ", "\"\<; largest |Psi^T Kch Psi| \>\"", ",", " ", "cnum", ",", 
        " ", "\"\< (original: 5.2e-15; 3.0e-16)\>\""}], "}"}], "]"}]}], 
    "]"}]}]}]], "Input",
 CellLabel->
  "In[357]:=",ExpressionUUID->"ff5865fc-cc81-4a51-8e87-4d0b8d96bc16"],

