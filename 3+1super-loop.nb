Cell[CellGroupData[{

Cell["Case B: the uniform polar superfluid (checks AS-3 to AS-6)", \
"Subsection",ExpressionUUID->"d217168f-7a26-4606-ad64-f41998889a21"],

Cell[TextData[{
 StyleBox["The fields.",
  FontWeight->"Bold"],
 " No gauge fields, and a uniform pair field along the third isospin \
direction, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["d", "TI"], "\[RightVector]"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{"0", ",", "0", ",", 
      SubscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4bf220fd-f4f8-41f9-82b6-336503b2c595"],
 " with a real ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], ">", "0"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9c2f364e-136d-4d90-baa3-0e16b137ef91"],
 " (the polar state). Then ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["P",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cf98d9c3-0fe2-42f0-a2d3-164316d1a8ee"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["P",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Dagger]"], "\[LongEqual]", 
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "3"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4aa6b8f5-0e5a-4a23-a635-35dc2ee535a8"],
 ". The pair matrix is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "3"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["ch",
      FontSlant->"Plain"]], "\[CircleTimes]", 
    SubscriptBox[
     StyleBox["E",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Tau]", "3", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "610efa70-9f0f-4e29-ab0a-95759bbbb126"],
 ". With ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["ch",
      FontSlant->"Plain"]], "\[LongEqual]", 
    StyleBox["diag",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       SubscriptBox[
        StyleBox["E",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["LL",
         FontSlant->"Plain"]]}], ",", 
      RowBox[{"-", 
       SubscriptBox[
        StyleBox["E",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["LL",
         FontSlant->"Plain"]]}]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c720e15b-a298-46a1-9923-82e277500cb9"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["E",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Tau]", "3", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"-", 
     SubsuperscriptBox["\[Tau]", "1", 
      StyleBox["LL",
       FontSlant->"Plain"]]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "28c41f48-3176-4540-9894-b9bf3f5f4862"],
 " it is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "3"], "\[LongEqual]", 
    StyleBox["diag",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["E",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"]], ",", 
      SubscriptBox[
       StyleBox["E",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}], "\[CircleTimes]", 
    SubsuperscriptBox["\[Tau]", "1", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ce2b196b-15f7-43c6-baac-04c6642e2084"],
 ": a real matrix with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], 
     StyleBox["T", "TI"]], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"], "\[LongEqual]", 
    RowBox[{"-", 
     SubsuperscriptBox[
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], "3"]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fbcd6226-9194-4750-9fab-f91b1ce75b44"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], "2"], "\[LongEqual]", 
    RowBox[{"-", 
     SubscriptBox[
      StyleBox["1",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "8"]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "acfdc25c-559f-4c0c-a423-9f5f76750c23"],
 "."
}], "Text",ExpressionUUID->"620ec833-e978-45ef-9176-ce00741a1235"],

Cell[TextData[{
 StyleBox["The key identity.",
  FontWeight->"Bold"],
 " For the matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["h",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["q", "TI"], "\[RightVector]"], 
      StyleBox["LL",
       FontSlant->"Plain"]], ")"}], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", 
     StyleBox["j", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]], 
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]], "+", 
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c8a9ace3-962a-4e23-bb71-dc404c2862c9"],
 " of a plane wave,"
}], "Text",ExpressionUUID->"ef0dc9de-7b3d-4bfb-8feb-2a4c0ef11b3a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["h",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   RowBox[{"(", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["q", "TI"], "\[RightVector]"], 
     StyleBox["LL",
      FontSlant->"Plain"]], ")"}], "\[LongEqual]", 
   SubscriptBox[
    StyleBox["h",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", 
      SubscriptBox[
       OverscriptBox[
        StyleBox["q", "TI"], "\[RightVector]"], 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}], "*"], "\[ThinSpace]", 
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"]}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"69172f9d-3bcf-430c-bb2e-7656c9b0f023"],

Cell[TextData[{
 "Proof: with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]], "\[LongEqual]", 
    StyleBox["diag",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       SubsuperscriptBox["\[Sigma]", 
        StyleBox["j", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"]]}], ",", 
      SubsuperscriptBox["\[Sigma]", 
       StyleBox["j", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "90b43955-342b-4e5d-b23b-bfffdc7d6738"],
 ", the Dirac factor ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["diag",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["E",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"]], ",", 
      SubscriptBox[
       StyleBox["E",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1c7fea80-dc72-4fa7-b261-489dd2c6b079"],
 " of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b1d7b016-ec53-4b08-82ec-0f4b99cb894b"],
 ", and the relation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["E",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Sigma]", 
     StyleBox["j", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"-", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox["\[Sigma]", 
        StyleBox["j", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"]], ")"}], "*"]}], 
    SubscriptBox[
     StyleBox["E",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "590fd8cb-2d7f-4df4-b98a-1b86d6b03327"],
 " (for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["j", "TI"], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b37d70eb-1fd0-48ff-ba42-b291c41a3697"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["j", "TI"], "\[LongEqual]", "3"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "47e93879-2e74-47bf-be8b-2fff49c46c22"],
 " the Pauli matrix is real and anticommutes with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["E",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    StyleBox["i", "TI"], 
    SubsuperscriptBox["\[Sigma]", "2", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e02ac2d1-c614-4ab6-89a3-be4f89776358"],
 "; for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["j", "TI"], "\[LongEqual]", "2"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8c0b6f95-f553-43ff-928a-1c9bd0bad486"],
 " it is imaginary and commutes with it), one finds ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "3"], 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]], "\[LongEqual]", 
    RowBox[{"-", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox["\[Alpha]", 
        StyleBox["LL",
         FontSlant->"Plain"], 
        StyleBox["j", "TI"]], ")"}], "*"]}], 
    SubsuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "3"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b639597a-1b65-4687-a2e5-c7cf8fd7129a"],
 ". The matrix ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Beta]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ecbbfae4-58de-432a-b834-37c4bf73c9fe"],
 " is real and exchanges the two Weyl blocks, whose Dirac factors in ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ece680fb-7f34-44c5-b213-96b0f911b131"],
 " are equal, so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "3"], 
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "3"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ceaa7562-7fe1-4e1a-ad63-c09138d07ea3"],
 ". Inserted in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["h",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d095ae52-c577-4c4e-8df8-855dd3ceccb4"],
 ", the two relations give the identity. It holds on the lattice as well, \
where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["sin",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["j", "TI"]], 
      SubsuperscriptBox["\[ScriptL]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["x",
        FontSlant->"Plain"]]}], ")"}], "/", 
    SubsuperscriptBox["\[ScriptL]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["x",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "29b4dd8c-cf7f-45ad-9d3c-dd7422f354d7"],
 " (an odd function of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["q", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "145f6af5-e688-45a3-bb0d-c5222c4ba1d0"],
 ") stands in place of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["q", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ef121a93-3b66-48b9-8748-f3f7540b34a7"],
 " and the Wilson term (an even function) is added to the mass."
}], "Text",ExpressionUUID->"8f4ec4fd-73cc-461e-91af-053580ad854a"],

Cell[TextData[{
 StyleBox["The Bogoliubov modes.",
  FontWeight->"Bold"],
 " On plane waves the operator ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalH]",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["DB",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b4ae2ff7-c8f6-463a-8393-a45f2e163053"],
 " is a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"16", "\[Times]", "16"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f9b132ce-3705-47ac-a028-574f24501f2b"],
 " matrix with the blocks ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["h",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["q", "TI"], "\[RightVector]"], 
      StyleBox["LL",
       FontSlant->"Plain"]], ")"}], "-", 
    SubscriptBox["\[Mu]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a392bf0c-862f-4a9b-84b1-305fa92ddeb8"],
 " (upper left), ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e086414c-01ab-40d1-91b6-4956dfe3a6cf"],
 " (upper right), ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "3"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e63f8d9a-23f5-446b-ad13-06f2d8db6c4f"],
 " (lower left) and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["h",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", 
         SubscriptBox[
          OverscriptBox[
           StyleBox["q", "TI"], "\[RightVector]"], 
          StyleBox["LL",
           FontSlant->"Plain"]]}], ")"}], "*"], "-", 
      SubscriptBox["\[Mu]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d86dcef2-0791-434c-b259-a6b1ccb0f32e"],
 " (lower right), as in check GS-8. Let ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Chi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["pw",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f800efed-ea5c-4deb-998f-f0d09aa006a7"],
 " be a normalized eigenvector of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["h",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["q", "TI"], "\[RightVector]"], 
      StyleBox["LL",
       FontSlant->"Plain"]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "56870fbe-174c-413e-a5c0-14f06281962a"],
 " with the eigenvalue ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", 
    SubscriptBox["\[CurlyEpsilon]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "470e5fa6-4b9a-4892-aea1-88e315df792e"],
 " or ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SubscriptBox["\[CurlyEpsilon]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4e86a539-360c-43fa-bca8-7ab98dcf4312"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CurlyEpsilon]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["q", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], "2"], "+", 
       SubsuperscriptBox[
        StyleBox["m", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], "2"]}], ")"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "eef23b37-e7cf-453a-aaed-4b2e69b75c15"],
 ". By the key identity, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "3"], 
    SubsuperscriptBox["\[Chi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["pw",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "11dde624-1566-43ae-b381-9edb048ce0e1"],
 " is an eigenvector of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["h",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", 
       SubscriptBox[
        OverscriptBox[
         StyleBox["q", "TI"], "\[RightVector]"], 
        StyleBox["LL",
         FontSlant->"Plain"]]}], ")"}], "*"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "09387d16-5979-4946-92ef-27628aefff9f"],
 " with the same eigenvalue; and because ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"], 
    SubsuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "3"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "8"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d7ac5a8a-ae7d-4290-a7d6-60d735d7bceb"],
 ", the operator maps the two vectors ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubsuperscriptBox["\[Chi]", 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["pw",
       FontSlant->"Plain"]], ",", "0"}], ")"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bebc3b56-7bf6-4f05-a07e-4a99f540c712"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", 
     SubsuperscriptBox[
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], "3"], 
     SubsuperscriptBox["\[Chi]", 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["pw",
       FontSlant->"Plain"]]}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cb8553a1-e37d-41fb-b2aa-42559ba4282e"],
 " to combinations of the same two vectors, with the matrix"
}], "Text",ExpressionUUID->"249520a9-2df9-4320-a213-431e1ef4c89a"],

Cell[BoxData[
 FormBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {
      RowBox[{
       RowBox[{"\[PlusMinus]", 
        SubscriptBox["\[CurlyEpsilon]", 
         StyleBox["LL",
          FontSlant->"Plain"]]}], "-", 
       SubscriptBox["\[Mu]", 
        StyleBox["LL",
         FontSlant->"Plain"]]}], 
      SubscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"]]},
     {
      SubscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[PlusMinus]", 
          SubscriptBox["\[CurlyEpsilon]", 
           StyleBox["LL",
            FontSlant->"Plain"]]}], "-", 
         SubscriptBox["\[Mu]", 
          StyleBox["LL",
           FontSlant->"Plain"]]}], ")"}]}]}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"e26574e8-f4a2-4daa-a15a-36d02cc02066"],

Cell[TextData[{
 "The square of this matrix is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{"\[PlusMinus]", 
        SubscriptBox["\[CurlyEpsilon]", 
         StyleBox["LL",
          FontSlant->"Plain"]]}], "-", 
       SubscriptBox["\[Mu]", 
        StyleBox["LL",
         FontSlant->"Plain"]]}], ")"}], "2"], "+", 
    SubsuperscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4578ba7a-a5a5-4db8-9d53-d6be8f411f2e"],
 " times the unit matrix. Its eigenvalues are therefore ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    SubsuperscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "-"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4cee6555-f6b1-434a-bec6-50caed32a04b"],
 " for the upper sign (from the eigenvalue ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", 
    SubscriptBox["\[CurlyEpsilon]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0c31155c-5189-4117-ae56-8b7e5229f1e4"],
 ") and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    SubsuperscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "+"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "10482fe4-d553-401c-877e-101fae1ba193"],
 " for the lower sign (from ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SubscriptBox["\[CurlyEpsilon]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d3162238-2547-44ac-9609-4acf10f89d06"],
 "), with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[PlusMinus]"], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["\[CurlyEpsilon]", 
           StyleBox["LL",
            FontSlant->"Plain"]], "\[PlusMinus]", 
          SubscriptBox["\[Mu]", 
           StyleBox["LL",
            FontSlant->"Plain"]]}], ")"}], "2"], "+", 
       SubsuperscriptBox["\[CapitalDelta]", 
        StyleBox["LL",
         FontSlant->"Plain"], "2"]}], ")"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "853b59e5-4edc-49ad-b071-b9219ddc16b0"],
 ", each four times (the eigenvalue ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", 
    SubscriptBox["\[CurlyEpsilon]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "42c15573-1668-4efe-938c-e843061dc711"],
 " of the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"8", "\[Times]", "8"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c2c1f174-0e54-4aec-aded-447e2b7e522e"],
 " matrix ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["h",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e80e081d-67dd-46aa-9ed6-3f842f5c8a0a"],
 " has four eigenvectors, and so has ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SubscriptBox["\[CurlyEpsilon]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "723a9e6b-fcb4-4af7-a908-dbd3854514c0"],
 "). The eigenvector of the positive eigenvalue is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["cos",
      FontSlant->"Plain"], "\[ThinSpace]", 
     SubsuperscriptBox["\[CurlyTheta]", 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["B",
       FontSlant->"Plain"]], "\[ThinSpace]", 
     SubsuperscriptBox["\[Chi]", 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["pw",
       FontSlant->"Plain"]], ",", " ", 
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", 
     SubsuperscriptBox["\[CurlyTheta]", 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["B",
       FontSlant->"Plain"]], "\[ThinSpace]", 
     SubsuperscriptBox[
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], "3"], 
     SubsuperscriptBox["\[Chi]", 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["pw",
       FontSlant->"Plain"]]}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3241cf57-160d-4535-a89d-2426937d0552"],
 " with the Bogoliubov angle ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CurlyTheta]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["B",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ef807fd0-9ead-4030-a48c-f0c1ae28b3bf"],
 " given by"
}], "Text",ExpressionUUID->"990bd259-b2de-469c-aaea-7d13c8e61e85"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox[
    StyleBox["cos",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   SubsuperscriptBox["\[CurlyTheta]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["B",
     FontSlant->"Plain"]], "\[LongEqual]", 
   FractionBox["1", "2"], 
   RowBox[{"(", 
    RowBox[{"1", "+", 
     FractionBox[
      RowBox[{
       RowBox[{"\[PlusMinus]", 
        SubscriptBox["\[CurlyEpsilon]", 
         StyleBox["LL",
          FontSlant->"Plain"]]}], "-", 
       SubscriptBox["\[Mu]", 
        StyleBox["LL",
         FontSlant->"Plain"]]}], 
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "\[MinusPlus]"]]}], ")"}], ",", "      ", 
   SuperscriptBox[
    StyleBox["sin",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   SubsuperscriptBox["\[CurlyTheta]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["B",
     FontSlant->"Plain"]], "\[LongEqual]", 
   FractionBox["1", "2"], 
   RowBox[{"(", 
    RowBox[{"1", "-", 
     FractionBox[
      RowBox[{
       RowBox[{"\[PlusMinus]", 
        SubscriptBox["\[CurlyEpsilon]", 
         StyleBox["LL",
          FontSlant->"Plain"]]}], "-", 
       SubscriptBox["\[Mu]", 
        StyleBox["LL",
         FontSlant->"Plain"]]}], 
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "\[MinusPlus]"]]}], ")"}]}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"c02e0e54-31ee-49c0-97d6-70756f574829"],

Cell[TextData[{
 "(inserted in the matrix, the first row gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["tan",
     FontSlant->"Plain"], "\[ThinSpace]", 
    SubsuperscriptBox["\[CurlyTheta]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["B",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "\[MinusPlus]"], "-", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[PlusMinus]", 
         SubscriptBox["\[CurlyEpsilon]", 
          StyleBox["LL",
           FontSlant->"Plain"]]}], "-", 
        SubscriptBox["\[Mu]", 
         StyleBox["LL",
          FontSlant->"Plain"]]}], ")"}]}], ")"}], "/", 
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ec0979a1-0f93-408f-81d7-766a76d66c0f"],
 " and the second ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["tan",
     FontSlant->"Plain"], "\[ThinSpace]", 
    SubsuperscriptBox["\[CurlyTheta]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["B",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "/", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "\[MinusPlus]"], "+", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[PlusMinus]", 
         SubscriptBox["\[CurlyEpsilon]", 
          StyleBox["LL",
           FontSlant->"Plain"]]}], "-", 
        SubscriptBox["\[Mu]", 
         StyleBox["LL",
          FontSlant->"Plain"]]}], ")"}]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "62147ba6-e593-4595-9ada-9dbc31c46300"],
 ", and the two agree because ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "\[MinusPlus]"], ")"}], "2"], "-", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{"\[PlusMinus]", 
        SubscriptBox["\[CurlyEpsilon]", 
         StyleBox["LL",
          FontSlant->"Plain"]]}], "-", 
       SubscriptBox["\[Mu]", 
        StyleBox["LL",
         FontSlant->"Plain"]]}], ")"}], "2"], "\[LongEqual]", 
    SubsuperscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "006f8144-44c6-491b-8b01-34656c66baec"],
 "). These modes are the quasi-particles of the superfluid: superpositions of \
a particle and a hole with the weights ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["cos",
      FontSlant->"Plain"], "2"], "\[ThinSpace]", 
    SubsuperscriptBox["\[CurlyTheta]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["B",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b99620a8-109c-471f-905c-bafb303432f4"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["sin",
      FontSlant->"Plain"], "2"], "\[ThinSpace]", 
    SubsuperscriptBox["\[CurlyTheta]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["B",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "23b0a2f2-bea6-4941-8bac-4a93c213c02d"],
 ". The branch ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "-"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3c5a9a6e-0e9e-4135-84dc-b8b0ff8e550c"],
 " has its minimum ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalDelta]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2792b48f-c4c1-44dc-be19-dd13d8b981f1"],
 " at the Fermi momentum ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["k", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["F",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d2de80e9-3c13-4521-8c97-335ddb1a7c70"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CurlyEpsilon]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubscriptBox["\[Mu]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4b6177f6-6db5-4509-a747-20e5686d688c"],
 ": ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalDelta]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6530d1c4-3fdd-4732-85b8-1e063ef818f9"],
 " is the energy gap of the superfluid. The branch ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "+"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9883c94a-3a47-468b-acf3-71e9cb36962f"],
 " belongs to the states of negative energy (the antiparticles). Check AS-3 \
verifies the key identity, the eigenvectors and their energies for 50 random \
momenta, chemical potentials and gaps, and then the 16 eigenvalues of the \
lattice operator on the plane wave of every allowed momentum of a ring of 32 \
sites (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[ScriptL]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["x",
      FontSlant->"Plain"]], "\[LongEqual]", "0.5"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3edf68fb-eff2-4653-93b1-ae7440a4e252"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0.4"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "08a064d6-68a9-410b-a049-dd7bce29cecc"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Mu]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0.6"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c424031c-5f29-4b3e-b508-a0798f19dc1b"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0.3"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "58e153e5-4ab0-4273-98fd-2641af1498b4"],
 "), where ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CurlyEpsilon]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["lat",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "710e6e9f-c123-47e4-89ed-7ae9ffb67773"],
 " stands in place of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CurlyEpsilon]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c05316c6-4341-4563-b6ec-7b62fc1ec24a"],
 " (Figure 4(a))."
}], "Text",ExpressionUUID->"d318e433-baf2-4d9c-a6c3-2b7e2a15dee4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"AS", "-", "3"}], ",", " ", 
    RowBox[{"the", " ", 
     RowBox[{"continuum", ":", " ", 
      RowBox[{"50", " ", "random", " ", "momenta"}]}]}], ",", " ", 
    RowBox[{"chemical", " ", "potentials", " ", "and", " ", "gaps", " ", 
     RowBox[{"(", 
      RowBox[{
      "the", " ", "random", " ", "numbers", " ", "in", " ", "the", " ", 
       "order", " ", "of", " ", "t2_analytic"}], ")"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"as3Dev", " ", "=", " ", "0."}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "q", ",", " ", "chem", ",", " ", "gap", ",", " ", "hq8", ",", " ", 
          "hmqc", ",", " ", "pair", ",", " ", "hbdg", ",", " ", "ev", ",", 
          " ", "vecs", ",", " ", "energy"}], "}"}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{"q", " ", "=", " ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"2.", " ", 
             RowBox[{"t2Unit", "[", "]"}]}], ",", " ", 
            RowBox[{"{", "3", "}"}]}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"chem", " ", "=", " ", 
          RowBox[{"Abs", "[", 
           RowBox[{"t2Unit", "[", "]"}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"gap", " ", "=", " ", 
          RowBox[{"0.1", " ", "+", " ", 
           RowBox[{"0.9", " ", 
            RowBox[{"Abs", "[", 
             RowBox[{"t2Unit", "[", "]"}], "]"}]}]}]}], ";", "\n", "   ", 
         RowBox[{"hq8", " ", "=", " ", 
          RowBox[{"t2h8", "[", 
           RowBox[{"q", ",", " ", "mass"}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"hmqc", " ", "=", " ", 
          RowBox[{"Conjugate", "[", 
           RowBox[{"t2h8", "[", 
            RowBox[{
             RowBox[{"-", "q"}], ",", " ", "mass"}], "]"}], "]"}]}], ";", 
         "\n", "   ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{"the", " ", "identity", " ", 
            RowBox[{"K", "^", "3"}], " ", "h", 
            RowBox[{"(", "q", ")"}]}], " ", "=", " ", 
           RowBox[{"conj", 
            RowBox[{"(", 
             RowBox[{"h", 
              RowBox[{"(", 
               RowBox[{"-", "q"}], ")"}]}], ")"}], " ", 
            RowBox[{"K", "^", "3"}]}]}], " ", "*)"}], "\n", "   ", 
         RowBox[{"as3Dev", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"as3Dev", ",", " ", 
            RowBox[{"fro", "[", 
             RowBox[{
              RowBox[{"asK3", " ", ".", " ", "hq8"}], " ", "-", " ", 
              RowBox[{"hmqc", " ", ".", " ", "asK3"}]}], "]"}]}], "]"}]}], ";",
          "\n", "   ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{"H_BdG", 
            RowBox[{"(", "q", ")"}]}], " ", "=", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"[", 
              RowBox[{
               RowBox[{"[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"h", 
                   RowBox[{"(", "q", ")"}]}], " ", "-", " ", "mu"}], ",", " ",
                  "P"}], "]"}], ",", " ", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"P", "^", "dag"}], ",", " ", 
                 RowBox[{"-", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"conj", 
                    RowBox[{"(", 
                    RowBox[{"h", 
                    RowBox[{"(", 
                    RowBox[{"-", "q"}], ")"}]}], ")"}]}], " ", "-", " ", 
                    "mu"}], ")"}]}]}], "]"}]}], "]"}], " ", "with", " ", 
             "P"}], " ", "=", " ", 
            RowBox[{"Delta", " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"K", "^", "3"}], ")"}], "^", "dag"}]}]}]}], " ", 
          "*)"}], "\n", "   ", 
         RowBox[{"pair", " ", "=", " ", 
          RowBox[{"t2pairPotential", "[", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0", ",", " ", "gap"}], "}"}], "]"}]}], ";",
          "\n", "   ", 
         RowBox[{"hbdg", " ", "=", " ", 
          RowBox[{"ArrayFlatten", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"hq8", " ", "-", " ", 
                RowBox[{"chem", " ", 
                 RowBox[{"IdentityMatrix", "[", "8", "]"}]}]}], ",", " ", 
               "pair"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"ConjugateTranspose", "[", "pair", "]"}], ",", " ", 
               RowBox[{"-", 
                RowBox[{"(", 
                 RowBox[{"hmqc", " ", "-", " ", 
                  RowBox[{"chem", " ", 
                   RowBox[{"IdentityMatrix", "[", "8", "]"}]}]}], ")"}]}]}], 
              "}"}]}], "}"}], "]"}]}], ";", "\n", "   ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ev", ",", " ", "vecs"}], "}"}], " ", "=", " ", 
          RowBox[{"t2eigh", "[", "hq8", "]"}]}], ";", "\n", "   ", 
         RowBox[{"energy", " ", "=", " ", 
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{"q", " ", ".", " ", "q"}], " ", "+", " ", 
            RowBox[{"mass", "^", "2"}]}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{
            RowBox[{
            "the", " ", "eigenvector", " ", "number", " ", "8", " ", "has", " ",
              "the", " ", "eigenvalue"}], " ", "+", "eps"}], ",", " ", 
           RowBox[{
            RowBox[{
            "the", " ", "number", " ", "1", " ", "the", " ", "eigenvalue"}], 
            " ", "-", "eps"}]}], " ", "*)"}], "\n", "   ", 
         RowBox[{"Do", "[", "\n", "    ", 
          RowBox[{
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"col", " ", "=", " ", 
                RowBox[{"colSign", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
               RowBox[{"sg", " ", "=", " ", 
                RowBox[{"colSign", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", "chi", ",", " ", 
               "kchi", ",", " ", "xe", ",", " ", "e16", ",", " ", "cth", ",", 
               " ", "sth", ",", " ", "v16", ",", " ", "target"}], "}"}], ",", 
             "\n", "     ", 
             RowBox[{
              RowBox[{"as3Dev", " ", "=", " ", 
               RowBox[{"Max", "[", 
                RowBox[{"as3Dev", ",", " ", 
                 RowBox[{"Abs", "[", 
                  RowBox[{
                   RowBox[{"ev", "[", 
                    RowBox[{"[", "col", "]"}], "]"}], " ", "-", " ", 
                   RowBox[{"sg", " ", "energy"}]}], "]"}]}], "]"}]}], ";", 
              "\n", "     ", 
              RowBox[{"chi", " ", "=", " ", 
               RowBox[{"vecs", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", " ", "col"}], "]"}], "]"}]}], ";", "\n", 
              "     ", 
              RowBox[{"kchi", " ", "=", " ", 
               RowBox[{"asK3", " ", ".", " ", "chi"}]}], ";", "\n", "     ", 
              RowBox[{"xe", " ", "=", " ", 
               RowBox[{
                RowBox[{"sg", " ", "energy"}], " ", "-", " ", "chem"}]}], ";",
               "\n", "     ", 
              RowBox[{"e16", " ", "=", " ", 
               RowBox[{"Sqrt", "[", 
                RowBox[{
                 RowBox[{"xe", "^", "2"}], " ", "+", " ", 
                 RowBox[{"gap", "^", "2"}]}], "]"}]}], ";", "\n", "     ", 
              RowBox[{"(*", " ", 
               RowBox[{
               "cos", " ", "theta_B", " ", "and", " ", "sin", " ", 
                "theta_B"}], " ", "*)"}], "\n", "     ", 
              RowBox[{"cth", " ", "=", " ", 
               RowBox[{"Sqrt", "[", 
                RowBox[{"0.5", " ", 
                 RowBox[{"(", 
                  RowBox[{"1", " ", "+", " ", 
                   RowBox[{"xe", "/", "e16"}]}], ")"}]}], "]"}]}], ";", " ", 
              RowBox[{"sth", " ", "=", " ", 
               RowBox[{"Sqrt", "[", 
                RowBox[{"0.5", " ", 
                 RowBox[{"(", 
                  RowBox[{"1", " ", "-", " ", 
                   RowBox[{"xe", "/", "e16"}]}], ")"}]}], "]"}]}], ";", "\n", 
              "     ", 
              RowBox[{"v16", " ", "=", " ", 
               RowBox[{"Join", "[", 
                RowBox[{
                 RowBox[{"cth", " ", "chi"}], ",", " ", 
                 RowBox[{"sth", " ", "kchi"}]}], "]"}]}], ";", "\n", "     ", 
              
              RowBox[{"as3Dev", " ", "=", " ", 
               RowBox[{"Max", "[", 
                RowBox[{"as3Dev", ",", " ", 
                 RowBox[{"Norm", "[", 
                  RowBox[{
                   RowBox[{"hbdg", " ", ".", " ", "v16"}], " ", "-", " ", 
                   RowBox[{"e16", " ", "v16"}]}], "]"}]}], "]"}]}], ";", "\n",
               "     ", 
              RowBox[{"target", " ", "=", " ", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"sg", " ", ">", " ", "0"}], ",", " ", 
                 RowBox[{"Sqrt", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"energy", " ", "-", " ", "chem"}], ")"}], "^", 
                    "2"}], " ", "+", " ", 
                   RowBox[{"gap", "^", "2"}]}], "]"}], ",", " ", 
                 RowBox[{"Sqrt", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"energy", " ", "+", " ", "chem"}], ")"}], "^", 
                    "2"}], " ", "+", " ", 
                   RowBox[{"gap", "^", "2"}]}], "]"}]}], "]"}]}], ";", "\n", 
              "     ", 
              RowBox[{"as3Dev", " ", "=", " ", 
               RowBox[{"Max", "[", 
                RowBox[{"as3Dev", ",", " ", 
                 RowBox[{"Abs", "[", 
                  RowBox[{"e16", " ", "-", " ", "target"}], "]"}]}], 
                "]"}]}]}]}], "]"}], ",", "\n", "    ", 
           RowBox[{"{", 
            RowBox[{"colSign", ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"8", ",", " ", "1."}], "}"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"1", ",", " ", 
                 RowBox[{"-", "1."}]}], "}"}]}], "}"}]}], "}"}]}], "]"}]}]}], 
       "]"}], ",", "\n", "  ", 
      RowBox[{"{", "50", "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", 
      RowBox[{"lattice", ":", " ", 
       RowBox[{"the", " ", "parameters", " ", "of", " ", "case", " ", "B", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"the", " ", "spacing"}], ",", " ", 
          RowBox[{"the", " ", "chemical", " ", "potential"}], ",", " ", 
          RowBox[{"the", " ", "gap"}]}], ")"}]}]}]}], ",", " ", 
     RowBox[{
     "a", " ", "chain", " ", "of", " ", "32", " ", "sites", " ", "with", " ", 
      "the", "\n", "   ", "uniform", " ", "pair", " ", "field", " ", 
      RowBox[{"(", 
       RowBox[{"0", ",", " ", "0", ",", " ", "Delta"}], ")"}]}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"asBEll", ",", " ", "asBMu", ",", " ", "asBDelta"}], "}"}], " ",
      "=", " ", 
     RowBox[{"{", 
      RowBox[{"0.5", ",", " ", "0.6", ",", " ", "0.3"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as3N", " ", "=", " ", "32"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as3Lat", " ", "=", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<n\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"as3N", ",", " ", "1", ",", " ", "1"}], "}"}]}], ",", " ", 
       RowBox[{"\"\<ell\>\"", " ", "->", " ", "asBEll"}], ",", " ", 
       RowBox[{"\"\<periodic\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"True", ",", " ", "False", ",", " ", "False"}], "}"}]}], ",",
        " ", 
       RowBox[{"\"\<wilson\>\"", " ", "->", " ", "1.0"}], ",", " ", 
       RowBox[{"\"\<mass\>\"", " ", "->", " ", "mass"}], ",", " ", 
       RowBox[{"\"\<mu\>\"", " ", "->", " ", "asBMu"}]}], "|>"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as3Fields", " ", "=", " ", 
     RowBox[{"t2trivialFields", "[", "as3N", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"as3Fields", "[", 
        RowBox[{"[", 
         RowBox[{"\"\<d\>\"", ",", " ", "site"}], "]"}], "]"}], " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{"0.", ",", " ", "0.", ",", " ", "asBDelta"}], "}"}]}], ",", 
      " ", 
      RowBox[{"{", 
       RowBox[{"site", ",", " ", "as3N"}], "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as3DevLat", " ", "=", " ", "0."}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"the", " ", "rows", " ", 
       RowBox[{"{", 
        RowBox[{"q", ",", " ", "E_qp"}], "}"}], " ", "of", " ", "the", " ", 
       "points", " ", "of", " ", "Figure", " ", "4", 
       RowBox[{"(", "a", ")"}]}], ":", " ", 
      RowBox[{"the", " ", "positive", " ", "eigenvalues"}]}], ",", " ", 
     RowBox[{
     "in", " ", "ascending", " ", "order", " ", "for", " ", "every", " ", 
      "momentum"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"as3LatticeRows", " ", "=", " ", 
     RowBox[{"{", "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"q", " ", "=", " ", 
           RowBox[{"t2chainMomentum", "[", 
            RowBox[{"kq", ",", " ", "as3N", ",", " ", "asBEll"}], "]"}]}], ",",
           " ", "ev", ",", " ", "el", ",", " ", "em", ",", " ", "ep", ",", 
          " ", "ex"}], "}"}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{"ev", " ", "=", " ", 
          RowBox[{"First", "[", 
           RowBox[{"t2eigh", "[", 
            RowBox[{"t2planeMatrix", "[", 
             RowBox[{"as3Lat", ",", " ", "as3Fields", ",", " ", "q"}], "]"}], 
            "]"}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"el", " ", "=", " ", 
          RowBox[{"t2epsLat", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"q", ",", " ", "0.", ",", " ", "0."}], "}"}], ",", " ", 
            "asBEll", ",", " ", "mass", ",", " ", "1.0", ",", " ", 
            "asChainActive"}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"em", " ", "=", " ", 
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"el", " ", "-", " ", "asBMu"}], ")"}], "^", "2"}], " ", 
            "+", " ", 
            RowBox[{"asBDelta", "^", "2"}]}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"ep", " ", "=", " ", 
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"el", " ", "+", " ", "asBMu"}], ")"}], "^", "2"}], " ", 
            "+", " ", 
            RowBox[{"asBDelta", "^", "2"}]}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"ex", " ", "=", " ", 
          RowBox[{"Sort", "[", 
           RowBox[{"Flatten", "[", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"em", ",", " ", 
                RowBox[{"-", "em"}], ",", " ", "ep", ",", " ", 
                RowBox[{"-", "ep"}]}], "}"}], ",", " ", 
              RowBox[{"{", "4", "}"}]}], "]"}], "]"}], "]"}]}], ";", "\n", 
         "   ", 
         RowBox[{"as3DevLat", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"as3DevLat", ",", " ", 
            RowBox[{"Max", "[", 
             RowBox[{"Abs", "[", 
              RowBox[{"ev", " ", "-", " ", "ex"}], "]"}], "]"}]}], "]"}]}], ";",
          "\n", "   ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"ev", "[", 
               RowBox[{"[", "i", "]"}], "]"}], " ", ">", " ", "0"}], ",", " ", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"as3LatticeRows", ",", " ", 
               RowBox[{"{", 
                RowBox[{"q", ",", " ", 
                 RowBox[{"ev", "[", 
                  RowBox[{"[", "i", "]"}], "]"}]}], "}"}]}], "]"}]}], "]"}], ",",
            " ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "16"}], "}"}]}], "]"}]}]}], "]"}], ",", 
      "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"kq", ",", " ", "0", ",", " ", 
        RowBox[{"as3N", " ", "-", " ", "1"}]}], "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", "rows", " ", 
      RowBox[{"{", 
       RowBox[{"q", ",", " ", "eps_lat", ",", " ", 
        RowBox[{"E", "^", "-"}], ",", " ", 
        RowBox[{"E", "^", "+"}]}], "}"}], " ", "of", " ", "the", " ", 
      "curves", " ", "of", " ", "Figure", " ", "4", 
      RowBox[{"(", "a", ")"}]}], ",", " ", 
     RowBox[{"on", " ", "401", " ", "momenta"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"as3CurveRows", " ", "=", " ", 
     RowBox[{"Table", "[", "\n", "   ", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"q", " ", "=", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "Pi"}], "/", "asBEll"}], " ", "+", " ", 
            RowBox[{"2", " ", 
             RowBox[{"Pi", "/", "asBEll"}], " ", 
             RowBox[{"i", "/", "400."}]}]}]}], "}"}], ",", "\n", "    ", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"el", " ", "=", " ", 
             RowBox[{"t2epsLat", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"q", ",", " ", "0.", ",", " ", "0."}], "}"}], ",", 
               " ", "asBEll", ",", " ", "mass", ",", " ", "1.0", ",", " ", 
               "asChainActive"}], "]"}]}], "}"}], ",", "\n", "     ", 
           RowBox[{"{", 
            RowBox[{"q", ",", " ", "el", ",", " ", 
             RowBox[{"Sqrt", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"el", " ", "-", " ", "asBMu"}], ")"}], "^", "2"}], 
               " ", "+", " ", 
               RowBox[{"asBDelta", "^", "2"}]}], "]"}], ",", " ", 
             RowBox[{"Sqrt", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"el", " ", "+", " ", "asBMu"}], ")"}], "^", "2"}], 
               " ", "+", " ", 
               RowBox[{"asBDelta", "^", "2"}]}], "]"}]}], "}"}]}], "]"}]}], 
        "]"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "0", ",", " ", "400"}], "}"}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<AS-3\>\"", ",", 
     " ", "\"\<the Bogoliubov modes of the uniform polar superfluid dvec = \
(0, 0, Delta) (case B): Kch_3 h(q) = conj(h(-q)) Kch_3, so that for an \
eigenvector chi_pw of h(q) with the energy +eps or -eps the hole vector Kch_3 \
chi_pw is an eigenvector of conj(h(-q)) with the same energy; Ppair = Delta \
Kch_3^dag couples (chi_pw, 0) only to (0, Kch_3 chi_pw), and (cos theta_B \
chi_pw, sin theta_B Kch_3 chi_pw) with cos^2 theta_B = (1 + (+-eps - \
mu)/E)/2, sin^2 theta_B = (1 - (+-eps - mu)/E)/2, E = ((+-eps - mu)^2 + \
Delta^2)^(1/2), is an eigenvector of H_BdG(q) with the energy E, which is E^- \
for the positive branch +eps and E^+ for the negative branch -eps (50 random \
momenta, chemical potentials and gaps, m = 0.4; tolerance 1e-12); on the \
lattice (periodic chain of 32 sites, dx = 0.5, r_W = 1, m = 0.4, mu = 0.6, \
Delta = 0.3) the 16 eigenvalues of the lattice operator on the plane wave of \
each allowed momentum are +-E^- and +-E^+ with eps_lat in place of eps, each \
four times (tolerance 1e-12)\>\"", ",", "\n", "  ", 
     RowBox[{
      RowBox[{"as3Dev", " ", "<", " ", "1*^-12"}], " ", "&&", " ", 
      RowBox[{"as3DevLat", " ", "<", " ", "1*^-12"}]}], ",", "\n", "  ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<largest deviations \>\"", ",", " ", 
        RowBox[{"asSci", "[", "as3Dev", "]"}], ",", 
        " ", "\"\< (continuum), \>\"", ",", " ", 
        RowBox[{"asSci", "[", "as3DevLat", "]"}], ",", 
        " ", "\"\< (lattice) (original: 6.7e-15, 1.2e-14)\>\""}], "}"}], 
      "]"}]}], "]"}]}]}]], "Input",
 CellLabel->
  "In[676]:=",ExpressionUUID->"7b15dc14-77f3-4a06-92b2-7fa006abc7b9"],

Cell[BoxData[
 StyleBox[
  TemplateBox[{
    StyleBox["\"PASS  \"", Bold, 
     RGBColor[0, 
      Rational[2, 3], 0], StripOnInput -> False], "\"AS-3: \"", 
    "\"the Bogoliubov modes of the uniform polar superfluid dvec = (0, 0, \
Delta) (case B): Kch_3 h(q) = conj(h(-q)) Kch_3, so that for an eigenvector \
chi_pw of h(q) with the energy +eps or -eps the hole vector Kch_3 chi_pw is \
an eigenvector of conj(h(-q)) with the same energy; Ppair = Delta Kch_3^dag \
couples (chi_pw, 0) only to (0, Kch_3 chi_pw), and (cos theta_B chi_pw, sin \
theta_B Kch_3 chi_pw) with cos^2 theta_B = (1 + (+-eps - mu)/E)/2, sin^2 \
theta_B = (1 - (+-eps - mu)/E)/2, E = ((+-eps - mu)^2 + Delta^2)^(1/2), is an \
eigenvector of H_BdG(q) with the energy E, which is E^- for the positive \
branch +eps and E^+ for the negative branch -eps (50 random momenta, chemical \
potentials and gaps, m = 0.4; tolerance 1e-12); on the lattice (periodic \
chain of 32 sites, dx = 0.5, r_W = 1, m = 0.4, mu = 0.6, Delta = 0.3) the 16 \
eigenvalues of the lattice operator on the plane wave of each allowed \
momentum are +-E^- and +-E^+ with eps_lat in place of eps, each four times \
(tolerance 1e-12)\"", 
    "\"  -- largest deviations 6.4e-15 (continuum), 1.2e-14 (lattice) \
(original: 6.7e-15, 1.2e-14)\""},
   "RowDefault"],
  StripOnInput->False,
  LineIndent->0]], "Print",
 CellChangeTimes->{4.004025508182342*^9},
 CellLabel->
  "During evaluation of \
In[676]:=",ExpressionUUID->"323389ef-7c16-45a1-b677-2557db74ae87"]
}, Open  ]],

Cell[TextData[{
 StyleBox["A particle injected into the superfluid oscillates into a hole \
(check AS-4).",
  FontWeight->"Bold"],
 " Start with the particle ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubsuperscriptBox["\[Chi]", 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["pw",
       FontSlant->"Plain"]], ",", "0"}], ")"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f201f773-fda3-43f6-9848-e12b3864a9b0"],
 " of the positive energy ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CurlyEpsilon]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e7282220-751c-4d25-b6a8-03ecfe412811"],
 ". Its evolution stays in the plane of the two vectors ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubsuperscriptBox["\[Chi]", 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["pw",
       FontSlant->"Plain"]], ",", "0"}], ")"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a3744e66-d3d5-4eec-a0f9-c85b3c277021"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", 
     SubsuperscriptBox[
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], "3"], 
     SubsuperscriptBox["\[Chi]", 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["pw",
       FontSlant->"Plain"]]}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7e460c75-663b-4c08-ad7f-052f4aff29eb"],
 ", in which the operator is the matrix displayed above with the upper sign. \
The square of that matrix is ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["E", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], "-"], ")"}], "2"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5236c8c5-8ae2-4627-9d84-d0638745ed09"],
 " times the unit matrix, so its exponential with the factor ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     StyleBox["i", "TI"]}], 
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "0"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b81d7681-2a7f-4382-aefc-2753089d6922"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["cos",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "-"], 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "0"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bfda4bb9-c31e-43c9-90e7-1823e4e1d779"],
 " times the unit matrix minus ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["i", "TI"], "\[ThinSpace]", 
    StyleBox["sin",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "-"], 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "0"]}], ")"}], "/", 
    SubsuperscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "-"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f5ed1007-d85a-49b5-badb-8a8161e06f8e"],
 " times the matrix itself, and the mode is"
}], "Text",ExpressionUUID->"52fabdbb-6da1-49bb-bc80-eb1d912a4e70"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["\[Psi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p",
     FontSlant->"Plain"]], "\[LongEqual]", 
   RowBox[{"(", 
    RowBox[{
     StyleBox["cos",
      FontSlant->"Plain"], 
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["E", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], "-"], 
       SubsuperscriptBox[
        StyleBox["x", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], "0"]}], ")"}], "-", 
     StyleBox["i", "TI"], "\[ThinSpace]", 
     FractionBox[
      RowBox[{
       SubscriptBox["\[CurlyEpsilon]", 
        StyleBox["LL",
         FontSlant->"Plain"]], "-", 
       SubscriptBox["\[Mu]", 
        StyleBox["LL",
         FontSlant->"Plain"]]}], 
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "-"]], "\[ThinSpace]", 
     StyleBox["sin",
      FontSlant->"Plain"], 
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["E", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], "-"], 
       SubsuperscriptBox[
        StyleBox["x", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], "0"]}], ")"}]}], ")"}], 
   SubsuperscriptBox["\[Chi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["pw",
     FontSlant->"Plain"]]}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"a3329bc8-95d3-4d64-9213-cc5e07f57556"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["\[Psi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["h",
     FontSlant->"Plain"]], "\[LongEqual]", 
   RowBox[{"-", 
    StyleBox["i", "TI"]}], "\[ThinSpace]", 
   FractionBox[
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "-"]], "\[ThinSpace]", 
