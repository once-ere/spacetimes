     FontSlant->"Plain"]], 
   RowBox[{"(", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["s", "TI"], "\[RightVector]"], 
     StyleBox["LL",
      FontSlant->"Plain"]], ")"}], "+", 
   SubscriptBox[
    StyleBox["P",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   RowBox[{"(", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["s", "TI"], "\[RightVector]"], 
     StyleBox["LL",
      FontSlant->"Plain"]], ")"}], 
   SubsuperscriptBox["\[Psi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["h",
     FontSlant->"Plain"]], 
   RowBox[{"(", 
    SubscriptBox[
     OverscriptBox[
