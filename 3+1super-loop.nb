              SubsuperscriptBox[
               StyleBox["T", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], "\[Iota]"], "+", 
              SubsuperscriptBox[
               StyleBox["g", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["F",
                FontSlant->"Plain"]], 
              SubsuperscriptBox[
               StyleBox["A", "TI"], 
