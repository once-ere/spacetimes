       DefaultBaseStyle->"Column",
       GridBoxAlignment->{"Columns" -> {{Left}}},
       GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
      "Column"]},
    {
     TagBox[GridBox[{
        {
         StyleBox["\<\"5 The manifolds\"\>",
          StripOnInput->False,
          FontSize->12,
          FontWeight->Bold]},
        {
         TagBox[GridBox[{
            {
             StyleBox["\<\"symbol\"\>",
              StripOnInput->False,
              FontFamily->"Source Sans Pro",
              FontWeight->Bold], 
             StyleBox["\<\"plain-text names\"\>",
              StripOnInput->False,
              FontFamily->"Source Sans Pro",
              FontWeight->Bold], 
             StyleBox["\<\"meaning\"\>",
              StripOnInput->False,
              FontFamily->"Source Sans Pro",
              FontWeight->Bold]},
