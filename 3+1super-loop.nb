Cell[CellGroupData[{

Cell["GS-16: the lattice operator on plane waves", "Subsection",ExpressionUUID->"580c6eb9-c6e0-42cb-909b-342b25220eae"],

Cell[TextData[{
 "On a periodic chain of 24 sites along ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "1"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e3a52149-9111-4bac-8096-09926c69c154"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[ScriptL]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["x",
      FontSlant->"Plain"]], "\[LongEqual]", "0.5"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9f80301f-81ca-4c56-b5c6-62c3300089eb"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0.4"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a7798aee-6fa9-4573-8f78-37f7d028ee7a"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Mu]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0afa5065-b64b-4f09-adb4-98d564d40b6f"],
 ", no gauge fields, no pairing) the lattice operator ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalH]",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["lat",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8f41f9d6-08fe-4e98-b703-60afe5a1afe0"],
 " of the solvers maps a plane wave, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["exp",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["i", "TI"], 
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "1"], 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "1"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0b8b5b41-10f3-43cd-8577-d3a7e4457920"],
 " times one of the 16 unit vectors of a site, to a plane wave of the same \
momentum, and the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"16", "\[Times]", "16"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c07509c3-f706-4c1b-ba24-5af2e843ec6c"],
 " matrix of these images has the eigenvalues ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SubsuperscriptBox["\[CurlyEpsilon]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["lat",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d02ffc5c-b17f-46b2-9cd8-228a46798648"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", 
    SubsuperscriptBox["\[CurlyEpsilon]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["lat",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "63696405-1265-4088-922d-a0f5aaa24f8c"],
 ", each eight times, at all 24 allowed momenta ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["q", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "1"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "11c9a950-bab5-4de8-911e-ce405d8c12ae"],
 " (the integer multiples of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Pi]", "/", 
    RowBox[{"(", 
     RowBox[{"24", 
      SubsuperscriptBox["\[ScriptL]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["x",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d88808d4-e210-4216-b561-e5d832add471"],
 ", from ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "11"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4ee4c993-9303-4544-8e5d-d265176d00cf"],
 " to ",
 Cell[BoxData[
  FormBox["12", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "863e398d-b005-4b58-8244-499ec7942896"],
 " times this unit), for the Wilson coefficients ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["W",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f8b0f91d-d286-4d6c-a9fa-cb7900d023b0"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["W",
      FontSlant->"Plain"]], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9a90f557-0644-4555-8a9b-7dd53c199aa0"],
 ". The energy of a free particle on the lattice is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CurlyEpsilon]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["lat",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["q", "TI"], "\[RightVector]"], 
      StyleBox["LL",
       FontSlant->"Plain"]], ")"}], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       UnderscriptBox["\[Sum]", 
        StyleBox["j", "TI"],
        LimitsPositioning->True], "\[ThinSpace]", 
       SuperscriptBox[
        StyleBox["sin",
         FontSlant->"Plain"], "2"], 
       RowBox[{"(", 
        RowBox[{
         SubsuperscriptBox[
          StyleBox["q", "TI"], 
          StyleBox["LL",
           FontSlant->"Plain"], 
          StyleBox["j", "TI"]], 
         SubsuperscriptBox["\[ScriptL]", 
          StyleBox["LL",
           FontSlant->"Plain"], 
          StyleBox["x",
           FontSlant->"Plain"]]}], ")"}], "/", 
       SuperscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox["\[ScriptL]", 
          StyleBox["LL",
           FontSlant->"Plain"], 
          StyleBox["x",
           FontSlant->"Plain"]], ")"}], "2"], "+", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubscriptBox[
           StyleBox["m", "TI"], 
           StyleBox["LL",
            FontSlant->"Plain"]], "+", 
          RowBox[{"(", 
           RowBox[{
            SubsuperscriptBox[
             StyleBox["r", "TI"], 
             StyleBox["LL",
              FontSlant->"Plain"], 
             StyleBox["W",
              FontSlant->"Plain"]], "/", 
            SubsuperscriptBox["\[ScriptL]", 
             StyleBox["LL",
              FontSlant->"Plain"], 
             StyleBox["x",
              FontSlant->"Plain"]]}], ")"}], "\[ThinSpace]", 
          UnderscriptBox["\[Sum]", 
           StyleBox["j", "TI"],
           LimitsPositioning->True], 
          RowBox[{"(", 
           RowBox[{"1", "-", 
            StyleBox["cos",
             FontSlant->"Plain"], 
            RowBox[{"(", 
             RowBox[{
              SubsuperscriptBox[
               StyleBox["q", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["j", "TI"]], 
              SubsuperscriptBox["\[ScriptL]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["x",
                FontSlant->"Plain"]]}], ")"}]}], ")"}]}], ")"}], "2"]}], 
      ")"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e5419983-17d5-496f-830d-0af8c5cbfdfc"],
 ", the sums running over the directions with more than one site. At ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], 
    SubsuperscriptBox["\[ScriptL]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["x",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"\[PlusMinus]", "\[Pi]"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bc5fbdfc-2bfd-4636-b9d8-ab9510c2c810"],
 " the sine vanishes again: without the Wilson term (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["W",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fb3404d8-cdb5-4676-bb29-895f9f724e32"],
 ") the energy returns to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4f26e10b-eee7-4bd6-ad4a-0f85c4aef856"],
 " there (a second, spurious particle, the doubler); with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["W",
      FontSlant->"Plain"]], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e9cc5e31-d172-4f32-85fd-e372a784b724"],
 " it is lifted to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "+", "2", 
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["W",
      FontSlant->"Plain"]], "/", 
    SubsuperscriptBox["\[ScriptL]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["x",
      FontSlant->"Plain"]], "\[LongEqual]", "4.4"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "648faef5-b594-4cd9-9c34-3f1af04b3894"],
 ". Figure 1 shows these eigenvalues with the formula and with the continuum \
energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CurlyEpsilon]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["q", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], "2"], "+", 
       SubsuperscriptBox[
        StyleBox["m", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], "2"]}], ")"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2dac2a8b-e494-4b89-8c7c-a21d145188b7"],
 " (the figures stand in the subsection after the data files of the original \
program)."
}], "Text",ExpressionUUID->"c752197e-b677-445a-9f61-82de50921a0c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"mFig", ",", " ", "dxFig", ",", " ", "nFig"}], "}"}], " ", "=", 
    " ", 
    RowBox[{"{", 
     RowBox[{"0.4", ",", " ", "0.5", ",", " ", "24"}], "}"}]}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", "1", ")"}], " ", "the", " ", 
     RowBox[{"curves", ":", " ", 
      RowBox[{
      "the", " ", "continuum", " ", "energy", " ", "and", " ", "eps_lat", " ",
        "for", " ", "r_W"}]}]}], " ", "=", " ", 
    RowBox[{
    "0", " ", "and", " ", "1", " ", "on", " ", "401", " ", "momenta"}]}], " ",
    "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"curves", " ", "=", " ", 
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"q", " ", "=", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "Pi"}], "/", "dxFig"}], " ", "+", " ", 
             RowBox[{"2", " ", 
              RowBox[{"Pi", "/", "dxFig"}], " ", 
              RowBox[{"i", "/", "400."}]}]}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"rw", ",", " ", "q", ",", " ", 
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{"q", "^", "2"}], " ", "+", " ", 
              RowBox[{"mFig", "^", "2"}]}], "]"}], ",", " ", 
            RowBox[{"t2epsLat", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"q", ",", " ", "0.", ",", " ", "0."}], "}"}], ",", " ",
               "dxFig", ",", " ", "mFig", ",", " ", "rw", ",", " ", 
              RowBox[{"{", 
               RowBox[{"True", ",", " ", "False", ",", " ", "False"}], 
               "}"}]}], "]"}]}], "}"}]}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"rw", ",", " ", 
          RowBox[{"{", 
           RowBox[{"0.", ",", " ", "1."}], "}"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", "0", ",", " ", "400"}], "}"}]}], "]"}], ",", 
      " ", "1"}], "]"}]}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"(", "2", ")"}], " ", "the", " ", 
    RowBox[{"points", ":", " ", 
     RowBox[{
     "the", " ", "largest", " ", "eigenvalue", " ", "of", " ", "the", " ", 
      "operator", " ", "on", " ", "the", " ", "plane", " ", "waves", " ", 
      "of", " ", "the", " ", "24", " ", "allowed", " ", "momenta"}]}]}], " ", 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"dispDev", " ", "=", " ", "0."}], ";"}], "\n", 
 RowBox[{
  RowBox[{"points", " ", "=", " ", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"latFig", " ", "=", " ", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<n\>\"", " ", "->", " ", 
               RowBox[{"{", 
                RowBox[{"nFig", ",", " ", "1", ",", " ", "1"}], "}"}]}], ",", 
              " ", 
              RowBox[{"\"\<ell\>\"", " ", "->", " ", "dxFig"}], ",", " ", 
              RowBox[{"\"\<periodic\>\"", " ", "->", " ", 
               RowBox[{"{", 
                RowBox[{"True", ",", " ", "False", ",", " ", "False"}], 
                "}"}]}], ",", " ", 
              RowBox[{"\"\<wilson\>\"", " ", "->", " ", "rw"}], ",", " ", 
              RowBox[{"\"\<mass\>\"", " ", "->", " ", "mFig"}], ",", " ", 
              RowBox[{"\"\<mu\>\"", " ", "->", " ", "0."}]}], "|>"}]}], ",", 
           "\n", "      ", "kk", ",", " ", "q", ",", " ", "w", ",", " ", 
           "out", ",", " ", "m16", ",", " ", "ev", ",", " ", "el"}], "}"}], ",",
          "\n", "     ", 
         RowBox[{
          RowBox[{"kk", " ", "=", " ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"kq", " ", "<=", " ", 
              RowBox[{"nFig", "/", "2"}]}], ",", " ", "kq", ",", " ", 
             RowBox[{"kq", " ", "-", " ", "nFig"}]}], "]"}]}], ";", "\n", 
          "     ", 
          RowBox[{"q", " ", "=", " ", 
           RowBox[{"2", " ", "Pi", " ", 
            RowBox[{"kk", "/", 
             RowBox[{"(", 
              RowBox[{"nFig", " ", "dxFig"}], ")"}]}]}]}], ";", "\n", "     ", 
          RowBox[{"(*", " ", 
           RowBox[{
            RowBox[{"the", " ", "16", " ", "plane", " ", "waves"}], ",", " ", 
            
            RowBox[{"one", " ", "per", " ", "unit", " ", "vector", " ", "b"}],
             ",", " ", 
            RowBox[{
            "as", " ", "the", " ", "columns", " ", "of", " ", "a", " ", 
             "matrix"}]}], " ", "*)"}], "\n", "     ", 
          RowBox[{"w", " ", "=", " ", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"Mod", "[", 
                  RowBox[{
                   RowBox[{"r", " ", "-", " ", "1"}], ",", " ", "16"}], "]"}],
                  " ", "+", " ", "1"}], " ", "==", " ", "b"}], ",", " ", 
               RowBox[{"Exp", "[", 
                RowBox[{"I", " ", "q", " ", "dxFig", " ", 
                 RowBox[{"Quotient", "[", 
                  RowBox[{
                   RowBox[{"r", " ", "-", " ", "1"}], ",", " ", "16"}], 
                  "]"}]}], "]"}], ",", " ", 
               RowBox[{"0.", " ", "I"}]}], "]"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"r", ",", " ", 
               RowBox[{"16", " ", "nFig"}]}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"b", ",", " ", "16"}], "}"}]}], "]"}]}], ";", "\n", 
          "     ", 
          RowBox[{"out", " ", "=", " ", 
           RowBox[{"t2apply", "[", 
            RowBox[{"latFig", ",", " ", 
             RowBox[{"t2trivialFields", "[", "nFig", "]"}], ",", " ", "w"}], 
            "]"}]}], ";", "\n", "     ", 
          RowBox[{"m16", " ", "=", " ", 
           RowBox[{"out", "[", 
            RowBox[{"[", 
             RowBox[{"1", " ", ";;", " ", "16"}], "]"}], "]"}]}], ";", "\n", 
          "     ", 
          RowBox[{"dispDev", " ", "=", " ", 
           RowBox[{"Max", "[", 
            RowBox[{"dispDev", ",", " ", 
             RowBox[{"Max", "[", 
              RowBox[{"Abs", "[", 
               RowBox[{
                RowBox[{"out", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"16", " ", 
                    RowBox[{"(", 
                    RowBox[{"nFig", " ", "-", " ", "1"}], ")"}]}], " ", "+", 
                    " ", "1"}], " ", ";;", " ", 
                   RowBox[{"16", " ", "nFig"}]}], "]"}], "]"}], " ", "-", " ", 
                RowBox[{"m16", " ", 
                 RowBox[{"Exp", "[", 
                  RowBox[{"I", " ", "q", " ", "dxFig", " ", 
                   RowBox[{"(", 
                    RowBox[{"nFig", " ", "-", " ", "1"}], ")"}]}], "]"}]}]}], 
               "]"}], "]"}]}], "]"}]}], ";", "\n", "     ", 
          RowBox[{"ev", " ", "=", " ", 
           RowBox[{"First", "[", 
            RowBox[{"t2eigh", "[", "m16", "]"}], "]"}]}], ";", "\n", "     ", 
          
          RowBox[{"el", " ", "=", " ", 
           RowBox[{"t2epsLat", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"q", ",", " ", "0.", ",", " ", "0."}], "}"}], ",", " ", 
             "dxFig", ",", " ", "mFig", ",", " ", "rw", ",", " ", 
             RowBox[{"{", 
              RowBox[{"True", ",", " ", "False", ",", " ", "False"}], "}"}]}],
             "]"}]}], ";", "\n", "     ", 
          RowBox[{"dispDev", " ", "=", " ", 
           RowBox[{"Max", "[", 
            RowBox[{"dispDev", ",", " ", 
             RowBox[{"Max", "[", 
              RowBox[{"Abs", "[", 
               RowBox[{"ev", " ", "-", " ", 
                RowBox[{"Join", "[", 
                 RowBox[{
                  RowBox[{"ConstantArray", "[", 
                   RowBox[{
                    RowBox[{"-", "el"}], ",", " ", "8"}], "]"}], ",", " ", 
                  RowBox[{"ConstantArray", "[", 
                   RowBox[{"el", ",", " ", "8"}], "]"}]}], "]"}]}], "]"}], 
              "]"}]}], "]"}]}], ";", "\n", "     ", 
          RowBox[{"{", 
           RowBox[{"rw", ",", " ", "q", ",", " ", 
            RowBox[{"ev", "[", 
             RowBox[{"[", "16", "]"}], "]"}]}], "}"}]}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"{", 
        RowBox[{"rw", ",", " ", 
         RowBox[{"{", 
          RowBox[{"0.", ",", " ", "1."}], "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"kq", ",", " ", "0", ",", " ", 
         RowBox[{"nFig", " ", "-", " ", "1"}]}], "}"}]}], "]"}], ",", " ", 
     "1"}], "]"}]}], ";"}], "\n", 
 RowBox[{"SL31Check", "[", 
  RowBox[{"\"\<GS-16\>\"", ",", 
   " ", "\"\<the lattice operator of the solvers on plane waves: on a \
periodic chain of 24 sites (dx = 0.5, m = 0.4) the image of a plane wave is a \
plane wave of the same momentum, and the 16 x 16 matrix of the images has the \
eigenvalues -eps_lat (eightfold) and +eps_lat (eightfold) at all 24 momenta, \
for r_W = 0 and 1 (tolerance 1e-12)\>\"", ",", "\n", "  ", 
   RowBox[{"dispDev", " ", "<", " ", "1*^-12"}], ",", " ", 
   RowBox[{"Row", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<largest deviation \>\"", ",", " ", "dispDev", ",", 
      " ", "\"\< (original: 1.4e-14)\>\""}], "}"}], "]"}]}], "]"}]}], "Input",\

 CellLabel->
