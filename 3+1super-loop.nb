                 OverscriptBox[
                  StyleBox["x",
                   FontWeight->"Bold",
                   FontSlant->"Plain"], "_"], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "24f5f7e2-12f3-46a4-8489-f4a131d21413"],
               " changes the signs of the coefficients of ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubscriptBox[
                   StyleBox["e",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], "1"], ",", "\[Ellipsis]", ",", 
                  SubscriptBox[
                   StyleBox["e",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], "7"]}], TraditionalForm]], 
