Cell["\<\
GS-7 to GS-9: the super-loop form of the Dirac operator and the \
Dirac-Bogoliubov-de Gennes equations\
\>", "Subsection",ExpressionUUID->"ec0f22f9-d687-4369-9e62-57ca65784190"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"GS", "-", "7"}], ":", " ", 
     RowBox[{
      RowBox[{"with", " ", "constant", " ", "non"}], "-", 
      RowBox[{
      "abelian", " ", "gauge", " ", "fields", " ", "nabla_p", " ", "acts", " ",
        "on", " ", "plane", " ", "waves", " ", "as", " ", "N_p"}]}]}], " ", "=",
     " ", 
    RowBox[{
     RowBox[{"i", " ", "k_p"}], " ", "-", " ", 
     RowBox[{"i", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"gv", " ", 
         RowBox[{"A_p", ".", "T"}]}], " ", "+", " ", 
        RowBox[{"gF", " ", "AF_p"}]}], ")"}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"worst7", " ", "=", " ", "0."}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"kv", " ", "=", " ", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"t2Unit", "[", "]"}], ",", " ", 
             RowBox[{"{", "4", "}"}]}], "]"}]}], ",", " ", "nps", ",", " ", 
          "dirac", ",", " ", "ur", ",", " ", "ll", ",", " ", "sq", ",", " ", 
          "rhs", ",", " ", "md", ",", " ", "mdb", ",", " ", "nk"}], "}"}], ",",
         "\n", "   ", 
        RowBox[{
         RowBox[{"nps", " ", "=", " ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Module", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"a", " ", "=", " ", 
                RowBox[{"Table", "[", 
                 RowBox[{
                  RowBox[{"t2Unit", "[", "]"}], ",", " ", 
                  RowBox[{"{", "3", "}"}]}], "]"}]}], "}"}], ",", " ", 
              RowBox[{
               RowBox[{"I", " ", 
                RowBox[{"kv", "[", 
                 RowBox[{"[", 
                  RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}], " ", 
                RowBox[{"IdentityMatrix", "[", "8", "]"}]}], " ", "-", " ", 
               RowBox[{"I", " ", 
                RowBox[{"gauge8", "[", 
                 RowBox[{"gv", ",", " ", "gf", ",", " ", "a", ",", " ", 
                  RowBox[{"t2Unit", "[", "]"}]}], "]"}]}]}]}], "]"}], ",", 
            " ", 
            RowBox[{"{", 
             RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], ";",
          "\n", "   ", 
         RowBox[{"dirac", " ", "=", " ", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"t2lift4", "[", 
              RowBox[{"g", "[", 
               RowBox[{"[", 
                RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}], "]"}], " ", ".",
              " ", 
             RowBox[{"nps", "[", 
              RowBox[{"[", 
               RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}]}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], ";",
          "\n", "   ", 
         RowBox[{"ur", " ", "=", " ", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"KroneckerProduct", "[", 
              RowBox[{
               RowBox[{"t2sigma", "[", "p", "]"}], ",", " ", 
               RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}], " ", ".", 
             " ", 
             RowBox[{"nps", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"p", " ", "+", " ", "1"}], ",", " ", 
                RowBox[{"5", " ", ";;", " ", "8"}], ",", " ", 
                RowBox[{"5", " ", ";;", " ", "8"}]}], "]"}], "]"}]}], ",", 
            " ", 
            RowBox[{"{", 
             RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], ";",
          "\n", "   ", 
         RowBox[{"ll", " ", "=", " ", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"KroneckerProduct", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"p", " ", "==", " ", "0"}], ",", " ", "1", ",", " ", 
                  RowBox[{"-", "1"}]}], "]"}], " ", 
                RowBox[{"t2sigma", "[", "p", "]"}]}], ",", " ", 
               RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}], " ", ".", 
             " ", 
             RowBox[{"nps", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"p", " ", "+", " ", "1"}], ",", " ", 
                RowBox[{"1", " ", ";;", " ", "4"}], ",", " ", 
                RowBox[{"1", " ", ";;", " ", "4"}]}], "]"}], "]"}]}], ",", 
            " ", 
            RowBox[{"{", 
             RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], ";",
          "\n", "   ", 
         RowBox[{"worst7", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"worst7", ",", " ", 
            RowBox[{"fro", "[", 
             RowBox[{
              RowBox[{"dirac", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"1", " ", ";;", " ", "4"}], ",", " ", 
                 RowBox[{"5", " ", ";;", " ", "8"}]}], "]"}], "]"}], " ", "-",
               " ", "ur"}], "]"}], ",", " ", 
            RowBox[{"fro", "[", 
             RowBox[{
              RowBox[{"dirac", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"5", " ", ";;", " ", "8"}], ",", " ", 
                 RowBox[{"1", " ", ";;", " ", "4"}]}], "]"}], "]"}], " ", "-",
               " ", "ll"}], "]"}], ",", "\n", "     ", 
            RowBox[{
             RowBox[{"fro", "[", 
              RowBox[{"dirac", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"1", " ", ";;", " ", "4"}], ",", " ", 
                 RowBox[{"1", " ", ";;", " ", "4"}]}], "]"}], "]"}], "]"}], 
             " ", "+", " ", 
             RowBox[{"fro", "[", 
              RowBox[{"dirac", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"5", " ", ";;", " ", "8"}], ",", " ", 
                 RowBox[{"5", " ", ";;", " ", "8"}]}], "]"}], "]"}], 
              "]"}]}]}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"sq", " ", "=", " ", 
          RowBox[{"dirac", " ", ".", " ", "dirac"}]}], ";", "\n", "   ", 
         RowBox[{"rhs", " ", "=", " ", 
          RowBox[{
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"t2eta", "[", "p", "]"}], " ", 
              RowBox[{
               RowBox[{"nps", "[", 
                RowBox[{"[", 
                 RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}], " ", ".", 
               " ", 
               RowBox[{"nps", "[", 
                RowBox[{"[", 
                 RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}]}]}], ",", 
             " ", 
             RowBox[{"{", 
              RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}], 
           " ", "+", "\n", "     ", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{"0.25", " ", 
              RowBox[{
               RowBox[{"t2lift4", "[", 
                RowBox[{"comm", "[", 
                 RowBox[{
                  RowBox[{"g", "[", 
                   RowBox[{"[", 
                    RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}], ",", " ", 
                  RowBox[{"g", "[", 
                   RowBox[{"[", 
                    RowBox[{"q", " ", "+", " ", "1"}], "]"}], "]"}]}], "]"}], 
                "]"}], " ", ".", " ", 
               RowBox[{"comm", "[", 
                RowBox[{
                 RowBox[{"nps", "[", 
                  RowBox[{"[", 
                   RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}], ",", " ", 
                 
                 RowBox[{"nps", "[", 
                  RowBox[{"[", 
                   RowBox[{"q", " ", "+", " ", "1"}], "]"}], "]"}]}], 
                "]"}]}]}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"q", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}]}],
          ";", "\n", "   ", 
         RowBox[{"worst7", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"worst7", ",", " ", 
            RowBox[{"fro", "[", 
             RowBox[{"sq", " ", "-", " ", "rhs"}], "]"}]}], "]"}]}], ";", 
         "\n", "   ", 
         RowBox[{"md", " ", "=", " ", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{"I", " ", 
             RowBox[{"kv", "[", 
              RowBox[{"[", 
               RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}], " ", 
             RowBox[{"t2sigma", "[", "p", "]"}]}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], ";",
          "\n", "   ", 
         RowBox[{"mdb", " ", "=", " ", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{"I", " ", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"p", " ", "==", " ", "0"}], ",", " ", "1", ",", " ", 
               RowBox[{"-", "1"}]}], "]"}], " ", 
             RowBox[{"kv", "[", 
              RowBox[{"[", 
               RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}], " ", 
             RowBox[{"t2sigma", "[", "p", "]"}]}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], ";",
          "\n", "   ", 
         RowBox[{"nk", " ", "=", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"kv", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "^", "2"}], " ", "-", " ", 
           RowBox[{
            RowBox[{"kv", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "^", "2"}], " ", "-", " ", 
           RowBox[{
            RowBox[{"kv", "[", 
             RowBox[{"[", "3", "]"}], "]"}], "^", "2"}], " ", "-", " ", 
           RowBox[{
            RowBox[{"kv", "[", 
             RowBox[{"[", "4", "]"}], "]"}], "^", "2"}]}]}], ";", "\n", "   ", 
         RowBox[{"worst7", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"worst7", ",", " ", 
            RowBox[{"fro", "[", 
             RowBox[{
              RowBox[{"md", " ", ".", " ", "mdb"}], " ", "+", " ", 
              RowBox[{"nk", " ", 
               RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], "]"}]}], 
           "]"}]}]}]}], "]"}], ",", "\n", "  ", 
      RowBox[{"{", "50", "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<GS-7\>\"", ",", 
     " ", "\"\<the super-loop form of the Dirac operator: gamma^p nabla_p has \
the Weyl blocks M_LL(D) and M_LL(conj D) and no diagonal blocks; \
(gamma.nabla)^2 = eta nabla nabla + (1/4)[gamma^p, gamma^q][nabla_p, \
nabla_q]; for a free plane wave M_LL(D) M_LL(conj D) = -N_LL(k) sigma_0 (50 \
random momenta and fields; tolerance 1e-12)\>\"", ",", "\n", "  ", 
     RowBox[{"worst7", " ", "<", " ", "1*^-12"}], ",", " ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<largest deviation \>\"", ",", " ", "worst7", ",", 
        " ", "\"\< (original: 1.6e-15)\>\""}], "}"}], "]"}]}], 
    "]"}]}]}]], "Input",
