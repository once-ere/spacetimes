                StyleBox["x", "TI"], 
                StyleBox["LL",
                 FontSlant->"Plain"]], ")"}], "\[ThinSpace]", 
              SubsuperscriptBox[
               OverscriptBox[
                StyleBox["u", "TI"], "\[RightVector]"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["f",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "4470f7b0-99ca-40d4-8fc7-f2f5cf4f19a0"],
           " of the field from the vacuum ",
