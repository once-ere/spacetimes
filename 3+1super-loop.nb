                    SuperscriptBox[
                    RowBox[{"(", 
                    SubsuperscriptBox[
                    StyleBox["x", "TI"], "LL", "1"], ")"}], "2"], "+", 
                    SuperscriptBox[
                    RowBox[{"(", 
                    SubsuperscriptBox[
                    StyleBox["q", "TI"], "LL", "2"], ")"}], "2"], "+", 
