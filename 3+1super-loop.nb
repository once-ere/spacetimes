Cell[TextData[{
 "S-5, TeX: with its ",
 StyleBox["TraditionalForm",
  FontFamily->"Source Code Pro"],
 " rule, every symbol is written in TeX from its displayed boxes; the \
internal name, with its separator character, does not appear."
}], "Text",ExpressionUUID->"57b80e7b-a67b-4dc0-9a75-fe5d6211db29"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"texOut", " ", "=", " ", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{"r", ",", " ", 
       RowBox[{"Replace", "[", 
        RowBox[{
         RowBox[{"r", "[", "\"\<symbol\>\"", "]"}], ",", " ", 
         RowBox[{
          RowBox[{"HoldComplete", "[", "s_", "]"}], " ", ":>", " ", 
          RowBox[{"ToString", "[", 
           RowBox[{"TeXForm", "[", 
            RowBox[{"Unevaluated", "[", "s", "]"}], "]"}], "]"}]}]}], "]"}]}],
       "]"}], ",", " ", "symbolTable"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-5\>\"", ",", 
    " ", "\"\<the TeX of every symbol is written from its printed form, \
without the internal name\>\"", ",", "\n", "  ", 
    RowBox[{"AllTrue", "[", 
     RowBox[{"texOut", ",", " ", 
      RowBox[{
       RowBox[{"!", " ", 
        RowBox[{"StringContainsQ", "[", 
         RowBox[{"#", ",", " ", 
          
          RowBox[{"\"\<UnderBracket\>\"", " ", "|", 
           " ", "\"\<\[UnderBracket]\>\""}]}], "]"}]}], " ", "&"}]}], "]"}], ",",
     " ", 
    RowBox[{"Count", "[", 
     RowBox[{"texOut", ",", " ", 
      RowBox[{"x_", " ", "/;", " ", 
       RowBox[{"!", " ", 
        RowBox[{"StringContainsQ", "[", 
         RowBox[{"x", ",", " ", "\"\<UnderBracket\>\""}], "]"}]}]}]}], 
     "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{"TableForm", "[", 
  RowBox[{
   RowBox[{"Take", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", "\"\<tex\>\"", "]"}], " ", "&"}], ",", " ", 
          "symbolTable"}], "]"}], ",", " ", "texOut"}], "}"}], "]"}], ",", 
     " ", "8"}], "]"}], ",", " ", 
   RowBox[{"TableHeadings", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"None", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<registry TeX\>\"", ",", 
        " ", "\"\<TeXForm of the symbol\>\""}], "}"}]}], "}"}]}]}], 
  "]"}]}], "Input",
 CellLabel->
  "In[176]:=",ExpressionUUID->"0afc7e5e-3687-495a-ba2a-a9155e916f23"],

