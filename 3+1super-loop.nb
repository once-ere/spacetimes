                 StyleBox["Z", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["t",
                  FontSlant->"Plain"]], 
                RowBox[{"(", "0", ")"}]}], ")"}], 
              RowBox[{"1", "/", "2"}]], TraditionalForm]], "InlineFormula",
