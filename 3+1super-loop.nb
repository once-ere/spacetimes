           FontSize->8],
          ImageSize->95], 
         PaneBox[
          StyleBox[
           
           TemplateBox[{
            "\"the annihilation operator of the quasi-particle of a numbered \
mode of the mean-field equations (constant in time): \"", 
             FormBox[
              RowBox[{
                SubscriptBox["\[CapitalPsi]", "LL"], "\[LongEqual]", 
                UnderscriptBox["\[Sum]", 
                 StyleBox["n", "TI"], LimitsPositioning -> True], 
                RowBox[{"(", 
                  RowBox[{
                    SubsuperscriptBox["\[Psi]", 
                    RowBox[{"LL", ",", 
                    StyleBox["n", "TI"]}], "p"], 
                    SubsuperscriptBox[
                    OverscriptBox[
                    StyleBox["a", "TI"], "^"], 
                    RowBox[{"LL", ",", 
                    StyleBox["n", "TI"]}], "qp"], "+", 
                    SuperscriptBox[
                    RowBox[{"(", 
                    SubsuperscriptBox["\[Psi]", 
                    RowBox[{"LL", ",", 
                    StyleBox["n", "TI"]}], "h"], ")"}], "*"], 
                    SuperscriptBox[
                    RowBox[{"(", 
                    SubsuperscriptBox[
                    OverscriptBox[
                    StyleBox["a", "TI"], "^"], 
                    RowBox[{"LL", ",", 
                    StyleBox["n", "TI"]}], "qp"], ")"}], "\[Dagger]"]}], 
                  ")"}]}], TraditionalForm], 
             "\"; the quasi-particle vacuum is annihilated by every \"", 
             FormBox[
              SubsuperscriptBox[
               OverscriptBox[
                StyleBox["a", "TI"], "^"], 
               RowBox[{"LL", ",", 
                 StyleBox["n", "TI"]}], "qp"], TraditionalForm]},
            "RowDefault"],
           StripOnInput->False,
           FontFamily->"Source Sans Pro",
           FontSize->9.5],
          ImageSize->290]},
