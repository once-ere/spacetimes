                    SubsuperscriptBox["\[Gamma]", "LL", "2"], 
                    SubsuperscriptBox["\[Gamma]", "LL", "0"]}], 
                  TraditionalForm], "\"; \"", 
                 FormBox[
                  RowBox[{
                    SubsuperscriptBox["\[Alpha]", "LL", 
                    StyleBox["j", "TI"]], "\[LongEqual]", 
                    SubsuperscriptBox["\[Gamma]", "LL", "0"], 
                    SubsuperscriptBox["\[Gamma]", "LL", 
                    StyleBox["j", "TI"]]}], TraditionalForm], "\", \"", 
                 FormBox[
                  RowBox[{
                    SubscriptBox["\[Beta]", "LL"], "\[LongEqual]", 
                    SubsuperscriptBox["\[Gamma]", "LL", "0"]}], 
                  TraditionalForm], "\" (on Dirac \"", 
