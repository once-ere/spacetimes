Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "how", " ", "many", " ", "items", " ", "of", " ", "each", " ", "kind"}], 
   " ", "*)"}], "\n", 
  RowBox[{"ReverseSort", "[", 
   RowBox[{"Counts", "[", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"#", "[", "\"\<kind\>\"", "]"}], " ", "&"}], ",", " ", 
      "items"}], "]"}], "]"}], "]"}]}]], "Input",
 CellLabel->
  "In[152]:=",ExpressionUUID->"2a24fe7a-7d2f-4fff-bf4d-de57986fb2ac"],

