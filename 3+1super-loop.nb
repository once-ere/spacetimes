                 RowBox[{"LL", ",", 
                   StyleBox["p", "TI"]}], "2"], "\[LongEqual]", "0"}], 
              TraditionalForm], "\"): \"", 
             FormBox[
              FractionBox[
               RowBox[{
                 SubsuperscriptBox[
                  StyleBox["A", FontSlant -> "Plain"], 
                  RowBox[{"LL", ",", 
                    StyleBox["p", "TI"]}], "\[UpArrow]"], "\[LongEqual]", 
