             "\"), and their modulus \"", 
             FormBox[
              RowBox[{
                SubsuperscriptBox["\[CurlyRho]", "LL", "n"], "\[LongEqual]", 
                SuperscriptBox[
                 RowBox[{"(", 
                   RowBox[{
                    SuperscriptBox[
                    RowBox[{"(", 
                    SubsuperscriptBox[
                    StyleBox["c", "TI"], 
