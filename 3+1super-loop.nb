Cell["\<\
Numbers. The original programs compute in double precision with random \
numbers from a generator with a fixed seed. Part II uses the same generator \
with the same seeds, and draws the random numbers in the same order, so that \
every random matrix, field and momentum is the same number as in the original \
program. Exact quantities (the Dirac matrices, the generators) are computed \
exactly; results that depend on rounding (the largest deviation of a check) \
are reported next to the value of the original report.\
\>", "Text",ExpressionUUID->"5782a760-f9f8-44dd-82f8-116349625ee7"],

Cell[CellGroupData[{

Cell["\<\
II.1 The core library t2core: random numbers, matrices, the super-loop \
operators, the lattice\
\>", "Section",ExpressionUUID->"630883d8-4d19-49a5-a0b8-adc6c063bfbe"],

Cell[CellGroupData[{

Cell["II.1.1 Random numbers (t2core/src/rng.rs)", "Subsection",ExpressionUUID->"f94f85c1-a19f-40f3-b4f6-9b214d025278"],

Cell[TextData[{
 "The generator SplitMix64 keeps one unsigned 64-bit integer as its state. \
Every call adds the constant 9E3779B97F4A7C15 (hexadecimal) to the state and \
mixes the result with shifts, exclusive-or operations (",
 StyleBox["BitXor",
  FontFamily->"Source Code Pro"],
 ") and multiplications; all arithmetic is modulo ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", "64"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dce050a6-b1a9-4f3f-9d8c-7606ab0a6be6"],
 ", as in Rust. A uniform number in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"-", "1"}], ",", "1", ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "835fd564-61af-425c-b6f2-9dee0270c84f"],
 " is made from the upper 53 bits. The conversion is exact in both languages, \
so the Wolfram Language reproduces every random number of the original \
programs bit for bit. The test compares the first three integers and the \
first four uniform numbers for the seed 2026111707 (the seed of the program \
t2_fields) with the values of the same algorithm computed independently in \
Python 3."
}], "Text",ExpressionUUID->"57d1843b-db00-4204-a52c-30440dfdbbd0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", "state", " ", "of", " ", "the", " ", "generator"}], ";",
     " ", 
    RowBox[{
     RowBox[{"t2Seed", "[", "s", "]"}], " ", "starts", " ", "a", " ", "new", " ",
      "sequence"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"t2Seed", "[", "s_Integer", "]"}], " ", ":=", " ", 
     RowBox[{"(", 
      RowBox[{"t2rngState", " ", "=", " ", 
       RowBox[{"Mod", "[", 
        RowBox[{"s", ",", " ", 
         RowBox[{"2", "^", "64"}]}], "]"}]}], ")"}]}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{" ", 
     RowBox[{"one", " ", "step", " ", "of", " ", 
      RowBox[{"SplitMix64", ":", " ", 
       RowBox[{"returns", " ", "an", " ", "integer", " ", 
        RowBox[{"in", " ", "[", 
         RowBox[{"0", ",", " ", 
          RowBox[{"2", "^", "64"}]}]}]}]}]}], ")"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2NextU64", "[", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "z", "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"t2rngState", " ", "=", " ", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"t2rngState", " ", "+", " ", "16^^9E3779B97F4A7C15"}], ",",
            " ", 
           RowBox[{"2", "^", "64"}]}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"z", " ", "=", " ", "t2rngState"}], ";", "\n", "   ", 
        RowBox[{"z", " ", "=", " ", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"BitXor", "[", 
             RowBox[{"z", ",", " ", 
              RowBox[{"BitShiftRight", "[", 
               RowBox[{"z", ",", " ", "30"}], "]"}]}], "]"}], " ", 
            "16^^BF58476D1CE4E5B9"}], ",", " ", 
           RowBox[{"2", "^", "64"}]}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"z", " ", "=", " ", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"BitXor", "[", 
             RowBox[{"z", ",", " ", 
              RowBox[{"BitShiftRight", "[", 
               RowBox[{"z", ",", " ", "27"}], "]"}]}], "]"}], " ", 
            "16^^94D049BB133111EB"}], ",", " ", 
           RowBox[{"2", "^", "64"}]}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"BitXor", "[", 
         RowBox[{"z", ",", " ", 
          RowBox[{"BitShiftRight", "[", 
           RowBox[{"z", ",", " ", "31"}], "]"}]}], "]"}]}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{" ", 
       RowBox[{"a", " ", "uniform", " ", "number", " ", 
        RowBox[{"in", " ", "[", 
         RowBox[{
          RowBox[{"-", "1"}], ",", " ", "1"}]}]}], ")"}], ":", " ", 
      RowBox[{"the", " ", "upper", " ", "53", " ", "bits"}]}], ",", " ", 
     RowBox[{"as", " ", "an", " ", "exact", " ", "rational"}], ",", " ", 
     RowBox[{"converted", " ", "to", " ", "a", " ", "double"}]}], " ", "*)"}],
    "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2Unit", "[", "]"}], " ", ":=", " ", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{"2", " ", 
        RowBox[{
         RowBox[{"BitShiftRight", "[", 
          RowBox[{
           RowBox[{"t2NextU64", "[", "]"}], ",", " ", "11"}], "]"}], "/", 
         RowBox[{"2", "^", "53"}]}]}], " ", "-", " ", "1"}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{" ", 
      RowBox[{
       RowBox[{"a", " ", "random", " ", "complex", " ", "number", " ", "re"}],
        " ", "+", " ", 
       RowBox[{
       "i", " ", "im", " ", "with", " ", "re", " ", "and", " ", "im", " ", 
        "uniform", " ", 
        RowBox[{"in", " ", "[", 
         RowBox[{
          RowBox[{"-", "1"}], ",", " ", "1"}]}]}]}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{"re", " ", "is", " ", "drawn", " ", "first"}], ")"}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2UnitC", "[", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"re", " ", "=", " ", 
         RowBox[{"t2Unit", "[", "]"}]}], "}"}], ",", " ", 
       RowBox[{"re", " ", "+", " ", 
        RowBox[{"I", " ", 
         RowBox[{"t2Unit", "[", "]"}]}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "a", " ", "list", " ", "of", " ", "n", " ", "random", " ", "complex", " ",
      "numbers"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2RndVec", "[", "n_Integer", "]"}], " ", ":=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"t2UnitC", "[", "]"}], ",", " ", 
       RowBox[{"{", "n", "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", 
      RowBox[{"test", ":", " ", 
       RowBox[{
       "the", " ", "first", " ", "values", " ", "for", " ", "the", " ", 
        "seed", " ", "2026111707"}]}]}], ",", " ", 
     RowBox[{
     "computed", " ", "by", " ", "the", " ", "same", " ", "algorithm", " ", 
      "in", " ", "Python", " ", "3"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"t2Seed", "[", "2026111707", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"t2first", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"t2NextU64", "[", "]"}], ",", " ", 
       RowBox[{"t2NextU64", "[", "]"}], ",", " ", 
       RowBox[{"t2NextU64", "[", "]"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"t2Seed", "[", "2026111707", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"t2firstUnits", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"t2Unit", "[", "]"}], ",", " ", 
       RowBox[{"{", "4", "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<T2-RNG\>\"", ",", 
     " ", "\"\<the generator SplitMix64 gives, for the seed 2026111707, the \
integers and the uniform numbers of the original algorithm\>\"", ",", "\n", 
     "  ", 
     RowBox[{
      RowBox[{"t2first", " ", "===", " ", 
       RowBox[{"{", 
        RowBox[{
        "16253586484067153034", ",", " ", "11771902715344777314", ",", " ", 
         "8742176756923514478"}], "}"}]}], " ", "&&", "\n", "   ", 
      RowBox[{"t2firstUnits", " ", "===", " ", 
       RowBox[{"{", 
        RowBox[{
        "0.7622173776706638", ",", " ", "0.2763122498264816", ",", " ", 
         RowBox[{"-", "0.05217129678912458"}], ",", " ", 
         "0.4038650534416697"}], "}"}]}]}], ",", "\n", "  ", "t2firstUnits"}],
     "]"}]}]}]], "Input",
