            SubsuperscriptBox["\[CurlyPhi]", "LL", "G"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"thG0 thG1 thG2 thG phiG\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the three Goldstone fields of SFBSv: the phase ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[CurlyTheta]", 
              RowBox[{
               StyleBox["LL",
                FontSlant->"Plain"], ",", "0"}], 
              StyleBox["G",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "16aa4594-67ca-47a4-8b6c-cf8af21950a1"],
           " (the angle of the broken fermion number) and the angles ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[CurlyTheta]", 
              RowBox[{
               StyleBox["LL",
                FontSlant->"Plain"], ",", "1"}], 
              StyleBox["G",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "53b3e6fe-1c44-4930-badf-8443d41485a4"],
           ", ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[CurlyTheta]", 
              RowBox[{
               StyleBox["LL",
                FontSlant->"Plain"], ",", "2"}], 
              StyleBox["G",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "df5c1196-a3ba-45ec-8eb6-e9b70fa53ff8"],
           " of the broken isospin rotations about the first two axes; ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox["\[CurlyTheta]", 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", "1"}], 
               StyleBox["G",
                FontSlant->"Plain"]], "+", 
              StyleBox["i", "TI"], 
              SubsuperscriptBox["\[CurlyTheta]", 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", "2"}], 
               StyleBox["G",
                FontSlant->"Plain"]], "\[LongEqual]", 
              SubsuperscriptBox["\[CurlyTheta]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["G",
                FontSlant->"Plain"]], "\[ThinSpace]", 
              StyleBox["exp",
               FontSlant->"Plain"], 
              RowBox[{"(", 
               RowBox[{
                StyleBox["i", "TI"], 
                SubsuperscriptBox["\[CurlyPhi]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["G",
                  FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "3fc8f4c8-e32e-46d6-bff5-1be9d29e9e9f"],
           " with ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox["\[CurlyTheta]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["G",
                FontSlant->"Plain"]], "\[GreaterEqual]", "0"}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "7c782cb6-ee2c-445b-838f-4d9155f07f8e"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "55133765-edc9-4d0e-889c-11395dd573c3"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox[
             TagBox[
              StyleBox["U", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
              "SL31SansSerif"], "LL", "G"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"UG U(thG1,thG2)\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the isospin rotation of the Goldstone fields of SFBSv, ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              StyleBox["exp",
               FontSlant->"Plain"], 
              RowBox[{"(", 
               RowBox[{
                FractionBox[
                 StyleBox["i", "TI"], "2"], 
                RowBox[{"(", 
                 RowBox[{
                  SubsuperscriptBox["\[CurlyTheta]", 
                   RowBox[{
                    StyleBox["LL",
                    FontSlant->"Plain"], ",", "1"}], 
                   StyleBox["G",
                    FontSlant->"Plain"]], 
                  SubsuperscriptBox["\[Tau]", "1", 
                   StyleBox["LL",
                    FontSlant->"Plain"]], "+", 
                  SubsuperscriptBox["\[CurlyTheta]", 
                   RowBox[{
                    StyleBox["LL",
                    FontSlant->"Plain"], ",", "2"}], 
                   StyleBox["G",
                    FontSlant->"Plain"]], 
                  SubsuperscriptBox["\[Tau]", "2", 
                   StyleBox["LL",
                    FontSlant->"Plain"]]}], ")"}]}], ")"}]}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "b069ba06-d840-4338-b152-b4093ac7e61f"],
           ", a matrix of ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              StyleBox["SU", "TI"], 
              RowBox[{"(", "2", ")"}]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "fc76868e-641f-4d90-bb06-7c167be84626"],
           " whose rotation turns the third isospin axis by the angle ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[CurlyTheta]", 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["G",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "9f4c08c1-6eef-43a4-90d8-94ccdb77919d"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "2d5a7ec1-73f0-4431-a707-9786559f4d4a"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["h", "LL", "a"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"h_a\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the amplitude field of SFBSv: the change of the length of the \
real part of the field from ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[CapitalDelta]", 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["vac",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "7a51eff1-e7e5-4615-8b92-ce857bbd7358"],
           ", the analogue of the Higgs field; electrically neutral"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "2a8ccf98-347c-48f3-b2e6-3e28f36d5513"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["c", 
             RowBox[{"LL", ",", "1"}], "n"], "\", \"", 
            SubsuperscriptBox["c", 
             RowBox[{"LL", ",", "2"}], "n"], "\", \"", 
            SubsuperscriptBox["\[CurlyRho]", "LL", "n"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"c_n1 c_n2 rho_n\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the two non-unitary fields of SFBSv, the components of an \
imaginary part orthogonal to the real part of the field (",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["c", "TI"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", "1"}], 
               StyleBox["n",
                FontSlant->"Plain"]], "\[MinusPlus]", 
              StyleBox["i", "TI"], "\[ThinSpace]", 
              SubsuperscriptBox[
               StyleBox["c", "TI"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", "2"}], 
               StyleBox["n",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "96677733-6075-479d-b7e5-02c86aa17b5b"],
           " carry the electric charge ",
           Cell[BoxData[
            FormBox[
             RowBox[{"\[PlusMinus]", "1"}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "c45d3ac4-8517-4b1b-98fd-98d3a10bb4a2"],
           "), and their modulus ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox["\[CurlyRho]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["n",
                FontSlant->"Plain"]], "\[LongEqual]", 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{
                 SuperscriptBox[
                  RowBox[{"(", 
                   SubsuperscriptBox[
                    StyleBox["c", "TI"], 
                    RowBox[{
                    StyleBox["LL",
                    FontSlant->"Plain"], ",", "1"}], 
                    StyleBox["n",
                    FontSlant->"Plain"]], ")"}], "2"], "+", 
                 SuperscriptBox[
                  RowBox[{"(", 
                   SubsuperscriptBox[
                    StyleBox["c", "TI"], 
                    RowBox[{
                    StyleBox["LL",
                    FontSlant->"Plain"], ",", "2"}], 
                    StyleBox["n",
                    FontSlant->"Plain"]], ")"}], "2"]}], ")"}], 
               RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
            
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "12237548-2805-42b0-b6d2-bbf0503cf426"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "4e2db0ce-8ae1-4ac5-9aeb-53d4d837f0f2"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            RowBox[{
              SubsuperscriptBox["\[CapitalOmega]", "LL", "H"], "(", 
              SubscriptBox[
               OverscriptBox["d", "\[RightVector]"], "LL"], ")"}], "\", \"", 
            SubsuperscriptBox["\[Lambda]", "LL", "H"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"Omega_H lambda_H\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the potential of the Higgs form with the minimum on ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["\[ScriptCapitalV]",
               FontSlant->"Plain"], 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["vac",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "1e547e78-2b49-4381-b684-d0d0416c1a24"],
           ", ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox["\[Lambda]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["H",
                FontSlant->"Plain"]], 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{
                 SuperscriptBox[
                  RowBox[{"\[LeftBracketingBar]", 
                   SubscriptBox[
                    OverscriptBox[
                    StyleBox["d", "TI"], "\[RightVector]"], 
                    StyleBox["LL",
                    FontSlant->"Plain"]], "\[RightBracketingBar]"}], "2"], "-", 
                 SuperscriptBox[
                  RowBox[{"(", 
                   SubsuperscriptBox["\[CapitalDelta]", 
                    StyleBox["LL",
                    FontSlant->"Plain"], 
                    StyleBox["vac",
                    FontSlant->"Plain"]], ")"}], "2"]}], ")"}], "2"]}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "d668a920-f5ec-4123-985f-02f052a12d7c"],
           ", used for comparison; its coupling ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox["\[Lambda]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["H",
                FontSlant->"Plain"]], "\[LongEqual]", 
              SubsuperscriptBox["\[CapitalOmega]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               RowBox[{
                StyleBox["s",
                 FontSlant->"Plain"], 
                RowBox[{"(", "2", ")"}]}]], "/", 
              RowBox[{"(", 
               RowBox[{"4", 
                SuperscriptBox[
                 RowBox[{"(", 
                  SubsuperscriptBox["\[CapitalDelta]", 
                   StyleBox["LL",
                    FontSlant->"Plain"], 
                   StyleBox["vac",
                    FontSlant->"Plain"]], ")"}], "2"]}], ")"}]}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "f0d064e5-a6fb-4ca1-ba2a-f9ea9a37a3c4"],
           " gives it the curvature of the computed potential along ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["h", "TI"], 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["a",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "2e7724a1-8577-424e-8382-738e8dfdb075"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "4e8d4410-6bd6-41e0-972d-ff6d3f7281a8"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["\[ScriptCapitalL]", "LL", "kin"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"Lagr_kin L_kin\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the kinetic Lagrangian of the SFBS, the part of ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["\[ScriptCapitalL]",
               FontSlant->"Plain"], 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["B",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "58d9c6c9-0bf1-46e8-86ec-1285287f1983"],
           " that contains the derivatives, ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["Z", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["t",
                FontSlant->"Plain"]], "\[ThinSpace]", 
              UnderscriptBox["\[Sum]", "\[Iota]",
               LimitsPositioning->True], 
              SuperscriptBox[
               RowBox[{"\[LeftBracketingBar]", 
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{
                   SubsuperscriptBox["\[Del]", 
                    RowBox[{
                    StyleBox["LL",
                    FontSlant->"Plain"], ",", "0"}], 
                    StyleBox["B",
                    FontSlant->"Plain"]], 
                   SubscriptBox[
                    OverscriptBox[
                    StyleBox["d", "TI"], "\[RightVector]"], 
                    StyleBox["LL",
                    FontSlant->"Plain"]]}], ")"}], "\[Iota]"], 
                "\[RightBracketingBar]"}], "2"], "-", 
              SubsuperscriptBox[
               StyleBox["Z", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["s",
                FontSlant->"Plain"]], "\[ThinSpace]", 
              UnderscriptBox["\[Sum]", 
               StyleBox["j", "TI"],
               LimitsPositioning->True], "\[ThinSpace]", 
              UnderscriptBox["\[Sum]", "\[Iota]",
               LimitsPositioning->True], 
              SuperscriptBox[
               RowBox[{"\[LeftBracketingBar]", 
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{
                   SubsuperscriptBox["\[Del]", 
                    RowBox[{
                    StyleBox["LL",
                    FontSlant->"Plain"], ",", 
                    StyleBox["j", "TI"]}], 
                    StyleBox["B",
                    FontSlant->"Plain"]], 
                   SubscriptBox[
                    OverscriptBox[
                    StyleBox["d", "TI"], "\[RightVector]"], 
                    StyleBox["LL",
                    FontSlant->"Plain"]]}], ")"}], "\[Iota]"], 
                "\[RightBracketingBar]"}], "2"]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "a9039b42-0246-4b75-b1b3-d3080762c5cb"],
           ", so that ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["\[ScriptCapitalL]",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["B",
                FontSlant->"Plain"]], "\[LongEqual]", 
              SubsuperscriptBox[
               StyleBox["\[ScriptCapitalL]",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["kin",
                FontSlant->"Plain"]], "-", 
              SubscriptBox["\[CapitalOmega]", 
               StyleBox["LL",
                FontSlant->"Plain"]], 
              RowBox[{"(", 
               SubscriptBox[
                OverscriptBox[
                 StyleBox["d", "TI"], "\[RightVector]"], 
                StyleBox["LL",
                 FontSlant->"Plain"]], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "094f223f-0b93-4bca-9b83-34b75020b43b"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "7620a5bd-5ae9-4827-9dfb-71a96763a81d"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            RowBox[{
              SubsuperscriptBox[
               TagBox[
                StyleBox[
                "N", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
                "SL31SansSerif"], "LL", "g"], "(", 
              SubscriptBox[
               OverscriptBox["d", "\[RightVector]"], "LL"], ")"}], "\", \"", 
            RowBox[{
              SubsuperscriptBox[
               TagBox[
                StyleBox[
                "N", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
                "SL31SansSerif"], "LL", "v"], "(", 
              SubscriptBox[
               OverscriptBox["d", "\[RightVector]"], "LL"], ")"}], "\", \"", 
            SubsuperscriptBox[
             OverscriptBox["w", "\[RightVector]"], "LL", "n"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"N_g N_v w_n\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the contact matrix: the real symmetric ",
           Cell[BoxData[
            FormBox[
             RowBox[{"4", "\[Times]", "4"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "9c4acfb2-4e22-4c5d-9020-e42a85560293"],
           " matrix of the terms of ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              UnderscriptBox["\[Sum]", "\[Iota]",
               LimitsPositioning->True], 
              SuperscriptBox[
               RowBox[{"\[LeftBracketingBar]", 
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{
                   SubsuperscriptBox["\[Del]", 
                    RowBox[{
                    StyleBox["LL",
                    FontSlant->"Plain"], ",", 
                    StyleBox["p", "TI"]}], 
                    StyleBox["B",
                    FontSlant->"Plain"]], 
                   SubscriptBox[
                    OverscriptBox[
                    StyleBox["d", "TI"], "\[RightVector]"], 
                    StyleBox["LL",
                    FontSlant->"Plain"]]}], ")"}], "\[Iota]"], 
                "\[RightBracketingBar]"}], "2"]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "ec5298be-37b3-4124-b8a4-3d3226ee7f09"],
           " that are quadratic in the potentials ",
           Cell[BoxData[
            FormBox[
             RowBox[{"(", 
              RowBox[{
               SubsuperscriptBox[
                StyleBox["A", "TI"], 
                RowBox[{
                 StyleBox["LL",
                  FontSlant->"Plain"], ",", 
                 StyleBox["p", "TI"]}], 
                StyleBox["F",
                 FontSlant->"Plain"]], ",", 
               SubsuperscriptBox[
                StyleBox["A", "TI"], 
                RowBox[{
                 StyleBox["LL",
                  FontSlant->"Plain"], ",", 
                 StyleBox["p", "TI"]}], "1"], ",", 
               SubsuperscriptBox[
                StyleBox["A", "TI"], 
                RowBox[{
                 StyleBox["LL",
                  FontSlant->"Plain"], ",", 
                 StyleBox["p", "TI"]}], "2"], ",", 
               SubsuperscriptBox[
                StyleBox["A", "TI"], 
                RowBox[{
                 StyleBox["LL",
                  FontSlant->"Plain"], ",", 
                 StyleBox["p", "TI"]}], "3"]}], ")"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "44a1afde-3e6b-4ca8-b8ea-91317a395f78"],
           ", with the corner entry ",
           Cell[BoxData[
            FormBox[
             RowBox[{"4", 
              SuperscriptBox[
               RowBox[{"(", 
                SubsuperscriptBox[
                 StyleBox["g", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["F",
                  FontSlant->"Plain"]], ")"}], "2"], 
              SuperscriptBox[
               RowBox[{"\[LeftBracketingBar]", 
                SubscriptBox[
                 OverscriptBox[
                  StyleBox["d", "TI"], "\[RightVector]"], 
                 StyleBox["LL",
                  FontSlant->"Plain"]], "\[RightBracketingBar]"}], "2"]}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "dbf422d2-adb5-420a-926d-cf5148dd3b56"],
           ", the first row and column ",
           Cell[BoxData[
            FormBox[
             RowBox[{"4", 
              SubsuperscriptBox[
               StyleBox["g", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["F",
                FontSlant->"Plain"]], 
              SubsuperscriptBox[
               StyleBox["g", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["v",
                FontSlant->"Plain"]], 
              SuperscriptBox[
               RowBox[{"(", 
                SubsuperscriptBox[
                 StyleBox["w", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["n",
                  FontSlant->"Plain"]], ")"}], "\[Iota]"]}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "b71b0b7d-3ca6-41fc-bb9b-82d25b08f8c5"],
           " and the isospin block ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SuperscriptBox[
               RowBox[{"(", 
                SubsuperscriptBox[
                 StyleBox["g", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["v",
                  FontSlant->"Plain"]], ")"}], "2"], 
              SubsuperscriptBox[
               StyleBox["N",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["v",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "2cb1f90f-2ff7-47aa-bca8-1e897a46ece2"],
           ", whose entries are ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SuperscriptBox[
               RowBox[{"\[LeftBracketingBar]", 
                SubscriptBox[
                 OverscriptBox[
                  StyleBox["d", "TI"], "\[RightVector]"], 
                 StyleBox["LL",
                  FontSlant->"Plain"]], "\[RightBracketingBar]"}], "2"], "-", 
              
              SuperscriptBox[
               RowBox[{"\[LeftBracketingBar]", 
                SubsuperscriptBox[
                 StyleBox["d", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], "\[Iota]"], "\[RightBracketingBar]"}], 
               "2"]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "11a9a2ef-5a5d-472c-b9ec-3a5d0ea140d7"],
           " on the diagonal and ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              RowBox[{"-", 
               StyleBox["Re",
                FontSlant->"Plain"]}], 
              RowBox[{"(", 
               RowBox[{
                SubsuperscriptBox[
                 StyleBox["d", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], "\[Iota]"], 
                SuperscriptBox[
                 RowBox[{"(", 
                  SubsuperscriptBox[
                   StyleBox["d", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"], 
                   SuperscriptBox["\[Iota]", "\[Prime]"]], ")"}], "*"]}], 
               ")"}]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "c0fa8f46-5e01-4911-b616-b0682d1aa4c2"],
           " off it; and the real vector ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               OverscriptBox[
                StyleBox["w", "TI"], "\[RightVector]"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["n",
                FontSlant->"Plain"]], "\[LongEqual]", 
              StyleBox["Re",
               FontSlant->"Plain"], "\[ThinSpace]", 
              SubscriptBox[
               OverscriptBox[
                StyleBox["d", "TI"], "\[RightVector]"], 
               StyleBox["LL",
                FontSlant->"Plain"]], "\[Times]", 
              StyleBox["Im",
               FontSlant->"Plain"], "\[ThinSpace]", 
              SubscriptBox[
               OverscriptBox[
                StyleBox["d", "TI"], "\[RightVector]"], 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "8455cd16-b925-406a-864d-7db0b64664e6"],
           ", zero for the polar fields"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "f8e84180-f050-4826-9abc-a8c39dd2bc28"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["E", "LL", "c"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"E_c E_Lambda\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the quasi-particle energy of the condensed vacuum ",
           Cell[BoxData[
            FormBox[
             RowBox[{"(", 
              RowBox[{"0", ",", "0", ",", 
               SubscriptBox["\[CapitalDelta]", 
                StyleBox["LL",
                 FontSlant->"Plain"]]}], ")"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "06637e3c-0b96-4789-b21a-23b457ddd138"],
           " at ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubscriptBox["\[Mu]", 
               StyleBox["LL",
                FontSlant->"Plain"]], "\[LongEqual]", "0"}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "4f1ae2c5-6032-44fb-82d1-8f03bdb402e1"],
           ", ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["E", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["c",
                FontSlant->"Plain"]], "\[LongEqual]", 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{
                 SubsuperscriptBox[
                  StyleBox["q", "TI"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], "2"], "+", 
                 SuperscriptBox[
                  RowBox[{"(", 
                   SubsuperscriptBox[
                    StyleBox["M", "TI"], 
                    StyleBox["LL",
                    FontSlant->"Plain"], 
                    StyleBox["q",
                    FontSlant->"Plain"]], ")"}], "2"]}], ")"}], 
               RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
            
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "d0e6b110-7bdf-42ec-9460-dc57ddb4b472"],
           ", an eigenvalue of ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubscriptBox[
               StyleBox["H",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"]], 
              RowBox[{"(", 
               SubscriptBox[
                OverscriptBox[
                 StyleBox["q", "TI"], "\[RightVector]"], 
                StyleBox["LL",
                 FontSlant->"Plain"]], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "9a3b6f43-1c65-4086-b6e5-61d6f75cc983"],
           " eight times with each sign; ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["E", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["c",
                FontSlant->"Plain"]], 
              RowBox[{"(", 
               SubscriptBox["\[CapitalLambda]", 
                StyleBox["LL",
                 FontSlant->"Plain"]], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "6c846830-bf59-41d7-b0a4-65606e2f60b9"],
           " is its value at ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubscriptBox[
               StyleBox["q", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"]], "\[LongEqual]", 
              SubscriptBox["\[CapitalLambda]", 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "ddc66781-c4e2-4533-ade8-4b59adb834a4"],
           " (plain text ",
           StyleBox["E_Lambda",
            FontFamily->"Source Code Pro"],
           ")"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "f580126a-28f2-4254-80b1-6b6c580221c8"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox[
             OverscriptBox["a", "\[RightVector]"], "LL", "F"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"a_F\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the fermion-number coupling times the space components of a \
constant fermion-number potential, ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               OverscriptBox[
                StyleBox["a", "TI"], "\[RightVector]"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["F",
                FontSlant->"Plain"]], "\[LongEqual]", 
              SubsuperscriptBox[
               StyleBox["g", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["F",
                FontSlant->"Plain"]], 
              RowBox[{"(", 
               RowBox[{
                SubsuperscriptBox[
                 StyleBox["A", "TI"], 
                 RowBox[{
                  StyleBox["LL",
                   FontSlant->"Plain"], ",", "1"}], 
                 StyleBox["F",
                  FontSlant->"Plain"]], ",", 
                SubsuperscriptBox[
                 StyleBox["A", "TI"], 
                 RowBox[{
                  StyleBox["LL",
                   FontSlant->"Plain"], ",", "2"}], 
                 StyleBox["F",
                  FontSlant->"Plain"]], ",", 
                SubsuperscriptBox[
                 StyleBox["A", "TI"], 
