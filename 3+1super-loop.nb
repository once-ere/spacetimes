  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "28c8f3cf-f4cb-4698-8d9f-d7ff280b2611"],
 ". Because ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       UnderscriptBox["\[Sum]", "\[Iota]",
        LimitsPositioning->True], "\[ThinSpace]", 
       SubsuperscriptBox[
