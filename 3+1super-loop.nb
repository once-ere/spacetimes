              RowBox[{
                SubscriptBox[
                 OverscriptBox[
                  StyleBox["s", "TI"], "\[RightVector]"], "LL"], 
                "\[LongEqual]", 
                RowBox[{"(", 
                  RowBox[{
                    SubsuperscriptBox[
                    StyleBox["s", "TI"], "LL", "1"], ",", 
                    SubsuperscriptBox[
                    StyleBox["s", "TI"], "LL", "2"], ",", 
                    SubsuperscriptBox[
                    StyleBox["s", "TI"], "LL", "3"]}], ")"}]}], 
              TraditionalForm], "\", whose integer coordinates \"", 
             FormBox[
              SubsuperscriptBox[
               StyleBox["s", "TI"], "LL", 
               StyleBox["j", "TI"]], TraditionalForm], 
             "\" run from 0 to the number of sites of their direction minus \
1, at the point \"", 
             FormBox[
              RowBox[{
                SubsuperscriptBox[
                 StyleBox["x", "TI"], "LL", 
