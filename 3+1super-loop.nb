Cell[TextData[{
 StyleBox["The gap equation in closed form (check AS-5).",
  FontWeight->"Bold"],
 " The pair field of a stationary state must be the one that its own modes \
produce. For the uniform polar state this self-consistency condition is the \
gap equation: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "202969ae-102a-4248-8d94-cbf665594f4d"],
 " equals the integral of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "/", 
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "+"], "+", "1", "/", 
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "-"]}], ")"}], "\[ThinSpace]", 
    SuperscriptBox[
     StyleBox["d", "TI"], "3"], 
    SubscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "/", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"2", "\[Pi]"}], ")"}], "3"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "57881c1c-38a9-463e-a50f-ef9103fbe799"],
 " over the momenta with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "<", 
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "46f89a0c-dcd4-4275-a1d0-3c84a185c9ac"],
 " (check GS-9), with the coupling ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bcb68e12-b1a4-46b7-bfd8-6a1d50ee6949"],
 " of the contact interaction and the momentum cutoff ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalLambda]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a5b0b78c-4e8e-42f0-8e2a-d70c111ada2b"],
 ". For massless spinor charges (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bfe0791e-4b91-4b93-9f39-205f24506c69"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CurlyEpsilon]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "625648ab-83c7-4d10-b7c0-33a8bb84a912"],
 ") the integral can be done. The integrand depends only on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["q", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c2da174a-7e5f-400e-bbb5-b732a097bb80"],
 ", so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["d", "TI"], "3"], 
    SubscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "/", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"2", "\[Pi]"}], ")"}], "3"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c7f1808d-e430-41a1-95de-350108d06763"],
 " becomes ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "2"], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "/", 
    RowBox[{"(", 
     RowBox[{"2", 
      SuperscriptBox["\[Pi]", "2"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d639659e-dee4-4fdd-bbf1-2448a857b349"],
 ", and one needs antiderivatives of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "2"], "/", 
    SubsuperscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[PlusMinus]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f9af5888-176c-4616-a1c0-a7976a20de4b"],
 ". They are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]], "\[MinusPlus]", "3", 
      SubscriptBox["\[Mu]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}], 
    SubsuperscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[PlusMinus]"], "+", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["\[Mu]", 
       StyleBox["LL",
        FontSlant->"Plain"], "2"], "-", 
      FractionBox["1", "2"], 
      SubsuperscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"], "2"]}], ")"}], "\[ThinSpace]", 
    StyleBox["arsinh",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SubscriptBox[
         StyleBox["q", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"]], "\[PlusMinus]", 
        SubscriptBox["\[Mu]", 
         StyleBox["LL",
          FontSlant->"Plain"]]}], ")"}], "/", 
      SubscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f0f504e7-e66d-4362-b524-3408776fd25a"],
 ", as differentiation shows: the derivative with respect to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["q", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "040aa65e-717a-435d-b18f-ccd7179c70d7"],
 ", multiplied by ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "\[PlusMinus]"], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8e743eed-4233-407c-b03a-19998f1138aa"],
 ", is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "\[PlusMinus]"], ")"}], "2"], "+", 
    FractionBox["1", "2"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]], "\[MinusPlus]", "3", 
      SubscriptBox["\[Mu]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]], "\[PlusMinus]", 
      SubscriptBox["\[Mu]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}], "+", 
    SubsuperscriptBox["\[Mu]", 
     StyleBox["LL",
      FontSlant->"Plain"], "2"], "-", 
    FractionBox["1", "2"], 
    SubsuperscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"], "2"], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2a6554f0-354b-4011-9eaf-93388b741c69"],
 ". At ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "db4c81be-43e9-451e-b392-9049375b0528"],
 " the two antiderivatives cancel each other (there ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "+"], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "-"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a0dae546-7474-47e7-a833-c1b32dd29938"],
 ", and the function arsinh is odd), so the integral is the sum of the two \
antiderivatives at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6a4e691e-1876-4966-8271-c4867862e625"],
 ", divided by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    SuperscriptBox["\[Pi]", "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "84e31d76-97f3-450a-8423-c892ba1c082d"],
 ". The gap equation is therefore (the sum has two terms, one with the upper \
signs and one with the lower signs)"
}], "Text",ExpressionUUID->"620e7038-056c-474b-8218-8f61bb1de093"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox["1", 
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]]], "\[LongEqual]", 
   FractionBox["1", 
    RowBox[{"4", 
     SuperscriptBox["\[Pi]", "2"]}]], "\[ThinSpace]", 
   UnderscriptBox["\[Sum]", "\[PlusMinus]",
    LimitsPositioning->True], 
   RowBox[{"[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[CapitalLambda]", 
        StyleBox["LL",
         FontSlant->"Plain"]], "\[MinusPlus]", "3", 
       SubscriptBox["\[Mu]", 
        StyleBox["LL",
         FontSlant->"Plain"]]}], ")"}], "\[ThinSpace]", 
     SubsuperscriptBox[
      StyleBox["E", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], "\[PlusMinus]"], 
     RowBox[{"(", 
      SubscriptBox["\[CapitalLambda]", 
       StyleBox["LL",
        FontSlant->"Plain"]], ")"}], "+", 
     RowBox[{"(", 
      RowBox[{"2", 
       SubsuperscriptBox["\[Mu]", 
        StyleBox["LL",
         FontSlant->"Plain"], "2"], "-", 
       SubsuperscriptBox["\[CapitalDelta]", 
        StyleBox["LL",
         FontSlant->"Plain"], "2"]}], ")"}], "\[ThinSpace]", 
     StyleBox["arsinh",
      FontSlant->"Plain"], 
     FractionBox[
      RowBox[{
       SubscriptBox["\[CapitalLambda]", 
        StyleBox["LL",
         FontSlant->"Plain"]], "\[PlusMinus]", 
       SubscriptBox["\[Mu]", 
        StyleBox["LL",
         FontSlant->"Plain"]]}], 
      SubscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"]]]}], "]"}]}], TraditionalForm]], "DisplayFormula",\

 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"98f636a3-570d-4811-ab01-2b8051a4445c"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[PlusMinus]"], 
    RowBox[{"(", 
     SubscriptBox["\[CapitalLambda]", 
      StyleBox["LL",
       FontSlant->"Plain"]], ")"}], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["\[CapitalLambda]", 
           StyleBox["LL",
            FontSlant->"Plain"]], "\[PlusMinus]", 
          SubscriptBox["\[Mu]", 
           StyleBox["LL",
            FontSlant->"Plain"]]}], ")"}], "2"], "+", 
       SubsuperscriptBox["\[CapitalDelta]", 
        StyleBox["LL",
         FontSlant->"Plain"], "2"]}], ")"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b1e1e491-5b77-4702-962b-66cd39a052ea"],
 ". At ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Mu]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "eaac3cea-64c9-4efa-bcb8-2d2c31ac4ebe"],
 " the right side is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[CapitalLambda]", 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         SubsuperscriptBox["\[CapitalLambda]", 
          StyleBox["LL",
           FontSlant->"Plain"], "2"], "+", 
         SubsuperscriptBox["\[CapitalDelta]", 
          StyleBox["LL",
           FontSlant->"Plain"], "2"]}], ")"}], 
       RowBox[{"1", "/", "2"}]], "-", 
      SubsuperscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"], "2"], "\[ThinSpace]", 
      StyleBox["arsinh",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[CapitalLambda]", 
         StyleBox["LL",
          FontSlant->"Plain"]], "/", 
        SubscriptBox["\[CapitalDelta]", 
         StyleBox["LL",
          FontSlant->"Plain"]]}], ")"}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"2", 
      SuperscriptBox["\[Pi]", "2"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "18ae0345-8d39-4269-ad7b-2bad4793ac8e"],
 ", which decreases from ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"], "2"], "/", 
    RowBox[{"(", 
     RowBox[{"2", 
      SuperscriptBox["\[Pi]", "2"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8a42f955-e07d-4c3a-99eb-5a6b8257dc9a"],
 " as ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalDelta]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ca8ced35-8ac3-450e-90bb-72638ac35a6a"],
 " grows: at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Mu]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "21f62f30-9543-454d-9167-dd7c710f4615"],
 " a gap exists only above the critical coupling ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["crit",
      FontSlant->"Plain"]], "\[LongEqual]", "2", 
    SuperscriptBox["\[Pi]", "2"], "/", 
    SubsuperscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0da27866-b486-4ea7-b0b9-0570dc94ed8b"],
 " (below it the vacuum stays normal, above it the vacuum itself condenses). \
For ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Mu]", 
     StyleBox["LL",
      FontSlant->"Plain"]], ">", "0"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "55a350a5-27ab-4b00-839c-19f69d06d617"],
 " the arsinh terms grow like ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["ln",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{"1", "/", 
      SubscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "52b566e8-815f-49e8-87a0-77a363e02883"],
 " as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[RightArrow]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2f5256ae-c8b0-4f7a-978d-9694678a74a1"],
 ", with the coefficient ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    SubsuperscriptBox["\[Mu]", 
     StyleBox["LL",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "593a2006-45e1-4467-a782-ae608d5549be"],
 " (the Fermi surface), so a solution exists for every attractive coupling. \
With ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[PlusMinus]"], 
    RowBox[{"(", 
     SubscriptBox["\[CapitalLambda]", 
      StyleBox["LL",
       FontSlant->"Plain"]], ")"}], "\[RightArrow]", 
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[PlusMinus]", 
    SubscriptBox["\[Mu]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dab1b27f-5607-4705-944e-cdb82aa7b458"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["arsinh",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[CapitalLambda]", 
         StyleBox["LL",
          FontSlant->"Plain"]], "\[PlusMinus]", 
        SubscriptBox["\[Mu]", 
         StyleBox["LL",
          FontSlant->"Plain"]]}], ")"}], "/", 
      SubscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}], "\[RightArrow]", 
    StyleBox["ln",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{"2", 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[CapitalLambda]", 
         StyleBox["LL",
          FontSlant->"Plain"]], "\[PlusMinus]", 
        SubscriptBox["\[Mu]", 
         StyleBox["LL",
          FontSlant->"Plain"]]}], ")"}], "/", 
      SubscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3c9e0f6d-22a3-4829-b229-1dd21bc5cf34"],
 " the gap equation becomes ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["\[CapitalLambda]", 
       StyleBox["LL",
        FontSlant->"Plain"], "2"], "-", "3", 
      SubsuperscriptBox["\[Mu]", 
       StyleBox["LL",
        FontSlant->"Plain"], "2"], "+", 
      SubsuperscriptBox["\[Mu]", 
       StyleBox["LL",
        FontSlant->"Plain"], "2"], "\[ThinSpace]", 
      StyleBox["ln",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       RowBox[{"4", 
        RowBox[{"(", 
         RowBox[{
          SubsuperscriptBox["\[CapitalLambda]", 
           StyleBox["LL",
            FontSlant->"Plain"], "2"], "-", 
          SubsuperscriptBox["\[Mu]", 
           StyleBox["LL",
            FontSlant->"Plain"], "2"]}], ")"}], "/", 
        SubsuperscriptBox["\[CapitalDelta]", 
         StyleBox["LL",
          FontSlant->"Plain"], "2"]}], ")"}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"2", 
      SuperscriptBox["\[Pi]", "2"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a1c4bba0-4e8e-4f7f-b070-f07677f05ab3"],
 ", whose solution is the weak-coupling gap of the theory of Bardeen, Cooper \
and Schrieffer (BCS),"
}], "Text",ExpressionUUID->"43129657-c82a-4925-9802-a55e84150297"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[CapitalDelta]", 
    StyleBox["LL",
     FontSlant->"Plain"]], "\[LongEqual]", "2", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["\[CapitalLambda]", 
       StyleBox["LL",
        FontSlant->"Plain"], "2"], "-", 
      SubsuperscriptBox["\[Mu]", 
       StyleBox["LL",
        FontSlant->"Plain"], "2"]}], ")"}], 
    RowBox[{"1", "/", "2"}]], "\[ThinSpace]", 
   StyleBox["exp",
    FontSlant->"Plain"], 
   RowBox[{"(", 
    RowBox[{"-", 
     FractionBox["3", "2"]}], ")"}], "\[ThinSpace]", 
   StyleBox["exp",
    FontSlant->"Plain"], 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       SuperscriptBox["\[Pi]", "2"], 
       SubsuperscriptBox["\[Mu]", 
        StyleBox["LL",
         FontSlant->"Plain"], "2"]]}], 
     RowBox[{"(", 
      RowBox[{
       FractionBox["1", 
        SubscriptBox[
         StyleBox["G", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"]]], "-", 
       FractionBox["1", 
        SubsuperscriptBox[
         StyleBox["G", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], 
         StyleBox["crit",
          FontSlant->"Plain"]]]}], ")"}]}], ")"}]}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"aa370571-8a14-4883-a31e-92f332b5b500"],

Cell[TextData[{
 "which is exponentially small in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "70b70265-e084-43a4-8e40-b7b482bab28d"],
 ". The terms neglected in this limit are of the order ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"], "2"], "\[ThinSpace]", 
    StyleBox["ln",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[CapitalLambda]", 
       StyleBox["LL",
        FontSlant->"Plain"]], "/", 
      SubscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bae63e3f-1c47-49fe-9896-09838efd6a54"],
 "; carried through the solution, they give the BCS form a relative error of \
the size ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"], "2"], "/", 
      RowBox[{"(", 
       RowBox[{"2", 
        SubsuperscriptBox["\[Mu]", 
         StyleBox["LL",
          FontSlant->"Plain"], "2"]}], ")"}]}], ")"}], "\[ThinSpace]", 
    StyleBox["ln",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[CapitalLambda]", 
       StyleBox["LL",
        FontSlant->"Plain"]], "/", 
      SubscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7bd827a7-f6c2-46f9-b315-1811abab0b50"],
 ". Check AS-5 has four parts, all with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f2115847-a86b-4b23-a085-38a34acd05c0"],
 ": (1) the closed form against a numerical quadrature of the integral, for \
six pairs of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Mu]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "49bef2e0-436e-449d-8968-e7c080282b37"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalDelta]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b646de55-7462-4a22-9266-8896e5d9a8ec"],
 "; (2) the critical coupling; (3) the gaps that the closed form gives by \
bisection, inserted in the integral computed by quadrature, for the three \
chemical potentials ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Mu]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0", ",", "0.3", ",", "0.6"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ec019549-9b18-46f3-9c9d-dc1841f5bfb9"],
 " and the four couplings ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "/", 
    SubsuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["crit",
      FontSlant->"Plain"]], "\[LongEqual]", "0.6", ",", "1.2", ",", "1.8", ",",
     "2.4"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "621018ad-b9ff-48fa-95f0-9a0b8c2acf1d"],
 " (of these twelve cases eleven have a gap; at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Mu]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3c6b4030-625e-4eda-8047-376724166c5b"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.6", "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["crit",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8503aeb0-4bd2-4074-aa4a-e470c23f424f"],
 " there is none); (4) the BCS form at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Mu]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0.3"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b041e498-6fb7-405d-8b99-be398067e53c"],
 ", whose relative deviation must be smaller than twice the size of the \
leading correction. The quadrature is the Gauss-Legendre rule with 32 nodes \
on every panel of a division of the interval from 0 to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalLambda]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4718909a-2318-4b8f-9165-5f0ed59a5a8c"],
 ". The function ",
 StyleBox["t2gaussLegendre",
  FontFamily->"Source Code Pro"],
 " computes the nodes, which are the zeros of the Legendre polynomial of the \
degree 32, by Newton's method, and their weights; with them the rule is exact \
for every polynomial up to the degree 63. The panels are 64 equal ones, \
refined towards the Fermi momentum ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["k", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubscriptBox["\[Mu]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dff3e426-c0d5-4648-a258-37d2b2230ca5"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SubsuperscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "-"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b9428a67-450f-4a66-9254-52bb41c40c51"],
 " has its sharp maximum ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a4bead07-3c62-4579-a17b-f5167ff4af4c"],
 " (function ",
 StyleBox["t2gapIntegralQuad",
  FontFamily->"Source Code Pro"],
 "). Figure 4(c) shows the gap as a function of the coupling."
}], "Text",ExpressionUUID->"05ac766f-4faa-4e2d-ae1d-a6dfe8022319"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"the", " ", "Gauss"}], "-", 
      RowBox[{"Legendre", " ", "nodes", " ", "and", " ", "weights", " ", 
       RowBox[{"on", " ", "[", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "1"}], "]"}]}]}], ":", " ", 
     RowBox[{
      RowBox[{"Newton", "'"}], "s", " ", "method", " ", "on", " ", "the", " ",
       "Legendre", " ", "polynomial", " ", "of", " ", "the", " ", "degree", " ",
       "nodes"}]}], ",", "\n", "   ", 
    RowBox[{
     RowBox[{
     "which", " ", "is", " ", "computed", " ", "with", " ", "its", " ", 
      "three"}], "-", 
     RowBox[{"term", " ", "recurrence", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{
         "leg0", " ", "is", " ", "the", " ", "polynomial", " ", "of", " ", 
          "the", " ", "degree", " ", "j"}], " ", "+", " ", "1"}], ",", " ", 
        RowBox[{"leg1", " ", "of", " ", "the", " ", "degree", " ", "j"}]}], 
       ")"}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"t2gaussLegendre", "[", "nodes_Integer", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"nodeX", " ", "=", " ", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0.", ",", " ", "nodes"}], "]"}]}], ",", " ", 
         RowBox[{"nodeW", " ", "=", " ", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0.", ",", " ", "nodes"}], "]"}]}], ",", " ", "z", ",", 
         " ", "zOld", ",", " ", "leg0", ",", " ", "leg1", ",", " ", "leg2", ",",
          " ", "deriv"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"Do", "[", "\n", "    ", 
         RowBox[{
          RowBox[{
           RowBox[{"z", " ", "=", " ", 
            RowBox[{"Cos", "[", 
             RowBox[{"Pi", " ", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"i", " ", "+", " ", "0.75"}], ")"}], "/", 
               RowBox[{"(", 
                RowBox[{"nodes", " ", "+", " ", "0.5"}], ")"}]}]}], "]"}]}], ";",
            "\n", "    ", 
           RowBox[{"Do", "[", "\n", "     ", 
            RowBox[{
             RowBox[{
              RowBox[{"leg0", " ", "=", " ", "1."}], ";", " ", 
              RowBox[{"leg1", " ", "=", " ", "0."}], ";", "\n", "     ", 
              RowBox[{"Do", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"leg2", " ", "=", " ", "leg1"}], ";", " ", 
                 RowBox[{"leg1", " ", "=", " ", "leg0"}], ";", " ", 
                 RowBox[{"leg0", " ", "=", " ", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"2.", " ", "j"}], " ", "+", " ", "1."}], ")"}], " ",
                     "z", " ", "leg1"}], " ", "-", " ", 
                    RowBox[{"j", " ", "leg2"}]}], ")"}], "/", 
                   RowBox[{"(", 
                    RowBox[{"j", " ", "+", " ", "1."}], ")"}]}]}]}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"j", ",", " ", "0", ",", " ", 
                  RowBox[{"nodes", " ", "-", " ", "1"}]}], "}"}]}], "]"}], ";",
               "\n", "     ", 
              RowBox[{"deriv", " ", "=", " ", 
               RowBox[{"nodes", " ", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"z", " ", "leg0"}], " ", "-", " ", "leg1"}], ")"}],
                  "/", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"z", " ", "z"}], " ", "-", " ", "1."}], 
                  ")"}]}]}]}], ";", "\n", "     ", 
              RowBox[{"zOld", " ", "=", " ", "z"}], ";", "\n", "     ", 
              RowBox[{"z", " ", "=", " ", 
               RowBox[{"zOld", " ", "-", " ", 
                RowBox[{"leg0", "/", "deriv"}]}]}], ";", "\n", "     ", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Abs", "[", 
                  RowBox[{"z", " ", "-", " ", "zOld"}], "]"}], " ", "<", " ", 
                 "1.*^-15"}], ",", " ", 
                RowBox[{"Break", "[", "]"}]}], "]"}]}], ",", "\n", "     ", 
             RowBox[{"{", "100", "}"}]}], "]"}], ";", "\n", "    ", 
           RowBox[{"(*", " ", 
            RowBox[{
             RowBox[{
             "the", " ", "derivative", " ", "at", " ", "the", " ", 
              "converged", " ", "node"}], ",", " ", 
             RowBox[{"for", " ", "the", " ", "weight"}]}], " ", "*)"}], "\n", 
           "    ", 
           RowBox[{"leg0", " ", "=", " ", "1."}], ";", " ", 
           RowBox[{"leg1", " ", "=", " ", "0."}], ";", "\n", "    ", 
           RowBox[{"Do", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"leg2", " ", "=", " ", "leg1"}], ";", " ", 
              RowBox[{"leg1", " ", "=", " ", "leg0"}], ";", " ", 
              RowBox[{"leg0", " ", "=", " ", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"2.", " ", "j"}], " ", "+", " ", "1."}], ")"}], " ",
                    "z", " ", "leg1"}], " ", "-", " ", 
                  RowBox[{"j", " ", "leg2"}]}], ")"}], "/", 
                RowBox[{"(", 
                 RowBox[{"j", " ", "+", " ", "1."}], ")"}]}]}]}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"j", ",", " ", "0", ",", " ", 
               RowBox[{"nodes", " ", "-", " ", "1"}]}], "}"}]}], "]"}], ";", 
           "\n", "    ", 
           RowBox[{"deriv", " ", "=", " ", 
            RowBox[{"nodes", " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"z", " ", "leg0"}], " ", "-", " ", "leg1"}], ")"}], "/", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"z", " ", "z"}], " ", "-", " ", "1."}], ")"}]}]}]}], ";",
            "\n", "    ", 
           RowBox[{
            RowBox[{"nodeX", "[", 
             RowBox[{"[", 
              RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}], " ", "=", " ", 
            
            RowBox[{"-", "z"}]}], ";", "\n", "    ", 
           RowBox[{
            RowBox[{"nodeW", "[", 
             RowBox[{"[", 
              RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}], " ", "=", " ", 
            
            RowBox[{"2.", "/", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1.", " ", "-", " ", 
                 RowBox[{"z", " ", "z"}]}], ")"}], " ", "deriv", " ", 
               "deriv"}], ")"}]}]}]}], ",", "\n", "    ", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", "0", ",", " ", 
            RowBox[{"nodes", " ", "-", " ", "1"}]}], "}"}]}], "]"}], ";", 
        "\n", "   ", 
        RowBox[{"{", 
         RowBox[{"nodeX", ",", " ", "nodeW"}], "}"}]}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
      "the", " ", "right", " ", "side", " ", "of", " ", "the", " ", "gap", " ",
        "equation", " ", "for", " ", "massless", " ", "spinor", " ", 
       "charges", " ", "in", " ", "closed", " ", "form", " ", 
       RowBox[{"(", 
        RowBox[{"the", " ", "displayed", " ", "formula"}], ")"}]}], ":", " ", 
      
      RowBox[{"lam", " ", "is", " ", "the", "\n", "   ", "cutoff"}]}], ",", 
     " ", 
     RowBox[{"chem", " ", "the", " ", "chemical", " ", "potential"}], ",", 
     " ", 
     RowBox[{"gap", " ", "the", " ", "gap"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2gapIntegralClosed", "[", 
      RowBox[{"lam_", ",", " ", "chem_", ",", " ", "gap_"}], "]"}], " ", ":=",
      " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ep", " ", "=", " ", 
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"lam", " ", "+", " ", "chem"}], ")"}], "^", "2"}], " ", 
            "+", " ", 
            RowBox[{"gap", "^", "2"}]}], "]"}]}], ",", " ", 
         RowBox[{"em", " ", "=", " ", 
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"lam", " ", "-", " ", "chem"}], ")"}], "^", "2"}], " ", 
            "+", " ", 
            RowBox[{"gap", "^", "2"}]}], "]"}]}]}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"lam", " ", "-", " ", 
             RowBox[{"3.", " ", "chem"}]}], ")"}], " ", "ep"}], " ", "+", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"lam", " ", "+", " ", 
             RowBox[{"3.", " ", "chem"}]}], ")"}], " ", "em"}], " ", "+", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2.", " ", "chem", " ", "chem"}], " ", "-", " ", 
             RowBox[{"gap", " ", "gap"}]}], ")"}], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"ArcSinh", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"lam", " ", "+", " ", "chem"}], ")"}], "/", "gap"}], 
              "]"}], " ", "+", " ", 
             RowBox[{"ArcSinh", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"lam", " ", "-", " ", "chem"}], ")"}], "/", "gap"}], 
              "]"}]}], ")"}]}]}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"4.", " ", "Pi", " ", "Pi"}], ")"}]}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
      "the", " ", "same", " ", "integral", " ", "for", " ", "the", " ", 
       "mass", " ", "m", " ", "by", " ", "composite", " ", "Gauss"}], "-", 
      RowBox[{"Legendre", " ", "quadrature", " ", "in", " ", "q"}]}], ",", 
     " ", 
     RowBox[{
     "with", " ", "panels", " ", "refined", " ", "geometrically", "\n", "   ",
       "towards", " ", "the", " ", "Fermi", " ", "momentum"}], ",", " ", 
     RowBox[{
      RowBox[{"where", " ", 
       RowBox[{"1", "/", 
        RowBox[{"E", "^", 
         RowBox[{"-", " ", "has"}]}]}], " ", "its", " ", "sharp", " ", 
       "maximum", " ", 
       RowBox[{"1", "/", "gap"}]}], ";", " ", 
      RowBox[{"gl", " ", "is", " ", "the", " ", "pair", " ", 
       RowBox[{"{", 
        RowBox[{"nodes", ",", " ", "weights"}], "}"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2gapIntegralQuad", "[", 
      RowBox[{
      "lam_", ",", " ", "chem_", ",", " ", "gap_", ",", " ", "m_", ",", " ", 
       "gl_List"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "integrand", ",", " ", "kf", ",", " ", "pts", ",", " ", "width", ",", 
         " ", 
         RowBox[{"total", " ", "=", " ", "0."}], ",", " ", "mid", ",", " ", 
         "half"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{
         RowBox[{"integrand", "[", "q_", "]"}], " ", ":=", " ", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"energy", " ", "=", " ", 
             RowBox[{"Sqrt", "[", 
              RowBox[{
               RowBox[{"q", " ", "q"}], " ", "+", " ", 
               RowBox[{"m", " ", "m"}]}], "]"}]}], "}"}], ",", "\n", "     ", 
           
           RowBox[{"q", " ", "q", " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"1.", "/", 
                RowBox[{"Sqrt", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"energy", " ", "+", " ", "chem"}], ")"}], "^", 
                   "2"}], " ", "+", " ", 
                  RowBox[{"gap", " ", "gap"}]}], "]"}]}], " ", "+", " ", 
               RowBox[{"1.", "/", 
                RowBox[{"Sqrt", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"energy", " ", "-", " ", "chem"}], ")"}], "^", 
                   "2"}], " ", "+", " ", 
                  RowBox[{"gap", " ", "gap"}]}], "]"}]}]}], ")"}], "/", 
             RowBox[{"(", 
              RowBox[{"2.", " ", "Pi", " ", "Pi"}], ")"}]}]}]}], "]"}]}], ";",
         "\n", "   ", 
        RowBox[{"kf", " ", "=", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"chem", " ", ">", " ", "m"}], ",", " ", 
           RowBox[{"Sqrt", "[", 
            RowBox[{
             RowBox[{"chem", " ", "chem"}], " ", "-", " ", 
             RowBox[{"m", " ", "m"}]}], "]"}], ",", " ", 
           RowBox[{"-", "1."}]}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"pts", " ", "=", " ", 
         RowBox[{"{", 
          RowBox[{"0.", ",", " ", "lam"}], "}"}]}], ";", "\n", "   ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"kf", " ", ">", " ", "0."}], " ", "&&", " ", 
           RowBox[{"kf", " ", "<", " ", "lam"}]}], ",", "\n", "    ", 
          RowBox[{
           RowBox[{"AppendTo", "[", 
            RowBox[{"pts", ",", " ", "kf"}], "]"}], ";", "\n", "    ", 
           RowBox[{"width", " ", "=", " ", 
            RowBox[{
             RowBox[{"Max", "[", 
              RowBox[{"gap", ",", " ", "1.*^-6"}], "]"}], "/", "4."}]}], ";", 
           "\n", "    ", 
           RowBox[{"While", "[", 
            RowBox[{
             RowBox[{"width", " ", "<", " ", "lam"}], ",", "\n", "     ", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"kf", " ", "-", " ", "width"}], " ", ">", " ", 
                 "0."}], ",", " ", 
                RowBox[{"AppendTo", "[", 
