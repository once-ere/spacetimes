 "."
}], "Text",ExpressionUUID->"a8fc1c5f-a0d2-44b7-ad31-ba922a747137"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"det", " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SubsuperscriptBox["k", "LL", "B"], "^", "2"}], " ", "+", " ", 
        RowBox[{
         RowBox[{
          SubsuperscriptBox["Z", "LL", "t"], "/", 
          SubsuperscriptBox["Z", "LL", "s"]}], " ", 
         RowBox[{
          SubsuperscriptBox["M", "LL", "W"], "^", "2"}]}]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SubsuperscriptBox["\[Omega]", "LL", "B"], "^", "2"}], " ", "-", " ", 
        
        RowBox[{
         SubsuperscriptBox["M", "LL", "W"], "^", "2"}]}], ")"}]}], " ", "-", 
     "\n", "   ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox["k", "LL", "B"], " ", 
        SubsuperscriptBox["\[Omega]", "LL", "B"]}], ")"}], "^", "2"}]}]}], 
   ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Solve", " ", "needs", " ", "a", " ", "symbol", " ", "as", " ", 
    RowBox[{"unknown", ":", " ", 
     RowBox[{
     "the", " ", "square", " ", "of", " ", "the", " ", "frequency", " ", "is",
       " ", "called", " ", "w"}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{"root", " ", "=", " ", 
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"det", " ", "/.", " ", 
       RowBox[{
        SubsuperscriptBox["\[Omega]", "LL", "B"], " ", "->", " ", 
        RowBox[{"Sqrt", "[", "w", "]"}]}]}], ")"}], " ", "==", " ", "0"}], ",",
     " ", "w"}], "]"}]}]}], "Input",
 CellLabel->
  "In[210]:=",ExpressionUUID->"b61438de-c58a-428f-a4a5-2e3079a9361d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"w", "\[Rule]", 
    FractionBox[
     RowBox[{
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox["k", "LL", "B"], ")"}], "2"], " ", 
       SubsuperscriptBox["Z", "LL", "s"]}], "+", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox["M", "LL", "W"], ")"}], "2"], " ", 
       SubsuperscriptBox["Z", "LL", "t"]}]}], 
     SubsuperscriptBox["Z", "LL", "t"]]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{4.004025486365652*^9},
 CellLabel->
  "Out[211]=",ExpressionUUID->"34ef088f-3a2b-460c-a4a6-2d443d4cf351"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-10\>\"", ",", 
    " ", "\"\<the determinant of the time and longitudinal equations vanishes \
exactly at omega_B^2 = M_W^2 + (Z_s/Z_t) k_B^2\>\"", ",", "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", "root", "]"}], " ", "==", " ", "1"}], " ", "&&", 
     " ", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"w", " ", "/.", " ", 
          RowBox[{"First", "[", "root", "]"}]}], ")"}], " ", "-", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           SubsuperscriptBox["M", "LL", "W"], "^", "2"}], " ", "+", " ", 
          RowBox[{
           RowBox[{
            SubsuperscriptBox["Z", "LL", "s"], "/", 
            SubsuperscriptBox["Z", "LL", "t"]}], " ", 
           RowBox[{
            SubsuperscriptBox["k", "LL", "B"], "^", "2"}]}]}], ")"}]}], "]"}],
       " ", "===", " ", "0"}]}], ",", "\n", "  ", 
    RowBox[{"Factor", "[", "det", "]"}]}], "]"}], ";"}]], "Input",
 CellLabel->
  "In[212]:=",ExpressionUUID->"d8608a44-3cd6-4094-b341-0914a3d7dacc"],

Cell[BoxData[
 StyleBox[
  TemplateBox[{
    StyleBox["\"PASS  \"", Bold, 
     RGBColor[0, 
      Rational[2, 3], 0], StripOnInput -> False], "\"S-10: \"", 
    "\"the determinant of the time and longitudinal equations vanishes \
exactly at omega_B^2 = M_W^2 + (Z_s/Z_t) k_B^2\"", "\"  -- \"", 
    RowBox[{"-", 
      FractionBox[
       RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
            SubsuperscriptBox["M", "LL", "W"], ")"}], "2"], " ", 
         RowBox[{"(", 
           RowBox[{
             RowBox[{
               SuperscriptBox[
                RowBox[{"(", 
                  SubsuperscriptBox["k", "LL", "B"], ")"}], "2"], " ", 
               SubsuperscriptBox["Z", "LL", "s"]}], "+", 
             RowBox[{
               SuperscriptBox[
                RowBox[{"(", 
                  SubsuperscriptBox["M", "LL", "W"], ")"}], "2"], " ", 
               SubsuperscriptBox["Z", "LL", "t"]}], "-", 
             RowBox[{
               SubsuperscriptBox["Z", "LL", "t"], " ", 
               SuperscriptBox[
                RowBox[{"(", 
                  SubsuperscriptBox["\[Omega]", "LL", "B"], ")"}], "2"]}]}], 
           ")"}]}], 
       SubsuperscriptBox["Z", "LL", "s"]]}]},
   "RowDefault"],
  StripOnInput->False,
  LineIndent->0]], "Print",
 CellChangeTimes->{4.0040254863678293`*^9},
