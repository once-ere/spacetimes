                    FontSlant->"Plain"]], ")"}]}]},
                {
                 RowBox[{
                  SubscriptBox[
                   StyleBox["P",
                    FontFamily->"Helvetica",
                    FontSlant->"Plain"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]], 
                  SuperscriptBox[
                   RowBox[{"(", 
                    SubsuperscriptBox[
                    OverscriptBox[
                    StyleBox["u", "TI"], "\[RightVector]"], 
                    StyleBox["LL",
                    FontSlant->"Plain"], 
                    StyleBox["f",
                    FontSlant->"Plain"]], ")"}], "\[Dagger]"]}], "0"}
               },
               
               GridBoxAlignment->{
                "Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
               GridBoxSpacings->{"Columns" -> {
                   Offset[0.27999999999999997`], {
                    Offset[0.7]}, 
                   Offset[0.27999999999999997`]}, "Rows" -> {
                   Offset[0.2], {
                    Offset[0.4]}, 
                   Offset[0.2]}}], "\[NoBreak]", ")"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "c328d37b-fc3d-470a-8045-33646b29e172"],
           ", where ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubscriptBox[
               StyleBox["P",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"]], 
              RowBox[{"(", 
               SubsuperscriptBox[
                OverscriptBox[
                 StyleBox["u", "TI"], "\[RightVector]"], 
                StyleBox["LL",
                 FontSlant->"Plain"], 
