Cell["\<\
S-1 and S-2: every TeX item was converted into boxes (no item failed), and \
every symbolized box is now read as one atomic symbol.\
\>", "Text",ExpressionUUID->"6da7dccd-198b-4c9a-b052-4d477d0ee479"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-1\>\"", ",", 
    " ", "\"\<every one of the TeX items of the registry is converted into a \
box structure\>\"", ",", "\n", "  ", 
    RowBox[{"AllTrue", "[", 
     RowBox[{"items", ",", " ", 
      RowBox[{
       RowBox[{"FreeQ", "[", 
        RowBox[{
         RowBox[{"#", "[", "\"\<boxes\>\"", "]"}], ",", " ", 
         RowBox[{"$Failed", " ", "|", " ", "Null"}]}], "]"}], " ", "&"}]}], 
     "]"}], ",", " ", 
    RowBox[{"Length", "[", "items", "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-2\>\"", ",", 
    " ", "\"\<every symbolized box is read as one atomic symbol (head Symbol)\
\>\"", ",", "\n", "  ", 
    RowBox[{"AllTrue", "[", 
     RowBox[{"symbolTable", ",", " ", 
      RowBox[{
       RowBox[{"MatchQ", "[", 
        RowBox[{
         RowBox[{"#", "[", "\"\<symbol\>\"", "]"}], ",", " ", 
         RowBox[{"HoldComplete", "[", "_Symbol", "]"}]}], "]"}], " ", "&"}]}],
      "]"}], ",", "\n", "  ", 
    RowBox[{"Count", "[", 
     RowBox[{"symbolTable", ",", " ", 
      RowBox[{"r_", " ", "/;", " ", 
       RowBox[{"MatchQ", "[", 
        RowBox[{
         RowBox[{"r", "[", "\"\<symbol\>\"", "]"}], ",", " ", 
         RowBox[{"HoldComplete", "[", "_Symbol", "]"}]}], "]"}]}]}], "]"}]}], 
   "]"}], ";"}]}], "Input",
 CellLabel->
  "In[174]:=",ExpressionUUID->"dc829978-a4cc-4ed5-9654-15e5d0bce9c5"],

