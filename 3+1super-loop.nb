                  RowBox[{
                    SubscriptBox[
                    OverscriptBox[
                    StyleBox["d", "TI"], "\[RightVector]"], "LL"], 
                    "\[LongEqual]", 
                    RowBox[{"(", 
                    RowBox[{
                    SubsuperscriptBox[
                    StyleBox["d", "TI"], "LL", "1"], ",", 
                    SubsuperscriptBox[
                    StyleBox["d", "TI"], "LL", "2"], ",", 
                    SubsuperscriptBox[
                    StyleBox["d", "TI"], "LL", "3"]}], ")"}], "\[Element]", 
                    SuperscriptBox[
                    StyleBox["C", FontSlant -> "Plain"], "3"]}], 
                  TraditionalForm], "\" with \"", 
                 FormBox[
                  FractionBox[
                   RowBox[{
                    SubsuperscriptBox[
                    StyleBox["d", "TI"], "LL", "\[Iota]"], "\[LongEqual]", 
