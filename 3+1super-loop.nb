                 TagBox[
                  StyleBox["b", FontWeight -> "Bold", FontSlant -> "Plain"], 
                  "SL31Bold"], "\[Prime]"]},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              StyleBox["\<\"aH bS cH dS bS'\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[Cell[TextData[{
               "bi-quaternions: elements of ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  StyleBox["\[DoubleStruckCapitalC]",
                   FontSlant->"Plain"], "\[CircleTimes]", 
                  StyleBox["\[DoubleStruckCapitalH]",
                   FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "d3312cc6-e106-46c4-a0d2-edcbe46f22bd"],
               ", the complex combinations of ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubscriptBox[
                   StyleBox["e",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], "0"], ",", 
                  SubscriptBox[
                   StyleBox["e",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], "1"], ",", 
                  SubscriptBox[
                   StyleBox["e",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], "2"], ",", 
                  SubscriptBox[
                   StyleBox["e",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], "3"]}], TraditionalForm]], 
