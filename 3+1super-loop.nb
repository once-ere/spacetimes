                 RowBox[{"dinfT", " ", "dinfT"}], " ", "-", " ", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"nu", " ", "-", " ", "level"}], ")"}], "^", "2"}],
                   "/", 
                  RowBox[{"(", 
                   RowBox[{"ellT", " ", "ellT"}], ")"}]}]}]}], "]"}], ";", 
              " ", 
              RowBox[{"level", " ", "+=", " ", "1."}]}]}], "]"}], ";", "\n", 
           "    ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "[", "found", "]"}], " ", "!=", " ", 
              RowBox[{"Length", "[", "expect", "]"}]}], ",", " ", 
             RowBox[{"as8CountOk", " ", "=", " ", "False"}]}], "]"}], ";", 
           "\n", "    ", 
           RowBox[{"Do", "[", 
            RowBox[{
             RowBox[{"as8DevPT", " ", "=", " ", 
              RowBox[{"Max", "[", 
               RowBox[{"as8DevPT", ",", " ", 
                RowBox[{"Abs", "[", 
                 RowBox[{
                  RowBox[{"found", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], " ", "-", " ", 
                  RowBox[{"expect", "[", 
                   RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], "]"}]}], ",", 
             " ", 
             RowBox[{"{", 
              RowBox[{"i", ",", " ", 
               RowBox[{"Min", "[", 
                RowBox[{
                 RowBox[{"Length", "[", "found", "]"}], ",", " ", 
                 RowBox[{"Length", "[", "expect", "]"}]}], "]"}]}], "}"}]}], 
            "]"}], ";", "\n", "    ", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"as8Counts", ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"dinfT", " ", "ellT"}], ",", " ", "sgn", ",", " ", 
               RowBox[{"Length", "[", "found", "]"}]}], "}"}]}], "]"}]}]}], 
         "]"}], ",", "\n", "   ", 
        RowBox[{"{", 
         RowBox[{"sector", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1."}], ",", " ", "0."}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"1.", ",", " ", 
              RowBox[{"-", "1."}]}], "}"}]}], "}"}]}], "}"}]}], "]"}], ",", 
      "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"kink", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1.", ",", " ", "1."}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"2.5", ",", " ", "1."}], "}"}]}], "}"}]}], "}"}]}], "]"}], 
    ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<AS-8\>\"", ",", 
     " ", "\"\<the square of the operator and the complete spectrum of the \
bound states of a wall (case C): with mu = 0, no gauge fields, dvec = (0, 0, \
Delta(x_LL^1)) real and the plane wave exp(i (q^2 x_LL^2 + q^3 x_LL^3)) along \
the wall, H_DB^2 = (-d^2/d(x_LL^1)^2 + (q^2)^2 + (q^3)^2 + m^2 + Delta^2) \
1_16 + (d Delta/d x_LL^1) Qmat_K with the constant matrix Qmat_K = [[0, -i \
alpha_LL^1 Kch_3^dag], [-i alpha_LL^1 Kch_3, 0]], which is Hermitian, squares \
to the unit matrix and has the trace 0 (tolerance 1e-13), because alpha_LL^j \
Kch_3^dag = -Kch_3^dag conj(alpha_LL^j) for j = 1, 2, 3 (tolerance 1e-13); \
the identity is checked by applying H_DB twice to a Gaussian times a random \
16-component vector, with exact derivatives, for 50 random kinks Delta = \
Delta_inf tanh(x_LL^1/ell_K), points and momenta (m = 0.4; tolerance 1e-11); \
the bound states of the two scalar operators -d^2/d(x_LL^1)^2 + Delta^2 - d \
Delta/d x_LL^1 (the eigenvalue -1 of Qmat_K) and -d^2/d(x_LL^1)^2 + Delta^2 + \
d Delta/d x_LL^1 (the eigenvalue +1) are those of Poeschl-Teller wells, \
Delta_inf^2 - (Delta_inf - k_K/ell_K)^2 for the integers k_K with 0 <= k_K < \
Delta_inf ell_K (eigenvalue -1) and 1 <= k_K < Delta_inf ell_K (eigenvalue \
+1): finite differences with 4000 and 8001 points on (-20, 20), extrapolated, \
give exactly these bound states, and no others below the threshold \
Delta_inf^2, for Delta_inf ell_K = 1 and 2.5 (ell_K = 1; tolerance 1e-6); \
hence the bound states of the wall have the energies +-(m^2 + (q^2)^2 + \
(q^3)^2 + 2 k_K Delta_inf/ell_K - k_K^2/ell_K^2)^(1/2)\>\"", ",", "\n", "  ", 
     
     RowBox[{
      RowBox[{"as8QkDev", " ", "<", " ", "1*^-13"}], " ", "&&", " ", 
      RowBox[{"as8RelDev", " ", "<", " ", "1*^-13"}], " ", "&&", " ", 
      RowBox[{"as8DevSq", " ", "<", " ", "1*^-11"}], " ", "&&", " ", 
      RowBox[{"as8DevPT", " ", "<", " ", "1*^-6"}], " ", "&&", " ", 
      "as8CountOk"}], ",", "\n", "  ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<deviations: Qmat_K \>\"", ",", " ", 
        RowBox[{"asSci", "[", "as8QkDev", "]"}], ",", 
        " ", "\"\<, relation \>\"", ",", " ", 
        RowBox[{"asSci", "[", "as8RelDev", "]"}], ",", 
        " ", "\"\<, square \>\"", ",", " ", 
        RowBox[{"asSci", "[", "as8DevSq", "]"}], ",", 
        " ", "\"\<, bound states \>\"", ",", " ", 
        RowBox[{"asSci", "[", "as8DevPT", "]"}], ",", " ", "\"\<; \>\"", ",", 
        "\n", "    ", 
        RowBox[{"Row", "[", 
         RowBox[{"Riffle", "[", 
          RowBox[{
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Row", "[", 
               RowBox[{"{", 
                RowBox[{"\"\<Delta_inf ell_K = \>\"", ",", " ", 
                 RowBox[{"asFix", "[", 
                  RowBox[{
                   RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", " ", "1"}], "]"}], ",",
                  " ", "\"\<, Qmat_K = \>\"", ",", " ", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], " ", ">", " ", "0"}], ",",
                    " ", "\"\<+1\>\"", ",", " ", "\"\<-1\>\""}], "]"}], ",", 
                 " ", "\"\<: \>\"", ",", " ", 
                 RowBox[{"#", "[", 
                  RowBox[{"[", "3", "]"}], "]"}], ",", " ", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "3", "]"}], "]"}], " ", "==", " ", "1"}], ",",
                    " ", "\"\< bound state\>\"", ",", 
                   " ", "\"\< bound states\>\""}], "]"}]}], "}"}], "]"}], " ",
               "&"}], ",", " ", "as8Counts"}], "]"}], ",", 
           " ", "\"\<; \>\""}], "]"}], "]"}], ",", "\n", 
        "    ", "\"\< (original: 0.0e0, 0.0e0, 9.9e-16, 9.2e-9; 1, 0, 3 and 2 \
bound states)\>\""}], "}"}], "]"}]}], "]"}]}]}]], "Input",
 CellLabel->
  "In[745]:=",ExpressionUUID->"712bf24c-036c-46a2-a005-c6f307eb94b5"],

Cell[BoxData[
 StyleBox[
  TemplateBox[{
    StyleBox["\"PASS  \"", Bold, 
     RGBColor[0, 
      Rational[2, 3], 0], StripOnInput -> False], "\"AS-8: \"", 
    "\"the square of the operator and the complete spectrum of the bound \
states of a wall (case C): with mu = 0, no gauge fields, dvec = (0, 0, \
Delta(x_LL^1)) real and the plane wave exp(i (q^2 x_LL^2 + q^3 x_LL^3)) along \
the wall, H_DB^2 = (-d^2/d(x_LL^1)^2 + (q^2)^2 + (q^3)^2 + m^2 + Delta^2) \
1_16 + (d Delta/d x_LL^1) Qmat_K with the constant matrix Qmat_K = [[0, -i \
alpha_LL^1 Kch_3^dag], [-i alpha_LL^1 Kch_3, 0]], which is Hermitian, squares \
to the unit matrix and has the trace 0 (tolerance 1e-13), because alpha_LL^j \
Kch_3^dag = -Kch_3^dag conj(alpha_LL^j) for j = 1, 2, 3 (tolerance 1e-13); \
the identity is checked by applying H_DB twice to a Gaussian times a random \
16-component vector, with exact derivatives, for 50 random kinks Delta = \
Delta_inf tanh(x_LL^1/ell_K), points and momenta (m = 0.4; tolerance 1e-11); \
the bound states of the two scalar operators -d^2/d(x_LL^1)^2 + Delta^2 - d \
Delta/d x_LL^1 (the eigenvalue -1 of Qmat_K) and -d^2/d(x_LL^1)^2 + Delta^2 + \
d Delta/d x_LL^1 (the eigenvalue +1) are those of Poeschl-Teller wells, \
Delta_inf^2 - (Delta_inf - k_K/ell_K)^2 for the integers k_K with 0 <= k_K < \
Delta_inf ell_K (eigenvalue -1) and 1 <= k_K < Delta_inf ell_K (eigenvalue \
+1): finite differences with 4000 and 8001 points on (-20, 20), extrapolated, \
give exactly these bound states, and no others below the threshold \
Delta_inf^2, for Delta_inf ell_K = 1 and 2.5 (ell_K = 1; tolerance 1e-6); \
hence the bound states of the wall have the energies +-(m^2 + (q^2)^2 + \
(q^3)^2 + 2 k_K Delta_inf/ell_K - k_K^2/ell_K^2)^(1/2)\"", 
    "\"  -- deviations: Qmat_K 0, relation 0, square 1.1e-15, bound states \
9.2e-9; Delta_inf ell_K = 1.0, Qmat_K = -1: 1 bound state; Delta_inf ell_K = \
1.0, Qmat_K = +1: 0 bound states; Delta_inf ell_K = 2.5, Qmat_K = -1: 3 bound \
states; Delta_inf ell_K = 2.5, Qmat_K = +1: 2 bound states (original: 0.0e0, \
0.0e0, 9.9e-16, 9.2e-9; 1, 0, 3 and 2 bound states)\""},
   "RowDefault"],
  StripOnInput->False,
  LineIndent->0]], "Print",
 CellChangeTimes->{4.004025510659305*^9},
 CellLabel->
  "During evaluation of \
In[745]:=",ExpressionUUID->"834d87ce-e233-4079-893e-1e8cd24bb78e"]
}, Open  ]],

Cell[TextData[{
 StyleBox["On the lattice: sixteen bound states, and the first-order effect \
of the Wilson term (check AS-9).",
  FontWeight->"Bold"],
 " A periodic lattice needs a second wall. The check uses a ring of the \
length 24 with a kink at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], "\[LongEqual]", "6"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8bb2b870-67fd-4a53-bca7-c2fcc9c8da1a"],
 " and an antikink at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], "\[LongEqual]", "18"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e414086f-dc02-42c8-b2ec-84202f23a1ac"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["x", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], "1"], ")"}], "\[LongEqual]", 
    StyleBox["tanh",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "1"], "-", "6"}], ")"}], "\[ThinSpace]", 
    StyleBox["tanh",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{"18", "-", 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "1"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e748c70f-1ec4-4a0b-b0d1-bed8ab50f24e"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Infinity]"], "\[LongEqual]", 
    SubsuperscriptBox["\[ScriptL]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "04b268ef-0eb4-4516-a047-e84547785c1c"],
 ", so only the states with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["k", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f651d814-d402-4175-8e71-93e037fb4dee"],
 " are bound), with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0.4"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2580ba0b-a2d7-40e3-951f-af444e055dfc"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Mu]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0bc7b11c-b6c5-4d6c-9ebf-614da61f3a9a"],
 ". On 60 sites (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[ScriptL]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["x",
      FontSlant->"Plain"]], "\[LongEqual]", "0.4"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e4865f22-558c-4c3a-bdf4-abbd8e785eae"],
 ") the lattice operator is a matrix of 960 rows, which ",
 StyleBox["t2eigh",
  FontFamily->"Source Code Pro"],
 " diagonalizes. It has exactly 16 eigenvalues inside 0.8 times the threshold \
",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["m", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "2"], "+", 
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox["\[CapitalDelta]", 
         StyleBox["LL",
          FontSlant->"Plain"], "\[Infinity]"], ")"}], "2"]}], ")"}], 
    RowBox[{"1", "/", "2"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c43e8ac0-22b6-466e-b580-8c79988b7341"],
 ": eight near ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", 
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b61ef4cf-46cf-4bfa-9235-dd550460f8e4"],
 " and eight near ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a5f8beca-ed8a-4989-8cd0-223f43e4d4f0"],
 ", four for each wall and sign, and the density of the eight positive ones \
sits on the two walls with the profile ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox["\[CurlyPhi]", 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["K",
       FontSlant->"Plain"]], ")"}], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "75c1f4fc-ee96-4f34-a4b8-a9476c77343b"],
 ". They lie slightly above ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f0cd8be1-fd6b-40bf-bbb6-798dc261b344"],
 " in magnitude, because of the Wilson term. To see by how much, the analytic \
bound state of the kink is put on the lattice, with the spinor ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Chi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["K",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c23d731f-1911-4942-810a-765bb54146aa"],
 " whose components 1 and 5 are ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SqrtBox["2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b43fbf85-3062-41ec-8786-380dba4b0a42"],
 " and whose other components are zero (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Chi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubsuperscriptBox["\[Chi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c34660f3-b590-46f2-bfc5-d5be8b981507"],
 ", because ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Beta]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d3009f4e-9dc0-4d1f-bfdb-0079e4e4d1aa"],
 " exchanges the first and the third Dirac component, which with isospin up \
are the components 1 and 5), and its Rayleigh quotient ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["R",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0e8e6f8a-cbc9-47b7-b13f-27605e369f81"],
 " is computed: the scalar product of the state with ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalH]",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["lat",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9d8b5b4e-43ab-43d1-9684-0f361f856a3b"],
 " applied to it, divided by the scalar product of the state with itself. In ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalH]",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["lat",
      FontSlant->"Plain"]], "-", 
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ea684b8c-8fe2-4eab-aca4-5d78832cc471"],
 " applied to the state the mass terms cancel as in the proof above; the \
terms with ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Alpha]", 
    StyleBox["LL",
     FontSlant->"Plain"], "1"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6dfba0bc-5cd6-41c5-8a1d-e434b477cbd3"],
 " and with the pair field contribute nothing to the Rayleigh quotient, \
because ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[Chi]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["K",
        FontSlant->"Plain"]], ")"}], "\[Dagger]"], 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], 
    SubsuperscriptBox["\[Chi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2b6c7752-5cf1-4f41-b408-d29353dd02a1"],
 " for an eigenvector of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Beta]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fad4a45f-5283-4943-8231-75358ca56a7c"],
 " (which anticommutes with ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Alpha]", 
    StyleBox["LL",
     FontSlant->"Plain"], "1"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e3b46ce3-46b8-4983-a3f4-ea6795ea094c"],
 "); the Wilson terms of the particle part and of the hole part add. After a \
summation by parts on the ring,"
}], "Text",ExpressionUUID->"a50bf6f0-9743-47c0-8a62-c0f0f00a980a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["R",
     FontSlant->"Plain"]], "\[LongEqual]", 
   SubscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], "+", 
   FractionBox[
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["W",
      FontSlant->"Plain"]], 
    RowBox[{"2", 
     SubsuperscriptBox["\[ScriptL]", 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["x",
       FontSlant->"Plain"]]}]], "\[ThinSpace]", 
   FractionBox[
    RowBox[{"\[Sum]", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox["\[CurlyPhi]", 
         StyleBox["LL",
          FontSlant->"Plain"], 
         StyleBox["K",
          FontSlant->"Plain"]], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            SubsuperscriptBox[
             StyleBox["s", "TI"], 
             StyleBox["LL",
              FontSlant->"Plain"], "1"], "+", "1"}], ")"}], 
          SubsuperscriptBox["\[ScriptL]", 
           StyleBox["LL",
            FontSlant->"Plain"], 
           StyleBox["x",
            FontSlant->"Plain"]]}], ")"}], "-", 
        SubsuperscriptBox["\[CurlyPhi]", 
         StyleBox["LL",
          FontSlant->"Plain"], 
         StyleBox["K",
          FontSlant->"Plain"]], 
        RowBox[{"(", 
         RowBox[{
          SubsuperscriptBox[
           StyleBox["s", "TI"], 
           StyleBox["LL",
            FontSlant->"Plain"], "1"], 
          SubsuperscriptBox["\[ScriptL]", 
           StyleBox["LL",
            FontSlant->"Plain"], 
           StyleBox["x",
            FontSlant->"Plain"]]}], ")"}]}], ")"}], "2"]}], 
    RowBox[{"\[Sum]", "\[ThinSpace]", 
     SubsuperscriptBox["\[CurlyPhi]", 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["K",
       FontSlant->"Plain"]], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox[
         StyleBox["s", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], "1"], 
        SubsuperscriptBox["\[ScriptL]", 
         StyleBox["LL",
          FontSlant->"Plain"], 
         StyleBox["x",
          FontSlant->"Plain"]]}], ")"}], "2"]}]]}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"c11fd2ba-ecb2-4d72-b4c4-adf5cbd4879f"],

Cell[TextData[{
 "where both sums run over the sites ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["s", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "1"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2a274e79-4bd3-4beb-af55-87bfb4dc8732"],
 " of the ring. For a small spacing the sums become integrals, and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["R",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "002bb5d8-0613-45ce-8469-0785ac1979c1"],
 " tends to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "519bb273-3368-4939-9b45-ab17cb9891f8"],
 " plus ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], 
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["W",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[ScriptL]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["x",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "101f1abe-a09c-42bd-84a1-b8e37f4bf0e3"],
 " times the ratio of the integral of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      StyleBox["d", "TI"], 
      SubsuperscriptBox["\[CurlyPhi]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["K",
        FontSlant->"Plain"]], "/", 
      StyleBox["d", "TI"], 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "1"]}], ")"}], "2"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3fea6d9c-a01a-486c-82b5-90a3178f4e97"],
 " to the integral of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox["\[CurlyPhi]", 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["K",
       FontSlant->"Plain"]], ")"}], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "78a4348a-d71c-4cd7-9780-18a3e556f259"],
 ". For ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CurlyPhi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]], "\[LongEqual]", "1", "/", "\[ThinSpace]", 
    StyleBox["cosh",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["x", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], "1"], ")"}]}], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0a8f1503-2388-4e35-b000-64c606c10053"],
 " the two integrals are ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "/", "3"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0e5ff94a-c7eb-4974-ac26-5a6e0aa0f81b"],
 " and ",
 Cell[BoxData[
  FormBox["2", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "41bc5109-7622-4849-ad4d-a7b16dd0dcc8"],
 ", so that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["R",
      FontSlant->"Plain"]], "\[RightArrow]", 
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "+", 
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["W",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[ScriptL]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["x",
      FontSlant->"Plain"]], "/", "6"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6ab34a8c-40ff-48bf-b4e1-34859662d424"],
 ": the Wilson term shifts the bound states at first order in the lattice \
spacing. This is the price for removing the doublers (check GS-16). The check \
verifies the displayed formula on rings with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[ScriptL]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["x",
      FontSlant->"Plain"]], "\[LongEqual]", "0.4", ",", "0.2", ",", "0.1", ",",
     "0.05"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b653c7b7-c521-46db-9355-d481cd31ceec"],
 ", the approach of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["R",
        FontSlant->"Plain"]], "-", 
      SubscriptBox[
       StyleBox["m", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["r", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["W",
        FontSlant->"Plain"]], 
      SubsuperscriptBox["\[ScriptL]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["x",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "657bcfff-afd8-45b2-8857-0eb14560e2a9"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", "6"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bd51cbea-537c-4f32-9450-14d1da3c7ae1"],
 " (with a difference that falls by a factor near 4 at every halving of the \
spacing), and the decrease of the relative residual of the state (the norm of \
",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalH]",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["lat",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ef00d1b1-309f-4e71-84d3-40271b84f5a7"],
 " applied to the state minus ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["R",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8f158ba4-cf67-4f31-940f-db0408767e5d"],
 " times the state, divided by the norm of the state)."
}], "Text",ExpressionUUID->"746c65be-091a-4471-bc69-146d31f8ef52"],

Cell[TextData[{
 "Finally the check compares the eigenvalues and the densities of the \
diagonalization at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[ScriptL]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["x",
      FontSlant->"Plain"]], "\[LongEqual]", "0.4"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "10dc86f1-3bf2-45c0-a8ef-2dc6796e8727"],
 " with the analytic state at second order in the residual of that state, by \
two theorems of perturbation theory. Take a normalized trial state. Its \
Rayleigh quotient is its scalar product with the operator applied to it, and \
its relative residual is the norm of the operator applied to the state minus \
the Rayleigh quotient times the state. Written in the eigenvectors of the \
operator, the state has components whose squared moduli are weights with the \
sum 1; with these weights the mean of the eigenvalues is the Rayleigh \
quotient, and the mean of the squared differences between the eigenvalues and \
the Rayleigh quotient is the square of the relative residual. Now let a group \
of eigenvalues be given, let the Rayleigh quotient lie between the nearest \
eigenvalue below the group and the nearest one above it, and call the \
distance the smallest difference between the Rayleigh quotient and an \
eigenvalue outside the group."
}], "Text",ExpressionUUID->"6984c8e9-a480-4580-ada3-ad05fe149287"],

Cell[TextData[{
 StyleBox["The theorem of Kato and Temple, for a group.",
  FontWeight->"Bold"],
 " An eigenvalue of the group is not larger than the Rayleigh quotient plus \
the square of the relative residual divided by the distance, and an \
eigenvalue of the group is not smaller than the Rayleigh quotient minus the \
same amount. Proof of the first half: suppose that every eigenvalue of the \
group exceeded the Rayleigh quotient by more than this amount. For every \
eigenvalue of the operator form the product of two differences: the \
eigenvalue minus the nearest eigenvalue below the group, and the eigenvalue \
minus the Rayleigh quotient minus the amount. For an eigenvalue at or below \
that neighbour both differences are negative or zero, and for every other \
eigenvalue both are positive, so no product is negative. But the mean of the \
products with the weights is the square of the relative residual, minus the \
amount times the difference between the Rayleigh quotient and the neighbour \
(the terms of first order in the differences from the Rayleigh quotient have \
the mean zero); this is zero or negative, because that difference is at least \
the distance. A mean of numbers that are not negative can be zero or negative \
only if every number with a weight is zero, that is, if the state lies in the \
eigenvectors of the neighbour; then its Rayleigh quotient would be the \
neighbour and not a number above it. This contradiction proves the first \
half; the second half follows in the same way with the nearest eigenvalue \
above the group."
}], "Text",ExpressionUUID->"3cec68bd-1ed2-405e-8b47-164dd262b39f"],

Cell[TextData[{
 StyleBox["The theorem of Davis and Kahan, for a group.",
  FontWeight->"Bold"],
 " The part of the trial state outside the space of the eigenvectors of the \
group has at most the norm of the relative residual divided by the distance. \
Proof: the operator minus the Rayleigh quotient multiplies every component of \
that part by a number of magnitude at least the distance, and the image of \
that part is a part of the image of the whole state, whose norm is the \
relative residual."
}], "Text",ExpressionUUID->"146e48ff-1711-4385-98c9-e2be5d6955b8"],

Cell[TextData[{
 "Here the group consists of the eight positive bound states, and the trial \
state is the analytic bound state on the ring of 60 sites. The check verifies \
that ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["R",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "30457776-dfbe-40d3-acab-f340aacdaf38"],
 " lies between the neighbours of the group. The moduli of the 16 eigenvalues \
inside 0.8 times the threshold differ among themselves only by rounding \
errors (the check prints this spread, the largest minus the smallest \
modulus), so that by the first theorem all of them lie within the square of \
the relative residual divided by the distance, plus the spread, of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["R",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "819f6afa-ef41-40cc-aa07-c0a7755d2431"],
 "; the check verifies it. It verifies the second theorem directly as well: \
the norm of the part of the analytic state outside the space of the eight \
eigenvectors is computed from the scalar products of the state with these \
eigenvectors. For the densities the check makes a requirement on the scale of \
the second theorem: the summed density of the eight eigenvectors and the \
analytic density of the two walls, each normalized to the sum 1 over the \
sites, are compared by their Bhattacharyya coefficient (the sum over the \
sites of the square root of their product, which is 1 for equal densities and \
smaller otherwise), and 1 minus this coefficient must be smaller than half \
the square of the relative residual divided by the distance (the leading term \
of 1 minus the cosine of the angle whose sine is that ratio). This is not a \
consequence of the theorem, because the analytic state of the check is one \
state of one wall. Figure 5 shows the pair field, the densities, the spectrum \
and the convergence."
}], "Text",ExpressionUUID->"c5e5cbc0-7a70-496f-9b64-527f81e5ad2f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"AS", "-", "9"}], ":", " ", 
     RowBox[{
     "a", " ", "ring", " ", "of", " ", "the", " ", "length", " ", "24", " ", 
      "with", " ", "a", " ", "kink", " ", "at", " ", 
      RowBox[{"x", "^", "1"}]}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{"6", " ", "and", " ", "an", " ", "antikink", " ", "at", " ", 
      RowBox[{"x", "^", "1"}]}], " ", "=", " ", "18"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"as9Ring", " ", "=", " ", "24."}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"as9Xk1", ",", " ", "as9Xk2"}], "}"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"6.", ",", " ", "18."}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"as9Profile", "[", "x_", "]"}], " ", ":=", " ", 
     RowBox[{"asCDinf", " ", 
      RowBox[{"Tanh", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"x", " ", "-", " ", "as9Xk1"}], ")"}], "/", "asCEllK"}], 
       "]"}], " ", 
      RowBox[{"Tanh", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"as9Xk2", " ", "-", " ", "x"}], ")"}], "/", "asCEllK"}], 
       "]"}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "distance", " ", "of", " ", "two", " ", "points", " ", "of", 
      " ", "the", " ", "ring"}], ",", " ", 
     RowBox[{
     "and", " ", "the", " ", "profile", " ", "phi_K", " ", "of", " ", "the", " ",
       "bound", " ", "state", " ", "of", " ", "a", " ", "wall", " ", "at", " ",
       "the", " ", "point", " ", "wall"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"as9Distance", "[", 
      RowBox[{"x_", ",", " ", "wall_"}], "]"}], " ", ":=", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"d", " ", "=", " ", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"x", " ", "-", " ", "wall"}], ",", " ", "as9Ring"}], 
          "]"}]}], "}"}], ",", " ", 
       RowBox[{"Min", "[", 
        RowBox[{"d", ",", " ", 
         RowBox[{"as9Ring", " ", "-", " ", "d"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"as9Phi", "[", 
      RowBox[{"x_", ",", " ", "wall_"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"Cosh", "[", 
       RowBox[{
        RowBox[{"as9Distance", "[", 
         RowBox[{"x", ",", " ", "wall"}], "]"}], "/", "asCEllK"}], "]"}], "^", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "asCDinf"}], " ", "asCEllK"}], ")"}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"(", "1", ")"}], " ", "the", " ", "dense", " ", "spectrum", " ",
       "at", " ", "dx"}], " ", "=", " ", 
     RowBox[{"0.4", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"60", " ", "sites"}], ",", " ", 
        RowBox[{"a", " ", "matrix", " ", "of", " ", "960", " ", "rows"}]}], 
       ")"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"as9N", " ", "=", " ", "60"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as9Ell", " ", "=", " ", 
     RowBox[{"as9Ring", "/", "as9N"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as9Lat", " ", "=", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<n\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"as9N", ",", " ", "1", ",", " ", "1"}], "}"}]}], ",", " ", 
       RowBox[{"\"\<ell\>\"", " ", "->", " ", "as9Ell"}], ",", " ", 
       RowBox[{"\"\<periodic\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"True", ",", " ", "False", ",", " ", "False"}], "}"}]}], ",",
        " ", 
       RowBox[{"\"\<wilson\>\"", " ", "->", " ", "1.0"}], ",", " ", 
       RowBox[{"\"\<mass\>\"", " ", "->", " ", "mass"}], ",", " ", 
       RowBox[{"\"\<mu\>\"", " ", "->", " ", "0."}]}], "|>"}]}], ";"}], "\n", 
   
   RowBox[{
    RowBox[{"as9Fields", " ", "=", " ", 
     RowBox[{"t2trivialFields", "[", "as9N", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"as9Fields", "[", 
        RowBox[{"[", 
         RowBox[{"\"\<d\>\"", ",", " ", "site"}], "]"}], "]"}], " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{"0.", ",", " ", "0.", ",", " ", 
         RowBox[{"as9Profile", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"site", " ", "-", " ", "1"}], ")"}], " ", "as9Ell"}], 
          "]"}]}], "}"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"site", ",", " ", "as9N"}], "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as9H", " ", "=", " ", 
     RowBox[{"t2dense", "[", 
      RowBox[{"as9Lat", ",", " ", "as9Fields"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"as9Ev", ",", " ", "as9Vec"}], "}"}], " ", "=", " ", 
     RowBox[{"t2eigh", "[", "as9H", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as9Threshold", " ", "=", " ", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"mass", " ", "mass"}], " ", "+", " ", 
       RowBox[{"asCDinf", " ", "asCDinf"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "places", " ", "of", " ", "the", " ", "eigenvalues", " ", 
      "inside", " ", "0.8", " ", "times", " ", "the", " ", "threshold"}], ",",
      " ", 
     RowBox[{
     "and", " ", "of", " ", "the", " ", "positive", " ", "ones", " ", "among",
       " ", "them"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"as9Inside", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"Length", "[", "as9Ev", "]"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"as9Ev", "[", 
           RowBox[{"[", "#", "]"}], "]"}], "]"}], " ", "<", " ", 
         RowBox[{"0.8", " ", "as9Threshold"}]}], " ", "&"}]}], "]"}]}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"as9Plus", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{"as9Inside", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"as9Ev", "[", 
          RowBox[{"[", "#", "]"}], "]"}], " ", ">", " ", "0"}], " ", "&"}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", "rows", " ", 
      RowBox[{"{", 
       RowBox[{"index", ",", " ", "E_qp"}], "}"}], " ", "of", " ", "Figure", " ",
       "5", 
      RowBox[{"(", "c", ")"}]}], ":", " ", 
     RowBox[{"the", " ", "index", " ", "counts", " ", "from", " ", "0"}]}], 
    " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"as9SpectrumRows", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"i", " ", "-", " ", "1"}], ",", " ", 
         RowBox[{"as9Ev", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], "}"}], ",", " ", 
