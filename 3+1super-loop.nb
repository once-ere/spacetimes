           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the function ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubscriptBox["\[CapitalXi]", 
               StyleBox["LL",
                FontSlant->"Plain"]], 
              RowBox[{"(", 
               SuperscriptBox[
                RowBox[{"(", 
                 SubsuperscriptBox[
                  StyleBox["M", "TI"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
                  StyleBox["q",
                   FontSlant->"Plain"]], ")"}], "2"], ")"}], "\[LongEqual]", 
              "2", "\[ThinSpace]", 
              SubscriptBox["\[Integral]", 
               RowBox[{
                SubscriptBox[
                 StyleBox["q", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"]], "<", 
                SubscriptBox["\[CapitalLambda]", 
                 StyleBox["LL",
                  FontSlant->"Plain"]]}]], "\[ThinSpace]", 
              SuperscriptBox[
               StyleBox["d", "TI"], "3"], 
              SubscriptBox[
               StyleBox["q", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"]], 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"2", "\[Pi]"}], ")"}], 
               RowBox[{"-", "3"}]], 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{
                 SubsuperscriptBox[
                  StyleBox["q", "TI"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], "2"], "+", 
                 SuperscriptBox[
                  RowBox[{"(", 
                   SubsuperscriptBox[
                    StyleBox["M", "TI"], 
                    StyleBox["LL",
                    FontSlant->"Plain"], 
                    StyleBox["q",
                    FontSlant->"Plain"]], ")"}], "2"]}], ")"}], 
               RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
            
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "e6635668-78af-4424-930f-9b032420d6cd"],
