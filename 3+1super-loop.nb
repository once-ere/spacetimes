  "Out[533]=",ExpressionUUID->"7fc66043-2838-4515-bf18-adb8a34f07f8"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"SL31Check", "[", 
  RowBox[{"\"\<GS-12\>\"", ",", 
   " ", "\"\<the printed formulas agree with the matrices that they describe: \
the entries of Ppair (symbolic d), of the blocks of sgen(u_p) and of Gamma_p, \
the expansions of the covariant derivatives, the sixteen equations of the \
Dirac-Bogoliubov-de Gennes system, the pair operators Pi and the eight exact \
equations, each evaluated for numbers assigned to its symbols and compared \
with the matrix computation (tolerance 1e-12)\>\"", ",", "\n", "  ", 
   RowBox[{
    RowBox[{"pdev", " ", "<", " ", "1*^-12"}], " ", "&&", " ", 
    RowBox[{"eqdev", " ", "<", " ", "1*^-12"}], " ", "&&", " ", 
    RowBox[{"eqdev2", " ", "<", " ", "1*^-12"}], " ", "&&", " ", 
    RowBox[{"pidev", " ", "<", " ", "1*^-12"}], " ", "&&", " ", 
    RowBox[{"eqdev3", " ", "<", " ", "1*^-12"}]}], ",", "\n", "  ", 
   RowBox[{"Row", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<largest deviations \>\"", ",", " ", "pdev", ",", 
      " ", "\"\<, \>\"", ",", " ", "eqdev", ",", " ", "\"\<, \>\"", ",", " ", 
      "eqdev2", ",", " ", "\"\<, \>\"", ",", " ", "pidev", ",", 
      " ", "\"\<, \>\"", ",", " ", "eqdev3", ",", 
      " ", "\"\< (original: 0.0e0, 4.0e-16, 3.4e-16, 0.0e0, 5.0e-16)\>\""}], 
     "}"}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[534]:=",ExpressionUUID->"90b0e4e0-347d-4c3a-9a6a-1f758ddd339b"],

Cell[BoxData[
 StyleBox[
  TemplateBox[{
    StyleBox["\"PASS  \"", Bold, 
     RGBColor[0, 
      Rational[2, 3], 0], StripOnInput -> False], "\"GS-12: \"", 
    "\"the printed formulas agree with the matrices that they describe: the \
entries of Ppair (symbolic d), of the blocks of sgen(u_p) and of Gamma_p, the \
expansions of the covariant derivatives, the sixteen equations of the \
Dirac-Bogoliubov-de Gennes system, the pair operators Pi and the eight exact \
equations, each evaluated for numbers assigned to its symbols and compared \
with the matrix computation (tolerance 1e-12)\"", 
    "\"  -- largest deviations 0., 3.55445e-16, 1.57009e-16, 1.11022e-16, \
2.28878e-16 (original: 0.0e0, 4.0e-16, 3.4e-16, 0.0e0, 5.0e-16)\""},
   "RowDefault"],
  StripOnInput->False,
  LineIndent->0]], "Print",
 CellChangeTimes->{4.00402549526431*^9},
 CellLabel->
  "During evaluation of \
In[534]:=",ExpressionUUID->"92411140-ab43-4451-aa3a-d4108bb32a47"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
GS-13: the time integration by IDA, compared with the exact solution\
\>", "Subsection",ExpressionUUID->"859673ad-2c5f-40ec-b697-fee82e9a9819"],

Cell[TextData[{
 "The original program checks its time integration on the lattice of GS-10 \
(",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", "\[Times]", "2", "\[Times]", "4"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "06eec27a-24da-43f9-8446-f0ade877aeac"],
 " sites with random links, potentials and pair fields; ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["cpx",
      FontSlant->"Plain"]], "\[LongEqual]", "384"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "91b58a2c-1cdf-46b4-a4bd-420101daad3a"],
 "). From a random initial state ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["w", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["lat",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e204136f-6bcc-4799-8669-1c63941cfece"],
 " of the norm 1, drawn from a generator of its own (seed 2026111713, so that \
the random numbers of the later checks are not shifted), it integrates the \
lattice equations with CVODE up to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "0"], "\[LongEqual]", "20"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7b94f51a-9232-4620-805b-467071108b70"],
 ", with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["tol",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox["10", 
     RowBox[{"-", "8"}]], ",", 
    SuperscriptBox["10", 
     RowBox[{"-", "10"}]], ",", 
    SuperscriptBox["10", 
     RowBox[{"-", "12"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "aee80233-7c57-4361-876a-45f53a324cba"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["tol",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["tol",
      FontSlant->"Plain"]], "/", "100"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fc8899ac-2fce-47fc-8a51-fcb633698889"],
 ", and compares the states at the 41 output times ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "0"], "\[LongEqual]", "0", ",", "0.5", ",", 
    "\[Ellipsis]", ",", "20"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d61cc5eb-7bbd-43da-82eb-de36949c1465"],
 " with the exact solution ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["w", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["ex",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "200b55ea-b7fb-427d-9d5e-f4be8f9a5265"],
 ": the sum over the eigenvectors of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalH]",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["lat",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f9ff5f3a-c509-488d-9d50-9aca66e3f658"],
 " of the eigenvector times its scalar product with the initial state times \
the phase factor of the angle ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     SubsuperscriptBox[
      StyleBox["E", "TI"], 
      RowBox[{
       StyleBox["LL",
        FontSlant->"Plain"], ",", 
       StyleBox["n", "TI"]}], 
      StyleBox["qp",
       FontSlant->"Plain"]]}], 
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "0"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bb564220-6ab5-421c-baa4-4d0fb95e2bf2"],
 " (eigensolver ",
 StyleBox["t2eigh",
  FontFamily->"Source Code Pro"],
 "). The quantity compared is the relative deviation ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Delta]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["rel",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7fbe4af7-fcf8-4959-902f-fc8bd6c704c3"],
 ", the norm of the difference between the computed and the exact state \
divided by the norm of the exact state. The notebook repeats the check with \
IDA in place of CVODE (functions ",
 StyleBox["t2evolveIDA",
  FontFamily->"Source Code Pro"],
 " and ",
 StyleBox["t2localErrorsIDA",
  FontFamily->"Source Code Pro"],
 " of chapter II.1.5): the same lattice, the same initial state, the same \
tolerances, the same output times."
}], "Text",ExpressionUUID->"7e76e01e-313d-4b5e-a7b7-824be798c79f"],

Cell[TextData[{
 "The check has four parts, for each of the three tolerances. (1) The exact \
local error ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Delta]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["loc",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "56169642-2dd3-432d-8150-a841ec0a7ea7"],
 " of every internal step is at most ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["loc",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["tol",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dfb90fa9-8232-45ee-b8a6-ab15c64bb5eb"],
 " times the norm of the state plus ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["tol",
      FontSlant->"Plain"]], 
    SqrtBox[
     RowBox[{"2", 
      SubsuperscriptBox[
       StyleBox["n", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["cpx",
        FontSlant->"Plain"]]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "eef98bd5-393e-44d5-90fe-2131b97ac11e"],
 ". Because the evolution is unitary, the deviation at the end of every \
internal step is then at most ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["err",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["st",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["loc",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7d624a6b-aadc-401e-9b21-bb23256b7ae0"],
 " (chapter II.1.5). (2) The states of ",
 StyleBox["NDSolve",
  FontFamily->"Source Code Pro"],
 " at the output times are the cubic Hermite polynomials of the stored values \
and derivatives (tolerance ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "12"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "59ddd55c-c006-4d38-a854-f127c4f21f52"],
 "), so that the bound ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["out",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1016904c-7a87-4196-9338-08cc37036124"],
 " of chapter II.1.5 holds for them, and the largest ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Delta]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["rel",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a683e717-7583-4f58-8ec2-372c38324e25"],
 " is at most ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["out",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "72b513c9-1dae-4347-9752-15b9f455badc"],
 " (the exact state has the norm 1, so the relative deviation is the \
deviation). (3) The largest deviation decreases from ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["tol",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox["10", 
     RowBox[{"-", "8"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7f4f1522-0936-455c-9ce7-28048eb243c2"],
 " to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "10"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
