             " ", "\"\<AS-\>\""}], "]"}], " ", "||", " ", 
           RowBox[{
            RowBox[{"#", "[", "\"\<name\>\"", "]"}], " ", "===", 
            " ", "\"\<T2-DATA-2\>\""}]}], " ", "&"}]}], "]"}]}], "]"}], ",", 
     " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"#", ",", " ", "Bold"}], "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<check\>\"", ",", " ", "\"\<result\>\"", ",", 
        " ", "\"\<statement\>\""}], "}"}]}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
