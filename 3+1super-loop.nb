              " ", "1"}], ",", " ", 
             RowBox[{"Continue", "[", "]"}]}], "]"}], ";", "\n", "    ", 
           RowBox[{"sp", " ", "=", " ", 
            RowBox[{"t2neighbour", "[", 
             RowBox[{"lat", ",", " ", "s", ",", " ", "j", ",", " ", "True"}], 
             "]"}]}], ";", " ", 
           RowBox[{"sm", " ", "=", " ", 
            RowBox[{"t2neighbour", "[", 
