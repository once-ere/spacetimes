                RowBox[{"\[GothicS]\[GothicL]", "(", "2", ")"}], "\", \"", 
                RowBox[{"\[GothicS]\[GothicU]", "(", "2", ")"}], "\", \"", 
                
                RowBox[{
                 "\[GothicS]\[GothicP]\[GothicI]\[GothicN]", "(", "7", ")"}], 
                "\", \"", 
                SubscriptBox["\[GothicG]", "2"], "\", \"", 
                RowBox[{
                  SubscriptBox["\[GothicG]", "2"], "(", 
                  "\[DoubleStruckCapitalC]", ")"}]},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              
              StyleBox["\<\"so(3,1) so(1,7) so(4,1) so(8) so(4,4) so(8,C) \
so(3) so(4) so(2,1) sl(2,R) sl(2) su(2) spin(7) g2 g2(C)\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[
              StyleBox[
               TemplateBox[{"\"Lie algebras: of the Lorentz groups of \"", 
                 FormBox[
                  RowBox[{"3", "+", "1"}], TraditionalForm], "\" and \"", 
                 FormBox[
                  RowBox[{"7", "+", "1"}], TraditionalForm], 
                 "\" dimensions; of the de Sitter group (signature of the \
Killing form: 4 positive, 6 negative); of the linear maps that preserve a \
definite real, a \"", 
                 FormBox[
                  RowBox[{"(", 
                    RowBox[{"4", ",", "4"}], ")"}], TraditionalForm], 
                 "\" and a complex quadratic form in eight dimensions; of the \
rotations of three-dimensional space and of four-dimensional Euclidean space; \
of the Lorentz group of \"", 
                 FormBox[
                  RowBox[{"2", "+", "1"}], TraditionalForm], 
                 "\" dimensions, equal to \"", 
                 FormBox[
                  RowBox[{
                    RowBox[{
                    StyleBox["s", "TI"], 
                    StyleBox["l", "TI"]}], "(", 
                    RowBox[{"2", ",", 
                    StyleBox["R", FontSlant -> "Plain"]}], ")"}], 
                  TraditionalForm], "\"; \"", 
                 FormBox[
                  RowBox[{
                    RowBox[{
                    StyleBox["s", "TI"], 
                    StyleBox["l", "TI"]}], "(", "2", ")"}], TraditionalForm], 
                 "\" the simple Lie algebra of dimension 3 over any field; \
\"", 
                 FormBox[
                  RowBox[{
                    RowBox[{
                    StyleBox["s", "TI"], 
                    StyleBox["u", "TI"]}], "(", "2", ")"}], TraditionalForm], 
                 "\" isospin; \"", 
                 FormBox[
                  RowBox[{
                    RowBox[{
                    StyleBox["s", "TI"], 
                    StyleBox["p", "TI"], 
                    StyleBox["i", "TI"], 
                    StyleBox["n", "TI"]}], "(", "7", ")"}], TraditionalForm], 
                 "\" of dimension 21; the exceptional Lie algebra \"", 
                 FormBox[
                  SubscriptBox[
                   StyleBox["g", "TI"], "2"], TraditionalForm], 
                 "\" (compact, dimension 14) and its complex form (real \
dimension 28)\""},
                "RowDefault"],
               StripOnInput->False,
               FontFamily->"Source Sans Pro",
               FontSize->9.5],
              ImageSize->290]},
            {
             PaneBox[
              
              TemplateBox[{
               "tr", "\", \"", "det", "\", \"", "diag", "\", \"", "Re", 
                "\", \"", "Im"},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              
              StyleBox["\<\"tr det diag Re Im exp ln sqrt sum int span \
dim\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[
              
              StyleBox["\<\"trace, determinant, the diagonal matrix with the \
listed entries, real part, imaginary part (also: the imaginary part of an \
algebra, the span of its imaginary units); plain text `exp`, `ln`, `sqrt`, \
`sum`, `int`, `span`, `dim`: the exponential, natural logarithm, square root, \
a sum, an integral, the set of real linear combinations, a dimension\"\>",
               StripOnInput->False,
               FontFamily->"Source Sans Pro",
               FontSize->9.5],
              ImageSize->290]},
            {
