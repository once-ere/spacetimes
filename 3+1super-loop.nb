  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "da693e4e-9eae-4f42-9b9e-1d1de65c7a79"],
 ", the exponential has the closed form ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      RowBox[{"-", 
       StyleBox["i", "TI"]}], 
      SubsuperscriptBox["\[ScriptL]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["x",
        FontSlant->"Plain"]], 
      SubsuperscriptBox[
       StyleBox["g", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["F",
        FontSlant->"Plain"]], 
      SubsuperscriptBox[
       StyleBox["A", "TI"], 
       RowBox[{
        StyleBox["LL",
         FontSlant->"Plain"], ",", 
        StyleBox["j", "TI"]}], 
       StyleBox["F",
        FontSlant->"Plain"]]}]], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["cos",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       RowBox[{
        FractionBox["1", "2"], 
        SubsuperscriptBox["\[ScriptL]", 
         StyleBox["LL",
          FontSlant->"Plain"], 
         StyleBox["x",
          FontSlant->"Plain"]], 
        SubsuperscriptBox[
         StyleBox["g", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], 
         StyleBox["v",
          FontSlant->"Plain"]], 
        RowBox[{"\[LeftBracketingBar]", 
         SubsuperscriptBox[
          OverscriptBox[
           StyleBox["A", "TI"], "\[RightVector]"], 
          RowBox[{
           StyleBox["LL",
            FontSlant->"Plain"], ",", 
           StyleBox["j", "TI"]}], 
          StyleBox["v",
           FontSlant->"Plain"]], "\[RightBracketingBar]"}]}], ")"}], 
      SubsuperscriptBox["\[Sigma]", "0", 
       StyleBox["LL",
        FontSlant->"Plain"]], "-", 
      StyleBox["i", "TI"], "\[ThinSpace]", 
      StyleBox["sin",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       RowBox[{
        FractionBox["1", "2"], 
        SubsuperscriptBox["\[ScriptL]", 
         StyleBox["LL",
          FontSlant->"Plain"], 
         StyleBox["x",
          FontSlant->"Plain"]], 
        SubsuperscriptBox[
         StyleBox["g", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], 
         StyleBox["v",
          FontSlant->"Plain"]], 
        RowBox[{"\[LeftBracketingBar]", 
         SubsuperscriptBox[
          OverscriptBox[
           StyleBox["A", "TI"], "\[RightVector]"], 
          RowBox[{
           StyleBox["LL",
            FontSlant->"Plain"], ",", 
           StyleBox["j", "TI"]}], 
          StyleBox["v",
           FontSlant->"Plain"]], "\[RightBracketingBar]"}]}], ")"}], "\[ThinSpace]", 
      UnderscriptBox["\[Sum]", "\[Iota]",
       LimitsPositioning->True], "\[ThinSpace]", 
      SubsuperscriptBox[
       StyleBox["A", "TI"], 
       RowBox[{
