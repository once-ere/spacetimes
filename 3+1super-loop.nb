          RowBox[{"t2adjoint", "[", "u2", "]"}]}], ";", "\n", "   ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{"worst4", " ", "=", " ", 
            RowBox[{"Max", "[", 
             RowBox[{"worst4", ",", " ", 
              RowBox[{"fro", "[", 
