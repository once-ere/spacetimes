Cell[CellGroupData[{

Cell["\<\
II.2 Item [1]: the field equations on the 3+1 manifold, and the checks GS-1 \
to GS-16 (program t2_fields)\
\>", "Section",ExpressionUUID->"751be14f-e594-47cc-8d1b-9bdf4d407776"],

Cell[TextData[{
 "The program t2_fields (t2fields/src/main.rs) builds every matrix of the \
field equations of the self-interacting spinor field ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "862722c1-1c7b-450a-a7cc-db2726c63c01"],
 " on ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[DoubleStruckCapitalR]",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    RowBox[{"1", ",", "3"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4d61f0aa-6a98-494b-bcb7-8cb290b3ffdf"],
 " and checks every statement made about them: checks GS-1 to GS-16. The \
rewriting below keeps the order of the original program, because the random \
numbers are drawn in that order from one generator with the seed 2026111707. \
Every check prints one line with PASS or FAIL; the statement is that of the \
original report, and the numbers in the details are the Wolfram Language \
results, followed (where the original report gives them) by the values of the \
original report."
}], "Text",ExpressionUUID->"37dcf05c-d209-47a1-998a-7bc35b61f3a4"],

Cell[TextData[{
 "The physics in brief. The covariant derivative is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Del]", 
     StyleBox["p", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubscriptBox["\[PartialD]", 
     StyleBox["p", "TI"]], "+", 
    SubsuperscriptBox["\[CapitalGamma]", 
     StyleBox["p", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "-", 
    StyleBox["i", "TI"], 
    SubscriptBox[
     StyleBox["A",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e0b5b970-d171-44c6-b58a-2cc5fea60334"],
 ", with the spin connection ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalGamma]", 
     StyleBox["p", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["s",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["u",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["LL",
        FontSlant->"Plain"], ",", 
       StyleBox["p", "TI"]}], "\[Omega]"], ")"}], "\[CircleTimes]", 
    SubsuperscriptBox["\[Sigma]", "0", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3ec50cbf-7d1d-4a48-a508-ec6792aafbe3"],
 " (the Lorentz connection ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["u",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], "\[Omega]"], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", 
     StyleBox["j", "TI"],
     LimitsPositioning->True], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["\[Omega]", 
       RowBox[{
        StyleBox["LL",
         FontSlant->"Plain"], ",", 
        StyleBox["p", "TI"]}], 
       StyleBox["j", "TI"]], 
      SubsuperscriptBox[
       StyleBox["J", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["j", "TI"]], "+", 
      SubsuperscriptBox["\[CurlyPi]", 
       RowBox[{
        StyleBox["LL",
         FontSlant->"Plain"], ",", 
        StyleBox["p", "TI"]}], 
       StyleBox["j", "TI"]], 
      SubsuperscriptBox[
       StyleBox["K", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["j", "TI"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "674a2d08-a7b9-48d2-b366-cbf8b03b1adc"],
 ", an element of the Lorentz algebra of the super-loop, acting on the Dirac \
index) and the gauge matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["A",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", "\[Iota]",
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], "\[Iota]"], 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Iota]"], "+", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], 
     StyleBox["F",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "8"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5afcaada-7acf-42db-a8b8-00592be9925a"],
 " of the isospin group and of the fermion number. The mean-field \
(Dirac-Bogoliubov-de Gennes) equations couple the particle part ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Psi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c1433f4f-6e19-4803-ab78-b5aba3da0255"],
 " and the hole part ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Psi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["h",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "687f1761-3c27-495b-9597-a464e4b4d8ab"],
 " of a mode through the pairing block ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["P",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", "\[Iota]",
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Iota]"], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "\[Iota]"], ")"}], "\[Dagger]"]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "58681c64-0b39-43ff-bf18-450fd2226dda"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["d", "TI"], "\[RightVector]"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["d", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "1"], ",", 
      SubsuperscriptBox[
       StyleBox["d", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "2"], ",", 
      SubsuperscriptBox[
       StyleBox["d", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "258e604b-15ba-46b8-be9b-89cb8529e3cc"],
 " is the order parameter."
}], "Text",ExpressionUUID->"6e8433d7-c1a3-4210-beb4-57d9d483f746"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "the", " ", "seed", " ", "of", " ", "the", " ", "program", " ", 
    "t2_fields", " ", "and", " ", "the", " ", "tolerance", " ", "of", " ", 
    "the", " ", "exact", " ", "relations"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"t2Seed", "[", "2026111707", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"tol", " ", "=", " ", "1*^-12"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", "Frobenius", " ", "norm"}], ",", " ", 
     RowBox[{
     "the", " ", "name", " ", "used", " ", "in", " ", "the", " ", "Rust", " ",
       "code"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"fro", "[", "m_", "]"}], " ", ":=", " ", 
     RowBox[{"Norm", "[", 
      RowBox[{"m", ",", " ", "\"\<Frobenius\>\""}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "the", " ", "four", " ", "Dirac", " ", "matrices", " ", "of", " ", "the", 
     " ", "canonical", " ", "frame"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"t2gamma", "[", "p", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellLabel->
  "In[353]:=",ExpressionUUID->"157c1eed-0a06-44ff-bf5f-20c69735e182"],

Cell[CellGroupData[{

Cell["GS-1 and GS-2: the Dirac matrices and the Lorentz generators", \
"Subsection",ExpressionUUID->"bf0d02df-b72d-4a30-aa4d-e61eb17b6160"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"GS", "-", "1"}], ":", " ", 
      RowBox[{"Clifford", " ", "relations", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"gamma", "^", "p"}], ",", " ", 
         RowBox[{"gamma", "^", "q"}]}], "}"}]}]}], " ", "=", " ", 
     RowBox[{"2", " ", 
      RowBox[{"eta", "^", "pq"}], " ", "1", "_", "4"}]}], ",", " ", 
    RowBox[{"and", " ", "the", " ", "forms", " ", "of", " ", "gamma_ch"}], ",",
     " ", "C", ",", " ", 
    RowBox[{"alpha", "^", "j"}], ",", " ", 
    RowBox[{"the", " ", "frame", " ", "and", " ", "eps2"}]}], " ", "*)"}], 
  "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"cliff", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"fro", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"g", "[", 
            RowBox[{"[", 
             RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}], " ", ".", " ", 
           RowBox[{"g", "[", 
            RowBox[{"[", 
             RowBox[{"q", " ", "+", " ", "1"}], "]"}], "]"}]}], " ", "+", " ", 
          RowBox[{
           RowBox[{"g", "[", 
            RowBox[{"[", 
             RowBox[{"q", " ", "+", " ", "1"}], "]"}], "]"}], " ", ".", " ", 
           RowBox[{"g", "[", 
            RowBox[{"[", 
             RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}]}], " ", "-", " ", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"p", " ", "==", " ", "q"}], ",", " ", 
             RowBox[{"2", " ", 
              RowBox[{"t2eta", "[", "p", "]"}]}], ",", " ", "0"}], "]"}], " ", 
           RowBox[{"IdentityMatrix", "[", "4", "]"}]}]}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"q", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}], "]"}]}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"gchOk", " ", "=", " ", 
     RowBox[{
      RowBox[{"fro", "[", 
       RowBox[{"t2gammaCh", " ", "-", " ", 
        RowBox[{"DiagonalMatrix", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", " ", 
           RowBox[{"-", "1"}], ",", " ", "1", ",", " ", "1"}], "}"}], "]"}]}],
        "]"}], " ", "<", " ", "tol"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"cOk", " ", "=", " ", 
     RowBox[{
      RowBox[{"fro", "[", 
       RowBox[{"t2cconj", " ", "-", " ", 
        RowBox[{"ArrayFlatten", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"t2eps2", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", 
             RowBox[{"-", "t2eps2"}]}], "}"}]}], "}"}], "]"}]}], "]"}], " ", "<",
       " ", "tol"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"alOk", " ", "=", " ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"Range", "[", "3", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"fro", "[", 
          RowBox[{
           RowBox[{"t2alpha", "[", "#", "]"}], " ", "-", " ", 
           RowBox[{"ArrayFlatten", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", 
                 RowBox[{"t2sigma", "[", "#", "]"}]}], ",", " ", "0"}], "}"}],
               ",", " ", 
              RowBox[{"{", 
               RowBox[{"0", ",", " ", 
                RowBox[{"t2sigma", "[", "#", "]"}]}], "}"}]}], "}"}], "]"}]}],
           "]"}], " ", "<", " ", "tol"}], " ", "&"}]}], "]"}]}], ";"}], "\n", 
   
   RowBox[{
    RowBox[{"frameOk", " ", "=", " ", 
     RowBox[{
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", " ", "3"}], "]"}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"fro", "[", 
            RowBox[{
             RowBox[{"t2mq", "[", 
              RowBox[{"t2canonicalFrame", "[", 
               RowBox[{"[", 
                RowBox[{"#", " ", "+", " ", "1"}], "]"}], "]"}], "]"}], " ", "-",
              " ", 
             RowBox[{"t2sigma", "[", "#", "]"}]}], "]"}], " ", "<", " ", 
           "tol"}], " ", "&&", "\n", "      ", 
          RowBox[{
           RowBox[{"fro", "[", 
            RowBox[{
             RowBox[{"t2mq", "[", 
              RowBox[{"t2bqConj", "[", 
               RowBox[{"t2canonicalFrame", "[", 
                RowBox[{"[", 
                 RowBox[{"#", " ", "+", " ", "1"}], "]"}], "]"}], "]"}], 
              "]"}], " ", "-", " ", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"#", " ", "==", " ", "0"}], ",", " ", "1", ",", " ", 
                RowBox[{"-", "1"}]}], "]"}], " ", 
              RowBox[{"t2sigma", "[", "#", "]"}]}]}], "]"}], " ", "<", " ", 
           "tol"}]}], " ", "&"}]}], "]"}], " ", "&&", "\n", "   ", 
      RowBox[{
       RowBox[{"fro", "[", 
        RowBox[{
         RowBox[{"t2mq", "[", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "0", ",", " ", 
            RowBox[{"-", "1"}], ",", " ", "0"}], "}"}], "]"}], " ", "-", " ", 
         "t2eps2"}], "]"}], " ", "<", " ", "tol"}]}]}], ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<GS-1\>\"", ",", 
     " ", "\"\<the Dirac matrices are built from the frame of R^(1,3)_LL; \
Clifford relations; gamma_ch = diag(-1,-1,1,1), C_LL = diag(eps2, -eps2), \
alpha^j = diag(-sigma_j, sigma_j), eps2 = M_LL(-e2)\>\"", ",", "\n", "  ", 
     RowBox[{
      RowBox[{"cliff", " ", "<", " ", "tol"}], " ", "&&", " ", "gchOk", " ", "&&",
