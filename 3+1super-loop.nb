Cell[TextData[{
 "S-11, the sum over the isospin index with the generators ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Iota]"], "\[LongEqual]", 
    SubsuperscriptBox["\[Tau]", "\[Iota]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "/", "2"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4befce1f-ba14-4104-9e7c-fc81aa79ab38"],
 ": the Casimir ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SubscriptBox[
       StyleBox["T", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]], ")"}], "2"], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", "\[Iota]",
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Iota]"], 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Iota]"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "598d5c81-395c-497c-824c-45a98b948570"],
 " of the isospin one-half is ",
 Cell[BoxData[
  FormBox[
   FractionBox["3", "4"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "aa50c3dc-4907-4802-af59-c3082c4fa118"],
 " times the unit matrix. The components ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Tau]", "1", 
     StyleBox["LL",
      FontSlant->"Plain"]], ",", 
    SubsuperscriptBox["\[Tau]", "2", 
     StyleBox["LL",
      FontSlant->"Plain"]], ",", 
    SubsuperscriptBox["\[Tau]", "3", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3bdb5033-cb4e-4eeb-8ef7-762d5357f0fa"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], ",", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "2"], ",", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "3"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a1e31c0d-9ff9-448d-ab1d-0393337d325c"],
 " are symbolized; the generators are defined from the Pauli matrices by \
rules."
}], "Text",ExpressionUUID->"0fef1c47-214c-48a3-9fde-0f90781deda6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"taus", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ReleaseHold", "[", 
      RowBox[{"SL31Instance", "[", 
       RowBox[{
        RowBox[{
        "SL31SymbolBoxes", "[", "\"\<\\\\tau^{\\\\rm LL}_\\\\iota\>\"", "]"}],
         ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<\[Iota]\>\"", " ", "->", " ", 
          RowBox[{"ToString", "[", "k", "]"}]}], "}"}]}], "]"}], "]"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Ts", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ReleaseHold", "[", 
      RowBox[{"SL31Instance", "[", 
       RowBox[{
        RowBox[{
        "SL31SymbolBoxes", "[", "\"\<T^\\\\iota_{\\\\rm LL}\>\"", "]"}], ",", 
        " ", 
        RowBox[{"{", 
         RowBox[{"\"\<\[Iota]\>\"", " ", "->", " ", 
          RowBox[{"ToString", "[", "k", "]"}]}], "}"}]}], "]"}], "]"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"casimir", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Ts", "[", 
         RowBox[{"[", "k", "]"}], "]"}], " ", ".", " ", 
        RowBox[{"Ts", "[", 
         RowBox[{"[", "k", "]"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}], " ", "/.", " ", 
     RowBox[{"Thread", "[", 
      RowBox[{"Ts", " ", "->", " ", 
       RowBox[{"taus", "/", "2"}]}], "]"}]}], " ", "/.", " ", 
    RowBox[{"Thread", "[", 
     RowBox[{"taus", " ", "->", " ", "pauliValues"}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-11\>\"", ",", 
    " ", "\"\<the sum over iota of T^iota_LL T^iota_LL (with T = tau/2 for \
the symbolized components) is 3/4 times the unit matrix\>\"", ",", "\n", "  ", 
    RowBox[{"casimir", " ", "===", " ", 
     RowBox[{
      RowBox[{"3", "/", "4"}], " ", 
      RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], ",", " ", "casimir"}], 
   "]"}], ";"}]}], "Input",
 CellLabel->
  "In[201]:=",ExpressionUUID->"dcb03ed9-1d1c-4cf5-8f0a-9eafacf6be19"],

