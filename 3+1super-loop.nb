          OverscriptBox[
           StyleBox["A", "TI"], "\[RightVector]"], 
          RowBox[{
           StyleBox["LL",
            FontSlant->"Plain"], ",", 
           StyleBox["j", "TI"]}], 
          StyleBox["v",
           FontSlant->"Plain"]], "\[RightBracketingBar]"}]}], ")"}], 
      SubsuperscriptBox["\[Sigma]", "0", 
       StyleBox["LL",
        FontSlant->"Plain"]], "-", 
      StyleBox["i", "TI"], "\[ThinSpace]", 
      StyleBox["sin",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       RowBox[{
        FractionBox["1", "2"], 
        SubsuperscriptBox["\[ScriptL]", 
         StyleBox["LL",
          FontSlant->"Plain"], 
         StyleBox["x",
          FontSlant->"Plain"]], 
        SubsuperscriptBox[
         StyleBox["g", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], 
         StyleBox["v",
          FontSlant->"Plain"]], 
        RowBox[{"\[LeftBracketingBar]", 
