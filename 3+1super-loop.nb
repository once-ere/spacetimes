                    FontSlant->"Plain"]], "\[LongEqual]", 
                  RowBox[{"{", 
                   RowBox[{
                    StyleBox["w",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], "\[Element]", 
                    SubscriptBox[
                    StyleBox["\[DoubleStruckCapitalB]",
                    FontSlant->"Plain"], 
                    StyleBox["LL",
                    FontSlant->"Plain"]], ":", 
                    SubscriptBox[
                    StyleBox["N", "TI"], 
                    StyleBox["LL",
                    FontSlant->"Plain"]], 
                    RowBox[{"(", 
                    StyleBox["w",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], ")"}], "\[LongEqual]", "1"}], 
