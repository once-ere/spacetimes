          "0.5792666"}], "]"}], " ", "<", " ", "1*^-7"}]}], ",", "\n", "  ", 
      RowBox[{"N", "[", 
       RowBox[{"gapValue", ",", " ", "12"}], "]"}]}], "]"}], 
    ";"}]}]}]], "Input",
