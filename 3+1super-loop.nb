                    RowBox[{"[", 
                    RowBox[{
                    StyleBox["z",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], ",", 
                    StyleBox["x",
                    FontWeight->"Bold",
                    FontSlant->"Plain"]}], "]"}], ",", 
