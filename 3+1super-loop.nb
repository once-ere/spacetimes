              ImageSize->95], 
             PaneBox[
              StyleBox[
               
               TemplateBox[{
                "\"transpose; tensor product and direct sum (plain text `(x)` \
for \"", 
                 FormBox["\[CircleTimes]", TraditionalForm], 
                 "\"); composition of maps; expectation value in the ground \
state; the Hermitian conjugate of the preceding terms\""},
                "RowDefault"],
               StripOnInput->False,
               FontFamily->"Source Sans Pro",
               FontSize->9.5],
              ImageSize->290]},
            {
             PaneBox[
              
              StyleBox["\<\"A-1, ..., R-6; G-1, ..., G-12; LL-S1, ..., LL-H1; \
X-1, ..., X-10; Z-1, ..., Z-8; Theorems R, L, M, SF1, ..., SF4\"\>",
               StripOnInput->False,
               FontSize->9],
              ImageSize->125], 
             PaneBox[
              StyleBox["\<\"\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[
              
              StyleBox["\<\"the identifiers of the machine checks of the \
project (letters: A associativity, L Lorentz super-loop, Q operators and \
eigenvalues, C the inversion element, M Malcev classification, G Groebner \
bases, N manifolds, S superfluid, R renormalizability, LL-S symbols, LL-H \
self-containedness, X the examples of the spin-zero superfluid, Z the 3+1 \
manifold and the renormalizability of the Yukawa form) and the labels of the \
theorems of the project; they are names, not mathematical symbols\"\>",
               StripOnInput->False,
               FontFamily->"Source Sans Pro",
               FontSize->9.5],
              ImageSize->290]},
            {
             PaneBox[
              StyleBox["\<\"H-grp, H-op, H-Lie, H-gr, H-dyn\"\>",
