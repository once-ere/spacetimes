  "In[347]:=",ExpressionUUID->"1c80df09-ff81-475a-b54e-b9f271d30d1c"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   StyleBox["\<\"PASS  \"\>",
    StripOnInput->False,
    LineColor->RGBColor[0, 
      Rational[2, 3], 0],
    FrontFaceColor->RGBColor[0, 
      Rational[2, 3], 0],
    BackFaceColor->RGBColor[0, 
