                 SubscriptBox[
                  StyleBox["G", "TI"], "LL"]}]], TraditionalForm], 
             "\" times the pair expectation of the positive-energy \
eigenvectors of \"", 
             FormBox[
              SubsuperscriptBox[
               StyleBox["H", "TI"], "LL", "lat"], TraditionalForm], 
             "\" with that pair field, divided by \"", 
             FormBox[
              SuperscriptBox[
               RowBox[{"(", 
                 SubsuperscriptBox["\[ScriptL]", "LL", "x"], ")"}], 
               SubsuperscriptBox[
                StyleBox["n", "TI"], "LL", "act"]], TraditionalForm], 
             
             "\"; the quantities of the Anderson iteration for its fixed \
point: the iterate (the real and imaginary parts of all \"", 
             FormBox[
              SubsuperscriptBox[
