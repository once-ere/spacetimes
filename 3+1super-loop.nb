                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "2074ef0a-a523-4118-8f32-93fe7cf41504"],
               ", ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SuperscriptBox[
                   StyleBox["b",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], "\[Prime]"], "\[ThinSpace]", 
                  SubscriptBox[
                   StyleBox["e",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], "4"]}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "abeb7236-5451-4558-bdf6-89ff922a6472"],
               " are spinor charges"
              }], "Text",
               FontFamily->"Source Sans Pro",
               FontSize->9.5,ExpressionUUID->
               "50756adf-d6d3-4041-8d76-219de6efdf77"],
              ImageSize->290]},
            {
             PaneBox[
              TemplateBox[{
                OverscriptBox[
                 TagBox[
                  StyleBox["x", FontWeight -> "Bold", FontSlant -> "Plain"], 
                  "SL31Bold"], "_"], "\", \"", 
                SuperscriptBox[
                 TagBox[
                  StyleBox["x", FontWeight -> "Bold", FontSlant -> "Plain"], 
                  "SL31Bold"], "*"], "\", \"", 
                SuperscriptBox[
                 TagBox[
                  StyleBox["x", FontWeight -> "Bold", FontSlant -> "Plain"], 
                  "SL31Bold"], "\[Dagger]"]},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              
              StyleBox["\<\"xbar x^* x^dag aHbar bSbar bS'bar cHbar dSbar \
gLbar hLbar rPbar rP'bar bS^* bS'^* gL^* gL^dag uL^dag\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[Cell[TextData[{
               "the three conjugations (also of bi-quaternions): ",
               Cell[BoxData[
                FormBox[
                 OverscriptBox[
                  StyleBox["x",
                   FontWeight->"Bold",
                   FontSlant->"Plain"], "_"], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "0cd966c1-a2a5-4fb1-bff5-23014a3dc032"],
               " changes the signs of the coefficients of ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubscriptBox[
                   StyleBox["e",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], "1"], ",", "\[Ellipsis]", ",", 
                  SubscriptBox[
                   StyleBox["e",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], "7"]}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "f0d16c9a-b144-45ce-a71b-38d6364c8399"],
               " (it is complex-linear, ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  OverscriptBox[
                   StyleBox[
                    RowBox[{"x", "y"}],
                    FontWeight->"Bold",
                    FontSlant->"Plain"], "_"], "\[LongEqual]", 
                  OverscriptBox[
                   StyleBox["y",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], "_"], "\[ThinSpace]", 
                  OverscriptBox[
                   StyleBox["x",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], "_"]}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "0d7684fb-ac00-4c10-a5a9-aef91a48e5eb"],
               ", and ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  OverscriptBox[
                   RowBox[{
                    StyleBox["a",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], "+", 
                    StyleBox["b",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], 
                    SubscriptBox[
                    StyleBox["e",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], "4"]}], "_"], "\[LongEqual]", 
                  OverscriptBox[
                   StyleBox["a",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], "_"], "-", 
                  StyleBox["b",
                   FontWeight->"Bold",
                   FontSlant->"Plain"], 
                  SubscriptBox[
                   StyleBox["e",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], "4"]}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "b6cd6d5a-cc69-4b32-9136-81f67c068fcf"],
               "); ",
               Cell[BoxData[
                FormBox[
                 SuperscriptBox[
                  StyleBox["x",
                   FontWeight->"Bold",
                   FontSlant->"Plain"], "*"], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "aa5aa527-d4b6-40f9-abe0-55788c74665c"],
               
               " replaces every complex coefficient by its complex conjugate; \
",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SuperscriptBox[
                   StyleBox["x",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], "\[Dagger]"], "\[LongEqual]", 
                  SuperscriptBox[
                   RowBox[{"(", 
                    OverscriptBox[
                    StyleBox["x",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], "_"], ")"}], "*"]}], 
                 TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "18fb82b4-e40a-4ee7-b053-870d16af4e68"],
               " (plain text: ",
               StyleBox["xbar",
                FontFamily->"Source Code Pro"],
               ", ",
               StyleBox["x^*",
                FontFamily->"Source Code Pro"],
               ", ",
               StyleBox["x^dag",
                FontFamily->"Source Code Pro"],
               ", and likewise ",
               StyleBox["aHbar",
                FontFamily->"Source Code Pro"],
               ", ",
               StyleBox["gL^dag",
                FontFamily->"Source Code Pro"],
               ", ...)"
              }], "Text",
               FontFamily->"Source Sans Pro",
               FontSize->9.5,ExpressionUUID->
               "902414e3-d18b-4c20-9104-94ce316bde97"],
              ImageSize->290]},
            {
             PaneBox[
              TemplateBox[{
                RowBox[{
                  SubscriptBox["N", "LL"], "(", 
                  TagBox[
                   StyleBox["x", FontWeight -> "Bold", FontSlant -> "Plain"], 
                   "SL31Bold"], ")"}], "\", \"", 
                RowBox[{
                  SubscriptBox["N", "LL"], "(", 
                  TagBox[
                   StyleBox["x", FontWeight -> "Bold", FontSlant -> "Plain"], 
                   "SL31Bold"], ",", 
                  TagBox[
                   StyleBox["y", FontWeight -> "Bold", FontSlant -> "Plain"], 
                   "SL31Bold"], ")"}]},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              StyleBox["\<\"N_LL\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[Cell[TextData[{
               "the complex norm ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubscriptBox[
                   StyleBox["N", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]], 
                  RowBox[{"(", 
                   StyleBox["x",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], ")"}], "\[LongEqual]", 
                  UnderscriptBox["\[Sum]", 
                   StyleBox["p", "TI"],
                   LimitsPositioning->True], "\[ThinSpace]", 
                  SubsuperscriptBox["\[Xi]", 
                   StyleBox["p", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]], 
                  SuperscriptBox[
                   RowBox[{"(", 
                    StyleBox["x",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], ")"}], "2"]}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "d222ab5a-e926-4d98-b7bb-89fda3afcd09"],
               ", with ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  StyleBox["x",
                   FontWeight->"Bold",
                   FontSlant->"Plain"], 
                  OverscriptBox[
                   StyleBox["x",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], "_"], "\[LongEqual]", 
                  OverscriptBox[
                   StyleBox["x",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], "_"], 
                  StyleBox["x",
                   FontWeight->"Bold",
                   FontSlant->"Plain"], "\[LongEqual]", 
                  SubscriptBox[
                   StyleBox["N", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]], 
                  RowBox[{"(", 
                   StyleBox["x",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], ")"}], "\[ThinSpace]", 
                  SubscriptBox[
                   StyleBox["e",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], "0"]}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "0d44e251-4f1a-4b03-80a4-b581a2c6199b"],
               ", and its polarization ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubscriptBox[
                   StyleBox["N", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]], 
                  RowBox[{"(", 
                   RowBox[{
                    StyleBox["x",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], ",", 
                    StyleBox["y",
                    FontWeight->"Bold",
                    FontSlant->"Plain"]}], ")"}], "\[LongEqual]", 
                  UnderscriptBox["\[Sum]", 
                   StyleBox["p", "TI"],
                   LimitsPositioning->True], "\[ThinSpace]", 
                  SubsuperscriptBox["\[Xi]", 
                   StyleBox["p", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]], 
                  RowBox[{"(", 
                   StyleBox["x",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], ")"}], "\[ThinSpace]", 
                  SubsuperscriptBox["\[Xi]", 
                   StyleBox["p", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]], 
                  RowBox[{"(", 
                   StyleBox["y",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], ")"}]}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "9b9e0317-5b5f-4c18-8c29-6b3c04d903d8"],
               ", ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubscriptBox[
                   StyleBox["N", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]], 
                  RowBox[{"(", 
                   RowBox[{
                    StyleBox["x",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], ",", 
                    StyleBox["x",
                    FontWeight->"Bold",
                    FontSlant->"Plain"]}], ")"}], "\[LongEqual]", 
                  SubscriptBox[
                   StyleBox["N", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]], 
                  RowBox[{"(", 
                   StyleBox["x",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], ")"}]}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "e6f1bceb-223a-4363-8360-fe917416c0e8"],
               " (complex-valued; for bi-quaternions the determinant of the ",
               
               Cell[BoxData[
                FormBox[
                 RowBox[{"2", "\[Times]", "2"}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "48a4f5cb-b15a-45b6-b54a-6d90436c55eb"],
               " matrix ",
