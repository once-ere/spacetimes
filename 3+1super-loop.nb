                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "486f7f14-465c-400b-b778-6e8a50854039"],
               ", and its polarization ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubscriptBox[
                   StyleBox["N", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]], 
                  RowBox[{"(", 
