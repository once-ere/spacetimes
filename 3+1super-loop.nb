           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "5a2f1298-9b91-4733-84e1-51673641d88a"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox[
             TagBox[
              StyleBox["V", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
              "SL31SansSerif"], "LL", "\[PlusMinus]"], "\", \"", 
            SubsuperscriptBox[
             TagBox[
              StyleBox["B", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
              "SL31SansSerif"], "LL", "W"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"Vblock BW\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the isospin factors of the two Weyl blocks of a Lorentz-invariant \
pair matrix, which is ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              StyleBox["diag",
               FontSlant->"Plain"], 
              RowBox[{"(", 
               RowBox[{
                SubscriptBox[
                 StyleBox["E",
                  FontFamily->"Helvetica",
                  FontSlant->"Plain"], 
                 StyleBox["LL",
                  FontSlant->"Plain"]], "\[CircleTimes]", 
                SubsuperscriptBox[
                 StyleBox["V",
                  FontFamily->"Helvetica",
                  FontSlant->"Plain"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], "-"], ",", 
                SubscriptBox[
                 StyleBox["E",
                  FontFamily->"Helvetica",
                  FontSlant->"Plain"], 
                 StyleBox["LL",
                  FontSlant->"Plain"]], "\[CircleTimes]", 
                SubsuperscriptBox[
                 StyleBox["V",
                  FontFamily->"Helvetica",
                  FontSlant->"Plain"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], "+"]}], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "40df467f-29c1-4367-bc0a-af5069945e76"],
           " with two symmetric complex ",
           Cell[BoxData[
            FormBox[
             RowBox[{"2", "\[Times]", "2"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "78cdb87d-53a5-4e08-b120-fa32f8307da6"],
           " matrices ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["V",
               FontFamily->"Helvetica",
               FontSlant->"Plain"], 
              StyleBox["LL",
               FontSlant->"Plain"], "\[PlusMinus]"], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "ddc83d36-ecf2-4a92-85a0-11c41efb8836"],
           " on the isospin index; and a complex ",
           Cell[BoxData[
            FormBox[
             RowBox[{"2", "\[Times]", "2"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "f323965c-8f94-4680-a02c-7f8df5410ebc"],
           " matrix on the Weyl index, the Weyl factor of a term of a ",
           Cell[BoxData[
            FormBox[
             RowBox[{"4", "\[Times]", "4"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "6fcf8305-b4e0-4612-b57d-ce8cc2322d77"],
           
           " block of a pair matrix (in the proof that the Lorentz-invariant \
pairs have this form)"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "4d918924-326a-487c-9e8b-c85fa5649e3e"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox[
             TagBox[
              StyleBox["K", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
              "SL31SansSerif"], "LL", 
             RowBox[{"(", "+", "1", ")"}]], "\", \"", 
            SubsuperscriptBox[
             TagBox[
              StyleBox["K", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
              "SL31SansSerif"], "LL", 
             RowBox[{"(", "0", ")"}]], "\", \"", 
            SubsuperscriptBox[
             TagBox[
              StyleBox["K", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
              "SL31SansSerif"], "LL", 
             RowBox[{"(", "-", "1", ")"}]], "\", \"", 
            SubsuperscriptBox["\[CapitalPi]", "LL", 
             RowBox[{"(", "+", "1", ")"}]], "\", \"", 
            SubsuperscriptBox["\[CapitalPi]", "LL", 
             RowBox[{"(", "0", ")"}]], "\", \"", 
            SubsuperscriptBox["\[CapitalPi]", "LL", 
             RowBox[{"(", "-", "1", ")"}]]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"K(+1) K(0) K(-1) Pi(+1) Pi(0) Pi(-1)\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the scalar pair matrices of definite electric charge, ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["K",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               RowBox[{"(", 
                RowBox[{"\[PlusMinus]", "1"}], ")"}]], "\[LongEqual]", 
              RowBox[{"(", 
               RowBox[{
                SubsuperscriptBox[
                 StyleBox["K",
                  FontFamily->"Helvetica",
                  FontSlant->"Plain"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], "1"], "\[MinusPlus]", 
                StyleBox["i", "TI"], 
                SubsuperscriptBox[
                 StyleBox["K",
                  FontFamily->"Helvetica",
                  FontSlant->"Plain"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], "2"]}], ")"}], "/", 
              SqrtBox["2"]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "943f753e-a756-42f7-be74-04460d2a3079"],
           " and ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["K",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               RowBox[{"(", "0", ")"}]], "\[LongEqual]", 
              SubsuperscriptBox[
               StyleBox["K",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"], "3"]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "58099802-29d0-4045-ae51-ba939a667fa8"],
           ", and the pair operators ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[CapitalPi]", 
              StyleBox["LL",
               FontSlant->"Plain"], 
              RowBox[{"(", 
               RowBox[{"+", "1"}], ")"}]], TraditionalForm]], "InlineFormula",
            
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "4a9f53a7-c5ea-4f08-9f3c-021448955686"],
           ", ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[CapitalPi]", 
              StyleBox["LL",
               FontSlant->"Plain"], 
              RowBox[{"(", "0", ")"}]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "69305865-9eaf-49e7-bef8-2bdb753496ef"],
           ", ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[CapitalPi]", 
              StyleBox["LL",
               FontSlant->"Plain"], 
              RowBox[{"(", 
               RowBox[{"-", "1"}], ")"}]], TraditionalForm]], "InlineFormula",
            
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "8001b906-614c-4ef6-9bbe-dd8beeadf15f"],
           " made with them, which annihilate a pair of the electric charge ",
           
           Cell[BoxData[
            FormBox[
             RowBox[{"+", "1"}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "a41fbf39-1f9c-4e59-8e9e-b2b05fcbe627"],
           " (two isospin-up charges), ",
           Cell[BoxData[
            FormBox["0", TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "2e8d8e2b-019f-49bc-a723-23ef67511398"],
           " (one isospin-up and one isospin-down charge) and ",
           Cell[BoxData[
            FormBox[
             RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "9a963773-db87-47ef-99b6-4a9693ecc5d2"],
           " (two isospin-down charges)"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "87a351b4-baeb-41d3-89e9-37e995cc2ae4"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["S", "LL", "sp"], "\", \"", 
            SubsuperscriptBox["I", "LL", "v"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"S_sp I_v\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the spin and the isospin of a state of two spinor charges: the \
sums of the squares of the three total spin generators and of the three total \
isospin generators have the eigenvalues ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["S", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["sp",
                FontSlant->"Plain"]], 
              RowBox[{"(", 
               RowBox[{
                SubsuperscriptBox[
                 StyleBox["S", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["sp",
                  FontSlant->"Plain"]], "+", "1"}], ")"}]}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "9fa1511b-fb64-41c4-9854-d69dccfa7c2c"],
           " and ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["I", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["v",
                FontSlant->"Plain"]], 
              RowBox[{"(", 
               RowBox[{
                SubsuperscriptBox[
                 StyleBox["I", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["v",
                  FontSlant->"Plain"]], "+", "1"}], ")"}]}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "61e946f5-4b13-43b1-9861-811f5c3cd422"],
           "; the superfluid boson singlet has ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["S", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["sp",
                FontSlant->"Plain"]], "\[LongEqual]", "0"}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "a56a5dd4-2178-462c-89d3-39313864d407"],
           " (spin singlet) and ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["I", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["v",
                FontSlant->"Plain"]], "\[LongEqual]", "1"}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "5033583d-2b68-4908-8969-f5d5c427d2bc"],
           " (isospin triplet)"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "af43c74b-b586-4178-8798-c96bb6166d9e"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            RowBox[{
              SubscriptBox[
               OverscriptBox["c", "^"], 
               RowBox[{"LL", ",", "k"}]], "(", 
              SubscriptBox[
               OverscriptBox["s", "\[RightVector]"], "LL"], ")"}], "\", \"", 
            RowBox[{
              SubsuperscriptBox[
               OverscriptBox["\[CapitalPi]", "^"], "LL", "\[Iota]"], "(", 
              SubscriptBox[
               OverscriptBox["s", "\[RightVector]"], "LL"], ")"}], "\", \"", 
            RowBox[{
              SubsuperscriptBox[
               OverscriptBox["n", "^"], "LL", "F"], "(", 
              SubscriptBox[
               OverscriptBox["s", "\[RightVector]"], "LL"], ")"}], "\", \"", 
            RowBox[{
              SubsuperscriptBox[
               OverscriptBox["n", "^"], "LL", "\[Iota]"], "(", 
              SubscriptBox[
               OverscriptBox["s", "\[RightVector]"], "LL"], ")"}]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"c_site Pi_site n_F_site n_iota_site\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "operators of one lattice site ",
           Cell[BoxData[
            FormBox[
             SubscriptBox[
              OverscriptBox[
               StyleBox["s", "TI"], "\[RightVector]"], 
              StyleBox["LL",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "a13c738d-d089-47b0-b411-1faf3bac8616"],
           " (a cell of the volume ",
           Cell[BoxData[
            FormBox[
             SuperscriptBox[
              RowBox[{"(", 
               SubsuperscriptBox["\[ScriptL]", 
                StyleBox["LL",
                 FontSlant->"Plain"], 
                StyleBox["x",
                 FontSlant->"Plain"]], ")"}], "3"], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "42066f40-63dd-4a06-a11b-bf4f4d3b6784"],
           "): the annihilation operators ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubscriptBox[
               OverscriptBox[
                StyleBox["c", "TI"], "^"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["k", "TI"]}]], 
              RowBox[{"(", 
               SubscriptBox[
                OverscriptBox[
                 StyleBox["s", "TI"], "\[RightVector]"], 
                StyleBox["LL",
                 FontSlant->"Plain"]], ")"}], "\[LongEqual]", 
              SuperscriptBox[
               RowBox[{"(", 
                SubsuperscriptBox["\[ScriptL]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["x",
                  FontSlant->"Plain"]], ")"}], 
               RowBox[{"3", "/", "2"}]], 
              SubscriptBox["\[CapitalPsi]", 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["k", "TI"]}]], 
              RowBox[{"(", 
               SubscriptBox[
                OverscriptBox[
                 StyleBox["s", "TI"], "\[RightVector]"], 
                StyleBox["LL",
                 FontSlant->"Plain"]], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "d8238c89-be42-4716-a452-80090af5481c"],
           
           " of the eight components, which obey the canonical \
anticommutation relations; the pair operator of the site ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               OverscriptBox["\[CapitalPi]", "^"], 
               StyleBox["LL",
                FontSlant->"Plain"], "\[Iota]"], "\[LongEqual]", 
              UnderscriptBox["\[Sum]", 
               RowBox[{
                StyleBox["k", "TI"], ",", 
                SuperscriptBox[
                 StyleBox["k", "TI"], "\[Prime]"]}],
               LimitsPositioning->True], 
              SubscriptBox[
               RowBox[{"(", 
                SubsuperscriptBox[
                 StyleBox["K",
                  FontFamily->"Helvetica",
                  FontSlant->"Plain"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], "\[Iota]"], ")"}], 
               RowBox[{
                StyleBox["k", "TI"], 
                SuperscriptBox[
                 StyleBox["k", "TI"], "\[Prime]"]}]], 
              SubscriptBox[
               OverscriptBox[
                StyleBox["c", "TI"], "^"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["k", "TI"]}]], 
              SubscriptBox[
               OverscriptBox[
                StyleBox["c", "TI"], "^"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                SuperscriptBox[
                 StyleBox["k", "TI"], "\[Prime]"]}]]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "b96d6146-6eb6-4c7d-97ed-1df366ec215d"],
           "; the number of spinor charges on the site ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               OverscriptBox[
                StyleBox["n", "TI"], "^"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["F",
                FontSlant->"Plain"]], "\[LongEqual]", 
              UnderscriptBox["\[Sum]", 
               StyleBox["k", "TI"],
               LimitsPositioning->True], "\[ThinSpace]", 
              SubsuperscriptBox[
               OverscriptBox[
                StyleBox["c", "TI"], "^"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["k", "TI"]}], "\[Dagger]"], 
              SubscriptBox[
               OverscriptBox[
                StyleBox["c", "TI"], "^"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["k", "TI"]}]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "3089927f-b4df-42a2-9b92-a5990aaf6952"],
           "; and the isospin of the site ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               OverscriptBox[
                StyleBox["n", "TI"], "^"], 
               StyleBox["LL",
                FontSlant->"Plain"], "\[Iota]"], "\[LongEqual]", 
              UnderscriptBox["\[Sum]", 
               RowBox[{
                StyleBox["k", "TI"], ",", 
                SuperscriptBox[
                 StyleBox["k", "TI"], "\[Prime]"]}],
               LimitsPositioning->True], "\[ThinSpace]", 
              SubsuperscriptBox[
               OverscriptBox[
                StyleBox["c", "TI"], "^"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["k", "TI"]}], "\[Dagger]"], 
              SubscriptBox[
               RowBox[{"(", 
                SubsuperscriptBox[
                 StyleBox["T", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], "\[Iota]"], ")"}], 
               RowBox[{
                StyleBox["k", "TI"], 
                SuperscriptBox[
                 StyleBox["k", "TI"], "\[Prime]"]}]], 
              SubscriptBox[
               OverscriptBox[
                StyleBox["c", "TI"], "^"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                SuperscriptBox[
                 StyleBox["k", "TI"], "\[Prime]"]}]]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "78793317-fb87-4e77-8cb3-7e5183159652"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "e0abdcf6-b1b8-440b-96f2-7311a2960244"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox[
             OverscriptBox["H", "^"], "LL", "q"], "\", \"", 
            RowBox[{"|", 
              SubsuperscriptBox["\[CapitalPhi]", "LL", "SF"], 
              "\[RightAngleBracket]"}], "\", \"", 
            RowBox[{"|", 
              SubsuperscriptBox["\[CapitalPhi]", "LL", "N"], 
              "\[RightAngleBracket]"}]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"H_q SF_state Dirac_sea\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the part of the mean-field Hamiltonian of the uniform polar state \
that belongs to one pair of momenta ",
           Cell[BoxData[
            FormBox[
             SubscriptBox[
              OverscriptBox[
               StyleBox["q", "TI"], "\[RightVector]"], 
              StyleBox["LL",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "00507a50-38d8-4168-8e67-7b3e9159139d"],
           ", ",
           Cell[BoxData[
            FormBox[
             RowBox[{"-", 
              SubscriptBox[
               OverscriptBox[
                StyleBox["q", "TI"], "\[RightVector]"], 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "15ec124a-2ff4-406c-8e89-7b0ccd118531"],
           
           " (an operator on 16 fermion modes); the superfluid boson singlet \
state, its ground state, a coherent state of pairs; and the normal state from \
which it is built, the Dirac sea of these modes (every state of energy ",
           Cell[BoxData[
            FormBox[
             RowBox[{"-", 
              SubscriptBox["\[CurlyEpsilon]", 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "0bd38ffd-1087-4f4d-9e32-eb4d1ae4f6cd"],
           " filled, every state of energy ",
           Cell[BoxData[
            FormBox[
             RowBox[{"+", 
              SubscriptBox["\[CurlyEpsilon]", 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "b9467427-d361-497b-8f81-0a8114396b5a"],
           " empty)"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "eceeeb56-3007-41ae-a372-a3d116c6ed30"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            RowBox[{
              SubsuperscriptBox[
               OverscriptBox["B", "^"], "LL", "p"], "(", 
              SubscriptBox[
               OverscriptBox["q", "\[RightVector]"], "LL"], ")"}], "\", \"", 
            RowBox[{
              SubsuperscriptBox[
               OverscriptBox["B", "^"], "LL", "a"], "(", 
              SubscriptBox[
               OverscriptBox["q", "\[RightVector]"], "LL"], ")"}], "\", \"", 
            SubsuperscriptBox["t", "LL", "p"], "\", \"", 
            SubsuperscriptBox["t", "LL", "a"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"B_p B_a t_p t_a\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the pair operators of the momenta ",
           Cell[BoxData[
            FormBox[
             SubscriptBox[
              OverscriptBox[
               StyleBox["q", "TI"], "\[RightVector]"], 
              StyleBox["LL",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "9ca32142-a0f4-449b-95f9-3ce182bdd8a8"],
           " and ",
           Cell[BoxData[
            FormBox[
             RowBox[{"-", 
              SubscriptBox[
               OverscriptBox[
                StyleBox["q", "TI"], "\[RightVector]"], 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "5dcc6890-8e12-43cf-8263-66470ed5a2da"],
           " in the scalar isospin channel of ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["K",
               FontFamily->"Helvetica",
               FontSlant->"Plain"], 
              StyleBox["LL",
               FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "55cb0884-62d9-4006-a35e-27e10b0656e8"],
           ": ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               OverscriptBox[
                StyleBox["B", "TI"], "^"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["p",
                FontSlant->"Plain"]], 
              SuperscriptBox[
               RowBox[{"(", 
                SubscriptBox[
                 OverscriptBox[
                  StyleBox["q", "TI"], "\[RightVector]"], 
                 StyleBox["LL",
                  FontSlant->"Plain"]], ")"}], "\[Dagger]"]}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "7c4d0a5d-e074-48fa-9cb1-ec4bdb85662e"],
           
           " creates a pair of spinor charges of positive energy (particles), \
",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               OverscriptBox[
                StyleBox["B", "TI"], "^"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["a",
                FontSlant->"Plain"]], 
              SuperscriptBox[
               RowBox[{"(", 
                SubscriptBox[
                 OverscriptBox[
                  StyleBox["q", "TI"], "\[RightVector]"], 
                 StyleBox["LL",
                  FontSlant->"Plain"]], ")"}], "\[Dagger]"]}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "65af8244-04bf-47a8-bc15-acba5c11d380"],
           
           " removes a pair from the states of negative energy (creates a \
pair of antiparticles); and their weights ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["t", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["p",
                FontSlant->"Plain"]], "\[LongEqual]", 
              SubscriptBox["\[CapitalDelta]", 
               StyleBox["LL",
                FontSlant->"Plain"]], "/", 
              RowBox[{"(", 
               RowBox[{
                SubsuperscriptBox[
                 StyleBox["E", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], "-"], "+", 
                SubscriptBox["\[CurlyEpsilon]", 
                 StyleBox["LL",
                  FontSlant->"Plain"]], "-", 
                SubscriptBox["\[Mu]", 
                 StyleBox["LL",
                  FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "b6ac33f7-360e-4320-ab21-e8f0fa49ad54"],
           " and ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["t", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["a",
                FontSlant->"Plain"]], "\[LongEqual]", 
              SubscriptBox["\[CapitalDelta]", 
               StyleBox["LL",
                FontSlant->"Plain"]], "/", 
              RowBox[{"(", 
               RowBox[{
                SubsuperscriptBox[
                 StyleBox["E", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], "+"], "+", 
                SubscriptBox["\[CurlyEpsilon]", 
                 StyleBox["LL",
                  FontSlant->"Plain"]], "+", 
                SubscriptBox["\[Mu]", 
                 StyleBox["LL",
                  FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "58ec294e-9971-46f4-9468-82859073d413"],
           " in the superfluid boson singlet state"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "f42cdef1-b256-4c5e-958c-afd9c4c1fe13"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            RowBox[{
              SubsuperscriptBox[
               TagBox[
                StyleBox[
                "Y", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
                "SL31SansSerif"], "LL", "\[PlusMinus]"], "(", 
              SubscriptBox[
               OverscriptBox["q", "\[RightVector]"], "LL"], ")"}], "\", \"", 
            SubscriptBox[
             OverscriptBox["f", "^"], "LL"], "\", \"", 
            SubsuperscriptBox[
             OverscriptBox["f", "^"], "LL", "\[Prime]"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"Yproj f_state f_partner\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the projectors ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              FractionBox["1", "2"], 
              RowBox[{"(", 
               RowBox[{
                SubscriptBox[
                 StyleBox["1",
                  FontFamily->"Helvetica",
                  FontSlant->"Plain"], "8"], "\[PlusMinus]", 
                SubscriptBox[
                 StyleBox["h",
                  FontFamily->"Helvetica",
                  FontSlant->"Plain"], 
                 StyleBox["LL",
                  FontSlant->"Plain"]], 
                RowBox[{"(", 
                 SubscriptBox[
                  OverscriptBox[
                   StyleBox["q", "TI"], "\[RightVector]"], 
                  StyleBox["LL",
                   FontSlant->"Plain"]], ")"}], "/", 
                SubscriptBox["\[CurlyEpsilon]", 
                 StyleBox["LL",
                  FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "aaca742f-45b6-4ace-ba0a-68f9adb8bd4b"],
           " on the states of energy ",
           Cell[BoxData[
            FormBox[
             RowBox[{"\[PlusMinus]", 
              SubscriptBox["\[CurlyEpsilon]", 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "f8deeac3-a7be-4b6a-a95a-dd46366c9377"],
           
           " of the plane-wave Hamiltonian (rank 4 each); and the \
annihilation operators of a spinor charge in an eigenstate of ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubscriptBox[
               StyleBox["h",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"]], 
              RowBox[{"(", 
               SubscriptBox[
                OverscriptBox[
                 StyleBox["q", "TI"], "\[RightVector]"], 
                StyleBox["LL",
                 FontSlant->"Plain"]], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "438fb76e-789d-4eaa-98b9-cbcce8940b61"],
           " and in its partner state of the momentum ",
           Cell[BoxData[
            FormBox[
             RowBox[{"-", 
              SubscriptBox[
               OverscriptBox[
                StyleBox["q", "TI"], "\[RightVector]"], 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "cc060f11-2b61-4878-b560-9efdc2ec36e3"],
           " (the complex conjugate of ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["K",
               FontFamily->"Helvetica",
               FontSlant->"Plain"], 
              StyleBox["LL",
               FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "041a6a2d-ad40-44d3-9c0f-a11744896d9f"],
           " times the eigenvector)"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "423cfe76-e1ab-4509-a835-7d2da4193928"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["\[ScriptCapitalL]", "LL", "HS"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"Lagr_HS\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the Lagrangian density of the gauge-covariant spinor field after \
the Hubbard-Stratonovich identity: the Lagrangian ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["\[ScriptCapitalL]",
               FontSlant->"Plain"], 
              StyleBox["LL",
               FontSlant->"Plain"], "\[Del]"], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "71038e1c-8270-42f3-8083-c8209ff2a6b3"],
           " with its pairing term replaced by ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              RowBox[{"-", 
               UnderscriptBox["\[Sum]", "\[Iota]",
                LimitsPositioning->True]}], 
              SuperscriptBox[
               RowBox[{"\[LeftBracketingBar]", 
                SubsuperscriptBox[
                 StyleBox["d", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], "\[Iota]"], "\[RightBracketingBar]"}], 
               "2"], "/", 
              SubscriptBox[
               StyleBox["G", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"]], "-", 
              FractionBox["1", "2"], "\[ThinSpace]", 
              UnderscriptBox["\[Sum]", "\[Iota]",
               LimitsPositioning->True], 
              RowBox[{"(", 
               RowBox[{
                SuperscriptBox[
                 RowBox[{"(", 
                  SubsuperscriptBox[
                   StyleBox["d", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"], "\[Iota]"], ")"}], "*"], 
                SubsuperscriptBox["\[CapitalPi]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], "\[Iota]"], "+", 
                SubsuperscriptBox[
                 StyleBox["d", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], "\[Iota]"], 
                SuperscriptBox[
                 RowBox[{"(", 
                  SubsuperscriptBox["\[CapitalPi]", 
                   StyleBox["LL",
                    FontSlant->"Plain"], "\[Iota]"], ")"}], "\[Dagger]"]}], 
               ")"}]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "e7953908-bba8-493e-a58f-126f60e8638e"],
           ", in which ",
           Cell[BoxData[
            FormBox[
             SubscriptBox[
              OverscriptBox[
               StyleBox["d", "TI"], "\[RightVector]"], 
              StyleBox["LL",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "fe9230be-93ee-4b13-a591-215c6af19bae"],
           " is an independent complex isovector field"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "bd3db71f-e690-4352-b5e4-f953359c0de0"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["\[Del]", 
             RowBox[{"LL", ",", "p"}], "B"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"nablaB nablaB_p\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the gauge-covariant derivative of the SFBS field, ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox["\[Del]", 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}], 
               StyleBox["B",
                FontSlant->"Plain"]], 
              SubscriptBox[
               OverscriptBox[
                StyleBox["d", "TI"], "\[RightVector]"], 
               StyleBox["LL",
                FontSlant->"Plain"]], "\[LongEqual]", 
              SubscriptBox["\[PartialD]", 
               StyleBox["p", "TI"]], 
              SubscriptBox[
               OverscriptBox[
                StyleBox["d", "TI"], "\[RightVector]"], 
               StyleBox["LL",
                FontSlant->"Plain"]], "-", "2", 
              StyleBox["i", "TI"], "\[ThinSpace]", 
              SubsuperscriptBox[
               StyleBox["g", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["F",
                FontSlant->"Plain"]], 
              SubsuperscriptBox[
               StyleBox["A", "TI"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}], 
               StyleBox["F",
                FontSlant->"Plain"]], 
              SubscriptBox[
               OverscriptBox[
                StyleBox["d", "TI"], "\[RightVector]"], 
               StyleBox["LL",
                FontSlant->"Plain"]], "+", 
              SubsuperscriptBox[
               StyleBox["g", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["v",
                FontSlant->"Plain"]], 
              SubsuperscriptBox[
               StyleBox["\[ScriptCapitalA]",
                FontSlant->"Plain"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}], 
               StyleBox["v",
                FontSlant->"Plain"]], 
              SubscriptBox[
               OverscriptBox[
                StyleBox["d", "TI"], "\[RightVector]"], 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "4f3489f8-7336-46ca-a5f7-70bb34fdf6a3"],
           " (fermion number 2, isospin vector, Lorentz scalar)"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "318a31ce-2a56-4cde-bc1e-5fb76c31c0eb"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["\[ScriptCapitalA]", 
             RowBox[{"LL", ",", "p"}], "v"], "\", \"", 
            SubsuperscriptBox[
             OverscriptBox["A", "\[RightVector]"], 
             RowBox[{"LL", ",", "p"}], "v"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"Avec_matrix Avec_p\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the isospin potential of the direction ",
           Cell[BoxData[
            FormBox[
             StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "f1e36cd0-9a90-4720-be32-c6a709828ce3"],
           " in the vector representation: the vector ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               OverscriptBox[
                StyleBox["A", "TI"], "\[RightVector]"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}], 
               StyleBox["v",
                FontSlant->"Plain"]], "\[LongEqual]", 
              RowBox[{"(", 
               RowBox[{
                SubsuperscriptBox[
                 StyleBox["A", "TI"], 
                 RowBox[{
                  StyleBox["LL",
                   FontSlant->"Plain"], ",", 
                  StyleBox["p", "TI"]}], "1"], ",", 
                SubsuperscriptBox[
                 StyleBox["A", "TI"], 
                 RowBox[{
                  StyleBox["LL",
                   FontSlant->"Plain"], ",", 
                  StyleBox["p", "TI"]}], "2"], ",", 
                SubsuperscriptBox[
                 StyleBox["A", "TI"], 
                 RowBox[{
                  StyleBox["LL",
                   FontSlant->"Plain"], ",", 
                  StyleBox["p", "TI"]}], "3"]}], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "4351c21d-f00a-4ad8-bf1b-6934f00921fa"],
           " and the real antisymmetric ",
           Cell[BoxData[
            FormBox[
             RowBox[{"3", "\[Times]", "3"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "e77f60d9-d8a3-4cde-ab60-1723a3f1e958"],
           " matrix with the entries ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubscriptBox[
               RowBox[{"(", 
                SubsuperscriptBox[
                 StyleBox["\[ScriptCapitalA]",
                  FontSlant->"Plain"], 
                 RowBox[{
                  StyleBox["LL",
                   FontSlant->"Plain"], ",", 
                  StyleBox["p", "TI"]}], 
                 StyleBox["v",
                  FontSlant->"Plain"]], ")"}], 
               RowBox[{"\[Iota]", 
                SuperscriptBox["\[Iota]", "\[Prime]\[Prime]"]}]], "\[LongEqual]", 
              UnderscriptBox["\[Sum]", 
               SuperscriptBox["\[Iota]", "\[Prime]"],
               LimitsPositioning->True], "\[ThinSpace]", 
              SubsuperscriptBox["\[Epsilon]", 
               RowBox[{"\[Iota]", 
                SuperscriptBox["\[Iota]", "\[Prime]"], 
                SuperscriptBox["\[Iota]", "\[Prime]\[Prime]"]}], 
               StyleBox["LL",
                FontSlant->"Plain"]], 
              SubsuperscriptBox[
               StyleBox["A", "TI"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}], 
               SuperscriptBox["\[Iota]", "\[Prime]"]]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "5f41652e-00e9-45eb-9c72-fe89cc619b4f"],
           ", so that ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["\[ScriptCapitalA]",
                FontSlant->"Plain"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}], 
               StyleBox["v",
                FontSlant->"Plain"]], 
              SubscriptBox[
               OverscriptBox[
                StyleBox["d", "TI"], "\[RightVector]"], 
               StyleBox["LL",
                FontSlant->"Plain"]], "\[LongEqual]", 
              SubsuperscriptBox[
               OverscriptBox[
                StyleBox["A", "TI"], "\[RightVector]"], 
               RowBox[{
                StyleBox["LL",
                 FontSlant->"Plain"], ",", 
                StyleBox["p", "TI"]}], 
               StyleBox["v",
                FontSlant->"Plain"]], "\[Times]", 
              SubscriptBox[
               OverscriptBox[
                StyleBox["d", "TI"], "\[RightVector]"], 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "82bab1b2-f8b0-4536-9d47-e68c02fdc7e2"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "88c0aed9-2a3a-40e1-82da-68b6d209672f"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["\[CapitalPsi]", "LL", "a"], "\", \"", 
            SubsuperscriptBox["\[CapitalPsi]", "LL", "b"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"Psi_a Psi_b\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "two arbitrary eight-component fields that transform like ",
           Cell[BoxData[
            FormBox[
             SubscriptBox["\[CapitalPsi]", 
              StyleBox["LL",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "9bbe6c94-0445-48c0-8087-3a072f1cada4"],
           "; used in the Leibniz rule of the covariant derivative of the SFBS"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "ab9e62e3-d146-4292-9982-dead9f925954"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["\[ScriptCapitalS]", "LL", "B"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"S_B\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the effective action of the SFBS: ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              StyleBox["exp",
               FontSlant->"Plain"], 
              RowBox[{"(", 
               RowBox[{
                StyleBox["i", "TI"], 
                SubsuperscriptBox[
                 StyleBox["\[ScriptCapitalS]",
                  FontSlant->"Plain"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["B",
                  FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "66c174bd-14ad-42ff-8017-8a0ad75f9cc7"],
           " is the functional integral over the spinor field of ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              StyleBox["exp",
               FontSlant->"Plain"], 
              RowBox[{"(", 
               RowBox[{
                StyleBox["i", "TI"], "\[ThinSpace]", "\[Integral]", 
                "\[ThinSpace]", 
                SuperscriptBox[
                 StyleBox["d", "TI"], "4"], 
                SubscriptBox[
                 StyleBox["x", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"]], "\[ThinSpace]", 
                SubsuperscriptBox[
                 StyleBox["\[ScriptCapitalL]",
                  FontSlant->"Plain"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["HS",
                  FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "67a54f8f-aa6f-42e0-836c-7595611d7ea8"],
           " at given ",
           Cell[BoxData[
            FormBox[
             SubscriptBox[
              OverscriptBox[
               StyleBox["d", "TI"], "\[RightVector]"], 
              StyleBox["LL",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "b9672e80-f095-4e75-b33c-b7580584f2e8"],
           " and given gauge fields"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "b485de7f-fed4-4ab3-bbdd-2e6121998064"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["\[ScriptCapitalL]", "LL", "B"], "\", \"", 
            SubsuperscriptBox["Z", "LL", "t"], "\", \"", 
            SubsuperscriptBox["Z", "LL", "s"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"Lagr_B Z_t Z_s Z_t0 Z_s0\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the effective Lagrangian density of the SFBS to second order in \
the derivatives, ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["Z", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["t",
                FontSlant->"Plain"]], "\[ThinSpace]", 
              UnderscriptBox["\[Sum]", "\[Iota]",
               LimitsPositioning->True], 
              SuperscriptBox[
               RowBox[{"\[LeftBracketingBar]", 
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{
                   SubsuperscriptBox["\[Del]", 
                    RowBox[{
                    StyleBox["LL",
                    FontSlant->"Plain"], ",", "0"}], 
                    StyleBox["B",
                    FontSlant->"Plain"]], 
                   SubscriptBox[
                    OverscriptBox[
                    StyleBox["d", "TI"], "\[RightVector]"], 
                    StyleBox["LL",
                    FontSlant->"Plain"]]}], ")"}], "\[Iota]"], 
                "\[RightBracketingBar]"}], "2"], "-", 
              SubsuperscriptBox[
               StyleBox["Z", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["s",
                FontSlant->"Plain"]], "\[ThinSpace]", 
              UnderscriptBox["\[Sum]", 
               StyleBox["j", "TI"],
               LimitsPositioning->True], "\[ThinSpace]", 
              UnderscriptBox["\[Sum]", "\[Iota]",
               LimitsPositioning->True], 
              SuperscriptBox[
               RowBox[{"\[LeftBracketingBar]", 
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{
                   SubsuperscriptBox["\[Del]", 
                    RowBox[{
                    StyleBox["LL",
                    FontSlant->"Plain"], ",", 
                    StyleBox["j", "TI"]}], 
                    StyleBox["B",
                    FontSlant->"Plain"]], 
                   SubscriptBox[
                    OverscriptBox[
                    StyleBox["d", "TI"], "\[RightVector]"], 
                    StyleBox["LL",
                    FontSlant->"Plain"]]}], ")"}], "\[Iota]"], 
                "\[RightBracketingBar]"}], "2"], "-", 
              SubscriptBox["\[CapitalOmega]", 
               StyleBox["LL",
                FontSlant->"Plain"]], 
              RowBox[{"(", 
               SubscriptBox[
                OverscriptBox[
                 StyleBox["d", "TI"], "\[RightVector]"], 
                StyleBox["LL",
                 FontSlant->"Plain"]], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "71417cf6-a27c-4322-9b96-f4873db31a06"],
           
           ", and its stiffness coefficients of the time derivatives and of \
the space derivatives; they depend on the vacuum about which the expansion is \
made, written as the argument: ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["Z", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["t",
                FontSlant->"Plain"]], 
              RowBox[{"(", "0", ")"}]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "ba4ee5b6-69aa-409c-8377-d4bdd0699cb9"],
           ", ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["Z", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["s",
                FontSlant->"Plain"]], 
              RowBox[{"(", "0", ")"}]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "99b63a36-1ea1-4ac4-80e9-898c3513b8ad"],
           " in the normal vacuum (plain text ",
           StyleBox["Z_t0",
            FontFamily->"Source Code Pro"],
           ", ",
           StyleBox["Z_s0",
            FontFamily->"Source Code Pro"],
           ")"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "cee10265-078b-41f6-ac77-834dd2fe943a"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            RowBox[{
              SubsuperscriptBox["\[Chi]", "LL", "pr"], "(", 
              SubsuperscriptBox["\[Omega]", "LL", "B"], ",", 
              SubsuperscriptBox["k", "LL", "B"], ")"}]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"chi_pr chi_pr_GL\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the pair susceptibility of the vacuum: the coefficient of ",
           Cell[BoxData[
            FormBox[
             SuperscriptBox[
              RowBox[{"\[LeftBracketingBar]", 
               SubscriptBox[
                OverscriptBox[
                 StyleBox["d", "TI"], "\[RightVector]"], 
                StyleBox["LL",
                 FontSlant->"Plain"]], "\[RightBracketingBar]"}], "2"], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "4922e053-65fa-4a12-ba23-de923ca86f1c"],
           
           " that the spinor field contributes to the effective action, per \
duration and volume, of a plane wave of the SFBS field with the frequency ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[Omega]", 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["B",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "41d0cb4c-fae3-4ec1-a68f-f483b9853c9a"],
           " and the wave number ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["k", "TI"], 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["B",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "c69609b5-ad4a-4193-a14c-78dd6c0a6313"],
           " (plain text ",
           StyleBox["chi_pr_GL",
            FontFamily->"Source Code Pro"],
           ": its derivative expansion to second order)"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "781cf026-5165-4e02-baf7-088527bea645"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["\[Omega]", "LL", "B"], "\", \"", 
            SubsuperscriptBox[
             OverscriptBox["k", "\[RightVector]"], "LL", "B"], "\", \"", 
            SubsuperscriptBox["k", "LL", "B"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"omega_B k_B omega_B_KG\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the frequency, the wave vector and the wave number of a plane \
wave of the SFBS field (plain text ",
           StyleBox["omega_B_KG",
            FontFamily->"Source Code Pro"],
           
           ": the frequency of the Klein-Gordon form of the effective field \
equation)"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "fee42f8a-d7cc-42e8-bcb5-3f0479bf78fb"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            RowBox[{
              SubsuperscriptBox["M", "LL", "pr"], "(", 
              SubscriptBox[
               OverscriptBox["q", "\[RightVector]"], "LL"], ",", 
              SubsuperscriptBox[
               OverscriptBox["k", "\[RightVector]"], "LL", "B"], ")"}], 
            "\", \"", 
            RowBox[{
              SubscriptBox["\[CurlyEpsilon]", "LL"], "(", "+", ")"}], 
            "\", \"", 
            RowBox[{
              SubscriptBox["\[CurlyEpsilon]", "LL"], "(", "-", ")"}]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"M_pr eps(+) eps(-)\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the pair matrix element ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              StyleBox["tr",
               FontSlant->"Plain"], 
              RowBox[{"(", 
               RowBox[{
                SubsuperscriptBox[
                 StyleBox["Y",
                  FontFamily->"Helvetica",
                  FontSlant->"Plain"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], "+"], 
                RowBox[{"(", 
                 RowBox[{
                  SubscriptBox[
                   OverscriptBox[
                    StyleBox["q", "TI"], "\[RightVector]"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]], "+", 
                  SubsuperscriptBox[
                   OverscriptBox[
                    StyleBox["k", "TI"], "\[RightVector]"], 
                   StyleBox["LL",
                    FontSlant->"Plain"], 
                   StyleBox["B",
                    FontSlant->"Plain"]], "/", "2"}], ")"}], 
                SubsuperscriptBox[
                 StyleBox["Y",
                  FontFamily->"Helvetica",
                  FontSlant->"Plain"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], "+"], 
                RowBox[{"(", 
                 RowBox[{
                  SubscriptBox[
                   OverscriptBox[
                    StyleBox["q", "TI"], "\[RightVector]"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]], "-", 
                  SubsuperscriptBox[
                   OverscriptBox[
                    StyleBox["k", "TI"], "\[RightVector]"], 
                   StyleBox["LL",
                    FontSlant->"Plain"], 
                   StyleBox["B",
                    FontSlant->"Plain"]], "/", "2"}], ")"}]}], ")"}]}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "86bd177d-7343-4bc2-8f02-475791862b68"],
           " of two spinor charges with the relative momentum ",
           Cell[BoxData[
            FormBox[
             SubscriptBox[
              OverscriptBox[
               StyleBox["q", "TI"], "\[RightVector]"], 
              StyleBox["LL",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "e412d234-9935-4c99-bef3-5bcf95a72892"],
           " and the total momentum ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              OverscriptBox[
               StyleBox["k", "TI"], "\[RightVector]"], 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["B",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "075b346c-87ef-44d9-aa3f-7524f06ab742"],
           ", and the energies ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubscriptBox["\[CurlyEpsilon]", 
               StyleBox["LL",
                FontSlant->"Plain"]], 
              RowBox[{"(", "\[PlusMinus]", ")"}], "\[LongEqual]", 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{
                 SuperscriptBox[
                  RowBox[{"\[LeftBracketingBar]", 
                   RowBox[{
                    SubscriptBox[
                    OverscriptBox[
                    StyleBox["q", "TI"], "\[RightVector]"], 
                    StyleBox["LL",
                    FontSlant->"Plain"]], "\[PlusMinus]", 
                    SubsuperscriptBox[
                    OverscriptBox[
                    StyleBox["k", "TI"], "\[RightVector]"], 
                    StyleBox["LL",
                    FontSlant->"Plain"], 
                    StyleBox["B",
                    FontSlant->"Plain"]], "/", "2"}], 
                   "\[RightBracketingBar]"}], "2"], "+", 
                 SubsuperscriptBox[
                  StyleBox["m", "TI"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], "2"]}], ")"}], 
               RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
            
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "05a170f1-b77c-435f-b77b-8c9337760c0f"],
           " of the two charges"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "f4eca28e-dea0-4edd-be37-83902f46e9d7"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            RowBox[{
              SubsuperscriptBox[
               TagBox[
                StyleBox[
                "H", FontFamily -> "Helvetica", FontSlant -> "Plain"], 
                "SL31SansSerif"], "LL", "mod"], "(", 
              SubscriptBox[
               OverscriptBox["q", "\[RightVector]"], "LL"], ")"}]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"H_mod\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the ",
           Cell[BoxData[
            FormBox[
             RowBox[{"16", "\[Times]", "16"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "74e69d04-e610-4f85-947f-c543f8603281"],
           " Bogoliubov matrix of the static pair field ",
           Cell[BoxData[
            FormBox[
             RowBox[{"(", 
              RowBox[{"0", ",", "0", ",", 
               SubsuperscriptBox[
                StyleBox["d", "TI"], 
                StyleBox["LL",
                 FontSlant->"Plain"], "3"], "\[ThinSpace]", 
               StyleBox["exp",
                FontSlant->"Plain"], 
               RowBox[{"(", 
                RowBox[{
                 StyleBox["i", "TI"], 
                 SubsuperscriptBox[
                  OverscriptBox[
                   StyleBox["k", "TI"], "\[RightVector]"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
                  StyleBox["B",
                   FontSlant->"Plain"]], "\[CenterDot]", 
                 SubscriptBox[
                  OverscriptBox[
                   StyleBox["x", "TI"], "\[RightVector]"], 
                  StyleBox["LL",
                   FontSlant->"Plain"]]}], ")"}]}], ")"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "b7ffc74a-1704-44c3-b1c3-7627dd4baee1"],
           " for the relative momentum ",
           Cell[BoxData[
            FormBox[
             SubscriptBox[
              OverscriptBox[
               StyleBox["q", "TI"], "\[RightVector]"], 
              StyleBox["LL",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "569e55ce-93f9-4d23-9843-502a7b543d0d"],
           ", acting on the Nambu pair ",
           Cell[BoxData[
            FormBox[
             RowBox[{"(", 
              RowBox[{
               SubscriptBox["\[CapitalPsi]", 
                StyleBox["LL",
                 FontSlant->"Plain"]], 
               RowBox[{"(", 
                RowBox[{
                 SubscriptBox[
                  OverscriptBox[
                   StyleBox["q", "TI"], "\[RightVector]"], 
                  StyleBox["LL",
                   FontSlant->"Plain"]], "+", 
                 SubsuperscriptBox[
                  OverscriptBox[
                   StyleBox["k", "TI"], "\[RightVector]"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
                  StyleBox["B",
                   FontSlant->"Plain"]], "/", "2"}], ")"}], ",", 
               SubscriptBox["\[CapitalPsi]", 
                StyleBox["LL",
                 FontSlant->"Plain"]], 
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{
                  SubsuperscriptBox[
                   OverscriptBox[
                    StyleBox["k", "TI"], "\[RightVector]"], 
                   StyleBox["LL",
                    FontSlant->"Plain"], 
                   StyleBox["B",
                    FontSlant->"Plain"]], "/", "2", "-", 
                  SubscriptBox[
                   OverscriptBox[
                    StyleBox["q", "TI"], "\[RightVector]"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]]}], ")"}], "*"]}], ")"}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "f1ed20d2-c495-46f3-a619-466ae13d9e84"]
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "f59d2f70-b05c-4bc6-8e11-f8dea87c155d"],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["G", "LL", "bd"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"G_bind\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the binding coupling, ",
           Cell[BoxData[
            FormBox[
             RowBox[{"1", "/", 
              SubsuperscriptBox[
               StyleBox["G", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["bd",
                FontSlant->"Plain"]], "\[LongEqual]", 
              SubsuperscriptBox["\[Chi]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["pr",
                FontSlant->"Plain"]], 
              RowBox[{"(", 
               RowBox[{"2", 
                SubscriptBox[
                 StyleBox["m", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"]], ",", "0"}], ")"}]}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "0ed0915e-01be-4517-b799-0cafa86f6586"],
           ": for ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox[
               StyleBox["G", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["bd",
                FontSlant->"Plain"]], "<", 
              SubscriptBox[
               StyleBox["G", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"]], "<", 
              SubsuperscriptBox[
               StyleBox["G", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["crit",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "ccc6f268-9276-4da9-9259-643944f99e30"],
           
           " the SFBS of the normal vacuum is a bound state of two spinor \
charges"
          }], "Text",
           FontFamily->"Source Sans Pro",
           FontSize->9.5,ExpressionUUID->
           "bc1e05b3-1eb4-4b47-9aaa-e408262121b5"],
