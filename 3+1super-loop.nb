              RowBox[{
                SubsuperscriptBox[
                 StyleBox["X", FontSlant -> "Plain"], "LL", "ph"], 
                "\[LongEqual]", 
                RowBox[{"(", 
                  Cell[
                   BoxData[
                    FormBox[
                    GridBox[{{
                    Cell[
                    TextData[{" ", 
                    Cell["0", "InlineFormula"], " "}]], 
                    Cell[
                    TextData[{" ", 
                    Cell[
                    BoxData[
                    SubscriptBox[
                    StyleBox["1", FontSlant -> "Plain"], "8"]], 
                    "InlineFormula"], " "}]]}, {
                    Cell[
                    TextData[{" ", 
                    Cell[
                    BoxData[
                    SubscriptBox[
                    StyleBox["1", FontSlant -> "Plain"], "8"]], 
                    "InlineFormula"], " "}]], 
                    Cell[
                    TextData[{" ", 
                    Cell["0", "InlineFormula"], " "}]]}}], TraditionalForm]]],
                   ")"}]}], TraditionalForm], 
             "\", with which the particle-hole symmetry reads \"", 
             FormBox[
              RowBox[{
                SubsuperscriptBox[
