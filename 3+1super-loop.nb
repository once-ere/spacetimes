   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"the", " ", "rotation", " ", "R", 
       RowBox[{"(", "U", ")"}]}], ":", " ", 
      RowBox[{"U", " ", "tau_iota", " ", 
       RowBox[{"U", "^", "dag"}]}]}], " ", "=", " ", 
     RowBox[{"sum_kappa", " ", "tau_kappa", " ", 
      RowBox[{
       RowBox[{"R", "[", "kappa", "]"}], "[", "iota", "]"}]}]}], " ", "*)"}], 
   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2adjoint", "[", "u_", "]"}], " ", ":=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Re", "[", 
         RowBox[{"Tr", "[", 
          RowBox[{
           RowBox[{"t2sigma", "[", "k", "]"}], " ", ".", " ", "u", " ", ".", 
           " ", 
           RowBox[{"t2sigma", "[", "i", "]"}], " ", ".", " ", 
           RowBox[{"ConjugateTranspose", "[", "u", "]"}]}], "]"}], "]"}], "/",
         "2"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
