         PaneBox[
          StyleBox[
           TemplateBox[{"\"the contact matrix: the real symmetric \"", 
             FormBox[
              RowBox[{"4", "\[Cross]", "4"}], TraditionalForm], 
             "\" matrix of the terms of \"", 
             FormBox[
              RowBox[{
                UnderscriptBox[
                "\[Sum]", "\[Iota]", LimitsPositioning -> True], "|", 
                SuperscriptBox[
                 RowBox[{"(", 
                   RowBox[{
                    SubsuperscriptBox["\[Del]", 
                    RowBox[{"LL", ",", 
                    StyleBox["p", "TI"]}], "B"], 
                    SubscriptBox[
                    OverscriptBox[
                    StyleBox["d", "TI"], "\[RightVector]"], "LL"]}], ")"}], 
                 "\[Iota]"], 
                SuperscriptBox["|", "2"]}], TraditionalForm], 
             "\" that are quadratic in the potentials \"", 
             FormBox[
              RowBox[{"(", 
                RowBox[{
                  SubsuperscriptBox[
                   StyleBox["A", "TI"], 
                   RowBox[{"LL", ",", 
                    StyleBox["p", "TI"]}], "F"], ",", 
                  SubsuperscriptBox[
                   StyleBox["A", "TI"], 
                   RowBox[{"LL", ",", 
                    StyleBox["p", "TI"]}], "1"], ",", 
                  SubsuperscriptBox[
                   StyleBox["A", "TI"], 
                   RowBox[{"LL", ",", 
                    StyleBox["p", "TI"]}], "2"], ",", 
                  SubsuperscriptBox[
                   StyleBox["A", "TI"], 
                   RowBox[{"LL", ",", 
                    StyleBox["p", "TI"]}], "3"]}], ")"}], TraditionalForm], 
             "\", with the corner entry \"", 
             FormBox[
              RowBox[{"4", 
                SuperscriptBox[
                 RowBox[{"(", 
                   SubsuperscriptBox[
                    StyleBox["g", "TI"], "LL", "F"], ")"}], "2"], "|", 
                SubscriptBox[
                 OverscriptBox[
                  StyleBox["d", "TI"], "\[RightVector]"], "LL"], 
                SuperscriptBox["|", "2"]}], TraditionalForm], 
             "\", the first row and column \"", 
             FormBox[
              RowBox[{"4", 
