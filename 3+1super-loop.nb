}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-8\>\"", ",", 
    " ", "\"\<the double sum of eta^LL_pp' x^p x^p' over p, p' = 0..3 (16 + 4 \
symbolized components) is (x^0)^2 - (x^1)^2 - (x^2)^2 - (x^3)^2\>\"", ",", 
    "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"Expand", "[", 
       RowBox[{"minkowski", " ", "-", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"xs", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "^", "2"}], " ", "-", " ", 
          RowBox[{
           RowBox[{"xs", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "^", "2"}], " ", "-", " ", 
