Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"GS", "-", "2"}], ":", " ", 
     RowBox[{"the", " ", "Lorentz", " ", "generators", " ", "sgen", 
      RowBox[{"(", 
       RowBox[{"J", "^", "j"}], ")"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"sgen", 
      RowBox[{"(", 
       RowBox[{"K", "^", "j"}], ")"}]}], ";", " ", 
     RowBox[{"the", " ", "27", " ", "relations", " ", "of", " ", "so", 
      RowBox[{"(", 
       RowBox[{"3", ",", "1"}], ")"}]}], ";", " ", 
     RowBox[{"the", " ", "24", " ", "intertwining", " ", "relations"}]}]}], 
   " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"sj", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"t2spinGen", "[", 
        RowBox[{"t2jgen", "[", "j", "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sk", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"t2spinGen", "[", 
        RowBox[{"t2kgen", "[", "j", "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"comm", "[", 
      RowBox[{"a_", ",", " ", "b_"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"a", " ", ".", " ", "b"}], " ", "-", " ", 
      RowBox[{"b", " ", ".", " ", "a"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"genOk", " ", "=", " ", 
     RowBox[{"And", " ", "@@", " ", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"jb", " ", "=", " ", 
              RowBox[{
               RowBox[{"Mod", "[", 
                RowBox[{"j", ",", " ", "3"}], "]"}], " ", "+", " ", "1"}]}], ",",
              " ", 
             RowBox[{"jc", " ", "=", " ", 
              RowBox[{
               RowBox[{"Mod", "[", 
                RowBox[{
                 RowBox[{"j", " ", "+", " ", "1"}], ",", " ", "3"}], "]"}], 
               " ", "+", " ", "1"}]}]}], "}"}], ",", "\n", "      ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"fro", "[", 
               RowBox[{
                RowBox[{"sj", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], " ", "-", " ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"g", "[", 
                   RowBox[{"[", 
                    RowBox[{"jb", " ", "+", " ", "1"}], "]"}], "]"}], " ", ".",
                   " ", 
                  RowBox[{"g", "[", 
                   RowBox[{"[", 
                    RowBox[{"jc", " ", "+", " ", "1"}], "]"}], "]"}]}], "/", 
                 "2"}]}], "]"}], " ", "<", " ", "tol"}], ",", " ", 
             RowBox[{
              RowBox[{"fro", "[", 
               RowBox[{
                RowBox[{"sk", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], " ", "-", " ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"g", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], " ", ".", " ", 
                  RowBox[{"g", "[", 
                   RowBox[{"[", 
                    RowBox[{"j", " ", "+", " ", "1"}], "]"}], "]"}]}], "/", 
                 "2"}]}], "]"}], " ", "<", " ", "tol"}], ",", "\n", "       ", 
             RowBox[{
              RowBox[{"fro", "[", 
               RowBox[{
                RowBox[{"sj", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], " ", "-", " ", 
                RowBox[{"ArrayFlatten", "[", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"-", "I"}], "/", "2"}], " ", 
                    RowBox[{"t2sigma", "[", "j", "]"}]}], ",", " ", "0"}], 
                    "}"}], ",", " ", 
                   RowBox[{"{", 
                    RowBox[{"0", ",", " ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"-", "I"}], "/", "2"}], " ", 
                    RowBox[{"t2sigma", "[", "j", "]"}]}]}], "}"}]}], "}"}], 
                 "]"}]}], "]"}], " ", "<", " ", "tol"}], ",", "\n", "       ", 
             RowBox[{
              RowBox[{"fro", "[", 
               RowBox[{
                RowBox[{"sk", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], " ", "-", " ", 
                RowBox[{"ArrayFlatten", "[", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"-", "1"}], "/", "2"}], " ", 
                    RowBox[{"t2sigma", "[", "j", "]"}]}], ",", " ", "0"}], 
                    "}"}], ",", " ", 
                   RowBox[{"{", 
                    RowBox[{"0", ",", " ", 
                    RowBox[{
                    RowBox[{"1", "/", "2"}], " ", 
                    RowBox[{"t2sigma", "[", "j", "]"}]}]}], "}"}]}], "}"}], 
                 "]"}]}], "]"}], " ", "<", " ", "tol"}]}], "}"}]}], "]"}], ",",
          " ", 
         RowBox[{"{", 
          RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rel", " ", "=", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"lj", " ", "=", " ", 
             RowBox[{"Sum", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"t2eps3", "[", 
                 RowBox[{"a", ",", " ", "b", ",", " ", "c"}], "]"}], " ", 
                RowBox[{"sj", "[", 
                 RowBox[{"[", "c", "]"}], "]"}]}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"c", ",", " ", "3"}], "}"}]}], "]"}]}], ",", " ", 
            RowBox[{"lk", " ", "=", " ", 
             RowBox[{"Sum", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"t2eps3", "[", 
                 RowBox[{"a", ",", " ", "b", ",", " ", "c"}], "]"}], " ", 
                RowBox[{"sk", "[", 
                 RowBox[{"[", "c", "]"}], "]"}]}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"c", ",", " ", "3"}], "}"}]}], "]"}]}]}], "}"}], ",", 
          "\n", "      ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"fro", "[", 
              RowBox[{
               RowBox[{"comm", "[", 
                RowBox[{
                 RowBox[{"sj", "[", 
                  RowBox[{"[", "a", "]"}], "]"}], ",", " ", 
                 RowBox[{"sj", "[", 
                  RowBox[{"[", "b", "]"}], "]"}]}], "]"}], " ", "-", " ", 
               "lj"}], "]"}], " ", "<", " ", "tol"}], ",", " ", 
            RowBox[{
             RowBox[{"fro", "[", 
              RowBox[{
               RowBox[{"comm", "[", 
                RowBox[{
                 RowBox[{"sj", "[", 
                  RowBox[{"[", "a", "]"}], "]"}], ",", " ", 
                 RowBox[{"sk", "[", 
                  RowBox[{"[", "b", "]"}], "]"}]}], "]"}], " ", "-", " ", 
               "lk"}], "]"}], " ", "<", " ", "tol"}], ",", " ", 
            RowBox[{
             RowBox[{"fro", "[", 
              RowBox[{
               RowBox[{"comm", "[", 
                RowBox[{
                 RowBox[{"sk", "[", 
                  RowBox[{"[", "a", "]"}], "]"}], ",", " ", 
                 RowBox[{"sk", "[", 
                  RowBox[{"[", "b", "]"}], "]"}]}], "]"}], " ", "+", " ", 
               "lj"}], "]"}], " ", "<", " ", "tol"}]}], "}"}]}], "]"}], ",", 
        " ", 
        RowBox[{"{", 
         RowBox[{"a", ",", " ", "3"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"b", ",", " ", "3"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"intertw", " ", "=", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"s", " ", "=", " ", 
             RowBox[{"t2spinGen", "[", "u", "]"}]}], ",", " ", 
            RowBox[{"v", " ", "=", " ", 
             RowBox[{"t2vecAction", "[", "u", "]"}]}]}], "}"}], ",", "\n", 
          "      ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"fro", "[", 
              RowBox[{
               RowBox[{"comm", "[", 
                RowBox[{
                 RowBox[{"g", "[", 
                  RowBox[{"[", 
                   RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}], ",", " ", 
                 "s"}], "]"}], " ", "-", " ", 
               RowBox[{"Sum", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"v", "[", 
                   RowBox[{"[", 
                    RowBox[{
                    RowBox[{"p", " ", "+", " ", "1"}], ",", " ", 
                    RowBox[{"q", " ", "+", " ", "1"}]}], "]"}], "]"}], " ", 
                  RowBox[{"g", "[", 
                   RowBox[{"[", 
                    RowBox[{"q", " ", "+", " ", "1"}], "]"}], "]"}]}], ",", 
                 " ", 
                 RowBox[{"{", 
                  RowBox[{"q", ",", " ", "0", ",", " ", "3"}], "}"}]}], 
                "]"}]}], "]"}], " ", "<", " ", "tol"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], 
         "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"j", ",", " ", "3"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"u", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"t2jgen", "[", "j", "]"}], ",", " ", 
            RowBox[{"t2kgen", "[", "j", "]"}]}], "}"}]}], "}"}]}], "]"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<GS-2\>\"", ",", 
     " ", "\"\<the Lorentz generators of the super-loop on the Dirac spinor, \
sgen(J^j) = diag(-i sigma_j/2, -i sigma_j/2) = gamma^j' gamma^j''/2, \
sgen(K^j) = diag(-sigma_j/2, sigma_j/2) = gamma^0 gamma^j/2; the 27 relations \
of so(3,1); 24 intertwining relations [gamma^p, sgen(u)] = sum V(u)[p][q] \
gamma^q\>\"", ",", "\n", "  ", 
     RowBox[{"genOk", " ", "&&", " ", 
      RowBox[{"(", 
       RowBox[{"And", " ", "@@", " ", "rel"}], ")"}], " ", "&&", " ", 
      RowBox[{"(", 
       RowBox[{"And", " ", "@@", " ", "intertw"}], ")"}]}], ",", " ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Length", "[", "rel", "]"}], ",", 
        " ", "\"\< commutation relations, \>\"", ",", " ", 
        RowBox[{"Length", "[", "intertw", "]"}], ",", 
        " ", "\"\< intertwining relations (original: 27 and 24)\>\""}], "}"}],
       "]"}]}], "]"}]}]}]], "Input",
