          ImageSize->95], 
         PaneBox[
          StyleBox[
           TemplateBox[{"\"the pair susceptibility of a direction \"", 
             FormBox[
              SubsuperscriptBox[
               OverscriptBox[
                StyleBox["u", "TI"], "\[RightVector]"], "LL", "f"], 
