               "b8cd0a5a-1a72-4f7f-a627-db8d22304d75"],
              ImageSize->290]},
            {
             PaneBox[
              TemplateBox[{
                TagBox[
                 StyleBox["a", FontWeight -> "Bold", FontSlant -> "Plain"], 
                 "SL31Bold"], "\", \"", 
                TagBox[
                 StyleBox["b", FontWeight -> "Bold", FontSlant -> "Plain"], 
                 "SL31Bold"], "\", \"", 
