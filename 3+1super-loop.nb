             FormBox[
              RowBox[{
                SuperscriptBox[
                 RowBox[{"(", 
                   SubsuperscriptBox[
                    StyleBox["M", "TI"], "LL", "W"], ")"}], "2"], 
                "\[LongEqual]", "2", 
                SubsuperscriptBox[
