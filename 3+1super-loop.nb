                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "f90f742d-0607-4410-97da-3670040934dc"],
               " in the chiral basis, ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubsuperscriptBox["\[Gamma]", 
                   StyleBox["LL",
                    FontSlant->"Plain"], "0"], "\[LongEqual]", 
                  RowBox[{"(", "\[NoBreak]", GridBox[{
                    {"0", 
                    SubsuperscriptBox["\[Sigma]", "0", 
                    StyleBox["LL",
                    FontSlant->"Plain"]]},
                    {
                    SubsuperscriptBox["\[Sigma]", "0", 
                    StyleBox["LL",
                    FontSlant->"Plain"]], "0"}
                    },
                    
                    GridBoxAlignment->{
                    "Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
                    GridBoxSpacings->{"Columns" -> {
                    Offset[0.27999999999999997`], {
                    Offset[0.7]}, 
