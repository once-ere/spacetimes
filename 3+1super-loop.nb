           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           
           "the mixing angle: the angle between the massless gauge field (the \
null vector of the mass matrix) and the axis of the potential ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["A", "TI"], 
              RowBox[{
               StyleBox["LL",
                FontSlant->"Plain"], ",", 
               StyleBox["p", "TI"]}], "3"], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "5e066c40-1496-49c9-91d5-33adafab41b1"],
           " in the plane of ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["A", "TI"], 
              RowBox[{
               StyleBox["LL",
                FontSlant->"Plain"], ",", 
               StyleBox["p", "TI"]}], 
              StyleBox["F",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "14579d26-2f51-45d4-a67c-a1d2a75a2e15"],
           " and ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              StyleBox["A", "TI"], 
              RowBox[{
               StyleBox["LL",
                FontSlant->"Plain"], ",", 
               StyleBox["p", "TI"]}], "3"], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "8758318a-8c19-4074-87a5-9d28f089059d"],
           "; zero in the vacuum, ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              StyleBox["arctan",
               FontSlant->"Plain"], 
              RowBox[{"(", 
               RowBox[{
                SubsuperscriptBox[
                 StyleBox["g", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["v",
                  FontSlant->"Plain"]], "/", 
                RowBox[{"(", 
                 RowBox[{"2", 
                  SubsuperscriptBox[
                   StyleBox["g", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"], 
                   StyleBox["F",
                    FontSlant->"Plain"]]}], ")"}]}], ")"}]}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "d42b16a2-5c2f-45ac-9c43-22a65c125e95"],
           
           " at the non-unitary saddle point (plain text: the values found at \
