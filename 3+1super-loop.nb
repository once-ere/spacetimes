             PaneBox[
              StyleBox["\<\"vI\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[Cell["\<\
a unit (bi-)quaternion that rotates the isospin of the spinor charges (from \
the left)\
\>", "Text",
               FontFamily->"Source Sans Pro",
               FontSize->9.5,ExpressionUUID->
               "a13cbeab-b83b-44a2-adac-224c0f0fc0e4"],
              ImageSize->290]},
            {
             PaneBox[
              TemplateBox[{
                SubscriptBox["\[GothicM]", "LL"], "\", \"", 
                SubscriptBox["\[GothicL]", "LL"], "\", \"", 
                SubscriptBox["\[GothicS]", "LL"]},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              StyleBox["\<\"m_LL l_LL s_LL\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[Cell[TextData[{
               "the Malcev algebra of the super-loop, ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubscriptBox[
                   StyleBox["\[GothicM]",
                    FontSlant->"Plain"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]], "\[LongEqual]", 
                  StyleBox["\[DoubleStruckCapitalC]",
                   FontSlant->"Plain"], "\[CircleTimes]", 
                  StyleBox["Im",
                   FontSlant->"Plain"], "\[ThinSpace]", 
                  StyleBox["\[DoubleStruckCapitalO]",
                   FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "3e167ca2-66e5-4f83-9583-96c9248ddb5a"],
               " with the commutator (real dimension 14), its Lorentz part ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubscriptBox[
                   StyleBox["\[GothicL]",
                    FontSlant->"Plain"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]], "\[LongEqual]", 
                  StyleBox["\[DoubleStruckCapitalC]",
                   FontSlant->"Plain"], "\[CircleTimes]", 
                  StyleBox["Im",
                   FontSlant->"Plain"], "\[ThinSpace]", 
                  StyleBox["\[DoubleStruckCapitalH]",
                   FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "80b188fe-a37b-4111-a4bf-d30de8355274"],
               " (6, a Lie algebra isomorphic to ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  StyleBox["\[GothicS]\[GothicO]",
                   FontSlant->"Plain"], 
                  RowBox[{"(", 
                   RowBox[{"3", ",", "1"}], ")"}]}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "2af56966-4a5f-4d78-8cb9-b1d499a7efb4"],
               "), and the space of spinor charges ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubscriptBox[
                   StyleBox["\[GothicS]",
                    FontSlant->"Plain"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]], "\[LongEqual]", 
                  RowBox[{"(", 
                   RowBox[{
                    StyleBox["\[DoubleStruckCapitalC]",
                    FontSlant->"Plain"], "\[CircleTimes]", 
                    StyleBox["\[DoubleStruckCapitalH]",
                    FontSlant->"Plain"]}], ")"}], "\[ThinSpace]", 
                  SubscriptBox[
                   StyleBox["e",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], "4"]}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "9cb62a4c-74ac-4f38-a5f6-63e229951f32"],
               " (8); ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubscriptBox[
                   StyleBox["\[GothicM]",
                    FontSlant->"Plain"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]], "\[LongEqual]", 
                  SubscriptBox[
                   StyleBox["\[GothicL]",
                    FontSlant->"Plain"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]], "\[CirclePlus]", 
                  SubscriptBox[
                   StyleBox["\[GothicS]",
                    FontSlant->"Plain"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "dc343eb3-c580-41f8-9c31-91fbbea1e569"]
              }], "Text",
               FontFamily->"Source Sans Pro",
               FontSize->9.5,ExpressionUUID->
               "149c9a1f-70e1-46a6-8a33-0392ed6590b6"],
              ImageSize->290]},
            {
             PaneBox[
              TemplateBox[{
                SubsuperscriptBox["J", "LL", "j"], "\", \"", 
