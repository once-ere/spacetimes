                    RowBox[{"(", 
                    SubsuperscriptBox[
                    StyleBox["A", "TI"], 
                    RowBox[{"LL", ",", "0"}], "\[Iota]"], ")"}], "2"]}], 
                   ")"}], 
                 RowBox[{"1", "/", "2"}]]}], TraditionalForm], 
             "\"; the axis of the rotation is the direction of the potential \
in isospin space\""},
            "RowDefault"],
           StripOnInput->False,
           FontFamily->"Source Sans Pro",
