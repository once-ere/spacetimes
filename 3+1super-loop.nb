                  SuperscriptBox[
                   RowBox[{"(", "3", ",", "1", ")"}], "+"]}], "\", \"", 
                
                RowBox[{
                 "S", "O", "(", "4", ",", "\[DoubleStruckCapitalC]", ")"}], 
