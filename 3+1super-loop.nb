     RowBox[{"t2Seed", "[", "s", "]"}], " ", "starts", " ", "a", " ", "new", " ",
      "sequence"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"t2Seed", "[", "s_Integer", "]"}], " ", ":=", " ", 
     RowBox[{"(", 
      RowBox[{"t2rngState", " ", "=", " ", 
       RowBox[{"Mod", "[", 
        RowBox[{"s", ",", " ", 
         RowBox[{"2", "^", "64"}]}], "]"}]}], ")"}]}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{" ", 
     RowBox[{"one", " ", "step", " ", "of", " ", 
      RowBox[{"SplitMix64", ":", " ", 
       RowBox[{"returns", " ", "an", " ", "integer", " ", 
        RowBox[{"in", " ", "[", 
         RowBox[{"0", ",", " ", 
          RowBox[{"2", "^", "64"}]}]}]}]}]}], ")"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2NextU64", "[", "]"}], " ", ":=", " ", 
