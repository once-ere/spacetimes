                "1150eb00-eb40-471a-a3c2-cac2404ab3da"],
               ")"
              }], "Text",
               FontFamily->"Source Sans Pro",
               FontSize->9.5,ExpressionUUID->
               "cc7a0566-ca00-4033-acae-9418e116ca28"],
              ImageSize->290]},
            {
             PaneBox[
              TemplateBox[{
                RowBox[{"[", 
                  TagBox[
                   StyleBox["x", FontWeight -> "Bold", FontSlant -> "Plain"], 
