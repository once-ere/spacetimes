               "]"}]}], "]"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"a", ",", " ", "3"}], "}"}]}], "]"}]}]}], "]"}], ",", 
      "\n", "  ", 
      RowBox[{"{", "100", "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
