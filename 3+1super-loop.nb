       GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
      "Column"]},
    {
     TagBox[GridBox[{
        {
         StyleBox["\<\"5 The manifolds\"\>",
          StripOnInput->False,
          FontSize->12,
          FontWeight->Bold]},
        {
         TagBox[GridBox[{
            {
             StyleBox["\<\"symbol\"\>",
              StripOnInput->False,
              FontFamily->"Source Sans Pro",
              FontWeight->Bold], 
             StyleBox["\<\"plain-text names\"\>",
              StripOnInput->False,
              FontFamily->"Source Sans Pro",
              FontWeight->Bold], 
             StyleBox["\<\"meaning\"\>",
              StripOnInput->False,
              FontFamily->"Source Sans Pro",
              FontWeight->Bold]},
            {
             PaneBox[
              TemplateBox[{
                SubsuperscriptBox["\[DoubleStruckCapitalR]", "LL", 
                 RowBox[{"1", ",", "7"}]], "\", \"", 
                SubsuperscriptBox["\[DoubleStruckCapitalR]", "LL", 
                 RowBox[{"1", ",", "3"}]], "\", \"", 
                SubsuperscriptBox["x", "LL", "p"]},
               "RowDefault"],
              ImageSize->125], 
             PaneBox[
              
              StyleBox["\<\"R^(1,7)_LL R^(1,3)_LL x_LL^0 x_LL^p x_LL^1 x_LL^2 \
x_LL^3 x_LL^j\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[
              StyleBox[
               TemplateBox[{"\"the Hermitian bi-octonions \"", 
                 FormBox[
                  RowBox[{
