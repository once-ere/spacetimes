Cell[CellGroupData[{

Cell["\<\
II.1.3 The super-loop operators as matrices (t2core/src/model.rs)\
\>", "Subsection",ExpressionUUID->"cfdf594b-c5d1-4328-b898-cb2e40e89e93"],

Cell[TextData[{
 "Every matrix of the field equations is built from the matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "262771cd-779f-4b07-be46-630514d99f56"],
 " of a bi-quaternion. A bi-quaternion ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["b",
     FontWeight->"Bold",
     FontSlant->"Plain"], "\[LongEqual]", 
    UnderoverscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["p", "TI"], "\[LongEqual]", "0"}], "3",
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox["\[Xi]", 
     StyleBox["p", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["p", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2af17317-acd9-4d48-83fa-417a030b1355"],
 " (four complex coefficients ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Xi]", 
     StyleBox["p", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4af0d086-8bc9-43c3-ab7d-d65ae937a510"],
 ") has the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Times]", "2"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d8f81872-c1e2-4887-b324-a02cf3c0de8a"],
 " matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[LongEqual]", 
    SubsuperscriptBox["\[Xi]", "0", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    SubsuperscriptBox["\[Sigma]", "0", 
     StyleBox["LL",
      FontSlant->"Plain"]], "-", 
    StyleBox["i", "TI"], "\[ThinSpace]", 
    UnderoverscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["j", "TI"], "\[LongEqual]", "1"}], "3",
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox["\[Xi]", 
     StyleBox["j", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    SubsuperscriptBox["\[Sigma]", 
     StyleBox["j", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a552af38-cecb-45f8-a5f8-dffccb1bded9"],
 ", so that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubscriptBox[
      StyleBox["e",
       FontWeight->"Bold",
       FontSlant->"Plain"], "0"], ")"}], "\[LongEqual]", 
    SubsuperscriptBox["\[Sigma]", "0", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b460cf3e-99cc-4053-99d5-8e1c0b942d39"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubscriptBox[
      StyleBox["e",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      StyleBox["j", "TI"]], ")"}], "\[LongEqual]", 
    RowBox[{"-", 
     StyleBox["i", "TI"]}], 
    SubsuperscriptBox["\[Sigma]", 
     StyleBox["j", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "44874482-aaea-4595-afb0-582beb6fcf78"],
 ". The canonical frame of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[DoubleStruckCapitalR]",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    RowBox[{"1", ",", "3"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e818801e-e36c-4a3f-8241-380970d26b5b"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["f",
      FontWeight->"Bold",
      FontSlant->"Plain"], "0"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "0"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3b5f940b-ef9a-4503-8b68-7d618dbf0f97"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["f",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]], "\[LongEqual]", 
    StyleBox["i", "TI"], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "44ee5743-1d29-46d4-8e1e-c5823716e669"],
 ", with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubscriptBox[
      StyleBox["f",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      StyleBox["p", "TI"]], ")"}], "\[LongEqual]", 
    SubsuperscriptBox["\[Sigma]", 
     StyleBox["p", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "53637fc1-ba8f-43e7-a6d0-cf26fb61837f"],
 ". The Dirac matrices of a frame are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p", "TI"]], 
    RowBox[{"[", 
     StyleBox["f",
      FontWeight->"Bold",
      FontSlant->"Plain"], "]"}], "\[LongEqual]", 
    RowBox[{"(", "\[NoBreak]", GridBox[{
       {"0", 
        RowBox[{
         SubscriptBox[
          StyleBox["M", "TI"], 
          StyleBox["LL",
           FontSlant->"Plain"]], 
         RowBox[{"(", 
          SubscriptBox[
           StyleBox["f",
            FontWeight->"Bold",
            FontSlant->"Plain"], 
           StyleBox["p", "TI"]], ")"}]}]},
       {
        RowBox[{
         SubscriptBox[
          StyleBox["M", "TI"], 
          StyleBox["LL",
           FontSlant->"Plain"]], 
         RowBox[{"(", 
          SubscriptBox[
           OverscriptBox[
            StyleBox["f",
             FontWeight->"Bold",
             FontSlant->"Plain"], "_"], 
           StyleBox["p", "TI"]], ")"}]}], "0"}
      },
      GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
      GridBoxSpacings->{"Columns" -> {
          Offset[0.27999999999999997`], {
           Offset[0.7]}, 
          Offset[0.27999999999999997`]}, "Rows" -> {
          Offset[0.2], {
           Offset[0.4]}, 
          Offset[0.2]}}], "\[NoBreak]", ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e4f55333-7fcd-4e54-8275-973d05165d36"],
 " (the chiral basis; ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["b",
     FontWeight->"Bold",
     FontSlant->"Plain"], "_"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1dd4631a-0a61-430f-926b-f51279800927"],
 " is the conjugate bi-quaternion, in which the signs of the coefficients of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "1"], ",", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "2"], ",", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "3"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "beab1b8d-1ba8-4c94-9082-b64de4735128"],
 " change); for the canonical frame they are ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "faefbf92-744b-49b0-9c5f-aafb82390671"],
 ". The spinor field ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e3a70f5a-779a-47c8-b7c9-eaff611cdd84"],
 " has the 8 components ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPsi]", 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", "1"}]], ",", "\[Ellipsis]", ",", 
    SubscriptBox["\[CapitalPsi]", 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", "8"}]]}], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f48810af-f343-4b23-abf3-e19e9b178747"],
 ": components 1 and 2 are the first Dirac component with isospin up and \
down, 3 and 4 the second, 5 and 6 the third, 7 and 8 the fourth. A ",
 Cell[BoxData[
  FormBox[
   RowBox[{"4", "\[Times]", "4"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a5d375c4-0159-4255-a538-dfd63a460cb9"],
 " matrix of the Dirac index therefore acts on the eight components as its \
Kronecker product with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["1",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "346a88a4-cbab-4f2f-a726-88e6a8b0b67b"],
 ", and a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Times]", "2"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "43e6918d-1ef0-4aa4-b6fb-f840ceeaac18"],
 " matrix of the isospin index as the Kronecker product of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["1",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "4"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "74c48b7d-50d0-4e4c-8423-00b6d9cf7edc"],
 " with it. The cell defines every function of model.rs, in the same order; \
the comment of each function states the formula."
}], "Text",ExpressionUUID->"e750ad75-0ca9-4f5c-894f-4bec84eac6c1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", "Pauli", " ", "matrices", " ", "sigma_", "0", " ", 
     RowBox[{"(", "unit", ")"}]}], ",", " ", 
    RowBox[{"sigma_", "1"}], ",", " ", 
    RowBox[{"sigma_", "2"}], ",", " ", 
    RowBox[{"sigma_", "3"}], ",", " ", 
    RowBox[{
     RowBox[{"and", " ", "eps2"}], " ", "=", " ", 
     RowBox[{"i", " ", "sigma_", "2"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"t2sigma", "[", "0", "]"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1"}], "}"}]}], "}"}]}], ";", " ", 
    RowBox[{
     RowBox[{"t2sigma", "[", "1", "]"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2sigma", "[", "2", "]"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", 
         RowBox[{"-", "I"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"I", ",", " ", "0"}], "}"}]}], "}"}]}], ";", " ", 
    RowBox[{
     RowBox[{"t2sigma", "[", "3", "]"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", 
         RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"t2eps2", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "0"}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"M_LL", 
        RowBox[{"(", "b", ")"}], " ", "of", " ", "the", " ", "bi"}], "-", 
       RowBox[{"quaternion", " ", "b"}]}], " ", "=", " ", 
      RowBox[{"sum_p", " ", "xi_p", " ", "e_p"}]}], ",", " ", 
     RowBox[{"xi", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"xi_", "0"}], ",", " ", 
        RowBox[{"xi_", "1"}], ",", " ", 
        RowBox[{"xi_", "2"}], ",", " ", 
        RowBox[{"xi_", "3"}]}], "}"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2mq", "[", "xi_List", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"xi", "[", 
        RowBox[{"[", "1", "]"}], "]"}], " ", 
       RowBox[{"t2sigma", "[", "0", "]"}]}], " ", "-", " ", 
      RowBox[{"I", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"xi", "[", 
           RowBox[{"[", "2", "]"}], "]"}], " ", 
          RowBox[{"t2sigma", "[", "1", "]"}]}], " ", "+", " ", 
         RowBox[{
          RowBox[{"xi", "[", 
           RowBox[{"[", "3", "]"}], "]"}], " ", 
          RowBox[{"t2sigma", "[", "2", "]"}]}], " ", "+", " ", 
         RowBox[{
