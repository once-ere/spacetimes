             RowBox[{"2", ",", " ", "2"}], "]"}], "]"}]}], ")"}], "/", 
         "2"}]}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2bqMul", "[", 
      RowBox[{"x_", ",", " ", "y_"}], "]"}], " ", ":=", " ", 
     RowBox[{"t2bqFrom", "[", 
      RowBox[{
       RowBox[{"t2mq", "[", "x", "]"}], " ", ".", " ", 
       RowBox[{"t2mq", "[", "y", "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2bqStar", "[", "x_", "]"}], " ", ":=", " ", 
     RowBox[{"Conjugate", "[", "x", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2bqDag", "[", "x_", "]"}], " ", ":=", " ", 
     RowBox[{"Conjugate", "[", 
      RowBox[{"t2bqConj", "[", "x", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "Weyl", " ", "isodoublet", " ", "of", " ", "a", " ", 
      "spinor", " ", "charge", " ", "y", " ", 
      RowBox[{"e4", ":", " ", 
       RowBox[{
        RowBox[{"psi", "'"}], 
        RowBox[{"(", "y", ")"}]}]}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"eps2", "^", 
       RowBox[{"-", "1"}]}], " ", "M_LL", 
      RowBox[{
       RowBox[{"(", "y", ")"}], "^", "T"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"rows", ":", " ", 
         RowBox[{"Weyl", " ", "index"}]}], ",", " ", 
        RowBox[{"columns", ":", " ", "isospin"}]}], ")"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2psiPrime", "[", "y_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"t2inv2", "[", "t2eps2", "]"}], " ", ".", " ", 
      RowBox[{"Transpose", "[", 
       RowBox[{"t2mq", "[", "y", "]"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "Dirac", " ", "isodoublet", " ", "of", " ", "two", " ", 
      "spinor", " ", 
      RowBox[{"charges", ":", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"components", " ", "1"}], ".."}], "4", " ", "are", " ", 
        "the", " ", "rows", " ", "of", " ", 
        RowBox[{"psi", "'"}], 
        RowBox[{"(", "y", ")"}]}]}]}], ",", " ", 
     RowBox[{
      RowBox[{"5", ".."}], "8", " ", "those", " ", "of", " ", 
      RowBox[{"psi", "'"}], 
      RowBox[{"(", "b", ")"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2diracFromCharges", "[", 
      RowBox[{"y_", ",", " ", "b_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{"t2psiPrime", "[", "y", "]"}], "]"}], ",", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{"t2psiPrime", "[", "b", "]"}], "]"}]}], "]"}]}], ";"}], "\n", 
   
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"the", " ", "Cayley"}], "-", 
      RowBox[{"Dickson", " ", "product", " ", 
       RowBox[{"(", 
        RowBox[{"a", " ", "+", " ", 
         RowBox[{"b", " ", "e4"}]}], ")"}], 
       RowBox[{"(", 
        RowBox[{"c", " ", "+", " ", 
         RowBox[{"d", " ", "e4"}]}], ")"}]}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"a", " ", "c"}], " ", "-", " ", 
        RowBox[{"conj", 
         RowBox[{"(", "d", ")"}], " ", "b"}]}], ")"}], " ", "+", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"d", " ", "a"}], " ", "+", " ", 
         RowBox[{"b", " ", "conj", 
          RowBox[{"(", "c", ")"}]}]}], ")"}], " ", "e4"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2bioctMul", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a_", ",", " ", "b_"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"cq_", ",", " ", "d_"}], "}"}]}], "]"}], " ", ":=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"t2bqMul", "[", 
         RowBox[{"a", ",", " ", "cq"}], "]"}], " ", "-", " ", 
        RowBox[{"t2bqMul", "[", 
         RowBox[{
          RowBox[{"t2bqConj", "[", "d", "]"}], ",", " ", "b"}], "]"}]}], ",", 
       " ", 
       RowBox[{
        RowBox[{"t2bqMul", "[", 
         RowBox[{"d", ",", " ", "a"}], "]"}], " ", "+", " ", 
        RowBox[{"t2bqMul", "[", 
         RowBox[{"b", ",", " ", 
          RowBox[{"t2bqConj", "[", "cq", "]"}]}], "]"}]}]}], "}"}]}], 
    ";"}]}]}]], "Input",
 CellLabel->
  "In[179]:=",ExpressionUUID->"6ada900a-08fb-4f2c-9768-7d254c20ceef"],

