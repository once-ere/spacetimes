Cell[TextData[{
 "S-10, the longitudinal vector boson. For a plane wave of wave number ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["k", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["B",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d9dc734d-c497-4858-a6bf-c2135ee69ba5"],
 " and frequency ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Omega]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["B",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f7373224-3c08-4d98-9aba-9a1634deb7fc"],
 " the time component and the longitudinal component of a massive vector \
field obey two linear equations; their determinant is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox[
         StyleBox["k", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], 
         StyleBox["B",
          FontSlant->"Plain"]], ")"}], "2"], "+", 
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox[
         StyleBox["Z", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], 
         StyleBox["t",
          FontSlant->"Plain"]], "/", 
        SubsuperscriptBox[
         StyleBox["Z", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], 
         StyleBox["s",
          FontSlant->"Plain"]]}], ")"}], 
      SuperscriptBox[
       StyleBox["M", "TI"], "2"]}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox["\[Omega]", 
         StyleBox["LL",
          FontSlant->"Plain"], 
         StyleBox["B",
          FontSlant->"Plain"]], ")"}], "2"], "-", 
      SuperscriptBox[
       StyleBox["M", "TI"], "2"]}], ")"}], "-", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["k", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], 
        StyleBox["B",
         FontSlant->"Plain"]], 
       SubsuperscriptBox["\[Omega]", 
        StyleBox["LL",
         FontSlant->"Plain"], 
        StyleBox["B",
         FontSlant->"Plain"]]}], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "baadf6ed-4eb8-4afd-babc-053477322901"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["M", "TI"], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["W",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "54be214d-4353-4292-bb49-d7a936869fca"],
 ". The cell checks with ",
 StyleBox["Factor",
  FontFamily->"Source Code Pro"],
 " and ",
 StyleBox["Solve",
  FontFamily->"Source Code Pro"],
 " that it vanishes exactly for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[Omega]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["B",
        FontSlant->"Plain"]], ")"}], "2"], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["W",
        FontSlant->"Plain"]], ")"}], "2"], "+", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["Z", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["s",
        FontSlant->"Plain"]], "/", 
      SubsuperscriptBox[
       StyleBox["Z", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["t",
        FontSlant->"Plain"]]}], ")"}], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["k", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["B",
        FontSlant->"Plain"]], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3f78f81c-32cf-4f71-9980-d9ecbcb4b6e0"],
 ": the absorbed Goldstone boson moves with the velocity ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["Z", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["s",
        FontSlant->"Plain"]], "/", 
      SubsuperscriptBox[
       StyleBox["Z", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["t",
        FontSlant->"Plain"]]}], ")"}], 
    RowBox[{"1", "/", "2"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5dbc6f51-fcd2-430f-9e0f-dbac47005806"],
 "."
}], "Text",ExpressionUUID->"702359fb-ae89-45e9-994c-b43e237272c1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"det", " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SubsuperscriptBox["k", "LL", "B"], "^", "2"}], " ", "+", " ", 
        RowBox[{
         RowBox[{
          SubsuperscriptBox["Z", "LL", "t"], "/", 
          SubsuperscriptBox["Z", "LL", "s"]}], " ", 
         RowBox[{
          SubsuperscriptBox["M", "LL", "W"], "^", "2"}]}]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SubsuperscriptBox["\[Omega]", "LL", "B"], "^", "2"}], " ", "-", " ", 
        
        RowBox[{
         SubsuperscriptBox["M", "LL", "W"], "^", "2"}]}], ")"}]}], " ", "-", 
     "\n", "   ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox["k", "LL", "B"], " ", 
        SubsuperscriptBox["\[Omega]", "LL", "B"]}], ")"}], "^", "2"}]}]}], 
   ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Solve", " ", "needs", " ", "a", " ", "symbol", " ", "as", " ", 
    RowBox[{"unknown", ":", " ", 
     RowBox[{
     "the", " ", "square", " ", "of", " ", "the", " ", "frequency", " ", "is",
       " ", "called", " ", "w"}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{"root", " ", "=", " ", 
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"det", " ", "/.", " ", 
       RowBox[{
        SubsuperscriptBox["\[Omega]", "LL", "B"], " ", "->", " ", 
        RowBox[{"Sqrt", "[", "w", "]"}]}]}], ")"}], " ", "==", " ", "0"}], ",",
     " ", "w"}], "]"}]}]}], "Input",
 CellLabel->
  "In[198]:=",ExpressionUUID->"457e2881-c264-4390-901b-517a3e8ef940"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"w", "\[Rule]", 
    FractionBox[
     RowBox[{
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox["k", "LL", "B"], ")"}], "2"], " ", 
       SubsuperscriptBox["Z", "LL", "s"]}], "+", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox["M", "LL", "W"], ")"}], "2"], " ", 
       SubsuperscriptBox["Z", "LL", "t"]}]}], 
     SubsuperscriptBox["Z", "LL", "t"]]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{4.0040147961633*^9},
 CellLabel->
  "Out[199]=",ExpressionUUID->"9d8baac9-100f-4728-9b12-5d9c016a6322"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-10\>\"", ",", 
    " ", "\"\<the determinant of the time and longitudinal equations vanishes \
exactly at omega_B^2 = M_W^2 + (Z_s/Z_t) k_B^2\>\"", ",", "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", "root", "]"}], " ", "==", " ", "1"}], " ", "&&", 
     " ", 
