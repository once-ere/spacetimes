                    FontSlant->"Plain"]], "\[CirclePlus]", 
                  SubscriptBox[
                   StyleBox["\[GothicP]",
                    FontSlant->"Plain"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]], "\[CirclePlus]", 
                  SubscriptBox[
                   StyleBox["\[GothicS]",
                    FontSlant->"Plain"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "c8d86665-1ee1-40a4-8f46-fa2dd71bdb10"],
               " (18), ",
               Cell[BoxData[
                FormBox[
                 SubsuperscriptBox[
                  StyleBox["\[ScriptCapitalF]",
                   FontSlant->"Plain"], 
                  StyleBox["LL",
                   FontSlant->"Plain"], 
                  StyleBox["C",
                   FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "38034f17-e809-4214-bd0d-b02c51e47c27"],
               " on ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubscriptBox[
                   StyleBox["\[GothicL]",
