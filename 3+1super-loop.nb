Cell[TextData[{
 "S-5, TeX: with its ",
 StyleBox["TraditionalForm",
  FontFamily->"Source Code Pro"],
 " rule, every symbol is written in TeX from its displayed boxes; the \
internal name, with its separator character, does not appear."
}], "Text",ExpressionUUID->"29cb7b07-2570-4077-a6a5-337d0d75f9a1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"texOut", " ", "=", " ", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{"r", ",", " ", 
       RowBox[{"Replace", "[", 
        RowBox[{
         RowBox[{"r", "[", "\"\<symbol\>\"", "]"}], ",", " ", 
         RowBox[{
          RowBox[{"HoldComplete", "[", "s_", "]"}], " ", ":>", " ", 
          RowBox[{"ToString", "[", 
           RowBox[{"TeXForm", "[", 
            RowBox[{"Unevaluated", "[", "s", "]"}], "]"}], "]"}]}]}], "]"}]}],
       "]"}], ",", " ", "symbolTable"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-5\>\"", ",", 
    " ", "\"\<the TeX of every symbol is written from its printed form, \
without the internal name\>\"", ",", "\n", "  ", 
    RowBox[{"AllTrue", "[", 
     RowBox[{"texOut", ",", " ", 
      RowBox[{
       RowBox[{"!", " ", 
        RowBox[{"StringContainsQ", "[", 
         RowBox[{"#", ",", " ", 
          
          RowBox[{"\"\<UnderBracket\>\"", " ", "|", 
           " ", "\"\<\[UnderBracket]\>\""}]}], "]"}]}], " ", "&"}]}], "]"}], ",",
     " ", 
    RowBox[{"Count", "[", 
     RowBox[{"texOut", ",", " ", 
      RowBox[{"x_", " ", "/;", " ", 
       RowBox[{"!", " ", 
        RowBox[{"StringContainsQ", "[", 
         RowBox[{"x", ",", " ", "\"\<UnderBracket\>\""}], "]"}]}]}]}], 
     "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{"TableForm", "[", 
  RowBox[{
   RowBox[{"Take", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", "\"\<tex\>\"", "]"}], " ", "&"}], ",", " ", 
          "symbolTable"}], "]"}], ",", " ", "texOut"}], "}"}], "]"}], ",", 
     " ", "8"}], "]"}], ",", " ", 
   RowBox[{"TableHeadings", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"None", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<registry TeX\>\"", ",", 
        " ", "\"\<TeXForm of the symbol\>\""}], "}"}]}], "}"}]}]}], 
  "]"}]}], "Input",
 CellLabel->
  "In[188]:=",ExpressionUUID->"cbf86a69-a01c-47af-9e91-562c1abe63de"],

