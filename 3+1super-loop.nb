Cell[CellGroupData[{

Cell["II.1.4 The lattice operator (t2core/src/lattice.rs)", "Subsection",ExpressionUUID->"ce94eb4c-03ed-457c-97cc-a680803ee332"],

Cell[TextData[{
 "The solvers discretize space on a lattice of ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubsuperscriptBox[
      StyleBox["n", "TI"], "LL", "x"], "\[Cross]", 
     SubsuperscriptBox[
      StyleBox["n", "TI"], "LL", "y"], "\[Cross]", 
     SubsuperscriptBox[
      StyleBox["n", "TI"], "LL", "z"]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"a216ffcd-f1e9-47e6-85b1-a559b1e91083"]], "InlineFormula",
  ExpressionUUID->"e37409d6-bc7b-4c9b-80d6-a1f4354d9682"],
 " sites with the spacing ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[ScriptL]", "LL", "x"], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"b29c2fba-432c-4aef-aad4-3cb278f33cbf"]], 
  "InlineFormula",ExpressionUUID->"7c4d8dff-2ff6-4287-85a7-8181d00bd187"],
 " (called ell in the code). A site ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["s", "TI"], "\[RightVector]"], "LL"], "\[LongEqual]", 
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["s", "TI"], "LL", "1"], ",", 
       SubsuperscriptBox[
        StyleBox["s", "TI"], "LL", "2"], ",", 
       SubsuperscriptBox[
        StyleBox["s", "TI"], "LL", "3"]}], ")"}]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"bccad04d-77d8-43e3-9fd3-021427048b2f"]], 
  "InlineFormula",ExpressionUUID->"e6067b79-5a9b-4c66-b155-2b6b72eb0ab7"],
 " has integer coordinates counted from 0, and the code gives it the number \
",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubsuperscriptBox[
      StyleBox["s", "TI"], "LL", "1"], "+", 
     SubsuperscriptBox[
      StyleBox["n", "TI"], "LL", "x"], 
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["s", "TI"], "LL", "2"], "+", 
       SubsuperscriptBox[
        StyleBox["n", "TI"], "LL", "y"], 
       SubsuperscriptBox[
        StyleBox["s", "TI"], "LL", "3"]}], ")"}]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"f6fc8266-2160-496c-bd22-2cc0df4816f9"]], 
  "InlineFormula",ExpressionUUID->"fb8f814c-ad5f-48cb-bd9c-c56ee53652d1"],
 "; ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     OverscriptBox["\[Delta]", "\[RightVector]"], "LL", 
     StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "cb78493f-1382-4306-91f2-970a0f065f69"]], "InlineFormula",ExpressionUUID->
  "7ea427bc-7163-48f1-8dae-9593bd8a867d"],
 " is the step to the next site in the direction ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    StyleBox["j", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "d9666f21-9e3a-408e-a4c8-c0237d57b1d5"]], "InlineFormula",ExpressionUUID->
  "a61c728e-5f47-45c4-93c0-ebaa9175d935"],
 ". On every site a mode has 16 complex components: the particle part ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[Psi]", "LL", "p"], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"0865afb3-7ea7-43da-b4d9-c66199ff8a71"]], 
  "InlineFormula",ExpressionUUID->"618c7f67-3b93-40fb-8d53-589cfa23adaf"],
 " (8 components) and the hole part ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[Psi]", "LL", "h"], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"0287b305-a440-42c5-b673-4b04e80ed8d6"]], 
  "InlineFormula",ExpressionUUID->"b9fecf6f-3b0a-4aa8-a91b-97ed67dc28b3"],
 " (8). The gauge fields live on the links: the link from ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubscriptBox[
     OverscriptBox[
      StyleBox["s", "TI"], "\[RightVector]"], "LL"], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"22abd373-19df-4c47-b039-ce38df62bdba"]], 
  "InlineFormula",ExpressionUUID->"ccfea179-ff67-4293-bc5d-435cca13be48"],
 " to ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["s", "TI"], "\[RightVector]"], "LL"], "+", 
     SubsuperscriptBox[
      OverscriptBox["\[Delta]", "\[RightVector]"], "LL", 
      StyleBox["j", "TI"]]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"f8d4a033-3415-452e-97e9-2ff609877ace"]], "InlineFormula",
  ExpressionUUID->"ae732e05-1e48-4a51-9fc9-bac88357dced"],
 " carries the ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{"2", "\[Cross]", "2"}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"e2d4decd-9297-4ca3-b7f1-4892a38e8d1a"]], "InlineFormula",
  ExpressionUUID->"a7b479af-9bc5-4b28-b867-5e4d5fcd464d"],
 " isospin matrix ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubsuperscriptBox[
      StyleBox["U",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      RowBox[{"LL", ",", 
       StyleBox["j", "TI"]}], "link"], 
     RowBox[{"(", 
      SubscriptBox[
       OverscriptBox[
        StyleBox["s", "TI"], "\[RightVector]"], "LL"], ")"}], "\[LongEqual]", 
     "exp", 
     RowBox[{"(", 
      RowBox[{"-", 
       StyleBox["i", "TI"], 
       SubsuperscriptBox["\[ScriptL]", "LL", "x"], 
       RowBox[{"(", 
        RowBox[{
         SubsuperscriptBox[
          StyleBox["g", "TI"], "LL", "v"], 
         SubscriptBox[
          StyleBox["a",
           FontFamily->"Helvetica",
           FontSlant->"Plain"], 
          RowBox[{"LL", ",", 
           StyleBox["j", "TI"]}]], "+", 
         SubsuperscriptBox[
          StyleBox["g", "TI"], "LL", "F"], 
         SubsuperscriptBox[
          StyleBox["A", "TI"], 
          RowBox[{"LL", ",", 
           StyleBox["j", "TI"]}], "F"], 
         SubsuperscriptBox["\[Sigma]", "0", "LL"]}], ")"}]}], ")"}]}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "a6e738be-4c80-45e5-a83e-709d6246d598"]], "InlineFormula",ExpressionUUID->
  "402df09b-bc9e-4bf0-abd1-99f09fb47425"],
 " with the isospin potential ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["a",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      RowBox[{"LL", ",", 
       StyleBox["j", "TI"]}]], "\[LongEqual]", 
     UnderscriptBox["\[Sum]", "\[Iota]",
      LimitsPositioning->True], 
     SubsuperscriptBox[
      StyleBox["A", "TI"], 
      RowBox[{"LL", ",", 
       StyleBox["j", "TI"]}], "\[Iota]"], 
     SubsuperscriptBox["\[Tau]", "\[Iota]", "LL"], "/", "2"}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "289c3d95-56a8-44bb-a1e7-cf08a0e73231"]], "InlineFormula",ExpressionUUID->
  "96685e5e-489d-4782-90d8-4d62a87eb64a"],
 ". Because ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        UnderscriptBox["\[Sum]", "\[Iota]",
         LimitsPositioning->True], 
        SubsuperscriptBox[
         StyleBox["A", "TI"], 
         RowBox[{"LL", ",", 
          StyleBox["j", "TI"]}], "\[Iota]"], 
        SubsuperscriptBox["\[Tau]", "\[Iota]", "LL"]}], ")"}], "2"], "\[LongEqual]",
      "|", 
     SubsuperscriptBox[
      OverscriptBox[
       StyleBox["A", "TI"], "\[RightVector]"], 
      RowBox[{"LL", ",", 
       StyleBox["j", "TI"]}], "v"], 
     SuperscriptBox["|", "2"], 
     SubsuperscriptBox["\[Sigma]", "0", "LL"]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"d2196007-4140-4523-ba62-c7e69fa79e42"]], 
  "InlineFormula",ExpressionUUID->"07d7019b-6dfb-4606-b153-42956012d97f"],
 ", with the length ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    TemplateBox[{
      RowBox[{
        SubsuperscriptBox[
         OverscriptBox[
          StyleBox["A", "TI"], "\[RightVector]"], 
         RowBox[{"LL", ",", 
           StyleBox["j", "TI"]}], "v"]}]},
     "Abs"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "18a3d88e-fb98-4a85-b8c4-c362a14d2043"]], "InlineFormula",ExpressionUUID->
  "1b2078ae-1698-4c15-8d75-1e501803dbd3"],
 " of the isospin vector ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubsuperscriptBox[
      OverscriptBox[
       StyleBox["A", "TI"], "\[RightVector]"], 
      RowBox[{"LL", ",", 
       StyleBox["j", "TI"]}], "v"], "\[LongEqual]", 
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["A", "TI"], 
        RowBox[{"LL", ",", 
         StyleBox["j", "TI"]}], "1"], ",", 
       SubsuperscriptBox[
        StyleBox["A", "TI"], 
        RowBox[{"LL", ",", 
         StyleBox["j", "TI"]}], "2"], ",", 
       SubsuperscriptBox[
        StyleBox["A", "TI"], 
        RowBox[{"LL", ",", 
         StyleBox["j", "TI"]}], "3"]}], ")"}]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"502c4c4e-9d35-4690-a05b-6e8e8cbc6481"]], 
  "InlineFormula",ExpressionUUID->"080985fc-38ac-4b3f-943b-a5147198cfb9"],
 ", the exponential has the closed form ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{"-", 
       StyleBox["i", "TI"], 
       SubsuperscriptBox["\[ScriptL]", "LL", "x"], 
       SubsuperscriptBox[
        StyleBox["g", "TI"], "LL", "F"], 
       SubsuperscriptBox[
        StyleBox["A", "TI"], 
        RowBox[{"LL", ",", 
         StyleBox["j", "TI"]}], "F"]}]], "(", 
     RowBox[{"cos", 
      RowBox[{"(", 
       FractionBox["1", 
        RowBox[{"2", 
         SubsuperscriptBox["\[ScriptL]", "LL", "x"], 
         SubsuperscriptBox[
          StyleBox["g", "TI"], "LL", "v"], "|", 
         SubsuperscriptBox[
          OverscriptBox[
           StyleBox["A", "TI"], "\[RightVector]"], 
          RowBox[{"LL", ",", 
           StyleBox["j", "TI"]}], "v"], "|"}]], ")"}], 
      SubsuperscriptBox["\[Sigma]", "0", "LL"], "-", 
      StyleBox["i", "TI"], "sin", 
      RowBox[{"(", 
       FractionBox["1", 
        RowBox[{"2", 
         SubsuperscriptBox["\[ScriptL]", "LL", "x"], 
         SubsuperscriptBox[
          StyleBox["g", "TI"], "LL", "v"], "|", 
         SubsuperscriptBox[
          OverscriptBox[
           StyleBox["A", "TI"], "\[RightVector]"], 
          RowBox[{"LL", ",", 
           StyleBox["j", "TI"]}], "v"], "|"}]], ")"}], 
      UnderscriptBox["\[Sum]", "\[Iota]",
       LimitsPositioning->True], 
      SubsuperscriptBox[
       StyleBox["A", "TI"], 
       RowBox[{"LL", ",", 
        StyleBox["j", "TI"]}], "\[Iota]"], 
      SubsuperscriptBox["\[Tau]", "\[Iota]", "LL"], "/", "|", 
      SubsuperscriptBox[
       OverscriptBox[
        StyleBox["A", "TI"], "\[RightVector]"], 
       RowBox[{"LL", ",", 
        StyleBox["j", "TI"]}], "v"], "|"}], ")"}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"383035fa-2f15-4835-b2f5-4ee85c73bf8c"]], 
  "InlineFormula",ExpressionUUID->"679c0660-a622-4846-907b-6cde68d05956"],
 ", which ",
 StyleBox["t2link",
  FontFamily->"Source Code Pro"],
 " evaluates. The particle row of the lattice Dirac-Bogoliubov-de Gennes \
operator ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalH]",
      FontSlant->"Plain"], "LL", "lat"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"c638d555-9bff-4189-b357-a8c09f8bc6ac"]], "InlineFormula",
  ExpressionUUID->"447c5647-4ec7-479d-a77a-3ed936a98169"],
 ", applied to a mode ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["\[Psi]", "LL", "p"], ",", 
      SubsuperscriptBox["\[Psi]", "LL", "h"]}], ")"}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"2c12c4f7-6032-4e98-b6bc-d2ba4f501440"]], 
  "InlineFormula",ExpressionUUID->"e9d71a8f-3d97-4378-b527-1c6ccaf062eb"],
 ", is"
}], "Text",ExpressionUUID->"7feb8e39-af48-4560-87a1-5f10611ec4d2"],

Cell[TextData[{
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     UnderscriptBox["\[Sum]", 
      StyleBox["j", "TI"],
      LimitsPositioning->True], 
     RowBox[{"[", 
      RowBox[{"-", 
       FractionBox[
        RowBox[{
         StyleBox["i", "TI"], 
         SubsuperscriptBox["\[Alpha]", "LL", 
          StyleBox["j", "TI"]]}], 
        RowBox[{"2", 
         SubsuperscriptBox["\[ScriptL]", "LL", "x"]}]], 
       RowBox[{"(", 
        RowBox[{
         SubsuperscriptBox[
          StyleBox["U",
           FontFamily->"Helvetica",
           FontSlant->"Plain"], 
          RowBox[{"LL", ",", 
           StyleBox["j", "TI"]}], "link"], 
         RowBox[{"(", 
          SubscriptBox[
           OverscriptBox[
            StyleBox["s", "TI"], "\[RightVector]"], "LL"], ")"}], 
         SubsuperscriptBox["\[Psi]", "LL", "p"], 
         RowBox[{"(", 
          RowBox[{
           SubscriptBox[
            OverscriptBox[
             StyleBox["s", "TI"], "\[RightVector]"], "LL"], "+", 
           SubsuperscriptBox[
            OverscriptBox["\[Delta]", "\[RightVector]"], "LL", 
            StyleBox["j", "TI"]]}], ")"}], "-", 
         SubsuperscriptBox[
          StyleBox["U",
           FontFamily->"Helvetica",
           FontSlant->"Plain"], 
          RowBox[{"LL", ",", 
           StyleBox["j", "TI"]}], "link"], 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            SubscriptBox[
             OverscriptBox[
              StyleBox["s", "TI"], "\[RightVector]"], "LL"], "-", 
            SubsuperscriptBox[
             OverscriptBox["\[Delta]", "\[RightVector]"], "LL", 
             StyleBox["j", "TI"]]}], ")"}], "\[Dagger]"], 
         SubsuperscriptBox["\[Psi]", "LL", "p"], 
         RowBox[{"(", 
          RowBox[{
           SubscriptBox[
            OverscriptBox[
             StyleBox["s", "TI"], "\[RightVector]"], "LL"], "-", 
           SubsuperscriptBox[
            OverscriptBox["\[Delta]", "\[RightVector]"], "LL", 
            StyleBox["j", "TI"]]}], ")"}]}], ")"}], "-", 
       FractionBox[
        SubsuperscriptBox[
         StyleBox["r", "TI"], "LL", "W"], 
        RowBox[{"2", 
         SubsuperscriptBox["\[ScriptL]", "LL", "x"]}]], 
       SubscriptBox["\[Beta]", "LL"], 
       RowBox[{"(", 
        RowBox[{
         SubsuperscriptBox[
          StyleBox["U",
           FontFamily->"Helvetica",
           FontSlant->"Plain"], 
          RowBox[{"LL", ",", 
           StyleBox["j", "TI"]}], "link"], 
         RowBox[{"(", 
          SubscriptBox[
           OverscriptBox[
            StyleBox["s", "TI"], "\[RightVector]"], "LL"], ")"}], 
         SubsuperscriptBox["\[Psi]", "LL", "p"], 
         RowBox[{"(", 
          RowBox[{
           SubscriptBox[
            OverscriptBox[
             StyleBox["s", "TI"], "\[RightVector]"], "LL"], "+", 
           SubsuperscriptBox[
            OverscriptBox["\[Delta]", "\[RightVector]"], "LL", 
            StyleBox["j", "TI"]]}], ")"}], "+", 
         SubsuperscriptBox[
          StyleBox["U",
           FontFamily->"Helvetica",
           FontSlant->"Plain"], 
          RowBox[{"LL", ",", 
           StyleBox["j", "TI"]}], "link"], 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            SubscriptBox[
             OverscriptBox[
              StyleBox["s", "TI"], "\[RightVector]"], "LL"], "-", 
            SubsuperscriptBox[
             OverscriptBox["\[Delta]", "\[RightVector]"], "LL", 
             StyleBox["j", "TI"]]}], ")"}], "\[Dagger]"], 
         SubsuperscriptBox["\[Psi]", "LL", "p"], 
         RowBox[{"(", 
          RowBox[{
           SubscriptBox[
            OverscriptBox[
             StyleBox["s", "TI"], "\[RightVector]"], "LL"], "-", 
           SubsuperscriptBox[
            OverscriptBox["\[Delta]", "\[RightVector]"], "LL", 
            StyleBox["j", "TI"]]}], ")"}], "-", "2", 
         SubsuperscriptBox["\[Psi]", "LL", "p"], 
         RowBox[{"(", 
          SubscriptBox[
           OverscriptBox[
            StyleBox["s", "TI"], "\[RightVector]"], "LL"], ")"}]}], ")"}]}], 
      "]"}], "+", 
     SubscriptBox[
      StyleBox["m", "TI"], "LL"], 
     SubscriptBox["\[Beta]", "LL"], 
     SubsuperscriptBox["\[Psi]", "LL", "p"], 
     RowBox[{"(", 
      SubscriptBox[
       OverscriptBox[
        StyleBox["s", "TI"], "\[RightVector]"], "LL"], ")"}], "-", 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["A",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        RowBox[{"LL", ",", "0"}]], 
       RowBox[{"(", 
        SubscriptBox[
         OverscriptBox[
          StyleBox["s", "TI"], "\[RightVector]"], "LL"], ")"}], "+", 
       SubscriptBox["\[Mu]", "LL"]}], ")"}], 
     SubsuperscriptBox["\[Psi]", "LL", "p"], 
     RowBox[{"(", 
      SubscriptBox[
       OverscriptBox[
        StyleBox["s", "TI"], "\[RightVector]"], "LL"], ")"}], "+", 
     SubscriptBox[
      StyleBox["P",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "LL"], 
     RowBox[{"(", 
      SubscriptBox[
       OverscriptBox[
        StyleBox["s", "TI"], "\[RightVector]"], "LL"], ")"}], 
     SubsuperscriptBox["\[Psi]", "LL", "h"], 
     RowBox[{"(", 
      SubscriptBox[
       OverscriptBox[
        StyleBox["s", "TI"], "\[RightVector]"], "LL"], ")"}]}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "a75d0f15-57f0-46f2-8e07-d279294dce5d"]], "InlineFormula",ExpressionUUID->
  "e7e72d3c-f1ad-4fe3-a3bf-07f3fae20ba9"],
 ","
}], "Text",ExpressionUUID->"acd305c7-1caa-4a08-ac54-c50c7410ecc7"],

Cell[TextData[{
 "where ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[Alpha]", "LL", 
     StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "272b37db-9df3-46b2-8562-16691f6d124c"]], "InlineFormula",ExpressionUUID->
  "b8e02b45-983f-44da-be03-5686b5b8bb6f"],
 " and ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubscriptBox["\[Beta]", "LL"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"89b57663-f0a2-4e37-8536-ec436c755cf7"]], "InlineFormula",
  ExpressionUUID->"0f9daac9-38db-47ef-8318-ffaa8ee2b595"],
 " act on the Dirac index and the link matrices on the isospin index (code: \
",
 StyleBox["t2hMinusV",
  FontFamily->"Source Code Pro"],
 " without the pair term, and ",
 StyleBox["t2apply",
  FontFamily->"Source Code Pro"],
 "). The hole row is ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["P",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "LL"], 
     SuperscriptBox[
      RowBox[{"(", 
       SubscriptBox[
        OverscriptBox[
         StyleBox["s", "TI"], "\[RightVector]"], "LL"], ")"}], "\[Dagger]"], 
     SubsuperscriptBox["\[Psi]", "LL", "p"], 
     RowBox[{"(", 
      SubscriptBox[
       OverscriptBox[
        StyleBox["s", "TI"], "\[RightVector]"], "LL"], ")"}]}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "2ca4b6b4-a494-4660-ae83-2eece839cee3"]], "InlineFormula",ExpressionUUID->
  "6d002acb-a18f-4868-a0fa-0bf856b4af86"],
 " minus the complex conjugate of the same expression without the pair term, \
applied to the complex conjugate of ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[Psi]", "LL", "h"], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"ce508cea-eb8d-4ac0-8361-16b667c3d90d"]], 
  "InlineFormula",ExpressionUUID->"9e9fd81d-e3c4-4ab3-ba3f-57ba498d1987"],
 ". Here ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["r", "TI"], "LL", "W"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"dd55cf24-f9e7-4060-96db-f3f9f65110f0"]], "InlineFormula",
  ExpressionUUID->"416f84de-f8ea-48e7-937f-fe27f0f9410b"],
 " is the Wilson coefficient (the term in ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["r", "TI"], "LL", "W"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"cf3c5576-5325-41f7-8c2a-525b3e72730a"]], "InlineFormula",
  ExpressionUUID->"e21237d6-18e6-4bc4-9aa2-c0cff55617b7"],
 " removes the doubled fermions of the lattice), ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["A",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      RowBox[{"LL", ",", "0"}]], 
     RowBox[{"(", 
      SubscriptBox[
       OverscriptBox[
        StyleBox["s", "TI"], "\[RightVector]"], "LL"], ")"}], "\[LongEqual]", 
     
     SubsuperscriptBox[
      StyleBox["g", "TI"], "LL", "v"], 
     UnderscriptBox["\[Sum]", "\[Iota]",
      LimitsPositioning->True], 
     SubsuperscriptBox[
      StyleBox["A", "TI"], 
      RowBox[{"LL", ",", "0"}], "\[Iota]"], 
     SubsuperscriptBox[
      StyleBox["T", "TI"], "LL", "\[Iota]"], "+", 
     SubsuperscriptBox[
      StyleBox["g", "TI"], "LL", "F"], 
     SubsuperscriptBox[
      StyleBox["A", "TI"], 
      RowBox[{"LL", ",", "0"}], "F"], 
     SubscriptBox[
      StyleBox["1",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "8"]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"5006b17f-ded4-488e-aca1-cc9e262b3a10"]], "InlineFormula",
  ExpressionUUID->"6fdb10e5-6315-4830-900d-f1eb811e3b9a"],
 " is the potential of the time direction at the site and ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["P",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "LL"], 
     RowBox[{"(", 
      SubscriptBox[
       OverscriptBox[
        StyleBox["s", "TI"], "\[RightVector]"], "LL"], ")"}], "\[LongEqual]", 
     
     UnderscriptBox["\[Sum]", "\[Iota]",
      LimitsPositioning->True], 
     SubsuperscriptBox[
      StyleBox["d", "TI"], "LL", "\[Iota]"], 
     RowBox[{"(", 
      SubscriptBox[
       OverscriptBox[
        StyleBox["s", "TI"], "\[RightVector]"], "LL"], ")"}], 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["K",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], "LL", "\[Iota]"], ")"}], "\[Dagger]"]}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "e2bf0948-d857-4ac3-bbc3-c4a62ed907b6"]], "InlineFormula",ExpressionUUID->
  "29cb210b-b1d1-4dd0-a113-2f794d21dcd8"],
 " the pairing block; a direction without a neighbour (a Dirichlet boundary) \
contributes zero. The function ",
 StyleBox["t2apply",
  FontFamily->"Source Code Pro"],
 " applies the operator to a vector, or, column by column, to a matrix whose \
columns are vectors; ",
 StyleBox["t2dense",
  FontFamily->"Source Code Pro"],
 " applies it to the unit matrix and so returns the whole matrix."
}], "Text",ExpressionUUID->"695b3b1a-7af0-4076-bd91-f7155494f516"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "the", " ", "closed", " ", "form", " ", "of", " ", "the", " ", "link", " ",
     "matrix", " ", "exp", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "i"}], " ", "ell", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"gv", " ", 
         RowBox[{
          RowBox[{"a", ".", "tau"}], "/", "2"}]}], " ", "+", " ", 
        RowBox[{"gf", " ", "b"}]}], ")"}]}], ")"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"t2link", "[", 
      RowBox[{
      "gv_", ",", " ", "gf_", ",", " ", "a_List", ",", " ", "b_", ",", " ", 
       "ell_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"na", " ", "=", " ", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"a", " ", ".", " ", "a"}], "]"}]}], ",", " ", "x", ",", 
         " ", "ph", ",", " ", "cx", ",", " ", "sx", ",", " ", "n1", ",", " ", 
         "n2", ",", " ", "n3"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"x", " ", "=", " ", 
         RowBox[{"0.5", " ", "ell", " ", "gv", " ", "na"}]}], ";", "\n", 
        "   ", 
        RowBox[{"ph", " ", "=", " ", 
         RowBox[{
          RowBox[{"Cos", "[", 
           RowBox[{
            RowBox[{"-", "ell"}], " ", "gf", " ", "b"}], "]"}], " ", "+", " ", 
          RowBox[{"I", " ", 
           RowBox[{"Sin", "[", 
            RowBox[{
             RowBox[{"-", "ell"}], " ", "gf", " ", "b"}], "]"}]}]}]}], ";", 
        "\n", "   ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"cx", ",", " ", "sx"}], "}"}], " ", "=", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Cos", "[", "x", "]"}], ",", " ", 
           RowBox[{"Sin", "[", "x", "]"}]}], "}"}]}], ";", "\n", "   ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"n1", ",", " ", "n2", ",", " ", "n3"}], "}"}], " ", "=", 
         " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"na", " ", ">", " ", "0"}], ",", " ", 
           RowBox[{"a", "/", "na"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"0.", ",", " ", "0.", ",", " ", "0."}], "}"}]}], "]"}]}], 
        ";", "\n", "   ", 
        RowBox[{"ph", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"cx", " ", "-", " ", 
              RowBox[{"I", " ", "sx", " ", "n3"}]}], ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "sx"}], " ", "n2"}], " ", "-", " ", 
              RowBox[{"I", " ", "sx", " ", "n1"}]}]}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"sx", " ", "n2"}], " ", "-", " ", 
              RowBox[{"I", " ", "sx", " ", "n1"}]}], ",", " ", 
             RowBox[{"cx", " ", "+", " ", 
              RowBox[{"I", " ", "sx", " ", "n3"}]}]}], "}"}]}], "}"}]}]}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "2", " ", "x", " ", "2", " ", "potential", " ", "matrix", " ",
       "gv", " ", 
      RowBox[{
       RowBox[{"A0", ".", "tau"}], "/", "2"}]}], " ", "+", " ", 
     RowBox[{"gf", " ", "A0F"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2potential", "[", 
