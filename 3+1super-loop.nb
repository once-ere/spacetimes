       "steps"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"time13", ",", " ", "runs13"}], "}"}], " ", "=", " ", 
     RowBox[{"AbsoluteTiming", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"t2evolveIDA", "[", 
