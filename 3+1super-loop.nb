            RowBox[{
            "the", " ", "product", " ", "rule", " ", "for", " ", "all", " ", 
             "nine", " ", "pairs", " ", 
             RowBox[{"(", 
              RowBox[{"j", ",", " ", 
               RowBox[{"j", "'"}]}], ")"}]}], ",", " ", 
            RowBox[{
            "with", " ", "the", " ", "27", " ", "symbolized", " ", 
             "components", " ", "of", " ", "epsilon"}]}], " ", "*)"}], "\n", 
          "     ", 
          RowBox[{"rule", " ", "=", " ", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"sigma", "[", 
                RowBox[{"[", "j", "]"}], "]"}], " ", ".", " ", 
               RowBox[{"sigma", "[", 
                RowBox[{"[", "jp", "]"}], "]"}]}], " ", "-", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"KroneckerDelta", "[", 
                  RowBox[{"j", ",", " ", "jp"}], "]"}], " ", 
                 SubscriptBox[
                  TagBox[
                   StyleBox["1",
                    FontFamily->"Helvetica",
                    FontSlant->"Plain"],
                   "SL31SansSerif"], "2"]}], " ", "+", "\n", "           ", 
                RowBox[{"I", " ", 
                 RowBox[{"Sum", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"eps", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", ",", " ", "jp", ",", " ", "jpp"}], "]"}], 
                    "]"}], " ", "/.", " ", 
                    RowBox[{"Thread", "[", 
                    RowBox[{
                    RowBox[{"Flatten", "[", "eps", "]"}], " ", "->", " ", 
                    RowBox[{"Flatten", "[", 
                    RowBox[{"Normal", "[", 
                    RowBox[{"LeviCivitaTensor", "[", "3", "]"}], "]"}], 
                    "]"}]}], "]"}]}], ")"}], " ", 
                    RowBox[{"sigma", "[", 
                    RowBox[{"[", "jpp", "]"}], "]"}]}], ",", " ", 
                   RowBox[{"{", 
                    RowBox[{"jpp", ",", " ", "3"}], "}"}]}], "]"}]}]}], 
               ")"}]}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"j", ",", " ", "3"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"jp", ",", " ", "3"}], "}"}]}], "]"}]}], ";", "\n", 
          "     ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Max", "[", 
             RowBox[{"Abs", "[", "sum", "]"}], "]"}], ",", " ", 
            RowBox[{"Max", "[", 
             RowBox[{"Abs", "[", 
              RowBox[{"Flatten", "[", "rule", "]"}], "]"}], "]"}]}], 
           "}"}]}]}], "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"SL31Check", "[", 
     RowBox[{"\"\<S-7\>\"", ",", 
      " ", "\"\<sum over j of sigma^LL_j sigma^LL_j = 3 times the unit \
matrix, and sigma_j sigma_j' = delta_jj' + i sum_j'' epsilon_jj'j'' sigma_j'' \
for all nine pairs (components as symbolized symbols)\>\"", ",", "\n", "  ", 
      RowBox[{"check7", " ", "===", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0"}], "}"}]}], ",", " ", "check7"}], "]"}], 
    ";"}]}]}]], "Input",
 CellLabel->
  "In[116]:=",ExpressionUUID->"49de098b-87dd-45cb-bf4d-b61b9ecaa929"],

