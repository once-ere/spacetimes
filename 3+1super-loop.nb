                  RowBox[{"ep", " ", "-", " ", 
                   RowBox[{"as1Acal0", "[", "qq", "]"}], " ", "-", " ", 
                   "as1Mu"}], ",", " ", 
                  RowBox[{"ep", " ", "-", " ", 
                   RowBox[{"as1Acal0", "[", "qq", "]"}], " ", "-", " ", 
                   "as1Mu"}]}], "}"}], "]"}]}], ";", "\n", "     ", 
              RowBox[{"as1Dev", " ", "=", " ", 
