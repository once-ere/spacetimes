              RowBox[{
                SubsuperscriptBox[
                 StyleBox["F", FontSlant -> "Plain"], 
                 RowBox[{"LL", ",", 
                   StyleBox["p", "TI"], 
                   SuperscriptBox[
                    StyleBox["p", "TI"], "\[Prime]"]}], "F"], "\[LongEqual]", 
                
                SubscriptBox["\[PartialD]", 
