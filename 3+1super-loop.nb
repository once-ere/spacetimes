                    FontSlant->"Plain"], 
                   StyleBox["v",
                    FontSlant->"Plain"]], ")"}], "2"], ",", 
                SuperscriptBox[
                 RowBox[{"(", 
                  SubsuperscriptBox[
                   StyleBox["g", "TI"], 
                   StyleBox["LL",
                    FontSlant->"Plain"], 
