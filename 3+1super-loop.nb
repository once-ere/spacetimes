                   FontSlant->"Plain"], "+"], ")"}], "2"], ")"}], "-", 
              SubsuperscriptBox[
               StyleBox["W", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["g",
                FontSlant->"Plain"]], 
              RowBox[{"(", 
