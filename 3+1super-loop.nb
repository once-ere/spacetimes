             PaneBox[
              StyleBox["\<\"\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[Cell[TextData[{
               "a linear map from ",
               Cell[BoxData[
                FormBox[
                 SubscriptBox[
                  StyleBox["\[GothicM]",
                   FontSlant->"Plain"], 
                  StyleBox["LL",
                   FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "da8cdfa8-c283-43d9-b5f1-ebba72af27ce"],
               
               " to the linear operators (matrices) on a vector space that \
turns brackets into commutators, ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubscriptBox["\[CurlyRho]", 
                   StyleBox["LL",
                    FontSlant->"Plain"]], 
                  RowBox[{"(", 
                   RowBox[{"[", 
                    RowBox[{
                    StyleBox["x",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], ",", 
                    StyleBox["y",
                    FontWeight->"Bold",
                    FontSlant->"Plain"]}], "]"}], ")"}], "\[LongEqual]", 
                  SubscriptBox["\[CurlyRho]", 
                   StyleBox["LL",
                    FontSlant->"Plain"]], 
                  RowBox[{"(", 
                   StyleBox["x",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], ")"}], 
                  SubscriptBox["\[CurlyRho]", 
                   StyleBox["LL",
                    FontSlant->"Plain"]], 
                  RowBox[{"(", 
                   StyleBox["y",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], ")"}], "-", 
                  SubscriptBox["\[CurlyRho]", 
                   StyleBox["LL",
                    FontSlant->"Plain"]], 
                  RowBox[{"(", 
                   StyleBox["y",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], ")"}], 
                  SubscriptBox["\[CurlyRho]", 
                   StyleBox["LL",
                    FontSlant->"Plain"]], 
                  RowBox[{"(", 
                   StyleBox["x",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], ")"}]}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "feea9959-6645-4d1f-b7bb-5984be98675e"],
               "; ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubscriptBox[
                   StyleBox["O",
