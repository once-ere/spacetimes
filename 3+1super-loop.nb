           FontSize->8],
          ImageSize->95], 
         PaneBox[
          StyleBox[
           
           TemplateBox[{
            "\"the common factor of the kernels of the condensed vacuum, \"", 
             
             FormBox[
              RowBox[{
                SubscriptBox["\[CapitalUpsilon]", "LL"], "\[LongEqual]", "2", 
                
                SubscriptBox["\[Integral]", 
                 RowBox[{
                   SubscriptBox[
                    StyleBox["q", "TI"], "LL"], "<", 
                   SubscriptBox["\[CapitalLambda]", "LL"]}]], 
                SuperscriptBox[
                 StyleBox["d", "TI"], "3"], 
                SubscriptBox[
                 StyleBox["q", "TI"], "LL"], 
                SuperscriptBox[
                 RowBox[{"(", 
                   RowBox[{"2", "\[Pi]"}], ")"}], "-3"], 
                SuperscriptBox[
                 RowBox[{"(", 
                   RowBox[{
                    SubsuperscriptBox[
                    StyleBox["E", "TI"], "LL", "c"], "(", 
                    RowBox[{"4", 
                    SuperscriptBox[
                    RowBox[{"(", 
                    SubsuperscriptBox[
                    StyleBox["E", "TI"], "LL", "c"], ")"}], "2"], "-", 
                    SuperscriptBox[
                    RowBox[{"(", 
                    SubsuperscriptBox["\[Omega]", "LL", "B"], ")"}], "2"]}], 
                    ")"}], ")"}], "-1"]}], TraditionalForm], "\", with \"", 
             FormBox[
              RowBox[{
                SubscriptBox["\[CapitalUpsilon]", "LL"], 
                RowBox[{"(", "0", ")"}], "\[LongEqual]", 
                SubsuperscriptBox[
                 StyleBox["Z", "TI"], "LL", "t"], 
                RowBox[{"(", 
                  SubscriptBox["\[CapitalDelta]", "LL"], ")"}]}], 
              TraditionalForm], "\"; its derivative with respect to \"", 
             FormBox[
              SuperscriptBox[
               RowBox[{"(", 
                 SubsuperscriptBox["\[Omega]", "LL", "B"], ")"}], "2"], 
              TraditionalForm], "\" at zero; and the positive number \"", 
             FormBox[
              RowBox[{
                SubsuperscriptBox[
                 StyleBox["c", "TI"], "LL", "w"], "\[LongEqual]", 
                SuperscriptBox[
                 RowBox[{"(", 
                   SubsuperscriptBox[
                    StyleBox["M", "TI"], "LL", "q"], ")"}], "2"], "-", 
                SuperscriptBox[
                 RowBox[{"(", 
                   SubsuperscriptBox["\[Omega]", "LL", "B"], ")"}], "2"], "/",
                 "4"}], TraditionalForm], 
             "\", used in the proof that the kernels of the Goldstone and of \
the massive directions are \"", 
             FormBox[
              RowBox[{"-", 
                SuperscriptBox[
                 RowBox[{"(", 
                   SubsuperscriptBox["\[Omega]", "LL", "B"], ")"}], "2"], 
                SubscriptBox["\[CapitalUpsilon]", "LL"]}], TraditionalForm], 
             "\" and \"", 
             FormBox[
              RowBox[{
                RowBox[{"(", 
                  RowBox[{"4", 
                    SubsuperscriptBox["\[CapitalDelta]", "LL", "2"], "-", 
                    SuperscriptBox[
                    RowBox[{"(", 
                    SubsuperscriptBox["\[Omega]", "LL", "B"], ")"}], "2"]}], 
                  ")"}], 
                SubscriptBox["\[CapitalUpsilon]", "LL"]}], TraditionalForm]},
            "RowDefault"],
           StripOnInput->False,
           FontFamily->"Source Sans Pro",
           FontSize->9.5],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox[
             OverscriptBox["d", "\[RightVector]"], "LL", "u"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[
          StyleBox[
           
           TemplateBox[{
            "\"the SFBS field in the unitary gauge, the column of the SFBSv \
parametrization, \"", 
             FormBox[
              RowBox[{"(", 
                RowBox[{
                  StyleBox["i", "TI"], " ", 
                  SubsuperscriptBox[
                   StyleBox["c", "TI"], 
                   RowBox[{"LL", ",", "1"}], "n"], ", ", 
                  StyleBox["i", "TI"], " ", 
                  SubsuperscriptBox[
                   StyleBox["c", "TI"], 
                   RowBox[{"LL", ",", "2"}], "n"], ", ", 
                  SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], "+", 
                  SubsuperscriptBox[
                   StyleBox["h", "TI"], "LL", "a"]}], ")"}], TraditionalForm],
              "\": the field after the gauge transformation that removes the \
three Goldstone fields\""},
            "RowDefault"],
           StripOnInput->False,
           FontFamily->"Source Sans Pro",
           FontSize->9.5],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["V", 
             RowBox[{"LL", ",", "p"}], "F"], "\", \"", 
            SubsuperscriptBox["V", 
             RowBox[{"LL", ",", "p"}], "\[Iota]"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          StyleBox["\<\"V V^iota VF\"\>",
           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[
          StyleBox[
           
           TemplateBox[{
            "\"the gauge potentials in the unitary gauge, the vector fields \
of definite mass: \"", 
             FormBox[
              RowBox[{
                SubsuperscriptBox[
                 StyleBox["V", "TI"], 
                 RowBox[{"LL", ",", 
                   StyleBox["p", "TI"]}], "F"], "\[LongEqual]", 
                SubsuperscriptBox[
                 StyleBox["A", "TI"], 
                 RowBox[{"LL", ",", 
                   StyleBox["p", "TI"]}], "F"], "-", 
                SubscriptBox["\[PartialD]", 
                 StyleBox["p", "TI"]], 
                SubsuperscriptBox["\[CurlyTheta]", 
                 RowBox[{"LL", ",", "0"}], "G"], "/", 
                SubsuperscriptBox[
                 StyleBox["g", "TI"], "LL", "F"]}], TraditionalForm], 
             "\" and \"", 
             FormBox[
              RowBox[{
                UnderscriptBox[
                "\[Sum]", "\[Iota]", LimitsPositioning -> True], 
                SubsuperscriptBox[
                 StyleBox["V", "TI"], 
                 RowBox[{"LL", ",", 
                   StyleBox["p", "TI"]}], "\[Iota]"], 
                SubsuperscriptBox["\[Tau]", "\[Iota]", "LL"], "/", "2", 
                "\[LongEqual]", 
                SuperscriptBox[
                 RowBox[{"(", 
                   SubsuperscriptBox[
                    StyleBox["U", FontSlant -> "Plain"], "LL", "G"], ")"}], 
                 "\[Dagger]"], 
                SubscriptBox[
                 StyleBox["a", FontSlant -> "Plain"], 
                 RowBox[{"LL", ",", 
                   StyleBox["p", "TI"]}]], 
                SubsuperscriptBox[
                 StyleBox["U", FontSlant -> "Plain"], "LL", "G"], "-", 
                RowBox[{"(", 
                  RowBox[{
                    StyleBox["i", "TI"], "/", 
                    SubsuperscriptBox[
                    StyleBox["g", "TI"], "LL", "v"]}], ")"}], 
                RowBox[{"(", 
                  RowBox[{
                    SubscriptBox["\[PartialD]", 
                    StyleBox["p", "TI"]], 
                    SuperscriptBox[
                    RowBox[{"(", 
                    SubsuperscriptBox[
                    StyleBox["U", FontSlant -> "Plain"], "LL", "G"], ")"}], 
                    "\[Dagger]"]}], ")"}], 
                SubsuperscriptBox[
                 StyleBox["U", FontSlant -> "Plain"], "LL", "G"]}], 
              TraditionalForm], "\"; to first order \"", 
             FormBox[
              RowBox[{
                SubsuperscriptBox[
                 StyleBox["V", "TI"], 
                 RowBox[{"LL", ",", 
                   StyleBox["p", "TI"]}], "\[Iota]"], "\[LongEqual]", 
                SubsuperscriptBox[
                 StyleBox["A", "TI"], 
