           StripOnInput->False,
           FontFamily->"Source Sans Pro",
           FontSize->9.5],
          ImageSize->290]},
        {
         PaneBox[
          TemplateBox[{
            SubsuperscriptBox["\[Theta]", "LL", "mix"]},
           "RowDefault"],
          ImageSize->125], 
         PaneBox[
          
          StyleBox["\<\"theta_mix theta_mix_vacuum theta_mix_saddle \
theta_mix_pred\"\>",
           StripOnInput->False,
