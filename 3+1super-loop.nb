Cell[BoxData[{
 RowBox[{
  RowBox[{"xs", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ReleaseHold", "[", 
      RowBox[{"SL31Instance", "[", 
       RowBox[{
        RowBox[{"SL31SymbolBoxes", "[", "\"\<x^p_{\\\\rm LL}\>\"", "]"}], ",",
         " ", 
        RowBox[{"{", 
         RowBox[{"\"\<p\>\"", " ", "->", " ", 
