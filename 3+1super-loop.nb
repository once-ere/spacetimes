In[737]:=",ExpressionUUID->"5449bf2b-1e65-4c03-b12e-c262f6c3ebac"]
}, Open  ]],

Cell[TextData[{
 StyleBox["The square of the operator, and all bound states (check AS-8).",
  FontWeight->"Bold"],
 " With the plane wave ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["exp",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["i", "TI"], 
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox[
         StyleBox["q", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], "2"], 
        SubsuperscriptBox[
         StyleBox["x", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], "2"], "+", 
        SubsuperscriptBox[
         StyleBox["q", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], "3"], 
        SubsuperscriptBox[
         StyleBox["x", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], "3"]}], ")"}]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e3fc2bdf-da07-4601-aaa0-779b7eb2486a"],
 " along the wall, the particle block of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalH]",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["DB",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "712ad9eb-765b-455b-9e65-d920010ae312"],
 " is the operator ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     StyleBox["i", "TI"]}], 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], 
    SubscriptBox["\[PartialD]", "1"], "+", 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], "2"], 
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "2"], "+", 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], "3"], 
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "3"], "+", 
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8441fe95-ae75-48d1-b0c7-b629ea1f93eb"],
 ", and the hole block is minus the complex conjugate of the same operator \
with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "380258a6-3954-4fed-8e0e-954808cd312f"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "3"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "87c99089-72c2-40a6-a1bf-3904ea9bc216"],
 " in place of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["q", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0ef63006-a6d3-4d3b-9bf7-03b38bfa476b"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["q", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "82852f6d-ea1e-4e6e-8a45-f20ebfb60c7d"],
 ". By the relation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"], "\[LongEqual]", 
    RowBox[{"-", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["K",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["LL",
         FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"]}], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[Alpha]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["j", "TI"]], ")"}], "*"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "510c52a1-8b2c-49af-831f-779b70f5c812"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["j", "TI"], "\[LongEqual]", "1", ",", "2", ",", "3"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "435f97a0-b55c-4599-8183-8c3bff15bb60"],
 " (the key identity of case B in another form), the particle block times ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a2e96efe-35c7-493e-9911-bd8534fbf045"],
 " equals ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f1d81c98-a314-4c27-a64f-055ff389838d"],
 " times the hole block with the opposite sign. In the off-diagonal blocks of \
the square of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalH]",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["DB",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e34d7ef4-a8d0-40ed-b16f-4e9779e70ae6"],
 " everything therefore cancels except the derivative of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalDelta]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c45940c9-cd72-4601-b5c8-300825460f5c"],
 ", which arises when ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[PartialD]", "1"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cac2e4da-c17a-48a3-a71b-4cac5367c602"],
 " acts on the factor ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalDelta]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ec558577-a2ba-48be-a8a2-5135b886fa06"],
 "; the diagonal blocks are the squares of the particle block and of the hole \
block plus ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"], "2"], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"], 
    SubsuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "3"], "\[LongEqual]", 
    SubsuperscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"], "2"], 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "8"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0cc81769-884d-441e-a39d-8d89a7aa8562"],
 ". The result is"
}], "Text",ExpressionUUID->"3b67f8e7-e073-4726-9cbd-b036c76c9542"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["\[ScriptCapitalH]",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["DB",
       FontSlant->"Plain"]], ")"}], "2"], "\[LongEqual]", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       SuperscriptBox[
        StyleBox["d", "TI"], "2"], 
       RowBox[{
        StyleBox["d", "TI"], 
        SuperscriptBox[
         RowBox[{"(", 
          SubsuperscriptBox[
           StyleBox["x", "TI"], 
           StyleBox["LL",
            FontSlant->"Plain"], "1"], ")"}], "2"]}]]}], "+", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["q", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], "2"], ")"}], "2"], "+", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["q", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], "3"], ")"}], "2"], "+", 
     SubsuperscriptBox[
      StyleBox["m", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], "2"], "+", 
     SubsuperscriptBox["\[CapitalDelta]", 
      StyleBox["LL",
       FontSlant->"Plain"], "2"]}], ")"}], 
   SubscriptBox[
    StyleBox["1",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "16"], "+", 
   FractionBox[
    RowBox[{
     StyleBox["d", "TI"], 
     SubscriptBox["\[CapitalDelta]", 
      StyleBox["LL",
       FontSlant->"Plain"]]}], 
    RowBox[{
     StyleBox["d", "TI"], 
     SubsuperscriptBox[
      StyleBox["x", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], "1"]}]], "\[ThinSpace]", 
   SubsuperscriptBox[
    StyleBox["Q",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["K",
     FontSlant->"Plain"]]}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"723fbf8c-4fd5-4155-bcf3-114dfd5327bb"],

Cell["with the constant matrix", "Text",ExpressionUUID->"6dcd8ba3-cfdb-457f-bea0-a88bb97ed04b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["Q",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["K",
     FontSlant->"Plain"]], "\[LongEqual]", 
   RowBox[{"(", "\[NoBreak]", GridBox[{
      {"0", 
       RowBox[{
        RowBox[{"-", 
         StyleBox["i", "TI"]}], 
        SubsuperscriptBox["\[Alpha]", 
         StyleBox["LL",
          FontSlant->"Plain"], "1"], 
        SuperscriptBox[
         RowBox[{"(", 
          SubsuperscriptBox[
           StyleBox["K",
            FontFamily->"Helvetica",
            FontSlant->"Plain"], 
           StyleBox["LL",
            FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"]}]},
      {
       RowBox[{
        RowBox[{"-", 
         StyleBox["i", "TI"]}], 
        SubsuperscriptBox["\[Alpha]", 
         StyleBox["LL",
          FontSlant->"Plain"], "1"], 
        SubsuperscriptBox[
         StyleBox["K",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], 
         StyleBox["LL",
          FontSlant->"Plain"], "3"]}], "0"}
     },
     GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.7]}, 
         Offset[0.27999999999999997`]}, "Rows" -> {
         Offset[0.2], {
          Offset[0.4]}, 
         Offset[0.2]}}], "\[NoBreak]", ")"}]}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"e35e37d4-864a-4760-bbdd-784b8ff3b4c2"],

Cell[TextData[{
 "The constant matrix ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["Q",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["K",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b9da5220-e97c-46f2-8383-774b677a97f1"],
 " is Hermitian, its square is the unit matrix, and its trace is 0: it has \
the eigenvalue ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4bea4f00-2c9c-4cc3-8202-be7f0dea028c"],
 " on a subspace of eight dimensions and the eigenvalue ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d976ee3b-997c-48c7-9af6-0fac7d5eb884"],
 " on another. On these two subspaces the square of the operator is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "2"], "+", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "2"], ")"}], "2"], "+", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "09f8af04-85a0-42ea-a68c-4ef7bb31b12c"],
 " plus one of the two scalar operators ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     SuperscriptBox[
      StyleBox["d", "TI"], "2"]}], "/", 
    StyleBox["d", "TI"], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "1"], ")"}], "2"], "+", 
    SubsuperscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"], "2"], "-", 
    StyleBox["d", "TI"], 
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "/", 
    StyleBox["d", "TI"], 
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "1"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9f06c8a8-f914-4142-b041-92510245505b"],
 " (eigenvalue ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "61b2864e-fa21-44cb-872a-11d58de11b32"],
 ") and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     SuperscriptBox[
      StyleBox["d", "TI"], "2"]}], "/", 
    StyleBox["d", "TI"], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "1"], ")"}], "2"], "+", 
    SubsuperscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"], "2"], "+", 
    StyleBox["d", "TI"], 
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "/", 
    StyleBox["d", "TI"], 
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "1"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "60828cdd-d300-46ae-9900-a0309828ceba"],
 " (eigenvalue ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d8388da6-7395-4d4d-8bc8-b8fb70fdde1a"],
 "). The first is the product ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       StyleBox["d", "TI"]}], "/", 
      StyleBox["d", "TI"], 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "1"], "+", 
      SubscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["d", "TI"], "/", 
      StyleBox["d", "TI"], 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "1"], "+", 
      SubscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a3eb63af-1105-47ab-944e-1e24cc33b1b0"],
 ", and the second is the product of the same two first-order operators in \
the other order. Two such products have the same eigenvalues different from \
zero (if one of them maps a function to a multiple of itself, the first-order \
factor applied to that function gives an eigenfunction of the other product \
with the same eigenvalue). They differ only in the eigenvalue zero: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], "/", 
    StyleBox["d", "TI"], 
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], "+", 
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c0dacb3e-f64b-4336-82de-e6640b0399f6"],
 " maps the normalizable profile ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CurlyPhi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["K",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "877e4ce5-9ca9-47cc-afea-ca9d6fdbcb93"],
 " to zero, while the functions that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     StyleBox["d", "TI"]}], "/", 
    StyleBox["d", "TI"], 
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], "+", 
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "64f14b8e-9b96-4900-9ccf-b5911de9445e"],
 " maps to zero are the multiples of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SubsuperscriptBox["\[CurlyPhi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ed44e510-81e4-42ca-842c-70fca4f911d2"],
 ", which grow on both sides of the wall. The sector with the eigenvalue ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8f2b030c-fd80-4606-bdf7-89660bd9e85a"],
 " therefore has exactly one bound state more than the sector with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b4e72dc9-5f3f-41e3-b00e-9c0345173d95"],
 ": the state of the display before this one, with the squared energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "2"], "+", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "2"], ")"}], "2"], "+", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e80a4845-7f15-47e2-adc4-730b978f42ab"],
 ", the energy of a free particle of the mass ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f4872429-6298-4ac0-af24-c8618e3cacd1"],
 " that moves in the two dimensions of the wall."
}], "Text",ExpressionUUID->"a71fd2bc-5b1f-4cdf-ad6a-c94add2ff1be"],

Cell[TextData[{
 "For the kink, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"], "2"], "\[MinusPlus]", 
    StyleBox["d", "TI"], 
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "/", 
    StyleBox["d", "TI"], 
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"], "\[Infinity]"], ")"}], "2"], "-", 
    SubsuperscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Infinity]"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"], "\[Infinity]"], "\[PlusMinus]", "1", "/", 
      SubsuperscriptBox["\[ScriptL]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["K",
        FontSlant->"Plain"]]}], ")"}], "\[ThinSpace]", 
    StyleBox["cosh",
     FontSlant->"Plain"], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["x", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], "1"], "/", 
       SubsuperscriptBox["\[ScriptL]", 
        StyleBox["LL",
         FontSlant->"Plain"], 
        StyleBox["K",
         FontSlant->"Plain"]]}], ")"}], 
     RowBox[{"-", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d4b35d28-bd33-4a77-a84a-c7e5953e19ff"],
 ", because ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["tanh",
      FontSlant->"Plain"], "2"], "\[LongEqual]", "1", "-", 
    SuperscriptBox[
     StyleBox["cosh",
      FontSlant->"Plain"], 
     RowBox[{"-", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "25806f96-4585-46f6-9c83-d99984b35aff"],
 " and the derivative of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["tanh",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "1"], "/", 
      SubsuperscriptBox["\[ScriptL]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["K",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5d4244a1-d7be-466c-b152-f73812fb17f3"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["cosh",
     FontSlant->"Plain"], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["x", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], "1"], "/", 
       SubsuperscriptBox["\[ScriptL]", 
        StyleBox["LL",
         FontSlant->"Plain"], 
        StyleBox["K",
         FontSlant->"Plain"]]}], ")"}], 
     RowBox[{"-", "2"}]], "/", 
    SubsuperscriptBox["\[ScriptL]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "adc9e88b-29bf-4d39-8656-700deebe162d"],
 ". The operator of the sector ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a4c91d62-28dd-45e2-b050-343863be94d4"],
 " is therefore ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox["\[CapitalDelta]", 
      StyleBox["LL",
       FontSlant->"Plain"], "\[Infinity]"], ")"}], "2"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c4d07d84-a41c-4def-bd3a-d72c2866d1d0"],
 " plus the potential well ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     SuperscriptBox[
      StyleBox["d", "TI"], "2"]}], "/", 
    StyleBox["d", "TI"], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "1"], ")"}], "2"], "-", 
    SubsuperscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Infinity]"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"], "\[Infinity]"], "+", "1", "/", 
      SubsuperscriptBox["\[ScriptL]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["K",
        FontSlant->"Plain"]]}], ")"}], "\[ThinSpace]", 
    StyleBox["cosh",
     FontSlant->"Plain"], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["x", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], "1"], "/", 
       SubsuperscriptBox["\[ScriptL]", 
        StyleBox["LL",
         FontSlant->"Plain"], 
        StyleBox["K",
         FontSlant->"Plain"]]}], ")"}], 
     RowBox[{"-", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fcfa53c0-96f4-4c98-876a-2f3602ae9b9f"],
 ", a well of the form of Poeschl and Teller with the parameter ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalDelta]", 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Infinity]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "335ee33d-8d97-49f9-af7a-8de6b44c19ac"],
 "; and the operator of the sector ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "01e12e19-8d7c-4345-b9db-dea2fd92c823"],
 " is ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox["\[CapitalDelta]", 
      StyleBox["LL",
       FontSlant->"Plain"], "\[Infinity]"], ")"}], "2"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0785d78f-23c7-415a-b0e0-0a08f6396bf0"],
 " plus the well of the same form with the parameter ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Infinity]"], "-", "1", "/", 
    SubsuperscriptBox["\[ScriptL]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ea27bb94-f044-479e-ae52-62bc25a7a749"],
 ". By the argument of the two products, the well with the parameter ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalDelta]", 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Infinity]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7975f391-18c8-400b-853e-654d3c568bf6"],
 " has one bound state more than the well with the parameter ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Infinity]"], "-", "1", "/", 
    SubsuperscriptBox["\[ScriptL]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c2dd495d-d12b-4587-952a-65fa239c5864"],
 ", namely ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CurlyPhi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["K",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "204be7f2-cd52-4bcb-b884-2dd7b663aeef"],
 " with the eigenvalue ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"], "\[Infinity]"], ")"}], "2"]}], TraditionalForm]],
   "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7a7d3cfd-bb77-4f32-890e-d6bb1070dda7"],
 " of the well, and its other bound states are those of the well with the \
smaller parameter. Applied again and again, as long as the parameter stays \
positive, this gives the eigenvalues ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox["\[CapitalDelta]", 
        StyleBox["LL",
         FontSlant->"Plain"], "\[Infinity]"], "-", 
       SubsuperscriptBox[
        StyleBox["k", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], 
        StyleBox["K",
         FontSlant->"Plain"]], "/", 
       SubsuperscriptBox["\[ScriptL]", 
        StyleBox["LL",
         FontSlant->"Plain"], 
        StyleBox["K",
         FontSlant->"Plain"]]}], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4774e40d-c0d1-4abe-b2ae-f50ae88b6359"],
 " of the well with the parameter ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalDelta]", 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Infinity]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e16887f0-eef4-4b99-9999-4b9126a3d6db"],
 ", for the integers ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["k", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["K",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "47dee216-719b-45ce-be5d-540627d61ec3"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "\[LessEqual]", 
    SubsuperscriptBox[
     StyleBox["k", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]], "<", 
    SubsuperscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Infinity]"], 
    SubsuperscriptBox["\[ScriptL]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e2b92904-df51-4bf8-9964-cad68d9ac61c"],
 ", and those with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "\[LessEqual]", 
    SubsuperscriptBox[
     StyleBox["k", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]], "<", 
    SubsuperscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Infinity]"], 
    SubsuperscriptBox["\[ScriptL]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "effe52fa-a12c-4eca-9537-e3bb9ab3b55a"],
 " for the sector ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "91d631c9-d6eb-40ee-9fb9-9a16176ad620"],
 ". The bound states of the wall therefore have the energies"
}], "Text",ExpressionUUID->"9bf2253c-f598-4b90-855d-f2196944f52b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["E", "TI"], 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["n", "TI"]}], 
    StyleBox["qp",
     FontSlant->"Plain"]], "\[LongEqual]", 
   RowBox[{"\[PlusMinus]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["m", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], "2"], "+", 
       SuperscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox[
          StyleBox["q", "TI"], 
          StyleBox["LL",
           FontSlant->"Plain"], "2"], ")"}], "2"], "+", 
       SuperscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox[
          StyleBox["q", "TI"], 
          StyleBox["LL",
           FontSlant->"Plain"], "3"], ")"}], "2"], "+", 
       FractionBox[
        RowBox[{"2", 
         SubsuperscriptBox[
          StyleBox["k", "TI"], 
          StyleBox["LL",
           FontSlant->"Plain"], 
          StyleBox["K",
           FontSlant->"Plain"]], 
         SubsuperscriptBox["\[CapitalDelta]", 
          StyleBox["LL",
           FontSlant->"Plain"], "\[Infinity]"]}], 
        SubsuperscriptBox["\[ScriptL]", 
         StyleBox["LL",
          FontSlant->"Plain"], 
         StyleBox["K",
          FontSlant->"Plain"]]], "-", 
       FractionBox[
        SuperscriptBox[
         RowBox[{"(", 
          SubsuperscriptBox[
           StyleBox["k", "TI"], 
           StyleBox["LL",
            FontSlant->"Plain"], 
           StyleBox["K",
            FontSlant->"Plain"]], ")"}], "2"], 
        SuperscriptBox[
         RowBox[{"(", 
          SubsuperscriptBox["\[ScriptL]", 
           StyleBox["LL",
            FontSlant->"Plain"], 
           StyleBox["K",
            FontSlant->"Plain"]], ")"}], "2"]]}], ")"}], 
     RowBox[{"1", "/", "2"}]]}], ",", "      ", 
   SubsuperscriptBox[
    StyleBox["k", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["K",
     FontSlant->"Plain"]], "\[LongEqual]", "0", ",", "1", ",", "2", ",", 
   "\[Ellipsis]", ",", "   ", 
   SubsuperscriptBox[
    StyleBox["k", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["K",
     FontSlant->"Plain"]], "<", 
   SubsuperscriptBox["\[CapitalDelta]", 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Infinity]"], 
   SubsuperscriptBox["\[ScriptL]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["K",
     FontSlant->"Plain"]]}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"b27f20a0-5f40-46aa-9922-d141bdfdf316"],

Cell[TextData[{
 "four times each sign for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["k", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a1cecbb9-daba-41d0-ae6b-d0a8cf1da816"],
 " (the sector ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f10fff2b-3bd1-44af-9977-ab03360cb74b"],
 " only) and eight times each sign for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["k", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]], "\[GreaterEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "20821751-4e90-4f64-b1a9-8116169c74a6"],
 " (both sectors); the states that are not bound begin at ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["m", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "2"], "+", 
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox[
         StyleBox["q", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], "2"], ")"}], "2"], "+", 
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox[
         StyleBox["q", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], "3"], ")"}], "2"], "+", 
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox["\[CapitalDelta]", 
         StyleBox["LL",
          FontSlant->"Plain"], "\[Infinity]"], ")"}], "2"]}], ")"}], 
    RowBox[{"1", "/", "2"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3d999b23-7b13-4230-a6b0-7b5079528b67"],
 ". In particular, for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Infinity]"], 
    SubsuperscriptBox["\[ScriptL]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]], "\[LessEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "249425d7-f232-4782-a13a-e833dcd062da"],
 " the states with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["k", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e67a18f6-2232-4fee-bcaa-47d0362d7a94"],
 " are the only bound states. Check AS-8 verifies the properties of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["Q",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["K",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c4476901-5359-4a56-8f6f-3a0da00e3692"],
 " and the relation between ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Alpha]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "79e9873a-3811-4efd-b731-961cb58c3801"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "277dc80f-8827-4bbb-986d-a3b8828329fc"],
 "; the formula for the square, by applying the operator twice to a Gaussian \
function of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "1"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "22b50bd4-24fb-47ea-abb5-533645ae7f68"],
 " times a random vector of 16 components, with exact derivatives, for 50 \
random kinks, points and momenta; and the bound states of the two scalar \
operators for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Infinity]"], 
    SubsuperscriptBox["\[ScriptL]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e9761536-6a49-4b8c-8d13-49f7182250ed"],
 " and ",
 Cell[BoxData[
  FormBox["2.5", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b95dab1b-ad1b-43da-9bbc-e30120052580"],
 " (one and none, and three and two bound states)."
}], "Text",ExpressionUUID->"be3b6d71-9551-451c-a144-21c2bf780065"],

Cell[TextData[{
 "The bound states of the scalar operators are computed by second-order \
finite differences on the interval from ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "20"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d96e6e6b-d8c2-46ae-8eb4-94c48dc54c46"],
 " to ",
 Cell[BoxData[
  FormBox["20", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1ead6369-e698-4099-8984-09919e4254f2"],
 " with 4000 and with 8001 inner points. The error of such differences is \
proportional to the square of the spacing, so four thirds of the finer result \
minus one third of the coarser one removes its leading part (Richardson \
extrapolation). The finite-difference operator is a symmetric tridiagonal \
matrix. The number of its eigenvalues below a given number is the number of \
negative pivots in the elimination of the matrix minus that number times the \
unit matrix (a Sturm sequence; function ",
 StyleBox["t2sturmCount",
  FontFamily->"Source Code Pro"],
 ", which is compiled with ",
 StyleBox["Compile",
  FontFamily->"Source Code Pro"],
 " because the check passes through some fourteen million matrix rows), and \
bisection on this count gives every eigenvalue below the threshold ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox["\[CapitalDelta]", 
      StyleBox["LL",
       FontSlant->"Plain"], "\[Infinity]"], ")"}], "2"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d8a184de-ed2d-41e2-933a-a8d1573d593c"],
 " (function ",
 StyleBox["t2sturmLowest",
  FontFamily->"Source Code Pro"],
 ")."
}], "Text",ExpressionUUID->"107ba9d9-f695-4625-857e-6985a91cbcc0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
     "the", " ", "number", " ", "of", " ", "eigenvalues", " ", "below", " ", 
      "the", " ", "number", " ", "below", " ", "of", " ", "the", " ", "real", 
      " ", "symmetric", " ", "tridiagonal", " ", "matrix", " ", "with", " ", 
      "the", " ", "diagonal", " ", "diag", " ", "and", "\n", "   ", "the", " ",
       "constant", " ", "off"}], "-", 
     RowBox[{"diagonal", " ", 
      RowBox[{"off", ":", " ", 
       RowBox[{
        RowBox[{
        "the", " ", "number", " ", "of", " ", "negative", " ", "pivots", " ", 
         "of", " ", "the", " ", "elimination", " ", "of", " ", "the", " ", 
         "matrix", " ", "minus", " ", "below", " ", "times", " ", "the", "\n",
          "   ", "unit", " ", "matrix", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"a", " ", "Sturm", " ", "sequence"}], ")"}], ".", "  ", 
          "A"}], " ", "pivot", " ", "that", " ", "is", " ", "exactly", " ", 
         "zero", " ", "is", " ", "replaced", " ", "by"}], " ", "-", 
        RowBox[{"1", "e"}], "-", "300"}]}]}]}], ",", " ", 
    RowBox[{"as", " ", "in", " ", "the", " ", "original", " ", "program"}]}], 
   " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"t2sturmCount", " ", "=", " ", 
     RowBox[{"Compile", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"diag", ",", " ", "_Real", ",", " ", "1"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"off", ",", " ", "_Real"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"below", ",", " ", "_Real"}], "}"}]}], "}"}], ",", "\n", 
       "   ", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"count", " ", "=", " ", "0"}], ",", " ", 
           RowBox[{"pivot", " ", "=", " ", "1."}]}], "}"}], ",", "\n", "    ", 
         RowBox[{
          RowBox[{"Do", "[", "\n", "     ", 
           RowBox[{
            RowBox[{
             RowBox[{"pivot", " ", "=", " ", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"diag", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], " ", "-", " ", "below"}], 
                ")"}], " ", "-", " ", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"i", " ", "==", " ", "1"}], ",", " ", "0.", ",", " ", 
                 RowBox[{"off", " ", 
                  RowBox[{"off", "/", "pivot"}]}]}], "]"}]}]}], ";", "\n", 
             "     ", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"pivot", " ", "==", " ", "0."}], ",", " ", 
               RowBox[{"pivot", " ", "=", " ", 
                RowBox[{"-", "1.*^-300"}]}]}], "]"}], ";", "\n", "     ", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"pivot", " ", "<", " ", "0."}], ",", " ", 
               RowBox[{"count", "++"}]}], "]"}]}], ",", "\n", "     ", 
            RowBox[{"{", 
             RowBox[{"i", ",", " ", 
              RowBox[{"Length", "[", "diag", "]"}]}], "}"}]}], "]"}], ";", 
          "\n", "    ", "count"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", "eigenvalues", " ", "number", " ", "0"}], ",", " ", 
     "1", ",", " ", 
     RowBox[{"...", " ", 
      RowBox[{"(", "ascending", ")"}], " ", "below", " ", "upper", " ", "of", 
      " ", "the", " ", "tridiagonal", " ", "matrix"}], ",", " ", 
     RowBox[{
     "each", " ", "by", " ", "200", " ", "steps", " ", "of", " ", "bisection",
       "\n", "   ", "between", " ", "lower", " ", "and", " ", "upper"}]}], 
    " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2sturmLowest", "[", 
      RowBox[{
      "diag_", ",", " ", "off_", ",", " ", "lower_", ",", " ", "upper_"}], 
      "]"}], " ", ":=", " ", 
     RowBox[{"Table", "[", "\n", "   ", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"lo", " ", "=", " ", "lower"}], ",", " ", 
           RowBox[{"hi", " ", "=", " ", "upper"}], ",", " ", "mid"}], "}"}], ",",
          "\n", "    ", 
         RowBox[{
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"mid", " ", "=", " ", 
              RowBox[{"0.5", " ", 
               RowBox[{"(", 
                RowBox[{"lo", " ", "+", " ", "hi"}], ")"}]}]}], ";", " ", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"t2sturmCount", "[", 
                 RowBox[{"diag", ",", " ", "off", ",", " ", "mid"}], "]"}], 
                " ", ">", " ", "number"}], ",", " ", 
               RowBox[{"hi", " ", "=", " ", "mid"}], ",", " ", 
               RowBox[{"lo", " ", "=", " ", "mid"}]}], "]"}]}], ",", " ", 
            RowBox[{"{", "200", "}"}]}], "]"}], ";", "\n", "    ", 
          RowBox[{"0.5", " ", 
           RowBox[{"(", 
            RowBox[{"lo", " ", "+", " ", "hi"}], ")"}]}]}]}], "]"}], ",", 
       "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"number", ",", " ", "0", ",", " ", 
         RowBox[{
          RowBox[{"t2sturmCount", "[", 
           RowBox[{"diag", ",", " ", "off", ",", " ", "upper"}], "]"}], " ", "-",
           " ", "1"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"the", " ", "bound"}], "-", 
       RowBox[{"state", " ", "eigenvalues", " ", 
        RowBox[{"(", 
         RowBox[{"below", " ", "the", " ", "threshold", " ", 
          RowBox[{"dinf", "^", "2"}]}], ")"}], " ", "of", " ", "the", " ", 
        "scalar", " ", "operator"}], " ", "-", 
       RowBox[{
        RowBox[{"d", "^", "2"}], "/", 
        RowBox[{"dx", "^", "2"}]}], " ", "+", " ", 
       RowBox[{"Delta", "^", "2"}], " ", "+", " ", 
       RowBox[{"sgn", " ", 
        RowBox[{"Delta", "'"}], " ", "with", "\n", "   ", "Delta"}]}], " ", "=",
       " ", 
      RowBox[{"dinf", " ", "tanh", 
       RowBox[{"(", 
        RowBox[{"x", "/", "ellk"}], ")"}]}]}], ",", " ", 
     RowBox[{
      RowBox[{"by", " ", "second"}], "-", 
      RowBox[{"order", " ", "finite", " ", "differences", " ", "on", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "xmax"}], ",", " ", "xmax"}], ")"}], " ", "with", " ", 
       "Dirichlet", " ", "ends"}]}], ",", " ", 
     RowBox[{
      RowBox[{
      "extrapolated", " ", "from", "\n", "   ", "npts", " ", "and", " ", "2", 
       " ", "npts"}], " ", "+", " ", 
      RowBox[{"1", " ", "inner", " ", "points"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2ptBoundStates", "[", 
      RowBox[{
      "dinf_", ",", " ", "ellk_", ",", " ", "sgn_", ",", " ", "xmax_", ",", 
       " ", "npts_Integer"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "solve", ",", " ", "coarse", ",", " ", "fine", ",", " ", "len"}], 
        "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{
         RowBox[{"solve", "[", "np_", "]"}], " ", ":=", " ", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"width", " ", "=", " ", 
              RowBox[{"2.", " ", 
               RowBox[{"xmax", "/", 
                RowBox[{"(", 
                 RowBox[{"np", " ", "+", " ", "1."}], ")"}]}]}]}], ",", " ", 
             "diag"}], "}"}], ",", "\n", "     ", 
           RowBox[{
            RowBox[{"diag", " ", "=", " ", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"With", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"x", " ", "=", " ", 
                   RowBox[{
                    RowBox[{"-", "xmax"}], " ", "+", " ", 
                    RowBox[{"i", " ", "width"}]}]}], "}"}], ",", " ", 
                 RowBox[{
                  RowBox[{"2.", "/", 
                   RowBox[{"(", 
                    RowBox[{"width", " ", "width"}], ")"}]}], " ", "+", " ", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"dinf", " ", 
                    RowBox[{"Tanh", "[", 
                    RowBox[{"x", "/", "ellk"}], "]"}]}], ")"}], "^", "2"}], 
                  " ", "+", " ", 
                  RowBox[{"sgn", " ", 
                   RowBox[{
                    RowBox[{"dinf", "/", "ellk"}], "/", 
                    RowBox[{
                    RowBox[{"Cosh", "[", 
                    RowBox[{"x", "/", "ellk"}], "]"}], "^", "2"}]}]}]}]}], 
                "]"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"i", ",", " ", "1", ",", " ", "np"}], "}"}]}], 
              "]"}]}], ";", "\n", "     ", 
            RowBox[{"t2sturmLowest", "[", 
             RowBox[{"diag", ",", " ", 
              RowBox[{
               RowBox[{"-", "1."}], "/", 
               RowBox[{"(", 
                RowBox[{"width", " ", "width"}], ")"}]}], ",", " ", 
              RowBox[{
               RowBox[{"Min", "[", "diag", "]"}], " ", "-", " ", 
               RowBox[{"4.", "/", 
