            FormBox[
             RowBox[{"(", 
              RowBox[{"1", ",", "0", ",", "0"}], ")"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "747dcd69-07fd-4602-beb9-09e32ae84a23"],
           ", ",
           Cell[BoxData[
            FormBox[
             RowBox[{"(", 
              RowBox[{"0", ",", "1", ",", "0"}], ")"}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "bfb8d030-40ee-49b7-a438-ebdc619c6231"],
           ", ",
           Cell[BoxData[
            FormBox[
             RowBox[{"(", 
              RowBox[{"0", ",", "0", ",", 
