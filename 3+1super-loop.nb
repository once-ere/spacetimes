                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "da221fa8-d857-4550-832c-44cb4fd979fd"],
               
               " of the order parameter; it is an internal direction, not a \
direction in space (that is ",
               Cell[BoxData[
                FormBox[
                 StyleBox["j", "TI"], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "dc7c8663-4614-4c07-80d7-1a8656dbe55b"],
               ")"
              }], "Text",
               FontFamily->"Source Sans Pro",
               FontSize->9.5,ExpressionUUID->
               "3494e157-21ec-4130-87fe-4e762240a65c"],
