Cell[CellGroupData[{

Cell["\<\
II.1.3 The super-loop operators as matrices (t2core/src/model.rs)\
\>", "Subsection",ExpressionUUID->"f6d5b4c5-6fcc-46fa-8fd1-3587511378d5"],

Cell[TextData[{
 "Every matrix of the field equations is built from the matrix ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["M", "TI"], "LL"], "(", 
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"1a9059ed-8917-41d1-bf32-c19586f3166d"]], "InlineFormula",
  ExpressionUUID->"ae5233ea-df03-4963-9771-131f7c83711b"],
 " of a bi-quaternion. A bi-quaternion ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], "\[LongEqual]", 
     UnderoverscriptBox["\[Sum]", 
      RowBox[{
       StyleBox["p", "TI"], "\[LongEqual]", "0"}], "3",
      LimitsPositioning->True], 
     SubsuperscriptBox["\[Xi]", 
      StyleBox["p", "TI"], "LL"], 
     RowBox[{"(", 
      StyleBox["b",
       FontWeight->"Bold",
       FontSlant->"Plain"], ")"}], 
     SubscriptBox[
      StyleBox["e",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      StyleBox["p", "TI"]]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"091b7520-0982-4546-88ba-baf3f2bfc0e5"]], "InlineFormula",
  ExpressionUUID->"2b57bd49-258a-4243-b1cb-29a757ac9e81"],
 " (four complex coefficients ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubsuperscriptBox["\[Xi]", 
      StyleBox["p", "TI"], "LL"], "(", 
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"3ef3d2ca-cf97-4527-9cc6-b8c8d3ff4380"]], "InlineFormula",
  ExpressionUUID->"466ab6dd-f0e7-4bd8-83a3-52d39888455a"],
 ") has the ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{"2", "\[Cross]", "2"}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"5808c700-e205-48df-a80d-5f9afa1dc087"]], "InlineFormula",
  ExpressionUUID->"40c735ea-4c84-4cb4-9d96-a790c8419202"],
 " matrix ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["M", "TI"], "LL"], 
     RowBox[{"(", 
      StyleBox["b",
       FontWeight->"Bold",
       FontSlant->"Plain"], ")"}], "\[LongEqual]", 
     SubsuperscriptBox["\[Xi]", "0", "LL"], 
     RowBox[{"(", 
      StyleBox["b",
       FontWeight->"Bold",
       FontSlant->"Plain"], ")"}], 
     SubsuperscriptBox["\[Sigma]", "0", "LL"], "-", 
     StyleBox["i", "TI"], 
     UnderoverscriptBox["\[Sum]", 
      RowBox[{
       StyleBox["j", "TI"], "\[LongEqual]", "1"}], "3",
      LimitsPositioning->True], 
     SubsuperscriptBox["\[Xi]", 
      StyleBox["j", "TI"], "LL"], 
     RowBox[{"(", 
      StyleBox["b",
       FontWeight->"Bold",
       FontSlant->"Plain"], ")"}], 
     SubsuperscriptBox["\[Sigma]", 
      StyleBox["j", "TI"], "LL"]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"ec5063fe-ceea-476d-b495-4395faa0bc97"]], "InlineFormula",
  ExpressionUUID->"5743408c-96b4-4ff7-8e84-083ce428e8bc"],
 ", so that ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["M", "TI"], "LL"], 
     RowBox[{"(", 
      SubscriptBox[
       StyleBox["e",
        FontWeight->"Bold",
        FontSlant->"Plain"], "0"], ")"}], "\[LongEqual]", 
     SubsuperscriptBox["\[Sigma]", "0", "LL"]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"92d69a62-b2d8-43cf-9fd4-2d0d2bcade56"]], 
  "InlineFormula",ExpressionUUID->"c80065d6-6b49-4c67-8762-a62e159ed830"],
 " and ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["M", "TI"], "LL"], 
     RowBox[{"(", 
      SubscriptBox[
       StyleBox["e",
        FontWeight->"Bold",
        FontSlant->"Plain"], 
       StyleBox["j", "TI"]], ")"}], "\[LongEqual]", "-", 
     StyleBox["i", "TI"], 
     SubsuperscriptBox["\[Sigma]", 
      StyleBox["j", "TI"], "LL"]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"6629a4c7-d97f-4f39-940d-f62a238e49de"]], "InlineFormula",
  ExpressionUUID->"825ae4c5-3a45-4f91-9cf6-7077319bca9c"],
 ". The canonical frame of ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["\[DoubleStruckCapitalR]",
      FontSlant->"Plain"], "LL", 
     RowBox[{"1", ",", "3"}]], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"ef50d4e8-5826-49e9-933c-272ad117a822"]], "InlineFormula",
  ExpressionUUID->"0449c705-e34c-4db0-90ce-cbc267046dbb"],
 " is ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["f",
       FontWeight->"Bold",
       FontSlant->"Plain"], "0"], "\[LongEqual]", 
     SubscriptBox[
      StyleBox["e",
       FontWeight->"Bold",
       FontSlant->"Plain"], "0"]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"a0bb8abb-dd92-4a72-b8e3-4cfe6c2a6ecb"]], "InlineFormula",
  ExpressionUUID->"7d475e68-2b84-4e6b-b212-d30acc144ee3"],
 ", ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["f",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      StyleBox["j", "TI"]], "\[LongEqual]", 
     StyleBox["i", "TI"], 
     SubscriptBox[
      StyleBox["e",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      StyleBox["j", "TI"]]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"8588540d-a53e-4f5b-b76d-8db4f957df4a"]], "InlineFormula",
  ExpressionUUID->"29c05405-a615-4812-9453-2d49e7be8f0e"],
 ", with ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["M", "TI"], "LL"], 
     RowBox[{"(", 
      SubscriptBox[
       StyleBox["f",
        FontWeight->"Bold",
        FontSlant->"Plain"], 
       StyleBox["p", "TI"]], ")"}], "\[LongEqual]", 
     SubsuperscriptBox["\[Sigma]", 
      StyleBox["p", "TI"], "LL"]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"fba0c600-e016-49ef-9560-10773062f237"]], "InlineFormula",
  ExpressionUUID->"904e0b48-d4da-4099-9329-fb5f6cec2bb5"],
 ". The Dirac matrices of a frame are ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubsuperscriptBox["\[Gamma]", "LL", 
      StyleBox["p", "TI"]], 
     RowBox[{"[", 
      StyleBox["f",
       FontWeight->"Bold",
       FontSlant->"Plain"], "]"}], "\[LongEqual]", 
     RowBox[{"(", Cell[BoxData[
       FormBox[GridBox[{
          {Cell[TextData[{
            " ",
            Cell[
            "0", "InlineFormula",ExpressionUUID->
             "1fe5546a-4662-434a-8938-1bc9eb12deaa"],
            " "
           }],ExpressionUUID->"c4182a24-25e3-4beb-84d6-32d710ec87f3"], Cell[
           TextData[{
            " ",
            Cell[BoxData[
             RowBox[{
              SubscriptBox[
               StyleBox["M", "TI"], "LL"], "(", 
              SubscriptBox[
               StyleBox["f",
                FontWeight->"Bold",
                FontSlant->"Plain"], 
               StyleBox["p", "TI"]], ")"}]], "InlineFormula",ExpressionUUID->
             "c5cbfefb-f3d6-45dd-ac2e-2b88b3f3fd93"],
            " "
           }],ExpressionUUID->"a4824b45-4120-4873-ad9e-6ed60091c454"]},
          {Cell[TextData[{
            " ",
            Cell[BoxData[
             RowBox[{
              SubscriptBox[
               StyleBox["M", "TI"], "LL"], "(", 
              SubscriptBox[
               OverscriptBox[
                StyleBox["f",
                 FontWeight->"Bold",
                 FontSlant->"Plain"], "_"], 
               StyleBox["p", "TI"]], ")"}]], "InlineFormula",ExpressionUUID->
             "fbb6f1cb-ca23-496d-a8d0-9c7c9bf584c9"],
            " "
           }],ExpressionUUID->"4e8cab08-7aa6-4543-8cf3-fa4fe4984203"], Cell[
           TextData[{
            " ",
            Cell[
            "0", "InlineFormula",ExpressionUUID->
             "8f0e7c8d-cb69-42e0-9576-c1b2f2eed983"],
            " "
           }],ExpressionUUID->"3961bb52-ed80-4c3f-ba3c-592949800d9b"]}
         }], TraditionalForm]],ExpressionUUID->
       "faa63b82-1e72-4e84-a6e2-bd907c37a12b"], ")"}]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"a4f0c4b6-53a9-4f0d-86b5-d692510e550c"]], 
  "InlineFormula",ExpressionUUID->"c24df59d-dcef-4ca0-90fe-7646f3ad6c05"],
 " (the chiral basis; ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    OverscriptBox[
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], "_"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"2c5284dd-4707-4a45-8991-3c8003c6b251"]], "InlineFormula",
  ExpressionUUID->"ec17fb00-d3d9-463f-b625-ab4cfbc88e2e"],
 " is the conjugate bi-quaternion, in which the signs of the coefficients of ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["e",
       FontWeight->"Bold",
       FontSlant->"Plain"], "1"], ",", 
     SubscriptBox[
      StyleBox["e",
       FontWeight->"Bold",
       FontSlant->"Plain"], "2"], ",", 
     SubscriptBox[
      StyleBox["e",
       FontWeight->"Bold",
       FontSlant->"Plain"], "3"]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"b73b2dd0-e84a-45ba-bc70-aecb6c4b7b83"]], "InlineFormula",
  ExpressionUUID->"02095740-ac06-4aa0-8566-26610701b9dc"],
 " change); for the canonical frame they are ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[Gamma]", "LL", 
     StyleBox["p", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "e9151a0e-8339-4f2c-855a-d2b1b1ecdf69"]], "InlineFormula",ExpressionUUID->
  "b31ace75-c517-43d9-a73d-3b46ce90655c"],
 ". The spinor field ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubscriptBox["\[CapitalPsi]", "LL"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"fcbacb36-2584-47a6-982e-d3819a2a8e9b"]], "InlineFormula",
  ExpressionUUID->"b9a3c983-2390-4d5b-af89-eee2236fe179"],
 " has the 8 components ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox["\[CapitalPsi]", 
      RowBox[{"LL", ",", "1"}]], ",", "\[Ellipsis]", ",", 
     SubscriptBox["\[CapitalPsi]", 
      RowBox[{"LL", ",", "8"}]]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"85ae2704-08b6-4fe8-afc8-2885f77d59a3"]], "InlineFormula",
  ExpressionUUID->"5f6bec21-19f5-4c41-8a42-204a01ab3d62"],
 ": components 1 and 2 are the first Dirac component with isospin up and \
down, 3 and 4 the second, 5 and 6 the third, 7 and 8 the fourth. A ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{"4", "\[Cross]", "4"}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"408ddf6e-eb66-4ce6-915f-5ddb7ddebb22"]], "InlineFormula",
  ExpressionUUID->"76bb28ad-ff2a-4209-8eb0-53b2612708e1"],
 " matrix of the Dirac index therefore acts on the eight components as its \
Kronecker product with ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"7fbb58e6-335c-4692-a556-5a8797366a2c"]], "InlineFormula",
  ExpressionUUID->"45966f79-f742-4c14-9e11-7abebe584689"],
 ", and a ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{"2", "\[Cross]", "2"}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"a6152af9-9771-43a3-af8b-8cc5c3c61046"]], "InlineFormula",
  ExpressionUUID->"f34b342b-bab3-40cd-a904-95125be2a2fc"],
 " matrix of the isospin index as the Kronecker product of ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "4"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"f636d0a6-ec60-472e-b749-a9106b1429f0"]], "InlineFormula",
  ExpressionUUID->"cc17f08f-352c-4bb4-a65c-a50af2f82204"],
 " with it. The cell defines every function of model.rs, in the same order; \
the comment of each function states the formula."
}], "Text",ExpressionUUID->"691a8b45-e027-4676-a47b-890dd74cca8b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", "Pauli", " ", "matrices", " ", "sigma_", "0", " ", 
     RowBox[{"(", "unit", ")"}]}], ",", " ", 
    RowBox[{"sigma_", "1"}], ",", " ", 
    RowBox[{"sigma_", "2"}], ",", " ", 
    RowBox[{"sigma_", "3"}], ",", " ", 
    RowBox[{
     RowBox[{"and", " ", "eps2"}], " ", "=", " ", 
     RowBox[{"i", " ", "sigma_", "2"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"t2sigma", "[", "0", "]"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1"}], "}"}]}], "}"}]}], ";", " ", 
    RowBox[{
     RowBox[{"t2sigma", "[", "1", "]"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2sigma", "[", "2", "]"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", 
         RowBox[{"-", "I"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"I", ",", " ", "0"}], "}"}]}], "}"}]}], ";", " ", 
    RowBox[{
     RowBox[{"t2sigma", "[", "3", "]"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", 
         RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"t2eps2", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "0"}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"M_LL", 
        RowBox[{"(", "b", ")"}], " ", "of", " ", "the", " ", "bi"}], "-", 
       RowBox[{"quaternion", " ", "b"}]}], " ", "=", " ", 
      RowBox[{"sum_p", " ", "xi_p", " ", "e_p"}]}], ",", " ", 
     RowBox[{"xi", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"xi_", "0"}], ",", " ", 
        RowBox[{"xi_", "1"}], ",", " ", 
        RowBox[{"xi_", "2"}], ",", " ", 
        RowBox[{"xi_", "3"}]}], "}"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2mq", "[", "xi_List", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"xi", "[", 
        RowBox[{"[", "1", "]"}], "]"}], " ", 
       RowBox[{"t2sigma", "[", "0", "]"}]}], " ", "-", " ", 
      RowBox[{"I", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"xi", "[", 
           RowBox[{"[", "2", "]"}], "]"}], " ", 
          RowBox[{"t2sigma", "[", "1", "]"}]}], " ", "+", " ", 
         RowBox[{
          RowBox[{"xi", "[", 
           RowBox[{"[", "3", "]"}], "]"}], " ", 
          RowBox[{"t2sigma", "[", "2", "]"}]}], " ", "+", " ", 
         RowBox[{
          RowBox[{"xi", "[", 
           RowBox[{"[", "4", "]"}], "]"}], " ", 
          RowBox[{"t2sigma", "[", "3", "]"}]}]}], ")"}]}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"the", " ", "conjugate", " ", "bi"}], "-", 
      RowBox[{"quaternion", ":", " ", 
       RowBox[{
       "the", " ", "signs", " ", "of", " ", "the", " ", "coefficients", " ", 
        "of", " ", "e1"}]}]}], ",", " ", "e2", ",", " ", 
     RowBox[{"e3", " ", "change"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2bqConj", "[", "xi_List", "]"}], " ", ":=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"xi", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
       RowBox[{"-", 
        RowBox[{"xi", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", 
       RowBox[{"-", 
        RowBox[{"xi", "[", 
         RowBox[{"[", "3", "]"}], "]"}]}], ",", " ", 
       RowBox[{"-", 
        RowBox[{"xi", "[", 
         RowBox[{"[", "4", "]"}], "]"}]}]}], "}"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"the", " ", "canonical", " ", "frame", " ", "of", " ", 
       RowBox[{"R", "^", 
        RowBox[{"(", 
         RowBox[{"1", ",", "3"}], ")"}]}], 
       RowBox[{"_LL", ":", " ", 
        RowBox[{"f_", "0"}]}]}], " ", "=", " ", "e0"}], ",", " ", 
     RowBox[{"f_j", " ", "=", " ", 
      RowBox[{"i", " ", "e_j", " ", 
       RowBox[{"(", 
        RowBox[{"one", " ", "row", " ", "per", " ", "p"}], ")"}]}]}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"t2canonicalFrame", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], "}"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "I", ",", " ", "0", ",", " ", "0"}], "}"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0", ",", " ", "I", ",", " ", "0"}], "}"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0", ",", " ", "0", ",", " ", "I"}], "}"}]}], 
      "}"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
      "the", " ", "Dirac", " ", "matrices", " ", "of", " ", "a", " ", "frame",
        " ", "f", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"a", " ", "list", " ", "of", " ", "four", " ", "bi"}], "-", 
         "quaternions"}], ")"}]}], ":", " ", 
      RowBox[{"gamma", "^", 
       RowBox[{"p", "[", "f", "]"}]}]}], " ", "=", " ", 
     RowBox[{"[", 
      RowBox[{
       RowBox[{"[", 
        RowBox[{"0", ",", " ", 
         RowBox[{"M", 
          RowBox[{"(", "f_p", ")"}]}]}], "]"}], ",", " ", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{"M", 
          RowBox[{"(", 
           RowBox[{"conj", " ", "f_p"}], ")"}]}], ",", " ", "0"}], "]"}]}], 
      "]"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2gammasFromFrame", "[", "f_", "]"}], " ", ":=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"ArrayFlatten", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", " ", 
            RowBox[{"t2mq", "[", 
             RowBox[{"f", "[", 
              RowBox[{"[", 
               RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}], "]"}]}], 
           "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"t2mq", "[", 
             RowBox[{"t2bqConj", "[", 
              RowBox[{"f", "[", 
               RowBox[{"[", 
                RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}], "]"}], "]"}],
             ",", " ", "0"}], "}"}]}], "}"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"gamma_LL", "^", "p"}], " ", "of", " ", "the", " ", "canonical", 
     " ", "frame", " ", 
     RowBox[{"(", 
