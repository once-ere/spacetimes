   RowBox[{"(*", " ", 
    RowBox[{
    "the", " ", "bound", " ", "of", " ", "the", " ", "spectral", " ", 
     "radius", " ", "used", " ", "for", " ", "the", " ", "time", " ", 
     "step"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2normBound", "[", 
      RowBox[{"lat_", ",", " ", "fl_"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Count", "[", 
        RowBox[{
         RowBox[{"lat", "[", "\"\<n\>\"", "]"}], ",", " ", 
         RowBox[{"n_", " ", "/;", " ", 
          RowBox[{"n", " ", ">", " ", "1"}]}]}], "]"}], " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", " ", "+", " ", 
          RowBox[{"2", " ", 
           RowBox[{"lat", "[", "\"\<wilson\>\"", "]"}]}]}], ")"}], "/", 
        RowBox[{"lat", "[", "\"\<ell\>\"", "]"}]}]}], " ", "+", " ", 
      RowBox[{"Abs", "[", 
       RowBox[{"lat", "[", "\"\<mass\>\"", "]"}], "]"}], " ", "+", " ", 
      RowBox[{"Abs", "[", 
       RowBox[{"lat", "[", "\"\<mu\>\"", "]"}], "]"}], " ", "+", "\n", "   ", 
      
      RowBox[{"Max", "[", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Norm", "[", 
           RowBox[{"#", ",", " ", "\"\<Frobenius\>\""}], "]"}], " ", "&"}], ",",
          " ", 
         RowBox[{"fl", "[", "\"\<v0\>\"", "]"}]}], "]"}], "]"}], " ", "+", 
      " ", 
      RowBox[{"Max", "[", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Total", "[", 
           RowBox[{"Abs", "[", "#", "]"}], "]"}], " ", "&"}], ",", " ", 
         RowBox[{"fl", "[", "\"\<d\>\"", "]"}]}], "]"}], "]"}]}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "free", " ", "lattice", " ", "dispersion", " ", "eps_lat", 
      RowBox[{
       RowBox[{"(", "q", ")"}], "^", "2"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"sum_j", " ", 
       RowBox[{"sin", "^", "2"}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"q_j", " ", "ell"}], ")"}], "/", 
        RowBox[{"ell", "^", "2"}]}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"m", " ", "+", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"r", "/", "ell"}], ")"}], " ", "sum_j", " ", 
          RowBox[{"(", 
           RowBox[{"1", " ", "-", " ", 
            RowBox[{"cos", " ", "q_j", " ", "ell"}]}], ")"}]}]}], ")"}], "^", 
       "2"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2epsLat", "[", 
      RowBox[{
      "q_List", ",", " ", "ell_", ",", " ", "m_", ",", " ", "r_", ",", " ", 
       "active_List"}], "]"}], " ", ":=", " ", 
     RowBox[{"Sqrt", "[", "\n", "   ", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"active", "[", 
            RowBox[{"[", "j", "]"}], "]"}], ",", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"Sin", "[", 
              RowBox[{
               RowBox[{"q", "[", 
                RowBox[{"[", "j", "]"}], "]"}], " ", "ell"}], "]"}], "^", 
             "2"}], "/", 
            RowBox[{"ell", "^", "2"}]}], ",", " ", "0"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}], " ", "+", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"m", " ", "+", " ", 
          RowBox[{
           RowBox[{"r", "/", "ell"}], " ", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"active", "[", 
                RowBox[{"[", "j", "]"}], "]"}], ",", " ", 
               RowBox[{"1", " ", "-", " ", 
                RowBox[{"Cos", "[", 
                 RowBox[{
                  RowBox[{"q", "[", 
                   RowBox[{"[", "j", "]"}], "]"}], " ", "ell"}], "]"}]}], ",",
                " ", "0"}], "]"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}]}], ")"}], "^", 
        "2"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "the", " ", "4", " ", "x", " ", "4", " ", "matrix", " ", "of", " ", "the",
      " ", "free", " ", "lattice", " ", "operator", " ", "on", " ", "the", " ",
      "plane", " ", "wave", " ", "exp", 
     RowBox[{"(", 
      RowBox[{"i", " ", 
       RowBox[{"q", ".", "x"}]}], ")"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2hLatPlane", "[", 
      RowBox[{
      "q_List", ",", " ", "ell_", ",", " ", "m_", ",", " ", "r_", ",", " ", 
       "active_List"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"active", "[", 
           RowBox[{"[", "j", "]"}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{"t2alpha", "[", "j", "]"}], " ", 
           RowBox[{
            RowBox[{"Sin", "[", 
             RowBox[{
              RowBox[{"q", "[", 
               RowBox[{"[", "j", "]"}], "]"}], " ", "ell"}], "]"}], "/", 
            "ell"}]}], ",", " ", "0"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}], " ", "+", "\n", "   ", 
      
      RowBox[{"t2beta", " ", 
       RowBox[{"(", 
        RowBox[{"m", " ", "+", " ", 
         RowBox[{
          RowBox[{"r", "/", "ell"}], " ", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"active", "[", 
               RowBox[{"[", "j", "]"}], "]"}], ",", " ", 
              RowBox[{"1", " ", "-", " ", 
               RowBox[{"Cos", "[", 
                RowBox[{
                 RowBox[{"q", "[", 
                  RowBox[{"[", "j", "]"}], "]"}], " ", "ell"}], "]"}]}], ",", 
              " ", "0"}], "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}]}], ")"}]}]}]}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"the", " ", "anomalous", " ", "density", " ", 
       RowBox[{"Pi", "^", "iota"}], 
       RowBox[{"(", "s", ")"}]}], " ", "=", " ", 
      RowBox[{"sum_n", " ", "psi_p"}]}], ",", 
     RowBox[{"n", 
      RowBox[{
       RowBox[{"(", "s", ")"}], "^", "T"}], " ", "Kch_iota", " ", "conj", 
      RowBox[{"(", 
       RowBox[{"psi_h", ",", 
        RowBox[{"n", 
         RowBox[{"(", "s", ")"}]}]}], ")"}], " ", "of", " ", "a", " ", "set", 
      " ", "of", " ", "mode", " ", "functions"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2anomalous", "[", 
      RowBox[{"ns_", ",", " ", "modes_List"}], "]"}], " ", ":=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"w", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{
              RowBox[{"16", " ", "s"}], " ", "+", " ", "1"}], " ", ";;", " ", 
             
             RowBox[{
              RowBox[{"16", " ", "s"}], " ", "+", " ", "8"}]}], "]"}], "]"}], 
          " ", ".", " ", 
          RowBox[{"N", "[", 
           RowBox[{"t2kpair", "[", "i", "]"}], "]"}], " ", ".", " ", 
          RowBox[{"Conjugate", "[", 
           RowBox[{"w", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{
               RowBox[{"16", " ", "s"}], " ", "+", " ", "9"}], " ", ";;", " ", 
              RowBox[{
               RowBox[{"16", " ", "s"}], " ", "+", " ", "16"}]}], "]"}], 
            "]"}], "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"w", ",", " ", "modes"}], "}"}]}], "]"}], ",", "\n", "   ", 
       
       RowBox[{"{", 
        RowBox[{"s", ",", " ", "0", ",", " ", 
         RowBox[{"ns", " ", "-", " ", "1"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
      "one", " ", "step", " ", "of", " ", "the", " ", "classical", " ", 
       "Runge"}], "-", 
      RowBox[{"Kutta", " ", "method", " ", "RK4", " ", "for", " ", "i", " ", 
       RowBox[{"dw", "/", "dt"}]}]}], " ", "=", " ", 
     RowBox[{"H", " ", "w"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2rk4Step", "[", 
      RowBox[{"lat_", ",", " ", "fl_", ",", " ", "w_", ",", " ", "dt_"}], 
      "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"k1", ",", " ", "k2", ",", " ", "k3", ",", " ", "k4"}], "}"}],
        ",", "\n", "   ", 
       RowBox[{
        RowBox[{"k1", " ", "=", " ", 
         RowBox[{
          RowBox[{"-", "I"}], " ", 
          RowBox[{"t2apply", "[", 
           RowBox[{"lat", ",", " ", "fl", ",", " ", "w"}], "]"}]}]}], ";", 
        "\n", "   ", 
        RowBox[{"k2", " ", "=", " ", 
         RowBox[{
          RowBox[{"-", "I"}], " ", 
          RowBox[{"t2apply", "[", 
           RowBox[{"lat", ",", " ", "fl", ",", " ", 
            RowBox[{"w", " ", "+", " ", 
             RowBox[{"0.5", " ", "dt", " ", "k1"}]}]}], "]"}]}]}], ";", "\n", 
        "   ", 
        RowBox[{"k3", " ", "=", " ", 
         RowBox[{
          RowBox[{"-", "I"}], " ", 
          RowBox[{"t2apply", "[", 
           RowBox[{"lat", ",", " ", "fl", ",", " ", 
            RowBox[{"w", " ", "+", " ", 
             RowBox[{"0.5", " ", "dt", " ", "k2"}]}]}], "]"}]}]}], ";", "\n", 
        "   ", 
        RowBox[{"k4", " ", "=", " ", 
         RowBox[{
          RowBox[{"-", "I"}], " ", 
          RowBox[{"t2apply", "[", 
           RowBox[{"lat", ",", " ", "fl", ",", " ", 
            RowBox[{"w", " ", "+", " ", 
             RowBox[{"dt", " ", "k3"}]}]}], "]"}]}]}], ";", "\n", "   ", 
        RowBox[{"w", " ", "+", " ", 
         RowBox[{
          RowBox[{"dt", "/", "6"}], " ", 
          RowBox[{"(", 
           RowBox[{"k1", " ", "+", " ", 
            RowBox[{"2", " ", "k2"}], " ", "+", " ", 
            RowBox[{"2", " ", "k3"}], " ", "+", " ", "k4"}], ")"}]}]}]}]}], 
      "]"}]}], ";"}]}]}]], "Input",
 CellLabel->
  "In[218]:=",ExpressionUUID->"9538a0d1-421e-4b74-abd0-d7e6984efa6e"],

Cell[TextData[{
 "The library module sym.rs is a small symbolic algebra: linear combinations \
of monomials (TeX strings) with exact coefficients ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     StyleBox["a", "TI"], "+", 
     StyleBox["b", "TI"], 
     StyleBox["i", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "dcb35a2a-f7d9-4956-9e4f-291d26bb822a"]], "InlineFormula",ExpressionUUID->
  "e5c996f9-6152-4003-bd33-03d11468ad1d"],
 " (",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     StyleBox["a", "TI"], ",", 
     StyleBox["b", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "4bfc5407-7790-4b80-b4a2-8aa4c33c9418"]], "InlineFormula",ExpressionUUID->
  "ef8fd6de-9670-4468-80df-1e196484dbfc"],
 " rational), used by the programs to print the matrices and the component \
equations in TeX and to evaluate every printed formula numerically. The \
Wolfram Language is itself a symbolic algebra with exact Gaussian rationals, \
so this module needs no rewriting: in check GS-12 below the same formulas are \
built from symbols and evaluated in the same way. For example, the TeX of ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[Sigma]", "2", "LL"], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"fa004311-63f2-449a-9208-64b91c228b23"]], 
  "InlineFormula",ExpressionUUID->"bab5419b-9235-4d09-8c14-19962a963055"],
 " written by ",
 StyleBox["TeXForm",
  FontFamily->"Source Code Pro"],
 ":"
}], "Text",ExpressionUUID->"bdbc7e8c-3644-49a0-b094-e397e3f2ae8d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ToString", "[", 
  RowBox[{"TeXForm", "[", 
   RowBox[{"MatrixForm", "[", 
    RowBox[{"t2sigma", "[", "2", "]"}], "]"}], "]"}], "]"}]], "Input",
 CellLabel->
  "In[238]:=",ExpressionUUID->"c112a36b-0620-42d1-a855-4f786ee2b93d"],

Cell[BoxData["\<\"\\\\left(\\n\\\\begin{array}{cc}\\n 0 & -i \\\\\\\\\\n i & \
0 \\\\\\\\\\n\\\\end{array}\\n\\\\right)\"\>"], "Output",
 CellChangeTimes->{4.003995309337576*^9},
 CellLabel->
  "Out[238]=",ExpressionUUID->"11fe8736-9955-45f6-995f-ee8e910cd29f"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
II.2 Item [1]: the field equations on the 3+1 manifold, and the checks GS-1 \
to GS-16 (program t2_fields)\
\>", "Section",ExpressionUUID->"d72b1774-6679-47ab-bfc8-71502f03fe36"],

Cell[TextData[{
 "The program t2_fields (t2fields/src/main.rs) builds every matrix of the \
field equations of the self-interacting spinor field ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubscriptBox["\[CapitalPsi]", "LL"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"cac30c28-227f-4363-8935-0db97cab0136"]], "InlineFormula",
  ExpressionUUID->"0ee8dd1b-b0f3-4dde-801d-9e67e94d15ea"],
 " on ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["\[DoubleStruckCapitalR]",
      FontSlant->"Plain"], "LL", 
     RowBox[{"1", ",", "3"}]], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"b53e87c4-c5ae-471c-a2b6-85a89688e16c"]], "InlineFormula",
  ExpressionUUID->"6002c412-1633-481b-a053-44f82617ffe4"],
 " and checks every statement made about them: checks GS-1 to GS-16. The \
rewriting below keeps the order of the original program, because the random \
numbers are drawn in that order from one generator with the seed 2026111707. \
Every check prints one line with PASS or FAIL; the statement is that of the \
original report, and the numbers in the details are the Wolfram Language \
results, followed (where the original report gives them) by the values of the \
original report."
}], "Text",ExpressionUUID->"a8b7afc8-835b-4577-aae9-6a9461156469"],

Cell[TextData[{
 "The physics in brief. The covariant derivative is ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubsuperscriptBox["\[Del]", 
      StyleBox["p", "TI"], "LL"], "\[LongEqual]", 
     SubscriptBox["\[PartialD]", 
      StyleBox["p", "TI"]], "+", 
     SubsuperscriptBox["\[CapitalGamma]", 
      StyleBox["p", "TI"], "LL"], "-", 
     StyleBox["i", "TI"], 
     SubscriptBox[
      StyleBox["A",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      RowBox[{"LL", ",", 
       StyleBox["p", "TI"]}]]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"19fd1ab5-dc0b-4013-99e6-3de07c1cd5b6"]], "InlineFormula",
  ExpressionUUID->"35b8dfcd-e79e-4a2c-ac40-6c17f140e5c8"],
 ", with the spin connection ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubsuperscriptBox["\[CapitalGamma]", 
      StyleBox["p", "TI"], "LL"], "\[LongEqual]", 
     SubscriptBox[
      StyleBox["s",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "LL"], 
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["u",
        FontWeight->"Bold",
        FontSlant->"Plain"], 
       RowBox[{"LL", ",", 
        StyleBox["p", "TI"]}], "\[Omega]"], ")"}], "\[CircleTimes]", 
     SubsuperscriptBox["\[Sigma]", "0", "LL"]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"d811eb77-4f54-4130-9e40-322f567ab569"]], 
  "InlineFormula",ExpressionUUID->"c8f526a1-a603-4d6b-8de6-f34db03f9bdb"],
 " (the Lorentz connection ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubsuperscriptBox[
      StyleBox["u",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      RowBox[{"LL", ",", 
       StyleBox["p", "TI"]}], "\[Omega]"], "\[LongEqual]", 
     UnderscriptBox["\[Sum]", 
      StyleBox["j", "TI"],
      LimitsPositioning->True], 
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox["\[Omega]", 
        RowBox[{"LL", ",", 
         StyleBox["p", "TI"]}], 
        StyleBox["j", "TI"]], 
       SubsuperscriptBox[
        StyleBox["J", "TI"], "LL", 
        StyleBox["j", "TI"]], "+", 
       SubsuperscriptBox["\[CurlyPi]", 
        RowBox[{"LL", ",", 
         StyleBox["p", "TI"]}], 
        StyleBox["j", "TI"]], 
       SubsuperscriptBox[
        StyleBox["K", "TI"], "LL", 
        StyleBox["j", "TI"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"78290960-8b1a-4810-be11-c05d9a0d0fff"]], "InlineFormula",
  ExpressionUUID->"5167ad25-0dbd-426f-a852-ecb02cb070f3"],
 ", an element of the Lorentz algebra of the super-loop, acting on the Dirac \
index) and the gauge matrix ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["A",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      RowBox[{"LL", ",", 
       StyleBox["p", "TI"]}]], "\[LongEqual]", 
     SubsuperscriptBox[
      StyleBox["g", "TI"], "LL", "v"], 
     UnderscriptBox["\[Sum]", "\[Iota]",
      LimitsPositioning->True], 
     SubsuperscriptBox[
      StyleBox["A", "TI"], 
      RowBox[{"LL", ",", 
       StyleBox["p", "TI"]}], "\[Iota]"], 
     SubsuperscriptBox[
      StyleBox["T", "TI"], "LL", "\[Iota]"], "+", 
     SubsuperscriptBox[
      StyleBox["g", "TI"], "LL", "F"], 
     SubsuperscriptBox[
      StyleBox["A", "TI"], 
      RowBox[{"LL", ",", 
       StyleBox["p", "TI"]}], "F"], 
     SubscriptBox[
      StyleBox["1",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "8"]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"3a218bcc-673a-45d9-8ae9-42cd0499d04b"]], "InlineFormula",
  ExpressionUUID->"e765539c-3445-42f9-9453-e938bb403a55"],
 " of the isospin group and of the fermion number. The mean-field \
(Dirac-Bogoliubov-de Gennes) equations couple the particle part ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[Psi]", "LL", "p"], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"5b4881bf-f974-40b7-9f77-61204e023d91"]], 
  "InlineFormula",ExpressionUUID->"cb5a7933-92f6-45c8-8010-8ea102c12ba2"],
 " and the hole part ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[Psi]", "LL", "h"], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"7f90625c-81c8-4f53-847f-9ef0b9b87e1e"]], 
  "InlineFormula",ExpressionUUID->"6f2321bc-ea18-4cc6-a9e1-6cdf2d7fa999"],
 " of a mode through the pairing block ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["P",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "LL"], "\[LongEqual]", 
     UnderscriptBox["\[Sum]", "\[Iota]",
      LimitsPositioning->True], 
     SubsuperscriptBox[
      StyleBox["d", "TI"], "LL", "\[Iota]"], 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["K",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], "LL", "\[Iota]"], ")"}], "\[Dagger]"]}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "357137d3-aa35-4d50-ae51-297ee5185527"]], "InlineFormula",ExpressionUUID->
  "f5398a1e-de66-4bbd-b0f9-47a9c4089787"],
 ", where ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["d", "TI"], "\[RightVector]"], "LL"], "\[LongEqual]", 
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["d", "TI"], "LL", "1"], ",", 
       SubsuperscriptBox[
        StyleBox["d", "TI"], "LL", "2"], ",", 
       SubsuperscriptBox[
        StyleBox["d", "TI"], "LL", "3"]}], ")"}]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"61c34bbb-9b9a-4e6b-a4ec-d8614cb6e5c7"]], 
  "InlineFormula",ExpressionUUID->"f89afb4c-aa22-4c76-835d-aa19c5682c0e"],
 " is the order parameter."
}], "Text",ExpressionUUID->"6abfd897-1dd2-469c-ac0e-9f3bea71a5bd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "the", " ", "seed", " ", "of", " ", "the", " ", "program", " ", 
    "t2_fields", " ", "and", " ", "the", " ", "tolerance", " ", "of", " ", 
    "the", " ", "exact", " ", "relations"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"t2Seed", "[", "2026111707", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"tol", " ", "=", " ", "1*^-12"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", "Frobenius", " ", "norm"}], ",", " ", 
