 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"1 Indices, conventions and number sets\"\>", "\[Rule]", 
    "11"}], ",", 
   RowBox[{"\<\"2 The bi-octonions and the super-loop\"\>", "\[Rule]", "26"}],
    ",", 
   RowBox[{"\<\"3 Operators on the super-loop and their eigenvalues\"\>", "\[Rule]",
     "3"}], ",", 
