Cell[CellGroupData[{

Cell["\<\
GS-3 and GS-4: finite transformations, isospin and the pair matrices\
\>", "Subsection",ExpressionUUID->"a15b4622-61ad-4bce-b0bd-4241fc133468"],

Cell[TextData[{
 "GS-3 is the change of representation of the gauge group ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SL", "TI"], 
    RowBox[{"(", 
     RowBox[{"2", ",", 
      StyleBox["\[DoubleStruckCapitalC]",
       FontSlant->"Plain"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1a278e63-534e-4701-8572-191e7000d930"],
 ": for a unit bi-quaternion ",
 Cell[BoxData[
  FormBox[
   StyleBox["g",
    FontWeight->"Bold",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "64020e80-2bf9-4696-a242-07e56a839a67"],
 " the spinor matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["S",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[LongEqual]", 
    StyleBox["diag",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      RowBox[{"(", 
       OverscriptBox[
        StyleBox["g",
         FontWeight->"Bold",
         FontSlant->"Plain"], "~"], ")"}], ",", 
      SubscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      RowBox[{"(", 
       StyleBox["g",
        FontWeight->"Bold",
        FontSlant->"Plain"], ")"}]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1e265404-2d71-4705-9648-03b03ddb26fb"],
 ", with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], "~"], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      SuperscriptBox[
       StyleBox["g",
        FontWeight->"Bold",
        FontSlant->"Plain"], "\[Dagger]"], ")"}], 
     RowBox[{"-", "1"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "be7afbef-b1a5-40a3-a6f1-c027e7d264cd"],
 " and so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     OverscriptBox[
      StyleBox["g",
       FontWeight->"Bold",
       FontSlant->"Plain"], "~"], ")"}], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["M", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"]], 
       SuperscriptBox[
        RowBox[{"(", 
         StyleBox["g",
          FontWeight->"Bold",
          FontSlant->"Plain"], ")"}], "\[Dagger]"]}], ")"}], 
     RowBox[{"-", "1"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "09512123-7823-4220-845d-38870d864930"],
 ", satisfies ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["S",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      StyleBox["g",
       FontWeight->"Bold",
       FontSlant->"Plain"], ")"}], 
     RowBox[{"-", "1"}]], 
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p", "TI"]], 
    SubscriptBox[
     StyleBox["S",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", 
     SuperscriptBox[
      StyleBox["p", "TI"], "\[Prime]"],
     LimitsPositioning->True], 
    SubscriptBox[
     RowBox[{"[", 
      RowBox[{
       SubscriptBox[
        StyleBox["L",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["LL",
         FontSlant->"Plain"]], 
       RowBox[{"(", 
        StyleBox["g",
         FontWeight->"Bold",
         FontSlant->"Plain"], ")"}]}], "]"}], 
     RowBox[{
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], 
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     SuperscriptBox[
      StyleBox["p", "TI"], "\[Prime]"]]}], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "70fab077-c9da-4bc2-8bdf-28aa4e91e079"],
 " with the real Lorentz matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"[", 
      RowBox[{
       SubscriptBox[
        StyleBox["L",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["LL",
         FontSlant->"Plain"]], 
       RowBox[{"(", 
        StyleBox["g",
         FontWeight->"Bold",
         FontSlant->"Plain"], ")"}]}], "]"}], 
     RowBox[{
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], "\[LongEqual]", 
    FractionBox["1", "2"], 
    StyleBox["Re",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["\[Sigma]", 
       StyleBox["p", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      SubscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      RowBox[{"(", 
       StyleBox["g",
        FontWeight->"Bold",
        FontSlant->"Plain"], ")"}], 
      SubsuperscriptBox["\[Sigma]", 
       SuperscriptBox[
        StyleBox["p", "TI"], "\[Prime]"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      SubscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      SuperscriptBox[
       RowBox[{"(", 
        StyleBox["g",
         FontWeight->"Bold",
         FontSlant->"Plain"], ")"}], "\[Dagger]"]}], ")"}]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7ce55dc2-ae19-4fde-b5f4-84e8e4c0ca97"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["S",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
