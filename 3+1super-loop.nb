                   RowBox[{"2", 
                    SubscriptBox[
                    StyleBox["G", "TI"], "LL"], 
                    RowBox[{"\[LeftAngleBracket]", 
                    SubsuperscriptBox["\[CapitalPi]", "LL", "\[Iota]"], 
                    "\[RightAngleBracket]"}]}]], TraditionalForm], 
                 "\", and its non-unitarity \"", 
                 FormBox[
                  RowBox[{
                    RowBox[{
                    SubscriptBox["\[Zeta]", "LL"], "\[LongEqual]"}], "|", 
                    RowBox[{
                    SubscriptBox[
                    OverscriptBox[
                    StyleBox["d", "TI"], "\[RightVector]"], "LL"], "\[Cross]", 
                    SubsuperscriptBox[
                    OverscriptBox[
                    StyleBox["d", "TI"], "\[RightVector]"], "LL", 
                    RowBox[{" ", "*"}]]}], "|", 
                    RowBox[{"/", 
                    RowBox[{"|", 
                    SubscriptBox[
                    OverscriptBox[
                    StyleBox["d", "TI"], "\[RightVector]"], "LL"], 
                    SuperscriptBox["|", "2"], 
                    RowBox[{"\[Element]", 
                    RowBox[{"[", 
                    RowBox[{"0", ",", "1"}], "]"}]}]}]}]}], TraditionalForm], 
                 "\" (plain text `cross(dvec, dvec^*)`: the cross product)\""},
                "RowDefault"],
               StripOnInput->False,
               FontFamily->"Source Sans Pro",
               FontSize->9.5],
              ImageSize->290]},
            {
             PaneBox[
              TemplateBox[{
