              SubsuperscriptBox[
               StyleBox["u", FontSlant -> "Bold"], 
               RowBox[{"LL", ",", 
                 StyleBox["p", "TI"]}], 
               RowBox[{"\[Omega]", "*"}]], TraditionalForm], 
