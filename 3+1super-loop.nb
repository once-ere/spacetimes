            FormBox[
             RowBox[{
              SubscriptBox[
               OverscriptBox[
                StyleBox["d", "TI"], "\[RightVector]"], 
               StyleBox["LL",
                FontSlant->"Plain"]], "\[RightTeeArrow]", 
              StyleBox["exp",
               FontSlant->"Plain"], 
              RowBox[{"(", 
               RowBox[{"2", 
                StyleBox["i", "TI"], 
                SubsuperscriptBox["\[Theta]", 
