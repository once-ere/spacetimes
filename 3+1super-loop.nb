          FontSlant->"Plain"]], ")"}]}], ")"}]}], "]"}], "+", 
   SubscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   SubscriptBox["\[Beta]", 
