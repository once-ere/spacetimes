                    RowBox[{"-", 
                    SubsuperscriptBox["\[Sigma]", 
                    StyleBox["j", "TI"], "LL"]}]], "InlineFormula"], " "}]], 
                    Cell[
                    TextData[{" ", 
                    Cell["0", "InlineFormula"], " "}]]}}], TraditionalForm]]],
                     ")"}]}], TraditionalForm], "\"; the chirality matrix \"", 
                 FormBox[
                  RowBox[{
                    SubsuperscriptBox["\[Gamma]", "LL", "ch"], "\[LongEqual]", 
                    StyleBox["i", "TI"], 
                    SubsuperscriptBox["\[Gamma]", "LL", "0"], 
                    SubsuperscriptBox["\[Gamma]", "LL", "1"], 
                    SubsuperscriptBox["\[Gamma]", "LL", "2"], 
                    SubsuperscriptBox["\[Gamma]", "LL", "3"], "\[LongEqual]", 
                    
                    StyleBox["diag", FontSlant -> "Plain"], 
                    RowBox[{"(", 
