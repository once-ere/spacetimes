                SubsuperscriptBox[
                 StyleBox["y", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], "+"], ",", 
                SubsuperscriptBox[
                 StyleBox["y", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], "-"]}], ")"}], "\[LongEqual]", 
              RowBox[{"(", 
               RowBox[{"0", ",", 
                FractionBox[
                 StyleBox["i", "TI"], "2"], 
                RowBox[{"(", 
