         PaneBox[Cell[TextData[{
           "a fixed complex unit vector, the direction of a deviation ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox["\[Delta]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["f",
                FontSlant->"Plain"]], 
              RowBox[{"(", 
