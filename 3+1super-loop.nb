                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "3404de9f-fff2-4770-91f9-441c6316bfc7"],
               " (plain text: ",
               StyleBox["xbar",
                FontFamily->"Source Code Pro"],
               ", ",
               StyleBox["x^*",
                FontFamily->"Source Code Pro"],
               ", ",
               StyleBox["x^dag",
                FontFamily->"Source Code Pro"],
               ", and likewise ",
