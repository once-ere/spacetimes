              StyleBox["\<\"Dpair\"\>",
               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[
              StyleBox[
               
               TemplateBox[{
                "\"the isospin part of the pairing block of the scalar \
channel, the \"", 
                 FormBox[
                  RowBox[{"2", "\[Cross]", "2"}], TraditionalForm], 
                 "\" matrix \"", 
                 FormBox[
                  RowBox[{
                    SubscriptBox[
                    StyleBox["D", FontSlant -> "Plain"], "LL"], 
                    "\[LongEqual]", 
                    UnderscriptBox[
                    "\[Sum]", "\[Iota]", LimitsPositioning -> True], 
                    SubsuperscriptBox[
                    StyleBox["d", "TI"], "LL", "\[Iota]"], 
                    SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{
                    SubscriptBox[
                    StyleBox["E", FontSlant -> "Plain"], "LL"], 
                    SubsuperscriptBox["\[Tau]", "\[Iota]", "LL"]}], ")"}], 
                    "\[Dagger]"]}], TraditionalForm], "\", so that \"", 
                 FormBox[
                  RowBox[{
                    SubscriptBox[
                    StyleBox["P", FontSlant -> "Plain"], "LL"], 
                    "\[LongEqual]", 
                    SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{
                    SubscriptBox[
                    StyleBox["C", "TI"], "LL"], 
                    SubsuperscriptBox["\[Gamma]", "LL", "ch"]}], ")"}], 
                    "\[Dagger]"], "\[CircleTimes]", 
                    SubscriptBox[
                    StyleBox["D", FontSlant -> "Plain"], "LL"]}], 
                  TraditionalForm], 
                 "\"; it is also the isospin wavefunction of the condensed \
pairs (rows and columns: isospin up, down); plain text `Dpair` (not `D_LL`, \
which is the Lorentz derivation)\""},
                "RowDefault"],
               StripOnInput->False,
               FontFamily->"Source Sans Pro",
               FontSize->9.5],
              ImageSize->290]},
