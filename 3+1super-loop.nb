     SubscriptBox[
      OverscriptBox[
       StyleBox["s", "TI"], "\[RightVector]"], 
      StyleBox["LL",
       FontSlant->"Plain"]], ")"}], "\[LongEqual]", 
    StyleBox["exp",
     FontSlant->"Plain"], 
