                    StyleBox["p", "TI"]}], "\[DownArrow]"], "\[LongEqual]", 
                 SubsuperscriptBox[
                  StyleBox["g", "TI"], "LL", "F"], 
                 SubsuperscriptBox[
                  StyleBox["A", "TI"], 
                  RowBox[{"LL", ",", 
                    StyleBox["p", "TI"]}], "F"], "-", "1"}], 
               RowBox[{"2", 
                 SubsuperscriptBox[
                  StyleBox["g", "TI"], "LL", "v"], 
                 SubsuperscriptBox[
                  StyleBox["A", "TI"], 
                  RowBox[{"LL", ",", 
                    StyleBox["p", "TI"]}], "3"]}]], TraditionalForm], 
             "\" on the isospin-down components (\"", 
             FormBox[
              FractionBox[
               RowBox[{
                 SubscriptBox[
                  StyleBox["Q", "TI"], "LL"], "\[LongEqual]", "-1"}], "2"], 
              TraditionalForm], 
             "\"); constant potentials of a space direction shift the \
