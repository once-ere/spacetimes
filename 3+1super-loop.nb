             FormBox[
              RowBox[{
                SubsuperscriptBox[
                 OverscriptBox[
                  StyleBox["n", "TI"], "^"], "LL", "F"], "\[LongEqual]", 
                UnderscriptBox["\[Sum]", 
                 StyleBox["k", "TI"], LimitsPositioning -> True], 
                SubsuperscriptBox[
                 OverscriptBox[
                  StyleBox["c", "TI"], "^"], 
                 RowBox[{"LL", ",", 
