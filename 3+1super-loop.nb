             RowBox[{"\"\<FAIL\>\"", ",", " ", "Red"}], "]"}]}], "]"}], ",", 
          " ", 
          RowBox[{"#", "[", "\"\<statement\>\"", "]"}]}], "}"}], " ", "&"}], ",",
        "\n", "    ", 
       RowBox[{"Select", "[", 
        RowBox[{"SL31`Test`$Results", ",", " ", 
         RowBox[{
          RowBox[{"StringStartsQ", "[", 
           RowBox[{
            RowBox[{"#", "[", "\"\<name\>\"", "]"}], ",", " ", 
            RowBox[{"\"\<GS-\>\"", " ", "|", " ", "\"\<T2-\>\""}]}], "]"}], 
          " ", "&"}]}], "]"}]}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"#", ",", " ", "Bold"}], "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<check\>\"", ",", " ", "\"\<result\>\"", ",", 
        " ", "\"\<statement\>\""}], "}"}]}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"(*", " ", 
    RowBox[{"no", " ", "fixed", " ", "column", " ", 
     RowBox[{"widths", ":", " ", 
      RowBox[{
      "the", " ", "front", " ", "end", " ", "wraps", " ", "the", " ", 
