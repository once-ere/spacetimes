               RowBox[{
                RowBox[{
                 RowBox[{"Transpose", "[", "u8", "]"}], " ", ".", " ", 
                 RowBox[{"k", "[", 
                  RowBox[{"[", "a", "]"}], "]"}], " ", ".", " ", "u8"}], " ", 
                "-", " ", 
                RowBox[{"Sum", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"r", "[", 
                    RowBox[{"[", 
                    RowBox[{"a", ",", " ", "b"}], "]"}], "]"}], " ", 
                   RowBox[{"k", "[", 
                    RowBox[{"[", "b", "]"}], "]"}]}], ",", " ", 
                  RowBox[{"{", 
                   RowBox[{"b", ",", " ", "3"}], "}"}]}], "]"}]}], "]"}]}], 
             "]"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"a", ",", " ", "3"}], "}"}]}], "]"}], ";", "\n", "   ", 
         RowBox[{"psi", " ", "=", " ", 
          RowBox[{"t2RndVec", "[", "8", "]"}]}], ";", "\n", "   ", 
