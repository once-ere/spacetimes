               StripOnInput->False,
               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[Cell[TextData[{
               "the pair operators ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubsuperscriptBox["\[CapitalPi]", 
                   StyleBox["LL",
                    FontSlant->"Plain"], "\[Iota]"], "\[LongEqual]", 
                  UnderscriptBox["\[Sum]", 
                   SubscriptBox[
                    OverscriptBox[
                    StyleBox["q", "TI"], "\[RightVector]"], 
