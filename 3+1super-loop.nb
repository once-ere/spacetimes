                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "75e430e7-4c8b-4a99-b01a-926a187528cc"],
               " (it is complex-linear, ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  OverscriptBox[
                   StyleBox[
                    RowBox[{"x", "y"}],
                    FontWeight->"Bold",
                    FontSlant->"Plain"], "_"], "\[LongEqual]", 
                  OverscriptBox[
                   StyleBox["y",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], "_"], "\[ThinSpace]", 
                  OverscriptBox[
                   StyleBox["x",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], "_"]}], TraditionalForm]], 
                "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "d65da156-b89e-4e18-bd93-f904d72a54df"],
               ", and ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  OverscriptBox[
                   RowBox[{
                    StyleBox["a",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], "+", 
