               FontFamily->"Source Code Pro",
               FontSize->8],
              ImageSize->95], 
             PaneBox[Cell[TextData[{
               "the Lorentz super-loop: the unit bi-octonions, ",
               Cell[BoxData[
                FormBox[
                 RowBox[{
                  SubscriptBox[
                   StyleBox["\[DoubleStruckCapitalL]",
                    FontSlant->"Plain"], 
                   StyleBox["LL",
                    FontSlant->"Plain"]], "\[LongEqual]", 
                  RowBox[{"{", 
                   RowBox[{
                    StyleBox["w",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], "\[Element]", 
                    SubscriptBox[
                    StyleBox["\[DoubleStruckCapitalB]",
                    FontSlant->"Plain"], 
                    StyleBox["LL",
                    FontSlant->"Plain"]], ":", 
                    SubscriptBox[
                    StyleBox["N", "TI"], 
                    StyleBox["LL",
                    FontSlant->"Plain"]], 
                    RowBox[{"(", 
                    StyleBox["w",
                    FontWeight->"Bold",
                    FontSlant->"Plain"], ")"}], "\[LongEqual]", "1"}], 
                   "}"}]}], TraditionalForm]], "InlineFormula",
                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "7307b49a-6615-4389-b816-67a98a88dbe3"],
               ", with the product of ",
               Cell[BoxData[
