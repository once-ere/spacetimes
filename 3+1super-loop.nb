Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", 
     RowBox[{"values", ":", " ", 
      RowBox[{"inside", " ", "Block", " ", "only"}]}]}], ",", " ", 
    RowBox[{
    "so", " ", "that", " ", "the", " ", "symbols", " ", "stay", " ", "free", " ",
      "elsewhere"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"pauliValues", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "0"}], "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", 
           RowBox[{"-", "I"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"I", ",", " ", "0"}], "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", 
           RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check7", " ", "=", " ", 
     RowBox[{"Block", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          SubsuperscriptBox["\[Sigma]", "1", "LL"], " ", "=", " ", 
          RowBox[{"pauliValues", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
         RowBox[{
          SubsuperscriptBox["\[Sigma]", "2", "LL"], " ", "=", " ", 
          RowBox[{"pauliValues", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ",", "\n", "     ", 
         RowBox[{
          SubsuperscriptBox["\[Sigma]", "3", "LL"], " ", "=", " ", 
          RowBox[{"pauliValues", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], ",", " ", 
         RowBox[{
          SubscriptBox[
           TagBox[
            StyleBox["1",
             FontFamily->"Helvetica",
             FontSlant->"Plain"],
            "SL31SansSerif"], "2"], " ", "=", " ", 
          RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], "}"}], ",", "\n", 
       "   ", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"sum", ",", " ", "rule"}], "}"}], ",", "\n", "     ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{"the", " ", "sum", " ", "over", " ", "j", " ", "of", " ", 
            RowBox[{"sigma_j", " ", ".", " ", "sigma_j"}]}], ",", " ", 
           RowBox[{
           "written", " ", "with", " ", "the", " ", "three", " ", 
            "components"}]}], " ", "*)"}], "\n", "     ", 
         RowBox[{
          RowBox[{"sum", " ", "=", " ", 
           RowBox[{
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"sigma", "[", 
                RowBox[{"[", "j", "]"}], "]"}], " ", ".", " ", 
               RowBox[{"sigma", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}], " ", "-", " ", 
            RowBox[{"3", " ", 
             SubscriptBox[
              TagBox[
               StyleBox["1",
                FontFamily->"Helvetica",
                FontSlant->"Plain"],
               "SL31SansSerif"], "2"]}]}]}], ";", "\n", "     ", 
          RowBox[{"(*", " ", 
           RowBox[{
            RowBox[{
            "the", " ", "product", " ", "rule", " ", "for", " ", "all", " ", 
             "nine", " ", "pairs", " ", 
             RowBox[{"(", 
              RowBox[{"j", ",", " ", 
               RowBox[{"j", "'"}]}], ")"}]}], ",", " ", 
            RowBox[{
            "with", " ", "the", " ", "27", " ", "symbolized", " ", 
             "components", " ", "of", " ", "epsilon"}]}], " ", "*)"}], "\n", 
          "     ", 
          RowBox[{"rule", " ", "=", " ", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"sigma", "[", 
                RowBox[{"[", "j", "]"}], "]"}], " ", ".", " ", 
               RowBox[{"sigma", "[", 
                RowBox[{"[", "jp", "]"}], "]"}]}], " ", "-", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"KroneckerDelta", "[", 
                  RowBox[{"j", ",", " ", "jp"}], "]"}], " ", 
                 SubscriptBox[
                  TagBox[
                   StyleBox["1",
                    FontFamily->"Helvetica",
                    FontSlant->"Plain"],
                   "SL31SansSerif"], "2"]}], " ", "+", "\n", "           ", 
                RowBox[{"I", " ", 
                 RowBox[{"Sum", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"eps", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", ",", " ", "jp", ",", " ", "jpp"}], "]"}], 
                    "]"}], " ", "/.", " ", 
                    RowBox[{"Thread", "[", 
                    RowBox[{
                    RowBox[{"Flatten", "[", "eps", "]"}], " ", "->", " ", 
                    RowBox[{"Flatten", "[", 
                    RowBox[{"Normal", "[", 
                    RowBox[{"LeviCivitaTensor", "[", "3", "]"}], "]"}], 
                    "]"}]}], "]"}]}], ")"}], " ", 
                    RowBox[{"sigma", "[", 
                    RowBox[{"[", "jpp", "]"}], "]"}]}], ",", " ", 
                   RowBox[{"{", 
                    RowBox[{"jpp", ",", " ", "3"}], "}"}]}], "]"}]}]}], 
               ")"}]}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"j", ",", " ", "3"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"jp", ",", " ", "3"}], "}"}]}], "]"}]}], ";", "\n", 
          "     ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Max", "[", 
             RowBox[{"Abs", "[", "sum", "]"}], "]"}], ",", " ", 
            RowBox[{"Max", "[", 
             RowBox[{"Abs", "[", 
              RowBox[{"Flatten", "[", "rule", "]"}], "]"}], "]"}]}], 
           "}"}]}]}], "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"SL31Check", "[", 
     RowBox[{"\"\<S-7\>\"", ",", 
      " ", "\"\<sum over j of sigma^LL_j sigma^LL_j = 3 times the unit \
matrix, and sigma_j sigma_j' = delta_jj' + i sum_j'' epsilon_jj'j'' sigma_j'' \
for all nine pairs (components as symbolized symbols)\>\"", ",", "\n", "  ", 
      RowBox[{"check7", " ", "===", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0"}], "}"}]}], ",", " ", "check7"}], "]"}], 
    ";"}]}]}]], "Input",
 CellLabel->
  "In[197]:=",ExpressionUUID->"c93a4c97-ca8d-4fa4-b633-16f0796a3b5a"],

Cell[BoxData[
 StyleBox[
