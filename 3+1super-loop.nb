              RowBox[{
               SubsuperscriptBox[
                StyleBox["V", "TI"], 
                RowBox[{
                 StyleBox["LL",
                  FontSlant->"Plain"], ",", 
                 StyleBox["p", "TI"]}], 
                StyleBox["F",
                 FontSlant->"Plain"]], ",", 
               SubsuperscriptBox[
                StyleBox["V", "TI"], 
                RowBox[{
                 StyleBox["LL",
                  FontSlant->"Plain"], ",", 
                 StyleBox["p", "TI"]}], "1"], ",", 
               SubsuperscriptBox[
                StyleBox["V", "TI"], 
                RowBox[{
                 StyleBox["LL",
                  FontSlant->"Plain"], ",", 
                 StyleBox["p", "TI"]}], "2"], ",", 
               SubsuperscriptBox[
                StyleBox["V", "TI"], 
                RowBox[{
                 StyleBox["LL",
                  FontSlant->"Plain"], ",", 
                 StyleBox["p", "TI"]}], "3"]}], ")"}], TraditionalForm]], 
