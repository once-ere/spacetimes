         PaneBox[
          StyleBox[
           TemplateBox[{"\"the eight components of \"", 
             FormBox[
              SubscriptBox["\[CapitalPsi]", "LL"], TraditionalForm], 
             "\": components 1 and 2 are the first Dirac component with \
isospin up and down, 3 and 4 the second, 5 and 6 the third, 7 and 8 the \
fourth; \"", 
             FormBox[
              SubsuperscriptBox["\[CapitalPsi]", "LL", "-"], TraditionalForm],
              "\" (components 1 to 4, chirality \"", 
             FormBox["-1", TraditionalForm], "\") and \"", 
             FormBox[
              SubsuperscriptBox["\[CapitalPsi]", "LL", "+"], TraditionalForm],
              "\" (components 5 to 8, chirality \"", 
             FormBox["+1", TraditionalForm], 
             "\") are the two Weyl isodoublets; \"", 
             FormBox[
              RowBox[{
                SubscriptBox[
                 OverscriptBox["\[CapitalPsi]", "_"], "LL"], "\[LongEqual]", 
                SubsuperscriptBox["\[CapitalPsi]", "LL", "\[Dagger]"], 
                RowBox[{"(", 
                  RowBox[{
                    SubsuperscriptBox["\[Gamma]", "LL", "0"], 
                    "\[CircleTimes]", 
                    SubsuperscriptBox["\[Sigma]", "0", "LL"]}], ")"}]}], 
              TraditionalForm], "\" is the Dirac adjoint\""},
            "RowDefault"],
           StripOnInput->False,
           FontFamily->"Source Sans Pro",
           FontSize->9.5],
          ImageSize->290]},
        {
