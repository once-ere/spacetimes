Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"exact", " ", "values", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"45", "/", "2"}], ",", " ", 
       RowBox[{"1", "/", "5"}], ",", " ", "1"}], ")"}]}], ",", " ", 
    RowBox[{
    "so", " ", "that", " ", "FindRoot", " ", "can", " ", "work", " ", "with", 
     " ", "30", " ", "digits"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"gapValue", " ", "=", " ", 
     RowBox[{"Block", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          SubscriptBox["G", "LL"], " ", "=", " ", 
          RowBox[{"45", "/", "2"}]}], ",", " ", 
         RowBox[{
          SubscriptBox["m", "LL"], " ", "=", " ", 
          RowBox[{"1", "/", "5"}]}], ",", " ", 
         RowBox[{
          SubscriptBox["\[CapitalLambda]", "LL"], " ", "=", " ", "1"}]}], 
        "}"}], ",", "\n", "   ", 
       RowBox[{
        SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], " ", "/.", " ", 
        RowBox[{"FindRoot", "[", 
         RowBox[{"gapEquation", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], ",", " ", 
            "0.2"}], "}"}], ",", " ", 
          RowBox[{"WorkingPrecision", " ", "->", " ", "30"}], ",", " ", 
          RowBox[{"AccuracyGoal", " ", "->", " ", "20"}]}], "]"}]}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"SL31Check", "[", 
     RowBox[{"\"\<S-6\>\"", ",", 
      " ", "\"\<the gap equation written with the symbols gives the gap of \
the condensed vacuum 0.2094933033 at G = 22.5, m = 0.2, cutoff 1; 2 Delta_vac \
= 0.4189866 and 2 M_q = 0.5792666\>\"", ",", "\n", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"gapValue", " ", "-", " ", "0.2094933033"}], "]"}], " ", "<",
         " ", "1*^-10"}], " ", "&&", " ", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"2", " ", "gapValue"}], " ", "-", " ", "0.4189866"}], "]"}],
         " ", "<", " ", "1*^-7"}], " ", "&&", " ", 
