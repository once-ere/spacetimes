Cell[CellGroupData[{

Cell["I.5 The single symbols and their kinds", "Section",ExpressionUUID->"eaf8f3f8-157e-4a8a-bdda-46145745fe2b"],

Cell[TextData[{
 "An entry may list several symbols, for example \"",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a3264fa0-216e-4e0e-a2b3-ab6cd2272015"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Mu]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "095b7dc7-9c2e-4910-8893-83203262a588"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalLambda]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a45336f3-f790-4e52-88f6-f36c4e6d9779"],
 "\" (the mass of the spinor charges, the chemical potential and the momentum \
cutoff). The next cell takes every TeX segment between dollar signs, splits \
it into single items, converts each into boxes, and classifies it. The kinds \
are: symbol (one fixed object, such as ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalDelta]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["vac",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c12c53db-9225-4551-8590-b4b3821afb90"],
 "); family (a symbol with a running index, such as ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Tau]", "\[Iota]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "66bbfdd1-47fb-477a-88d4-7c613191f7c9"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Iota]", "\[LongEqual]", "1", ",", "2", ",", "3"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "34494338-6655-4ea5-831d-9072344abeca"],
 "); function and function family (a symbol followed by its argument, such as \
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["u",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1f521c96-0003-45d0-883c-f265f97ad761"],
 "); letter (a single letter such as ",
 Cell[BoxData[
  FormBox[
   StyleBox["D", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f5d0fca9-03a0-4d13-aca8-5f664e205797"],
 ", the number of space dimensions); index and primed index (",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d3162bb0-87d8-450d-9ce9-510ba54f26f6"],
 ", ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["p", "TI"], "\[Prime]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fa89d1ca-f9c6-400d-99c1-7259c458df20"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["j", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e9216907-a8f6-4c0e-9636-43a8d74ecbc6"],
 ", ",
 Cell[BoxData[
  FormBox["\[Iota]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ca47bae3-871e-4b86-a404-4ea7554cfe48"],
 ", ...); set (",
 Cell[BoxData[
  FormBox[
   StyleBox["\[DoubleStruckCapitalR]",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dba15089-61c4-43d4-97d1-0449cd5f7a15"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[DoubleStruckCapitalC]",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d1e2bcfa-cb6b-4745-8cd2-aa614ecdacb6"],
 ", ...); group (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SL",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{"2", ",", 
      StyleBox["\[DoubleStruckCapitalC]",
       FontSlant->"Plain"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7fbf7c35-f805-4297-a317-ca00ffb28570"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU",
     FontSlant->"Plain"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["v",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5519a301-1d5a-4db2-b75f-91a2bdc04abc"],
 ", ...); ket; operator (tr, det, the transpose, the tensor product, ...); \
expression (a combination such as ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     SubscriptBox[
      StyleBox["T", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"]], ")"}], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6d51c17c-0a8e-4edf-92c5-7d37f9b3c75b"],
 "); imaginary unit. Entries that are not written in TeX at all are the \
labels of the machine checks and of the hypotheses of the no-go theorems; \
they are names, not symbols, and are kept as text."
}], "Text",ExpressionUUID->"9dcacb1d-f3bb-4627-80d3-d4a5004bf330"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "every", " ", "TeX", " ", "segment", " ", "of", " ", "every", " ", 
    RowBox[{"entry", ":", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"entry", " ", "number"}], ",", " ", "segment"}], "}"}]}]}], 
   " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"segments", " ", "=", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{"e", ",", " ", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"e", "[", "\"\<entry\>\"", "]"}], ",", " ", "#"}], 
               "}"}], " ", "&"}], ",", " ", 
             RowBox[{"StringCases", "[", 
              RowBox[{
               RowBox[{"e", "[", "\"\<symbol\>\"", "]"}], ",", " ", 
               RowBox[{
                RowBox[{"\"\<$\>\"", " ", "~~", " ", 
                 RowBox[{"Shortest", "[", "x__", "]"}], " ", "~~", 
                 " ", "\"\<$\>\""}], " ", ":>", " ", "x"}]}], "]"}]}], 
            "]"}]}], "]"}], ",", " ", "SL31Registry"}], "]"}], ",", " ", 
       "1"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"the", " ", "entries", " ", "without", " ", "any", " ", 
     RowBox[{"TeX", ":", " ", "labels"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"labelEntries", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{"SL31Registry", ",", " ", 
       RowBox[{
        RowBox[{"!", " ", 
         RowBox[{"StringContainsQ", "[", 
          RowBox[{
           RowBox[{"#", "[", "\"\<symbol\>\"", "]"}], ",", " ", "\"\<$\>\""}],
           "]"}]}], " ", "&"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "split", " ", "every", " ", "segment", " ", "into", " ", "single", " ", 
     "items", " ", "and", " ", "convert", " ", "each", " ", "item"}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"items", " ", "=", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{"s", ",", " ", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"<|", 
               RowBox[{
                RowBox[{"\"\<entry\>\"", " ", "->", " ", 
                 RowBox[{"s", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
                RowBox[{"\"\<tex\>\"", " ", "->", " ", "#"}], ",", " ", 
                RowBox[{"\"\<boxes\>\"", " ", "->", " ", 
                 RowBox[{"SL31TeXToBoxes", "[", "#", "]"}]}]}], "|>"}], " ", 
              "&"}], ",", " ", 
             RowBox[{"SL31SplitTeX", "[", 
              RowBox[{"s", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "]"}]}], "]"}], ",", 
         " ", "segments"}], "]"}], ",", " ", "1"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"items", " ", "=", " ", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Append", "[", 
         RowBox[{"#", ",", " ", 
          RowBox[{"\"\<kind\>\"", " ", "->", " ", 
           RowBox[{"SL31Classify", "[", 
            RowBox[{
             RowBox[{"#", "[", "\"\<tex\>\"", "]"}], ",", " ", 
             RowBox[{"#", "[", "\"\<boxes\>\"", "]"}]}], "]"}]}]}], "]"}], 
        " ", "&"}], ",", " ", "items"}], "]"}]}], ";"}], "\n", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", "[", "segments", "]"}], ",", " ", 
     RowBox[{"Length", "[", "items", "]"}], ",", " ", 
     RowBox[{"Length", "[", "labelEntries", "]"}]}], "}"}]}]}]], "Input",
 CellLabel->
  "In[147]:=",ExpressionUUID->"8b2ec39d-b00f-45e3-9216-8af735672257"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"452", ",", "467", ",", "2"}], "}"}]], "Output",
 CellChangeTimes->{4.004025485212727*^9},
 CellLabel->
