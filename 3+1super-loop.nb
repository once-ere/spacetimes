               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "ff105f5b-e54c-4330-b5f9-9c3cf314fc6f"],
           " in place of ",
           Cell[BoxData[
            FormBox[
             SubscriptBox[
              OverscriptBox[
               StyleBox["d", "TI"], "\[RightVector]"], 
              StyleBox["LL",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "df7de76f-393f-4600-9f85-9badfeaafd8c"],
           "; and the same for ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox[
              OverscriptBox[
               StyleBox["u", "TI"], "\[RightVector]"], 
