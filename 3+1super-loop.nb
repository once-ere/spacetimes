Cell[CellGroupData[{

Cell["GS-12: the explicit matrices and the component equations", "Subsection",ExpressionUUID->"c6445d17-169f-42ec-858b-bdecdf85ae26"],

Cell[TextData[{
 "The original program prints every matrix and every component equation of \
the field equations in TeX, with its small symbolic algebra, and evaluates \
each printed expression for numbers assigned to its symbols, comparing it \
with the ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{"8", "\[Cross]", "8"}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"f94678d1-b8b5-494e-ae06-0244435d004a"]], "InlineFormula",
  ExpressionUUID->"1756ed30-a6b0-4c0f-951e-ad5867ca2b90"],
 " and ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{"16", "\[Cross]", "16"}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"23d37a06-9e44-460a-9ae9-9319cd9a2b13"]], "InlineFormula",
  ExpressionUUID->"22f19d58-dfc1-4b71-ae2c-c242b3755e84"],
 " matrix computation (check GS-12). Here the same expressions are built from \
symbols of the Wolfram Language, shown, and evaluated in the same way. The \
symbols: ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["d", "TI"], "LL", "\[Iota]"], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"81423ba6-f579-4686-ac4d-0114b97b7108"]], 
  "InlineFormula",ExpressionUUID->"89ff4c25-1a97-4200-8055-1b3c1e452074"],
 " (the order parameter), ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[Omega]", 
     RowBox[{"LL", ",", 
      StyleBox["p", "TI"]}], 
     StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "012520a5-6d98-40a2-83d9-ca3aa952e0d9"]], "InlineFormula",ExpressionUUID->
  "3e530b0b-779f-419a-8c1e-482821bbdf4b"],
 " and ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[CurlyPi]", 
     RowBox[{"LL", ",", 
      StyleBox["p", "TI"]}], 
     StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "e55dcae9-42cd-432a-ba0b-d640b17cd886"]], "InlineFormula",ExpressionUUID->
  "815e17d5-f843-4613-a2fd-bca097ff6af1"],
 " (the rotation and boost parts of the Lorentz connection in the direction \
",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "635c0c91-7143-4aa0-a10c-8b9564dbe80a"]], "InlineFormula",ExpressionUUID->
  "aa97270d-72f4-4d38-8e90-0dcd2634a2bf"],
 "), ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{"LL", ",", 
      StyleBox["p", "TI"]}], "\[Iota]"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"1c10ebb2-1eff-4d1b-958f-228ada30ed06"]], "InlineFormula",
  ExpressionUUID->"9a804629-773c-4477-a717-afd2ed0d9cb5"],
 " and ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{"LL", ",", 
      StyleBox["p", "TI"]}], "F"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"fac510f8-8d2c-402c-9ca6-4ac046d7b136"]], "InlineFormula",
  ExpressionUUID->"73aaad1f-46ad-4b8c-8437-b63eedd5344d"],
 " (the gauge potentials), ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["g", "TI"], "LL", "v"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"b7a2389a-bd92-421f-a9c8-90df91623041"]], "InlineFormula",
  ExpressionUUID->"8a90ae9c-2805-4709-a0bf-f68682e5bf51"],
 ", ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["g", "TI"], "LL", "F"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"5e3d4fab-034b-4ddd-adab-679743db81a8"]], "InlineFormula",
  ExpressionUUID->"fd8d81ee-ea3e-49dd-aed3-469291a4918f"],
 " (the couplings), ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[Psi]", 
     RowBox[{"LL", ",", 
      StyleBox["k", "TI"]}], "p"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"7cf1f3a7-7cb5-4f9e-928e-f5f686d7af3b"]], "InlineFormula",
  ExpressionUUID->"45f0d8ba-4b25-4665-95cd-43a8c7179735"],
 ", ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[Psi]", 
     RowBox[{"LL", ",", 
      StyleBox["k", "TI"]}], "h"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"8df31e61-4020-4474-a5af-810104b70de3"]], "InlineFormula",
  ExpressionUUID->"f93efbab-5457-422d-b6d8-7898d216e7c9"],
 ", ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubscriptBox["\[CapitalPsi]", 
     RowBox[{"LL", ",", 
      StyleBox["k", "TI"]}]], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"95e63967-0d63-4e13-b46a-1c9e46580b82"]], "InlineFormula",
  ExpressionUUID->"68ce26e5-246a-4250-b466-73f7c0d27b90"],
 " (",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     StyleBox["k", "TI"], "\[LongEqual]", "1", ",", "\[Ellipsis]", ",", "8"}],
     TraditionalForm]], "InlineFormula",ExpressionUUID->
   "08d77001-1139-4dae-a6c3-3d225b3e3f1c"]], "InlineFormula",ExpressionUUID->
  "b4ff4d93-f5cc-4825-b084-580efb8549ca"],
 ", the components), ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubscriptBox[
     StyleBox["m", "TI"], "LL"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"2772a122-7876-4d03-9944-21bed6b105f4"]], "InlineFormula",
  ExpressionUUID->"24ea5d6d-aefd-4312-8902-884868902784"],
 ", ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubscriptBox["\[Mu]", "LL"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"12d0cbaa-b0ca-46e9-992c-89540255a1f6"]], "InlineFormula",
  ExpressionUUID->"dc901ab2-88e0-44f4-8263-6b1ec0c06fb6"],
 ", ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubscriptBox[
     StyleBox["G", "TI"], "LL"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"6cee6bfb-4ab9-4a05-b253-fe01e9037138"]], "InlineFormula",
  ExpressionUUID->"27a3a18d-9861-4788-9b17-e3c52bb10f56"],
 " and ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[CapitalPi]", "LL", "\[Iota]"], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"28471a5b-2b7c-41fa-b856-2b0c50f234b0"]], 
  "InlineFormula",ExpressionUUID->"12520533-a5bf-4a74-ab00-f67d8e42914b"],
 " (the pair operators). They are ordinary symbols with formatting rules, so \
that they print as in the documents."
}], "Text",ExpressionUUID->"6a8612c1-e08b-4b59-a960-5e7444262ea8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "the", " ", "symbols", " ", "of", " ", "the", " ", "formulas", " ", "and", 
    " ", "the", " ", "way", " ", "they", " ", "print"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Format", "[", 
      RowBox[{"dS", "[", "i_", "]"}], "]"}], " ", ":=", " ", 
     RowBox[{"Subsuperscript", "[", 
      RowBox[{"\"\<d\>\"", ",", " ", "\"\<LL\>\"", ",", " ", "i"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Format", "[", 
      RowBox[{"dStarS", "[", "i_", "]"}], "]"}], " ", ":=", " ", 
     RowBox[{"Superscript", "[", 
      RowBox[{
       RowBox[{"Subsuperscript", "[", 
        RowBox[{"\"\<d\>\"", ",", " ", "\"\<LL\>\"", ",", " ", "i"}], "]"}], ",",
        " ", "\"\<*\>\""}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Format", "[", 
      RowBox[{"omS", "[", 
       RowBox[{"j_", ",", " ", "idx_"}], "]"}], "]"}], " ", ":=", " ", 
     RowBox[{"Subsuperscript", "[", 
      RowBox[{"\"\<\[Omega]\>\"", ",", " ", 
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<LL,\>\"", ",", " ", "idx"}], "}"}], "]"}], ",", " ", 
       "j"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Format", "[", 
      RowBox[{"vpS", "[", 
       RowBox[{"j_", ",", " ", "idx_"}], "]"}], "]"}], " ", ":=", " ", 
     RowBox[{"Subsuperscript", "[", 
      RowBox[{"\"\<\[CurlyPi]\>\"", ",", " ", 
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<LL,\>\"", ",", " ", "idx"}], "}"}], "]"}], ",", " ", 
       "j"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Format", "[", 
      RowBox[{"afS", "[", "idx_", "]"}], "]"}], " ", ":=", " ", 
     RowBox[{"Subsuperscript", "[", 
      RowBox[{"\"\<A\>\"", ",", " ", 
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<LL,\>\"", ",", " ", "idx"}], "}"}], "]"}], ",", 
       " ", "\"\<F\>\""}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Format", "[", 
      RowBox[{"avS", "[", 
       RowBox[{"i_", ",", " ", "idx_"}], "]"}], "]"}], " ", ":=", " ", 
     RowBox[{"Subsuperscript", "[", 
      RowBox[{"\"\<A\>\"", ",", " ", 
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<LL,\>\"", ",", " ", "idx"}], "}"}], "]"}], ",", " ", 
       "i"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Format", "[", "gvS", "]"}], " ", ":=", " ", 
     RowBox[{"Subsuperscript", "[", 
      RowBox[{"\"\<g\>\"", ",", " ", "\"\<LL\>\"", ",", " ", "\"\<v\>\""}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Format", "[", "gfS", "]"}], " ", ":=", " ", 
     RowBox[{"Subsuperscript", "[", 
      RowBox[{"\"\<g\>\"", ",", " ", "\"\<LL\>\"", ",", " ", "\"\<F\>\""}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Format", "[", 
      RowBox[{"psP", "[", "k_", "]"}], "]"}], " ", ":=", " ", 
     RowBox[{"Subsuperscript", "[", 
      RowBox[{"\"\<\[Psi]\>\"", ",", " ", 
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<LL,\>\"", ",", " ", "k"}], "}"}], "]"}], ",", 
       " ", "\"\<p\>\""}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Format", "[", 
      RowBox[{"psH", "[", "k_", "]"}], "]"}], " ", ":=", " ", 
     RowBox[{"Subsuperscript", "[", 
      RowBox[{"\"\<\[Psi]\>\"", ",", " ", 
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<LL,\>\"", ",", " ", "k"}], "}"}], "]"}], ",", 
       " ", "\"\<h\>\""}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Format", "[", 
      RowBox[{"psiS", "[", "k_", "]"}], "]"}], " ", ":=", " ", 
     RowBox[{"Subscript", "[", 
      RowBox[{"\"\<\[CapitalPsi]\>\"", ",", " ", 
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<LL,\>\"", ",", " ", "k"}], "}"}], "]"}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Format", "[", 
      RowBox[{"psiStarS", "[", "k_", "]"}], "]"}], " ", ":=", " ", 
     RowBox[{"Subsuperscript", "[", 
      RowBox[{"\"\<\[CapitalPsi]\>\"", ",", " ", 
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<LL,\>\"", ",", " ", "k"}], "}"}], "]"}], ",", 
       " ", "\"\<*\>\""}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Format", "[", 
      RowBox[{"piS", "[", "i_", "]"}], "]"}], " ", ":=", " ", 
     RowBox[{"Subsuperscript", "[", 
      RowBox[{"\"\<\[CapitalPi]\>\"", ",", " ", "\"\<LL\>\"", ",", " ", "i"}],
       "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Format", "[", "mS", "]"}], " ", ":=", " ", 
     RowBox[{"Subscript", "[", 
      RowBox[{"\"\<m\>\"", ",", " ", "\"\<LL\>\""}], "]"}]}], ";", " ", 
    RowBox[{
     RowBox[{"Format", "[", "muS", "]"}], " ", ":=", " ", 
     RowBox[{"Subscript", "[", 
      RowBox[{"\"\<\[Mu]\>\"", ",", " ", "\"\<LL\>\""}], "]"}]}], ";", " ", 
    RowBox[{
     RowBox[{"Format", "[", "bigGS", "]"}], " ", ":=", " ", 
     RowBox[{"Subscript", "[", 
      RowBox[{"\"\<G\>\"", ",", " ", "\"\<LL\>\""}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Format", "[", 
