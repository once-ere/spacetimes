           StripOnInput->False,
           FontFamily->"Source Code Pro",
           FontSize->8],
          ImageSize->95], 
         PaneBox[Cell[TextData[{
           "the mass of the SFBS boson of the normal vacuum: the frequency ",
           Cell[BoxData[
            FormBox[
             SubsuperscriptBox["\[Omega]", 
              StyleBox["LL",
               FontSlant->"Plain"], 
              StyleBox["B",
               FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "ebcf9a54-defb-4d49-9851-ae1ee0327051"],
           " below the threshold ",
           Cell[BoxData[
            FormBox[
             RowBox[{"2", 
              SubscriptBox[
               StyleBox["m", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "608774e4-9f07-4b07-82c6-0ac4daf50579"],
           " with ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox["\[Chi]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["pr",
                FontSlant->"Plain"]], 
              RowBox[{"(", 
               RowBox[{
                SubsuperscriptBox["\[Omega]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["B",
                  FontSlant->"Plain"]], ",", "0"}], ")"}], "\[LongEqual]", 
              "1", "/", 
              SubscriptBox[
               StyleBox["G", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "9811494d-4555-4bb9-847d-ace6d2f5227d"],
           " (plain text ",
