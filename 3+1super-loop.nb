            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "02a58fbe-2b6e-49b8-b45e-ac3a240f718e"],
           ", ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SuperscriptBox[
               RowBox[{"(", 
                SubsuperscriptBox[
                 StyleBox["M", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["W",
                  FontSlant->"Plain"]], ")"}], "2"], "\[LongEqual]", "2", 
