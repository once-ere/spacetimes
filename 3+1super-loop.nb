            FormBox[
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                SubsuperscriptBox[
                 StyleBox["V", "TI"], 
                 RowBox[{
                  StyleBox["LL",
                   FontSlant->"Plain"], ",", 
                  StyleBox["p", "TI"]}], "1"], "\[MinusPlus]", 
