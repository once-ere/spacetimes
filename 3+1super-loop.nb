                    SubsuperscriptBox[
                    StyleBox["E", "TI"], "LL", "+"], "+", 
                    SubscriptBox["\[Epsilon]", "LL"], "+", 
                    SubscriptBox["\[Mu]", "LL"]}], ")"}]}], TraditionalForm], 
             "\" in the superfluid boson singlet state\""},
            "RowDefault"],
           StripOnInput->False,
           FontFamily->"Source Sans Pro",
           FontSize->9.5],
          ImageSize->290]},
        {
