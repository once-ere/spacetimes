Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Alpha]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "efcc74e4-5d26-4853-ac63-3c6ab69b5ad7"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Beta]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0469fee9-dadb-452a-91b9-bb9c617e5d27"],
 " act on the Dirac index and the link matrices on the isospin index (code: \
",
 StyleBox["t2hMinusV",
  FontFamily->"Source Code Pro"],
 " without the pair term, and ",
 StyleBox["t2apply",
  FontFamily->"Source Code Pro"],
 "). The hole row is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["P",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubscriptBox[
       OverscriptBox[
        StyleBox["s", "TI"], "\[RightVector]"], 
       StyleBox["LL",
        FontSlant->"Plain"]], ")"}], "\[Dagger]"], 
    SubsuperscriptBox["\[Psi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["s", "TI"], "\[RightVector]"], 
      StyleBox["LL",
       FontSlant->"Plain"]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1fdead6e-7f9b-4a31-a861-ca40be64e8a7"],
 " minus the complex conjugate of the same expression without the pair term, \
applied to the complex conjugate of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Psi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["h",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5afd1d65-2b60-42bd-a101-410234113778"],
 ". Here ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["W",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "34857227-eea0-4470-9012-ac558b4a40d0"],
 " is the Wilson coefficient (the term in ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["W",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e535105e-6c1e-4573-b41d-0b4eda5a1624"],
 " removes the doubled fermions of the lattice), ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["A",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", "0"}]], 
    RowBox[{"(", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["s", "TI"], "\[RightVector]"], 
      StyleBox["LL",
       FontSlant->"Plain"]], ")"}], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", "\[Iota]",
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", "0"}], "\[Iota]"], 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Iota]"], "+", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", "0"}], 
     StyleBox["F",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "8"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9e74f36a-f21d-4692-94ec-6195d7273578"],
 " is the potential of the time direction at the site and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["P",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["s", "TI"], "\[RightVector]"], 
      StyleBox["LL",
       FontSlant->"Plain"]], ")"}], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", "\[Iota]",
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Iota]"], 
    RowBox[{"(", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["s", "TI"], "\[RightVector]"], 
      StyleBox["LL",
       FontSlant->"Plain"]], ")"}], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "\[Iota]"], ")"}], "\[Dagger]"]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5d7ad8da-f4ac-4d0d-9b70-d91dedc0e839"],
 " the pairing block; a direction without a neighbour (a Dirichlet boundary) \
contributes zero. The function ",
 StyleBox["t2apply",
  FontFamily->"Source Code Pro"],
 " applies the operator to a vector, or, column by column, to a matrix whose \
columns are vectors; ",
 StyleBox["t2dense",
  FontFamily->"Source Code Pro"],
 " applies it to the unit matrix and so returns the whole matrix."
}], "Text",ExpressionUUID->"a5304660-b5be-4bad-b891-8b5ae7f0198d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "the", " ", "closed", " ", "form", " ", "of", " ", "the", " ", "link", " ",
     "matrix", " ", "exp", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "i"}], " ", "ell", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"gv", " ", 
         RowBox[{
          RowBox[{"a", ".", "tau"}], "/", "2"}]}], " ", "+", " ", 
        RowBox[{"gf", " ", "b"}]}], ")"}]}], ")"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"t2link", "[", 
      RowBox[{
      "gv_", ",", " ", "gf_", ",", " ", "a_List", ",", " ", "b_", ",", " ", 
       "ell_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"na", " ", "=", " ", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"a", " ", ".", " ", "a"}], "]"}]}], ",", " ", "x", ",", 
         " ", "ph", ",", " ", "cx", ",", " ", "sx", ",", " ", "n1", ",", " ", 
         "n2", ",", " ", "n3"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"x", " ", "=", " ", 
         RowBox[{"0.5", " ", "ell", " ", "gv", " ", "na"}]}], ";", "\n", 
        "   ", 
        RowBox[{"ph", " ", "=", " ", 
         RowBox[{
          RowBox[{"Cos", "[", 
           RowBox[{
            RowBox[{"-", "ell"}], " ", "gf", " ", "b"}], "]"}], " ", "+", " ", 
          RowBox[{"I", " ", 
           RowBox[{"Sin", "[", 
            RowBox[{
             RowBox[{"-", "ell"}], " ", "gf", " ", "b"}], "]"}]}]}]}], ";", 
        "\n", "   ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"cx", ",", " ", "sx"}], "}"}], " ", "=", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Cos", "[", "x", "]"}], ",", " ", 
           RowBox[{"Sin", "[", "x", "]"}]}], "}"}]}], ";", "\n", "   ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"n1", ",", " ", "n2", ",", " ", "n3"}], "}"}], " ", "=", 
         " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"na", " ", ">", " ", "0"}], ",", " ", 
           RowBox[{"a", "/", "na"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"0.", ",", " ", "0.", ",", " ", "0."}], "}"}]}], "]"}]}], 
        ";", "\n", "   ", 
        RowBox[{"ph", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"cx", " ", "-", " ", 
              RowBox[{"I", " ", "sx", " ", "n3"}]}], ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "sx"}], " ", "n2"}], " ", "-", " ", 
              RowBox[{"I", " ", "sx", " ", "n1"}]}]}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"sx", " ", "n2"}], " ", "-", " ", 
              RowBox[{"I", " ", "sx", " ", "n1"}]}], ",", " ", 
             RowBox[{"cx", " ", "+", " ", 
              RowBox[{"I", " ", "sx", " ", "n3"}]}]}], "}"}]}], "}"}]}]}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "2", " ", "x", " ", "2", " ", "potential", " ", "matrix", " ",
       "gv", " ", 
      RowBox[{
       RowBox[{"A0", ".", "tau"}], "/", "2"}]}], " ", "+", " ", 
     RowBox[{"gf", " ", "A0F"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2potential", "[", 
      RowBox[{"gv_", ",", " ", "gf_", ",", " ", "a0_List", ",", " ", "a0f_"}],
       "]"}], " ", ":=", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"h", " ", "=", " ", 
         RowBox[{"0.5", " ", "gv"}]}], "}"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"gf", " ", "a0f"}], " ", "+", " ", 
            RowBox[{"h", " ", 
             RowBox[{"a0", "[", 
              RowBox[{"[", "3", "]"}], "]"}]}]}], ",", " ", 
           RowBox[{
            RowBox[{"h", " ", 
             RowBox[{"a0", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], " ", "-", " ", 
            RowBox[{"I", " ", "h", " ", 
             RowBox[{"a0", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}]}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"h", " ", 
             RowBox[{"a0", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], " ", "+", " ", 
            RowBox[{"I", " ", "h", " ", 
             RowBox[{"a0", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}]}], ",", " ", 
           RowBox[{
            RowBox[{"gf", " ", "a0f"}], " ", "-", " ", 
            RowBox[{"h", " ", 
             RowBox[{"a0", "[", 
              RowBox[{"[", "3", "]"}], "]"}]}]}]}], "}"}]}], "}"}]}], "]"}]}],
     ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"a", " ", 
      RowBox[{"lattice", ":", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<n\>\"", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"n1", ",", " ", "n2", ",", " ", "n3"}], "}"}]}], ",", " ", 
         
         RowBox[{"\"\<ell\>\"", " ", "->", " ", "spacing"}], ",", " ", 
         RowBox[{"\"\<periodic\>\"", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"True", "|", "False"}], ",", " ", ".."}], "}"}]}], ",", 
         " ", 
         RowBox[{"\"\<wilson\>\"", " ", "->", " ", "r_W"}], ",", "\n", "   ", 
         
         RowBox[{"\"\<mass\>\"", " ", "->", " ", "m"}], ",", " ", 
         RowBox[{"\"\<mu\>\"", " ", "->", " ", "mu"}]}], "|>"}]}]}], ";", " ", 
     RowBox[{"sites", " ", "are", " ", "numbered", " ", "from", " ", "0"}]}], 
    " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2nsites", "[", "lat_", "]"}], " ", ":=", " ", 
     RowBox[{"Times", " ", "@@", " ", 
      RowBox[{"lat", "[", "\"\<n\>\"", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2dim", "[", "lat_", "]"}], " ", ":=", " ", 
     RowBox[{"16", " ", 
      RowBox[{"t2nsites", "[", "lat", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2siteOf", "[", 
      RowBox[{"lat_", ",", " ", 
       RowBox[{"{", 
        RowBox[{"ix_", ",", " ", "iy_", ",", " ", "iz_"}], "}"}]}], "]"}], 
     " ", ":=", " ", 
     RowBox[{"ix", " ", "+", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"lat", "[", "\"\<n\>\"", "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}], " ", 
       RowBox[{"(", 
        RowBox[{"iy", " ", "+", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"lat", "[", "\"\<n\>\"", "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}], " ", "iz"}]}], ")"}]}]}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2siteCoords", "[", 
      RowBox[{"lat_", ",", " ", "s_"}], "]"}], " ", ":=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Mod", "[", 
        RowBox[{"s", ",", " ", 
         RowBox[{
          RowBox[{"lat", "[", "\"\<n\>\"", "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", " ", 
       RowBox[{"Mod", "[", 
        RowBox[{
         RowBox[{"Quotient", "[", 
          RowBox[{"s", ",", " ", 
           RowBox[{
            RowBox[{"lat", "[", "\"\<n\>\"", "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", " ", 
         RowBox[{
          RowBox[{"lat", "[", "\"\<n\>\"", "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ",", " ", 
       RowBox[{"Quotient", "[", 
        RowBox[{"s", ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"lat", "[", "\"\<n\>\"", "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", 
          RowBox[{
           RowBox[{"lat", "[", "\"\<n\>\"", "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}]}]}], "]"}]}], "}"}]}], ";"}], "\n", 
   
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "neighbour", " ", "of", " ", "site", " ", "s", " ", "in", " ",
       "the", " ", "direction", " ", "j", " ", 
      RowBox[{"(", 
       RowBox[{"0", ",", " ", "1", ",", " ", "2"}], ")"}]}], ",", " ", 
     RowBox[{
      RowBox[{"forward", " ", "or", " ", "backward"}], ";", " ", 
      RowBox[{
      "None", " ", "at", " ", "a", " ", "Dirichlet", " ", "boundary", "\n", 
       "   ", "and", " ", "in", " ", "a", " ", "direction", " ", "with", " ", 
       "a", " ", "single", " ", "site"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2neighbour", "[", 
      RowBox[{"lat_", ",", " ", "s_", ",", " ", "j_", ",", " ", "fwd_"}], 
      "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", " ", "=", " ", 
          RowBox[{"t2siteCoords", "[", 
           RowBox[{"lat", ",", " ", "s"}], "]"}]}], ",", " ", 
         RowBox[{"n", " ", "=", " ", 
          RowBox[{
           RowBox[{"lat", "[", "\"\<n\>\"", "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"j", " ", "+", " ", "1"}], "]"}], "]"}]}]}], "}"}], ",", 
       "\n", "   ", 
       RowBox[{"Which", "[", "\n", "    ", 
        RowBox[{
         RowBox[{"n", " ", "==", " ", "1"}], ",", " ", "None", ",", "\n", 
         "    ", 
         RowBox[{"fwd", " ", "&&", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"x", "[", 
             RowBox[{"[", 
              RowBox[{"j", " ", "+", " ", "1"}], "]"}], "]"}], " ", "+", " ", 
            "1"}], " ", "==", " ", "n"}]}], ",", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"lat", "[", "\"\<periodic\>\"", "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"j", " ", "+", " ", "1"}], "]"}], "]"}], ",", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"x", "[", 
              RowBox[{"[", 
               RowBox[{"j", " ", "+", " ", "1"}], "]"}], "]"}], " ", "=", " ",
              "0"}], ";", " ", 
            RowBox[{"t2siteOf", "[", 
             RowBox[{"lat", ",", " ", "x"}], "]"}]}], ",", " ", "None"}], 
          "]"}], ",", "\n", "    ", "fwd", ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"x", "[", 
            RowBox[{"[", 
             RowBox[{"j", " ", "+", " ", "1"}], "]"}], "]"}], " ", "+=", " ", 
           "1"}], ";", " ", 
          RowBox[{"t2siteOf", "[", 
           RowBox[{"lat", ",", " ", "x"}], "]"}]}], ",", "\n", "    ", 
         RowBox[{
          RowBox[{"x", "[", 
           RowBox[{"[", 
            RowBox[{"j", " ", "+", " ", "1"}], "]"}], "]"}], " ", "==", " ", 
          "0"}], ",", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"lat", "[", "\"\<periodic\>\"", "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"j", " ", "+", " ", "1"}], "]"}], "]"}], ",", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"x", "[", 
              RowBox[{"[", 
               RowBox[{"j", " ", "+", " ", "1"}], "]"}], "]"}], " ", "=", " ", 
             RowBox[{"n", " ", "-", " ", "1"}]}], ";", " ", 
            RowBox[{"t2siteOf", "[", 
             RowBox[{"lat", ",", " ", "x"}], "]"}]}], ",", " ", "None"}], 
          "]"}], ",", "\n", "    ", "True", ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"x", "[", 
            RowBox[{"[", 
             RowBox[{"j", " ", "+", " ", "1"}], "]"}], "]"}], " ", "-=", " ", 
           "1"}], ";", " ", 
          RowBox[{"t2siteOf", "[", 
           RowBox[{"lat", ",", " ", "x"}], "]"}]}]}], "]"}]}], "]"}]}], ";"}],
    "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"trivial", " ", 
      RowBox[{"fields", ":", " ", 
       RowBox[{"unit", " ", "links"}]}]}], ",", " ", 
     RowBox[{"zero", " ", "potential"}], ",", " ", 
     RowBox[{"zero", " ", "order", " ", "parameter"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2trivialFields", "[", "ns_", "]"}], " ", ":=", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<links\>\"", " ", "->", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"N", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", " ", 
             RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", " ", 
             RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "}"}], "]"}], ",", 
          " ", 
          RowBox[{"{", "ns", "}"}]}], "]"}]}], ",", "\n", "   ", 
       RowBox[{"\"\<v0\>\"", " ", "->", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0.", ",", " ", "0."}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"0.", ",", " ", "0."}], "}"}]}], "}"}], ",", " ", 
          RowBox[{"{", "ns", "}"}]}], "]"}]}], ",", " ", 
       RowBox[{"\"\<d\>\"", " ", "->", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0.", ",", " ", "0.", ",", " ", "0."}], "}"}], ",", " ", 
          RowBox[{"{", "ns", "}"}]}], "]"}]}]}], "|>"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "8", " ", "x", " ", "8", " ", "matrices", " ", "used", " ", 
      "on", " ", "every", " ", 
      RowBox[{"site", ":", " ", 
       RowBox[{
        RowBox[{"alpha", "^", "j"}], " ", 
        RowBox[{"(", "x", ")"}], " ", "1", "_", "2"}]}]}], ",", " ", 
     RowBox[{"beta", " ", 
      RowBox[{"(", "x", ")"}], " ", "1", "_", "2", " ", "and", " ", 
      RowBox[{"Kch_iota", "^", "dag"}]}]}], " ", "*)"}], "\n", 
