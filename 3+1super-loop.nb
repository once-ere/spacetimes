     RowBox[{
     "a", " ", "number", " ", "that", " ", "directly", " ", "follows", " ", 
      "a", " ", "letter", " ", "is", " ", "joined", "\n", "        ", "to", " ",
       "the", " ", "letter", " ", "without", " ", "a", " ", "space", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
         "the", " ", "coordinate", " ", "x5", " ", "is", " ", "one", " ", 
          "name"}], ",", " ", 
         RowBox[{"not", " ", "a", " ", "product"}]}], ")"}], ".", "\n", 
       "     ", "4."}], " ", "A", " ", "sign", " ", "that", " ", "stands", " ",
       "first"}]}], ",", " ", 
    RowBox[{"or", " ", "after", " ", "an", " ", "operator"}], ",", " ", 
    RowBox[{"a", " ", "relation"}], ",", " ", 
    RowBox[{
    "an", " ", "opening", " ", "delimiter", " ", "or", " ", "a", "\n", 
     "        ", "comma"}], ",", " ", 
    RowBox[{
     RowBox[{
     "is", " ", "a", " ", "prefix", " ", "sign", " ", "and", " ", "is", " ", 
      "joined", " ", "to", " ", "the", " ", "item", " ", "that", " ", 
      "follows", " ", "it"}], ";", " ", 
     RowBox[{
     "the", " ", "name", " ", "of", " ", "a", "\n", "        ", "function", " ", 
