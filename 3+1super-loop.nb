Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"exact", " ", "values", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"45", "/", "2"}], ",", " ", 
       RowBox[{"1", "/", "5"}], ",", " ", "1"}], ")"}]}], ",", " ", 
    RowBox[{
    "so", " ", "that", " ", "FindRoot", " ", "can", " ", "work", " ", "with", 
     " ", "30", " ", "digits"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"gapValue", " ", "=", " ", 
     RowBox[{"Block", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          SubscriptBox["G", "LL"], " ", "=", " ", 
          RowBox[{"45", "/", "2"}]}], ",", " ", 
         RowBox[{
          SubscriptBox["m", "LL"], " ", "=", " ", 
          RowBox[{"1", "/", "5"}]}], ",", " ", 
