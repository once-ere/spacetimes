                SubsuperscriptBox["\[Theta]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], 
                 StyleBox["F",
                  FontSlant->"Plain"]]}], ")"}], 
              SubsuperscriptBox[
               StyleBox["R",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["v",
                FontSlant->"Plain"]], 
              RowBox[{"(", 
               SubscriptBox[
                StyleBox["U",
                 FontFamily->"Helvetica",
                 FontSlant->"Plain"], 
                StyleBox["LL",
                 FontSlant->"Plain"]], ")"}], 
              SubscriptBox[
               OverscriptBox[
                StyleBox["d", "TI"], "\[RightVector]"], 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "c248d933-84ea-45aa-9e44-93acfe4119f8"],
           " that leave it unchanged, a group ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              StyleBox["O", "TI"], 
              RowBox[{"(", "2", ")"}]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "5c27c38a-3540-4bc0-8934-1b895fd97c98"],
           " formed by the group ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              StyleBox["U", "TI"], 
              SubsuperscriptBox[
               RowBox[{"(", "1", ")"}], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["Q",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "c59e5fa9-b408-4dd6-9cf0-0496ccaa459c"],
           " of the electric charge (the rotations ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              StyleBox["exp",
               FontSlant->"Plain"], 
              RowBox[{"(", 
               RowBox[{
                StyleBox["i", "TI"], 
                SubsuperscriptBox["\[Theta]", 
                 StyleBox["LL",
                  FontSlant->"Plain"], "3"], 
                SubscriptBox[
                 StyleBox["Q", "TI"], 
                 StyleBox["LL",
                  FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], 
            "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "a08c236a-fba0-4625-9e57-1ec4d3eebef9"],
           " about the third isospin axis) and the reflection ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubsuperscriptBox["\[Theta]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["F",
                FontSlant->"Plain"]], "\[LongEqual]", "\[Pi]", "/", "2"}], 
             TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "4c1d00b1-db38-4013-8203-c201a642fb5b"],
           ", ",
           Cell[BoxData[
            FormBox[
             RowBox[{
              SubscriptBox[
               StyleBox["U",
                FontFamily->"Helvetica",
                FontSlant->"Plain"], 
               StyleBox["LL",
                FontSlant->"Plain"]], "\[LongEqual]", 
              StyleBox["i", "TI"], 
              SubsuperscriptBox["\[Tau]", "1", 
               StyleBox["LL",
                FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "068de710-edd4-4691-ab02-f4488a460b74"],
