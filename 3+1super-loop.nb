Cell[CellGroupData[{

Cell["GS-13: the stability of the time step", "Subsection",ExpressionUUID->"56d4d51e-f63d-496f-9694-211baa82903f"],

Cell[TextData[{
 "The solvers advance a mode in time with the classical Runge-Kutta method of \
fourth order (RK4) for ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     StyleBox["i", "TI"], " ", 
     SubscriptBox["\[PartialD]", "0"], 
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox["\[Psi]", "LL", "p"], ",", 
       SubsuperscriptBox["\[Psi]", "LL", "h"]}], ")"}], "\[LongEqual]", 
     SubsuperscriptBox[
      StyleBox["\[ScriptCapitalH]",
       FontSlant->"Plain"], "LL", "lat"], 
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox["\[Psi]", "LL", "p"], ",", 
       SubsuperscriptBox["\[Psi]", "LL", "h"]}], ")"}]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"bb91b712-5aba-4d60-aecb-87ab6de577df"]], 
  "InlineFormula",ExpressionUUID->"9fbfe07e-551f-462b-b1f5-be48bd7d02ef"],
 " with the time step ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[ScriptL]", "LL", "t"], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"4110d4e3-948a-4e6b-aa0c-4ad515bc6b56"]], 
  "InlineFormula",ExpressionUUID->"8516647b-324f-4995-b149-ff4417fedb38"],
 ". One step multiplies the component of an eigenvector with the energy ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["E", "TI"], 
     RowBox[{"LL", ",", 
      StyleBox["n", "TI"]}], "qp"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"d0b7a2e6-58e5-4e46-93ae-a736fc8a1fb6"]], "InlineFormula",
  ExpressionUUID->"74e5ebc0-04d3-47ba-8724-561f00ef0d5a"],
 " by ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{"1", "-", 
     StyleBox["i", "TI"], 
     StyleBox["z", "TI"], "-", 
     SuperscriptBox[
      StyleBox["z", "TI"], "2"], "/", "2", "+", 
     StyleBox["i", "TI"], 
     SuperscriptBox[
      StyleBox["z", "TI"], "3"], "/", "6", "+", 
     SuperscriptBox[
      StyleBox["z", "TI"], "4"], "/", "24"}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"c7adefa4-6c88-42db-8ef0-ed486baba0e6"]], 
  "InlineFormula",ExpressionUUID->"051f8f73-8583-459f-87ec-9f78a8ace136"],
 ", the Taylor polynomial of degree 4 of ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      StyleBox["i", "TI"], 
      StyleBox["z", "TI"]}]], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"3a5b6552-260d-4154-b484-6e727e275f82"]], "InlineFormula",
  ExpressionUUID->"4b486220-63ce-44cc-b4fe-fe98f905619a"],
 ", where ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    StyleBox["z", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "802d66ec-c7cf-46a4-a437-41ddc765337c"]], "InlineFormula",ExpressionUUID->
  "65ea06da-f7ba-4118-842a-1bc5497d0f92"],
 " is an abbreviation used only here and in Figure 2: ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     StyleBox["z", "TI"], "\[LongEqual]", 
     SubsuperscriptBox[
      StyleBox["E", "TI"], 
      RowBox[{"LL", ",", 
       StyleBox["n", "TI"]}], "qp"], 
     SubsuperscriptBox["\[ScriptL]", "LL", "t"]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"49101d14-35b4-42bc-9497-27a95ca60ec8"]], 
  "InlineFormula",ExpressionUUID->"0879fc38-717e-4a44-b64f-255aa4c7c8c1"],
 ". The modulus of the factor is at most 1 for ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{"|", 
     StyleBox["z", "TI"], "|", "\[LessEqual]", "2", 
     SqrtBox["2"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "aac8a14d-1ed2-4c46-9227-22c01231b3c4"]], "InlineFormula",ExpressionUUID->
  "63801b64-3ccc-434a-8e9b-52be928e0efc"],
 " and exceeds 1 beyond; for small ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    StyleBox["z", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "f80fb78d-fdf7-4f39-902e-1d4ad27b627d"]], "InlineFormula",ExpressionUUID->
  "ef3fb6da-b142-486d-8fe2-346e94115733"],
 " it is ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{"1", "-", 
     SuperscriptBox[
      StyleBox["z", "TI"], "6"], "/", "144"}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"44406378-c260-43ed-b43c-ba8039bb9260"]], 
  "InlineFormula",ExpressionUUID->"9805ac3e-6745-44c6-b59e-9e25325e6e4b"],
 " to leading order. The solvers therefore use ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubsuperscriptBox["\[ScriptL]", "LL", "t"], "\[LessEqual]", "2.5", "/", 
     SubsuperscriptBox[
      StyleBox["B", "TI"], "LL", "H"]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"1bfa859c-71aa-4911-81ba-afcd3b0f3e33"]], "InlineFormula",
  ExpressionUUID->"3b76819c-a2f2-4dcb-830c-97d18bac6472"],
 " with the bound ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["B", "TI"], "LL", "H"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"8a974255-e612-4023-a460-9c3502ad1d99"]], "InlineFormula",
  ExpressionUUID->"1067ab33-8a43-4808-8710-4f98e20df603"],
 " of the largest eigenvalue magnitude of ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalH]",
      FontSlant->"Plain"], "LL", "lat"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"485acd9c-852a-4bfa-822f-d9e71dbf55a8"]], "InlineFormula",
  ExpressionUUID->"2b9f6e91-4d21-4698-8b21-884fe4851da3"],
 " (check GS-10)."
}], "Text",ExpressionUUID->"451cb5b9-a876-44cf-883b-0cb0526d07e2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"rk4", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{"Abs", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", " ", "-", " ", 
       RowBox[{
        RowBox[{"x", "^", "2"}], "/", "2"}], " ", "+", " ", 
       RowBox[{
        RowBox[{"x", "^", "4"}], "/", "24"}]}], ")"}], " ", "+", " ", 
     RowBox[{"I", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "x"}], " ", "+", " ", 
        RowBox[{
         RowBox[{"x", "^", "3"}], "/", "6"}]}], ")"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"stableOk", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"rk4", "[", "2.5", "]"}], " ", "<=", " ", "1"}], " ", "&&", " ", 
    
    RowBox[{
     RowBox[{"rk4", "[", 
      RowBox[{"2", " ", 
       RowBox[{"Sqrt", "[", "2.", "]"}]}], "]"}], " ", "<=", " ", 
     RowBox[{"1", " ", "+", " ", "1*^-12"}]}], " ", "&&", " ", 
    RowBox[{
     RowBox[{"rk4", "[", "2.9", "]"}], " ", ">", " ", "1"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"drift", " ", "=", " ", 
   RowBox[{"1", " ", "-", " ", 
    RowBox[{"rk4", "[", "0.1", "]"}]}]}], ";"}], "\n", 
 RowBox[{"SL31Check", "[", 
  RowBox[{"\"\<GS-13\>\"", ",", 
   " ", "\"\<time stepping: one RK4 step multiplies an eigencomponent by 1 - \
i x - x^2/2 + i x^3/6 + x^4/24, x = E dt; the modulus is at most 1 for |x| <= \
2 sqrt 2 and exceeds 1 beyond (x = 2.9); the decrease per step is about \
x^6/144\>\"", ",", "\n", "  ", 
   RowBox[{"stableOk", " ", "&&", " ", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"drift", " ", "-", " ", 
       RowBox[{
        RowBox[{"0.1", "^", "6"}], "/", "144"}]}], "]"}], " ", "<", " ", 
     "1*^-11"}]}], ",", "\n", "  ", 
   RowBox[{"Row", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<modulus at x = 2.5: \>\"", ",", " ", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{"rk4", "[", "2.5", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"7", ",", " ", "6"}], "}"}]}], "]"}], ",", 
      " ", "\"\<; at 2.9: \>\"", ",", " ", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{"rk4", "[", "2.9", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"7", ",", " ", "6"}], "}"}]}], "]"}], ",", 
      " ", "\"\<; loss at x = 0.1: \>\"", ",", " ", "drift", ",", 
      " ", "\"\< (original: 0.508186; 1.193063; 6.9e-9)\>\""}], "}"}], 
    "]"}]}], "]"}]}], "Input",
 CellLabel->
  "In[421]:=",ExpressionUUID->"ff66ed53-d480-4cac-9b06-f891679d2e0a"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   StyleBox["\<\"PASS  \"\>",
    StripOnInput->False,
    LineColor->RGBColor[0, 
      Rational[2, 3], 0],
    FrontFaceColor->RGBColor[0, 
      Rational[2, 3], 0],
    BackFaceColor->RGBColor[0, 
      Rational[2, 3], 0],
    GraphicsColor->RGBColor[0, 
      Rational[2, 3], 0],
    FontWeight->Bold,
    FontColor->RGBColor[0, 
      Rational[2, 3], 0]], "\[InvisibleSpace]", "\<\"GS-13\"\>", 
   "\[InvisibleSpace]", "\<\": \"\>", 
   "\[InvisibleSpace]", "\<\"time stepping: one RK4 step multiplies an \
eigencomponent by 1 - i x - x^2/2 + i x^3/6 + x^4/24, x = E dt; the modulus \
is at most 1 for |x| <= 2 sqrt 2 and exceeds 1 beyond (x = 2.9); the decrease \
per step is about x^6/144\"\>", "\[InvisibleSpace]", 
   TemplateBox[{"\"  -- \"", 
     TemplateBox[{"\"modulus at x = 2.5: \"", 
       TagBox[
        InterpretationBox[
         StyleBox["\"0.508186\"", ShowStringCharacters -> False], 
         0.508186294051508, AutoDelete -> True], NumberForm[#, {7, 6}]& ], 
       "\"; at 2.9: \"", 
       TagBox[
        InterpretationBox[
         StyleBox["\"1.193063\"", ShowStringCharacters -> False], 
         1.1930626741549684`, AutoDelete -> True], NumberForm[#, {7, 6}]& ], 
       "\"; loss at x = 0.1: \"", "6.935763852133903`*^-9", 
       "\" (original: 0.508186; 1.193063; 6.9e-9)\""}, "RowDefault"]},
    "RowDefault"]}],
  SequenceForm[
   Style["PASS  ", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0]], "GS-13", ": ", 
   "time stepping: one RK4 step multiplies an eigencomponent by 1 - i x - \
x^2/2 + i x^3/6 + x^4/24, x = E dt; the modulus is at most 1 for |x| <= 2 \
sqrt 2 and exceeds 1 beyond (x = 2.9); the decrease per step is about \
x^6/144", 
   Row[{"  -- ", 
     Row[{"modulus at x = 2.5: ", 
       NumberForm[0.508186294051508, {7, 6}], "; at 2.9: ", 
       NumberForm[1.1930626741549684`, {7, 6}], "; loss at x = 0.1: ", 
       6.935763852133903*^-9, " (original: 0.508186; 1.193063; 6.9e-9)"}]}]],
  Editable->False]], "Print",
 CellChangeTimes->{4.0039953160601387`*^9},
 CellLabel->
  "During evaluation of \
In[421]:=",ExpressionUUID->"00a06ed3-556d-48c1-9766-f32802881a3a"]
