                RowBox[{"(", 
                  SubsuperscriptBox[
                   StyleBox["t", FontSlant -> "Bold"], 
                   RowBox[{"LL", ",", 
                    StyleBox["p", "TI"]}], "A"], ")"}], "\[LongEqual]", "-", 
                StyleBox["i", "TI"], " ", 
                SubscriptBox[
                 StyleBox["a", FontSlant -> "Plain"], 
                 RowBox[{"LL", ",", 
                   StyleBox["p", "TI"]}]]}], TraditionalForm], 
             "\"; it acts on the spinor charges through the isospin \
derivation \"", 
             FormBox[
              SubsuperscriptBox[
               StyleBox["D", "TI"], "LL", "v"], TraditionalForm]},
            "RowDefault"],
           StripOnInput->False,
           FontFamily->"Source Sans Pro",
