                FontFamily->"Times",
                FontSize->1.1 Inherited,ExpressionUUID->
                "d4363d6a-4246-453d-8b63-6cc4a75511aa"]
              }], "Text",
               FontFamily->"Source Sans Pro",
               FontSize->9.5,ExpressionUUID->
               "ceaac1cd-c78d-4d1c-a7b9-e530e85e6c32"],
              ImageSize->290]},
            {
