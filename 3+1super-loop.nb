       RowBox[{"maxdev13", "[", 
        RowBox[{"[", "1", "]"}], "]"}], " ", ">", " ", 
       RowBox[{"maxdev13", "[", 
        RowBox[{"[", "2", "]"}], "]"}], " ", ">", " ", 
       RowBox[{"maxdev13", "[", 
        RowBox[{"[", "3", "]"}], "]"}]}], " ", "&&", "\n", "   ", 
      RowBox[{
       RowBox[{"maxdev13", "[", 
        RowBox[{"[", "3", "]"}], "]"}], " ", "<", " ", "1*^-9"}], " ", "&&", 
      " ", 
      RowBox[{
       RowBox[{"normChange13", "[", 
        RowBox[{"[", "3", "]"}], "]"}], " ", "<", " ", "1*^-10"}]}], ",", 
     "\n", "  ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<for rtol = 1e-8, 1e-10, 1e-12: largest \
local_error/budget_step \>\"", ",", " ", 
        RowBox[{"sci13", "[", "ratio13", "]"}], ",", 
        " ", "\"\<; largest relative deviations \>\"", ",", " ", 
        RowBox[{"sci13", "[", "maxdev13", "]"}], ",", 
        " ", "\"\< <= budget_out \>\"", ",", " ", 
        RowBox[{"sci13", "[", "bout13", "]"}], ",", "\n", 
        "    ", "\"\< (budget \>\"", ",", " ", 
        RowBox[{"sci13", "[", "berr13", "]"}], ",", 
        " ", "\"\<); largest norm changes \>\"", ",", " ", 
        RowBox[{"sci13", "[", "normChange13", "]"}], ",", 
        " ", "\"\<; N_steps \>\"", ",", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"steps13", ",", " ", "\"\<, \>\""}], "]"}], ",", 
        " ", "\"\<; N_evals \>\"", ",", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"evals13", ",", " ", "\"\<, \>\""}], "]"}], ",", 
        " ", "\"\<; largest h_IDA \>\"", ",", " ", 
        RowBox[{"sci13", "[", "hmax13", "]"}], ",", "\n", 
        "    ", "\"\<; largest deriv_residual \>\"", ",", " ", 
        RowBox[{"sci13", "[", "resid13", "]"}], ",", 
        " ", "\"\<; Hermite polynomials within \>\"", ",", " ", 
        RowBox[{"sci13", "[", "hermite13", "]"}], ",", " ", "\"\<; E_max \>\"",
         ",", " ", 
        RowBox[{"NumberForm", "[", 
         RowBox[{"eMax13", ",", " ", 
          RowBox[{"{", 
           RowBox[{"6", ",", " ", "4"}], "}"}]}], "]"}], ",", 
        " ", "\"\<; computing time \>\"", ",", " ", 
        RowBox[{"Round", "[", 
         RowBox[{"time13", ",", " ", "0.1"}], "]"}], ",", "\n", 
        "    ", "\"\< s (original program, CVODE: largest relative deviations \
1.2e-6, 1.7e-7, 1.7e-10, budgets 2.6e-5, 6.2e-7, 6.4e-9, norm changes 5.2e-7, \
9.8e-8, 5.9e-11, steps 1528, 3661, 3804)\>\""}], "}"}], "]"}]}], 
    "]"}]}]}]], "Input",
