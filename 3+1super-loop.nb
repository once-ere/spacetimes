            FontFamily->"Times",
            FontSize->1.1 Inherited,ExpressionUUID->
            "baea9087-c9f6-4d06-b9df-107d144c58d6"],
           " (plain text ",
           StyleBox["M_W_time",
            FontFamily->"Source Code Pro"],
           ", ",
           StyleBox["M_F_time",
            FontFamily->"Source Code Pro"],
