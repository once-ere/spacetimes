                    FontWeight->"Bold",
                    FontSlant->"Plain"], ",", 
                    StyleBox["z",
                    FontWeight->"Bold",
                    FontSlant->"Plain"]}], ")"}], "\[LongEqual]", 
                  RowBox[{"[", 
