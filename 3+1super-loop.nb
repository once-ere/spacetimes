                    SubsuperscriptBox[
                    StyleBox["m", "TI"], "LL", "2"], "+", 
                    SubsuperscriptBox["\[CapitalDelta]", "LL", "2"]}], ")"}], 
                "+", 
                RowBox[{"(", 
                  RowBox[{
                    StyleBox["d", "TI"], 
                    SubscriptBox["\[CapitalDelta]", "LL"], "/", 
                    StyleBox["d", "TI"], 
                    SubsuperscriptBox[
                    StyleBox["x", "TI"], "LL", "1"]}], ")"}], " ", 
                SubsuperscriptBox[
                 StyleBox["Q", FontSlant -> "Plain"], "LL", "K"]}], 
              TraditionalForm], "\"; and the number \"", 
             FormBox[
              RowBox[{
                SubsuperscriptBox[
                 StyleBox["k", "TI"], "LL", "K"], "\[LongEqual]", "0", ",", 
