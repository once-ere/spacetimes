       RowBox[{"2", " ", 
        RowBox[{"l", "/", "z_m"}]}], ")"}]}], ";", " ", 
     RowBox[{"time", " ", "pi", " ", 
      RowBox[{"l", "/", "2"}]}], ";", " ", 
     RowBox[{"Y", " ", "=", " ", 
      RowBox[{"sinh", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"kappa", "^", 
           RowBox[{"(", 
            RowBox[{"1", "/", "2"}], ")"}]}], " ", "t"}], ")"}], "/", 
        RowBox[{"kappa", "^", 
         RowBox[{"(", 
          RowBox[{"1", "/", "2"}], ")"}]}]}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"ell", " ", "=", " ", 
     RowBox[{"1", "/", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"2", " ", "kk"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"j0t", " ", "=", " ", 
     RowBox[{
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{"1", " ", "-", " ", 
          RowBox[{"s", "^", "2"}]}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"s", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}], " ", 
      "ell"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"antiT", " ", "=", " ", 
     RowBox[{"-", 
      RowBox[{"Log", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", " ", "+", " ", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"1", " ", "-", " ", 
            RowBox[{"s", "^", "2"}]}], "]"}]}], ")"}], "/", "s"}], "]"}]}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"okAT", " ", "=", " ", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"antiT", ",", " ", "s"}], "]"}], " ", "-", " ", 
         RowBox[{"1", "/", 
          RowBox[{"(", 
           RowBox[{"s", " ", 
            RowBox[{"Sqrt", "[", 
             RowBox[{"1", " ", "-", " ", 
              RowBox[{"s", "^", "2"}]}], "]"}]}], ")"}]}]}], ",", " ", 
        RowBox[{"Assumptions", " ", "->", " ", 
         RowBox[{"0", " ", "<", " ", "s", " ", "<", " ", "1"}]}]}], "]"}], 
      " ", "===", " ", "0"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"limT", " ", "=", " ", 
     RowBox[{"Limit", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"antiT", " ", "/.", " ", 
          RowBox[{"s", " ", "->", " ", "1"}]}], ")"}], " ", "-", " ", 
        RowBox[{"(", 
         RowBox[{"antiT", " ", "/.", " ", 
          RowBox[{"s", " ", "->", " ", "um"}]}], ")"}], " ", "-", " ", 
        RowBox[{"Log", "[", 
         RowBox[{"2", "/", "um"}], "]"}]}], ",", " ", 
       RowBox[{"um", " ", "->", " ", "0"}], ",", " ", 
       RowBox[{"Direction", " ", "->", " ", "\"\<FromAbove\>\""}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"t2t", " ", "=", " ", 
     RowBox[{
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{"1", "/", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"1", " ", "-", " ", 
           RowBox[{"s", "^", "2"}]}], "]"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"s", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}], " ", 
      "ell"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"yy", "[", "t_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"Sinh", "[", 
       RowBox[{
        RowBox[{"Sqrt", "[", "kk", "]"}], " ", "t"}], "]"}], "/", 
      RowBox[{"Sqrt", "[", "kk", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"okY", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"yy", "''"}], "[", "t", "]"}], " ", "-", " ", 
         RowBox[{"kk", " ", 
          RowBox[{"yy", "[", "t", "]"}]}]}], "]"}], " ", "===", " ", "0"}], 
      " ", "&&", " ", 
      RowBox[{
       RowBox[{"Limit", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"yy", "[", "t", "]"}], "/", "t"}], ",", " ", 
         RowBox[{"t", " ", "->", " ", "0"}]}], "]"}], " ", "===", " ", 
       "1"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gamT", " ", "=", " ", 
     RowBox[{"2", " ", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "2"}], " ", "zm"}], "]"}], " ", 
      RowBox[{"zm", "^", "2"}], " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "2"}], " ", 
          RowBox[{"(", 
           RowBox[{"j0t", " ", "-", " ", "zm", " ", "-", " ", 
            RowBox[{"Log", "[", 
             RowBox[{"2", " ", 
              RowBox[{"ell", "/", "zm"}]}], "]"}]}], ")"}]}], "]"}], "/", 
        RowBox[{
         RowBox[{"yy", "[", "t2t", "]"}], "^", "2"}]}], "/", "Pi"}], " ", 
      RowBox[{"Pi", "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"yy", "'"}], "[", "t2t", "]"}], "/", 
         RowBox[{"yy", "[", "t2t", "]"}]}], ")"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"targetT", " ", "=", " ", 
     RowBox[{
      RowBox[{"8", "/", 
       RowBox[{"Sqrt", "[", "kk", "]"}]}], " ", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "Pi"}], "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", 
           RowBox[{"Sqrt", "[", 
            RowBox[{"2", " ", "kk"}], "]"}]}], ")"}]}], "]"}], "/", 
       RowBox[{"Sinh", "[", 
        RowBox[{"Pi", "/", 
         RowBox[{"Sqrt", "[", "2", "]"}]}], "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"okT", " ", "=", " ", 
     RowBox[{"okAT", " ", "&&", " ", 
      RowBox[{"limT", " ", "===", " ", "0"}], " ", "&&", " ", "okY", " ", "&&",
       " ", 
      RowBox[{
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"FullSimplify", "[", 
          RowBox[{
           RowBox[{"gamT", "/", "targetT"}], ",", " ", 
           RowBox[{"Assumptions", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"kk", " ", ">", " ", "0"}], ",", " ", 
              RowBox[{"zm", " ", ">", " ", "0"}]}], "}"}]}]}], "]"}], " ", "-",
          " ", "1"}], "]"}], " ", "===", " ", "0"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WT-4\>\"", ",", 
      " ", "\"\<(Python YT-5a, YT-5b) the method of the weak-field rate gives \
Landau's (4/F) exp(-2/(3F)) for a uniform field \\\nF and 8 kappa^(-1/2) \
exp(-pi/(2 (2 kappa)^(1/2)))/sinh(pi/2^(1/2)) for the tidal field (both \
exits)\>\"", ",", " ", 
      RowBox[{"okU", " ", "&&", " ", "okT"}], ",", "\n", "  ", 
      RowBox[{"\"\<uniform: \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"InputForm", "[", "gamU", "]"}], "]"}], " ", "<>", 
       " ", "\"\< (antiderivative \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", "okAU", "]"}], " ", "<>", 
       " ", "\"\<, logarithm \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", "limU", "]"}], " ", "<>", "\n", 
       "   ", "\"\<); tidal: ratio to the formula \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"InputForm", "[", 
         RowBox[{"FullSimplify", "[", 
          RowBox[{
           RowBox[{"gamT", "/", "targetT"}], ",", " ", 
           RowBox[{"Assumptions", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"kk", " ", ">", " ", "0"}], ",", " ", 
              RowBox[{"zm", " ", ">", " ", "0"}]}], "}"}]}]}], "]"}], "]"}], 
        "]"}], " ", "<>", "\n", "   ", "\"\< (antiderivative \>\"", " ", "<>",
        " ", 
       RowBox[{"ToString", "[", "okAT", "]"}], " ", "<>", 
       " ", "\"\<, logarithm \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", "limT", "]"}], " ", "<>", 
       " ", "\"\<, Jacobi \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", "okY", "]"}], " ", "<>", " ", "\"\<)\>\""}]}],
      "]"}], ";"}]}]}]], "Input",
 CellLabel->
  "In[438]:=",ExpressionUUID->"8a267e96-6d35-4341-bcd7-0974c35b5d95"],

Cell[BoxData["\<\"PASS WT-4     (Python YT-5a, YT-5b) the method of the \
weak-field rate gives Landau's (4/F) exp(-2/(3F)) for a uniform field F and 8 \
kappa^(-1/2) exp(-pi/(2 (2 kappa)^(1/2)))/sinh(pi/2^(1/2)) for the tidal \
field (both exits) [uniform: 4/(E^(2/(3*F))*F) (antiderivative True, \
logarithm 0); tidal: ratio to the formula 1 (antiderivative True, logarithm \
0, Jacobi True)]\"\>"], "Print",
 CellChangeTimes->{4.004398283494584*^9},
 CellLabel->
  "During evaluation of \
In[438]:=",ExpressionUUID->"7f6a9f69-59e4-4273-b3ea-86999cf0e92e"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["WT-5: classical motion in the growing field", "Section",ExpressionUUID->"b2560681-a202-486f-ba20-6a256e198082"],

Cell[TextData[{
 "Along the fall the tidal strength grows as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Kappa]", 
     StyleBox["LG",
      FontSlant->"Plain"], 
     StyleBox["tid",
      FontSlant->"Plain"]], "\[LongEqual]", "2", "/", 
    RowBox[{"(", 
     RowBox[{"9", 
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox[
         StyleBox["T", "TI"], 
         StyleBox["LG",
          FontSlant->"Plain"], 
         StyleBox["fall",
          FontSlant->"Plain"]], ")"}], "2"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "27e07478-23ab-4f0e-962f-d9072b4f7652"],
 ". The classical equations of the relative motion along and across the \
radius, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["z", "TI"], "\[Prime]\[Prime]"], "\[LongEqual]", "2", 
    SubsuperscriptBox["\[Kappa]", 
     StyleBox["LG",
      FontSlant->"Plain"], 
     StyleBox["tid",
      FontSlant->"Plain"]], 
    StyleBox["z", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b6e41c29-cb47-4b5a-9dfd-2aa28a9d42ea"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["x", "TI"], "\[Prime]\[Prime]"], "\[LongEqual]", 
    RowBox[{"-", 
     SubsuperscriptBox["\[Kappa]", 
      StyleBox["LG",
       FontSlant->"Plain"], 
      StyleBox["tid",
       FontSlant->"Plain"]]}], 
    StyleBox["x", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b2796543-6e05-4342-bb61-1b176f3bfe14"],
 ", then have power-law solutions: ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["T", "TI"], 
    RowBox[{"4", "/", "3"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6a251d66-cd6d-49c4-8fce-e43e97f8e3c3"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["T", "TI"], 
    RowBox[{
     RowBox[{"-", "1"}], "/", "3"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6ddb1563-4f08-44ef-859c-c6f216ddd277"],
 " along, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["T", "TI"], 
    RowBox[{"2", "/", "3"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2d7e15a0-e401-4584-9eb5-586c877d6831"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["T", "TI"], 
    RowBox[{"1", "/", "3"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8c8bc8cb-7b9f-4d8e-89e0-044c3e6e4be3"],
 " across (with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["LG",
      FontSlant->"Plain"], 
     StyleBox["fall",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1d62dfd2-ef76-4f3c-bcd2-686db1f5dceb"],
 "). The check lets ",
 StyleBox["DSolve",
  FontFamily->"Source Code Pro"],
 " find them and compares the solutions with given initial values with the \
closed forms of the Rust program, which uses them to test its integration."
}], "Text",ExpressionUUID->"738726af-f404-4558-8a4a-2744fcc69ea7"],

