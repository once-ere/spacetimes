}]}]}]}]}]}], "-", "6"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"aa", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "a01", ",", " ", "a02", ",", " ", "a03"}], 
        "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "a01"}], ",", " ", "0", ",", " ", "a12", ",", " ", 
         "a13"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "a02"}], ",", " ", 
         RowBox[{"-", "a12"}], ",", " ", "0", ",", " ", "a23"}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "a03"}], ",", " ", 
         RowBox[{"-", "a13"}], ",", " ", 
         RowBox[{"-", "a23"}], ",", " ", "0"}], "}"}]}], "}"}]}], ";"}], "  ", 
   RowBox[{"(*", " ", 
    RowBox[{"a_", 
     RowBox[{"{", "bc", "}"}], " ", "of", " ", "one", " ", "a"}], " ", "*)"}],
    "\n", 
   RowBox[{
    RowBox[{"gUp", " ", "=", " ", "gm"}], ";"}], 
   "                                                               ", 
   RowBox[{"(*", " ", 
    RowBox[{"constant", " ", 
     RowBox[{"gamma", "^", 
      RowBox[{"a", ":", " ", 
       RowBox[{"the", " ", "special", " ", "gauge"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"gLo", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"eta", "[", 
         RowBox[{"[", 
          RowBox[{"b", ",", " ", "b"}], "]"}], "]"}], " ", 
        RowBox[{"gUp", "[", 
         RowBox[{"[", "b", "]"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"b", ",", " ", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gConn", " ", "=", " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"gg", "/", "2"}], " ", 
        RowBox[{"aa", "[", 
         RowBox[{"[", 
          RowBox[{"b", ",", " ", "c"}], "]"}], "]"}], " ", 
        RowBox[{"gmn", "[", 
         RowBox[{"gUp", ",", " ", "b", ",", " ", "c"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"b", ",", " ", "4"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"c", ",", " ", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"cSol", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"Tr", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"-", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"gConn", " ", ".", " ", 
                RowBox[{"gLo", "[", 
                 RowBox[{"[", "b", "]"}], "]"}]}], " ", "-", " ", 
               RowBox[{
                RowBox[{"gLo", "[", 
                 RowBox[{"[", "b", "]"}], "]"}], " ", ".", " ", "gConn"}]}], 
              ")"}]}], ")"}], " ", ".", " ", 
           RowBox[{"gUp", "[", 
            RowBox[{"[", "e", "]"}], "]"}]}], "]"}], "/", "4"}], "]"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"b", ",", " ", "4"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"e", ",", " ", "4"}], "}"}]}], "]"}]}], ";"}], "   ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"C_b", "^", "e"}], " ", "of", " ", 
      RowBox[{"(", "4.19", ")"}]}], ",", " ", 
     RowBox[{
      RowBox[{"d", " ", "gamma"}], " ", "=", " ", "0"}]}], " ", "*)"}], "\n", 
   
   RowBox[{
    RowBox[{"ok6", " ", "=", " ", 
     RowBox[{"zeroQ", "[", 
      RowBox[{"cSol", " ", "-", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"2", " ", "gg", " ", 
          RowBox[{"aa", "[", 
           RowBox[{"[", 
            RowBox[{"b", ",", " ", "e"}], "]"}], "]"}], " ", 
          RowBox[{"eta", "[", 
           RowBox[{"[", 
            RowBox[{"e", ",", " ", "e"}], "]"}], "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"b", ",", " ", "4"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"e", ",", " ", "4"}], "}"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"okSpan", " ", "=", " ", 
     RowBox[{"And", " ", "@@", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"zeroQ", "[", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"gConn", " ", ".", " ", 
              RowBox[{"gLo", "[", 
               RowBox[{"[", "b", "]"}], "]"}]}], " ", "-", " ", 
             RowBox[{
              RowBox[{"gLo", "[", 
               RowBox[{"[", "b", "]"}], "]"}], " ", ".", " ", "gConn"}]}], 
            ")"}]}], " ", "-", " ", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"cSol", "[", 
              RowBox[{"[", 
               RowBox[{"b", ",", " ", "e"}], "]"}], "]"}], " ", 
             RowBox[{"gLo", "[", 
              RowBox[{"[", "e", "]"}], "]"}]}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"e", ",", " ", "4"}], "}"}]}], "]"}]}], "]"}], ",", " ", 
        
        RowBox[{"{", 
         RowBox[{"b", ",", " ", "4"}], "}"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WL-6\>\"", ",", 
      " ", "\"\<(Rust L4-6b, L4-6c; Python YL-6, YL-6b) in Lord's special \
gauge (constant gamma, (5.2)): for Gamma = 1/2 g \\\na_bc gamma^{bc} with six \
symbolic a_bc, [Gamma, gamma_b] = -2 g a_b^e gamma_e, so (4.19) gives C_b^e = \
2 g a_b^e: \\\ntwice the printed (4.20) and (5.2), C = g a\>\"", ",", " ", 
      RowBox[{"ok6", " ", "&&", " ", "okSpan"}], ",", " ", 
      RowBox[{"\"\<C = 2 g a: \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", "ok6", "]"}], " ", "<>", 
       " ", "\"\<, in the span of gamma_e: \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", "okSpan", "]"}]}]}], "]"}], 
    ";"}]}]}]], "Input",
 CellLabel->"In[59]:=",ExpressionUUID->"9af74979-bb4b-4962-b2ce-34e08827e9be"],

Cell[BoxData["\<\"PASS WL-6     (Rust L4-6b, L4-6c; Python YL-6, YL-6b) in \
Lord's special gauge (constant gamma, (5.2)): for Gamma = 1/2 g a_bc \
gamma^{bc} with six symbolic a_bc, [Gamma, gamma_b] = -2 g a_b^e gamma_e, so \
(4.19) gives C_b^e = 2 g a_b^e: twice the printed (4.20) and (5.2), C = g a \
[C = 2 g a: True, in the span of gamma_e: True]\"\>"], "Print",
 CellChangeTimes->{4.0043982467376127`*^9},
