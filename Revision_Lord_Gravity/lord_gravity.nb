          RowBox[{"n", ",", " ", "4"}], "}"}]}], "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"r117", " ", "=", " ", 
     RowBox[{"And", " ", "@@", " ", 
      RowBox[{"Flatten", "@", 
       RowBox[{"Table", "[", "\n", "     ", 
        RowBox[{
         RowBox[{"With", "[", 
