         RowBox[{"x", ",", " ", 
          RowBox[{"-", "1"}], ",", " ", "1"}], "}"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rho0", " ", "=", " ", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "2"}], " ", "r"}], "]"}], "/", "Pi"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"e2", " ", "=", " ", 
