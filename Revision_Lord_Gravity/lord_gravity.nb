            RowBox[{"gam", "[", 
             RowBox[{"[", "4", "]"}], "]"}]}]}], " ", "+", " ", 
          RowBox[{
           RowBox[{"Cos", "[", "th", "]"}], " ", 
           RowBox[{
            RowBox[{"gam", "[", 
             RowBox[{"[", "3", "]"}], "]"}], " ", ".", " ", 
            RowBox[{"gam", "[", 
             RowBox[{"[", "4", "]"}], "]"}]}]}]}], ")"}], "/", "2"}]}], 
      "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"okOmS", " ", "=", " ", 
     RowBox[{"zeroQ", "[", 
      RowBox[{
       RowBox[{"geoS", "[", "\"\<spc\>\"", "]"}], " ", "-", " ", "omegaS"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"okNgS", " ", "=", " ", 
     RowBox[{"zeroQ", "[", 
      RowBox[{"nablaGamma", "[", "geoS", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "spinor", " ", "curvature", " ", "for", " ", "the", " ", 
      "general", " ", "static"}], ",", " ", 
     RowBox[{"spherically", " ", "symmetric", " ", "tetrad", " ", "diag", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"h", 
         RowBox[{"(", "r", ")"}]}], ",", " ", 
        RowBox[{
         RowBox[{"1", "/", "h"}], 
         RowBox[{"(", "r", ")"}]}], ",", " ", "r", ",", " ", 
        RowBox[{"r", " ", "sin", " ", "th"}]}], ")"}], " ", "with", " ", "a", 
      "\n", "   ", "symbolic", " ", "function", " ", "h"}], ",", " ", 
     RowBox[{"which", " ", "contains", " ", "Schwarzschild", " ", 
      RowBox[{"(", 
       RowBox[{"h", " ", "=", " ", 
        RowBox[{"f", "^", 
         RowBox[{"{", 
          RowBox[{"1", "/", "2"}], "}"}]}]}], ")"}], " ", "and", " ", 
      "avoids", " ", "the", " ", "square", " ", "roots", " ", "that", " ", 
      "Simplify", " ", "does", " ", "not", " ", "always", "\n", "   ", 
      "remove"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"geoSh", " ", "=", " ", 
     RowBox[{"geometry", "[", 
      RowBox[{
       RowBox[{"DiagonalMatrix", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"hS", "[", "r", "]"}], ",", " ", 
          RowBox[{"1", "/", 
           RowBox[{"hS", "[", "r", "]"}]}], ",", " ", "r", ",", " ", 
          RowBox[{"r", " ", 
           RowBox[{"Sin", "[", "th", "]"}]}]}], "}"}], "]"}], ",", " ", "XS", 
       ",", " ", "Simplify"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"riemSh", " ", "=", " ", 
     RowBox[{"riemann", "[", 
      RowBox[{
       RowBox[{"geoSh", "[", "\"\<chr\>\"", "]"}], ",", " ", "XS", ",", " ", 
       "Simplify"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"okCurvS", " ", "=", " ", 
     RowBox[{"zeroQ", "[", 
      RowBox[{"spinCurvDev", "[", 
       RowBox[{"geoSh", ",", " ", "riemSh"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WG-1\>\"", ",", 
      " ", "\"\<(Rust G-4 to G-9; Python YG-2, YG-3) Schwarzschild, f = 1 - \
2M/r, coframe e^0 = f^{1/2} dt, e^1 = \\\nf^{-1/2} dr, e^2 = r dth, e^3 = r \
sin(th) dph: Ricci tensor zero; Kretschmann invariant 48 M^2/r^6; Omega_t = \
M/(2 r^2) \\\ngamma^0 gamma^1, Omega_r = 0, Omega_th = 1/2 f^{1/2} gamma^1 \
gamma^2, Omega_ph = 1/2 (f^{1/2} sin(th) gamma^1 gamma^3 + \\\ncos(th) \
gamma^2 gamma^3); d_mu gamma^nu + Gamma^nu_{mu la} gamma^la + [Omega_mu, \
gamma^nu] = 0; spinor curvature = 1/4 \\\nR_{ab mu nu} gamma^{ab} (for every \
static, spherically symmetric tetrad diag(h(r), 1/h(r), r, r sin th) with a \
symbolic \\\nfunction h)\>\"", ",", " ", 
      RowBox[{
      "okRicS", " ", "&&", " ", "okKretS", " ", "&&", " ", "okOmS", " ", "&&",
        " ", "okNgS", " ", "&&", " ", "okCurvS"}], ",", "\n", "  ", 
      RowBox[{"\"\<Ricci 0 \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", "okRicS", "]"}], " ", "<>", 
       " ", "\"\<, Kretschmann \>\"", " ", "<>", " ", 
