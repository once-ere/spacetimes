        RowBox[{"uDot", " ", "-", " ", 
         RowBox[{"I", " ", "vDot"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"2", " ", "aa"}], ")"}]}], " ", "+", " ", 
      RowBox[{"I", " ", "om", " ", "tDot", " ", "pV"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dqV", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", "dWdr"}], "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", 
          RowBox[{"bb", "^", "3"}]}], ")"}]}], " ", "bRv"}], " ", "+", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"uDot", " ", "+", " ", 
         RowBox[{"I", " ", "vDot"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"2", " ", "bb"}], ")"}]}], " ", "+", " ", 
      RowBox[{"I", " ", "om", " ", "tDot", " ", "qV"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rel1", " ", "=", " ", 
     RowBox[{"dpV", " ", "-", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"I", " ", "om"}], " ", "-", " ", 
            RowBox[{"sW", "/", 
             RowBox[{"(", 
              RowBox[{"4", " ", "rW"}], ")"}]}]}], ")"}], " ", "pV"}], " ", "-",
          " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"I", " ", 
             RowBox[{"lam", "/", "rW"}]}], " ", "+", " ", "mB"}], ")"}], " ", 
          "qV"}]}], ")"}], "/", 
       RowBox[{"aa", "^", "2"}]}]}]}], ";"}], "                ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"1", " ", "-", " ", "W"}], " ", "=", " ", 
     RowBox[{"a", "^", "2"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"rel2", " ", "=", " ", 
     RowBox[{"dqV", " ", "-", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"I", " ", 
             RowBox[{"lam", "/", "rW"}]}], " ", "-", " ", "mB"}], ")"}], " ", 
          "pV"}], " ", "+", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "I"}], " ", "om"}], " ", "+", " ", 
            RowBox[{"sW", "/", 
             RowBox[{"(", 
              RowBox[{"4", " ", "rW"}], ")"}]}]}], ")"}], " ", "qV"}]}], 
        ")"}], "/", 
       RowBox[{"bb", "^", "2"}]}]}]}], ";"}], "               ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"1", " ", "+", " ", "W"}], " ", "=", " ", 
     RowBox[{"b", "^", "2"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"relRem", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Expand", "[", 
        RowBox[{
         RowBox[{"PolynomialReduce", "[", 
          RowBox[{
           RowBox[{"Expand", "[", 
            RowBox[{"Numerator", "[", 
             RowBox[{"Together", "[", "e", "]"}], "]"}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"bb", "^", "2"}], " ", "-", " ", "2", " ", "+", " ", 
             RowBox[{"aa", "^", "2"}]}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"bb", ",", " ", "aa"}], "}"}]}], "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"e", ",", " ", 
         RowBox[{"{", 
          RowBox[{"rel1", ",", " ", "rel2"}], "}"}]}], "}"}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WS-3\>\"", ",", 
      " ", "\"\<(Rust LS-3; Python YS-3) the two separations describe the \
same field: if (u, w) solve (S), then P = \\\n(1 - W)^(-1/2) a_R e^{i omega \
(tau - t)} and Q = (1 + W)^(-1/2) b_R e^{i omega (tau - t)}, with d(tau - \
t)/dr = W/f, solve \\\n(PG) exactly outside the horizon (the identity written \
as rational functions of a = (1 - W)^(1/2), b = (1 + W)^(1/2), the \\\n\
numerators reduced modulo a^2 + b^2 = 2)\>\"", ",", " ", 
      RowBox[{"relRem", " ", "===", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0"}], "}"}]}], ",", " ", 
      RowBox[{"\"\<remainders \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"InputForm", "[", "relRem", "]"}], "]"}]}]}], "]"}], 
    ";"}]}]}]], "Input",
 CellLabel->
  "In[237]:=",ExpressionUUID->"055310ce-2623-4290-8fe2-1420973d579d"],

Cell[BoxData["\<\"PASS WS-3     (Rust LS-3; Python YS-3) the two separations \
describe the same field: if (u, w) solve (S), then P = (1 - W)^(-1/2) a_R \
e^{i omega (tau - t)} and Q = (1 + W)^(-1/2) b_R e^{i omega (tau - t)}, with \
d(tau - t)/dr = W/f, solve (PG) exactly outside the horizon (the identity \
written as rational functions of a = (1 - W)^(1/2), b = (1 + W)^(1/2), the \
numerators reduced modulo a^2 + b^2 = 2) [remainders {0, 0}]\"\>"], "Print",
 CellChangeTimes->{4.0043982479691267`*^9},
 CellLabel->
  "During evaluation of \
In[237]:=",ExpressionUUID->"a2cfa527-439a-4ee6-a8d7-5fe28ac001f6"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["WS-4: how the field behaves at the horizon and at the centre", "Section",ExpressionUUID->"6fe58436-df3d-4222-8d0b-1e276923dfcf"],

Cell[TextData[{
 "Near a point where the coefficients of a linear system blow up like ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["r", "TI"], "-", 
      SubscriptBox[
       StyleBox["r", "TI"], "0"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3a785def-f772-4ad3-8e36-1a8d3d0b0f0f"],
 ", the solutions behave like powers ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      StyleBox["r", "TI"], "-", 
      SubscriptBox[
       StyleBox["r", "TI"], "0"]}], ")"}], 
    StyleBox["s", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bc1d7375-0fc8-49a5-aaf6-18a4153a065f"],
 ", and the exponents ",
 Cell[BoxData[
  FormBox[
   StyleBox["s", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "206d3bde-1f7d-45b2-9008-78066300ba35"],
 " are the eigenvalues of the residue matrix (the coefficient of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["r", "TI"], "-", 
      SubscriptBox[
       StyleBox["r", "TI"], "0"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "22109dad-ebd7-40b0-998e-568629ebb15f"],
 "). At the horizon the exponents of (18.5) are ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9114634a-068b-4161-805d-f99586b54c30"],
 ", the solution that is smooth there and falls in, and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"4", 
    StyleBox["i", "TI"], 
    SubsuperscriptBox["\[Omega]", 
     StyleBox["LG",
      FontSlant->"Plain"], 
     StyleBox["S",
      FontSlant->"Plain"]], "-", 
    FractionBox["1", "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8de8c462-47b1-4cc7-bd25-954110960c97"],
 ", a solution that oscillates infinitely often and would come out of the \
black hole; the physical boundary condition keeps the first. At ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0c2d55c9-890d-4933-a64d-41ce9511dae9"],
 " both exponents are ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "4"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8bce447d-78b2-4823-b405-0c88a54033d1"],
 ", so both solutions behave as ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["r", "TI"], 
    RowBox[{"1", "/", "4"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "637340a0-55bd-4c18-8275-3fc6b27a14d7"],
 "."
}], "Text",ExpressionUUID->"c8145b02-3445-4578-ae36-120ac9363f2c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", 
          RowBox[{"--", 
           RowBox[{"--", 
            RowBox[{"--", 
             RowBox[{"--", 
              RowBox[{"--", 
               RowBox[{"--", 
                RowBox[{"--", 
                 RowBox[{"--", 
                  RowBox[{"--", 
                   RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{
                    "--", " ", 
                    "WS"}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]\
}]}]}]}]}]}], "-", "4"}], ":", " ", 
    RowBox[{"the", " ", "exponents"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"aPG", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"I", " ", "om"}], " ", "-", " ", 
            RowBox[{"wPG", "/", 
             RowBox[{"(", 
              RowBox[{"4", " ", "r"}], ")"}]}]}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"1", " ", "-", " ", "wPG"}], ")"}]}], ",", " ", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"I", " ", 
              RowBox[{"lam", "/", "r"}]}], " ", "+", " ", "mB"}], ")"}]}], "/", 
          RowBox[{"(", 
           RowBox[{"1", " ", "-", " ", "wPG"}], ")"}]}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"I", " ", 
             RowBox[{"lam", "/", "r"}]}], " ", "-", " ", "mB"}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"1", " ", "+", " ", "wPG"}], ")"}]}], ",", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "I"}], " ", "om"}], " ", "+", " ", 
            RowBox[{"wPG", "/", 
             RowBox[{"(", 
              RowBox[{"4", " ", "r"}], ")"}]}]}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"1", " ", "+", " ", "wPG"}], ")"}]}]}], "}"}]}], "}"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"resH", " ", "=", " ", 
     RowBox[{"Simplify", "[", 
      RowBox[{"Limit", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"r", " ", "-", " ", "2"}], ")"}], " ", "aPG"}], ",", " ", 
        RowBox[{"r", " ", "->", " ", "2"}]}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"res0", " ", "=", " ", 
     RowBox[{"Simplify", "[", 
      RowBox[{"Limit", "[", 
       RowBox[{
        RowBox[{"r", " ", "aPG"}], ",", " ", 
        RowBox[{"r", " ", "->", " ", "0"}], ",", " ", 
        RowBox[{"Direction", " ", "->", " ", "\"\<FromAbove\>\""}]}], "]"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"evH", " ", "=", " ", 
     RowBox[{"Simplify", "[", 
      RowBox[{"Eigenvalues", "[", "resH", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"okH", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", "evH", "]"}], " ", "==", " ", "2"}], " ", "&&", 
      " ", 
      RowBox[{"AnyTrue", "[", 
       RowBox[{"evH", ",", " ", 
        RowBox[{
         RowBox[{"TrueQ", "[", 
          RowBox[{
           RowBox[{"Simplify", "[", "#", "]"}], " ", "==", " ", "0"}], "]"}], 
         " ", "&"}]}], "]"}], " ", "&&", "\n", "   ", 
      RowBox[{"AnyTrue", "[", 
       RowBox[{"evH", ",", " ", 
        RowBox[{
         RowBox[{"TrueQ", "[", 
          RowBox[{
           RowBox[{"Simplify", "[", 
            RowBox[{"#", " ", "-", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"4", " ", "I", " ", "om"}], " ", "-", " ", 
               RowBox[{"1", "/", "2"}]}], ")"}]}], "]"}], " ", "==", " ", 
           "0"}], "]"}], " ", "&"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ok0", " ", "=", " ", 
     RowBox[{"zeroQ", "[", 
      RowBox[{"res0", " ", "-", " ", 
       RowBox[{
        RowBox[{"IdentityMatrix", "[", "2", "]"}], "/", "4"}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WS-4\>\"", ",", 
      " ", "\"\<(Rust LS-4, LS-4b, LS-6; Python YS-4) the exponents: the \
residue matrix lim (r - 2) A(r) of (PG) at the \\\nhorizon has the \
eigenvalues 0 (the solution analytic at r = 2, which falls in) and 4 i omega \
- 1/2 (the solution that comes \\\nout); lim r A(r) at r = 0 is 1/4 times the \
unit matrix (both solutions behave as r^(1/4))\>\"", ",", " ", 
      RowBox[{"okH", " ", "&&", " ", "ok0"}], ",", "\n", "  ", 
      RowBox[{"\"\<residue at r = 2: \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"InputForm", "[", "resH", "]"}], "]"}], " ", "<>", 
       " ", "\"\<, eigenvalues \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"InputForm", "[", "evH", "]"}], "]"}], " ", "<>", 
       " ", "\"\<; at r = 0: \>\"", " ", "<>", "\n", "   ", 
       RowBox[{"ToString", "[", 
        RowBox[{"InputForm", "[", "res0", "]"}], "]"}]}]}], "]"}], 
    ";"}]}]}]], "Input",
 CellLabel->
  "In[249]:=",ExpressionUUID->"b795ef1b-8969-4773-a589-1eb568b3dafe"],

Cell[BoxData["\<\"PASS WS-4     (Rust LS-4, LS-4b, LS-6; Python YS-4) the \
exponents: the residue matrix lim (r - 2) A(r) of (PG) at the horizon has the \
eigenvalues 0 (the solution analytic at r = 2, which falls in) and 4 i omega \
- 1/2 (the solution that comes out); lim r A(r) at r = 0 is 1/4 times the \
unit matrix (both solutions behave as r^(1/4)) [residue at r = 2: {{-1/2 + \
(4*I)*om, (-2*I)*lam - 4*mB}, {0, 0}}, eigenvalues {0, -1/2 + (4*I)*om}; at r \
= 0: {{1/4, 0}, {0, 1/4}}]\"\>"], "Print",
 CellChangeTimes->{4.004398248062096*^9},
 CellLabel->
  "During evaluation of \
In[249]:=",ExpressionUUID->"c2266ea2-5722-473e-91b9-7c940e184efe"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["WS-5 and WS-9: the radial current", "Section",ExpressionUUID->"e21b3866-fd96-4cfe-a70b-300181cf086d"],

Cell[TextData[{
 "The conserved charge of the Dirac field gives the radial current (19.2), ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["J", "TI"], 
     StyleBox["LG",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      SubscriptBox[
       StyleBox["w", "TI"], 
       StyleBox["LG",
        FontSlant->"Plain"]]}], ")"}], "|", 
    SubscriptBox[
     StyleBox["\[ScriptCapitalQ]",
      FontSlant->"Plain"], 
     StyleBox["LG",
      FontSlant->"Plain"]], 
    SuperscriptBox["|", "2"], "-", 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      SubscriptBox[
       StyleBox["w", "TI"], 
       StyleBox["LG",
        FontSlant->"Plain"]]}], ")"}], "|", 
    SubscriptBox[
     StyleBox["\[ScriptCapitalP]",
      FontSlant->"Plain"], 
     StyleBox["LG",
      FontSlant->"Plain"]], 
    SuperscriptBox["|", "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2c0d56db-bc2b-4fcb-b5cd-883e216d04b0"],
 ", the flux into a sphere. For a real frequency it does not depend on ",
 Cell[BoxData[
  FormBox[
   StyleBox["r", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e0ca6596-8a79-4812-93ca-0a4ec2e481b2"],
 " (WS-5): what flows in at infinity flows into the horizon. For a complex \
frequency ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Omega]", 
     StyleBox["LG",
      FontSlant->"Plain"], 
     StyleBox["S",
      FontSlant->"Plain"]], "\[LongEqual]", 
    StyleBox["a", "TI"], "+", 
    StyleBox["ib", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "17f6b524-0351-498f-aea7-967a700f9ede"],
 " it changes as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["J", "TI"], 
     StyleBox["LG",
      FontSlant->"Plain"]], "/", 
    StyleBox["dr", "TI"], "\[LongEqual]", "2", 
    StyleBox["b", "TI"], 
    RowBox[{"(", 
     RowBox[{"|", 
      SubscriptBox[
       StyleBox["\[ScriptCapitalP]",
        FontSlant->"Plain"], 
       StyleBox["LG",
        FontSlant->"Plain"]], 
      SuperscriptBox["|", "2"], "+", "|", 
      SubscriptBox[
       StyleBox["\[ScriptCapitalQ]",
        FontSlant->"Plain"], 
       StyleBox["LG",
        FontSlant->"Plain"]], 
      SuperscriptBox["|", "2"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9a122615-30d9-47ad-9fc5-78767c712abc"],
 " (WS-9). A quasi-bound state decays at infinity and has ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["J", "TI"], 
     StyleBox["LG",
      FontSlant->"Plain"]], "\[LongEqual]", "2"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "83bec306-b9b0-4afb-8875-38d9ea16cbbc"],
 " at the horizon (with the normalization ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["\[ScriptCapitalQ]",
      FontSlant->"Plain"], 
     StyleBox["LG",
      FontSlant->"Plain"]], 
    RowBox[{"(", "2", ")"}], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3f63419b-5b24-40d8-8abf-4b09c761dbae"],
 "), so integrating gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Im",
     FontSlant->"Plain"], "\[ThinSpace]", 
    SubsuperscriptBox["\[Omega]", 
     StyleBox["LG",
      FontSlant->"Plain"], 
     StyleBox["S",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"-", "1"}], "/", 
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalN]",
      FontSlant->"Plain"], 
     StyleBox["LG",
      FontSlant->"Plain"], 
     StyleBox["S",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d2f171bc-f1a7-4eb9-8ae3-78eca1446b05"],
 ", with ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalN]",
     FontSlant->"Plain"], 
    StyleBox["LG",
     FontSlant->"Plain"], 
    StyleBox["S",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "681687c0-904e-43e0-8d6a-be77fbc41ee5"],
 " the integral of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    SubscriptBox[
     StyleBox["\[ScriptCapitalP]",
      FontSlant->"Plain"], 
     StyleBox["LG",
      FontSlant->"Plain"]], 
    SuperscriptBox["|", "2"], "+", "|", 
    SubscriptBox[
     StyleBox["\[ScriptCapitalQ]",
      FontSlant->"Plain"], 
     StyleBox["LG",
      FontSlant->"Plain"]], 
    SuperscriptBox["|", "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a8cf40f5-26ab-4808-87e1-71fab73e88a2"],
 " outside the horizon (20.3): the decay rate of a state is fixed by how much \
of it lies outside the black hole. In the code the complex conjugates are \
independent functions ",
 StyleBox["pB",
  FontFamily->"Source Code Pro"],
 ", ",
 StyleBox["qB",
  FontFamily->"Source Code Pro"],
 " that obey the conjugate system, and ",
 StyleBox["aw",
  FontFamily->"Source Code Pro"],
 ", ",
 StyleBox["bw",
  FontFamily->"Source Code Pro"],
 " are the real and the imaginary part of the frequency."
}], "Text",ExpressionUUID->"1c2be643-560d-4830-8774-559854cffed6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
