       RowBox[{
        RowBox[{"-", 
         RowBox[{"g", ".", "p"}]}], " ", "B"}]}], "}"}]}], ";", " ", 
    RowBox[{"C", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"P", " ", 
        RowBox[{"B", "^"}], "*"}], ",", " ", 
       RowBox[{"P", " ", 
        RowBox[{"A", "^"}], "*"}]}], "}"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"uvec", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"x", "[", "k", "]"}], " ", "+", " ", 
        RowBox[{"I", " ", 
         RowBox[{"y", "[", "k", "]"}]}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", "8"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"pv", " ", "=", " ", 
     RowBox[{"{", 
