Cell[BoxData["\<\"PASS WP-1     (Python YP-2; Rust LP-1) the coefficients of \
m alpha^4 of all 18 states with n <= 3, without and with the annihilation \
term, computed with the radial functions of the Wolfram Language and exact \
integration, equal the rational numbers of data/lg_pair_levels.csv [1^1S0 \
-21/64 / -21/64; 1^3S1 1/192 / 49/192; 2^1S0 -53/1024 / -53/1024; 2^3S1 \
-31/3072 / 65/3072; 2^1P1 -31/3072 / -31/3072; 2^3P2 -43/15360 / -43/15360; \
2^3P1 -47/3072 / -47/3072; 2^3P0 -95/3072 / -95/3072; 3^1S0 -85/5184 / \
-85/5184; 3^3S1 -7/1728 / 1/192; 3^1P1 -7/1728 / -7/1728; 3^3P2 -49/25920 / \
-49/25920; 3^3P1 -29/5184 / -29/5184; 3^3P0 -53/5184 / -53/5184; 3^1D2 \
-41/25920 / -41/25920; 3^3D3 -127/181440 / -127/181440; 3^3D2 -49/25920 / \
-49/25920; 3^3D1 -1/320 / -1/320]\"\>"], "Print",
 CellChangeTimes->{4.004398282185588*^9},
