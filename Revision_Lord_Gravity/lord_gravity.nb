                 RowBox[{"s", " ", 
                  RowBox[{"(", 
                   RowBox[{"s", " ", "+", " ", "1"}], ")"}]}]}], ")"}], "/", 
               "2"}]}], " ", "+", " ", 
             RowBox[{"If", "[", 
