       RowBox[{"0", " ", "and", " ", 
        RowBox[{"d", "^", "2"}], 
        RowBox[{"V", "/", 
         RowBox[{"dz", "^", "2"}]}]}], " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"-", "2"}], " ", 
