         ";", "\n", "  ", 
        RowBox[{"gi", " ", "=", " ", 
         RowBox[{"Simplify", "[", 
          RowBox[{"Inverse", "[", "g", "]"}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"gam", " ", "=", " ", 
