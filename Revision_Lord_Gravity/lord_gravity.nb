}]}]}]}]}]}], "-", "4"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"lam", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "l01", ",", " ", "l02", ",", " ", "l03"}], 
        "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "l01"}], ",", " ", "0", ",", " ", "l12", ",", " ", 
         "l13"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "l02"}], ",", " ", 
         RowBox[{"-", "l12"}], ",", " ", "0", ",", " ", "l23"}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "l03"}], ",", " ", 
         RowBox[{"-", "l13"}], ",", " ", 
         RowBox[{"-", "l23"}], ",", " ", "0"}], "}"}]}], "}"}]}], ";"}], "  ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"lambda_", 
      RowBox[{"{", 
       RowBox[{"mu", " ", "nu"}], "}"}]}], ",", " ", "real"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"xx", " ", "=", " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"lam", "[", 
          RowBox[{"[", 
           RowBox[{"a", ",", " ", "b"}], "]"}], "]"}], "/", "4"}], " ", 
        RowBox[{"smn", "[", 
         RowBox[{"sig", ",", " ", "a", ",", " ", "b"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "4"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"b", ",", " ", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"xxd", " ", "=", " ", 
     RowBox[{
      RowBox[{"ConjugateTranspose", "[", "xx", "]"}], " ", "/.", " ", 
      RowBox[{
       RowBox[{"Conjugate", "[", "z_", "]"}], " ", ":>", " ", "z"}]}]}], 
    ";"}], "                   ", 
   RowBox[{"(*", " ", 
    RowBox[{"the", " ", "lambda", " ", "are", " ", "real"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"ok4", " ", "=", " ", 
     RowBox[{"And", " ", "@@", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"zeroQ", "[", 
         RowBox[{
          RowBox[{"xx", " ", ".", " ", 
           RowBox[{"sig", "[", 
            RowBox[{"[", "m", "]"}], "]"}]}], " ", "+", " ", 
          RowBox[{
           RowBox[{"sig", "[", 
            RowBox[{"[", "m", "]"}], "]"}], " ", ".", " ", "xxd"}], " ", "+", 
          " ", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"eta", "[", 
              RowBox[{"[", 
               RowBox[{"m", ",", " ", "m"}], "]"}], "]"}], " ", 
             RowBox[{"lam", "[", 
              RowBox[{"[", 
               RowBox[{"m", ",", " ", "n"}], "]"}], "]"}], " ", 
             RowBox[{"sig", "[", 
              RowBox[{"[", "n", "]"}], "]"}]}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"n", ",", " ", "4"}], "}"}]}], "]"}]}], "]"}], ",", " ", 
        
        RowBox[{"{", 
         RowBox[{"m", ",", " ", "4"}], "}"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WL-4\>\"", ",", 
      " ", "\"\<(Rust L1-5; Python YL-2) (1.8) to first order: with \
Lambda_mu^nu = delta_mu^nu + eta^{nu rho} \\\nlambda_{rho mu} and L = 1 + 1/4 \
lambda_{mu nu} sigma^{mu nu} (six real symbols), eta^{mu rho} lambda_{rho nu} \
sigma^nu + \\\nX sigma^mu + sigma^mu X^dag = 0 for every mu\>\"", ",", " ", 
      "ok4", ",", " ", 
      RowBox[{"ToString", "[", "ok4", "]"}]}], "]"}], ";"}]}]}]], "Input",
 CellLabel->"In[42]:=",ExpressionUUID->"b0e79ee9-47db-4301-97a6-27117efc59be"],

Cell[BoxData["\<\"PASS WL-4     (Rust L1-5; Python YL-2) (1.8) to first \
order: with Lambda_mu^nu = delta_mu^nu + eta^{nu rho} lambda_{rho mu} and L = \
1 + 1/4 lambda_{mu nu} sigma^{mu nu} (six real symbols), eta^{mu rho} \
lambda_{rho nu} sigma^nu + X sigma^mu + sigma^mu X^dag = 0 for every mu \
[True]\"\>"], "Print",
 CellChangeTimes->{4.004398246721328*^9},
 CellLabel->
  "During evaluation of \
In[42]:=",ExpressionUUID->"901f2f00-0d1d-4a12-b61a-e4b8f2fd0913"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
WL-5: the sign of the gauge transformation (Lord's Section 4)\
\>", "Section",ExpressionUUID->"26e2893e-74ca-453e-88d3-8ff17a4eb085"],

Cell[TextData[{
 "When the change of representation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["S", "TI"], 
    RowBox[{"(", 
     StyleBox["x", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6674430a-1dfa-4b5a-98fa-1c5392cd7b5d"],
 " depends on the point, the derivative of a spinor is no longer covariant, \
and Lord adds an auxiliary field ",
 Cell[BoxData[
  FormBox["\[CapitalGamma]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6763832a-841b-4772-b981-40d98aac5819"],
 ", as in electrodynamics: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["D", "TI"], "\[LongEqual]", "\[PartialD]", "-", 
    "\[CapitalGamma]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1745727b-02a8-4b19-807a-95f326fc2190"],
 ". For ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["D", "TI"], "\[Psi]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "87f5e20d-c8a4-41ce-a869-ac0d3a62315f"],
 " to transform like ",
 Cell[BoxData[
  FormBox["\[Psi]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2de5b026-ad25-46e2-85b6-c819e707485c"],
 ", the field must transform as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[CapitalGamma]", "\[Prime]"], "\[LongEqual]", 
    StyleBox["S", "TI"], "\[CapitalGamma]", 
    SuperscriptBox[
     StyleBox["S", "TI"], 
     RowBox[{"-", "1"}]], "+", 
    RowBox[{"(", 
     RowBox[{"\[PartialD]", 
      StyleBox["S", "TI"]}], ")"}], 
    SuperscriptBox[
     StyleBox["S", "TI"], 
     RowBox[{"-", "1"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a12c6892-5b26-45be-9354-50a1cbd35152"],
 ". Lord prints the inhomogeneous term as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["S", "TI"], "\[ThinSpace]", "\[PartialD]", 
    RowBox[{"(", 
     SuperscriptBox[
      StyleBox["S", "TI"], 
      RowBox[{"-", "1"}]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b0f740f2-add5-40cd-885f-1cb2c135470f"],
 ", which is its negative. The check takes an explicit ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["S", "TI"], 
    RowBox[{"(", 
     StyleBox["t", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3f0e19d0-3657-4730-8b06-eaaf3b48a850"],
 " of determinant 1, a constant ",
 Cell[BoxData[
  FormBox["\[CapitalGamma]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "87745ddb-18dc-49cd-9995-54220bde464e"],
 " in the Lorentz algebra with symbolic entries, and a spinor of four \
symbolic functions, and shows that the corrected law makes ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["D", "TI"], "\[Psi]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1ce67510-6c94-4a0e-a06b-cf48e9686dfe"],
 " covariant and the printed one does not. Section 7 of the manuscript \
records this correction and those of the next two checks."
}], "Text",ExpressionUUID->"92cfc9f8-7cc1-4785-8011-4e7f9ba04c32"],

