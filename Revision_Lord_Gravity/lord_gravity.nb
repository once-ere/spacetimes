 " that exchanges the two isospin components."
}], "Text",ExpressionUUID->"333bdc8c-b884-40e1-b5d0-a418ac8772ca"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "the", " ", "helper", " ", "functions", " ", "of", " ", "the", " ", 
    "script", " ", 
    RowBox[{"lg_annih", ".", "wls"}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "the", " ", "matrices", " ", "of", " ", "the", " ", "chiral", " ", "basis",
     " ", "of", " ", 
    RowBox[{"lord_gravity", ".", "md"}], " ", "and", " ", "of", " ", "the", " ",
     "pairing", " ", "term"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"s0", " ", "=", " ", 
     RowBox[{"IdentityMatrix", "[", "2", "]"}]}], ";", " ", 
    RowBox[{"s1", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}]}], "}"}]}], ";", " ", 
    RowBox[{"s2", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", 
         RowBox[{"-", "I"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"I", ",", " ", "0"}], "}"}]}], "}"}]}], ";", " ", 
    RowBox[{"s3", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", 
         RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"z2", " ", "=", " ", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"blk", "[", 
      RowBox[{"a_", ",", " ", "b_", ",", " ", "c_", ",", " ", "d_"}], "]"}], 
     " ", ":=", " ", 
     RowBox[{"ArrayFlatten", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"a", ",", " ", "b"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"c", ",", " ", "d"}], "}"}]}], "}"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"g4", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"blk", "[", 
        RowBox[{"z2", ",", " ", "s0", ",", " ", "s0", ",", " ", "z2"}], "]"}],
        ",", " ", 
       RowBox[{"blk", "[", 
        RowBox[{"z2", ",", " ", "s1", ",", " ", 
         RowBox[{"-", "s1"}], ",", " ", "z2"}], "]"}], ",", " ", 
       RowBox[{"blk", "[", 
        RowBox[{"z2", ",", " ", "s2", ",", " ", 
         RowBox[{"-", "s2"}], ",", " ", "z2"}], "]"}], ",", " ", 
       RowBox[{"blk", "[", 
        RowBox[{"z2", ",", " ", "s3", ",", " ", 
         RowBox[{"-", "s3"}], ",", " ", "z2"}], "]"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gch", " ", "=", " ", 
     RowBox[{"I", " ", 
      RowBox[{
       RowBox[{"g4", "[", 
        RowBox[{"[", "1", "]"}], "]"}], " ", ".", " ", 
       RowBox[{"g4", "[", 
        RowBox[{"[", "2", "]"}], "]"}], " ", ".", " ", 
       RowBox[{"g4", "[", 
        RowBox[{"[", "3", "]"}], "]"}], " ", ".", " ", 
       RowBox[{"g4", "[", 
        RowBox[{"[", "4", "]"}], "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"el", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "0"}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"cll", " ", "=", " ", 
     RowBox[{"ArrayFlatten", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"el", ",", " ", "z2"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"z2", ",", " ", 
          RowBox[{"-", "el"}]}], "}"}]}], "}"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"k3", " ", "=", " ", 
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{
       RowBox[{"cll", " ", ".", " ", "gch"}], ",", " ", 
       RowBox[{"el", " ", ".", " ", "s3"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"pm", " ", "=", " ", 
     RowBox[{
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{
        RowBox[{"g4", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", " ", "s0"}], "]"}], " ", ".", 
      " ", 
      RowBox[{"ConjugateTranspose", "[", "k3", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"g8", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"#", ",", " ", "s0"}], "]"}], " ", "&"}], " ", "/@", " ", 
      "g4"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"t3", " ", "=", " ", 
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{
       RowBox[{"IdentityMatrix", "[", "4", "]"}], ",", " ", 
       RowBox[{"s3", "/", "2"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"fl", " ", "=", " ", 
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{
       RowBox[{"IdentityMatrix", "[", "4", "]"}], ",", " ", "s1"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"zero8", " ", "=", " ", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", " ", 
       RowBox[{"{", 
        RowBox[{"8", ",", " ", "8"}], "}"}]}], "]"}]}], ";"}]}]}]], "Input",
 CellLabel->
  "In[473]:=",ExpressionUUID->"1ff470ac-b8ae-4db6-b07d-f10e88fd7884"],

Cell[CellGroupData[{

Cell["WA-1: the algebra of the pairing term", "Section",ExpressionUUID->"9fd37b57-1bf9-4034-a83c-a362d358892a"],

Cell[TextData[{
 "The matrix ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["P",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LG",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4e3ed60e-cce1-4b1a-8646-7409598e7630"],
 " is real, antisymmetric and unitary; it commutes with the Dirac matrices \
and with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["i", "TI"], 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "3"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a1312e39-8035-4a4f-80fe-5ae08db6a1be"],
 " in the sense of WG-6; and the reflection ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["F",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LG",
     FontSlant->"Plain"], 
    StyleBox["v",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2e54e3ab-9809-464d-8051-ddcc6077226a"],
 " commutes with the pairing map and turns ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0e6ba694-ac71-4533-ab94-914460d2c234"],
 " into ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "3"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e14e907d-a3bd-4c02-9e82-8c763e1f48ea"],
 ". The reflection is the element of the unbroken group ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["O", "TI"], 
    RowBox[{"(", "2", ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0c699636-e80c-4f7e-aef6-81905eed6881"],
 " that the selection rules of annihilation use."
}], "Text",ExpressionUUID->"1f880f2d-b303-4900-b8c0-6be926a6619f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
