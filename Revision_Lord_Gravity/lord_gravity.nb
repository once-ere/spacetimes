       " ", "-", " ", 
       RowBox[{
        RowBox[{"Inverse", "[", "sP", "]"}], " ", ".", " ", 
        RowBox[{"bar", "[", "sigGen", "]"}], " ", ".", " ", 
        RowBox[{"Inverse", "[", "sS", "]"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WL-2\>\"", ",", 
      " ", "\"\<(Rust L1-11a, L1-11b; Python YL-3) for S of determinant 1 \
(symbolic entries): epsilon S = (S^T)^{-1} \\\nepsilon; and for any matrix \
sigma and a second S' of determinant 1, bar(S sigma S') = S'^{-1} bar(sigma) \
