Cell[BoxData["\<\"PASS WL-7     (Rust L4-10a, L4-10b, L4-10c; Python YL-7b, \
YL-7c) lambda(W) = 1/4 W_{ab} gamma^{ab} (W antisymmetric, symbolic) \
satisfies [lambda(W), gamma_b] = -W_b^e gamma_e and [lambda(W1), lambda(W2)] \
= lambda([W1, W2]): a homomorphism of Lie algebras, so the curvature of the \
spinor connection lambda(W_mu) is lambda(R_{mu nu}) = 1/4 R_{mu nu ab} \
gamma^{ab} exactly, and Lord's printed 1/2 R gamma is twice it [action on \
gamma True, homomorphism True]\"\>"], "Print",
 CellChangeTimes->{4.004398246747637*^9},
