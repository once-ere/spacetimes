          RowBox[{
           RowBox[{"geo", "[", "\"\<spc\>\"", "]"}], "[", 
           RowBox[{"[", "m", "]"}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{"geo", "[", "\"\<X\>\"", "]"}], "[", 
           RowBox[{"[", "n", "]"}], "]"}]}], "]"}], " ", "+", "\n", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{"geo", "[", "\"\<spc\>\"", "]"}], "[", 
