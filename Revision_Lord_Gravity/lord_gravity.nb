Cell[CellGroupData[{

Cell["7. The pair falls into a black hole (Part VI, Section 32)", "Chapter",ExpressionUUID->"3249886f-ec7a-4175-b12c-7c25dbec88dd"],

Cell[TextData[{
 "A pair that falls freely into a black hole is stretched along the radius \
and squeezed across it by the tidal field. In the atomic units of the pair \
(lengths in its Bohr radius ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["LG",
     FontSlant->"Plain"], 
    StyleBox["pair",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bc36ada2-286e-45b0-9efd-fa905a525d71"],
 ", energies in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Mu]", 
     StyleBox["LG",
      FontSlant->"Plain"], 
     StyleBox["pair",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[Alpha]", 
       StyleBox["LG",
        FontSlant->"Plain"], 
       StyleBox["Z",
        FontSlant->"Plain"]], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "54ee07a9-9e58-4903-a383-9dadd371ecaa"],
 ") its relative motion is that of a hydrogen atom in the potential ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "1"}], "/", 
    StyleBox["r", "TI"], "-", 
    SubsuperscriptBox["\[Kappa]", 
     StyleBox["LG",
      FontSlant->"Plain"], 
     StyleBox["tid",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     StyleBox["r", "TI"], "2"], 
    SubscriptBox[
     StyleBox["P", "TI"], "2"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["cos",
       FontSlant->"Plain"], "\[ThinSpace]", "\[Theta]"}], ")"}]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "40076cc1-8df1-4f38-a313-b46b4b4f9365"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["P", "TI"], "2"], 
    RowBox[{"(", 
     StyleBox["x", "TI"], ")"}], "\[LongEqual]", 
    FractionBox["1", "2"], 
    RowBox[{"(", 
     RowBox[{"3", 
      SuperscriptBox[
       StyleBox["x", "TI"], "2"], "-", "1"}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ea9e5280-f4c1-4db2-a321-258d2885e661"],
 " is the Legendre polynomial of degree 2 and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Kappa]", 
    StyleBox["LG",
     FontSlant->"Plain"], 
    StyleBox["tid",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c08f7ab7-fed0-4742-a24c-6b58eb2354be"],
 " the tidal strength (32.2). This chapter checks the pieces of that \
computation that can be done exactly. In the code ",
 StyleBox["kap",
  FontFamily->"Source Code Pro"],
 " (WT-2) and ",
 StyleBox["kk",
  FontFamily->"Source Code Pro"],
 " (WT-3, WT-4) are ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Kappa]", 
    StyleBox["LG",
     FontSlant->"Plain"], 
    StyleBox["tid",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "be6f2651-10f2-4383-a6de-dfca72fc0b4e"],
 ", ",
 StyleBox["T",
  FontFamily->"Source Code Pro"],
 " is the time ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["LG",
     FontSlant->"Plain"], 
    StyleBox["fall",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "686198b8-f9fc-4a1c-ae2b-da91b1aa6a82"],
 ", ",
 StyleBox["mm",
  FontFamily->"Source Code Pro"],
 " the mass ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["\[ScriptCapitalM]",
     FontSlant->"Plain"], 
    StyleBox["LG",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7c52c7de-3efb-4d76-b380-b4aab0db19c3"],
 ", and ",
 StyleBox["F",
  FontFamily->"Source Code Pro"],
 " the strength ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["F", "TI"], 
    StyleBox["LG",
     FontSlant->"Plain"], 
    StyleBox["u",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9bb8492a-ce82-4d5c-928a-434a74083544"],
 " of a uniform field."
}], "Text",ExpressionUUID->"2b4204a8-94be-4328-b7ab-59569d94479d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "the", " ", "symbols", " ", "that", " ", "the", " ", "code", " ", "of", " ",
     "this", " ", "chapter", " ", "creates", " ", "live", " ", "in", " ", 
    "the", " ", "context", " ", "LGNB`Tidal`", " ", 
    RowBox[{"(", 
     RowBox[{
     "the", " ", "code", " ", "is", " ", "that", " ", "of", " ", "the", " ", 
      "script", " ", 
      RowBox[{
       RowBox[{"wolfram", "/", "source"}], "/", 
       RowBox[{"lg_tidal", ".", "wls"}]}]}], ")"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{"Begin", "[", "\"\<LGNB`Tidal`\>\"", "]"}], ";"}]}]], "Input",
 CellLabel->
  "In[406]:=",ExpressionUUID->"b02f9101-7049-4ad3-91b7-1a836dc06611"],

Cell[CellGroupData[{

Cell["WT-1: how the tidal field couples the angular momenta", "Section",ExpressionUUID->"0d04cfbd-b27f-496b-a33a-0d35c010bbc1"],

Cell[TextData[{
 "The tidal potential ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["r", "TI"], "2"], 
    SubscriptBox[
     StyleBox["P", "TI"], "2"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["cos",
       FontSlant->"Plain"], "\[ThinSpace]", "\[Theta]"}], ")"}]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "43dfc8cf-628c-4066-916a-5a99b73031e4"],
 " couples a state of the orbital angular momentum ",
 Cell[BoxData[
  FormBox["\[ScriptL]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "488c53f6-540c-4884-9cc0-b271b06a40c3"],
 " to those of ",
 Cell[BoxData[
  FormBox["\[ScriptL]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f7c496e5-3e4e-4d59-881e-640e0a4dfa40"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ScriptL]", "\[PlusMinus]", "2"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dc9428f4-936b-4252-8560-8a315e1a41ce"],
 ". The strength of the coupling is the integral of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["Y", "TI"], 
     RowBox[{"\[ScriptL]", "0"}]], 
    SubscriptBox[
     StyleBox["P", "TI"], "2"], 
    SubscriptBox[
     StyleBox["Y", "TI"], 
     RowBox[{
      SuperscriptBox["\[ScriptL]", "\[Prime]"], "0"}]]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cd8e7237-07ce-4dde-aa43-cfc5fe07af60"],
 " over the sphere, a product of two 3-j symbols. The check compares the \
formula with 3-j symbols (",
 StyleBox["ThreeJSymbol",
  FontFamily->"Source Code Pro"],
 ") with the closed forms that the Rust program uses, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ScriptL]", 
    RowBox[{"(", 
     RowBox[{"\[ScriptL]", "+", "1"}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"2", "\[ScriptL]", "-", "1"}], ")"}], 
      RowBox[{"(", 
       RowBox[{"2", "\[ScriptL]", "+", "3"}], ")"}]}], ")"}]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "36cd3fa6-80d2-463d-85ea-a48da0015cdb"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[ScriptL]", "\[Prime]"], "\[LongEqual]", "\[ScriptL]"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0e7ab9bd-16b1-4470-8b0d-51c75c9723ec"],
 " and the one for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[ScriptL]", "\[Prime]"], "\[LongEqual]", "\[ScriptL]", "+",
     "2"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2fe6213a-b883-44f8-9739-9de281a066f0"],
 ", for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "\[ScriptL]", "\[LongEqual]", "0", ",", "2", ",", "\[Ellipsis]", ",", 
    "30"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4fcbcf09-62b6-43a2-894d-eb0e49edcd12"],
 "."
}], "Text",ExpressionUUID->"d10bf502-eb1d-49a6-ac2c-e1088857a67e"],

