        RowBox[{"(", "V1", ")"}]}], ")"}]}], " ", "minus", " ", 
     RowBox[{"f", "/", "2"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"okRays", " ", "=", " ", 
     RowBox[{"zeroQ", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"nullLen", "[", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "1"}], "}"}], "]"}], ",", " ", 
        RowBox[{"nullLen", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", 
           RowBox[{"fV", "/", "2"}]}], "}"}], "]"}], ",", " ", "factorRays", ",",
         " ", "transport"}], "}"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WV-5\>\"", ",", 
      " ", "\"\<(Rust: the excision of the black hole) the radial light rays: \
f dv^2 - 2 dv dr = dv (f dv - 2 dr), so the \\\nradial null directions are dv \
= 0 (the ingoing rays, which are the slices v = const) and dr/dv = f/2 (the \
outgoing rays); \\\n(V1) is d_v P + (f/2) d_r P = -(M/(2 r^2)) P - (i \
lambda/(2 r) + m/2) Q, a transport of P along the outgoing rays, outward \\\n\
where f > 0 and inward inside the apparent horizon r = 2 M(v); hence an inner \
edge of the grid inside the apparent horizon \\\nneeds no boundary \
condition\>\"", ",", " ", "okRays", ",", "\n", "  ", 
      RowBox[{"\"\<lengths of (0, 1) and (1, f/2): \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"InputForm", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"nullLen", "[", 
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "1"}], "}"}], "]"}], ",", " ", 
           RowBox[{"nullLen", "[", 
            RowBox[{"{", 
             RowBox[{"1", ",", " ", 
              RowBox[{"fV", "/", "2"}]}], "}"}], "]"}]}], "}"}], "]"}], "]"}],
        " ", "<>", "\n", "   ", "\"\<; factorization \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"InputForm", "[", "factorRays", "]"}], "]"}], " ", "<>", 
       " ", "\"\<; transport \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"InputForm", "[", "transport", "]"}], "]"}]}]}], "]"}], 
    ";"}]}]}]], "Input",
 CellLabel->
  "In[353]:=",ExpressionUUID->"94355286-a930-4af8-aeee-8f2263d9f92e"],

Cell[BoxData["\<\"PASS WV-5     (Rust: the excision of the black hole) the \
radial light rays: f dv^2 - 2 dv dr = dv (f dv - 2 dr), so the radial null \
directions are dv = 0 (the ingoing rays, which are the slices v = const) and \
dr/dv = f/2 (the outgoing rays); (V1) is d_v P + (f/2) d_r P = -(M/(2 r^2)) P \
- (i lambda/(2 r) + m/2) Q, a transport of P along the outgoing rays, outward \
where f > 0 and inward inside the apparent horizon r = 2 M(v); hence an inner \
edge of the grid inside the apparent horizon needs no boundary condition \
[lengths of (0, 1) and (1, f/2): {0, 0}; factorization 0; transport 0]\"\>"], \
"Print",
 CellChangeTimes->{4.004398277562365*^9},
 CellLabel->
  "During evaluation of \
In[353]:=",ExpressionUUID->"e3111caa-45aa-4788-b64b-3e37429839fe"]
}, Open  ]],

