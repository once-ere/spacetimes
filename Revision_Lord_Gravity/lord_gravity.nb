             RowBox[{"r", "^", "2"}]}]}], " ", "-", " ", 
           RowBox[{"2", " ", 
            RowBox[{"D", "[", 
             RowBox[{"fdl", ",", " ", "r"}], "]"}]}]}], ")"}]}], " ", "-", 
        " ", 
        RowBox[{"kk", " ", 
         RowBox[{"r", "^", "2"}]}]}], "]"}], " ", "===", " ", "0"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{
