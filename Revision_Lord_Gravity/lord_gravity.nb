Cell[TextData[{
 "The function ",
 StyleBox["geometry[E, X, simp]",
  FontFamily->"Source Code Pro"],
 " takes a coframe, the matrix ",
 StyleBox["E",
  FontFamily->"Source Code Pro"],
 " with entries ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      StyleBox["LG",
       FontSlant->"Plain"], "\[ThinSpace]", 
      StyleBox["a", "TI"]}]], 
    SubscriptBox["", "\[Mu]"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7a6035ce-7c10-4c5b-95b3-77407ecc241f"],
 " in the coordinates ",
 StyleBox["X",
  FontFamily->"Source Code Pro"],
 ", and returns the tetrad (",
 StyleBox["F",
  FontFamily->"Source Code Pro"],
 ", the inverse transpose), the metric, the Christoffel symbols, the spin \
connection of the tetrad postulate, the Dirac matrices ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LG",
      FontSlant->"Plain"], "\[Mu]"], "\[LongEqual]", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["e", "TI"], 
      StyleBox["a", "TI"], 
      StyleBox["LG",
       FontSlant->"Plain"]], 
     SuperscriptBox["", "\[Mu]"], 
     SuperscriptBox["\[Gamma]", 
      StyleBox["a", "TI"]]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7053997e-ff16-444a-8c50-a96e46ebc639"],
 " and the spinor connection ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "4"], 
    SubscriptBox["\[Omega]", 
     RowBox[{"\[Mu]", "\[ThinSpace]", 
      StyleBox["ab", "TI"]}]], 
    SuperscriptBox["\[Gamma]", 
     StyleBox["ab", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7e00dc2f-c03c-4841-9f12-98bc78083934"],
 ". The functions ",
 StyleBox["riemann",
  FontFamily->"Source Code Pro"],
 ", ",
 StyleBox["ricci",
  FontFamily->"Source Code Pro"],
 " and ",
 StyleBox["christoffel",
  FontFamily->"Source Code Pro"],
 " compute the curvature in the conventions of Landau and Lifshitz; ",
 StyleBox["nablaGamma",
  FontFamily->"Source Code Pro"],
 " is the covariant derivative of the Dirac matrices, which must vanish, and ",
 StyleBox["spinCurvDev",
  FontFamily->"Source Code Pro"],
 " is the difference between the curvature of the spinor connection and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "4"], 
    SubscriptBox[
     StyleBox["R", "TI"], 
     RowBox[{
      StyleBox["ab", "TI"], "\[Mu]", "\[Nu]"}]], 
    SuperscriptBox["\[Gamma]", 
     StyleBox["ab", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "23884104-cdc9-463c-a1be-6b9c14ae5d0d"],
 ", which must vanish too. Then the assumptions ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r", "TI"], ">", "2", 
    StyleBox["M", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "82f99e0a-2cd0-4a9d-ab32-58f0cb3c75e0"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["M", "TI"], ">", "0"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f04cf787-0eb6-4c2e-ac00-ef47ff09c687"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "<", "\[Theta]", "<", "\[Pi]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6d76c849-b7a2-4739-976e-c3579decddd6"],
 " are set for ",
 StyleBox["Simplify",
  FontFamily->"Source Code Pro"],
 " (they hold in this chapter only)."
}], "Text",ExpressionUUID->"2b673c2d-d62a-4d74-8b09-3399b2972298"],

