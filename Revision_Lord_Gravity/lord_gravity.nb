Cell[CellGroupData[{

Cell["\<\
WG-3: the Vaidya space-times (a black hole whose mass changes)\
\>", "Section",ExpressionUUID->"5b3db406-f5e3-43cb-a7c5-bdd66bccd389"],

Cell[TextData[{
 "If radiation falls into a black hole, its mass grows; if it radiates, its \
mass shrinks. The Vaidya metric describes this with a mass that depends on \
the advanced time ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["v", "TI"], 
    StyleBox["LG",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cce61c65-a613-4eb1-95f0-951e2183b5cd"],
 " (for infalling radiation) or on the retarded time ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["u", "TI"], 
    StyleBox["LG",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "76649884-5876-49d4-8a8b-714eb452273c"],
 " (for outgoing radiation); in the code they are ",
 StyleBox["vv",
  FontFamily->"Source Code Pro"],
 " and ",
 StyleBox["uu",
  FontFamily->"Source Code Pro"],
 ", and the mass functions ",
 StyleBox["mIn",
  FontFamily->"Source Code Pro"],
 " and ",
 StyleBox["mOut",
  FontFamily->"Source Code Pro"],
 ". The check computes Einstein's tensor and finds that it is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"8", "\[Pi]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e5d97c4e-2e1d-4d6f-b516-61e3a2636870"],
 " times the energy-momentum tensor of a pressureless stream of radiation \
moving at the speed of light (null dust), with the energy density ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Rho]", 
     StyleBox["LG",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalM]",
      FontSlant->"Plain"], 
     StyleBox["LG",
      FontSlant->"Plain"], "\[Prime]"], 
    RowBox[{"(", 
     SubscriptBox[
      StyleBox["v", "TI"], 
      StyleBox["LG",
       FontSlant->"Plain"]], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"4", "\[Pi]", 
      SuperscriptBox[
       StyleBox["r", "TI"], "2"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c972f8ea-4da2-432f-b28a-9490055ee6f5"],
 ", positive when the mass grows, or ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     SubsuperscriptBox[
      StyleBox["\[ScriptCapitalM]",
       FontSlant->"Plain"], 
      StyleBox["LG",
       FontSlant->"Plain"], "\[Prime]"]}], 
    RowBox[{"(", 
     SubscriptBox[
      StyleBox["u", "TI"], 
      StyleBox["LG",
       FontSlant->"Plain"]], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"4", "\[Pi]", 
      SuperscriptBox[
       StyleBox["r", "TI"], "2"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d87215f5-9790-4330-88ca-a62424fb61bc"],
 ", positive when the mass shrinks; the scalar curvature vanishes. Part V \
uses the ingoing form."
}], "Text",ExpressionUUID->"a1b3edde-7599-43ae-a2b8-fc4eb92a2a52"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", 
          RowBox[{"--", 
           RowBox[{"--", 
            RowBox[{"--", 
             RowBox[{"--", 
              RowBox[{"--", 
               RowBox[{"--", 
                RowBox[{"--", 
                 RowBox[{"--", 
                  RowBox[{"--", 
                   RowBox[{"--", 
                    RowBox[{"--", 
