                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{
                    "--", " ", 
                    "WG"}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]\
}]}]}]}]}]}], "-", "3"}], ":", " ", "Vaidya"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"einstein", "[", 
      RowBox[{"g_", ",", " ", "X_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"chr", ",", " ", "riem", ",", " ", "ric", ",", " ", "rs"}], 
        "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"chr", " ", "=", " ", 
         RowBox[{"christoffel", "[", 
          RowBox[{"g", ",", " ", "X", ",", " ", "Simplify"}], "]"}]}], ";", 
        "\n", "  ", 
        RowBox[{"riem", " ", "=", " ", 
         RowBox[{"riemann", "[", 
          RowBox[{"chr", ",", " ", "X", ",", " ", "Simplify"}], "]"}]}], ";", 
        "\n", "  ", 
        RowBox[{"ric", " ", "=", " ", 
         RowBox[{"Simplify", "[", 
          RowBox[{"ricci", "[", "riem", "]"}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"rs", " ", "=", " ", 
         RowBox[{"Simplify", "[", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Inverse", "[", "g", "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"a", ",", " ", "b"}], "]"}], "]"}], " ", 
             RowBox[{"ric", "[", 
              RowBox[{"[", 
               RowBox[{"a", ",", " ", "b"}], "]"}], "]"}]}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"a", ",", " ", "4"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"b", ",", " ", "4"}], "}"}]}], "]"}], "]"}]}], ";", "\n",
         "  ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Simplify", "[", 
           RowBox[{"ric", " ", "-", " ", 
            RowBox[{"g", " ", 
             RowBox[{"rs", "/", "2"}]}]}], "]"}], ",", " ", "rs"}], "}"}]}]}],
       "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gIn", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", " ", "-", " ", 
          RowBox[{"2", " ", 
           RowBox[{
            RowBox[{"mIn", "[", "vv", "]"}], "/", "r"}]}]}], ",", " ", 
         RowBox[{"-", "1"}], ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
       
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "0", ",", " ", "0", ",", " ", "0"}], 
        "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0", ",", " ", 
         RowBox[{"-", 
          RowBox[{"r", "^", "2"}]}], ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0", ",", " ", "0", ",", " ", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"r", "^", "2"}]}], " ", 
          RowBox[{
           RowBox[{"Sin", "[", "th", "]"}], "^", "2"}]}]}], "}"}]}], "}"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"gtIn", ",", " ", "rsIn"}], "}"}], " ", "=", " ", 
     RowBox[{"einstein", "[", 
      RowBox[{"gIn", ",", " ", 
       RowBox[{"{", 
        RowBox[{"vv", ",", " ", "r", ",", " ", "th", ",", " ", "ph"}], 
        "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"tIn", " ", "=", " ", 
     RowBox[{"8", " ", "Pi", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"mIn", "'"}], "[", "vv", "]"}], "/", 
        RowBox[{"(", 
         RowBox[{"4", " ", "Pi", " ", 
          RowBox[{"r", "^", "2"}]}], ")"}]}], ")"}], " ", 
      RowBox[{"Outer", "[", 
       RowBox[{"Times", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], "}"}], ",",
         " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], "}"}]}], 
       "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gOut", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", " ", "-", " ", 
          RowBox[{"2", " ", 
           RowBox[{
            RowBox[{"mOut", "[", "uu", "]"}], "/", "r"}]}]}], ",", " ", "1", ",",
          " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], "}"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0", ",", " ", 
         RowBox[{"-", 
          RowBox[{"r", "^", "2"}]}], ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0", ",", " ", "0", ",", " ", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"r", "^", "2"}]}], " ", 
          RowBox[{
           RowBox[{"Sin", "[", "th", "]"}], "^", "2"}]}]}], "}"}]}], "}"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"gtOut", ",", " ", "rsOut"}], "}"}], " ", "=", " ", 
     RowBox[{"einstein", "[", 
      RowBox[{"gOut", ",", " ", 
       RowBox[{"{", 
        RowBox[{"uu", ",", " ", "r", ",", " ", "th", ",", " ", "ph"}], 
        "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"tOut", " ", "=", " ", 
     RowBox[{"8", " ", "Pi", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{
          RowBox[{"mOut", "'"}], "[", "uu", "]"}]}], "/", 
        RowBox[{"(", 
         RowBox[{"4", " ", "Pi", " ", 
          RowBox[{"r", "^", "2"}]}], ")"}]}], ")"}], " ", 
      RowBox[{"Outer", "[", 
       RowBox[{"Times", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], "}"}], ",",
         " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], "}"}]}], 
       "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"okIn", " ", "=", " ", 
     RowBox[{
      RowBox[{"zeroQ", "[", 
       RowBox[{"gtIn", " ", "-", " ", "tIn"}], "]"}], " ", "&&", " ", 
      RowBox[{"zeroQ", "[", "rsIn", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"okOut", " ", "=", " ", 
     RowBox[{
      RowBox[{"zeroQ", "[", 
       RowBox[{"gtOut", " ", "-", " ", "tOut"}], "]"}], " ", "&&", " ", 
      RowBox[{"zeroQ", "[", "rsOut", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WG-3\>\"", ",", 
      " ", "\"\<Vaidya, ingoing: ds^2 = (1 - 2M(v)/r) dv^2 - 2 dv dr - r^2 \
dOmega^2: G_{mu nu} = 8 pi rho l_mu l_nu with \\\nl = dv and rho = M'(v)/(4 \
pi r^2) (null dust falling in), R = 0; outgoing: ds^2 = (1 - 2M(u)/r) du^2 + \
2 du dr - r^2 \\\ndOmega^2: G_{mu nu} = 8 pi rho k_mu k_nu with k = du and \
rho = -M'(u)/(4 pi r^2) (null dust radiated, positive for M' < 0), \\\nR = \
0\>\"", ",", " ", 
      RowBox[{"okIn", " ", "&&", " ", "okOut"}], ",", " ", 
      RowBox[{"\"\<ingoing \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", "okIn", "]"}], " ", "<>", 
       " ", "\"\<, outgoing \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", "okOut", "]"}]}]}], "]"}], ";"}]}]}]], "Input",
 CellLabel->
  "In[126]:=",ExpressionUUID->"07c2e181-4b61-4752-bc32-b0f5bc77105f"],

Cell[BoxData["\<\"PASS WG-3     Vaidya, ingoing: ds^2 = (1 - 2M(v)/r) dv^2 - \
2 dv dr - r^2 dOmega^2: G_{mu nu} = 8 pi rho l_mu l_nu with l = dv and rho = \
M'(v)/(4 pi r^2) (null dust falling in), R = 0; outgoing: ds^2 = (1 - \
2M(u)/r) du^2 + 2 du dr - r^2 dOmega^2: G_{mu nu} = 8 pi rho k_mu k_nu with k \
= du and rho = -M'(u)/(4 pi r^2) (null dust radiated, positive for M' < 0), R \
= 0 [ingoing True, outgoing True]\"\>"], "Print",
 CellChangeTimes->{4.0043982471257563`*^9},
 CellLabel->
  "During evaluation of \
In[126]:=",ExpressionUUID->"d73c8776-a3ee-470f-b1aa-cb41ad91d5d3"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
WG-4: conformal invariance and the square of the Dirac operator\
\>", "Section",ExpressionUUID->"d22bfd19-3a36-42bb-b396-537ff3502a75"],

Cell[TextData[{
 "In a space-time whose metric is a multiple of the flat one, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["g", "TI"], "\[LongEqual]", 
    SubsuperscriptBox["\[CapitalOmega]", 
     StyleBox["LG",
      FontSlant->"Plain"], "2"], 
    SuperscriptBox["\[Eta]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "caeb929b-9347-403d-8f5b-f986085f3122"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalOmega]", 
     StyleBox["LG",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"\[Phi]", 
      RowBox[{"(", 
       StyleBox["x", "TI"], ")"}]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ad6005bd-28b4-4fa7-9bf4-a84e9dfaab0b"],
 " and ",
 Cell[BoxData[
  FormBox["\[Phi]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6970306e-ba37-4517-a9bc-9cc27957b838"],
 " an arbitrary symbolic function, the check verifies two statements for a \
spinor of four symbolic functions. First, the massless Dirac operator ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LG",
      FontSlant->"Plain"], "\[Mu]"], 
    SubscriptBox["\[Del]", "\[Mu]"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "047e22f0-3dda-468b-a80c-adf4023aa9ab"],
 " (with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Del]", "\[Mu]"], "\[LongEqual]", 
    SubscriptBox["\[PartialD]", "\[Mu]"], "+", 
    SubsuperscriptBox["\[CapitalGamma]", "\[Mu]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f99d887b-8357-4e5d-8e08-8f9be850bb28"],
 ") is conformally invariant: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LG",
      FontSlant->"Plain"], "\[Mu]"], 
    SubscriptBox["\[Del]", "\[Mu]"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["\[CapitalOmega]", 
       StyleBox["LG",
        FontSlant->"Plain"], 
       RowBox[{
        RowBox[{"-", "3"}], "/", "2"}]], "\[Psi]"}], ")"}], "\[LongEqual]", 
    SubsuperscriptBox["\[CapitalOmega]", 
     StyleBox["LG",
      FontSlant->"Plain"], 
     RowBox[{
      RowBox[{"-", "5"}], "/", "2"}]], 
    SuperscriptBox["\[Gamma]", 
     StyleBox["a", "TI"]], 
    SubscriptBox["\[PartialD]", 
     StyleBox["a", "TI"]], "\[Psi]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "173766ce-c32c-4118-8dce-0b1dc718dd01"],
 ", so the massless brochon does not feel such a gravitational field except \
through a rescaling. Second, the square of the Dirac operator is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox["\[Gamma]", 
        StyleBox["LG",
         FontSlant->"Plain"], "\[Mu]"], 
       SubscriptBox["\[Del]", "\[Mu]"]}], ")"}], "2"], "\[Psi]", "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LG",
      FontSlant->"Plain"], 
     RowBox[{"\[Mu]", "\[Nu]"}]], 
    SubscriptBox["\[Del]", "\[Mu]"], 
    SubscriptBox["\[Del]", "\[Nu]"], "\[Psi]", "-", 
    FractionBox["1", "4"], 
    StyleBox["R", "TI"], "\[Psi]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "566ec5ba-1369-4097-8ec3-995fd92b9464"],
 " (the formula of Lichnerowicz), with the coefficient ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "4"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "75628b40-8a21-4070-9773-116d300fac8a"],
 " of the scalar curvature ",
 Cell[BoxData[
  FormBox[
   StyleBox["R", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "21191966-3561-4128-90ff-e5fdcec8a55a"],
 ", not Lord's ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8048012e-0696-4e9f-b201-3eb14df49d1c"],
 " (the control shows that ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "635b4f34-d566-4194-becf-fd0020436d11"],
 " fails, and that ",
 Cell[BoxData[
  FormBox[
   StyleBox["R", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6785f4a0-d5b7-4bdd-90fe-b7bc30ae73cf"],
 " is not zero here, so the control means something). This coefficient is \
remark R1 of the manuscript."
}], "Text",ExpressionUUID->"88a78bf4-5dcd-4a17-90d9-cc10c3b4d373"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", 
          RowBox[{"--", 
           RowBox[{"--", 
