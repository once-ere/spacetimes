}]}]}]}]}]}], "-", "4"}], ":", " ", 
    RowBox[{"conformally", " ", "flat"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"XC", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "x", ",", " ", "y", ",", " ", "z"}], "}"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"geoC", " ", "=", " ", 
     RowBox[{"geometry", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"phi", " ", "@@", " ", "XC"}], "]"}], " ", "id4"}], ",", " ",
        "XC", ",", " ", "Simplify"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"psi", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"ps", "[", "i", "]"}], " ", "@@", " ", "XC"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"dslash", "[", 
      RowBox[{"geo_", ",", " ", "f_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"geo", "[", "\"\<gam\>\"", "]"}], "[", 
         RowBox[{"[", "m", "]"}], "]"}], " ", ".", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{"f", ",", " ", 
            RowBox[{
             RowBox[{"geo", "[", "\"\<X\>\"", "]"}], "[", 
             RowBox[{"[", "m", "]"}], "]"}]}], "]"}], " ", "+", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"geo", "[", "\"\<spc\>\"", "]"}], "[", 
            RowBox[{"[", "m", "]"}], "]"}], " ", ".", " ", "f"}]}], ")"}]}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"flatSlash", "[", "f_", "]"}], " ", ":=", " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"gam", "[", 
         RowBox[{"[", "a", "]"}], "]"}], " ", ".", " ", 
        RowBox[{"D", "[", 
         RowBox[{"f", ",", " ", 
          RowBox[{"XC", "[", 
