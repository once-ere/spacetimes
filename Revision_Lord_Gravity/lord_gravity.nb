Cell[CellGroupData[{

Cell["WW-4: the quasi-particle energies of the superfluid", "Section",ExpressionUUID->"63c04edf-eb72-4eee-b5e7-6dfb589b56d4"],

Cell[TextData[{
 "In the polar ground state of the brochon model the Bogoliubov-de Gennes \
matrix (a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"16", "\[Times]", "16"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "eced5744-7575-48c9-8465-522668791280"],
 " matrix that couples the brochon at the momentum ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["q", "TI"], "\[RightVector]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "23309235-b259-4155-857d-e25ed58695e7"],
 " with its conjugate at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    OverscriptBox[
     StyleBox["q", "TI"], "\[RightVector]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5574134b-6145-4d8d-b969-83e6296091f0"],
 ") has, for symbolic real momentum, Dirac mass ",
 Cell[BoxData[
  FormBox[
   StyleBox["M", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bb9227af-e266-4c8f-9068-e62e7bf5794b"],
 " and pair amplitude ",
 Cell[BoxData[
  FormBox[
   StyleBox["D", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e0dadb2c-a218-45e1-8618-b0bc9d15aad8"],
 " (in the code ",
 StyleBox["mM",
  FontFamily->"Source Code Pro"],
 " and ",
 StyleBox["dd",
  FontFamily->"Source Code Pro"],
 "), a square that is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"|", 
     OverscriptBox[
      StyleBox["q", "TI"], "\[RightVector]"], 
     SuperscriptBox["|", "2"], "+", 
     SuperscriptBox[
      StyleBox["M", "TI"], "2"], "+", 
     SuperscriptBox[
      StyleBox["D", "TI"], "2"]}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "70e02f6c-950e-47da-a8b6-5e69ab879a83"],
 " times the unit matrix, and the trace 0. Hence its eigenvalues are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[PlusMinus]", 
     StyleBox["E", "TI"]}], 
    RowBox[{"(", 
     OverscriptBox[
      StyleBox["q", "TI"], "\[RightVector]"], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "68efff30-d17f-4f98-9c98-df1cca29c07a"],
 ", eight times each, with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["E", "TI"], 
    RowBox[{"(", 
     OverscriptBox[
      StyleBox["q", "TI"], "\[RightVector]"], ")"}], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"|", 
       OverscriptBox[
        StyleBox["q", "TI"], "\[RightVector]"], 
       SuperscriptBox["|", "2"], "+", 
       SuperscriptBox[
        StyleBox["M", "TI"], "2"], "+", 
       SuperscriptBox[
        StyleBox["D", "TI"], "2"]}], ")"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ec515edc-d44e-4f96-b15b-e56c93cb134f"],
 " (B.18): the energy of a quasi-particle, whose smallest value, at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     StyleBox["q", "TI"], "\[RightVector]"], "\[LongEqual]", "0"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d492162a-2e38-40ad-aea3-9647dae36e0e"],
 ", is the gap."
}], "Text",ExpressionUUID->"798fc35f-a65b-4f80-9850-c8d9b67351c6"],

