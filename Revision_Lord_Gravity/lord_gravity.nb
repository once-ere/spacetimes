              RowBox[{"s", " ", "+", " ", "1"}], ")"}]}], " ", "-", " ", 
            RowBox[{"3", "/", "2"}]}], ")"}], "/", "2"}]}], ";", "\n", "   ", 
        
        RowBox[{"e", " ", "=", " ", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"-", "p4"}], "/", "8"}], " ", 
           RowBox[{"(", 
            RowBox[{"2", "/", 
             RowBox[{"m", "^", "3"}]}], ")"}]}], " ", "+", " ", 
          RowBox[{
           RowBox[{"Pi", "/", "2"}], " ", 
           RowBox[{"(", 
            RowBox[{"2", "/", 
             RowBox[{"m", "^", "2"}]}], ")"}], " ", 
           RowBox[{"iv", "[", "\"\<p0\>\"", "]"}]}], " ", "-", " ", 
          RowBox[{
           RowBox[{"1", "/", 
            RowBox[{"(", 
             RowBox[{"2", " ", 
              RowBox[{"m", "^", "2"}]}], ")"}]}], " ", 
           RowBox[{"iv", "[", "\"\<oo\>\"", "]"}]}], " ", "+", "\n", "     ", 
          
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"l", " ", ">", " ", "0"}], ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"3", "/", 
               RowBox[{"(", 
                RowBox[{"2", " ", 
                 RowBox[{"m", "^", "2"}]}], ")"}]}], " ", 
              RowBox[{"iv", "[", "\"\<ir3\>\"", "]"}], " ", 
              RowBox[{
               RowBox[{"(", 
