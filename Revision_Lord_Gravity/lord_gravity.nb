      RowBox[{"{", 
       RowBox[{
        RowBox[{"om", " ", "->", " ", "w1"}], ",", " ", 
        RowBox[{"mB", " ", "->", " ", "m1"}], ",", " ", 
        RowBox[{"lam", " ", "->", " ", "l1"}], ",", " ", 
        RowBox[{"r", " ", "->", " ", "r1"}]}], "}"}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"integrate", " ", 
      RowBox[{"(", "PG", ")"}], " ", "with", " ", "NDSolve", " ", "from", " ",
       "r1", " ", 
      RowBox[{"(", 
       RowBox[{"values", " ", "y1"}], ")"}], " ", "to", " ", "r2"}], ",", " ", 
     RowBox[{"arithmetic", " ", "of", " ", "wpN", " ", "digits"}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"pgSolve", "[", 
      RowBox[{
      "w1_", ",", " ", "m1_", ",", " ", "l1_", ",", " ", "r1_", ",", " ", 
       "y1_", ",", " ", "r2_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"sol", ",", " ", 
         RowBox[{"ww", " ", "=", " ", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"2", "/", "rv"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"sol", " ", "=", " ", 
         RowBox[{"NDSolve", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"pp", "'"}], "[", "rv", "]"}], " ", "==", " ", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"I", " ", "w1"}], " ", "-", " ", 
                    RowBox[{"ww", "/", 
                    RowBox[{"(", 
                    RowBox[{"4", " ", "rv"}], ")"}]}]}], ")"}], " ", 
                  RowBox[{"pp", "[", "rv", "]"}]}], " ", "-", " ", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"I", " ", 
                    RowBox[{"l1", "/", "rv"}]}], " ", "+", " ", "m1"}], ")"}],
                   " ", 
                  RowBox[{"qq", "[", "rv", "]"}]}]}], ")"}], "/", 
               RowBox[{"(", 
                RowBox[{"1", " ", "-", " ", "ww"}], ")"}]}]}], ",", "\n", 
             "     ", 
             RowBox[{
              RowBox[{
               RowBox[{"qq", "'"}], "[", "rv", "]"}], " ", "==", " ", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"I", " ", 
                    RowBox[{"l1", "/", "rv"}]}], " ", "-", " ", "m1"}], ")"}],
                   " ", 
                  RowBox[{"pp", "[", "rv", "]"}]}], " ", "+", " ", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"-", "I"}], " ", "w1"}], " ", "+", " ", 
                    RowBox[{"ww", "/", 
                    RowBox[{"(", 
                    RowBox[{"4", " ", "rv"}], ")"}]}]}], ")"}], " ", 
                  RowBox[{"qq", "[", "rv", "]"}]}]}], ")"}], "/", 
               RowBox[{"(", 
                RowBox[{"1", " ", "+", " ", "ww"}], ")"}]}]}], ",", " ", 
             RowBox[{
              RowBox[{"pp", "[", "r1", "]"}], " ", "==", " ", 
              RowBox[{"y1", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
             RowBox[{
              RowBox[{"qq", "[", "r1", "]"}], " ", "==", " ", 
              RowBox[{"y1", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ",", "\n", "    ", 
           RowBox[{"{", 
            RowBox[{"pp", ",", " ", "qq"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"rv", ",", " ", 
             RowBox[{"Min", "[", 
              RowBox[{"r1", ",", " ", "r2"}], "]"}], ",", " ", 
             RowBox[{"Max", "[", 
              RowBox[{"r1", ",", " ", "r2"}], "]"}]}], "}"}], ",", " ", 
           RowBox[{"WorkingPrecision", " ", "->", " ", "wpN"}], ",", " ", 
           RowBox[{"PrecisionGoal", " ", "->", " ", "26"}], ",", " ", 
           RowBox[{"AccuracyGoal", " ", "->", " ", "26"}], ",", "\n", "    ", 
           
           RowBox[{"MaxSteps", " ", "->", " ", 
            RowBox[{"10", "^", "7"}]}]}], "]"}]}], ";", "\n", "  ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"pp", "[", "r2", "]"}], ",", " ", 
           RowBox[{"qq", "[", "r2", "]"}]}], "}"}], " ", "/.", " ", 
         RowBox[{"First", "[", "sol", "]"}]}]}]}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellLabel->
  "In[269]:=",ExpressionUUID->"a8f0d8f7-7cae-4271-8c1b-ed765d124c7e"],

