Cell[CellGroupData[{

Cell["WP-2: the barrier of the pair in a tidal field", "Section",ExpressionUUID->"93434144-d6aa-4f01-946d-0f331a6db90a"],

Cell[TextData[{
 "Near a black hole the tidal field adds ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     SubsuperscriptBox[
      StyleBox["k", "TI"], 
      StyleBox["LG",
       FontSlant->"Plain"], 
      StyleBox["tid",
       FontSlant->"Plain"]]}], 
    SuperscriptBox[
     StyleBox["z", "TI"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2d27a3ab-a948-497e-b79d-9c3706065fa7"],
 " to the potential along the radial direction, with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["k", "TI"], 
     StyleBox["LG",
      FontSlant->"Plain"], 
     StyleBox["tid",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubsuperscriptBox["\[Mu]", 
     StyleBox["LG",
      FontSlant->"Plain"], 
     StyleBox["pair",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["\[ScriptCapitalM]",
      FontSlant->"Plain"], 
     StyleBox["LG",
      FontSlant->"Plain"]], "/", 
    SuperscriptBox[
     StyleBox["r", "TI"], "3"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "46cc0b72-da79-407e-9ae1-2a6dd3763e91"],
 " (in the code ",
 StyleBox["k",
  FontFamily->"Source Code Pro"],
 ", and ",
 StyleBox["rg",
  FontFamily->"Source Code Pro"],
 " for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["\[ScriptCapitalM]",
     FontSlant->"Plain"], 
    StyleBox["LG",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d5b64dea-4f21-4431-850b-e1b756aba511"],
 ", ",
 StyleBox["al",
  FontFamily->"Source Code Pro"],
 " for ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Alpha]", 
    StyleBox["LG",
     FontSlant->"Plain"], 
    StyleBox["Z",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4ad56281-fd13-4057-8c38-d1416e499c2a"],
 ", ",
 StyleBox["mu",
  FontFamily->"Source Code Pro"],
 " for ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Mu]", 
    StyleBox["LG",
     FontSlant->"Plain"], 
    StyleBox["pair",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a0511341-2949-488d-83b1-56ef96f1b1db"],
 "). The sum ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     SubsuperscriptBox["\[Alpha]", 
      StyleBox["LG",
       FontSlant->"Plain"], 
      StyleBox["Z",
       FontSlant->"Plain"]]}], "/", 
    StyleBox["z", "TI"], "-", 
    SubsuperscriptBox[
     StyleBox["k", "TI"], 
     StyleBox["LG",
      FontSlant->"Plain"], 
     StyleBox["tid",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     StyleBox["z", "TI"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4f76f286-5e6a-481f-8cc5-677ba03e6aa9"],
 " has a maximum, a barrier: the check finds its top at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["z", "TI"], "*"], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox["\[Alpha]", 
        StyleBox["LG",
         FontSlant->"Plain"], 
        StyleBox["Z",
         FontSlant->"Plain"]], "/", 
       RowBox[{"(", 
        RowBox[{"2", 
         SubsuperscriptBox[
          StyleBox["k", "TI"], 
          StyleBox["LG",
           FontSlant->"Plain"], 
          StyleBox["tid",
           FontSlant->"Plain"]]}], ")"}]}], ")"}], 
     RowBox[{"1", "/", "3"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "36b9ba1d-7676-4474-9136-c4b50a9ca041"],
 " with the height ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     FractionBox["3", "2"]}], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[Alpha]", 
       StyleBox["LG",
        FontSlant->"Plain"], 
       StyleBox["Z",
        FontSlant->"Plain"]], ")"}], 
     RowBox[{"2", "/", "3"}]], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"2", 
       SubsuperscriptBox[
        StyleBox["k", "TI"], 
        StyleBox["LG",
         FontSlant->"Plain"], 
        StyleBox["tid",
         FontSlant->"Plain"]]}], ")"}], 
     RowBox[{"1", "/", "3"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2285a606-b643-49f7-b972-bec1a7c0e6c6"],
 ", and shows that the barrier sinks to the level ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     SubsuperscriptBox["\[Mu]", 
      StyleBox["LG",
       FontSlant->"Plain"], 
      StyleBox["pair",
       FontSlant->"Plain"]]}], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[Alpha]", 
       StyleBox["LG",
        FontSlant->"Plain"], 
       StyleBox["Z",
        FontSlant->"Plain"]], ")"}], "2"], "/", 
    RowBox[{"(", 
     RowBox[{"2", 
      SuperscriptBox[
       StyleBox["n", "TI"], "2"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "96ce7474-ef58-4a4b-bf9b-183899504f6e"],
 " at the radius given by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["r", "TI"], "3"], "\[LongEqual]", "54", 
    SuperscriptBox[
     StyleBox["n", "TI"], "6"], 
    SubscriptBox[
     StyleBox["\[ScriptCapitalM]",
      FontSlant->"Plain"], 
     StyleBox["LG",
      FontSlant->"Plain"]], "/", 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox["\[Mu]", 
         StyleBox["LG",
          FontSlant->"Plain"], 
         StyleBox["pair",
          FontSlant->"Plain"]], ")"}], "2"], 
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox["\[Alpha]", 
         StyleBox["LG",
          FontSlant->"Plain"], 
         StyleBox["Z",
          FontSlant->"Plain"]], ")"}], "4"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f3f0bd05-56d9-472c-a46b-5ca2f2e9d423"],
 ". This is the classical estimate of the break-up of the pair; Part VI shows \
(Section 32, remark R13) that along a real fall the pair breaks up much later."
}], "Text",ExpressionUUID->"efd559d6-2b65-4d92-984e-10c1fed78684"],

