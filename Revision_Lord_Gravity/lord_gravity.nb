     RowBox[{"(", "PG", ")"}]}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Outside", " ", "the", " ", "horizon", " ", 
      RowBox[{"(", 
       RowBox[{"0", " ", "<", " ", "W", " ", "<", " ", "1"}], ")"}], " ", 
      "every", " ", "square", " ", "root", " ", "is", " ", "a", " ", 
