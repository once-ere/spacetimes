                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{
                    "--", " ", 
                    "WV"}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]\
}]}]}]}]}]}], "-", "2"}], ":", " ", 
    RowBox[{"the", " ", "charge"}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", "conjugates", " ", "pB"}], ",", " ", 
    RowBox[{"qB", " ", "of", " ", "P"}], ",", " ", 
    RowBox[{
    "Q", " ", "are", " ", "independent", " ", "functions", " ", "that", " ", 
     "obey", " ", "the", " ", "conjugate", " ", "equations", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"M", 
        RowBox[{"(", "v", ")"}]}], ",", " ", "m", ",", " ", 
       RowBox[{"lambda", " ", "real"}]}], ")"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"radVb", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Derivative", "[", 
           RowBox[{"1", ",", " ", "0"}], "]"}], "[", "pB", "]"}], "[", 
         RowBox[{"v", ",", " ", "r"}], "]"}], " ", "->", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"bhM", "[", "v", "]"}], "/", "r"}], " ", "-", " ", 
            RowBox[{"1", "/", "2"}]}], ")"}], " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Derivative", "[", 
             RowBox[{"0", ",", " ", "1"}], "]"}], "[", "pB", "]"}], "[", 
           RowBox[{"v", ",", " ", "r"}], "]"}]}], " ", "-", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"bhM", "[", "v", "]"}], "/", 
           RowBox[{"(", 
            RowBox[{"2", " ", 
             RowBox[{"r", "^", "2"}]}], ")"}]}], " ", 
          RowBox[{"pB", "[", 
           RowBox[{"v", ",", " ", "r"}], "]"}]}], " ", "-", "\n", "     ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "I"}], " ", 
             RowBox[{"lam", "/", 
              RowBox[{"(", 
               RowBox[{"2", " ", "r"}], ")"}]}]}], " ", "+", " ", 
            RowBox[{"mB", "/", "2"}]}], ")"}], " ", 
          RowBox[{"qB", "[", 
           RowBox[{"v", ",", " ", "r"}], "]"}]}]}]}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Derivative", "[", 
           RowBox[{"0", ",", " ", "1"}], "]"}], "[", "qB", "]"}], "[", 
         RowBox[{"v", ",", " ", "r"}], "]"}], " ", "->", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "I"}], " ", 
            RowBox[{"lam", "/", "r"}]}], " ", "-", " ", "mB"}], ")"}], " ", 
         RowBox[{"pB", "[", 
          RowBox[{"v", ",", " ", "r"}], "]"}]}]}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"cont", " ", "=", " ", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", " ", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"pP", "[", 
               RowBox[{"v", ",", " ", "r"}], "]"}], " ", 
              RowBox[{"pB", "[", 
               RowBox[{"v", ",", " ", "r"}], "]"}]}], ",", " ", "v"}], 
            "]"}]}], " ", "+", " ", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"fV", " ", 
              RowBox[{"pP", "[", 
               RowBox[{"v", ",", " ", "r"}], "]"}], " ", 
              RowBox[{"pB", "[", 
               RowBox[{"v", ",", " ", "r"}], "]"}]}], " ", "-", " ", 
             RowBox[{
              RowBox[{"qQ", "[", 
               RowBox[{"v", ",", " ", "r"}], "]"}], " ", 
              RowBox[{"qB", "[", 
               RowBox[{"v", ",", " ", "r"}], "]"}]}]}], ",", " ", "r"}], 
           "]"}]}], ")"}], " ", "/.", " ", 
        RowBox[{"radV", "[", 
         RowBox[{"1", "/", "2"}], "]"}]}], " ", "/.", " ", "radVb"}], "]"}]}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WV-2\>\"", ",", 
      " ", "\"\<(Rust LV-4, LV-5; Python YV-2) the conservation of the \
charge: d_v (2 |P|^2) + d_r (f |P|^2 - |Q|^2) = 0 \\\nexactly for every \
solution of (V1), (V2), for an arbitrary function M(v) (the conjugates of P, \
Q are independent functions \\\nthat solve the conjugate equations; M, m, \
lambda real)\>\"", ",", " ", 
      RowBox[{"zeroQ", "[", "cont", "]"}], ",", " ", 
      RowBox[{"\"\<residual \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"InputForm", "[", "cont", "]"}], "]"}]}]}], "]"}], 
    ";"}]}]}]], "Input",
 CellLabel->
  "In[326]:=",ExpressionUUID->"31e0d8d7-3322-438b-852b-5c352629e5a9"],

