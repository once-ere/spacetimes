Cell[CellGroupData[{

Cell["\<\
9. The worked examples (Parts II and III, Appendices A and B)\
\>", "Chapter",ExpressionUUID->"8f0c2fbe-0c4c-41c8-b600-7af1dfdcf8a7"],

Cell[TextData[{
 "The manuscript illustrates its objects with explicit examples, chosen so \
that every number is a simple fraction. This chapter checks them exactly. In \
the code: ",
 StyleBox["mll[xi]",
  FontFamily->"Source Code Pro"],
 " is the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Times]", "2"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "78f168cc-8ceb-4d35-88a3-487223d3dc56"],
 " matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7660d6f3-1b31-460e-bd18-e6724b595f52"],
 " of a bi-quaternion with the coefficients ",
 StyleBox["xi",
  FontFamily->"Source Code Pro"],
 ", ",
 StyleBox["ndet",
  FontFamily->"Source Code Pro"],
 " the polarized determinant ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["N", "TI"], 
    StyleBox["LG",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c939fcc9-f3ed-49c9-a0ce-567f1676d89d"],
 ", ",
 StyleBox["dirac",
  FontFamily->"Source Code Pro"],
 " Lord's Dirac matrices of a set of four ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Times]", "2"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "21895600-bb51-43fe-aca1-1a5899799d12"],
 " matrices, ",
 StyleBox["lorentzOf",
  FontFamily->"Source Code Pro"],
 " the Lorentz matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["L",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f91b1893-61a0-4ba6-8946-d2fc8b01ff0c"],
 " of a unit bi-quaternion."
}], "Text",ExpressionUUID->"ebe0395f-e4f7-4988-9395-c17041fc6c8f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "the", " ", "symbols", " ", "that", " ", "the", " ", "code", " ", "of", " ",
     "this", " ", "chapter", " ", "creates", " ", "live", " ", "in", " ", 
    "the", " ", "context", " ", "LGNB`Worked`", " ", 
    RowBox[{"(", 
     RowBox[{
     "the", " ", "code", " ", "is", " ", "that", " ", "of", " ", "the", " ", 
      "script", " ", 
      RowBox[{
       RowBox[{"wolfram", "/", "source"}], "/", 
       RowBox[{"lg_worked", ".", "wls"}]}]}], ")"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{"Begin", "[", "\"\<LGNB`Worked`\>\"", "]"}], ";"}]}]], "Input",
 CellLabel->
  "In[517]:=",ExpressionUUID->"fa3fbc68-ba80-4b86-b0d9-5169b3384afc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "the", " ", "helper", " ", "functions", " ", "of", " ", "the", " ", 
    "script", " ", 
    RowBox[{"lg_worked", ".", "wls"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"zeroQ", "[", "m_", "]"}], " ", ":=", " ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{"{", 
         RowBox[{"Simplify", "[", "m", "]"}], "}"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{"#", " ", "===", " ", "0"}], " ", "&"}]}], "]"}]}], ";"}], 
   "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "matrices", " ", "of", " ", "the", " ", "manuscript"}], ",", 
     " ", 
     RowBox[{"written", " ", "again"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"sig", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", " ", 
       RowBox[{"PauliMatrix", "[", "1", "]"}], ",", " ", 
       RowBox[{"PauliMatrix", "[", "2", "]"}], ",", " ", 
       RowBox[{"PauliMatrix", "[", "3", "]"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"eps", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "0"}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"bar", "[", "x_", "]"}], " ", ":=", " ", 
     RowBox[{"-", 
      RowBox[{"eps", " ", ".", " ", 
       RowBox[{"Transpose", "[", "x", "]"}], " ", ".", " ", "eps"}]}]}], 
    ";"}], "                                    ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Lord", "'"}], "s", " ", 
      RowBox[{"(", "1.2", ")"}]}], ",", " ", 
     RowBox[{"the", " ", "adjugate"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"mll", "[", "xi_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"xi", "[", 
        RowBox[{"[", "1", "]"}], "]"}], " ", 
       RowBox[{"sig", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], " ", "-", " ", 
      RowBox[{"I", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"xi", "[", 
           RowBox[{"[", "2", "]"}], "]"}], " ", 
          RowBox[{"sig", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], " ", "+", " ", 
         RowBox[{
          RowBox[{"xi", "[", 
           RowBox[{"[", "3", "]"}], "]"}], " ", 
          RowBox[{"sig", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], " ", "+", " ", 
         RowBox[{
          RowBox[{"xi", "[", 
           RowBox[{"[", "4", "]"}], "]"}], " ", 
          RowBox[{"sig", "[", 
           RowBox[{"[", "4", "]"}], "]"}]}]}], ")"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"ndet", "[", 
      RowBox[{"x_", ",", " ", "y_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Det", "[", 
          RowBox[{"x", " ", "+", " ", "y"}], "]"}], " ", "-", " ", 
         RowBox[{"Det", "[", "x", "]"}], " ", "-", " ", 
         RowBox[{"Det", "[", "y", "]"}]}], ")"}], "/", "2"}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"dirac", "[", "s_", "]"}], " ", ":=", " ", 
     RowBox[{"ArrayFlatten", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "s"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"bar", "[", "s", "]"}], ",", " ", "0"}], "}"}]}], "}"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"eta", " ", "=", " ", 
     RowBox[{"DiagonalMatrix", "[", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", 
        RowBox[{"-", "1"}], ",", " ", 
        RowBox[{"-", "1"}], ",", " ", 
        RowBox[{"-", "1"}]}], "}"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gam", " ", "=", " ", 
     RowBox[{"dirac", " ", "/@", " ", "sig"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"herm", "[", "m_", "]"}], " ", ":=", " ", 
     RowBox[{"ConjugateTranspose", "[", "m", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"lorentzOf", "[", "mg_", "]"}], " ", ":=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Re", "[", 
        RowBox[{
         RowBox[{"Tr", "[", 
          RowBox[{
           RowBox[{"sig", "[", 
            RowBox[{"[", "p", "]"}], "]"}], " ", ".", " ", "mg", " ", ".", 
           " ", 
           RowBox[{"sig", "[", 
            RowBox[{"[", "q", "]"}], "]"}], " ", ".", " ", 
           RowBox[{"herm", "[", "mg", "]"}]}], "]"}], "/", "2"}], "]"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"p", ",", " ", "4"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"q", ",", " ", "4"}], "}"}]}], "]"}]}], ";"}]}]}]], "Input",
 CellLabel->
  "In[518]:=",ExpressionUUID->"755ac83b-dd88-4cef-95ae-6009e2922c2d"],

Cell[CellGroupData[{

Cell["WW-1: a change of representation by a boost", "Section",ExpressionUUID->"0f0939a4-daee-4bb4-8cd1-59ac84b78c9d"],

Cell[TextData[{
 "The unit bi-quaternion ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["g",
     FontWeight->"Bold",
     FontSlant->"Plain"], "\[LongEqual]", 
    FractionBox["5", "4"], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "0"], "+", 
    FractionBox["3", "4"], 
    StyleBox["i", "TI"], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "3"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1884b842-ba80-444d-9ae3-8f920f9e23aa"],
 " is a boost along the third axis with the velocity ",
 Cell[BoxData[
  FormBox[
   FractionBox["15", "17"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e2c6d095-f9a9-4140-b6a6-a0d5aa295f21"],
 " (its Lorentz matrix has the entries ",
 Cell[BoxData[
  FormBox[
   FractionBox["17", "8"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2244cee3-21b6-4245-b4ec-6bc68387cc54"],
 " and ",
 Cell[BoxData[
  FormBox[
   FractionBox["15", "8"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "052401ce-74c7-4686-8bf0-eae51fa9ac39"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox["17", "8"], ")"}], "2"], "-", 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox["15", "8"], ")"}], "2"], "\[LongEqual]", "1"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "244ac797-db39-42fc-a0fe-be76e77897da"],
 "). Its matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["S", "TI"], "\[LongEqual]", 
    StyleBox["diag",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      FractionBox["1", "2"], ",", "2"}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ffa329a0-c0ec-4f0e-afa6-6ed20a5c5f64"],
 " changes Lord's matrices into ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["diag",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      FractionBox["1", "4"], ",", "4"}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b8bbfd3a-299f-4d08-9035-8ec4ae5970a5"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Sigma]", "1", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3de4e87f-0e82-4939-a412-4de26d5982f2"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Sigma]", "2", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ffece752-f5bc-466b-91d1-7672f4a6996c"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["diag",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      FractionBox["1", "4"], ",", 
      RowBox[{"-", "4"}]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7f0c9c85-90d3-4984-818c-f6653d808209"],
 ". The check verifies, exactly, that the new set is Hermitian with the right \
polarized determinants, that its Dirac matrices are those of the old set \
conjugated by the spinor matrix of the boost, that they equal the old ones \
combined with the inverse Lorentz matrix, and that the new set is the frame \
",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     FractionBox["17", "8"], ",", "0", ",", "0", ",", 
     RowBox[{"-", 
      FractionBox["15", "8"]}]}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e3b58a60-42ff-4669-a8ae-f2cff9e5ff63"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "1", ",", "0", ",", "0"}], ")"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "360304ad-0fe1-4ea2-87fe-2665535cb9eb"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "0", ",", "1", ",", "0"}], ")"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "730ef1e2-4141-4b9e-afa6-64ea3faab857"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["15", "8"]}], ",", "0", ",", "0", ",", 
     FractionBox["17", "8"]}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7d558a0f-0a48-4360-99d1-1923f806e0cd"],
 " of M31, whose time vector moves with the velocity ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    FractionBox["15", "17"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ac7e9906-28bd-4ada-9bf6-3e5e0ce4486d"],
 "."
}], "Text",ExpressionUUID->"3214c528-ba64-4982-8a86-a8d32c50952b"],

