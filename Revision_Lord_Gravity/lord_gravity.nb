                 "id256"}]}], "]"}], " ", "===", " ", 
             RowBox[{"ConstantArray", "[", 
              RowBox[{"0", ",", " ", 
               RowBox[{"{", 
                RowBox[{"256", ",", " ", "256"}], "}"}]}], "]"}]}]}]}], "]"}],
          ",", " ", 
         RowBox[{"{", 
          RowBox[{"m", ",", " ", "4"}], "}"}]}], "]"}], ",", " ", "TrueQ"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WA-3\>\"", ",", 
      " ", "\"\<(Rust AN-3; Python YA-3) gamma^0 gamma^mu T^3 P is symmetric \
and P^dag (gamma^0 gamma^mu T^3) P = \\\n-(gamma^0 gamma^mu T^3)^T; in the \
Fock space of eight modes (exact, b = 3/7 + 2i/5) {Psi_i, Psi_j^dag} = (1 + \
|b|^2) delta_ij, \\\n{Psi_i, Psi_j} = 0 and J[Psi] = (1 + |b|^2) J[chi] up to \
a multiple of the identity\>\"", ",", " ", 
      RowBox[{
      "sym", " ", "&&", " ", "nrm", " ", "&&", " ", "car1", " ", "&&", " ", 
       "car2", " ", "&&", " ", "curr"}], ",", "\n", "  ", 
      RowBox[{"\"\<symmetric \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", "sym", "]"}], " ", "<>", 
       " ", "\"\<, normal part \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", "nrm", "]"}], " ", "<>", 
       " ", "\"\<, anticommutators \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"car1", " ", "&&", " ", "car2"}], "]"}], " ", "<>", "\n", 
       "   ", "\"\<, currents \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", "curr", "]"}]}]}], "]"}], ";"}]}]}]], "Input",\

 CellLabel->
  "In[500]:=",ExpressionUUID->"ce4607cd-a250-465f-ac34-182a03d08c2b"],

Cell[BoxData["\<\"PASS WA-3     (Rust AN-3; Python YA-3) gamma^0 gamma^mu T^3 \
P is symmetric and P^dag (gamma^0 gamma^mu T^3) P = -(gamma^0 gamma^mu \
T^3)^T; in the Fock space of eight modes (exact, b = 3/7 + 2i/5) {Psi_i, \
Psi_j^dag} = (1 + |b|^2) delta_ij, {Psi_i, Psi_j} = 0 and J[Psi] = (1 + \
|b|^2) J[chi] up to a multiple of the identity [symmetric True, normal part \
True, anticommutators True, currents True]\"\>"], "Print",
