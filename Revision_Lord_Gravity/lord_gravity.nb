Cell[BoxData["\<\"PASS WT-2     (Python YT-2) the Painleve-Gullstrand \
observers u = d_t - (2M/r)^(1/2) d_r are unit and geodesic; the geodesic \
deviation -R^a_{b c d} u^b u^d in their frame is diag(2M/r^3, -M/r^3, \
-M/r^3); r = ((9M/2)(tau0 - tau)^2)^(1/3) solves (dr/dtau)^2 = 2M/r; kappa = \
(mu M/r^3)/(mu^3 alpha^4) = 2/(9 T^2) with T = (tau0 - tau) mu alpha^2; r = \
2M at T_h = (4/3) M mu alpha^2 [frame True (A_rr = (2*mm)/rr^3, A_thth = \
-(mm/rr^3)), radius True, kappa 2/(9*T^2), horizon True]\"\>"], "Print",
 CellChangeTimes->{4.004398282474126*^9},
 CellLabel->
  "During evaluation of \
In[411]:=",ExpressionUUID->"8f025a02-ebf9-4627-8262-ef4bd0da5059"]
