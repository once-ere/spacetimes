        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", 
           RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sigbar", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"sig", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
       RowBox[{"-", 
        RowBox[{"sig", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", 
       RowBox[{"-", 
        RowBox[{"sig", "[", 
         RowBox[{"[", "3", "]"}], "]"}]}], ",", " ", 
       RowBox[{"-", 
        RowBox[{"sig", "[", 
         RowBox[{"[", "4", "]"}], "]"}]}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gam", " ", "=", " ", 
     RowBox[{"Table", "[", 
