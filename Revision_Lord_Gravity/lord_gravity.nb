            RowBox[{"s", " ", "m", " ", "n"}], "}"}]}], " ", "=", " ", 
          RowBox[{
           RowBox[{"d_m", " ", 
            RowBox[{"Gamma", "^", "a_"}], 
            RowBox[{"{", 
             RowBox[{"n", " ", "s"}], "}"}]}], " ", "-", " ", 
