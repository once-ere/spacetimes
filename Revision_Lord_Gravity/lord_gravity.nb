Cell[CellGroupData[{

Cell["WA-3: the quantized field and its zeugon current", "Section",ExpressionUUID->"d2f988b5-4863-4053-9577-236c1ffaab35"],

Cell[TextData[{
 "The quantized field of eight modes lives in a Fock space of dimension ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["2", "8"], "\[LongEqual]", "256"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dd1b7d01-fd16-4505-b1d2-03a0ddd3d1d8"],
 ", built with the construction of Jordan and Wigner, in exact rational \
arithmetic with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["b", "TI"], 
     StyleBox["LG",
      FontSlant->"Plain"], 
     StyleBox["qp",
      FontSlant->"Plain"]], "\[LongEqual]", 
    FractionBox["3", "7"], "+", 
    FractionBox["2", "5"], 
    StyleBox["i", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8a48d138-1e6c-4471-92f1-1db0580bcdb5"],
 ". The check shows that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPsi]", "\[LongEqual]", "\[Chi]", "+", 
    SubsuperscriptBox[
     StyleBox["b", "TI"], 
     StyleBox["LG",
      FontSlant->"Plain"], 
     StyleBox["qp",
      FontSlant->"Plain"]], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["P",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LG",
      FontSlant->"Plain"]], 
    SuperscriptBox["\[Chi]", "\[Dagger]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7bae2737-4325-4dfb-bac1-14e507451ef2"],
 " has the anticommutators of a free field up to the factor ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "+", "|", 
    SubsuperscriptBox[
     StyleBox["b", "TI"], 
     StyleBox["LG",
      FontSlant->"Plain"], 
     StyleBox["qp",
      FontSlant->"Plain"]], 
    SuperscriptBox["|", "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d8cda4ea-d8a1-4fab-a674-171a222a7a70"],
 ", and that its zeugon current is exactly ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "+", "|", 
    SubsuperscriptBox[
     StyleBox["b", "TI"], 
     StyleBox["LG",
      FontSlant->"Plain"], 
     StyleBox["qp",
      FontSlant->"Plain"]], 
    SuperscriptBox["|", "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "54d33295-95d8-4cc9-a46f-a685ed96dda8"],
 " times that of ",
 Cell[BoxData[
  FormBox["\[Chi]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3f1e042d-3961-42d8-b9dc-619563080ae9"],
 ", up to a constant: the current contains no term that creates or destroys \
two quasi-particles, so the zeugon cannot make two quasi-particles of \
opposite charge annihilate unless they are a particle and its own \
antiparticle."
}], "Text",ExpressionUUID->"46f5655c-5302-4340-9fe9-02a0941fa40e"],

