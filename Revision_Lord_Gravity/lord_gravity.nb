       RowBox[{"{", 
        RowBox[{"mm", " ", "->", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"okAntiOff", " ", "=", " ", 
     RowBox[{"witnessQ", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"thetaV", " ", "-", " ", 
          RowBox[{"Transpose", "[", "thetaV", "]"}]}], ")"}], "/", "2"}], ",",
        " ", "offRules", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"t", " ", "->", " ", 
          RowBox[{"1", "/", "2"}]}], ",", " ", 
         RowBox[{"x", " ", "->", " ", 
          RowBox[{"1", "/", "3"}]}], ",", " ", 
         RowBox[{"y", " ", "->", " ", 
          RowBox[{"1", "/", "5"}]}], ",", " ", 
         RowBox[{"z", " ", "->", " ", 
          RowBox[{"1", "/", "7"}]}]}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WG-5\>\"", ",", 
      " ", "\"\<(Rust G-13; Python YG-6) the energy-momentum tensor of the \
brochon from the variation of the action e \\\n[i/2 (psi-bar gamma^mu \
nabla_mu psi - (nabla_mu psi)-bar gamma^mu psi) - m psi-bar psi] with respect \
to the tetrad, at \\\nfirst order about flat space-time (e_a^mu = delta + eps \
h_{a mu}, sixteen symbolic functions h; symbolic psi and psi-bar): \\\nthe \
symmetric part of Theta_{mu nu} = (dS/de_a^mu) eta_{a nu} is exactly T_{mu \
nu} = i/4 (psi-bar gamma_mu d_nu psi + \\\npsi-bar gamma_nu d_mu psi - d_mu \
psi-bar gamma_nu psi - d_nu psi-bar gamma_mu psi) - eta_{mu nu} L, off shell; \
the \\\nantisymmetric part is not zero off shell and vanishes on a solution \
(two plane waves of mass 3)\>\"", ",", "\n", "  ", 
      RowBox[{
      "okSym", " ", "&&", " ", "okShellEq", " ", "&&", " ", "okAnti", " ", "&&",
        " ", "okAntiOff"}], ",", "\n", "  ", 
