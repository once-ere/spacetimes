Cell[CellGroupData[{

Cell["3. The brochon in the Schwarzschild field (Part IV)", "Chapter",ExpressionUUID->"66424fa6-b274-4269-ad7b-f9b710af302c"],

Cell[TextData[{
 "Part IV solves the Dirac equation of a particle of the mass ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6ed1d39a-6f20-4787-a57a-c116896f9545"],
 " (one isospin component of the brochon) around a Schwarzschild black hole \
of the mass ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["\[ScriptCapitalM]",
      FontSlant->"Plain"], 
     StyleBox["LG",
      FontSlant->"Plain"]], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "148cb62a-a547-4721-8819-129f09a08923"],
 " (the horizon at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r", "TI"], "\[LongEqual]", "2"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1486be21-3342-42e9-ab1d-27266d76ad08"],
 "; units ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["N",
      FontSlant->"Plain"]], "\[LongEqual]", 
    StyleBox["c", "TI"], "\[LongEqual]", "\[HBar]", "\[LongEqual]", "1"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6aef483f-cd47-4119-8978-bf03908c9459"],
 "), with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["f", "TI"], 
     StyleBox["LG",
      FontSlant->"Plain"]], "\[LongEqual]", "1", "-", "2", "/", 
    StyleBox["r", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ce868bb4-46c4-4370-ae35-288fb589fdc5"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["w", "TI"], 
     StyleBox["LG",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"2", "/", 
       StyleBox["r", "TI"]}], ")"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3d9252cc-e801-4e53-817e-d79a19f65ea0"],
 ". Because the black hole is spherical, the equation separates. The angular \
dependence is that of the hydrogen atom: the angular functions ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Alpha]", 
     StyleBox["LG",
      FontSlant->"Plain"]], 
    RowBox[{"(", "\[Theta]", ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "96a90258-3366-4ba5-9152-a5d8929e21aa"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Beta]", 
     StyleBox["LG",
      FontSlant->"Plain"]], 
    RowBox[{"(", "\[Theta]", ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8059dfc6-036f-4224-bcb3-204ed51e6882"],
 " obey (18.4), with the total angular momentum ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["j", "TI"], 
    StyleBox["LG",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dff3ee74-6522-43b4-923a-5817b4ab7074"],
 ", its component ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    RowBox[{
     StyleBox["j", "TI"], ",", 
     StyleBox["LG",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1e122937-059b-4b64-a52e-cc95628cf4da"],
 " and the separation constant ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Lambda]", 
     StyleBox["LG",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"\[PlusMinus]", 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["j", "TI"], 
        StyleBox["LG",
         FontSlant->"Plain"]], "+", 
       FractionBox["1", "2"]}], ")"}]}]}], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6fbf8925-5807-4982-b067-16103f116ced"],
 ". Two radial functions remain. In the static tetrad they are ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["\[ScriptCapitalU]",
     FontSlant->"Plain"], 
    StyleBox["LG",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b97c83ed-57bf-4193-9dc3-d3e867bf2c4a"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["\[ScriptCapitalV]",
     FontSlant->"Plain"], 
    StyleBox["LG",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7785828c-d804-416c-93ea-4362e50edf3d"],
 " and obey (18.7); in the freely falling tetrad they are ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["\[ScriptCapitalP]",
     FontSlant->"Plain"], 
    StyleBox["LG",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "91dbd4ee-b95e-48b2-9ea0-9f48a501c324"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["\[ScriptCapitalQ]",
     FontSlant->"Plain"], 
    StyleBox["LG",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3d8576b9-f302-4a3d-91ab-724c08eb6822"],
 " and obey (18.5), which is regular at the horizon:"
}], "Text",ExpressionUUID->"942c13ac-e86a-4120-b091-2ceaf142fc3c"],

