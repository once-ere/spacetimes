         RowBox[{"I", "/", "2"}], " ", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"qV", " ", ".", " ", 
             RowBox[{"gUV", "[", 
              RowBox[{"[", "m", "]"}], "]"}], " ", ".", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"D", "[", 
                RowBox[{"pV", ",", " ", 
                 RowBox[{"XV", "[", 
                  RowBox[{"[", "m", "]"}], "]"}]}], "]"}], " ", "+", " ", 
               RowBox[{
                RowBox[{"spcV", "[", 
                 RowBox[{"[", "m", "]"}], "]"}], " ", ".", " ", "pV"}]}], 
              ")"}]}], " ", "-", "\n", "        ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"D", "[", 
                RowBox[{"qV", ",", " ", 
                 RowBox[{"XV", "[", 
                  RowBox[{"[", "m", "]"}], "]"}]}], "]"}], " ", "-", " ", 
               RowBox[{"qV", " ", ".", " ", 
                RowBox[{"spcV", "[", 
                 RowBox[{"[", "m", "]"}], "]"}]}]}], ")"}], " ", ".", " ", 
             RowBox[{"gUV", "[", 
              RowBox[{"[", "m", "]"}], "]"}], " ", ".", " ", "pV"}]}], ",", 
           " ", 
           RowBox[{"{", 
            RowBox[{"m", ",", " ", "4"}], "}"}]}], "]"}]}], " ", "-", " ", 
        RowBox[{"mm", " ", 
         RowBox[{"qV", " ", ".", " ", "pV"}]}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"lag1", " ", "=", " ", 
     RowBox[{"Expand", "[", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{"lagV", ",", " ", "eps"}], "]"}], " ", "/.", " ", 
       RowBox[{"eps", " ", "->", " ", "0"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"varV", " ", "=", " ", 
