      RowBox[{"2", ",", " ", "x"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ang2", " ", "=", " ", 
     RowBox[{"2", " ", "Pi", " ", 
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"p2", "[", "x", "]"}], "^", "2"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"x", ",", " ", 
          RowBox[{"-", "1"}], ",", " ", "1"}], "}"}]}], "]"}]}]}], ";", " ", 
    RowBox[{"ang3", " ", "=", " ", 
     RowBox[{"2", " ", "Pi", " ", 
      RowBox[{"Integrate", "[", 
       RowBox[{
