           RowBox[{"r", ",", " ", "0", ",", " ", "Infinity"}], "}"}]}], "]"}],
         "/", 
        RowBox[{"kk", "^", "3"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WT-3\>\"", ",", 
      " ", "\"\<(Python YT-3) f = kappa (r^3/3 + r^2/2) solves the equation \
of Dalgarno and Lewis for psi_1 = f P_2 psi_0, \\\nand E = -1/2 - (15/2) \
kappa^2 - (153/2) kappa^3 + O(kappa^4) (E_2 = <psi_0|V|psi_1>, E_3 = \
<psi_1|V|psi_1>)\>\"", ",", "\n", "  ", 
      RowBox[{"okDL", " ", "&&", " ", 
       RowBox[{"e2", " ", "===", " ", 
