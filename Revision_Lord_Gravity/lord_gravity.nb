    RowBox[{"the", " ", "coupling"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"closed", "[", 
      RowBox[{"l_", ",", " ", "lp_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Which", "[", 
      RowBox[{
       RowBox[{"l", " ", "==", " ", "lp"}], ",", " ", 
