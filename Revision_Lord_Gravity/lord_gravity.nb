            RowBox[{
             RowBox[{"2", " ", "l"}], " ", "-", " ", "1"}], ")"}], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", " ", "l"}], " ", "+", " ", "3"}], ")"}]}], 
          ")"}]}]}], ",", "\n", "   ", 
       RowBox[{"lp", " ", "==", " ", 
        RowBox[{"l", " ", "+", " ", "2"}]}], ",", " ", 
       RowBox[{
        RowBox[{"3", "/", "2"}], " ", 
        RowBox[{"(", 
         RowBox[{"l", " ", "+", " ", "1"}], ")"}], " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"l", " ", "+", " ", "2"}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", " ", "l"}], " ", "+", " ", "3"}], ")"}], " ", 
           RowBox[{"Sqrt", "[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"2", " ", "l"}], " ", "+", " ", "1"}], ")"}], " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"2", " ", "l"}], " ", "+", " ", "5"}], ")"}]}], 
            "]"}]}], ")"}]}]}], ",", " ", "True", ",", " ", "0"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"a", " ", "3"}], "-", 
        RowBox[{
        "j", " ", "symbol", " ", "whose", " ", "three", " ", "angular", " ", 
         "momenta", " ", "violate", " ", "the", " ", "triangle", " ", 
         "condition"}]}], " ", "|", 
       RowBox[{"l", " ", "-", " ", 
        RowBox[{"l", "'"}]}], "|", " ", 
       RowBox[{"<=", " ", "2", " ", "<=", " ", 
        RowBox[{"l", " ", "+", " ", 
         RowBox[{
          RowBox[{"l", "'"}], " ", "is", " ", "0"}]}]}]}], ";", " ", 
      RowBox[{
      "it", " ", "is", " ", "set", " ", "to", " ", "0", "\n", "   ", "here", " ",
        "without", " ", "calling", " ", "ThreeJSymbol"}]}], ",", " ", 
     RowBox[{
     "which", " ", "returns", " ", "0", " ", "as", " ", "well", " ", "but", " ",
       "prints", " ", "the", " ", "message", " ", 
      RowBox[{"ClebschGordan", "::", "tri"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"for", " ", "l"}], " ", "=", " ", 
          RowBox[{
           RowBox[{"l", "'"}], " ", "=", " ", "0"}]}], ";", "\n", "   ", 
         RowBox[{
         "the", " ", "first", " ", "version", " ", "of", " ", "this", " ", 
          "script", " ", "printed", " ", "it"}]}], ",", " ", 
        RowBox[{"request", " ", "349"}]}], ")"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"threej", "[", 
      RowBox[{"l_", ",", " ", "lp_"}], "]"}], " ", ":=", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"l", " ", "-", " ", "lp"}], "]"}], " ", "<=", " ", "2", " ", 
        "<=", " ", 
        RowBox[{"l", " ", "+", " ", "lp"}]}], ",", " ", 
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", " ", "l"}], " ", "+", " ", "1"}], ")"}], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", " ", "lp"}], " ", "+", " ", "1"}], ")"}]}], "]"}], " ", 
        RowBox[{
         RowBox[{"ThreeJSymbol", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"l", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"2", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"lp", ",", " ", "0"}], "}"}]}], "]"}], "^", "2"}]}], ",", 
       " ", "0"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"bad1", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"l", ",", " ", "lp", ",", " ", 
             RowBox[{"FullSimplify", "[", 
              RowBox[{
               RowBox[{"threej", "[", 
                RowBox[{"l", ",", " ", "lp"}], "]"}], " ", "-", " ", 
               RowBox[{"closed", "[", 
