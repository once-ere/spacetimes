   RowBox[{
    RowBox[{
     RowBox[{"dsl", "[", 
      RowBox[{"{", 
       RowBox[{"a_", ",", " ", "b_"}], "}"}], "]"}], " ", ":=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"gp", " ", ".", " ", "a"}], ",", " ", 
       RowBox[{"-", 
        RowBox[{"gp", " ", ".", " ", "b"}]}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"cm", "[", 
      RowBox[{"{", 
       RowBox[{"a_", ",", " ", "b_"}], "}"}], "]"}], " ", ":=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"pm", " ", ".", " ", 
        RowBox[{"conjv", "[", "b", "]"}]}], ",", " ", 
       RowBox[{"pm", " ", ".", " ", 
        RowBox[{"conjv", "[", "a", "]"}]}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"res", "[", "bb_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"chi", " ", "=", " ", 
          RowBox[{"{", 
           RowBox[{"uvec", ",", " ", 
            RowBox[{"ConstantArray", "[", 
             RowBox[{"0", ",", " ", "8"}], "]"}]}], "}"}]}], ",", " ", "psi", 
         ",", " ", "lhs", ",", " ", "w", ",", " ", "rhs"}], "}"}], ",", "\n", 
       "   ", 
       RowBox[{
        RowBox[{"psi", " ", "=", " ", 
         RowBox[{"chi", " ", "+", " ", 
          RowBox[{"bb", " ", 
           RowBox[{"cm", "[", "chi", "]"}]}]}]}], ";", "\n", "   ", 
        RowBox[{"lhs", " ", "=", " ", 
         RowBox[{
          RowBox[{"dsl", "[", "psi", "]"}], " ", "-", " ", 
          RowBox[{"mm", " ", "psi"}], " ", "-", " ", 
          RowBox[{"dd", " ", 
           RowBox[{"cm", "[", "psi", "]"}]}]}]}], ";", "\n", "   ", 
        RowBox[{"w", " ", "=", " ", 
         RowBox[{
          RowBox[{"dsl", "[", "chi", "]"}], " ", "-", " ", 
          RowBox[{"ee", " ", "chi"}]}]}], ";", "\n", "   ", 
        RowBox[{"rhs", " ", "=", " ", 
         RowBox[{"w", " ", "-", " ", 
          RowBox[{"bb", " ", 
           RowBox[{"cm", "[", "w", "]"}]}]}]}], ";", "\n", "   ", 
        RowBox[{"Simplify", "[", 
         RowBox[{
          RowBox[{"ComplexExpand", "[", 
           RowBox[{"Flatten", "[", 
            RowBox[{"lhs", " ", "-", " ", "rhs"}], "]"}], "]"}], ",", " ", 
