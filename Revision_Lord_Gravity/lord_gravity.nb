          RowBox[{"wPG", ",", " ", "1", ",", " ", "0", ",", " ", "0"}], "}"}],
          ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0", ",", " ", "r", ",", " ", "0"}], "}"}], ",",
          " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0", ",", " ", "0", ",", " ", 
           RowBox[{"r", " ", 
            RowBox[{"Sin", "[", "th", "]"}]}]}], "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"tau", ",", " ", "r", ",", " ", "th", ",", " ", "ph"}], "}"}],
        ",", "\n", "   ", 
       RowBox[{
        RowBox[{"Simplify", "[", 
         RowBox[{"#", ",", " ", 
          RowBox[{
           RowBox[{"r", " ", ">", " ", "0"}], " ", "&&", " ", 
           RowBox[{"0", " ", "<", " ", "th", " ", "<", " ", "Pi"}]}]}], "]"}],
         " ", "&"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"radP", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Derivative", "[", "1", "]"}], "[", "pP", "]"}], "[", "r", 
         "]"}], " ", "->", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"I", " ", "om"}], " ", "-", " ", 
              RowBox[{"wPG", "/", 
               RowBox[{"(", 
                RowBox[{"4", " ", "r"}], ")"}]}]}], ")"}], " ", 
            RowBox[{"pP", "[", "r", "]"}]}], " ", "-", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"I", " ", 
               RowBox[{"lam", "/", "r"}]}], " ", "+", " ", "mB"}], ")"}], " ", 
            RowBox[{"qQ", "[", "r", "]"}]}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"1", " ", "-", " ", "wPG"}], ")"}]}]}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Derivative", "[", "1", "]"}], "[", "qQ", "]"}], "[", "r", 
         "]"}], " ", "->", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"I", " ", 
               RowBox[{"lam", "/", "r"}]}], " ", "-", " ", "mB"}], ")"}], " ", 
            RowBox[{"pP", "[", "r", "]"}]}], " ", "+", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "I"}], " ", "om"}], " ", "+", " ", 
              RowBox[{"wPG", "/", 
               RowBox[{"(", 
                RowBox[{"4", " ", "r"}], ")"}]}]}], ")"}], " ", 
            RowBox[{"qQ", "[", "r", "]"}]}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"1", " ", "+", " ", "wPG"}], ")"}]}]}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"prefP", " ", "=", " ", 
     RowBox[{
      RowBox[{"r", "^", 
       RowBox[{"-", "1"}]}], " ", 
      RowBox[{
       RowBox[{"Sin", "[", "th", "]"}], "^", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "/", "2"}], ")"}]}], " ", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "I"}], " ", "om", " ", "tau"}], " ", "+", " ", 
        RowBox[{"I", " ", "mj", " ", "ph"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"psiP", " ", "=", " ", 
     RowBox[{"prefP", " ", 
      RowBox[{"sH", " ", ".", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "I"}], " ", 
          RowBox[{"qQ", "[", "r", "]"}], " ", 
          RowBox[{"aA", "[", "th", "]"}]}], ",", " ", 
         RowBox[{"I", " ", 
          RowBox[{"pP", "[", "r", "]"}], " ", 
          RowBox[{"bB", "[", "th", "]"}]}], ",", " ", 
         RowBox[{
          RowBox[{"pP", "[", "r", "]"}], " ", 
          RowBox[{"aA", "[", "th", "]"}]}], ",", " ", 
         RowBox[{
          RowBox[{"qQ", "[", "r", "]"}], " ", 
          RowBox[{"bB", "[", "th", "]"}]}]}], "}"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"resP", " ", "=", " ", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"dirac", "[", 
            RowBox[{"geoP", ",", " ", "psiP", ",", " ", "mB"}], "]"}], " ", "/.",
            " ", "angRules"}], " ", "/.", " ", "radP"}], ")"}], "/", 
        "prefP"}], ",", " ", 
       RowBox[{
        RowBox[{"r", " ", ">", " ", "0"}], " ", "&&", " ", 
        RowBox[{"0", " ", "<", " ", "th", " ", "<", " ", "Pi"}]}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WS-2\>\"", ",", 
      " ", "\"\<(Rust LS-2; Python YS-2) the separation in the freely falling \
tetrad: the spinor r^(-1) sin(th)^(-1/2) \\\ne^(-i omega tau + i m_j ph) S_H \
(-i Q A, i P B, P A, Q B) solves the Dirac equation exactly when A, B solve \
(A) and P, Q \\\nsolve (PG), for every r > 0 (the identity holds on both \
sides of the horizon)\>\"", ",", " ", 
