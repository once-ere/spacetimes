           RowBox[{"2", " ", "l"}], " ", "+", " ", "3"}], ")"}]}]}], ",", " ", 
       RowBox[{"j", " ", "==", " ", "l"}], ",", " ", "2", ",", " ", "True", ",",
        " ", 
       RowBox[{
        RowBox[{"-", "2"}], " ", 
        RowBox[{
         RowBox[{"(", 
