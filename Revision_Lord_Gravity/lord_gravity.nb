                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{
                    "--", " ", 
                    "WC"}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]\
}]}]}]}]}]}], "-", "2"}], ":", " ", 
    RowBox[{"the", " ", "accretion", " ", "limit"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"fq", " ", "=", " ", 
     RowBox[{"1", " ", "-", " ", 
      RowBox[{"2", "/", "r"}], " ", "+", " ", 
      RowBox[{"q2", "/", 
       RowBox[{"r", "^", "2"}]}]}]}], ";"}], "    ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"M", " ", "=", " ", "1"}], ",", " ", 
     RowBox[{"q2", " ", "=", " ", 
      RowBox[{"Qg", "^", "2"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"W", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", " ", "-", " ", 
         RowBox[{"x", "/", "r"}]}], ")"}], "^", "2"}], " ", "-", " ", 
      "fq"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rp", " ", "=", " ", 
     RowBox[{"1", " ", "+", " ", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"1", " ", "-", " ", "q2"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"idA", " ", "=", " ", 
     RowBox[{"Simplify", "[", 
      RowBox[{"Expand", "[", 
       RowBox[{
        RowBox[{"W", " ", 
         RowBox[{"r", "^", "2"}]}], " ", "-", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", " ", 
           RowBox[{"(", 
            RowBox[{"1", " ", "-", " ", "x"}], ")"}], " ", "r"}], " ", "+", 
          " ", 
          RowBox[{"x", "^", "2"}], " ", "-", " ", "q2"}], ")"}]}], "]"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"idB", " ", "=", " ", 
     RowBox[{"Simplify", "[", 
      RowBox[{"Expand", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"W", " ", 
           RowBox[{"r", "^", "2"}]}], " ", "/.", " ", 
          RowBox[{"r", " ", "->", " ", "rp"}]}], ")"}], " ", "-", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"rp", " ", "-", " ", "x"}], ")"}], "^", "2"}]}], "]"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", "decision"}], ",", " ", 
     RowBox[{
      RowBox[{"for", " ", "six", " ", "charges", " ", 
       RowBox[{"Qg", "^", "2"}]}], " ", "=", " ", "0"}], ",", " ", 
     RowBox[{"1", "/", "4"}], ",", " ", 
     RowBox[{"1", "/", "2"}], ",", " ", 
     RowBox[{"9", "/", "16"}], ",", " ", 
     RowBox[{"3", "/", "4"}], ",", " ", 
     RowBox[{
      RowBox[{"99", "/", "100"}], ":", " ", 
      RowBox[{
       RowBox[{"Reduce", " ", "finds", " ", "the", " ", "x"}], " ", ">", " ", 
       
       RowBox[{"0", " ", "for", " ", "which", " ", "W", " ", 
        RowBox[{"r", "^", "2"}]}], " ", ">=", " ", 
       RowBox[{"0", " ", "at", "\n", "   ", "every", " ", "r"}], " ", ">=", 
       " ", 
       RowBox[{"r_", "+"}]}]}], ",", " ", 
     RowBox[{
      RowBox[{
      "and", " ", "the", " ", "answer", " ", "must", " ", "be", " ", "0"}], 
      " ", "<", " ", "x", " ", "<=", " ", "1"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"decs", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Reduce", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"ForAll", "[", 
           RowBox[{"r", ",", " ", 
            RowBox[{"r", " ", ">=", " ", 
             RowBox[{"(", 
              RowBox[{"rp", " ", "/.", " ", 
               RowBox[{"q2", " ", "->", " ", "c"}]}], ")"}]}], ",", " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"W", " ", 
                RowBox[{"r", "^", "2"}]}], " ", "/.", " ", 
               RowBox[{"q2", " ", "->", " ", "c"}]}], ")"}], " ", ">=", " ", 
             "0"}]}], "]"}], " ", "&&", " ", 
          RowBox[{"x", " ", ">", " ", "0"}]}], ",", " ", "x", ",", " ", 
         "Reals"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"c", ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", 
           RowBox[{"1", "/", "4"}], ",", " ", 
           RowBox[{"1", "/", "2"}], ",", " ", 
           RowBox[{"9", "/", "16"}], ",", " ", 
           RowBox[{"3", "/", "4"}], ",", " ", 
           RowBox[{"99", "/", "100"}]}], "}"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"okDec", " ", "=", " ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{"decs", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Simplify", "[", 
          RowBox[{"Equivalent", "[", 
           RowBox[{"#", ",", " ", 
            RowBox[{"0", " ", "<", " ", "x", " ", "<=", " ", "1"}]}], "]"}], 
          "]"}], " ", "===", " ", "True"}], " ", "&"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WC-2\>\"", ",", 
      " ", "\"\<(Rust LC-1; Python YC-2) W r^2 = 2 (1 - x) r + x^2 - Qg^2 and \
W(r_+) r_+^2 = (r_+ - x)^2 (M = 1); and for \\\nQg^2 = 0, 1/4, 1/2, 9/16, \
3/4, 99/100 Reduce decides that W >= 0 for every r >= r_+ exactly when 0 < x \
<= M\>\"", ",", "\n", "  ", 
      RowBox[{
       RowBox[{"idA", " ", "===", " ", "0"}], " ", "&&", " ", 
       RowBox[{"idB", " ", "===", " ", "0"}], " ", "&&", " ", "okDec"}], ",", 
      "\n", "  ", 
      RowBox[{"\"\<identities \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"InputForm", "[", 
         RowBox[{"{", 
          RowBox[{"idA", ",", " ", "idB"}], "}"}], "]"}], "]"}], " ", "<>", 
       " ", "\"\<; Reduce: \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"InputForm", "[", "decs", "]"}], "]"}]}]}], "]"}], 
    ";"}]}]}]], "Input",
 CellLabel->
  "In[387]:=",ExpressionUUID->"9b8e65ec-4327-4031-83ee-22b922bda2a1"],

Cell[BoxData["\<\"PASS WC-2     (Rust LC-1; Python YC-2) W r^2 = 2 (1 - x) r \
+ x^2 - Qg^2 and W(r_+) r_+^2 = (r_+ - x)^2 (M = 1); and for Qg^2 = 0, 1/4, \
1/2, 9/16, 3/4, 99/100 Reduce decides that W >= 0 for every r >= r_+ exactly \
when 0 < x <= M [identities {0, 0}; Reduce: {Inequality[0, Less, x, \
LessEqual, 1], Inequality[0, Less, x, LessEqual, 1], Inequality[0, Less, x, \
LessEqual, 1], Inequality[0, Less, x, LessEqual, 1], Inequality[0, Less, x, \
LessEqual, 1], Inequality[0, Less, x, LessEqual, 1]}]\"\>"], "Print",
 CellChangeTimes->{4.004398282375257*^9},
 CellLabel->
