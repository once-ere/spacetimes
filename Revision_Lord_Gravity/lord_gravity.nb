Cell[BoxData["\<\"PASS WG-4     (Rust G-10, G-15; Python YG-4, YG-7) g = \
Omega^2 eta with Omega = exp(phi(x)), phi a symbolic function, coframe Omega \
delta, spinor of four symbolic functions: Dslash (Omega^{-3/2} psi) = \
Omega^{-5/2} dslash psi (the massless brochon is conformally invariant); \
Dslash Dslash psi = Box psi - R/4 psi (Lichnerowicz), not Box psi - R/2 psi \
(Lord's printed coefficient); R is not zero [conformal True, -R/4 True, -R/2 \
fails True, R != 0 True]\"\>"], "Print",
 CellChangeTimes->{4.004398247161234*^9},
 CellLabel->
  "During evaluation of \
In[136]:=",ExpressionUUID->"0b4d50e2-b267-4bb4-a1e8-fe84a9838dc7"]
