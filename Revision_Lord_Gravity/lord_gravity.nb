               RowBox[{"s", " ", "==", " ", "1"}], ",", " ", 
               RowBox[{
                RowBox[{"1", "/", 
                 RowBox[{"m", "^", "2"}]}], " ", 
                RowBox[{"iv", "[", "\"\<ir3\>\"", "]"}], " ", 
                RowBox[{
                 RowBox[{"s12", "[", 
