Cell[CellGroupData[{

Cell["\<\
6. A black hole that carries the charge of the zeugon (Part VI, Section 30)\
\>", "Chapter",ExpressionUUID->"3b7bbbf9-8f21-4f3b-81ad-45b0de8a922c"],

Cell[TextData[{
 "A black hole can swallow quasi-particles of one zeugon charge more than of \
the other and so acquire a charge ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["Q", "TI"], 
    StyleBox["LG",
     FontSlant->"Plain"], 
    StyleBox["Z",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2fc92a3f-9559-4af5-849c-c73658f9c9fb"],
 ". Its field is that of Reissner and Nordstrom, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["f", "TI"], 
     StyleBox["LG",
      FontSlant->"Plain"], 
     StyleBox["RN",
      FontSlant->"Plain"]], "\[LongEqual]", "1", "-", "2", 
    SubscriptBox[
     StyleBox["\[ScriptCapitalM]",
      FontSlant->"Plain"], 
     StyleBox["LG",
      FontSlant->"Plain"]], "/", 
    StyleBox["r", "TI"], "+", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["\[ScriptCapitalQ]",
        FontSlant->"Plain"], 
       StyleBox["LG",
        FontSlant->"Plain"], 
       StyleBox["Z",
        FontSlant->"Plain"]], ")"}], "2"], "/", 
    SuperscriptBox[
     StyleBox["r", "TI"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "83607e67-c68b-422d-9576-21e71e57431b"],
 ", with the charge measured as a length ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalQ]",
      FontSlant->"Plain"], 
     StyleBox["LG",
      FontSlant->"Plain"], 
     StyleBox["Z",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["G", "TI"], 
        StyleBox["N",
         FontSlant->"Plain"]], "/", "4", "\[Pi]"}], ")"}], 
     RowBox[{"1", "/", "2"}]], 
    SubsuperscriptBox[
     StyleBox["Q", "TI"], 
     StyleBox["LG",
      FontSlant->"Plain"], 
     StyleBox["Z",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "23da6f98-e97a-40a6-a8f1-db77c77e8657"],
 " in the normalization of the zeugon field of the manuscript (30.1). This \
chapter checks the geometry, the limit that selective accretion sets to the \
charge, and the size of the shadow of such a black hole."
}], "Text",ExpressionUUID->"17aa8cbf-04dc-4d06-990c-ea1d5f6363d2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
