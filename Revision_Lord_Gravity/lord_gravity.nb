         "]"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"r2", " ", "=", " ", 
     RowBox[{"res", "[", 
      RowBox[{
       RowBox[{"-", "dd"}], "/", 
       RowBox[{"(", 
        RowBox[{"ee", " ", "+", " ", "mm"}], ")"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"c2", " ", "=", " ", 
     RowBox[{"res", "[", 
      RowBox[{"dd", "/", 
       RowBox[{"(", 
        RowBox[{"ee", " ", "+", " ", "mm"}], ")"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ok2", " ", "=", " ", 
     RowBox[{
      RowBox[{"AllTrue", "[", 
