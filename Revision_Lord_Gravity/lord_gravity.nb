Cell[CellGroupData[{

Cell["\<\
4. The brochon around a black hole whose mass changes (Part V)\
\>", "Chapter",ExpressionUUID->"3611fbe3-de38-437f-8811-086c920649dc"],

Cell[TextData[{
 "Part V puts the brochon into the ingoing Vaidya space-time, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], 
    SuperscriptBox[
     StyleBox["s", "TI"], "2"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["f", "TI"], 
     StyleBox["LG",
      FontSlant->"Plain"]], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    SuperscriptBox[
     StyleBox["v", "TI"], "2"], "-", "2", "\[ThinSpace]", 
    StyleBox["dv", "TI"], "\[ThinSpace]", 
    StyleBox["dr", "TI"], "-", 
    SuperscriptBox[
     StyleBox["r", "TI"], "2"], 
    StyleBox["d", "TI"], 
    SuperscriptBox["\[CapitalOmega]", "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4d9c87fb-a242-4c5b-b474-b4917f1fe85c"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["f", "TI"], 
     StyleBox["LG",
      FontSlant->"Plain"]], "\[LongEqual]", "1", "-", "2", 
    SubscriptBox[
     StyleBox["\[ScriptCapitalM]",
      FontSlant->"Plain"], 
     StyleBox["LG",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubscriptBox[
      StyleBox["v", "TI"], 
      StyleBox["LG",
       FontSlant->"Plain"]], ")"}], "/", 
    StyleBox["r", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "edb1d193-6508-416a-a648-a87764325d23"],
 ", the field of a black hole that grows or shrinks (Chapter 2, WG-3). It \
uses a coframe that is regular across the horizon, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], "0"], "\[LongEqual]", 
    FractionBox["1", "2"], 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      SubscriptBox[
       StyleBox["f", "TI"], 
       StyleBox["LG",
        FontSlant->"Plain"]]}], ")"}], "\[ThinSpace]", 
    StyleBox["dv", "TI"], "-", 
    StyleBox["dr", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c9761b37-1aa8-4c65-bfdb-52ed02114ef8"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], "1"], "\[LongEqual]", 
    FractionBox["1", "2"], 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      SubscriptBox[
       StyleBox["f", "TI"], 
       StyleBox["LG",
        FontSlant->"Plain"]]}], ")"}], "\[ThinSpace]", 
    StyleBox["dv", "TI"], "+", 
    StyleBox["dr", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a4f910a4-5c9e-4467-81e2-92f70b55c898"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], "2"], "\[LongEqual]", 
    StyleBox["r", "TI"], "\[ThinSpace]", 
    StyleBox["d", "TI"], "\[Theta]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dab1f56d-dd4d-492b-b25b-bcab6a8b7672"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], "3"], "\[LongEqual]", 
    StyleBox["r", "TI"], "\[ThinSpace]", 
    StyleBox["sin",
     FontSlant->"Plain"], "\[ThinSpace]", "\[Theta]", "\[ThinSpace]", 
    StyleBox["d", "TI"], "\[CurlyPhi]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d88a3ec9-1f4f-4e49-9174-69c7143be105"],
 ". The Dirac equation then reduces to two equations for two functions ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalP]",
      FontSlant->"Plain"], 
     StyleBox["LG",
      FontSlant->"Plain"], 
     StyleBox["V",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["v", "TI"], 
       StyleBox["LG",
        FontSlant->"Plain"]], ",", 
      StyleBox["r", "TI"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "73ab0ca0-7f8b-48a1-9834-41ae8d6acf54"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalQ]",
      FontSlant->"Plain"], 
     StyleBox["LG",
      FontSlant->"Plain"], 
     StyleBox["V",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["v", "TI"], 
       StyleBox["LG",
        FontSlant->"Plain"]], ",", 
      StyleBox["r", "TI"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8a4a1668-dc90-408d-9fb2-068e55ebce36"],
 ": an evolution equation in the advanced time (24.2) and a constraint in the \
radius (24.3),"
}], "Text",ExpressionUUID->"3f82abd6-bac6-456a-ab2f-a7ee7d3ebdac"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[PartialD]", 
    StyleBox["v", "TI"]], 
   StyleBox["P", "TI"], "\[LongEqual]", 
   RowBox[{"(", 
    RowBox[{
     FractionBox[
      StyleBox["M", "TI"], 
      StyleBox["r", "TI"]], "-", 
     FractionBox["1", "2"]}], ")"}], 
   SubscriptBox["\[PartialD]", 
    StyleBox["r", "TI"]], 
   StyleBox["P", "TI"], "-", 
   FractionBox[
    StyleBox["M", "TI"], 
    RowBox[{"2", 
     SuperscriptBox[
      StyleBox["r", "TI"], "2"]}]], 
   StyleBox["P", "TI"], "-", 
   RowBox[{"(", 
    RowBox[{
     FractionBox[
      RowBox[{
       StyleBox["i", "TI"], "\[Lambda]"}], 
      RowBox[{"2", 
       StyleBox["r", "TI"]}]], "+", 
     FractionBox[
      StyleBox["m", "TI"], "2"]}], ")"}], 
   StyleBox["Q", "TI"], ",", "      ", 
   SubscriptBox["\[PartialD]", 
    StyleBox["r", "TI"]], 
   StyleBox["Q", "TI"], "\[LongEqual]", 
   RowBox[{"(", 
    RowBox[{
     FractionBox[
      RowBox[{
       StyleBox["i", "TI"], "\[Lambda]"}], 
      StyleBox["r", "TI"]], "-", 
     StyleBox["m", "TI"]}], ")"}], 
   StyleBox["P", "TI"], "."}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"59a53492-b30d-4702-8de4-b57d8afb61c8"],

Cell[TextData[{
 "In the code the advanced time is ",
 StyleBox["v",
  FontFamily->"Source Code Pro"],
 ", the mass function of the black hole ",
 StyleBox["bhM[v]",
  FontFamily->"Source Code Pro"],
 ", the mass of the brochon ",
 StyleBox["mB",
  FontFamily->"Source Code Pro"],
 ", and the radial functions ",
 StyleBox["pP",
  FontFamily->"Source Code Pro"],
 ", ",
 StyleBox["qQ",
  FontFamily->"Source Code Pro"],
 "."
}], "Text",ExpressionUUID->"ddf13a71-3554-498e-87e9-37b9079807ce"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "the", " ", "symbols", " ", "that", " ", "the", " ", "code", " ", "of", " ",
     "this", " ", "chapter", " ", "creates", " ", "live", " ", "in", " ", 
    "the", " ", "context", " ", "LGNB`Vaidya`", " ", 
