Cell[CellGroupData[{

Cell["WT-2: the tidal field along the fall", "Section",ExpressionUUID->"f590fe90-83da-4bb7-a24d-b54a6512f3c4"],

Cell[TextData[{
 "The observers of the Painleve-Gullstrand coordinates fall freely from rest \
far away. The check verifies that they are geodesic and that their proper \
time is the coordinate time; that the tidal tensor (the geodesic deviation) \
in their frame is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["diag",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{"2", 
      SubscriptBox[
       StyleBox["\[ScriptCapitalM]",
        FontSlant->"Plain"], 
       StyleBox["LG",
        FontSlant->"Plain"]], "/", 
      SuperscriptBox[
       StyleBox["r", "TI"], "3"], ",", 
      RowBox[{"-", 
       SubscriptBox[
        StyleBox["\[ScriptCapitalM]",
         FontSlant->"Plain"], 
        StyleBox["LG",
         FontSlant->"Plain"]]}], "/", 
      SuperscriptBox[
       StyleBox["r", "TI"], "3"], ",", 
      RowBox[{"-", 
       SubscriptBox[
        StyleBox["\[ScriptCapitalM]",
         FontSlant->"Plain"], 
        StyleBox["LG",
         FontSlant->"Plain"]]}], "/", 
      SuperscriptBox[
       StyleBox["r", "TI"], "3"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ad2d13b5-cc8d-464f-9881-85277f317b23"],
 ", stretching along the radius and squeezing across; and that along their \
path ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["r", "TI"], "3"], "\[LongEqual]", 
    FractionBox["9", "2"], 
    SubscriptBox[
     StyleBox["\[ScriptCapitalM]",
      FontSlant->"Plain"], 
     StyleBox["LG",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox["\[Tau]", 
        StyleBox["LG",
         FontSlant->"Plain"], 
        StyleBox["end",
         FontSlant->"Plain"]], "-", 
       SubscriptBox["\[Tau]", 
        StyleBox["LG",
         FontSlant->"Plain"]]}], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a0385b02-2948-412c-b939-25329a0b8ab8"],
 ". In the atomic units of the pair the tidal strength is then ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Kappa]", 
     StyleBox["LG",
      FontSlant->"Plain"], 
     StyleBox["tid",
      FontSlant->"Plain"]], "\[LongEqual]", "2", "/", 
    RowBox[{"(", 
     RowBox[{"9", 
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox[
         StyleBox["T", "TI"], 
         StyleBox["LG",
          FontSlant->"Plain"], 
         StyleBox["fall",
          FontSlant->"Plain"]], ")"}], "2"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "58e8b58d-fd11-4f6d-8157-e118a836a68d"],
 ", where ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["LG",
     FontSlant->"Plain"], 
    StyleBox["fall",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a17b102b-e8de-44bb-a172-546c10ff794f"],
 " is the proper time that is left before the centre would be reached: the \
same for every black hole. The mass of the black hole decides only when the \
horizon is crossed, at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["LG",
      FontSlant->"Plain"], 
     StyleBox["fall",
      FontSlant->"Plain"]], "\[LongEqual]", 
    FractionBox["4", "3"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[ScriptCapitalM]",
       FontSlant->"Plain"], "~"], 
     StyleBox["LG",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "82c5a71f-39d5-4445-900b-9be9d78079ef"],
 "."
}], "Text",ExpressionUUID->"fef374d3-5eb9-4616-bd09-4b5ab9cf2cff"],

