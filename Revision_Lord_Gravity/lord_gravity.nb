    RowBox[{
     RowBox[{"cop", "[", "i_", "]"}], " ", ":=", " ", 
     RowBox[{"KroneckerProduct", " ", "@@", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Which", "[", 
         RowBox[{
          RowBox[{"k", " ", "<", " ", "i"}], ",", " ", "zop", ",", " ", 
