Cell["WS-3: the two descriptions are the same field", "Section",ExpressionUUID->"a403b863-a0c3-4173-a35e-cd4c061d3e08"],

Cell[TextData[{
 "Outside the horizon both systems describe the brochon, so they must be \
related by the change of tetrad and of time coordinate. The check shows that \
if ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["\[ScriptCapitalU]",
     FontSlant->"Plain"], 
    StyleBox["LG",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a6d7a095-cc5c-49c2-9d01-e670102583f7"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["\[ScriptCapitalV]",
     FontSlant->"Plain"], 
    StyleBox["LG",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1d55bea2-ce48-4626-a9fc-0f97f9152ed2"],
 " solve (18.7), then ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["\[ScriptCapitalP]",
      FontSlant->"Plain"], 
     StyleBox["LG",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "-", 
       SubscriptBox[
        StyleBox["w", "TI"], 
        StyleBox["LG",
         FontSlant->"Plain"]]}], ")"}], 
     RowBox[{
      RowBox[{"-", "1"}], "/", "2"}]], 
    StyleBox["a", "TI"], "\[ThinSpace]", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      StyleBox["i", "TI"], 
      SubsuperscriptBox["\[Omega]", 
       StyleBox["LG",
        FontSlant->"Plain"], 
       StyleBox["S",
        FontSlant->"Plain"]], 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[Tau]", 
         StyleBox["LG",
          FontSlant->"Plain"]], "-", 
        StyleBox["t", "TI"]}], ")"}]}]]}], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e315fdf2-df6d-4d13-b52a-6e14b4fb6547"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["\[ScriptCapitalQ]",
      FontSlant->"Plain"], 
     StyleBox["LG",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "+", 
       SubscriptBox[
        StyleBox["w", "TI"], 
        StyleBox["LG",
         FontSlant->"Plain"]]}], ")"}], 
     RowBox[{
      RowBox[{"-", "1"}], "/", "2"}]], 
    StyleBox["b", "TI"], "\[ThinSpace]", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      StyleBox["i", "TI"], 
      SubsuperscriptBox["\[Omega]", 
       StyleBox["LG",
        FontSlant->"Plain"], 
       StyleBox["S",
        FontSlant->"Plain"]], 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[Tau]", 
         StyleBox["LG",
          FontSlant->"Plain"]], "-", 
        StyleBox["t", "TI"]}], ")"}]}]]}], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6d235a40-9d5c-4cb4-96a7-b46f2c7565c4"],
 ", with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["\[ScriptCapitalU]",
        FontSlant->"Plain"], 
       StyleBox["LG",
        FontSlant->"Plain"]], "-", 
      StyleBox["i", "TI"], 
      SubscriptBox[
       StyleBox["\[ScriptCapitalV]",
        FontSlant->"Plain"], 
       StyleBox["LG",
        FontSlant->"Plain"]]}], ")"}], "/", "2"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cce6f3b3-fe72-4fbc-b5b5-5e0a044fea07"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["b", "TI"], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["\[ScriptCapitalU]",
        FontSlant->"Plain"], 
       StyleBox["LG",
        FontSlant->"Plain"]], "+", 
      StyleBox["i", "TI"], 
      SubscriptBox[
       StyleBox["\[ScriptCapitalV]",
        FontSlant->"Plain"], 
       StyleBox["LG",
        FontSlant->"Plain"]]}], ")"}], "/", "2"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ccd65031-a2c2-41d8-8b39-745859d2b544"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[Tau]", 
       StyleBox["LG",
        FontSlant->"Plain"]], "-", 
      StyleBox["t", "TI"]}], ")"}], "/", 
    StyleBox["dr", "TI"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["w", "TI"], 
     StyleBox["LG",
      FontSlant->"Plain"]], "/", 
    SubscriptBox[
     StyleBox["f", "TI"], 
     StyleBox["LG",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "97416c27-1baf-4ff6-9358-8cc110de2db8"],
 ", solve (18.5). The square roots are handled by writing everything in terms \
of the two positive numbers ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "-", 
      SubscriptBox[
       StyleBox["w", "TI"], 
       StyleBox["LG",
        FontSlant->"Plain"]]}], ")"}], 
    RowBox[{"1", "/", "2"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5c971a74-c73f-4343-b203-2cf016344b91"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "+", 
      SubscriptBox[
       StyleBox["w", "TI"], 
       StyleBox["LG",
        FontSlant->"Plain"]]}], ")"}], 
    RowBox[{"1", "/", "2"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "230d9968-98e7-42c7-a7b8-ccab81fc9ec9"],
 " (in the code ",
 StyleBox["aa",
  FontFamily->"Source Code Pro"],
 " and ",
 StyleBox["bb",
  FontFamily->"Source Code Pro"],
 "), whose squares add up to 2, and reducing the numerators modulo that \
relation."
}], "Text",ExpressionUUID->"29e666f4-312d-44a8-b073-46f95ac920cf"],

