                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{
                    "--", " ", 
                    "WL"}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]\
}]}]}]}]}]}], "-", "5"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"sT", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", " ", "+", " ", 
          RowBox[{"t", "^", "3"}]}], ",", " ", "t"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"t", "^", "2"}], ",", " ", "1"}], "}"}]}], "}"}]}], ";"}], 
   "                                         ", 
   RowBox[{"(*", " ", 
    RowBox[{"det", " ", "=", " ", 
     RowBox[{"1", " ", "for", " ", "every", " ", "real", " ", "t"}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"s4", "[", "m_", "]"}], " ", ":=", " ", 
     RowBox[{"ArrayFlatten", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"m", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", 
          RowBox[{"Inverse", "[", 
           RowBox[{"Transpose", "[", "m", "]"}], "]"}]}], "}"}]}], "}"}], 
      "]"}]}], ";"}], "          ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"diag", 
      RowBox[{"(", 
       RowBox[{"S", ",", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"S", "^", "dag"}], ")"}], "^", 
         RowBox[{"{", 
          RowBox[{"-", "1"}], "}"}]}]}], ")"}]}], ";", " ", 
     RowBox[{"S", " ", "real", " ", "for", " ", "real", " ", "t"}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"yY", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"y1", ",", " ", "y2"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"y3", ",", " ", 
         RowBox[{"-", "y1"}]}], "}"}]}], "}"}]}], ";", " ", 
    RowBox[{"yYd", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"yc1", ",", " ", "yc3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"yc2", ",", " ", 
         RowBox[{"-", "yc1"}]}], "}"}]}], "}"}]}], ";"}], "          ", 
   RowBox[{"(*", " ", 
    RowBox[{"Y", " ", "and", " ", 
     RowBox[{"Y", "^", "dag"}], " ", "with", " ", "independent", " ", 
     "symbols"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"gC", " ", "=", " ", 
     RowBox[{"ArrayFlatten", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"yY", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", 
          RowBox[{"-", "yYd"}]}], "}"}]}], "}"}], "]"}]}], ";"}], 
   "                               ", 
   RowBox[{"(*", " ", 
    RowBox[{
    "a", " ", "constant", " ", "element", " ", "of", " ", "the", " ", 
     "Lorentz", " ", "algebra"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"psiT", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"f1", "[", "t", "]"}], ",", " ", 
       RowBox[{"f2", "[", "t", "]"}], ",", " ", 
       RowBox[{"f3", "[", "t", "]"}], ",", " ", 
       RowBox[{"f4", "[", "t", "]"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"tt", " ", "=", " ", 
     RowBox[{"s4", "[", "sT", "]"}]}], ";", " ", 
    RowBox[{"tti", " ", "=", " ", 
     RowBox[{"Inverse", "[", "tt", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rhs5", " ", "=", " ", 
     RowBox[{"tt", " ", ".", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{"psiT", ",", " ", "t"}], "]"}], " ", "-", " ", 
        RowBox[{"gC", " ", ".", " ", "psiT"}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gOK", " ", "=", " ", 
     RowBox[{
      RowBox[{"tt", " ", ".", " ", "gC", " ", ".", " ", "tti"}], " ", "+", 
      " ", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{"tt", ",", " ", "t"}], "]"}], " ", ".", " ", "tti"}]}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"gPR", " ", "=", " ", 
     RowBox[{
      RowBox[{"tt", " ", ".", " ", "gC", " ", ".", " ", "tti"}], " ", "+", 
      " ", 
      RowBox[{"tt", " ", ".", " ", 
       RowBox[{"D", "[", 
        RowBox[{"tti", ",", " ", "t"}], "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"okCov", " ", "=", " ", 
     RowBox[{"zeroQ", "[", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"tt", " ", ".", " ", "psiT"}], ",", " ", "t"}], "]"}], " ", "-",
        " ", 
       RowBox[{"gOK", " ", ".", " ", 
        RowBox[{"(", 
         RowBox[{"tt", " ", ".", " ", "psiT"}], ")"}]}], " ", "-", " ", 
       "rhs5"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"badPR", " ", "=", " ", 
     RowBox[{"Not", "[", 
      RowBox[{"zeroQ", "[", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"tt", " ", ".", " ", "psiT"}], ",", " ", "t"}], "]"}], " ", 
        "-", " ", 
        RowBox[{"gPR", " ", ".", " ", 
         RowBox[{"(", 
          RowBox[{"tt", " ", ".", " ", "psiT"}], ")"}]}], " ", "-", " ", 
        "rhs5"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WL-5\>\"", ",", 
      " ", "\"\<(Rust L4-2, L4-3; Python YL-4, YL-4b) for S(t) = ((1 + t^3, \
t), (t^2, 1)) (determinant 1), a constant \\\nGamma = diag(Y, -Y^dag) of the \
Lorentz algebra and a spinor of four symbolic functions: D = d - Gamma is \
covariant with \\\nGamma' = S Gamma S^{-1} + (dS) S^{-1}, and not with the \
printed inhomogeneous term S (d S^{-1})\>\"", ",", " ", 
      RowBox[{"okCov", " ", "&&", " ", "badPR"}], ",", "\n", "  ", 
      RowBox[{"\"\<corrected law covariant \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", "okCov", "]"}], " ", "<>", 
       " ", "\"\<, printed law not covariant \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", "badPR", "]"}]}]}], "]"}], ";"}]}]}]], "Input",\

 CellLabel->"In[47]:=",ExpressionUUID->"208b074b-4a02-4555-adb1-92936c2750af"],

Cell[BoxData["\<\"PASS WL-5     (Rust L4-2, L4-3; Python YL-4, YL-4b) for \
S(t) = ((1 + t^3, t), (t^2, 1)) (determinant 1), a constant Gamma = diag(Y, \
-Y^dag) of the Lorentz algebra and a spinor of four symbolic functions: D = d \
- Gamma is covariant with Gamma' = S Gamma S^{-1} + (dS) S^{-1}, and not with \
the printed inhomogeneous term S (d S^{-1}) [corrected law covariant True, \
printed law not covariant True]\"\>"], "Print",
 CellChangeTimes->{4.0043982467295437`*^9},
