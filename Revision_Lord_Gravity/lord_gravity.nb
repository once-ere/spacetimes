Cell[CellGroupData[{

Cell["WP-1: the levels of the pair to the order alpha^4", "Section",ExpressionUUID->"0306710d-75d3-4d55-be42-0082628ae583"],

Cell[TextData[{
 "For every state with principal number ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LessEqual]", "3"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6e699fdc-89ab-4237-a36b-8a86d8f43c36"],
 " the check computes the coefficient of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["m", "TI"], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[Alpha]", 
       StyleBox["LG",
        FontSlant->"Plain"], 
       StyleBox["Z",
        FontSlant->"Plain"]], ")"}], "4"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4da500c3-22aa-403c-8e92-1c6d21dbe31c"],
 " of the shift, without and with the annihilation term, from the radial \
functions of hydrogen (",
 StyleBox["LaguerreL",
  FontFamily->"Source Code Pro"],
 ") by exact integration, and compares it with the exact rational numbers \
that the Python program wrote into the file ",
 StyleBox["data/lg_pair_levels.csv",
  FontFamily->"Source Code Pro"],
 " (in the closed cell above). The function ",
 StyleBox["ints",
  FontFamily->"Source Code Pro"],
 " computes the integrals of the radial function that the operators need, ",
 StyleBox["level",
  FontFamily->"Source Code Pro"],
 " adds the terms of the Hamiltonian, and ",
 StyleBox["s12",
  FontFamily->"Source Code Pro"],
 " is the expectation value of the tensor force between the two spins."
}], "Text",ExpressionUUID->"96f2f793-8181-41b1-aab4-8cd3d446e9b0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", 
          RowBox[{"--", 
           RowBox[{"--", 
            RowBox[{"--", 
             RowBox[{"--", 
              RowBox[{"--", 
               RowBox[{"--", 
                RowBox[{"--", 
                 RowBox[{"--", 
                  RowBox[{"--", 
                   RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{
                    "--", " ", 
                    "WP"}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]\
}]}]}]}]}]}], "-", "1"}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "the", " ", "normalized", " ", "radial", " ", "function", " ", "of", " ", 
     "the", " ", "hydrogen"}], "-", 
    RowBox[{
    "like", " ", "state", " ", "n", " ", "l", " ", "with", " ", "the", " ", 
     "Bohr", " ", "radius", " ", "1"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"rad", "[", 
      RowBox[{"n_", ",", " ", "l_"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"2", "/", "n"}], ")"}], "^", "3"}], " ", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"n", " ", "-", " ", "l", " ", "-", " ", "1"}], ")"}], 
          "!"}], "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "n", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"n", " ", "+", " ", "l"}], ")"}], "!"}]}], ")"}]}]}], 
       "]"}], " ", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "rr"}], "/", "n"}], "]"}], " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", " ", 
         RowBox[{"rr", "/", "n"}]}], ")"}], "^", "l"}], " ", 
      RowBox[{"LaguerreL", "[", 
       RowBox[{
        RowBox[{"n", " ", "-", " ", "l", " ", "-", " ", "1"}], ",", " ", 
        RowBox[{
         RowBox[{"2", " ", "l"}], " ", "+", " ", "1"}], ",", " ", 
        RowBox[{"2", " ", 
         RowBox[{"rr", "/", "n"}]}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"ints", "[", 
      RowBox[{"n_", ",", " ", "l_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"R", " ", "=", " ", 
          RowBox[{"rad", "[", 
           RowBox[{"n", ",", " ", "l"}], "]"}]}], ",", " ", "p4", ",", " ", 
         RowBox[{"en", " ", "=", " ", 
          RowBox[{
           RowBox[{"-", "1"}], "/", 
           RowBox[{"(", 
            RowBox[{"2", " ", 
             RowBox[{"n", "^", "2"}]}], ")"}]}]}]}], "}"}], ",", "\n", "   ", 
       
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<ir\>\"", " ", "->", " ", 
          RowBox[{"Integrate", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"R", "^", "2"}], " ", "rr"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"rr", ",", " ", "0", ",", " ", "Infinity"}], "}"}]}], 
           "]"}]}], ",", " ", 
         RowBox[{"\"\<ir2\>\"", " ", "->", " ", 
          RowBox[{"Integrate", "[", 
           RowBox[{
            RowBox[{"R", "^", "2"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"rr", ",", " ", "0", ",", " ", "Infinity"}], "}"}]}], 
           "]"}]}], ",", "\n", "    ", 
         RowBox[{"\"\<ir3\>\"", " ", "->", " ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"l", " ", ">", " ", "0"}], ",", " ", 
            RowBox[{"Integrate", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"R", "^", "2"}], "/", "rr"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"rr", ",", " ", "0", ",", " ", "Infinity"}], "}"}]}], 
             "]"}], ",", " ", "0"}], "]"}]}], ",", "\n", "    ", 
         RowBox[{"\"\<p0\>\"", " ", "->", " ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"l", " ", "==", " ", "0"}], ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"Limit", "[", 
               RowBox[{"R", ",", " ", 
                RowBox[{"rr", " ", "->", " ", "0"}]}], "]"}], "^", "2"}], "/", 
             RowBox[{"(", 
              RowBox[{"4", " ", "Pi"}], ")"}]}], ",", " ", "0"}], "]"}]}], ",",
          "\n", "    ", 
         RowBox[{"\"\<oo\>\"", " ", "->", " ", 
          RowBox[{"Integrate", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"2", " ", "rr", " ", 
              RowBox[{
               RowBox[{"D", "[", 
                RowBox[{"R", ",", " ", "rr"}], "]"}], "^", "2"}]}], " ", "+", 
             " ", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"l", " ", ">", " ", "0"}], ",", " ", 
               RowBox[{"l", " ", 
                RowBox[{"(", 
                 RowBox[{"l", " ", "+", " ", "1"}], ")"}], " ", 
                RowBox[{
                 RowBox[{"R", "^", "2"}], "/", "rr"}]}], ",", " ", "0"}], 
              "]"}]}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"rr", ",", " ", "0", ",", " ", "Infinity"}], "}"}]}], 
           "]"}]}]}], "|>"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"s12", "[", 
      RowBox[{"l_", ",", " ", "j_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Which", "[", 
      RowBox[{
       RowBox[{"l", " ", "==", " ", "0"}], ",", " ", "0", ",", " ", 
       RowBox[{"j", " ", "==", " ", 
        RowBox[{"l", " ", "+", " ", "1"}]}], ",", " ", 
