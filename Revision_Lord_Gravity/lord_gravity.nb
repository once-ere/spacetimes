Cell[CellGroupData[{

Cell["WS-6: the angular functions of j = 1/2", "Section",ExpressionUUID->"be3b268c-29aa-4b05-b1e2-c931391f9f77"],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["j", "TI"], 
     StyleBox["LG",
      FontSlant->"Plain"]], "\[LongEqual]", 
    FractionBox["1", "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "439b71f1-03ef-4589-bb20-1c7589d981c0"],
 " the angular functions have a closed form, for example ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Alpha]", 
     StyleBox["LG",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["sin",
      FontSlant->"Plain"], 
     RowBox[{"1", "/", "2"}]], "\[ThinSpace]", 
    FractionBox["\[Theta]", "2"], "\[ThinSpace]", 
    SuperscriptBox[
     StyleBox["cos",
      FontSlant->"Plain"], 
     RowBox[{"3", "/", "2"}]], "\[ThinSpace]", 
    FractionBox["\[Theta]", "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "858f69aa-c808-46bd-9e74-fad2af1efd0c"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Beta]", 
     StyleBox["LG",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubscriptBox["\[Lambda]", 
     StyleBox["LG",
      FontSlant->"Plain"]], "\[ThinSpace]", 
    SuperscriptBox[
     StyleBox["sin",
      FontSlant->"Plain"], 
     RowBox[{"3", "/", "2"}]], "\[ThinSpace]", 
    FractionBox["\[Theta]", "2"], "\[ThinSpace]", 
    SuperscriptBox[
     StyleBox["cos",
      FontSlant->"Plain"], 
     RowBox[{"1", "/", "2"}]], "\[ThinSpace]", 
    FractionBox["\[Theta]", "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fd8b278e-b316-40ea-81e4-153c1e99afc7"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], 
     RowBox[{
      StyleBox["j", "TI"], ",", 
      StyleBox["LG",
       FontSlant->"Plain"]}]], "\[LongEqual]", 
    FractionBox["1", "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8e9c94ac-adb6-43bb-9698-98f2ff9cf2e8"],
 " (18.6). The check verifies the four cases ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Lambda]", 
     StyleBox["LG",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"\[PlusMinus]", "1"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "54a89ece-477a-4eb6-8bbf-3f41720434d8"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], 
     RowBox[{
      StyleBox["j", "TI"], ",", 
      StyleBox["LG",
       FontSlant->"Plain"]}]], "\[LongEqual]", 
    RowBox[{"\[PlusMinus]", 
     FractionBox["1", "2"]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "750f8f4d-fad5-4570-b670-a09422c411f7"],
 " exactly, and that ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", 
    StyleBox["LG",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "de5af29b-e007-4e00-83d8-5f691a166957"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Beta]", 
    StyleBox["LG",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6e0437bc-2679-4c19-bd68-01ddb701a617"],
 " divided by ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      StyleBox["sin",
       FontSlant->"Plain"], "\[ThinSpace]", "\[Theta]"}], ")"}], 
    RowBox[{"1", "/", "2"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e6dd642d-3ad1-4d56-830c-76297b3981d8"],
 " are bounded at both poles (they become ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["cos",
     FontSlant->"Plain"], "\[ThinSpace]", 
    FractionBox["\[Theta]", "2"], "/", 
    SqrtBox["2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2307dd97-d526-44d6-a75d-61a3af061d0d"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["sin",
     FontSlant->"Plain"], "\[ThinSpace]", 
    FractionBox["\[Theta]", "2"], "/", 
    SqrtBox["2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3e17cf80-ab4e-4688-a7c6-789e4ffc9202"],
 " up to sign). In the code ",
 StyleBox["sS",
  FontFamily->"Source Code Pro"],
 " and ",
 StyleBox["cC",
  FontFamily->"Source Code Pro"],
 " are the sine and the cosine of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Theta]", "/", "2"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "234ef968-5d34-4669-84be-9df5f5ee536f"],
 "."
}], "Text",ExpressionUUID->"08254a3b-eb6a-498b-8ef3-06bbbb9fb672"],

