Cell[BoxData["\<\"PASS WG-1     (Rust G-4 to G-9; Python YG-2, YG-3) \
Schwarzschild, f = 1 - 2M/r, coframe e^0 = f^{1/2} dt, e^1 = f^{-1/2} dr, e^2 \
= r dth, e^3 = r sin(th) dph: Ricci tensor zero; Kretschmann invariant 48 \
M^2/r^6; Omega_t = M/(2 r^2) gamma^0 gamma^1, Omega_r = 0, Omega_th = 1/2 \
f^{1/2} gamma^1 gamma^2, Omega_ph = 1/2 (f^{1/2} sin(th) gamma^1 gamma^3 + \
cos(th) gamma^2 gamma^3); d_mu gamma^nu + Gamma^nu_{mu la} gamma^la + \
[Omega_mu, gamma^nu] = 0; spinor curvature = 1/4 R_{ab mu nu} gamma^{ab} (for \
every static, spherically symmetric tetrad diag(h(r), 1/h(r), r, r sin th) \
with a symbolic function h) [Ricci 0 True, Kretschmann True, Omega True, \
nabla gamma True, curvature True]\"\>"], "Print",
 CellChangeTimes->{4.0043982469523487`*^9},
