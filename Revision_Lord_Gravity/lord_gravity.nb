Cell[BoxData["\<\"PASS WL-1     (Rust L1-1 to L1-4, L1-7 to L1-10; Python \
YL-1) Lord's identities (1.2), (1.3), (1.5) (256 index combinations), (1.7), \
(1.10), (1.11), (1.12), (1.13) (both forms), (1.14), (1.15) and (1.17) hold \
exactly for his matrices [(1.2) True, (1.3) True, (1.5) True, (1.7) True, \
(1.10)-(1.14) True, (1.15) True, (1.17) True]\"\>"], "Print",
 CellChangeTimes->{4.004398246701315*^9},
