Cell[CellGroupData[{

Cell["WL-7: the curvature of the spinor connection", "Section",ExpressionUUID->"b6b040e1-5c7a-45c2-8052-f3bea46e6a37"],

Cell[TextData[{
 "The map ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Lambda]", 
    RowBox[{"(", 
     StyleBox["W", "TI"], ")"}], "\[LongEqual]", 
    FractionBox["1", "4"], 
    SubscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["ab", "TI"]], 
    SuperscriptBox["\[Gamma]", 
     StyleBox["ab", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "18c5d187-a5a9-4e12-a123-d9b5f36a61f7"],
 " takes an element of the Lorentz algebra (an antisymmetric ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["ab", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "eb40793b-aeff-4e3c-8ddd-b14e124434a5"],
 ") to a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"4", "\[Times]", "4"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a37f2304-699f-4d70-afbe-fed14cf7af64"],
 " matrix that acts on Dirac spinors. The check shows, for symbolic ",
 Cell[BoxData[
  FormBox[
   StyleBox["W", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f25f01ce-96f4-4e26-a46c-de672bd3713c"],
 ", that it acts on the Dirac matrices as the Lorentz algebra acts on \
vectors, and that it preserves commutators: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"[", 
     RowBox[{"\[Lambda]", 
      RowBox[{"(", 
       SubscriptBox[
        StyleBox["W", "TI"], "1"], ")"}], ",", "\[Lambda]", 
      RowBox[{"(", 
       SubscriptBox[
        StyleBox["W", "TI"], "2"], ")"}]}], "]"}], "\[LongEqual]", 
    "\[Lambda]", 
    RowBox[{"(", 
     RowBox[{"[", 
      RowBox[{
       SubscriptBox[
        StyleBox["W", "TI"], "1"], ",", 
       SubscriptBox[
        StyleBox["W", "TI"], "2"]}], "]"}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "245ac0a0-88b2-4e3e-80ab-103cac92fede"],
 ", a homomorphism of Lie algebras. It follows that the curvature of the \
spinor connection is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "4"], 
    SubscriptBox[
     StyleBox["R", "TI"], 
     RowBox[{
      StyleBox["ab", "TI"], "\[Mu]", "\[Nu]"}]], 
    SuperscriptBox["\[Gamma]", 
     StyleBox["ab", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "adce1d70-9b9d-4aa2-8ab9-77c1db7059a4"],
 ", where ",
 Cell[BoxData[
  FormBox[
   StyleBox["R", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "adfda6be-fe42-4f03-ab89-8ad3badda3fe"],
 " is the Riemann tensor; Lord prints ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], 
    StyleBox["R", "TI"], "\[Gamma]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2f9fd350-34e3-4829-9cc5-15df0786e901"],
 ", twice this. His two factors 2 (this one and that of WL-6) compensate each \
other only to first order in the fields."
}], "Text",ExpressionUUID->"a2fb4260-937f-481a-91b2-31c37ba3ea15"],

