   RowBox[{
    RowBox[{"gp", " ", "=", " ", 
     RowBox[{"dirac", " ", "/@", " ", "sp"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"lm", " ", "=", " ", 
