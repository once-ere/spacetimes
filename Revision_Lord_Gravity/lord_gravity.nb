                    "--", " ", 
                    "WT"}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]\
}]}]}]}]}]}], "-", "5"}], ":", " ", 
    RowBox[{"the", " ", "Gaussian", " ", "packet"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"solZ", " ", "=", " ", 
     RowBox[{"DSolve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"zf", "''"}], "[", "T", "]"}], " ", "==", " ", 
        RowBox[{"2", " ", 
         RowBox[{"(", 
          RowBox[{"2", "/", 
           RowBox[{"(", 
            RowBox[{"9", " ", 
             RowBox[{"T", "^", "2"}]}], ")"}]}], ")"}], " ", 
         RowBox[{"zf", "[", "T", "]"}]}]}], ",", " ", 
       RowBox[{"zf", "[", "T", "]"}], ",", " ", "T"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"solX", " ", "=", " ", 
     RowBox[{"DSolve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"xf", "''"}], "[", "T", "]"}], " ", "==", " ", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"(", 
           RowBox[{"2", "/", 
            RowBox[{"(", 
             RowBox[{"9", " ", 
              RowBox[{"T", "^", "2"}]}], ")"}]}], ")"}]}], " ", 
         RowBox[{"xf", "[", "T", "]"}]}]}], ",", " ", 
       RowBox[{"xf", "[", "T", "]"}], ",", " ", "T"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"T", "/", "T0"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"x1", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"1", "/", "5"}], " ", 
       RowBox[{"q", "^", 
        RowBox[{"(", 
         RowBox[{"4", "/", "3"}], ")"}]}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"4", "/", "5"}], " ", 
       RowBox[{"q", "^", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "/", "3"}], ")"}]}]}]}]}], ";", " ", 
    RowBox[{"x2", " ", "=", " ", 
     RowBox[{
      RowBox[{"3", "/", "5"}], " ", "T0", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"q", "^", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "/", "3"}], ")"}]}], " ", "-", " ", 
        RowBox[{"q", "^", 
         RowBox[{"(", 
          RowBox[{"4", "/", "3"}], ")"}]}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"y1", " ", "=", " ", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"q", "^", 
        RowBox[{"(", 
         RowBox[{"2", "/", "3"}], ")"}]}]}], " ", "+", " ", 
      RowBox[{"2", " ", 
       RowBox[{"q", "^", 
        RowBox[{"(", 
         RowBox[{"1", "/", "3"}], ")"}]}]}]}]}], ";", " ", 
    RowBox[{"y2", " ", "=", " ", 
     RowBox[{"3", " ", "T0", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"q", "^", 
         RowBox[{"(", 
          RowBox[{"1", "/", "3"}], ")"}]}], " ", "-", " ", 
        RowBox[{"q", "^", 
         RowBox[{"(", 
          RowBox[{"2", "/", "3"}], ")"}]}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"okODE", " ", "=", " ", 
     RowBox[{"And", " ", "@@", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Simplify", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"D", "[", 
              RowBox[{"#1", ",", " ", 
               RowBox[{"{", 
                RowBox[{"T", ",", " ", "2"}], "}"}]}], "]"}], " ", "-", " ", 
             RowBox[{"#2", " ", 
              RowBox[{"2", "/", 
               RowBox[{"(", 
                RowBox[{"9", " ", 
                 RowBox[{"T", "^", "2"}]}], ")"}]}], " ", "#1"}]}], ",", " ", 
            
            RowBox[{"Assumptions", " ", "->", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"T", " ", ">", " ", "0"}], ",", " ", 
               RowBox[{"T0", " ", ">", " ", "0"}]}], "}"}]}]}], "]"}], " ", "===",
           " ", "0"}], " ", "&"}], " ", "@@@", "\n", "     ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x1", ",", " ", "2"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"x2", ",", " ", "2"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"y1", ",", " ", 
            RowBox[{"-", "1"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"y2", ",", " ", 
            RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ini", " ", "=", " ", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x1", ",", " ", 
          RowBox[{"D", "[", 
           RowBox[{"x1", ",", " ", "T"}], "]"}], ",", " ", "x2", ",", " ", 
          RowBox[{"D", "[", 
           RowBox[{"x2", ",", " ", "T"}], "]"}], ",", " ", "y1", ",", " ", 
          RowBox[{"D", "[", 
           RowBox[{"y1", ",", " ", "T"}], "]"}], ",", " ", "y2", ",", " ", 
          RowBox[{"D", "[", 
           RowBox[{"y2", ",", " ", "T"}], "]"}]}], "}"}], " ", "/.", " ", 
        RowBox[{"T", " ", "->", " ", "T0"}]}], ",", " ", 
       RowBox[{"Assumptions", " ", "->", " ", 
        RowBox[{"T0", " ", ">", " ", "0"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"okIni", " ", "=", " ", 
     RowBox[{"ini", " ", "===", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "0", ",", " ", "0", ",", " ", 
        RowBox[{"-", "1"}], ",", " ", "1", ",", " ", "0", ",", " ", "0", ",", 
        " ", 
        RowBox[{"-", "1"}]}], "}"}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "the", " ", "general", " ", "solutions", " ", "of", " ", "DSolve", " ", 
     "span", " ", "the", " ", "same", " ", "powers"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"spanZ", " ", "=", " ", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"zf", "[", "T", "]"}], " ", "/.", " ", 
        RowBox[{"solZ", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
       RowBox[{"Assumptions", " ", "->", " ", 
        RowBox[{"T", " ", ">", " ", "0"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"spanX", " ", "=", " ", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"xf", "[", "T", "]"}], " ", "/.", " ", 
        RowBox[{"solX", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
       RowBox[{"Assumptions", " ", "->", " ", 
        RowBox[{"T", " ", ">", " ", "0"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"okSpan", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"spanZ", ",", " ", 
           RowBox[{"{", 
            RowBox[{"T", ",", " ", "2"}], "}"}]}], "]"}], " ", "-", " ", 
         RowBox[{
          RowBox[{"4", "/", 
           RowBox[{"(", 
            RowBox[{"9", " ", 
             RowBox[{"T", "^", "2"}]}], ")"}]}], " ", "spanZ"}]}], "]"}], " ",
        "===", " ", "0"}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"spanX", ",", " ", 
           RowBox[{"{", 
            RowBox[{"T", ",", " ", "2"}], "}"}]}], "]"}], " ", "+", " ", 
         RowBox[{
          RowBox[{"2", "/", 
           RowBox[{"(", 
            RowBox[{"9", " ", 
             RowBox[{"T", "^", "2"}]}], ")"}]}], " ", "spanX"}]}], "]"}], " ",
        "===", " ", "0"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WT-5\>\"", ",", 
      " ", "\"\<(Rust LT-2; Python YT-6) in the field kappa = 2/(9 T^2) the \
closed forms X1, X2 (z'' = 2 kappa z: powers \\\nT^(4/3), T^(-1/3)) and Y1, \
Y2 (x'' = -kappa x: powers T^(2/3), T^(1/3)) solve their equations and have \
the values (1, 0) \\\nand (0, -1) of (value, d/dT) at T0; DSolve gives the \
same powers\>\"", ",", " ", 
      RowBox[{"okODE", " ", "&&", " ", "okIni", " ", "&&", " ", "okSpan"}], ",",
       "\n", "  ", 
      RowBox[{"\"\<equations \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", "okODE", "]"}], " ", "<>", 
       " ", "\"\<, initial values \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"InputForm", "[", "ini", "]"}], "]"}], " ", "<>", 
       " ", "\"\<; DSolve: z = \>\"", " ", "<>", "\n", "   ", 
       RowBox[{"ToString", "[", 
        RowBox[{"InputForm", "[", "spanZ", "]"}], "]"}], " ", "<>", 
       " ", "\"\<, x = \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"InputForm", "[", "spanX", "]"}], "]"}]}]}], "]"}], 
    ";"}]}]}]], "Input",
 CellLabel->
  "In[458]:=",ExpressionUUID->"9f9c2e44-0a65-43c8-acbf-01945bbb8fb0"],

Cell[BoxData["\<\"PASS WT-5     (Rust LT-2; Python YT-6) in the field kappa = \
2/(9 T^2) the closed forms X1, X2 (z'' = 2 kappa z: powers T^(4/3), T^(-1/3)) \
and Y1, Y2 (x'' = -kappa x: powers T^(2/3), T^(1/3)) solve their equations \
and have the values (1, 0) and (0, -1) of (value, d/dT) at T0; DSolve gives \
the same powers [equations True, initial values {1, 0, 0, -1, 1, 0, 0, -1}; \
DSolve: z = (C[1] + T^(5/3)*C[2])/T^(1/3), x = T^(1/3)*(C[1] + T^(1/3)*C[2])]\
\"\>"], "Print",
 CellChangeTimes->{4.004398283567213*^9},
 CellLabel->
  "During evaluation of \
In[458]:=",ExpressionUUID->"9db3e2da-428f-4842-9b39-cc92321addff"]
}, Open  ]],

