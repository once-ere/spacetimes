Cell[BoxData["\<\"PASS WW-1     (LW-1 to LW-3) the change of representation \
by S = M_LL(gtilde) of the boost (5/4) e_0 + (3/4) i e_3: S = diag(1/2, 2), \
the matrices sigma'_mu, their bars and polarized determinants, Lord's Dirac \
matrices = S4 gamma^a S4^-1 with S4 = S_LL(g), the Clifford relation, the \
Lorentz matrix L of the boost, gamma'^a = (L^-1)_ab gamma^b, (9.3), and the \
frame of M31 with the velocity -15/17 (exact) [sigma'_0 = {{1/4, 0}, {0, 4}}, \
sigma'_3 = {{1/4, 0}, {0, -4}}, L^-1 = {{17/8, 0, 0, -15/8}, {0, 1, 0, 0}, \
{0, 0, 1, 0}, {-15/8, 0, 0, 17/8}}, f'_0 = {17/8, 0, 0, -15/8}]\"\>"], "Print",\

 CellChangeTimes->{4.004398284027082*^9},
 CellLabel->
  "During evaluation of \
In[529]:=",ExpressionUUID->"b8aec2a5-3bf8-4114-b583-e1f9f7df05b9"]
