          "    ", 
          RowBox[{"{", 
           RowBox[{"rr", ",", " ", "4"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"m", ",", " ", "4"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"n", ",", " ", "4"}], "}"}]}], "]"}], "]"}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "the", " ", "covariant", " ", "constancy", " ", "of", " ", "the", " ", 
     "Dirac", " ", "matrices", " ", "and", " ", "the", " ", "spinor", " ", 
     "curvature"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"nablaGamma", "[", "geo_", "]"}], " ", ":=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"geo", "[", "\"\<gam\>\"", "]"}], "[", 
           RowBox[{"[", "n", "]"}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{"geo", "[", "\"\<X\>\"", "]"}], "[", 
           RowBox[{"[", "m", "]"}], "]"}]}], "]"}], " ", "+", " ", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"geo", "[", "\"\<chr\>\"", "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"n", ",", " ", "m", ",", " ", "l"}], "]"}], "]"}], " ", 
           RowBox[{
            RowBox[{"geo", "[", "\"\<gam\>\"", "]"}], "[", 
            RowBox[{"[", "l", "]"}], "]"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"l", ",", " ", "4"}], "}"}]}], "]"}], " ", "+", "\n", 
        "    ", 
        RowBox[{
         RowBox[{
          RowBox[{"geo", "[", "\"\<spc\>\"", "]"}], "[", 
          RowBox[{"[", "m", "]"}], "]"}], " ", ".", " ", 
         RowBox[{
          RowBox[{"geo", "[", "\"\<gam\>\"", "]"}], "[", 
          RowBox[{"[", "n", "]"}], "]"}]}], " ", "-", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"geo", "[", "\"\<gam\>\"", "]"}], "[", 
          RowBox[{"[", "n", "]"}], "]"}], " ", ".", " ", 
         RowBox[{
          RowBox[{"geo", "[", "\"\<spc\>\"", "]"}], "[", 
          RowBox[{"[", "m", "]"}], "]"}]}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "4"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"n", ",", " ", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"spinCurvDev", "[", 
      RowBox[{"geo_", ",", " ", "riem_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Table", "[", 
