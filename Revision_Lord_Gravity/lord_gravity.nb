}]}]}]}]}]}], "-", "4"}], ":", " ", 
    RowBox[{
     RowBox[{"the", " ", "weak"}], "-", 
     RowBox[{"field", " ", "rate"}]}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"uniform", " ", "field", " ", 
       RowBox[{"F", ":", " ", "L"}]}], " ", "=", " ", 
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"2", "F"}], ")"}]}]}], ";", " ", 
     RowBox[{"the", " ", "integral", " ", "of", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", " ", "-", " ", 
         RowBox[{"z", "/", "L"}]}], ")"}], "^", 
       RowBox[{"(", 
        RowBox[{"1", "/", "2"}], ")"}]}], " ", "is", " ", "2", 
      RowBox[{"L", "/", "3"}]}], ";", " ", 
     RowBox[{"the", " ", "Coulomb", " ", "logarithm", " ", "log", 
      RowBox[{"(", 
       RowBox[{"4", 
        RowBox[{"L", "/", "z_m"}]}], ")"}]}], ";", " ", 
     RowBox[{
     "the", "\n", "   ", "Euclidean", " ", "time", " ", "to", " ", "the", " ",
       "turning", " ", "point", " ", "2", "L"}]}], ",", " ", 
    RowBox[{"Y", " ", "=", " ", "t"}], ",", " ", 
    RowBox[{"S2", " ", "=", " ", 
     RowBox[{"1", "/", "t"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"LL", " ", "=", " ", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", "F"}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"j0u", " ", "=", " ", 
     RowBox[{
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{"1", " ", "-", " ", "s"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"s", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}], " ", 
      "LL"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"antiU", " ", "=", " ", 
     RowBox[{"Log", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", " ", "-", " ", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"1", " ", "-", " ", "s"}], "]"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"1", " ", "+", " ", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"1", " ", "-", " ", "s"}], "]"}]}], ")"}]}], "]"}]}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"okAU", " ", "=", " ", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"antiU", ",", " ", "s"}], "]"}], " ", "-", " ", 
         RowBox[{"1", "/", 
          RowBox[{"(", 
           RowBox[{"s", " ", 
            RowBox[{"Sqrt", "[", 
             RowBox[{"1", " ", "-", " ", "s"}], "]"}]}], ")"}]}]}], ",", " ", 
        
        RowBox[{"Assumptions", " ", "->", " ", 
         RowBox[{"0", " ", "<", " ", "s", " ", "<", " ", "1"}]}]}], "]"}], 
      " ", "===", " ", "0"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"limU", " ", "=", " ", 
     RowBox[{"Limit", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"antiU", " ", "/.", " ", 
          RowBox[{"s", " ", "->", " ", "1"}]}], ")"}], " ", "-", " ", 
        RowBox[{"(", 
         RowBox[{"antiU", " ", "/.", " ", 
          RowBox[{"s", " ", "->", " ", "um"}]}], ")"}], " ", "-", " ", 
        RowBox[{"Log", "[", 
         RowBox[{"4", "/", "um"}], "]"}]}], ",", " ", 
       RowBox[{"um", " ", "->", " ", "0"}], ",", " ", 
       RowBox[{"Direction", " ", "->", " ", "\"\<FromAbove\>\""}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"t2u", " ", "=", " ", 
     RowBox[{
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{"1", "/", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"1", " ", "-", " ", "s"}], "]"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"s", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}], " ", 
      "LL"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gamU", " ", "=", " ", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "2"}], " ", "zm"}], "]"}], " ", 
        RowBox[{"zm", "^", "2"}], " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "2"}], " ", 
            RowBox[{"(", 
             RowBox[{"j0u", " ", "-", " ", "zm", " ", "-", " ", 
              RowBox[{"Log", "[", 
               RowBox[{"4", " ", 
                RowBox[{"LL", "/", "zm"}]}], "]"}]}], ")"}]}], "]"}], "/", 
          RowBox[{"t2u", "^", "2"}]}], "/", "Pi"}], " ", "Pi", " ", "t2u"}], ",",
        " ", 
       RowBox[{"Assumptions", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"F", " ", ">", " ", "0"}], ",", " ", 
          RowBox[{"zm", " ", ">", " ", "0"}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"okU", " ", "=", " ", 
     RowBox[{"okAU", " ", "&&", " ", 
      RowBox[{"limU", " ", "===", " ", "0"}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"gamU", " ", "-", " ", 
          RowBox[{
           RowBox[{"4", "/", "F"}], " ", 
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "2"}], "/", 
             RowBox[{"(", 
              RowBox[{"3", " ", "F"}], ")"}]}], "]"}]}]}], ",", " ", 
         RowBox[{"Assumptions", " ", "->", " ", 
          RowBox[{"F", " ", ">", " ", "0"}]}]}], "]"}], " ", "===", " ", 
       "0"}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"tidal", " ", 
       RowBox[{"field", ":", " ", "l"}]}], " ", "=", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", " ", "kappa"}], ")"}], "^", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "/", "2"}], ")"}]}]}], ";", " ", 
     RowBox[{"integral", " ", "pi", " ", 
      RowBox[{"l", "/", "4"}]}], ";", " ", 
     RowBox[{"logarithm", " ", "log", 
