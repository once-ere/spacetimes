         RowBox[{"Conjugate", "[", "u1", "]"}], " ", ".", " ", 
         RowBox[{"gam", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ")"}], " ", 
       RowBox[{"Exp", "[", 
        RowBox[{"I", " ", 
         RowBox[{"dotX", "[", "k1", "]"}]}], "]"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Conjugate", "[", "u2", "]"}], " ", ".", " ", 
