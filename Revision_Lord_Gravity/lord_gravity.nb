}]}]}]}]}]}], "-", "3"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"mA", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"p11", ",", " ", "p12"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"p21", ",", " ", "p22"}], "}"}]}], "}"}]}], ";", " ", 
    RowBox[{"mB", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"q11", ",", " ", "q12"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"q21", ",", " ", "q22"}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nAB", " ", "=", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Det", "[", 
         RowBox[{"mA", " ", "+", " ", "mB"}], "]"}], " ", "-", " ", 
        RowBox[{"Det", "[", "mA", "]"}], " ", "-", " ", 
        RowBox[{"Det", "[", "mB", "]"}]}], ")"}], "/", "2"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ok3", " ", "=", " ", 
     RowBox[{"zeroQ", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"mA", " ", ".", " ", 
           RowBox[{"bar", "[", "mB", "]"}]}], " ", "+", " ", 
          RowBox[{"mB", " ", ".", " ", 
           RowBox[{"bar", "[", "mA", "]"}]}]}], ")"}], "/", "2"}], " ", "-", 
       " ", 
       RowBox[{"nAB", " ", 
        RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"okN", " ", "=", " ", 
     RowBox[{"And", " ", "@@", " ", 
      RowBox[{"Flatten", "@", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Det", "[", 
              RowBox[{
               RowBox[{"sig", "[", 
                RowBox[{"[", "m", "]"}], "]"}], " ", "+", " ", 
               RowBox[{"sig", "[", 
                RowBox[{"[", "n", "]"}], "]"}]}], "]"}], " ", "-", " ", 
             RowBox[{"Det", "[", 
              RowBox[{"sig", "[", 
               RowBox[{"[", "m", "]"}], "]"}], "]"}], " ", "-", " ", 
             RowBox[{"Det", "[", 
              RowBox[{"sig", "[", 
               RowBox[{"[", "n", "]"}], "]"}], "]"}]}], ")"}], "/", "2"}], 
          " ", "==", " ", 
          RowBox[{"eta", "[", 
           RowBox[{"[", 
            RowBox[{"m", ",", " ", "n"}], "]"}], "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"m", ",", " ", "4"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"n", ",", " ", "4"}], "}"}]}], "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WL-3\>\"", ",", 
      " ", "\"\<(Rust L1-13, L1-14; Python YL-3, YL-3b) for any two 2x2 \
matrices A, B (symbolic entries): 1/2 (A bar(B) + \\\nB bar(A)) = N(A, B) 1 \
with N(A, B) = (det(A + B) - det A - det B)/2, and N(sigma^mu, sigma^nu) = \
eta^{mu nu}; so (1.3) \\\nholds for a set of four matrices exactly when their \
products N are eta^{ab}\>\"", ",", " ", 
      RowBox[{"ok3", " ", "&&", " ", "okN"}], ",", "\n", "  ", 
      RowBox[{"\"\<identity \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", "ok3", "]"}], " ", "<>", 
       " ", "\"\<, N of the standard set \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", "okN", "]"}]}]}], "]"}], ";"}]}]}]], "Input",
 CellLabel->"In[37]:=",ExpressionUUID->"1480e71d-e911-4f65-8f7f-27d178d2f61a"],

Cell[BoxData["\<\"PASS WL-3     (Rust L1-13, L1-14; Python YL-3, YL-3b) for \
any two 2x2 matrices A, B (symbolic entries): 1/2 (A bar(B) + B bar(A)) = \
N(A, B) 1 with N(A, B) = (det(A + B) - det A - det B)/2, and N(sigma^mu, \
sigma^nu) = eta^{mu nu}; so (1.3) holds for a set of four matrices exactly \
when their products N are eta^{ab} [identity True, N of the standard set \
True]\"\>"], "Print",
 CellChangeTimes->{4.0043982467160797`*^9},
