Cell[CellGroupData[{

Cell["WC-1: the geometry", "Section",ExpressionUUID->"add46656-4403-4efb-a57a-60bbee96fa5d"],

Cell[TextData[{
 "With the zeugon field ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", "\[Mu]"}]], 
    StyleBox["d", "TI"], 
    SuperscriptBox[
     StyleBox["x", "TI"], "\[Mu]"], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["Q", "TI"], 
       StyleBox["LG",
        FontSlant->"Plain"], 
       StyleBox["Z",
        FontSlant->"Plain"]], "/", 
      RowBox[{"(", 
       RowBox[{"4", "\[Pi]", 
        StyleBox["r", "TI"]}], ")"}]}], ")"}], "\[ThinSpace]", 
    StyleBox["dt", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6981923c-964f-4c6b-b170-8519437ae89c"],
 " the metric with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["f", "TI"], 
     StyleBox["LG",
      FontSlant->"Plain"], 
     StyleBox["RN",
      FontSlant->"Plain"]], "\[LongEqual]", "1", "-", "2", 
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["N",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LG",
      FontSlant->"Plain"]], "/", 
    StyleBox["r", "TI"], "+", 
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["N",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["Q", "TI"], 
       StyleBox["LG",
        FontSlant->"Plain"], 
       StyleBox["Z",
        FontSlant->"Plain"]], ")"}], "2"], "/", 
    RowBox[{"(", 
     RowBox[{"4", "\[Pi]", 
      SuperscriptBox[
       StyleBox["r", "TI"], "2"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "693d5ae5-8188-4911-a582-bb3ca94fffc0"],
 " solves Einstein's equations with the energy-momentum tensor of the zeugon \
exactly; with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["N",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["Q", "TI"], 
       StyleBox["LG",
        FontSlant->"Plain"], 
       StyleBox["Z",
        FontSlant->"Plain"]], ")"}], "2"], "/", 
    SuperscriptBox[
     StyleBox["r", "TI"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6a994e49-191a-45a6-950c-692e8807e68e"],
 " in place of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["N",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["Q", "TI"], 
       StyleBox["LG",
        FontSlant->"Plain"], 
       StyleBox["Z",
        FontSlant->"Plain"]], ")"}], "2"], "/", 
    RowBox[{"(", 
     RowBox[{"4", "\[Pi]", 
      SuperscriptBox[
       StyleBox["r", "TI"], "2"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "47084f67-ae44-431e-8e6f-08ca95adf490"],
 " (the normalization of another convention) it does not, which shows that \
the factor ",
 Cell[BoxData[
  FormBox[
   RowBox[{"4", "\[Pi]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6366a13c-2e63-408d-af7b-6a1a32de2a3c"],
 " matters and that the check can fail. In the code ",
 StyleBox["gN",
  FontFamily->"Source Code Pro"],
 " is ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["N",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c0d01380-69a2-402b-8ca6-66ef6f502a15"],
 ", ",
 StyleBox["mm",
  FontFamily->"Source Code Pro"],
 " the mass and ",
 StyleBox["qq",
  FontFamily->"Source Code Pro"],
 " the charge."
}], "Text",ExpressionUUID->"c89de32c-8bb5-4374-8547-f76e2938fec9"],

