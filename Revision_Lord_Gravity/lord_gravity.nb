Cell[CellGroupData[{

Cell["WS-8: three greybody factors", "Section",ExpressionUUID->"49564955-f111-4fa7-965e-38bc6ea87ee1"],

Cell[TextData[{
 "A wave sent towards the black hole is partly absorbed and partly scattered \
back; the absorbed fraction is the greybody factor. The check integrates from \
the horizon to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r", "TI"], "\[LongEqual]", "4000"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1a5e4c78-af70-4a84-94e8-0e098daf0f86"],
 ", splits the solution there into an incoming and an outgoing wave, and \
divides the current into the horizon by the incoming current. The three cases \
are compared with the Rust values, which carry the error ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", "\[Times]", 
    SuperscriptBox["10", 
     RowBox[{"-", "8"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1d412400-a4d1-4c8c-9601-48ef0ecc61de"],
 " of the integrator CVODE; the tolerance is ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "7"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2fa7425c-e91b-4eff-b36e-7f5716ebc15f"],
 "."
}], "Text",ExpressionUUID->"2d2e74db-2648-46ff-8dda-f34f41f0ae59"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", 
          RowBox[{"--", 
           RowBox[{"--", 
            RowBox[{"--", 
             RowBox[{"--", 
              RowBox[{"--", 
               RowBox[{"--", 
                RowBox[{"--", 
                 RowBox[{"--", 
                  RowBox[{"--", 
                   RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
