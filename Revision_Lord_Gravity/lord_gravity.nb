Cell[CellGroupData[{

Cell["2. The brochon in a curved space-time (Part III)", "Chapter",ExpressionUUID->"ab217a03-524e-47e8-ba2a-a2c059bfefee"],

Cell[TextData[{
 "Part III turns Lord's reference vectors into the tetrad of a curved \
space-time: four orthonormal vectors ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["a", "TI"], 
     StyleBox["LG",
      FontSlant->"Plain"]], 
    SuperscriptBox["", "\[Mu]"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "315b83c5-ae90-4ebe-bb1a-97c840695b9a"],
 " at each point, from which the metric ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     RowBox[{"\[Mu]", "\[Nu]"}], 
     StyleBox["LG",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{
       StyleBox["LG",
        FontSlant->"Plain"], "\[ThinSpace]", 
       StyleBox["a", "TI"]}]], 
     SubscriptBox["", "\[Mu]"], 
     SubsuperscriptBox["\[Eta]", 
      StyleBox["ab", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"]], 
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{
       StyleBox["LG",
        FontSlant->"Plain"], "\[ThinSpace]", 
       StyleBox["b", "TI"]}]], 
     SubscriptBox["", "\[Nu]"]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "148776ec-0fb6-4234-974e-dff7090815ac"],
 " follows. The spin connection ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Omega]", 
    RowBox[{"\[Mu]", "\[ThinSpace]", 
     StyleBox["ab", "TI"]}], 
    StyleBox["LG",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3899eedc-86cf-4ed4-83a4-28540960bf10"],
 " is fixed by requiring that the tetrad be covariantly constant (the tetrad \
postulate), and the spinor connection is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalGamma]", "\[Mu]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    FractionBox["1", "4"], 
    SubsuperscriptBox["\[Omega]", 
     RowBox[{"\[Mu]", "\[ThinSpace]", 
      StyleBox["ab", "TI"]}], 
     StyleBox["LG",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["ab", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1853b4e8-6fb9-4d76-9cc4-5fd30afff2c8"],
 ". With it the brochon obeys the Dirac equation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["i", "TI"], 
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LG",
      FontSlant->"Plain"], "\[Mu]"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[PartialD]", "\[Mu]"], "+", 
      SubsuperscriptBox["\[CapitalGamma]", "\[Mu]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}], 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "65484b85-3555-42b8-b332-d1bf86f1206d"],
 " in any gravitational field. This chapter checks the geometry for the \
space-times that the later parts use, the square of the Dirac operator, the \
energy-momentum tensor of the brochon, and a property of the pairing term of \
the superfluid."
}], "Text",ExpressionUUID->"734e2cb5-3d9e-4279-9dc8-19ef76dea822"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "the", " ", "symbols", " ", "that", " ", "the", " ", "code", " ", "of", " ",
     "this", " ", "chapter", " ", "creates", " ", "live", " ", "in", " ", 
    "the", " ", "context", " ", "LGNB`Curved`", " ", 
    RowBox[{"(", 
     RowBox[{
     "the", " ", "code", " ", "is", " ", "that", " ", "of", " ", "the", " ", 
      "script", " ", 
      RowBox[{
       RowBox[{"wolfram", "/", "source"}], "/", 
       RowBox[{"lg_curved", ".", "wls"}]}]}], ")"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{"Begin", "[", "\"\<LGNB`Curved`\>\"", "]"}], ";"}]}]], "Input",
 CellLabel->"In[78]:=",ExpressionUUID->"a2bddcfd-de59-40c3-8c8f-e22ae44d1f03"],

Cell[TextData[{
 "Four helper functions: ",
 StyleBox["zeroQ",
  FontFamily->"Source Code Pro"],
 " (every entry simplifies to zero), ",
 StyleBox["finiteQ",
  FontFamily->"Source Code Pro"],
 " (no infinity in an expression), ",
 StyleBox["zeroE",
  FontFamily->"Source Code Pro"],
 " (every entry expands to zero, which decides identities between polynomials \
in symbolic functions quickly), and ",
 StyleBox["witnessQ",
  FontFamily->"Source Code Pro"],
 " (an expression is not identically zero, shown by its value for explicit \
functions at one rational point; it is used for the controls, the statements \
that a wrong formula fails)."
}], "Text",ExpressionUUID->"9e95376a-151e-4c81-863e-237287f5b322"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "the", " ", "helper", " ", "functions", " ", "of", " ", "the", " ", 
    "script", " ", 
    RowBox[{"lg_curved", ".", "wls"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"zeroQ", "[", "m_", "]"}], " ", ":=", " ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{"{", "m", "}"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{"TrueQ", "[", 
         RowBox[{
          RowBox[{"Simplify", "[", "#", "]"}], " ", "==", " ", "0"}], "]"}], 
        " ", "&"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"finiteQ", "[", "m_", "]"}], " ", ":=", " ", 
     RowBox[{"FreeQ", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{"{", "m", "}"}], "]"}], ",", " ", 
       RowBox[{
       "ComplexInfinity", " ", "|", " ", "Indeterminate", " ", "|", " ", 
        RowBox[{"DirectedInfinity", "[", "_", "]"}], " ", "|", " ", 
        "Infinity"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"zeroE", ":", " ", 
       RowBox[{
       "the", " ", "expanded", " ", "form", " ", "is", " ", "0", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
          "for", " ", "polynomials", " ", "in", " ", "independent", " ", 
           "functions", " ", "and", " ", "their", " ", "derivatives"}], ",", 
          " ", 
          RowBox[{"with", " ", "exponential", "\n", "   ", "factors"}], ",", 
          " ", 
          RowBox[{
          "the", " ", "expanded", " ", "form", " ", "is", " ", "canonical"}], 
          ",", " ", 
          RowBox[{
          "so", " ", "this", " ", "decides", " ", "the", " ", "identity", " ",
            "exactly", " ", "and", " ", "quickly"}]}], ")"}]}]}], ";", " ", 
      RowBox[{"witnessQ", ":", " ", 
       RowBox[{
       "an", " ", "expression", "\n", "   ", "is", " ", "not", " ", 
        "identically", " ", "zero"}]}]}], ",", " ", 
     RowBox[{
     "shown", " ", "by", " ", "its", " ", "value", " ", "for", " ", 
      "explicit", " ", "functions", " ", "at", " ", "a", " ", "rational", " ",
       "point"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"zeroE", "[", "m_", "]"}], " ", ":=", " ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{"{", "m", "}"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Expand", "[", "#", "]"}], " ", "===", " ", "0"}], " ", 
        "&"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"witnessQ", "[", 
      RowBox[{"m_", ",", " ", "rules_", ",", " ", "pt_"}], "]"}], " ", ":=", 
     " ", 
     RowBox[{"AnyTrue", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{"{", "m", "}"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"N", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"#", " ", "/.", " ", "rules"}], ")"}], " ", "/.", " ", 
             "pt"}], ",", " ", "30"}], "]"}], "]"}], " ", ">", " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "20"}]}]}], " ", "&"}]}], "]"}]}], ";"}]}]}]], "Input",\

 CellLabel->"In[79]:=",ExpressionUUID->"a3ad0593-a55d-40f1-8182-f8fa7c38741c"],

