                "0"}], "]"}]}], ",", " ", "0"}], "]"}], " ", "+", "\n", 
          "     ", 
          RowBox[{"8", " ", 
           RowBox[{"Pi", "/", 
            RowBox[{"(", 
             RowBox[{"3", " ", 
              RowBox[{"m", "^", "2"}]}], ")"}]}], " ", "s1s2", " ", 
           RowBox[{"iv", "[", "\"\<p0\>\"", "]"}]}], " ", "+", " ", 
          RowBox[{"If", "[", 
           RowBox[{"ann", ",", " ", 
            RowBox[{
             RowBox[{"Pi", "/", 
              RowBox[{"(", 
               RowBox[{"2", " ", 
                RowBox[{"m", "^", "2"}]}], ")"}]}], " ", 
             RowBox[{"(", 
              RowBox[{"3", " ", "+", " ", 
               RowBox[{"4", " ", "s1s2"}]}], ")"}], " ", 
             RowBox[{"iv", "[", "\"\<p0\>\"", "]"}]}], ",", " ", "0"}], 
           "]"}]}]}], ";", "\n", "   ", 
        RowBox[{"Simplify", "[", 
         RowBox[{"e", "/", "2"}], "]"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"in", " ", "the", " ", 
      RowBox[{"notebook", ":", " ", 
       RowBox[{"the", " ", "text", " ", "of", " ", 
        RowBox[{"data", "/", "lg_pair"}], 
        RowBox[{"_levels", ".", "csv"}]}]}]}], ",", " ", 
     RowBox[{
     "from", " ", "the", " ", "closed", " ", "data", " ", "cell", " ", "of", " ",
       "this", " ", "chapter"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"tab", " ", "=", " ", 
     RowBox[{"Rest", "[", 
      RowBox[{"ImportString", "[", 
       RowBox[{"lgPairLevelsCSV", ",", " ", "\"\<CSV\>\"", ",", " ", 
        RowBox[{"\"\<Numeric\>\"", " ", "->", " ", "False"}]}], "]"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rows3", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{"tab", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"ToExpression", "[", 
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "]"}], " ", "<=", " ", "3"}], " ", 
        "&"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"cmp", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "n", ",", " ", "l", ",", " ", "s", ",", " ", "j", ",", " ", "e0", ",",
            " ", "e1", ",", " ", "w0", ",", " ", "w1"}], "}"}], ",", "\n", 
         "    ", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"n", ",", " ", "l", ",", " ", "s", ",", " ", "j"}], "}"}],
            " ", "=", " ", 
           RowBox[{"ToExpression", " ", "/@", " ", 
            RowBox[{"rw", "[", 
             RowBox[{"[", 
              RowBox[{"2", " ", ";;", " ", "5"}], "]"}], "]"}]}]}], ";", "\n",
           "    ", 
          RowBox[{"w0", " ", "=", " ", 
           RowBox[{"ToExpression", "[", 
            RowBox[{"rw", "[", 
             RowBox[{"[", "7", "]"}], "]"}], "]"}]}], ";", " ", 
