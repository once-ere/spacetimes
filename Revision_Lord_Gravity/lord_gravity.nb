Cell[CellGroupData[{

Cell["WG-6: the pairing term and the zeugon", "Section",ExpressionUUID->"1cb56847-3e5f-4e90-bd64-3943fdd5a210"],

Cell[TextData[{
 "In the superfluid ground state of the brochon model the field equation \
contains a pairing term, which mixes the brochon with its complex conjugate: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["\[ScriptCapitalC]",
      FontSlant->"Plain"], 
     StyleBox["LG",
      FontSlant->"Plain"]], "\[CapitalPsi]", "\[LongEqual]", 
    SubscriptBox[
     StyleBox["P",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LG",
      FontSlant->"Plain"]], 
    SuperscriptBox["\[CapitalPsi]", "*"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fd01e562-d1c9-4576-96dc-e776adf1ff10"],
 " with the matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["P",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LG",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["\[Gamma]", 
       StyleBox["LL",
        FontSlant->"Plain"], "0"], "\[CircleTimes]", 
      SubscriptBox[
       StyleBox["1",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], "2"]}], ")"}], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9e4134b8-f448-41c1-b3f8-287d491006a5"],
 ". For the quasi-particles to move like Dirac particles in a gravitational \
field (Theorem L2), this map must commute with the Dirac matrices and with \
every Lorentz transformation, and with the charge of the zeugon. The check \
shows exactly that: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["P",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "\[ThinSpace]", 
    OverscriptBox[
     SuperscriptBox["\[Gamma]", 
      StyleBox["a", "TI"]], "_"], "\[LongEqual]", 
    SuperscriptBox["\[Gamma]", 
     StyleBox["a", "TI"]], 
    StyleBox["P",
     FontFamily->"Helvetica",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c0ce472f-bb19-414e-b614-7943092d3407"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["P",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "\[ThinSpace]", 
    OverscriptBox[
     StyleBox["P",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "_"], "\[LongEqual]", 
    RowBox[{"-", "1"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0d42e2f8-fda5-42b1-ac92-e0b52ac463c0"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["P",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "\[ThinSpace]", 
    OverscriptBox[
     StyleBox["X", "TI"], "_"], "\[LongEqual]", 
    StyleBox["X", "TI"], 
    StyleBox["P",
     FontFamily->"Helvetica",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0f0a0344-fbb1-4a81-9b96-1f1aa0261c96"],
 " for every element ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["X", "TI"], "\[LongEqual]", 
    FractionBox["1", "4"], 
    SubsuperscriptBox[
     StyleBox["w", "TI"], 
     StyleBox["ab", "TI"], 
     StyleBox["LG",
      FontSlant->"Plain"]], 
    SuperscriptBox["\[Gamma]", 
     StyleBox["ab", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b1d80bce-738c-442d-8690-29c5273c8bd3"],
 " of the Lorentz algebra, and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["P",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "\[ThinSpace]", 
    OverscriptBox[
     RowBox[{
      StyleBox["i", "TI"], 
      SuperscriptBox[
       StyleBox["T", "TI"], "3"]}], "_"], "\[LongEqual]", 
    StyleBox["i", "TI"], 
    SuperscriptBox[
     StyleBox["T", "TI"], "3"], 
    StyleBox["P",
     FontFamily->"Helvetica",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4a9ee8d4-6d46-4ee2-87fd-acb603872f64"],
 " for the generator ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6d1b34c1-cff9-4dbb-8dd4-721db4bb7fe3"],
 " of the zeugon, but not for ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["T", "TI"], "1"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "11216ae0-a090-4a43-b852-bd04052583de"],
 ", ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["T", "TI"], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e41a378d-85fa-440c-bc16-5a91a05f5006"],
 " or the fermion number (the bars here are complex conjugates). This is the \
algebraic reason why the zeugon, the gauge boson of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1557658a-6daf-4862-a800-2d73caf74c8c"],
 ", stays massless in the superfluid while the other gauge bosons do not, and \
why the quasi-particles carry its charge (Theorem L2)."
}], "Text",ExpressionUUID->"2305b42d-7f32-4f6e-aee9-5dde48c57a76"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", 
          RowBox[{"--", 
           RowBox[{"--", 
            RowBox[{"--", 
             RowBox[{"--", 
              RowBox[{"--", 
               RowBox[{"--", 
                RowBox[{"--", 
                 RowBox[{"--", 
                  RowBox[{"--", 
                   RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{
                    "--", " ", 
                    "WG"}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]\
}]}]}]}]}]}], "-", "6"}], ":", " ", 
    RowBox[{"the", " ", "pairing", " ", "term"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"eL", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "0"}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gch", " ", "=", " ", 
     RowBox[{"I", " ", 
      RowBox[{
       RowBox[{"gam", "[", 
        RowBox[{"[", "1", "]"}], "]"}], " ", ".", " ", 
       RowBox[{"gam", "[", 
        RowBox[{"[", "2", "]"}], "]"}], " ", ".", " ", 
       RowBox[{"gam", "[", 
        RowBox[{"[", "3", "]"}], "]"}], " ", ".", " ", 
       RowBox[{"gam", "[", 
        RowBox[{"[", "4", "]"}], "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"cLL", " ", "=", " ", 
     RowBox[{"ArrayFlatten", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"eL", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", 
          RowBox[{"-", "eL"}]}], "}"}]}], "}"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"k3", " ", "=", " ", 
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{
       RowBox[{"cLL", " ", ".", " ", "gch"}], ",", " ", 
       RowBox[{"eL", " ", ".", " ", 
        RowBox[{"sig", "[", 
         RowBox[{"[", "4", "]"}], "]"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"d8m", "[", "m_", "]"}], " ", ":=", " ", 
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{"m", ",", " ", 
       RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"i8m", "[", "m_", "]"}], " ", ":=", " ", 
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{"id4", ",", " ", "m"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"pM", " ", "=", " ", 
     RowBox[{
      RowBox[{"d8m", "[", 
       RowBox[{"gam", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "]"}], " ", ".", " ", 
      RowBox[{"ConjugateTranspose", "[", "k3", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"okGam", " ", "=", " ", 
     RowBox[{"And", " ", "@@", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"zeroQ", "[", 
         RowBox[{
          RowBox[{"pM", " ", ".", " ", 
           RowBox[{"Conjugate", "[", 
            RowBox[{"d8m", "[", 
             RowBox[{"gam", "[", 
              RowBox[{"[", "a", "]"}], "]"}], "]"}], "]"}]}], " ", "-", " ", 
          RowBox[{
           RowBox[{"d8m", "[", 
            RowBox[{"gam", "[", 
             RowBox[{"[", "a", "]"}], "]"}], "]"}], " ", ".", " ", "pM"}]}], 
         "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"a", ",", " ", "4"}], "}"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"okSq", " ", "=", " ", 
     RowBox[{"zeroQ", "[", 
      RowBox[{
       RowBox[{"pM", " ", ".", " ", 
        RowBox[{"Conjugate", "[", "pM", "]"}]}], " ", "+", " ", 
       RowBox[{"IdentityMatrix", "[", "8", "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"wS", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "w01", ",", " ", "w02", ",", " ", "w03"}], 
        "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "w01"}], ",", " ", "0", ",", " ", "w12", ",", " ", 
         "w13"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "w02"}], ",", " ", 
         RowBox[{"-", "w12"}], ",", " ", "0", ",", " ", "w23"}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "w03"}], ",", " ", 
         RowBox[{"-", "w13"}], ",", " ", 
         RowBox[{"-", "w23"}], ",", " ", "0"}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"omL", " ", "=", " ", 
     RowBox[{"d8m", "[", 
      RowBox[{
       RowBox[{"1", "/", "4"}], " ", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"wS", "[", 
           RowBox[{"[", 
            RowBox[{"a", ",", " ", "b"}], "]"}], "]"}], " ", 
          RowBox[{"gab", "[", 
           RowBox[{"a", ",", " ", "b"}], "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"a", ",", " ", "4"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"b", ",", " ", "4"}], "}"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"okLor", " ", "=", " ", 
     RowBox[{"zeroQ", "[", 
      RowBox[{
       RowBox[{"pM", " ", ".", " ", 
        RowBox[{"ComplexExpand", "[", 
         RowBox[{"Conjugate", "[", "omL", "]"}], "]"}]}], " ", "-", " ", 
       RowBox[{"omL", " ", ".", " ", "pM"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"genOK", "[", "tg_", "]"}], " ", ":=", " ", 
     RowBox[{"zeroQ", "[", 
      RowBox[{
       RowBox[{"pM", " ", ".", " ", 
        RowBox[{"Conjugate", "[", 
         RowBox[{"I", " ", "tg"}], "]"}]}], " ", "-", " ", 
       RowBox[{"I", " ", 
        RowBox[{"tg", " ", ".", " ", "pM"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"okT3", " ", "=", " ", 
     RowBox[{"genOK", "[", 
      RowBox[{"i8m", "[", 
       RowBox[{
        RowBox[{"sig", "[", 
         RowBox[{"[", "4", "]"}], "]"}], "/", "2"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"notT1", " ", "=", " ", 
     RowBox[{"!", " ", 
      RowBox[{"genOK", "[", 
       RowBox[{"i8m", "[", 
        RowBox[{
         RowBox[{"sig", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "/", "2"}], "]"}], "]"}]}]}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"notT2", " ", "=", " ", 
     RowBox[{"!", " ", 
      RowBox[{"genOK", "[", 
       RowBox[{"i8m", "[", 
        RowBox[{
         RowBox[{"sig", "[", 
          RowBox[{"[", "3", "]"}], "]"}], "/", "2"}], "]"}], "]"}]}]}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"notF", " ", "=", " ", 
     RowBox[{"!", " ", 
      RowBox[{"genOK", "[", 
       RowBox[{"IdentityMatrix", "[", "8", "]"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WG-6\>\"", ",", 
      " ", "\"\<(Rust G-17; Python YG-8) the pairing term of the polar \
superfluid, C psi = P conj(psi) with P = (gamma^0 \\\n(x) 1_2)(K^3_LL)^dag, \
K^3_LL = C_LL gamma^ch_LL (x) E_LL tau_3: P conj(gamma^a) = gamma^a P (so C \
anticommutes with i \\\ngamma^mu, real tetrad), P conj(P) = -1 (C^2 = -1), P \
conj(Omega) = Omega P for every Omega = 1/4 w_{ab} gamma^{ab} of the \\\n\
Lorentz algebra (w real symbols), and P conj(i t) = i t P for the generator t \
= T^3 of the zeugon but not for T^1, T^2 or \\\nthe fermion number\>\"", ",", 
      " ", 
      RowBox[{
      "okGam", " ", "&&", " ", "okSq", " ", "&&", " ", "okLor", " ", "&&", 
       " ", "okT3", " ", "&&", " ", "notT1", " ", "&&", " ", "notT2", " ", "&&",
        " ", "notF"}], ",", "\n", "  ", 
      RowBox[{"\"\<gamma \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", "okGam", "]"}], " ", "<>", 
       " ", "\"\<, C^2 = -1 \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", "okSq", "]"}], " ", "<>", 
       " ", "\"\<, Lorentz \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", "okLor", "]"}], " ", "<>", 
       " ", "\"\<, T^3 \>\"", " ", "<>", "\n", "   ", 
       RowBox[{"ToString", "[", "okT3", "]"}], " ", "<>", 
       " ", "\"\<, not T^1 \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", "notT1", "]"}], " ", "<>", 
       " ", "\"\<, not T^2 \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", "notT2", "]"}], " ", "<>", 
       " ", "\"\<, not F \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", "notF", "]"}]}]}], "]"}], ";"}]}]}]], "Input",\

 CellLabel->
  "In[187]:=",ExpressionUUID->"ac825534-e2fd-422e-a988-79e906421d32"],

Cell[BoxData["\<\"PASS WG-6     (Rust G-17; Python YG-8) the pairing term of \
the polar superfluid, C psi = P conj(psi) with P = (gamma^0 (x) \
1_2)(K^3_LL)^dag, K^3_LL = C_LL gamma^ch_LL (x) E_LL tau_3: P conj(gamma^a) = \
gamma^a P (so C anticommutes with i gamma^mu, real tetrad), P conj(P) = -1 \
(C^2 = -1), P conj(Omega) = Omega P for every Omega = 1/4 w_{ab} gamma^{ab} \
of the Lorentz algebra (w real symbols), and P conj(i t) = i t P for the \
generator t = T^3 of the zeugon but not for T^1, T^2 or the fermion number \
[gamma True, C^2 = -1 True, Lorentz True, T^3 True, not T^1 True, not T^2 \
True, not F True]\"\>"], "Print",
 CellChangeTimes->{4.004398247497036*^9},
 CellLabel->
  "During evaluation of \
In[187]:=",ExpressionUUID->"6a351325-4b18-4704-ab19-1542e351efb5"]
}, Open  ]],

