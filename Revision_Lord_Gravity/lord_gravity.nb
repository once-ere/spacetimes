Cell[TextData[{
 "The helper functions: ",
 StyleBox["zeroQ",
  FontFamily->"Source Code Pro"],
 ", ",
 StyleBox["num",
  FontFamily->"Source Code Pro"],
 " (a number written in the CSV files, such as ",
 StyleBox["1.5e-3",
  FontFamily->"Source Code Pro"],
 ", read exactly), and ",
 StyleBox["readTable",
  FontFamily->"Source Code Pro"],
 " (the header and the rows of a CSV file; in the notebook it reads the text \
of the file from a closed cell of this chapter)."
}], "Text",ExpressionUUID->"33cab1f5-4707-4a53-a77a-eb00d42d4639"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "the", " ", "helper", " ", "functions", " ", "of", " ", "the", " ", 
    "script", " ", 
    RowBox[{"lg_schw", ".", "wls"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"notes", " ", "=", " ", 
     RowBox[{"{", "}"}]}], ";"}], "   ", 
   RowBox[{"(*", " ", 
    RowBox[{
    "the", " ", "notes", " ", "of", " ", "the", " ", "computations", " ", 
     "of", " ", "this", " ", "chapter"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"zeroQ", "[", "m_", "]"}], " ", ":=", " ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{"{", "m", "}"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{"TrueQ", "[", 
         RowBox[{
          RowBox[{"Simplify", "[", "#", "]"}], " ", "==", " ", "0"}], "]"}], 
        " ", "&"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"num", "[", "s_String", "]"}], " ", ":=", " ", 
     RowBox[{"ToExpression", "[", 
      RowBox[{"StringReplace", "[", 
       RowBox[{"s", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<e\>\"", " ", "->", " ", "\"\<*^\>\""}], "}"}]}], "]"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"in", " ", "the", " ", 
      RowBox[{"notebook", ":", " ", 
       RowBox[{
       "readTable", " ", "reads", " ", "the", " ", "text", " ", "of", " ", 
        "a", " ", "CSV", " ", "file"}]}]}], ",", " ", 
     RowBox[{
     "which", " ", "a", " ", "closed", " ", "data", " ", "cell", " ", "of", " ",
       "this", " ", "chapter", " ", "holds"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"readTable", "[", "csv_String", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"tb", " ", "=", " ", 
         RowBox[{
          RowBox[{"ImportString", "[", 
           RowBox[{"csv", ",", " ", "\"\<CSV\>\"", ",", " ", 
            RowBox[{"\"\<Numeric\>\"", " ", "->", " ", "False"}]}], "]"}], 
          " ", "/.", " ", 
          RowBox[{"_Missing", " ", "->", " ", "\"\<NaN\>\""}]}]}], "}"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"First", "[", "tb", "]"}], ",", " ", 
         RowBox[{"Rest", "[", "tb", "]"}]}], "}"}]}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellLabel->
  "In[208]:=",ExpressionUUID->"44afc58f-8167-4807-9728-e9e0229d1061"],

