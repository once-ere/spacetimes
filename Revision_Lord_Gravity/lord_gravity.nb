             RowBox[{"[", "9", "]"}], "]"}], "]"}]}], ";", "\n", "    ", 
          RowBox[{"e0", " ", "=", " ", 
           RowBox[{"level", "[", 
            RowBox[{
            "n", ",", " ", "l", ",", " ", "s", ",", " ", "j", ",", " ", 
             "False"}], "]"}]}], ";", " ", 
          RowBox[{"e1", " ", "=", " ", 
           RowBox[{"level", "[", 
            RowBox[{
            "n", ",", " ", "l", ",", " ", "s", ",", " ", "j", ",", " ", 
             "True"}], "]"}]}], ";", "\n", "    ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"rw", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"Simplify", "[", 
               RowBox[{"e0", " ", "-", " ", "w0"}], "]"}], " ", "===", " ", 
