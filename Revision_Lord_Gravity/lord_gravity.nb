   RowBox[{"(*", " ", 
    RowBox[{"det", " ", "=", " ", "1"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"sP", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a2", ",", " ", "b2"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"c2", ",", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", " ", "+", " ", 
            RowBox[{"b2", " ", "c2"}]}], ")"}], "/", "a2"}]}], "}"}]}], 
      "}"}]}], ";"}], "            ", 
   RowBox[{"(*", " ", 
    RowBox[{
    "a", " ", "second", " ", "matrix", " ", "of", " ", "determinant", " ", 
     "1"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"sigGen", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"s11", ",", " ", "s12"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"s21", ",", " ", "s22"}], "}"}]}], "}"}]}], ";"}], 
   "                ", 
   RowBox[{"(*", " ", 
    RowBox[{"any", " ", "2", "x2", " ", "matrix"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"okEps", " ", "=", " ", 
     RowBox[{"zeroQ", "[", 
      RowBox[{
       RowBox[{"eps", " ", ".", " ", "sS"}], " ", "-", " ", 
       RowBox[{
        RowBox[{"Inverse", "[", 
         RowBox[{"Transpose", "[", "sS", "]"}], "]"}], " ", ".", " ", 
        "eps"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ok123", " ", "=", " ", 
     RowBox[{"zeroQ", "[", 
