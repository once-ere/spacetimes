           RowBox[{"chr", "[", 
            RowBox[{"[", 
             RowBox[{"rr", ",", " ", "n", ",", " ", "s"}], "]"}], "]"}], ",", 
           " ", 
           RowBox[{"X", "[", 
            RowBox[{"[", "m", "]"}], "]"}]}], "]"}], " ", "-", " ", 
