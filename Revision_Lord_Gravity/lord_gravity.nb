}]}]}]}]}]}], "-", "7"}], ":", " ", 
    RowBox[{"quasi", "-", 
     RowBox[{"bound", " ", "states"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"qHead", ",", " ", "qRows"}], "}"}], " ", "=", " ", 
     RowBox[{"readTable", "[", "lgQbsCSV", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"col", "[", "name_", "]"}], " ", ":=", " ", 
     RowBox[{"First", "[", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Position", "[", 
        RowBox[{"qHead", ",", " ", "name"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"qbsRust", "[", 
      RowBox[{"state_", ",", " ", "mmv_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"row", " ", "=", " ", 
         RowBox[{"Select", "[", 
          RowBox[{"qRows", ",", " ", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", 
                RowBox[{"col", "[", "\"\<state\>\"", "]"}], "]"}], "]"}], " ",
               "===", " ", "state"}], " ", "&&", " ", 
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{
                RowBox[{"num", "[", 
                 RowBox[{"#", "[", 
                  RowBox[{"[", 
                   RowBox[{"col", "[", "\"\<Mm\>\"", "]"}], "]"}], "]"}], 
                 "]"}], " ", "-", " ", "mmv"}], "]"}], " ", "<", " ", 
              RowBox[{"10", "^", 
               RowBox[{"-", "9"}]}]}]}], " ", "&"}]}], "]"}]}], "}"}], ",", 
       "\n", "  ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"row", " ", "===", " ", 
          RowBox[{"{", "}"}]}], ",", " ", 
         RowBox[{"Missing", "[", "]"}], ",", " ", 
         RowBox[{
          RowBox[{"num", "[", 
           RowBox[{"row", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", " ", 
              RowBox[{"col", "[", "\"\<Re_omega_over_m\>\"", "]"}]}], "]"}], 
            "]"}], "]"}], " ", "+", " ", 
          RowBox[{"I", " ", 
           RowBox[{"num", "[", 
            RowBox[{"row", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", " ", 
               RowBox[{"col", "[", "\"\<Im_omega_over_m\>\"", "]"}]}], "]"}], 
             "]"}], "]"}]}]}]}], "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "frequency", " ", "is", " ", "raised", " ", "to", " ", "40", 
      " ", "digits", " ", "first"}], ",", " ", 
     RowBox[{
     "so", " ", "that", " ", "every", " ", "number", " ", "in", " ", 
      "NDSolve", " ", "has", " ", "more", " ", "digits", " ", "than", " ", 
      "its", " ", "working", "\n", "   ", "precision"}]}], " ", "*)"}], "\n", 
   
   RowBox[{
    RowBox[{
     RowBox[{"matching", "[", 
      RowBox[{
       RowBox[{"w0_", "?", "NumericQ"}], ",", " ", "m1_", ",", " ", "l1_", ",",
        " ", "rmatch_", ",", " ", "rmax_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"w1", " ", "=", " ", 
          RowBox[{"SetPrecision", "[", 
           RowBox[{"w0", ",", " ", "40"}], "]"}]}], ",", " ", "st", ",", " ", 
         "yh", ",", " ", "es", ",", " ", "vd", ",", " ", "yi"}], "}"}], ",", 
       "\n", "  ", 
       RowBox[{
        RowBox[{"st", " ", "=", " ", 
         RowBox[{"taylorStart", "[", 
          RowBox[{"w1", ",", " ", "m1", ",", " ", "l1", ",", " ", "x0T"}], 
          "]"}]}], ";", "\n", "  ", 
        RowBox[{"yh", " ", "=", " ", 
         RowBox[{"pgSolve", "[", 
          RowBox[{"w1", ",", " ", "m1", ",", " ", "l1", ",", " ", 
           RowBox[{"2", " ", "+", " ", "x0T"}], ",", " ", "st", ",", " ", 
           "rmatch"}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"es", " ", "=", " ", 
         RowBox[{"Eigensystem", "[", 
          RowBox[{"pgMat", "[", 
           RowBox[{"w1", ",", " ", "m1", ",", " ", "l1", ",", " ", "rmax"}], 
           "]"}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"vd", " ", "=", " ", 
         RowBox[{"es", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", " ", 
            RowBox[{"First", "[", 
             RowBox[{"Ordering", "[", 
              RowBox[{
               RowBox[{"Re", "[", 
                RowBox[{"es", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", " ", "1"}], 
              "]"}], "]"}]}], "]"}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"yi", " ", "=", " ", 
         RowBox[{"pgSolve", "[", 
          RowBox[{
          "w1", ",", " ", "m1", ",", " ", "l1", ",", " ", "rmax", ",", " ", 
           "vd", ",", " ", "rmatch"}], "]"}]}], ";", "\n", "  ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"yh", "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", 
            RowBox[{"yi", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], " ", "-", " ", 
           RowBox[{
            RowBox[{"yh", "[", 
             RowBox[{"[", "2", "]"}], "]"}], " ", 
            RowBox[{"yi", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Norm", "[", "yh", "]"}], " ", 
           RowBox[{"Norm", "[", "yi", "]"}]}], ")"}]}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"mmQ", " ", "=", " ", 
     RowBox[{"3", "/", "10"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"qbsCases", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<1S1/2\>\"", ",", " ", "1", ",", " ", "1"}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"\"\<2P1/2\>\"", ",", " ", 
         RowBox[{"-", "1"}], ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<2P3/2\>\"", ",", " ", "2", ",", " ", "2"}], "}"}]}], 
      "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dev7", " ", "=", " ", "0"}], ";", " ", 
    RowBox[{"det7", " ", "=", " ", 
     RowBox[{"{", "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"st", " ", "=", " ", 
           RowBox[{"cs", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
          RowBox[{"l1", " ", "=", " ", 
           RowBox[{"cs", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", 
          RowBox[{"n1", " ", "=", " ", 
           RowBox[{"cs", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], ",", " ", "wr", ",", " ", "kap",
           ",", " ", "rmatch", ",", " ", "rmax", ",", " ", "sol", ",", " ", 
          "wq"}], "}"}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{"wr", " ", "=", " ", 
          RowBox[{"SetPrecision", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"qbsRust", "[", 
              RowBox[{"st", ",", " ", 
               RowBox[{"N", "[", "mmQ", "]"}]}], "]"}], " ", "mmQ"}], ",", 
            " ", "40"}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"kap", " ", "=", " ", 
          RowBox[{"Re", "[", 
           RowBox[{"Sqrt", "[", 
            RowBox[{
             RowBox[{"mmQ", "^", "2"}], " ", "-", " ", 
             RowBox[{"wr", "^", "2"}]}], "]"}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"rmatch", " ", "=", " ", 
          RowBox[{
           RowBox[{"n1", "^", "2"}], "/", 
           RowBox[{"mmQ", "^", "2"}]}]}], ";", " ", 
         RowBox[{"rmax", " ", "=", " ", 
          RowBox[{"SetPrecision", "[", 
           RowBox[{
            RowBox[{"45", "/", "kap"}], ",", " ", "40"}], "]"}]}], ";", "\n", 
         "   ", 
         RowBox[{"sol", " ", "=", " ", 
          RowBox[{"FindRoot", "[", 
           RowBox[{
            RowBox[{"matching", "[", 
             RowBox[{
             "ww", ",", " ", "mmQ", ",", " ", "l1", ",", " ", "rmatch", ",", 
              " ", "rmax"}], "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"ww", ",", " ", 
              RowBox[{"wr", " ", 
               RowBox[{"(", 
                RowBox[{"1", " ", "+", " ", 
                 RowBox[{"10", "^", 
                  RowBox[{"-", "4"}]}]}], ")"}]}], ",", " ", 
              RowBox[{"wr", " ", 
               RowBox[{"(", 
                RowBox[{"1", " ", "-", " ", 
                 RowBox[{"10", "^", 
                  RowBox[{"-", "4"}]}]}], ")"}]}]}], "}"}], ",", "\n", 
            "     ", 
            RowBox[{"WorkingPrecision", " ", "->", " ", "30"}], ",", " ", 
            RowBox[{"PrecisionGoal", " ", "->", " ", "20"}], ",", " ", 
            RowBox[{"AccuracyGoal", " ", "->", " ", "22"}], ",", " ", 
            RowBox[{"MaxIterations", " ", "->", " ", "40"}]}], "]"}]}], ";", 
         "\n", "   ", 
         RowBox[{"wq", " ", "=", " ", 
          RowBox[{"ww", " ", "/.", " ", "sol"}]}], ";", "\n", "   ", 
         RowBox[{"dev7", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"dev7", ",", " ", 
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"wq", " ", "-", " ", "wr"}], "]"}], "/", "mmQ"}]}], 
           "]"}]}], ";", "\n", "   ", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"det7", ",", " ", 
           RowBox[{
           "st", " ", "<>", " ", "\"\<: omega/m = \>\"", " ", "<>", " ", 
            RowBox[{"fmt", "[", 
             RowBox[{
              RowBox[{"Re", "[", 
               RowBox[{"wq", "/", "mmQ"}], "]"}], ",", " ", "14"}], "]"}], 
            " ", "<>", " ", "\"\< \>\"", " ", "<>", " ", 
            RowBox[{"fmt", "[", 
             RowBox[{
              RowBox[{"Im", "[", 
               RowBox[{"wq", "/", "mmQ"}], "]"}], ",", " ", "10"}], "]"}], 
            " ", "<>", " ", "\"\< i (Rust \>\"", " ", "<>", "\n", "     ", 
            RowBox[{"fmt", "[", 
             RowBox[{
              RowBox[{"Re", "[", 
               RowBox[{"wr", "/", "mmQ"}], "]"}], ",", " ", "14"}], "]"}], 
            " ", "<>", " ", "\"\< \>\"", " ", "<>", " ", 
            RowBox[{"fmt", "[", 
             RowBox[{
              RowBox[{"Im", "[", 
               RowBox[{"wr", "/", "mmQ"}], "]"}], ",", " ", "10"}], "]"}], 
            " ", "<>", " ", "\"\< i)\>\""}]}], "]"}], ";", "\n", "   ", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<  WS-7 \>\"", ",", " ", 
           RowBox[{"Last", "[", "det7", "]"}]}], "]"}]}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"cs", ",", " ", "qbsCases"}], "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"checkDev", "[", 
     RowBox[{"\"\<WS-7\>\"", ",", 
      " ", "\"\<(Rust LS-8; Python YS-6) the quasi-bound states 1S1/2, 2P1/2 \
and 2P3/2 at Mm = 3/10, found again with \\\nNDSolve in arithmetic of 32 \
digits from the Taylor start of order 20 at r = 2 + 1/20, the decaying local \
eigenvector at \\\nr = 45/kappa, matching at r = n^2/(Mm)^2, and FindRoot \
from starts 1e-4 away from data/lg_schw_qbs.csv: the largest \\\n\
|omega_Wolfram - omega_Rust|/m (the Rust values have the accuracy of double \
precision)\>\"", ",", " ", "dev7", ",", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "11"}]}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"AppendTo", "[", 
     RowBox[{"notes", ",", " ", 
      RowBox[{"\"\<WS-7: \>\"", " ", "<>", " ", 
       RowBox[{"StringRiffle", "[", 
        RowBox[{"det7", ",", " ", "\"\<; \>\""}], "]"}]}]}], "]"}], 
    ";"}]}]}]], "Input",
