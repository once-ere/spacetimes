  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"a", " ", "field", " ", "A", " ", 
        RowBox[{"e", "^", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "i"}], " ", 
           RowBox[{"p", ".", "x"}]}], ")"}]}]}], " ", "+", " ", 
       RowBox[{"B", " ", 
        RowBox[{"e", "^", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"+", "i"}], " ", 
           RowBox[{"p", ".", "x"}]}], ")"}]}], " ", "as", " ", "the", " ", 
