            RowBox[{"solP", ",", " ", 
             RowBox[{"XV", "[", 
              RowBox[{"[", "m", "]"}], "]"}]}], "]"}]}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"m", ",", " ", "4"}], "}"}]}], "]"}], " ", "-", " ", 
       RowBox[{"3", " ", "solP"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"okAnti", " ", "=", " ", 
     RowBox[{"zeroE", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"thetaV", " ", "-", " ", 
           RowBox[{"Transpose", "[", "thetaV", "]"}]}], ")"}], "/", "2"}], 
        ")"}], " ", "/.", " ", "subs"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"offRules", " ", "=", " ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"pp", "[", "i", "]"}], " ", "->", " ", 
          RowBox[{"Function", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"t", ",", " ", "x", ",", " ", "y", ",", " ", "z"}], 
             "}"}], ",", " ", 
            RowBox[{"Evaluate", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"1", " ", "+", " ", 
                 RowBox[{"t", " ", "x"}]}], ",", " ", 
                RowBox[{"y", " ", "-", " ", 
                 RowBox[{"2", " ", 
                  RowBox[{"z", "^", "2"}]}]}], ",", " ", 
                RowBox[{
                 RowBox[{"t", " ", "z"}], " ", "+", " ", "3"}], ",", " ", 
                RowBox[{"x", " ", "y", " ", "t"}]}], "}"}], "[", 
              RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "4"}], "}"}]}], "]"}], ",", "\n", "   ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"qq", "[", "i", "]"}], " ", "->", " ", 
          RowBox[{"Function", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"t", ",", " ", "x", ",", " ", "y", ",", " ", "z"}], 
             "}"}], ",", " ", 
            RowBox[{"Evaluate", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"t", " ", "-", " ", "y"}], ",", " ", 
                RowBox[{"2", " ", "+", " ", 
                 RowBox[{"x", " ", "z"}]}], ",", " ", 
                RowBox[{"y", "^", "2"}], ",", " ", 
                RowBox[{"t", " ", "+", " ", "z"}]}], "}"}], "[", 
              RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "]"}]}], ",", " ", 
