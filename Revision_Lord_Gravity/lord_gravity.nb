Cell[CellGroupData[{

Cell["\<\
8. The quasi-particles are Dirac particles: annihilation (Part VI, Section 33)\
\>", "Chapter",ExpressionUUID->"d6ec775d-b178-4c53-b466-12b86b3caf77"],

Cell[TextData[{
 "The pairing in the superfluid mixes particles and antiparticles of the \
brochon, so its quasi-particles are mixtures too, and it is not obvious which \
of them can annihilate. Theorem L3 of the manuscript answers this: the \
quasi-particle field is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubscriptBox["\[Chi]", 
     StyleBox["LG",
      FontSlant->"Plain"]], "+", 
    SubsuperscriptBox[
     StyleBox["b", "TI"], 
     StyleBox["LG",
      FontSlant->"Plain"], 
     StyleBox["qp",
      FontSlant->"Plain"]], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["\[ScriptCapitalC]",
      FontSlant->"Plain"], 
     StyleBox["LG",
      FontSlant->"Plain"]], 
    SubscriptBox["\[Chi]", 
     StyleBox["LG",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4b52dff6-d6c4-4f98-9263-4a0aaa7e61c9"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["b", "TI"], 
     StyleBox["LG",
      FontSlant->"Plain"], 
     StyleBox["qp",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"-", 
     StyleBox["D", "TI"]}], "/", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["E", "TI"], "+", 
      StyleBox["M", "TI"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ca0cdc6b-2792-4e18-a249-f9f8de067d6c"],
 ", where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Chi]", 
    StyleBox["LG",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "25d441a9-d5e6-4970-945c-d51a99b6b650"],
 " is an ordinary Dirac field of the mass ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["E", "TI"], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        StyleBox["M", "TI"], "2"], "+", "|", 
       StyleBox["D", "TI"], 
       SuperscriptBox["|", "2"]}], ")"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "29a57c9e-b8ab-48ca-b3f4-3f3d6d4a6b3b"],
 "; here, as in the theorem, ",
 Cell[BoxData[
  FormBox[
   StyleBox["M", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a39a9f71-2dba-465c-b6e2-252d91532f2a"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["D", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3a1b8c37-6c3f-4242-8d3d-be006e767dc5"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["E", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5037cf34-c20d-47ec-af2c-8c969043cc12"],
 " are short for the Dirac mass ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["M", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["CJT",
      FontSlant->"Plain"], ",", 
     StyleBox["D",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a4bb61da-2578-4822-a6d7-3e4289655a0e"],
 ", the pair amplitude ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["D", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["CJT",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e0149089-8c21-4cc3-903c-4708a6d9a477"],
 " and the gap ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["CJT",
      FontSlant->"Plain"], ",", 
     StyleBox["gap",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "669b2bad-4cd5-4d33-a03b-9505ec4d4ac8"],
 " of the superfluid. So the quasi-particles are the particles and \
antiparticles of a Dirac field, and the zeugon conserves their number ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["N", "TI"], 
    StyleBox["LG",
     FontSlant->"Plain"], 
    StyleBox["qp",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f2f0ba43-41dd-4382-b166-ab02bf9ac43a"],
 ". This chapter checks the theorem exactly, including in the Fock space of \
the quantized field."
}], "Text",ExpressionUUID->"5b4d6e3b-2933-44cb-8114-33d4fd8d930b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "the", " ", "symbols", " ", "that", " ", "the", " ", "code", " ", "of", " ",
     "this", " ", "chapter", " ", "creates", " ", "live", " ", "in", " ", 
    "the", " ", "context", " ", "LGNB`Annih`", " ", 
    RowBox[{"(", 
     RowBox[{
     "the", " ", "code", " ", "is", " ", "that", " ", "of", " ", "the", " ", 
      "script", " ", 
      RowBox[{
       RowBox[{"wolfram", "/", "source"}], "/", 
       RowBox[{"lg_annih", ".", "wls"}]}]}], ")"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{"Begin", "[", "\"\<LGNB`Annih`\>\"", "]"}], ";"}]}]], "Input",
 CellLabel->
  "In[472]:=",ExpressionUUID->"7cc1ecb8-1d6e-4fe7-be9a-f9da2d0b036a"],

Cell[TextData[{
 "The matrices of the chiral basis and of the pairing term, on the eight \
components of the brochon (four Dirac components times two isospin \
components): ",
 StyleBox["g8",
  FontFamily->"Source Code Pro"],
 " the Dirac matrices, ",
 StyleBox["pm",
  FontFamily->"Source Code Pro"],
 " the matrix ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["P",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LG",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "032f43c1-99f2-4d65-ae18-7956e123ab8c"],
 ", ",
 StyleBox["t3",
  FontFamily->"Source Code Pro"],
 " the generator ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
