Cell[CellGroupData[{

Cell["WC-2: the limit of the charge by accretion", "Section",ExpressionUUID->"f789e610-15a7-4a59-9589-425076784723"],

Cell[TextData[{
 "A charged black hole repels particles of the same sign. A quasi-particle \
that starts at rest far away, with the ratio of its charge to its mass \
written as the length ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["LG",
     FontSlant->"Plain"], 
    StyleBox["acc",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "84a9e8e4-f3a5-4268-bedb-d2bfe249f5f5"],
 " (30.2), reaches the horizon only if its radial velocity squared, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "-", 
       SubsuperscriptBox[
        StyleBox["x", "TI"], 
        StyleBox["LG",
         FontSlant->"Plain"], 
        StyleBox["acc",
         FontSlant->"Plain"]], "/", 
       StyleBox["r", "TI"]}], ")"}], "2"], "-", 
    SubsuperscriptBox[
     StyleBox["f", "TI"], 
     StyleBox["LG",
      FontSlant->"Plain"], 
     StyleBox["RN",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "48512b40-7781-4a8a-b562-85f718587268"],
 ", stays positive all the way down. In units ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["\[ScriptCapitalM]",
      FontSlant->"Plain"], 
     StyleBox["LG",
      FontSlant->"Plain"]], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "58f9584a-c0cc-4bfa-bb3f-441aff9f88a6"],
 " (in the code ",
 StyleBox["x",
  FontFamily->"Source Code Pro"],
 " for ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["LG",
     FontSlant->"Plain"], 
    StyleBox["acc",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "59c09de4-782e-4f4a-b5dc-1425c2a109c7"],
 ", ",
 StyleBox["q2",
  FontFamily->"Source Code Pro"],
 " for ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["\[ScriptCapitalQ]",
       FontSlant->"Plain"], 
      StyleBox["LG",
       FontSlant->"Plain"], 
      StyleBox["Z",
       FontSlant->"Plain"]], ")"}], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d2ccf69b-3451-4fa1-9feb-aedfc9ffce58"],
 " and ",
 StyleBox["W",
  FontFamily->"Source Code Pro"],
 " for the velocity squared) the check shows the identities that make this \
simple, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["r", "TI"], "2"], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       StyleBox["dr", "TI"], "/", 
       StyleBox["d", "TI"], 
       SubsuperscriptBox["\[Tau]", 
        StyleBox["LG",
         FontSlant->"Plain"], 
        StyleBox["qp",
         FontSlant->"Plain"]]}], ")"}], "2"], "\[LongEqual]", "2", 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LG",
        FontSlant->"Plain"], 
       StyleBox["acc",
        FontSlant->"Plain"]]}], ")"}], 
    StyleBox["r", "TI"], "+", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LG",
        FontSlant->"Plain"], 
       StyleBox["acc",
        FontSlant->"Plain"]], ")"}], "2"], "-", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["\[ScriptCapitalQ]",
        FontSlant->"Plain"], 
       StyleBox["LG",
        FontSlant->"Plain"], 
       StyleBox["Z",
        FontSlant->"Plain"]], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "aaf6b63d-5333-4d5e-bf2a-1d21ed506629"],
 " (with ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Tau]", 
    StyleBox["LG",
     FontSlant->"Plain"], 
    StyleBox["qp",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6a031833-82f5-4d40-b6b6-9ca2d1e73d8a"],
 " the proper time of the quasi-particle) and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["r", "TI"], 
       RowBox[{"+", ",", 
        StyleBox["LG",
         FontSlant->"Plain"]}]], "-", 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LG",
        FontSlant->"Plain"], 
       StyleBox["acc",
        FontSlant->"Plain"]]}], ")"}], "2"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a0225df2-a66a-4035-a761-f68652de2b42"],
 " at the outer horizon ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["r", "TI"], 
    RowBox[{"+", ",", 
     StyleBox["LG",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b39568ce-8b80-4ee2-9445-439799afce40"],
 ", and lets ",
 StyleBox["Reduce",
  FontFamily->"Source Code Pro"],
 " decide for six charges that the velocity squared is positive at every ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r", "TI"], "\[GreaterEqual]", 
    SubscriptBox[
     StyleBox["r", "TI"], 
     RowBox[{"+", ",", 
      StyleBox["LG",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "40b33bfc-c39d-4767-82ac-9227d938a099"],
 " exactly when ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "<", 
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LG",
      FontSlant->"Plain"], 
     StyleBox["acc",
      FontSlant->"Plain"]], "\[LessEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0789571b-89b0-45be-99e1-fc6ce8a1ea61"],
 ". Particles whose charge-to-mass length exceeds the mass of the black hole \
can no longer fall in, which limits the charge that accretion can build up."
}], "Text",ExpressionUUID->"1e03ed15-57e6-4ea0-91d1-fedf661e85ed"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", 
          RowBox[{"--", 
           RowBox[{"--", 
            RowBox[{"--", 
             RowBox[{"--", 
              RowBox[{"--", 
               RowBox[{"--", 
                RowBox[{"--", 
                 RowBox[{"--", 
                  RowBox[{"--", 
                   RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
