                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{
                    "--", " ", 
                    "WW"}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]\
}]}]}]}]}]}], "-", "1"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"5", "/", "4"}], ",", " ", "0", ",", " ", "0", ",", " ", 
       RowBox[{
        RowBox[{"3", "/", "4"}], " ", "I"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"mg", " ", "=", " ", 
     RowBox[{"mll", "[", "g", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"s", " ", "=", " ", 
     RowBox[{"mll", "[", 
      RowBox[{"Conjugate", "[", "g", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sp", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"s", " ", ".", " ", 
        RowBox[{"sig", "[", 
         RowBox[{"[", "m", "]"}], "]"}], " ", ".", " ", 
        RowBox[{"herm", "[", "s", "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"expect", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"DiagonalMatrix", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", "/", "4"}], ",", " ", "4"}], "}"}], "]"}], ",", " ", 
       RowBox[{"sig", "[", 
        RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
       RowBox[{"sig", "[", 
        RowBox[{"[", "3", "]"}], "]"}], ",", " ", 
       RowBox[{"DiagonalMatrix", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", "/", "4"}], ",", " ", 
          RowBox[{"-", "4"}]}], "}"}], "]"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"s4", " ", "=", " ", 
     RowBox[{"ArrayFlatten", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"s", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", 
          RowBox[{"Inverse", "[", 
           RowBox[{"herm", "[", "s", "]"}], "]"}]}], "}"}]}], "}"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"s4ll", " ", "=", " ", 
     RowBox[{"ArrayFlatten", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Inverse", "[", 
           RowBox[{"herm", "[", "mg", "]"}], "]"}], ",", " ", "0"}], "}"}], ",",
         " ", 
