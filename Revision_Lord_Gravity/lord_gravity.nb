              RowBox[{"[", "b", "]"}], "]"}]}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"b", ",", " ", "4"}], "}"}]}], "]"}]}], ",", " ", 
         RowBox[{"{", 
