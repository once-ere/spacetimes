Cell[CellGroupData[{

Cell["WG-1: the Schwarzschild space-time in the static tetrad", "Section",ExpressionUUID->"17ca9976-d7fb-47cc-8045-3721e03197ad"],

Cell[TextData[{
 "The Schwarzschild black hole of the mass ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["M", "TI"], 
    StyleBox["LG",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "38fc046a-bef0-4d2f-9a8d-b23ca67343a1"],
 " has the metric ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["f", "TI"], 
     StyleBox["LG",
      FontSlant->"Plain"]], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    SuperscriptBox[
     StyleBox["t", "TI"], "2"], "-", 
    SubsuperscriptBox[
     StyleBox["f", "TI"], 
     StyleBox["LG",
      FontSlant->"Plain"], 
     RowBox[{"-", "1"}]], 
    StyleBox["d", "TI"], 
    SuperscriptBox[
     StyleBox["r", "TI"], "2"], "-", 
    SuperscriptBox[
     StyleBox["r", "TI"], "2"], 
    StyleBox["d", "TI"], 
    SuperscriptBox["\[CapitalOmega]", "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5314fd9d-c065-47a3-b44d-d5041f229aa8"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["f", "TI"], 
     StyleBox["LG",
      FontSlant->"Plain"]], "\[LongEqual]", "1", "-", "2", 
    SubscriptBox[
     StyleBox["\[ScriptCapitalM]",
      FontSlant->"Plain"], 
     StyleBox["LG",
      FontSlant->"Plain"]], "/", 
    StyleBox["r", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7e848f82-216e-446d-a395-db706bbe12dd"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["\[ScriptCapitalM]",
      FontSlant->"Plain"], 
     StyleBox["LG",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["N",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LG",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c7a0020d-bf1e-4fd0-a306-86dd5fbe1e19"],
 " is the mass as a length (units ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["c", "TI"], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "07aaa5a6-a3f9-47de-9b9e-24f3761fde23"],
 "; in the code ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["N",
      FontSlant->"Plain"]], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "646fd559-4d2c-45d0-8540-b658b4b568d4"],
 ", the mass ",
 StyleBox["M",
  FontFamily->"Source Code Pro"],
 " and ",
 StyleBox["fS",
  FontFamily->"Source Code Pro"],
 " for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["f", "TI"], 
    StyleBox["LG",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "11fcb163-dd66-4284-802c-37799e024d09"],
 "). The static tetrad is the diagonal one, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], "0"], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["f", "TI"], 
     StyleBox["LG",
      FontSlant->"Plain"], 
     RowBox[{"1", "/", "2"}]], 
    StyleBox["dt", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "060a74f7-568d-460b-9590-b18f8e506ba2"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], "1"], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["f", "TI"], 
     StyleBox["LG",
      FontSlant->"Plain"], 
     RowBox[{
      RowBox[{"-", "1"}], "/", "2"}]], 
    StyleBox["dr", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "84c6520f-cbf0-4e5f-82c0-07b26483033b"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], "2"], "\[LongEqual]", 
    StyleBox["r", "TI"], "\[ThinSpace]", 
    StyleBox["d", "TI"], "\[Theta]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8de6e41f-74c5-4d6d-b87f-c3f94efc6859"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], "3"], "\[LongEqual]", 
    StyleBox["r", "TI"], "\[ThinSpace]", 
    StyleBox["sin",
     FontSlant->"Plain"], "\[ThinSpace]", "\[Theta]", "\[ThinSpace]", 
    StyleBox["d", "TI"], "\[CurlyPhi]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d4b94d42-45f4-4f89-9753-d5d05eca0f8b"],
 ". The check computes from it: the Ricci tensor (zero: the space-time is \
empty), the Kretschmann invariant ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["R", "TI"], 
     RowBox[{"\[Mu]", "\[Nu]", "\[Rho]", "\[Sigma]"}]], 
    SuperscriptBox[
     StyleBox["R", "TI"], 
     RowBox[{"\[Mu]", "\[Nu]", "\[Rho]", "\[Sigma]"}]], "\[LongEqual]", "48", 
    
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalM]",
      FontSlant->"Plain"], 
     StyleBox["LG",
      FontSlant->"Plain"], "2"], "/", 
    SuperscriptBox[
     StyleBox["r", "TI"], "6"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "927e5e0c-1601-4d6b-9554-511fb86b188d"],
 " (finite at the horizon ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r", "TI"], "\[LongEqual]", "2", 
    SubscriptBox[
     StyleBox["\[ScriptCapitalM]",
      FontSlant->"Plain"], 
     StyleBox["LG",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8ed60f92-5fb9-416d-9d43-908275629116"],
 ", infinite at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3fc614fa-e64a-4ad9-8978-44c3bc01e5f7"],
 ": the horizon is not a singularity of the geometry, the centre is), the \
spinor connection ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalGamma]", "\[Mu]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1b091114-27a9-4110-b271-4b930887d114"],
 " in closed form, the covariant constancy of the Dirac matrices, and the \
curvature of the spinor connection, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "4"], 
    SubsuperscriptBox[
     StyleBox["R", "TI"], 
     RowBox[{
      StyleBox["ab", "TI"], "\[Mu]", "\[Nu]"}], 
     StyleBox["LG",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["ab", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "47e7e767-201a-45ae-ab46-5a87a7ee1efe"],
 ". The last is checked for every static, spherically symmetric tetrad with \
an arbitrary function ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["h", "TI"], 
     StyleBox["LG",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["r", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "155fce0d-34c5-4868-9d0c-3bf8e718cfba"],
 " in place of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["f", "TI"], 
    StyleBox["LG",
     FontSlant->"Plain"], 
    RowBox[{"1", "/", "2"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f4fb0192-9f0f-4cf5-8ae1-3ed337f0c8ec"],
 ", which avoids square roots that ",
 StyleBox["Simplify",
  FontFamily->"Source Code Pro"],
 " does not always remove."
}], "Text",ExpressionUUID->"780024a6-3685-47a4-9ec7-a7fa84a5718f"],

