  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"The", " ", "top", " ", "lies", " ", "at", " ", "z", "*"}], " ", 
     "=", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"alpha", "/", 
        RowBox[{"(", 
         RowBox[{"2", "k"}], ")"}]}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"1", "/", "3"}], ")"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"where", " ", 
       RowBox[{"dV", "/", "dz"}]}], " ", "=", " ", 
