          RowBox[{"[", "n", "]"}], "]"}]}], " ", "-", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"geo", "[", "\"\<spc\>\"", "]"}], "[", 
          RowBox[{"[", "n", "]"}], "]"}], " ", ".", " ", 
         RowBox[{
          RowBox[{"geo", "[", "\"\<spc\>\"", "]"}], "[", 
