           " ", 
           RowBox[{"X", "[", 
            RowBox[{"[", "n", "]"}], "]"}]}], "]"}], " ", "+", "\n", "     ", 
         
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"chr", "[", 
              RowBox[{"[", 
               RowBox[{"rr", ",", " ", "m", ",", " ", "l"}], "]"}], "]"}], " ", 
