       " ", "\"\<, eigenvalues \>\"", " ", "<>", "\n", "   ", 
       RowBox[{"ToString", "[", 
        RowBox[{"InputForm", "[", "evEF", "]"}], "]"}]}]}], "]"}], 
    ";"}]}]}]], "Input",
