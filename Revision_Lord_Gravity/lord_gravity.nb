    RowBox[{"Dalgarno", "-", "Lewis"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"fdl", " ", "=", " ", 
     RowBox[{"kk", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"r", "^", "3"}], "/", "3"}], " ", "+", " ", 
        RowBox[{
         RowBox[{"r", "^", "2"}], "/", "2"}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"okDL", " ", "=", " ", 
     RowBox[{
      RowBox[{"Simplify", "[", 
