           RowBox[{"z", "^", "3"}]}]}], " ", "-", " ", 
         RowBox[{"2", "k"}]}], " ", "<", " ", "0"}]}]}], ";", " ", 
     RowBox[{
     "all", " ", "quantities", " ", "are", "\n", "   ", "positive"}]}], ",", 
    " ", 
    RowBox[{
    "so", " ", "the", " ", "powers", " ", "may", " ", "be", " ", "expanded", " ", 
     RowBox[{
      RowBox[{"(", "PowerExpand", ")"}], ".", "  ", 
