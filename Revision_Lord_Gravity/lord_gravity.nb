Cell[TextData[{
 "The function ",
 StyleBox["geometry",
  FontFamily->"Source Code Pro"],
 " of the previous chapter, written again (this chapter has its own context), \
and the Dirac operator ",
 StyleBox["dirac[geo, psi, mass]",
  FontFamily->"Source Code Pro"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LongEqual]", 
    StyleBox["i", "TI"], 
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LG",
      FontSlant->"Plain"], 
     StyleBox["k", "TI"]], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[PartialD]", 
       StyleBox["k", "TI"]], "+", 
      SubsuperscriptBox["\[CapitalGamma]", 
       StyleBox["k", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}], "\[Psi]", "-", 
    StyleBox["m", "TI"], "\[Psi]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "484d94d2-93fa-4774-82d3-f74bdb2bc6a7"],
 "; ",
 StyleBox["angRules",
  FontFamily->"Source Code Pro"],
 " are the angular equations (18.4), ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LG",
      FontSlant->"Plain"], "\[Prime]"], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["m", "TI"], 
       RowBox[{
        StyleBox["j", "TI"], ",", 
        StyleBox["LG",
         FontSlant->"Plain"]}]], "/", "\[ThinSpace]", 
      StyleBox["sin",
       FontSlant->"Plain"], "\[ThinSpace]", "\[Theta]"}], ")"}], 
    SubscriptBox["\[Alpha]", 
     StyleBox["LG",
      FontSlant->"Plain"]], "-", 
    SubscriptBox["\[Lambda]", 
     StyleBox["LG",
      FontSlant->"Plain"]], 
    SubscriptBox["\[Beta]", 
     StyleBox["LG",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f9f816cb-9df2-43c2-a55c-750dd5ad1a35"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Beta]", 
     StyleBox["LG",
      FontSlant->"Plain"], "\[Prime]"], "\[LongEqual]", 
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["m", "TI"], 
        RowBox[{
         StyleBox["j", "TI"], ",", 
         StyleBox["LG",
          FontSlant->"Plain"]}]], "/", "\[ThinSpace]", 
       StyleBox["sin",
        FontSlant->"Plain"], "\[ThinSpace]", "\[Theta]"}], ")"}]}], 
    SubscriptBox["\[Beta]", 
     StyleBox["LG",
      FontSlant->"Plain"]], "+", 
    SubscriptBox["\[Lambda]", 
     StyleBox["LG",
      FontSlant->"Plain"]], 
    SubscriptBox["\[Alpha]", 
     StyleBox["LG",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9edac29f-8160-4139-a459-228202db7d7c"],
 "."
}], "Text",ExpressionUUID->"9c5e6c75-f739-4ed2-9035-0f570926fed1"],

