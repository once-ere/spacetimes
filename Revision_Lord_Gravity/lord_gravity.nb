}]}]}]}]}]}], "-", "2"}], ":", " ", 
    RowBox[{
    "the", " ", "tidal", " ", "field", " ", "along", " ", "the", " ", 
     "fall"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"xs", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"tt", ",", " ", "rr", ",", " ", "th", ",", " ", "ph"}], "}"}]}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"vv", " ", "=", " ", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"2", " ", 
       RowBox[{"mm", "/", "rr"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", " ", "-", " ", 
          RowBox[{"vv", "^", "2"}]}], ",", " ", 
         RowBox[{"-", "vv"}], ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "vv"}], ",", " ", 
         RowBox[{"-", "1"}], ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
       
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0", ",", " ", 
         RowBox[{"-", 
          RowBox[{"rr", "^", "2"}]}], ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0", ",", " ", "0", ",", " ", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"rr", "^", "2"}]}], " ", 
          RowBox[{
           RowBox[{"Sin", "[", "th", "]"}], "^", "2"}]}]}], "}"}]}], "}"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"gi", " ", "=", " ", 
     RowBox[{"Simplify", "[", 
      RowBox[{"Inverse", "[", "g", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gam", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"gi", "[", 
             RowBox[{"[", 
              RowBox[{"a", ",", " ", "d"}], "]"}], "]"}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"D", "[", 
               RowBox[{
                RowBox[{"g", "[", 
                 RowBox[{"[", 
                  RowBox[{"d", ",", " ", "b"}], "]"}], "]"}], ",", " ", 
                RowBox[{"xs", "[", 
                 RowBox[{"[", "c", "]"}], "]"}]}], "]"}], " ", "+", " ", 
              RowBox[{"D", "[", 
               RowBox[{
                RowBox[{"g", "[", 
                 RowBox[{"[", 
                  RowBox[{"d", ",", " ", "c"}], "]"}], "]"}], ",", " ", 
                RowBox[{"xs", "[", 
                 RowBox[{"[", "b", "]"}], "]"}]}], "]"}], " ", "-", " ", 
              RowBox[{"D", "[", 
               RowBox[{
                RowBox[{"g", "[", 
                 RowBox[{"[", 
                  RowBox[{"b", ",", " ", "c"}], "]"}], "]"}], ",", " ", 
                RowBox[{"xs", "[", 
                 RowBox[{"[", "d", "]"}], "]"}]}], "]"}]}], ")"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"d", ",", " ", "4"}], "}"}]}], "]"}], "/", "2"}], "]"}], ",",
        "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "4"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"b", ",", " ", "4"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"c", ",", " ", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"R", "^", "a_"}], 
      RowBox[{"{", 
       RowBox[{"b", " ", "c", " ", "d"}], "}"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"d_c", " ", 
       RowBox[{"Gamma", "^", "a_"}], 
       RowBox[{"{", 
        RowBox[{"d", " ", "b"}], "}"}]}], " ", "-", " ", 
      RowBox[{"d_d", " ", 
       RowBox[{"Gamma", "^", "a_"}], 
       RowBox[{"{", 
        RowBox[{"c", " ", "b"}], "}"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"Gamma", "^", "a_"}], 
       RowBox[{"{", 
        RowBox[{"c", " ", "l"}], "}"}], " ", 
       RowBox[{"Gamma", "^", "l_"}], 
       RowBox[{"{", 
        RowBox[{"d", " ", "b"}], "}"}]}], " ", "-", " ", 
      RowBox[{
       RowBox[{"Gamma", "^", "a_"}], 
       RowBox[{"{", 
        RowBox[{"d", " ", "l"}], "}"}], " ", 
       RowBox[{"Gamma", "^", "l_"}], 
       RowBox[{"{", 
        RowBox[{"c", " ", "b"}], "}"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"riem", "[", 
      RowBox[{"a_", ",", " ", "b_", ",", " ", "c_", ",", " ", "d_"}], "]"}], 
     " ", ":=", " ", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"gam", "[", 
         RowBox[{"[", 
          RowBox[{"a", ",", " ", "d", ",", " ", "b"}], "]"}], "]"}], ",", " ", 
        RowBox[{"xs", "[", 
         RowBox[{"[", "c", "]"}], "]"}]}], "]"}], " ", "-", " ", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"gam", "[", 
         RowBox[{"[", 
          RowBox[{"a", ",", " ", "c", ",", " ", "b"}], "]"}], "]"}], ",", " ", 
        RowBox[{"xs", "[", 
         RowBox[{"[", "d", "]"}], "]"}]}], "]"}], " ", "+", "\n", "   ", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"gam", "[", 
           RowBox[{"[", 
            RowBox[{"a", ",", " ", "c", ",", " ", "l"}], "]"}], "]"}], " ", 
          RowBox[{"gam", "[", 
           RowBox[{"[", 
            RowBox[{"l", ",", " ", "d", ",", " ", "b"}], "]"}], "]"}]}], " ", 
         "-", " ", 
         RowBox[{
          RowBox[{"gam", "[", 
