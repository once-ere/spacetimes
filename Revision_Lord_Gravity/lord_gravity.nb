          RowBox[{"[", "4", "]"}], "]"}]}], "]"}], " ", "===", " ", 
       RowBox[{"1", "/", "2"}]}], " ", "&&", "\n", "  ", 
      RowBox[{"zeroQ", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"g2", "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", ".", " ", 
            RowBox[{"g2", "[", 
             RowBox[{"[", "4", "]"}], "]"}]}], " ", "+", " ", 
           RowBox[{
            RowBox[{"g2", "[", 
             RowBox[{"[", "4", "]"}], "]"}], " ", ".", " ", 
            RowBox[{"g2", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}]}], ")"}], "/", "2"}], " ", "-", 
        " ", 
        RowBox[{
         RowBox[{"IdentityMatrix", "[", "4", "]"}], "/", "2"}]}], "]"}]}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WW-2\>\"", ",", 
      " ", "\"\<(LW-4) the set (sigma_0, sigma_1, sigma_2, sigma_3 + \
sigma_0/2): Hermitian, linearly independent (the \\\ndeterminant of the \
coefficients is 1), N_LG(sigma''_0, sigma''_3) = 1/2, (1/2){gamma''^0, \
gamma''^3} = (1/2) 1_4 (exact)\>\"", ",", " ", "ok2", ",", "\n", "  ", 
      RowBox[{"\"\<det \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"Det", "[", "coef", "]"}], "]"}], " ", "<>", 
       " ", "\"\<, N03 \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"InputForm", "[", 
         RowBox[{"ndet", "[", 
          RowBox[{
           RowBox[{"s2", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
           RowBox[{"s2", "[", 
            RowBox[{"[", "4", "]"}], "]"}]}], "]"}], "]"}], "]"}]}]}], "]"}], 
    ";"}]}]}]], "Input",
