Cell[CellGroupData[{

Cell["WL-6: the factor 2 of the connection of the vectors", "Section",ExpressionUUID->"328bc585-a1ca-4781-a704-8cd5c11b2bbb"],

Cell[TextData[{
 "A spinor connection ",
 Cell[BoxData[
  FormBox["\[CapitalGamma]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "890a1986-2999-4ec1-8b47-916ec839f3ef"],
 " induces a connection ",
 Cell[BoxData[
  FormBox[
   StyleBox["C", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "86eb26da-13fb-45a2-8669-6af72ac12e00"],
 " on vectors through the commutator with the Dirac matrices: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"\[CapitalGamma]", ",", 
     SubscriptBox["\[Gamma]", 
      StyleBox["b", "TI"]]}], "]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9f6dc397-1681-4ec6-b30a-6ed633f413fe"],
 " is a combination of the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", 
    StyleBox["e", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "93730161-3e39-447e-9602-9e92feb61533"],
 ", and its coefficients are ",
 Cell[BoxData[
  FormBox[
   StyleBox["C", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f30c62dd-8117-464e-91fb-a9568e60d077"],
 ". In Lord's special gauge (constant Dirac matrices) with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalGamma]", "\[LongEqual]", 
    FractionBox["1", "2"], 
    StyleBox["g", "TI"], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["bc", "TI"]], 
    SuperscriptBox["\[Gamma]", 
     StyleBox["bc", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4e90526a-9f39-42ca-9c5a-8f00e169151a"],
 ", the check computes the coefficients for six symbolic ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["bc", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7951af76-beb9-4001-be60-2782c4c61bd1"],
 " and finds ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["C", "TI"], "\[LongEqual]", "2", 
    StyleBox["g", "TI"], "\[ThinSpace]", 
    StyleBox["a", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "72f59a4f-65ef-43c8-863f-0476b50097aa"],
 ", twice the value that Lord prints in (4.20) and (5.2)."
}], "Text",ExpressionUUID->"cbf7f78a-b806-4218-b1ec-893ade84d3c4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
