         RowBox[{"gam", "[", 
          RowBox[{"[", "1", "]"}], "]"}], " ", "mass"}]}], ",", " ", 
       RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"qv", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"q1", ",", " ", "q2", ",", " ", "q3"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"pm", " ", "=", " ", 
     RowBox[{"dd", " ", 
      RowBox[{"ConjugateTranspose", "[", "k3", "]"}]}]}], ";"}], 
   "                                          ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"D", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"K", "^", "3"}], ")"}], "^", "dag"}]}], ",", " ", 
     RowBox[{"D", " ", "real"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"pmDag", " ", "=", " ", 
     RowBox[{"dd", " ", "k3"}]}], ";"}], 
   "                                                           ", 
   RowBox[{"(*", " ", 
    RowBox[{"its", " ", "Hermitian", " ", "conjugate", " ", "D", " ", 
     RowBox[{"K", "^", "3"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"hb", " ", "=", " ", 
     RowBox[{"ArrayFlatten", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"h8", "[", 
           RowBox[{"qv", ",", " ", "mM"}], "]"}], ",", " ", "pm"}], "}"}], ",",
         " ", 
        RowBox[{"{", 
         RowBox[{"pmDag", ",", " ", 
          RowBox[{"-", 
           RowBox[{"Transpose", "[", 
            RowBox[{"h8", "[", 
             RowBox[{
              RowBox[{"-", "qv"}], ",", " ", "mM"}], "]"}], "]"}]}]}], 
         "}"}]}], "}"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"assum", " ", "=", " ", 
     RowBox[{"Element", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "q1", ",", " ", "q2", ",", " ", "q3", ",", " ", "mM", ",", " ", 
         "dd"}], "}"}], ",", " ", "Reals"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"hsq", " ", "=", " ", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"ConjugateTranspose", "[", "hb", "]"}], " ", "-", " ", "hb"}],
        ",", " ", "assum"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sq", " ", "=", " ", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"hb", " ", ".", " ", "hb"}], " ", "-", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"q1", "^", "2"}], " ", "+", " ", 
           RowBox[{"q2", "^", "2"}], " ", "+", " ", 
           RowBox[{"q3", "^", "2"}], " ", "+", " ", 
           RowBox[{"mM", "^", "2"}], " ", "+", " ", 
           RowBox[{"dd", "^", "2"}]}], ")"}], " ", 
         RowBox[{"IdentityMatrix", "[", "16", "]"}]}]}], ",", " ", "assum"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ok4", " ", "=", " ", 
     RowBox[{
      RowBox[{"zeroQ", "[", "hsq", "]"}], " ", "&&", " ", 
      RowBox[{"zeroQ", "[", "sq", "]"}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"Simplify", "[", 
        RowBox[{"Tr", "[", "hb", "]"}], "]"}], " ", "===", " ", "0"}]}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WW-4\>\"", ",", 
      " ", "\"\<(LW-6) the Bogoliubov-de Gennes matrix with the normal \
self-energy (M - m_LL) beta (x) 1_2 and the pair \\\nself-energy D (K^3)^dag, \
for symbolic real q, M, D: Hermitian, its square is (|q|^2 + M^2 + D^2) 1_16 \
and its trace is 0, \\\nso its eigenvalues are -E(q) and +E(q) eight times \
each (exact)\>\"", ",", " ", "ok4", ",", "\n", "  ", 
      RowBox[{"\"\<H^2 - E^2 1 = 0: \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"zeroQ", "[", "sq", "]"}], "]"}], " ", "<>", 
       " ", "\"\<, tr H = \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"Simplify", "[", 
         RowBox[{"Tr", "[", "hb", "]"}], "]"}], "]"}]}]}], "]"}], 
    ";"}]}]}]], "Input",
 CellLabel->
  "In[563]:=",ExpressionUUID->"a3095a9e-8ce2-44d6-8486-601f7535ceb1"],

Cell[BoxData["\<\"PASS WW-4     (LW-6) the Bogoliubov-de Gennes matrix with \
the normal self-energy (M - m_LL) beta (x) 1_2 and the pair self-energy D \
(K^3)^dag, for symbolic real q, M, D: Hermitian, its square is (|q|^2 + M^2 + \
D^2) 1_16 and its trace is 0, so its eigenvalues are -E(q) and +E(q) eight \
times each (exact) [H^2 - E^2 1 = 0: True, tr H = 0]\"\>"], "Print",
 CellChangeTimes->{4.004398284100419*^9},
 CellLabel->
  "During evaluation of \
In[563]:=",ExpressionUUID->"61ca2f17-9fcc-4698-a79c-6e10502ddc49"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["WW-5: the gap equation", "Section",ExpressionUUID->"26b67d65-37dc-4c4e-983a-d624d48996f3"],

Cell[TextData[{
 "The size of the gap is fixed by a gap equation that contains the integral \
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["I", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{"(", "1", ")"}]], 
    RowBox[{"(", 
     StyleBox["M", "TI"], ")"}], "\[LongEqual]", 
    SubsuperscriptBox["\[Integral]", "0", "1"], "\[ThinSpace]", 
    SuperscriptBox[
     StyleBox["q", "TI"], "2"], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        StyleBox["q", "TI"], "2"], "+", 
       SuperscriptBox[
        StyleBox["M", "TI"], "2"]}], ")"}], 
     RowBox[{
      RowBox[{"-", "1"}], "/", "2"}]], 
    StyleBox["dq", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ccc93f50-06da-47af-9e10-a0941687fa4f"],
 " (A.19, with the cutoff ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b297917a-8fe2-498b-aa37-a4d00d534a40"],
 "). The check computes the integral with ",
 StyleBox["Integrate",
  FontFamily->"Source Code Pro"],
 ", compares it with the closed form of (A.19) symbolically and as numbers of \
40 digits, and then puts the printed numbers of the manuscript into the gap \
equation of the method CJT, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["CJT",
       FontSlant->"Plain"], ",", 
      StyleBox["P",
       FontSlant->"Plain"]}]], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["I", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{"(", "1", ")"}]], 
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["E", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["CJT",
        FontSlant->"Plain"], ",", 
       StyleBox["gap",
        FontSlant->"Plain"]}]], ")"}], "/", 
    SuperscriptBox["\[Pi]", "2"], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "70db5136-15aa-4742-9976-86dde726b8c6"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["CJT",
       FontSlant->"Plain"], ",", 
      StyleBox["P",
       FontSlant->"Plain"]}]], "\[LongEqual]", "23.7"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b952e897-e72e-4dcd-95f3-bf0e9e30c8b5"],
 ", and into ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Pi]", "2"], "/", 
    SubsuperscriptBox[
     StyleBox["I", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{"(", "1", ")"}]], 
    RowBox[{"(", 
     FractionBox["1", "5"], ")"}], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["crit",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5950966b-df39-4d8c-a0d7-38f58cf56eb8"],
 ": both hold to the ten printed digits. The printed numbers come from the \
fragment file ",
 StyleBox["lg_examples.md",
  FontFamily->"Source Code Pro"],
 ", in the closed cell below."
}], "Text",ExpressionUUID->"d87792f3-09e9-450c-ab55-3c424a38299d"],

