                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{
                    "--", " ", 
                    "WL"}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]\
}]}]}]}]}]}], "-", "1"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"r12", " ", "=", " ", 
     RowBox[{"And", " ", "@@", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"bar", "[", 
          RowBox[{"sig", "[", 
           RowBox[{"[", "m", "]"}], "]"}], "]"}], " ", "==", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"m", " ", "==", " ", "1"}], ",", " ", 
           RowBox[{"sig", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
           RowBox[{"-", 
            RowBox[{"sig", "[", 
             RowBox[{"[", "m", "]"}], "]"}]}]}], "]"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"m", ",", " ", "4"}], "}"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"r13", " ", "=", " ", 
     RowBox[{"And", " ", "@@", " ", 
      RowBox[{"Flatten", "@", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"sig", "[", 
               RowBox[{"[", "m", "]"}], "]"}], " ", ".", " ", 
              RowBox[{"bar", "[", 
               RowBox[{"sig", "[", 
                RowBox[{"[", "n", "]"}], "]"}], "]"}]}], " ", "+", " ", 
             RowBox[{
              RowBox[{"sig", "[", 
               RowBox[{"[", "n", "]"}], "]"}], " ", ".", " ", 
              RowBox[{"bar", "[", 
               RowBox[{"sig", "[", 
                RowBox[{"[", "m", "]"}], "]"}], "]"}]}]}], ")"}], "/", "2"}], 
          " ", "==", " ", 
          RowBox[{
           RowBox[{"eta", "[", 
            RowBox[{"[", 
             RowBox[{"m", ",", " ", "n"}], "]"}], "]"}], " ", 
           RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"m", ",", " ", "4"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"n", ",", " ", "4"}], "}"}]}], "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"r15", " ", "=", " ", 
     RowBox[{"And", " ", "@@", " ", 
      RowBox[{"Flatten", "@", 
       RowBox[{"Table", "[", "\n", "     ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"smn", "[", 
             RowBox[{"sig", ",", " ", "m", ",", " ", "n"}], "]"}], " ", ".", 
            " ", 
            RowBox[{"smn", "[", 
             RowBox[{"sig", ",", " ", "r", ",", " ", "t"}], "]"}]}], " ", "-",
            " ", 
           RowBox[{
