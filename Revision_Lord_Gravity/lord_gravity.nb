Cell[CellGroupData[{

Cell["WG-2: the freely falling observers (Painleve and Gullstrand)", "Section",ExpressionUUID->"b0b02037-55b1-400d-b81d-08e06c265858"],

Cell[TextData[{
 "The static tetrad is singular at the horizon, because a static observer \
cannot exist there. The observers who fall freely from rest at infinity have \
a tetrad that is regular across the horizon: with their proper time ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Tau]", 
    StyleBox["LG",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8cc0093a-8da3-4679-9467-111184994b94"],
 " as the time coordinate, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], "0"], "\[LongEqual]", 
    StyleBox["d", "TI"], 
    SubscriptBox["\[Tau]", 
     StyleBox["LG",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b3bb567a-3059-49af-934c-a1768cb8e5c4"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], "1"], "\[LongEqual]", 
    StyleBox["dr", "TI"], "+", 
    SubscriptBox[
     StyleBox["w", "TI"], 
     StyleBox["LG",
      FontSlant->"Plain"]], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    SubscriptBox["\[Tau]", 
     StyleBox["LG",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3a33f631-1c9e-4943-aac0-62c7b31a1ba3"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["w", "TI"], 
     StyleBox["LG",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"2", 
       SubscriptBox[
        StyleBox["\[ScriptCapitalM]",
         FontSlant->"Plain"], 
        StyleBox["LG",
         FontSlant->"Plain"]], "/", 
       StyleBox["r", "TI"]}], ")"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "58e3b586-3838-4136-bf1c-bd1ca672e23a"],
 ", their speed (in the code ",
 StyleBox["tT",
  FontFamily->"Source Code Pro"],
 " and ",
 StyleBox["vPG",
  FontFamily->"Source Code Pro"],
 "). The check shows that this is the same space-time (the metric is \
Schwarzschild's after the change ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Tau]", 
     StyleBox["LG",
      FontSlant->"Plain"]], "\[LongEqual]", 
    StyleBox["t", "TI"], "+", "\[Integral]", "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["w", "TI"], 
     StyleBox["LG",
      FontSlant->"Plain"]], "/", 
    SubscriptBox[
     StyleBox["f", "TI"], 
     StyleBox["LG",
      FontSlant->"Plain"]], "\[ThinSpace]", 
    StyleBox["dr", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6812796f-865b-4618-8f08-d9e696e2fdc8"],
 "), computes the spinor connection in closed form, and shows that the \
tetrad, the Christoffel symbols and the spinor connection are finite at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r", "TI"], "\[LongEqual]", "2", 
    SubscriptBox[
     StyleBox["\[ScriptCapitalM]",
      FontSlant->"Plain"], 
     StyleBox["LG",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "71bf5701-6a01-4889-becd-01270f273775"],
 ". Part IV integrates the radial equations of the brochon in this tetrad \
across the horizon."
}], "Text",ExpressionUUID->"4dd94627-83fe-4407-9804-e179bec4a560"],

