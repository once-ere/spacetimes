Cell[CellGroupData[{

Cell["WC-3: the shadow", "Section",ExpressionUUID->"0e0d33b2-fbd6-46f6-91c3-891c7b0fe7bb"],

Cell[TextData[{
 "Light that passes close to a black hole can circle it on the photon sphere, \
where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       StyleBox["r", "TI"], "2"], "/", 
      SubsuperscriptBox[
       StyleBox["f", "TI"], 
       StyleBox["LG",
        FontSlant->"Plain"], 
       StyleBox["RN",
        FontSlant->"Plain"]]}], ")"}], "/", 
    StyleBox["dr", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e8871665-0fc7-438f-90ee-930bf84347da"],
 ", which here is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["r", "TI"], "2"], "-", "3", 
    StyleBox["r", "TI"], "+", "2", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["\[ScriptCapitalQ]",
        FontSlant->"Plain"], 
       StyleBox["LG",
        FontSlant->"Plain"], 
       StyleBox["Z",
        FontSlant->"Plain"]], ")"}], "2"], "\[LongEqual]", "0"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d1ecc55a-4da6-4576-9af0-3fdae27ed870"],
 " (units ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["\[ScriptCapitalM]",
      FontSlant->"Plain"], 
     StyleBox["LG",
      FontSlant->"Plain"]], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2ceb9c02-a7bc-418d-9fb9-e8c2d96bd6cc"],
 "). Light that comes closer falls in, so the black hole casts a shadow whose \
radius, as seen from far away, is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["b", "TI"], 
     StyleBox["LG",
      FontSlant->"Plain"], 
     StyleBox["sh",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        StyleBox["r", "TI"], "2"], "/", 
       SubsuperscriptBox[
        StyleBox["f", "TI"], 
        StyleBox["LG",
         FontSlant->"Plain"], 
        StyleBox["RN",
         FontSlant->"Plain"]]}], ")"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1fa4d0dc-baad-47bf-a321-6d74036bc8d5"],
 " at the photon sphere ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["LG",
     FontSlant->"Plain"], 
    StyleBox["ph",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6fe33b3c-98c2-4229-bb0f-37d132aaf496"],
 ". The check derives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["b", "TI"], 
     StyleBox["LG",
      FontSlant->"Plain"], 
     StyleBox["sh",
      FontSlant->"Plain"]], "\[LongEqual]", "3", 
    SqrtBox["3"], "\[ThinSpace]", 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox[
         StyleBox["\[ScriptCapitalQ]",
          FontSlant->"Plain"], 
         StyleBox["LG",
          FontSlant->"Plain"], 
         StyleBox["Z",
          FontSlant->"Plain"]], ")"}], "2"], "/", "6", "-", "7", 
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox[
         StyleBox["\[ScriptCapitalQ]",
          FontSlant->"Plain"], 
         StyleBox["LG",
          FontSlant->"Plain"], 
         StyleBox["Z",
          FontSlant->"Plain"]], ")"}], "4"], "/", "216", "+", "\[Ellipsis]"}],
      ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ef39037a-51a1-4705-af9c-bcedf1632b46"],
 " for a small charge and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["b", "TI"], 
     StyleBox["LG",
      FontSlant->"Plain"], 
     StyleBox["sh",
      FontSlant->"Plain"]], "\[LongEqual]", "4"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c1d99353-26e0-4711-ba7b-b408e3478449"],
 " for the largest charge, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalQ]",
      FontSlant->"Plain"], 
     StyleBox["LG",
      FontSlant->"Plain"], 
     StyleBox["Z",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["\[ScriptCapitalM]",
      FontSlant->"Plain"], 
     StyleBox["LG",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f2a333c6-115b-450f-a9ba-1769654ddbb2"],
 "; the charge shrinks the shadow, which is how such a charge could be \
detected (Section 34)."
}], "Text",ExpressionUUID->"658ea395-70e9-46ef-b802-437eb91f7aa8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", 
          RowBox[{"--", 
           RowBox[{"--", 
            RowBox[{"--", 
             RowBox[{"--", 
              RowBox[{"--", 
               RowBox[{"--", 
                RowBox[{"--", 
                 RowBox[{"--", 
                  RowBox[{"--", 
                   RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{
                    "--", " ", 
                    "WC"}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]\
}]}]}]}]}]}], "-", "3"}], ":", " ", 
    RowBox[{"the", " ", "shadow"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"phi", " ", "=", " ", 
     RowBox[{
      RowBox[{"r", "^", "2"}], "/", "fq"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"crit", " ", "=", " ", 
     RowBox[{"Factor", "[", 
      RowBox[{"Together", "[", 
       RowBox[{"D", "[", 
        RowBox[{"phi", ",", " ", "r"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rph", " ", "=", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"3", " ", "+", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"9", " ", "-", " ", 
          RowBox[{"8", " ", "q2"}]}], "]"}]}], ")"}], "/", "2"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"onSphere", " ", "=", " ", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"r", "^", "2"}], " ", "-", " ", 
         RowBox[{"3", " ", "r"}], " ", "+", " ", 
         RowBox[{"2", " ", "q2"}]}], ")"}], " ", "/.", " ", 
       RowBox[{"r", " ", "->", " ", "rph"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"bc", " ", "=", " ", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{"phi", " ", "/.", " ", 
        RowBox[{"r", " ", "->", " ", "rph"}]}], "]"}], " ", "/.", " ", 
      RowBox[{"q2", " ", "->", " ", 
       RowBox[{"eps", "^", "2"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ser", " ", "=", " ", 
     RowBox[{"Normal", "[", 
      RowBox[{"Series", "[", 
       RowBox[{"bc", ",", " ", 
        RowBox[{"{", 
         RowBox[{"eps", ",", " ", "0", ",", " ", "4"}], "}"}]}], "]"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"okSer", " ", "=", " ", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{"ser", " ", "-", " ", 
        RowBox[{"3", " ", 
         RowBox[{"Sqrt", "[", "3", "]"}], " ", 
         RowBox[{"(", 
          RowBox[{"1", " ", "-", " ", 
           RowBox[{
            RowBox[{"eps", "^", "2"}], "/", "6"}], " ", "-", " ", 
           RowBox[{"7", " ", 
            RowBox[{
             RowBox[{"eps", "^", "4"}], "/", "216"}]}]}], ")"}]}]}], "]"}], 
      " ", "===", " ", "0"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ext", " ", "=", " ", 
     RowBox[{"Simplify", "[", 
      RowBox[{"bc", " ", "/.", " ", 
       RowBox[{"eps", " ", "->", " ", "1"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WC-3\>\"", ",", 
      " ", "\"\<(Rust LC-2, LC-3; Python YC-3) d(r^2/f)/dr = 0 is r^2 - 3 r + \
2 Qg^2 = 0, solved by r_ph = (3 + (9 - 8 \\\nQg^2)^(1/2))/2; b_c = 3 3^(1/2) \
(1 - Qg^2/6 - 7 Qg^4/216 + ...) and b_c = 4 for the extremal charge (M = 1)\>\
\"", ",", "\n", "  ", 
      RowBox[{
       RowBox[{"onSphere", " ", "===", " ", "0"}], " ", "&&", " ", "okSer", 
       " ", "&&", " ", 
       RowBox[{"ext", " ", "===", " ", "4"}]}], ",", "\n", "  ", 
      RowBox[{"\"\<d/dr (r^2/f) = \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"InputForm", "[", "crit", "]"}], "]"}], " ", "<>", 
       " ", "\"\<; series \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"InputForm", "[", "ser", "]"}], "]"}], " ", "<>", 
       " ", "\"\<; extremal \>\"", " ", "<>", "\n", "   ", 
       RowBox[{"ToString", "[", 
        RowBox[{"InputForm", "[", "ext", "]"}], "]"}]}]}], "]"}], 
    ";"}]}]}]], "Input",
 CellLabel->
  "In[395]:=",ExpressionUUID->"cd7178fe-c861-4b54-b478-60b43f620d4d"],

Cell[BoxData["\<\"PASS WC-3     (Rust LC-2, LC-3; Python YC-3) d(r^2/f)/dr = \
0 is r^2 - 3 r + 2 Qg^2 = 0, solved by r_ph = (3 + (9 - 8 Qg^2)^(1/2))/2; b_c \
= 3 3^(1/2) (1 - Qg^2/6 - 7 Qg^4/216 + ...) and b_c = 4 for the extremal \
charge (M = 1) [d/dr (r^2/f) = (2*r^3*(2*q2 - 3*r + r^2))/(q2 - 2*r + r^2)^2; \
series 3*Sqrt[3] - (Sqrt[3]*eps^2)/2 - (7*eps^4)/(24*Sqrt[3]); extremal \
4]\"\>"], "Print",
 CellChangeTimes->{4.004398282391438*^9},
 CellLabel->
  "During evaluation of \
In[395]:=",ExpressionUUID->"3432db0c-d4de-45f5-92ab-5e693c846631"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
