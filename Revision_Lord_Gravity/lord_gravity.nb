Cell[CellGroupData[{

Cell["WL-4: an infinitesimal Lorentz transformation", "Section",ExpressionUUID->"591174f9-b6b6-4a3c-9b16-4be7c6348091"],

Cell[TextData[{
 "Lord's (1.8) says that the spinor matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["L", "TI"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "2"], "+", 
    FractionBox["1", "4"], 
    SubscriptBox["\[Lambda]", 
     RowBox[{"\[Mu]", "\[Nu]"}]], 
    SubsuperscriptBox["\[Sigma]", 
     StyleBox["LG",
      FontSlant->"Plain"], 
     RowBox[{"\[Mu]", "\[Nu]"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b7c53dff-b4f7-4be4-99c0-03205efa380c"],
 " and the Lorentz matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[CapitalLambda]", "\[Mu]"], 
     SuperscriptBox["", "\[Nu]"]}], "\[LongEqual]", 
    RowBox[{
     SubsuperscriptBox["\[Delta]", "\[Mu]", "\[Nu]"], "+", 
     RowBox[{
      SuperscriptBox["\[Eta]", 
       RowBox[{"\[Nu]", "\[Rho]"}]], 
      SubscriptBox["\[Lambda]", 
       RowBox[{"\[Rho]", "\[Mu]"}]]}]}]}], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dcdfeaa1-3871-492f-96ff-f7adf515fd23"],
 " belong together: transforming the matrices ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Sigma]", "\[Mu]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0673ca10-52e4-4d4c-857a-40b2a0ed7ffc"],
 " by ",
 Cell[BoxData[
  FormBox[
   StyleBox["L", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8f61249d-22aa-4681-b94d-921a6f946a4d"],
 " is the same as transforming their index by ",
 Cell[BoxData[
  FormBox["\[CapitalLambda]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "24e73d5d-0da2-44a9-b5d8-6a868ea38e73"],
 ". The check takes the six parameters ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Lambda]", 
    RowBox[{"\[Mu]", "\[Nu]"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bccfef8e-e1d7-478e-b69e-47adc7de2503"],
 " as real symbols and verifies the relation to first order in them, where it \
is a linear identity."
}], "Text",ExpressionUUID->"a325f3c2-0d99-4cd3-8586-b3392c12d82b"],

