                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{
                    "--", " ", 
                    "WS"}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]\
}]}]}]}]}]}], "-", "8"}], ":", " ", 
     RowBox[{"greybody", " ", "factors", " ", "at", " ", "r"}]}], " ", "=", 
    " ", "4000"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"gHead", ",", " ", "gRows"}], "}"}], " ", "=", " ", 
     RowBox[{"readTable", "[", "lgGreyCSV", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"gcol", "[", "name_", "]"}], " ", ":=", " ", 
     RowBox[{"First", "[", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Position", "[", 
        RowBox[{"gHead", ",", " ", "name"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"greyRust", "[", 
      RowBox[{"m1_", ",", " ", "l1_", ",", " ", "w1_"}], "]"}], " ", ":=", 
     " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"row", " ", "=", " ", 
         RowBox[{"Select", "[", 
          RowBox[{"gRows", ",", " ", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{
                RowBox[{"num", "[", 
                 RowBox[{"#", "[", 
                  RowBox[{"[", 
                   RowBox[{"gcol", "[", "\"\<Mm\>\"", "]"}], "]"}], "]"}], 
                 "]"}], " ", "-", " ", "m1"}], "]"}], " ", "<", " ", 
              RowBox[{"10", "^", 
               RowBox[{"-", "9"}]}]}], " ", "&&", "\n", "      ", 
             RowBox[{
              RowBox[{"num", "[", 
               RowBox[{"#", "[", 
                RowBox[{"[", 
                 RowBox[{"gcol", "[", "\"\<lambda\>\"", "]"}], "]"}], "]"}], 
               "]"}], " ", "==", " ", "l1"}], " ", "&&", " ", 
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{
                RowBox[{"num", "[", 
                 RowBox[{"#", "[", 
                  RowBox[{"[", 
                   RowBox[{"gcol", "[", "\"\<M_omega\>\"", "]"}], "]"}], 
                  "]"}], "]"}], " ", "-", " ", "w1"}], "]"}], " ", "<", " ", 
              RowBox[{"10", "^", 
               RowBox[{"-", "9"}]}]}]}], " ", "&"}]}], "]"}]}], "}"}], ",", 
       "\n", "  ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"row", " ", "===", " ", 
          RowBox[{"{", "}"}]}], ",", " ", 
         RowBox[{"Missing", "[", "]"}], ",", " ", 
         RowBox[{"num", "[", 
          RowBox[{"row", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", " ", 
             RowBox[{"gcol", "[", "\"\<Gamma\>\"", "]"}]}], "]"}], "]"}], 
          "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"greyCases", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1", ",", " ", 
         RowBox[{"1", "/", "4"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "/", "5"}], ",", " ", 
         RowBox[{"-", "1"}], ",", " ", 
         RowBox[{"1", "/", "4"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "2", ",", " ", 
         RowBox[{"2", "/", "5"}]}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dev8", " ", "=", " ", "0"}], ";", " ", 
    RowBox[{"det8", " ", "=", " ", 
     RowBox[{"{", "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rFar", " ", "=", " ", "4000"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"m1", " ", "=", " ", 
           RowBox[{"cs", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
          RowBox[{"l1", " ", "=", " ", 
           RowBox[{"cs", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", 
          RowBox[{"w1", " ", "=", " ", 
           RowBox[{"cs", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], ",", " ", "st", ",", " ", "y", ",",
           " ", "wf", ",", " ", "ar", ",", " ", "br", ",", " ", "uu", ",", 
          " ", "wv", ",", " ", "sf", ",", " ", "aa", ",", " ", "bb", ",", " ",
           "cc", ",", " ", "kk", ",", " ", "ab", ",", " ", "gam1", ",", " ", 
          "gr"}], "}"}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{"st", " ", "=", " ", 
          RowBox[{"taylorStart", "[", 
           RowBox[{"w1", ",", " ", "m1", ",", " ", "l1", ",", " ", "x0T"}], 
           "]"}]}], ";", "\n", "   ", 
         RowBox[{"y", " ", "=", " ", 
          RowBox[{"pgSolve", "[", 
           RowBox[{"w1", ",", " ", "m1", ",", " ", "l1", ",", " ", 
            RowBox[{"2", " ", "+", " ", "x0T"}], ",", " ", "st", ",", " ", 
            "rFar"}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"wf", " ", "=", " ", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"2", "/", "rFar"}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"ar", " ", "=", " ", 
          RowBox[{
           RowBox[{"y", "[", 
            RowBox[{"[", "1", "]"}], "]"}], " ", 
           RowBox[{"Sqrt", "[", 
            RowBox[{"1", " ", "-", " ", "wf"}], "]"}]}]}], ";", " ", 
         RowBox[{"br", " ", "=", " ", 
          RowBox[{
           RowBox[{"y", "[", 
            RowBox[{"[", "2", "]"}], "]"}], " ", 
           RowBox[{"Sqrt", "[", 
            RowBox[{"1", " ", "+", " ", "wf"}], "]"}]}]}], ";", "\n", "   ", 
         RowBox[{"uu", " ", "=", " ", 
          RowBox[{"ar", " ", "+", " ", "br"}]}], ";", " ", 
         RowBox[{"wv", " ", "=", " ", 
          RowBox[{"I", " ", 
           RowBox[{"(", 
            RowBox[{"ar", " ", "-", " ", "br"}], ")"}]}]}], ";", "\n", "   ", 
         
         RowBox[{"sf", " ", "=", " ", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"1", " ", "-", " ", 
            RowBox[{"2", "/", "rFar"}]}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"aa", " ", "=", " ", 
          RowBox[{"m1", " ", "sf"}]}], ";", " ", 
         RowBox[{"bb", " ", "=", " ", 
          RowBox[{"w1", " ", "+", " ", 
           RowBox[{"l1", " ", 
            RowBox[{"sf", "/", "rFar"}]}]}]}], ";", " ", 
         RowBox[{"cc", " ", "=", " ", 
          RowBox[{"w1", " ", "-", " ", 
           RowBox[{"l1", " ", 
            RowBox[{"sf", "/", "rFar"}]}]}]}], ";", "\n", "   ", 
         RowBox[{"kk", " ", "=", " ", 
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{"bb", " ", "cc"}], " ", "-", " ", 
            RowBox[{"aa", "^", "2"}]}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"u", ",", " ", "w"}], ")"}], " ", "=", " ", 
             RowBox[{
              RowBox[{"alpha", " ", 
               RowBox[{"(", 
                RowBox[{"b", ",", " ", 
                 RowBox[{"a", " ", "+", " ", 
                  RowBox[{"i", " ", "k"}]}]}], ")"}]}], " ", "+", " ", 
              RowBox[{"beta", " ", 
               RowBox[{"(", 
                RowBox[{"b", ",", " ", 
                 RowBox[{"a", " ", "-", " ", 
                  RowBox[{"i", " ", "k"}]}]}], ")"}]}]}]}], ";", " ", 
            RowBox[{
             RowBox[{
             "the", " ", "incoming", " ", "wave", " ", "beta", " ", "carries",
               " ", "the", " ", "current", " ", "b", " ", "k"}], " ", "|", 
             "beta", "|", 
             RowBox[{"^", "2"}]}]}], ",", " ", 
           RowBox[{
            RowBox[{
             RowBox[{
             "the", "\n", "      ", "current", " ", "into", " ", "the", " ", 
              "horizon", " ", "is", " ", "2"}], " ", "|", 
             RowBox[{"Q", 
              RowBox[{"(", "2", ")"}]}], "|", 
             RowBox[{"^", "2"}]}], " ", "=", " ", "2"}]}], " ", "*)"}], "\n", 
         "   ", 
         RowBox[{"ab", " ", "=", " ", 
          RowBox[{"LinearSolve", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"bb", ",", " ", "bb"}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"aa", " ", "+", " ", 
                 RowBox[{"I", " ", "kk"}]}], ",", " ", 
                RowBox[{"aa", " ", "-", " ", 
                 RowBox[{"I", " ", "kk"}]}]}], "}"}]}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"uu", ",", " ", "wv"}], "}"}]}], "]"}]}], ";", "\n", 
         "   ", 
         RowBox[{"gam1", " ", "=", " ", 
          RowBox[{"2", "/", 
           RowBox[{"(", 
            RowBox[{"bb", " ", "kk", " ", 
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{"ab", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "]"}], "^", "2"}]}], 
            ")"}]}]}], ";", "\n", "   ", 
         RowBox[{"gr", " ", "=", " ", 
          RowBox[{"greyRust", "[", 
           RowBox[{
            RowBox[{"N", "[", "m1", "]"}], ",", " ", "l1", ",", " ", 
            RowBox[{"N", "[", "w1", "]"}]}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"dev8", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"dev8", ",", " ", 
            RowBox[{"Abs", "[", 
             RowBox[{"gam1", " ", "-", " ", "gr"}], "]"}]}], "]"}]}], ";", 
         "\n", "   ", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"det8", ",", " ", 
           RowBox[{"\"\<Mm = \>\"", " ", "<>", " ", 
            RowBox[{"ToString", "[", 
             RowBox[{"m1", ",", " ", "InputForm"}], "]"}], " ", "<>", 
            " ", "\"\<, lambda = \>\"", " ", "<>", " ", 
            RowBox[{"ToString", "[", "l1", "]"}], " ", "<>", 
            " ", "\"\<, M omega = \>\"", " ", "<>", "\n", "     ", 
            RowBox[{"ToString", "[", 
             RowBox[{"w1", ",", " ", "InputForm"}], "]"}], " ", "<>", 
            " ", "\"\<: Gamma = \>\"", " ", "<>", " ", 
            RowBox[{"fmt", "[", 
             RowBox[{"gam1", ",", " ", "13"}], "]"}], " ", "<>", 
            " ", "\"\< (Rust \>\"", " ", "<>", " ", 
            RowBox[{"fmt", "[", 
             RowBox[{"gr", ",", " ", "13"}], "]"}], " ", "<>", 
            " ", "\"\<)\>\""}]}], "]"}], ";", "\n", "   ", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<  WS-8 \>\"", ",", " ", 
           RowBox[{"Last", "[", "det8", "]"}]}], "]"}]}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"cs", ",", " ", "greyCases"}], "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"checkDev", "[", 
     RowBox[{"\"\<WS-8\>\"", ",", 
      " ", "\"\<(Rust LS-9; Python YS-7) the greybody factors (Mm, lambda, M \
omega) = (0, 1, 1/4), (1/5, -1, 1/4), \\\n(0, 2, 2/5) at r = 4000, found \
again with NDSolve in arithmetic of 32 digits from the Taylor start and the \
decomposition \\\ninto the local outgoing and incoming waves: the largest \
difference of Gamma from data/lg_schw_grey.csv (the Rust values \\\ncarry the \
global error 3e-8 of CVODE, check LS-9a)\>\"", ",", " ", "dev8", ",", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "7"}]}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"AppendTo", "[", 
     RowBox[{"notes", ",", " ", 
      RowBox[{"\"\<WS-8: \>\"", " ", "<>", " ", 
       RowBox[{"StringRiffle", "[", 
        RowBox[{"det8", ",", " ", "\"\<; \>\""}], "]"}]}]}], "]"}], 
    ";"}]}]}]], "Input",
 CellLabel->
  "In[292]:=",ExpressionUUID->"fe17d7e6-7251-4004-a9c3-e9b132107975"],

