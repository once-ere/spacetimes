Cell[CellGroupData[{

Cell["\<\
WL-2 and WL-3: matrices of determinant 1 and the polarized determinant\
\>", "Section",ExpressionUUID->"dbceb768-565c-4f3e-a74e-f9a78be5848a"],

Cell[TextData[{
 "A change of representation is a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Times]", "2"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4a7ab75e-897a-4b94-aeed-1a2ba1708ee8"],
 " matrix ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["S", "TI"], 
    StyleBox["Lord",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "99e8f727-adbd-4528-8543-d1afd5d6bf54"],
 " of determinant 1. WL-2 checks, for a matrix of determinant 1 with symbolic \
entries, the two rules that make the bar behave well under such a change: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["E",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    StyleBox["S", "TI"], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      SuperscriptBox[
       StyleBox["S", "TI"], 
       StyleBox["T", "TI"]], ")"}], 
     RowBox[{"-", "1"}]], 
    SubscriptBox[
     StyleBox["E",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f174473d-9be8-4ff2-bf2b-9d344738f92b"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     RowBox[{
      StyleBox["S", "TI"], "\[Sigma]", 
      SuperscriptBox[
       StyleBox["S", "TI"], "\[Prime]"]}], "_"], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["S", "TI"], 
     RowBox[{"\[Prime]", 
      RowBox[{"-", "1"}]}]], 
    OverscriptBox["\[Sigma]", "_"], 
    SuperscriptBox[
     StyleBox["S", "TI"], 
     RowBox[{"-", "1"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e3085fab-0545-42ff-a982-9ac80cd8565a"],
 " for any matrix ",
 Cell[BoxData[
  FormBox["\[Sigma]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "36518bf8-180b-4815-8954-2f32b291c63b"],
 " and a second matrix ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["S", "TI"], "\[Prime]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "08e1a4de-8fd1-42fa-b565-905583d4189e"],
 " of determinant 1; with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["S", "TI"], "\[Prime]"], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["S", "TI"], "\[Dagger]"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6b906f36-b384-4cd8-a0c3-3906e07ee36e"],
 " this is Lord's (1.23)."
}], "Text",ExpressionUUID->"226cd7cb-3aba-46cc-970e-97b0d12393bb"],

Cell[TextData[{
 "WL-3 checks the identity behind the word \"Minkowski product of two \
matrices\": for any two ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Times]", "2"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c49159c0-3452-44a5-9f5e-9c9f3dc3076d"],
 " matrices ",
 Cell[BoxData[
  FormBox[
   StyleBox["A", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "93bb6a15-4143-4319-b992-d2fe5abca60c"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["B", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c525534b-1afd-42bf-b78c-deddf7a8de5a"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["A", "TI"], 
      OverscriptBox[
       StyleBox["B", "TI"], "_"], "+", 
      StyleBox["B", "TI"], 
      OverscriptBox[
       StyleBox["A", "TI"], "_"]}], ")"}], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["LG",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["A", "TI"], ",", 
      StyleBox["B", "TI"]}], ")"}], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bd9d709f-e762-4048-96cd-38fed5d46918"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["LG",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["A", "TI"], ",", 
      StyleBox["B", "TI"]}], ")"}], "\[LongEqual]", 
    FractionBox["1", "2"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["det",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       RowBox[{
        StyleBox["A", "TI"], "+", 
        StyleBox["B", "TI"]}], ")"}], "-", 
      StyleBox["det",
       FontSlant->"Plain"], "\[ThinSpace]", 
      StyleBox["A", "TI"], "-", 
      StyleBox["det",
       FontSlant->"Plain"], "\[ThinSpace]", 
      StyleBox["B", "TI"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "24072a50-481a-449a-b71b-092e1f70ded8"],
 " is the polarized determinant. So a set of four Hermitian matrices \
satisfies Lord's (1.3) exactly when their polarized determinants are ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Eta]", 
    RowBox[{"\[Mu]", "\[Nu]"}], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b956c6d8-baf0-47b0-ad1e-49f830f4c820"],
 "; this is how the manuscript recognizes a valid set (an orthonormal frame) \
by a simple computation."
}], "Text",ExpressionUUID->"6b95318a-221f-44cb-8635-ac7e91a61009"],

