}]}]}]}]}]}], "-", "2"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"s2", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"sig", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
       RowBox[{"sig", "[", 
        RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
       RowBox[{"sig", "[", 
        RowBox[{"[", "3", "]"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{"sig", "[", 
         RowBox[{"[", "4", "]"}], "]"}], " ", "+", " ", 
        RowBox[{
         RowBox[{"sig", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "/", "2"}]}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"coef", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Tr", "[", 
         RowBox[{
          RowBox[{"s2", "[", 
           RowBox[{"[", "k", "]"}], "]"}], " ", ".", " ", 
          RowBox[{"sig", "[", 
           RowBox[{"[", "r", "]"}], "]"}]}], "]"}], "/", "2"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", "4"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"g2", " ", "=", " ", 
     RowBox[{"dirac", " ", "/@", " ", "s2"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ok2", " ", "=", " ", 
     RowBox[{
      RowBox[{"zeroQ", "[", 
       RowBox[{"s2", " ", "-", " ", 
        RowBox[{"(", 
         RowBox[{"herm", " ", "/@", " ", "s2"}], ")"}]}], "]"}], " ", "&&", 
      " ", 
      RowBox[{"FreeQ", "[", 
       RowBox[{"coef", ",", " ", "Complex"}], "]"}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"Det", "[", "coef", "]"}], " ", "===", " ", "1"}], " ", "&&", 
      " ", 
      RowBox[{
       RowBox[{"ndet", "[", 
