Cell[CellGroupData[{

Cell["WA-2: Theorem L3 for a plane wave", "Section",ExpressionUUID->"ec0ef726-27b1-431c-b538-1b0287698026"],

Cell[TextData[{
 "The core of Theorem L3 is the identity ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"[", 
     RowBox[{
      StyleBox["i", "TI"], "\[Gamma]", "\[CenterDot]", "\[PartialD]", "-", 
      StyleBox["M", "TI"], "-", 
      StyleBox["D", "TI"], "\[ThinSpace]", 
      SubscriptBox[
       StyleBox["\[ScriptCapitalC]",
        FontSlant->"Plain"], 
       StyleBox["LG",
        FontSlant->"Plain"]]}], "]"}], 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      SubsuperscriptBox[
       StyleBox["b", "TI"], 
       StyleBox["LG",
        FontSlant->"Plain"], 
       StyleBox["qp",
        FontSlant->"Plain"]], "\[ThinSpace]", 
      SubscriptBox[
       StyleBox["\[ScriptCapitalC]",
        FontSlant->"Plain"], 
       StyleBox["LG",
        FontSlant->"Plain"]]}], ")"}], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      SubsuperscriptBox[
       StyleBox["b", "TI"], 
       StyleBox["LG",
        FontSlant->"Plain"], 
       StyleBox["qp",
        FontSlant->"Plain"]], "\[ThinSpace]", 
      SubscriptBox[
       StyleBox["\[ScriptCapitalC]",
        FontSlant->"Plain"], 
       StyleBox["LG",
        FontSlant->"Plain"]]}], ")"}], 
    RowBox[{"[", 
     RowBox[{
      StyleBox["i", "TI"], "\[Gamma]", "\[CenterDot]", "\[PartialD]", "-", 
      StyleBox["E", "TI"]}], "]"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a7505893-ff81-4878-820c-80bb7f9aa5b6"],
 ": the operator of the superfluid, applied to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Chi]", 
     StyleBox["LG",
      FontSlant->"Plain"]], "+", 
    SubsuperscriptBox[
     StyleBox["b", "TI"], 
     StyleBox["LG",
      FontSlant->"Plain"], 
     StyleBox["qp",
      FontSlant->"Plain"]], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["\[ScriptCapitalC]",
      FontSlant->"Plain"], 
     StyleBox["LG",
      FontSlant->"Plain"]], 
    SubscriptBox["\[Chi]", 
     StyleBox["LG",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "99e68ed9-b996-4b77-a6b2-cd4e645be13f"],
 ", gives the same as the Dirac operator of the mass ",
 Cell[BoxData[
  FormBox[
   StyleBox["E", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6cceba12-d334-4f8e-ada1-39443eafeb18"],
 " applied to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Chi]", 
    StyleBox["LG",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "51d9a20d-6b01-4612-b416-ee3f3a3624d3"],
 ", up to the factor on the left, which can be inverted. The check verifies \
it on a plane wave with a symbolic spinor (16 real symbols) and a symbolic \
four-momentum that need not satisfy any mass condition, with symbolic ",
 Cell[BoxData[
  FormBox[
   StyleBox["M", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "eb501c26-2b5d-4665-ba6c-58c015502cad"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    StyleBox["D", "TI"], "|"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3960d325-1d4e-40b6-8e79-30d3e8730473"],
 " and phase of ",
 Cell[BoxData[
  FormBox[
   StyleBox["D", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a2d936d3-2032-4519-bd30-1c51088eb7a3"],
 ". As a control, the wrong sign of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["b", "TI"], 
    StyleBox["LG",
     FontSlant->"Plain"], 
    StyleBox["qp",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "58fbab8a-2b24-477a-b6c0-caa9fa8d7a3f"],
 " fails."
}], "Text",ExpressionUUID->"5dda7dd5-b662-46d8-b101-657e6aa1465f"],

