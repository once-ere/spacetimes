                    "--", " ", 
                    "WA"}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]\
}]}]}]}]}]}], "-", "1"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"ok1", " ", "=", " ", 
     RowBox[{
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"Flatten", "[", "pm", "]"}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Im", "[", "#", "]"}], " ", "===", " ", "0"}], " ", "&"}]}],
        "]"}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"pm", " ", "+", " ", 
        RowBox[{"Transpose", "[", "pm", "]"}]}], " ", "===", " ", "zero8"}], 
      " ", "&&", " ", 
      RowBox[{
       RowBox[{"pm", " ", ".", " ", 
        RowBox[{"ConjugateTranspose", "[", "pm", "]"}]}], " ", "===", " ", 
       RowBox[{"IdentityMatrix", "[", "8", "]"}]}], " ", "&&", "\n", "   ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{"g8", ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"pm", " ", ".", " ", 
            RowBox[{"Conjugate", "[", "#", "]"}]}], " ", "-", " ", 
           RowBox[{"#", " ", ".", " ", "pm"}]}], " ", "===", " ", "zero8"}], 
         " ", "&"}]}], "]"}], " ", "&&", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"pm", " ", ".", " ", 
         RowBox[{"Conjugate", "[", 
          RowBox[{"I", " ", "t3"}], "]"}]}], " ", "-", " ", 
        RowBox[{"I", " ", 
         RowBox[{"t3", " ", ".", " ", "pm"}]}]}], " ", "===", " ", "zero8"}], 
      " ", "&&", "\n", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{"pm", " ", ".", " ", 
         RowBox[{"Conjugate", "[", "fl", "]"}]}], " ", "-", " ", 
        RowBox[{"fl", " ", ".", " ", "pm"}]}], " ", "===", " ", "zero8"}], 
      " ", "&&", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"fl", " ", ".", " ", "t3", " ", ".", " ", "fl"}], " ", "+", 
        " ", "t3"}], " ", "===", " ", "zero8"}], " ", "&&", " ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{"g8", ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"fl", " ", ".", " ", "#"}], " ", "-", " ", 
           RowBox[{"#", " ", ".", " ", "fl"}]}], " ", "===", " ", "zero8"}], 
         " ", "&"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WA-1\>\"", ",", 
      " ", "\"\<(Rust AN-1; Python YA-1) P is real, antisymmetric and \
unitary; P (gamma^a)^* = gamma^a P; P (i T^3)^* = i T^3 P; \\\nF = 1_4 (x) \
tau_1 commutes with C and with the gamma^a, and F T^3 F = -T^3 (exact)\>\"", ",",
       " ", "ok1", ",", " ", 
      RowBox[{"\"\<all identities: \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", "ok1", "]"}]}]}], "]"}], ";"}]}]}]], "Input",
