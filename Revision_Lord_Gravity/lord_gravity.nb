}]}]}]}]}]}], "-", "1"}], ":", " ", "Schwarzschild"}], ",", " ", 
    RowBox[{"diagonal", " ", "tetrad"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"fS", " ", "=", " ", 
     RowBox[{"1", " ", "-", " ", 
      RowBox[{"2", " ", 
       RowBox[{"M", "/", "r"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"XS", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "r", ",", " ", "th", ",", " ", "ph"}], "}"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"geoS", " ", "=", " ", 
     RowBox[{"geometry", "[", 
      RowBox[{
       RowBox[{"DiagonalMatrix", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Sqrt", "[", "fS", "]"}], ",", " ", 
          RowBox[{"1", "/", 
           RowBox[{"Sqrt", "[", "fS", "]"}]}], ",", " ", "r", ",", " ", 
          RowBox[{"r", " ", 
           RowBox[{"Sin", "[", "th", "]"}]}]}], "}"}], "]"}], ",", " ", "XS", 
       ",", " ", "simpA"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"riemS", " ", "=", " ", 
     RowBox[{"riemann", "[", 
      RowBox[{
       RowBox[{"geoS", "[", "\"\<chr\>\"", "]"}], ",", " ", "XS", ",", " ", 
       "simpA"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"okRicS", " ", "=", " ", 
     RowBox[{"zeroQ", "[", 
      RowBox[{"ricci", "[", "riemS", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rlowS", " ", "=", " ", 
     RowBox[{"Simplify", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"geoS", "[", "\"\<g\>\"", "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"a", ",", " ", "k"}], "]"}], "]"}], " ", 
           RowBox[{"riemS", "[", 
            RowBox[{"[", 
             RowBox[{"k", ",", " ", "b", ",", " ", "c", ",", " ", "d"}], 
             "]"}], "]"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"k", ",", " ", "4"}], "}"}]}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"a", ",", " ", "4"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"b", ",", " ", "4"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"c", ",", " ", "4"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"d", ",", " ", "4"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rupS", " ", "=", " ", 
     RowBox[{"Simplify", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"geoS", "[", "\"\<gi\>\"", "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"b", ",", " ", "q"}], "]"}], "]"}], " ", 
           RowBox[{
            RowBox[{"geoS", "[", "\"\<gi\>\"", "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"c", ",", " ", "s"}], "]"}], "]"}], " ", 
           RowBox[{
            RowBox[{"geoS", "[", "\"\<gi\>\"", "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"d", ",", " ", "u"}], "]"}], "]"}], " ", 
           RowBox[{"riemS", "[", 
            RowBox[{"[", 
             RowBox[{"a", ",", " ", "q", ",", " ", "s", ",", " ", "u"}], 
             "]"}], "]"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"q", ",", " ", "4"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"s", ",", " ", "4"}], "}"}], ",", "\n", "     ", 
          RowBox[{"{", 
           RowBox[{"u", ",", " ", "4"}], "}"}]}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"a", ",", " ", "4"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"b", ",", " ", "4"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"c", ",", " ", "4"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"d", ",", " ", "4"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"kretS", " ", "=", " ", 
     RowBox[{"Simplify", "[", 
      RowBox[{"Total", "[", 
       RowBox[{"Flatten", "[", 
        RowBox[{"rlowS", " ", "rupS"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"okKretS", " ", "=", " ", 
     RowBox[{"zeroQ", "[", 
      RowBox[{"kretS", " ", "-", " ", 
       RowBox[{"48", " ", 
        RowBox[{
         RowBox[{"M", "^", "2"}], "/", 
         RowBox[{"r", "^", "6"}]}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"omegaS", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"M", "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", 
           RowBox[{"r", "^", "2"}]}], ")"}]}], " ", 
        RowBox[{
         RowBox[{"gam", "[", 
          RowBox[{"[", "1", "]"}], "]"}], " ", ".", " ", 
         RowBox[{"gam", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}]}], ",", " ", 
       RowBox[{"0", " ", "id4"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Sqrt", "[", "fS", "]"}], "/", "2"}], " ", 
