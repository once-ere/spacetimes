         RowBox[{"{", 
          RowBox[{"i", ",", " ", "4"}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"mm", " ", "->", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"okShellEq", " ", "=", " ", 
     RowBox[{"zeroE", "[", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"I", " ", 
