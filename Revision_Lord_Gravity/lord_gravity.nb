     RowBox[{"SparseArray", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "1"}], "}"}], " ", "->", " ", "1"}], ",", 
