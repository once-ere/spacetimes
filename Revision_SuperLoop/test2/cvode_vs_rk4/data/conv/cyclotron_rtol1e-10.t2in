# example 'cyclotron' of the Test 2 solver: a packet in a magnetic field on a 40 x 40 lattice with walls (cyclotron orbit)
# every key is explained by: python3 t2_solve.py --guide, or by the Rust solver: t2_solve --guide
format = t2in 2
title = a wave packet in a constant magnetic field (cyclotron motion)
task = evolve
sites = 40 40 1
spacing = 0.5
boundary = wall wall periodic
mass = 0.4
mu = 0.0
magnetic = 0.4 0.0
initial = packet
packet_center = 9.75 13.3 0
packet_width = 1.5
packet_momentum = 0.6 0 0
packet_branch = positive
packet_spin = up
packet_isospin = up
output_step = 0.05
outputs = 720
fields_every = 80
rtol = 1e-10
atol = 1e-12
