# example 'quench' of the Test 2 solver: a quench of the coupling: the amplitude (Higgs) oscillation of the pair field
# every key is explained by: python3 t2_solve.py --guide, or by the Rust solver: t2_solve --guide
format = t2in 2
title = a quench of the coupling of the uniform superfluid
task = quench
sites = 24 1 1
spacing = 0.5
boundary = periodic periodic periodic
mass = 0.0
mu = 0.0
coupling = 0.45
quench_coupling = 0.455
pair = uniform
pair_direction = 3
pair_amplitude = 0.5
mixing = 0.6
tolerance = 1e-12
max_iterations = 400
output_step = 0.04
outputs = 600
fields_every = 25
rtol = 1e-10
atol = 1e-12
