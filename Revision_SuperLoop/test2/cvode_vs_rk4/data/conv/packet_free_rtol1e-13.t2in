# example 'packet_free' of the Test 2 solver: a free Gaussian packet of positive energy on a ring (group velocity)
# every key is explained by: python3 t2_solve.py --guide, or by the Rust solver: t2_solve --guide
format = t2in 2
title = a free Gaussian wave packet on a ring
task = evolve
sites = 128 1 1
spacing = 0.5
boundary = periodic periodic periodic
mass = 0.4
mu = 0.0
initial = packet
packet_center = 16 0 0
packet_width = 3.0
packet_momentum = 0.8 0 0
packet_branch = positive
packet_spin = up
packet_isospin = up
packet_part = particle
output_step = 0.05
outputs = 600
fields_every = 20
rtol = 1e-13
atol = 1e-15
