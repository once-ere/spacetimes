# example 'packet_free' of the Test 2 solver: a free Gaussian packet of positive energy on a ring (group velocity)
# every key is explained by: python3 t2_solve.py --guide
format = t2in 1
title = a free Gaussian wave packet on a ring
task = evolve
sites = 128 1 1
spacing = 0.5
boundary = periodic periodic periodic
mass = 0.4
mu = 0.0
initial = packet
packet_center = 16 0 0
packet_width = 3.0
packet_momentum = 0.8 0 0
packet_branch = positive
packet_spin = up
packet_isospin = up
packet_part = particle
time_step = 0.05
steps = 600
output_every = 20
