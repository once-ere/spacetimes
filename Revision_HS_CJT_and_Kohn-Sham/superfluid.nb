   "\[InvisibleSpace]", "\<\"  deviation \"\>", 
   "\[InvisibleSpace]", "\<\"4.441e-16\"\>", 
   "\[InvisibleSpace]", "\<\" (tolerance \"\>", 
   "\[InvisibleSpace]", "\<\"1.000e-12\"\>", 
   "\[InvisibleSpace]", "\<\"): \"\>", 
   "\[InvisibleSpace]", "\<\"KS: at zero pair momentum no other pair channel \
is induced (norm of the self-consistent components of P^a other than \
(K^iota)^dag)\"\>", "\[InvisibleSpace]", "\<\"   [the same check: Rust \"\>", 
   "\[InvisibleSpace]", "\<\"P3-G4 KS\"\>", 
   "\[InvisibleSpace]", "\<\", Python \"\>", 
   "\[InvisibleSpace]", "\<\"YP3-G4 KS\"\>", 
   "\[InvisibleSpace]", "\<\"]\"\>"}],
  SequenceForm[
  "PASS ", "WP3-G4 KS", "  deviation ", "4.441e-16", " (tolerance ", 
   "1.000e-12", "): ", 
   "KS: at zero pair momentum no other pair channel is induced (norm of the \
self-consistent components of P^a other than (K^iota)^dag)", 
   "   [the same check: Rust ", "P3-G4 KS", ", Python ", "YP3-G4 KS", "]"],
  Editable->False]], "Print",
 CellChangeTimes->{4.004286136565189*^9},
 CellLabel->
  "During evaluation of \
In[383]:=",ExpressionUUID->"db025b6d-6234-4d83-8751-96a602689803"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"PASS \"\>", "\[InvisibleSpace]", "\<\"WP3-G1 CJT\"\>", 
   "\[InvisibleSpace]", "\<\"  deviation \"\>", 
   "\[InvisibleSpace]", "\<\"4.421e-10\"\>", 
   "\[InvisibleSpace]", "\<\" (tolerance \"\>", 
