Cell[TextData[{
 StyleBox["AS1: plane waves in constant gauge fields.",
  FontWeight->"Bold"],
 " In constant gauge fields the field equation without self-interaction has \
plane-wave solutions ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Chi]", "\[ThinSpace]", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      RowBox[{"-", 
       StyleBox["i", "TI"]}], "\[Omega]", 
      StyleBox["t", "TI"], "+", 
      StyleBox["i", "TI"], 
      OverscriptBox[
       StyleBox["q", "TI"], "\[RightVector]"], "\[CenterDot]", 
      OverscriptBox[
       StyleBox["x", "TI"], "\[RightVector]"]}]]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "07371837-9518-4d5f-b4dd-f11a4a0a7b45"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"\[Omega]", ",", "\[Chi]"}], ")"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c33f964d-7293-48cd-ad82-a302459c6e8d"],
 " is an eigenpair of the Hermitian matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["h",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["pw",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     OverscriptBox[
      StyleBox["q", "TI"], "\[RightVector]"], ")"}], "\[LongEqual]", 
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "+", 
    SuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["F",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["B", "TI"], "0"], "+", 
    SuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["v",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["W",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "0"], "+", 
    UnderscriptBox["\[Sum]", 
     StyleBox["j", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["j", "TI"]], "+", 
      SuperscriptBox[
       StyleBox["g", "TI"], 
       StyleBox["F",
        FontSlant->"Plain"]], 
      SubscriptBox[
       StyleBox["B", "TI"], 
       StyleBox["j", "TI"]], "+", 
      SuperscriptBox[
       StyleBox["g", "TI"], 
       StyleBox["v",
        FontSlant->"Plain"]], 
      SubscriptBox[
       StyleBox["W",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["j", "TI"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "15c0f14c-3822-4c34-a5ba-5784ec65a400"],
 ". For the spin-isospin locked field ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["W", "TI"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["j", "TI"]}], "\[Iota]"], "\[LongEqual]", 
    StyleBox["w", "TI"], "\[ThinSpace]", 
    SubscriptBox["\[Delta]", 
     RowBox[{"\[Iota]", 
      StyleBox["j", "TI"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "63c8ee42-692b-49c6-af5f-34d8154db891"],
 " the eight frequencies at the momentum ",
 Cell[BoxData[
  FormBox[
   StyleBox["q", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "716339ee-a1b7-46bf-acbd-7bfdfd46591f"],
 " along ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["x", "TI"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "85851986-7dec-4084-b9ab-18d7ca1f8a83"],
 " are ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", "\[Omega]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1ecae946-e47d-4c40-82c9-f6e2e130e1ab"],
 " with the four branches ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Omega]", "2"], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["m", "TI"], "2"], "+", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       StyleBox["q", "TI"], "\[PlusMinus]", 
       StyleBox["gw", "TI"], "/", "2"}], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "affa097d-b6bd-4550-8465-9902c3d97fc7"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Omega]", "2"], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["m", "TI"], "2"], "+", 
    SuperscriptBox[
     StyleBox["q", "TI"], "2"], "+", 
    FractionBox["5", "4"], 
    SuperscriptBox[
     StyleBox["g", "TI"], "2"], 
    SuperscriptBox[
     StyleBox["w", "TI"], "2"], "\[PlusMinus]", 
    StyleBox["gw", "TI"], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        StyleBox["q", "TI"], "2"], "+", 
       SuperscriptBox[
        StyleBox["g", "TI"], "2"], 
       SuperscriptBox[
        StyleBox["w", "TI"], "2"]}], ")"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b3082b0f-0bee-4a58-8e81-71c0ce82a9d5"],
 "."
}], "Text",ExpressionUUID->"6d15467b-cb84-43bf-bb35-e4345c32ee1a"],

Cell[TextData[{
 StyleBox["AS2: Landau levels.",
  FontWeight->"Bold"],
 " In a constant magnetic field ",
 Cell[BoxData[
  FormBox[
   StyleBox["B", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "29c501b3-a746-42c6-a90e-82b3016b494f"],
 " along ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["x", "TI"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ea0a7b81-f5b9-4581-a208-5a3e77e62c9d"],
 " the frequencies are ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       StyleBox["m", "TI"], "2"], "+", 
      SubsuperscriptBox[
       StyleBox["q", "TI"], "3", "2"], "+", "2", 
      StyleBox["neB", "TI"]}], ")"}], 
    RowBox[{"1", "/", "2"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a959d81c-5c3c-479d-85eb-a17e594d6b67"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "0", ",", "1", ",", "2", ",", 
    "\[Ellipsis]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "189ccba6-7c06-40da-be0f-0d25cf5a5718"],
 "; the program discretizes ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["x", "TI"], "1"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3418508c-17a6-4fae-a2c4-9dcaec1957ce"],
 " on a lattice with the Wilson term (spacings ",
 Cell[BoxData[
  FormBox["0.1", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cc2837da-b02b-4c32-b9dc-a76efc102e11"],
 ", ",
 Cell[BoxData[
  FormBox["0.05", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cfce1f59-00ac-4489-8d35-8ab749533905"],
 ", ",
 Cell[BoxData[
  FormBox["0.025", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "836d0cd6-2430-46b9-8fc5-53753501997d"],
 ") and compares the seven lowest positive frequencies, and their Richardson \
extrapolation ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    StyleBox["E", "TI"], 
    RowBox[{"(", "0.025", ")"}], "-", 
    StyleBox["E", "TI"], 
    RowBox[{"(", "0.05", ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "87146e9d-c7d2-4c2b-ad63-6e31e5a0c98d"],
 ", with the Landau levels."
}], "Text",ExpressionUUID->"e5c04c69-df17-4d50-bebe-d48b68a505fb"],

Cell[TextData[{
 StyleBox["AS3: the uniform superfluid of the spin-zero pairing.",
  FontWeight->"Bold"],
 " For a uniform unitary pair field the 16 eigenvalues of the matrix of \
Bogoliubov and de Gennes are ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    SuperscriptBox[
     RowBox[{"[", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"\[CurlyEpsilon]", "\[PlusMinus]", "\[Mu]"}], ")"}], "2"], "+", 
       SuperscriptBox["\[CapitalDelta]", "2"]}], "]"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9e840682-db31-498c-9550-b62d8a304932"],
 ", each four times; the mean-field energy is stationary where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["G", "TI"], "/", 
      SuperscriptBox["\[Pi]", "2"]}], ")"}], 
    SubscriptBox[
     StyleBox["I", "TI"], "1"], 
    RowBox[{"(", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         StyleBox["m", "TI"], "2"], "+", 
        SuperscriptBox["\[CapitalDelta]", "2"]}], ")"}], 
      RowBox[{"1", "/", "2"}]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0aaaa1df-58e1-4356-be32-05de6a5c9c09"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["I", "TI"], "1"], 
    RowBox[{"(", 
     StyleBox["M", "TI"], ")"}], "\[LongEqual]", 
    FractionBox["1", "2"], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "+", 
         SuperscriptBox[
          StyleBox["M", "TI"], "2"]}], ")"}], 
       RowBox[{"1", "/", "2"}]], "-", 
      SuperscriptBox[
       StyleBox["M", "TI"], "2"], "\[ThinSpace]", 
      StyleBox["arcsinh",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       RowBox[{"1", "/", 
        StyleBox["M", "TI"]}], ")"}]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "13705090-2e0c-4944-825d-f4ce3e13a12a"],
 ", and at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["G", "TI"], "\[LongEqual]", "22.5"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "69117e03-1a41-4168-9ea2-9f3691eca226"],
 " the gap is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", "\[LongEqual]", "0.2094933033"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f34abf78-fe06-47e8-a46b-30e2155c8727"],
 "."
}], "Text",ExpressionUUID->"a17355c9-1a03-4915-9fc2-75ce96587c3d"],

Cell[TextData[{
 StyleBox["AS4: the kink of the pair field.",
  FontWeight->"Bold"],
 " For the pair field ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", 
    RowBox[{"(", 
     StyleBox["x", "TI"], ")"}], "\[LongEqual]", 
    SubscriptBox["\[CapitalDelta]", "\[Infinity]"], "\[ThinSpace]", 
    StyleBox["tanh",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["x", "TI"], "/", "\[ScriptL]"}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4391bd94-920b-4b8e-8da9-3dfa2fc62178"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalDelta]", "\[Infinity]"], "\[LongEqual]", "0.5"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f8137bff-f966-4883-bda9-ca5bd6ce23ba"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ScriptL]", "\[LongEqual]", "4"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "eab4bd46-14a0-4b41-91ef-28c0345cb1cc"],
 ") the reduced problem has the bound states ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["sech",
      FontSlant->"Plain"], "2"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["x", "TI"], "/", "\[ScriptL]"}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "12fe9275-b625-4ede-8049-3b22eb378243"],
 " (zero mode, energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    StyleBox["m", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "447c033a-267f-4357-80e0-9eb60dbaa759"],
 ") and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["sech",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["x", "TI"], "/", "\[ScriptL]"}], ")"}], "\[ThinSpace]", 
    StyleBox["tanh",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["x", "TI"], "/", "\[ScriptL]"}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d09c277a-db08-4da7-9f0b-4596da01a7dd"],
 " (energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        StyleBox["m", "TI"], "2"], "+", 
       SubsuperscriptBox[
        StyleBox["E", "TI"], "1", "2"]}], ")"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a48332eb-a2ca-45e9-9062-d0ed18da8f9e"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["E", "TI"], "1", "2"], "\[LongEqual]", "3", "/", "16"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7df7ef77-2a3d-4673-bd8d-416f9fc81a8a"],
 "); on the Wilson lattice exactly three bound states lie below the continuum \
",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       StyleBox["m", "TI"], "2"], "+", 
      SubsuperscriptBox["\[CapitalDelta]", "\[Infinity]", "2"]}], ")"}], 
    RowBox[{"1", "/", "2"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "97f46486-dbc2-4d5b-aacc-a86ae35bc3a7"],
 "."
}], "Text",ExpressionUUID->"bf9c588c-cea3-4493-b343-296328955970"],

Cell[TextData[{
 "The next cell computes the four cases. The eigenvalues of the Hermitian \
matrices are computed by the function ",
 StyleBox["Eigenvalues",
  FontFamily->"Source Code Pro"],
 " of the Wolfram Language (dense matrices of up to 4800 rows); the gap \
equation is solved by ",
 StyleBox["FindRoot",
  FontFamily->"Source Code Pro"],
 " with 30 digits; the profiles of AS4 are checked symbolically by ",
 StyleBox["FullSimplify",
  FontFamily->"Source Code Pro"],
 "."
}], "Text",ExpressionUUID->"58864b0d-a646-4682-ad62-9aa72c8306f3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"hPW", "[", 
      RowBox[{
      "q", ",", " ", "m", ",", " ", "gv", ",", " ", "gf", ",", " ", "w", ",", 
       " ", "b"}], "]"}], ":", " ", 
     RowBox[{
      RowBox[{"the", " ", "plane"}], "-", 
      RowBox[{
      "wave", " ", "matrix", " ", "of", " ", "AS1", " ", "for", " ", "the", " ",
        "constant", " ", "fields", " ", 
       RowBox[{"w", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"p", "+", "1"}], ",", " ", "i"}], "]"}], "]"}]}]}]}], " ", "=",
     " ", 
    RowBox[{
     RowBox[{
      RowBox[{"W", "^", "i_p"}], " ", "and", " ", 
      RowBox[{"b", "[", 
       RowBox[{"[", 
        RowBox[{"p", "+", "1"}], "]"}], "]"}]}], " ", "=", " ", "B_p"}]}], 
   " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"hPW", "[", 
      RowBox[{
      "q_", ",", " ", "m_", ",", " ", "gv_", ",", " ", "gf_", ",", " ", "w_", 
       ",", " ", "b_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "gauge", "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{
         RowBox[{"gauge", "[", "p_", "]"}], " ", ":=", " ", 
         RowBox[{
          RowBox[{"gf", " ", 
           RowBox[{"b", "[", 
            RowBox[{"[", 
             RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}], " ", 
           RowBox[{"IdentityMatrix", "[", "8", "]"}]}], " ", "+", " ", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{"gv", " ", 
             RowBox[{"w", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"p", " ", "+", " ", "1"}], ",", " ", "i"}], "]"}], 
              "]"}], " ", 
             RowBox[{"tLL", "[", "i", "]"}]}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"i", ",", " ", "3"}], "}"}]}], "]"}]}]}], ";", "\n", 
        "   ", 
        RowBox[{
         RowBox[{
          RowBox[{"d8", "[", "betaLL", "]"}], " ", "m"}], " ", "+", " ", 
         RowBox[{"gauge", "[", "0", "]"}], " ", "+", " ", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"d8", "[", 
             RowBox[{"alphaLL", "[", "j", "]"}], "]"}], " ", ".", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"q", "[", 
                RowBox[{"[", "j", "]"}], "]"}], " ", 
               RowBox[{"IdentityMatrix", "[", "8", "]"}]}], " ", "+", " ", 
              RowBox[{"gauge", "[", "j", "]"}]}], ")"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}]}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"AS1", "-", "3"}], ":", " ", 
       RowBox[{
        RowBox[{"the", " ", "spin"}], "-", 
        RowBox[{"isospin", " ", "locked", " ", "field", " ", 
         RowBox[{"W", "^", "i_j"}]}]}]}], " ", "=", " ", 
      RowBox[{"w", " ", "delta_ij"}]}], ",", " ", 
     RowBox[{"w", " ", "=", " ", "0.9"}], ",", " ", 
     RowBox[{"g_v", " ", "=", " ", "0.83"}], ",", " ", 
     RowBox[{"at", " ", "61", " ", "momenta", " ", "along", " ", 
      RowBox[{"x", "^", "3"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"w", " ", "=", " ", "0.9"}], ",", " ", 
        RowBox[{"gv", " ", "=", " ", "0.83"}], ",", " ", "wl", ",", " ", "gw",
         ",", " ", 
        RowBox[{"m", " ", "=", " ", 
         RowBox[{"N", "[", "mLL", "]"}]}], ",", " ", 
        RowBox[{"d", " ", "=", " ", "0."}]}], "}"}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{"wl", " ", "=", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"w", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "w", ",", " ", "0"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "0", ",", " ", "w"}], "}"}]}], "}"}]}], ";",
        "\n", "  ", 
       RowBox[{"gw", " ", "=", " ", 
        RowBox[{"gv", " ", "w"}]}], ";", "\n", "  ", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"ev", " ", "=", " ", 
              RowBox[{"Sort", "[", 
               RowBox[{"Re", "[", 
                RowBox[{"Eigenvalues", "[", 
                 RowBox[{"N", "[", 
                  RowBox[{"hPW", "[", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"0", ",", " ", "0", ",", " ", "q"}], "}"}], ",", 
                    " ", "m", ",", " ", "gv", ",", " ", "0", ",", " ", "wl", ",",
                     " ", 
                    RowBox[{"{", 
                    RowBox[{
                    "0", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], 
                    "}"}]}], "]"}], "]"}], "]"}], "]"}], "]"}]}], ",", " ", 
             "w2", ",", " ", "want"}], "}"}], ",", "\n", "     ", 
           RowBox[{
            RowBox[{"w2", " ", "=", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"m", "^", "2"}], " ", "+", " ", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"q", " ", "+", " ", 
                   RowBox[{"gw", "/", "2"}]}], ")"}], "^", "2"}]}], ",", " ", 
               
               RowBox[{
                RowBox[{"m", "^", "2"}], " ", "+", " ", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"q", " ", "-", " ", 
                   RowBox[{"gw", "/", "2"}]}], ")"}], "^", "2"}]}], ",", " ", 
               
               RowBox[{
                RowBox[{"m", "^", "2"}], " ", "+", " ", 
                RowBox[{"q", "^", "2"}], " ", "+", " ", 
                RowBox[{"1.25", " ", 
                 RowBox[{"gw", "^", "2"}]}], " ", "+", " ", 
                RowBox[{"gw", " ", 
                 RowBox[{"Sqrt", "[", 
                  RowBox[{
                   RowBox[{"q", "^", "2"}], " ", "+", " ", 
                   RowBox[{"gw", "^", "2"}]}], "]"}]}]}], ",", " ", 
               RowBox[{
                RowBox[{"m", "^", "2"}], " ", "+", " ", 
                RowBox[{"q", "^", "2"}], " ", "+", " ", 
                RowBox[{"1.25", " ", 
                 RowBox[{"gw", "^", "2"}]}], " ", "-", " ", 
                RowBox[{"gw", " ", 
                 RowBox[{"Sqrt", "[", 
                  RowBox[{
                   RowBox[{"q", "^", "2"}], " ", "+", " ", 
                   RowBox[{"gw", "^", "2"}]}], "]"}]}]}]}], "}"}]}], ";", 
            "\n", "     ", 
            RowBox[{"want", " ", "=", " ", 
             RowBox[{"Sort", "[", 
              RowBox[{"Join", "[", 
               RowBox[{
                RowBox[{"Sqrt", "[", "w2", "]"}], ",", " ", 
                RowBox[{"-", 
                 RowBox[{"Sqrt", "[", "w2", "]"}]}]}], "]"}], "]"}]}], ";", 
            "\n", "     ", 
            RowBox[{"d", " ", "=", " ", 
             RowBox[{"Max", "[", 
              RowBox[{"d", ",", " ", 
               RowBox[{"Max", "[", 
                RowBox[{"Abs", "[", 
                 RowBox[{"ev", " ", "-", " ", "want"}], "]"}], "]"}]}], 
              "]"}]}]}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"q", ",", " ", 
           RowBox[{"Subdivide", "[", 
            RowBox[{
             RowBox[{"-", "1.5"}], ",", " ", "1.5", ",", " ", "60"}], "]"}]}],
           "}"}]}], "]"}], ";", "\n", "  ", 
       RowBox[{"check", "[", 
        RowBox[{"\"\<WAS1-3\>\"", ",", 
         " ", "\"\<spin-isospin locked field: four analytic branches (61 \
momenta)\>\"", ",", " ", "d", ",", " ", 
         RowBox[{"10", "^", 
