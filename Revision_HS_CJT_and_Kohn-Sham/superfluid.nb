Cell[TextData[{
 StyleBox["The Taylor coefficient at the origin.",
  FontWeight->"Bold"],
 " The coefficient ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["Tay",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8adddb04-f96c-4453-b586-bd4682adb752"],
 " of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6a21e02d-e8d2-48b6-87f4-bd59b2c88428"],
 " of the Taylor series at the origin is the limit of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalV]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], "/", 
    SuperscriptBox["\[CapitalPhi]", "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6a1fe4cb-0463-43a0-9b62-0d917035bf2f"],
 " at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPhi]", "\[RightArrow]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "adba1b68-858c-405a-9afb-358e05c7bd28"],
 ". The Rust and the Python program compute it from three states with small \
applied fields (0.004, 0.008, 0.016) and the Richardson elimination of the \
term proportional to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CapitalPhi]", "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1918f1c8-d78f-4b1c-a817-e4176a524250"],
 ". The next cell estimates it from the first six points of the computed \
curve (",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPhi]", "<", "0.1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6271438a-df6f-41c3-90c2-71c53bc93c25"],
 ", well inside the radius of convergence) by fitting ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalV]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], "/", 
    SuperscriptBox["\[CapitalPhi]", "2"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["a", "TI"], "0"], "+", 
    SubscriptBox[
     StyleBox["a", "TI"], "1"], 
    SuperscriptBox["\[CapitalPhi]", "2"], "+", 
    SubscriptBox[
     StyleBox["a", "TI"], "2"], 
    SuperscriptBox["\[CapitalPhi]", "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d6182891-1666-415d-8627-ab833bcc1f9b"],
 "; the truncation of this local series limits the agreement to about ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", "\[Times]", 
    SuperscriptBox["10", 
     RowBox[{"-", "7"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "92606575-2c42-4b2f-b64a-3482e10340b3"],
 ". The fitted ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7df8cc00-86f5-4dda-9911-34dace257db0"],
 " of the Landau form differs from ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["Tay",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fcf99cbb-4404-43a7-9fde-713ec8eb9f8b"],
 " by 0.7 to 2 per cent: it is a property of the fit."
}], "Text",ExpressionUUID->"e8ff28a1-8822-4c6c-9d5c-2a8929e48dc0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"lfTaylor", "[", "t", "]"}], ":", " ", 
    RowBox[{
     RowBox[{"a", "^", "Tay"}], " ", "estimated", " ", "from", " ", "the", " ",
      "points", " ", "2", " ", "to", " ", "7", " ", "of", " ", "the", " ", 
     "curve", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"the", " ", "first", " ", "point", " ", "is", " ", "Phi"}], 
       " ", "=", " ", "0"}], ")"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"lfTaylor", "[", "t_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"p", " ", "=", " ", 
         RowBox[{
          RowBox[{"lfCurve", "[", "t", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"2", " ", ";;", " ", "7"}], "]"}], "]"}]}], "}"}], ",", 
       " ", 
       RowBox[{
        RowBox[{"LeastSquares", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", " ", 
              RowBox[{"x", "^", "2"}], ",", " ", 
              RowBox[{"x", "^", "4"}]}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"x", ",", " ", 
              RowBox[{"p", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], "}"}]}], 
           "]"}], ",", " ", 
          RowBox[{
           RowBox[{"p", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "/", 
           RowBox[{
            RowBox[{"p", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], "^", "2"}]}]}], 
         "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{"\"\<WP3-10 \>\"", " ", "<>", " ", "t"}], ",", " ", 
        RowBox[{
         RowBox[{"lfName", "[", "t", "]"}], " ", "<>", 
         " ", "\"\<: the coefficient of Phi^2 of the Taylor series at the \
origin from the first six points of the curve = the Rust value a^Tay = \>\"", 
         " ", "<>", " ", 
         RowBox[{"ToString", "[", 
          RowBox[{"rustPart3", "[", 
           RowBox[{"\"\<p3_a_taylor_\>\"", " ", "<>", " ", "t"}], "]"}], 
          "]"}], " ", "<>", " ", "\"\< (relative)\>\""}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"lfTaylor", "[", "t", "]"}], " ", "-", " ", 
           RowBox[{"rustPart3", "[", 
            RowBox[{"\"\<p3_a_taylor_\>\"", " ", "<>", " ", "t"}], "]"}]}], 
          "]"}], "/", 
         RowBox[{"Abs", "[", 
          RowBox[{"rustPart3", "[", 
           RowBox[{"\"\<p3_a_taylor_\>\"", " ", "<>", " ", "t"}], "]"}], 
          "]"}]}], ",", " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "6"}]}], ",", " ", 
        RowBox[{"\"\<P3-10 \>\"", " ", "<>", " ", "t"}], ",", " ", 
        RowBox[{"\"\<YP3-10 \>\"", " ", "<>", " ", "t"}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"t", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<HS_1_1\>\"", ",", " ", "\"\<CJT\>\""}], "}"}]}], 
       "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"lfName", "[", "t", "]"}], ",", " ", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{"lfTaylor", "[", "t", "]"}], ",", " ", "10"}], "]"}], ",",
            " ", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{"rustPart3", "[", 
              RowBox[{"\"\<p3_a_taylor_\>\"", " ", "<>", " ", "t"}], "]"}], ",",
              " ", "10"}], "]"}], ",", " ", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"lfResults", "[", "t", "]"}], "[", "\"\<a\>\"", "]"}], ",",
              " ", "10"}], "]"}], ",", " ", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{"100", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"lfResults", "[", "t", "]"}], "[", "\"\<a\>\"", 
                  "]"}], "/", 
                 RowBox[{"rustPart3", "[", 
                  RowBox[{"\"\<p3_a_taylor_\>\"", " ", "<>", " ", "t"}], 
                  "]"}]}], " ", "-", " ", "1"}], ")"}]}], ",", " ", "3"}], 
            "]"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"t", ",", " ", "lfTags"}], "}"}]}], "]"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<method\>\"", ",", " ", "\"\<a^Tay from the curve\>\"", ",",
          " ", "\"\<a^Tay of the Rust program\>\"", ",", 
         " ", "\"\<a of the Landau form\>\"", ",", 
         " ", "\"\<a/a^Tay - 1 (per cent)\>\""}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "All"}]}], "]"}]}]}]], "Input",
 CellLabel->
  "In[311]:=",ExpressionUUID->"4eecb2a3-c84e-4355-8ec2-d878f66121cd"],

