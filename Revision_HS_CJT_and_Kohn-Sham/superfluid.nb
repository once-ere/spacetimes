Cell[TextData[{
 StyleBox["Is the order parameter smaller and more physically reasonable?",
  FontWeight->"Bold"],
 " Yes, near the critical temperature, and only there, for the mean-field \
free energy of the methods (Section III.G shows that these temperatures lie \
inside the critical region of the transition, where the fluctuations that the \
methods omit dominate)."
}], "Text",ExpressionUUID->"2efe8de3-ee75-4a82-8e09-62dc2ff8c1c1"],

Cell[TextData[{
 StyleBox["It is smaller.",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalPhi]", 
     RowBox[{"0", ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bb0c7156-3860-48dc-be79-903f7b14f554"],
 " keeps its value of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5ced784e-d1fa-4595-9f2e-4b807bb2e6f5"],
 " up to about ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.3", "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ae640ada-e988-4203-8065-b8e1782ea4eb"],
 " (the gap is much larger than these temperatures, and thermal \
quasi-particles are exponentially rare), then falls and vanishes continuously \
at ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "702dccdc-3fed-45a1-81b6-4f84a2257d8b"],
 ", like ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "-", 
      StyleBox["T", "TI"], "/", 
      SubsuperscriptBox[
       StyleBox["T", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["c",
         FontSlant->"Plain"]}]]}], ")"}], 
    RowBox[{"1", "/", "2"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cc9fd551-a3e0-463f-ac55-ad2eba08ce4e"],
 " (the table and the figure above)."
}], "ItemNumbered",ExpressionUUID->"d8a81bfb-79bf-445d-ab70-dcdbe0837d1f"],

Cell[TextData[{
 StyleBox["It lies inside the radius of convergence.",
  FontWeight->"Bold"],
 " At ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "76b543e5-941d-45f8-85e0-c8e7a2361455"],
 " the order parameter is 1.5 to 2 times the radius, which is then the mass \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "55f875ed-6bad-4f3f-97c1-ca3536a9b0b2"],
 "; above the reduced temperature of the table (0.35 to 0.42) it is smaller \
than the radius, and near ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "39df00ca-0a60-43a5-8751-a25b91af1416"],
 " much smaller. There the series of the free energy in powers of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e0d82782-0c69-4545-b81c-eec4cef44665"],
 " converges at the minimum, and the Landau coefficients are the Taylor \
coefficients of the free energy: the regime of Landau's theory, which Section \
III.L found absent at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "af4a6266-5cb4-47cd-9069-a4784145acbb"],
 "."
}], "ItemNumbered",ExpressionUUID->"af2d11b6-fcaa-4c38-affa-2a9e0a141805"],

Cell[TextData[{
 StyleBox["The Landau form becomes exact.",
  FontWeight->"Bold"],
 " The residual of the Landau form falls from a few tenths of a per cent of \
the depth at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3530379c-8671-4c6b-ac67-46bb1b75ce40"],
 " to about ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "3"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f96ebd69-7628-4b14-bdc6-3e8ead107410"],
 " per cent at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.98", "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "03330654-d546-4e83-94fc-f29d2c77cb9d"],
 ", and that of the quartic form (the form of the Higgs potential of the \
Standard Model and of the theory of Ginzburg and Landau) from 3 to 6 per cent \
to about 0.3 per cent; near ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b56b8025-c381-4fee-9422-430f99ec1930"],
 " it falls in proportion to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "-", 
    StyleBox["T", "TI"], "/", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0aa8ec2c-86b7-4361-9344-6e14627d1fb7"],
 "."
}], "ItemNumbered",ExpressionUUID->"2a360219-5ab5-46ea-a82a-ed950270d154"],

Cell[TextData[{
 StyleBox["Landau's theory predicts the order parameter.",
  FontWeight->"Bold"],
 " Near ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f03bafa8-580d-485b-a0fc-8548d075a273"],
 " the error of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       StyleBox["a", "TI"]}], "/", "2", 
      StyleBox["b", "TI"]}], ")"}], 
    RowBox[{"1", "/", "2"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "57a3003e-2137-4348-8c85-23a7e7c09c42"],
 " is a fraction (0.19 to 0.28 in the Rust table) of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "-", 
    StyleBox["T", "TI"], "/", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3656dcec-5d35-48a1-856a-6a100c1aa4d1"],
 ", as Landau's theory requires; the cell above computes it for CJT at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.9", "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["CJT",
       FontSlant->"Plain"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b18edc93-b37f-4962-9618-0b4af424964f"],
 "."
}], "ItemNumbered",ExpressionUUID->"3858dcc7-50bf-4e3c-9e5f-efcaa58a97dc"],

Cell[TextData[{
 StyleBox["The scales.",
  FontWeight->"Bold"],
 " Near ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4667c9af-9d8e-4795-9cf9-e1f4bba3b303"],
 " the order parameter is small also against the Dirac mass and the cutoff. \
The critical temperatures themselves are about a fifth to a quarter of the \
cutoff (the table above), and the states at the cutoff are occupied by 0.8 to \
1.8 per cent at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.98", "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fc445331-ca32-4772-80ce-e880ea55eb6e"],
 ", so the thermal physics reaches the cutoff only weakly. The ratio of the \
gap at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1a9359a8-83e1-4ae9-bbe8-6ea42ac8a0e6"],
 " to ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c9cbeac6-0919-4d92-af1b-9a35fcea9e4f"],
 " is 1.65 to 1.74; the theory of Bardeen, Cooper and Schrieffer gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Pi]", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      SubscriptBox["\[Gamma]", 
       StyleBox["E",
        FontSlant->"Plain"]]}]], "\[LongEqual]", "1.764"}], TraditionalForm]],
   "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c5bab295-a436-4b30-8e12-9fa9664b7fd4"],
 " (with Euler's constant ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", 
     StyleBox["E",
      FontSlant->"Plain"]], "\[LongEqual]", "0.5772"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "85aa4304-c16d-476c-a1fb-abb5d99f829a"],
 ") for weak pairing at a Fermi surface. The ratios are of the same size but \
not equal: here there is no Fermi surface (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Mu]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f22d19c4-308c-4f00-911b-e23fb97898dd"],
 "), the pairing needs a coupling above a critical one, and the gap contains \
the Dirac mass."
}], "ItemNumbered",ExpressionUUID->"65c2d0eb-3e88-4ebd-911a-67ba7814bec0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
III.T.7 What the free energy of these methods does not contain, and why it \
matters\
\>", "Section",ExpressionUUID->"74d3465b-6a52-4c76-a766-00a01d115fc4"],

Cell[TextData[{
 StyleBox["The remark.",
  FontWeight->"Bold"],
 " All three methods give mean-field free energies: the thermal state is \
quasi-free, so the free energy contains the thermal quasi-particles of the \
spinor field, but neither the thermal fluctuations of the order parameter \
about its mean value (its amplitude, Goldstone and non-unitary modes) nor \
thermal gauge fields. ",
 StyleBox["Why it holds.",
  FontWeight->"Bold"],
 " A quasi-free state is a state whose correlations of four and more fields \
are fixed by its correlations of two fields (Wick's theorem); the three \
methods choose the best such state, and a fluctuation of the order parameter \
is a correlation of two pairs beyond the product of the pair densities. In HS \
the integral over the auxiliary fields is replaced by its saddle point, in \
CJT the effective action is truncated at the contractions of the contact \
terms in pairs, and in KS the exchange-correlation energy has no thermal part."
}], "Text",ExpressionUUID->"9228afd5-1816-416e-9c9b-974778af6240"],

Cell[TextData[{
 StyleBox["Why it matters.",
  FontWeight->"Bold"],
 " Near a continuous transition the fluctuations of the order parameter grow \
without bound. Their size relative to the order parameter is measured by the \
Ginzburg number of the transition (A. P. Levanyuk 1959, V. L. Ginzburg 1960): \
the mean-field free energy is accurate where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "-", 
    StyleBox["T", "TI"], "/", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "30aad11f-b898-445b-b3fd-e40c354328a2"],
 " is much larger than the Ginzburg number, and it fails within the critical \
region, where it is smaller. For a free energy of the form of Ginzburg and \
Landau in three dimensions, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", 
     StyleBox["GL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      RowBox[{"\[Del]", 
       SubscriptBox["\[Psi]", 
        StyleBox["GL",
         FontSlant->"Plain"]]}], "\[RightBracketingBar]"}], "2"], "+", 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["GL",
      FontSlant->"Plain"], "\[Prime]"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["T", "TI"], "/", 
      SubscriptBox[
       StyleBox["T", "TI"], 
       StyleBox["c",
        FontSlant->"Plain"]], "-", "1"}], ")"}], 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      SubscriptBox["\[Psi]", 
       StyleBox["GL",
        FontSlant->"Plain"]], "\[RightBracketingBar]"}], "2"], "+", 
    FractionBox["1", "2"], 
    SubscriptBox["\[Beta]", 
     StyleBox["GL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      SubscriptBox["\[Psi]", 
       StyleBox["GL",
        FontSlant->"Plain"]], "\[RightBracketingBar]"}], "4"]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "142b7e53-1fe5-4905-b716-691f9e4b4929"],
 " (the example of Section III.L.2 with the gradient coefficient ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", 
    StyleBox["GL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "adaf0fc7-f839-48bc-96fa-5aa3912f80ec"],
 ", the slope ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Alpha]", 
    StyleBox["GL",
     FontSlant->"Plain"], "\[Prime]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ec5e8d93-7e7d-4862-a0f2-d0fc06ee4457"],
 " and the critical temperature ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["c",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0916b349-1e59-4c72-8e2b-0fe0e915b6d2"],
 "), the Ginzburg number is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["c",
      FontSlant->"Plain"], "2"], 
    SubsuperscriptBox["\[Beta]", 
     StyleBox["GL",
      FontSlant->"Plain"], "2"], "/", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["\[Alpha]", 
       StyleBox["GL",
        FontSlant->"Plain"], "\[Prime]"], 
      SubsuperscriptBox["\[Gamma]", 
       StyleBox["GL",
        FontSlant->"Plain"], "3"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9b5c6a31-c845-4dec-8ddb-74b8c5a36c81"],
 " up to a numerical factor that depends on the conventions. Within the \
critical region the order parameter vanishes with an exponent different from ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "053fe7f7-857c-4eb2-991c-d85b38e01485"],
 " (in three dimensions near 0.33 to 0.37 for the Ising, XY and Heisenberg \
universality classes), the critical temperature is in general lower than the \
mean-field one, and for an order parameter with two quartic invariants, as \
here, the fluctuations can also make the transition discontinuous (the \
renormalization-group theory of such fields is reviewed by A. Pelissetto and \
E. Vicari, 2002). A gauge field coupled to the order parameter can do the \
same: its fluctuations make the transition of a superconductor weakly first \
order (B. I. Halperin, T. C. Lubensky and S.-k. Ma, 1974), and the thermal \
transition of the Higgs field of the electroweak theory, of first order for \
small Higgs masses, ends at a critical Higgs mass, above which there is no \
transition but a smooth crossover (lattice simulations of K. Kajantie, M. \
Laine, K. Rummukainen and M. Shaposhnikov, 1996). The answer of Section \
III.T.6 therefore describes the superfluid near ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cd478c74-b5e8-4722-bbdb-eded30d4e126"],
 " only outside the critical region, and whether the transition of the full \
theory is continuous is not decided here. The size of the critical region \
needs the gradient coefficient of the field at ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a469a4f2-b875-45d9-ac73-08334bd83db5"],
 ", which Section III.G computes: the Ginzburg number is 7.6 to 11.4, so that \
the whole range of temperatures of Section III.T.6 where the free energy \
behaves as Landau's theory lies inside the critical region. At ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e6dd9028-f973-4a92-bcf5-1069761332a6"],
 " the methods omit the quantum fluctuations of the order parameter as well; \
that is a property of the methods, not the subject of this remark."
}], "Text",ExpressionUUID->"180e0bb9-dc12-4e6b-afc5-b5e7428f313c"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Part III, third section. The width of the critical region, and the superfluid \
as a Higgs sector\
\>", "Chapter",ExpressionUUID->"e6050c54-1c7d-4a86-9386-385a862e7ff3"],

Cell[TextData[{
 "On 21 November 2026 the author asked to find how wide the region of the \
fluctuations near the critical temperature is, which needs one more \
calculation, the gradient coefficient of the field at the critical \
temperature; then to determine for each of the five methods ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "25b6261a-685c-4af3-b956-4d07a03e8999"],
 " (HS ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"1", ",", "1"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8c4aa09c-855f-4004-9324-a6fec67917ff"],
 ", HS ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "1"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "98f3db51-c0df-44a4-ac5c-c309ddb54de1"],
 ", HS ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "0"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e5ecd4bf-6efb-48a2-b8e3-cc45a75e2a4e"],
 ", KS and CJT) whether the superfluid can play the role of the Higgs \
particle, and whether the Higgs is really a composite particle. This chapter \
does both with the engines of Part II and of Section III.T, and repeats the \
checks of the Rust program ",
 StyleBox["sf_part3",
  FontFamily->"Source Code Pro"],
 " (modules ",
 StyleBox["ginzburg",
  FontFamily->"Source Code Pro"],
 " and ",
 StyleBox["higgs",
  FontFamily->"Source Code Pro"],
 ") and of the Python program ",
 StyleBox["sf_part3.py",
  FontFamily->"Source Code Pro"],
 ". ",
 StyleBox["The answers.",
  FontWeight->"Bold"],
 " The Ginzburg number is 7.6 to 11.4 (Section III.G.7): the critical region \
is wider than the critical temperature itself, so the mean-field description \
of the five methods holds nowhere near the transition. Every method realizes \
the Higgs mechanism and has a composite neutral scalar below the threshold of \
two quasi-particles, but in no method can it be the Higgs boson that is \
observed (Section III.G.8). Within this model the Higgs field is composite by \
construction."
}], "Text",ExpressionUUID->"617592f0-a3db-4d6b-be33-2965e43b1ddd"],

Cell[CellGroupData[{

Cell["\<\
III.G.1 The free energy of Ginzburg and Landau and the Ginzburg number\
\>", "Section",ExpressionUUID->"53a9d994-a837-47c2-a78a-a847b7c2fe8a"],

Cell[TextData[{
 StyleBox["Units.",
  FontWeight->"Bold"],
 " As in Section III.T: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["k", "TI"], 
     StyleBox["B",
      FontSlant->"Plain"]], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c3678041-d95c-4490-a4a3-cbbebe2f08d9"],
 ", the cutoff ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8bfc236b-6ce2-4a66-aada-308c4417787b"],
 ", the chemical potential zero. ",
 StyleBox["The field.",
  FontWeight->"Bold"],
 " The field of the superfluid is the complex isospin vector ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["\[CapitalPhi]", "1"], ",", 
      SuperscriptBox["\[CapitalPhi]", "2"], ",", 
      SuperscriptBox["\[CapitalPhi]", "3"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ee95001b-8a53-460a-98a6-636f8fbae255"],
 " of the components of the pair self-energy along ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], "\[Iota]"], ")"}], "\[Dagger]"], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6833e688-7d8d-4b85-bfdc-350d38e21725"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[CapitalPhi]", "\[Iota]"], "\[LongEqual]", 
    StyleBox["tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "\[Iota]"], 
      SubscriptBox[
       StyleBox["P",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["SF",
        FontSlant->"Plain"]]}], ")"}], "/", "8"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3bb7a736-59e2-4565-8759-bb5a1433a342"],
 "; it has ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], "\[CapitalPhi]"], "\[LongEqual]", "6"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6b2d2486-5588-4bdc-b910-31ea2f27c2e5"],
 " real components, and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
      "\[RightBracketingBar]"}], "2"], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", "\[Iota]",
     LimitsPositioning->True], 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      SuperscriptBox["\[CapitalPhi]", "\[Iota]"], "\[RightBracketingBar]"}], 
     "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f0907ed4-da22-45b7-b655-eca7140c6092"],
 ". ",
 StyleBox["The form of Ginzburg and Landau.",
  FontWeight->"Bold"],
 " Near the critical temperature ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "138021a5-4eb5-4868-b1d1-ee8d4c86b613"],
 " the field is small. For a static field that varies slowly in space, the \
free energy of method ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "48248423-d6d4-4195-a3d1-1080ef9d68c4"],
 " to second order in the field and in its derivatives and to fourth order in \
the field is"
}], "Text",ExpressionUUID->"03a26729-542e-464b-a6ab-51808217004a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalF]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["GL",
      FontSlant->"Plain"]}]], 
   RowBox[{"[", 
    OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "]"}], "\[LongEqual]", "\[Integral]",
    "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["d", "TI"], "3"], 
   StyleBox["x", "TI"], 
   RowBox[{"[", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["c",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      StyleBox["X", "TI"]], "\[ThinSpace]", 
     UnderoverscriptBox["\[Sum]", 
      RowBox[{
       StyleBox["j", "TI"], "\[LongEqual]", "1"}], "3",
      LimitsPositioning->True], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[PartialD]", 
         StyleBox["j", "TI"]], 
        OverscriptBox["\[CapitalPhi]", "\[RightVector]"]}], ")"}], 
      "\[Dagger]"], "\[CenterDot]", 
     SubscriptBox["\[PartialD]", 
      StyleBox["j", "TI"]], 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "+", 
     SubsuperscriptBox[
      StyleBox["a", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["X", "TI"], ",", 
       StyleBox["Tay",
        FontSlant->"Plain"]}]], 
     RowBox[{"(", 
      StyleBox["T", "TI"], ")"}], "\[ThinSpace]", 
     SuperscriptBox[
      RowBox[{"\[LeftBracketingBar]", 
       OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
       "\[RightBracketingBar]"}], "2"], "+", 
     SubsuperscriptBox[
      StyleBox["b", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["X", "TI"], ",", 
       StyleBox["Tay",
        FontSlant->"Plain"]}]], 
     RowBox[{"(", 
      StyleBox["T", "TI"], ")"}], "\[ThinSpace]", 
     SuperscriptBox[
      RowBox[{"\[LeftBracketingBar]", 
       OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
       "\[RightBracketingBar]"}], "4"]}], "]"}], ","}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"f4bc98f6-48b0-4b93-b67f-8c46fe037007"],

Cell[TextData[{
 "with the Taylor coefficients ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["Tay",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e4a5016e-611e-4642-abce-e889975e8e65"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["b", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["Tay",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5c828e85-75c2-409c-9741-f97aee68f820"],
 " of the free energy at the origin (Section III.T.6), ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["Tay",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}], "\[TildeTilde]", 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["GL",
       FontSlant->"Plain"]}]], 
    SubsuperscriptBox[
     StyleBox["t", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["red",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d5218b87-8709-4343-bf3d-dd1497a8002c"],
 " near ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "357ec769-2185-4d7e-b969-a9eb42dbfb54"],
 ", the reduced temperature ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["t", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["red",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["T", "TI"], "-", 
      SubsuperscriptBox[
       StyleBox["T", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["c",
         FontSlant->"Plain"]}]]}], ")"}], "/", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ad630196-59a2-4835-9c24-5ad4c2bc3128"],
 ", the slope ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["GL",
       FontSlant->"Plain"]}]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]], "\[ThinSpace]", 
    SubscriptBox["\[PartialD]", 
     StyleBox["T", "TI"]], 
    SubsuperscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["Tay",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4fd9f6ab-b7ac-48e4-9041-03d087fa6aee"],
 " at ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a2678d8f-cb07-4a4a-b10f-f86ae1712441"],
 ", and the ",
 StyleBox["gradient coefficient",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["c",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cc38feb0-3759-4ca7-bb71-4cd17a249fec"],
 " at ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4cc41bb3-2a74-4a2a-936f-b6ee33720314"],
 ". The rotations and the isospin rotations allow no other term of second \
order, and a term with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "\[CenterDot]", 
    OverscriptBox["\[CapitalPhi]", "\[RightVector]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ee1dbe3d-30b4-40ff-a14c-d5a3cbdba1d4"],
 " has the fermion number 4 and is not invariant under ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["U", "TI"], 
    SubsuperscriptBox[
     RowBox[{"(", "1", ")"}], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b129e7fb-4aed-4664-8042-31a2f5c0be26"],
 ". Of the two quartic invariants ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}], "4"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8973e161-7b69-44d4-a129-5c9225edc955"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     RowBox[{
      OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "\[CenterDot]", 
      OverscriptBox["\[CapitalPhi]", "\[RightVector]"]}], 
     "\[RightBracketingBar]"}], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "72f776d2-ef53-4aa9-a3b8-44a540e0154e"],
 ", which are equal on the polar fields of the minimum, the form keeps the \
coefficient along these fields. ",
 StyleBox["The Ginzburg number.",
  FontWeight->"Bold"],
 " Above ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "eec6b4ed-f6f5-43ed-9288-37945b21ac76"],
 " the field fluctuates about zero with the probability density proportional \
to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["exp",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       SubsuperscriptBox[
        StyleBox["\[ScriptCapitalF]",
         FontSlant->"Plain"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["X", "TI"], ",", 
         StyleBox["GL",
          FontSlant->"Plain"]}]]}], "/", 
      StyleBox["T", "TI"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6e5cd991-c5e3-45b6-b193-366549c59aec"],
 ". To second order the fluctuations are Gaussian, and their free energy per \
volume is, up to terms analytic in ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8586e51b-fe61-45a1-97ec-4075833ba45b"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], 
    SubsuperscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], "\[CapitalPhi]"], 
    StyleBox["T", "TI"], "\[ThinSpace]", "\[Integral]", "\[ThinSpace]", 
    FractionBox[
     RowBox[{
      SuperscriptBox[
       StyleBox["d", "TI"], "3"], 
      StyleBox["k", "TI"]}], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"2", "\[Pi]"}], ")"}], "3"]], "\[ThinSpace]", 
    StyleBox["ln",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["c",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["X", "TI"]], 
      SuperscriptBox[
       StyleBox["k", "TI"], "2"], "+", 
      SubsuperscriptBox[
       StyleBox["a", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["Tay",
         FontSlant->"Plain"]}]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d2d6ff3a-f3d5-4535-ac07-ab204d960cc7"],
 ". With ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Integral]", "\[ThinSpace]", 
    FractionBox[
     RowBox[{
      SuperscriptBox[
       StyleBox["d", "TI"], "3"], 
      StyleBox["k", "TI"]}], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"2", "\[Pi]"}], ")"}], "3"]], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       StyleBox["c",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       SuperscriptBox[
        StyleBox["k", "TI"], "2"], "+", 
       StyleBox["a", "TI"]}], ")"}], 
     RowBox[{"-", "2"}]], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"8", "\[Pi]", 
       SuperscriptBox[
        StyleBox["c",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        RowBox[{"3", "/", "2"}]], 
       SuperscriptBox[
        StyleBox["a", "TI"], 
        RowBox[{"1", "/", "2"}]]}], ")"}], 
     RowBox[{"-", "1"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9589678a-aa85-4725-a732-1a5acd4c27dc"],
 " its specific heat per volume, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["C", "TI"], "\[LongEqual]", 
    RowBox[{"-", 
     StyleBox["T", "TI"]}], 
    SubsuperscriptBox["\[PartialD]", 
     StyleBox["T", "TI"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8d8ade0f-808a-4d87-a7d5-cd416fb83059"],
 " of the free energy, is near ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "35662556-8bc1-4f2c-b806-47ed42c05847"]
}], "Text",ExpressionUUID->"f775ec8d-8f56-4ff4-bf17-5cbc47b0e52f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["C", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["fl",
      FontSlant->"Plain"]}]], "\[LongEqual]", 
   FractionBox[
    RowBox[{
     SubsuperscriptBox[
      StyleBox["n", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], "\[CapitalPhi]"], "\[ThinSpace]", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox["\[Alpha]", 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["X", "TI"], ",", 
         StyleBox["GL",
          FontSlant->"Plain"]}]], ")"}], 
      RowBox[{"3", "/", "2"}]]}], 
    RowBox[{"16", "\[Pi]", "\[ThinSpace]", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["c",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        StyleBox["X", "TI"]], ")"}], 
      RowBox[{"3", "/", "2"}]], "\[ThinSpace]", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["t", "TI"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        StyleBox["red",
         FontSlant->"Plain"]], ")"}], 
      RowBox[{"1", "/", "2"}]]}]], ",", "      ", "\[CapitalDelta]", 
   SubsuperscriptBox[
    StyleBox["C", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], "\[LongEqual]", 
   FractionBox[
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[Alpha]", 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["GL",
         FontSlant->"Plain"]}]], ")"}], "2"], 
    RowBox[{"2", "\[ThinSpace]", 
     SubsuperscriptBox[
      StyleBox["b", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["X", "TI"], ",", 
       StyleBox["Tay",
        FontSlant->"Plain"]}]], "\[ThinSpace]", 
     SubsuperscriptBox[
      StyleBox["T", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["X", "TI"], ",", 
       StyleBox["c",
        FontSlant->"Plain"]}]]}]], ","}], TraditionalForm]], "DisplayFormula",\

 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"62ac5f78-32ad-40f1-bf85-47c2aef1a99c"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", 
    SubsuperscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "50dc4792-67e9-4413-b29f-5ef81414b5c3"],
 " is the jump of the specific heat of mean-field theory at ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d6c3a8cf-2c6f-401a-a379-ebb7bca22f20"],
 " (below it the minimum of the form is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
      "\[RightBracketingBar]"}], "2"], "\[LongEqual]", 
    RowBox[{"-", 
     StyleBox["a", "TI"]}], "/", 
    RowBox[{"(", 
     RowBox[{"2", 
      StyleBox["b", "TI"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2eecd647-0e38-4e83-b5c9-3d97459a9e51"],
 " with the free energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     SuperscriptBox[
      StyleBox["a", "TI"], "2"]}], "/", 
    RowBox[{"(", 
     RowBox[{"4", 
      StyleBox["b", "TI"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bcefd994-07c2-4883-8d19-7df807b06834"],
 " per volume). Mean-field theory holds where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["fl",
       FontSlant->"Plain"]}]], "\[LessLess]", "\[CapitalDelta]", 
    SubsuperscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "045eb096-1050-45db-9eb6-c98c49f43129"],
 ". The two are equal at the ",
 StyleBox["Ginzburg number",
  FontWeight->"Bold"],
 " (A. P. Levanyuk 1959, V. L. Ginzburg 1960)"
}], "Text",ExpressionUUID->"20373aba-20d1-412c-b07b-bb8dbc5b00c4"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["Gi",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], "\[LongEqual]", 
   FractionBox[
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["n", "TI"], 
        StyleBox["SF",
         FontSlant->"Plain"], "\[CapitalPhi]"], ")"}], "2"], "\[ThinSpace]", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["b", "TI"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["X", "TI"], ",", 
         StyleBox["Tay",
          FontSlant->"Plain"]}]], ")"}], "2"], "\[ThinSpace]", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["T", "TI"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["X", "TI"], ",", 
         StyleBox["c",
          FontSlant->"Plain"]}]], ")"}], "2"]}], 
    RowBox[{"64", 
     SuperscriptBox["\[Pi]", "2"], "\[ThinSpace]", 
     SubsuperscriptBox["\[Alpha]", 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["X", "TI"], ",", 
       StyleBox["GL",
        FontSlant->"Plain"]}]], "\[ThinSpace]", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["c",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        StyleBox["X", "TI"]], ")"}], "3"]}]], "\[LongEqual]", 
   FractionBox[
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["n", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], "\[CapitalPhi]"], ")"}], "2"], 
    RowBox[{"256", 
     SuperscriptBox["\[Pi]", "2"], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"\[CapitalDelta]", 
        SubsuperscriptBox[
         StyleBox["C", "TI"], 
         StyleBox["SF",
          FontSlant->"Plain"], 
         StyleBox["X", "TI"]], 
        SuperscriptBox[
         RowBox[{"(", 
          SubsuperscriptBox["\[Xi]", 
           StyleBox["SF",
            FontSlant->"Plain"], 
           RowBox[{
            StyleBox["X", "TI"], ",", 
            StyleBox["GL",
             FontSlant->"Plain"]}]], ")"}], "3"]}], ")"}], "2"]}]], ",", 
   "      ", 
   SubsuperscriptBox["\[Xi]", 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["GL",
      FontSlant->"Plain"]}]], "\[LongEqual]", 
   SuperscriptBox[
    RowBox[{"(", 
     FractionBox[
      SubsuperscriptBox[
       StyleBox["c",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["X", "TI"]], 
      SubsuperscriptBox["\[Alpha]", 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["GL",
         FontSlant->"Plain"]}]]], ")"}], 
    RowBox[{"1", "/", "2"}]], "."}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"55f26f3e-2b9a-45fd-a458-d82d06614944"],

Cell[TextData[{
 "Mean-field theory holds for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftBracketingBar]", 
     SubsuperscriptBox[
      StyleBox["t", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      StyleBox["red",
       FontSlant->"Plain"]], "\[RightBracketingBar]"}], "\[GreaterGreater]", 
    SubsuperscriptBox[
     StyleBox["Gi",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b714260a-dc05-4b18-875b-e09cb4456ce3"],
 ", and the critical region, where it fails, has the width of about ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["Gi",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "35ddc2da-e0ed-4132-a48c-085827ef8ada"],
 " on both sides of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5e878491-dbf5-4e44-b8ff-66d7f767caf5"],
 ". The second form shows the meaning: the correlation length of mean-field \
theory is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Xi]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["GL",
       FontSlant->"Plain"]}]], 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      SubsuperscriptBox[
       StyleBox["t", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["red",
        FontSlant->"Plain"]], "\[RightBracketingBar]"}], 
     RowBox[{
      RowBox[{"-", "1"}], "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9a0aa466-3b45-4b53-9678-68a5a9807a5c"],
 ", and mean-field theory needs many degrees of freedom in a correlation \
volume, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", 
    SubsuperscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[Xi]", 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["GL",
         FontSlant->"Plain"]}]], ")"}], "3"], "\[GreaterGreater]", "1"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2db10907-9bef-4f47-a7ef-874e4aab735f"],
 ". ",
 StyleBox["A remark on the factors (what it means and why it matters).",
  FontWeight->"Bold"],
 " Other forms of the criterion (the mean square fluctuation of the field in \
a correlation volume against the square of its mean value, or the first \
correction to ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["b", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["Tay",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c8a9b405-0fa3-47a8-81a2-6db58ca357d7"],
 " against ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["b", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["Tay",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "53f1b73a-8a7b-4a19-8fd0-8bd0317e3bae"],
 ") give the same combination of ",
 Cell[BoxData[
  FormBox["\[Alpha]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cef6a45a-939a-47e9-9bc4-a37e31c91fda"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["b", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "843573fc-eeb9-4e8f-837a-64ef48743d4f"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["c",
    FontFamily->"Helvetica",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "aa30980a-9293-4d65-8a83-caa236ce9531"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["c",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6d7a54ba-437a-4e6b-9c15-f2560cddd903"],
 " with other numerical factors of order one, and books on the subject differ \
by such factors. The formula above is the definition used here. It matters \
only when the number is near 1; the numbers found below are far above 1, so a \
factor of order one does not change the conclusion."
}], "Text",ExpressionUUID->"3c3c188b-908e-4c99-98b2-af29d9d2d4a7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
III.G.2 The coefficient of the field of a moving pair: the static pair \
response\
\>", "Section",ExpressionUUID->"c872eacd-1dc4-4bf8-bcaf-1709aa26c846"],

Cell[TextData[{
 "A pair field with the momentum ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["q", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["pair",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "27cc9b31-d615-4b78-ac9e-e29fc72a5b4f"],
 " along ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox[
     StyleBox["e", "TI"], "\[RightVector]"], "3"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "50e37cbe-3cc7-4c65-ae20-ed0d3829bd40"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
    RowBox[{"(", 
     OverscriptBox[
      StyleBox["x", "TI"], "\[RightVector]"], ")"}], "\[LongEqual]", 
    OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "\[ThinSpace]", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      StyleBox["i", "TI"], 
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["pair",
        FontSlant->"Plain"]], 
      SuperscriptBox[
       StyleBox["x", "TI"], "3"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b640249a-a243-4f54-bd5c-d955e4bf4dac"],
 ", has the gradient term ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["c",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["pair",
        FontSlant->"Plain"]], ")"}], "2"], 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
      "\[RightBracketingBar]"}], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "366990f4-01b9-4a51-9bf8-0c8ce9505ccd"],
 ", so its coefficient of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e23b0cb0-f733-4ce6-9207-cef86de3d482"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["Tay",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["pair",
        FontSlant->"Plain"]], ";", 
      StyleBox["T", "TI"]}], ")"}], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["Tay",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}], "+", 
    SubsuperscriptBox[
     StyleBox["c",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["pair",
        FontSlant->"Plain"]], ")"}], "2"], "+", 
    StyleBox["O", "TI"], 
    RowBox[{"(", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["q", "TI"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        StyleBox["pair",
         FontSlant->"Plain"]], ")"}], "4"], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "29a938ac-5484-4e81-b5af-f26e46fa519e"],
 ". The state of a moving pair pairs the momenta ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     StyleBox["q", "TI"], "\[RightVector]"], "+", 
    FractionBox["1", "2"], 
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["pair",
      FontSlant->"Plain"]], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["e", "TI"], "\[RightVector]"], "3"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b27f56cb-4456-431b-ba9e-db558ea3c3b2"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     OverscriptBox[
      StyleBox["q", "TI"], "\[RightVector]"]}], "+", 
    FractionBox["1", "2"], 
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["pair",
      FontSlant->"Plain"]], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["e", "TI"], "\[RightVector]"], "3"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5213651c-50b7-476f-bc89-944ab1b57562"],
 " (relative momentum ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["q", "TI"], "\[RightVector]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7c32d816-1c0d-4fa8-9bf8-980dce4d993e"],
 "). After the gauge transformation ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPsi]", "\[RightArrow]", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      StyleBox["i", "TI"], 
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["pair",
        FontSlant->"Plain"]], 
      SuperscriptBox[
       StyleBox["x", "TI"], "3"], "/", "2"}]], "\[CapitalPsi]"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "765382ab-f361-4261-b07a-3fa55edab1f1"],
 ", which makes the pair field uniform, it is the thermal state of the matrix \
of Bogoliubov and de Gennes (Section II.2) with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["h",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     RowBox[{"\[PlusMinus]", 
      OverscriptBox[
       StyleBox["q", "TI"], "\[RightVector]"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c5ca5cae-0449-4505-85a3-5c39ba91d96c"],
 " replaced by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["h",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     RowBox[{"\[PlusMinus]", 
      OverscriptBox[
       StyleBox["q", "TI"], "\[RightVector]"]}], ")"}], "+", 
    SubsuperscriptBox[
     StyleBox["T",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["tw",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "72c96181-74ef-4d59-9f3e-9e51c5d655f8"],
 ", the ",
 StyleBox["twist",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["T",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["tw",
      FontSlant->"Plain"]], "\[LongEqual]", 
    FractionBox["1", "2"], 
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["pair",
      FontSlant->"Plain"]], "\[ThinSpace]", 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], "3"], "\[CircleTimes]", 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "58e48c75-599b-4401-a049-49b1cccca920"],
 ", with the normal self-energy ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["N",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["n",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "646f6072-292a-4a79-ba3b-2bb2172070ce"],
 " of the normal state at ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7c474d9a-ddca-46dc-b200-cb2837ed2bb8"],
 " (a change of the normal self-energy changes the free energy only at fourth \
order in the field, because the free energy is stationary in it) and with a \
small antisymmetric pair block ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["P",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["a",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d4d351a6-79ed-46c1-b581-350e4f709e70"],
 ". To first order in ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["P",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["a",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "09e7c5b5-676d-4662-be7a-d4dc36802489"],
 " the pair matrix summed over the momenta, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["C",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["p",
       FontSlant->"Plain"], ",", 
      StyleBox["tot",
       FontSlant->"Plain"]}]], "\[LongEqual]", "\[Integral]", "\[ThinSpace]", 
    
    FractionBox[
     RowBox[{
      SuperscriptBox[
       StyleBox["d", "TI"], "3"], 
      StyleBox["q", "TI"]}], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"2", "\[Pi]"}], ")"}], "3"]], 
    SubsuperscriptBox[
     StyleBox["C",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     OverscriptBox[
      StyleBox["q", "TI"], "\[RightVector]"], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "506a3ec5-b4c6-4263-98cc-85a4678c3e57"],
 ", is the ",
 StyleBox["static pair response",
  FontWeight->"Bold"]
}], "Text",ExpressionUUID->"30bb4fcb-1822-4be8-94d6-10e94a27482b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["C",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["p",
      FontSlant->"Plain"], ",", 
     StyleBox["tot",
      FontSlant->"Plain"]}]], "\[LongEqual]", 
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalX]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["P",
     FontSlant->"Plain"]], 
   RowBox[{"[", 
    SubsuperscriptBox[
     StyleBox["P",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["a",
      FontSlant->"Plain"]], "]"}], "\[LongEqual]", 
   RowBox[{"-", "\[Integral]"}], "\[ThinSpace]", 
   FractionBox[
    RowBox[{
     SuperscriptBox[
      StyleBox["d", "TI"], "3"], 
     StyleBox["q", "TI"]}], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"2", "\[Pi]"}], ")"}], "3"]], "\[ThinSpace]", 
   UnderoverscriptBox["\[Sum]", 
    RowBox[{
     StyleBox["a", "TI"], ",", 
     StyleBox["b", "TI"], "\[LongEqual]", "1"}], "8",
    LimitsPositioning->True], "\[ThinSpace]", 
   FractionBox[
    RowBox[{
     StyleBox["f", "TI"], 
     RowBox[{"(", 
      SubsuperscriptBox["\[CurlyEpsilon]", 
       RowBox[{
        StyleBox["SF",
         FontSlant->"Plain"], ",", 
        StyleBox["a", "TI"]}], 
       StyleBox["A",
        FontSlant->"Plain"]], ")"}], "-", 
     StyleBox["f", "TI"], 
     RowBox[{"(", 
      SubsuperscriptBox["\[CurlyEpsilon]", 
       RowBox[{
        StyleBox["SF",
         FontSlant->"Plain"], ",", 
        StyleBox["b", "TI"]}], 
       StyleBox["D",
        FontSlant->"Plain"]], ")"}]}], 
    RowBox[{
     SubsuperscriptBox["\[CurlyEpsilon]", 
      RowBox[{
       StyleBox["SF",
        FontSlant->"Plain"], ",", 
       StyleBox["a", "TI"]}], 
      StyleBox["A",
       FontSlant->"Plain"]], "-", 
     SubsuperscriptBox["\[CurlyEpsilon]", 
      RowBox[{
       StyleBox["SF",
        FontSlant->"Plain"], ",", 
       StyleBox["b", "TI"]}], 
      StyleBox["D",
       FontSlant->"Plain"]]}]], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["u",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["a", "TI"]}]], 
   SubsuperscriptBox[
    StyleBox["u",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["a", "TI"]}], "\[Dagger]"], "\[ThinSpace]", 
   SubsuperscriptBox[
    StyleBox["P",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["a",
     FontSlant->"Plain"]], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["w",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["b", "TI"]}]], 
   SubsuperscriptBox[
    StyleBox["w",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["b", "TI"]}], "\[Dagger]"], ","}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"799000ae-5fd7-4ec6-b8e3-5361f5e4b2aa"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CurlyEpsilon]", 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["a", "TI"]}], 
    StyleBox["A",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2187a7a5-2806-40e0-85c6-4cf0ad9098d6"],
 " and the normalized eigenvectors ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["u",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["a", "TI"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c6e7f416-c402-4e73-9b3a-ed23811ce6a9"],
 " are those of the particle block ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["h",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     OverscriptBox[
      StyleBox["q", "TI"], "\[RightVector]"], ")"}], "+", 
    SubsuperscriptBox[
     StyleBox["N",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["n",
      FontSlant->"Plain"]], "+", 
    SubsuperscriptBox[
     StyleBox["T",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["tw",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "426db094-1b39-4c5a-b890-113c8e53e42d"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CurlyEpsilon]", 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["b", "TI"]}], 
    StyleBox["D",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f912d63d-e247-4046-876a-0891ac89967d"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["w",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["b", "TI"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6acae650-0923-4f6f-a1e6-72454e5a7770"],
 " those of the hole block ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["h",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["LL",
         FontSlant->"Plain"]], 
       RowBox[{"(", 
        RowBox[{"-", 
         OverscriptBox[
          StyleBox["q", "TI"], "\[RightVector]"]}], ")"}], "+", 
       SubsuperscriptBox[
        StyleBox["N",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        StyleBox["n",
         FontSlant->"Plain"]], "+", 
       SubsuperscriptBox[
        StyleBox["T",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        StyleBox["tw",
         FontSlant->"Plain"]]}], ")"}], 
     StyleBox["T", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1990120d-1bb1-416f-b9da-a1d5d61778cd"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["f", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e46b4a59-9fcf-4c17-afb2-c15b21b21d8e"],
 " is the Fermi function, and the quotient is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["f", "TI"], "\[Prime]"], 
    RowBox[{"(", "\[CurlyEpsilon]", ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6b995171-603e-490b-906f-5a1d0ba68d76"],
 " where the two energies coincide (the first-order term of the function ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["f", "TI"], 
    RowBox[{"(", 
     SubscriptBox[
      StyleBox["H",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["SF",
       FontSlant->"Plain"]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "53120004-3dcf-4541-97e2-9263261bed98"],
 " of a Hermitian matrix in its off-diagonal block). The free energy of the \
state, measured from the normal state at ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "df8751a2-b4b3-4d72-ad38-8f3d916a69a0"],
 ", is to second order"
}], "Text",ExpressionUUID->"b890cdd4-5675-4c13-be46-efda1d82468b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalF]",
     FontSlant->"Plain"], 
    RowBox[{"2", ",", 
     StyleBox["SF",
      FontSlant->"Plain"]}], 
    StyleBox["X", "TI"]], "\[LongEqual]", 
   FractionBox["1", "2"], "\[ThinSpace]", 
   StyleBox["Re",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["tr",
    FontSlant->"Plain"], 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["P",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        StyleBox["a",
         FontSlant->"Plain"]], "-", 
       SubscriptBox[
        StyleBox["P",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["SF",
         FontSlant->"Plain"]], 
       RowBox[{"[", 
        SubsuperscriptBox[
         StyleBox["C",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], 
         StyleBox["SF",
          FontSlant->"Plain"], 
         RowBox[{
          StyleBox["p",
           FontSlant->"Plain"], ",", 
          StyleBox["tot",
           FontSlant->"Plain"]}]], "]"}]}], ")"}], 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["C",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["p",
          FontSlant->"Plain"], ",", 
         StyleBox["tot",
          FontSlant->"Plain"]}]], ")"}], "\[Dagger]"]}], ")"}], ","}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"c096209a-bce3-4d41-b4d4-6ca6ebadbb7f"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["P",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"]], 
    RowBox[{"[", 
     SubsuperscriptBox[
      StyleBox["C",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["p",
        FontSlant->"Plain"], ",", 
       StyleBox["tot",
        FontSlant->"Plain"]}]], "]"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "44c35aa4-27ee-45bc-896d-cc904f2b2ef2"],
 " is the pair self-energy of method ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2e9d10fa-fefa-407e-b776-7bfdcd80ae3a"],
 " for the pair matrix ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["C",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["p",
      FontSlant->"Plain"], ",", 
     StyleBox["tot",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "aa607f74-82b2-4f46-8770-b1261396d4a3"],
 " (Section II.2; linear in it, and it contains every pair channel of the \
method, not only the channels ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a00c18e2-fd9b-42e1-a440-b4c98eeca658"],
 "). ",
 StyleBox["Derivation.",
  FontWeight->"Bold"],
 " The expectation value of the pair term of the BdG Hamiltonian is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     StyleBox["V", "TI"], "\[RightAngleBracket]"}], "\[LongEqual]", 
    RowBox[{"-", 
     StyleBox["Re",
      FontSlant->"Plain"]}], "\[ThinSpace]", 
    StyleBox["tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["P",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["a",
        FontSlant->"Plain"]], 
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox[
         StyleBox["C",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], 
         StyleBox["SF",
          FontSlant->"Plain"], 
         RowBox[{
          StyleBox["p",
           FontSlant->"Plain"], ",", 
          StyleBox["tot",
           FontSlant->"Plain"]}]], ")"}], "\[Dagger]"]}], ")"}]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3c6a993f-57ab-40b1-a780-058acabcdf89"],
 "; the thermal state of the Hamiltonian with the pair term has the \
thermodynamic potential ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{"\[LeftAngleBracket]", 
     StyleBox["V", "TI"], "\[RightAngleBracket]"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ec98c695-4549-41b1-a649-7d4a8322ab45"],
 " below that of the normal state (second-order perturbation theory); the \
free energy of the method contains this potential minus ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftAngleBracket]", 
    StyleBox["V", "TI"], "\[RightAngleBracket]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c724017e-2083-4414-bc62-27b1fcd1da8b"],
 " (the pair term is not part of the Hamiltonian of the model) plus the pair \
part of the interaction energy, which is quadratic in the pair matrix and \
equals ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", "2"]}], 
    StyleBox["Re",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["P",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["SF",
        FontSlant->"Plain"]], 
      RowBox[{"[", 
       SubsuperscriptBox[
        StyleBox["C",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["p",
          FontSlant->"Plain"], ",", 
         StyleBox["tot",
          FontSlant->"Plain"]}]], "]"}], 
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox[
         StyleBox["C",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], 
         StyleBox["SF",
          FontSlant->"Plain"], 
         RowBox[{
          StyleBox["p",
           FontSlant->"Plain"], ",", 
          StyleBox["tot",
           FontSlant->"Plain"]}]], ")"}], "\[Dagger]"]}], ")"}]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "862cf7cf-1963-462f-b516-c61b43909d8a"],
 "; the sum is the formula above. The field of the state is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[CapitalPhi]", "3"], "\[LongEqual]", 
    StyleBox["tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], 
      SubscriptBox[
       StyleBox["P",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["SF",
        FontSlant->"Plain"]], 
      RowBox[{"[", 
       SubsuperscriptBox[
        StyleBox["C",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["p",
          FontSlant->"Plain"], ",", 
         StyleBox["tot",
          FontSlant->"Plain"]}]], "]"}]}], ")"}], "/", "8"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b954f593-689b-4733-bc3a-303b10814554"],
 ". The free energy of the field is the smallest ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalF]",
     FontSlant->"Plain"], 
    RowBox[{"2", ",", 
     StyleBox["SF",
      FontSlant->"Plain"]}], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3e0817b7-8aca-4acf-b898-99d9d0e6f6dd"],
 " among the states with this field: the components of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["P",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["a",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "afe9aad1-2711-41e6-b576-af6f9878d8a0"],
 " along ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], "1"], ")"}], "\[Dagger]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "25eb6146-34cf-49aa-85cf-2bcb73e76411"],
 ", ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], "2"], ")"}], "\[Dagger]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "99e763f8-7b1d-4a3a-bbe4-0e1c60bfc60b"],
 ", ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dd7aacfd-3339-4179-a977-d4ac8773feee"],
 " are held at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "0", ",", "1"}], ")"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "963a7cd4-7fc7-4467-925e-be00f8acbd7a"],
 ", and its components along the other 25 antisymmetric matrices are made \
self-consistent (a linear system of 25 complex unknowns: the stationarity of \
the free energy with a Lagrange multiplier for the field). Then ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["Tay",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["pair",
        FontSlant->"Plain"]], ";", 
      StyleBox["T", "TI"]}], ")"}], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalF]",
      FontSlant->"Plain"], 
     RowBox[{"2", ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]], "/", 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      SuperscriptBox["\[CapitalPhi]", "3"], "\[RightBracketingBar]"}], "2"]}],
    TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6c44d0d0-45e3-43a9-b560-8c1b083462d6"],
 ". At ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["pair",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "07a162a1-b04c-4b16-98ff-d5cb62d9bf33"],
 " and in the channel ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f8b1d378-816d-4897-ab21-811939abb2e7"],
 " alone this is"
