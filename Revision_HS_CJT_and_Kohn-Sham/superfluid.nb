        StyleBox["P",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["SF",
         FontSlant->"Plain"]]},
      {
       SubsuperscriptBox[
        StyleBox["P",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["SF",
         FontSlant->"Plain"], "\[Dagger]"], 
       RowBox[{"-", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SubscriptBox[
            StyleBox["h",
             FontFamily->"Helvetica",
             FontSlant->"Plain"], 
            StyleBox["LL",
             FontSlant->"Plain"]], 
           RowBox[{"(", 
            RowBox[{"-", 
             SubscriptBox[
              OverscriptBox[
               StyleBox["q", "TI"], "\[RightVector]"], 
              StyleBox["LL",
               FontSlant->"Plain"]]}], ")"}], "+", 
           SubscriptBox[
            StyleBox["N",
             FontFamily->"Helvetica",
             FontSlant->"Plain"], 
            StyleBox["SF",
             FontSlant->"Plain"]]}], ")"}], 
         StyleBox["T", "TI"]]}]}
     },
     GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.7]}, 
         Offset[0.27999999999999997`]}, "Rows" -> {
         Offset[0.2], {
          Offset[0.4]}, 
         Offset[0.2]}}], "\[NoBreak]", ")"}], ","}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"5897d657-f2e7-40e3-9577-d14649c2b2d3"],

Cell[TextData[{
 "whose projector onto the negative eigenvalues gives ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["C",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["n",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e764f556-35af-44c7-b10f-9d7be4481251"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SubsuperscriptBox[
     StyleBox["C",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "db78e309-a797-44e3-ae23-bbadeef40780"],
 " as its upper blocks. ",
 StyleBox["The grid:",
  FontWeight->"Bold"],
 " 24 Gauss-Legendre nodes of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftBracketingBar]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["q", "TI"], "\[RightVector]"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[RightBracketingBar]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "29da7472-09e7-456e-8d53-cd5a482c75a9"],
 " on ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"0", ",", 
     SubscriptBox["\[CapitalLambda]", 
      StyleBox["LL",
       FontSlant->"Plain"]]}], "]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bcd0ebfa-c9e4-4c92-a300-930e2ae7acd1"],
 " times the six directions ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["e", "TI"], "\[RightVector]"], 
     StyleBox["j", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "09fe08b0-a1d0-4e19-a3ac-79de94b1b7d7"],
 ", with the weight ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["w", "TI"], 
     StyleBox["r",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     StyleBox["q", "TI"], "2"], "/", 
    RowBox[{"(", 
     RowBox[{"2", 
      SuperscriptBox["\[Pi]", "2"]}], ")"}], "/", "6"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d09995d7-c5a5-4915-808b-dd4e50896266"],
 " of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Integral]", "\[ThinSpace]", 
    SuperscriptBox[
     StyleBox["d", "TI"], "3"], 
    StyleBox["q", "TI"], "/", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"2", "\[Pi]"}], ")"}], "3"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1e14e585-4762-49b8-91d2-805f9f0cdec6"],
 ". ",
 StyleBox["The iteration:",
  FontWeight->"Bold"],
 " the self-energies are mixed (new times 0.6 plus old times 0.4) until they \
change by less than ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "12"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0025916e-d1f5-4cf5-bafe-a077daa7e15c"],
 ". The gap is the minimum over ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "\[LessEqual]", 
    RowBox[{"\[LeftBracketingBar]", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["q", "TI"], "\[RightVector]"], 
      StyleBox["LL",
       FontSlant->"Plain"]], "\[RightBracketingBar]"}], "\[LessEqual]", 
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5e06b9dd-e91f-4321-a2e5-0f0e7181ff99"],
 " of the smallest eigenvalue modulus of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["H",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d5a0f5fb-0ebe-49ad-a699-7f77af2ac267"],
 " (401 momenta and a golden-section refinement), and the Dirac mass is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "+", 
    FractionBox["1", "8"], 
    StyleBox["tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[Beta]", 
         StyleBox["LL",
          FontSlant->"Plain"]], "\[CircleTimes]", 
        SubscriptBox[
         StyleBox["1",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], "2"]}], ")"}], 
      SubscriptBox[
       StyleBox["N",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["SF",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cea6441c-e1e9-4f25-9221-1a301e390b99"],
 ". The next cell defines this engine; the cell after it checks that the \
self-energies are the derivatives of the energy (central differences on \
random states) and that the engine with the pairing term alone reproduces the \
analytic solution AS3 of Part I."
}], "Text",ExpressionUUID->"4b7a5ff8-9089-498b-a173-d1091e4cccc6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"--", " ", "the"}]}], " ", "constants", " ", "and", " ", 
    "matrices", " ", "of", " ", "the", " ", "engine", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"floating", " ", "point"}], ")"}], " ", "--"}], "--"}]}], " ", 
   "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"lamLL", " ", "=", " ", "1."}], ";"}], 
   "                                   ", 
   RowBox[{"(*", " ", 
    RowBox[{"the", " ", "momentum", " ", "cutoff", " ", "Lambda_LL"}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"gvLL", ",", " ", "gfLL"}], "}"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"0.7", ",", " ", "0.45"}], "}"}]}], ";"}], 
   "                   ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", "gauge", " ", "couplings", " ", 
      RowBox[{"g", "^", "v_LL"}]}], ",", " ", 
     RowBox[{
      RowBox[{"g", "^", "F_LL"}], " ", "of", " ", "the", " ", "project"}]}], 
    " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"id8", " ", "=", " ", 
     RowBox[{"N", "[", 
      RowBox[{"IdentityMatrix", "[", "8", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"b8", " ", "=", " ", 
     RowBox[{"N", "[", 
      RowBox[{"d8", "[", "betaLL", "]"}], "]"}]}], ";"}], 
   "                           ", 
   RowBox[{"(*", " ", 
    RowBox[{"beta_LL", " ", 
     RowBox[{"(", "x", ")"}], " ", "1", "_", "2"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"k8", "[", "iota_", "]"}], " ", ":=", " ", 
     RowBox[{"N", "[", 
      RowBox[{"kLL", "[", "iota", "]"}], "]"}]}], ";"}], 
   "                    ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"K", "^", "iota_LL"}], ",", " ", "numerical"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"zero8", " ", "=", " ", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{
       RowBox[{"0.", " ", "I"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"8", ",", " ", "8"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"gaussLegendre", "[", "n", "]"}], ":", " ", 
     RowBox[{
      RowBox[{
      "the", " ", "nodes", " ", "and", " ", "weights", " ", "of", " ", "the", 
       " ", "n"}], "-", 
      RowBox[{"point", " ", "Gauss"}], "-", 
      RowBox[{"Legendre", " ", "rule", " ", 
       RowBox[{"on", " ", "[", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "1"}], "]"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"40", " ", "digits"}], ",", " ", 
         RowBox[{"then", " ", "machine", " ", "numbers"}]}], ")"}]}]}]}], " ",
     "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"gaussLegendre", "[", "n_Integer", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "xx", ",", " ", "poly", ",", " ", "dpoly", ",", " ", "roots"}], "}"}],
        ",", "\n", "   ", 
       RowBox[{
        RowBox[{"poly", " ", "=", " ", 
         RowBox[{"LegendreP", "[", 
          RowBox[{"n", ",", " ", "xx"}], "]"}]}], ";", " ", 
        RowBox[{"dpoly", " ", "=", " ", 
         RowBox[{"D", "[", 
          RowBox[{"poly", ",", " ", "xx"}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"roots", " ", "=", " ", 
         RowBox[{"Sort", "[", 
          RowBox[{"xx", " ", "/.", " ", 
           RowBox[{"NSolve", "[", 
            RowBox[{
             RowBox[{"poly", " ", "==", " ", "0"}], ",", " ", "xx", ",", " ", 
             
             RowBox[{"WorkingPrecision", " ", "->", " ", "40"}]}], "]"}]}], 
          "]"}]}], ";", "\n", "   ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"N", "[", "roots", "]"}], ",", " ", 
          RowBox[{"N", "[", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"2", "/", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", " ", "-", " ", 
                   RowBox[{"#", "^", "2"}]}], ")"}], " ", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"dpoly", " ", "/.", " ", 
                    RowBox[{"xx", " ", "->", " ", "#"}]}], ")"}], "^", 
                  "2"}]}], ")"}]}], " ", "&"}], ",", " ", "roots"}], "]"}], 
           "]"}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"gridSF", "[", "nr", "]"}], ":", " ", 
      RowBox[{"the", " ", "radial", " ", "nodes", " ", "kr", " ", 
       RowBox[{"(", 
        RowBox[{"on", " ", "[", 
         RowBox[{"0", ",", " ", "Lambda"}], "]"}], ")"}], " ", "and", " ", 
       "weights", " ", "wr"}]}], ",", " ", 
     RowBox[{
      RowBox[{"the", " ", "momenta", " ", "q", " ", 
