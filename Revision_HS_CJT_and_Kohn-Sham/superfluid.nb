Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "2", ")"}]], "\[LongEqual]", 
   FractionBox["1", "2"], 
   RowBox[{"(", "2.8", ")"}], ":", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       OverscriptBox["\[CapitalPsi]", "_"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      SubscriptBox["\[CapitalPsi]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}], "2"], ":", 
   RowBox[{"+", 
    FractionBox["1", "2"]}], 
   RowBox[{"(", "0.8", ")"}], "\[ThinSpace]", 
   UnderscriptBox["\[Sum]", 
    StyleBox["p", "TI"],
    LimitsPositioning->True], "\[ThinSpace]", 
   SubsuperscriptBox["\[Eta]", 
    StyleBox["pp", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], ":", 
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["j", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["F",
        FontSlant->"Plain"], ",", 
       StyleBox["p", "TI"]}]], ")"}], "2"], ":", 
   RowBox[{"-", 
    FractionBox["1", "4"]}], 
   RowBox[{"(", "25.2", ")"}], "\[ThinSpace]", 
   UnderscriptBox["\[Sum]", "\[Iota]",
    LimitsPositioning->True], ":", 
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox["\[CapitalPi]", 
      StyleBox["LL",
       FontSlant->"Plain"], "\[Iota]"], ")"}], "\[Dagger]"], 
   SubsuperscriptBox["\[CapitalPi]", 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Iota]"], ":", "."}], 
  TraditionalForm]], "DisplayFormula",
