Cell[TextData[{
 "The next cell prints the numbers of the answer: the critical temperature, \
the order parameter at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7adcd579-6653-4623-ad20-1ed6f474721a"],
 " and at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.98", "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "50fb7b51-12b5-4e7b-9435-302fd235a1ae"],
 ", the radius of convergence at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.98", "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "693e2276-3e8c-46d4-9379-4e1a92b5de84"],
 " (from the Dirac mass of the normal state computed by the notebook), the \
reduced temperature above which the order parameter lies inside the radius, \
and the residuals of the two forms at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c5bbe8ea-fdd2-46e9-bd9d-3b0a234110a9"],
 " and at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.98", "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d7b673d8-5c9b-42f4-954b-224394a2df4d"],
 " (in per cent of the depth). The two cells of the figure after it show the \
order parameter and the radius against ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "/", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "37d71df4-5236-4b65-9ed9-edf900f3588a"],
 " and their ratio, and the residuals of the two forms."
}], "Text",ExpressionUUID->"33d21284-855d-4fff-b658-f7e2428053a7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"thRadius", "[", 
     RowBox[{"t", ",", " ", "tau"}], "]"}], ":", " ", 
    RowBox[{"the", " ", "radius", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"M_n", 
         RowBox[{
          RowBox[{"(", "T", ")"}], "^", "2"}]}], " ", "+", " ", 
        RowBox[{
         RowBox[{"pi", "^", "2"}], " ", 
         RowBox[{"T", "^", "2"}]}]}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}]}], " ", "with", " ", "the", " ", 
     "Dirac", " ", "mass", " ", "of", " ", "the", " ", "normal", " ", "state",
      " ", "computed", " ", "by", " ", "the", " ", "notebook"}]}], " ", 
   "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"thRadius", "[", 
      RowBox[{"t_", ",", " ", "tau_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"temp", " ", "=", " ", 
         RowBox[{"tau", " ", 
          RowBox[{"thTc", "[", "t", "]"}]}]}], "}"}], ",", " ", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"thMassN", "[", 
           RowBox[{"t", ",", " ", "temp"}], "]"}], "^", "2"}], " ", "+", " ", 
         
         RowBox[{
          RowBox[{"Pi", "^", "2"}], " ", 
          RowBox[{"temp", "^", "2"}]}]}], "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"thCross", "[", "t", "]"}], ":", " ", 
     RowBox[{
      RowBox[{
      "the", " ", "reduced", " ", "temperature", " ", "above", " ", "which", " ",
        "Phi0", 
       RowBox[{"(", "T", ")"}]}], " ", "<", " ", 
      RowBox[{"r", 
       RowBox[{"(", "T", ")"}], " ", 
       RowBox[{"(", 
        RowBox[{
        "linear", " ", "interpolation", " ", "in", " ", "the", " ", "table", " ",
          "of", " ", "temperatures"}], ")"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"thCross", "[", "t_", "]"}], " ", ":=", " ", 
