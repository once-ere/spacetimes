Cell[TextData[{
 "with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftBracketingBar]", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["q", "TI"], "\[RightVector]"], 
      StyleBox["LL",
       FontSlant->"Plain"]], "\[RightBracketingBar]"}], "<", 
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2ef2eeef-eb3c-4f8a-bc1a-3b337c304887"],
 ". The energy per volume is the kinetic part plus the contractions of the \
contact terms: a bilinear term ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Nu]", ":", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["\[CapitalPsi]", "\[Dagger]"], 
       SubscriptBox[
        StyleBox["X",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["SF",
         FontSlant->"Plain"]], "\[CapitalPsi]"}], ")"}], "2"], ":"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "058f3159-e812-4f9c-b7fc-c426c2447cfb"],
 " gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Nu]", 
    RowBox[{"[", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["w", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["H",
        FontSlant->"Plain"]], "\[ThinSpace]", 
      StyleBox["tr",
       FontSlant->"Plain"], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         StyleBox["X",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], "\[Delta]", 
         SuperscriptBox[
          StyleBox["C",
           FontFamily->"Helvetica",
           FontSlant->"Plain"], 
          StyleBox["n",
           FontSlant->"Plain"]]}], ")"}], "2"], "-", 
      SubsuperscriptBox[
       StyleBox["w", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["F",
        FontSlant->"Plain"]], "\[ThinSpace]", 
      StyleBox["tr",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       RowBox[{
        StyleBox["X",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        OverscriptBox[
         StyleBox["C",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], "~"], 
        StyleBox["X",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        OverscriptBox[
         StyleBox["C",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], "~"]}], ")"}], "-", 
      SubsuperscriptBox[
       StyleBox["w", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["P",
        FontSlant->"Plain"]], "\[ThinSpace]", 
      StyleBox["tr",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          SuperscriptBox[
           StyleBox["C",
            FontFamily->"Helvetica",
            FontSlant->"Plain"], 
           StyleBox["p",
            FontSlant->"Plain"]], ")"}], "*"], 
        StyleBox["X",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        SuperscriptBox[
         StyleBox["C",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], 
         StyleBox["p",
          FontSlant->"Plain"]], 
        SuperscriptBox[
         StyleBox["X",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], 
         StyleBox["T", "TI"]]}], ")"}]}], "]"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0c239a04-ccca-4d86-9c51-5b50b8920218"],
 ", and a pairing term ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", "4"]}], 
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], ":", 
    SuperscriptBox[
     RowBox[{"(", 
      SuperscriptBox["\[CapitalPi]", "\[Iota]"], ")"}], "\[Dagger]"], 
    SuperscriptBox["\[CapitalPi]", "\[Iota]"], ":"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e043efdd-3493-4a31-b93a-6bb2986177cc"],
 " gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", "4"]}], 
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"[", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["w", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["P",
        FontSlant->"Plain"]], 
      SuperscriptBox[
       RowBox[{"\[LeftBracketingBar]", 
        RowBox[{
         StyleBox["tr",
          FontSlant->"Plain"], 
         RowBox[{"(", 
          RowBox[{
           SubsuperscriptBox[
            StyleBox["K",
             FontFamily->"Helvetica",
             FontSlant->"Plain"], 
            StyleBox["LL",
             FontSlant->"Plain"], "\[Iota]"], 
           SuperscriptBox[
            RowBox[{"(", 
             SuperscriptBox[
              StyleBox["C",
               FontFamily->"Helvetica",
               FontSlant->"Plain"], 
              StyleBox["p",
               FontSlant->"Plain"]], ")"}], 
            StyleBox["T", "TI"]]}], ")"}]}], "\[RightBracketingBar]"}], "2"], 
      "+", "2", 
      SubsuperscriptBox[
       StyleBox["w", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["F",
        FontSlant->"Plain"]], "\[ThinSpace]", 
      StyleBox["tr",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          SubsuperscriptBox[
           StyleBox["K",
            FontFamily->"Helvetica",
            FontSlant->"Plain"], 
           StyleBox["LL",
            FontSlant->"Plain"], "\[Iota]"], ")"}], "\[Dagger]"], 
        SuperscriptBox[
         OverscriptBox[
          StyleBox["C",
           FontFamily->"Helvetica",
           FontSlant->"Plain"], "~"], 
         StyleBox["T", "TI"]], 
        SubsuperscriptBox[
         StyleBox["K",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], 
         StyleBox["LL",
          FontSlant->"Plain"], "\[Iota]"], 
        OverscriptBox[
         StyleBox["C",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], "~"]}], ")"}]}], "]"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "69d4701d-648b-4101-ae01-2ae9acb3dbd0"],
 ", where the weights ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["w", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["H",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "64c43c27-42ac-48b7-ba88-b250e00e9e70"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["w", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["F",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2799b1bf-f73a-4100-bf6e-54420de43753"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["w", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["P",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b1d01cb0-dc65-484b-887d-407b1a51e9b9"],
 " of the direct (Hartree), exchange (Fock) and pair (Bogoliubov) \
contractions define the method, and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     StyleBox["C",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "~"], "\[LongEqual]", "\[Delta]", 
    SuperscriptBox[
     StyleBox["C",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["n",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4a399f70-9023-4261-b3b9-7a27a89faed8"],
 " except in KS, where it is the projection ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalP]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["KS",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     RowBox[{"\[Delta]", 
      SuperscriptBox[
       StyleBox["C",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["n",
        FontSlant->"Plain"]]}], ")"}], "\[LongEqual]", 
    FractionBox["1", "8"], 
    StyleBox["tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{"\[Delta]", 
      SuperscriptBox[
       StyleBox["C",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["n",
        FontSlant->"Plain"]]}], ")"}], 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "8"], "+", 
    FractionBox["1", "8"], 
    StyleBox["tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[Beta]", 
         StyleBox["LL",
          FontSlant->"Plain"]], "\[CircleTimes]", 
        SubscriptBox[
         StyleBox["1",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], "2"]}], ")"}], "\[Delta]", 
      SuperscriptBox[
       StyleBox["C",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["n",
        FontSlant->"Plain"]]}], ")"}], 
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[CircleTimes]", 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6f4c78dc-ffcf-48a7-8f4f-53a9d1de7f3e"],
 " onto the two Kohn-Sham densities. ",
 StyleBox["HS",
  FontWeight->"Bold"],
 " decouples the shares ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["s", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["HS",
      FontSlant->"Plain"], ",", 
     StyleBox["S",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5c834544-46c2-4789-a4f1-f3ee0024cf1c"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["s", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["HS",
      FontSlant->"Plain"], ",", 
     StyleBox["V",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "79efb4e3-09a1-4c0d-9de7-9fdf7875a6f6"],
 " of the scalar and the vector term in the density channels and the rest in \
the pair channels: weights ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["s", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["HS",
        FontSlant->"Plain"], ",", 
       StyleBox["S",
        FontSlant->"Plain"]}]], ",", "0", ",", "1", "-", 
     SubsuperscriptBox[
      StyleBox["s", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["HS",
        FontSlant->"Plain"], ",", 
       StyleBox["S",
        FontSlant->"Plain"]}]]}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "51fd1de9-5291-417e-88aa-6c902bb5c217"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["s", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["HS",
        FontSlant->"Plain"], ",", 
       StyleBox["V",
        FontSlant->"Plain"]}]], ",", "0", ",", "1", "-", 
     SubsuperscriptBox[
      StyleBox["s", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["HS",
        FontSlant->"Plain"], ",", 
       StyleBox["V",
        FontSlant->"Plain"]}]]}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0742c0ac-7a89-49ee-a3d3-0bbaba1d3d1f"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "0", ",", "1"}], ")"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8aa67746-93ca-403b-97e5-25383ef15921"],
 " for the pairing term; three parameter sets are computed, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"1", ",", "1"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "db4a3498-bc7a-4ade-9fa6-a139490df5dc"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "1"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a09328da-edaa-47f2-becd-f5623e8d35af"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "0"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d86c2bd7-ee77-4b50-8a41-8809bca9619a"],
 ". ",
 StyleBox["KS",
  FontWeight->"Bold"],
 " and ",
 StyleBox["CJT",
  FontWeight->"Bold"],
 " keep all three contractions with weight 1; KS with the projection. The \
self-energies are the derivatives of the energy,"
}], "Text",ExpressionUUID->"3a1a41ae-e0fb-4a61-8ef8-b8e706610d59"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["N",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"]], "\[LongEqual]", "\[Nu]", 
   RowBox[{"[", 
    RowBox[{"2", 
     SubsuperscriptBox[
      StyleBox["w", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      StyleBox["H",
       FontSlant->"Plain"]], "\[ThinSpace]", 
     StyleBox["X",
      FontFamily->"Helvetica",
