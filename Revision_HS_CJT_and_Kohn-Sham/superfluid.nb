             RowBox[{"Map", "[", 
              RowBox[{
               RowBox[{"row", "[", 
                RowBox[{"[", "2", "]"}], "]"}], ",", " ", "lfTags"}], "]"}], ",",
              " ", 
             RowBox[{"row", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], "]"}], ",", " ", 
         "lfRows"}], "]"}], ",", " ", 
       RowBox[{"Prepend", "[", 
        RowBox[{
         RowBox[{"lfName", " ", "/@", " ", "lfTags"}], ",", 
         " ", "\"\<quantity\>\""}], "]"}]}], "]"}], ",", "\n", "  ", 
     RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
     RowBox[{"Alignment", " ", "->", " ", "Left"}], ",", " ", 
