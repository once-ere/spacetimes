Cell[CellGroupData[{

Cell["III.G.4 The coefficient at zero pair momentum and the slope", "Section",ExpressionUUID->"55085174-48a9-472f-85ef-093df46be80f"],

Cell[TextData[{
 "The next cell computes, for every method with its own critical temperature \
(Section III.T.4), the coefficient at zero pair momentum from the static pair \
response and checks it four ways: at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.9", "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "96af0dc5-3688-4672-9acb-66166567e965"],
 " it is the Taylor coefficient of the nonlinear free energy of the Rust \
table (Section III.T); at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "/", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]], "\[LongEqual]", "0.9"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e74a4c4b-7272-435a-9082-b0e407bc379d"],
 ", ",
 Cell[BoxData[
  FormBox["0.998", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4a2d6fbe-5ea5-4813-b4cb-1e2eaa3e93c7"],
 ", ",
 Cell[BoxData[
  FormBox["1.002", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "885aa970-a0ff-4887-8e1b-dfaa043d8caf"],
 " it is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "-", 
      SubsuperscriptBox["\[Lambda]", 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["P",
        FontSlant->"Plain"]]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["\[Lambda]", 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["P",
        FontSlant->"Plain"]], 
      SubsuperscriptBox[
       StyleBox["g", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["P",
         FontSlant->"Plain"]}]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f63239ad-6c5c-4840-91e7-492893b204f9"],
 " with the eigenvalue of Section III.T.4; at ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3c513b04-bfaa-4140-ad71-5b6651caabb1"],
 " it vanishes; and no other pair channel is induced. The slope ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Alpha]", 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["GL",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fbc3d698-4d09-40f6-92fb-808ea276605f"],
 " is computed twice: from central differences of the coefficient at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     RowBox[{"1", "\[PlusMinus]", "0.002"}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9a852fab-5042-440b-99a9-b280dddc234c"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     RowBox[{"1", "\[PlusMinus]", "0.004"}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7361824d-f460-49d8-9c03-99592edbca63"],
 " with the Richardson extrapolation, and in closed form with the derivatives \
of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["I", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "1", ")"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1c07655e-2c89-4c33-bdde-8e92be299a61"],
 " on the radial nodes,"
}], "Text",ExpressionUUID->"5ade1249-9703-4293-a860-67db7eea26d4"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[PartialD]", 
    StyleBox["T", "TI"]], 
   SubsuperscriptBox[
    StyleBox["I", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "1", ")"}]], "\[LongEqual]", 
   RowBox[{"-", 
    FractionBox["1", 
     RowBox[{"2", 
      SuperscriptBox[
       StyleBox["T", "TI"], "2"]}]]}], "\[ThinSpace]", 
   SubsuperscriptBox["\[Integral]", "0", 
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]], "\[ThinSpace]", 
   FractionBox[
    RowBox[{
     SuperscriptBox[
      StyleBox["q", "TI"], "2"], "\[ThinSpace]", 
     StyleBox["dq", "TI"]}], 
    RowBox[{
     SuperscriptBox[
      StyleBox["cosh",
       FontSlant->"Plain"], "2"], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["E", "TI"], 
        StyleBox["M", "TI"]], "/", "2", 
       StyleBox["T", "TI"]}], ")"}]}]], ",", "      ", 
   SubscriptBox["\[PartialD]", 
    StyleBox["M", "TI"]], 
   SubsuperscriptBox[
    StyleBox["I", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "1", ")"}]], "\[LongEqual]", 
   SubsuperscriptBox["\[Integral]", "0", 
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["q", "TI"], "2"], 
   FractionBox[
    StyleBox["M", "TI"], 
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["M", "TI"]]], 
   RowBox[{"[", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"2", 
       StyleBox["T", "TI"], 
       SubscriptBox[
        StyleBox["E", "TI"], 
        StyleBox["M", "TI"]], "\[ThinSpace]", 
       SuperscriptBox[
        StyleBox["cosh",
         FontSlant->"Plain"], "2"], 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox[
          StyleBox["E", "TI"], 
          StyleBox["M", "TI"]], "/", "2", 
         StyleBox["T", "TI"]}], ")"}]}]], "-", 
     FractionBox[
      RowBox[{
       StyleBox["tanh",
        FontSlant->"Plain"], 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox[
          StyleBox["E", "TI"], 
          StyleBox["M", "TI"]], "/", "2", 
         StyleBox["T", "TI"]}], ")"}]}], 
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["M", "TI"], "2"]]}], "]"}], 
   StyleBox["dq", "TI"], ","}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"6ef8cc9e-fc59-4381-a503-5fffff6b4762"],

Cell[TextData[{
 "and the derivative of the Dirac mass of the normal state from the implicit \
function theorem applied to its scalar self-consistency ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["M", "TI"], "-", 
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["S",
       FontSlant->"Plain"]}]], 
    SubsuperscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["S",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["M", "TI"], ",", 
      StyleBox["T", "TI"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4028899d-6abe-4801-9013-48b5e3400b13"],
 " (Section III.T.4): ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", 
     StyleBox["T", "TI"]], 
    StyleBox["M", "TI"], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["S",
       FontSlant->"Plain"]}]], 
    SubscriptBox["\[PartialD]", 
     StyleBox["T", "TI"]], 
    SubsuperscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["S",
      FontSlant->"Plain"]], "/", 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      SubsuperscriptBox[
       StyleBox["g", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["S",
         FontSlant->"Plain"]}]], 
      SubscriptBox["\[PartialD]", 
       StyleBox["M", "TI"]], 
      SubsuperscriptBox[
       StyleBox["n", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["S",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e7d34c75-a3e5-498f-89a2-5fed84eda66d"],
 "."
}], "Text",ExpressionUUID->"45b3c5fa-1817-488a-8ba8-4140bbbf6938"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"gzI1D", "[", 
     RowBox[{"mo", ",", " ", "m", ",", " ", "temp"}], "]"}], ":", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"I1", ",", " ", 
       RowBox[{"dI1", "/", "dT"}], ",", " ", 
       RowBox[{"dI1", "/", "dM"}]}], "}"}], " ", "on", " ", "the", " ", 
     "radial", " ", "nodes", " ", "of", " ", "the", " ", "grid", " ", "of", " ",
      "the", " ", "model", " ", "mo", " ", 
     RowBox[{"(", 
      RowBox[{"temp", " ", ">", " ", "0"}], ")"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"gzI1D", "[", 
      RowBox[{"mo_", ",", " ", "m_", ",", " ", "temp_"}], "]"}], " ", ":=", 
     " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"kr", " ", "=", " ", 
          RowBox[{
           RowBox[{"mo", "[", "\"\<g\>\"", "]"}], "[", "\"\<kr\>\"", "]"}]}], 
         ",", " ", 
         RowBox[{"wr", " ", "=", " ", 
          RowBox[{
           RowBox[{"mo", "[", "\"\<g\>\"", "]"}], "[", "\"\<wr\>\"", "]"}]}], 
         ",", " ", "e", ",", " ", "x"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"e", " ", "=", " ", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{"kr", "^", "2"}], " ", "+", " ", 
           RowBox[{"m", "^", "2"}]}], "]"}]}], ";", " ", 
        RowBox[{"x", " ", "=", " ", 
         RowBox[{"e", "/", 
          RowBox[{"(", 
           RowBox[{"2", " ", "temp"}], ")"}]}]}], ";", "\n", "   ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Total", "[", 
           RowBox[{"wr", " ", 
            RowBox[{"kr", "^", "2"}], " ", 
            RowBox[{
             RowBox[{"Tanh", "[", "x", "]"}], "/", "e"}]}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"Total", "[", 
             RowBox[{"wr", " ", 
              RowBox[{"kr", "^", "2"}], " ", 
              RowBox[{
               RowBox[{"Sech", "[", "x", "]"}], "^", "2"}]}], "]"}]}], "/", 
           RowBox[{"(", 
            RowBox[{"2", " ", 
             RowBox[{"temp", "^", "2"}]}], ")"}]}], ",", " ", 
          RowBox[{"Total", "[", 
           RowBox[{"wr", " ", 
            RowBox[{"kr", "^", "2"}], " ", 
            RowBox[{"(", 
             RowBox[{"m", "/", "e"}], ")"}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"Sech", "[", "x", "]"}], "^", "2"}], "/", 
               RowBox[{"(", 
                RowBox[{"2", " ", "temp", " ", "e"}], ")"}]}], " ", "-", " ", 
              
              RowBox[{
               RowBox[{"Tanh", "[", "x", "]"}], "/", 
               RowBox[{"e", "^", "2"}]}]}], ")"}]}], "]"}]}], "}"}]}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"gzAlphaClosed", "[", "t", "]"}], ":", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"alpha", ",", " ", 
        RowBox[{
         RowBox[{"lambda", "^", "P"}], 
         RowBox[{"(", "T_c", ")"}]}], ",", " ", 
        RowBox[{"M_n", 
         RowBox[{"(", "T_c", ")"}]}]}], "}"}], " ", "in", " ", "closed", " ", 
      "form", " ", "at", " ", "the", " ", "critical", " ", "temperature", " ",
       "of", " ", "the", " ", "notebook"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"gzAlphaClosed", "[", "t_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"mo", " ", "=", " ", 
          RowBox[{"thModel", "[", "t", "]"}]}], ",", " ", 
         RowBox[{"tc", " ", "=", " ", 
          RowBox[{"thTc", "[", "t", "]"}]}], ",", " ", "gs", ",", " ", "gp", ",",
          " ", "mn", ",", " ", "i1", ",", " ", "i1t", ",", " ", "i1m", ",", 
         " ", "i10", ",", " ", "dnt", ",", " ", "dnm", ",", " ", "dmt", ",", 
         " ", "lam", ",", " ", "dlam"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"gs", ",", " ", "gp"}], "}"}], " ", "=", " ", 
         RowBox[{"thCoup", "[", "t", "]"}]}], ";", "\n", "   ", 
        RowBox[{"mn", " ", "=", " ", 
         RowBox[{"thMassN", "[", 
          RowBox[{"t", ",", " ", "tc"}], "]"}]}], ";", "\n", "   ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"i1", ",", " ", "i1t", ",", " ", "i1m"}], "}"}], " ", "=", 
         " ", 
         RowBox[{"gzI1D", "[", 
          RowBox[{"mo", ",", " ", "mn", ",", " ", "tc"}], "]"}]}], ";", "\n", 
        "   ", 
        RowBox[{"dnt", " ", "=", " ", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{"2", "/", 
             RowBox[{"Pi", "^", "2"}]}], ")"}]}], " ", "mn", " ", "i1t"}]}], ";",
         " ", 
        RowBox[{"dnm", " ", "=", " ", 
