Cell[CellGroupData[{

Cell["III.L.3 The computed curves of the Rust program", "Section",ExpressionUUID->"ad39153a-a2d8-45fd-bda1-be08b1c1d1ae"],

Cell[TextData[{
 "The closed cell holds the values of Part III of the Rust program ",
 StyleBox["sf_part3",
  FontFamily->"Source Code Pro"],
 " (",
 StyleBox["rustPart3",
  FontFamily->"Source Code Pro"],
 ") and its five computed polar curves (",
 StyleBox["rustEffPot[tag]",
  FontFamily->"Source Code Pro"],
 ": for each point the applied field ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPhi]", 
    StyleBox["a",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "05f1dfac-47bd-470a-a0e7-cb598064ec6e"],
 ", the field ",
 Cell[BoxData[
  FormBox["\[CapitalPhi]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "36e47a87-55d3-445f-aa2b-0a5c82ac3393"],
 " of the state, the energy per volume ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalV]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "75ae8ba2-cda8-40a1-9c1b-1b26d9207bfb"],
 " and the Dirac mass of the state). They were copied from the data files \
named, with their SHA-256 checksums, in the comment at the top of the cell, \
by ",
 StyleBox["wolfram/tools/make_data_cells.py",
  FontFamily->"Source Code Pro"],
 "."
}], "Text",ExpressionUUID->"9f1b9877-7551-4041-af85-c684324ac78d"],

