Cell[TextData[{
 "The first check of the conventions: the mass matrix of the gauge fields of \
the Standard Model, computed from the covariant derivative (1.1) with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", 
    StyleBox["ig", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3736c3cb-6502-44d1-badb-5bf9877c137a"],
 ", has the eigenvalues ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "acdc15ce-bd8a-4122-a80c-9a3ae22e6c53"],
 " (the photon), ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["M", "TI"], 
    StyleBox["W", "TI"], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ecd454b5-d322-438c-838f-8a3068290f3f"],
 " (twice) and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["M", "TI"], 
    StyleBox["Z", "TI"], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "08ebdd52-81ec-454b-ab28-ebf46b9eb741"],
 ", with the eigenvectors ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["A", "TI"], "\[Mu]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c9072842-75aa-4156-9d1f-d20ba366c22a"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["Z", "TI"], "\[Mu]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "86494ca6-5886-47f2-bd8c-4cd7480d7bb9"],
 " of the text. The kinetic term ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["D", "TI"], "\[Mu]"], 
       RowBox[{"\[LeftAngleBracket]", 
        SuperscriptBox["\[CapitalPhi]", 
         StyleBox["SM",
          FontSlant->"Plain"]], "\[RightAngleBracket]"}]}], ")"}], 
     "\[Dagger]"], 
    SuperscriptBox[
     StyleBox["D", "TI"], "\[Mu]"], 
    RowBox[{"\[LeftAngleBracket]", 
     SuperscriptBox["\[CapitalPhi]", 
      StyleBox["SM",
       FontSlant->"Plain"]], "\[RightAngleBracket]"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "65dfaa46-bf26-4568-a050-264b966b2f46"],
 " of the constant vacuum is the quadratic form ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", 
     StyleBox["ab", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["M",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["ab", "TI"]], 
    SubsuperscriptBox[
     StyleBox["V", "TI"], "\[Mu]", 
     StyleBox["a", "TI"]], 
    SuperscriptBox[
     StyleBox["V", "TI"], 
     RowBox[{
      StyleBox["b", "TI"], ",", "\[Mu]"}]]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "96cbe002-2666-406b-aea3-d714a348922a"],
 " of the four fields ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox[
      StyleBox["W", "TI"], "1"], ",", 
     SuperscriptBox[
      StyleBox["W", "TI"], "2"], ",", 
     SuperscriptBox[
      StyleBox["W", "TI"], "3"], ",", 
     StyleBox["B", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f9faca1f-29fa-45d1-a736-8c5d20e4a9a7"],
 "; the cell computes ",
 Cell[BoxData[
  FormBox[
   StyleBox["M",
    FontFamily->"Helvetica",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5e8f6141-9deb-439b-bbd7-d53c6bb95fa3"],
 " exactly, with symbolic couplings, and diagonalizes it. The Rust program ",
 StyleBox["sf_part1",
  FontFamily->"Source Code Pro"],
 " checks the same statement with numbers through the four eigenvectors, and \
the Python program ",
 StyleBox["sf_part1.py",
  FontFamily->"Source Code Pro"],
 " through the eigenvalues computed by LAPACK (check SM-1 of both); the same \
computation for the superfluid is the mass matrix (14.3) of Part IV."
}], "Text",ExpressionUUID->"a1de5e3b-a037-4329-b6ba-19d8835c0060"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"gSM", ",", " ", 
    RowBox[{
     RowBox[{"gpSM", ":", " ", 
      RowBox[{"the", " ", "couplings", " ", "g", " ", "and", " ", 
       RowBox[{"g", "'"}], " ", "of", " ", "SU", 
       RowBox[{"(", "2", ")"}], "_L", " ", "and", " ", "U", 
       RowBox[{"(", "1", ")"}], "_Y"}]}], ";", " ", 
