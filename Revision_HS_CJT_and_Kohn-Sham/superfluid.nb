         RowBox[{"{", 
          RowBox[{"o", ",", " ", 
           RowBox[{"Keys", "[", "channelOps", "]"}]}], "}"}]}], "]"}], ",", 
       "\n", "   ", 
       RowBox[{"Prepend", "[", 
