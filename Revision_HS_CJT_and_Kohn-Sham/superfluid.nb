Cell[CellGroupData[{

Cell["I.5 The Lagrangian and the field equations (item 4)", "Section",ExpressionUUID->"c032c7ab-58bd-43ae-8037-f41d2b3801d8"],

Cell[TextData[{
 "The Lagrangian density of the solution is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["\[ScriptCapitalL]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalL]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], "\[CapitalPsi]"], "+", 
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalL]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["self",
      FontSlant->"Plain"]], "+", 
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalL]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["YM",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ebafcafd-12c1-4b01-8a76-c215efccf7e7"],
 ", with the Dirac part ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalL]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], "\[CapitalPsi]"], "\[LongEqual]", 
    SubscriptBox[
     OverscriptBox["\[CapitalPsi]", "_"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["i", "TI"], "\[ThinSpace]", 
      UnderscriptBox["\[Sum]", 
       StyleBox["p", "TI"],
       LimitsPositioning->True], "\[ThinSpace]", 
      SubsuperscriptBox["\[Gamma]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["p", "TI"]], 
      SubsuperscriptBox["\[Del]", 
       StyleBox["p", "TI"], 
       StyleBox["GEE",
        FontSlant->"Plain"]], "-", 
      SubscriptBox[
       StyleBox["m", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}], 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "475bdd6f-ef9f-4e7d-9b77-5032fa74b1d3"],
 ", the Yang-Mills part ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalL]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["YM",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"-", 
     FractionBox["1", "4"]}], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", "\[Iota]",
     LimitsPositioning->True], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["W", "TI"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}], "\[Iota]"], 
    SubsuperscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{"\[Iota]", ",", 
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], "-", 
    FractionBox["1", "4"], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["B", "TI"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], 
    SubsuperscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5a3c36a0-4030-49f3-8812-fd2169672e05"],
 ", and the self-interaction ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalL]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["self",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"-", 
     SubsuperscriptBox[
      StyleBox["V", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       StyleBox["n", "TI"], ")"}]]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bc0ba021-c667-49c6-8e85-2435736553d1"],
 ", a normal-ordered GEE-invariant contact interaction. Its first two steps \
are"
}], "Text",ExpressionUUID->"fcb70738-6036-48eb-ab1d-3fe8ccc367be"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "0", ")"}]], "\[LongEqual]", 
   FractionBox["1", "2"], 
   SubsuperscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["S",
     FontSlant->"Plain"]], ":", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       OverscriptBox["\[CapitalPsi]", "_"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      SubscriptBox["\[CapitalPsi]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}], "2"], ":", 
   RowBox[{"+", 
    FractionBox["1", "2"]}], 
   SubsuperscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["V",
     FontSlant->"Plain"]], "\[ThinSpace]", 
   UnderscriptBox["\[Sum]", 
    StyleBox["p", "TI"],
    LimitsPositioning->True], "\[ThinSpace]", 
   SubsuperscriptBox["\[Eta]", 
    StyleBox["pp", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], ":", 
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["j", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["F",
        FontSlant->"Plain"], ",", 
       StyleBox["p", "TI"]}]], ")"}], "2"], ":", ",", "      ", 
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "1", ")"}]], "\[LongEqual]", 
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "0", ")"}]], "-", 
   FractionBox["1", "4"], 
   SubscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], "\[ThinSpace]", 
   UnderscriptBox["\[Sum]", "\[Iota]",
    LimitsPositioning->True], ":", 
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox["\[CapitalPi]", 
      StyleBox["LL",
       FontSlant->"Plain"], "\[Iota]"], ")"}], "\[Dagger]"], 
   SubsuperscriptBox["\[CapitalPi]", 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Iota]"], ":", ","}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"e803be97-b9ec-4750-af6d-6e72a335d35c"],

Cell[TextData[{
 "with the fermion-number current ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["j", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["F",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}]], "\[LongEqual]", 
    SubscriptBox[
     OverscriptBox["\[CapitalPsi]", "_"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p", "TI"]], 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9cd11834-3915-4d29-86b0-1109b521282e"],
 " and the pair operators ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalPi]", 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Iota]"], "\[LongEqual]", 
    SubsuperscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["T", "TI"]], 
    SubsuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Iota]"], 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ad9839b0-192a-4495-a39c-8a0fbf781976"],
 " of one point. ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "0", ")"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ee0f2c9d-8909-4d79-a207-39d134754e40"],
 " is formed after the author's Kohn-Sham ansatz, whose interaction energy \
density of uniform matter is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], 
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["V", "TI"]], 
    SuperscriptBox[
     StyleBox["n", "TI"], "2"], "+", 
    FractionBox["1", "2"], 
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["S", "TI"]], 
    SubsuperscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["S", "TI"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "87f4edbe-1932-4a48-8b26-ac128ce3c7eb"],
 "; ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "1", ")"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c5467397-0200-4d31-914b-8f1af7d406c1"],
 " adds the attraction in the spin-zero pair channel. Varying the action with \
respect to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox["\[CapitalPsi]", "_"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "95350b44-1b35-44e3-a5e5-c7fe230aafab"],
 " gives the field equation of the spinor field,"
}], "Text",ExpressionUUID->"bdbda5ca-58c5-4c3d-afd8-3e9f66abe7cf"],

Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox["i", "TI"], "\[ThinSpace]", 
   UnderscriptBox["\[Sum]", 
    StyleBox["p", "TI"],
    LimitsPositioning->True], "\[ThinSpace]", 
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p", "TI"]], 
   SubsuperscriptBox["\[Del]", 
    StyleBox["p", "TI"], 
    StyleBox["GEE",
     FontSlant->"Plain"]], 
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], "-", 
   SubscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], "\[LongEqual]", 
   SubsuperscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["S",
     FontSlant->"Plain"]], 
   RowBox[{"(", 
    RowBox[{
     SubscriptBox[
      OverscriptBox["\[CapitalPsi]", "_"], 
      StyleBox["LL",
       FontSlant->"Plain"]], 
     SubscriptBox["\[CapitalPsi]", 
      StyleBox["LL",
       FontSlant->"Plain"]]}], ")"}], 
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], "+", 
   SubsuperscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["V",
     FontSlant->"Plain"]], "\[ThinSpace]", 
   UnderscriptBox["\[Sum]", 
    StyleBox["p", "TI"],
    LimitsPositioning->True], "\[ThinSpace]", 
   SubsuperscriptBox[
    StyleBox["j", "TI"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}], 
    StyleBox["F",
     FontSlant->"Plain"]], 
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p", "TI"]], 
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], "-", 
   FractionBox["1", "2"], 
   SubscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], "\[ThinSpace]", 
   UnderscriptBox["\[Sum]", "\[Iota]",
    LimitsPositioning->True], "\[ThinSpace]", 
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], "0"], 
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], "\[Iota]"], ")"}], "\[Dagger]"], 
   SubsuperscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"], "*"], "\[ThinSpace]", 
   SubsuperscriptBox["\[CapitalPi]", 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Iota]"], ","}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"2aaf82df-7e75-463a-802a-d1eaacd7dca6"],

Cell[TextData[{
 "and varying with respect to the gauge fields gives the Yang-Mills equations \
with the currents of the spinor field as sources, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["p", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubscriptBox["\[PartialD]", 
     StyleBox["p", "TI"]], 
    SubsuperscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{"\[Iota]", ",", 
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], "-", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      SuperscriptBox["\[Iota]", "\[Prime]"], 
      SuperscriptBox["\[Iota]", "\[Prime]\[Prime]"]}],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox["\[Epsilon]", 
     RowBox[{"\[Iota]", 
      SuperscriptBox["\[Iota]", "\[Prime]"], 
      SuperscriptBox["\[Iota]", "\[Prime]\[Prime]"]}], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", 
     StyleBox["p", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["W", "TI"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], 
     SuperscriptBox["\[Iota]", "\[Prime]"]], 
    SubsuperscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      SuperscriptBox["\[Iota]", "\[Prime]\[Prime]"], ",", 
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["j", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{"\[Iota]", ",", 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "530653d1-9a29-4d3e-ad2d-68119d491916"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["p", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubscriptBox["\[PartialD]", 
     StyleBox["p", "TI"]], 
    SubsuperscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["j", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["F",
       FontSlant->"Plain"], ",", 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "067020a6-3010-427f-b603-8a94301a64ff"],
 "."
}], "Text",ExpressionUUID->"20cbd173-9e5e-426c-a676-21635529e5ae"],

Cell[TextData[{
 "The right side of the field equation of the spinor field is the commutator \
of the field with the Hamiltonian of the contact terms. The next cell checks \
this exactly, as an identity of operators on the Fock space of the eight \
components of one point (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["2", "8"], "\[LongEqual]", "256"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4b0a6acc-5da9-4726-aa27-ae9fd8b0dcd2"],
 " states), for each contact term: with the Hamiltonians ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["S",
      FontSlant->"Plain"]], "\[LongEqual]", 
    FractionBox["1", "2"], 
    SuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["S",
      FontSlant->"Plain"]], ":", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["\[CapitalPsi]", "\[Dagger]"], "\[Beta]", 
       "\[CapitalPsi]"}], ")"}], "2"], ":"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7809c871-e9f1-4bcb-8fbc-2088629c5a47"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["V",
      FontSlant->"Plain"]], "\[LongEqual]", 
    FractionBox["1", "2"], 
    SuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["V",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     RowBox[{":", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["\[CapitalPsi]", "\[Dagger]"], "\[CapitalPsi]"}], 
        ")"}], "2"], ":", 
      RowBox[{"-", 
       UnderscriptBox["\[Sum]", 
        StyleBox["j", "TI"],
        LimitsPositioning->True]}], ":", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["\[CapitalPsi]", "\[Dagger]"], 
         SuperscriptBox["\[Alpha]", 
          StyleBox["j", "TI"]], "\[CapitalPsi]"}], ")"}], "2"], ":"}], 
     ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "abe43626-651a-4d28-9810-0bc3a7757daf"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["P",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"-", 
     FractionBox["1", "4"]}], 
    StyleBox["G", "TI"], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", "\[Iota]",
     LimitsPositioning->True], "\[ThinSpace]", 
    SuperscriptBox["\[CapitalPi]", 
     RowBox[{"\[Iota]", "\[Dagger]"}]], 
    SuperscriptBox["\[CapitalPi]", "\[Iota]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8bd072f9-a7c9-4a6e-aee3-51053962fa49"],
 ", the commutators ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{
     SubscriptBox["\[CapitalPsi]", 
      StyleBox["e", "TI"]], ",", 
     StyleBox["H", "TI"]}], "]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d179d928-e68c-45d6-be6d-23c43a0a4318"],
 " equal ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["S",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     RowBox[{
      OverscriptBox["\[CapitalPsi]", "_"], "\[CapitalPsi]"}], ")"}], 
    SubscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["\[Gamma]", "0"], "\[CapitalPsi]"}], ")"}], 
     StyleBox["e", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d75a4000-a591-4a1f-bd66-5bef9a0b30ca"],
 ", the vector term, and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", "2"]}], 
    StyleBox["G", "TI"], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", "\[Iota]",
     LimitsPositioning->True], 
    SubscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        StyleBox["K",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        RowBox[{"\[Iota]", "\[Dagger]"}]], 
       SuperscriptBox["\[CapitalPsi]", "*"]}], ")"}], 
     StyleBox["e", "TI"]], 
    SuperscriptBox["\[CapitalPi]", "\[Iota]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e2182cbb-9d3b-44a4-ad2b-bdf8e437ffd5"],
 ". The couplings of the test are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["S",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"-", "8"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4d28949a-b937-4d6e-9634-fb7d739b52e1"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["V",
      FontSlant->"Plain"]], "\[LongEqual]", "4", "/", "5"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e2b95541-d152-4718-867f-e0911c028356"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["G", "TI"], "\[LongEqual]", "45", "/", "2"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0867676b-af35-4447-8880-9e04866e06ce"],
 ", exact numbers, so every deviation must be exactly 0. The last check of \
the cell derives the Yang-Mills equations with a source symbolically, with \
the function ",
 StyleBox["EulerEquations",
  FontFamily->"Source Code Pro"],
 " of the package ",
 StyleBox["VariationalMethods",
  FontFamily->"Source Code Pro"],
 " of the Wolfram Language, and compares all twelve equations with the form \
above."
}], "Text",ExpressionUUID->"bc322995-d49b-48df-9c08-a3417dd347d3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", "annihilation", " ", "operators", " ", "c_e", " ", 
     RowBox[{"(", 
      RowBox[{"e", " ", "=", " ", 
       RowBox[{
        RowBox[{"1", ".."}], "8"}]}], ")"}], " ", "of", " ", "the", " ", 
     "eight", " ", "components", " ", "and", " ", "their", " ", "adjoints"}], 
    ",", " ", 
    RowBox[{"256", " ", "x", " ", "256", " ", "sparse", " ", "matrices"}]}], 
   " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"cOps", " ", "=", " ", 
     RowBox[{"fockOps", "[", "8", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"cdOps", " ", "=", " ", 
     RowBox[{"ConjugateTranspose", " ", "/@", " ", "cOps"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"bilinear", "[", "a", "]"}], ":", " ", 
     RowBox[{"sum_ij", " ", "a_ij", " ", 
      RowBox[{"c_i", "^", "dag"}], " ", "c_j"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"bilinear", "[", "a_", "]"}], " ", ":=", " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"a", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", " ", "j"}], "]"}], "]"}], " ", "=!=", " ", 
          "0"}], ",", " ", 
         RowBox[{
          RowBox[{"a", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", " ", "j"}], "]"}], "]"}], " ", 
          RowBox[{
           RowBox[{"cdOps", "[", 
            RowBox[{"[", "i", "]"}], "]"}], " ", ".", " ", 
           RowBox[{"cOps", "[", 
            RowBox[{"[", "j", "]"}], "]"}]}]}], ",", " ", "0"}], "]"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "8"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "8"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"quartic", "[", 
      RowBox[{"a", ",", " ", "b"}], "]"}], ":", " ", 
     RowBox[{
      RowBox[{"the", " ", "normal"}], "-", 
      RowBox[{
      "ordered", " ", "product", " ", "sum_ijkl", " ", "a_ij", " ", "b_kl", " ", 
       RowBox[{"c_i", "^", "dag"}], " ", 
       RowBox[{"c_k", "^", "dag"}], " ", "c_l", " ", "c_j"}]}]}], " ", "*)"}],
    "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"quartic", "[", 
      RowBox[{"a_", ",", " ", "b_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"a", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", " ", "j"}], "]"}], "]"}], " ", "=!=", " ", 
           "0"}], " ", "&&", " ", 
          RowBox[{
           RowBox[{"b", "[", 
            RowBox[{"[", 
             RowBox[{"k", ",", " ", "l"}], "]"}], "]"}], " ", "=!=", " ", 
           "0"}]}], ",", " ", 
         RowBox[{
          RowBox[{"a", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", " ", "j"}], "]"}], "]"}], " ", 
          RowBox[{"b", "[", 
           RowBox[{"[", 
            RowBox[{"k", ",", " ", "l"}], "]"}], "]"}], " ", 
          RowBox[{
           RowBox[{"cdOps", "[", 
            RowBox[{"[", "i", "]"}], "]"}], " ", ".", " ", 
           RowBox[{"cdOps", "[", 
            RowBox[{"[", "k", "]"}], "]"}], " ", ".", " ", 
           RowBox[{"cOps", "[", 
            RowBox[{"[", "l", "]"}], "]"}], " ", ".", " ", 
           RowBox[{"cOps", "[", 
            RowBox[{"[", "j", "]"}], "]"}]}]}], ",", " ", "0"}], "]"}], ",", 
       "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "8"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "8"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", "8"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"l", ",", " ", "8"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"gScal", ",", " ", "gVec", ",", " ", 
     RowBox[{"gPair", ":", " ", 
      RowBox[{
      "the", " ", "exact", " ", "couplings", " ", "of", " ", "the", " ", 
       "test"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"gScal", ",", " ", "gVec", ",", " ", "gPair"}], "}"}], " ", "=",
      " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "8"}], ",", " ", 
       RowBox[{"4", "/", "5"}], ",", " ", 
       RowBox[{"45", "/", "2"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"beta8", " ", "=", " ", 
     RowBox[{"d8", "[", "betaLL", "]"}]}], ";", " ", 
    RowBox[{"alpha8", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"d8", "[", 
        RowBox[{"alphaLL", "[", "j", "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"hS", " ", "=", " ", 
     RowBox[{
      RowBox[{"gScal", "/", "2"}], " ", 
      RowBox[{"quartic", "[", 
       RowBox[{"beta8", ",", " ", "beta8"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"hV", " ", "=", " ", 
     RowBox[{
      RowBox[{"gVec", "/", "2"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"quartic", "[", 
         RowBox[{
          RowBox[{"IdentityMatrix", "[", "8", "]"}], ",", " ", 
          RowBox[{"IdentityMatrix", "[", "8", "]"}]}], "]"}], " ", "-", " ", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{"quartic", "[", 
           RowBox[{
            RowBox[{"alpha8", "[", 
             RowBox[{"[", "j", "]"}], "]"}], ",", " ", 
            RowBox[{"alpha8", "[", 
             RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}], ")"}]}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", "pair", " ", "operators", " ", 
      RowBox[{"Pi", "^", "iota"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{
      "sum_ij", " ", "K_ij", " ", "c_i", " ", "c_j", " ", "and", " ", "the", " ",
        "pairing", " ", "Hamiltonian"}], " ", "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"G", "/", "4"}], ")"}], " ", "sum", " ", 
       RowBox[{"Pi", "^", "dag"}], " ", "Pi"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"piOps", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"k", " ", "=", " ", 
           RowBox[{"kLL", "[", "iota", "]"}]}], "}"}], ",", " ", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"k", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", " ", "j"}], "]"}], "]"}], " ", "=!=", " ", 
              "0"}], ",", " ", 
             RowBox[{
              RowBox[{"k", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", " ", "j"}], "]"}], "]"}], " ", 
              RowBox[{
               RowBox[{"cOps", "[", 
                RowBox[{"[", "i", "]"}], "]"}], " ", ".", " ", 
               RowBox[{"cOps", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}]}], ",", " ", "0"}], "]"}], ",",
            " ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "8"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"j", ",", " ", "8"}], "}"}]}], "]"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"iota", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"hP", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "gPair"}], "/", "4"}], " ", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ConjugateTranspose", "[", 
          RowBox[{"piOps", "[", 
           RowBox[{"[", "k", "]"}], "]"}], "]"}], " ", ".", " ", 
         RowBox[{"piOps", "[", 
          RowBox[{"[", "k", "]"}], "]"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nBeta", " ", "=", " ", 
     RowBox[{"bilinear", "[", "beta8", "]"}]}], ";", " ", 
    RowBox[{"nOne", " ", "=", " ", 
     RowBox[{"bilinear", "[", 
      RowBox[{"IdentityMatrix", "[", "8", "]"}], "]"}]}], ";", " ", 
    RowBox[{"nAlpha", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"bilinear", "[", 
        RowBox[{"alpha8", "[", 
         RowBox[{"[", "j", "]"}], "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"lin", "[", "v", "]"}], " ", "=", " ", 
     RowBox[{"sum_b", " ", "v_b", " ", "c_b"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"lin", "[", "v_", "]"}], " ", ":=", " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"v", "[", 
         RowBox[{"[", "b", "]"}], "]"}], " ", 
        RowBox[{"cOps", "[", 
         RowBox[{"[", "b", "]"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"b", ",", " ", "8"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dE2", ",", " ", "dE3", ",", " ", "dE4"}], "}"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", "\n", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"dE2", " ", "=", " ", 
        RowBox[{"Max", "[", 
         RowBox[{"dE2", ",", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{"Normal", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"cOps", "[", 
                RowBox[{"[", "e", "]"}], "]"}], " ", ".", " ", "hS"}], " ", "-",
               " ", 
              RowBox[{"hS", " ", ".", " ", 
               RowBox[{"cOps", "[", 
                RowBox[{"[", "e", "]"}], "]"}]}], " ", "-", " ", 
              RowBox[{"gScal", " ", 
               RowBox[{"nBeta", " ", ".", " ", 
                RowBox[{"lin", "[", 
                 RowBox[{"beta8", "[", 
                  RowBox[{"[", "e", "]"}], "]"}], "]"}]}]}]}], "]"}], "]"}], 
           "]"}]}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"dE3", " ", "=", " ", 
        RowBox[{"Max", "[", 
         RowBox[{"dE3", ",", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{"Normal", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"cOps", "[", 
                RowBox[{"[", "e", "]"}], "]"}], " ", ".", " ", "hV"}], " ", "-",
               " ", 
              RowBox[{"hV", " ", ".", " ", 
               RowBox[{"cOps", "[", 
                RowBox[{"[", "e", "]"}], "]"}]}], " ", "-", " ", 
              RowBox[{"gVec", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"nOne", " ", ".", " ", 
                  RowBox[{"cOps", "[", 
                   RowBox[{"[", "e", "]"}], "]"}]}], " ", "-", " ", 
                 RowBox[{"Sum", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"nAlpha", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], " ", ".", " ", 
                    RowBox[{"lin", "[", 
                    RowBox[{"alpha8", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", ",", " ", "e"}], "]"}], "]"}], "]"}]}], ",", 
                   " ", 
                   RowBox[{"{", 
                    RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}], ")"}]}]}],
              "]"}], "]"}], "]"}]}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"dE4", " ", "=", " ", 
        RowBox[{"Max", "[", 
         RowBox[{"dE4", ",", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{"Normal", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"cOps", "[", 
                RowBox[{"[", "e", "]"}], "]"}], " ", ".", " ", "hP"}], " ", "-",
               " ", 
              RowBox[{"hP", " ", ".", " ", 
               RowBox[{"cOps", "[", 
                RowBox[{"[", "e", "]"}], "]"}]}], " ", "+", " ", 
              RowBox[{
               RowBox[{"gPair", "/", "2"}], " ", 
               RowBox[{"Sum", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Sum", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Conjugate", "[", 
                    RowBox[{
                    RowBox[{"kLL", "[", "k", "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"a", ",", " ", "e"}], "]"}], "]"}], "]"}], " ", 
                    RowBox[{"cdOps", "[", 
                    RowBox[{"[", "a", "]"}], "]"}]}], ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"a", ",", " ", "8"}], "}"}]}], "]"}], " ", ".", 
                  " ", 
                  RowBox[{"piOps", "[", 
                   RowBox[{"[", "k", "]"}], "]"}]}], ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}]}]}], "]"}], 
            "]"}], "]"}]}], "]"}]}]}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"e", ",", " ", "8"}], "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WE-2\>\"", ",", 
      " ", "\"\<scalar contact term: [Psi_e, H_S] = G^S (Psi-bar Psi)(gamma^0 \
Psi)_e (exact, 256 states)\>\"", ",", " ", "dE2", ",", " ", "0", ",", 
      " ", "\"\<E-2\>\"", ",", " ", "\"\<E-2\>\""}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WE-3\>\"", ",", 
      " ", "\"\<vector contact term (exact, 256 states)\>\"", ",", " ", "dE3",
       ",", " ", "0", ",", " ", "\"\<E-3\>\"", ",", " ", "\"\<E-3\>\""}], 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WE-4\>\"", ",", 
      " ", "\"\<pairing term: [Psi_e, H_P] = -(G/2) sum (K^dag Psi^*)_e Pi \
(exact, 256 states)\>\"", ",", " ", "dE4", ",", " ", "0", ",", 
      " ", "\"\<E-4\>\"", ",", " ", "\"\<E-4\>\""}], "]"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"E", "-", "14"}], ":", " ", 
       RowBox[{
        RowBox[{"the", " ", "Euler"}], "-", 
        RowBox[{"Lagrange", " ", "equations", " ", "of", " ", "L"}]}]}], " ", 
      "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{"1", "/", "4"}], ")"}]}], " ", 
        RowBox[{"W", "^", "a_pq"}], " ", 
        RowBox[{"W", "^", 
         RowBox[{"(", 
          RowBox[{"a", ",", "pq"}], ")"}]}]}], " ", "-", " ", 
       RowBox[{"g", " ", 
        RowBox[{"W", "^", "a_p"}], " ", 
        RowBox[{"j", "^", 
         RowBox[{"(", 
          RowBox[{"a", ",", "p"}], ")"}]}]}]}]}], ",", " ", 
     RowBox[{"derived", " ", "symbolically"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"Needs", "[", "\"\<VariationalMethods`\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Clear", "[", "gYM", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"etaD", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", 
       RowBox[{"-", "1"}], ",", " ", 
       RowBox[{"-", "1"}], ",", " ", 
       RowBox[{"-", "1"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"wF", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"ToExpression", "[", 
         RowBox[{"\"\<wf\>\"", " ", "<>", " ", 
          RowBox[{"ToString", "[", "a", "]"}], " ", "<>", " ", 
          RowBox[{"ToString", "[", "p", "]"}]}], "]"}], "[", 
        RowBox[{"x0", ",", " ", "x1", ",", " ", "x2", ",", " ", "x3"}], "]"}],
        ",", " ", 
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"jF", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"ToExpression", "[", 
         RowBox[{"\"\<jf\>\"", " ", "<>", " ", 
          RowBox[{"ToString", "[", "a", "]"}], " ", "<>", " ", 
          RowBox[{"ToString", "[", "p", "]"}]}], "]"}], "[", 
        RowBox[{"x0", ",", " ", "x1", ",", " ", "x2", ",", " ", "x3"}], "]"}],
        ",", " ", 
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"fYM", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"wF", "[", 
           RowBox[{"[", 
            RowBox[{"a", ",", " ", "q"}], "]"}], "]"}], ",", " ", 
          RowBox[{"xs", "[", 
           RowBox[{"[", "p", "]"}], "]"}]}], "]"}], " ", "-", " ", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"wF", "[", 
           RowBox[{"[", 
            RowBox[{"a", ",", " ", "p"}], "]"}], "]"}], ",", " ", 
          RowBox[{"xs", "[", 
           RowBox[{"[", "q", "]"}], "]"}]}], "]"}], " ", "-", " ", 
        RowBox[{"gYM", " ", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"levi", "[", 
             RowBox[{"a", ",", " ", "b", ",", " ", "c"}], "]"}], " ", 
            RowBox[{"wF", "[", 
             RowBox[{"[", 
              RowBox[{"b", ",", " ", "p"}], "]"}], "]"}], " ", 
            RowBox[{"wF", "[", 
             RowBox[{"[", 
              RowBox[{"c", ",", " ", "q"}], "]"}], "]"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"b", ",", " ", "3"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"c", ",", " ", "3"}], "}"}]}], "]"}]}]}], ",", "\n", 
       "   ", 
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"p", ",", " ", "4"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"q", ",", " ", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"lYM", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", "1"}], "/", "4"}], " ", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"etaD", "[", 
           RowBox[{"[", "p", "]"}], "]"}], " ", 
          RowBox[{"etaD", "[", 
           RowBox[{"[", "q", "]"}], "]"}], " ", 
          RowBox[{
           RowBox[{"fYM", "[", 
            RowBox[{"[", 
             RowBox[{"a", ",", " ", "p", ",", " ", "q"}], "]"}], "]"}], "^", 
           "2"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"a", ",", " ", "3"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"p", ",", " ", "4"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"q", ",", " ", "4"}], "}"}]}], "]"}]}], " ", "-", " ", 
      RowBox[{"gYM", " ", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"wF", "[", 
           RowBox[{"[", 
            RowBox[{"a", ",", " ", "p"}], "]"}], "]"}], " ", 
          RowBox[{"jF", "[", 
           RowBox[{"[", 
            RowBox[{"a", ",", " ", "p"}], "]"}], "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"a", ",", " ", "3"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"p", ",", " ", "4"}], "}"}]}], "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"eqsYM", " ", "=", " ", 
     RowBox[{"EulerEquations", "[", 
      RowBox[{"lYM", ",", " ", 
       RowBox[{"Flatten", "[", "wF", "]"}], ",", " ", "xs"}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"the", " ", "claimed", " ", 
     RowBox[{"form", ":", " ", 
      RowBox[{
       RowBox[{"sum_p", " ", "d_p", " ", 
        RowBox[{"F", "^", 
         RowBox[{"(", 
          RowBox[{"a", ",", 
           RowBox[{"p", " ", 
            RowBox[{"p", "'"}]}]}], ")"}]}]}], " ", "-", " ", 
       RowBox[{"g", " ", "sum", " ", "eps_abc", " ", 
        RowBox[{"W", "^", "b_p"}], " ", 
        RowBox[{"F", "^", 
         RowBox[{"(", 
          RowBox[{"c", ",", 
           RowBox[{"p", " ", 
            RowBox[{"p", "'"}]}]}], ")"}]}]}], " ", "-", " ", 
       RowBox[{"g", " ", 
        RowBox[{"J", "^", 
         RowBox[{"(", 
          RowBox[{"a", ",", 
           RowBox[{"p", "'"}]}], ")"}]}], " ", "must", " ", "equal", " ", 
        "lhs"}], " ", "-", " ", "rhs"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"fUp", "[", 
      RowBox[{"c_", ",", " ", "p_", ",", " ", "pp_"}], "]"}], " ", ":=", " ", 
     
     RowBox[{
      RowBox[{"etaD", "[", 
       RowBox[{"[", "p", "]"}], "]"}], " ", 
      RowBox[{"etaD", "[", 
       RowBox[{"[", "pp", "]"}], "]"}], " ", 
      RowBox[{"fYM", "[", 
       RowBox[{"[", 
        RowBox[{"c", ",", " ", "p", ",", " ", "pp"}], "]"}], "]"}]}]}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"claimedYM", " ", "=", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"fUp", "[", 
              RowBox[{"a", ",", " ", "p", ",", " ", "pp"}], "]"}], ",", " ", 
             RowBox[{"xs", "[", 
              RowBox[{"[", "p", "]"}], "]"}]}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"p", ",", " ", "4"}], "}"}]}], "]"}], " ", "-", " ", 
         RowBox[{"gYM", " ", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"levi", "[", 
              RowBox[{"a", ",", " ", "b", ",", " ", "c"}], "]"}], " ", 
             RowBox[{"wF", "[", 
              RowBox[{"[", 
               RowBox[{"b", ",", " ", "p"}], "]"}], "]"}], " ", 
             RowBox[{"fUp", "[", 
              RowBox[{"c", ",", " ", "p", ",", " ", "pp"}], "]"}]}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"b", ",", " ", "3"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"c", ",", " ", "3"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"p", ",", " ", "4"}], "}"}]}], "]"}]}], " ", "-", "\n", 
         "      ", 
         RowBox[{"gYM", " ", 
          RowBox[{"jF", "[", 
           RowBox[{"[", 
            RowBox[{"a", ",", " ", "pp"}], "]"}], "]"}]}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"a", ",", " ", "3"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"pp", ",", " ", "4"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
   
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
      "EulerEquations", " ", "writes", " ", "each", " ", "equation", " ", 
       "as", " ", "lhs"}], " ", "==", " ", "rhs"}], ";", " ", 
     RowBox[{"lhs", " ", "-", " ", 
      RowBox[{
      "rhs", " ", "is", " ", "compared", " ", "with", " ", "the", " ", 
       "claimed", " ", "form", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{
          "an", " ", "equation", " ", "is", " ", "the", " ", "same", "\n", 
           "   ", "equation", " ", "when", " ", "lhs"}], " ", "-", " ", 
          RowBox[{
          "rhs", " ", "equals", " ", "the", " ", "claimed", " ", "form", " ", 
           "or", " ", "its", " ", "negative"}]}], ";", " ", 
         RowBox[{
         "the", " ", "sign", " ", "that", " ", "occurred", " ", "is", " ", 
          "reported"}]}], ")"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"lhsYM", " ", "=", " ", 
     RowBox[{
      RowBox[{"eqsYM", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], " ", "-", " ", 
      RowBox[{"eqsYM", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"signYM", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Which", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Expand", "[", 
           RowBox[{
            RowBox[{"lhsYM", "[", 
             RowBox[{"[", "k", "]"}], "]"}], " ", "-", " ", 
            RowBox[{"claimedYM", "[", 
             RowBox[{"[", "k", "]"}], "]"}]}], "]"}], " ", "===", " ", "0"}], 
         ",", " ", "1", ",", " ", 
         RowBox[{
          RowBox[{"Expand", "[", 
           RowBox[{
            RowBox[{"lhsYM", "[", 
             RowBox[{"[", "k", "]"}], "]"}], " ", "+", " ", 
            RowBox[{"claimedYM", "[", 
             RowBox[{"[", "k", "]"}], "]"}]}], "]"}], " ", "===", " ", "0"}], 
         ",", " ", 
         RowBox[{"-", "1"}], ",", " ", "True", ",", " ", "0"}], "]"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", 
         RowBox[{"Length", "[", "lhsYM", "]"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"checkTrue", "[", 
     RowBox[{"\"\<WE-14\>\"", ",", 
      " ", "\"\<symbolic Euler-Lagrange equations of the Yang-Mills \
Lagrangian with the source: d_p W^(a,p p') - g eps_abc W^b_p W^(c,p p') = g \
j^(a,p') (12 components)\>\"", ",", "\n", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "eqsYM", "]"}], " ", "==", " ", "12"}], " ", "&&",
        " ", 
       RowBox[{"FreeQ", "[", 
        RowBox[{"signYM", ",", " ", "0"}], "]"}]}], ",", " ", 
      RowBox[{
       RowBox[{"ToString", "[", 
        RowBox[{"Count", "[", 
         RowBox[{"signYM", ",", " ", 
          RowBox[{"Except", "[", "0", "]"}]}], "]"}], "]"}], " ", "<>", 
       " ", "\"\< of 12 equations identical (EulerEquations; signs \>\"", " ",
        "<>", " ", 
       RowBox[{"ToString", "[", "signYM", "]"}], " ", "<>", 
       " ", "\"\<)\>\""}], ",", "\n", "  ", "\"\<E-14\>\"", ",", 
      " ", "\"\<E-14\>\""}], "]"}], ";"}]}]}]], "Input",
