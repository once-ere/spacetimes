Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"lfTags", ":", " ", 
    RowBox[{"the", " ", "five", " ", "methods", " ", 
     RowBox[{"(", 
      RowBox[{"the", " ", "tags", " ", "of", " ", "the", " ", "data"}], ")"}],
      " ", "and", " ", "their", " ", "printed", " ", "names"}]}], " ", "*)"}],
   "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"lfTags", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<HS_1_1\>\"", ",", " ", "\"\<HS_0_1\>\"", ",", 
       " ", "\"\<HS_0_0\>\"", ",", " ", "\"\<KS\>\"", ",", 
       " ", "\"\<CJT\>\""}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"lfName", " ", "=", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<HS_1_1\>\"", " ", "->", " ", "\"\<HS (1, 1)\>\""}], ",", 
       " ", 
       RowBox[{"\"\<HS_0_1\>\"", " ", "->", " ", "\"\<HS (0, 1)\>\""}], ",", 
       " ", 
       RowBox[{"\"\<HS_0_0\>\"", " ", "->", " ", "\"\<HS (0, 0)\>\""}], ",", 
       " ", 
       RowBox[{"\"\<KS\>\"", " ", "->", " ", "\"\<KS\>\""}], ",", " ", 
       RowBox[{"\"\<CJT\>\"", " ", "->", " ", "\"\<CJT\>\""}]}], "|>"}]}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"lfPhi0", "[", "t", "]"}], ":", " ", 
      RowBox[{"the", " ", "vacuum", " ", "field", " ", 
       RowBox[{"Phi", "^", "X_"}], "0"}]}], ",", 
     RowBox[{"SF", ";", " ", 
      RowBox[{
       RowBox[{"lfE0", "[", "t", "]"}], ":", " ", 
       RowBox[{
       "the", " ", "energy", " ", "per", " ", "volume", " ", "of", " ", "the",
         " ", "minimum", " ", 
        RowBox[{"(", 
         RowBox[{"minus", " ", "the", " ", "depth"}], ")"}]}]}]}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"lfPhi0", "[", "t_", "]"}], " ", ":=", " ", 
     RowBox[{"rustPart3", "[", 
      RowBox[{"\"\<p3_Phi0_\>\"", " ", "<>", " ", "t"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"lfE0", "[", "t_", "]"}], " ", ":=", " ", 
     RowBox[{"rustPart3", "[", 
      RowBox[{"\"\<p3_E0_\>\"", " ", "<>", " ", "t"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"lfCurve", "[", "t", "]"}], ":", " ", 
      RowBox[{
      "the", " ", "computed", " ", "polar", " ", "curve", " ", "as", " ", 
       "pairs", " ", 
       RowBox[{"{", 
        RowBox[{"Phi", ",", " ", "V"}], "}"}]}]}], ";", " ", 
     RowBox[{
      RowBox[{"lfFitted", "[", 
       RowBox[{"t", ",", " ", "top"}], "]"}], ":", " ", 
      RowBox[{
       RowBox[{"its", " ", "points", " ", "with", " ", "Phi"}], " ", "<=", 
       " ", 
       RowBox[{"top", " ", "Phi0"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"lfCurve", "[", "t_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"rustEffPot", "[", "t", "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"lfFitted", "[", 
      RowBox[{"t_", ",", " ", "top_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"lfCurve", "[", "t", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], " ", "<=", " ", 
         RowBox[{"top", " ", 
          RowBox[{"lfPhi0", "[", "t", "]"}], " ", 
          RowBox[{"(", 
           RowBox[{"1", " ", "+", " ", 
            RowBox[{"10", "^", 
             RowBox[{"-", "12"}]}]}], ")"}]}]}], " ", "&"}]}], "]"}]}], ";"}],
    "\n", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"lfName", "[", "t", "]"}], ",", " ", 
           RowBox[{"lfPhi0", "[", "t", "]"}], ",", " ", 
           RowBox[{"lfE0", "[", "t", "]"}], ",", " ", 
           RowBox[{"Length", "[", 
            RowBox[{"lfFitted", "[", 
             RowBox[{"t", ",", " ", "1.4"}], "]"}], "]"}], ",", " ", 
           RowBox[{
            RowBox[{"Max", "[", 
             RowBox[{
              RowBox[{"lfCurve", "[", "t", "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], "]"}], "/", 
            RowBox[{"lfPhi0", "[", "t", "]"}]}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"t", ",", " ", "lfTags"}], "}"}]}], "]"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<method\>\"", ",", " ", "\"\<Phi0\>\"", ",", 
         " ", "\"\<minimum of V (minus the depth)\>\"", ",", 
         " ", "\"\<points with Phi <= 1.4 Phi0\>\"", ",", 
         " ", "\"\<end of the curve / Phi0\>\""}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "All"}]}], "]"}]}]}]], "Input",
 CellLabel->
