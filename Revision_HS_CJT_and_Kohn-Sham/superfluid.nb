      " ", "\"\<local SL(2,C): gamma^p[f'] (d_p + Gamma'_p)(S psi) = S \
gamma^p d_p psi (symbolic derivatives)\>\"", ",", " ", "dC8", ",", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "9"}]}], ",", " ", "\"\<C-8\>\"", ",", 
      " ", "\"\<C-8\>\""}], "]"}], ";"}]}]}]], "Input",
 CellLabel->"In[92]:=",ExpressionUUID->"b3295a51-eb7e-44b7-8016-2a36c9a6f199"],

