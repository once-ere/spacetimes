Cell[TextData[{
 StyleBox["The Higgs mechanism.",
  FontWeight->"Bold"],
 " In every method the condensate gives the masses ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     RowBox[{
      StyleBox["W", "TI"], ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["f", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["I",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "855b8668-72e2-4950-beaa-e8ac1b0f1d0e"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     RowBox[{
      StyleBox["Z", "TI"], ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]], "\[LongEqual]", "2", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["f", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["F",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "201d36f5-82bd-4691-a9ee-871824120d52"],
 " to the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["W", "TI"], "\[PlusMinus]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2fa56aee-8d0f-4dab-ae36-252a86d0f8d8"],
 " and the ",
 Cell[BoxData[
  FormBox[
   StyleBox["Z", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a132ccde-ba0b-490b-bf58-b5393122cea1"],
 " of the superfluid, leaves exactly one gauge boson, the photon ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["W", "TI"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "709342ee-a4ae-4930-be24-6c11c536c13d"],
 ", massless, and turns the three Goldstone fields into the longitudinal \
parts of the massive bosons: the superfluid does what the Higgs field does."
}], "ItemNumbered",ExpressionUUID->"876ae6d2-ecbc-45c9-b07b-e9c6f3bb4251"],

Cell[TextData[{
 StyleBox["A neutral scalar particle.",
  FontWeight->"Bold"],
 " In every method the amplitude mode (charge 0) lies below the threshold of \
two quasi-particles, at 0.82 to 0.90 of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    SubsuperscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["gap",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "afa9271e-e7ca-4779-9395-e2b91dd2fbaa"],
 ": a bound state of the mean-field dynamics."
}], "ItemNumbered",ExpressionUUID->"71df2ba4-8c91-499d-b712-88d62a7938fe"],

Cell[TextData[{
 StyleBox["Its mass against the scale of the breaking.",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["H",
       FontSlant->"Plain"]}]], "/", 
    SubsuperscriptBox[
     StyleBox["v", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3979979e-95c0-4ace-9983-80f0d7ca8a21"],
 " is 4.46 to 5.69, 8.8 to 11.2 times the value 0.5085 of the Standard Model; \
",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Lambda]", 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["H",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "95ea345f-83e8-408d-b2df-771be6c19193"],
 " is 9.9 to 16.2, beyond the bound ",
 Cell[BoxData[
  FormBox[
   RowBox[{"8", "\[Pi]", "/", "3", "\[LongEqual]", "8.38"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "61c09788-14e4-4c2b-a0f1-a35408101b17"],
 " that perturbative unitarity of the scattering of longitudinal gauge bosons \
sets at tree level (B. W. Lee, C. Quigg and H. B. Thacker 1977). On the scale \
on which ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["v", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], "\[LongEqual]", "246.22"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "345f7763-3443-4633-928d-3d75eca8c7bd"],
 " GeV the amplitude mode has the mass 1.10 to 1.40 TeV."
}], "ItemNumbered",ExpressionUUID->"843e7f1d-7748-42f1-9f30-3ce2c5c28bf7"],

Cell[TextData[{
 StyleBox["Its width.",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalGamma]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["H",
       FontSlant->"Plain"]}]], "/", 
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["H",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "83af7d1d-c860-4791-aad7-87ff51d88fca"],
 " is 2.1 to 3.9: once the decays into Goldstone fields are allowed, the \
amplitude mode is a broad resonance, not a particle. The Higgs boson has ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalGamma]", 
     StyleBox["H", "TI"]], "/", 
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["H", "TI"]], "\[TildeTilde]", "3", "\[Times]", 
    SuperscriptBox["10", 
     RowBox[{"-", "5"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "385c08fa-dea3-46b2-9085-5899395f87a9"],
 "."
}], "ItemNumbered",ExpressionUUID->"cfd82c59-29e9-49fe-a615-ede27d84ffa3"],

Cell[TextData[{
 StyleBox["No further scalars.",
  FontWeight->"Bold"],
 " Every method has the non-unitary doublet, two scalars of charge ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0f5ec457-f60d-48b5-87e4-449cfadfa5de"],
 " at 0.99 to 1.09 times ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["M", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["H",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0e9c5836-20ce-41b8-8c14-d8d44cf4c2a2"],
 ". The Standard Model has none."
}], "ItemNumbered",ExpressionUUID->"46bd18ab-4ec0-4693-b007-7dd94208e173"],

Cell[TextData[{
 StyleBox["The quantum numbers.",
  FontWeight->"Bold"],
 " The condensate is an isospin vector of fermion number 2 of the vector-like \
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["v",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e42fea66-df48-45c7-a34e-4cd13e586d25"],
 "; the Higgs field of the Standard Model is a doublet of hypercharge ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fe06772f-e7ad-41fe-81f7-9a81a02ecb15"],
 " of the chiral ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["L", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5ef463c4-28ef-4cd3-b16f-b79a88a564e1"],
 ". Here the photon is ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["W", "TI"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "444b3e06-c5ec-4df5-aa17-c48ce9d64430"],
 " (no mixing angle), the ",
 Cell[BoxData[
  FormBox[
   StyleBox["Z", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "94c64882-7850-4fc2-8f9f-d1f95e785c04"],
 " is the gauge boson of the fermion number, and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     RowBox[{
      StyleBox["W", "TI"], ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]], "/", 
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     RowBox[{
      StyleBox["Z", "TI"], ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "eb520fc0-dd36-4a1d-87bc-dd9e5c50da91"],
 " depends on two independent couplings, with no relation like ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["W", "TI"]], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["Z", "TI"]], "\[ThinSpace]", 
    StyleBox["cos",
     FontSlant->"Plain"], "\[ThinSpace]", 
    SubscriptBox["\[Theta]", 
     StyleBox["W", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fd740547-7e5c-4179-b448-68349527cd72"],
 " of the custodial symmetry. The masses of the spinor field do not come from \
the condensate as Yukawa masses: the condensate adds a pairing gap to a Dirac \
mass that the vector-like theory allows without it."
}], "ItemNumbered",ExpressionUUID->"f711b760-fefb-45b9-8bac-128d705ae1bd"],

Cell[TextData[{
 StyleBox["The thermal history.",
  FontWeight->"Bold"],
 " The transition of the superfluid lies deep in its own critical region \
(Section III.G.7); its mean-field temperature, 1.6 to 1.8 times ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["v", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6e3c6206-9e0c-4685-83e2-30946bb066af"],
 ", is not reliable. The Standard Model has a smooth crossover at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"159.5", "\[PlusMinus]", "1.5"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6b920773-76b6-4809-9afd-a14e1545b95b"],
 " GeV (M. D'Onofrio and K. Rummukainen 2016), not a phase transition."
}], "ItemNumbered",ExpressionUUID->"d4ce6895-0336-402b-8d20-aa23136e6768"],

Cell[TextData[{
 StyleBox["The verdict.",
  FontWeight->"Bold"],
 " In every method the superfluid realizes the Higgs mechanism, with the \
massless photon and the longitudinal gauge bosons, and has a Higgs-like \
neutral scalar. In no method can its amplitude mode be the Higgs boson that \
is observed: it is 9 to 11 times too heavy against the scale of the breaking, \
strongly coupled, broad, accompanied by charged scalars of about the same \
mass, and attached to a different symmetry. The methods differ in degree, not \
in kind: CJT and KS come closest, HS ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"1", ",", "1"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6760ef48-c32c-4eae-9894-ed91bd8df27a"],
 " is farthest. ",
 StyleBox["Is the Higgs a composite particle?",
  FontWeight->"Bold"],
 " In this model, yes, in every method: the field ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[CapitalPhi]", "\[RightVector]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bf209449-cefc-4736-9dca-196a17685066"],
 " is not a field of the Lagrangian, whose only matter field is the spinor \
field. It is the amplitude of the pair self-energy, a composite of two spinor \
charges; its kinetic part has no term of its own and is generated entirely by \
the spinor field (",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["Z", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4ca17881-d050-4a31-b342-fe0cddf25dce"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["Y", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c3b859eb-d22b-48b7-a649-f4c88a1b4793"],
 " are susceptibilities of the spinor field); and its amplitude mode is a \
bound state of two quasi-particles below their threshold. This is the \
compositeness condition of W. A. Bardeen, C. T. Hill and M. Lindner (1990): \
the normalization of the composite field vanishes at the cutoff, where only \
the spinor field exists. The same structure explains why the composite is \
heavy: in the dynamics of Y. Nambu and G. Jona-Lasinio (1961) the mass of the \
bound state is tied to the gap of the spinor charges, while the scale of the \
breaking comes from a loop of the spinor field and is small against the gap. \
A light composite needs a large ratio of the cutoff to the gap, or a \
different mechanism, for example a Higgs boson that is itself a \
pseudo-Goldstone boson of a larger broken symmetry (D. B. Kaplan and H. \
Georgi 1984). Whether the Higgs boson of nature is composite is not decided \
here: its measured couplings agree with those of an elementary Higgs field at \
the level of several per cent, which constrains, but does not exclude, \
compositeness at a higher scale. What this chapter shows is that the \
composite Higgs of the five mean-field methods of this model, with its cutoff \
of the order of the scale of the breaking, is not that boson."
}], "Text",ExpressionUUID->"e7a28377-5b33-4bb5-902f-59218d7148ca"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["The list of all checks", "Chapter",ExpressionUUID->"d3907bde-e5d8-4a18-aaa1-966fbc40a7fe"],

Cell["\<\
The last cell lists every check of this notebook with its result and its \
counterparts in the Rust and the Python programs, and counts the checks that \
passed.\
\>", "Text",ExpressionUUID->"9a799657-fb60-4826-b98b-65035b10b3a6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", "table", " ", "of", " ", "all", " ", 
     RowBox[{"checks", ":", " ", "identifier"}]}], ",", " ", "result", ",", 
    " ", "deviation", ",", " ", "tolerance", ",", " ", "counterparts"}], " ", 
   "*)"}], "\n", 
  RowBox[{"Grid", "[", 
   RowBox[{
    RowBox[{"Prepend", "[", 
     RowBox[{
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"#", "[", "\"\<id\>\"", "]"}], ",", " ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"#", "[", "\"\<pass\>\"", "]"}], ",", " ", "\"\<PASS\>\"",
              ",", " ", "\"\<FAIL\>\""}], "]"}], ",", " ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"NumericQ", "[", 
              RowBox[{"#", "[", "\"\<deviation\>\"", "]"}], "]"}], ",", " ", 
             RowBox[{"sci", "[", 
              RowBox[{"#", "[", "\"\<deviation\>\"", "]"}], "]"}], ",", 
             " ", "\"\<--\>\""}], "]"}], ",", "\n", "      ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"NumericQ", "[", 
              RowBox[{"#", "[", "\"\<tolerance\>\"", "]"}], "]"}], ",", " ", 
             RowBox[{"sci", "[", 
              RowBox[{"#", "[", "\"\<tolerance\>\"", "]"}], "]"}], ",", 
             " ", "\"\<--\>\""}], "]"}], ",", " ", 
           RowBox[{"#", "[", "\"\<rust\>\"", "]"}], ",", " ", 
           RowBox[{"#", "[", "\"\<python\>\"", "]"}]}], "}"}], " ", "&"}], ",",
         " ", "SFNB`Test`$Results"}], "]"}], ",", "\n", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"#", ",", " ", "Bold"}], "]"}], " ", "&"}], " ", "/@", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<check\>\"", ",", " ", "\"\<result\>\"", ",", 
         " ", "\"\<deviation\>\"", ",", " ", "\"\<tolerance\>\"", ",", 
         " ", "\"\<Rust\>\"", ",", " ", "\"\<Python\>\""}], "}"}]}]}], "]"}], 
    ",", "\n", "  ", 
    RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
    RowBox[{"Alignment", " ", "->", " ", "Left"}], ",", " ", 
    RowBox[{"BaseStyle", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"FontSize", " ", "->", " ", "9"}], "}"}]}]}], "]"}]}]], "Input",\

 CellLabel->
  "In[406]:=",ExpressionUUID->"b7a05281-8eac-4482-8c5f-5fb58c664854"],

