Cell[CellGroupData[{

Cell["III.L.4 The fit and its residual", "Section",ExpressionUUID->"d88a8410-6228-4a41-8b35-05c552912af6"],

Cell[TextData[{
 StyleBox["\"The Landau form is a fit.\"",
  FontWeight->"Bold"],
 " The coefficients ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "37837e2b-a93d-4707-b6ee-db2f4be6a90c"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["b", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "41dd7e68-f150-419c-8d74-efd974a8ae24"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f0423b8c-9e1e-4cf8-bf05-0e77cf7b82ad"],
 " are not derived from the theory: they minimize the sum of the squares of \
the residuals ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["\[ScriptCapitalV]",
      FontSlant->"Plain"], 
     StyleBox["L",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubscriptBox["\[CapitalPhi]", 
      StyleBox["i", "TI"]], ")"}], "-", 
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalV]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], 
    RowBox[{"(", 
     SubscriptBox["\[CapitalPhi]", 
      StyleBox["i", "TI"]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0c57419d-3527-4116-bc58-bc8f3f230ff9"],
 " over the computed points ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPhi]", 
     StyleBox["i", "TI"]], "\[LessEqual]", "1.4", 
    SubsuperscriptBox["\[CapitalPhi]", 
     RowBox[{"0", ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "584e30b7-ae94-4c9c-a0da-4644da1a9657"],
 ". ",
 StyleBox["\"Its largest residual is 0.27-0.7 % of the depth.\"",
  FontWeight->"Bold"],
 " The largest of these residuals, divided by the depth, lies between these \
two numbers for the five methods. The next cell defines the least squares \
(the function ",
 StyleBox["LeastSquares",
  FontFamily->"Source Code Pro"],
 " of the Wolfram Language on the columns ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["t", "TI"], 
    StyleBox["k", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "62185a5a-708f-471b-82e6-38c9749a3a19"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["t", "TI"], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"\[CapitalPhi]", "/", 
       SubscriptBox["\[CapitalPhi]", 
        StyleBox["max",
         FontSlant->"Plain"]]}], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cb195c2d-975d-4f48-b5f2-c6bbd22a8a7b"],
 ", which keeps the fits with many powers well conditioned) and computes, for \
each method: the minimum ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPhi]", 
    StyleBox["L",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "97737fa8-b3d3-4abc-8095-8deac0052680"],
 " of the fitted polynomial, its value and its second derivative there; the \
largest residual of the fits ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["k", "TI"], "\[LongEqual]", "1"}], 
     StyleBox["K", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["c", "TI"], 
     StyleBox["k", "TI"]], 
    SuperscriptBox["\[CapitalPhi]", 
     RowBox[{"2", 
      StyleBox["k", "TI"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2640aadb-b148-4846-a8cb-5a09c632109f"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["K", "TI"], "\[LongEqual]", "2"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bfd218c1-9f84-41e7-8a5a-ecfc10f75c44"],
 " (the quartic form of the Standard Model) to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["K", "TI"], "\[LongEqual]", "6"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c7583b1e-fab2-4090-bf22-253e3eed5634"],
 " (powers to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CapitalPhi]", "12"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dbd92780-71dc-489f-874b-88fe3bb9495c"],
 "); the number of sign changes of the residual of the Landau form; and the \
Landau form fitted on three intervals, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"0", ",", 
     SubsuperscriptBox["\[CapitalPhi]", 
      RowBox[{"0", ",", 
       StyleBox["SF",
        FontSlant->"Plain"]}], 
      StyleBox["X", "TI"]]}], "]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2a75000f-5ee9-426b-8f64-e94c7639647c"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"0", ",", "1.4", 
     SubsuperscriptBox["\[CapitalPhi]", 
      RowBox[{"0", ",", 
       StyleBox["SF",
        FontSlant->"Plain"]}], 
      StyleBox["X", "TI"]]}], "]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7c6843c4-2eab-4b85-9055-15905a1d08a1"],
 " and the whole curve. Every number is compared with that of the Rust \
program, which computes it with Householder reflections; the Python program \
computes it a third time with the singular-value decomposition."
}], "Text",ExpressionUUID->"7ffa4267-46d3-44cd-b089-98b190151758"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"evenFit", "[", 
        RowBox[{"pts", ",", " ", "kk"}], "]"}], ":", " ", 
       RowBox[{
        RowBox[{"the", " ", "least"}], "-", 
        RowBox[{"squares", " ", "fit", " ", "V"}]}]}], " ", "=", " ", 
      RowBox[{"sum_", 
       RowBox[{"{", 
        RowBox[{"k", "=", 
         RowBox[{
          RowBox[{"1", ".."}], "kk"}]}], "}"}], " ", "c_k", " ", 
       RowBox[{"Phi", "^", 
        RowBox[{"(", 
         RowBox[{"2", "k"}], ")"}]}], " ", "to", " ", "the", " ", "points", " ", 
       RowBox[{"{", 
        RowBox[{"Phi", ",", " ", "V"}], "}"}]}]}], ";", " ", 
     RowBox[{"returns", " ", "the", "\n", "   ", "coefficients", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"c_", "1"}], ",", " ", "...", ",", " ", "c_kk"}], "}"}]}]}], ",",
     " ", 
    RowBox[{
    "the", " ", "largest", " ", "residual", " ", "and", " ", "the", " ", 
     "list", " ", "of", " ", "the", " ", "residuals", " ", 
     RowBox[{"(", 
      RowBox[{"fit", " ", "minus", " ", "computed", " ", "value"}], ")"}]}]}],
    " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"evenFit", "[", 
      RowBox[{"pts_", ",", " ", "kk_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", " ", "=", " ", 
          RowBox[{"pts", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], ",", " ", 
         RowBox[{"y", " ", "=", " ", 
          RowBox[{"pts", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], ",", " ", "xm", ",",
          " ", "a", ",", " ", "d", ",", " ", "c", ",", " ", "r"}], "}"}], ",",
        "\n", "   ", 
       RowBox[{
        RowBox[{"xm", " ", "=", " ", 
         RowBox[{"Max", "[", "x", "]"}]}], ";", "\n", "   ", 
        RowBox[{"a", " ", "=", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"xi", "/", "xm"}], ")"}], "^", 
            RowBox[{"(", 
             RowBox[{"2", " ", "k"}], ")"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"xi", ",", " ", "x"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"k", ",", " ", "kk"}], "}"}]}], "]"}]}], ";", "        ", 
        
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{"the", " ", "columns", " ", 
           RowBox[{"t", "^", "k"}], " ", "with", " ", "t"}], " ", "=", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"Phi", "/", "Phi_max"}], ")"}], "^", "2"}]}], " ", "*)"}],
         "\n", "   ", 
        RowBox[{"d", " ", "=", " ", 
         RowBox[{"LeastSquares", "[", 
          RowBox[{"a", ",", " ", "y"}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"c", " ", "=", " ", 
         RowBox[{"d", "/", 
          RowBox[{"xm", "^", 
           RowBox[{"(", 
            RowBox[{"2", " ", 
             RowBox[{"Range", "[", "kk", "]"}]}], ")"}]}]}]}], ";", 
        "                            ", 
        RowBox[{"(*", " ", 
         RowBox[{
         "back", " ", "to", " ", "the", " ", "coefficients", " ", "of", " ", 
          RowBox[{"Phi", "^", 
           RowBox[{"(", 
            RowBox[{"2", "k"}], ")"}]}]}], " ", "*)"}], "\n", "   ", 
        RowBox[{"r", " ", "=", " ", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"c", "[", 
                RowBox[{"[", "k", "]"}], "]"}], " ", 
               RowBox[{"xi", "^", 
                RowBox[{"(", 
                 RowBox[{"2", " ", "k"}], ")"}]}]}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"k", ",", " ", "kk"}], "}"}]}], "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"xi", ",", " ", "x"}], "}"}]}], "]"}], " ", "-", " ", 
          "y"}]}], ";", "\n", "   ", 
        RowBox[{"{", 
         RowBox[{"c", ",", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", "r", "]"}], "]"}], ",", " ", "r"}], "}"}]}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"landauMin", "[", 
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "b", ",", " ", "c"}], "}"}], "]"}], ":", " ", 
      RowBox[{
       RowBox[{"the", " ", "minimum", " ", "Phi_L"}], " ", ">", " ", 
       RowBox[{
        RowBox[{"0", " ", "of", " ", "a", " ", 
         RowBox[{"Phi", "^", "2"}]}], " ", "+", " ", 
        RowBox[{"b", " ", 
         RowBox[{"Phi", "^", "4"}]}], " ", "+", " ", 
        RowBox[{"c", " ", 
         RowBox[{"Phi", "^", "6"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"the", " ", "positive", " ", "root", " ", "s"}], " ", "=", 
           " ", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Phi", "^", "2"}], " ", "of", "\n", "   ", "a"}], " ", "+",
              " ", 
             RowBox[{"2", " ", "b", " ", "s"}], " ", "+", " ", 
             RowBox[{"3", " ", "c", " ", 
              RowBox[{"s", "^", "2"}]}]}], " ", "=", " ", "0"}]}], 
          ")"}]}]}]}]}], ",", " ", 
     RowBox[{
      RowBox[{
      "the", " ", "value", " ", "of", " ", "the", " ", "polynomial", " ", 
       "there", " ", "and", " ", "its", " ", "second", " ", "derivative", " ",
        "2", " ", "a"}], " ", "+", " ", 
      RowBox[{"12", " ", "b", " ", 
       RowBox[{"Phi", "^", "2"}]}], " ", "+", " ", 
      RowBox[{"30", " ", "c", " ", 
       RowBox[{"Phi", "^", "4"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"landauMin", "[", 
      RowBox[{"{", 
       RowBox[{"a_", ",", " ", "b_", ",", " ", "c_"}], "}"}], "]"}], " ", ":=",
      " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"s", " ", "=", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "2"}], " ", "b"}], " ", "+", " ", 
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{"4", " ", 
               RowBox[{"b", "^", "2"}]}], " ", "-", " ", 
              RowBox[{"12", " ", "a", " ", "c"}]}], "]"}]}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"6", " ", "c"}], ")"}]}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Sqrt", "[", "s", "]"}], ",", " ", 
         RowBox[{
          RowBox[{"a", " ", "s"}], " ", "+", " ", 
          RowBox[{"b", " ", 
           RowBox[{"s", "^", "2"}]}], " ", "+", " ", 
          RowBox[{"c", " ", 
           RowBox[{"s", "^", "3"}]}]}], ",", " ", 
         RowBox[{
          RowBox[{"2", " ", "a"}], " ", "+", " ", 
          RowBox[{"12", " ", "b", " ", "s"}], " ", "+", " ", 
          RowBox[{"30", " ", "c", " ", 
           RowBox[{"s", "^", "2"}]}]}]}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"lfResults", "[", "t", "]"}], ":", " ", 
     RowBox[{
     "all", " ", "numbers", " ", "of", " ", "the", " ", "accuracy", " ", "of",
       " ", "the", " ", "Landau", " ", "form", " ", "for", " ", "the", " ", 
      "method", " ", "t"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"lfResults", " ", "=", " ", 
     RowBox[{"Association", "[", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{"t", ",", " ", 
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"pts", " ", "=", " ", 
               RowBox[{"lfFitted", "[", 
                RowBox[{"t", ",", " ", "1.4"}], "]"}]}], ",", " ", "fits", ",",
               " ", "mn", ",", " ", "r6", ",", " ", "big", ",", " ", "signs", 
              ",", " ", "top3", ",", " ", "rng"}], "}"}], ",", "\n", "      ", 
            RowBox[{
             RowBox[{"fits", " ", "=", " ", 
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{"evenFit", "[", 
                 RowBox[{"pts", ",", " ", "kk"}], "]"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"kk", ",", " ", "2", ",", " ", "6"}], "}"}]}], 
               "]"}]}], ";", "        ", 
             RowBox[{"(*", " ", 
              RowBox[{
               RowBox[{"K", " ", "=", " ", "2"}], ",", " ", "...", ",", " ", 
               RowBox[{"6", ";", " ", 
                RowBox[{"K", " ", "=", " ", 
                 RowBox[{
                 "3", " ", "is", " ", "the", " ", "Landau", " ", 
                  "form"}]}]}]}], " ", "*)"}], "\n", "      ", 
             RowBox[{"mn", " ", "=", " ", 
              RowBox[{"landauMin", "[", 
               RowBox[{"fits", "[", 
                RowBox[{"[", 
                 RowBox[{"2", ",", " ", "1"}], "]"}], "]"}], "]"}]}], ";", 
             "\n", "      ", 
             RowBox[{"r6", " ", "=", " ", 
              RowBox[{"fits", "[", 
               RowBox[{"[", 
                RowBox[{"2", ",", " ", "3"}], "]"}], "]"}]}], ";", "\n", 
             "      ", 
             RowBox[{"big", " ", "=", " ", 
              RowBox[{"Select", "[", 
               RowBox[{"r6", ",", " ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Abs", "[", "#", "]"}], " ", ">", " ", 
                  RowBox[{
                   RowBox[{"10", "^", 
                    RowBox[{"-", "3"}]}], " ", 
                   RowBox[{"Max", "[", 
                    RowBox[{"Abs", "[", "r6", "]"}], "]"}]}]}], " ", "&"}]}], 
               "]"}]}], ";", "   ", 
             RowBox[{"(*", " ", 
              RowBox[{
               RowBox[{"residuals", " ", "below", " ", "1", "e"}], "-", 
               RowBox[{
               "3", " ", "of", " ", "the", " ", "largest", " ", "are", " ", 
                "not", " ", "counted"}]}], " ", "*)"}], "\n", "      ", 
             RowBox[{"signs", " ", "=", " ", 
              RowBox[{"Count", "[", 
               RowBox[{
                RowBox[{"Differences", "[", 
                 RowBox[{"Sign", "[", "big", "]"}], "]"}], ",", " ", 
                RowBox[{"d_", " ", "/;", " ", 
                 RowBox[{"d", " ", "!=", " ", "0"}]}]}], "]"}]}], ";", "\n", 
             "      ", 
             RowBox[{"top3", " ", "=", " ", 
              RowBox[{
               RowBox[{"Max", "[", 
                RowBox[{
                 RowBox[{"lfCurve", "[", "t", "]"}], "[", 
