Cell["\<\
I.3 The spinor field and the Dirac field (item 2); theorem D1\
\>", "Section",ExpressionUUID->"bc1aa9bf-c1f9-4728-93ac-e8ee0538cfd1"],

Cell[TextData[{
 "A two-component spinor transforms under the unit bi-quaternion ",
 Cell[BoxData[
  FormBox[
   StyleBox["g",
    FontWeight->"Bold",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d8602f65-bcbc-4fd8-8b96-1899c3834b7d"],
 " as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Chi]", "\[RightTeeArrow]", 
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[Chi]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "05251b8e-e028-46f2-a6f1-7de27aeaea16"],
 " (or, for the other kind, with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     OverscriptBox[
      StyleBox["g",
       FontWeight->"Bold",
       FontSlant->"Plain"], "~"], ")"}], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["M", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"]], 
       SuperscriptBox[
        RowBox[{"(", 
         StyleBox["g",
          FontWeight->"Bold",
          FontSlant->"Plain"], ")"}], "\[Dagger]"]}], ")"}], 
     RowBox[{"-", "1"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f8e5c8e2-cda4-48ca-8ccc-59bfa902d23d"],
 "). The Dirac matrices of a frame ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    StyleBox["p", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "eecc491a-b723-440e-a0f9-b0289aedf228"],
 " are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p", "TI"]], 
    RowBox[{"[", 
     StyleBox["f",
      FontWeight->"Bold",
      FontSlant->"Plain"], "]"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f05c2d0c-c037-47c7-8894-b3c71d274e76"],
 " with the blocks ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubscriptBox[
      StyleBox["f",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      StyleBox["p", "TI"]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "35696eac-3b33-4409-81a8-4626440fe092"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["f",
        FontWeight->"Bold",
        FontSlant->"Plain"], "_"], 
      StyleBox["p", "TI"]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "168fdcd9-2e84-49ba-8567-566ca6ab2ee2"],
 " off the diagonal; the spinor matrix is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["S",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[LongEqual]", 
    StyleBox["diag",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      RowBox[{"(", 
       OverscriptBox[
        StyleBox["g",
         FontWeight->"Bold",
         FontSlant->"Plain"], "~"], ")"}], ",", 
      SubscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      RowBox[{"(", 
       StyleBox["g",
        FontWeight->"Bold",
        FontSlant->"Plain"], ")"}]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4980fdc8-b9c8-4e91-89b8-d3ce5d15739c"],
 ", and"
}], "Text",ExpressionUUID->"2af9ddfa-38c2-496a-97cd-bb031906f601"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["S",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   SuperscriptBox[
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    RowBox[{"-", "1"}]], 
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p", "TI"]], 
   SubscriptBox[
    StyleBox["S",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   RowBox[{"(", 
    StyleBox["g",
     FontWeight->"Bold",
     FontSlant->"Plain"], ")"}], "\[LongEqual]", 
   UnderscriptBox["\[Sum]", 
    SuperscriptBox[
     StyleBox["p", "TI"], "\[Prime]"],
    LimitsPositioning->True], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["L",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["p", "TI"], 
     SuperscriptBox[
      StyleBox["p", "TI"], "\[Prime]"]}]], 
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    SuperscriptBox[
     StyleBox["p", "TI"], "\[Prime]"]], ",", "      ", 
   SubscriptBox[
    StyleBox["S",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   SuperscriptBox[
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[Dagger]"], 
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], "0"], 
   SubscriptBox[
    StyleBox["S",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   RowBox[{"(", 
    StyleBox["g",
     FontWeight->"Bold",
     FontSlant->"Plain"], ")"}], "\[LongEqual]", 
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], "0"], ",", "      ", 
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p", "TI"]], 
   RowBox[{"[", 
    SuperscriptBox[
     StyleBox["f",
      FontWeight->"Bold",
      FontSlant->"Plain"], "\[Prime]"], "]"}], "\[LongEqual]", 
   SubscriptBox[
    StyleBox["S",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   RowBox[{"(", 
    StyleBox["g",
     FontWeight->"Bold",
     FontSlant->"Plain"], ")"}], "\[ThinSpace]", 
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p", "TI"]], 
   RowBox[{"[", 
    StyleBox["f",
     FontWeight->"Bold",
     FontSlant->"Plain"], "]"}], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["S",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   SuperscriptBox[
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    RowBox[{"-", "1"}]]}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"f546e984-f117-4148-b8dd-3730eab047aa"],

Cell[TextData[{
 "for the transformed frame ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["f",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["p", "TI"], "\[Prime]"], "\[LongEqual]", 
    OverscriptBox[
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], "~"], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["f",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["p", "TI"]], "\[ThinSpace]", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["g",
       FontWeight->"Bold",
       FontSlant->"Plain"], "~"], "\[Dagger]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1a8035b5-1c59-4c61-97b4-a5f0d4e6e054"],
 " (equations (3.8) and (3.9) of the manuscript). The spinor field ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "30ba09ea-6e65-4d13-b108-7453a1e82e93"],
 " is the Dirac isodoublet: eight anticommuting components, made of two \
spinor charges of the super-loop; it transforms as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[RightTeeArrow]", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["S",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      RowBox[{"(", 
       StyleBox["g",
        FontWeight->"Bold",
        FontSlant->"Plain"], ")"}], "\[CircleTimes]", 
      SubscriptBox[
       StyleBox["1",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], "2"]}], ")"}], 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3b101545-d60c-4dcf-8202-b3264e38ff81"],
 ", its isospin generators are ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2554e297-f216-4802-b967-42c0f40ebcfe"],
 ", its fermion number is 1, and its mass term ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubscriptBox[
     OverscriptBox["\[CapitalPsi]", "_"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e7c451ce-5f51-4272-836c-05de775e6fb7"],
 " is invariant under all of GEE."
}], "Text",ExpressionUUID->"81a3d8da-f668-4986-9372-c8bdf2c430eb"],

Cell[TextData[{
 StyleBox["Theorem D1.",
  FontWeight->"Bold"],
 " A single Dirac field with four components, on which ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["v",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b625265b-6647-4850-85c9-5717d76f4907"],
 " acts by a non-trivial linear representation that commutes with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SL", "TI"], 
    RowBox[{"(", 
     RowBox[{"2", ",", 
      StyleBox["\[DoubleStruckCapitalC]",
       FontSlant->"Plain"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "14c31f96-4f89-4a26-a338-321eb5628c6d"],
 " and keeps the kinetic term, has no Lorentz-invariant bilinear without \
derivatives (no Dirac, pseudoscalar or Majorana mass) that is invariant under \
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["v",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d60fa3b7-74a3-4a32-9ad7-087170efd720"],
 ". The reason: the two left-handed Weyl spinors ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Psi]", "-"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b17489eb-12d1-49ae-8d36-a855bd2c168f"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["E",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SuperscriptBox["\[Psi]", "+"], ")"}], "*"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2c20a0b3-b902-442d-bda1-1a1010fa940f"],
 " of the Dirac field form an isospin doublet (the group of Pauli and G\
\[CapitalATilde]\.bcrsey), and the Lorentz-invariant bilinears ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Xi]", 
     StyleBox["f", "TI"], 
     StyleBox["T", "TI"]], 
    SubscriptBox[
     StyleBox["E",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubscriptBox["\[Xi]", 
     SuperscriptBox[
      StyleBox["f", "TI"], "\[Prime]"]]}], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7cf5d26b-1ae0-4c7a-8dca-c0aad8eb5fb4"],
 " are symmetric in the doublet indices, an isospin triplet, which contains \
no invariant. This is why the spinor field of the solution is an isodoublet \
of Dirac fields. The next cell repeats the finite part of the proof as a \
computation: on the eight operators ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["\[Psi]", "1"], ",", "\[Ellipsis]", ",", 
     SubscriptBox["\[Psi]", "4"], ",", 
     SubsuperscriptBox["\[Psi]", "1", "\[Dagger]"], ",", "\[Ellipsis]", ",", 
     SubsuperscriptBox["\[Psi]", "4", "\[Dagger]"]}], ")"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "61cc34b5-df0a-41d9-aace-80fdace0a5a4"],
 " of one point, a bilinear ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["\[GothicN]",
      FontSlant->"Plain"], 
     StyleBox["T", "TI"]], 
    StyleBox["\[GothicCapitalQ]",
     FontSlant->"Plain"], 
    StyleBox["\[GothicN]",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "77715ba0-5ee1-419a-8833-513b91ca743f"],
 " with an antisymmetric ",
 Cell[BoxData[
  FormBox[
   RowBox[{"8", "\[Times]", "8"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b4a73606-c9fa-475e-b0e7-e0d2ed87dbef"],
 " matrix ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[GothicCapitalQ]",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "837e0ad4-fde1-4721-a881-1dab3b79095d"],
 " is invariant under a group exactly when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["\[GothicCapitalX]",
      FontSlant->"Plain"], 
     StyleBox["T", "TI"]], 
    StyleBox["\[GothicCapitalQ]",
     FontSlant->"Plain"], "+", 
    StyleBox["\[GothicCapitalQ]",
     FontSlant->"Plain"], 
    StyleBox["\[GothicCapitalX]",
     FontSlant->"Plain"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "55f66d25-fc9b-423b-8fda-4501fcde4c43"],
 " for every generator ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[GothicCapitalX]",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "688205d0-70b0-4411-87c3-948ab8b7d102"],
 "; the dimension of the space of such ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[GothicCapitalQ]",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1d378e5b-9c00-4abc-9f13-cde180ebbe67"],
 " is ",
 Cell[BoxData[
  FormBox["28", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "04b26684-ae28-4351-98fc-4f4784794853"],
 " minus the rank of these linear conditions. With exact arithmetic: \
dimension 6 for the Lorentz group, 0 for the Lorentz group together with the \
Pauli-G\[CapitalATilde]\.bcrsey ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    RowBox[{"(", "2", ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ea7b2a38-1436-4d56-bb31-c44ebb7fc92d"],
 "."
}], "Text",ExpressionUUID->"da6dc714-eb92-4b57-b3a1-3619fb82db73"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"F", "-", "2"}], ":", " ", 
      RowBox[{"the", " ", "Clifford", " ", "algebra", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"gamma", "^", "p"}], ",", " ", 
         RowBox[{"gamma", "^", "q"}]}], "}"}]}]}], " ", "=", " ", 
     RowBox[{"2", " ", 
      RowBox[{"eta", "^", "pq"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"C", " ", 
      RowBox[{"gamma", "^", "p"}], " ", 
      RowBox[{"C", "^", "dag"}]}], " ", "=", " ", 
     RowBox[{"-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"gamma", "^", "p"}], ")"}], "^", "T"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"gamma", "^", "ch"}], " ", "=", " ", 
     RowBox[{"diag", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "1"}], ",", "1", ",", "1"}], ")"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"C", "^", "T"}], " ", "=", " ", 
     RowBox[{
      RowBox[{"-", "C"}], " ", 
      RowBox[{"(", "exact", ")"}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"dF2", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Flatten", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"gam", "[", "p", "]"}], " ", ".", " ", 
              RowBox[{"gam", "[", "q", "]"}]}], " ", "+", " ", 
             RowBox[{
              RowBox[{"gam", "[", "q", "]"}], " ", ".", " ", 
              RowBox[{"gam", "[", "p", "]"}]}], " ", "-", " ", 
             RowBox[{"2", " ", 
              RowBox[{"etaLL", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"p", " ", "+", " ", "1"}], ",", " ", 
                 RowBox[{"q", " ", "+", " ", "1"}]}], "]"}], "]"}], " ", 
              RowBox[{"IdentityMatrix", "[", "4", "]"}]}]}], "]"}], ",", " ", 
           
           RowBox[{"{", 
            RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"q", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}], ",", 
         "\n", "     ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"cLL", " ", ".", " ", 
              RowBox[{"gam", "[", "p", "]"}], " ", ".", " ", 
              RowBox[{"ConjugateTranspose", "[", "cLL", "]"}]}], " ", "+", 
             " ", 
             RowBox[{"Transpose", "[", 
              RowBox[{"gam", "[", "p", "]"}], "]"}]}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}], ",", 
         "\n", "     ", 
         RowBox[{"Abs", "[", 
          RowBox[{"gch", " ", "-", " ", 
           RowBox[{"DiagonalMatrix", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", " ", 
              RowBox[{"-", "1"}], ",", " ", "1", ",", " ", "1"}], "}"}], 
            "]"}]}], "]"}], ",", " ", 
         RowBox[{"Abs", "[", 
          RowBox[{"cLL", " ", "+", " ", 
           RowBox[{"Transpose", "[", "cLL", "]"}]}], "]"}]}], "}"}], "]"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WF-2\>\"", ",", 
      " ", "\"\<Clifford algebra, chirality, charge conjugation (exact)\>\"", 
      ",", " ", "dF2", ",", " ", "0", ",", " ", "\"\<F-2\>\"", ",", 
      " ", "\"\<F-2\>\""}], "]"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"F", "-", 
      RowBox[{"3", "a"}]}], ",", " ", 
     RowBox[{"F", "-", 
      RowBox[{"3", "b"}]}], ",", " ", 
     RowBox[{"F", "-", 
      RowBox[{"3", 
       RowBox[{"d", ":", " ", 
        RowBox[{
         RowBox[{
         "the", " ", "spinor", " ", "matrices", " ", "of", " ", "200", " ", 
          "random", " ", "unit", " ", "bi"}], "-", 
         RowBox[{"quaternions", " ", 
          RowBox[{"(", 
           RowBox[{"floating", " ", "point"}], ")"}]}]}]}]}]}]}], " ", "*)"}],
    "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dF3a", ",", " ", "dF3b", ",", " ", "dF3d"}], "}"}], " ", "=", 
     " ", 
     RowBox[{"{", 
      RowBox[{"0.", ",", " ", "0.", ",", " ", "0."}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"mg", " ", "=", " ", 
           RowBox[{"randUnitBiq", "[", "]"}]}], ",", " ", "s", ",", " ", "si",
           ",", " ", "lg", ",", " ", "mgt", ",", " ", "gf"}], "}"}], ",", 
        "\n", "   ", 
        RowBox[{
         RowBox[{"s", " ", "=", " ", 
          RowBox[{"sSpin", "[", "mg", "]"}]}], ";", " ", 
         RowBox[{"si", " ", "=", " ", 
          RowBox[{"Inverse", "[", "s", "]"}]}], ";", " ", 
         RowBox[{"lg", " ", "=", " ", 
          RowBox[{"lorentzMatrix", "[", "mg", "]"}]}], ";", " ", 
         RowBox[{"mgt", " ", "=", " ", 
          RowBox[{"Inverse", "[", 
           RowBox[{"ConjugateTranspose", "[", "mg", "]"}], "]"}]}], ";", "\n",
          "   ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"dF3a", " ", "=", " ", 
             RowBox[{"Max", "[", 
              RowBox[{"dF3a", ",", " ", 
               RowBox[{"Max", "[", 
                RowBox[{"Abs", "[", 
                 RowBox[{
                  RowBox[{"si", " ", ".", " ", 
