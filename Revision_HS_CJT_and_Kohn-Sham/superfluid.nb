   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WP2-0b\>\"", ",", 
      " ", "\"\<the three W together = 1/4 of B in every channel\>\"", ",", 
      "\n", "  ", 
      RowBox[{"Max", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"pairEnergy", "[", 
