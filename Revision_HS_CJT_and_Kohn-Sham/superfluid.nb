Cell[TextData[{
 "with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftBracketingBar]", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["q", "TI"], "\[RightVector]"], 
      StyleBox["LL",
       FontSlant->"Plain"]], "\[RightBracketingBar]"}], "<", 
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "31a0e5b1-0240-47c9-a40a-8ef761a6fc79"],
 ". The energy per volume is the kinetic part plus the contractions of the \
contact terms: a bilinear term ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Nu]", ":", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["\[CapitalPsi]", "\[Dagger]"], 
       SubscriptBox[
        StyleBox["X",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["SF",
         FontSlant->"Plain"]], "\[CapitalPsi]"}], ")"}], "2"], ":"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7167c279-49f5-4e3b-acf0-cdf811779099"],
 " gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Nu]", 
    RowBox[{"[", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["w", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["H",
        FontSlant->"Plain"]], "\[ThinSpace]", 
      StyleBox["tr",
       FontSlant->"Plain"], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         StyleBox["X",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], "\[Delta]", 
         SuperscriptBox[
          StyleBox["C",
           FontFamily->"Helvetica",
           FontSlant->"Plain"], 
          StyleBox["n",
           FontSlant->"Plain"]]}], ")"}], "2"], "-", 
      SubsuperscriptBox[
       StyleBox["w", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["F",
        FontSlant->"Plain"]], "\[ThinSpace]", 
      StyleBox["tr",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       RowBox[{
        StyleBox["X",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        OverscriptBox[
         StyleBox["C",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], "~"], 
        StyleBox["X",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        OverscriptBox[
         StyleBox["C",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], "~"]}], ")"}], "-", 
      SubsuperscriptBox[
       StyleBox["w", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["P",
        FontSlant->"Plain"]], "\[ThinSpace]", 
      StyleBox["tr",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          SuperscriptBox[
           StyleBox["C",
            FontFamily->"Helvetica",
            FontSlant->"Plain"], 
           StyleBox["p",
            FontSlant->"Plain"]], ")"}], "*"], 
        StyleBox["X",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        SuperscriptBox[
         StyleBox["C",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], 
         StyleBox["p",
          FontSlant->"Plain"]], 
        SuperscriptBox[
         StyleBox["X",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], 
         StyleBox["T", "TI"]]}], ")"}]}], "]"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8307b425-8d50-4261-a781-eb58ba029b45"],
 ", and a pairing term ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", "4"]}], 
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], ":", 
    SuperscriptBox[
     RowBox[{"(", 
      SuperscriptBox["\[CapitalPi]", "\[Iota]"], ")"}], "\[Dagger]"], 
    SuperscriptBox["\[CapitalPi]", "\[Iota]"], ":"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ea158ad3-1d0e-4229-9668-e429be46ae9c"],
 " gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", "4"]}], 
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"[", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["w", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["P",
        FontSlant->"Plain"]], 
      SuperscriptBox[
       RowBox[{"\[LeftBracketingBar]", 
        RowBox[{
         StyleBox["tr",
          FontSlant->"Plain"], 
         RowBox[{"(", 
          RowBox[{
           SubsuperscriptBox[
            StyleBox["K",
             FontFamily->"Helvetica",
             FontSlant->"Plain"], 
            StyleBox["LL",
             FontSlant->"Plain"], "\[Iota]"], 
           SuperscriptBox[
            RowBox[{"(", 
             SuperscriptBox[
              StyleBox["C",
               FontFamily->"Helvetica",
               FontSlant->"Plain"], 
              StyleBox["p",
               FontSlant->"Plain"]], ")"}], 
            StyleBox["T", "TI"]]}], ")"}]}], "\[RightBracketingBar]"}], "2"], 
      "+", "2", 
      SubsuperscriptBox[
       StyleBox["w", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["F",
        FontSlant->"Plain"]], "\[ThinSpace]", 
      StyleBox["tr",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          SubsuperscriptBox[
           StyleBox["K",
            FontFamily->"Helvetica",
            FontSlant->"Plain"], 
           StyleBox["LL",
            FontSlant->"Plain"], "\[Iota]"], ")"}], "\[Dagger]"], 
        SuperscriptBox[
         OverscriptBox[
          StyleBox["C",
           FontFamily->"Helvetica",
           FontSlant->"Plain"], "~"], 
         StyleBox["T", "TI"]], 
        SubsuperscriptBox[
         StyleBox["K",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], 
         StyleBox["LL",
          FontSlant->"Plain"], "\[Iota]"], 
        OverscriptBox[
         StyleBox["C",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], "~"]}], ")"}]}], "]"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c8008918-6196-4302-b8d1-5d29e0321ccd"],
 ", where the weights ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["w", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["H",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "be13d81c-1445-4ba0-abd0-f346b9496550"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["w", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["F",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "047132d8-d248-4bb6-a798-af35f613a0a7"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["w", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["P",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1683492a-0276-48da-b887-5134ddf78142"],
 " of the direct (Hartree), exchange (Fock) and pair (Bogoliubov) \
contractions define the method, and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     StyleBox["C",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "~"], "\[LongEqual]", "\[Delta]", 
    SuperscriptBox[
     StyleBox["C",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["n",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1c1677bc-7885-4dc9-b8a8-07e4c0887996"],
 " except in KS, where it is the projection ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalP]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["KS",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     RowBox[{"\[Delta]", 
      SuperscriptBox[
       StyleBox["C",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["n",
        FontSlant->"Plain"]]}], ")"}], "\[LongEqual]", 
    FractionBox["1", "8"], 
    StyleBox["tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{"\[Delta]", 
      SuperscriptBox[
       StyleBox["C",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["n",
        FontSlant->"Plain"]]}], ")"}], 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "8"], "+", 
    FractionBox["1", "8"], 
    StyleBox["tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[Beta]", 
         StyleBox["LL",
          FontSlant->"Plain"]], "\[CircleTimes]", 
        SubscriptBox[
         StyleBox["1",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], "2"]}], ")"}], "\[Delta]", 
      SuperscriptBox[
       StyleBox["C",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["n",
        FontSlant->"Plain"]]}], ")"}], 
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[CircleTimes]", 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "57d73b6e-809b-49f7-80a8-9ff1473cc9c0"],
 " onto the two Kohn-Sham densities. ",
 StyleBox["HS",
  FontWeight->"Bold"],
 " decouples the shares ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["s", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["HS",
      FontSlant->"Plain"], ",", 
     StyleBox["S",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d1d347a3-6ad5-4deb-bd4c-b79d19c04807"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["s", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["HS",
      FontSlant->"Plain"], ",", 
     StyleBox["V",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7583e196-d23c-45b7-b53d-609cacc3baf8"],
 " of the scalar and the vector term in the density channels and the rest in \
the pair channels: weights ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["s", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["HS",
        FontSlant->"Plain"], ",", 
       StyleBox["S",
        FontSlant->"Plain"]}]], ",", "0", ",", "1", "-", 
     SubsuperscriptBox[
      StyleBox["s", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["HS",
        FontSlant->"Plain"], ",", 
       StyleBox["S",
        FontSlant->"Plain"]}]]}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e519f487-38a8-48cc-ba6e-0af596cce9c9"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["s", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["HS",
        FontSlant->"Plain"], ",", 
       StyleBox["V",
        FontSlant->"Plain"]}]], ",", "0", ",", "1", "-", 
     SubsuperscriptBox[
      StyleBox["s", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["HS",
        FontSlant->"Plain"], ",", 
       StyleBox["V",
        FontSlant->"Plain"]}]]}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "161d460a-ed7c-441d-be55-d0ef193ef68f"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "0", ",", "1"}], ")"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ecb41783-0517-4966-ba44-6d73d489cbf3"],
 " for the pairing term; three parameter sets are computed, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"1", ",", "1"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ca35ef5b-1fe2-4f57-acdd-60c276b42b30"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "1"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ce74849d-791d-4dac-9a14-1bea8d000572"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "0"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a801699a-7dd1-41af-bb05-deefa9bbd256"],
 ". ",
 StyleBox["KS",
  FontWeight->"Bold"],
 " and ",
 StyleBox["CJT",
  FontWeight->"Bold"],
 " keep all three contractions with weight 1; KS with the projection. The \
self-energies are the derivatives of the energy,"
}], "Text",ExpressionUUID->"79d6d04b-4022-4139-a232-abece98c25f6"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["N",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"]], "\[LongEqual]", "\[Nu]", 
   RowBox[{"[", 
