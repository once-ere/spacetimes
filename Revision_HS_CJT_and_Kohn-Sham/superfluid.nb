Cell[TextData[{
 "For each of the three potentials and the five methods, the cell after it \
computes the effective couplings and the stationary states reached from three \
starts (a polar pair ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.3", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a0e4f737-60eb-4502-9106-f81165543b2a"],
 "; a Dirac mass lowered by 1; a Dirac mass raised by 0.5), keeps the one of \
lowest energy (the ground state), and computes its energy per volume, its \
pair amplitude ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftBracketingBar]", 
    SubsuperscriptBox[
     StyleBox["D", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], "\[RightBracketingBar]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1104af36-88ab-459d-96d0-4f922c8f1c4b"],
 ", its Dirac mass and its gap. The ground state of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "2", ")"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "56ffd361-db41-4167-ab55-c71c4c05a1f9"],
 " is a polar superfluid in every method. Each number is compared with that \
of the Rust program. (This cell computes 45 self-consistent states; it takes \
a few minutes.)"
}], "Text",ExpressionUUID->"ffbd5688-ef5c-4aa5-ba06-817e5a25ad9a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"the", " ", "critical", " ", "pair", " ", "coupling", " ", 
    RowBox[{
     RowBox[{"pi", "^", "2"}], "/", "I1"}], 
    RowBox[{"(", "m", ")"}], " ", "and", " ", "the", " ", "coefficients", " ",
     "of", " ", 
    RowBox[{"V", "^", 
     RowBox[{"(", "2", ")"}]}], " ", "from", " ", "the", " ", "two", " ", 
    "conditions", " ", "on", " ", "the", " ", "CJT", " ", "couplings"}], " ", 
   "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"gCrit", " ", "=", " ", 
     RowBox[{
      RowBox[{"Pi", "^", "2"}], "/", 
      RowBox[{"(", 
       RowBox[{"0.5", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Sqrt", "[", 
           RowBox[{"1", " ", "+", " ", 
            RowBox[{"mLL", "^", "2"}]}], "]"}], " ", "-", " ", 
          RowBox[{
           RowBox[{"mLL", "^", "2"}], " ", 
           RowBox[{"ArcSinh", "[", 
            RowBox[{"1", "/", "mLL"}], "]"}]}]}], ")"}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WP2-6b\>\"", ",", " ", 
      RowBox[{"\"\<the critical pair coupling pi^2/I1(m) = \>\"", " ", "<>", 
       " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"NumberForm", "[", 
         RowBox[{
          RowBox[{"N", "[", "gCrit", "]"}], ",", " ", "11"}], "]"}], "]"}]}], 
      ",", " ", 
      RowBox[{"Abs", "[", 
       RowBox[{"gCrit", " ", "-", " ", 
        RowBox[{"rustPart2", "[", "\"\<p2_Gcrit\>\"", "]"}]}], "]"}], ",", 
      " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}], ",", " ", "\"\<P2-6b\>\"", ",", 
      " ", "\"\<YP2-6b\>\""}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"f", " ", "=", " ", 
         RowBox[{
          RowBox[{"effCouplings", "[", 
           RowBox[{
            RowBox[{"{", "\"\<CJT\>\"", "}"}], ",", " ", "#1", ",", " ", 
            "0.8", ",", " ", "#2"}], "]"}], " ", "&"}]}], ",", " ", "s0", ",",
         " ", "p0", ",", " ", "s1", ",", " ", "p1", ",", " ", "s2", ",", " ", 
        "p2", ",", " ", "st", ",", " ", "pt"}], "}"}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"s0", ",", " ", "p0"}], "}"}], " ", "=", " ", 
        RowBox[{"f", "[", 
         RowBox[{"0.", ",", " ", "0."}], "]"}]}], ";", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"s1", ",", " ", "p1"}], "}"}], " ", "=", " ", 
        RowBox[{"f", "[", 
         RowBox[{"1.", ",", " ", "0."}], "]"}]}], ";", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"s2", ",", " ", "p2"}], "}"}], " ", "=", " ", 
        RowBox[{"f", "[", 
         RowBox[{"0.", ",", " ", "1."}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"st", " ", "=", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"effCouplings", "[", 
           RowBox[{
            RowBox[{"{", "\"\<CJT\>\"", "}"}], ",", " ", 
            RowBox[{"-", "8."}], ",", " ", "0.8", ",", " ", "0."}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", "s0"}]}], ";", "\n", 
       "  ", 
       RowBox[{"pt", " ", "=", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"effCouplings", "[", 
           RowBox[{
            RowBox[{"{", "\"\<CJT\>\"", "}"}], ",", " ", 
            RowBox[{"-", "8."}], ",", " ", "0.8", ",", " ", "22.5"}], "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", "p0"}]}], ";", "\n", 
       "  ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"gS2", ",", " ", "gP2"}], "}"}], " ", "=", " ", 
        RowBox[{"LinearSolve", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"s1", " ", "-", " ", "s0"}], ",", " ", 
              RowBox[{"s2", " ", "-", " ", "s0"}]}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"p1", " ", "-", " ", "p0"}], ",", " ", 
              RowBox[{"p2", " ", "-", " ", "p0"}]}], "}"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"st", ",", " ", "pt"}], "}"}]}], "]"}]}]}]}], "]"}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WP2-6a\>\"", ",", " ", 
      RowBox[{"\"\<V^(2) from the conditions on the CJT effective couplings: \
(G^S, G) = (\>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"NumberForm", "[", 
         RowBox[{"gS2", ",", " ", "11"}], "]"}], "]"}], " ", "<>", 
       " ", "\"\<, \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"NumberForm", "[", 
         RowBox[{"gP2", ",", " ", "11"}], "]"}], "]"}], " ", "<>", 
       " ", "\"\<)\>\""}], ",", "\n", "  ", 
      RowBox[{"Max", "[", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"gS2", " ", "-", " ", 
          RowBox[{"rustPart2", "[", "\"\<p2_V2_GS\>\"", "]"}]}], "]"}], ",", 
        " ", 
        RowBox[{"Abs", "[", 
         RowBox[{"gP2", " ", "-", " ", 
          RowBox[{"rustPart2", "[", "\"\<p2_V2_G\>\"", "]"}]}], "]"}]}], 
       "]"}], ",", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}], ",", " ", "\"\<P2-6a\>\"", ",", 
      " ", "\"\<YP2-6a\>\""}], "]"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"the", " ", "three", " ", "potentials", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"G", "^", "S"}], ",", " ", 
       RowBox[{"G", "^", "V"}], ",", " ", "G"}], "}"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"potentialsSF", " ", "=", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<V0\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "8."}], ",", " ", "0.8", ",", " ", "0."}], "}"}]}], ",",
        " ", 
       RowBox[{"\"\<V1\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "8."}], ",", " ", "0.8", ",", " ", "22.5"}], "}"}]}], ",",
        " ", 
       RowBox[{"\"\<V2\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"gS2", ",", " ", "0.8", ",", " ", "gP2"}], "}"}]}]}], 
      "|>"}]}], ";"}]}]}]], "Input",
 CellLabel->
  "In[227]:=",ExpressionUUID->"4057d7e0-1048-47c7-afe9-832beba1a367"],

