Cell[CellGroupData[{

Cell["III.L.5 Why no polynomial can be exact: the cause", "Section",ExpressionUUID->"1c06a2b0-7043-4c3a-9726-80e82e5f5e70"],

Cell[TextData[{
 StyleBox["The pair field enters the quasi-particle energies like a mass.",
  FontWeight->"Bold"],
 " For the applied pair self-energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "77c3178a-c4dd-40b1-a90c-f0dfe213014a"],
 " and a normal self-energy that is a Dirac mass, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["D",
         FontSlant->"Plain"]}]], "-", 
      SubscriptBox[
       StyleBox["m", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}], 
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[CircleTimes]", 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ad1dbd98-48da-4127-b841-af8cfaadad47"],
 ", the eigenvalues of the matrix of Bogoliubov and de Gennes at the momentum \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox[
     StyleBox["q", "TI"], "\[RightVector]"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8886ed02-1979-4e0c-8c2b-01334c857259"],
 " are ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    StyleBox["E", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "94608bcd-b9e3-4d3a-a619-6106fdc839a7"],
 ", each eight times, with"
}], "Text",ExpressionUUID->"102767db-8f8d-4e82-a01c-5508db6919f5"],

Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox["E", "TI"], "\[LongEqual]", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"\[LeftBracketingBar]", 
        SubscriptBox[
         OverscriptBox[
          StyleBox["q", "TI"], "\[RightVector]"], 
         StyleBox["LL",
          FontSlant->"Plain"]], "\[RightBracketingBar]"}], "2"], "+", 
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox[
         StyleBox["M", "TI"], 
         StyleBox["SF",
          FontSlant->"Plain"], 
         RowBox[{
          StyleBox["X", "TI"], ",", 
          StyleBox["D",
           FontSlant->"Plain"]}]], ")"}], "2"], "+", 
      SubsuperscriptBox["\[CapitalPhi]", 
       StyleBox["a",
        FontSlant->"Plain"], "2"]}], ")"}], 
    RowBox[{"1", "/", "2"}]], "."}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"2db55ae0-ca67-47be-b3c6-86ced27737fa"],

Cell[TextData[{
 "The next cell checks this for 20 random momenta, masses and fields with the \
matrices of Part I (",
 StyleBox["hLL",
  FontFamily->"Source Code Pro"],
 ", ",
 StyleBox["kLL",
  FontFamily->"Source Code Pro"],
 ", ",
 StyleBox["betaLL",
  FontFamily->"Source Code Pro"],
 "); along the whole polar curve the normal self-energy is such a Dirac mass \
(the Rust check P3-9 and the Python check YP3-9)."
}], "Text",ExpressionUUID->"5ad54995-9184-4421-b30f-de7b1e93389d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
     "the", " ", "BdG", " ", "matrix", " ", "of", " ", "the", " ", "eight", " ",
       "components", " ", "with", " ", "the", " ", "Dirac", " ", "mass", " ", 
      "M", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"normal", " ", "self"}], "-", 
        RowBox[{"energy", " ", 
         RowBox[{"(", 
          RowBox[{"M", " ", "-", " ", "m"}], ")"}], " ", "beta", " ", 
         RowBox[{"(", "x", ")"}], " ", "1", "_", "2"}]}], ")"}], " ", "and", " ",
       "the", " ", "applied", "\n", "   ", "pair", " ", "self"}], "-", 
     RowBox[{"energy", " ", "fa", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"K", "^", "3"}], ")"}], "^", "dag"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"at", " ", "the", " ", "momentum", " ", "q"}], ";", " ", 
     RowBox[{
      RowBox[{"its", " ", "sorted", " ", "eigenvalues", " ", "against"}], " ",
       "-", 
      RowBox[{"E", " ", 
       RowBox[{"(", 
        RowBox[{"eight", " ", "times"}], ")"}], " ", "and"}], " ", "+", 
      RowBox[{"E", " ", 
       RowBox[{"(", 
        RowBox[{"eight", " ", "times"}], ")"}]}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"lfBdG", "[", 
      RowBox[{"q_", ",", " ", "mass_", ",", " ", "fa_"}], "]"}], " ", ":=", 
     " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"n", " ", "=", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"mass", " ", "-", " ", "mLL"}], ")"}], " ", 
           RowBox[{"d8", "[", "betaLL", "]"}]}]}], ",", " ", 
         RowBox[{"p", " ", "=", " ", 
          RowBox[{"fa", " ", 
           RowBox[{"ConjugateTranspose", "[", 
            RowBox[{"kLL", "[", "3", "]"}], "]"}]}]}], ",", " ", "a", ",", 
         " ", "d"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"a", " ", "=", " ", 
         RowBox[{
          RowBox[{"hLL", "[", 
           RowBox[{"q", ",", " ", "mLL"}], "]"}], " ", "+", " ", "n"}]}], ";",
         " ", 
        RowBox[{"d", " ", "=", " ", 
         RowBox[{
          RowBox[{"hLL", "[", 
           RowBox[{
            RowBox[{"-", "q"}], ",", " ", "mLL"}], "]"}], " ", "+", " ", 
          "n"}]}], ";", "\n", "   ", 
        RowBox[{"N", "[", 
         RowBox[{"ArrayFlatten", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"a", ",", " ", "p"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"ConjugateTranspose", "[", "p", "]"}], ",", " ", 
              RowBox[{"-", 
               RowBox[{"Transpose", "[", "d", "]"}]}]}], "}"}]}], "}"}], 
          "]"}], "]"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"SeedRandom", "[", "20261121", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"lfQpDev", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"q", " ", "=", " ", 
             RowBox[{"RandomReal", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", "3"}], 
              "]"}]}], ",", " ", 
            RowBox[{"mass", " ", "=", " ", 
             RowBox[{"RandomReal", "[", 
              RowBox[{"{", 
               RowBox[{"0.1", ",", " ", "0.5"}], "}"}], "]"}]}], ",", " ", 
            RowBox[{"fa", " ", "=", " ", 
             RowBox[{"RandomReal", "[", 
              RowBox[{"{", 
               RowBox[{"0", ",", " ", "0.6"}], "}"}], "]"}]}], ",", " ", "ev",
             ",", " ", "e"}], "}"}], ",", "\n", "     ", 
          RowBox[{
           RowBox[{"ev", " ", "=", " ", 
            RowBox[{"Sort", "[", 
             RowBox[{"Re", "[", 
              RowBox[{"Eigenvalues", "[", 
               RowBox[{"lfBdG", "[", 
                RowBox[{"q", ",", " ", "mass", ",", " ", "fa"}], "]"}], "]"}],
               "]"}], "]"}]}], ";", "\n", "     ", 
           RowBox[{"e", " ", "=", " ", 
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{"q", " ", ".", " ", "q"}], " ", "+", " ", 
              RowBox[{"mass", "^", "2"}], " ", "+", " ", 
              RowBox[{"fa", "^", "2"}]}], "]"}]}], ";", "\n", "     ", 
           RowBox[{"Max", "[", 
            RowBox[{"Abs", "[", 
             RowBox[{"ev", " ", "-", " ", 
              RowBox[{"Join", "[", 
               RowBox[{
                RowBox[{"ConstantArray", "[", 
                 RowBox[{
                  RowBox[{"-", "e"}], ",", " ", "8"}], "]"}], ",", " ", 
                RowBox[{"ConstantArray", "[", 
                 RowBox[{"e", ",", " ", "8"}], "]"}]}], "]"}]}], "]"}], 
            "]"}]}]}], "]"}], ",", " ", 
        RowBox[{"{", "20", "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WP3-8\>\"", ",", 
      " ", "\"\<the pair field enters the quasi-particle energies like a \
mass: the BdG matrix with N = (M - m) beta (x) 1_2 and P = Phi_a (K^3)^dag \
has the eigenvalues -+(q^2 + M^2 + Phi_a^2)^(1/2), eight times each (20 \
random q, M, Phi_a)\>\"", ",", " ", "lfQpDev", ",", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "13"}]}], ",", " ", "\"\<P3-8\>\"", ",", 
      " ", "\"\<YP3-8\>\""}], "]"}], ";"}]}]}]], "Input",
 CellLabel->
  "In[301]:=",ExpressionUUID->"8a53c8d1-286c-44ff-8949-bd2ef9ea2923"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"PASS \"\>", "\[InvisibleSpace]", "\<\"WP3-8\"\>", 
   "\[InvisibleSpace]", "\<\"  deviation \"\>", 
   "\[InvisibleSpace]", "\<\"1.554e-15\"\>", 
   "\[InvisibleSpace]", "\<\" (tolerance \"\>", 
   "\[InvisibleSpace]", "\<\"1.000e-13\"\>", 
   "\[InvisibleSpace]", "\<\"): \"\>", 
   "\[InvisibleSpace]", "\<\"the pair field enters the quasi-particle \
energies like a mass: the BdG matrix with N = (M - m) beta (x) 1_2 and P = \
Phi_a (K^3)^dag has the eigenvalues -+(q^2 + M^2 + Phi_a^2)^(1/2), eight \
times each (20 random q, M, Phi_a)\"\>", 
   "\[InvisibleSpace]", "\<\"   [the same check: Rust \"\>", 
   "\[InvisibleSpace]", "\<\"P3-8\"\>", 
   "\[InvisibleSpace]", "\<\", Python \"\>", 
   "\[InvisibleSpace]", "\<\"YP3-8\"\>", "\[InvisibleSpace]", "\<\"]\"\>"}],
  SequenceForm[
  "PASS ", "WP3-8", "  deviation ", "1.554e-15", " (tolerance ", "1.000e-13", 
   "): ", "the pair field enters the quasi-particle energies like a mass: the \
BdG matrix with N = (M - m) beta (x) 1_2 and P = Phi_a (K^3)^dag has the \
eigenvalues -+(q^2 + M^2 + Phi_a^2)^(1/2), eight times each (20 random q, M, \
Phi_a)", "   [the same check: Rust ", "P3-8", ", Python ", "YP3-8", "]"],
  Editable->False]], "Print",
 CellChangeTimes->{4.004286091502512*^9},
 CellLabel->
  "During evaluation of \
In[301]:=",ExpressionUUID->"74c2a123-ea72-488c-88fd-f65fa87495bc"]
}, Open  ]],

Cell[TextData[{
 StyleBox["A logarithm.",
  FontWeight->"Bold"],
 " The energy per volume is an integral over the momenta ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["q", "TI"], "<", 
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6bbcd077-fc40-4cd8-9b53-ede3c082d056"],
 " of functions of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       StyleBox["q", "TI"], "2"], "+", 
      StyleBox["s", "TI"]}], ")"}], 
    RowBox[{"1", "/", "2"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e255fe9c-0e2c-4627-b06f-de84eb8ceb9e"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["s", "TI"], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["D",
         FontSlant->"Plain"]}]], ")"}], "2"], "+", 
    SubsuperscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d86710db-c4b7-4074-99f8-891853868dc8"],
 ". The next cell integrates the simplest of them exactly and expands the \
result about ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["s", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7cf002ad-5605-407e-8bcb-7eff60a09ec6"],
 ": it contains the term ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "16"], 
    SuperscriptBox[
     StyleBox["s", "TI"], "2"], "\[ThinSpace]", 
    StyleBox["ln",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["s", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f3f59cd8-9f0b-483f-bf3b-28798c2155d0"],
 ", which is not analytic at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["s", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cfcd01ae-7a5c-423d-a364-7db1ec93b0b1"],
 ", that is, at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"], "2"], "\[LongEqual]", 
    RowBox[{"-", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["M", "TI"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["X", "TI"], ",", 
         StyleBox["D",
          FontSlant->"Plain"]}]], ")"}], "2"]}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ef33cf86-c5f7-401a-86ca-f4bb447c74db"],
 ". Hence ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalV]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2a35ec88-41d0-46ed-8db5-c0797c315c92"],
 " is not a polynomial in ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3d0cfe95-76da-4446-86a2-f909a0c7a05f"],
 ", and a series of powers of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d85c5a90-135e-4c43-ad20-db3a7f5de5a7"],
 " about the origin can converge only within a radius of the order of the \
Dirac mass (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0.2"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4746f050-ba25-488e-94db-956b288f94b4"],
 " at the origin), while ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalPhi]", 
     RowBox[{"0", ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]], "\[LongEqual]", "0.31"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "56eb2538-4394-4168-9845-c8dceac84ef1"],
 " to ",
 Cell[BoxData[
  FormBox["0.40", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a237ffc8-d058-4610-9427-c2f6e92bb53c"],
 ": the superfluid is far from the regime of Landau's theory, where the order \
parameter is small and the Landau coefficients are Taylor coefficients."
}], "Text",ExpressionUUID->"2e9a6650-5c8d-4151-959a-c9771f5e844f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", "integral", " ", "of", " ", 
     RowBox[{"q", "^", "2"}], " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"q", "^", "2"}], " ", "+", " ", "s"}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}]}], " ", "from", " ", "0", " ", "to", " ",
      "the", " ", "cutoff", " ", "lam"}], ",", " ", "exactly", ",", " ", 
    RowBox[{
     RowBox[{"and", " ", "its", " ", "expansion", " ", "about", " ", "s"}], 
     " ", "=", " ", "0"}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"lfq", ":", " ", 
     RowBox[{
     "the", " ", "modulus", " ", "of", " ", "the", " ", "momentum"}]}], ",", 
    " ", 
    RowBox[{"lfs", ":", " ", 
     RowBox[{
      RowBox[{"the", " ", "quantity", " ", 
       RowBox[{"M", "^", "2"}]}], " ", "+", " ", 
      RowBox[{"Phi_a", "^", "2"}]}]}], ",", " ", 
    RowBox[{"lfLam", ":", " ", 
     RowBox[{"the", " ", "cutoff"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"lfInt", " ", "=", " ", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"lfq", "^", "2"}], " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"lfq", "^", "2"}], " ", "+", " ", "lfs"}], "]"}]}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"lfq", ",", " ", "0", ",", " ", "lfLam"}], "}"}], ",", " ", 
       RowBox[{"Assumptions", " ", "->", " ", 
        RowBox[{
         RowBox[{"lfs", " ", ">", " ", "0"}], " ", "&&", " ", 
         RowBox[{"lfLam", " ", ">", " ", "0"}]}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"lfClosed", " ", "=", " ", 
     RowBox[{
      RowBox[{"lfLam", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", " ", 
          RowBox[{"lfLam", "^", "2"}]}], " ", "+", " ", "lfs"}], ")"}], " ", 
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"lfLam", "^", "2"}], " ", "+", " ", "lfs"}], "]"}], "/", 
        "8"}]}], " ", "-", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"lfs", "^", "2"}], "/", "8"}], " ", 
       RowBox[{"Log", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"lfLam", " ", "+", " ", 
           RowBox[{"Sqrt", "[", 
            RowBox[{
             RowBox[{"lfLam", "^", "2"}], " ", "+", " ", "lfs"}], "]"}]}], 
          ")"}], "/", 
         RowBox[{"Sqrt", "[", "lfs", "]"}]}], "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<the integral minus the closed form: \>\"", ",", " ", 
      RowBox[{"FullSimplify", "[", 
       RowBox[{
        RowBox[{"lfInt", " ", "-", " ", "lfClosed"}], ",", " ", 
        RowBox[{"Assumptions", " ", "->", " ", 
         RowBox[{
          RowBox[{"lfs", " ", ">", " ", "0"}], " ", "&&", " ", 
          RowBox[{"lfLam", " ", ">", " ", "0"}]}]}]}], "]"}]}], "]"}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"lfSeries", " ", "=", " ", 
     RowBox[{"Expand", "[", 
      RowBox[{"Normal", "[", 
       RowBox[{"Series", "[", 
        RowBox[{
         RowBox[{"lfClosed", " ", "/.", " ", 
          RowBox[{"lfLam", " ", "->", " ", "1"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"lfs", ",", " ", "0", ",", " ", "2"}], "}"}]}], "]"}], 
       "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<the closed form about s = 0 (cutoff 1), to the order s^2: \
\>\"", ",", " ", "lfSeries"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<its term with the logarithm: \>\"", ",", " ", 
      RowBox[{"Coefficient", "[", 
       RowBox[{"lfSeries", ",", " ", 
        RowBox[{"Log", "[", "lfs", "]"}]}], "]"}], ",", 
      " ", "\"\< Log[s]\>\""}], "]"}], ";"}]}]}]], "Input",
 CellLabel->
  "In[305]:=",ExpressionUUID->"0e327e02-88d5-48d3-a4f1-d04e8df0a8b8"],

