     "x", " ", "in", " ", "per", " ", "cent", " ", "with", " ", "three", " ", 
      "significant", " ", "digits"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"pct", "[", "x_", "]"}], " ", ":=", " ", 
     RowBox[{"NumberForm", "[", 
      RowBox[{
       RowBox[{"100.", " ", "x"}], ",", " ", "3"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"lfRows", " ", "=", " ", 
     RowBox[{"{", "\n", "   ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<minimum of the polynomial: Phi_L/Phi0 - 1 (per cent)\>\"",
          ",", " ", 
