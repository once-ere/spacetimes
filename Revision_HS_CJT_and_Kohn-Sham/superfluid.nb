       RowBox[{"sum_a", " ", 
        RowBox[{"V", "^", "a_mu"}], " ", "X_a", " ", "for", " ", "the", " ", 
        "fields", " ", "V"}], " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"W", "^", "1"}], ",", " ", 
           RowBox[{"W", "^", "2"}], ",", " ", 
           RowBox[{"W", "^", "3"}], ",", " ", "B"}], ")"}], ":", "\n", "   ", 
         
         RowBox[{
          RowBox[{"i", " ", "g", " ", 
           RowBox[{"tau_a", "/", "2"}]}], " ", "<", "Phi", ">", " ", 
          RowBox[{"for", " ", "a"}]}]}], " ", "=", " ", "1"}]}]}], ",", " ", 
     "2", ",", " ", 
     RowBox[{
      RowBox[{"3", " ", "and", " ", "i", " ", 
       RowBox[{"g", "'"}], " ", "Y"}], " ", "<", "Phi", ">", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Y", " ", "=", " ", 
         RowBox[{"1", "/", "2"}]}], ")"}], " ", "for", " ", "B"}]}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"xSM", " ", "=", " ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"I", " ", 
            RowBox[{"gSM", "/", "2"}]}], ")"}], " ", 
          RowBox[{
           RowBox[{"sig", "[", 
            RowBox[{"[", 
             RowBox[{"a", " ", "+", " ", "1"}], "]"}], "]"}], " ", ".", " ", 
           "phiSM"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"a", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"I", " ", 
           RowBox[{"gpSM", "/", "2"}]}], ")"}], " ", "phiSM"}], "}"}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", "mass", " ", "matrix", " ", "M_ab"}], " ", "=", " ", 
     
     RowBox[{
      RowBox[{
       RowBox[{"2", " ", "Re", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"X_a", "^", "dag"}], " ", "X_b"}], ")"}]}], ":", " ", 
       RowBox[{
        RowBox[{
