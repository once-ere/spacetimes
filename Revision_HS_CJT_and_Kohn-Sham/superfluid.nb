Cell[CellGroupData[{

Cell["I.2 The manifold M31 of the Lorentz super-loop (item 1)", "Section",ExpressionUUID->"d110bed8-6368-4eaa-9343-50e19a8c0d57"],

Cell[TextData[{
 StyleBox["Bi-quaternions.",
  FontWeight->"Bold"],
 " A bi-quaternion is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["b",
     FontWeight->"Bold",
     FontSlant->"Plain"], "\[LongEqual]", 
    UnderoverscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["p", "TI"], "\[LongEqual]", "0"}], "3",
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox["\[Xi]", 
     StyleBox["p", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["p", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "03f1b53e-40ef-4e28-b281-e23161c06eee"],
 " with four complex coefficients and the units ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "0"], "\[LongEqual]", "1", ",", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "1"], ",", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "2"], ",", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "3"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3aea6a6c-f6ec-4cfb-8886-b6d247ab8b69"],
 ", multiplied by the rules of the quaternions, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"], "2"], "\[LongEqual]", 
    RowBox[{"-", "1"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a1682aec-ebbf-4504-9259-bfef0ae33afb"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "1"], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "2"], "\[LongEqual]", 
    RowBox[{"-", 
     SubscriptBox[
      StyleBox["e",
       FontWeight->"Bold",
       FontSlant->"Plain"], "2"]}], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "1"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "3"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2f64fe3f-1678-429b-8fdd-c3dccefd3aa2"],
 " and cyclically. The conjugation ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["b",
     FontWeight->"Bold",
     FontSlant->"Plain"], "_"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0f2c88a3-44a6-4a40-af1a-64c115eec980"],
 " changes the signs of the coefficients of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "1"], ",", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "2"], ",", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "3"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "40a223fe-e73b-4b87-bbad-e26f7c44aae9"],
 ", the complex conjugation ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["b",
     FontWeight->"Bold",
     FontSlant->"Plain"], "*"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7a38500e-dffd-42b8-ae21-b1dc4af85787"],
 " conjugates every coefficient, and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], "\[Dagger]"], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      OverscriptBox[
       StyleBox["b",
        FontWeight->"Bold",
        FontSlant->"Plain"], "_"], ")"}], "*"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bda083fe-70fa-4f83-9054-9acf8a338497"],
 ". The complex norm ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", 
     StyleBox["p", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox["\[Xi]", 
     StyleBox["p", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      StyleBox["b",
       FontWeight->"Bold",
       FontSlant->"Plain"], ")"}], "2"]}], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a26216e1-e477-4ff0-98b4-3e280224c9d9"],
 " satisfies ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["b",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    OverscriptBox[
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], "_"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "0"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a5d9324d-21d4-4a39-ad7c-adbb53bf186d"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["b",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      SuperscriptBox[
       StyleBox["b",
        FontWeight->"Bold",
        FontSlant->"Plain"], "\[Prime]"]}], ")"}], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SuperscriptBox[
      StyleBox["b",
       FontWeight->"Bold",
       FontSlant->"Plain"], "\[Prime]"], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e35f2034-6b74-4c7c-8f2c-14c2b72d352e"],
 ". The matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[LongEqual]", 
    SubsuperscriptBox["\[Xi]", "0", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Sigma]", "0", 
     StyleBox["LL",
      FontSlant->"Plain"]], "-", 
    StyleBox["i", "TI"], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", 
     StyleBox["j", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox["\[Xi]", 
     StyleBox["j", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Sigma]", 
     StyleBox["j", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "844cf565-6793-43d0-89c1-fa1d930a4c86"],
 " is multiplicative, has the determinant ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d0d085d3-b30a-45ee-a393-01b92804849c"],
 ", satisfies ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SuperscriptBox[
      StyleBox["b",
       FontWeight->"Bold",
       FontSlant->"Plain"], "\[Dagger]"], ")"}], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      StyleBox["b",
       FontWeight->"Bold",
       FontSlant->"Plain"], ")"}], "\[Dagger]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6bdec8aa-9866-425e-b9d0-960b6d0fb970"],
 ", and every complex ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Times]", "2"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "530690eb-19d2-4862-a336-c8ba7c54c74c"],
 " matrix is the matrix of exactly one bi-quaternion; the unit bi-quaternions \
(",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "17f0e60d-b50c-4d01-be46-0fa87315e3e8"],
 ") are therefore the group ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SL", "TI"], 
    RowBox[{"(", 
     RowBox[{"2", ",", 
      StyleBox["\[DoubleStruckCapitalC]",
       FontSlant->"Plain"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5f9bb2e4-f229-4918-a06a-4b14d7a28768"],
 "."
}], "Text",ExpressionUUID->"3c77f00a-c536-482c-bb0a-d8f1061e549a"],

Cell[TextData[{
 StyleBox["Bi-octonions and the super-loop.",
  FontWeight->"Bold"],
 " A bi-octonion is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["x",
     FontWeight->"Bold",
     FontSlant->"Plain"], "\[LongEqual]", 
    StyleBox["a",
     FontWeight->"Bold",
     FontSlant->"Plain"], "+", 
    StyleBox["b",
     FontWeight->"Bold",
     FontSlant->"Plain"], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0a2e182c-78b4-40ea-a382-d1e69819cf02"],
 " with two bi-quaternions, multiplied by the rule of Cayley and Dickson"
}], "Text",ExpressionUUID->"118d12fe-d987-4bde-b768-5657a4b0278a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     StyleBox["a",
      FontWeight->"Bold",
      FontSlant->"Plain"], "+", 
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], "\[ThinSpace]", 
     SubscriptBox[
      StyleBox["e",
       FontWeight->"Bold",
       FontSlant->"Plain"], "4"]}], ")"}], 
   RowBox[{"(", 
    RowBox[{
     StyleBox["c",
      FontWeight->"Bold",
      FontSlant->"Plain"], "+", 
     StyleBox["d",
      FontWeight->"Bold",
      FontSlant->"Plain"], "\[ThinSpace]", 
     SubscriptBox[
      StyleBox["e",
       FontWeight->"Bold",
       FontSlant->"Plain"], "4"]}], ")"}], "\[LongEqual]", 
   RowBox[{"(", 
    RowBox[{
     StyleBox["a",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["c",
      FontWeight->"Bold",
      FontSlant->"Plain"], "-", 
     OverscriptBox[
      StyleBox["d",
       FontWeight->"Bold",
       FontSlant->"Plain"], "_"], 
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"]}], ")"}], "+", 
   RowBox[{"(", 
    RowBox[{
     StyleBox["d",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["a",
      FontWeight->"Bold",
      FontSlant->"Plain"], "+", 
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     OverscriptBox[
      StyleBox["c",
       FontWeight->"Bold",
       FontSlant->"Plain"], "_"]}], ")"}], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["e",
     FontWeight->"Bold",
     FontSlant->"Plain"], "4"], ","}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"cc2e7788-5859-4676-8feb-91994b75b3c5"],

Cell[TextData[{
 "with the eight units ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "0"], ",", "\[Ellipsis]", ",", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "3"], ",", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "622a8772-b18e-4357-b865-f05876a0b293"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     RowBox[{"4", "+", 
      StyleBox["j", "TI"]}]], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ff960ee9-47ce-4180-9c6f-3270ef397b59"],
 ". The norm is multiplicative, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox[
      RowBox[{"x", "y"}],
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["x",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["y",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6e0f43b1-94ac-4205-890c-0349a793d83b"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["x",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    OverscriptBox[
     StyleBox["x",
      FontWeight->"Bold",
      FontSlant->"Plain"], "_"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["x",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "0"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d00dfaf8-86b4-4b78-a38f-b17fc4bec809"],
 ". The product is not associative (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["e",
        FontWeight->"Bold",
        FontSlant->"Plain"], "1"], 
      SubscriptBox[
       StyleBox["e",
        FontWeight->"Bold",
        FontSlant->"Plain"], "2"]}], ")"}], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "4"], "-", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "1"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["e",
        FontWeight->"Bold",
        FontSlant->"Plain"], "2"], 
      SubscriptBox[
       StyleBox["e",
        FontWeight->"Bold",
        FontSlant->"Plain"], "4"]}], ")"}], "\[LongEqual]", "2", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "7"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a64f6e6a-b20b-45f9-9281-63b31d0cc8c0"],
 "), but it is alternative, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     StyleBox[
      RowBox[{"x", "x"}],
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    StyleBox["y",
     FontWeight->"Bold",
     FontSlant->"Plain"], "\[LongEqual]", 
    StyleBox["x",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     StyleBox[
      RowBox[{"x", "y"}],
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "23927af1-6928-4536-9f76-56c1c94c07c2"],
 ", and satisfies the three Moufang identities ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     StyleBox[
      RowBox[{"z", "x", "z"}],
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    StyleBox["y",
     FontWeight->"Bold",
     FontSlant->"Plain"], "\[LongEqual]", 
    StyleBox["z",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["x",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       StyleBox[
        RowBox[{"z", "y"}],
        FontWeight->"Bold",
        FontSlant->"Plain"], ")"}]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "50ba7de6-ad5c-473f-af81-3213a2fd27ad"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["y",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     StyleBox[
      RowBox[{"z", "x", "z"}],
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       StyleBox[
        RowBox[{"y", "z"}],
        FontWeight->"Bold",
        FontSlant->"Plain"], ")"}], 
      StyleBox["x",
       FontWeight->"Bold",
       FontSlant->"Plain"]}], ")"}], 
    StyleBox["z",
     FontWeight->"Bold",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "96e9e663-6743-4467-89aa-6914015bb05b"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     StyleBox[
      RowBox[{"z", "x"}],
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    RowBox[{"(", 
     StyleBox[
      RowBox[{"y", "z"}],
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["z",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       StyleBox[
        RowBox[{"x", "y"}],
        FontWeight->"Bold",
        FontSlant->"Plain"], ")"}]}], ")"}], 
    StyleBox["z",
     FontWeight->"Bold",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7b042a2d-4782-4ea2-a4eb-5d80d6bb2247"],
 ". The unit bi-octonions form the Lorentz super-loop ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["\[DoubleStruckCapitalL]",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "07048bce-63d0-4cd7-9b89-2389d874bc37"],
 ", a Moufang loop of real dimension 14 that contains ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SL", "TI"], 
    RowBox[{"(", 
     RowBox[{"2", ",", 
      StyleBox["\[DoubleStruckCapitalC]",
       FontSlant->"Plain"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c506fbd7-bb99-4843-83a5-d8ade5975889"],
 "."
}], "Text",ExpressionUUID->"ba68462f-8151-4776-8bbc-80866e68956d"],

Cell["\<\
The next cell checks these rules exactly: bi-octonions with small integer \
(Gaussian integer) coefficients are multiplied in exact arithmetic, so every \
identity must hold with the deviation exactly 0. Of the 343 ordered triples \
of imaginary units, 168 have a nonzero associator: a triple with two equal \
members has none (alternativity), and of the 210 triples of distinct units a \
triple has none exactly when its third unit is plus or minus the product of \
the first two, which leaves 210 - 42 = 168.\
\>", "Text",ExpressionUUID->"6df17ff7-8bf4-4c86-b5ca-d14f5900cdb5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"A", "-", "2"}], ":", " ", 
      RowBox[{
      "the", " ", "rules", " ", "of", " ", "the", " ", "eight", " ", 
       "units"}], ":", " ", 
      RowBox[{"e_p", "^", "2"}]}], " ", "=", " ", 
     RowBox[{"-", "1"}]}], ",", " ", 
    RowBox[{
     RowBox[{"e_p", " ", "e_q"}], " ", "=", " ", 
     RowBox[{
      RowBox[{"-", "e_q"}], " ", "e_p", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"p", " ", "!=", " ", "q"}], ",", " ", 
        RowBox[{"both", " ", ">=", " ", "1"}]}], ")"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"e_j", " ", "e_", "4"}], " ", "=", " ", 
     RowBox[{"e_", 
      RowBox[{"(", 
       RowBox[{"4", "+", "j"}], ")"}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"dA2", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Join", "[", "\n", "    ", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"oMax", "[", 
           RowBox[{
            RowBox[{"oMul", "[", 
             RowBox[{
              RowBox[{"oUnit", "[", "p", "]"}], ",", " ", 
              RowBox[{"oUnit", "[", "p", "]"}]}], "]"}], " ", "+", " ", 
            RowBox[{"oUnit", "[", "0", "]"}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"p", ",", " ", "1", ",", " ", "7"}], "}"}]}], "]"}], ",", 
        "\n", "    ", 
        RowBox[{"Flatten", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"p", " ", "!=", " ", "q"}], ",", " ", 
             RowBox[{"oMax", "[", 
              RowBox[{
               RowBox[{"oMul", "[", 
                RowBox[{
                 RowBox[{"oUnit", "[", "p", "]"}], ",", " ", 
                 RowBox[{"oUnit", "[", "q", "]"}]}], "]"}], " ", "+", " ", 
               RowBox[{"oMul", "[", 
                RowBox[{
                 RowBox[{"oUnit", "[", "q", "]"}], ",", " ", 
                 RowBox[{"oUnit", "[", "p", "]"}]}], "]"}]}], "]"}], ",", " ",
              "0"}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"p", ",", " ", "1", ",", " ", "7"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"q", ",", " ", "1", ",", " ", "7"}], "}"}]}], "]"}], 
         "]"}], ",", "\n", "    ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"oMax", "[", 
           RowBox[{
            RowBox[{"oMul", "[", 
             RowBox[{
              RowBox[{"oUnit", "[", "j", "]"}], ",", " ", 
              RowBox[{"oUnit", "[", "4", "]"}]}], "]"}], " ", "-", " ", 
            RowBox[{"oUnit", "[", 
             RowBox[{"4", " ", "+", " ", "j"}], "]"}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"j", ",", " ", "1", ",", " ", "3"}], "}"}]}], "]"}]}], 
       "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WA-2\>\"", ",", 
      " ", "\"\<bi-octonion units: e_p^2 = -1, e_p e_q = -e_q e_p, e_j e_4 = \
e_(4+j) (exact)\>\"", ",", " ", "dA2", ",", " ", "0", ",", " ", "\"\<A-2\>\"",
       ",", " ", "\"\<A-2\>\""}], "]"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"rintBio", "[", "]"}], " ", "is", " ", "a", " ", "random", " ", 
      "bi"}], "-", 
     RowBox[{"octonion", " ", "with", " ", "Gaussian"}], "-", 
     RowBox[{"integer", " ", "coefficients", " ", "between"}], " ", "-", 
     RowBox[{"3", " ", "and", " ", "3"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"rintBio", "[", "]"}], " ", ":=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"RandomInteger", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "3"}], ",", " ", "3"}], "}"}], ",", " ", "4"}], 
         "]"}], " ", "+", " ", 
        RowBox[{"I", " ", 
         RowBox[{"RandomInteger", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "3"}], ",", " ", "3"}], "}"}], ",", " ", "4"}], 
          "]"}]}]}], ",", " ", 
       RowBox[{
        RowBox[{"RandomInteger", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "3"}], ",", " ", "3"}], "}"}], ",", " ", "4"}], 
         "]"}], " ", "+", " ", 
        RowBox[{"I", " ", 
         RowBox[{"RandomInteger", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "3"}], ",", " ", "3"}], "}"}], ",", " ", "4"}], 
          "]"}]}]}]}], "}"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"A", "-", 
      RowBox[{"3", " ", "to", " ", "A"}], "-", 
      RowBox[{
      "6", " ", "on", " ", "200", " ", "random", " ", "triples", " ", 
       RowBox[{"(", 
        RowBox[{"x", ",", " ", "y", ",", " ", "z"}], ")"}]}]}], ",", " ", 
     RowBox[{"in", " ", "exact", " ", "arithmetic"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dA3", ",", " ", "dA4", ",", " ", "dA5", ",", " ", "dA6"}], 
      "}"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], "}"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"x", " ", "=", " ", 
           RowBox[{"rintBio", "[", "]"}]}], ",", " ", 
          RowBox[{"y", " ", "=", " ", 
           RowBox[{"rintBio", "[", "]"}]}], ",", " ", 
          RowBox[{"z", " ", "=", " ", 
           RowBox[{"rintBio", "[", "]"}]}], ",", " ", "zxz"}], "}"}], ",", 
        "\n", "   ", 
        RowBox[{
         RowBox[{"dA3", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"dA3", ",", " ", 
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"oNorm", "[", 
               RowBox[{"oMul", "[", 
                RowBox[{"x", ",", " ", "y"}], "]"}], "]"}], " ", "-", " ", 
              RowBox[{
               RowBox[{"oNorm", "[", "x", "]"}], " ", 
               RowBox[{"oNorm", "[", "y", "]"}]}]}], "]"}]}], "]"}]}], ";", 
         "\n", "   ", 
         RowBox[{"dA4", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"dA4", ",", " ", 
            RowBox[{"oMax", "[", 
             RowBox[{
              RowBox[{"oMul", "[", 
               RowBox[{"x", ",", " ", 
                RowBox[{"oBar", "[", "x", "]"}]}], "]"}], " ", "-", " ", 
              RowBox[{
               RowBox[{"oNorm", "[", "x", "]"}], " ", 
               RowBox[{"oUnit", "[", "0", "]"}]}]}], "]"}]}], "]"}]}], ";", 
         "\n", "   ", 
         RowBox[{"dA5", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"dA5", ",", " ", 
            RowBox[{"oMax", "[", 
             RowBox[{
              RowBox[{"oMul", "[", 
               RowBox[{
                RowBox[{"oMul", "[", 
                 RowBox[{"x", ",", " ", "x"}], "]"}], ",", " ", "y"}], "]"}], 
              " ", "-", " ", 
              RowBox[{"oMul", "[", 
               RowBox[{"x", ",", " ", 
                RowBox[{"oMul", "[", 
                 RowBox[{"x", ",", " ", "y"}], "]"}]}], "]"}]}], "]"}], ",", 
            " ", 
            RowBox[{"oMax", "[", 
             RowBox[{
              RowBox[{"oMul", "[", 
               RowBox[{
                RowBox[{"oMul", "[", 
                 RowBox[{"y", ",", " ", "x"}], "]"}], ",", " ", "x"}], "]"}], 
              " ", "-", " ", 
              RowBox[{"oMul", "[", 
               RowBox[{"y", ",", " ", 
                RowBox[{"oMul", "[", 
                 RowBox[{"x", ",", " ", "x"}], "]"}]}], "]"}]}], "]"}]}], 
           "]"}]}], ";", "\n", "   ", 
         RowBox[{"zxz", " ", "=", " ", 
          RowBox[{"oMul", "[", 
           RowBox[{
            RowBox[{"oMul", "[", 
             RowBox[{"z", ",", " ", "x"}], "]"}], ",", " ", "z"}], "]"}]}], ";",
          "\n", "   ", 
         RowBox[{"dA6", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"dA6", ",", " ", 
            RowBox[{"oMax", "[", 
             RowBox[{
              RowBox[{"oMul", "[", 
               RowBox[{"zxz", ",", " ", "y"}], "]"}], " ", "-", " ", 
              RowBox[{"oMul", "[", 
               RowBox[{"z", ",", " ", 
                RowBox[{"oMul", "[", 
                 RowBox[{"x", ",", " ", 
                  RowBox[{"oMul", "[", 
                   RowBox[{"z", ",", " ", "y"}], "]"}]}], "]"}]}], "]"}]}], 
             "]"}], ",", " ", 
            RowBox[{"oMax", "[", 
             RowBox[{
              RowBox[{"oMul", "[", 
               RowBox[{"y", ",", " ", "zxz"}], "]"}], " ", "-", " ", 
              RowBox[{"oMul", "[", 
               RowBox[{
                RowBox[{"oMul", "[", 
                 RowBox[{
                  RowBox[{"oMul", "[", 
                   RowBox[{"y", ",", " ", "z"}], "]"}], ",", " ", "x"}], 
                 "]"}], ",", " ", "z"}], "]"}]}], "]"}], ",", "\n", "     ", 
            RowBox[{"oMax", "[", 
             RowBox[{
              RowBox[{"oMul", "[", 
               RowBox[{
                RowBox[{"oMul", "[", 
                 RowBox[{"z", ",", " ", "x"}], "]"}], ",", " ", 
                RowBox[{"oMul", "[", 
                 RowBox[{"y", ",", " ", "z"}], "]"}]}], "]"}], " ", "-", " ", 
              
              RowBox[{"oMul", "[", 
               RowBox[{
                RowBox[{"oMul", "[", 
                 RowBox[{"z", ",", " ", 
                  RowBox[{"oMul", "[", 
                   RowBox[{"x", ",", " ", "y"}], "]"}]}], "]"}], ",", " ", 
                "z"}], "]"}]}], "]"}]}], "]"}]}]}]}], "]"}], ",", " ", 
      RowBox[{"{", "200", "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WA-3\>\"", ",", 
      " ", "\"\<N(xy) = N(x) N(y), 200 random Gaussian-integer bi-octonions \
(exact)\>\"", ",", " ", "dA3", ",", " ", "0", ",", " ", "\"\<A-3\>\"", ",", 
      " ", "\"\<A-3\>\""}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WA-4\>\"", ",", " ", "\"\<x xbar = N(x) e_0 (exact)\>\"", ",",
       " ", "dA4", ",", " ", "0", ",", " ", "\"\<A-4\>\"", ",", 
      " ", "\"\<A-4\>\""}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WA-5\>\"", ",", 
      " ", "\"\<alternativity (xx)y = x(xy), (yx)x = y(xx) (exact)\>\"", ",", 
      " ", "dA5", ",", " ", "0", ",", " ", "\"\<A-5\>\"", ",", 
      " ", "\"\<A-5\>\""}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WA-6\>\"", ",", 
      " ", "\"\<the three Moufang identities (exact)\>\"", ",", " ", "dA6", ",",
       " ", "0", ",", " ", "\"\<A-6\>\"", ",", " ", "\"\<A-6\>\""}], "]"}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"A", "-", "7"}], ":", " ", 
      RowBox[{
      "the", " ", "associators", " ", "of", " ", "the", " ", "343", " ", 
       "ordered", " ", "triples", " ", "of", " ", "imaginary", " ", 
       "units"}]}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"and", " ", 
        RowBox[{"(", 
         RowBox[{"e1", " ", "e2"}], ")"}], " ", "e4"}], " ", "-", " ", 
       RowBox[{"e1", " ", 
        RowBox[{"(", 
         RowBox[{"e2", " ", "e4"}], ")"}]}]}], " ", "=", " ", 
      RowBox[{"2", " ", "e7"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"nonzeroAssociators", " ", "=", " ", 
     RowBox[{"Count", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"oMax", "[", 
           RowBox[{
            RowBox[{"oMul", "[", 
             RowBox[{
              RowBox[{"oMul", "[", 
               RowBox[{
                RowBox[{"oUnit", "[", "p", "]"}], ",", " ", 
                RowBox[{"oUnit", "[", "q", "]"}]}], "]"}], ",", " ", 
              RowBox[{"oUnit", "[", "r", "]"}]}], "]"}], " ", "-", " ", 
            RowBox[{"oMul", "[", 
             RowBox[{
              RowBox[{"oUnit", "[", "p", "]"}], ",", " ", 
              RowBox[{"oMul", "[", 
               RowBox[{
                RowBox[{"oUnit", "[", "q", "]"}], ",", " ", 
                RowBox[{"oUnit", "[", "r", "]"}]}], "]"}]}], "]"}]}], "]"}], ",",
           "\n", "      ", 
          RowBox[{"{", 
           RowBox[{"p", ",", " ", "1", ",", " ", "7"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"q", ",", " ", "1", ",", " ", "7"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"r", ",", " ", "1", ",", " ", "7"}], "}"}]}], "]"}], "]"}],
        ",", " ", 
       RowBox[{"v_", " ", "/;", " ", 
        RowBox[{"v", " ", ">", " ", "0"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"a124", " ", "=", " ", 
     RowBox[{
      RowBox[{"oMul", "[", 
       RowBox[{
        RowBox[{"oMul", "[", 
         RowBox[{
          RowBox[{"oUnit", "[", "1", "]"}], ",", " ", 
          RowBox[{"oUnit", "[", "2", "]"}]}], "]"}], ",", " ", 
        RowBox[{"oUnit", "[", "4", "]"}]}], "]"}], " ", "-", " ", 
      RowBox[{"oMul", "[", 
       RowBox[{
        RowBox[{"oUnit", "[", "1", "]"}], ",", " ", 
        RowBox[{"oMul", "[", 
         RowBox[{
          RowBox[{"oUnit", "[", "2", "]"}], ",", " ", 
          RowBox[{"oUnit", "[", "4", "]"}]}], "]"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"checkTrue", "[", 
     RowBox[{"\"\<WA-7\>\"", ",", 
      " ", "\"\<168 of the 343 triples of imaginary units have a nonzero \
associator; (e1 e2) e4 - e1 (e2 e4) = 2 e7\>\"", ",", "\n", "  ", 
      RowBox[{
       RowBox[{"nonzeroAssociators", " ", "==", " ", "168"}], " ", "&&", " ", 
       
       RowBox[{
        RowBox[{"oMax", "[", 
         RowBox[{"a124", " ", "-", " ", 
          RowBox[{"2", " ", 
           RowBox[{"oUnit", "[", "7", "]"}]}]}], "]"}], " ", "==", " ", 
        "0"}]}], ",", " ", 
      RowBox[{
       RowBox[{"ToString", "[", "nonzeroAssociators", "]"}], " ", "<>", 
       " ", "\"\< nonzero\>\""}], ",", " ", "\"\<A-7\>\"", ",", 
      " ", "\"\<A-7\>\""}], "]"}], ";"}]}]}]], "Input",
 CellLabel->"In[51]:=",ExpressionUUID->"89a41c17-c7cb-4c94-a324-4e09b8771375"],

