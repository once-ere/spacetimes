           RowBox[{"h", 
            RowBox[{"(", 
             RowBox[{"-", "q"}], ")"}]}], " ", "+", " ", "N", " ", "+", " ", 
           "X"}], ")"}], "^", "T"}]}]}], ";", " ", 
      RowBox[{
       RowBox[{"with", " ", "L"}], " ", "=", " ", 
       RowBox[{
        RowBox[{"conj", 
         RowBox[{"(", "va", ")"}], " ", "and", " ", "R"}], " ", "=", " ", 
        RowBox[{
         RowBox[{"vd", " ", "the", " ", "matrix", " ", 
          RowBox[{"U_A", "^", "dag"}], " ", 
          RowBox[{"(", 
           RowBox[{"E_ab", " ", "-", " ", "E_ba"}], ")"}], " ", "U_D", " ", 
          "has", " ", "the", " ", "entries", "\n", "   ", 
          RowBox[{"L", "[", 
           RowBox[{"k", ",", " ", "a"}], "]"}], " ", 
          RowBox[{"R", "[", 
           RowBox[{"l", ",", " ", "b"}], "]"}]}], " ", "-", " ", 
