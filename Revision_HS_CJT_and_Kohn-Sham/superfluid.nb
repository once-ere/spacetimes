                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"dpoly", " ", "/.", " ", 
                    RowBox[{"xx", " ", "->", " ", "#"}]}], ")"}], "^", 
                  "2"}]}], ")"}]}], " ", "&"}], ",", " ", "roots"}], "]"}], 
           "]"}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"gridSF", "[", "nr", "]"}], ":", " ", 
      RowBox[{"the", " ", "radial", " ", "nodes", " ", "kr", " ", 
       RowBox[{"(", 
        RowBox[{"on", " ", "[", 
         RowBox[{"0", ",", " ", "Lambda"}], "]"}], ")"}], " ", "and", " ", 
