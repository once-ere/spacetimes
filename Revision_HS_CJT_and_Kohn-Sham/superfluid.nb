       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "wgl"}], "}"}], " ", "=", " ", 
         RowBox[{"gaussLegendre", "[", "nr", "]"}]}], ";", "\n", "   ", 
        RowBox[{"kr", " ", "=", " ", 
         RowBox[{"0.5", " ", "lamLL", " ", 
          RowBox[{"(", 
           RowBox[{"x", " ", "+", " ", "1."}], ")"}]}]}], ";", " ", 
        RowBox[{"wr", " ", "=", " ", 
         RowBox[{"0.5", " ", "lamLL", " ", "wgl"}]}], ";", "\n", "   ", 
        RowBox[{"dirs", " ", "=", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", " ", "0", ",", " ", "0"}], "}"}], ",", 
           " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "1", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", 
             RowBox[{"-", "1"}], ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0", ",", " ", "1"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0", ",", " ", 
             RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ";", "\n", "   ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<nr\>\"", " ", "->", " ", "nr"}], ",", " ", 
          RowBox[{"\"\<kr\>\"", " ", "->", " ", "kr"}], ",", " ", 
          RowBox[{"\"\<wr\>\"", " ", "->", " ", "wr"}], ",", " ", 
          RowBox[{"\"\<dirs\>\"", " ", "->", " ", 
           RowBox[{"N", "[", "dirs", "]"}]}], ",", "\n", "     ", 
          RowBox[{"\"\<q\>\"", " ", "->", " ", 
           RowBox[{"Flatten", "[", 
            RowBox[{
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"kr", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], " ", 
                RowBox[{"dirs", "[", 
                 RowBox[{"[", "d", "]"}], "]"}]}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"i", ",", " ", "nr"}], "}"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"d", ",", " ", "6"}], "}"}]}], "]"}], ",", " ", "1"}],
             "]"}]}], ",", "\n", "     ", 
          RowBox[{"\"\<w\>\"", " ", "->", " ", 
           RowBox[{"Flatten", "[", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"wr", "[", 
                RowBox[{"[", "i", "]"}], "]"}], " ", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"kr", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "^", "2"}], "/", 
                 RowBox[{"(", 
                  RowBox[{"2", " ", 
                   RowBox[{"Pi", "^", "2"}]}], ")"}]}], "/", "6."}]}], ",", 
              " ", 
              RowBox[{"{", 
               RowBox[{"i", ",", " ", "nr"}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"d", ",", " ", "6"}], "}"}]}], "]"}], "]"}]}], ",", 
          " ", 
          RowBox[{"\"\<n\>\"", " ", "->", " ", 
           RowBox[{"6", " ", "nr"}]}]}], "|>"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"ksProj", "[", "x", "]"}], ":", " ", 
