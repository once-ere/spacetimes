       RowBox[{"(", 
        RowBox[{"0", ",", " ", "v"}], ")"}], "/", "sqrt2"}], " ", "of", " ", 
      "the", " ", "Higgs", " ", "doublet"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"phiSM", " ", "=", " ", 
