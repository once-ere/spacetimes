      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "/", "2"}], ")"}], " ", "sum_ab", " ", "M_ab", " ", 
       RowBox[{"V", "^", "a"}], " ", 
       RowBox[{"V", "^", "b"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"mSM", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"2", " ", 
        RowBox[{"ComplexExpand", "[", 
         RowBox[{"Re", "[", 
          RowBox[{
           RowBox[{"Conjugate", "[", 
            RowBox[{"xSM", "[", 
             RowBox[{"[", "a", "]"}], "]"}], "]"}], " ", ".", " ", 
           RowBox[{"xSM", "[", 
            RowBox[{"[", "b", "]"}], "]"}]}], "]"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "4"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"b", ",", " ", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", "predicted", " ", 
      RowBox[{"eigenvalues", ":", " ", "0"}]}], ",", " ", 
     RowBox[{
      RowBox[{"M_W", "^", "2"}], " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"g", " ", 
          RowBox[{"v", "/", "2"}]}], ")"}], "^", "2"}], " ", "twice"}]}], ",",
      " ", 
     RowBox[{
      RowBox[{
       RowBox[{"M_Z", "^", "2"}], " ", "=", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"g", "^", "2"}], " ", "+", " ", 
          RowBox[{
           RowBox[{"g", "'"}], "^", "2"}]}], ")"}], " ", 
        RowBox[{
         RowBox[{"v", "^", "2"}], "/", "4"}]}]}], ";", " ", 
      RowBox[{
      "they", " ", "are", " ", "the", " ", "eigenvalues", " ", "exactly", " ",
        "when", "\n", "   ", "the", " ", "characteristic", " ", "polynomial", 
       " ", "det", 
       RowBox[{"(", 
        RowBox[{"M", " ", "-", " ", 
         RowBox[{"lam", " ", "1"}]}], ")"}], " ", "equals", " ", "the", " ", 
       "product", " ", "of", " ", "the", " ", "factors", " ", 
       RowBox[{"(", 
        RowBox[{"lam", " ", "-", " ", "eigenvalue"}], ")"}]}]}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"evSMpred", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"gSM", " ", 
          RowBox[{"vSM", "/", "2"}]}], ")"}], "^", "2"}], ",", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"gSM", " ", 
          RowBox[{"vSM", "/", "2"}]}], ")"}], "^", "2"}], ",", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"gSM", "^", "2"}], " ", "+", " ", 
          RowBox[{"gpSM", "^", "2"}]}], ")"}], " ", 
        RowBox[{
         RowBox[{"vSM", "^", "2"}], "/", "4"}]}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"charSM", " ", "=", " ", 
     RowBox[{"Expand", "[", 
      RowBox[{
       RowBox[{"CharacteristicPolynomial", "[", 
        RowBox[{"mSM", ",", " ", "lam"}], "]"}], " ", "-", " ", 
       RowBox[{"Product", "[", 
        RowBox[{
         RowBox[{"lam", " ", "-", " ", "ev"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"ev", ",", " ", "evSMpred"}], "}"}]}], "]"}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", "photon", " ", "A"}], " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"sin", 
        RowBox[{"(", "thetaW", ")"}], " ", 
        RowBox[{"W", "^", "3"}]}], " ", "+", " ", 
       RowBox[{"cos", 
        RowBox[{"(", "thetaW", ")"}], " ", "B", " ", "with", " ", "tan", 
        RowBox[{"(", "thetaW", ")"}]}]}], " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"g", "'"}], "/", "g"}], " ", "is", " ", "the", " ", "null", " ",
        "vector"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"photonSM", " ", "=", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "0", ",", " ", "gpSM", ",", " ", "gSM"}], "}"}],
       "/", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"gSM", "^", "2"}], " ", "+", " ", 
        RowBox[{"gpSM", "^", "2"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<the mass matrix of (W1, W2, W3, B): \>\"", ",", " ", 
      RowBox[{"MatrixForm", "[", "mSM", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"checkTrue", "[", 
     RowBox[{"\"\<WSM-1\>\"", ",", 
      " ", "\"\<Standard Model with +i g: the eigenvalues of the mass matrix \
are 0, M_W^2 (twice), M_Z^2, and the photon sin(thetaW) W^3 + cos(thetaW) B \
is massless\>\"", ",", "\n", "  ", 
      RowBox[{
       RowBox[{"charSM", " ", "===", " ", "0"}], " ", "&&", " ", 
       RowBox[{
        RowBox[{"Simplify", "[", 
         RowBox[{"mSM", " ", ".", " ", "photonSM"}], "]"}], " ", "===", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], 
         "}"}]}]}], ",", " ", "\"\<exact, with symbolic g, g', v\>\"", ",", 
      "\n", "  ", "\"\<SM-1\>\"", ",", " ", "\"\<SM-1\>\""}], "]"}], 
    ";"}]}]}]], "Input",
 CellLabel->"In[42]:=",ExpressionUUID->"fbaf3a0e-0948-4742-9693-674327c21310"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"the mass matrix of (W1, W2, W3, B): \"\>", "\[InvisibleSpace]", 
   TagBox[
    RowBox[{"(", "\[NoBreak]", GridBox[{
       {
        FractionBox[
         RowBox[{
          SuperscriptBox["gSM", "2"], " ", 
          SuperscriptBox["vSM", "2"]}], "4"], "0", "0", "0"},
       {"0", 
        FractionBox[
         RowBox[{
          SuperscriptBox["gSM", "2"], " ", 
          SuperscriptBox["vSM", "2"]}], "4"], "0", "0"},
       {"0", "0", 
        FractionBox[
         RowBox[{
          SuperscriptBox["gSM", "2"], " ", 
          SuperscriptBox["vSM", "2"]}], "4"], 
        RowBox[{
         RowBox[{"-", 
          FractionBox["1", "4"]}], " ", "gpSM", " ", "gSM", " ", 
         SuperscriptBox["vSM", "2"]}]},
       {"0", "0", 
        RowBox[{
         RowBox[{"-", 
          FractionBox["1", "4"]}], " ", "gpSM", " ", "gSM", " ", 
         SuperscriptBox["vSM", "2"]}], 
        FractionBox[
         RowBox[{
          SuperscriptBox["gpSM", "2"], " ", 
          SuperscriptBox["vSM", "2"]}], "4"]}
      },
      GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
      GridBoxSpacings->{"Columns" -> {
          Offset[0.27999999999999997`], {
           Offset[0.7]}, 
          Offset[0.27999999999999997`]}, "Rows" -> {
          Offset[0.2], {
           Offset[0.4]}, 
          Offset[0.2]}}], "\[NoBreak]", ")"}],
    Function[BoxForm`e$, 
     MatrixForm[BoxForm`e$]]]}],
  SequenceForm["the mass matrix of (W1, W2, W3, B): ", 
   MatrixForm[{{
     Rational[1, 4] $CellContext`gSM^2 $CellContext`vSM^2, 0, 0, 0}, {
     0, Rational[1, 4] $CellContext`gSM^2 $CellContext`vSM^2, 0, 0}, {
     0, 0, Rational[1, 4] $CellContext`gSM^2 $CellContext`vSM^2, 
      Rational[-1, 
        4] $CellContext`gpSM $CellContext`gSM $CellContext`vSM^2}, {
     0, 0, Rational[-1, 
        4] $CellContext`gpSM $CellContext`gSM $CellContext`vSM^2, 
      Rational[1, 4] $CellContext`gpSM^2 $CellContext`vSM^2}}]],
