        RowBox[{"{", 
         RowBox[{"kind", ",", " ", "data", ",", " ", 
          RowBox[{"{", 
           RowBox[{"wH", ",", " ", "wF", ",", " ", "wP"}], "}"}], ",", " ", 
          "ks"}], "}"}]}]}], ";", " ", 
      RowBox[{"kind", " ", "\"\<b\>\"", " ", "with", " ", "data", " ", 
