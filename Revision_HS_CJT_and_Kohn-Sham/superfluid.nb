Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"PASS \"\>", "\[InvisibleSpace]", "\<\"WP3-10 CJT\"\>", 
   "\[InvisibleSpace]", "\<\"  deviation \"\>", 
   "\[InvisibleSpace]", "\<\"2.377e-8\"\>", 
   "\[InvisibleSpace]", "\<\" (tolerance \"\>", 
   "\[InvisibleSpace]", "\<\"1.000e-6\"\>", 
   "\[InvisibleSpace]", "\<\"): \"\>", 
   "\[InvisibleSpace]", "\<\"CJT: the coefficient of Phi^2 of the Taylor \
series at the origin from the first six points of the curve = the Rust value \
a^Tay = -0.00429666 (relative)\"\>", 
   "\[InvisibleSpace]", "\<\"   [the same check: Rust \"\>", 
   "\[InvisibleSpace]", "\<\"P3-10 CJT\"\>", 
   "\[InvisibleSpace]", "\<\", Python \"\>", 
   "\[InvisibleSpace]", "\<\"YP3-10 CJT\"\>", 
   "\[InvisibleSpace]", "\<\"]\"\>"}],
  SequenceForm[
  "PASS ", "WP3-10 CJT", "  deviation ", "2.377e-8", " (tolerance ", 
   "1.000e-6", "): ", 
   "CJT: the coefficient of Phi^2 of the Taylor series at the origin from the \
first six points of the curve = the Rust value a^Tay = -0.00429666 \
(relative)", "   [the same check: Rust ", "P3-10 CJT", ", Python ", 
   "YP3-10 CJT", "]"],
  Editable->False]], "Print",
 CellChangeTimes->{4.004272144451631*^9},
 CellLabel->
  "During evaluation of \
In[311]:=",ExpressionUUID->"1b63b8e8-8573-4e1f-84d0-d342d4b91920"]
}, Open  ]],

