       RowBox[{
        RowBox[{"Tr", "[", 
         RowBox[{"b8", " ", ".", " ", "x"}], "]"}], "/", "8"}], " ", 
       "b8"}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"terms", "[", 
