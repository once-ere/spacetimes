Cell[TextData[{
 StyleBox["The Taylor coefficient at the origin.",
  FontWeight->"Bold"],
 " The coefficient ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["Tay",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "250c4ef3-c412-4d84-99b0-7c00970424b5"],
 " of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "707e1d95-ce3b-443a-8a1e-bee3c26df938"],
 " of the Taylor series at the origin is the limit of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalV]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], "/", 
    SuperscriptBox["\[CapitalPhi]", "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "03df1abc-6d64-49a1-8440-33e28d1c0912"],
 " at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPhi]", "\[RightArrow]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ad2f83b8-a3b5-426c-a43c-c894ba6aaf17"],
 ". The Rust and the Python program compute it from three states with small \
applied fields (0.004, 0.008, 0.016) and the Richardson elimination of the \
term proportional to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CapitalPhi]", "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "92830f87-a57f-4e1a-a895-41bf0e7b7fcb"],
 ". The next cell estimates it from the first six points of the computed \
curve (",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPhi]", "<", "0.1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d12d7385-fbb3-4625-b323-f6ecdaf56e79"],
 ", well inside the radius of convergence) by fitting ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalV]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], "/", 
    SuperscriptBox["\[CapitalPhi]", "2"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["a", "TI"], "0"], "+", 
    SubscriptBox[
     StyleBox["a", "TI"], "1"], 
    SuperscriptBox["\[CapitalPhi]", "2"], "+", 
    SubscriptBox[
     StyleBox["a", "TI"], "2"], 
    SuperscriptBox["\[CapitalPhi]", "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "11ca5b09-17d6-48fc-81d4-95b86fc9728d"],
 "; the truncation of this local series limits the agreement to about ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", "\[Times]", 
    SuperscriptBox["10", 
     RowBox[{"-", "7"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b72bd1ed-0782-4d8a-87a1-fd7e16f2232f"],
 ". The fitted ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fe625a89-fe30-4000-9bec-1e99027bfe84"],
 " of the Landau form differs from ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["Tay",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b83e0775-561c-4db4-b8fc-790df68fc271"],
 " by 0.7 to 2 per cent: it is a property of the fit."
}], "Text",ExpressionUUID->"cf56f001-61a3-45cb-82f2-20eca856669e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"lfTaylor", "[", "t", "]"}], ":", " ", 
    RowBox[{
     RowBox[{"a", "^", "Tay"}], " ", "estimated", " ", "from", " ", "the", " ",
      "points", " ", "2", " ", "to", " ", "7", " ", "of", " ", "the", " ", 
     "curve", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"the", " ", "first", " ", "point", " ", "is", " ", "Phi"}], 
       " ", "=", " ", "0"}], ")"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"lfTaylor", "[", "t_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"p", " ", "=", " ", 
         RowBox[{
          RowBox[{"lfCurve", "[", "t", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"2", " ", ";;", " ", "7"}], "]"}], "]"}]}], "}"}], ",", 
       " ", 
       RowBox[{
        RowBox[{"LeastSquares", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", " ", 
              RowBox[{"x", "^", "2"}], ",", " ", 
              RowBox[{"x", "^", "4"}]}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"x", ",", " ", 
              RowBox[{"p", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], "}"}]}], 
           "]"}], ",", " ", 
          RowBox[{
           RowBox[{"p", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "/", 
           RowBox[{
            RowBox[{"p", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], "^", "2"}]}]}], 
         "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{"\"\<WP3-10 \>\"", " ", "<>", " ", "t"}], ",", " ", 
        RowBox[{
         RowBox[{"lfName", "[", "t", "]"}], " ", "<>", 
         " ", "\"\<: the coefficient of Phi^2 of the Taylor series at the \
origin from the first six points of the curve = the Rust value a^Tay = \>\"", 
         " ", "<>", " ", 
         RowBox[{"ToString", "[", 
          RowBox[{"rustPart3", "[", 
           RowBox[{"\"\<p3_a_taylor_\>\"", " ", "<>", " ", "t"}], "]"}], 
          "]"}], " ", "<>", " ", "\"\< (relative)\>\""}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"lfTaylor", "[", "t", "]"}], " ", "-", " ", 
           RowBox[{"rustPart3", "[", 
            RowBox[{"\"\<p3_a_taylor_\>\"", " ", "<>", " ", "t"}], "]"}]}], 
          "]"}], "/", 
         RowBox[{"Abs", "[", 
          RowBox[{"rustPart3", "[", 
           RowBox[{"\"\<p3_a_taylor_\>\"", " ", "<>", " ", "t"}], "]"}], 
          "]"}]}], ",", " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "6"}]}], ",", " ", 
        RowBox[{"\"\<P3-10 \>\"", " ", "<>", " ", "t"}], ",", " ", 
        RowBox[{"\"\<YP3-10 \>\"", " ", "<>", " ", "t"}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"t", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<HS_1_1\>\"", ",", " ", "\"\<CJT\>\""}], "}"}]}], 
       "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"lfName", "[", "t", "]"}], ",", " ", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{"lfTaylor", "[", "t", "]"}], ",", " ", "10"}], "]"}], ",",
            " ", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{"rustPart3", "[", 
              RowBox[{"\"\<p3_a_taylor_\>\"", " ", "<>", " ", "t"}], "]"}], ",",
              " ", "10"}], "]"}], ",", " ", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"lfResults", "[", "t", "]"}], "[", "\"\<a\>\"", "]"}], ",",
              " ", "10"}], "]"}], ",", " ", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{"100", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"lfResults", "[", "t", "]"}], "[", "\"\<a\>\"", 
                  "]"}], "/", 
                 RowBox[{"rustPart3", "[", 
                  RowBox[{"\"\<p3_a_taylor_\>\"", " ", "<>", " ", "t"}], 
                  "]"}]}], " ", "-", " ", "1"}], ")"}]}], ",", " ", "3"}], 
            "]"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"t", ",", " ", "lfTags"}], "}"}]}], "]"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<method\>\"", ",", " ", "\"\<a^Tay from the curve\>\"", ",",
          " ", "\"\<a^Tay of the Rust program\>\"", ",", 
         " ", "\"\<a of the Landau form\>\"", ",", 
         " ", "\"\<a/a^Tay - 1 (per cent)\>\""}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "All"}]}], "]"}]}]}]], "Input",
 CellLabel->
  "In[311]:=",ExpressionUUID->"751ecc40-4b2c-441a-8b23-e29a062d0cea"],

