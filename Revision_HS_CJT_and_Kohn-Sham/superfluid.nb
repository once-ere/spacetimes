       RowBox[{"(", 
        RowBox[{"all", " ", "positive", " ", "symbols"}], ")"}]}]}]}]}], " ", 
   "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", 
     RowBox[{"gSM", ",", " ", "gpSM", ",", " ", "vSM"}], "]"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"phiSM", ":", " ", 
      RowBox[{
       RowBox[{"the", " ", "vacuum"}], " ", "<", 
       RowBox[{"Phi", "^", "SM"}], ">"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"0", ",", " ", "v"}], ")"}], "/", "sqrt2"}], " ", "of", " ", 
      "the", " ", "Higgs", " ", "doublet"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"phiSM", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", 
       RowBox[{"vSM", "/", 
        RowBox[{"Sqrt", "[", "2", "]"}]}]}], "}"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
