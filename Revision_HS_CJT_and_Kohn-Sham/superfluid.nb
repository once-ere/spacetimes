Cell[TextData[{
 StyleBox["The Taylor coefficient at the origin.",
  FontWeight->"Bold"],
 " The coefficient ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["Tay",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e8b0c02f-0213-4e2d-89ab-68b6edfb2cf5"],
 " of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6999376f-2b35-41a7-8189-e430d2cbca96"],
 " of the Taylor series at the origin is the limit of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalV]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], "/", 
    SuperscriptBox["\[CapitalPhi]", "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ddae88dd-a89a-412d-8c2d-d00b6f53878f"],
 " at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPhi]", "\[RightArrow]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "afc1f908-e338-44f2-bed7-e955984903a6"],
 ". The Rust and the Python program compute it from three states with small \
applied fields (0.004, 0.008, 0.016) and the Richardson elimination of the \
term proportional to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CapitalPhi]", "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "db767071-4a80-4756-bf6f-241e743b4a53"],
 ". The next cell estimates it from the first six points of the computed \
curve (",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPhi]", "<", "0.1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "76071e79-0d6e-4e01-8ce6-2e45b605fb9e"],
 ", well inside the radius of convergence) by fitting ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalV]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], "/", 
    SuperscriptBox["\[CapitalPhi]", "2"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["a", "TI"], "0"], "+", 
    SubscriptBox[
     StyleBox["a", "TI"], "1"], 
    SuperscriptBox["\[CapitalPhi]", "2"], "+", 
    SubscriptBox[
     StyleBox["a", "TI"], "2"], 
    SuperscriptBox["\[CapitalPhi]", "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9015d34b-0276-42a0-bd5a-6411d70585f6"],
 "; the truncation of this local series limits the agreement to about ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", "\[Times]", 
    SuperscriptBox["10", 
     RowBox[{"-", "7"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "68d5aec7-352d-4404-a094-515e3e658576"],
 ". The fitted ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "24398a76-a2ec-424d-a5fa-c528026cfb01"],
 " of the Landau form differs from ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["Tay",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d0f465e6-ef44-433a-9185-815aad7a8bdf"],
 " by 0.7 to 2 per cent: it is a property of the fit."
}], "Text",ExpressionUUID->"407d5fe8-ab9e-4859-b190-1d2106ccb24c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"lfTaylor", "[", "t", "]"}], ":", " ", 
    RowBox[{
     RowBox[{"a", "^", "Tay"}], " ", "estimated", " ", "from", " ", "the", " ",
      "points", " ", "2", " ", "to", " ", "7", " ", "of", " ", "the", " ", 
     "curve", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"the", " ", "first", " ", "point", " ", "is", " ", "Phi"}], 
       " ", "=", " ", "0"}], ")"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"lfTaylor", "[", "t_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"p", " ", "=", " ", 
         RowBox[{
          RowBox[{"lfCurve", "[", "t", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"2", " ", ";;", " ", "7"}], "]"}], "]"}]}], "}"}], ",", 
       " ", 
       RowBox[{
        RowBox[{"LeastSquares", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", " ", 
              RowBox[{"x", "^", "2"}], ",", " ", 
              RowBox[{"x", "^", "4"}]}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"x", ",", " ", 
              RowBox[{"p", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], "}"}]}], 
           "]"}], ",", " ", 
          RowBox[{
           RowBox[{"p", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "/", 
           RowBox[{
            RowBox[{"p", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], "^", "2"}]}]}], 
         "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{"\"\<WP3-10 \>\"", " ", "<>", " ", "t"}], ",", " ", 
        RowBox[{
         RowBox[{"lfName", "[", "t", "]"}], " ", "<>", 
         " ", "\"\<: the coefficient of Phi^2 of the Taylor series at the \
origin from the first six points of the curve = the Rust value a^Tay = \>\"", 
         " ", "<>", " ", 
         RowBox[{"ToString", "[", 
          RowBox[{"rustPart3", "[", 
           RowBox[{"\"\<p3_a_taylor_\>\"", " ", "<>", " ", "t"}], "]"}], 
          "]"}], " ", "<>", " ", "\"\< (relative)\>\""}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"lfTaylor", "[", "t", "]"}], " ", "-", " ", 
           RowBox[{"rustPart3", "[", 
            RowBox[{"\"\<p3_a_taylor_\>\"", " ", "<>", " ", "t"}], "]"}]}], 
          "]"}], "/", 
         RowBox[{"Abs", "[", 
          RowBox[{"rustPart3", "[", 
           RowBox[{"\"\<p3_a_taylor_\>\"", " ", "<>", " ", "t"}], "]"}], 
          "]"}]}], ",", " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "6"}]}], ",", " ", 
        RowBox[{"\"\<P3-10 \>\"", " ", "<>", " ", "t"}], ",", " ", 
        RowBox[{"\"\<YP3-10 \>\"", " ", "<>", " ", "t"}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"t", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<HS_1_1\>\"", ",", " ", "\"\<CJT\>\""}], "}"}]}], 
       "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"lfName", "[", "t", "]"}], ",", " ", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{"lfTaylor", "[", "t", "]"}], ",", " ", "10"}], "]"}], ",",
            " ", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{"rustPart3", "[", 
              RowBox[{"\"\<p3_a_taylor_\>\"", " ", "<>", " ", "t"}], "]"}], ",",
              " ", "10"}], "]"}], ",", " ", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"lfResults", "[", "t", "]"}], "[", "\"\<a\>\"", "]"}], ",",
              " ", "10"}], "]"}], ",", " ", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{"100", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"lfResults", "[", "t", "]"}], "[", "\"\<a\>\"", 
                  "]"}], "/", 
                 RowBox[{"rustPart3", "[", 
                  RowBox[{"\"\<p3_a_taylor_\>\"", " ", "<>", " ", "t"}], 
                  "]"}]}], " ", "-", " ", "1"}], ")"}]}], ",", " ", "3"}], 
            "]"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"t", ",", " ", "lfTags"}], "}"}]}], "]"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<method\>\"", ",", " ", "\"\<a^Tay from the curve\>\"", ",",
          " ", "\"\<a^Tay of the Rust program\>\"", ",", 
         " ", "\"\<a of the Landau form\>\"", ",", 
         " ", "\"\<a/a^Tay - 1 (per cent)\>\""}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "All"}]}], "]"}]}]}]], "Input",
 CellLabel->
  "In[311]:=",ExpressionUUID->"99190b8b-c7d7-4e43-8b16-7560368d1878"],

