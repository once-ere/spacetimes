Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"CJT", ":", " ", 
     RowBox[{
     "the", " ", "gradient", " ", "coefficient", " ", "with", " ", "40", " ", 
      "radial", " ", "nodes", " ", 
      RowBox[{"(", 
       RowBox[{
       "a", " ", "model", " ", "of", " ", "the", " ", "same", " ", "contact", 
        " ", "terms", " ", "on", " ", "the", " ", "grid", " ", "of", " ", 
        "40", " ", "x", " ", "6", " ", "momenta"}], ")"}], "\n", "   ", "and",
       " ", "on", " ", "the", " ", "product", " ", "rule", " ", "of", " ", 
      "the", " ", "sphere", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"144", " ", "directions"}], ",", " ", 
        RowBox[{"24", " ", "radial", " ", "nodes"}]}], ")"}]}]}], ",", " ", 
    RowBox[{"against", " ", "the", " ", "six", " ", "directions"}]}], " ", 
   "*)"}], "\n", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"tc", " ", "=", " ", 
        RowBox[{"thTc", "[", "\"\<CJT\>\"", "]"}]}], ",", " ", 
       RowBox[{"ts", " ", "=", " ", 
        RowBox[{
         RowBox[{"thModel", "[", "\"\<CJT\>\"", "]"}], "[", "\"\<ts\>\"", 
         "]"}]}], ",", " ", "mo40", ",", " ", "n40", ",", " ", "a40", ",", 
       " ", "c40", ",", " ", "cProd", ",", " ", 
       RowBox[{"c6", " ", "=", " ", 
        RowBox[{
         RowBox[{"gzResults", "[", "\"\<CJT\>\"", "]"}], "[", "\"\<c\>\"", 
         "]"}]}]}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"mo40", " ", "=", " ", 
       RowBox[{"makeModel", "[", 
        RowBox[{"ts", ",", " ", "40"}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"n40", " ", "=", " ", 
       RowBox[{
        RowBox[{"solveSFT", "[", 
         RowBox[{
         "mo40", ",", " ", "zero8", ",", " ", "zero8", ",", " ", "tc", ",", 
          " ", "0.6", ",", " ", 
          RowBox[{"10", "^", 
           RowBox[{"-", "14"}]}]}], "]"}], "[", "\"\<n\>\"", "]"}]}], ";", 
      "\n", "  ", 
      RowBox[{
       RowBox[{"a40", "[", "q_", "]"}], " ", ":=", " ", 
       RowBox[{
        RowBox[{"gzQuad", "[", 
         RowBox[{"ts", ",", " ", 
          RowBox[{"gzResponse", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"mo40", "[", "\"\<g\>\"", "]"}], "[", "\"\<q\>\"", "]"}],
             ",", " ", 
            RowBox[{
             RowBox[{"mo40", "[", "\"\<g\>\"", "]"}], "[", "\"\<w\>\"", "]"}],
             ",", " ", "n40", ",", " ", 
            RowBox[{"gzTwist", "[", 
             RowBox[{"q", ",", " ", 
              RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}], ",", " ", 
            "tc"}], "]"}]}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"c40", " ", "=", " ", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"a0", " ", "=", " ", 
            RowBox[{"a40", "[", "0.", "]"}]}], ",", " ", "c1", ",", " ", 
           "c2"}], "}"}], ",", " ", 
         RowBox[{
          RowBox[{"c1", " ", "=", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"a40", "[", "0.005", "]"}], " ", "-", " ", "a0"}], 
             ")"}], "/", 
            RowBox[{"0.01", "^", "2"}]}]}], ";", " ", 
          RowBox[{"c2", " ", "=", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"a40", "[", "0.01", "]"}], " ", "-", " ", "a0"}], ")"}],
             "/", 
            RowBox[{"0.02", "^", "2"}]}]}], ";", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"4", " ", "c1"}], " ", "-", " ", "c2"}], ")"}], "/", 
           "3"}]}]}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"cProd", " ", "=", " ", 
       RowBox[{
        RowBox[{"gzGrad", "[", 
         RowBox[{"\"\<CJT\>\"", ",", " ", 
          RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", " ", "2.", ",", " ",
           "True", ",", " ", "gzSphere"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"check", "[", 
       RowBox[{"\"\<WP3-G8\>\"", ",", " ", 
        RowBox[{"\"\<CJT: the gradient coefficient does not depend on the \
quadrature: six directions and 24 radial nodes \>\"", " ", "<>", " ", 
         RowBox[{"ToString", "[", 
          RowBox[{"NumberForm", "[", 
           RowBox[{"c6", ",", " ", "12"}], "]"}], "]"}], " ", "<>", 
         " ", "\"\<, 144 directions \>\"", " ", "<>", " ", 
         RowBox[{"ToString", "[", 
          RowBox[{"NumberForm", "[", 
           RowBox[{"cProd", ",", " ", "12"}], "]"}], "]"}], " ", "<>", 
         " ", "\"\<, 40 radial nodes \>\"", " ", "<>", " ", 
         RowBox[{"ToString", "[", 
          RowBox[{"NumberForm", "[", 
           RowBox[{"c40", ",", " ", "12"}], "]"}], "]"}], " ", "<>", 
         " ", "\"\< (largest relative difference)\>\""}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"cProd", " ", "-", " ", "c6"}], "]"}], ",", " ", 
           RowBox[{"Abs", "[", 
            RowBox[{"c40", " ", "-", " ", "c6"}], "]"}]}], "]"}], "/", "c6"}],
         ",", " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "8"}]}], ",", " ", "\"\<P3-G8\>\"", ",", 
        " ", "\"\<YP3-G8 CJT\>\""}], "]"}]}]}], "]"}], ";"}]}]], "Input",
 CellLabel->
  "In[392]:=",ExpressionUUID->"e9065e05-711e-41a0-ab4e-d22713112c0c"],

