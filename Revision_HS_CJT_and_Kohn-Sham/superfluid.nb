Cell[CellGroupData[{

Cell["III.L.4 The fit and its residual", "Section",ExpressionUUID->"7dbbf749-f803-4c94-bf6a-b7e831b7e0de"],

Cell[TextData[{
 StyleBox["\"The Landau form is a fit.\"",
  FontWeight->"Bold"],
 " The coefficients ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e3bf8e0c-6409-432c-820b-d29ecb1dfe08"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["b", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "71aa921f-4e4e-4866-ab1e-553d9ddf3576"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "478a380a-d492-493b-b715-e72aeb3b9112"],
 " are not derived from the theory: they minimize the sum of the squares of \
the residuals ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["\[ScriptCapitalV]",
      FontSlant->"Plain"], 
     StyleBox["L",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubscriptBox["\[CapitalPhi]", 
      StyleBox["i", "TI"]], ")"}], "-", 
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalV]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], 
    RowBox[{"(", 
     SubscriptBox["\[CapitalPhi]", 
      StyleBox["i", "TI"]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2e4ae1f9-5536-46aa-be74-8bd263fe6fb6"],
 " over the computed points ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPhi]", 
     StyleBox["i", "TI"]], "\[LessEqual]", "1.4", 
    SubsuperscriptBox["\[CapitalPhi]", 
     RowBox[{"0", ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2ac054b3-4176-4611-af38-7e611c9a8762"],
 ". ",
 StyleBox["\"Its largest residual is 0.27-0.7 % of the depth.\"",
  FontWeight->"Bold"],
 " The largest of these residuals, divided by the depth, lies between these \
two numbers for the five methods. The next cell defines the least squares \
(the function ",
 StyleBox["LeastSquares",
  FontFamily->"Source Code Pro"],
 " of the Wolfram Language on the columns ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["t", "TI"], 
    StyleBox["k", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f0b252d0-6374-4255-ba26-afbd5f6b8a71"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["t", "TI"], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"\[CapitalPhi]", "/", 
       SubscriptBox["\[CapitalPhi]", 
        StyleBox["max",
         FontSlant->"Plain"]]}], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0c238bc5-97da-4941-bde2-252361b8c41c"],
 ", which keeps the fits with many powers well conditioned) and computes, for \
each method: the minimum ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPhi]", 
    StyleBox["L",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c47189a3-fbec-43d3-9a46-b8919aa0558b"],
 " of the fitted polynomial, its value and its second derivative there; the \
largest residual of the fits ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["k", "TI"], "\[LongEqual]", "1"}], 
     StyleBox["K", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["c", "TI"], 
     StyleBox["k", "TI"]], 
    SuperscriptBox["\[CapitalPhi]", 
     RowBox[{"2", 
      StyleBox["k", "TI"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "53aa38a5-a3df-478e-83eb-7d068a0c6985"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["K", "TI"], "\[LongEqual]", "2"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d5bdb898-ae40-4672-b83e-46a39a14a576"],
 " (the quartic form of the Standard Model) to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["K", "TI"], "\[LongEqual]", "6"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ea851af7-f514-40ee-8f90-6855cc01c776"],
 " (powers to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CapitalPhi]", "12"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7d4d483e-1e95-4645-ab30-1cc6c69651c7"],
 "); the number of sign changes of the residual of the Landau form; and the \
Landau form fitted on three intervals, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"0", ",", 
     SubsuperscriptBox["\[CapitalPhi]", 
      RowBox[{"0", ",", 
       StyleBox["SF",
        FontSlant->"Plain"]}], 
      StyleBox["X", "TI"]]}], "]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "863d1941-bad1-4d80-9156-68ab19f5fa37"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"0", ",", "1.4", 
     SubsuperscriptBox["\[CapitalPhi]", 
      RowBox[{"0", ",", 
       StyleBox["SF",
        FontSlant->"Plain"]}], 
      StyleBox["X", "TI"]]}], "]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e3bb08c7-d4cf-4f7a-90e4-f7aedf880168"],
 " and the whole curve. Every number is compared with that of the Rust \
program, which computes it with Householder reflections; the Python program \
computes it a third time with the singular-value decomposition."
}], "Text",ExpressionUUID->"944e8bcd-1a35-4921-ba13-c69f7dfb8770"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"evenFit", "[", 
        RowBox[{"pts", ",", " ", "kk"}], "]"}], ":", " ", 
       RowBox[{
        RowBox[{"the", " ", "least"}], "-", 
        RowBox[{"squares", " ", "fit", " ", "V"}]}]}], " ", "=", " ", 
      RowBox[{"sum_", 
       RowBox[{"{", 
        RowBox[{"k", "=", 
         RowBox[{
          RowBox[{"1", ".."}], "kk"}]}], "}"}], " ", "c_k", " ", 
       RowBox[{"Phi", "^", 
        RowBox[{"(", 
         RowBox[{"2", "k"}], ")"}]}], " ", "to", " ", "the", " ", "points", " ", 
       RowBox[{"{", 
        RowBox[{"Phi", ",", " ", "V"}], "}"}]}]}], ";", " ", 
     RowBox[{"returns", " ", "the", "\n", "   ", "coefficients", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"c_", "1"}], ",", " ", "...", ",", " ", "c_kk"}], "}"}]}]}], ",",
     " ", 
    RowBox[{
    "the", " ", "largest", " ", "residual", " ", "and", " ", "the", " ", 
     "list", " ", "of", " ", "the", " ", "residuals", " ", 
     RowBox[{"(", 
      RowBox[{"fit", " ", "minus", " ", "computed", " ", "value"}], ")"}]}]}],
    " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"evenFit", "[", 
      RowBox[{"pts_", ",", " ", "kk_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", " ", "=", " ", 
          RowBox[{"pts", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], ",", " ", 
         RowBox[{"y", " ", "=", " ", 
          RowBox[{"pts", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], ",", " ", "xm", ",",
          " ", "a", ",", " ", "d", ",", " ", "c", ",", " ", "r"}], "}"}], ",",
        "\n", "   ", 
       RowBox[{
        RowBox[{"xm", " ", "=", " ", 
         RowBox[{"Max", "[", "x", "]"}]}], ";", "\n", "   ", 
        RowBox[{"a", " ", "=", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"xi", "/", "xm"}], ")"}], "^", 
            RowBox[{"(", 
             RowBox[{"2", " ", "k"}], ")"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"xi", ",", " ", "x"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"k", ",", " ", "kk"}], "}"}]}], "]"}]}], ";", "        ", 
        
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{"the", " ", "columns", " ", 
           RowBox[{"t", "^", "k"}], " ", "with", " ", "t"}], " ", "=", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"Phi", "/", "Phi_max"}], ")"}], "^", "2"}]}], " ", "*)"}],
         "\n", "   ", 
        RowBox[{"d", " ", "=", " ", 
         RowBox[{"LeastSquares", "[", 
          RowBox[{"a", ",", " ", "y"}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"c", " ", "=", " ", 
         RowBox[{"d", "/", 
          RowBox[{"xm", "^", 
           RowBox[{"(", 
            RowBox[{"2", " ", 
             RowBox[{"Range", "[", "kk", "]"}]}], ")"}]}]}]}], ";", 
        "                            ", 
        RowBox[{"(*", " ", 
         RowBox[{
         "back", " ", "to", " ", "the", " ", "coefficients", " ", "of", " ", 
          RowBox[{"Phi", "^", 
           RowBox[{"(", 
            RowBox[{"2", "k"}], ")"}]}]}], " ", "*)"}], "\n", "   ", 
        RowBox[{"r", " ", "=", " ", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"c", "[", 
                RowBox[{"[", "k", "]"}], "]"}], " ", 
               RowBox[{"xi", "^", 
                RowBox[{"(", 
                 RowBox[{"2", " ", "k"}], ")"}]}]}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"k", ",", " ", "kk"}], "}"}]}], "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"xi", ",", " ", "x"}], "}"}]}], "]"}], " ", "-", " ", 
          "y"}]}], ";", "\n", "   ", 
        RowBox[{"{", 
         RowBox[{"c", ",", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", "r", "]"}], "]"}], ",", " ", "r"}], "}"}]}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"landauMin", "[", 
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "b", ",", " ", "c"}], "}"}], "]"}], ":", " ", 
      RowBox[{
       RowBox[{"the", " ", "minimum", " ", "Phi_L"}], " ", ">", " ", 
       RowBox[{
        RowBox[{"0", " ", "of", " ", "a", " ", 
         RowBox[{"Phi", "^", "2"}]}], " ", "+", " ", 
        RowBox[{"b", " ", 
         RowBox[{"Phi", "^", "4"}]}], " ", "+", " ", 
        RowBox[{"c", " ", 
         RowBox[{"Phi", "^", "6"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"the", " ", "positive", " ", "root", " ", "s"}], " ", "=", 
           " ", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Phi", "^", "2"}], " ", "of", "\n", "   ", "a"}], " ", "+",
              " ", 
             RowBox[{"2", " ", "b", " ", "s"}], " ", "+", " ", 
             RowBox[{"3", " ", "c", " ", 
              RowBox[{"s", "^", "2"}]}]}], " ", "=", " ", "0"}]}], 
          ")"}]}]}]}]}], ",", " ", 
     RowBox[{
      RowBox[{
      "the", " ", "value", " ", "of", " ", "the", " ", "polynomial", " ", 
       "there", " ", "and", " ", "its", " ", "second", " ", "derivative", " ",
        "2", " ", "a"}], " ", "+", " ", 
      RowBox[{"12", " ", "b", " ", 
       RowBox[{"Phi", "^", "2"}]}], " ", "+", " ", 
      RowBox[{"30", " ", "c", " ", 
       RowBox[{"Phi", "^", "4"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"landauMin", "[", 
      RowBox[{"{", 
       RowBox[{"a_", ",", " ", "b_", ",", " ", "c_"}], "}"}], "]"}], " ", ":=",
      " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"s", " ", "=", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "2"}], " ", "b"}], " ", "+", " ", 
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{"4", " ", 
               RowBox[{"b", "^", "2"}]}], " ", "-", " ", 
              RowBox[{"12", " ", "a", " ", "c"}]}], "]"}]}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"6", " ", "c"}], ")"}]}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Sqrt", "[", "s", "]"}], ",", " ", 
         RowBox[{
          RowBox[{"a", " ", "s"}], " ", "+", " ", 
          RowBox[{"b", " ", 
           RowBox[{"s", "^", "2"}]}], " ", "+", " ", 
          RowBox[{"c", " ", 
           RowBox[{"s", "^", "3"}]}]}], ",", " ", 
         RowBox[{
          RowBox[{"2", " ", "a"}], " ", "+", " ", 
          RowBox[{"12", " ", "b", " ", "s"}], " ", "+", " ", 
          RowBox[{"30", " ", "c", " ", 
           RowBox[{"s", "^", "2"}]}]}]}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"lfResults", "[", "t", "]"}], ":", " ", 
     RowBox[{
     "all", " ", "numbers", " ", "of", " ", "the", " ", "accuracy", " ", "of",
       " ", "the", " ", "Landau", " ", "form", " ", "for", " ", "the", " ", 
      "method", " ", "t"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"lfResults", " ", "=", " ", 
     RowBox[{"Association", "[", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{"t", ",", " ", 
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"pts", " ", "=", " ", 
