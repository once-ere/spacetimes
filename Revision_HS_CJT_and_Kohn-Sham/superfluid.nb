 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"17b6c58e-302d-4257-b053-70d8f6b38b65"],

Cell[TextData[{
 "for a bilinear term, and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["N",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"-", 
     SubscriptBox[
      StyleBox["G", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"]]}], 
    SubsuperscriptBox[
     StyleBox["w", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]], 
    StyleBox["\[ScriptCapitalP]",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        SuperscriptBox[
         StyleBox["K",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], "\[Iota]"], ")"}], "\[Dagger]"], 
      SuperscriptBox[
       OverscriptBox[
        StyleBox["C",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], "~"], 
       StyleBox["T", "TI"]], 
      SuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], "\[Iota]"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d361f528-fe66-42b8-8ca2-d1932186f390"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["P",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["w", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["P",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Iota]"], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "\[Iota]"], ")"}], "\[Dagger]"]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "76b6c722-b47b-4979-8018-43cf28eefeab"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Iota]"], "\[LongEqual]", 
    RowBox[{"-", 
     FractionBox["1", "2"]}], 
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    StyleBox["tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "\[Iota]"], 
      SuperscriptBox[
       RowBox[{"(", 
        SuperscriptBox[
         StyleBox["C",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], 
         StyleBox["p",
          FontSlant->"Plain"]], ")"}], 
       StyleBox["T", "TI"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "32532a93-9cc5-44a8-844d-71f62c3ec54e"],
 " for a pairing term. The state is the ground state of the matrix of \
Bogoliubov and de Gennes at every momentum,"
}], "Text",ExpressionUUID->"8028b73d-4efc-4c08-9db7-6eb0142e86bb"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["H",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"]], 
   RowBox[{"(", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["q", "TI"], "\[RightVector]"], 
     StyleBox["LL",
