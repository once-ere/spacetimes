Cell["II.2 The three methods and their numerical engine", "Section",ExpressionUUID->"a5c7af9b-735e-4a7b-9525-79b8f8de198e"],

Cell[TextData[{
 "All three methods approximate the state of the spinor field by a uniform \
quasi-free state: at every momentum ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox[
     StyleBox["q", "TI"], "\[RightVector]"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "84fc6bce-a511-43db-aafa-2397dbdd9081"],
 " the correlation matrices ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["C",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["n",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["q", "TI"], "\[RightVector]"], 
      StyleBox["LL",
       FontSlant->"Plain"]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "01607e1f-4ae5-4b80-9ecb-c4876c29b0f3"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["C",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["q", "TI"], "\[RightVector]"], 
      StyleBox["LL",
       FontSlant->"Plain"]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a276dc72-4ecf-4cc8-84e2-4b55d52f9ff6"],
 ", and their integrals over the momenta measured from the normal vacuum,"
}], "Text",ExpressionUUID->"4681fbfb-2814-4207-8105-3022a07717d7"],

