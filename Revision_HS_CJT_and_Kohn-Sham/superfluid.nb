Cell[CellGroupData[{

Cell["\<\
II.1 The pair channels and the gauge bosons that mediate the pairing\
\>", "Section",ExpressionUUID->"d342292f-7a6b-481d-91cd-60dc9d2c220b"],

Cell[TextData[{
 "The spin-zero pairs are the six antisymmetric unitary matrices ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "44355894-75f5-478f-b681-e50d74a35cde"],
 " (scalar, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["0", "+"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c033e31e-f377-4664-90e3-b53fc00e0d41"],
 ") and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     RowBox[{"\[Prime]", "\[Iota]"}]], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[CircleTimes]", 
    SubscriptBox[
     StyleBox["E",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Tau]", "\[Iota]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d1907533-3ecf-433b-b0bb-447e0e10168e"],
 " (pseudoscalar, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["0", "-"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0be880fb-6ad1-4143-8f64-d03c71fa3345"],
 "). The state of two spinor charges at one point in the channel ",
 Cell[BoxData[
  FormBox[
   StyleBox["K",
    FontFamily->"Helvetica",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "faf46068-5c9d-4a15-9862-80e46bf8a1e3"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftBracketingBar]", 
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "\[RightAngleBracket]", "\[Proportional]", 
    FractionBox["1", "2"], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["c", "TI"], 
      SuperscriptBox[
       StyleBox["c", "TI"], "\[Prime]"]}],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["c", "TI"], 
      SuperscriptBox[
       StyleBox["c", "TI"], "\[Prime]"]}], "*"], 
    SubsuperscriptBox["\[CapitalPsi]", 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["c", "TI"]}], "\[Dagger]"], 
    SubsuperscriptBox["\[CapitalPsi]", 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      SuperscriptBox[
       StyleBox["c", "TI"], "\[Prime]"]}], "\[Dagger]"], "\[LeftBracketingBar]",
     "0", "\[RightAngleBracket]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7ede8c1f-96b7-4426-8210-1158aa3f6581"],
 ", normalized, and the pair energy of a contact operator ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[ScriptCapitalO]",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7f657d9f-7ec3-426b-b451-f74a0758916f"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["pair",
      FontSlant->"Plain"]], 
    RowBox[{"[", 
     RowBox[{
      StyleBox["\[ScriptCapitalO]",
       FontSlant->"Plain"], ";", 
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"]}], "]"}], "\[LongEqual]", 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "\[RightBracketingBar]", 
      StyleBox["\[ScriptCapitalO]",
       FontSlant->"Plain"], "\[LeftBracketingBar]", 
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"]}], "\[RightAngleBracket]"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9ecf3a52-cb25-4605-b650-11e7e94b23c8"],
 ", per unit coupling; negative means attraction. The operators are the three \
terms of the potentials and the contact limit of the exchange of the four \
gauge bosons of GEE, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", 
     StyleBox["p", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox["\[Eta]", 
     StyleBox["pp", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], ":", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["\[CapitalPsi]", "\[Dagger]"], 
       SubsuperscriptBox[
        StyleBox["A",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["SF",
          FontSlant->"Plain"], ",", 
         StyleBox["p", "TI"]}], 
        StyleBox["b",
         FontSlant->"Plain"]], "\[CapitalPsi]"}], ")"}], "2"], ":"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "44529eb3-01d5-4e01-b97b-ae5ed35ee8d6"],
 " with the vertex matrices ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["A",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], 
     StyleBox["b",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["\[Gamma]", 
       StyleBox["LL",
        FontSlant->"Plain"], "0"], 
      SubsuperscriptBox["\[Gamma]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["p", "TI"]]}], ")"}], "\[CircleTimes]", 
    SubsuperscriptBox[
     StyleBox["t",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["b",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dee10022-5146-4bbe-95f0-c8a907a9d820"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["t",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["b",
      FontSlant->"Plain"]], "\[LongEqual]", 
    FractionBox["1", "2"], 
    SubsuperscriptBox["\[Tau]", "\[Iota]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c1b6fd54-a4e6-4875-a511-e7bbbf0c1359"],
 " for ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2f62eea5-9f03-42dc-a4b7-4b728a0a3551"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["1",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dcc67493-ad8d-4817-be82-9cf41e4f8e9b"],
 " for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f0ebc68d-7025-4f69-8629-0edafbbde176"],
 "). The result: the scalar term has ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e08b8076-50e4-4d38-8d93-1cf38261ab6f"],
 " in the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["0", "+"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0a065053-82b8-497e-b76f-3054b2f510d1"],
 " channels and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dbd1918f-a0c4-40bd-90ff-82f832e419f2"],
 " in the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["0", "-"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "145909c7-530e-439a-87a4-e837199141fb"],
 " channels, the vector term ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", "4"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5eecb917-b47f-4cc3-ad8e-72e3d1357b8b"],
 " everywhere, the pairing term ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "4"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3ca20e49-b299-4687-b4f7-c2541d810cef"],
 " in the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["0", "+"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c6e86b28-ced6-4481-8c19-c212b5761035"],
 " channels, each ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9263e21e-e034-4558-90ea-7dadc43afd2a"],
 " attracts (",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9e909795-b1eb-427d-a92d-db460d9f36a2"],
 ") in the two channels with the same index and repels (",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "eb428e24-207e-42bf-b6ad-c03e609b71aa"],
 ") in the other four, and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d2214867-e628-4a91-ad1a-8e2dd1874e48"],
 " repels (",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", "4"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e3d8f658-9832-4990-b50f-4c9c6d615da6"],
 ") everywhere. In every channel"
}], "Text",ExpressionUUID->"796efaaf-f856-4617-8d7f-e3d9321197c3"],

Cell[BoxData[
 FormBox[
  RowBox[{
   UnderoverscriptBox["\[Sum]", 
    RowBox[{"\[Iota]", "\[LongEqual]", "1"}], "3",
    LimitsPositioning->True], "\[ThinSpace]", 
   SubsuperscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["pair",
     FontSlant->"Plain"]], 
   RowBox[{"[", 
    RowBox[{
     SuperscriptBox[
      StyleBox["W", "TI"], "\[Iota]"], ";", 
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"]}], "]"}], "\[LongEqual]", 
   FractionBox["1", "4"], 
   SubsuperscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["pair",
     FontSlant->"Plain"]], 
   RowBox[{"[", 
    RowBox[{
     StyleBox["B", "TI"], ";", 
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"]}], "]"}], "\[LongEqual]", 
   RowBox[{"+", "1"}], ","}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"811b1875-2f6b-4b00-8f2d-747142bc282d"],

Cell[TextData[{
 "the isospin Casimir of a triplet pair (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["T", "TI"], "\[RightVector]"], "1"], "\[CenterDot]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["T", "TI"], "\[RightVector]"], "2"], "\[LongEqual]", 
    RowBox[{"+", 
     FractionBox["1", "4"]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d77967fb-a780-43ae-a1d3-3085d68cb9d0"],
 "): no gauge boson attracts a spin-zero pair in the symmetric vacuum. After \
the breaking of the symmetry in the channel ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5fab5343-feea-4ea4-b185-78558d8489e6"],
 ", the gauge field ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "18778481-29ab-49fa-99e0-f3ea57044338"],
 " of the unbroken generator stays massless (the photon of the superfluid) \
and attracts the two charges of the condensed pair, which carry the opposite \
charges ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["T", "TI"], "3"], "\[LongEqual]", 
    RowBox[{"\[PlusMinus]", 
     FractionBox["1", "2"]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "54c44c72-d8f0-435b-ba0f-2ca94ca47b1f"],
 ". The next cell computes the 42 pair energies exactly on the 256 states of \
one point (with the operators of Section I.5) and compares them with the \
table of the Rust program."
}], "Text",ExpressionUUID->"f9547add-07c9-4bfa-bc3a-c2ab80fab712"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"kPs", "[", "iota", "]"}], ":", " ", 
     RowBox[{"the", " ", "matrices", " ", 
      RowBox[{
       RowBox[{"K", "'"}], "^", "iota_LL"}]}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{"C_LL", " ", 
      RowBox[{"(", "x", ")"}], " ", "E_LL", " ", "tau_iota", " ", "of", " ", 
      "the", " ", "pseudoscalar", " ", "spin"}], "-", 
     RowBox[{"zero", " ", "pairs"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"kPs", "[", "iota_Integer", "]"}], " ", ":=", " ", 
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{"cLL", ",", " ", 
       RowBox[{"eLL", " ", ".", " ", 
        RowBox[{"sig", "[", 
         RowBox[{"[", 
          RowBox[{"iota", " ", "+", " ", "1"}], "]"}], "]"}]}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"pairState", "[", "k", "]"}], ":", " ", 
      RowBox[{
      "the", " ", "normalized", " ", "state", " ", "of", " ", "two", " ", 
       "charges", " ", "at", " ", "one", " ", "point", " ", "in", " ", "the", 
       " ", "channel", " ", "k"}], ":", " ", 
      RowBox[{
       RowBox[{"sum_ab", " ", "conj", 
        RowBox[{"(", "k_ab", ")"}], " ", 
        RowBox[{"c_a", "^", "dag"}], " ", 
        RowBox[{"c_b", "^", "dag"}]}], " ", "|", 
       RowBox[{"0", ">"}]}]}], ";", "\n", "   ", 
     RowBox[{
      RowBox[{"the", " ", "empty", " ", "state"}], " ", "|", 
      RowBox[{"0", ">", " ", 
       RowBox[{
       "is", " ", "the", " ", "first", " ", "basis", " ", "state"}]}]}]}], 
    " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"pairState", "[", "k_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"op", ",", " ", "w"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"op", " ", "=", " ", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"k", "[", 
               RowBox[{"[", 
                RowBox[{"a", ",", " ", "b"}], "]"}], "]"}], " ", "=!=", " ", 
              "0"}], ",", " ", 
             RowBox[{
              RowBox[{"Conjugate", "[", 
               RowBox[{"k", "[", 
                RowBox[{"[", 
                 RowBox[{"a", ",", " ", "b"}], "]"}], "]"}], "]"}], " ", 
              RowBox[{
               RowBox[{"cdOps", "[", 
                RowBox[{"[", "a", "]"}], "]"}], " ", ".", " ", 
               RowBox[{"cdOps", "[", 
                RowBox[{"[", "b", "]"}], "]"}]}]}], ",", " ", "0"}], "]"}], ",",
            " ", 
           RowBox[{"{", 
            RowBox[{"a", ",", " ", "8"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"b", ",", " ", "8"}], "}"}]}], "]"}]}], ";", "\n", "   ", 
        
        RowBox[{"w", " ", "=", " ", 
         RowBox[{"op", " ", ".", " ", 
          RowBox[{"UnitVector", "[", 
           RowBox[{"256", ",", " ", "1"}], "]"}]}]}], ";", "\n", "   ", 
        RowBox[{"w", "/", 
         RowBox[{"Norm", "[", "w", "]"}]}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"the", " ", "seven", " ", "contact", " ", 
     RowBox[{"operators", ":", " ", 
      RowBox[{
      "the", " ", "three", " ", "terms", " ", "of", " ", "the", " ", 
       "potentials", " ", "and", " ", "the", " ", "contact", " ", "limit", " ",
        "of", " ", "the", " ", "four", " ", "gauge", " ", "bosons"}]}]}], " ",
     "*)"}], "\n", 
   RowBox[{
    RowBox[{"channelOps", " ", "=", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<scalar\>\"", " ", "->", " ", 
        RowBox[{
         RowBox[{"1", "/", "2"}], " ", 
         RowBox[{"quartic", "[", 
          RowBox[{"beta8", ",", " ", "beta8"}], "]"}]}]}], ",", "\n", "   ", 
       RowBox[{"\"\<vector\>\"", " ", "->", " ", 
        RowBox[{
         RowBox[{"1", "/", "2"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"quartic", "[", 
            RowBox[{
             RowBox[{"IdentityMatrix", "[", "8", "]"}], ",", " ", 
             RowBox[{"IdentityMatrix", "[", "8", "]"}]}], "]"}], " ", "-", 
           " ", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{"quartic", "[", 
              RowBox[{
               RowBox[{"alpha8", "[", 
                RowBox[{"[", "j", "]"}], "]"}], ",", " ", 
               RowBox[{"alpha8", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}], ")"}]}]}], ",", 
       "\n", "   ", 
       RowBox[{"\"\<pairing\>\"", " ", "->", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "1"}], "/", "4"}], " ", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ConjugateTranspose", "[", 
             RowBox[{"piOps", "[", 
              RowBox[{"[", "k", "]"}], "]"}], "]"}], " ", ".", " ", 
            RowBox[{"piOps", "[", 
             RowBox[{"[", "k", "]"}], "]"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}]}]}]}], "|>"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"t", " ", "=", " ", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"sig", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "/", "2"}], ",", " ", 
              RowBox[{
               RowBox[{"sig", "[", 
                RowBox[{"[", "3", "]"}], "]"}], "/", "2"}], ",", " ", 
              RowBox[{
               RowBox[{"sig", "[", 
                RowBox[{"[", "4", "]"}], "]"}], "/", "2"}], ",", " ", 
              RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "}"}], "[", 
            RowBox[{"[", "b", "]"}], "]"}]}], ",", " ", 
          RowBox[{"name", " ", "=", " ", 
           RowBox[{
            RowBox[{"{", 
             
             RowBox[{"\"\<boson W1\>\"", ",", " ", "\"\<boson W2\>\"", ",", 
              " ", "\"\<boson W3\>\"", ",", " ", "\"\<boson B\>\""}], "}"}], "[", 
            RowBox[{"[", "b", "]"}], "]"}]}]}], "}"}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{"channelOps", "[", "name", "]"}], " ", "=", " ", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"1", "/", "2"}], " ", 
            RowBox[{"etaLL", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"p", " ", "+", " ", "1"}], ",", " ", 
               RowBox[{"p", " ", "+", " ", "1"}]}], "]"}], "]"}], " ", 
            RowBox[{"quartic", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"d8", "[", 
                RowBox[{
                 RowBox[{"gam", "[", "0", "]"}], " ", ".", " ", 
                 RowBox[{"gam", "[", "p", "]"}]}], "]"}], " ", ".", " ", 
               RowBox[{"i8", "[", "t", "]"}]}], ",", " ", 
              RowBox[{
               RowBox[{"d8", "[", 
                RowBox[{
                 RowBox[{"gam", "[", "0", "]"}], " ", ".", " ", 
                 RowBox[{"gam", "[", "p", "]"}]}], "]"}], " ", ".", " ", 
               RowBox[{"i8", "[", "t", "]"}]}]}], "]"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}]}], 
       "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"b", ",", " ", "4"}], "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "the", " ", "six", " ", "channels", " ", "and", " ", "their", " ", 
     "states"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"channelMats", " ", "=", " ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"\"\<K^\>\"", " ", "<>", " ", 
