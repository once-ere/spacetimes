Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", 
     RowBox[{"recursion", ":", " ", 
      RowBox[{
      "for", " ", "every", " ", "potential", " ", "and", " ", "method", " ", 
       "the", " ", "effective", " ", "couplings", " ", "and", " ", "the", " ",
        "ground", " ", "state", " ", 
       RowBox[{"(", 
        RowBox[{
        "the", " ", "lowest", " ", "of", " ", "three", "\n", "   ", 
         "starts"}], ")"}]}]}]}], ";", " ", 
    RowBox[{
     RowBox[{"groundSF", "[", "key", "]"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"model", ",", " ", "solution"}], "}"}]}], ";", " ", 
    RowBox[{
    "the", " ", "deviations", " ", "from", " ", "the", " ", "Rust", " ", 
     "values", " ", "are", " ", "collected", " ", "in", " ", "devSF"}]}], " ",
    "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"devSF", " ", "=", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<g\>\"", " ", "->", " ", "0."}], ",", " ", 
       RowBox[{"\"\<E\>\"", " ", "->", " ", "0."}], ",", " ", 
       RowBox[{"\"\<D\>\"", " ", "->", " ", "0."}], ",", " ", 
       RowBox[{"\"\<M\>\"", " ", "->", " ", "0."}], ",", " ", 
       RowBox[{"\"\<gap\>\"", " ", "->", " ", "0."}]}], "|>"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"groundSF", " ", "=", " ", 
     RowBox[{"<|", "|>"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"groundRows", " ", "=", " ", 
     RowBox[{"{", "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"pot", " ", "=", " ", 
           RowBox[{"potentialsSF", "[", "pn", "]"}]}], ",", " ", 
          RowBox[{"key", " ", "=", " ", 
           RowBox[{"pn", " ", "<>", " ", "\"\<_\>\"", " ", "<>", " ", 
            RowBox[{"shortName", "[", "m", "]"}]}]}], ",", " ", "gs", ",", 
          " ", "gp", ",", " ", "mo", ",", " ", "sols", ",", " ", "best", ",", 
          " ", "gap"}], "}"}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"gs", ",", " ", "gp"}], "}"}], " ", "=", " ", 
          RowBox[{"effCouplings", "[", 
           RowBox[{"m", ",", " ", 
            RowBox[{"Sequence", " ", "@@", " ", "pot"}]}], "]"}]}], ";", "\n",
          "   ", 
         RowBox[{
          RowBox[{"devSF", "[", "\"\<g\>\"", "]"}], " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{
            RowBox[{"devSF", "[", "\"\<g\>\"", "]"}], ",", " ", 
            RowBox[{"Abs", "[", 
             RowBox[{"gs", " ", "-", " ", 
              RowBox[{"rustPart2", "[", 
               RowBox[{"\"\<p2_gS_\>\"", " ", "<>", " ", "key"}], "]"}]}], 
             "]"}], ",", " ", 
            RowBox[{"Abs", "[", 
             RowBox[{"gp", " ", "-", " ", 
              RowBox[{"rustPart2", "[", 
               RowBox[{"\"\<p2_gP_\>\"", " ", "<>", " ", "key"}], "]"}]}], 
             "]"}]}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"mo", " ", "=", " ", 
          RowBox[{"makeModel", "[", 
           RowBox[{"terms", "[", 
            RowBox[{"m", ",", " ", 
             RowBox[{"Sequence", " ", "@@", " ", "pot"}]}], "]"}], "]"}]}], ";",
          "\n", "   ", 
         RowBox[{"sols", " ", "=", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"solveSF", "[", 
             RowBox[{"mo", ",", " ", "zero8", ",", " ", 
              RowBox[{"0.3", " ", 
               RowBox[{"ConjugateTranspose", "[", 
                RowBox[{"k8", "[", "3", "]"}], "]"}]}]}], "]"}], ",", " ", 
            RowBox[{"solveSF", "[", 
             RowBox[{"mo", ",", " ", 
              RowBox[{
               RowBox[{"-", "1."}], " ", "b8"}], ",", " ", "zero8"}], "]"}], ",",
             " ", 
            RowBox[{"solveSF", "[", 
             RowBox[{"mo", ",", " ", 
              RowBox[{"0.5", " ", "b8"}], ",", " ", "zero8"}], "]"}]}], 
           "}"}]}], ";", "\n", "   ", 
         RowBox[{"best", " ", "=", " ", 
          RowBox[{"First", "[", 
           RowBox[{"SortBy", "[", 
            RowBox[{"sols", ",", " ", 
             RowBox[{
              RowBox[{"#", "[", "\"\<e\>\"", "]"}], " ", "&"}]}], "]"}], 
           "]"}]}], ";", "\n", "   ", 
         RowBox[{
          RowBox[{"groundSF", "[", "key", "]"}], " ", "=", " ", 
          RowBox[{"{", 
           RowBox[{"mo", ",", " ", "best"}], "}"}]}], ";", "\n", "   ", 
         RowBox[{"gap", " ", "=", " ", 
          RowBox[{"gapSF", "[", 
           RowBox[{
            RowBox[{"best", "[", "\"\<n\>\"", "]"}], ",", " ", 
            RowBox[{"best", "[", "\"\<p\>\"", "]"}]}], "]"}]}], ";", "\n", 
         "   ", 
         RowBox[{
          RowBox[{"devSF", "[", "\"\<E\>\"", "]"}], " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{
            RowBox[{"devSF", "[", "\"\<E\>\"", "]"}], ",", " ", 
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"best", "[", "\"\<e\>\"", "]"}], " ", "-", " ", 
              RowBox[{"rustPart2", "[", 
               RowBox[{"\"\<p2_E_\>\"", " ", "<>", " ", "key"}], "]"}]}], 
             "]"}]}], "]"}]}], ";", "\n", "   ", 
         RowBox[{
          RowBox[{"devSF", "[", "\"\<D\>\"", "]"}], " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{
            RowBox[{"devSF", "[", "\"\<D\>\"", "]"}], ",", " ", 
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"dGap", "[", "best", "]"}], " ", "-", " ", 
              RowBox[{"rustPart2", "[", 
               RowBox[{"\"\<p2_D_\>\"", " ", "<>", " ", "key"}], "]"}]}], 
             "]"}]}], "]"}]}], ";", "\n", "   ", 
         RowBox[{
          RowBox[{"devSF", "[", "\"\<M\>\"", "]"}], " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{
            RowBox[{"devSF", "[", "\"\<M\>\"", "]"}], ",", " ", 
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"diracMass", "[", "best", "]"}], " ", "-", " ", 
              RowBox[{"rustPart2", "[", 
               RowBox[{"\"\<p2_M_\>\"", " ", "<>", " ", "key"}], "]"}]}], 
             "]"}]}], "]"}]}], ";", "\n", "   ", 
         RowBox[{
          RowBox[{"devSF", "[", "\"\<gap\>\"", "]"}], " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{
            RowBox[{"devSF", "[", "\"\<gap\>\"", "]"}], ",", " ", 
            RowBox[{"Abs", "[", 
             RowBox[{"gap", " ", "-", " ", 
              RowBox[{"rustPart2", "[", 
               RowBox[{"\"\<p2_gap_\>\"", " ", "<>", " ", "key"}], "]"}]}], 
             "]"}]}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"groundRows", ",", " ", 
           RowBox[{"{", 
            RowBox[{"pn", ",", " ", 
             RowBox[{"shortName", "[", "m", "]"}], ",", " ", "gs", ",", " ", 
             "gp", ",", " ", 
             RowBox[{
              RowBox[{"10", "^", "4"}], " ", 
              RowBox[{"best", "[", "\"\<e\>\"", "]"}]}], ",", " ", 
             RowBox[{"dGap", "[", "best", "]"}], ",", " ", 
             RowBox[{"diracMass", "[", "best", "]"}], ",", " ", "gap", ",", 
             " ", 
             RowBox[{"best", "[", "\"\<it\>\"", "]"}]}], "}"}]}], "]"}]}]}], 
       "]"}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"pn", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<V0\>\"", ",", " ", "\"\<V1\>\"", ",", 
