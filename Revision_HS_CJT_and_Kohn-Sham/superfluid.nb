Cell[CellGroupData[{

Cell["III.L.4 The fit and its residual", "Section",ExpressionUUID->"517e0c96-1eb0-4143-8ac9-9219722426cf"],

Cell[TextData[{
 StyleBox["\"The Landau form is a fit.\"",
  FontWeight->"Bold"],
 " The coefficients ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4e9113c6-39ff-458f-8c25-077d08be6dbd"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["b", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "186c3336-eb62-4ea1-869a-328526c3e1e6"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4fbc23a9-a06f-483a-b340-9c365bd2f057"],
 " are not derived from the theory: they minimize the sum of the squares of \
the residuals ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["\[ScriptCapitalV]",
      FontSlant->"Plain"], 
     StyleBox["L",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubscriptBox["\[CapitalPhi]", 
      StyleBox["i", "TI"]], ")"}], "-", 
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalV]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], 
    RowBox[{"(", 
     SubscriptBox["\[CapitalPhi]", 
      StyleBox["i", "TI"]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ef711660-0d98-4e2b-9130-ba65e50c16eb"],
 " over the computed points ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPhi]", 
     StyleBox["i", "TI"]], "\[LessEqual]", "1.4", 
    SubsuperscriptBox["\[CapitalPhi]", 
     RowBox[{"0", ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1e0b3a50-b88c-4d28-a581-829dbfed87ca"],
 ". ",
 StyleBox["\"Its largest residual is 0.27-0.7 % of the depth.\"",
  FontWeight->"Bold"],
 " The largest of these residuals, divided by the depth, lies between these \
two numbers for the five methods. The next cell defines the least squares \
(the function ",
 StyleBox["LeastSquares",
  FontFamily->"Source Code Pro"],
 " of the Wolfram Language on the columns ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["t", "TI"], 
    StyleBox["k", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3a090cea-6554-4630-bd88-1d871a5da61a"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["t", "TI"], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"\[CapitalPhi]", "/", 
       SubscriptBox["\[CapitalPhi]", 
        StyleBox["max",
         FontSlant->"Plain"]]}], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "98e5e762-8019-4eda-9725-aa7b8ea06e80"],
 ", which keeps the fits with many powers well conditioned) and computes, for \
each method: the minimum ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPhi]", 
    StyleBox["L",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "585b17bf-e855-43ff-9746-0397d53a81f7"],
 " of the fitted polynomial, its value and its second derivative there; the \
largest residual of the fits ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["k", "TI"], "\[LongEqual]", "1"}], 
     StyleBox["K", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["c", "TI"], 
     StyleBox["k", "TI"]], 
    SuperscriptBox["\[CapitalPhi]", 
     RowBox[{"2", 
      StyleBox["k", "TI"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1d702f8c-dbde-4535-805e-d1ab2f71f948"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["K", "TI"], "\[LongEqual]", "2"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "31f908c1-1816-4d57-b49a-5f61ae3bcae6"],
 " (the quartic form of the Standard Model) to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["K", "TI"], "\[LongEqual]", "6"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "15b7a040-1b04-43b6-a753-2e01c2c6785a"],
 " (powers to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CapitalPhi]", "12"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d2dd9dbf-11c6-47c2-a438-02203f80ad79"],
 "); the number of sign changes of the residual of the Landau form; and the \
Landau form fitted on three intervals, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"0", ",", 
     SubsuperscriptBox["\[CapitalPhi]", 
      RowBox[{"0", ",", 
       StyleBox["SF",
        FontSlant->"Plain"]}], 
      StyleBox["X", "TI"]]}], "]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8d29523a-3c28-4c78-908b-8af0d9f2ee6d"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"0", ",", "1.4", 
     SubsuperscriptBox["\[CapitalPhi]", 
      RowBox[{"0", ",", 
       StyleBox["SF",
        FontSlant->"Plain"]}], 
      StyleBox["X", "TI"]]}], "]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "29f4e7bf-9c6b-4eed-9352-6ce92142d4a5"],
 " and the whole curve. Every number is compared with that of the Rust \
program, which computes it with Householder reflections; the Python program \
computes it a third time with the singular-value decomposition."
}], "Text",ExpressionUUID->"7b7622f3-dea0-485b-a2c2-1236c13cfd1c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"evenFit", "[", 
        RowBox[{"pts", ",", " ", "kk"}], "]"}], ":", " ", 
       RowBox[{
        RowBox[{"the", " ", "least"}], "-", 
        RowBox[{"squares", " ", "fit", " ", "V"}]}]}], " ", "=", " ", 
      RowBox[{"sum_", 
       RowBox[{"{", 
        RowBox[{"k", "=", 
         RowBox[{
          RowBox[{"1", ".."}], "kk"}]}], "}"}], " ", "c_k", " ", 
       RowBox[{"Phi", "^", 
        RowBox[{"(", 
         RowBox[{"2", "k"}], ")"}]}], " ", "to", " ", "the", " ", "points", " ", 
       RowBox[{"{", 
        RowBox[{"Phi", ",", " ", "V"}], "}"}]}]}], ";", " ", 
     RowBox[{"returns", " ", "the", "\n", "   ", "coefficients", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"c_", "1"}], ",", " ", "...", ",", " ", "c_kk"}], "}"}]}]}], ",",
     " ", 
    RowBox[{
    "the", " ", "largest", " ", "residual", " ", "and", " ", "the", " ", 
     "list", " ", "of", " ", "the", " ", "residuals", " ", 
     RowBox[{"(", 
      RowBox[{"fit", " ", "minus", " ", "computed", " ", "value"}], ")"}]}]}],
    " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"evenFit", "[", 
      RowBox[{"pts_", ",", " ", "kk_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", " ", "=", " ", 
          RowBox[{"pts", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], ",", " ", 
         RowBox[{"y", " ", "=", " ", 
          RowBox[{"pts", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], ",", " ", "xm", ",",
          " ", "a", ",", " ", "d", ",", " ", "c", ",", " ", "r"}], "}"}], ",",
        "\n", "   ", 
       RowBox[{
        RowBox[{"xm", " ", "=", " ", 
         RowBox[{"Max", "[", "x", "]"}]}], ";", "\n", "   ", 
        RowBox[{"a", " ", "=", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"xi", "/", "xm"}], ")"}], "^", 
            RowBox[{"(", 
             RowBox[{"2", " ", "k"}], ")"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"xi", ",", " ", "x"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"k", ",", " ", "kk"}], "}"}]}], "]"}]}], ";", "        ", 
        
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{"the", " ", "columns", " ", 
           RowBox[{"t", "^", "k"}], " ", "with", " ", "t"}], " ", "=", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"Phi", "/", "Phi_max"}], ")"}], "^", "2"}]}], " ", "*)"}],
         "\n", "   ", 
        RowBox[{"d", " ", "=", " ", 
         RowBox[{"LeastSquares", "[", 
          RowBox[{"a", ",", " ", "y"}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"c", " ", "=", " ", 
         RowBox[{"d", "/", 
          RowBox[{"xm", "^", 
           RowBox[{"(", 
            RowBox[{"2", " ", 
             RowBox[{"Range", "[", "kk", "]"}]}], ")"}]}]}]}], ";", 
        "                            ", 
        RowBox[{"(*", " ", 
         RowBox[{
         "back", " ", "to", " ", "the", " ", "coefficients", " ", "of", " ", 
          RowBox[{"Phi", "^", 
           RowBox[{"(", 
            RowBox[{"2", "k"}], ")"}]}]}], " ", "*)"}], "\n", "   ", 
        RowBox[{"r", " ", "=", " ", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"c", "[", 
                RowBox[{"[", "k", "]"}], "]"}], " ", 
               RowBox[{"xi", "^", 
                RowBox[{"(", 
                 RowBox[{"2", " ", "k"}], ")"}]}]}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"k", ",", " ", "kk"}], "}"}]}], "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"xi", ",", " ", "x"}], "}"}]}], "]"}], " ", "-", " ", 
          "y"}]}], ";", "\n", "   ", 
        RowBox[{"{", 
         RowBox[{"c", ",", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", "r", "]"}], "]"}], ",", " ", "r"}], "}"}]}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"landauMin", "[", 
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "b", ",", " ", "c"}], "}"}], "]"}], ":", " ", 
      RowBox[{
       RowBox[{"the", " ", "minimum", " ", "Phi_L"}], " ", ">", " ", 
       RowBox[{
        RowBox[{"0", " ", "of", " ", "a", " ", 
         RowBox[{"Phi", "^", "2"}]}], " ", "+", " ", 
        RowBox[{"b", " ", 
         RowBox[{"Phi", "^", "4"}]}], " ", "+", " ", 
        RowBox[{"c", " ", 
         RowBox[{"Phi", "^", "6"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"the", " ", "positive", " ", "root", " ", "s"}], " ", "=", 
           " ", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Phi", "^", "2"}], " ", "of", "\n", "   ", "a"}], " ", "+",
              " ", 
             RowBox[{"2", " ", "b", " ", "s"}], " ", "+", " ", 
             RowBox[{"3", " ", "c", " ", 
              RowBox[{"s", "^", "2"}]}]}], " ", "=", " ", "0"}]}], 
          ")"}]}]}]}]}], ",", " ", 
     RowBox[{
      RowBox[{
      "the", " ", "value", " ", "of", " ", "the", " ", "polynomial", " ", 
       "there", " ", "and", " ", "its", " ", "second", " ", "derivative", " ",
        "2", " ", "a"}], " ", "+", " ", 
      RowBox[{"12", " ", "b", " ", 
       RowBox[{"Phi", "^", "2"}]}], " ", "+", " ", 
      RowBox[{"30", " ", "c", " ", 
       RowBox[{"Phi", "^", "4"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"landauMin", "[", 
      RowBox[{"{", 
       RowBox[{"a_", ",", " ", "b_", ",", " ", "c_"}], "}"}], "]"}], " ", ":=",
      " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"s", " ", "=", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "2"}], " ", "b"}], " ", "+", " ", 
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{"4", " ", 
               RowBox[{"b", "^", "2"}]}], " ", "-", " ", 
              RowBox[{"12", " ", "a", " ", "c"}]}], "]"}]}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"6", " ", "c"}], ")"}]}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Sqrt", "[", "s", "]"}], ",", " ", 
         RowBox[{
          RowBox[{"a", " ", "s"}], " ", "+", " ", 
          RowBox[{"b", " ", 
           RowBox[{"s", "^", "2"}]}], " ", "+", " ", 
          RowBox[{"c", " ", 
           RowBox[{"s", "^", "3"}]}]}], ",", " ", 
         RowBox[{
          RowBox[{"2", " ", "a"}], " ", "+", " ", 
          RowBox[{"12", " ", "b", " ", "s"}], " ", "+", " ", 
          RowBox[{"30", " ", "c", " ", 
           RowBox[{"s", "^", "2"}]}]}]}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"lfResults", "[", "t", "]"}], ":", " ", 
     RowBox[{
     "all", " ", "numbers", " ", "of", " ", "the", " ", "accuracy", " ", "of",
       " ", "the", " ", "Landau", " ", "form", " ", "for", " ", "the", " ", 
      "method", " ", "t"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"lfResults", " ", "=", " ", 
     RowBox[{"Association", "[", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{"t", ",", " ", 
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"pts", " ", "=", " ", 
               RowBox[{"lfFitted", "[", 
                RowBox[{"t", ",", " ", "1.4"}], "]"}]}], ",", " ", "fits", ",",
               " ", "mn", ",", " ", "r6", ",", " ", "big", ",", " ", "signs", 
              ",", " ", "top3", ",", " ", "rng"}], "}"}], ",", "\n", "      ", 
            RowBox[{
             RowBox[{"fits", " ", "=", " ", 
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{"evenFit", "[", 
                 RowBox[{"pts", ",", " ", "kk"}], "]"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"kk", ",", " ", "2", ",", " ", "6"}], "}"}]}], 
               "]"}]}], ";", "        ", 
             RowBox[{"(*", " ", 
              RowBox[{
               RowBox[{"K", " ", "=", " ", "2"}], ",", " ", "...", ",", " ", 
               RowBox[{"6", ";", " ", 
                RowBox[{"K", " ", "=", " ", 
                 RowBox[{
                 "3", " ", "is", " ", "the", " ", "Landau", " ", 
                  "form"}]}]}]}], " ", "*)"}], "\n", "      ", 
             RowBox[{"mn", " ", "=", " ", 
              RowBox[{"landauMin", "[", 
               RowBox[{"fits", "[", 
                RowBox[{"[", 
                 RowBox[{"2", ",", " ", "1"}], "]"}], "]"}], "]"}]}], ";", 
             "\n", "      ", 
             RowBox[{"r6", " ", "=", " ", 
              RowBox[{"fits", "[", 
               RowBox[{"[", 
                RowBox[{"2", ",", " ", "3"}], "]"}], "]"}]}], ";", "\n", 
             "      ", 
             RowBox[{"big", " ", "=", " ", 
              RowBox[{"Select", "[", 
               RowBox[{"r6", ",", " ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Abs", "[", "#", "]"}], " ", ">", " ", 
                  RowBox[{
                   RowBox[{"10", "^", 
                    RowBox[{"-", "3"}]}], " ", 
                   RowBox[{"Max", "[", 
                    RowBox[{"Abs", "[", "r6", "]"}], "]"}]}]}], " ", "&"}]}], 
               "]"}]}], ";", "   ", 
             RowBox[{"(*", " ", 
              RowBox[{
               RowBox[{"residuals", " ", "below", " ", "1", "e"}], "-", 
               RowBox[{
               "3", " ", "of", " ", "the", " ", "largest", " ", "are", " ", 
                "not", " ", "counted"}]}], " ", "*)"}], "\n", "      ", 
             RowBox[{"signs", " ", "=", " ", 
              RowBox[{"Count", "[", 
               RowBox[{
                RowBox[{"Differences", "[", 
                 RowBox[{"Sign", "[", "big", "]"}], "]"}], ",", " ", 
                RowBox[{"d_", " ", "/;", " ", 
                 RowBox[{"d", " ", "!=", " ", "0"}]}]}], "]"}]}], ";", "\n", 
             "      ", 
             RowBox[{"top3", " ", "=", " ", 
              RowBox[{
               RowBox[{"Max", "[", 
                RowBox[{
                 RowBox[{"lfCurve", "[", "t", "]"}], "[", 
                 RowBox[{"[", 
