Cell[CellGroupData[{

Cell["III.L.6 Why it matters", "Section",ExpressionUUID->"f73f2dcb-2ad7-4c64-b6a2-9c630ce77f39"],

Cell[TextData[{
 StyleBox["It enters no other result.",
  FontWeight->"Bold"],
 " The effective Lagrangians of the solution contain the computed function ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalV]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fe07a3c2-a453-4007-b610-9a3f27976891"],
 ", not the Landau form, and no other result uses ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "969a5b8b-df4c-43de-966a-f086bdd3d958"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["b", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "99989532-0645-4697-b3d1-69bad6b6d60f"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e6de9593-133c-45bf-994a-f43e57ce2dbd"],
 ": the mass of the amplitude mode uses the curvature ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalV]",
     FontSlant->"Plain"], 
    StyleBox["amp",
     FontSlant->"Plain"], "\[Prime]\[Prime]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7e16e6b0-96f4-4a67-97e3-1e1f91ae5e95"],
 " of the computed curve, ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["u", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ed4ab5ce-78c0-4ff3-9c24-caac8feb59f9"],
 " and the mass of the non-unitary modes use the computed curvature in the \
non-unitary direction, and the masses of the gauge bosons and the dynamics \
use ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalPhi]", 
    RowBox[{"0", ",", 
     StyleBox["SF",
      FontSlant->"Plain"]}], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2e7ef741-373f-4380-ae98-5d11638a20b1"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["Z", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c23db281-e985-4fb8-809c-a62f77492cad"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["Y", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "00d1e093-d68d-4f88-901a-6dc7a1b76a8f"],
 " and the susceptibilities."
}], "ItemNumbered",ExpressionUUID->"2309d737-742f-4b41-9746-2aaac346db30"],

Cell[TextData[{
 StyleBox["It matters to whoever replaces $\\mathcal V^X_{\\rm SF}$ by the \
Landau form",
  FontWeight->"Bold"],
 ", as in a model of the type of Ginzburg and Landau or of Higgs: the minimum \
of the polynomial is 0.04 to 0.11 per cent too small, its depth 0.12 to 0.31 \
per cent too large, its curvature at its minimum 0.86 to 2.3 per cent too \
large, and the mass of the amplitude mode 0.43 to 1.1 per cent too large (the \
table above). A derivative enlarges the relative error of the function. \
Beyond the fitted interval the error grows: fitted on the whole computed \
curve, the form misses by 1.2 to 1.7 per cent of the depth."
}], "ItemNumbered",ExpressionUUID->"c55922a3-9854-4a3f-9f4b-8ae7869339f6"],

Cell[TextData[{
 StyleBox["The coefficients are not constants of the theory.",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6d99e1b8-0d9c-4f45-a936-e5ab15da8b88"],
 " differs from the Taylor coefficient at the origin, and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["b", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6fe4989f-1b1f-4687-9aeb-1d8c4be5eaf8"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6329d1b1-4012-4e90-96ff-c88072facb3d"],
 " change with the fitted interval and with the number of powers (the last \
four rows of the table). No physical meaning may be given to ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["b", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0c337921-50d9-41a7-88f7-929ade96a06d"],
 " or ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b19b8a89-f1ff-45c3-b94a-36298f609d58"],
 " alone. The physical quantities are those that the computed function \
defines: ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalPhi]", 
    RowBox[{"0", ",", 
     StyleBox["SF",
      FontSlant->"Plain"]}], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "53ac3bf6-5c13-4260-af33-93bb47ec8bf0"],
 ", the depth, the curvatures at the minimum, and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["Tay",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f9e35cab-0fbb-423f-9ede-14e55f7598bf"],
 "."
}], "ItemNumbered",ExpressionUUID->"12775a4d-6bfd-4ec3-aa2d-8701341d6073"],

Cell[TextData[{
 StyleBox["The qualitative results do not depend on the fit.",
  FontWeight->"Bold"],
 " That ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalV]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3452bfa9-1d6c-447a-a644-8438782a45aa"],
 " vanishes at the origin, is negative near it, has its minimum at ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalPhi]", 
    RowBox[{"0", ",", 
     StyleBox["SF",
      FontSlant->"Plain"]}], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "20f61626-9c80-4480-b61f-00e4dbbe6c50"],
 ", depends only on the two invariants, and has a stable polar minimum (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["u", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], ">", "0"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "63add5cb-7ed2-4a09-846d-20899f9a90f6"],
 ") are properties of the computed function, checked on it directly; the sign \
of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "664f586f-576b-4052-8104-35167e5c54db"],
 " is that of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["Tay",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "08d1c2bc-b312-45bf-8b14-f61da08cc34f"],
 " (negative: the normal vacuum is unstable)."
}], "ItemNumbered",ExpressionUUID->"8d43e20a-c5ed-49f3-bcb4-2db1d8c8e58b"],

Cell[TextData[{
 StyleBox["The comparison with the Standard Model.",
  FontWeight->"Bold"],
 " The field has a Mexican hat with the symmetry structure of the Higgs \
sector and of the polar phase of a condensate of spin 1, but its potential is \
not the quartic potential of the Standard Model: the quartic form misses ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalV]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1c689c52-93c5-4ed9-9171-1e57acaec675"],
 " by 2.8 to 5.9 per cent of the depth, about ten times more than the Landau \
form with the sixth power."
}], "ItemNumbered",ExpressionUUID->"55de2cd9-65d2-4542-a0fe-d8362282a94a"],

Cell[TextData[{
 StyleBox["Corrections of the first answers.",
  FontWeight->"Bold"],
 " The first answers to the author contained five statements that were not \
exact; the numbers of this chapter are the corrected ones. (1) The residual \
changes its sign three times, not five. (2) The fit called a fit on ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"0", ",", "2", 
     SubscriptBox["\[CapitalPhi]", "0"]}], "]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3cca820e-97c9-4c31-a76a-ae1f6e706115"],
 " used all 61 points of the curve, whose fields reach 1.52 to 1.64 times ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalPhi]", 
    RowBox[{"0", ",", 
     StyleBox["SF",
      FontSlant->"Plain"]}], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5cc2bf25-be6b-4196-b960-eb171fc5fd75"],
 "; the applied field, not the field of the states, reaches ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    SubsuperscriptBox["\[CapitalPhi]", 
     RowBox[{"0", ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "58bc534f-e119-46bc-9743-a5f95a5104c4"],
 ". (3) The range of the end of the curve is 1.52 to 1.64 (HS ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "0"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fd212d7b-0828-4d71-a115-ac8b2b2fb39e"],
 "), not 1.52 to 1.61. (4) The singularity lies at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"], "2"], "\[LongEqual]", 
    RowBox[{"-", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["M", "TI"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["X", "TI"], ",", 
         StyleBox["D",
          FontSlant->"Plain"]}]], ")"}], "2"]}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "51460f95-20eb-4660-b4f0-889424cea11e"],
 " in the applied field; in the field of the states the radius of convergence \
is of the order of the Dirac mass, not equal to it. (5) The errors of the \
curvature quoted first, 1.1 to 2.7 per cent, are those of the polynomial at \
the minimum of the computed curve; at the polynomial's own minimum, where a \
user evaluates it, they are 0.86 to 2.3 per cent, as the table shows."
}], "Text",ExpressionUUID->"2a089795-89bf-4a68-80f7-8de3eaabbec5"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Part III, second section. The free energy at finite temperature: the critical \
temperatures and the size of the order parameter\
\>", "Chapter",ExpressionUUID->"c5bcc709-c345-419f-96b9-52cf854b6bd7"],

Cell[TextData[{
 "On 21 November 2026 the author asked to add to the analysis and the \
solution the effective potential and the free energy of each of the five \
computed methods ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "76e47eb4-c7e2-4c68-a5ae-ac850acedc12"],
 " (HS ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"1", ",", "1"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e9dc0cd1-b8f6-4b6e-bb2f-734f1a42345c"],
 ", HS ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "1"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6b7ad488-8076-4799-b021-48c205627d10"],
 ", HS ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "0"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "14d56c18-e776-47f1-b1bf-0e342fe0dfa6"],
 ", KS and CJT), to determine whether the order parameter is then smaller and \
more physically reasonable, and to document this addendum with its \
provenance. The effective potential of each method is the subject of Section \
III.L. This chapter computes the free energy at the temperature ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4647b423-89e0-4e5f-8427-0784bc50b26d"],
 " with the engine of Part II, shows that its value at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "042c633d-90c2-4da7-89a2-3c732fd50efb"],
 " is the effective potential, finds the critical temperatures, and answers \
the question (Section III.T.6). The Rust program ",
 StyleBox["sf_part3",
  FontFamily->"Source Code Pro"],
 " (module ",
 StyleBox["thermal",
  FontFamily->"Source Code Pro"],
 ") and the Python program ",
 StyleBox["sf_part3.py",
  FontFamily->"Source Code Pro"],
 " compute the same things; the closed cell of Section III.T.2 holds their \
values for the comparison."
}], "Text",ExpressionUUID->"931b4b38-3084-4ff3-aecc-63ee9af5d784"],

Cell[CellGroupData[{

Cell["III.T.1 The free energy of a state at the temperature T", "Section",ExpressionUUID->"67951e73-a29f-4c75-b598-a58cbea911dc"],

Cell[TextData[{
 StyleBox["Units and conditions.",
  FontWeight->"Bold"],
 " The temperature ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4bc463a5-8f5f-422d-b627-3e90bbeb427e"],
 " is measured in units of energy (Boltzmann's constant ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["k", "TI"], 
     StyleBox["B",
      FontSlant->"Plain"]], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8635bda2-4066-4cd0-9c3d-4871655a455b"],
 "), in the units of the project (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "605771d9-d544-46bc-b758-b1a995199898"],
 "). The chemical potential ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Mu]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5a577c59-f539-4539-99b9-0c3a330a2893"],
 " of the fermion number is zero, as everywhere in the solution: the states \
hold as many particles as antiparticles. ",
 StyleBox["The thermal states.",
  FontWeight->"Bold"],
 " At the temperature ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7202d75c-61e2-4928-8c8d-ba38553787fc"],
 " a uniform quasi-free state is the thermal state of its matrix of \
Bogoliubov and de Gennes ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["H",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a26fbf2f-2550-455a-a018-11b31ef608e2"],
 " (Section II.2): at every momentum its generalized density, the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"16", "\[Times]", "16"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b51aa506-38be-4c93-a6a8-b97b2fd9d257"],
 " matrix of the normal and the pair correlations, is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["f", "TI"], 
    RowBox[{"(", 
     SubscriptBox[
      StyleBox["H",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["SF",
       FontSlant->"Plain"]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f0bdded4-9699-4dfb-9e91-cd8a3a0505c6"],
 ", the Fermi function ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["f", "TI"], 
    RowBox[{"(", "\[CurlyEpsilon]", ")"}], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        StyleBox["e", "TI"], 
        RowBox[{"\[CurlyEpsilon]", "/", 
         StyleBox["T", "TI"]}]], "+", "1"}], ")"}], 
     RowBox[{"-", "1"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a6e6ed6c-3558-46af-8240-e51053479ba4"],
 " applied to the eigenvalues ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CurlyEpsilon]", 
    StyleBox["k", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "683d9389-0646-42a7-aa48-eeb60c3e4762"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["k", "TI"], "\[LongEqual]", "1", ",", "\[Ellipsis]", ",", "16"}],
    TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f7f7ce40-ba05-4418-9abf-6bce3f4b82f4"],
 ") of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["H",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9bdf4d46-2776-41f3-ad84-91638dbbbbd4"],
 ", with the occupations ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["f", "TI"], 
     StyleBox["k", "TI"]], "\[LongEqual]", 
    StyleBox["f", "TI"], 
    RowBox[{"(", 
     SubscriptBox["\[CurlyEpsilon]", 
      StyleBox["k", "TI"]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6d2efd1c-2c86-4fc1-87e0-553a61aaf296"],
 ". At ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "99deb2d1-8d48-451c-a1ac-7501ba21adf5"],
 " the Fermi function is 1 for the negative and 0 for the positive \
eigenvalues, and the thermal state is the ground state of Part II. ",
 StyleBox["The free energy",
  FontWeight->"Bold"],
 " per volume of method ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0c93a8f8-17a2-43b0-a2f5-76a6d8008159"],
 " is"
}], "Text",ExpressionUUID->"fb940397-cdc4-452c-a253-d3d3ee0c4925"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalE]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], "-", 
   StyleBox["T", "TI"], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["\[ScriptCapitalS]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"]], ",", "      ", 
   SubscriptBox[
    StyleBox["\[ScriptCapitalS]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"]], "\[LongEqual]", 
   RowBox[{"-", 
    FractionBox["1", "2"]}], "\[ThinSpace]", "\[Integral]", 
   FractionBox[
    RowBox[{
     SuperscriptBox[
      StyleBox["d", "TI"], "3"], 
     StyleBox["q", "TI"]}], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"2", "\[Pi]"}], ")"}], "3"]], "\[ThinSpace]", 
   UnderoverscriptBox["\[Sum]", 
    RowBox[{
     StyleBox["k", "TI"], "\[LongEqual]", "1"}], "16",
    LimitsPositioning->True], 
   RowBox[{"[", 
    RowBox[{
     SubscriptBox[
      StyleBox["f", "TI"], 
      StyleBox["k", "TI"]], "\[ThinSpace]", 
     StyleBox["ln",
      FontSlant->"Plain"], "\[ThinSpace]", 
     SubscriptBox[
      StyleBox["f", "TI"], 
      StyleBox["k", "TI"]], "+", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       SubscriptBox[
        StyleBox["f", "TI"], 
        StyleBox["k", "TI"]]}], ")"}], "\[ThinSpace]", 
     StyleBox["ln",
      FontSlant->"Plain"], 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       SubscriptBox[
        StyleBox["f", "TI"], 
        StyleBox["k", "TI"]]}], ")"}]}], "]"}], ","}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"8a6b6ccd-7309-463f-9369-be3b49a49ebc"],

Cell[TextData[{
 "with the energy per volume ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalE]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "09f1f3f4-b31f-480c-90c1-c8291acf075c"],
 " of method ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3f6cb5f9-2bf7-4e73-bc0a-dd293f9a23dc"],
 " (unchanged, Section II.2) and the entropy per volume ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["\[ScriptCapitalS]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fcbfacee-86cb-453b-9461-701c3b07be2e"],
 " of the quasi-free state. Every mode of the doubled space of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["H",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "03f09320-75bc-4791-9a0f-0bfc9accc6e3"],
 " appears twice, at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", "\[CurlyEpsilon]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8aca37a9-766c-4c6f-a28f-b3b103ed7e0d"],
 " with the occupations ",
 Cell[BoxData[
  FormBox[
   StyleBox["f", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4a84badb-152a-43f3-81f7-edf99245c031"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "-", 
    StyleBox["f", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d945ef83-fd1c-4989-9274-70a888322923"],
 ", hence the factor ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c4529218-c133-4077-9561-1b2640f93007"],
 ". The self-energies are the derivatives of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalE]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "73143727-c41d-4bd3-80a1-3bfb58fa273b"],
 " as at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "63fd5bae-e3cc-4e58-8e4a-1c6f41d82b14"],
 ", and the stationary points of the free energy are the self-consistent \
thermal states. In HS this is the free energy of the saddle point of the \
auxiliary fields; in CJT the effective action at the temperature ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "753e09ce-896d-4325-a5db-efd894b6864f"],
 " with the truncation of the method at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ef2f4633-8f43-4a69-aa8e-4de8a19863e2"],
 "; in KS the functional of N. D. Mermin (the theory of Hohenberg, Kohn and \
Sham at finite temperature) with the entropy of the quasi-free state of Kohn \
and Sham and the exchange-correlation energy of the method at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "75a5ef52-6925-4193-9147-09d925bb025c"],
 " (in the exact theory of Mermin the exchange-correlation free energy \
depends on the temperature; here only the states do, an approximation of the \
method). ",
 StyleBox["The free energy of the field",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[CapitalPhi]", "\[RightVector]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fd41af80-0a6d-4092-b432-8d472289a3d4"],
 " is the smallest free energy among the thermal states with this field, \
measured from the normal state at the same temperature:"
}], "Text",ExpressionUUID->"e1a9f833-b8df-4737-830a-47312a3ce88a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalF]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], 
   RowBox[{"(", 
    RowBox[{
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], ";", 
     StyleBox["T", "TI"]}], ")"}], "\[LongEqual]", 
   StyleBox["min",
    FontSlant->"Plain"], 
   RowBox[{"{", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["\[ScriptCapitalE]",
       FontSlant->"Plain"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      StyleBox["X", "TI"]], "-", 
     StyleBox["T", "TI"], 
     SubscriptBox[
      StyleBox["\[ScriptCapitalS]",
       FontSlant->"Plain"], 
      StyleBox["SF",
       FontSlant->"Plain"]], ":", " ", 
     SubsuperscriptBox[
      OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      StyleBox["X", "TI"]], "\[LongEqual]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"]}], "}"}], "-", 
   SubscriptBox[
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["\[ScriptCapitalE]",
        FontSlant->"Plain"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["X", "TI"]], "-", 
      StyleBox["T", "TI"], 
      SubscriptBox[
       StyleBox["\[ScriptCapitalS]",
        FontSlant->"Plain"], 
       StyleBox["SF",
        FontSlant->"Plain"]]}], ")"}], 
    StyleBox["normal",
     FontSlant->"Plain"]], "."}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"69dfa5f2-cd91-4816-b322-134f86281058"],

Cell[TextData[{
 "It is computed point by point as the effective potential of Section III.L: \
a fixed pair self-energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "75912c4b-156d-4534-8f70-de4c34f6ee29"],
 " (the applied field) is put into ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["H",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ec3a0bd5-53f6-4e5a-96f2-ed0564a57cd7"],
 ", the normal self-energy is made self-consistent at the temperature ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "68c1c5be-d9ca-443e-b5b7-ecef8819f64a"],
 ", and the thermal state gives one point, its own field ",
 Cell[BoxData[
  FormBox["\[CapitalPhi]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3743a3d0-c00c-456b-8cd4-3494f739095f"],
 " and its free energy. Its minimum lies at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}], "\[LongEqual]", 
    SubsuperscriptBox["\[CapitalPhi]", 
     RowBox[{"0", ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "47d94ea8-187f-4bec-9b66-6c86016ea2e3"],
 ", the ",
 StyleBox["order parameter at the temperature $T$",
  FontWeight->"Bold"],
 ": the modulus of the field of the self-consistent superfluid at ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "56639fbe-a3d3-472d-8825-8da1fb479f1d"],
 ". At ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "85d67a54-37c8-43f4-be17-b2be7d8025fc"],
 " the entropy vanishes and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalF]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], 
    RowBox[{"(", 
     RowBox[{
      OverscriptBox["\[CapitalPhi]", "\[RightVector]"], ";", "0"}], ")"}], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalV]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], 
    RowBox[{"(", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], ")"}]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6a904315-0030-4c7e-98ef-c0af3ba5d553"],
 ": ",
 StyleBox["the effective potential is the free energy at zero temperature",
  FontWeight->"Bold"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalPhi]", 
     RowBox[{"0", ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]], 
    RowBox[{"(", "0", ")"}], "\[LongEqual]", 
    SubsuperscriptBox["\[CapitalPhi]", 
     RowBox[{"0", ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "81c14962-fa77-4d71-80b2-0bf4f4ebf5e0"],
 ". The next cell defines the thermal states of the engine of Part II: ",
 StyleBox["thermalNode",
  FontFamily->"Source Code Pro"],
 " makes ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["f", "TI"], 
    RowBox[{"(", 
     SubscriptBox[
      StyleBox["H",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["SF",
       FontSlant->"Plain"]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1735c0bc-14be-49f6-82b7-753ce0b0a94d"],
 " and the entropy of one node of the grid, ",
 StyleBox["solveSFT",
  FontFamily->"Source Code Pro"],
 " the self-consistent thermal state, and ",
 StyleBox["fixedPairT",
  FontFamily->"Source Code Pro"],
 " the thermal state of an applied pair field."
}], "Text",ExpressionUUID->"04859e55-2eb1-4008-b6c4-6f850f907a9a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"fermiSF", "[", 
     RowBox[{"e", ",", " ", "t"}], "]"}], ":", " ", 
    RowBox[{"the", " ", "Fermi", " ", "function", " ", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"e", "^", 
         RowBox[{"(", 
          RowBox[{"e", "/", "t"}], ")"}]}], " ", "+", " ", "1"}], ")"}]}], " ",
      "of", " ", "the", " ", "energy", " ", "e", " ", "at", " ", "the", " ", 
     "temperature", " ", "t", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"the", " ", "step", " ", "function", " ", "at", " ", "t"}], 
       " ", "=", " ", "0"}], ")"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"fermiSF", "[", 
      RowBox[{
       RowBox[{"e_", "?", "NumericQ"}], ",", " ", 
       RowBox[{"t_", "?", "NumericQ"}]}], "]"}], " ", ":=", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"t", " ", "<=", " ", "0"}], ",", " ", 
       RowBox[{"Which", "[", 
        RowBox[{
         RowBox[{"e", " ", "<", " ", "0"}], ",", " ", "1.", ",", " ", 
         RowBox[{"e", " ", ">", " ", "0"}], ",", " ", "0.", ",", " ", "True", 
         ",", " ", "0.5"}], "]"}], ",", " ", 
       RowBox[{"1.", "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{"Clip", "[", 
            RowBox[{
             RowBox[{"e", "/", "t"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "700."}], ",", " ", "700."}], "}"}]}], "]"}], 
           "]"}], " ", "+", " ", "1."}], ")"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"binEntropy", "[", "f", "]"}], ":", " ", 
     RowBox[{
      RowBox[{"the", " ", "entropy"}], " ", "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"f", " ", "ln", " ", "f"}], " ", "+", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", " ", "-", " ", "f"}], ")"}], " ", "ln", 
          RowBox[{"(", 
           RowBox[{"1", " ", "-", " ", "f"}], ")"}]}]}], ")"}], " ", "of", " ",
        "a", " ", "mode", " ", "with", " ", "the", " ", "occupation", " ", 
       "f", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"zero", " ", "at", " ", "f"}], " ", "=", " ", 
         RowBox[{
          RowBox[{"0", " ", "and", " ", "f"}], " ", "=", " ", "1"}]}], 
        ")"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"binEntropy", "[", "f_", "]"}], " ", ":=", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"0", " ", "<", " ", "f", " ", "<", " ", "1"}], ",", " ", 
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"f", " ", 
           RowBox[{"Log", "[", "f", "]"}]}], " ", "+", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", " ", "-", " ", "f"}], ")"}], " ", 
           RowBox[{"Log", "[", 
            RowBox[{"1", " ", "-", " ", "f"}], "]"}]}]}], ")"}]}], ",", " ", 
       "0."}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"thermalNode", "[", 
      RowBox[{"h", ",", " ", "t"}], "]"}], ":", " ", 
     RowBox[{"the", " ", "thermal", " ", "state", " ", "f", 
      RowBox[{"(", "H", ")"}], " ", "of", " ", "one", " ", "BdG", " ", 
      "matrix", " ", "h", " ", "at", " ", "the", " ", "temperature", " ", 
      "t"}], ":", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"C", "^", "n"}], ",", " ", 
       RowBox[{"C", "^", "p"}], ",", " ", 
       RowBox[{"the", " ", "sorted", " ", "eigenvalues"}], ",", " ", 
       RowBox[{
       "the", " ", "sum", " ", "of", " ", "the", " ", "entropies", " ", "of", 
        " ", "the", " ", "16", " ", "modes"}]}], "}"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"thermalNode", "[", 
      RowBox[{"h_", ",", " ", "t_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ev", ",", " ", "vec", ",", " ", "f", ",", " ", "r"}], "}"}], 
