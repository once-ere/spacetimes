Cell[TextData[{
 StyleBox["The manifold M31 and its Lorentz group.",
  FontWeight->"Bold"],
 " M31 is the real vector space of the Hermitian bi-quaternions ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["x",
     FontWeight->"Bold",
     FontSlant->"Plain"], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "0"], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "0"], "+", 
    StyleBox["i", "TI"], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", 
     StyleBox["j", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "da11f1c4-bea9-4c1f-aeac-95e8ebe94be8"],
 "; their matrices ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["x",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", 
     StyleBox["p", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p", "TI"]], 
    SubsuperscriptBox["\[Sigma]", 
     StyleBox["p", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f488d1c7-7b04-4457-bf13-95dd79c15558"],
 " are the Hermitian ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Times]", "2"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0fcca4a4-251a-4769-88c2-a74b0fd7588f"],
 " matrices, and the norm ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["x",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "0"], ")"}], "2"], "-", 
    UnderscriptBox["\[Sum]", 
     StyleBox["j", "TI"],
     LimitsPositioning->True], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["j", "TI"]], ")"}], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8d2d4e82-1b05-4c84-95f0-4baed0f62ca0"],
 " is the Minkowski interval. A unit bi-quaternion ",
 Cell[BoxData[
  FormBox[
   StyleBox["g",
    FontWeight->"Bold",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "648c01f3-2226-421c-9944-734c44562602"],
 " acts by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["x",
     FontWeight->"Bold",
     FontSlant->"Plain"], "\[RightTeeArrow]", 
    StyleBox["g",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    StyleBox["x",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    SuperscriptBox[
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], "\[Dagger]"]}], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f7e833a6-a2fd-4889-9bb5-1c4c87e62df6"],
 "; this keeps M31 and the interval, so it is a Lorentz transformation, with \
the real matrix"
}], "Text",ExpressionUUID->"6148bb83-8b06-4cad-8f09-91a87700c587"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["L",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   SubscriptBox[
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    RowBox[{
     StyleBox["p", "TI"], 
     SuperscriptBox[
      StyleBox["p", "TI"], "\[Prime]"]}]], "\[LongEqual]", 
   FractionBox["1", "2"], "\[ThinSpace]", 
   StyleBox["Re",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["tr",
    FontSlant->"Plain"], 
   RowBox[{"(", 
    RowBox[{
     SubsuperscriptBox["\[Sigma]", 
      StyleBox["p", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"]], 
     SubscriptBox[
      StyleBox["M", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"]], 
     RowBox[{"(", 
      StyleBox["g",
       FontWeight->"Bold",
       FontSlant->"Plain"], ")"}], "\[ThinSpace]", 
     SubsuperscriptBox["\[Sigma]", 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"], 
      StyleBox["LL",
       FontSlant->"Plain"]], 
     SubscriptBox[
      StyleBox["M", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"]], 
     SuperscriptBox[
      RowBox[{"(", 
       StyleBox["g",
        FontWeight->"Bold",
        FontSlant->"Plain"], ")"}], "\[Dagger]"]}], ")"}], ","}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"a6ac5ff4-e48d-4f87-aafa-a19176ad9840"],

Cell[TextData[{
 "which is proper and orthochronous (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["L",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["T", "TI"]], "\[Eta]", 
    StyleBox["L",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "\[LongEqual]", "\[Eta]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "27b764b3-c92a-4261-8cda-af72dfa55508"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["det",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["L",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fbc88bfd-7cf6-4baf-9a31-587913125c54"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["L",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "00"], "\[GreaterEqual]", "1"}], TraditionalForm]],
   "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "28db40d4-94aa-4477-ae0e-6f1e9da60129"],
 ") and multiplicative, with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["L",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     RowBox[{"-", 
      StyleBox["g",
       FontWeight->"Bold",
       FontSlant->"Plain"]}], ")"}], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["L",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7aba7ce5-8267-4d59-96d6-18c099578d00"],
 ": ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SL", "TI"], 
    RowBox[{"(", 
     RowBox[{"2", ",", 
      StyleBox["\[DoubleStruckCapitalC]",
       FontSlant->"Plain"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a2894d66-b356-455e-b098-d4002dfec2c1"],
 " is the double cover of the proper orthochronous Lorentz group. The next \
cell checks the properties of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["M", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "17e2a120-2eb3-436d-828e-ba53a455e440"],
 " exactly (with Gaussian-integer coefficients) and those of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["L",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e0fddf79-a221-4613-89e8-0c490ca91d2c"],
 " with 200 random unit bi-quaternions in floating point. A spinor charge of \
the super-loop is a bi-octonion ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["b",
     FontWeight->"Bold",
     FontSlant->"Plain"], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2300a7a0-2377-465a-b73a-ec7378ab7ca7"],
 "; by the product rule the super-loop acts on it as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      StyleBox["b",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      SubscriptBox[
       StyleBox["e",
        FontWeight->"Bold",
        FontSlant->"Plain"], "4"]}], ")"}], 
    StyleBox["g",
     FontWeight->"Bold",
     FontSlant->"Plain"], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["b",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      OverscriptBox[
       StyleBox["g",
        FontWeight->"Bold",
        FontSlant->"Plain"], "_"]}], ")"}], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9e31eeeb-8bde-4f66-8ee1-b51bbd90cc3e"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["g",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["b",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      SubscriptBox[
       StyleBox["e",
        FontWeight->"Bold",
        FontSlant->"Plain"], "4"]}], ")"}], "\[LongEqual]", 
    RowBox[{"(", 
     StyleBox[
      RowBox[{"b", "g"}],
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cdb0daae-97e5-40e8-9c4c-715fcd2e2c10"],
 ", and the isospin ",
 Cell[BoxData[
  FormBox[
   StyleBox["v",
    FontWeight->"Bold",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "00fdec3e-8414-4660-a11a-eb772191fc7e"],
 " acts as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      StyleBox["v",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      RowBox[{"(", 
