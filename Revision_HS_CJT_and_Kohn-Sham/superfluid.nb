Cell[TextData[{
 "The first check of the conventions: the mass matrix of the gauge fields of \
the Standard Model, computed from the covariant derivative (1.1) with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", 
    StyleBox["ig", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3c954b2f-f0b5-4e1a-ae1f-cfdad1294f6d"],
 ", has the eigenvalues ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d644d6b6-359f-43d2-aac5-7b93ae76aca3"],
 " (the photon), ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["M", "TI"], 
    StyleBox["W", "TI"], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c06017ed-a2f7-4544-bb6d-634028125535"],
 " (twice) and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["M", "TI"], 
    StyleBox["Z", "TI"], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4f809c1a-2069-4598-895c-e007b1172d36"],
 ", with the eigenvectors ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["A", "TI"], "\[Mu]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e6591e4c-7f84-4a90-8619-62069ca355dc"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["Z", "TI"], "\[Mu]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "42e1c8e8-d014-4c7d-809f-eb1fce68f948"],
 " of the text. The kinetic term ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["D", "TI"], "\[Mu]"], 
       RowBox[{"\[LeftAngleBracket]", 
        SuperscriptBox["\[CapitalPhi]", 
         StyleBox["SM",
          FontSlant->"Plain"]], "\[RightAngleBracket]"}]}], ")"}], 
     "\[Dagger]"], 
    SuperscriptBox[
     StyleBox["D", "TI"], "\[Mu]"], 
    RowBox[{"\[LeftAngleBracket]", 
     SuperscriptBox["\[CapitalPhi]", 
      StyleBox["SM",
       FontSlant->"Plain"]], "\[RightAngleBracket]"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d40a1c8e-65ff-4f07-bceb-6f5f8e2c8588"],
 " of the constant vacuum is the quadratic form ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", 
     StyleBox["ab", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["M",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["ab", "TI"]], 
    SubsuperscriptBox[
     StyleBox["V", "TI"], "\[Mu]", 
     StyleBox["a", "TI"]], 
    SuperscriptBox[
     StyleBox["V", "TI"], 
     RowBox[{
      StyleBox["b", "TI"], ",", "\[Mu]"}]]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8eae17dd-91e4-4ba7-855c-debf00ae1629"],
 " of the four fields ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox[
      StyleBox["W", "TI"], "1"], ",", 
     SuperscriptBox[
      StyleBox["W", "TI"], "2"], ",", 
     SuperscriptBox[
      StyleBox["W", "TI"], "3"], ",", 
     StyleBox["B", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cc1df3a2-a1bd-4c20-855f-bb59b8f507d4"],
 "; the cell computes ",
 Cell[BoxData[
  FormBox[
   StyleBox["M",
    FontFamily->"Helvetica",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0a1485eb-3222-4958-8346-a768038c8dd8"],
 " exactly, with symbolic couplings, and diagonalizes it. The Rust program ",
 StyleBox["sf_part1",
  FontFamily->"Source Code Pro"],
 " checks the same statement with numbers through the four eigenvectors, and \
the Python program ",
 StyleBox["sf_part1.py",
  FontFamily->"Source Code Pro"],
 " through the eigenvalues computed by LAPACK (check SM-1 of both); the same \
computation for the superfluid is the mass matrix (14.3) of Part IV."
}], "Text",ExpressionUUID->"bf291ebd-7661-43b4-be57-d24ae7a1dbf8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"gSM", ",", " ", 
    RowBox[{
     RowBox[{"gpSM", ":", " ", 
      RowBox[{"the", " ", "couplings", " ", "g", " ", "and", " ", 
       RowBox[{"g", "'"}], " ", "of", " ", "SU", 
       RowBox[{"(", "2", ")"}], "_L", " ", "and", " ", "U", 
       RowBox[{"(", "1", ")"}], "_Y"}]}], ";", " ", 
     RowBox[{"vSM", ":", " ", 
      RowBox[{"the", " ", "vacuum", " ", "value", " ", "v", " ", 
       RowBox[{"(", 
        RowBox[{"all", " ", "positive", " ", "symbols"}], ")"}]}]}]}]}], " ", 
   "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", 
     RowBox[{"gSM", ",", " ", "gpSM", ",", " ", "vSM"}], "]"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"phiSM", ":", " ", 
      RowBox[{
       RowBox[{"the", " ", "vacuum"}], " ", "<", 
       RowBox[{"Phi", "^", "SM"}], ">"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"0", ",", " ", "v"}], ")"}], "/", "sqrt2"}], " ", "of", " ", 
      "the", " ", "Higgs", " ", "doublet"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"phiSM", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", 
       RowBox[{"vSM", "/", 
        RowBox[{"Sqrt", "[", "2", "]"}]}]}], "}"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"xSM", "[", "a", "]"}], ":", " ", 
       RowBox[{
        RowBox[{"the", " ", "vector", " ", "X_a", " ", "with", " ", "D_mu"}], 
        " ", "<", "Phi", ">"}]}], " ", "=", " ", 
      RowBox[{
       RowBox[{"sum_a", " ", 
        RowBox[{"V", "^", "a_mu"}], " ", "X_a", " ", "for", " ", "the", " ", 
        "fields", " ", "V"}], " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"W", "^", "1"}], ",", " ", 
           RowBox[{"W", "^", "2"}], ",", " ", 
           RowBox[{"W", "^", "3"}], ",", " ", "B"}], ")"}], ":", "\n", "   ", 
         
         RowBox[{
          RowBox[{"i", " ", "g", " ", 
           RowBox[{"tau_a", "/", "2"}]}], " ", "<", "Phi", ">", " ", 
          RowBox[{"for", " ", "a"}]}]}], " ", "=", " ", "1"}]}]}], ",", " ", 
     "2", ",", " ", 
     RowBox[{
      RowBox[{"3", " ", "and", " ", "i", " ", 
       RowBox[{"g", "'"}], " ", "Y"}], " ", "<", "Phi", ">", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Y", " ", "=", " ", 
         RowBox[{"1", "/", "2"}]}], ")"}], " ", "for", " ", "B"}]}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"xSM", " ", "=", " ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"I", " ", 
            RowBox[{"gSM", "/", "2"}]}], ")"}], " ", 
          RowBox[{
           RowBox[{"sig", "[", 
            RowBox[{"[", 
             RowBox[{"a", " ", "+", " ", "1"}], "]"}], "]"}], " ", ".", " ", 
           "phiSM"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"a", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"I", " ", 
           RowBox[{"gpSM", "/", "2"}]}], ")"}], " ", "phiSM"}], "}"}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", "mass", " ", "matrix", " ", "M_ab"}], " ", "=", " ", 
     
     RowBox[{
      RowBox[{
       RowBox[{"2", " ", "Re", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"X_a", "^", "dag"}], " ", "X_b"}], ")"}]}], ":", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"D", " ", "<", "Phi", ">"}], ")"}], "^", "dag"}], " ", 
        RowBox[{"(", 
         RowBox[{"D", " ", "<", "Phi", ">"}], ")"}]}]}], " ", "=", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "/", "2"}], ")"}], " ", "sum_ab", " ", "M_ab", " ", 
       RowBox[{"V", "^", "a"}], " ", 
       RowBox[{"V", "^", "b"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"mSM", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"2", " ", 
        RowBox[{"ComplexExpand", "[", 
         RowBox[{"Re", "[", 
          RowBox[{
           RowBox[{"Conjugate", "[", 
            RowBox[{"xSM", "[", 
             RowBox[{"[", "a", "]"}], "]"}], "]"}], " ", ".", " ", 
           RowBox[{"xSM", "[", 
            RowBox[{"[", "b", "]"}], "]"}]}], "]"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "4"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"b", ",", " ", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", "predicted", " ", 
      RowBox[{"eigenvalues", ":", " ", "0"}]}], ",", " ", 
     RowBox[{
      RowBox[{"M_W", "^", "2"}], " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"g", " ", 
          RowBox[{"v", "/", "2"}]}], ")"}], "^", "2"}], " ", "twice"}]}], ",",
      " ", 
     RowBox[{
      RowBox[{
       RowBox[{"M_Z", "^", "2"}], " ", "=", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"g", "^", "2"}], " ", "+", " ", 
          RowBox[{
           RowBox[{"g", "'"}], "^", "2"}]}], ")"}], " ", 
        RowBox[{
         RowBox[{"v", "^", "2"}], "/", "4"}]}]}], ";", " ", 
      RowBox[{
      "they", " ", "are", " ", "the", " ", "eigenvalues", " ", "exactly", " ",
        "when", "\n", "   ", "the", " ", "characteristic", " ", "polynomial", 
       " ", "det", 
       RowBox[{"(", 
        RowBox[{"M", " ", "-", " ", 
         RowBox[{"lam", " ", "1"}]}], ")"}], " ", "equals", " ", "the", " ", 
       "product", " ", "of", " ", "the", " ", "factors", " ", 
       RowBox[{"(", 
        RowBox[{"lam", " ", "-", " ", "eigenvalue"}], ")"}]}]}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"evSMpred", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"gSM", " ", 
          RowBox[{"vSM", "/", "2"}]}], ")"}], "^", "2"}], ",", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"gSM", " ", 
          RowBox[{"vSM", "/", "2"}]}], ")"}], "^", "2"}], ",", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"gSM", "^", "2"}], " ", "+", " ", 
          RowBox[{"gpSM", "^", "2"}]}], ")"}], " ", 
        RowBox[{
         RowBox[{"vSM", "^", "2"}], "/", "4"}]}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"charSM", " ", "=", " ", 
     RowBox[{"Expand", "[", 
      RowBox[{
       RowBox[{"CharacteristicPolynomial", "[", 
        RowBox[{"mSM", ",", " ", "lam"}], "]"}], " ", "-", " ", 
       RowBox[{"Product", "[", 
        RowBox[{
         RowBox[{"lam", " ", "-", " ", "ev"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"ev", ",", " ", "evSMpred"}], "}"}]}], "]"}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", "photon", " ", "A"}], " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"sin", 
        RowBox[{"(", "thetaW", ")"}], " ", 
        RowBox[{"W", "^", "3"}]}], " ", "+", " ", 
       RowBox[{"cos", 
        RowBox[{"(", "thetaW", ")"}], " ", "B", " ", "with", " ", "tan", 
        RowBox[{"(", "thetaW", ")"}]}]}], " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"g", "'"}], "/", "g"}], " ", "is", " ", "the", " ", "null", " ",
        "vector"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"photonSM", " ", "=", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "0", ",", " ", "gpSM", ",", " ", "gSM"}], "}"}],
       "/", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"gSM", "^", "2"}], " ", "+", " ", 
        RowBox[{"gpSM", "^", "2"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<the mass matrix of (W1, W2, W3, B): \>\"", ",", " ", 
      RowBox[{"MatrixForm", "[", "mSM", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"checkTrue", "[", 
     RowBox[{"\"\<WSM-1\>\"", ",", 
      " ", "\"\<Standard Model with +i g: the eigenvalues of the mass matrix \
are 0, M_W^2 (twice), M_Z^2, and the photon sin(thetaW) W^3 + cos(thetaW) B \
is massless\>\"", ",", "\n", "  ", 
      RowBox[{
       RowBox[{"charSM", " ", "===", " ", "0"}], " ", "&&", " ", 
       RowBox[{
        RowBox[{"Simplify", "[", 
         RowBox[{"mSM", " ", ".", " ", "photonSM"}], "]"}], " ", "===", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], 
         "}"}]}]}], ",", " ", "\"\<exact, with symbolic g, g', v\>\"", ",", 
      "\n", "  ", "\"\<SM-1\>\"", ",", " ", "\"\<SM-1\>\""}], "]"}], 
    ";"}]}]}]], "Input",
 CellLabel->"In[42]:=",ExpressionUUID->"c27b693a-960f-4caf-bdb4-fbe445c697b2"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"the mass matrix of (W1, W2, W3, B): \"\>", "\[InvisibleSpace]", 
   TagBox[
    RowBox[{"(", "\[NoBreak]", GridBox[{
       {
        FractionBox[
         RowBox[{
          SuperscriptBox["gSM", "2"], " ", 
          SuperscriptBox["vSM", "2"]}], "4"], "0", "0", "0"},
       {"0", 
        FractionBox[
         RowBox[{
          SuperscriptBox["gSM", "2"], " ", 
          SuperscriptBox["vSM", "2"]}], "4"], "0", "0"},
       {"0", "0", 
        FractionBox[
         RowBox[{
          SuperscriptBox["gSM", "2"], " ", 
          SuperscriptBox["vSM", "2"]}], "4"], 
        RowBox[{
         RowBox[{"-", 
          FractionBox["1", "4"]}], " ", "gpSM", " ", "gSM", " ", 
         SuperscriptBox["vSM", "2"]}]},
       {"0", "0", 
        RowBox[{
         RowBox[{"-", 
          FractionBox["1", "4"]}], " ", "gpSM", " ", "gSM", " ", 
         SuperscriptBox["vSM", "2"]}], 
        FractionBox[
         RowBox[{
          SuperscriptBox["gpSM", "2"], " ", 
          SuperscriptBox["vSM", "2"]}], "4"]}
      },
      GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
      GridBoxSpacings->{"Columns" -> {
          Offset[0.27999999999999997`], {
           Offset[0.7]}, 
          Offset[0.27999999999999997`]}, "Rows" -> {
          Offset[0.2], {
           Offset[0.4]}, 
          Offset[0.2]}}], "\[NoBreak]", ")"}],
    Function[BoxForm`e$, 
     MatrixForm[BoxForm`e$]]]}],
  SequenceForm["the mass matrix of (W1, W2, W3, B): ", 
   MatrixForm[{{
     Rational[1, 4] $CellContext`gSM^2 $CellContext`vSM^2, 0, 0, 0}, {
     0, Rational[1, 4] $CellContext`gSM^2 $CellContext`vSM^2, 0, 0}, {
     0, 0, Rational[1, 4] $CellContext`gSM^2 $CellContext`vSM^2, 
      Rational[-1, 
        4] $CellContext`gpSM $CellContext`gSM $CellContext`vSM^2}, {
     0, 0, Rational[-1, 
        4] $CellContext`gpSM $CellContext`gSM $CellContext`vSM^2, 
      Rational[1, 4] $CellContext`gpSM^2 $CellContext`vSM^2}}]],
