Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"PASS \"\>", "\[InvisibleSpace]", "\<\"WP3-T8 CJT\"\>", 
   "\[InvisibleSpace]", "\<\"  deviation \"\>", 
   "\[InvisibleSpace]", "\<\"2.765e-13\"\>", 
   "\[InvisibleSpace]", "\<\" (tolerance \"\>", 
