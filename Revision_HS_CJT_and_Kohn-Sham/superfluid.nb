Cell[TextData[{
 "The next cell takes the ground states of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "2", ")"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c010085e-d543-4519-be6a-39af34f4402f"],
 " of Part II (",
 StyleBox["groundSF",
  FontFamily->"Source Code Pro"],
 "), makes them self-consistent to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "13"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "24757bc5-9685-497f-8bda-2bd1347c8389"],
 ", and computes the thermal states at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0.005"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "89e4e8ae-19b5-48ee-a3a1-9802ead96fae"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      RowBox[{"-", 
       SubsuperscriptBox[
        StyleBox["E", "TI"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["X", "TI"], ",", 
         StyleBox["gap",
          FontSlant->"Plain"]}]]}], "/", 
      StyleBox["T", "TI"]}]], "<", 
    SuperscriptBox["10", 
     RowBox[{"-", "25"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "459cfed5-d357-46cc-ab50-a52321784e4f"],
 ": the order parameter and the free energy measured from the normal state at \
the same temperature must be those of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
