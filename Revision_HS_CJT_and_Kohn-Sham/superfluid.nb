      SubscriptBox[
       OverscriptBox["\[CapitalPsi]", "_"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      SubscriptBox["\[CapitalPsi]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}], "2"], ":", 
