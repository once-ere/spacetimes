Cell[CellGroupData[{

Cell["\<\
III.G.7 The Ginzburg number: how wide is the critical region?\
\>", "Section",ExpressionUUID->"e52371d5-839a-4422-9bb5-b351d3773571"],

Cell[TextData[{
 "The next cell computes the Ginzburg number by both forms of Section \
III.G.1, with the slope and the gradient coefficient of the notebook and the \
quartic coefficient of the notebook (CJT) or of the Rust table (the other \
methods), and prints the table of the answer: the correlation length ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Xi]", 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["GL",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1348ebc1-f5c6-4009-8b7c-582887fa19b5"],
 " in units of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f208531e-3bf5-40d6-9363-442a5754440c"],
 ", the specific-heat jump per correlation volume ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", 
    SubsuperscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[Xi]", 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["GL",
         FontSlant->"Plain"]}]], ")"}], "3"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "244311c1-4bf4-43c2-8197-aebd6e3f5d3e"],
 ", the Ginzburg number, the width ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["Gi",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "74f0737d-329e-409f-972f-e73602f718fa"],
 " of the critical region in temperature, and the Ginzburg number with ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["c",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e2833e24-99dc-4971-ad9f-dfa021cc44f8"],
 " changed by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    SubsuperscriptBox[
     StyleBox["c",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      RowBox[{
       StyleBox["T",
        FontSlant->"Plain"], "\[InvisibleSpace]", "3"}]}]]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "20f15471-079e-484e-ae1b-8f23f390587c"],
 " of the Rust table."
}], "Text",ExpressionUUID->"7dfb6180-4146-4eab-a375-97ded666cbfa"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"gzGi", "[", "t_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"r", " ", "=", " ", 
        RowBox[{"gzResults", "[", "t", "]"}]}], ",", " ", 
       RowBox[{"b", " ", "=", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"t", " ", "===", " ", "\"\<CJT\>\""}], ",", " ", 
          RowBox[{
           RowBox[{"gzResults", "[", "\"\<CJT\>\"", "]"}], "[", "\"\<b\>\"", 
           "]"}], ",", " ", 
          RowBox[{"gzRust", "[", 
           RowBox[{"t", ",", " ", "\"\<b\>\""}], "]"}]}], "]"}]}], ",", " ", 
       "gi1", ",", " ", "dc", ",", " ", "xi", ",", " ", "gi2"}], "}"}], ",", 
     "\n", "   ", 
     RowBox[{
      RowBox[{"gi1", " ", "=", " ", 
       RowBox[{"36", " ", 
        RowBox[{"b", "^", "2"}], " ", 
        RowBox[{
         RowBox[{
          RowBox[{"r", "[", "\"\<Tc\>\"", "]"}], "^", "2"}], "/", 
         RowBox[{"(", 
          RowBox[{"64", " ", 
           RowBox[{"Pi", "^", "2"}], " ", 
           RowBox[{"r", "[", "\"\<alpha\>\"", "]"}], " ", 
           RowBox[{
            RowBox[{"r", "[", "\"\<c\>\"", "]"}], "^", "3"}]}], ")"}]}]}]}], ";",
       "\n", "   ", 
      RowBox[{"dc", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"r", "[", "\"\<alpha\>\"", "]"}], "^", "2"}], "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", "b", " ", 
          RowBox[{"r", "[", "\"\<Tc\>\"", "]"}]}], ")"}]}]}], ";", " ", 
      RowBox[{"xi", " ", "=", " ", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"r", "[", "\"\<c\>\"", "]"}], "/", 
         RowBox[{"r", "[", "\"\<alpha\>\"", "]"}]}], "]"}]}], ";", "\n", 
      "   ", 
      RowBox[{"gi2", " ", "=", " ", 
       RowBox[{"36", "/", 
        RowBox[{"(", 
         RowBox[{"256", " ", 
          RowBox[{"Pi", "^", "2"}], " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"dc", " ", 
             RowBox[{"xi", "^", "3"}]}], ")"}], "^", "2"}]}], ")"}]}]}], ";", 
      "\n", "   ", 
      RowBox[{"{", 
       RowBox[{"gi1", ",", " ", "gi2", ",", " ", "xi", ",", " ", 
        RowBox[{"dc", " ", 
         RowBox[{"xi", "^", "3"}]}], ",", " ", "b"}], "}"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"gzGi", "[", "t", "]"}]}], "}"}], ",", "\n", "   ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{"\"\<WP3-G11 \>\"", " ", "<>", " ", "t"}], ",", " ", 
        RowBox[{
         RowBox[{"thName", "[", "t", "]"}], " ", "<>", 
         " ", "\"\<: the Ginzburg number by the first form \>\"", " ", "<>", 
         " ", 
         RowBox[{"ToString", "[", 
          RowBox[{"NumberForm", "[", 
           RowBox[{
            RowBox[{"g", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", " ", "8"}], "]"}], "]"}], 
         " ", "<>", " ", "\"\< and by the second form \>\"", " ", "<>", " ", 
         RowBox[{"ToString", "[", 
          RowBox[{"NumberForm", "[", 
           RowBox[{
            RowBox[{"g", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", " ", "8"}], "]"}], "]"}], 
         " ", "<>", " ", "\"\< = Rust \>\"", " ", "<>", " ", 
         RowBox[{"ToString", "[", 
          RowBox[{"NumberForm", "[", 
           RowBox[{
            RowBox[{"gzRust", "[", 
             RowBox[{"t", ",", " ", "\"\<Gi\>\""}], "]"}], ",", " ", "8"}], 
           "]"}], "]"}], " ", "<>", 
         " ", "\"\< (largest relative difference)\>\""}], ",", "\n", "    ", 
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"g", "[", 
              RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", 
             RowBox[{"gzRust", "[", 
              RowBox[{"t", ",", " ", "\"\<Gi\>\""}], "]"}]}], "]"}], ",", " ", 
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"g", "[", 
              RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
             RowBox[{"g", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], "]"}], "/", 
         RowBox[{"gzRust", "[", 
          RowBox[{"t", ",", " ", "\"\<Gi\>\""}], "]"}]}], ",", " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "6"}]}], ",", " ", 
        RowBox[{"\"\<P3-G11 \>\"", " ", "<>", " ", "t"}], ",", " ", 
        RowBox[{"\"\<YP3-G11 \>\"", " ", "<>", " ", "t"}]}], "]"}]}], "]"}], ",",
     " ", 
    RowBox[{"{", 
     RowBox[{"t", ",", " ", "thTags"}], "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
