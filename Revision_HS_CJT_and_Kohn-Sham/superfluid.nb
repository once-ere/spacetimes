     SubsuperscriptBox[
      StyleBox["g", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["X", "TI"], ",", 
       StyleBox["P",
        FontSlant->"Plain"]}]]}]], ","}], TraditionalForm]], "DisplayFormula",\

 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"be3828c5-a560-4f8f-b7fc-589854c41e76"],

Cell[TextData[{
 "with the eigenvalue ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Lambda]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["P",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a0d05fb0-9132-464f-b728-f24ad6177cad"],
 " of Section III.T.4: the applied block ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5121282f-f531-47a4-9c7f-dbf079dec52d"],
 " produces the field ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[CapitalPhi]", "3"], "\[LongEqual]", 
    SubsuperscriptBox["\[Lambda]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["P",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "742984bd-7464-4df3-9bb8-4aa2d0cfda8b"],
 ", and the formula for ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalF]",
     FontSlant->"Plain"], 
    RowBox[{"2", ",", 
     StyleBox["SF",
      FontSlant->"Plain"]}], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "29f5d94d-5cc5-4133-ae78-a48746018b7f"],
 " gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      SubsuperscriptBox["\[Lambda]", 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["P",
        FontSlant->"Plain"]]}], ")"}], "\[CenterDot]", "2", 
    SubsuperscriptBox["\[Lambda]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["P",
      FontSlant->"Plain"]], "/", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["P",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "11df073f-5c3c-472d-b285-c15f7c21745c"],
 ". Hence the slope in closed form, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["GL",
       FontSlant->"Plain"]}]], "\[LongEqual]", 
    RowBox[{"-", 
     SubsuperscriptBox[
      StyleBox["T", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["X", "TI"], ",", 
       StyleBox["c",
        FontSlant->"Plain"]}]]}], "\[ThinSpace]", 
    SubscriptBox["\[PartialD]", 
     StyleBox["T", "TI"]], 
    SubsuperscriptBox["\[Lambda]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["P",
      FontSlant->"Plain"]], "/", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[Lambda]", 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["P",
        FontSlant->"Plain"]], ")"}], "2"], 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["P",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a0f20912-d4f6-4eb7-ad79-a6c84427a9d5"],
 " at ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6cd23973-ea4a-442e-ad51-41b099d04b33"],
 ". ",
 StyleBox["The engine.",
  FontWeight->"Bold"],
 " The next cell defines the static pair response on any set of momenta with \
weights, the quadratic free energy of the field, the normal self-energy at ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6df2d9cf-8158-4db7-a308-7f70dcab6667"],
 ", and the coefficient for a twist ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["q", "TI"], "\[ThinSpace]", 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], "3"], "\[CircleTimes]", 
    StyleBox["t",
     FontFamily->"Helvetica",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a2a30c1b-2634-4805-88e9-ce3de3edafb2"],
 " with an isospin matrix ",
 Cell[BoxData[
  FormBox[
   StyleBox["t",
    FontFamily->"Helvetica",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9175f31b-f6f8-48ec-b5f2-8ee26d718932"],
 ": ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["t",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b5f99a5d-6f7d-425b-a595-7ebce4d517ab"],
 " moves the pair (fermion number 2) with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["pair",
      FontSlant->"Plain"]], "\[LongEqual]", "2", 
    StyleBox["q", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2f5c80a7-a7fd-497e-999a-b663142282e5"],
 "; ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["t",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "\[LongEqual]", 
    FractionBox["1", "2"], 
    SubscriptBox["\[Tau]", "1"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b1af9191-1f11-42e8-9c48-d2652338c97d"],
 " turns the isospin direction of the field (its components of charge ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2ef1218f-6273-43fc-9ab0-e8aacdea6fd1"],
 " of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "1"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2936bdce-557a-4d24-aa8f-363ddfc54ccc"],
 " get the momenta ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    StyleBox["q", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "57dcd004-d811-4033-8741-5335fcb95d59"],
 "), and must give the same coefficient by the isospin invariance of the form."
}], "Text",ExpressionUUID->"82a847b4-3bf9-40f8-9d0e-fffe1fc7ad86"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"--", " ", "the"}]}], " ", "static", " ", "pair", " ", 
    "response", " ", "and", " ", "the", " ", "quadratic", " ", "free", " ", 
    "energy", " ", "of", " ", "a", " ", "field", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"Section", " ", 
        RowBox[{"III", ".", "G"}], ".2"}], ")"}], " ", "--"}], "--"}]}], " ", 
   "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"gzPairs", ":", " ", 
     RowBox[{"the", " ", "28", " ", "index", " ", "pairs", " ", 
      RowBox[{"{", 
       RowBox[{"a", ",", " ", "b"}], "}"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"a", " ", "<", " ", "b"}], ";", " ", 
     RowBox[{"gzBasis", ":", " ", 
      RowBox[{
       RowBox[{
       "the", " ", "antisymmetric", " ", "basis", " ", "matrices", " ", 
        "E_ab"}], " ", "-", " ", "E_ba"}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"gzPairs", " ", "=", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"a", ",", " ", "b"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"a", ",", " ", "8"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"b", ",", " ", 
           RowBox[{"a", " ", "+", " ", "1"}], ",", " ", "8"}], "}"}]}], "]"}],
        ",", " ", "1"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gzBasis", " ", "=", " ", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{"pr", ",", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Which", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{"i", ",", " ", "j"}], "}"}], " ", "==", " ", "pr"}], ",",
              " ", "1.", ",", " ", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"j", ",", " ", "i"}], "}"}], " ", "==", " ", "pr"}], ",",
              " ", 
             RowBox[{"-", "1."}], ",", " ", "True", ",", " ", "0."}], "]"}], ",",
            " ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "8"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"j", ",", " ", "8"}], "}"}]}], "]"}]}], "]"}], ",", " ", 
       "gzPairs"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"gzCoeffs", "[", "p", "]"}], ":", " ", 
      RowBox[{
      "the", " ", "coefficients", " ", "of", " ", "an", " ", "antisymmetric", 
       " ", "matrix", " ", "in", " ", "this", " ", "basis", " ", 
       RowBox[{"(", 
        RowBox[{
        "its", " ", "entries", " ", "above", " ", "the", " ", "diagonal"}], 
        ")"}]}]}], ";", "\n", "   ", 
     RowBox[{
      RowBox[{"gzFromCoeffs", "[", "v", "]"}], ":", " ", 
      RowBox[{
      "the", " ", "antisymmetric", " ", "matrix", " ", "of", " ", "the", " ", 
       "coefficients", " ", "v"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"gzCoeffs", "[", "p_", "]"}], " ", ":=", " ", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"p", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}], " ", "&"}], ",", 
       " ", "gzPairs"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"gzFromCoeffs", "[", "v_", "]"}], " ", ":=", " ", 
     RowBox[{"v", " ", ".", " ", "gzBasis"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"gzAlpha8", "[", "j", "]"}], ":", " ", 
      RowBox[{
       RowBox[{"alpha", "^", "j_LL"}], " ", 
       RowBox[{"(", "x", ")"}], " ", "1", "_", "2", " ", 
       RowBox[{"(", "numerical", ")"}]}]}], ";", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"gzH", "[", "q", "]"}], ":", " ", 
       RowBox[{"the", " ", "free", " ", "matrix", " ", "h_LL", 
        RowBox[{"(", "q", ")"}]}]}], " ", "=", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"beta", " ", "m_LL"}], " ", "+", " ", 
         RowBox[{"alpha", " ", ".", " ", "q"}]}], ")"}], " ", 
       RowBox[{"(", "x", ")"}], " ", "1", "_", "2"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"gzAlpha8", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"N", "[", 
        RowBox[{"d8", "[", 
         RowBox[{"alphaLL", "[", "j", "]"}], "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"gzH", "[", "q_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"N", "[", "mLL", "]"}], " ", "b8"}], " ", "+", " ", 
      RowBox[{
       RowBox[{"q", "[", 
        RowBox[{"[", "1", "]"}], "]"}], " ", 
       RowBox[{"gzAlpha8", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"q", "[", 
        RowBox[{"[", "2", "]"}], "]"}], " ", 
       RowBox[{"gzAlpha8", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"q", "[", 
        RowBox[{"[", "3", "]"}], "]"}], " ", 
       RowBox[{"gzAlpha8", "[", 
        RowBox[{"[", "3", "]"}], "]"}]}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"gzTwist", "[", 
      RowBox[{"q", ",", " ", "t2"}], "]"}], ":", " ", 
     RowBox[{"the", " ", "twist", " ", "q", " ", 
      RowBox[{"alpha", "^", "3"}], "_LL", " ", 
      RowBox[{"(", "x", ")"}], " ", "t2", " ", 
      RowBox[{"(", 
       RowBox[{
       "t2", " ", "a", " ", "2", " ", "x", " ", "2", " ", "isospin", " ", 
        "matrix"}], ")"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"gzTwist", "[", 
      RowBox[{"q_", ",", " ", "t2_"}], "]"}], " ", ":=", " ", 
     RowBox[{"q", " ", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{"d8", "[", 
         RowBox[{"alphaLL", "[", "3", "]"}], "]"}], " ", ".", " ", 
        RowBox[{"i8", "[", "t2", "]"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"gzDF", "[", 
       RowBox[{"e1", ",", " ", "e2", ",", " ", "t"}], "]"}], ":", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"f", 
          RowBox[{"(", "e1", ")"}]}], " ", "-", " ", 
         RowBox[{"f", 
          RowBox[{"(", "e2", ")"}]}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"e1", " ", "-", " ", "e2"}], ")"}]}]}], ",", " ", 
     RowBox[{
      RowBox[{"and", " ", 
       RowBox[{"f", "'"}], 
       RowBox[{"(", "e", ")"}]}], " ", "=", " ", 
      RowBox[{
       RowBox[{"-", "f"}], " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", " ", "-", " ", "f"}], ")"}], "/", "t"}], " ", "where", " ",
        "the", " ", "two", " ", "energies", " ", "coincide"}]}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"gzDF", "[", 
      RowBox[{"e1_", ",", " ", "e2_", ",", " ", "t_"}], "]"}], " ", ":=", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"e1", " ", "-", " ", "e2"}], "]"}], " ", "<", " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "7"}]}]}], ",", " ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"f", " ", "=", " ", 
           RowBox[{"fermiSF", "[", 
            RowBox[{
             RowBox[{"0.5", " ", 
              RowBox[{"(", 
               RowBox[{"e1", " ", "+", " ", "e2"}], ")"}]}], ",", " ", "t"}], 
            "]"}]}], "}"}], ",", " ", 
         RowBox[{
          RowBox[{"-", "f"}], " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", " ", "-", " ", "f"}], ")"}], "/", "t"}]}]}], "]"}], ",",
        " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"fermiSF", "[", 
           RowBox[{"e1", ",", " ", "t"}], "]"}], " ", "-", " ", 
          RowBox[{"fermiSF", "[", 
           RowBox[{"e2", ",", " ", "t"}], "]"}]}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"e1", " ", "-", " ", "e2"}], ")"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"gzResponse", "[", 
       RowBox[{
       "qs", ",", " ", "ws", ",", " ", "ns", ",", " ", "x", ",", " ", "t"}], 
       "]"}], ":", " ", 
      RowBox[{"the", " ", "static", " ", "pair", " ", "response", " ", 
       RowBox[{"X", "^", "P"}], " ", "of", " ", "the", " ", "28", " ", 
       "basis", " ", "matrices", " ", "at", " ", "the", " ", "temperature", " ",
        "t", " ", "on", " ", "the", "\n", "   ", "momenta", " ", "qs", " ", 
       "with", " ", "the", " ", "weights", " ", "ws", " ", "of", " ", "int", " ", 
       RowBox[{"d", "^", "3"}], 
       RowBox[{"q", "/", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"2", " ", "pi"}], ")"}], "^", "3"}]}]}]}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"for", " ", "the", " ", "normal", " ", "self"}], "-", 
       RowBox[{"energy", " ", "ns", " ", "and", " ", "the", " ", "twist", " ", 
        RowBox[{"x", ".", "  ", "At"}], " ", "each", " ", 
        RowBox[{"node", ":", "\n", "   ", 
         RowBox[{
         "the", " ", "eigenvalues", " ", "ea", " ", "and", " ", 
          "eigenvectors", " ", 
          RowBox[{"(", 
           RowBox[{"rows", " ", "of", " ", "va"}], ")"}], " ", "of", " ", 
          "the", " ", "particle", " ", "block", " ", "A"}]}]}]}], " ", "=", 
      " ", 
      RowBox[{
       RowBox[{"h", 
        RowBox[{"(", "q", ")"}]}], " ", "+", " ", "N", " ", "+", " ", "X"}]}],
      ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
       "ed", " ", "and", " ", "vd", " ", "of", " ", "the", " ", "hole", " ", 
        "block", "\n", "   ", "D"}], " ", "=", " ", 
