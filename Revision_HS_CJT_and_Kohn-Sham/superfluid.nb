        StyleBox["P",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["SF",
         FontSlant->"Plain"], "\[Dagger]"], 
       RowBox[{"-", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SubscriptBox[
            StyleBox["h",
             FontFamily->"Helvetica",
             FontSlant->"Plain"], 
            StyleBox["LL",
             FontSlant->"Plain"]], 
           RowBox[{"(", 
            RowBox[{"-", 
             SubscriptBox[
              OverscriptBox[
               StyleBox["q", "TI"], "\[RightVector]"], 
              StyleBox["LL",
               FontSlant->"Plain"]]}], ")"}], "+", 
           SubscriptBox[
            StyleBox["N",
             FontFamily->"Helvetica",
             FontSlant->"Plain"], 
            StyleBox["SF",
             FontSlant->"Plain"]]}], ")"}], 
         StyleBox["T", "TI"]]}]}
     },
     GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.7]}, 
         Offset[0.27999999999999997`]}, "Rows" -> {
         Offset[0.2], {
          Offset[0.4]}, 
         Offset[0.2]}}], "\[NoBreak]", ")"}], ","}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"2623ed81-f142-4a90-9a79-7c81039d73c2"],

Cell[TextData[{
 "whose projector onto the negative eigenvalues gives ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["C",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["n",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "97da0dea-6c99-4f02-b9a3-983febbbc08d"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SubsuperscriptBox[
     StyleBox["C",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "90aaae43-cf02-4d4b-b84c-60a729f793fe"],
 " as its upper blocks. ",
 StyleBox["The grid:",
  FontWeight->"Bold"],
 " 24 Gauss-Legendre nodes of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftBracketingBar]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["q", "TI"], "\[RightVector]"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[RightBracketingBar]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6c49cf13-6b7f-40cb-922d-b90fefa3cd78"],
 " on ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"0", ",", 
     SubscriptBox["\[CapitalLambda]", 
      StyleBox["LL",
       FontSlant->"Plain"]]}], "]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "17af3cac-ad11-491c-859f-e297b86d2b2a"],
 " times the six directions ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["e", "TI"], "\[RightVector]"], 
     StyleBox["j", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9a986748-c3b9-48a1-84e3-4bca56b4478b"],
 ", with the weight ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["w", "TI"], 
     StyleBox["r",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     StyleBox["q", "TI"], "2"], "/", 
    RowBox[{"(", 
     RowBox[{"2", 
      SuperscriptBox["\[Pi]", "2"]}], ")"}], "/", "6"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "522b2303-d14e-49c8-9a4a-3961a73c1a94"],
 " of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Integral]", "\[ThinSpace]", 
    SuperscriptBox[
     StyleBox["d", "TI"], "3"], 
    StyleBox["q", "TI"], "/", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"2", "\[Pi]"}], ")"}], "3"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e288e792-5192-401a-adfa-941a546611f2"],
 ". ",
 StyleBox["The iteration:",
  FontWeight->"Bold"],
 " the self-energies are mixed (new times 0.6 plus old times 0.4) until they \
change by less than ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "12"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9ed785b8-0a0f-4a56-97a8-239996d048e8"],
 ". The gap is the minimum over ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "\[LessEqual]", 
    RowBox[{"\[LeftBracketingBar]", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["q", "TI"], "\[RightVector]"], 
      StyleBox["LL",
       FontSlant->"Plain"]], "\[RightBracketingBar]"}], "\[LessEqual]", 
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9e6f09b1-09da-4329-b7c6-96da4d65808c"],
 " of the smallest eigenvalue modulus of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["H",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "df4b3203-5e30-46d3-a54c-e59833d142ca"],
 " (401 momenta and a golden-section refinement), and the Dirac mass is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "+", 
    FractionBox["1", "8"], 
    StyleBox["tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[Beta]", 
         StyleBox["LL",
          FontSlant->"Plain"]], "\[CircleTimes]", 
        SubscriptBox[
         StyleBox["1",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], "2"]}], ")"}], 
      SubscriptBox[
       StyleBox["N",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["SF",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f64553c6-c179-420e-8a86-dd6f2a554e98"],
 ". The next cell defines this engine; the cell after it checks that the \
self-energies are the derivatives of the energy (central differences on \
random states) and that the engine with the pairing term alone reproduces the \
analytic solution AS3 of Part I."
}], "Text",ExpressionUUID->"66b39167-0005-4eaa-a29c-b231b356f9e1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"--", " ", "the"}]}], " ", "constants", " ", "and", " ", 
    "matrices", " ", "of", " ", "the", " ", "engine", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"floating", " ", "point"}], ")"}], " ", "--"}], "--"}]}], " ", 
   "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"lamLL", " ", "=", " ", "1."}], ";"}], 
   "                                   ", 
   RowBox[{"(*", " ", 
    RowBox[{"the", " ", "momentum", " ", "cutoff", " ", "Lambda_LL"}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"gvLL", ",", " ", "gfLL"}], "}"}], " ", "=", " ", 
