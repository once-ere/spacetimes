        "}"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<sign changes of the residual of the Landau form\>\"", ",",
          " ", 
         RowBox[{
          RowBox[{
           RowBox[{"lfResults", "[", "#", "]"}], "[", "\"\<signs\>\"", "]"}], 
          " ", "&"}]}], "}"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<10^3 c fitted on [0, Phi0]\>\"", ",", " ", 
         RowBox[{
          RowBox[{"NumberForm", "[", 
           RowBox[{
            RowBox[{"1000", " ", 
             RowBox[{
              RowBox[{"lfResults", "[", "#", "]"}], "[", "\"\<rng1_c\>\"", 
              "]"}]}], ",", " ", "4"}], "]"}], " ", "&"}]}], "}"}], ",", "\n",
        "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<10^3 c fitted on [0, 1.4 Phi0]\>\"", ",", " ", 
         RowBox[{
          RowBox[{"NumberForm", "[", 
           RowBox[{
            RowBox[{"1000", " ", 
             RowBox[{
              RowBox[{"lfResults", "[", "#", "]"}], "[", "\"\<rng2_c\>\"", 
              "]"}]}], ",", " ", "4"}], "]"}], " ", "&"}]}], "}"}], ",", "\n",
        "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<10^3 c fitted on the whole curve\>\"", ",", " ", 
         RowBox[{
          RowBox[{"NumberForm", "[", 
           RowBox[{
            RowBox[{"1000", " ", 
             RowBox[{
              RowBox[{"lfResults", "[", "#", "]"}], "[", "\"\<rng3_c\>\"", 
              "]"}]}], ",", " ", "4"}], "]"}], " ", "&"}]}], "}"}], ",", "\n",
        "   ", 
       RowBox[{"{", 
