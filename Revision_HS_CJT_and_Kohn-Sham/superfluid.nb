         " ", "\"\<K'^2 (pseudoscalar 0-)\>\"", ",", " ", 
         RowBox[{"-", "1.00000000000000000*^0"}]}], "}"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<boson W2 (1/2) sum eta :j^p j_p:\>\"", ",", 
         " ", "\"\<K'^3 (pseudoscalar 0-)\>\"", ",", " ", 
         "1.00000000000000000*^0"}], "}"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<boson W3 (1/2) sum eta :j^p j_p:\>\"", ",", 
         " ", "\"\<K^1 (scalar 0+)\>\"", ",", " ", "1.00000000000000000*^0"}],
         "}"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<boson W3 (1/2) sum eta :j^p j_p:\>\"", ",", 
         " ", "\"\<K^2 (scalar 0+)\>\"", ",", " ", "1.00000000000000000*^0"}],
         "}"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<boson W3 (1/2) sum eta :j^p j_p:\>\"", ",", 
         " ", "\"\<K^3 (scalar 0+)\>\"", ",", " ", 
         RowBox[{"-", "1.00000000000000000*^0"}]}], "}"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<boson W3 (1/2) sum eta :j^p j_p:\>\"", ",", 
         " ", "\"\<K'^1 (pseudoscalar 0-)\>\"", ",", " ", 
         "1.00000000000000000*^0"}], "}"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<boson W3 (1/2) sum eta :j^p j_p:\>\"", ",", 
         " ", "\"\<K'^2 (pseudoscalar 0-)\>\"", ",", " ", 
         "1.00000000000000000*^0"}], "}"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<boson W3 (1/2) sum eta :j^p j_p:\>\"", ",", 
         " ", "\"\<K'^3 (pseudoscalar 0-)\>\"", ",", " ", 
         RowBox[{"-", "1.00000000000000000*^0"}]}], "}"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<boson B (1/2) sum eta :j^p j_p:\>\"", ",", 
         " ", "\"\<K^1 (scalar 0+)\>\"", ",", " ", "4.00000000000000000*^0"}],
         "}"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<boson B (1/2) sum eta :j^p j_p:\>\"", ",", 
         " ", "\"\<K^2 (scalar 0+)\>\"", ",", " ", "4.00000000000000000*^0"}],
         "}"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<boson B (1/2) sum eta :j^p j_p:\>\"", ",", 
         " ", "\"\<K^3 (scalar 0+)\>\"", ",", " ", "4.00000000000000000*^0"}],
         "}"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<boson B (1/2) sum eta :j^p j_p:\>\"", ",", 
         " ", "\"\<K'^1 (pseudoscalar 0-)\>\"", ",", " ", 
         "4.00000000000000000*^0"}], "}"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<boson B (1/2) sum eta :j^p j_p:\>\"", ",", 
         " ", "\"\<K'^2 (pseudoscalar 0-)\>\"", ",", " ", 
         "4.00000000000000000*^0"}], "}"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<boson B (1/2) sum eta :j^p j_p:\>\"", ",", 
         " ", "\"\<K'^3 (pseudoscalar 0-)\>\"", ",", " ", 
         "4.00000000000000000*^0"}], "}"}]}], "}"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<values of the Rust program sf_part2: \>\"", ",", " ", 
      RowBox[{"Length", "[", "rustPart2", "]"}], ",", 
      " ", "\"\<; rows of its table of pair channels: \>\"", ",", " ", 
      RowBox[{"Length", "[", "rustPairChannels", "]"}]}], "]"}], 
    ";"}]}]}]], "Input",
 CellOpen->False,
 CellLabel->
  "In[182]:=",ExpressionUUID->"cb77c640-2499-4952-ab12-9692d6f96557"],

