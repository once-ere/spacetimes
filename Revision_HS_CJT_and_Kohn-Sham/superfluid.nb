Cell[TextData[{
 StyleBox["The exchange of the gauge bosons.",
  FontWeight->"Bold"],
 " Beyond their contact limit, the four gauge bosons are exchanged between \
the charges with the propagator ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"\[LeftBracketingBar]", 
        RowBox[{
         OverscriptBox[
          StyleBox["q", "TI"], "\[RightVector]"], "-", 
         RowBox[{
          OverscriptBox[
           StyleBox["q", "TI"], "\[RightVector]"], "\[ThinSpace]", 
          SuperscriptBox["", "\[Prime]"]}]}], "\[RightBracketingBar]"}], "2"],
       "+", 
      SuperscriptBox[
       StyleBox["M", "TI"], "2"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c2ffeb61-426b-415c-9aa8-e9dc642f3413"],
 " of a boson of mass ",
 Cell[BoxData[
  FormBox[
   StyleBox["M", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3c3c22d4-cc30-4dc1-9073-dd341cb190bf"],
 ". In a uniform state the exchange self-energies at the momentum ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["q", "TI"], "\[RightVector]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "14133122-2fc3-4e86-9556-96ad9a4fbae3"],
 " are integrals over ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     StyleBox["q", "TI"], "\[RightVector]"], "\[ThinSpace]", 
    SuperscriptBox["", "\[Prime]"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6dd216f1-2b87-4d6d-9901-457457ef95c1"],
 " of the correlation matrices; with the six directions of the grid the \
correlation matrix at a radius has a part of angular momentum 0 (the mean \
over the directions) and three parts of angular momentum 1, and the angular \
integrals reduce to the two angular averages"
}], "Text",ExpressionUUID->"b3fb2ca6-a8b0-43c7-a4c9-3c16a02888bb"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["D", "TI"], "0"], 
   RowBox[{"(", 
    RowBox[{
     StyleBox["q", "TI"], ",", 
     SuperscriptBox[
      StyleBox["q", "TI"], "\[Prime]"]}], ")"}], "\[LongEqual]", 
   FractionBox["1", "2"], "\[ThinSpace]", 
   SubsuperscriptBox["\[Integral]", 
    RowBox[{"-", "1"}], "1"], "\[ThinSpace]", 
   FractionBox[
    StyleBox["dx", "TI"], 
    RowBox[{
     SuperscriptBox[
      StyleBox["q", "TI"], "2"], "+", 
     SuperscriptBox[
      StyleBox["q", "TI"], 
      RowBox[{"\[Prime]", "2"}]], "+", 
     SuperscriptBox[
      StyleBox["M", "TI"], "2"], "-", "2", 
     StyleBox["q", "TI"], 
     SuperscriptBox[
      StyleBox["q", "TI"], "\[Prime]"], 
     StyleBox["x", "TI"]}]], ",", "      ", 
   SubscriptBox[
    StyleBox["D", "TI"], "1"], 
   RowBox[{"(", 
    RowBox[{
     StyleBox["q", "TI"], ",", 
     SuperscriptBox[
      StyleBox["q", "TI"], "\[Prime]"]}], ")"}], "\[LongEqual]", 
   FractionBox["1", "2"], "\[ThinSpace]", 
   SubsuperscriptBox["\[Integral]", 
    RowBox[{"-", "1"}], "1"], "\[ThinSpace]", 
   FractionBox[
    RowBox[{
     StyleBox["x", "TI"], "\[ThinSpace]", 
     StyleBox["dx", "TI"]}], 
    RowBox[{
     SuperscriptBox[
      StyleBox["q", "TI"], "2"], "+", 
     SuperscriptBox[
      StyleBox["q", "TI"], 
      RowBox[{"\[Prime]", "2"}]], "+", 
     SuperscriptBox[
      StyleBox["M", "TI"], "2"], "-", "2", 
     StyleBox["q", "TI"], 
     SuperscriptBox[
      StyleBox["q", "TI"], "\[Prime]"], 
     StyleBox["x", "TI"]}]], ","}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"b048ae12-049e-4781-80cd-4aa79df730e4"],

Cell[TextData[{
 "whose closed forms contain ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["ln",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         StyleBox["q", "TI"], "-", 
         SuperscriptBox[
          StyleBox["q", "TI"], "\[Prime]"]}], ")"}], "2"], "+", 
      SuperscriptBox[
       StyleBox["M", "TI"], "2"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "30a3b9dc-2b14-45b8-92cf-a24f2e99f951"],
 ", singular at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["q", "TI"], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["q", "TI"], "\[Prime]"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "de991dfc-6e65-4ef5-be26-ab9b32aad0d0"],
 " for a massless boson; the radial integral subtracts this logarithm at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["q", "TI"], "\[Prime]"], "\[LongEqual]", 
    StyleBox["q", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "00844986-2b5c-4e5a-bdbb-a29bef960166"],
 " and integrates it exactly (",
 StyleBox["kernIntegral",
  FontFamily->"Source Code Pro"],
 "). The next cell compares the closed forms with a numerical integration \
over the angle; then it computes the Thouless eigenvalues of the exchange of \
the photon ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "557a8c7a-9ccc-423c-b494-6257fb5d4361"],
 " alone and of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5d2a4f95-c2e4-4098-9a47-9f8f5c68c4b4"],
 " alone in the normal vacuum (per unit squared coupling; a positive \
eigenvalue attracts the pair ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6fe2e81e-8d7f-4972-9e41-8f9ad5f10ee2"],
 "), by power iteration; and finally the CJT state of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "2", ")"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "08c6aac5-f777-42d7-95f1-bde3279d77dc"],
 " with the exchange of all four bosons at the couplings ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]], "\[LongEqual]", "0.7"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c6744d91-92c0-4a12-acdf-400324c64b7e"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]], "\[LongEqual]", "0.45"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "29cd7f8e-0eaf-4a32-b853-0bf1d3ce18be"],
 " and the boson masses of the Rust program."
}], "Text",ExpressionUUID->"accf3176-c429-4502-8083-07a14b6ae0e1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"kernSF", "[", 
      RowBox[{"g", ",", " ", "mass"}], "]"}], ":", " ", 
     RowBox[{"the", " ", "radial", " ", "kernels", " ", "of", " ", "D0"}]}], ",",
     " ", 
    RowBox[{"D1", " ", "in", " ", "closed", " ", 
     RowBox[{"form", ":", " ", 
      RowBox[{"{", 
       RowBox[{"r0", ",", " ", "r1"}], "}"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"s0", ",", " ", "s1"}], "}"}], " ", "with", " ", "D_l"}], " ", 
     "=", " ", 
     RowBox[{"r_l", " ", "+", " ", 
      RowBox[{"s_l", " ", "ln", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"q", " ", "-", " ", 
            RowBox[{"q", "'"}]}], ")"}], "^", "2"}], " ", "+", " ", 
         RowBox[{"M", "^", "2"}]}], ")"}]}]}]}], ",", "\n", "   ", 
    RowBox[{"the", " ", "logarithm", " ", "lm"}], ",", " ", 
    RowBox[{
     RowBox[{"and", " ", "aq"}], " ", "=", " ", 
     RowBox[{"the", " ", "exact", " ", "integral", " ", "of", " ", "ln", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"q", " ", "-", " ", 
           RowBox[{"q", "'"}]}], ")"}], "^", "2"}], " ", "+", " ", 
        RowBox[{"M", "^", "2"}]}], ")"}], " ", "over", " ", 
      RowBox[{"q", "'"}], " ", 
      RowBox[{"in", " ", "[", 
       RowBox[{"0", ",", " ", "Lambda"}], "]"}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"kernSF", "[", 
      RowBox[{"g_", ",", " ", "mass_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"kr", " ", "=", " ", 
          RowBox[{"g", "[", "\"\<kr\>\"", "]"}]}], ",", " ", "q", ",", " ", 
         "qp", ",", " ", "a", ",", " ", "b", ",", " ", "lp", ",", " ", "lm", ",",
          " ", "fp"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"q", " ", "=", " ", 
         RowBox[{"Outer", "[", 
          RowBox[{
           RowBox[{"#1", " ", "&"}], ",", " ", "kr", ",", " ", "kr"}], 
          "]"}]}], ";", " ", 
        RowBox[{"qp", " ", "=", " ", 
         RowBox[{"Outer", "[", 
          RowBox[{
           RowBox[{"#2", " ", "&"}], ",", " ", "kr", ",", " ", "kr"}], 
          "]"}]}], ";", "\n", "   ", 
        RowBox[{"a", " ", "=", " ", 
         RowBox[{
          RowBox[{"q", "^", "2"}], " ", "+", " ", 
          RowBox[{"qp", "^", "2"}], " ", "+", " ", 
          RowBox[{"mass", "^", "2"}]}]}], ";", " ", 
        RowBox[{"b", " ", "=", " ", 
         RowBox[{"2", " ", "q", " ", "qp"}]}], ";", " ", 
        RowBox[{"lp", " ", "=", " ", 
         RowBox[{"Log", "[", 
          RowBox[{"a", " ", "+", " ", "b"}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"lm", " ", "=", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"mass", " ", "==", " ", "0"}], " ", "&&", " ", 
              RowBox[{"i", " ", "==", " ", "j"}]}], ",", " ", "0.", ",", " ", 
             
             RowBox[{"Log", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"kr", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], " ", "-", " ", 
                  RowBox[{"kr", "[", 
                   RowBox[{"[", "j", "]"}], "]"}]}], ")"}], "^", "2"}], " ", "+",
                " ", 
               RowBox[{"mass", "^", "2"}]}], "]"}]}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", 
             RowBox[{"Length", "[", "kr", "]"}]}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"j", ",", " ", 
             RowBox[{"Length", "[", "kr", "]"}]}], "}"}]}], "]"}]}], ";", 
        "\n", "   ", 
        RowBox[{
         RowBox[{"fp", "[", "x_", "]"}], " ", ":=", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"mass", " ", "==", " ", "0"}], ",", " ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"x", " ", "==", " ", "0"}], ",", " ", "0.", ",", " ", 
             RowBox[{
              RowBox[{"x", " ", 
               RowBox[{"Log", "[", 
                RowBox[{"x", "^", "2"}], "]"}]}], " ", "-", " ", 
              RowBox[{"2", " ", "x"}]}]}], "]"}], ",", " ", 
           RowBox[{
            RowBox[{"x", " ", 
             RowBox[{"Log", "[", 
              RowBox[{
               RowBox[{"x", "^", "2"}], " ", "+", " ", 
               RowBox[{"mass", "^", "2"}]}], "]"}]}], " ", "-", " ", 
            RowBox[{"2", " ", "x"}], " ", "+", " ", 
            RowBox[{"2", " ", "mass", " ", 
             RowBox[{"ArcTan", "[", 
              RowBox[{"x", "/", "mass"}], "]"}]}]}]}], "]"}]}], ";", "\n", 
        "   ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<r\>\"", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"lp", "/", 
              RowBox[{"(", 
               RowBox[{"2", " ", "b"}], ")"}]}], ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "1"}], "/", "b"}], " ", "+", " ", 
              RowBox[{"a", " ", 
               RowBox[{"lp", "/", 
                RowBox[{"(", 
                 RowBox[{"2", " ", 
                  RowBox[{"b", "^", "2"}]}], ")"}]}]}]}]}], "}"}]}], ",", " ", 
          RowBox[{"\"\<s\>\"", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "1"}], "/", 
              RowBox[{"(", 
               RowBox[{"2", " ", "b"}], ")"}]}], ",", " ", 
             RowBox[{
              RowBox[{"-", "a"}], "/", 
              RowBox[{"(", 
               RowBox[{"2", " ", 
                RowBox[{"b", "^", "2"}]}], ")"}]}]}], "}"}]}], ",", " ", 
          RowBox[{"\"\<lm\>\"", " ", "->", " ", "lm"}], ",", "\n", "     ", 
          RowBox[{"\"\<aq\>\"", " ", "->", " ", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"fp", "[", 
                RowBox[{"lamLL", " ", "-", " ", "#"}], "]"}], " ", "-", " ", 
               RowBox[{"fp", "[", 
                RowBox[{"-", "#"}], "]"}]}], " ", "&"}], ",", " ", "kr"}], 
            "]"}]}], ",", " ", 
          RowBox[{"\"\<g\>\"", " ", "->", " ", "g"}]}], "|>"}]}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"kernIntegral", "[", 
       RowBox[{"kern", ",", " ", "l", ",", " ", "f"}], "]"}], ":", " ", 
      RowBox[{"the", " ", "integral", " ", "over", " ", 
       RowBox[{"q", "'"}], " ", "of", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"q", "'"}], "^", "2"}], "/", 
        RowBox[{"(", 
