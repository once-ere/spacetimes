Cell[CellGroupData[{

Cell["\<\
I.4 The gauge group GEE and its covariant derivatives (item 3)\
\>", "Section",ExpressionUUID->"cb31b4ee-637a-496d-af97-12093cc0aabf"],

Cell[TextData[{
 "The gauge group is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["GEE",
     FontSlant->"Plain"], "\[LongEqual]", 
    StyleBox["SL", "TI"], 
    RowBox[{"(", 
     RowBox[{"2", ",", 
      StyleBox["\[DoubleStruckCapitalC]",
       FontSlant->"Plain"]}], ")"}], "\[Times]", 
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["v",
      FontSlant->"Plain"]], "\[Times]", 
    StyleBox["U", "TI"], 
    SubsuperscriptBox[
     RowBox[{"(", "1", ")"}], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8ccb2ee7-d1fe-4a1c-ad36-2334282e5c01"],
 ". A local transformation is a unit bi-quaternion ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["g",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     StyleBox["x", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7f531699-d620-43cc-b706-9b0fd5d4119b"],
 ", an isospin rotation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["U",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["x", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c3e3a3cf-5f28-4f04-8c1e-e0eb8127e60f"],
 " and a phase ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Theta]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["x", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "46f63c2c-7fed-4798-ad13-a60984626e16"],
 "; it acts on the spinor field as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[RightTeeArrow]", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      StyleBox["i", "TI"], 
      SubsuperscriptBox["\[Theta]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["F",
        FontSlant->"Plain"]]}]], 
    SubscriptBox[
     StyleBox["S",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[CircleTimes]", 
    SubscriptBox[
     StyleBox["U",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[ThinSpace]", 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bd4b0e71-ebd2-4e6a-a393-b42a048278b0"],
 ". The gauge fields are the Lorentz connection with the spin connection ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalGamma]", 
    StyleBox["p", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "416e0f7c-571c-470e-9537-2f2120e7e736"],
 ", the field of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["v",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5de7f72e-1aa0-4b0f-a94f-3b6b3e428140"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["W",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}]], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", "\[Iota]",
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["W", "TI"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], "\[Iota]"], 
    SubsuperscriptBox["\[Tau]", "\[Iota]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "/", "2"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ee3cf485-1217-42f0-9912-bc7c87bcd7e8"],
 ", and the field ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["B", "TI"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1292eff3-df69-48d7-8ed2-43f8ed41b6c1"],
 " of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["U", "TI"], 
    SubsuperscriptBox[
     RowBox[{"(", "1", ")"}], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "10376411-479d-4fb9-93bf-9d1ba897cba2"],
 ", with the couplings ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["v",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6e24ff93-f947-49b3-8246-0f3e589e6fff"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["F",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "102f15a3-a13e-4730-a6e5-a2fb85b1a57f"],
 ". The covariant derivative of the spinor field is"
}], "Text",ExpressionUUID->"85a92479-593b-4daf-af32-f6d55e7922d0"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["\[Del]", 
    StyleBox["p", "TI"], 
    StyleBox["GEE",
     FontSlant->"Plain"]], 
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], "\[LongEqual]", 
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["\[PartialD]", 
      StyleBox["p", "TI"]], "+", 
     SubsuperscriptBox["\[CapitalGamma]", 
      StyleBox["p", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"]], "+", 
     StyleBox["i", "TI"], 
     SubsuperscriptBox[
      StyleBox["g", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["v",
       FontSlant->"Plain"]], "\[ThinSpace]", 
     SubscriptBox[
      StyleBox["1",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "4"], "\[CircleTimes]", 
     SubscriptBox[
      StyleBox["W",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["SF",
        FontSlant->"Plain"], ",", 
       StyleBox["p", "TI"]}]], "+", 
     StyleBox["i", "TI"], 
     SubsuperscriptBox[
      StyleBox["g", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["F",
       FontSlant->"Plain"]], 
     SubscriptBox[
      StyleBox["B", "TI"], 
      RowBox[{
       StyleBox["SF",
        FontSlant->"Plain"], ",", 
       StyleBox["p", "TI"]}]]}], ")"}], 
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], ","}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"e3f8e080-8fe9-48c7-9076-cd9c04195769"],

Cell[TextData[{
 "and it is covariant, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Del]", 
     StyleBox["p", "TI"], 
     RowBox[{"\[Prime]", 
      StyleBox["GEE",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["\[ScriptCapitalU]",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      SubscriptBox["\[CapitalPsi]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["\[ScriptCapitalU]",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Del]", 
     StyleBox["p", "TI"], 
     StyleBox["GEE",
      FontSlant->"Plain"]], 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0b816b10-f2ed-49ca-91db-5faa4b5375c4"],
 ", when the gauge fields transform as"
}], "Text",ExpressionUUID->"16adb995-dda7-439b-b10b-e97ff4364480"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["\[CapitalGamma]", 
    StyleBox["p", "TI"], 
    RowBox[{"\[Prime]", 
     StyleBox["LL",
      FontSlant->"Plain"]}]], "\[LongEqual]", 
   StyleBox["S",
    FontFamily->"Helvetica",
    FontSlant->"Plain"], "\[ThinSpace]", 
   SubsuperscriptBox["\[CapitalGamma]", 
    StyleBox["p", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["S",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{"-", "1"}]], "-", 
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["\[PartialD]", 
      StyleBox["p", "TI"]], 
     StyleBox["S",
      FontFamily->"Helvetica",
      FontSlant->"Plain"]}], ")"}], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["S",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{"-", "1"}]], ",", "      ", 
   SubsuperscriptBox[
    StyleBox["W",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}], "\[Prime]"], "\[LongEqual]", 
   SubscriptBox[
    StyleBox["U",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   SubscriptBox[
    StyleBox["W",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}]], 
   SubsuperscriptBox[
    StyleBox["U",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Dagger]"], "+", 
   FractionBox[
    StyleBox["i", "TI"], 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]]], 
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["\[PartialD]", 
      StyleBox["p", "TI"]], 
     SubscriptBox[
      StyleBox["U",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"]]}], ")"}], 
   SubsuperscriptBox[
    StyleBox["U",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Dagger]"], ",", "      ", 
   SubsuperscriptBox[
    StyleBox["B", "TI"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}], "\[Prime]"], "\[LongEqual]", 
   SubscriptBox[
    StyleBox["B", "TI"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}]], "-", 
   FractionBox["1", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]]], 
   SubscriptBox["\[PartialD]", 
    StyleBox["p", "TI"]], 
   SubsuperscriptBox["\[Theta]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["F",
     FontSlant->"Plain"]], "."}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"41e2c697-8d4c-43d2-b773-e6cd4d272232"],

Cell[TextData[{
 "An isospin vector of fermion number 2 and spin 0, such as the pair field ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[CapitalPhi]", "\[RightVector]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1c68cda0-ded4-4a28-9f85-d8d1852253c2"],
 " of the superfluid, has the covariant derivative ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Del]", 
     StyleBox["p", "TI"]], 
    OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "\[LongEqual]", 
    SubscriptBox["\[PartialD]", 
     StyleBox["p", "TI"]], 
    OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "-", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["W", "TI"], "\[RightVector]"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}]], "\[Times]", 
    OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "+", "2", 
    StyleBox["i", "TI"], 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["B", "TI"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}]], 
    OverscriptBox["\[CapitalPhi]", "\[RightVector]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e6b6a339-296b-4557-bc5e-2a424d973c83"],
 "; the field strengths are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["W",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], "\[LongEqual]", 
    SubscriptBox["\[PartialD]", 
     StyleBox["p", "TI"]], 
    SubscriptBox[
     StyleBox["W",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], "-", 
    SubscriptBox["\[PartialD]", 
     SuperscriptBox[
      StyleBox["p", "TI"], "\[Prime]"]], 
    SubscriptBox[
     StyleBox["W",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}]], "+", 
    StyleBox["i", "TI"], 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]], 
    RowBox[{"[", 
     RowBox[{
      SubscriptBox[
       StyleBox["W",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["SF",
         FontSlant->"Plain"], ",", 
        StyleBox["p", "TI"]}]], ",", 
      SubscriptBox[
       StyleBox["W",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["SF",
         FontSlant->"Plain"], ",", 
        SuperscriptBox[
         StyleBox["p", "TI"], "\[Prime]"]}]]}], "]"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "97e8c03b-d817-42a9-9cc7-98a4de3ce6ba"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["B", "TI"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], "\[LongEqual]", 
    SubscriptBox["\[PartialD]", 
     StyleBox["p", "TI"]], 
    SubscriptBox[
     StyleBox["B", "TI"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], "-", 
    SubscriptBox["\[PartialD]", 
     SuperscriptBox[
      StyleBox["p", "TI"], "\[Prime]"]], 
    SubscriptBox[
     StyleBox["B", "TI"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2094325b-10d9-4954-a119-f7bb12563957"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["W",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}], "\[Prime]"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["U",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["W",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], 
    SubsuperscriptBox[
     StyleBox["U",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Dagger]"]}], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c264c502-e79d-4d2e-9210-81dcfe935abb"],
 "."
}], "Text",ExpressionUUID->"31765ae1-f506-4423-b538-a2d45241b275"],

Cell[TextData[{
 "The next cell checks these covariance laws with random smooth fields: the \
isospin rotation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["U",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["x", "TI"], ")"}], "\[LongEqual]", 
    StyleBox["exp",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       StyleBox["i", "TI"], "2"], "\[ThinSpace]", 
      UnderscriptBox["\[Sum]", "\[Iota]",
       LimitsPositioning->True], "\[ThinSpace]", 
      SuperscriptBox[
       StyleBox["a", "TI"], "\[Iota]"], 
      RowBox[{"(", 
       StyleBox["x", "TI"], ")"}], 
      SubsuperscriptBox["\[Tau]", "\[Iota]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f68e9653-09f6-40da-b965-786e4dbd9f6d"],
 ", the phase, the gauge fields and the test fields are sums of sines of the \
four coordinates with random coefficients. The derivatives are computed \
symbolically by the function ",
 StyleBox["D",
  FontFamily->"Source Code Pro"],
 " of the Wolfram Language and evaluated at four random points: a third \
method, next to the automatic differentiation of the Rust program and the \
differences of eighth order of the Python program. The couplings of the test \
are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
