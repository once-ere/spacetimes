       " ", "of", " ", "Jordan", " ", "and", " ", "Wigner"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"fockOps", "[", "n_Integer", "]"}], " ", ":=", " ", 
     RowBox[{"Table", "[", 
