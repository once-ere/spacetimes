Cell[CellGroupData[{

Cell["III.L.5 Why no polynomial can be exact: the cause", "Section",ExpressionUUID->"76cc2ef3-aa53-474a-bd60-fcc73ea0c11c"],

Cell[TextData[{
 StyleBox["The pair field enters the quasi-particle energies like a mass.",
  FontWeight->"Bold"],
 " For the applied pair self-energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9074388e-f4fb-4342-95b9-d74b150b13d6"],
 " and a normal self-energy that is a Dirac mass, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["D",
         FontSlant->"Plain"]}]], "-", 
      SubscriptBox[
       StyleBox["m", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}], 
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[CircleTimes]", 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b2e8b248-9cf3-4274-9a09-21d79a8a334b"],
 ", the eigenvalues of the matrix of Bogoliubov and de Gennes at the momentum \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox[
     StyleBox["q", "TI"], "\[RightVector]"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "055a5b12-0539-4a9a-822f-2d7b1b9077c3"],
 " are ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    StyleBox["E", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2526bcc4-efba-4a24-a7f9-795c8424ceea"],
 ", each eight times, with"
}], "Text",ExpressionUUID->"0f6199a3-1847-4032-a450-97de00a492be"],

Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox["E", "TI"], "\[LongEqual]", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"\[LeftBracketingBar]", 
        SubscriptBox[
         OverscriptBox[
          StyleBox["q", "TI"], "\[RightVector]"], 
         StyleBox["LL",
          FontSlant->"Plain"]], "\[RightBracketingBar]"}], "2"], "+", 
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox[
         StyleBox["M", "TI"], 
         StyleBox["SF",
          FontSlant->"Plain"], 
         RowBox[{
          StyleBox["X", "TI"], ",", 
          StyleBox["D",
           FontSlant->"Plain"]}]], ")"}], "2"], "+", 
      SubsuperscriptBox["\[CapitalPhi]", 
       StyleBox["a",
        FontSlant->"Plain"], "2"]}], ")"}], 
    RowBox[{"1", "/", "2"}]], "."}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"0373dc58-6f48-4cba-a6a9-8029cc2419de"],

Cell[TextData[{
 "The next cell checks this for 20 random momenta, masses and fields with the \
matrices of Part I (",
 StyleBox["hLL",
  FontFamily->"Source Code Pro"],
 ", ",
 StyleBox["kLL",
  FontFamily->"Source Code Pro"],
 ", ",
 StyleBox["betaLL",
  FontFamily->"Source Code Pro"],
 "); along the whole polar curve the normal self-energy is such a Dirac mass \
(the Rust check P3-9 and the Python check YP3-9)."
}], "Text",ExpressionUUID->"b0567e00-ceb9-4a4c-a852-cd31459bd9e0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
     "the", " ", "BdG", " ", "matrix", " ", "of", " ", "the", " ", "eight", " ",
       "components", " ", "with", " ", "the", " ", "Dirac", " ", "mass", " ", 
      "M", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"normal", " ", "self"}], "-", 
        RowBox[{"energy", " ", 
         RowBox[{"(", 
          RowBox[{"M", " ", "-", " ", "m"}], ")"}], " ", "beta", " ", 
         RowBox[{"(", "x", ")"}], " ", "1", "_", "2"}]}], ")"}], " ", "and", " ",
       "the", " ", "applied", "\n", "   ", "pair", " ", "self"}], "-", 
     RowBox[{"energy", " ", "fa", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"K", "^", "3"}], ")"}], "^", "dag"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"at", " ", "the", " ", "momentum", " ", "q"}], ";", " ", 
     RowBox[{
      RowBox[{"its", " ", "sorted", " ", "eigenvalues", " ", "against"}], " ",
       "-", 
      RowBox[{"E", " ", 
       RowBox[{"(", 
        RowBox[{"eight", " ", "times"}], ")"}], " ", "and"}], " ", "+", 
      RowBox[{"E", " ", 
       RowBox[{"(", 
        RowBox[{"eight", " ", "times"}], ")"}]}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"lfBdG", "[", 
      RowBox[{"q_", ",", " ", "mass_", ",", " ", "fa_"}], "]"}], " ", ":=", 
     " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"n", " ", "=", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"mass", " ", "-", " ", "mLL"}], ")"}], " ", 
           RowBox[{"d8", "[", "betaLL", "]"}]}]}], ",", " ", 
         RowBox[{"p", " ", "=", " ", 
          RowBox[{"fa", " ", 
           RowBox[{"ConjugateTranspose", "[", 
            RowBox[{"kLL", "[", "3", "]"}], "]"}]}]}], ",", " ", "a", ",", 
         " ", "d"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"a", " ", "=", " ", 
         RowBox[{
          RowBox[{"hLL", "[", 
           RowBox[{"q", ",", " ", "mLL"}], "]"}], " ", "+", " ", "n"}]}], ";",
         " ", 
        RowBox[{"d", " ", "=", " ", 
         RowBox[{
          RowBox[{"hLL", "[", 
           RowBox[{
            RowBox[{"-", "q"}], ",", " ", "mLL"}], "]"}], " ", "+", " ", 
          "n"}]}], ";", "\n", "   ", 
        RowBox[{"N", "[", 
         RowBox[{"ArrayFlatten", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"a", ",", " ", "p"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"ConjugateTranspose", "[", "p", "]"}], ",", " ", 
              RowBox[{"-", 
               RowBox[{"Transpose", "[", "d", "]"}]}]}], "}"}]}], "}"}], 
          "]"}], "]"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"SeedRandom", "[", "20261121", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"lfQpDev", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"q", " ", "=", " ", 
             RowBox[{"RandomReal", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", "3"}], 
              "]"}]}], ",", " ", 
            RowBox[{"mass", " ", "=", " ", 
             RowBox[{"RandomReal", "[", 
              RowBox[{"{", 
               RowBox[{"0.1", ",", " ", "0.5"}], "}"}], "]"}]}], ",", " ", 
            RowBox[{"fa", " ", "=", " ", 
             RowBox[{"RandomReal", "[", 
              RowBox[{"{", 
               RowBox[{"0", ",", " ", "0.6"}], "}"}], "]"}]}], ",", " ", "ev",
             ",", " ", "e"}], "}"}], ",", "\n", "     ", 
          RowBox[{
           RowBox[{"ev", " ", "=", " ", 
            RowBox[{"Sort", "[", 
             RowBox[{"Re", "[", 
              RowBox[{"Eigenvalues", "[", 
               RowBox[{"lfBdG", "[", 
                RowBox[{"q", ",", " ", "mass", ",", " ", "fa"}], "]"}], "]"}],
               "]"}], "]"}]}], ";", "\n", "     ", 
           RowBox[{"e", " ", "=", " ", 
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{"q", " ", ".", " ", "q"}], " ", "+", " ", 
              RowBox[{"mass", "^", "2"}], " ", "+", " ", 
              RowBox[{"fa", "^", "2"}]}], "]"}]}], ";", "\n", "     ", 
           RowBox[{"Max", "[", 
            RowBox[{"Abs", "[", 
             RowBox[{"ev", " ", "-", " ", 
              RowBox[{"Join", "[", 
               RowBox[{
                RowBox[{"ConstantArray", "[", 
                 RowBox[{
                  RowBox[{"-", "e"}], ",", " ", "8"}], "]"}], ",", " ", 
                RowBox[{"ConstantArray", "[", 
                 RowBox[{"e", ",", " ", "8"}], "]"}]}], "]"}]}], "]"}], 
            "]"}]}]}], "]"}], ",", " ", 
        RowBox[{"{", "20", "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WP3-8\>\"", ",", 
      " ", "\"\<the pair field enters the quasi-particle energies like a \
mass: the BdG matrix with N = (M - m) beta (x) 1_2 and P = Phi_a (K^3)^dag \
has the eigenvalues -+(q^2 + M^2 + Phi_a^2)^(1/2), eight times each (20 \
random q, M, Phi_a)\>\"", ",", " ", "lfQpDev", ",", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "13"}]}], ",", " ", "\"\<P3-8\>\"", ",", 
      " ", "\"\<YP3-8\>\""}], "]"}], ";"}]}]}]], "Input",
 CellLabel->
  "In[301]:=",ExpressionUUID->"7270d212-472f-47e6-85e3-eeb234b0f760"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"PASS \"\>", "\[InvisibleSpace]", "\<\"WP3-8\"\>", 
   "\[InvisibleSpace]", "\<\"  deviation \"\>", 
   "\[InvisibleSpace]", "\<\"1.554e-15\"\>", 
   "\[InvisibleSpace]", "\<\" (tolerance \"\>", 
   "\[InvisibleSpace]", "\<\"1.000e-13\"\>", 
   "\[InvisibleSpace]", "\<\"): \"\>", 
   "\[InvisibleSpace]", "\<\"the pair field enters the quasi-particle \
energies like a mass: the BdG matrix with N = (M - m) beta (x) 1_2 and P = \
Phi_a (K^3)^dag has the eigenvalues -+(q^2 + M^2 + Phi_a^2)^(1/2), eight \
times each (20 random q, M, Phi_a)\"\>", 
   "\[InvisibleSpace]", "\<\"   [the same check: Rust \"\>", 
   "\[InvisibleSpace]", "\<\"P3-8\"\>", 
   "\[InvisibleSpace]", "\<\", Python \"\>", 
   "\[InvisibleSpace]", "\<\"YP3-8\"\>", "\[InvisibleSpace]", "\<\"]\"\>"}],
  SequenceForm[
  "PASS ", "WP3-8", "  deviation ", "1.554e-15", " (tolerance ", "1.000e-13", 
   "): ", "the pair field enters the quasi-particle energies like a mass: the \
BdG matrix with N = (M - m) beta (x) 1_2 and P = Phi_a (K^3)^dag has the \
eigenvalues -+(q^2 + M^2 + Phi_a^2)^(1/2), eight times each (20 random q, M, \
Phi_a)", "   [the same check: Rust ", "P3-8", ", Python ", "YP3-8", "]"],
  Editable->False]], "Print",
 CellChangeTimes->{4.0042664853846397`*^9},
 CellLabel->
  "During evaluation of \
In[301]:=",ExpressionUUID->"28236f1b-ce0a-4208-8908-e04559373a38"]
}, Open  ]],

Cell[TextData[{
 StyleBox["A logarithm.",
  FontWeight->"Bold"],
 " The energy per volume is an integral over the momenta ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["q", "TI"], "<", 
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e24a9656-2cd7-4099-8913-778b28388f5e"],
 " of functions of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       StyleBox["q", "TI"], "2"], "+", 
      StyleBox["s", "TI"]}], ")"}], 
    RowBox[{"1", "/", "2"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "df87275e-73dd-4aac-b058-d9faa57c9243"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["s", "TI"], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["D",
         FontSlant->"Plain"]}]], ")"}], "2"], "+", 
    SubsuperscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7f806009-ee7c-4799-ad65-9bf3fd7517ee"],
 ". The next cell integrates the simplest of them exactly and expands the \
result about ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["s", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c738c2a9-e456-4aa5-bd17-5769eb87bbd6"],
 ": it contains the term ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "16"], 
    SuperscriptBox[
     StyleBox["s", "TI"], "2"], "\[ThinSpace]", 
    StyleBox["ln",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["s", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "21bc8756-a0a6-4644-9c45-e7f8b11056c7"],
 ", which is not analytic at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["s", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c273f2a9-4ad2-4f78-9991-710d381c2278"],
 ", that is, at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"], "2"], "\[LongEqual]", 
    RowBox[{"-", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["M", "TI"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["X", "TI"], ",", 
         StyleBox["D",
          FontSlant->"Plain"]}]], ")"}], "2"]}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6299d077-d18f-46d2-9590-0461f7716968"],
 ". Hence ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalV]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "15d5a690-5ec9-4946-8fc4-27cce2faf4e3"],
 " is not a polynomial in ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a441636d-7e31-41ef-9393-391cfe8f61b4"],
 ", and a series of powers of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5696e200-c661-4698-baba-55fa8418a9f0"],
 " about the origin can converge only within a radius of the order of the \
Dirac mass (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0.2"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "06f42532-dd3d-4d50-86c3-47eb7e202257"],
 " at the origin), while ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalPhi]", 
     RowBox[{"0", ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]], "\[LongEqual]", "0.31"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "86705b18-8841-44b5-8429-c13e448d7c67"],
 " to ",
 Cell[BoxData[
  FormBox["0.40", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "54e60738-da7a-4676-87b4-88b6943a1b68"],
 ": the superfluid is far from the regime of Landau's theory, where the order \
parameter is small and the Landau coefficients are Taylor coefficients."
}], "Text",ExpressionUUID->"4d55706e-94d1-45cf-a01b-0801c123ffc8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", "integral", " ", "of", " ", 
     RowBox[{"q", "^", "2"}], " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"q", "^", "2"}], " ", "+", " ", "s"}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}]}], " ", "from", " ", "0", " ", "to", " ",
      "the", " ", "cutoff", " ", "lam"}], ",", " ", "exactly", ",", " ", 
    RowBox[{
     RowBox[{"and", " ", "its", " ", "expansion", " ", "about", " ", "s"}], 
     " ", "=", " ", "0"}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"lfq", ":", " ", 
     RowBox[{
     "the", " ", "modulus", " ", "of", " ", "the", " ", "momentum"}]}], ",", 
    " ", 
    RowBox[{"lfs", ":", " ", 
     RowBox[{
      RowBox[{"the", " ", "quantity", " ", 
       RowBox[{"M", "^", "2"}]}], " ", "+", " ", 
      RowBox[{"Phi_a", "^", "2"}]}]}], ",", " ", 
    RowBox[{"lfLam", ":", " ", 
     RowBox[{"the", " ", "cutoff"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"lfInt", " ", "=", " ", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"lfq", "^", "2"}], " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"lfq", "^", "2"}], " ", "+", " ", "lfs"}], "]"}]}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"lfq", ",", " ", "0", ",", " ", "lfLam"}], "}"}], ",", " ", 
       RowBox[{"Assumptions", " ", "->", " ", 
        RowBox[{
         RowBox[{"lfs", " ", ">", " ", "0"}], " ", "&&", " ", 
         RowBox[{"lfLam", " ", ">", " ", "0"}]}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"lfClosed", " ", "=", " ", 
     RowBox[{
      RowBox[{"lfLam", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", " ", 
          RowBox[{"lfLam", "^", "2"}]}], " ", "+", " ", "lfs"}], ")"}], " ", 
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"lfLam", "^", "2"}], " ", "+", " ", "lfs"}], "]"}], "/", 
        "8"}]}], " ", "-", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"lfs", "^", "2"}], "/", "8"}], " ", 
       RowBox[{"Log", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"lfLam", " ", "+", " ", 
           RowBox[{"Sqrt", "[", 
            RowBox[{
             RowBox[{"lfLam", "^", "2"}], " ", "+", " ", "lfs"}], "]"}]}], 
          ")"}], "/", 
         RowBox[{"Sqrt", "[", "lfs", "]"}]}], "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<the integral minus the closed form: \>\"", ",", " ", 
      RowBox[{"FullSimplify", "[", 
       RowBox[{
        RowBox[{"lfInt", " ", "-", " ", "lfClosed"}], ",", " ", 
        RowBox[{"Assumptions", " ", "->", " ", 
         RowBox[{
          RowBox[{"lfs", " ", ">", " ", "0"}], " ", "&&", " ", 
          RowBox[{"lfLam", " ", ">", " ", "0"}]}]}]}], "]"}]}], "]"}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"lfSeries", " ", "=", " ", 
     RowBox[{"Expand", "[", 
      RowBox[{"Normal", "[", 
       RowBox[{"Series", "[", 
        RowBox[{
         RowBox[{"lfClosed", " ", "/.", " ", 
          RowBox[{"lfLam", " ", "->", " ", "1"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"lfs", ",", " ", "0", ",", " ", "2"}], "}"}]}], "]"}], 
       "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<the closed form about s = 0 (cutoff 1), to the order s^2: \
\>\"", ",", " ", "lfSeries"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<its term with the logarithm: \>\"", ",", " ", 
      RowBox[{"Coefficient", "[", 
       RowBox[{"lfSeries", ",", " ", 
        RowBox[{"Log", "[", "lfs", "]"}]}], "]"}], ",", 
      " ", "\"\< Log[s]\>\""}], "]"}], ";"}]}]}]], "Input",
 CellLabel->
  "In[305]:=",ExpressionUUID->"a5e3ba34-fc50-4890-8939-6327f4720f60"],

