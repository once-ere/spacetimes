   UnderscriptBox["\[Sum]", 
    StyleBox["p", "TI"],
    LimitsPositioning->True], "\[ThinSpace]", 
   SubsuperscriptBox["\[Eta]", 
    StyleBox["pp", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], ":", 
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["j", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["F",
        FontSlant->"Plain"], ",", 
       StyleBox["p", "TI"]}]], ")"}], "2"], ":", 
   RowBox[{"-", 
