Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", 
     RowBox[{"figure", ":", " ", "top"}]}], ",", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "residual", " ", "of", " ", "the", " ", "Landau", " ", 
      "form", " ", "along", " ", "the", " ", "fitted", " ", "interval", " ", 
      "relative", " ", "to", " ", "the", " ", "depth", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
        "KS", " ", "and", " ", "CJT", "\n", "   ", "coincide", " ", "along", " ",
          "the", " ", "polar", " ", "fields"}], ",", " ", 
        RowBox[{
        "so", " ", "one", " ", "curve", " ", "is", " ", "drawn", " ", "for", " ",
          "both"}]}], ")"}]}], ";", " ", "bottom"}], ",", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
       "the", " ", "largest", " ", "residual", " ", "of", " ", "the", " ", 
        "fits", " ", "with", "\n", "   ", "the", " ", "powers", " ", 
        RowBox[{"Phi", "^", "2"}]}], " ", ".."}], " ", 
      RowBox[{"Phi", "^", 
       RowBox[{"(", 
