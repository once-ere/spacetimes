Cell[TextData[{
 StyleBox["A logarithm.",
  FontWeight->"Bold"],
 " The energy per volume is an integral over the momenta ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["q", "TI"], "<", 
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "88155be8-8af6-4d06-a3b6-88f2b79916d9"],
 " of functions of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       StyleBox["q", "TI"], "2"], "+", 
      StyleBox["s", "TI"]}], ")"}], 
    RowBox[{"1", "/", "2"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b3353934-f0bc-4b32-87b5-62912eda07fe"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["s", "TI"], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["D",
         FontSlant->"Plain"]}]], ")"}], "2"], "+", 
    SubsuperscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2790b37a-15d5-4d83-903a-3daaf8991253"],
 ". The next cell integrates the simplest of them exactly and expands the \
result about ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["s", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ad8ebc4d-1689-4b94-a3e9-ea71409e8b58"],
 ": it contains the term ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "16"], 
    SuperscriptBox[
     StyleBox["s", "TI"], "2"], "\[ThinSpace]", 
    StyleBox["ln",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["s", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "89d91654-65ef-48e2-a605-8cac74b21763"],
 ", which is not analytic at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["s", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bcdc1f5d-fc1a-4f95-8f7a-7ad7982adc70"],
 ", that is, at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"], "2"], "\[LongEqual]", 
    RowBox[{"-", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["M", "TI"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["X", "TI"], ",", 
         StyleBox["D",
          FontSlant->"Plain"]}]], ")"}], "2"]}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "169d7188-7b6f-4268-bd4f-b31034db9a31"],
 ". Hence ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalV]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3b04f515-5c60-4746-b553-b74ff33952d6"],
 " is not a polynomial in ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "34f203f5-5caa-4331-a109-48c52131b5d7"],
 ", and a series of powers of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f854af4f-ace5-4263-80a5-4e45819c698e"],
 " about the origin can converge only within a radius of the order of the \
Dirac mass (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0.2"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "42d7521b-ee57-4988-8f01-5c452d856d51"],
 " at the origin), while ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalPhi]", 
     RowBox[{"0", ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]], "\[LongEqual]", "0.31"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "51100e0b-a449-4be9-8509-3fafe5be9978"],
 " to ",
 Cell[BoxData[
  FormBox["0.40", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e8c0f80b-b5bc-4b65-b074-308be28a246b"],
 ": the superfluid is far from the regime of Landau's theory, where the order \
parameter is small and the Landau coefficients are Taylor coefficients."
}], "Text",ExpressionUUID->"57e3a0fd-b6cf-424b-a76a-3339974a9c2e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", "integral", " ", "of", " ", 
     RowBox[{"q", "^", "2"}], " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"q", "^", "2"}], " ", "+", " ", "s"}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}]}], " ", "from", " ", "0", " ", "to", " ",
      "the", " ", "cutoff", " ", "lam"}], ",", " ", "exactly", ",", " ", 
    RowBox[{
     RowBox[{"and", " ", "its", " ", "expansion", " ", "about", " ", "s"}], 
     " ", "=", " ", "0"}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"lfq", ":", " ", 
     RowBox[{
     "the", " ", "modulus", " ", "of", " ", "the", " ", "momentum"}]}], ",", 
    " ", 
    RowBox[{"lfs", ":", " ", 
     RowBox[{
      RowBox[{"the", " ", "quantity", " ", 
       RowBox[{"M", "^", "2"}]}], " ", "+", " ", 
      RowBox[{"Phi_a", "^", "2"}]}]}], ",", " ", 
    RowBox[{"lfLam", ":", " ", 
     RowBox[{"the", " ", "cutoff"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"lfInt", " ", "=", " ", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"lfq", "^", "2"}], " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"lfq", "^", "2"}], " ", "+", " ", "lfs"}], "]"}]}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"lfq", ",", " ", "0", ",", " ", "lfLam"}], "}"}], ",", " ", 
       RowBox[{"Assumptions", " ", "->", " ", 
        RowBox[{
         RowBox[{"lfs", " ", ">", " ", "0"}], " ", "&&", " ", 
         RowBox[{"lfLam", " ", ">", " ", "0"}]}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"lfClosed", " ", "=", " ", 
     RowBox[{
      RowBox[{"lfLam", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", " ", 
          RowBox[{"lfLam", "^", "2"}]}], " ", "+", " ", "lfs"}], ")"}], " ", 
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"lfLam", "^", "2"}], " ", "+", " ", "lfs"}], "]"}], "/", 
        "8"}]}], " ", "-", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"lfs", "^", "2"}], "/", "8"}], " ", 
       RowBox[{"Log", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"lfLam", " ", "+", " ", 
           RowBox[{"Sqrt", "[", 
            RowBox[{
             RowBox[{"lfLam", "^", "2"}], " ", "+", " ", "lfs"}], "]"}]}], 
          ")"}], "/", 
         RowBox[{"Sqrt", "[", "lfs", "]"}]}], "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<the integral minus the closed form: \>\"", ",", " ", 
      RowBox[{"FullSimplify", "[", 
       RowBox[{
        RowBox[{"lfInt", " ", "-", " ", "lfClosed"}], ",", " ", 
        RowBox[{"Assumptions", " ", "->", " ", 
         RowBox[{
          RowBox[{"lfs", " ", ">", " ", "0"}], " ", "&&", " ", 
          RowBox[{"lfLam", " ", ">", " ", "0"}]}]}]}], "]"}]}], "]"}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"lfSeries", " ", "=", " ", 
     RowBox[{"Expand", "[", 
      RowBox[{"Normal", "[", 
       RowBox[{"Series", "[", 
        RowBox[{
         RowBox[{"lfClosed", " ", "/.", " ", 
          RowBox[{"lfLam", " ", "->", " ", "1"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"lfs", ",", " ", "0", ",", " ", "2"}], "}"}]}], "]"}], 
       "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<the closed form about s = 0 (cutoff 1), to the order s^2: \
\>\"", ",", " ", "lfSeries"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<its term with the logarithm: \>\"", ",", " ", 
      RowBox[{"Coefficient", "[", 
       RowBox[{"lfSeries", ",", " ", 
        RowBox[{"Log", "[", "lfs", "]"}]}], "]"}], ",", 
      " ", "\"\< Log[s]\>\""}], "]"}], ";"}]}]}]], "Input",
 CellLabel->
  "In[217]:=",ExpressionUUID->"894756a1-8ce3-4adb-8001-4b56d1c09dc9"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"the integral minus the closed form: \"\>", "\[InvisibleSpace]",
    "0"}],
  SequenceForm["the integral minus the closed form: ", 0],
  Editable->False]], "Print",
 CellChangeTimes->{4.004265406268517*^9},
 CellLabel->
