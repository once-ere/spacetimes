Cell[TextData[{
 StyleBox["AS1: plane waves in constant gauge fields.",
  FontWeight->"Bold"],
 " In constant gauge fields the field equation without self-interaction has \
plane-wave solutions ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Chi]", "\[ThinSpace]", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      RowBox[{"-", 
       StyleBox["i", "TI"]}], "\[Omega]", 
      StyleBox["t", "TI"], "+", 
      StyleBox["i", "TI"], 
      OverscriptBox[
       StyleBox["q", "TI"], "\[RightVector]"], "\[CenterDot]", 
      OverscriptBox[
       StyleBox["x", "TI"], "\[RightVector]"]}]]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "240dbeee-a70f-4503-85d5-13ca9308bb09"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"\[Omega]", ",", "\[Chi]"}], ")"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0affc143-20cd-4070-980c-6cc9ef82a498"],
 " is an eigenpair of the Hermitian matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["h",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["pw",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     OverscriptBox[
      StyleBox["q", "TI"], "\[RightVector]"], ")"}], "\[LongEqual]", 
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "+", 
    SuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["F",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["B", "TI"], "0"], "+", 
    SuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["v",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["W",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "0"], "+", 
    UnderscriptBox["\[Sum]", 
     StyleBox["j", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["j", "TI"]], "+", 
      SuperscriptBox[
       StyleBox["g", "TI"], 
       StyleBox["F",
        FontSlant->"Plain"]], 
      SubscriptBox[
       StyleBox["B", "TI"], 
       StyleBox["j", "TI"]], "+", 
      SuperscriptBox[
       StyleBox["g", "TI"], 
       StyleBox["v",
        FontSlant->"Plain"]], 
      SubscriptBox[
       StyleBox["W",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["j", "TI"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "23c61795-61e7-4a07-9b1e-143c12c1eaa0"],
 ". For the spin-isospin locked field ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["W", "TI"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["j", "TI"]}], "\[Iota]"], "\[LongEqual]", 
    StyleBox["w", "TI"], "\[ThinSpace]", 
    SubscriptBox["\[Delta]", 
     RowBox[{"\[Iota]", 
      StyleBox["j", "TI"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "364bf60e-22c0-427f-819f-c1b6a084b438"],
 " the eight frequencies at the momentum ",
 Cell[BoxData[
  FormBox[
   StyleBox["q", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "30da3526-8e70-469a-9bc8-ff4fd08b44d4"],
 " along ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["x", "TI"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ec30ae77-04e9-48a5-9300-6969f5c79576"],
 " are ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", "\[Omega]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "38c541da-da7f-44e0-83f6-2ff1ae3329b8"],
 " with the four branches ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Omega]", "2"], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["m", "TI"], "2"], "+", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       StyleBox["q", "TI"], "\[PlusMinus]", 
       StyleBox["gw", "TI"], "/", "2"}], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6629f54b-f4e9-4688-a3a4-3855ee2eab6d"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Omega]", "2"], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["m", "TI"], "2"], "+", 
    SuperscriptBox[
     StyleBox["q", "TI"], "2"], "+", 
    FractionBox["5", "4"], 
    SuperscriptBox[
     StyleBox["g", "TI"], "2"], 
    SuperscriptBox[
     StyleBox["w", "TI"], "2"], "\[PlusMinus]", 
    StyleBox["gw", "TI"], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        StyleBox["q", "TI"], "2"], "+", 
       SuperscriptBox[
        StyleBox["g", "TI"], "2"], 
       SuperscriptBox[
        StyleBox["w", "TI"], "2"]}], ")"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "877a5989-ae71-452d-ad19-64c0997d440b"],
 "."
}], "Text",ExpressionUUID->"92f2ffeb-6c57-45f9-b406-2fe000a86b04"],

Cell[TextData[{
 StyleBox["AS2: Landau levels.",
  FontWeight->"Bold"],
 " In a constant magnetic field ",
 Cell[BoxData[
  FormBox[
   StyleBox["B", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cedeae13-bd32-4b91-b63b-8d3d1312c55b"],
 " along ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["x", "TI"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d6aaadd4-6e21-47de-8320-6d07d1b2e4f5"],
 " the frequencies are ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       StyleBox["m", "TI"], "2"], "+", 
      SubsuperscriptBox[
       StyleBox["q", "TI"], "3", "2"], "+", "2", 
      StyleBox["neB", "TI"]}], ")"}], 
    RowBox[{"1", "/", "2"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "44b85f2f-20ba-43e4-973a-c57eb940d302"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "0", ",", "1", ",", "2", ",", 
    "\[Ellipsis]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3a5015ac-397b-4703-8ec2-194b9da044ed"],
 "; the program discretizes ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["x", "TI"], "1"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d43a563a-a8cf-4094-bbb1-8df7acc37806"],
 " on a lattice with the Wilson term (spacings ",
 Cell[BoxData[
  FormBox["0.1", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1bd6064c-0149-4c64-810a-0bcf486edbb8"],
 ", ",
 Cell[BoxData[
  FormBox["0.05", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "04af1e7f-6de9-4cf3-9901-882c9c1dbbef"],
 ", ",
 Cell[BoxData[
  FormBox["0.025", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8d5567ed-af81-4299-a101-d87edabc017c"],
 ") and compares the seven lowest positive frequencies, and their Richardson \
extrapolation ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    StyleBox["E", "TI"], 
    RowBox[{"(", "0.025", ")"}], "-", 
    StyleBox["E", "TI"], 
    RowBox[{"(", "0.05", ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b5676a88-030b-4f82-9b01-fb6e0ad177a4"],
 ", with the Landau levels."
}], "Text",ExpressionUUID->"b14e33e8-49f3-45e6-9c09-a745a4885a08"],

Cell[TextData[{
 StyleBox["AS3: the uniform superfluid of the spin-zero pairing.",
  FontWeight->"Bold"],
 " For a uniform unitary pair field the 16 eigenvalues of the matrix of \
Bogoliubov and de Gennes are ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    SuperscriptBox[
     RowBox[{"[", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"\[CurlyEpsilon]", "\[PlusMinus]", "\[Mu]"}], ")"}], "2"], "+", 
       SuperscriptBox["\[CapitalDelta]", "2"]}], "]"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5452299b-5403-4bdb-9eba-c6994e3d0625"],
 ", each four times; the mean-field energy is stationary where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["G", "TI"], "/", 
      SuperscriptBox["\[Pi]", "2"]}], ")"}], 
    SubscriptBox[
     StyleBox["I", "TI"], "1"], 
    RowBox[{"(", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         StyleBox["m", "TI"], "2"], "+", 
        SuperscriptBox["\[CapitalDelta]", "2"]}], ")"}], 
      RowBox[{"1", "/", "2"}]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "71bc1026-ed2b-4b4f-896f-79b0aeca2697"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["I", "TI"], "1"], 
    RowBox[{"(", 
     StyleBox["M", "TI"], ")"}], "\[LongEqual]", 
    FractionBox["1", "2"], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "+", 
         SuperscriptBox[
          StyleBox["M", "TI"], "2"]}], ")"}], 
       RowBox[{"1", "/", "2"}]], "-", 
      SuperscriptBox[
       StyleBox["M", "TI"], "2"], "\[ThinSpace]", 
      StyleBox["arcsinh",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       RowBox[{"1", "/", 
        StyleBox["M", "TI"]}], ")"}]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "931ef1bd-c573-4259-9264-76234de0d749"],
 ", and at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["G", "TI"], "\[LongEqual]", "22.5"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a1c44cc7-c094-45b2-9f2b-e910f24ff20c"],
 " the gap is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", "\[LongEqual]", "0.2094933033"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0db198d2-fdd6-4148-a8f1-c3becb7bf0f0"],
 "."
}], "Text",ExpressionUUID->"fdc3f48c-919b-441d-afbe-78b8c2200067"],

Cell[TextData[{
 StyleBox["AS4: the kink of the pair field.",
  FontWeight->"Bold"],
 " For the pair field ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", 
    RowBox[{"(", 
     StyleBox["x", "TI"], ")"}], "\[LongEqual]", 
    SubscriptBox["\[CapitalDelta]", "\[Infinity]"], "\[ThinSpace]", 
    StyleBox["tanh",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["x", "TI"], "/", "\[ScriptL]"}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "18353e10-f6fc-4b57-ba9c-f29fca8bd7c2"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalDelta]", "\[Infinity]"], "\[LongEqual]", "0.5"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fae4c3ee-e9da-45ad-bf14-1ed27f5687f4"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ScriptL]", "\[LongEqual]", "4"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2de5b778-057e-4bb5-92d5-1b002d95df95"],
 ") the reduced problem has the bound states ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["sech",
      FontSlant->"Plain"], "2"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["x", "TI"], "/", "\[ScriptL]"}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7b5e5cc0-2a09-4ab6-a08b-9bc147b78d8f"],
 " (zero mode, energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    StyleBox["m", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a6f9e7ac-18fb-42ee-9cc1-efff31a74111"],
 ") and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["sech",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["x", "TI"], "/", "\[ScriptL]"}], ")"}], "\[ThinSpace]", 
    StyleBox["tanh",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["x", "TI"], "/", "\[ScriptL]"}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "18157f46-9ec7-4108-9ba5-b4fa6822999c"],
 " (energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        StyleBox["m", "TI"], "2"], "+", 
       SubsuperscriptBox[
        StyleBox["E", "TI"], "1", "2"]}], ")"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f0922040-6dcc-4788-b262-6ed8af48c817"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["E", "TI"], "1", "2"], "\[LongEqual]", "3", "/", "16"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "db87ad79-7e7a-42fa-9600-75b37be9029f"],
 "); on the Wilson lattice exactly three bound states lie below the continuum \
",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       StyleBox["m", "TI"], "2"], "+", 
      SubsuperscriptBox["\[CapitalDelta]", "\[Infinity]", "2"]}], ")"}], 
    RowBox[{"1", "/", "2"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "745d7e1f-bd61-40dc-b2d4-9cb401fddee8"],
 "."
}], "Text",ExpressionUUID->"56e3241a-74c0-4857-86ef-4f94c5383bec"],

Cell[TextData[{
 "The next cell computes the four cases. The eigenvalues of the Hermitian \
matrices are computed by the function ",
 StyleBox["Eigenvalues",
  FontFamily->"Source Code Pro"],
 " of the Wolfram Language (dense matrices of up to 4800 rows); the gap \
equation is solved by ",
 StyleBox["FindRoot",
  FontFamily->"Source Code Pro"],
 " with 30 digits; the profiles of AS4 are checked symbolically by ",
 StyleBox["FullSimplify",
  FontFamily->"Source Code Pro"],
 "."
}], "Text",ExpressionUUID->"b2b85891-b72a-4338-b505-ed3cd05b9ca3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"hPW", "[", 
      RowBox[{
      "q", ",", " ", "m", ",", " ", "gv", ",", " ", "gf", ",", " ", "w", ",", 
       " ", "b"}], "]"}], ":", " ", 
     RowBox[{
      RowBox[{"the", " ", "plane"}], "-", 
      RowBox[{
      "wave", " ", "matrix", " ", "of", " ", "AS1", " ", "for", " ", "the", " ",
        "constant", " ", "fields", " ", 
       RowBox[{"w", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"p", "+", "1"}], ",", " ", "i"}], "]"}], "]"}]}]}]}], " ", "=",
     " ", 
    RowBox[{
     RowBox[{
      RowBox[{"W", "^", "i_p"}], " ", "and", " ", 
      RowBox[{"b", "[", 
       RowBox[{"[", 
        RowBox[{"p", "+", "1"}], "]"}], "]"}]}], " ", "=", " ", "B_p"}]}], 
   " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"hPW", "[", 
      RowBox[{
      "q_", ",", " ", "m_", ",", " ", "gv_", ",", " ", "gf_", ",", " ", "w_", 
       ",", " ", "b_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "gauge", "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{
         RowBox[{"gauge", "[", "p_", "]"}], " ", ":=", " ", 
         RowBox[{
          RowBox[{"gf", " ", 
           RowBox[{"b", "[", 
            RowBox[{"[", 
             RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}], " ", 
           RowBox[{"IdentityMatrix", "[", "8", "]"}]}], " ", "+", " ", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{"gv", " ", 
             RowBox[{"w", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"p", " ", "+", " ", "1"}], ",", " ", "i"}], "]"}], 
              "]"}], " ", 
             RowBox[{"tLL", "[", "i", "]"}]}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"i", ",", " ", "3"}], "}"}]}], "]"}]}]}], ";", "\n", 
        "   ", 
        RowBox[{
         RowBox[{
          RowBox[{"d8", "[", "betaLL", "]"}], " ", "m"}], " ", "+", " ", 
         RowBox[{"gauge", "[", "0", "]"}], " ", "+", " ", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"d8", "[", 
             RowBox[{"alphaLL", "[", "j", "]"}], "]"}], " ", ".", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"q", "[", 
                RowBox[{"[", "j", "]"}], "]"}], " ", 
               RowBox[{"IdentityMatrix", "[", "8", "]"}]}], " ", "+", " ", 
              RowBox[{"gauge", "[", "j", "]"}]}], ")"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}]}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"AS1", "-", "3"}], ":", " ", 
       RowBox[{
        RowBox[{"the", " ", "spin"}], "-", 
        RowBox[{"isospin", " ", "locked", " ", "field", " ", 
         RowBox[{"W", "^", "i_j"}]}]}]}], " ", "=", " ", 
      RowBox[{"w", " ", "delta_ij"}]}], ",", " ", 
     RowBox[{"w", " ", "=", " ", "0.9"}], ",", " ", 
     RowBox[{"g_v", " ", "=", " ", "0.83"}], ",", " ", 
     RowBox[{"at", " ", "61", " ", "momenta", " ", "along", " ", 
      RowBox[{"x", "^", "3"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"w", " ", "=", " ", "0.9"}], ",", " ", 
        RowBox[{"gv", " ", "=", " ", "0.83"}], ",", " ", "wl", ",", " ", "gw",
         ",", " ", 
        RowBox[{"m", " ", "=", " ", 
         RowBox[{"N", "[", "mLL", "]"}]}], ",", " ", 
        RowBox[{"d", " ", "=", " ", "0."}]}], "}"}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{"wl", " ", "=", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"w", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "w", ",", " ", "0"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "0", ",", " ", "w"}], "}"}]}], "}"}]}], ";",
        "\n", "  ", 
       RowBox[{"gw", " ", "=", " ", 
        RowBox[{"gv", " ", "w"}]}], ";", "\n", "  ", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"ev", " ", "=", " ", 
              RowBox[{"Sort", "[", 
               RowBox[{"Re", "[", 
                RowBox[{"Eigenvalues", "[", 
                 RowBox[{"N", "[", 
                  RowBox[{"hPW", "[", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"0", ",", " ", "0", ",", " ", "q"}], "}"}], ",", 
                    " ", "m", ",", " ", "gv", ",", " ", "0", ",", " ", "wl", ",",
                     " ", 
                    RowBox[{"{", 
                    RowBox[{
                    "0", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], 
                    "}"}]}], "]"}], "]"}], "]"}], "]"}], "]"}]}], ",", " ", 
             "w2", ",", " ", "want"}], "}"}], ",", "\n", "     ", 
           RowBox[{
            RowBox[{"w2", " ", "=", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"m", "^", "2"}], " ", "+", " ", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"q", " ", "+", " ", 
                   RowBox[{"gw", "/", "2"}]}], ")"}], "^", "2"}]}], ",", " ", 
               
               RowBox[{
                RowBox[{"m", "^", "2"}], " ", "+", " ", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"q", " ", "-", " ", 
                   RowBox[{"gw", "/", "2"}]}], ")"}], "^", "2"}]}], ",", " ", 
               
               RowBox[{
                RowBox[{"m", "^", "2"}], " ", "+", " ", 
                RowBox[{"q", "^", "2"}], " ", "+", " ", 
                RowBox[{"1.25", " ", 
                 RowBox[{"gw", "^", "2"}]}], " ", "+", " ", 
                RowBox[{"gw", " ", 
                 RowBox[{"Sqrt", "[", 
                  RowBox[{
                   RowBox[{"q", "^", "2"}], " ", "+", " ", 
                   RowBox[{"gw", "^", "2"}]}], "]"}]}]}], ",", " ", 
               RowBox[{
                RowBox[{"m", "^", "2"}], " ", "+", " ", 
                RowBox[{"q", "^", "2"}], " ", "+", " ", 
                RowBox[{"1.25", " ", 
                 RowBox[{"gw", "^", "2"}]}], " ", "-", " ", 
                RowBox[{"gw", " ", 
                 RowBox[{"Sqrt", "[", 
                  RowBox[{
                   RowBox[{"q", "^", "2"}], " ", "+", " ", 
                   RowBox[{"gw", "^", "2"}]}], "]"}]}]}]}], "}"}]}], ";", 
            "\n", "     ", 
            RowBox[{"want", " ", "=", " ", 
             RowBox[{"Sort", "[", 
              RowBox[{"Join", "[", 
               RowBox[{
                RowBox[{"Sqrt", "[", "w2", "]"}], ",", " ", 
                RowBox[{"-", 
                 RowBox[{"Sqrt", "[", "w2", "]"}]}]}], "]"}], "]"}]}], ";", 
            "\n", "     ", 
            RowBox[{"d", " ", "=", " ", 
             RowBox[{"Max", "[", 
              RowBox[{"d", ",", " ", 
               RowBox[{"Max", "[", 
                RowBox[{"Abs", "[", 
                 RowBox[{"ev", " ", "-", " ", "want"}], "]"}], "]"}]}], 
              "]"}]}]}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"q", ",", " ", 
           RowBox[{"Subdivide", "[", 
            RowBox[{
             RowBox[{"-", "1.5"}], ",", " ", "1.5", ",", " ", "60"}], "]"}]}],
           "}"}]}], "]"}], ";", "\n", "  ", 
       RowBox[{"check", "[", 
        RowBox[{"\"\<WAS1-3\>\"", ",", 
         " ", "\"\<spin-isospin locked field: four analytic branches (61 \
momenta)\>\"", ",", " ", "d", ",", " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "12"}]}], ",", " ", "\"\<AS1-3\>\"", ",", 
         " ", "\"\<AS1-3\>\""}], "]"}]}]}], "]"}], ";"}], "\n", 
