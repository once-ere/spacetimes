Cell[CellGroupData[{

Cell["\<\
Part III, first section. The Landau form of the effective potentials: what it \
is, how accurate it is, and why that matters\
\>", "Chapter",ExpressionUUID->"eb886cc1-e998-4365-b142-559023acc428"],

Cell[TextData[{
 "Part III of the solution builds the effective Lagrangians ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["\[ScriptCapitalL]",
     FontSlant->"Plain"], 
    StyleBox["CJT",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b0fd07c0-e0ab-496a-a6e4-bf0585fb9ba4"],
 ", ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["\[ScriptCapitalL]",
     FontSlant->"Plain"], 
    StyleBox["HS",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0f5477fa-8d62-4dd0-8304-5fb37b3346c6"],
 ", ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["\[ScriptCapitalL]",
     FontSlant->"Plain"], 
    StyleBox["KS",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2f17444f-98ef-409c-b659-3803e1db7052"],
 " of the field of the superfluid boson singlet state. Their potential parts \
were summarized by a polynomial, the Landau form, with the remark: \"The \
Landau form is a fit; its largest residual is 0.27-0.7 % of the depth\". The \
author asked (21 November 2026) to explain this remark clearly and completely \
and why it is important, to define the Landau form with examples, and to keep \
the answer in the documents and in this notebook. This chapter is that \
answer. It is the first section of Part III in the notebook; the other \
sections of Part III, and Part II, whose engine computes the curves used \
here, follow in the next versions. Until then the computed curves are taken \
from the Rust program ",
 StyleBox["sf_part3",
  FontFamily->"Source Code Pro"],
 " (the closed cell of Section III.L.3, with the SHA-256 checksums of its \
data files), and this chapter recomputes from them, by its own least squares, \
every number of the answer."
}], "Text",ExpressionUUID->"b4286f63-a46d-4fdb-8799-9011aecdfbd3"],

Cell[CellGroupData[{

Cell["III.L.1 The objects", "Section",ExpressionUUID->"46bb8388-8709-4e67-ad75-e8f58ddf3745"],

Cell[TextData[{
 StyleBox["The field and its effective potential.",
  FontWeight->"Bold"],
 " The field of the superfluid boson singlet state is the complex isospin \
vector ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["\[CapitalPhi]", 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", "1"}]], ",", 
      SubsuperscriptBox["\[CapitalPhi]", 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", "2"}]], ",", 
      SubsuperscriptBox["\[CapitalPhi]", 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", "3"}]]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "91c1d997-2e17-44b5-91d8-7e764df31b4c"],
 " of the amplitudes of the pair self-energy of a uniform state, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["P",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"]], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", "\[Iota]",
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox["\[CapitalPhi]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", "\[Iota]"}]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "\[Iota]"], ")"}], "\[Dagger]"]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "277b253d-952b-4f6a-a14d-8c75575d5bd0"],
 ", where ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d40302dc-28e5-41a6-9f42-eaa2cf0e1359"],
 " are the three pair matrices of Part I (",
 StyleBox["kLL[iota]",
  FontFamily->"Source Code Pro"],
 " in the code) and ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "327d5667-56a0-44af-af44-085b65d8e062"],
 " is one of the five computed methods: HS ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"1", ",", "1"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "756e2304-7b3f-48a1-b725-fb40bd34e13a"],
 ", HS ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "1"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7de9d2dd-b01d-413d-b982-641d3abaea3b"],
 ", HS ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "0"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2c8399e6-6938-479f-ae7e-ca661a9a4729"],
 " (the method of Hubbard and Stratonovich with the shares ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["s", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["HS",
      FontSlant->"Plain"], ",", 
     StyleBox["S",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f0e3ad9e-44be-4a64-96d3-4d92bb60227d"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["s", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["HS",
      FontSlant->"Plain"], ",", 
     StyleBox["V",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e918fea7-72e7-4775-b0dc-294289e09110"],
 " of the scalar and the vector term decoupled in the density channels), KS \
(Kohn and Sham) and CJT (Cornwall, Jackiw and Tomboulis). The effective \
potential ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalV]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], 
    RowBox[{"(", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], ")"}]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ba355987-f63a-46c7-a2be-cad4aaf5be38"],
 " is the smallest energy per volume of method ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "335e6357-1cdb-4e8f-a2c5-a3c35bd1cd82"],
 " among the uniform states whose field is ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[CapitalPhi]", "\[RightVector]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ada67547-3ac4-4174-92e2-0147c011f1a8"],
 ", measured from the normal vacuum, so that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalV]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], 
    RowBox[{"(", "0", ")"}], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d42823ce-d744-49ac-b174-98e80c17da4c"],
 "."
}], "Text",ExpressionUUID->"129dc745-d98f-4548-ba9c-80f6a852d4be"],

Cell[TextData[{
 StyleBox["How it is computed.",
  FontWeight->"Bold"],
 " A fixed pair self-energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "beb0e187-b170-4ed2-a70b-741d57ceec8c"],
 ", the applied field of amplitude ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPhi]", 
    StyleBox["a",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b94ca9fd-fc79-41b2-bb53-6d34d7ad5330"],
 ", is put into the matrix of Bogoliubov and de Gennes, the normal \
self-energy is made self-consistent, and the ground state gives one point: \
its own field ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "\[LongEqual]", 
    "\[CapitalPhi]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["e", "TI"], "\[RightVector]"], "3"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b06979d0-3264-4bc2-bfd0-2bdf5dba9a1c"],
 " and its energy per volume. The Rust program computes 61 points per method, \
with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPhi]", 
    StyleBox["a",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "eb383795-7e42-41e4-bd3a-563c5c408860"],
 " from ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "07e735ce-4bbe-40f4-9513-6318e4ed8eb4"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    SubsuperscriptBox["\[CapitalPhi]", 
     RowBox[{"0", ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3f68a828-a3a2-41a9-b9ec-2faf9f52ed77"],
 ", each self-consistent to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "13"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "761a9fa2-e125-46b2-97ee-cf5f91303d47"],
 ". Along the ",
 StyleBox["polar",
  FontWeight->"Bold"],
 " fields ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      StyleBox["i", "TI"], "\[CurlyTheta]"}]], "\[CapitalPhi]", 
    OverscriptBox[
     StyleBox["n", "TI"], "\[RightVector]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7d5bfab1-9a96-4a53-a2be-3fa302a8f8c1"],
 " (real phase ",
 Cell[BoxData[
  FormBox["\[CurlyTheta]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cf549521-eeb7-49c4-bcce-37cf075debc1"],
 ", real unit vector ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["n", "TI"], "\[RightVector]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "30860f22-e3f4-4580-9ac6-e79507bdd3a7"],
 ") the potential depends on ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPhi]", "\[LongEqual]", 
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "047c864c-42ff-4e70-8d91-a65ed196d560"],
 " alone. Its minimum lies at ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalPhi]", 
    RowBox[{"0", ",", 
     StyleBox["SF",
      FontSlant->"Plain"]}], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "85009092-1e14-4ccf-bfbf-d7426b013532"],
 " (the vacuum), and the ",
 StyleBox["depth",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftBracketingBar]", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["\[ScriptCapitalV]",
       FontSlant->"Plain"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      StyleBox["X", "TI"]], 
     RowBox[{"(", 
      SubsuperscriptBox["\[CapitalPhi]", 
       RowBox[{"0", ",", 
        StyleBox["SF",
         FontSlant->"Plain"]}], 
       StyleBox["X", "TI"]], ")"}]}], "\[RightBracketingBar]"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2110d149-0a2e-4cf5-a428-85733ad4208e"],
 " is the energy per volume by which the superfluid lies below the normal \
vacuum. The second derivative ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalV]",
     FontSlant->"Plain"], 
    StyleBox["amp",
     FontSlant->"Plain"], "\[Prime]\[Prime]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f651a35c-0c7e-4f46-988e-772dc5d40fd3"],
 " of the polar curve at its minimum fixes the mass of the amplitude mode, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["H",
         FontSlant->"Plain"]}]], ")"}], "2"], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalV]",
      FontSlant->"Plain"], 
     StyleBox["amp",
      FontSlant->"Plain"], "\[Prime]\[Prime]"], "/", 
    RowBox[{"(", 
     RowBox[{"2", 
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox[
         StyleBox["Z", "TI"], 
         StyleBox["SF",
          FontSlant->"Plain"], 
         StyleBox["X", "TI"]], "+", 
        SubsuperscriptBox[
         StyleBox["Y", "TI"], 
         StyleBox["SF",
          FontSlant->"Plain"], 
         StyleBox["X", "TI"]]}], ")"}]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3c40425b-befd-4e01-a859-b02a6bf6d26c"],
 ", where ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["Z", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f7b2c3ef-0887-471c-9642-5536440e20be"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["Y", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5eaa6ba0-e210-4df0-ae11-655553fdf579"],
 " are the two coefficients of the kinetic part of the effective Lagrangian."
}], "Text",ExpressionUUID->"45ffbb66-611c-4f55-a192-8b429ef48b87"]
}, Open  ]],

Cell[CellGroupData[{

Cell["III.L.2 The Landau form: definition and examples", "Section",ExpressionUUID->"56ac7afd-893c-42b2-b943-6665d351d9cf"],

Cell[TextData[{
 StyleBox["Definition.",
  FontWeight->"Bold"],
 " A Landau form of a potential is its expansion in powers of the order \
parameter (the field that vanishes in the symmetric state and not in the \
broken one) under two rules: only polynomial invariants of the symmetry group \
occur, and the expansion stops after the lowest orders that bound the \
potential from below and produce its minima. L. D. Landau introduced it for \
phase transitions (1937): near a continuous transition the order parameter is \
small, the free energy is assumed to be analytic in it, and the form is its \
Taylor expansion, whose coefficients (the Landau coefficients) are \
derivatives at the symmetric state. The quadratic coefficient changes its \
sign at the transition; the signs of the higher coefficients decide the order \
of the transition and which broken state is the minimum. Examples:"
}], "Text",ExpressionUUID->"5dca87e0-8ab4-4e3b-ab7b-c1188892e701"],

Cell[TextData[{
 "A uniaxial ferromagnet: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["F", "TI"], 
     StyleBox["mag",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["mag",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["mag",
      FontSlant->"Plain"], "2"], "+", 
    SubscriptBox[
     StyleBox["b", "TI"], 
     StyleBox["mag",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["mag",
      FontSlant->"Plain"], "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3db74b3b-bbe1-4dd4-95d4-3566bdfd1ad8"],
 " for the magnetization ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["mag",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3891621b-50ef-471b-a002-614264a84f11"],
 " (the symmetry ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["mag",
      FontSlant->"Plain"]], "\[RightArrow]", 
    RowBox[{"-", 
     SubscriptBox[
      StyleBox["m", "TI"], 
      StyleBox["mag",
       FontSlant->"Plain"]]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fb2477ca-ac81-4ea8-9b0c-07386d3e3744"],
 "), with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["mag",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b356fbd4-332a-443e-943e-d3b44ce4a837"],
 " proportional to the temperature minus the Curie temperature and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["b", "TI"], 
     StyleBox["mag",
      FontSlant->"Plain"]], ">", "0"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8d081fb0-4af1-4031-a5eb-b8b3e7398f61"],
 "; below the Curie temperature the minima are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["mag",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"\[PlusMinus]", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", 
         SubscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["mag",
           FontSlant->"Plain"]]}], "/", 
        RowBox[{"(", 
         RowBox[{"2", 
          SubscriptBox[
           StyleBox["b", "TI"], 
           StyleBox["mag",
            FontSlant->"Plain"]]}], ")"}]}], ")"}], 
      RowBox[{"1", "/", "2"}]]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e443f8a7-588d-46f1-b0a8-3b62dbaf911f"],
 "."
}], "Item",ExpressionUUID->"f0461f47-e473-43c6-9673-071810ac3c04"],

Cell[TextData[{
 "The theory of superconductivity of V. L. Ginzburg and L. D. Landau (1950): ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Alpha]", 
     StyleBox["GL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      SubscriptBox["\[Psi]", 
       StyleBox["GL",
        FontSlant->"Plain"]], "\[RightBracketingBar]"}], "2"], "+", 
    FractionBox["1", "2"], 
    SubscriptBox["\[Beta]", 
     StyleBox["GL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      SubscriptBox["\[Psi]", 
       StyleBox["GL",
        FontSlant->"Plain"]], "\[RightBracketingBar]"}], "4"]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "91dc1de6-a40d-4d20-ab3e-bae0d6900eae"],
 " for the complex pair wave function ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Psi]", 
    StyleBox["GL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5e3cd043-599f-4974-b8ab-d2045aa229ac"],
 " (the symmetry ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["U", "TI"], 
    RowBox[{"(", "1", ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "09a96b2b-2064-4b04-a7f6-7606ab797da6"],
 "), with gradient terms and the magnetic field added. L. P. Gor'kov (1959) \
derived it from the theory of Bardeen, Cooper and Schrieffer near the \
critical temperature, where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftBracketingBar]", 
    SubscriptBox["\[Psi]", 
     StyleBox["GL",
      FontSlant->"Plain"]], "\[RightBracketingBar]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a61c3ee7-d9cb-470b-8965-3f4a832d9d4d"],
 " is small; there the coefficients are true Taylor coefficients."
}], "Item",ExpressionUUID->"63c5291d-c4dc-468d-9dc6-7c32f56bd0b4"],

Cell[TextData[{
 "The Higgs potential of the Standard Model, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     SuperscriptBox[
      RowBox[{"(", 
       SuperscriptBox["\[Mu]", 
        StyleBox["SM",
         FontSlant->"Plain"]], ")"}], "2"]}], 
    SuperscriptBox[
     RowBox[{"(", 
      SuperscriptBox["\[CapitalPhi]", 
       StyleBox["SM",
        FontSlant->"Plain"]], ")"}], "\[Dagger]"], 
    SuperscriptBox["\[CapitalPhi]", 
     StyleBox["SM",
      FontSlant->"Plain"]], "+", 
    SuperscriptBox["\[Lambda]", 
     StyleBox["SM",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         SuperscriptBox["\[CapitalPhi]", 
          StyleBox["SM",
           FontSlant->"Plain"]], ")"}], "\[Dagger]"], 
       SuperscriptBox["\[CapitalPhi]", 
        StyleBox["SM",
         FontSlant->"Plain"]]}], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5dd8a117-1a21-46a3-94cd-4394d001b139"],
 ": the doublet ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CapitalPhi]", 
    StyleBox["SM",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8486d197-0ed7-4e5e-8664-ecfcc3a1e0dd"],
 " has the single invariant ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SuperscriptBox["\[CapitalPhi]", 
       StyleBox["SM",
        FontSlant->"Plain"]], ")"}], "\[Dagger]"], 
    SuperscriptBox["\[CapitalPhi]", 
     StyleBox["SM",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d55e7005-621c-4b34-8dbc-4302d728c554"],
 " of degree 2, and this Landau form is exact at tree level, not a truncation."
}], "Item",ExpressionUUID->"328ad6ea-0e48-471c-af22-2b831fc0a952"],

Cell[TextData[{
 "The Bose-Einstein condensates of spin 1 (T.-L. Ho, 1998; T. Ohmi and K. \
Machida, 1998), the closest analogue of ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[CapitalPhi]", "\[RightVector]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a103e633-dd61-4a0b-abbe-5646c66e5069"],
 ": their order parameter is a complex vector ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[CurlyPi]", "\[RightVector]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f48519e5-9cb3-4c23-9672-218f76746393"],
 ", and their energy per volume ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], 
    SubscriptBox[
     StyleBox["c", "TI"], 
     StyleBox["n",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      OverscriptBox["\[CurlyPi]", "\[RightVector]"], 
      "\[RightBracketingBar]"}], "4"], "+", 
    FractionBox["1", "2"], 
    SubscriptBox[
     StyleBox["c", "TI"], 
     StyleBox["s",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"\[LeftBracketingBar]", 
        OverscriptBox["\[CurlyPi]", "\[RightVector]"], 
        "\[RightBracketingBar]"}], "4"], "-", 
      SuperscriptBox[
       RowBox[{"\[LeftBracketingBar]", 
        RowBox[{
         OverscriptBox["\[CurlyPi]", "\[RightVector]"], "\[CenterDot]", 
         OverscriptBox["\[CurlyPi]", "\[RightVector]"]}], 
        "\[RightBracketingBar]"}], "2"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a3ede306-7d09-427d-b7f4-f65d3e9025b5"],
 " contains the same two quartic invariants as ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[CapitalPhi]", "\[RightVector]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f8b1b47e-8803-47bd-b9bc-733aaf81b833"],
 ", the second term being the square of the spin. ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["c", "TI"], 
     StyleBox["s",
      FontSlant->"Plain"]], ">", "0"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ab6b5516-2f72-49ef-9778-1b2b8982b0d4"],
 " (sodium-23) favors the polar state, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["c", "TI"], 
     StyleBox["s",
      FontSlant->"Plain"]], "<", "0"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b46cbc6f-28d7-4b1c-b769-9650a343d2e1"],
 " (rubidium-87) the ferromagnetic state ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["\[CurlyPi]", "\[RightVector]"], "\[Proportional]", 
    RowBox[{"(", 
     RowBox[{"1", ",", 
      StyleBox["i", "TI"], ",", "0"}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7f2f4f98-b8ae-4ca7-87b0-420cde914a4a"],
 "."
}], "Item",ExpressionUUID->"9c95f216-b00a-403d-9d7e-43b9994f38ac"],

Cell[TextData[{
 "The ferroelectric barium titanate (A. F. Devonshire, 1949): ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Alpha]", 
     StyleBox["D",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["P", "TI"], 
     StyleBox["D",
      FontSlant->"Plain"], "2"], "+", 
    SubscriptBox["\[Beta]", 
     StyleBox["D",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["P", "TI"], 
     StyleBox["D",
      FontSlant->"Plain"], "4"], "+", 
    SubscriptBox["\[Gamma]", 
     StyleBox["D",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["P", "TI"], 
     StyleBox["D",
      FontSlant->"Plain"], "6"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0bedb432-58da-4a28-868e-2f1925baceb9"],
 " for the polarization ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["P", "TI"], 
    StyleBox["D",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6eb59dbc-d2f9-4134-92cb-b51007226c43"],
 ", with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Beta]", 
     StyleBox["D",
      FontSlant->"Plain"]], "<", "0"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7278c256-d812-475b-982a-573de8e5159f"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", 
     StyleBox["D",
      FontSlant->"Plain"]], ">", "0"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a486eb34-3a9e-45ad-b238-493ac07c3d21"],
 ": the sixth power is required, and the transition is of first order."
}], "Item",ExpressionUUID->"04c65e36-ade9-4360-ac80-117c68000475"],

Cell[TextData[{
 "Superfluid helium-3 (A. J. Leggett, 1975): one quadratic and five quartic \
invariants of a complex ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", "\[Times]", "3"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f008e2c8-8ace-4ad4-bf3c-155512b208d3"],
 " matrix, whose five coefficients decide between the phases A and B. The \
nematic liquid crystals (P. G. de Gennes, 1971): the traceless symmetric \
tensor of the nematic order admits an invariant of the third degree, so the \
transition is of first order."
}], "Item",ExpressionUUID->"e8ce6499-50dd-4397-b982-c9a68ddd0951"],

Cell[TextData[{
 "The name has nothing to do with the Landau levels of a charge in a magnetic \
field (Section I.6 of this notebook, AS2): the same physicist, another \
subject. ",
 StyleBox["The Landau form of $\\vec\\Phi$.",
  FontWeight->"Bold"],
 " The symmetry is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["v",
      FontSlant->"Plain"]], "\[Times]", 
    StyleBox["U", "TI"], 
    SubsuperscriptBox[
     RowBox[{"(", "1", ")"}], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "adad1ff0-8a41-4ebf-aea3-6058df1be054"],
 ". The independent invariants up to the fourth degree are ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9c2b5f90-c0c9-4d60-a884-edbd60a79e98"],
 ", ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}], "4"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "98d848a1-8e19-4acc-b48d-410ac4ebbed6"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     RowBox[{
      OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "\[CenterDot]", 
      OverscriptBox["\[CapitalPhi]", "\[RightVector]"]}], 
     "\[RightBracketingBar]"}], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9005592f-f4b5-4b5f-87ed-48dc155a6228"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
      "\[RightBracketingBar]"}], "4"], "-", 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      RowBox[{
       OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "\[CenterDot]", 
       OverscriptBox["\[CapitalPhi]", "\[RightVector]"]}], 
      "\[RightBracketingBar]"}], "2"], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      RowBox[{
       OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "\[Times]", 
       SuperscriptBox[
        OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "*"]}], 
      "\[RightBracketingBar]"}], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "10527fd8-1918-4446-8039-8348824715d9"],
 " vanishes exactly on the polar fields. The Landau form used by the solution \
is"
}], "Text",ExpressionUUID->"855526f2-6923-43ac-a3e2-42104df8af26"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalV]",
