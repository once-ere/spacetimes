Cell[CellGroupData[{

Cell["\<\
I.4 The gauge group GEE and its covariant derivatives (item 3)\
\>", "Section",ExpressionUUID->"bb8587a3-0710-4df3-9ef8-eb4ad3c93b92"],

Cell[TextData[{
 "The gauge group is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["GEE",
     FontSlant->"Plain"], "\[LongEqual]", 
    StyleBox["SL", "TI"], 
    RowBox[{"(", 
     RowBox[{"2", ",", 
      StyleBox["\[DoubleStruckCapitalC]",
       FontSlant->"Plain"]}], ")"}], "\[Times]", 
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["v",
      FontSlant->"Plain"]], "\[Times]", 
    StyleBox["U", "TI"], 
    SubsuperscriptBox[
     RowBox[{"(", "1", ")"}], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "817b2d30-2a57-4791-bd08-116f5f0ea612"],
 ". A local transformation is a unit bi-quaternion ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["g",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     StyleBox["x", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fe489831-f14f-400d-9ed6-ccd8d524495f"],
 ", an isospin rotation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["U",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["x", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2b98f11e-a83b-4b28-b3e3-e7c69ebf3af2"],
 " and a phase ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Theta]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["x", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "de5a2b7e-4ad7-4664-ab31-259e42d5590d"],
 "; it acts on the spinor field as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[RightTeeArrow]", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      StyleBox["i", "TI"], 
      SubsuperscriptBox["\[Theta]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["F",
        FontSlant->"Plain"]]}]], 
    SubscriptBox[
     StyleBox["S",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[CircleTimes]", 
    SubscriptBox[
     StyleBox["U",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[ThinSpace]", 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "257a17d9-c2b5-4802-b816-5445ada316fd"],
 ". The gauge fields are the Lorentz connection with the spin connection ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalGamma]", 
    StyleBox["p", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "08a44621-a44c-4fcf-9453-ec7c7cd63a70"],
 ", the field of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["v",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1294c936-a34e-463d-a10d-482461128565"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["W",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}]], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", "\[Iota]",
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["W", "TI"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], "\[Iota]"], 
    SubsuperscriptBox["\[Tau]", "\[Iota]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "/", "2"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "25bee37e-785c-4a7b-95f9-81d752575d26"],
 ", and the field ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["B", "TI"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "df864015-ddb3-40e5-ab47-8f9c9df17fa8"],
 " of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["U", "TI"], 
    SubsuperscriptBox[
     RowBox[{"(", "1", ")"}], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c768acbb-c1a3-40e2-a774-2978eb98284a"],
 ", with the couplings ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["v",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c92ecb8f-af6c-4115-aa81-50f1dfa5af04"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["F",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "963e3f78-7c47-44b7-9214-f19b8914d5cf"],
 ". The covariant derivative of the spinor field is"
}], "Text",ExpressionUUID->"53a9a9ad-bae2-4bcf-8d91-1113f414fbae"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["\[Del]", 
    StyleBox["p", "TI"], 
    StyleBox["GEE",
     FontSlant->"Plain"]], 
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], "\[LongEqual]", 
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["\[PartialD]", 
      StyleBox["p", "TI"]], "+", 
     SubsuperscriptBox["\[CapitalGamma]", 
      StyleBox["p", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"]], "+", 
     StyleBox["i", "TI"], 
     SubsuperscriptBox[
      StyleBox["g", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["v",
       FontSlant->"Plain"]], "\[ThinSpace]", 
     SubscriptBox[
      StyleBox["1",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "4"], "\[CircleTimes]", 
     SubscriptBox[
      StyleBox["W",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["SF",
        FontSlant->"Plain"], ",", 
       StyleBox["p", "TI"]}]], "+", 
     StyleBox["i", "TI"], 
     SubsuperscriptBox[
      StyleBox["g", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["F",
       FontSlant->"Plain"]], 
     SubscriptBox[
      StyleBox["B", "TI"], 
      RowBox[{
       StyleBox["SF",
        FontSlant->"Plain"], ",", 
       StyleBox["p", "TI"]}]]}], ")"}], 
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], ","}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"3cd527c5-9483-4961-9741-b011e44a5034"],

Cell[TextData[{
 "and it is covariant, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Del]", 
     StyleBox["p", "TI"], 
     RowBox[{"\[Prime]", 
      StyleBox["GEE",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["\[ScriptCapitalU]",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      SubscriptBox["\[CapitalPsi]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["\[ScriptCapitalU]",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Del]", 
     StyleBox["p", "TI"], 
     StyleBox["GEE",
      FontSlant->"Plain"]], 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4fae27d0-13fe-4594-82bd-42f69267c64a"],
 ", when the gauge fields transform as"
}], "Text",ExpressionUUID->"8173877a-ac99-4284-8a52-7062f0ef5c4d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["\[CapitalGamma]", 
    StyleBox["p", "TI"], 
    RowBox[{"\[Prime]", 
     StyleBox["LL",
      FontSlant->"Plain"]}]], "\[LongEqual]", 
   StyleBox["S",
    FontFamily->"Helvetica",
    FontSlant->"Plain"], "\[ThinSpace]", 
   SubsuperscriptBox["\[CapitalGamma]", 
    StyleBox["p", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["S",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{"-", "1"}]], "-", 
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["\[PartialD]", 
      StyleBox["p", "TI"]], 
     StyleBox["S",
      FontFamily->"Helvetica",
      FontSlant->"Plain"]}], ")"}], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["S",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{"-", "1"}]], ",", "      ", 
   SubsuperscriptBox[
    StyleBox["W",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}], "\[Prime]"], "\[LongEqual]", 
   SubscriptBox[
    StyleBox["U",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   SubscriptBox[
    StyleBox["W",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}]], 
   SubsuperscriptBox[
    StyleBox["U",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Dagger]"], "+", 
   FractionBox[
    StyleBox["i", "TI"], 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]]], 
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["\[PartialD]", 
      StyleBox["p", "TI"]], 
     SubscriptBox[
      StyleBox["U",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"]]}], ")"}], 
   SubsuperscriptBox[
    StyleBox["U",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Dagger]"], ",", "      ", 
   SubsuperscriptBox[
    StyleBox["B", "TI"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}], "\[Prime]"], "\[LongEqual]", 
   SubscriptBox[
    StyleBox["B", "TI"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}]], "-", 
   FractionBox["1", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]]], 
   SubscriptBox["\[PartialD]", 
    StyleBox["p", "TI"]], 
   SubsuperscriptBox["\[Theta]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["F",
     FontSlant->"Plain"]], "."}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"bcb11508-9b24-4769-bcc2-3a7f9b0f0050"],

Cell[TextData[{
 "An isospin vector of fermion number 2 and spin 0, such as the pair field ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[CapitalPhi]", "\[RightVector]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "04899082-92ba-4475-9634-de0f7701a0be"],
 " of the superfluid, has the covariant derivative ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Del]", 
     StyleBox["p", "TI"]], 
    OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "\[LongEqual]", 
    SubscriptBox["\[PartialD]", 
     StyleBox["p", "TI"]], 
    OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "-", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["W", "TI"], "\[RightVector]"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}]], "\[Times]", 
    OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "+", "2", 
    StyleBox["i", "TI"], 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["B", "TI"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}]], 
    OverscriptBox["\[CapitalPhi]", "\[RightVector]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "483cdb69-2c41-414c-a1bd-0cc34a7959be"],
 "; the field strengths are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["W",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], "\[LongEqual]", 
    SubscriptBox["\[PartialD]", 
     StyleBox["p", "TI"]], 
    SubscriptBox[
     StyleBox["W",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], "-", 
    SubscriptBox["\[PartialD]", 
     SuperscriptBox[
      StyleBox["p", "TI"], "\[Prime]"]], 
    SubscriptBox[
     StyleBox["W",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}]], "+", 
    StyleBox["i", "TI"], 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]], 
    RowBox[{"[", 
     RowBox[{
      SubscriptBox[
       StyleBox["W",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["SF",
         FontSlant->"Plain"], ",", 
        StyleBox["p", "TI"]}]], ",", 
      SubscriptBox[
       StyleBox["W",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["SF",
         FontSlant->"Plain"], ",", 
        SuperscriptBox[
         StyleBox["p", "TI"], "\[Prime]"]}]]}], "]"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "64a8f0be-dbad-4197-ada8-7b5d03dcbd92"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["B", "TI"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], "\[LongEqual]", 
    SubscriptBox["\[PartialD]", 
     StyleBox["p", "TI"]], 
    SubscriptBox[
     StyleBox["B", "TI"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], "-", 
    SubscriptBox["\[PartialD]", 
     SuperscriptBox[
      StyleBox["p", "TI"], "\[Prime]"]], 
    SubscriptBox[
     StyleBox["B", "TI"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "817e0449-3a32-40c1-9066-284b56711143"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["W",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}], "\[Prime]"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["U",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["W",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], 
    SubsuperscriptBox[
     StyleBox["U",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Dagger]"]}], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b92b7b9b-e9f8-4e39-823c-ac169f2c7f6f"],
 "."
}], "Text",ExpressionUUID->"f9fed371-834b-4395-b1cc-3de4fa437809"],

Cell[TextData[{
 "The next cell checks these covariance laws with random smooth fields: the \
isospin rotation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["U",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["x", "TI"], ")"}], "\[LongEqual]", 
    StyleBox["exp",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       StyleBox["i", "TI"], "2"], "\[ThinSpace]", 
      UnderscriptBox["\[Sum]", "\[Iota]",
       LimitsPositioning->True], "\[ThinSpace]", 
      SuperscriptBox[
       StyleBox["a", "TI"], "\[Iota]"], 
      RowBox[{"(", 
       StyleBox["x", "TI"], ")"}], 
      SubsuperscriptBox["\[Tau]", "\[Iota]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f2b640d4-d1fb-4daa-843f-5940dc529b01"],
 ", the phase, the gauge fields and the test fields are sums of sines of the \
four coordinates with random coefficients. The derivatives are computed \
symbolically by the function ",
 StyleBox["D",
  FontFamily->"Source Code Pro"],
 " of the Wolfram Language and evaluated at four random points: a third \
method, next to the automatic differentiation of the Rust program and the \
differences of eighth order of the Python program. The couplings of the test \
are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["v",
