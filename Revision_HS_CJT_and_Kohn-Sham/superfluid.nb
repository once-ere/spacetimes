        RowBox[{
         RowBox[{"40", " ", "digits"}], ",", " ", 
         RowBox[{"then", " ", "machine", " ", "numbers"}]}], ")"}]}]}]}], " ",
     "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"gaussLegendre", "[", "n_Integer", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "xx", ",", " ", "poly", ",", " ", "dpoly", ",", " ", "roots"}], "}"}],
        ",", "\n", "   ", 
