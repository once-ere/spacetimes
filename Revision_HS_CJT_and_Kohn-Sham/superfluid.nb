              RowBox[{"[", "4", "]"}], "]"}], ",", " ", "3"}], "]"}], ",", 
           "\n", "      ", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{"g", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", " ", "4"}], "]"}], ",", 
           " ", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"g", "[", 
               RowBox[{"[", "1", "]"}], "]"}], " ", 
              RowBox[{"r", "[", "\"\<Tc\>\"", "]"}]}], ",", " ", "4"}], "]"}],
            ",", "\n", "      ", 
           RowBox[{
            RowBox[{"ToString", "[", 
             RowBox[{"NumberForm", "[", 
              RowBox[{
               RowBox[{"36", " ", 
                RowBox[{
                 RowBox[{"g", "[", 
                  RowBox[{"[", "5", "]"}], "]"}], "^", "2"}], " ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"r", "[", "\"\<Tc\>\"", "]"}], "^", "2"}], "/", 
                 RowBox[{"(", 
                  RowBox[{"64", " ", 
                   RowBox[{"Pi", "^", "2"}], " ", 
                   RowBox[{"r", "[", "\"\<alpha\>\"", "]"}], " ", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"r", "[", "\"\<c\>\"", "]"}], " ", "+", " ", 
                    "ct3"}], ")"}], "^", "3"}]}], ")"}]}]}], ",", " ", "3"}], 
              "]"}], "]"}], " ", "<>", " ", "\"\< to \>\"", " ", "<>", " ", 
            RowBox[{"ToString", "[", 
             RowBox[{"NumberForm", "[", 
              RowBox[{
               RowBox[{"36", " ", 
                RowBox[{
                 RowBox[{"g", "[", 
                  RowBox[{"[", "5", "]"}], "]"}], "^", "2"}], " ", 
                RowBox[{
                 RowBox[{
