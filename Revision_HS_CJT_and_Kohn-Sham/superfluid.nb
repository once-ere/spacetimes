Cell[CellGroupData[{

Cell["\<\
II.4 The first excited states: the linear response of the superfluid\
\>", "Section",ExpressionUUID->"4d852792-111b-4d7d-b9fd-d4dc48f67cf9"],

Cell[TextData[{
 "A small change of the self-energies with the time dependence ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     RowBox[{"-", 
      StyleBox["i", "TI"]}], "\[Omega]", 
     StyleBox["t", "TI"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "538c8b4e-6600-4c10-8afa-ccacefdec422"],
 " is described by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["V",
      FontSlant->"Plain"]], "\[LongEqual]", "120"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0b0df4f3-57cc-4175-ad5e-9f525641d4a7"],
 " complex amplitudes: the 64 entries of a change ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", 
    StyleBox["N",
     FontFamily->"Helvetica",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "aa281bc5-668f-4084-be8b-67f663bb46c4"],
 " of the normal self-energy and the 28 independent entries of each of two \
antisymmetric changes of the pair self-energy (",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", 
    StyleBox["P",
     FontFamily->"Helvetica",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5fb96b38-36fb-4606-8f69-ef970512765b"],
 " and the change of its adjoint). The change of the state in answer to a \
change of the self-energies is the response ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Chi]", 
    RowBox[{"(", "\[Omega]", ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0e6c867a-da06-4432-abcb-1893b9bc26fd"],
 ", a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"120", "\[Times]", "120"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bde7c91d-0c3e-451d-b952-3d381b8c8a04"],
 " matrix,"
}], "Text",ExpressionUUID->"2b29ac80-2495-4368-9dcd-69e8db4c49ad"],

Cell[BoxData[
 FormBox[
  RowBox[{"\[Chi]", 
   RowBox[{"(", "\[Omega]", ")"}], "\[LongEqual]", 
   UnderscriptBox["\[Sum]", 
    StyleBox["n", "TI"],
    LimitsPositioning->True], 
   RowBox[{"(", 
    RowBox[{
     FractionBox[
      SubscriptBox[
       StyleBox["A",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["n", "TI"]], 
      RowBox[{"\[Omega]", "-", 
       SubscriptBox["\[CapitalOmega]", 
        StyleBox["n", "TI"]]}]], "-", 
     FractionBox[
      SubscriptBox[
       StyleBox["B",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["n", "TI"]], 
      RowBox[{"\[Omega]", "+", 
       SubscriptBox["\[CapitalOmega]", 
        StyleBox["n", "TI"]]}]]}], ")"}], ","}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"168e8eb7-14e2-401a-bd56-4de487caa524"],

Cell[TextData[{
 "a sum over the momenta ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "015a9887-f46c-4ef1-98f1-f227f1a17bee"],
 " of the grid, where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalOmega]", 
     StyleBox["n", "TI"]], "\[LongEqual]", "2", 
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["n", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5859e8f9-990f-4b1b-8992-0b66974a4c5f"],
 " is the energy of a pair of quasi-particles at the momentum ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "92831867-f96e-4c84-aae8-0cff7db17002"],
 " (for these states every eigenvalue of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["H",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "25f74dbc-ae29-4da3-b6be-18680d7cdcf4"],
 " at a momentum is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["n", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cc4e4a6a-a4c1-4148-84fe-0befa63a8351"],
 ", which the cell checks) and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["A",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "190f3ee0-7133-43e5-b70a-23ba7054620d"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["B",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "772d633b-e3b4-4fcc-84a1-eeac08c96cdf"],
 " are built from the eigenvectors (the creation of two quasi-particles and \
its reverse). The self-energies change by ",
 Cell[BoxData[
  FormBox[
   StyleBox["F",
    FontFamily->"Helvetica",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "24066c8b-d1ed-4563-8ceb-b28bb52bba46"],
 " times the change of the state, where ",
 Cell[BoxData[
  FormBox[
   StyleBox["F",
    FontFamily->"Helvetica",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a5b616ab-97bd-4476-9357-f1a07bdda3a9"],
 " is the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"120", "\[Times]", "120"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c8b4e323-4ff6-41fc-b459-6d0d45a37824"],
 " matrix of the self-energy maps of the contact terms (",
 StyleBox["respKernel",
  FontFamily->"Source Code Pro"],
 "). A collective mode of frequency ",
 Cell[BoxData[
  FormBox["\[Omega]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ac77f358-425c-41ba-aa12-0b4aa66fcb72"],
 " is a solution of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", "\[LongEqual]", "\[Chi]", 
    RowBox[{"(", "\[Omega]", ")"}], 
    StyleBox["F",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "\[Delta]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4e289b9f-ad06-42a8-b384-9f13e3a74d2a"],
 ": the matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["M",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{"(", "\[Omega]", ")"}], "\[LongEqual]", "\[Chi]", 
    RowBox[{"(", "\[Omega]", ")"}], 
    StyleBox["F",
     FontFamily->"Helvetica",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2a94860e-5375-476b-b9f0-af2687ad0183"],
 " has the eigenvalue 1. At ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Omega]", "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "24ffbadd-8694-4cc5-aa59-569398922fc0"],
 " the three broken generators give three Goldstone modes: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["M",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{"(", "0", ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "83a23ec4-daf8-4e5e-8390-ede972134d01"],
 " has the eigenvalue 1 three times. Below the threshold ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["min",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{"2", 
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["gap",
         FontSlant->"Plain"]}]], ",", 
      UnderscriptBox[
       StyleBox["min",
        FontSlant->"Plain"], 
       StyleBox["n", "TI"],
       LimitsPositioning->True], "\[ThinSpace]", 
      SubscriptBox["\[CapitalOmega]", 
       StyleBox["n", "TI"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "546a4477-4913-47da-919f-93084e07df49"],
 " the modes are found where the number of real eigenvalues of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["M",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{"(", "\[Omega]", ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "585cdfa2-b349-4c0c-9383-ffb3044b8ed2"],
 " above 1 changes: a scan of 300 frequencies, then 45 bisections for each \
change. The cell does this for HS ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"1", ",", "1"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "58436603-08ea-45d3-93f7-79e6898c7dff"],
 ", KS and CJT with ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "2", ")"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "22f4b7de-eeab-4b93-954e-3f15645fa10a"],
 ", and compares the modes with the Rust program."
}], "Text",ExpressionUUID->"adb0680c-dd6c-41e3-947d-361a63c2438a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", "28", " ", "pairs", " ", 
     RowBox[{"(", 
      RowBox[{"i", ",", " ", "j"}], ")"}]}], ",", " ", 
    RowBox[{"i", " ", "<", " ", "j"}], ",", " ", 
    RowBox[{"of", " ", "the", " ", "antisymmetric", " ", "matrices"}], ",", 
    " ", 
    RowBox[{
    "in", " ", "the", " ", "order", " ", "of", " ", "the", " ", "rows"}]}], 
   " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"pairsSF", " ", "=", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "j"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "8"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"j", ",", " ", 
           RowBox[{"i", " ", "+", " ", "1"}], ",", " ", "8"}], "}"}]}], "]"}],
        ",", " ", "1"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"toVec", "[", 
       RowBox[{"x", ",", " ", "a", ",", " ", "b"}], "]"}], ":", " ", 
      RowBox[{"the", " ", "120", " ", "amplitudes", " ", "of", " ", 
       RowBox[{"(", 
        RowBox[{"dN", ",", " ", "dP", ",", " ", 
         RowBox[{"dP", "-", "bar"}]}], ")"}]}], ":", " ", 
      RowBox[{"the", " ", "64", " ", "entries", " ", "of", " ", "x"}]}], ",", 
     " ", 
     RowBox[{"then", " ", 
      RowBox[{"1", "/", "2"}], " ", 
      RowBox[{"(", 
       RowBox[{"a_ij", " ", "-", " ", "a_ji"}], ")"}], " ", "and", " ", 
      RowBox[{"1", "/", "2"}], " ", 
      RowBox[{"(", 
       RowBox[{"b_ij", " ", "-", " ", "b_ji"}], ")"}]}]}], " ", "*)"}], "\n", 
   
   RowBox[{
    RowBox[{
     RowBox[{"toVec", "[", 
      RowBox[{"x_", ",", " ", "a_", ",", " ", "b_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", "x", "]"}], ",", " ", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"0.5", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"a", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}], " ", "-", 
             " ", 
             RowBox[{"a", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "]"}]}], ")"}]}], 
          " ", "&"}], ",", " ", "pairsSF"}], "]"}], ",", " ", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"0.5", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"b", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}], " ", "-", 
             " ", 
