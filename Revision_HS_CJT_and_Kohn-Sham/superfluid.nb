gamma^p d_p psi (symbolic derivatives)\>\"", ",", " ", "dC8", ",", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "9"}]}], ",", " ", "\"\<C-8\>\"", ",", 
      " ", "\"\<C-8\>\""}], "]"}], ";"}]}]}]], "Input",
 CellLabel->"In[92]:=",ExpressionUUID->"2ac0b3ed-9388-45ff-9557-86087ac75549"],

