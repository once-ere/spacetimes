Cell[CellGroupData[{

Cell["III.L.6 Why it matters", "Section",ExpressionUUID->"a0f99118-2c2a-4946-af5e-81519c8db6d5"],

Cell[TextData[{
 StyleBox["It enters no other result.",
  FontWeight->"Bold"],
 " The effective Lagrangians of the solution contain the computed function ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalV]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1c614303-5692-49c0-9ae9-d50c38e2ac5e"],
 ", not the Landau form, and no other result uses ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a4500d7e-3ee1-494e-ac80-6da53e68cca3"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["b", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f52fb994-407a-4021-acae-d7d1098dd0a3"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d0043f4c-6624-4d48-88d5-d3bb8aa12d3f"],
 ": the mass of the amplitude mode uses the curvature ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalV]",
     FontSlant->"Plain"], 
    StyleBox["amp",
     FontSlant->"Plain"], "\[Prime]\[Prime]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "45a451b7-351c-4b6f-ae70-4cafd4b82342"],
 " of the computed curve, ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["u", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "169158b9-2e2c-4f74-9067-4426e38808fa"],
 " and the mass of the non-unitary modes use the computed curvature in the \
non-unitary direction, and the masses of the gauge bosons and the dynamics \
use ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalPhi]", 
    RowBox[{"0", ",", 
     StyleBox["SF",
      FontSlant->"Plain"]}], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "808edee4-bd3d-4ae6-b916-6a0b1fad1ab3"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["Z", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "68171aa5-0423-44f9-8f55-27204623a7a0"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["Y", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6dcb77a3-1add-4d7b-b257-59e1fcb5b1e1"],
 " and the susceptibilities."
}], "ItemNumbered",ExpressionUUID->"e99fcb14-f85c-4aac-9745-6793a11e71de"],

Cell[TextData[{
 StyleBox["It matters to whoever replaces $\\mathcal V^X_{\\rm SF}$ by the \
Landau form",
  FontWeight->"Bold"],
 ", as in a model of the type of Ginzburg and Landau or of Higgs: the minimum \
of the polynomial is 0.04 to 0.11 per cent too small, its depth 0.12 to 0.31 \
per cent too large, its curvature at its minimum 0.86 to 2.3 per cent too \
large, and the mass of the amplitude mode 0.43 to 1.1 per cent too large (the \
table above). A derivative enlarges the relative error of the function. \
Beyond the fitted interval the error grows: fitted on the whole computed \
curve, the form misses by 1.2 to 1.7 per cent of the depth."
}], "ItemNumbered",ExpressionUUID->"e07f4f10-5fd3-4a61-b710-a54d569822c3"],

Cell[TextData[{
 StyleBox["The coefficients are not constants of the theory.",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b3758e42-a144-47fc-bcf6-811acc915fed"],
 " differs from the Taylor coefficient at the origin, and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["b", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6b126b49-35f2-495c-9161-e7ed603a6567"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "61dab237-3f73-4f8e-9bca-f8e143d53b20"],
 " change with the fitted interval and with the number of powers (the last \
four rows of the table). No physical meaning may be given to ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["b", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "16811ea4-c16c-44c6-8d44-3745f4b11b63"],
 " or ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "253c35a4-93b4-4d6d-9ceb-73f8ba972412"],
 " alone. The physical quantities are those that the computed function \
defines: ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalPhi]", 
    RowBox[{"0", ",", 
     StyleBox["SF",
      FontSlant->"Plain"]}], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "922eaa4a-d6f6-42a1-bf0d-6566e8c3846a"],
 ", the depth, the curvatures at the minimum, and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["Tay",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2342f890-d22e-4440-9bd9-73716972b5f2"],
 "."
}], "ItemNumbered",ExpressionUUID->"8e26467c-ab01-4071-85ca-1dc40d25b29e"],

Cell[TextData[{
 StyleBox["The qualitative results do not depend on the fit.",
  FontWeight->"Bold"],
 " That ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalV]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1d04400c-5363-470e-a2a3-4dad635ca42c"],
 " vanishes at the origin, is negative near it, has its minimum at ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalPhi]", 
    RowBox[{"0", ",", 
     StyleBox["SF",
      FontSlant->"Plain"]}], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bfd675a0-b27e-4217-b2ae-58ecffe38d7e"],
 ", depends only on the two invariants, and has a stable polar minimum (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["u", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], ">", "0"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8728c845-2cf0-4f7d-b5ec-89a17138a751"],
 ") are properties of the computed function, checked on it directly; the sign \
of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "96daaf61-4c78-4fdc-9295-237cd24c4b55"],
 " is that of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["Tay",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f6b4aec0-57e5-46c2-a077-e90d54eae72a"],
 " (negative: the normal vacuum is unstable)."
}], "ItemNumbered",ExpressionUUID->"9402c80d-a1e3-43a6-a005-fdd3040602d4"],

Cell[TextData[{
 StyleBox["The comparison with the Standard Model.",
  FontWeight->"Bold"],
 " The field has a Mexican hat with the symmetry structure of the Higgs \
sector and of the polar phase of a condensate of spin 1, but its potential is \
not the quartic potential of the Standard Model: the quartic form misses ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalV]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "70b4aa72-e892-4eb6-962a-3164e191b245"],
 " by 2.8 to 5.9 per cent of the depth, about ten times more than the Landau \
form with the sixth power."
}], "ItemNumbered",ExpressionUUID->"d28006e5-4d25-4958-bf44-363bdfb156cd"],

Cell[TextData[{
 StyleBox["Corrections of the first answers.",
  FontWeight->"Bold"],
 " The first answers to the author contained five statements that were not \
exact; the numbers of this chapter are the corrected ones. (1) The residual \
changes its sign three times, not five. (2) The fit called a fit on ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"0", ",", "2", 
     SubscriptBox["\[CapitalPhi]", "0"]}], "]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bce9a0b6-f9a2-4842-8c18-9535e72e48a4"],
 " used all 61 points of the curve, whose fields reach 1.52 to 1.64 times ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalPhi]", 
    RowBox[{"0", ",", 
     StyleBox["SF",
      FontSlant->"Plain"]}], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "37d81d1b-a3dc-4005-8c6c-cfaef8b4d0e7"],
 "; the applied field, not the field of the states, reaches ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    SubsuperscriptBox["\[CapitalPhi]", 
     RowBox[{"0", ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "26aa36ff-4d08-43e5-8fb5-030560858ca9"],
 ". (3) The range of the end of the curve is 1.52 to 1.64 (HS ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "0"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5560e4d1-a36b-4119-b1fe-873247e6e589"],
 "), not 1.52 to 1.61. (4) The singularity lies at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"], "2"], "\[LongEqual]", 
    RowBox[{"-", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["M", "TI"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["X", "TI"], ",", 
         StyleBox["D",
          FontSlant->"Plain"]}]], ")"}], "2"]}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c790adc8-d580-4561-a909-7c5766285237"],
 " in the applied field; in the field of the states the radius of convergence \
is of the order of the Dirac mass, not equal to it. (5) The errors of the \
curvature quoted first, 1.1 to 2.7 per cent, are those of the polynomial at \
the minimum of the computed curve; at the polynomial's own minimum, where a \
user evaluates it, they are 0.86 to 2.3 per cent, as the table shows."
}], "Text",ExpressionUUID->"f98611a6-45e7-4d3e-8934-008a280ecfc5"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["The list of all checks", "Chapter",ExpressionUUID->"cd418d98-efc6-4ee4-b8eb-d7c1f3a3ace0"],

Cell["\<\
The last cell lists every check of this notebook with its result and its \
counterparts in the Rust and the Python programs, and counts the checks that \
passed.\
\>", "Text",ExpressionUUID->"a7876604-8d87-475f-b9ed-8b9e5a0eb051"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", "table", " ", "of", " ", "all", " ", 
     RowBox[{"checks", ":", " ", "identifier"}]}], ",", " ", "result", ",", 
    " ", "deviation", ",", " ", "tolerance", ",", " ", "counterparts"}], " ", 
   "*)"}], "\n", 
  RowBox[{"Grid", "[", 
   RowBox[{
    RowBox[{"Prepend", "[", 
     RowBox[{
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"#", "[", "\"\<id\>\"", "]"}], ",", " ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"#", "[", "\"\<pass\>\"", "]"}], ",", " ", "\"\<PASS\>\"",
              ",", " ", "\"\<FAIL\>\""}], "]"}], ",", " ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"NumericQ", "[", 
              RowBox[{"#", "[", "\"\<deviation\>\"", "]"}], "]"}], ",", " ", 
             RowBox[{"sci", "[", 
              RowBox[{"#", "[", "\"\<deviation\>\"", "]"}], "]"}], ",", 
             " ", "\"\<--\>\""}], "]"}], ",", "\n", "      ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"NumericQ", "[", 
              RowBox[{"#", "[", "\"\<tolerance\>\"", "]"}], "]"}], ",", " ", 
             RowBox[{"sci", "[", 
              RowBox[{"#", "[", "\"\<tolerance\>\"", "]"}], "]"}], ",", 
             " ", "\"\<--\>\""}], "]"}], ",", " ", 
           RowBox[{"#", "[", "\"\<rust\>\"", "]"}], ",", " ", 
           RowBox[{"#", "[", "\"\<python\>\"", "]"}]}], "}"}], " ", "&"}], ",",
         " ", "SFNB`Test`$Results"}], "]"}], ",", "\n", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"#", ",", " ", "Bold"}], "]"}], " ", "&"}], " ", "/@", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<check\>\"", ",", " ", "\"\<result\>\"", ",", 
         " ", "\"\<deviation\>\"", ",", " ", "\"\<tolerance\>\"", ",", 
         " ", "\"\<Rust\>\"", ",", " ", "\"\<Python\>\""}], "}"}]}]}], "]"}], 
    ",", "\n", "  ", 
    RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
    RowBox[{"Alignment", " ", "->", " ", "Left"}], ",", " ", 
    RowBox[{"BaseStyle", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"FontSize", " ", "->", " ", "9"}], "}"}]}]}], "]"}]}]], "Input",\

 CellLabel->
  "In[314]:=",ExpressionUUID->"05e9654b-3d85-4f88-94e0-4289f9f2a9a4"],

