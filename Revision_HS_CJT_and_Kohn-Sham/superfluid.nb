            " ", 
           RowBox[{
            RowBox[{"1", "/", "4"}], " ", 
            RowBox[{"pairEnergy", "[", 
             RowBox[{"{", 
              RowBox[{"\"\<boson B\>\"", ",", " ", "c"}], "}"}], "]"}]}]}], 
          "]"}], ",", "\n", "    ", 
         RowBox[{"{", 
          RowBox[{"c", ",", " ", 
           RowBox[{"Keys", "[", "channelStates", "]"}]}], "}"}]}], "]"}], 
       "]"}], ",", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "12"}]}], ",", " ", "\"\<P2-0d\>\"", ",", 
