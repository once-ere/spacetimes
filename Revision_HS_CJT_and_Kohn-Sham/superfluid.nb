      RowBox[{"(", 
       RowBox[{"logarithmic", " ", "scale"}], ")"}]}], ";", " ", 
     RowBox[{"one", " ", "panel", " ", "above", " ", "the", " ", "other"}]}], 
    ",", " ", 
    RowBox[{
    "so", " ", "that", " ", "both", " ", "fit", " ", "the", "\n", "   ", 
     "width", " ", "of", " ", "a", " ", "printed", " ", "page"}]}], " ", 
   "*)"}], "\n", 
