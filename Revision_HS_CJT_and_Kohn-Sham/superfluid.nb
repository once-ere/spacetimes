Cell[CellGroupData[{

Cell["I.5 The Lagrangian and the field equations (item 4)", "Section",ExpressionUUID->"943a17f8-b581-4d40-ba1b-1d857c181e8d"],

Cell[TextData[{
 "The Lagrangian density of the solution is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["\[ScriptCapitalL]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalL]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], "\[CapitalPsi]"], "+", 
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalL]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["self",
      FontSlant->"Plain"]], "+", 
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalL]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["YM",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "81a31daa-c935-4341-a180-f0ec1a2c66c1"],
 ", with the Dirac part ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalL]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], "\[CapitalPsi]"], "\[LongEqual]", 
    SubscriptBox[
     OverscriptBox["\[CapitalPsi]", "_"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["i", "TI"], "\[ThinSpace]", 
      UnderscriptBox["\[Sum]", 
       StyleBox["p", "TI"],
       LimitsPositioning->True], "\[ThinSpace]", 
      SubsuperscriptBox["\[Gamma]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["p", "TI"]], 
      SubsuperscriptBox["\[Del]", 
       StyleBox["p", "TI"], 
       StyleBox["GEE",
        FontSlant->"Plain"]], "-", 
      SubscriptBox[
       StyleBox["m", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}], 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fbbe8e00-adcb-4406-b2e4-43c2fe978fcc"],
 ", the Yang-Mills part ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalL]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["YM",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"-", 
     FractionBox["1", "4"]}], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", "\[Iota]",
     LimitsPositioning->True], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["W", "TI"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}], "\[Iota]"], 
    SubsuperscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{"\[Iota]", ",", 
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], "-", 
    FractionBox["1", "4"], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["B", "TI"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], 
    SubsuperscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ba69b3de-d6d1-4d37-a110-a942e6a33501"],
 ", and the self-interaction ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalL]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["self",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"-", 
     SubsuperscriptBox[
      StyleBox["V", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       StyleBox["n", "TI"], ")"}]]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "65cb7d26-3a21-4092-adde-35ea0ddf233f"],
 ", a normal-ordered GEE-invariant contact interaction. Its first two steps \
are"
}], "Text",ExpressionUUID->"2eecc015-daf1-48f0-b7e4-e0a996c7ab0d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "0", ")"}]], "\[LongEqual]", 
   FractionBox["1", "2"], 
   SubsuperscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["S",
     FontSlant->"Plain"]], ":", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       OverscriptBox["\[CapitalPsi]", "_"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      SubscriptBox["\[CapitalPsi]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}], "2"], ":", 
   RowBox[{"+", 
    FractionBox["1", "2"]}], 
   SubsuperscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["V",
     FontSlant->"Plain"]], "\[ThinSpace]", 
   UnderscriptBox["\[Sum]", 
    StyleBox["p", "TI"],
    LimitsPositioning->True], "\[ThinSpace]", 
   SubsuperscriptBox["\[Eta]", 
    StyleBox["pp", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], ":", 
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["j", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["F",
        FontSlant->"Plain"], ",", 
       StyleBox["p", "TI"]}]], ")"}], "2"], ":", ",", "      ", 
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "1", ")"}]], "\[LongEqual]", 
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "0", ")"}]], "-", 
   FractionBox["1", "4"], 
   SubscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], "\[ThinSpace]", 
   UnderscriptBox["\[Sum]", "\[Iota]",
    LimitsPositioning->True], ":", 
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox["\[CapitalPi]", 
      StyleBox["LL",
       FontSlant->"Plain"], "\[Iota]"], ")"}], "\[Dagger]"], 
   SubsuperscriptBox["\[CapitalPi]", 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Iota]"], ":", ","}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"47770fdd-c08e-4258-a735-0faa5d5e3b42"],

Cell[TextData[{
 "with the fermion-number current ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["j", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["F",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}]], "\[LongEqual]", 
    SubscriptBox[
     OverscriptBox["\[CapitalPsi]", "_"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p", "TI"]], 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d5f34cab-5df2-4618-81d3-66945bf266e7"],
 " and the pair operators ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalPi]", 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Iota]"], "\[LongEqual]", 
    SubsuperscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["T", "TI"]], 
    SubsuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Iota]"], 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fbfc332d-aafd-474a-9b3c-51a4ed53417e"],
 " of one point. ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "0", ")"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ace90500-c5be-4c89-b0ee-8bbfb58c7481"],
 " is formed after the author's Kohn-Sham ansatz, whose interaction energy \
density of uniform matter is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], 
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["V", "TI"]], 
    SuperscriptBox[
     StyleBox["n", "TI"], "2"], "+", 
    FractionBox["1", "2"], 
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["S", "TI"]], 
    SubsuperscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["S", "TI"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b49835dd-b852-4efa-a4c7-49d2e8478c0e"],
 "; ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "1", ")"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8b72f1ef-716c-4989-a561-d7607cb7a344"],
 " adds the attraction in the spin-zero pair channel. Varying the action with \
respect to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox["\[CapitalPsi]", "_"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a0a66c4a-f842-4e7e-b857-22d903f46d5c"],
 " gives the field equation of the spinor field,"
}], "Text",ExpressionUUID->"b75731fd-7ee4-4d1e-9d41-d32a9cb9e4d1"],

Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox["i", "TI"], "\[ThinSpace]", 
   UnderscriptBox["\[Sum]", 
    StyleBox["p", "TI"],
    LimitsPositioning->True], "\[ThinSpace]", 
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p", "TI"]], 
   SubsuperscriptBox["\[Del]", 
    StyleBox["p", "TI"], 
    StyleBox["GEE",
     FontSlant->"Plain"]], 
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], "-", 
   SubscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], "\[LongEqual]", 
   SubsuperscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["S",
     FontSlant->"Plain"]], 
   RowBox[{"(", 
    RowBox[{
     SubscriptBox[
      OverscriptBox["\[CapitalPsi]", "_"], 
      StyleBox["LL",
       FontSlant->"Plain"]], 
     SubscriptBox["\[CapitalPsi]", 
      StyleBox["LL",
       FontSlant->"Plain"]]}], ")"}], 
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], "+", 
   SubsuperscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["V",
     FontSlant->"Plain"]], "\[ThinSpace]", 
   UnderscriptBox["\[Sum]", 
    StyleBox["p", "TI"],
    LimitsPositioning->True], "\[ThinSpace]", 
   SubsuperscriptBox[
    StyleBox["j", "TI"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}], 
    StyleBox["F",
     FontSlant->"Plain"]], 
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p", "TI"]], 
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], "-", 
   FractionBox["1", "2"], 
   SubscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], "\[ThinSpace]", 
   UnderscriptBox["\[Sum]", "\[Iota]",
    LimitsPositioning->True], "\[ThinSpace]", 
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], "0"], 
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], "\[Iota]"], ")"}], "\[Dagger]"], 
   SubsuperscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"], "*"], "\[ThinSpace]", 
   SubsuperscriptBox["\[CapitalPi]", 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Iota]"], ","}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"fa1627a3-d75d-40a6-a317-2ec7d49b150c"],

Cell[TextData[{
 "and varying with respect to the gauge fields gives the Yang-Mills equations \
with the currents of the spinor field as sources, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["p", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubscriptBox["\[PartialD]", 
     StyleBox["p", "TI"]], 
    SubsuperscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{"\[Iota]", ",", 
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], "-", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      SuperscriptBox["\[Iota]", "\[Prime]"], 
      SuperscriptBox["\[Iota]", "\[Prime]\[Prime]"]}],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox["\[Epsilon]", 
     RowBox[{"\[Iota]", 
      SuperscriptBox["\[Iota]", "\[Prime]"], 
      SuperscriptBox["\[Iota]", "\[Prime]\[Prime]"]}], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", 
     StyleBox["p", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["W", "TI"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], 
     SuperscriptBox["\[Iota]", "\[Prime]"]], 
    SubsuperscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      SuperscriptBox["\[Iota]", "\[Prime]\[Prime]"], ",", 
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["j", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{"\[Iota]", ",", 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "94403088-1057-4370-a4b5-6d631903dd7b"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["p", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubscriptBox["\[PartialD]", 
     StyleBox["p", "TI"]], 
    SubsuperscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["j", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["F",
       FontSlant->"Plain"], ",", 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dca70c4c-bea8-43cb-80b2-c79b361e77b9"],
 "."
}], "Text",ExpressionUUID->"cbb6949e-976c-4e3c-a167-668180fc09ee"],

Cell[TextData[{
 "The right side of the field equation of the spinor field is the commutator \
of the field with the Hamiltonian of the contact terms. The next cell checks \
this exactly, as an identity of operators on the Fock space of the eight \
components of one point (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["2", "8"], "\[LongEqual]", "256"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c8fff3c7-0826-472f-bd53-46f22473be87"],
 " states), for each contact term: with the Hamiltonians ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["S",
      FontSlant->"Plain"]], "\[LongEqual]", 
    FractionBox["1", "2"], 
    SuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["S",
      FontSlant->"Plain"]], ":", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["\[CapitalPsi]", "\[Dagger]"], "\[Beta]", 
       "\[CapitalPsi]"}], ")"}], "2"], ":"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dac52149-2a6a-4325-9a28-46a7b6573df4"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["V",
      FontSlant->"Plain"]], "\[LongEqual]", 
    FractionBox["1", "2"], 
    SuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["V",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     RowBox[{":", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["\[CapitalPsi]", "\[Dagger]"], "\[CapitalPsi]"}], 
        ")"}], "2"], ":", 
      RowBox[{"-", 
       UnderscriptBox["\[Sum]", 
        StyleBox["j", "TI"],
        LimitsPositioning->True]}], ":", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["\[CapitalPsi]", "\[Dagger]"], 
         SuperscriptBox["\[Alpha]", 
          StyleBox["j", "TI"]], "\[CapitalPsi]"}], ")"}], "2"], ":"}], 
     ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6df9a5bc-c6f3-4491-bdf4-70abfa6ab877"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["P",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"-", 
     FractionBox["1", "4"]}], 
    StyleBox["G", "TI"], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", "\[Iota]",
     LimitsPositioning->True], "\[ThinSpace]", 
    SuperscriptBox["\[CapitalPi]", 
     RowBox[{"\[Iota]", "\[Dagger]"}]], 
    SuperscriptBox["\[CapitalPi]", "\[Iota]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "60930099-82a6-4901-bea5-48ea951887b7"],
 ", the commutators ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{
     SubscriptBox["\[CapitalPsi]", 
      StyleBox["e", "TI"]], ",", 
     StyleBox["H", "TI"]}], "]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5b6bea32-6974-4654-85f9-da13799fb911"],
 " equal ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["S",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     RowBox[{
      OverscriptBox["\[CapitalPsi]", "_"], "\[CapitalPsi]"}], ")"}], 
    SubscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["\[Gamma]", "0"], "\[CapitalPsi]"}], ")"}], 
     StyleBox["e", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9cd0b651-3735-46f7-ab67-abe433fef176"],
 ", the vector term, and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", "2"]}], 
    StyleBox["G", "TI"], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", "\[Iota]",
     LimitsPositioning->True], 
    SubscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        StyleBox["K",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        RowBox[{"\[Iota]", "\[Dagger]"}]], 
       SuperscriptBox["\[CapitalPsi]", "*"]}], ")"}], 
     StyleBox["e", "TI"]], 
    SuperscriptBox["\[CapitalPi]", "\[Iota]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9fb36176-00c5-4509-b006-2020b6811ecb"],
 ". The couplings of the test are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["S",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"-", "8"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c11fcd02-554f-4be5-b012-dc5526aec0bc"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["V",
      FontSlant->"Plain"]], "\[LongEqual]", "4", "/", "5"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ce1feff4-b9dc-4ff5-a216-00709c78a8da"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["G", "TI"], "\[LongEqual]", "45", "/", "2"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "adb0a3a0-0470-46df-b3ae-fa4499d5919c"],
 ", exact numbers, so every deviation must be exactly 0. The last check of \
the cell derives the Yang-Mills equations with a source symbolically, with \
the function ",
 StyleBox["EulerEquations",
  FontFamily->"Source Code Pro"],
 " of the package ",
 StyleBox["VariationalMethods",
  FontFamily->"Source Code Pro"],
 " of the Wolfram Language, and compares all twelve equations with the form \
above."
}], "Text",ExpressionUUID->"0f8bcc7a-a06e-4967-b63a-35d9341c877c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", "annihilation", " ", "operators", " ", "c_e", " ", 
     RowBox[{"(", 
      RowBox[{"e", " ", "=", " ", 
       RowBox[{
        RowBox[{"1", ".."}], "8"}]}], ")"}], " ", "of", " ", "the", " ", 
     "eight", " ", "components", " ", "and", " ", "their", " ", "adjoints"}], 
    ",", " ", 
    RowBox[{"256", " ", "x", " ", "256", " ", "sparse", " ", "matrices"}]}], 
   " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"cOps", " ", "=", " ", 
     RowBox[{"fockOps", "[", "8", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"cdOps", " ", "=", " ", 
     RowBox[{"ConjugateTranspose", " ", "/@", " ", "cOps"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"bilinear", "[", "a", "]"}], ":", " ", 
     RowBox[{"sum_ij", " ", "a_ij", " ", 
      RowBox[{"c_i", "^", "dag"}], " ", "c_j"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"bilinear", "[", "a_", "]"}], " ", ":=", " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"a", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", " ", "j"}], "]"}], "]"}], " ", "=!=", " ", 
          "0"}], ",", " ", 
         RowBox[{
          RowBox[{"a", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", " ", "j"}], "]"}], "]"}], " ", 
          RowBox[{
           RowBox[{"cdOps", "[", 
            RowBox[{"[", "i", "]"}], "]"}], " ", ".", " ", 
           RowBox[{"cOps", "[", 
            RowBox[{"[", "j", "]"}], "]"}]}]}], ",", " ", "0"}], "]"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "8"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "8"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"quartic", "[", 
      RowBox[{"a", ",", " ", "b"}], "]"}], ":", " ", 
     RowBox[{
      RowBox[{"the", " ", "normal"}], "-", 
      RowBox[{
      "ordered", " ", "product", " ", "sum_ijkl", " ", "a_ij", " ", "b_kl", " ", 
       RowBox[{"c_i", "^", "dag"}], " ", 
       RowBox[{"c_k", "^", "dag"}], " ", "c_l", " ", "c_j"}]}]}], " ", "*)"}],
    "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"quartic", "[", 
      RowBox[{"a_", ",", " ", "b_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"a", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", " ", "j"}], "]"}], "]"}], " ", "=!=", " ", 
           "0"}], " ", "&&", " ", 
          RowBox[{
           RowBox[{"b", "[", 
            RowBox[{"[", 
             RowBox[{"k", ",", " ", "l"}], "]"}], "]"}], " ", "=!=", " ", 
           "0"}]}], ",", " ", 
         RowBox[{
          RowBox[{"a", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", " ", "j"}], "]"}], "]"}], " ", 
          RowBox[{"b", "[", 
           RowBox[{"[", 
            RowBox[{"k", ",", " ", "l"}], "]"}], "]"}], " ", 
          RowBox[{
           RowBox[{"cdOps", "[", 
            RowBox[{"[", "i", "]"}], "]"}], " ", ".", " ", 
           RowBox[{"cdOps", "[", 
            RowBox[{"[", "k", "]"}], "]"}], " ", ".", " ", 
           RowBox[{"cOps", "[", 
            RowBox[{"[", "l", "]"}], "]"}], " ", ".", " ", 
           RowBox[{"cOps", "[", 
            RowBox[{"[", "j", "]"}], "]"}]}]}], ",", " ", "0"}], "]"}], ",", 
       "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "8"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "8"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", "8"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"l", ",", " ", "8"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"gScal", ",", " ", "gVec", ",", " ", 
     RowBox[{"gPair", ":", " ", 
      RowBox[{
      "the", " ", "exact", " ", "couplings", " ", "of", " ", "the", " ", 
       "test"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"gScal", ",", " ", "gVec", ",", " ", "gPair"}], "}"}], " ", "=",
      " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "8"}], ",", " ", 
       RowBox[{"4", "/", "5"}], ",", " ", 
       RowBox[{"45", "/", "2"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"beta8", " ", "=", " ", 
     RowBox[{"d8", "[", "betaLL", "]"}]}], ";", " ", 
    RowBox[{"alpha8", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"d8", "[", 
        RowBox[{"alphaLL", "[", "j", "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"hS", " ", "=", " ", 
     RowBox[{
      RowBox[{"gScal", "/", "2"}], " ", 
      RowBox[{"quartic", "[", 
       RowBox[{"beta8", ",", " ", "beta8"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"hV", " ", "=", " ", 
     RowBox[{
      RowBox[{"gVec", "/", "2"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"quartic", "[", 
         RowBox[{
          RowBox[{"IdentityMatrix", "[", "8", "]"}], ",", " ", 
          RowBox[{"IdentityMatrix", "[", "8", "]"}]}], "]"}], " ", "-", " ", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{"quartic", "[", 
           RowBox[{
            RowBox[{"alpha8", "[", 
             RowBox[{"[", "j", "]"}], "]"}], ",", " ", 
            RowBox[{"alpha8", "[", 
             RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}], ")"}]}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", "pair", " ", "operators", " ", 
      RowBox[{"Pi", "^", "iota"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{
      "sum_ij", " ", "K_ij", " ", "c_i", " ", "c_j", " ", "and", " ", "the", " ",
        "pairing", " ", "Hamiltonian"}], " ", "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"G", "/", "4"}], ")"}], " ", "sum", " ", 
       RowBox[{"Pi", "^", "dag"}], " ", "Pi"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"piOps", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"k", " ", "=", " ", 
           RowBox[{"kLL", "[", "iota", "]"}]}], "}"}], ",", " ", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"k", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", " ", "j"}], "]"}], "]"}], " ", "=!=", " ", 
              "0"}], ",", " ", 
             RowBox[{
              RowBox[{"k", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", " ", "j"}], "]"}], "]"}], " ", 
              RowBox[{
               RowBox[{"cOps", "[", 
                RowBox[{"[", "i", "]"}], "]"}], " ", ".", " ", 
               RowBox[{"cOps", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}]}], ",", " ", "0"}], "]"}], ",",
            " ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "8"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"j", ",", " ", "8"}], "}"}]}], "]"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"iota", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"hP", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "gPair"}], "/", "4"}], " ", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ConjugateTranspose", "[", 
          RowBox[{"piOps", "[", 
           RowBox[{"[", "k", "]"}], "]"}], "]"}], " ", ".", " ", 
         RowBox[{"piOps", "[", 
          RowBox[{"[", "k", "]"}], "]"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nBeta", " ", "=", " ", 
     RowBox[{"bilinear", "[", "beta8", "]"}]}], ";", " ", 
    RowBox[{"nOne", " ", "=", " ", 
     RowBox[{"bilinear", "[", 
      RowBox[{"IdentityMatrix", "[", "8", "]"}], "]"}]}], ";", " ", 
    RowBox[{"nAlpha", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"bilinear", "[", 
        RowBox[{"alpha8", "[", 
         RowBox[{"[", "j", "]"}], "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"lin", "[", "v", "]"}], " ", "=", " ", 
     RowBox[{"sum_b", " ", "v_b", " ", "c_b"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"lin", "[", "v_", "]"}], " ", ":=", " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"v", "[", 
         RowBox[{"[", "b", "]"}], "]"}], " ", 
        RowBox[{"cOps", "[", 
         RowBox[{"[", "b", "]"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"b", ",", " ", "8"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dE2", ",", " ", "dE3", ",", " ", "dE4"}], "}"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", "\n", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"dE2", " ", "=", " ", 
        RowBox[{"Max", "[", 
         RowBox[{"dE2", ",", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{"Normal", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"cOps", "[", 
                RowBox[{"[", "e", "]"}], "]"}], " ", ".", " ", "hS"}], " ", "-",
               " ", 
              RowBox[{"hS", " ", ".", " ", 
               RowBox[{"cOps", "[", 
                RowBox[{"[", "e", "]"}], "]"}]}], " ", "-", " ", 
              RowBox[{"gScal", " ", 
               RowBox[{"nBeta", " ", ".", " ", 
                RowBox[{"lin", "[", 
                 RowBox[{"beta8", "[", 
                  RowBox[{"[", "e", "]"}], "]"}], "]"}]}]}]}], "]"}], "]"}], 
           "]"}]}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"dE3", " ", "=", " ", 
        RowBox[{"Max", "[", 
         RowBox[{"dE3", ",", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{"Normal", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"cOps", "[", 
                RowBox[{"[", "e", "]"}], "]"}], " ", ".", " ", "hV"}], " ", "-",
               " ", 
              RowBox[{"hV", " ", ".", " ", 
               RowBox[{"cOps", "[", 
                RowBox[{"[", "e", "]"}], "]"}]}], " ", "-", " ", 
              RowBox[{"gVec", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"nOne", " ", ".", " ", 
                  RowBox[{"cOps", "[", 
                   RowBox[{"[", "e", "]"}], "]"}]}], " ", "-", " ", 
                 RowBox[{"Sum", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"nAlpha", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], " ", ".", " ", 
                    RowBox[{"lin", "[", 
                    RowBox[{"alpha8", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", ",", " ", "e"}], "]"}], "]"}], "]"}]}], ",", 
                   " ", 
                   RowBox[{"{", 
                    RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}], ")"}]}]}],
              "]"}], "]"}], "]"}]}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"dE4", " ", "=", " ", 
        RowBox[{"Max", "[", 
         RowBox[{"dE4", ",", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{"Normal", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"cOps", "[", 
                RowBox[{"[", "e", "]"}], "]"}], " ", ".", " ", "hP"}], " ", "-",
               " ", 
              RowBox[{"hP", " ", ".", " ", 
               RowBox[{"cOps", "[", 
                RowBox[{"[", "e", "]"}], "]"}]}], " ", "+", " ", 
              RowBox[{
               RowBox[{"gPair", "/", "2"}], " ", 
               RowBox[{"Sum", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Sum", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Conjugate", "[", 
                    RowBox[{
                    RowBox[{"kLL", "[", "k", "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"a", ",", " ", "e"}], "]"}], "]"}], "]"}], " ", 
                    RowBox[{"cdOps", "[", 
                    RowBox[{"[", "a", "]"}], "]"}]}], ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"a", ",", " ", "8"}], "}"}]}], "]"}], " ", ".", 
                  " ", 
                  RowBox[{"piOps", "[", 
                   RowBox[{"[", "k", "]"}], "]"}]}], ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}]}]}], "]"}], 
            "]"}], "]"}]}], "]"}]}]}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"e", ",", " ", "8"}], "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WE-2\>\"", ",", 
      " ", "\"\<scalar contact term: [Psi_e, H_S] = G^S (Psi-bar Psi)(gamma^0 \
Psi)_e (exact, 256 states)\>\"", ",", " ", "dE2", ",", " ", "0", ",", 
      " ", "\"\<E-2\>\"", ",", " ", "\"\<E-2\>\""}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WE-3\>\"", ",", 
      " ", "\"\<vector contact term (exact, 256 states)\>\"", ",", " ", "dE3",
       ",", " ", "0", ",", " ", "\"\<E-3\>\"", ",", " ", "\"\<E-3\>\""}], 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WE-4\>\"", ",", 
      " ", "\"\<pairing term: [Psi_e, H_P] = -(G/2) sum (K^dag Psi^*)_e Pi \
(exact, 256 states)\>\"", ",", " ", "dE4", ",", " ", "0", ",", 
      " ", "\"\<E-4\>\"", ",", " ", "\"\<E-4\>\""}], "]"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"E", "-", "14"}], ":", " ", 
       RowBox[{
        RowBox[{"the", " ", "Euler"}], "-", 
        RowBox[{"Lagrange", " ", "equations", " ", "of", " ", "L"}]}]}], " ", 
      "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{"1", "/", "4"}], ")"}]}], " ", 
        RowBox[{"W", "^", "a_pq"}], " ", 
        RowBox[{"W", "^", 
         RowBox[{"(", 
          RowBox[{"a", ",", "pq"}], ")"}]}]}], " ", "-", " ", 
       RowBox[{"g", " ", 
        RowBox[{"W", "^", "a_p"}], " ", 
        RowBox[{"j", "^", 
         RowBox[{"(", 
          RowBox[{"a", ",", "p"}], ")"}]}]}]}]}], ",", " ", 
     RowBox[{"derived", " ", "symbolically"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"Needs", "[", "\"\<VariationalMethods`\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Clear", "[", "gYM", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"etaD", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", 
       RowBox[{"-", "1"}], ",", " ", 
       RowBox[{"-", "1"}], ",", " ", 
       RowBox[{"-", "1"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"wF", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"ToExpression", "[", 
         RowBox[{"\"\<wf\>\"", " ", "<>", " ", 
          RowBox[{"ToString", "[", "a", "]"}], " ", "<>", " ", 
          RowBox[{"ToString", "[", "p", "]"}]}], "]"}], "[", 
        RowBox[{"x0", ",", " ", "x1", ",", " ", "x2", ",", " ", "x3"}], "]"}],
        ",", " ", 
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"jF", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"ToExpression", "[", 
         RowBox[{"\"\<jf\>\"", " ", "<>", " ", 
          RowBox[{"ToString", "[", "a", "]"}], " ", "<>", " ", 
          RowBox[{"ToString", "[", "p", "]"}]}], "]"}], "[", 
        RowBox[{"x0", ",", " ", "x1", ",", " ", "x2", ",", " ", "x3"}], "]"}],
        ",", " ", 
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"fYM", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"wF", "[", 
           RowBox[{"[", 
            RowBox[{"a", ",", " ", "q"}], "]"}], "]"}], ",", " ", 
          RowBox[{"xs", "[", 
           RowBox[{"[", "p", "]"}], "]"}]}], "]"}], " ", "-", " ", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"wF", "[", 
           RowBox[{"[", 
            RowBox[{"a", ",", " ", "p"}], "]"}], "]"}], ",", " ", 
          RowBox[{"xs", "[", 
           RowBox[{"[", "q", "]"}], "]"}]}], "]"}], " ", "-", " ", 
        RowBox[{"gYM", " ", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"levi", "[", 
             RowBox[{"a", ",", " ", "b", ",", " ", "c"}], "]"}], " ", 
            RowBox[{"wF", "[", 
             RowBox[{"[", 
              RowBox[{"b", ",", " ", "p"}], "]"}], "]"}], " ", 
            RowBox[{"wF", "[", 
             RowBox[{"[", 
              RowBox[{"c", ",", " ", "q"}], "]"}], "]"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"b", ",", " ", "3"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"c", ",", " ", "3"}], "}"}]}], "]"}]}]}], ",", "\n", 
       "   ", 
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"p", ",", " ", "4"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"q", ",", " ", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"lYM", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", "1"}], "/", "4"}], " ", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"etaD", "[", 
           RowBox[{"[", "p", "]"}], "]"}], " ", 
          RowBox[{"etaD", "[", 
           RowBox[{"[", "q", "]"}], "]"}], " ", 
          RowBox[{
           RowBox[{"fYM", "[", 
            RowBox[{"[", 
             RowBox[{"a", ",", " ", "p", ",", " ", "q"}], "]"}], "]"}], "^", 
           "2"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"a", ",", " ", "3"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"p", ",", " ", "4"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"q", ",", " ", "4"}], "}"}]}], "]"}]}], " ", "-", " ", 
      RowBox[{"gYM", " ", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"wF", "[", 
           RowBox[{"[", 
            RowBox[{"a", ",", " ", "p"}], "]"}], "]"}], " ", 
          RowBox[{"jF", "[", 
           RowBox[{"[", 
            RowBox[{"a", ",", " ", "p"}], "]"}], "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"a", ",", " ", "3"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"p", ",", " ", "4"}], "}"}]}], "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"eqsYM", " ", "=", " ", 
     RowBox[{"EulerEquations", "[", 
      RowBox[{"lYM", ",", " ", 
       RowBox[{"Flatten", "[", "wF", "]"}], ",", " ", "xs"}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"the", " ", "claimed", " ", 
     RowBox[{"form", ":", " ", 
      RowBox[{
       RowBox[{"sum_p", " ", "d_p", " ", 
        RowBox[{"F", "^", 
         RowBox[{"(", 
          RowBox[{"a", ",", 
           RowBox[{"p", " ", 
            RowBox[{"p", "'"}]}]}], ")"}]}]}], " ", "-", " ", 
       RowBox[{"g", " ", "sum", " ", "eps_abc", " ", 
        RowBox[{"W", "^", "b_p"}], " ", 
        RowBox[{"F", "^", 
         RowBox[{"(", 
          RowBox[{"c", ",", 
           RowBox[{"p", " ", 
            RowBox[{"p", "'"}]}]}], ")"}]}]}], " ", "-", " ", 
       RowBox[{"g", " ", 
        RowBox[{"J", "^", 
         RowBox[{"(", 
          RowBox[{"a", ",", 
           RowBox[{"p", "'"}]}], ")"}]}], " ", "must", " ", "equal", " ", 
        "lhs"}], " ", "-", " ", "rhs"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"fUp", "[", 
      RowBox[{"c_", ",", " ", "p_", ",", " ", "pp_"}], "]"}], " ", ":=", " ", 
     
     RowBox[{
      RowBox[{"etaD", "[", 
       RowBox[{"[", "p", "]"}], "]"}], " ", 
      RowBox[{"etaD", "[", 
       RowBox[{"[", "pp", "]"}], "]"}], " ", 
      RowBox[{"fYM", "[", 
       RowBox[{"[", 
        RowBox[{"c", ",", " ", "p", ",", " ", "pp"}], "]"}], "]"}]}]}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"claimedYM", " ", "=", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"fUp", "[", 
              RowBox[{"a", ",", " ", "p", ",", " ", "pp"}], "]"}], ",", " ", 
             RowBox[{"xs", "[", 
              RowBox[{"[", "p", "]"}], "]"}]}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"p", ",", " ", "4"}], "}"}]}], "]"}], " ", "-", " ", 
         RowBox[{"gYM", " ", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"levi", "[", 
              RowBox[{"a", ",", " ", "b", ",", " ", "c"}], "]"}], " ", 
             RowBox[{"wF", "[", 
              RowBox[{"[", 
               RowBox[{"b", ",", " ", "p"}], "]"}], "]"}], " ", 
             RowBox[{"fUp", "[", 
              RowBox[{"c", ",", " ", "p", ",", " ", "pp"}], "]"}]}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"b", ",", " ", "3"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"c", ",", " ", "3"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"p", ",", " ", "4"}], "}"}]}], "]"}]}], " ", "-", "\n", 
         "      ", 
         RowBox[{"gYM", " ", 
          RowBox[{"jF", "[", 
           RowBox[{"[", 
            RowBox[{"a", ",", " ", "pp"}], "]"}], "]"}]}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"a", ",", " ", "3"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"pp", ",", " ", "4"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
   
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
      "EulerEquations", " ", "writes", " ", "each", " ", "equation", " ", 
       "as", " ", "lhs"}], " ", "==", " ", "rhs"}], ";", " ", 
     RowBox[{"lhs", " ", "-", " ", 
      RowBox[{
      "rhs", " ", "is", " ", "compared", " ", "with", " ", "the", " ", 
       "claimed", " ", "form", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{
          "an", " ", "equation", " ", "is", " ", "the", " ", "same", "\n", 
           "   ", "equation", " ", "when", " ", "lhs"}], " ", "-", " ", 
          RowBox[{
          "rhs", " ", "equals", " ", "the", " ", "claimed", " ", "form", " ", 
           "or", " ", "its", " ", "negative"}]}], ";", " ", 
         RowBox[{
         "the", " ", "sign", " ", "that", " ", "occurred", " ", "is", " ", 
          "reported"}]}], ")"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"lhsYM", " ", "=", " ", 
     RowBox[{
      RowBox[{"eqsYM", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], " ", "-", " ", 
      RowBox[{"eqsYM", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"signYM", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Which", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Expand", "[", 
           RowBox[{
            RowBox[{"lhsYM", "[", 
             RowBox[{"[", "k", "]"}], "]"}], " ", "-", " ", 
            RowBox[{"claimedYM", "[", 
             RowBox[{"[", "k", "]"}], "]"}]}], "]"}], " ", "===", " ", "0"}], 
         ",", " ", "1", ",", " ", 
         RowBox[{
          RowBox[{"Expand", "[", 
           RowBox[{
            RowBox[{"lhsYM", "[", 
             RowBox[{"[", "k", "]"}], "]"}], " ", "+", " ", 
            RowBox[{"claimedYM", "[", 
             RowBox[{"[", "k", "]"}], "]"}]}], "]"}], " ", "===", " ", "0"}], 
         ",", " ", 
         RowBox[{"-", "1"}], ",", " ", "True", ",", " ", "0"}], "]"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", 
         RowBox[{"Length", "[", "lhsYM", "]"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"checkTrue", "[", 
     RowBox[{"\"\<WE-14\>\"", ",", 
      " ", "\"\<symbolic Euler-Lagrange equations of the Yang-Mills \
Lagrangian with the source: d_p W^(a,p p') - g eps_abc W^b_p W^(c,p p') = g \
j^(a,p') (12 components)\>\"", ",", "\n", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "eqsYM", "]"}], " ", "==", " ", "12"}], " ", "&&",
        " ", 
       RowBox[{"FreeQ", "[", 
        RowBox[{"signYM", ",", " ", "0"}], "]"}]}], ",", " ", 
      RowBox[{
       RowBox[{"ToString", "[", 
        RowBox[{"Count", "[", 
         RowBox[{"signYM", ",", " ", 
          RowBox[{"Except", "[", "0", "]"}]}], "]"}], "]"}], " ", "<>", 
       " ", "\"\< of 12 equations identical (EulerEquations; signs \>\"", " ",
        "<>", " ", 
       RowBox[{"ToString", "[", "signYM", "]"}], " ", "<>", 
       " ", "\"\<)\>\""}], ",", "\n", "  ", "\"\<E-14\>\"", ",", 
      " ", "\"\<E-14\>\""}], "]"}], ";"}]}]}]], "Input",
