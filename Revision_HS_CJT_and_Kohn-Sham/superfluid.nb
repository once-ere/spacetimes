Cell[TextData[{
 "The next cell prints the numbers in the form of a table (in per cent where \
marked): what the polynomial gets wrong at its own minimum (the position, the \
depth, the curvature and the resulting mass of the amplitude mode), the \
largest residuals of the fits with more or fewer powers, the sign changes, \
and the coefficient ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "064b3c12-eab5-49c9-8d90-635dd49a7339"],
 " fitted on the three intervals. The figure after it shows the residuals \
(top) and the decrease of the largest residual with the number of powers \
(bottom)."
}], "Text",ExpressionUUID->"6f0e5dea-b917-4fed-8432-47afe40721ae"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "the", " ", "table", " ", "of", " ", "the", " ", "accuracy", " ", "of", " ",
      "the", " ", "Landau", " ", "form"}], ";", " ", 
    RowBox[{
     RowBox[{"pct", "[", "x", "]"}], ":", " ", 
     RowBox[{
     "x", " ", "in", " ", "per", " ", "cent", " ", "with", " ", "three", " ", 
      "significant", " ", "digits"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"pct", "[", "x_", "]"}], " ", ":=", " ", 
     RowBox[{"NumberForm", "[", 
      RowBox[{
       RowBox[{"100.", " ", "x"}], ",", " ", "3"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"lfRows", " ", "=", " ", 
     RowBox[{"{", "\n", "   ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<minimum of the polynomial: Phi_L/Phi0 - 1 (per cent)\>\"",
          ",", " ", 
         RowBox[{
          RowBox[{"pct", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"lfResults", "[", "#", "]"}], "[", "\"\<phifit\>\"", 
              "]"}], "/", 
             RowBox[{"lfPhi0", "[", "#", "]"}]}], " ", "-", " ", "1"}], "]"}],
           " ", "&"}]}], "}"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<depth of the polynomial / depth - 1 (per cent)\>\"", ",",
          " ", 
