Cell[CellGroupData[{

Cell["\<\
II.1 The pair channels and the gauge bosons that mediate the pairing\
\>", "Section",ExpressionUUID->"222e5f9f-4720-49cc-91bc-b6a11919ceb2"],

Cell[TextData[{
 "The spin-zero pairs are the six antisymmetric unitary matrices ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9e30a427-ab12-4a2e-9c99-d3d383ce27b9"],
 " (scalar, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["0", "+"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0f7b4f46-b826-47cf-ab48-65d576d86bc5"],
 ") and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     RowBox[{"\[Prime]", "\[Iota]"}]], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[CircleTimes]", 
    SubscriptBox[
     StyleBox["E",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Tau]", "\[Iota]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "887cb2fc-d0c7-41be-b1ed-9cefd5325a6b"],
 " (pseudoscalar, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["0", "-"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1d083faf-2400-4763-9f8b-5714b92d2ea1"],
 "). The state of two spinor charges at one point in the channel ",
 Cell[BoxData[
  FormBox[
   StyleBox["K",
    FontFamily->"Helvetica",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "71a51aba-141a-4ab2-9984-f153e5a8a5c6"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftBracketingBar]", 
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "\[RightAngleBracket]", "\[Proportional]", 
    FractionBox["1", "2"], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["c", "TI"], 
      SuperscriptBox[
       StyleBox["c", "TI"], "\[Prime]"]}],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["c", "TI"], 
      SuperscriptBox[
       StyleBox["c", "TI"], "\[Prime]"]}], "*"], 
    SubsuperscriptBox["\[CapitalPsi]", 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["c", "TI"]}], "\[Dagger]"], 
    SubsuperscriptBox["\[CapitalPsi]", 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      SuperscriptBox[
       StyleBox["c", "TI"], "\[Prime]"]}], "\[Dagger]"], "\[LeftBracketingBar]",
     "0", "\[RightAngleBracket]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "17b3a979-3d4b-4551-ad1e-ee462c072799"],
 ", normalized, and the pair energy of a contact operator ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[ScriptCapitalO]",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6256d2c0-7a85-4f07-bc2b-d9406e519fb2"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["pair",
      FontSlant->"Plain"]], 
    RowBox[{"[", 
     RowBox[{
      StyleBox["\[ScriptCapitalO]",
       FontSlant->"Plain"], ";", 
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"]}], "]"}], "\[LongEqual]", 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "\[RightBracketingBar]", 
      StyleBox["\[ScriptCapitalO]",
       FontSlant->"Plain"], "\[LeftBracketingBar]", 
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"]}], "\[RightAngleBracket]"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f12e8f55-ee22-4b3c-883e-c58962f854e3"],
 ", per unit coupling; negative means attraction. The operators are the three \
terms of the potentials and the contact limit of the exchange of the four \
gauge bosons of GEE, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", 
     StyleBox["p", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox["\[Eta]", 
     StyleBox["pp", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], ":", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["\[CapitalPsi]", "\[Dagger]"], 
       SubsuperscriptBox[
        StyleBox["A",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["SF",
          FontSlant->"Plain"], ",", 
         StyleBox["p", "TI"]}], 
        StyleBox["b",
         FontSlant->"Plain"]], "\[CapitalPsi]"}], ")"}], "2"], ":"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9dd38e2c-c830-4eaf-bbc5-0f5a5d28084a"],
 " with the vertex matrices ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["A",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], 
     StyleBox["b",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["\[Gamma]", 
       StyleBox["LL",
        FontSlant->"Plain"], "0"], 
      SubsuperscriptBox["\[Gamma]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["p", "TI"]]}], ")"}], "\[CircleTimes]", 
    SubsuperscriptBox[
     StyleBox["t",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["b",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "408b7208-22dc-4e48-9315-92674bafc204"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["t",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["b",
      FontSlant->"Plain"]], "\[LongEqual]", 
    FractionBox["1", "2"], 
    SubsuperscriptBox["\[Tau]", "\[Iota]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0688c128-a7d3-4691-b04e-15390f801f2c"],
 " for ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "77c908c2-e3fa-43bb-a02a-c512c65b5fe5"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["1",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c35846d7-34ad-4ca6-b9e1-a9645b941a61"],
 " for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ea7a8634-938c-4ab2-9376-1611e26b93dd"],
 "). The result: the scalar term has ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "47f12dbc-2469-421c-9b0a-8641bde7025e"],
 " in the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["0", "+"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8ee5fbeb-fca1-484b-9459-40d98dd8437f"],
 " channels and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "32c3f67a-b17c-44fe-84e1-fd7e289c215d"],
 " in the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["0", "-"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "761fa9ac-048e-4d53-a517-2f4fc3ba08f3"],
 " channels, the vector term ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", "4"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bc6efd91-49f7-45a3-913a-37ed8f0f6a8f"],
 " everywhere, the pairing term ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "4"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2668f8b3-55c5-4163-9a8a-ff1a558fdbd2"],
 " in the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["0", "+"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4df26623-0940-469c-815b-9efdd0cc446a"],
 " channels, each ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "865673dc-b008-4cd7-a54e-d39f4a48f037"],
 " attracts (",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8bce0575-0155-40db-888e-1a503a9b2c0d"],
 ") in the two channels with the same index and repels (",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "101b39e9-da54-46ae-a13a-93764bc18d49"],
 ") in the other four, and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0e7808c4-7f76-47bc-b690-820c1f6a6995"],
 " repels (",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", "4"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1d58fb57-3433-4f00-b267-09e135e07ff9"],
 ") everywhere. In every channel"
}], "Text",ExpressionUUID->"c8618544-6b6d-4451-9396-3048aae58c9d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   UnderoverscriptBox["\[Sum]", 
    RowBox[{"\[Iota]", "\[LongEqual]", "1"}], "3",
    LimitsPositioning->True], "\[ThinSpace]", 
   SubsuperscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["pair",
     FontSlant->"Plain"]], 
   RowBox[{"[", 
    RowBox[{
     SuperscriptBox[
      StyleBox["W", "TI"], "\[Iota]"], ";", 
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"]}], "]"}], "\[LongEqual]", 
   FractionBox["1", "4"], 
   SubsuperscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["pair",
     FontSlant->"Plain"]], 
   RowBox[{"[", 
    RowBox[{
     StyleBox["B", "TI"], ";", 
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"]}], "]"}], "\[LongEqual]", 
   RowBox[{"+", "1"}], ","}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"45939583-88b6-4ba5-8404-1b9e8aefecd1"],

Cell[TextData[{
 "the isospin Casimir of a triplet pair (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["T", "TI"], "\[RightVector]"], "1"], "\[CenterDot]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["T", "TI"], "\[RightVector]"], "2"], "\[LongEqual]", 
    RowBox[{"+", 
     FractionBox["1", "4"]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6f155d1e-321b-4e1b-ba41-163a8dbe336b"],
 "): no gauge boson attracts a spin-zero pair in the symmetric vacuum. After \
the breaking of the symmetry in the channel ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8aeea017-2826-48de-ad0f-78a5fe5dd794"],
 ", the gauge field ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5d6d8c40-8216-444b-bdcd-f6989d4e66c7"],
 " of the unbroken generator stays massless (the photon of the superfluid) \
and attracts the two charges of the condensed pair, which carry the opposite \
charges ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["T", "TI"], "3"], "\[LongEqual]", 
    RowBox[{"\[PlusMinus]", 
     FractionBox["1", "2"]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d8087715-c643-470c-bbb4-5b85a66dc649"],
 ". The next cell computes the 42 pair energies exactly on the 256 states of \
one point (with the operators of Section I.5) and compares them with the \
table of the Rust program."
}], "Text",ExpressionUUID->"fffb005c-f32d-47d8-94d2-506ea1a7ff11"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"kPs", "[", "iota", "]"}], ":", " ", 
     RowBox[{"the", " ", "matrices", " ", 
      RowBox[{
       RowBox[{"K", "'"}], "^", "iota_LL"}]}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{"C_LL", " ", 
      RowBox[{"(", "x", ")"}], " ", "E_LL", " ", "tau_iota", " ", "of", " ", 
      "the", " ", "pseudoscalar", " ", "spin"}], "-", 
     RowBox[{"zero", " ", "pairs"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"kPs", "[", "iota_Integer", "]"}], " ", ":=", " ", 
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{"cLL", ",", " ", 
       RowBox[{"eLL", " ", ".", " ", 
        RowBox[{"sig", "[", 
         RowBox[{"[", 
          RowBox[{"iota", " ", "+", " ", "1"}], "]"}], "]"}]}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"pairState", "[", "k", "]"}], ":", " ", 
      RowBox[{
      "the", " ", "normalized", " ", "state", " ", "of", " ", "two", " ", 
       "charges", " ", "at", " ", "one", " ", "point", " ", "in", " ", "the", 
       " ", "channel", " ", "k"}], ":", " ", 
      RowBox[{
       RowBox[{"sum_ab", " ", "conj", 
        RowBox[{"(", "k_ab", ")"}], " ", 
        RowBox[{"c_a", "^", "dag"}], " ", 
        RowBox[{"c_b", "^", "dag"}]}], " ", "|", 
       RowBox[{"0", ">"}]}]}], ";", "\n", "   ", 
     RowBox[{
      RowBox[{"the", " ", "empty", " ", "state"}], " ", "|", 
      RowBox[{"0", ">", " ", 
       RowBox[{
       "is", " ", "the", " ", "first", " ", "basis", " ", "state"}]}]}]}], 
    " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"pairState", "[", "k_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"op", ",", " ", "w"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"op", " ", "=", " ", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"k", "[", 
               RowBox[{"[", 
                RowBox[{"a", ",", " ", "b"}], "]"}], "]"}], " ", "=!=", " ", 
              "0"}], ",", " ", 
             RowBox[{
              RowBox[{"Conjugate", "[", 
               RowBox[{"k", "[", 
                RowBox[{"[", 
                 RowBox[{"a", ",", " ", "b"}], "]"}], "]"}], "]"}], " ", 
              RowBox[{
               RowBox[{"cdOps", "[", 
                RowBox[{"[", "a", "]"}], "]"}], " ", ".", " ", 
               RowBox[{"cdOps", "[", 
                RowBox[{"[", "b", "]"}], "]"}]}]}], ",", " ", "0"}], "]"}], ",",
            " ", 
           RowBox[{"{", 
            RowBox[{"a", ",", " ", "8"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"b", ",", " ", "8"}], "}"}]}], "]"}]}], ";", "\n", "   ", 
        
        RowBox[{"w", " ", "=", " ", 
         RowBox[{"op", " ", ".", " ", 
          RowBox[{"UnitVector", "[", 
           RowBox[{"256", ",", " ", "1"}], "]"}]}]}], ";", "\n", "   ", 
        RowBox[{"w", "/", 
         RowBox[{"Norm", "[", "w", "]"}]}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"the", " ", "seven", " ", "contact", " ", 
     RowBox[{"operators", ":", " ", 
      RowBox[{
      "the", " ", "three", " ", "terms", " ", "of", " ", "the", " ", 
       "potentials", " ", "and", " ", "the", " ", "contact", " ", "limit", " ",
        "of", " ", "the", " ", "four", " ", "gauge", " ", "bosons"}]}]}], " ",
     "*)"}], "\n", 
   RowBox[{
    RowBox[{"channelOps", " ", "=", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<scalar\>\"", " ", "->", " ", 
        RowBox[{
         RowBox[{"1", "/", "2"}], " ", 
         RowBox[{"quartic", "[", 
          RowBox[{"beta8", ",", " ", "beta8"}], "]"}]}]}], ",", "\n", "   ", 
       RowBox[{"\"\<vector\>\"", " ", "->", " ", 
        RowBox[{
         RowBox[{"1", "/", "2"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"quartic", "[", 
            RowBox[{
             RowBox[{"IdentityMatrix", "[", "8", "]"}], ",", " ", 
             RowBox[{"IdentityMatrix", "[", "8", "]"}]}], "]"}], " ", "-", 
           " ", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{"quartic", "[", 
              RowBox[{
               RowBox[{"alpha8", "[", 
                RowBox[{"[", "j", "]"}], "]"}], ",", " ", 
               RowBox[{"alpha8", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}], ")"}]}]}], ",", 
       "\n", "   ", 
       RowBox[{"\"\<pairing\>\"", " ", "->", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "1"}], "/", "4"}], " ", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ConjugateTranspose", "[", 
             RowBox[{"piOps", "[", 
              RowBox[{"[", "k", "]"}], "]"}], "]"}], " ", ".", " ", 
            RowBox[{"piOps", "[", 
             RowBox[{"[", "k", "]"}], "]"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}]}]}]}], "|>"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"t", " ", "=", " ", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"sig", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "/", "2"}], ",", " ", 
              RowBox[{
               RowBox[{"sig", "[", 
                RowBox[{"[", "3", "]"}], "]"}], "/", "2"}], ",", " ", 
              RowBox[{
               RowBox[{"sig", "[", 
                RowBox[{"[", "4", "]"}], "]"}], "/", "2"}], ",", " ", 
              RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "}"}], "[", 
            RowBox[{"[", "b", "]"}], "]"}]}], ",", " ", 
          RowBox[{"name", " ", "=", " ", 
           RowBox[{
            RowBox[{"{", 
             
             RowBox[{"\"\<boson W1\>\"", ",", " ", "\"\<boson W2\>\"", ",", 
              " ", "\"\<boson W3\>\"", ",", " ", "\"\<boson B\>\""}], "}"}], "[", 
            RowBox[{"[", "b", "]"}], "]"}]}]}], "}"}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{"channelOps", "[", "name", "]"}], " ", "=", " ", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"1", "/", "2"}], " ", 
            RowBox[{"etaLL", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"p", " ", "+", " ", "1"}], ",", " ", 
               RowBox[{"p", " ", "+", " ", "1"}]}], "]"}], "]"}], " ", 
            RowBox[{"quartic", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"d8", "[", 
                RowBox[{
                 RowBox[{"gam", "[", "0", "]"}], " ", ".", " ", 
                 RowBox[{"gam", "[", "p", "]"}]}], "]"}], " ", ".", " ", 
               RowBox[{"i8", "[", "t", "]"}]}], ",", " ", 
              RowBox[{
               RowBox[{"d8", "[", 
                RowBox[{
                 RowBox[{"gam", "[", "0", "]"}], " ", ".", " ", 
                 RowBox[{"gam", "[", "p", "]"}]}], "]"}], " ", ".", " ", 
               RowBox[{"i8", "[", "t", "]"}]}]}], "]"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}]}], 
       "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"b", ",", " ", "4"}], "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "the", " ", "six", " ", "channels", " ", "and", " ", "their", " ", 
     "states"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"channelMats", " ", "=", " ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"\"\<K^\>\"", " ", "<>", " ", 
           RowBox[{"ToString", "[", "i", "]"}]}], " ", "->", " ", 
          RowBox[{"kLL", "[", "i", "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"\"\<K'^\>\"", " ", "<>", " ", 
           RowBox[{"ToString", "[", "i", "]"}]}], " ", "->", " ", 
          RowBox[{"kPs", "[", "i", "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "3"}], "}"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"channelStates", " ", "=", " ", 
     RowBox[{"Association", "[", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", "->", " ", 
          RowBox[{"pairState", "[", 
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}]}], " ", "&"}], ",", " ", 
        "channelMats"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"pairEnergy", " ", "=", " ", 
     RowBox[{"Association", "[", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"o", ",", " ", "c"}], "}"}], " ", "->", " ", 
          RowBox[{"Re", "[", 
           RowBox[{
            RowBox[{"Conjugate", "[", 
             RowBox[{"channelStates", "[", "c", "]"}], "]"}], " ", ".", " ", 
            RowBox[{"channelOps", "[", "o", "]"}], " ", ".", " ", 
            RowBox[{"channelStates", "[", "c", "]"}]}], "]"}]}], ",", "\n", 
         "     ", 
         RowBox[{"{", 
          RowBox[{"o", ",", " ", 
           RowBox[{"Keys", "[", "channelOps", "]"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"c", ",", " ", 
           RowBox[{"Keys", "[", "channelStates", "]"}]}], "}"}]}], "]"}], 
       "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"the", " ", "table", " ", "of", " ", "the", " ", "Rust", " ", 
     RowBox[{"program", ":", " ", 
      RowBox[{"the", " ", "operator", " ", "name", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"first", " ", "word"}], ",", " ", 
         RowBox[{
          RowBox[{"or", " ", "\"\<boson W1\>\""}], " ", "..."}]}], ")"}], " ",
        "and", " ", "the", " ", "channel", " ", 
       RowBox[{"(", 
        RowBox[{"first", " ", "token"}], ")"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"rustPairEnergy", " ", "=", " ", 
     RowBox[{"Association", "[", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"StringStartsQ", "[", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", " ", "\"\<boson\>\""}], 
               "]"}], ",", " ", 
              RowBox[{"StringRiffle", "[", 
               RowBox[{"Take", "[", 
                RowBox[{
                 RowBox[{"StringSplit", "[", 
                  RowBox[{"#", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", " ", "2"}], 
                "]"}], "]"}], ",", " ", 
              RowBox[{"First", "[", 
               RowBox[{"StringSplit", "[", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}]}], "]"}], ",", 
            "\n", "       ", 
            RowBox[{"First", "[", 
             RowBox[{"StringSplit", "[", 
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}]}], "}"}], " ", "->",
           " ", 
          RowBox[{"#", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], " ", "&"}], ",", " ", 
        "rustPairChannels"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WP2-0a\>\"", ",", 
      " ", "\"\<pair-channel energies of 7 operators in 6 channels (exact \
algebra of one point) = the table of the Rust program\>\"", ",", "\n", "  ", 
      RowBox[{"Max", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"pairEnergy", "[", "k", "]"}], " ", "-", " ", 
           RowBox[{"rustPairEnergy", "[", "k", "]"}]}], "]"}], ",", " ", 
         RowBox[{"{", 
