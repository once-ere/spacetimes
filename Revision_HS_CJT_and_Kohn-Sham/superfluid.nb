Cell[CellGroupData[{

Cell["II.5 The gauge bosons in the superfluid", "Section",ExpressionUUID->"9b23eedd-f720-4b36-8ca1-952eb448e5c6"],

Cell[TextData[{
 StyleBox["The masses from the susceptibilities.",
  FontWeight->"Bold"],
 " A constant gauge field ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["A", "TI"], "0", 
    StyleBox["a", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "88bedb11-f1c0-4504-a227-64311dc93beb"],
 " along the generator ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["Q",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["a", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "91c1ffa0-b560-4cfd-b5ce-c0d2d9e89d87"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], "\[LongEqual]", "1", ",", "2", ",", "3"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5f7d3b18-02fb-4dfb-a4bc-16762db9280b"],
 ": ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "353942f9-c767-4ba1-ba37-845cfef33e94"],
 "; ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], "\[LongEqual]", "4"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c1b95d35-6794-47ab-b280-f899f2d451f4"],
 ": the fermion number ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["1",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "8"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "86fbc10a-8e01-4a98-b941-9bcb03c400d7"],
 ") enters like a chemical potential ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Mu]", 
    StyleBox["a", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "00189937-65af-435c-b0be-c4e9d8daad34"],
 " of that charge. The static susceptibility ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Chi]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["ab", "TI"]], "\[LongEqual]", "\[PartialD]", 
    RowBox[{"\[LeftAngleBracket]", 
     SubscriptBox[
      StyleBox["Q",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["a", "TI"]], "\[RightAngleBracket]"}], "/", "\[PartialD]", 
    SuperscriptBox["\[Mu]", 
     StyleBox["b", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "452dd3a8-d760-4199-afc0-085dc9c4f936"],
 " of the superfluid gives the mass matrix of the gauge bosons, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"(", 
      SuperscriptBox[
       StyleBox["M", "TI"], "2"], ")"}], 
     StyleBox["ab", "TI"]], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["a", "TI"]], 
    SubscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["b", "TI"]], 
    SubsuperscriptBox["\[Chi]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["ab", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "61790f1b-330f-4fe2-9374-1f0997f2cefc"],
 " (the Higgs mechanism of the condensate), with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["a", "TI"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "da62da63-fb62-4297-a5f2-06e3bd891e55"],
 " for the three ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e5aaa2b3-de1c-43d8-9777-05c3e14315d2"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["F",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "291b163e-902b-40ed-8cb5-b5fd56fd2a0c"],
 " for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3867390a-47e9-4249-b32d-bfff6709d8f7"],
 ". The next cell computes ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Chi]", 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["ab", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6608d0f4-b63a-4777-9708-1af6c42f5395"],
 " by central differences of the self-consistent states with the external \
self-energies ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[MinusPlus]", 
     StyleBox["h", "TI"]}], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["Q",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["b", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f32e952e-72c0-47aa-ac66-8fac5e326073"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["h", "TI"], "\[LongEqual]", "2", "\[Times]", 
    SuperscriptBox["10", 
     RowBox[{"-", "3"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cfc2d81d-67a6-455f-bb8e-fed4e87a026b"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    StyleBox["h", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "861149b7-9728-429a-905f-3364d695a43b"],
 ", and the Richardson extrapolation. The generator ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9a51afa7-7f5c-4b87-af1c-edd0b37d467b"],
 " leaves the condensate in the channel ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6a21a05f-6362-4f18-a88d-269ebe784549"],
 " unchanged, so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Chi]", 
     StyleBox["SF",
      FontSlant->"Plain"], "33"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "eef6a7a6-794b-45bd-8c3a-1bce3c907f3f"],
 ": ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b2feb93b-75ed-4b88-9278-fe77f4eac20c"],
 " stays massless (the photon of the superfluid), and there is no mixing."
}], "Text",ExpressionUUID->"2a2e8067-4c39-4b57-935a-2f07dec46091"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", "four", " ", 
     RowBox[{"charges", ":", " ", 
      RowBox[{"T", "^", "1"}]}]}], ",", " ", 
    RowBox[{"T", "^", "2"}], ",", " ", 
    RowBox[{
     RowBox[{"T", "^", "3"}], " ", 
     RowBox[{"(", 
      RowBox[{"1", "_", "4", " ", 
       RowBox[{"(", "x", ")"}], " ", 
       RowBox[{"tau", "/", "2"}]}], ")"}], " ", "and", " ", "the", " ", 
     "fermion", " ", "number", " ", "1", "_", "8"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"chargesSF", " ", "=", " ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"N", "[", 
          RowBox[{"i8", "[", 
           RowBox[{
            RowBox[{"sig", "[", 
             RowBox[{"[", 
              RowBox[{"k", " ", "+", " ", "1"}], "]"}], "]"}], "/", "2"}], 
           "]"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"{", "id8", "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"susceptibilitySF", "[", 
      RowBox[{"mo", ",", " ", "s"}], "]"}], ":", " ", 
     RowBox[{
     "the", " ", "4", " ", "x", " ", "4", " ", "static", " ", 
      "susceptibilities", " ", "by", " ", "central", " ", "differences", " ", 
      "and", " ", "Richardson"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"susceptibilitySF", "[", 
      RowBox[{"mo_", ",", " ", "s_", ",", " ", 
       RowBox[{"h_", " ", ":", " ", 
        RowBox[{"2.", " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "3"}]}]}]}]}], "]"}], " ", ":=", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", "dn", "}"}], ",", "\n", "     ", 
          RowBox[{
           RowBox[{"dn", " ", "=", " ", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"Module", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"r", " ", "=", " ", 
                  RowBox[{"Table", "[", 
                   RowBox[{
                    RowBox[{"Module", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"ext", " ", "=", " ", 
                    RowBox[{
                    RowBox[{"-", "sg"}], " ", "step", " ", 
                    RowBox[{"chargesSF", "[", 
                    RowBox[{"[", "bb", "]"}], "]"}]}]}], "}"}], ",", "\n", 
                    "            ", 
                    RowBox[{
                    RowBox[{"solveSF", "[", 
                    RowBox[{"mo", ",", " ", 
                    RowBox[{
                    RowBox[{"s", "[", "\"\<n\>\"", "]"}], " ", "+", " ", 
                    "ext"}], ",", " ", 
                    RowBox[{"s", "[", "\"\<p\>\"", "]"}], ",", " ", "0.6", ",",
                     " ", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", "14"}]}], ",", " ", "40000", ",", " ", 
                    "ext"}], "]"}], "[", "\"\<rho\>\"", "]"}]}], "]"}], ",", 
                    " ", 
                    RowBox[{"{", 
                    RowBox[{"sg", ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"1", ",", " ", 
                    RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], "]"}]}], "}"}], ",",
                 "\n", "        ", 
                RowBox[{"Table", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Re", "[", 
                    RowBox[{
                    RowBox[{"Tr", "[", 
                    RowBox[{
                    RowBox[{"chargesSF", "[", 
                    RowBox[{"[", "a", "]"}], "]"}], " ", ".", " ", 
                    RowBox[{"r", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "]"}], " ", "-", " ", 
                    RowBox[{"Tr", "[", 
                    RowBox[{
                    RowBox[{"chargesSF", "[", 
                    RowBox[{"[", "a", "]"}], "]"}], " ", ".", " ", 
                    RowBox[{"r", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], "]"}], "/", 
                   RowBox[{"(", 
                    RowBox[{"2", " ", "step"}], ")"}]}], ",", " ", 
                  RowBox[{"{", 
                   RowBox[{"a", ",", " ", "4"}], "}"}]}], "]"}]}], "]"}], ",",
               " ", 
              RowBox[{"{", 
               RowBox[{"step", ",", " ", 
                RowBox[{"{", 
                 RowBox[{"h", ",", " ", 
                  RowBox[{"2", " ", "h"}]}], "}"}]}], "}"}]}], "]"}]}], ";", 
           "\n", "     ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"4", " ", 
               RowBox[{"dn", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], " ", "-", " ", 
              RowBox[{"dn", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "/", "3"}]}]}], "]"}],
         ",", " ", 
        RowBox[{"{", 
         RowBox[{"bb", ",", " ", "4"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
   
   RowBox[{
    RowBox[{"chiRows", " ", "=", " ", 
     RowBox[{"{", "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"key", " ", "=", " ", 
           RowBox[{"shortName", "[", "m", "]"}]}], ",", " ", "mo", ",", " ", 
          "s", ",", " ", "chi", ",", " ", "off"}], "}"}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"mo", ",", " ", "s"}], "}"}], " ", "=", " ", 
          RowBox[{"groundSF", "[", 
           RowBox[{"\"\<V2_\>\"", " ", "<>", " ", "key"}], "]"}]}], ";", "\n",
          "   ", 
         RowBox[{"chi", " ", "=", " ", 
          RowBox[{"susceptibilitySF", "[", 
           RowBox[{"mo", ",", " ", "s"}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"off", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{"chi", " ", "-", " ", 
             RowBox[{"DiagonalMatrix", "[", 
              RowBox[{"Diagonal", "[", "chi", "]"}], "]"}]}], "]"}], "]"}]}], 
         ";", "\n", "   ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{"\"\<WP2-8a \>\"", " ", "<>", " ", "key"}], ",", " ", 
           RowBox[{
           "key", " ", "<>", " ", "\"\<: chi_11 = \>\"", " ", "<>", " ", 
            RowBox[{"ToString", "[", 
             RowBox[{"NumberForm", "[", 
              RowBox[{
               RowBox[{"chi", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], ",", " ", "10"}],
               "]"}], "]"}], " ", "<>", " ", "\"\<, chi_FF = \>\"", " ", "<>",
             " ", 
            RowBox[{"ToString", "[", 
             RowBox[{"NumberForm", "[", 
              RowBox[{
               RowBox[{"chi", "[", 
                RowBox[{"[", 
                 RowBox[{"4", ",", " ", "4"}], "]"}], "]"}], ",", " ", "10"}],
               "]"}], "]"}], " ", "<>", " ", "\"\< = Rust; chi_33 = \>\"", 
            " ", "<>", " ", 
            RowBox[{"sci", "[", 
             RowBox[{"chi", "[", 
              RowBox[{"[", 
               RowBox[{"3", ",", " ", "3"}], "]"}], "]"}], "]"}], " ", "<>", 
            " ", "\"\< (massless photon), no mixing\>\""}], ",", "\n", "    ", 
           RowBox[{"Max", "[", 
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{"chi", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], " ", "-", " ", 
               RowBox[{"rustPart2", "[", 
                RowBox[{"\"\<p2_chi11_\>\"", " ", "<>", " ", "key"}], "]"}]}],
               "]"}], ",", " ", 
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{"chi", "[", 
                RowBox[{"[", 
                 RowBox[{"4", ",", " ", "4"}], "]"}], "]"}], " ", "-", " ", 
               RowBox[{"rustPart2", "[", 
                RowBox[{"\"\<p2_chiFF_\>\"", " ", "<>", " ", "key"}], "]"}]}],
               "]"}], ",", " ", 
             RowBox[{"Abs", "[", 
              RowBox[{"chi", "[", 
               RowBox[{"[", 
                RowBox[{"3", ",", " ", "3"}], "]"}], "]"}], "]"}], ",", " ", 
             "off"}], "]"}], ",", " ", 
           RowBox[{"10", "^", 
            RowBox[{"-", "8"}]}], ",", "\n", "    ", 
           
           RowBox[{"\"\<P2-8a \>\"", " ", "<>", " ", "key", " ", "<>", 
            " ", "\"\<, P2-8b \>\"", " ", "<>", " ", "key"}], ",", " ", 
           RowBox[{"\"\<YP2-8a \>\"", " ", "<>", " ", "key"}]}], "]"}], ";", 
         "\n", "   ", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"chiRows", ",", " ", 
           RowBox[{"{", 
            RowBox[{"key", ",", " ", 
             RowBox[{"chi", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
             RowBox[{"chi", "[", 
              RowBox[{"[", 
               RowBox[{"3", ",", " ", "3"}], "]"}], "]"}], ",", " ", 
             RowBox[{"chi", "[", 
              RowBox[{"[", 
               RowBox[{"4", ",", " ", "4"}], "]"}], "]"}], ",", " ", 
             RowBox[{"gvLL", " ", 
              RowBox[{"Sqrt", "[", 
               RowBox[{"chi", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], "]"}]}], ",", 
             " ", 
             RowBox[{"gfLL", " ", 
              RowBox[{"Sqrt", "[", 
               RowBox[{"chi", "[", 
                RowBox[{"[", 
                 RowBox[{"4", ",", " ", "4"}], "]"}], "]"}], "]"}]}]}], 
            "}"}]}], "]"}]}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"m", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\"\<HS\>\"", ",", " ", "1.", ",", " ", "1."}], "}"}], ",",
           " ", 
          RowBox[{"{", "\"\<KS\>\"", "}"}], ",", " ", 
          RowBox[{"{", "\"\<CJT\>\"", "}"}]}], "}"}]}], "}"}]}], "]"}], ";"}],
    "\n", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
            RowBox[{"NumberForm", "[", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", " ", "8"}], "]"}], ",", 
            " ", 
            RowBox[{"sci", "[", 
             RowBox[{"#", "[", 
              RowBox[{"[", "3", "]"}], "]"}], "]"}], ",", " ", 
            RowBox[{"NumberForm", "[", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "4", "]"}], "]"}], ",", " ", "8"}], "]"}], ",", 
            " ", 
            RowBox[{"NumberForm", "[", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "5", "]"}], "]"}], ",", " ", "8"}], "]"}], ",", 
            " ", 
            RowBox[{"NumberForm", "[", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "6", "]"}], "]"}], ",", " ", "8"}], "]"}]}], 
           "}"}], " ", "&"}], ",", " ", "chiRows"}], "]"}], ",", "\n", "   ", 
       
       RowBox[{"{", 
        RowBox[{"\"\<method\>\"", ",", " ", "\"\<chi_11 = chi_22\>\"", ",", 
         " ", "\"\<chi_33\>\"", ",", " ", "\"\<chi_FF\>\"", ",", 
         " ", "\"\<M_W = g_v sqrt(chi_11)\>\"", ",", 
         " ", "\"\<M_Z = g_F sqrt(chi_FF)\>\""}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
     RowBox[{"Alignment", " ", "->", " ", "Right"}]}], "]"}]}]}]], "Input",
 CellLabel->
  "In[256]:=",ExpressionUUID->"c06cea94-2369-49fe-bca6-0e32d27c4370"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"PASS \"\>", "\[InvisibleSpace]", "\<\"WP2-8a HS_1_1\"\>", 
   "\[InvisibleSpace]", "\<\"  deviation \"\>", 
   "\[InvisibleSpace]", "\<\"8.289e-14\"\>", 
   "\[InvisibleSpace]", "\<\" (tolerance \"\>", 
   "\[InvisibleSpace]", "\<\"1.000e-8\"\>", 
   "\[InvisibleSpace]", "\<\"): \"\>", 
   "\[InvisibleSpace]", "\<\"HS_1_1: chi_11 = 0.005118624664, chi_FF = \
0.02014453922 = Rust; chi_33 = 8.759e-16 (massless photon), no mixing\"\>", 
   "\[InvisibleSpace]", "\<\"   [the same check: Rust \"\>", 
   "\[InvisibleSpace]", "\<\"P2-8a HS_1_1, P2-8b HS_1_1\"\>", 
   "\[InvisibleSpace]", "\<\", Python \"\>", 
   "\[InvisibleSpace]", "\<\"YP2-8a HS_1_1\"\>", 
   "\[InvisibleSpace]", "\<\"]\"\>"}],
  SequenceForm[
  "PASS ", "WP2-8a HS_1_1", "  deviation ", "8.289e-14", " (tolerance ", 
   "1.000e-8", "): ", 
   "HS_1_1: chi_11 = 0.005118624664, chi_FF = 0.02014453922 = Rust; chi_33 = \
8.759e-16 (massless photon), no mixing", "   [the same check: Rust ", 
   "P2-8a HS_1_1, P2-8b HS_1_1", ", Python ", "YP2-8a HS_1_1", "]"],
