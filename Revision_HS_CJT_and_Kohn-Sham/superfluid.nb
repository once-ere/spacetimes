Cell[TextData[{
 StyleBox["The exchange of the gauge bosons.",
  FontWeight->"Bold"],
 " Beyond their contact limit, the four gauge bosons are exchanged between \
the charges with the propagator ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"\[LeftBracketingBar]", 
        RowBox[{
         OverscriptBox[
          StyleBox["q", "TI"], "\[RightVector]"], "-", 
         RowBox[{
          OverscriptBox[
           StyleBox["q", "TI"], "\[RightVector]"], "\[ThinSpace]", 
          SuperscriptBox["", "\[Prime]"]}]}], "\[RightBracketingBar]"}], "2"],
       "+", 
      SuperscriptBox[
       StyleBox["M", "TI"], "2"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "877d09fb-5fb2-445a-9e60-b19788cd2966"],
 " of a boson of mass ",
 Cell[BoxData[
  FormBox[
   StyleBox["M", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d51b7408-6aba-4a9e-b8ab-36c97e02fa64"],
 ". In a uniform state the exchange self-energies at the momentum ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["q", "TI"], "\[RightVector]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ea584a6d-a76f-46cc-8a13-05aa26f454af"],
 " are integrals over ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     StyleBox["q", "TI"], "\[RightVector]"], "\[ThinSpace]", 
    SuperscriptBox["", "\[Prime]"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b31c6701-2184-497b-b102-e1b9a6382863"],
 " of the correlation matrices; with the six directions of the grid the \
correlation matrix at a radius has a part of angular momentum 0 (the mean \
over the directions) and three parts of angular momentum 1, and the angular \
integrals reduce to the two angular averages"
}], "Text",ExpressionUUID->"6c86c0f8-6e45-4638-b059-3ab4adffda93"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["D", "TI"], "0"], 
   RowBox[{"(", 
    RowBox[{
     StyleBox["q", "TI"], ",", 
     SuperscriptBox[
      StyleBox["q", "TI"], "\[Prime]"]}], ")"}], "\[LongEqual]", 
   FractionBox["1", "2"], "\[ThinSpace]", 
   SubsuperscriptBox["\[Integral]", 
    RowBox[{"-", "1"}], "1"], "\[ThinSpace]", 
   FractionBox[
    StyleBox["dx", "TI"], 
    RowBox[{
     SuperscriptBox[
      StyleBox["q", "TI"], "2"], "+", 
     SuperscriptBox[
      StyleBox["q", "TI"], 
      RowBox[{"\[Prime]", "2"}]], "+", 
     SuperscriptBox[
      StyleBox["M", "TI"], "2"], "-", "2", 
     StyleBox["q", "TI"], 
     SuperscriptBox[
      StyleBox["q", "TI"], "\[Prime]"], 
     StyleBox["x", "TI"]}]], ",", "      ", 
   SubscriptBox[
    StyleBox["D", "TI"], "1"], 
   RowBox[{"(", 
    RowBox[{
     StyleBox["q", "TI"], ",", 
     SuperscriptBox[
      StyleBox["q", "TI"], "\[Prime]"]}], ")"}], "\[LongEqual]", 
   FractionBox["1", "2"], "\[ThinSpace]", 
   SubsuperscriptBox["\[Integral]", 
    RowBox[{"-", "1"}], "1"], "\[ThinSpace]", 
   FractionBox[
    RowBox[{
     StyleBox["x", "TI"], "\[ThinSpace]", 
     StyleBox["dx", "TI"]}], 
    RowBox[{
     SuperscriptBox[
      StyleBox["q", "TI"], "2"], "+", 
     SuperscriptBox[
      StyleBox["q", "TI"], 
      RowBox[{"\[Prime]", "2"}]], "+", 
     SuperscriptBox[
      StyleBox["M", "TI"], "2"], "-", "2", 
     StyleBox["q", "TI"], 
     SuperscriptBox[
      StyleBox["q", "TI"], "\[Prime]"], 
     StyleBox["x", "TI"]}]], ","}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"c6b8fe5e-91be-424a-bd10-3c8b4b993aa7"],

Cell[TextData[{
 "whose closed forms contain ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["ln",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         StyleBox["q", "TI"], "-", 
         SuperscriptBox[
          StyleBox["q", "TI"], "\[Prime]"]}], ")"}], "2"], "+", 
      SuperscriptBox[
       StyleBox["M", "TI"], "2"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f7fa1027-151e-4030-9400-ae5d8bed9296"],
 ", singular at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["q", "TI"], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["q", "TI"], "\[Prime]"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6ded01f5-0778-4587-ba41-2e9344d243f1"],
 " for a massless boson; the radial integral subtracts this logarithm at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["q", "TI"], "\[Prime]"], "\[LongEqual]", 
    StyleBox["q", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "78ab1714-0ccf-4c77-9a0a-4c6c6752ef0d"],
 " and integrates it exactly (",
 StyleBox["kernIntegral",
  FontFamily->"Source Code Pro"],
 "). The next cell compares the closed forms with a numerical integration \
over the angle; then it computes the Thouless eigenvalues of the exchange of \
the photon ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4f8b796a-b99c-4ef4-865a-460e031d7b84"],
 " alone and of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6a4a3bee-1d7d-4bcd-9951-b3068469b668"],
 " alone in the normal vacuum (per unit squared coupling; a positive \
eigenvalue attracts the pair ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2edd0456-8c28-4081-91f2-ce85c9fedc93"],
 "), by power iteration; and finally the CJT state of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "2", ")"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "88991217-377c-4dab-8d9a-3dc34a7a2612"],
 " with the exchange of all four bosons at the couplings ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]], "\[LongEqual]", "0.7"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d2fadc96-4d14-43be-b564-295c3dbfb034"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]], "\[LongEqual]", "0.45"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3c31ed34-3274-4019-8d33-5ba635db2854"],
 " and the boson masses of the Rust program."
}], "Text",ExpressionUUID->"be16da4d-5eea-48a5-8e43-6234873218bd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"kernSF", "[", 
      RowBox[{"g", ",", " ", "mass"}], "]"}], ":", " ", 
     RowBox[{"the", " ", "radial", " ", "kernels", " ", "of", " ", "D0"}]}], ",",
     " ", 
    RowBox[{"D1", " ", "in", " ", "closed", " ", 
     RowBox[{"form", ":", " ", 
      RowBox[{"{", 
       RowBox[{"r0", ",", " ", "r1"}], "}"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"s0", ",", " ", "s1"}], "}"}], " ", "with", " ", "D_l"}], " ", 
     "=", " ", 
     RowBox[{"r_l", " ", "+", " ", 
      RowBox[{"s_l", " ", "ln", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"q", " ", "-", " ", 
            RowBox[{"q", "'"}]}], ")"}], "^", "2"}], " ", "+", " ", 
         RowBox[{"M", "^", "2"}]}], ")"}]}]}]}], ",", "\n", "   ", 
    RowBox[{"the", " ", "logarithm", " ", "lm"}], ",", " ", 
    RowBox[{
     RowBox[{"and", " ", "aq"}], " ", "=", " ", 
     RowBox[{"the", " ", "exact", " ", "integral", " ", "of", " ", "ln", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"q", " ", "-", " ", 
           RowBox[{"q", "'"}]}], ")"}], "^", "2"}], " ", "+", " ", 
        RowBox[{"M", "^", "2"}]}], ")"}], " ", "over", " ", 
      RowBox[{"q", "'"}], " ", 
      RowBox[{"in", " ", "[", 
       RowBox[{"0", ",", " ", "Lambda"}], "]"}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"kernSF", "[", 
      RowBox[{"g_", ",", " ", "mass_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"kr", " ", "=", " ", 
          RowBox[{"g", "[", "\"\<kr\>\"", "]"}]}], ",", " ", "q", ",", " ", 
         "qp", ",", " ", "a", ",", " ", "b", ",", " ", "lp", ",", " ", "lm", ",",
          " ", "fp"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"q", " ", "=", " ", 
         RowBox[{"Outer", "[", 
          RowBox[{
           RowBox[{"#1", " ", "&"}], ",", " ", "kr", ",", " ", "kr"}], 
          "]"}]}], ";", " ", 
        RowBox[{"qp", " ", "=", " ", 
         RowBox[{"Outer", "[", 
          RowBox[{
           RowBox[{"#2", " ", "&"}], ",", " ", "kr", ",", " ", "kr"}], 
          "]"}]}], ";", "\n", "   ", 
        RowBox[{"a", " ", "=", " ", 
         RowBox[{
          RowBox[{"q", "^", "2"}], " ", "+", " ", 
          RowBox[{"qp", "^", "2"}], " ", "+", " ", 
          RowBox[{"mass", "^", "2"}]}]}], ";", " ", 
        RowBox[{"b", " ", "=", " ", 
         RowBox[{"2", " ", "q", " ", "qp"}]}], ";", " ", 
        RowBox[{"lp", " ", "=", " ", 
         RowBox[{"Log", "[", 
          RowBox[{"a", " ", "+", " ", "b"}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"lm", " ", "=", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"mass", " ", "==", " ", "0"}], " ", "&&", " ", 
              RowBox[{"i", " ", "==", " ", "j"}]}], ",", " ", "0.", ",", " ", 
             
             RowBox[{"Log", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"kr", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], " ", "-", " ", 
                  RowBox[{"kr", "[", 
                   RowBox[{"[", "j", "]"}], "]"}]}], ")"}], "^", "2"}], " ", "+",
                " ", 
               RowBox[{"mass", "^", "2"}]}], "]"}]}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", 
             RowBox[{"Length", "[", "kr", "]"}]}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"j", ",", " ", 
             RowBox[{"Length", "[", "kr", "]"}]}], "}"}]}], "]"}]}], ";", 
        "\n", "   ", 
        RowBox[{
         RowBox[{"fp", "[", "x_", "]"}], " ", ":=", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"mass", " ", "==", " ", "0"}], ",", " ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"x", " ", "==", " ", "0"}], ",", " ", "0.", ",", " ", 
             RowBox[{
              RowBox[{"x", " ", 
               RowBox[{"Log", "[", 
                RowBox[{"x", "^", "2"}], "]"}]}], " ", "-", " ", 
              RowBox[{"2", " ", "x"}]}]}], "]"}], ",", " ", 
           RowBox[{
            RowBox[{"x", " ", 
             RowBox[{"Log", "[", 
              RowBox[{
               RowBox[{"x", "^", "2"}], " ", "+", " ", 
               RowBox[{"mass", "^", "2"}]}], "]"}]}], " ", "-", " ", 
            RowBox[{"2", " ", "x"}], " ", "+", " ", 
            RowBox[{"2", " ", "mass", " ", 
             RowBox[{"ArcTan", "[", 
              RowBox[{"x", "/", "mass"}], "]"}]}]}]}], "]"}]}], ";", "\n", 
        "   ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<r\>\"", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"lp", "/", 
              RowBox[{"(", 
               RowBox[{"2", " ", "b"}], ")"}]}], ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "1"}], "/", "b"}], " ", "+", " ", 
              RowBox[{"a", " ", 
               RowBox[{"lp", "/", 
                RowBox[{"(", 
                 RowBox[{"2", " ", 
                  RowBox[{"b", "^", "2"}]}], ")"}]}]}]}]}], "}"}]}], ",", " ", 
          RowBox[{"\"\<s\>\"", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "1"}], "/", 
              RowBox[{"(", 
               RowBox[{"2", " ", "b"}], ")"}]}], ",", " ", 
             RowBox[{
              RowBox[{"-", "a"}], "/", 
              RowBox[{"(", 
               RowBox[{"2", " ", 
                RowBox[{"b", "^", "2"}]}], ")"}]}]}], "}"}]}], ",", " ", 
          RowBox[{"\"\<lm\>\"", " ", "->", " ", "lm"}], ",", "\n", "     ", 
          RowBox[{"\"\<aq\>\"", " ", "->", " ", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"fp", "[", 
                RowBox[{"lamLL", " ", "-", " ", "#"}], "]"}], " ", "-", " ", 
               RowBox[{"fp", "[", 
                RowBox[{"-", "#"}], "]"}]}], " ", "&"}], ",", " ", "kr"}], 
            "]"}]}], ",", " ", 
          RowBox[{"\"\<g\>\"", " ", "->", " ", "g"}]}], "|>"}]}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"kernIntegral", "[", 
       RowBox[{"kern", ",", " ", "l", ",", " ", "f"}], "]"}], ":", " ", 
      RowBox[{"the", " ", "integral", " ", "over", " ", 
       RowBox[{"q", "'"}], " ", "of", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"q", "'"}], "^", "2"}], "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", 
          RowBox[{"pi", "^", "2"}]}], ")"}]}], " ", "D_l", 
       RowBox[{"(", 
        RowBox[{"q_i", ",", " ", 
