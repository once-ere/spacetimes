Cell[CellGroupData[{

Cell["II.5 The gauge bosons in the superfluid", "Section",ExpressionUUID->"4af2ef95-aa3b-432a-9844-df693b3d7183"],

Cell[TextData[{
 StyleBox["The masses from the susceptibilities.",
  FontWeight->"Bold"],
 " A constant gauge field ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["A", "TI"], "0", 
    StyleBox["a", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d1be2551-c823-4061-a9da-06727dcf5db4"],
 " along the generator ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["Q",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["a", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "27f8dafc-5e90-4f7a-a2e8-2133c998a4e9"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], "\[LongEqual]", "1", ",", "2", ",", "3"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "124e828c-c80f-41d6-930a-eda0c3c361c3"],
 ": ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "81f8addb-b6d4-48b7-9539-82fd10a11bf0"],
 "; ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], "\[LongEqual]", "4"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ac448b2c-3f22-41a9-adea-6af676c598df"],
 ": the fermion number ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["1",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "8"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "35b11c63-a7fb-417a-b310-d321a3935a5a"],
 ") enters like a chemical potential ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Mu]", 
    StyleBox["a", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7b666a3d-33f4-44fb-9044-c67005429075"],
 " of that charge. The static susceptibility ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Chi]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["ab", "TI"]], "\[LongEqual]", "\[PartialD]", 
    RowBox[{"\[LeftAngleBracket]", 
     SubscriptBox[
      StyleBox["Q",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["a", "TI"]], "\[RightAngleBracket]"}], "/", "\[PartialD]", 
    SuperscriptBox["\[Mu]", 
     StyleBox["b", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "62025259-c6f3-4ccd-9805-81afc3b6c402"],
 " of the superfluid gives the mass matrix of the gauge bosons, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"(", 
      SuperscriptBox[
       StyleBox["M", "TI"], "2"], ")"}], 
     StyleBox["ab", "TI"]], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["a", "TI"]], 
    SubscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["b", "TI"]], 
    SubsuperscriptBox["\[Chi]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["ab", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9862cbe6-233d-4ee9-82d7-dbf7515d0084"],
 " (the Higgs mechanism of the condensate), with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["a", "TI"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5864d9f4-396c-47f1-b8c2-43585d017eae"],
 " for the three ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c3a12c9a-a356-4d30-ac23-3d732168d689"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["F",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e08cf3d2-0112-48ad-97e3-9ff1da7ab0a6"],
 " for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2778854e-622e-4b6f-8488-b92ebbd5916e"],
 ". The next cell computes ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Chi]", 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["ab", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c5303602-8e0c-4f0c-a7f2-854702548967"],
 " by central differences of the self-consistent states with the external \
self-energies ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[MinusPlus]", 
     StyleBox["h", "TI"]}], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["Q",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["b", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c3eab37f-c633-443a-a13a-0227bba45d6b"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["h", "TI"], "\[LongEqual]", "2", "\[Times]", 
    SuperscriptBox["10", 
     RowBox[{"-", "3"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ac4bd151-031d-45af-9df2-c906c61fc566"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    StyleBox["h", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "515ac2d5-ea67-4976-bdbf-02611c0c658e"],
 ", and the Richardson extrapolation. The generator ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1deb7f94-db9f-4e8e-9d31-55b644d3abae"],
 " leaves the condensate in the channel ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "50589ee0-090e-47df-8ec0-2ed1795accb4"],
 " unchanged, so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Chi]", 
     StyleBox["SF",
      FontSlant->"Plain"], "33"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "caebe07e-3f30-4a63-9c27-c18b45551d6a"],
 ": ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1de676c7-3a0b-45f2-8f60-1b91ab355b34"],
 " stays massless (the photon of the superfluid), and there is no mixing."
}], "Text",ExpressionUUID->"9b3d37cd-e33a-4415-87eb-17cd1830eaba"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", "four", " ", 
     RowBox[{"charges", ":", " ", 
      RowBox[{"T", "^", "1"}]}]}], ",", " ", 
    RowBox[{"T", "^", "2"}], ",", " ", 
    RowBox[{
     RowBox[{"T", "^", "3"}], " ", 
     RowBox[{"(", 
      RowBox[{"1", "_", "4", " ", 
       RowBox[{"(", "x", ")"}], " ", 
       RowBox[{"tau", "/", "2"}]}], ")"}], " ", "and", " ", "the", " ", 
     "fermion", " ", "number", " ", "1", "_", "8"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"chargesSF", " ", "=", " ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"N", "[", 
          RowBox[{"i8", "[", 
           RowBox[{
            RowBox[{"sig", "[", 
             RowBox[{"[", 
              RowBox[{"k", " ", "+", " ", "1"}], "]"}], "]"}], "/", "2"}], 
           "]"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"{", "id8", "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"susceptibilitySF", "[", 
      RowBox[{"mo", ",", " ", "s"}], "]"}], ":", " ", 
     RowBox[{
     "the", " ", "4", " ", "x", " ", "4", " ", "static", " ", 
      "susceptibilities", " ", "by", " ", "central", " ", "differences", " ", 
      "and", " ", "Richardson"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"susceptibilitySF", "[", 
      RowBox[{"mo_", ",", " ", "s_", ",", " ", 
       RowBox[{"h_", " ", ":", " ", 
        RowBox[{"2.", " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "3"}]}]}]}]}], "]"}], " ", ":=", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", "dn", "}"}], ",", "\n", "     ", 
          RowBox[{
           RowBox[{"dn", " ", "=", " ", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"Module", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"r", " ", "=", " ", 
                  RowBox[{"Table", "[", 
                   RowBox[{
                    RowBox[{"Module", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"ext", " ", "=", " ", 
                    RowBox[{
                    RowBox[{"-", "sg"}], " ", "step", " ", 
                    RowBox[{"chargesSF", "[", 
                    RowBox[{"[", "bb", "]"}], "]"}]}]}], "}"}], ",", "\n", 
                    "            ", 
                    RowBox[{
                    RowBox[{"solveSF", "[", 
                    RowBox[{"mo", ",", " ", 
                    RowBox[{
                    RowBox[{"s", "[", "\"\<n\>\"", "]"}], " ", "+", " ", 
                    "ext"}], ",", " ", 
                    RowBox[{"s", "[", "\"\<p\>\"", "]"}], ",", " ", "0.6", ",",
                     " ", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", "14"}]}], ",", " ", "40000", ",", " ", 
                    "ext"}], "]"}], "[", "\"\<rho\>\"", "]"}]}], "]"}], ",", 
                    " ", 
                    RowBox[{"{", 
                    RowBox[{"sg", ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"1", ",", " ", 
                    RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], "]"}]}], "}"}], ",",
                 "\n", "        ", 
                RowBox[{"Table", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Re", "[", 
                    RowBox[{
                    RowBox[{"Tr", "[", 
                    RowBox[{
                    RowBox[{"chargesSF", "[", 
                    RowBox[{"[", "a", "]"}], "]"}], " ", ".", " ", 
                    RowBox[{"r", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "]"}], " ", "-", " ", 
                    RowBox[{"Tr", "[", 
                    RowBox[{
                    RowBox[{"chargesSF", "[", 
                    RowBox[{"[", "a", "]"}], "]"}], " ", ".", " ", 
                    RowBox[{"r", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], "]"}], "/", 
                   RowBox[{"(", 
                    RowBox[{"2", " ", "step"}], ")"}]}], ",", " ", 
                  RowBox[{"{", 
                   RowBox[{"a", ",", " ", "4"}], "}"}]}], "]"}]}], "]"}], ",",
               " ", 
              RowBox[{"{", 
               RowBox[{"step", ",", " ", 
                RowBox[{"{", 
                 RowBox[{"h", ",", " ", 
                  RowBox[{"2", " ", "h"}]}], "}"}]}], "}"}]}], "]"}]}], ";", 
           "\n", "     ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"4", " ", 
               RowBox[{"dn", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], " ", "-", " ", 
              RowBox[{"dn", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "/", "3"}]}]}], "]"}],
         ",", " ", 
        RowBox[{"{", 
         RowBox[{"bb", ",", " ", "4"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
   
   RowBox[{
    RowBox[{"chiRows", " ", "=", " ", 
     RowBox[{"{", "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"key", " ", "=", " ", 
           RowBox[{"shortName", "[", "m", "]"}]}], ",", " ", "mo", ",", " ", 
          "s", ",", " ", "chi", ",", " ", "off"}], "}"}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"mo", ",", " ", "s"}], "}"}], " ", "=", " ", 
          RowBox[{"groundSF", "[", 
           RowBox[{"\"\<V2_\>\"", " ", "<>", " ", "key"}], "]"}]}], ";", "\n",
          "   ", 
         RowBox[{"chi", " ", "=", " ", 
          RowBox[{"susceptibilitySF", "[", 
           RowBox[{"mo", ",", " ", "s"}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"off", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{"chi", " ", "-", " ", 
             RowBox[{"DiagonalMatrix", "[", 
              RowBox[{"Diagonal", "[", "chi", "]"}], "]"}]}], "]"}], "]"}]}], 
         ";", "\n", "   ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{"\"\<WP2-8a \>\"", " ", "<>", " ", "key"}], ",", " ", 
           RowBox[{
           "key", " ", "<>", " ", "\"\<: chi_11 = \>\"", " ", "<>", " ", 
            RowBox[{"ToString", "[", 
             RowBox[{"NumberForm", "[", 
              RowBox[{
               RowBox[{"chi", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], ",", " ", "10"}],
               "]"}], "]"}], " ", "<>", " ", "\"\<, chi_FF = \>\"", " ", "<>",
             " ", 
            RowBox[{"ToString", "[", 
             RowBox[{"NumberForm", "[", 
              RowBox[{
               RowBox[{"chi", "[", 
                RowBox[{"[", 
                 RowBox[{"4", ",", " ", "4"}], "]"}], "]"}], ",", " ", "10"}],
               "]"}], "]"}], " ", "<>", " ", "\"\< = Rust; chi_33 = \>\"", 
            " ", "<>", " ", 
            RowBox[{"sci", "[", 
             RowBox[{"chi", "[", 
              RowBox[{"[", 
               RowBox[{"3", ",", " ", "3"}], "]"}], "]"}], "]"}], " ", "<>", 
            " ", "\"\< (massless photon), no mixing\>\""}], ",", "\n", "    ", 
           RowBox[{"Max", "[", 
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{"chi", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], " ", "-", " ", 
               RowBox[{"rustPart2", "[", 
                RowBox[{"\"\<p2_chi11_\>\"", " ", "<>", " ", "key"}], "]"}]}],
               "]"}], ",", " ", 
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{"chi", "[", 
                RowBox[{"[", 
                 RowBox[{"4", ",", " ", "4"}], "]"}], "]"}], " ", "-", " ", 
               RowBox[{"rustPart2", "[", 
                RowBox[{"\"\<p2_chiFF_\>\"", " ", "<>", " ", "key"}], "]"}]}],
               "]"}], ",", " ", 
             RowBox[{"Abs", "[", 
              RowBox[{"chi", "[", 
               RowBox[{"[", 
                RowBox[{"3", ",", " ", "3"}], "]"}], "]"}], "]"}], ",", " ", 
             "off"}], "]"}], ",", " ", 
           RowBox[{"10", "^", 
            RowBox[{"-", "8"}]}], ",", "\n", "    ", 
           
           RowBox[{"\"\<P2-8a \>\"", " ", "<>", " ", "key", " ", "<>", 
            " ", "\"\<, P2-8b \>\"", " ", "<>", " ", "key"}], ",", " ", 
           RowBox[{"\"\<YP2-8a \>\"", " ", "<>", " ", "key"}]}], "]"}], ";", 
         "\n", "   ", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"chiRows", ",", " ", 
           RowBox[{"{", 
            RowBox[{"key", ",", " ", 
             RowBox[{"chi", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
             RowBox[{"chi", "[", 
              RowBox[{"[", 
               RowBox[{"3", ",", " ", "3"}], "]"}], "]"}], ",", " ", 
             RowBox[{"chi", "[", 
              RowBox[{"[", 
               RowBox[{"4", ",", " ", "4"}], "]"}], "]"}], ",", " ", 
             RowBox[{"gvLL", " ", 
              RowBox[{"Sqrt", "[", 
               RowBox[{"chi", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], "]"}]}], ",", 
             " ", 
             RowBox[{"gfLL", " ", 
              RowBox[{"Sqrt", "[", 
               RowBox[{"chi", "[", 
                RowBox[{"[", 
                 RowBox[{"4", ",", " ", "4"}], "]"}], "]"}], "]"}]}]}], 
            "}"}]}], "]"}]}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"m", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\"\<HS\>\"", ",", " ", "1.", ",", " ", "1."}], "}"}], ",",
           " ", 
          RowBox[{"{", "\"\<KS\>\"", "}"}], ",", " ", 
          RowBox[{"{", "\"\<CJT\>\"", "}"}]}], "}"}]}], "}"}]}], "]"}], ";"}],
    "\n", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
            RowBox[{"NumberForm", "[", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", " ", "8"}], "]"}], ",", 
            " ", 
            RowBox[{"sci", "[", 
             RowBox[{"#", "[", 
              RowBox[{"[", "3", "]"}], "]"}], "]"}], ",", " ", 
            RowBox[{"NumberForm", "[", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "4", "]"}], "]"}], ",", " ", "8"}], "]"}], ",", 
            " ", 
            RowBox[{"NumberForm", "[", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "5", "]"}], "]"}], ",", " ", "8"}], "]"}], ",", 
            " ", 
            RowBox[{"NumberForm", "[", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "6", "]"}], "]"}], ",", " ", "8"}], "]"}]}], 
           "}"}], " ", "&"}], ",", " ", "chiRows"}], "]"}], ",", "\n", "   ", 
       
       RowBox[{"{", 
        RowBox[{"\"\<method\>\"", ",", " ", "\"\<chi_11 = chi_22\>\"", ",", 
         " ", "\"\<chi_33\>\"", ",", " ", "\"\<chi_FF\>\"", ",", 
         " ", "\"\<M_W = g_v sqrt(chi_11)\>\"", ",", 
         " ", "\"\<M_Z = g_F sqrt(chi_FF)\>\""}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
     RowBox[{"Alignment", " ", "->", " ", "Right"}]}], "]"}]}]}]], "Input",
 CellLabel->
  "In[256]:=",ExpressionUUID->"7887aa15-8039-40c3-88fd-c7a2ffd1aaf4"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"PASS \"\>", "\[InvisibleSpace]", "\<\"WP2-8a HS_1_1\"\>", 
   "\[InvisibleSpace]", "\<\"  deviation \"\>", 
   "\[InvisibleSpace]", "\<\"8.289e-14\"\>", 
   "\[InvisibleSpace]", "\<\" (tolerance \"\>", 
   "\[InvisibleSpace]", "\<\"1.000e-8\"\>", 
   "\[InvisibleSpace]", "\<\"): \"\>", 
   "\[InvisibleSpace]", "\<\"HS_1_1: chi_11 = 0.005118624664, chi_FF = \
0.02014453922 = Rust; chi_33 = 8.759e-16 (massless photon), no mixing\"\>", 
   "\[InvisibleSpace]", "\<\"   [the same check: Rust \"\>", 
   "\[InvisibleSpace]", "\<\"P2-8a HS_1_1, P2-8b HS_1_1\"\>", 
   "\[InvisibleSpace]", "\<\", Python \"\>", 
   "\[InvisibleSpace]", "\<\"YP2-8a HS_1_1\"\>", 
   "\[InvisibleSpace]", "\<\"]\"\>"}],
  SequenceForm[
  "PASS ", "WP2-8a HS_1_1", "  deviation ", "8.289e-14", " (tolerance ", 
   "1.000e-8", "): ", 
   "HS_1_1: chi_11 = 0.005118624664, chi_FF = 0.02014453922 = Rust; chi_33 = \
8.759e-16 (massless photon), no mixing", "   [the same check: Rust ", 
   "P2-8a HS_1_1, P2-8b HS_1_1", ", Python ", "YP2-8a HS_1_1", "]"],
  Editable->False]], "Print",
