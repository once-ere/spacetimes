        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Psi", "^", "dag"}], " ", "X", " ", "Psi"}], ")"}], "^", 
         "2"}], ":"}]}]}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"kind", " ", "\"\<p\>\"", " ", "with", " ", "data", " ", 
         RowBox[{"{", 
          RowBox[{"G", ",", " ", "K"}], "}"}], " ", "for"}], " ", "-", 
        RowBox[{"(", 
         RowBox[{"G", "/", "4"}], ")"}]}], " ", ":", 
       RowBox[{
        RowBox[{"Pi", "^", "dag"}], " ", "Pi"}], ":"}], ";", " ", 
      RowBox[{
      "ks", " ", "is", " ", "True", " ", "for", " ", "the", " ", "KS", " ", 
       "projection"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"terms", "[", 
      RowBox[{
      "method_List", ",", " ", "gs_", ",", " ", "gv_", ",", " ", "g_"}], 
      "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "ws", ",", " ", "wv", ",", " ", "wq", ",", " ", "ks", ",", " ", 
         RowBox[{"t", " ", "=", " ", 
          RowBox[{"{", "}"}]}]}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"method", "[", 
            RowBox[{"[", "1", "]"}], "]"}], " ", "===", " ", "\"\<HS\>\""}], ",",
           "\n", "     ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"ws", ",", " ", "wv", ",", " ", "wq", ",", " ", "ks"}], 
            "}"}], " ", "=", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"method", "[", 
                RowBox[{"[", "2", "]"}], "]"}], ",", " ", "0.", ",", " ", 
               RowBox[{"1.", " ", "-", " ", 
                RowBox[{"method", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"method", "[", 
                RowBox[{"[", "3", "]"}], "]"}], ",", " ", "0.", ",", " ", 
               RowBox[{"1.", " ", "-", " ", 
                RowBox[{"method", "[", 
                 RowBox[{"[", "3", "]"}], "]"}]}]}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"1.", ",", " ", "0."}], "}"}], ",", " ", "False"}], 
            "}"}]}], ",", "\n", "     ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"ws", ",", " ", "wv", ",", " ", "wq", ",", " ", "ks"}], 
            "}"}], " ", "=", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"1.", ",", " ", "1.", ",", " ", "1."}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"1.", ",", " ", "1.", ",", " ", "1."}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"1.", ",", " ", "1."}], "}"}], ",", " ", 
             RowBox[{
              RowBox[{"method", "[", 
               RowBox[{"[", "1", "]"}], "]"}], " ", "===", 
              " ", "\"\<KS\>\""}]}], "}"}]}]}], "]"}], ";", "\n", "   ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"gs", " ", "!=", " ", "0"}], ",", " ", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"t", ",", " ", 
            RowBox[{"{", 
             RowBox[{"\"\<b\>\"", ",", " ", 
              RowBox[{"{", 
