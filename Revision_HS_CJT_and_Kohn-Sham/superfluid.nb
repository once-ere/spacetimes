         RowBox[{"{", 
          RowBox[{"i", ",", " ", "3"}], "}"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"channelStates", " ", "=", " ", 
     RowBox[{"Association", "[", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", "->", " ", 
          RowBox[{"pairState", "[", 
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}]}], " ", "&"}], ",", " ", 
        "channelMats"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"pairEnergy", " ", "=", " ", 
     RowBox[{"Association", "[", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Table", "[", 
