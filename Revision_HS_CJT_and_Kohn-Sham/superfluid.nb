      FontSlant->"Plain"], 
     RowBox[{"(", 
      RowBox[{
       StyleBox["X",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], "\[Delta]", 
       SuperscriptBox[
        StyleBox["C",
         FontFamily->"Helvetica",
