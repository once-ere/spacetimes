 "."
}], "Text",ExpressionUUID->"1c99299f-1edf-4e1d-9ec0-328e1a38cd64"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"thModel", "[", "t", "]"}], ",", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"thGround", "[", "t", "]"}], ":", " ", 
      RowBox[{"the", " ", "model", " ", "of", " ", 
       RowBox[{"V", "^", 
        RowBox[{"(", "2", ")"}]}], " ", "and", " ", "the", " ", "ground", " ",
        "state", " ", "at", " ", "T"}]}], " ", "=", " ", 
     RowBox[{"0", " ", "of", " ", "the", " ", "method", " ", "t", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"from", " ", "Part", " ", "II"}], ",", " ", 
        RowBox[{
         RowBox[{"iterated", " ", "to", " ", "1", "e"}], "-", "13"}]}], 
       ")"}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"thTags", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<HS_1_1\>\"", ",", " ", "\"\<HS_0_1\>\"", ",", 
       " ", "\"\<HS_0_0\>\"", ",", " ", "\"\<KS\>\"", ",", 
       " ", "\"\<CJT\>\""}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"thName", " ", "=", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<HS_1_1\>\"", " ", "->", " ", "\"\<HS (1, 1)\>\""}], ",", 
       " ", 
       RowBox[{"\"\<HS_0_1\>\"", " ", "->", " ", "\"\<HS (0, 1)\>\""}], ",", 
       " ", 
       RowBox[{"\"\<HS_0_0\>\"", " ", "->", " ", "\"\<HS (0, 0)\>\""}], ",", 
       " ", 
       RowBox[{"\"\<KS\>\"", " ", "->", " ", "\"\<KS\>\""}], ",", " ", 
       RowBox[{"\"\<CJT\>\"", " ", "->", " ", "\"\<CJT\>\""}]}], "|>"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"thModel", "[", "t_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"groundSF", "[", 
       RowBox[{"\"\<V2_\>\"", " ", "<>", " ", "t"}], "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"thGround", "[", "t_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"thGround", "[", "t", "]"}], " ", "=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"s", " ", "=", " ", 
          RowBox[{
           RowBox[{"groundSF", "[", 
            RowBox[{"\"\<V2_\>\"", " ", "<>", " ", "t"}], "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", " ", 
        RowBox[{"solveSF", "[", 
         RowBox[{
          RowBox[{"thModel", "[", "t", "]"}], ",", " ", 
          RowBox[{"s", "[", "\"\<n\>\"", "]"}], ",", " ", 
          RowBox[{"s", "[", "\"\<p\>\"", "]"}], ",", " ", "0.6", ",", " ", 
          RowBox[{"10", "^", 
           RowBox[{"-", "13"}]}]}], "]"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"mo", " ", "=", " ", 
           RowBox[{"thModel", "[", "t", "]"}]}], ",", " ", 
          RowBox[{"g0", " ", "=", " ", 
           RowBox[{"thGround", "[", "t", "]"}]}], ",", " ", "low", ",", " ", 
          "nlow"}], "}"}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{"low", " ", "=", " ", 
          RowBox[{"solveSFT", "[", 
           RowBox[{"mo", ",", " ", 
            RowBox[{"g0", "[", "\"\<n\>\"", "]"}], ",", " ", 
            RowBox[{"g0", "[", "\"\<p\>\"", "]"}], ",", " ", "0.005", ",", 
            " ", "0.6", ",", " ", 
            RowBox[{"10", "^", 
             RowBox[{"-", "13"}]}]}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"nlow", " ", "=", " ", 
          RowBox[{"solveSFT", "[", 
           RowBox[{
           "mo", ",", " ", "zero8", ",", " ", "zero8", ",", " ", "0.005", ",",
             " ", "0.6", ",", " ", 
            RowBox[{"10", "^", 
             RowBox[{"-", "13"}]}]}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{"\"\<WP3-T1 \>\"", " ", "<>", " ", "t"}], ",", " ", 
           RowBox[{
            RowBox[{"thName", "[", "t", "]"}], " ", "<>", 
            " ", "\"\<: the thermal states at T = 0.005 reproduce the ground \
state of T = 0 (|change of Phi0| + relative change of the energy)\>\""}], ",",
            "\n", "    ", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"phiOf", "[", "low", "]"}], " ", "-", " ", 
              RowBox[{"phiOf", "[", "g0", "]"}]}], "]"}], " ", "+", " ", 
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"low", "[", "\"\<free\>\"", "]"}], " ", "-", " ", 
                 RowBox[{"nlow", "[", "\"\<free\>\"", "]"}]}], ")"}], " ", "-",
                " ", 
               RowBox[{"g0", "[", "\"\<e\>\"", "]"}]}], "]"}], "/", 
             RowBox[{"Abs", "[", 
              RowBox[{"g0", "[", "\"\<e\>\"", "]"}], "]"}]}]}], ",", " ", 
           RowBox[{"10", "^", 
            RowBox[{"-", "11"}]}], ",", " ", 
           RowBox[{"\"\<P3-T1 \>\"", " ", "<>", " ", "t"}], ",", " ", 
           RowBox[{"\"\<YP3-T1 \>\"", " ", "<>", " ", "t"}]}], "]"}]}]}], 
       "]"}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"t", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<HS_1_1\>\"", ",", " ", "\"\<CJT\>\""}], "}"}]}], 
       "}"}]}], "]"}], ";"}]}]}]], "Input",
 CellLabel->
