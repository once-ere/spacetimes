Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["Tay",
      FontSlant->"Plain"]}]], 
   RowBox[{"(", 
    RowBox[{"0", ";", 
     StyleBox["T", "TI"]}], ")"}], "\[LongEqual]", 
   FractionBox[
    RowBox[{"1", "-", 
     SubsuperscriptBox["\[Lambda]", 
      StyleBox["SF",
       FontSlant->"Plain"], 
      StyleBox["P",
       FontSlant->"Plain"]], 
     RowBox[{"(", 
      StyleBox["T", "TI"], ")"}]}], 
    RowBox[{
     SubsuperscriptBox["\[Lambda]", 
      StyleBox["SF",
       FontSlant->"Plain"], 
      StyleBox["P",
       FontSlant->"Plain"]], 
     RowBox[{"(", 
