Cell[TextData[{
 StyleBox["The exchange of the gauge bosons.",
  FontWeight->"Bold"],
 " Beyond their contact limit, the four gauge bosons are exchanged between \
the charges with the propagator ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"\[LeftBracketingBar]", 
        RowBox[{
         OverscriptBox[
          StyleBox["q", "TI"], "\[RightVector]"], "-", 
         RowBox[{
          OverscriptBox[
           StyleBox["q", "TI"], "\[RightVector]"], "\[ThinSpace]", 
          SuperscriptBox["", "\[Prime]"]}]}], "\[RightBracketingBar]"}], "2"],
       "+", 
      SuperscriptBox[
       StyleBox["M", "TI"], "2"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2c749044-d276-4422-a733-56b908ef094d"],
 " of a boson of mass ",
 Cell[BoxData[
  FormBox[
   StyleBox["M", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a6297692-cd32-4111-b33b-3c5a4aaf1ea9"],
 ". In a uniform state the exchange self-energies at the momentum ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["q", "TI"], "\[RightVector]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1018ced2-de24-4efa-9e2c-b0cc82752204"],
 " are integrals over ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     StyleBox["q", "TI"], "\[RightVector]"], "\[ThinSpace]", 
    SuperscriptBox["", "\[Prime]"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d1e98af5-b64e-4f3d-bc22-2afacd2e287a"],
 " of the correlation matrices; with the six directions of the grid the \
correlation matrix at a radius has a part of angular momentum 0 (the mean \
over the directions) and three parts of angular momentum 1, and the angular \
integrals reduce to the two angular averages"
}], "Text",ExpressionUUID->"101f7045-fd15-4f73-ab07-d3a43b0c1789"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["D", "TI"], "0"], 
   RowBox[{"(", 
    RowBox[{
     StyleBox["q", "TI"], ",", 
     SuperscriptBox[
      StyleBox["q", "TI"], "\[Prime]"]}], ")"}], "\[LongEqual]", 
   FractionBox["1", "2"], "\[ThinSpace]", 
   SubsuperscriptBox["\[Integral]", 
    RowBox[{"-", "1"}], "1"], "\[ThinSpace]", 
   FractionBox[
    StyleBox["dx", "TI"], 
    RowBox[{
     SuperscriptBox[
      StyleBox["q", "TI"], "2"], "+", 
     SuperscriptBox[
      StyleBox["q", "TI"], 
      RowBox[{"\[Prime]", "2"}]], "+", 
     SuperscriptBox[
      StyleBox["M", "TI"], "2"], "-", "2", 
     StyleBox["q", "TI"], 
     SuperscriptBox[
      StyleBox["q", "TI"], "\[Prime]"], 
     StyleBox["x", "TI"]}]], ",", "      ", 
   SubscriptBox[
    StyleBox["D", "TI"], "1"], 
   RowBox[{"(", 
    RowBox[{
     StyleBox["q", "TI"], ",", 
     SuperscriptBox[
      StyleBox["q", "TI"], "\[Prime]"]}], ")"}], "\[LongEqual]", 
   FractionBox["1", "2"], "\[ThinSpace]", 
   SubsuperscriptBox["\[Integral]", 
    RowBox[{"-", "1"}], "1"], "\[ThinSpace]", 
   FractionBox[
    RowBox[{
     StyleBox["x", "TI"], "\[ThinSpace]", 
     StyleBox["dx", "TI"]}], 
    RowBox[{
     SuperscriptBox[
      StyleBox["q", "TI"], "2"], "+", 
     SuperscriptBox[
      StyleBox["q", "TI"], 
      RowBox[{"\[Prime]", "2"}]], "+", 
     SuperscriptBox[
      StyleBox["M", "TI"], "2"], "-", "2", 
     StyleBox["q", "TI"], 
     SuperscriptBox[
      StyleBox["q", "TI"], "\[Prime]"], 
     StyleBox["x", "TI"]}]], ","}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"735fe1d3-c913-43ce-bc04-8a2304a1c480"],

Cell[TextData[{
 "whose closed forms contain ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["ln",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         StyleBox["q", "TI"], "-", 
         SuperscriptBox[
          StyleBox["q", "TI"], "\[Prime]"]}], ")"}], "2"], "+", 
      SuperscriptBox[
       StyleBox["M", "TI"], "2"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "34487c08-7f35-48be-96dc-b4921948ab4b"],
 ", singular at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["q", "TI"], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["q", "TI"], "\[Prime]"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "aecce16a-6226-44d7-9751-bdee2834ae68"],
 " for a massless boson; the radial integral subtracts this logarithm at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["q", "TI"], "\[Prime]"], "\[LongEqual]", 
    StyleBox["q", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "21224f77-3837-4c3a-8b66-d4c42dc7b8b2"],
 " and integrates it exactly (",
 StyleBox["kernIntegral",
  FontFamily->"Source Code Pro"],
 "). The next cell compares the closed forms with a numerical integration \
over the angle; then it computes the Thouless eigenvalues of the exchange of \
the photon ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ec148448-113b-481f-b171-7ca1b3651311"],
 " alone and of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a9df7a1a-3882-4ee4-820b-97b695ecdfae"],
 " alone in the normal vacuum (per unit squared coupling; a positive \
eigenvalue attracts the pair ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c04899a1-ab2e-4dbd-92be-8b8982813628"],
 "), by power iteration; and finally the CJT state of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "2", ")"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "45796f1d-91ae-4c30-a12b-9eeeb2508e79"],
 " with the exchange of all four bosons at the couplings ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]], "\[LongEqual]", "0.7"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "599f1bca-73c5-4b29-95fb-55b83fa38024"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]], "\[LongEqual]", "0.45"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e038914f-7f85-46b8-a63f-3142b8dff376"],
 " and the boson masses of the Rust program."
}], "Text",ExpressionUUID->"a61e9382-c7b6-4602-b2cc-382fcb3fe2cd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"kernSF", "[", 
      RowBox[{"g", ",", " ", "mass"}], "]"}], ":", " ", 
     RowBox[{"the", " ", "radial", " ", "kernels", " ", "of", " ", "D0"}]}], ",",
     " ", 
    RowBox[{"D1", " ", "in", " ", "closed", " ", 
     RowBox[{"form", ":", " ", 
      RowBox[{"{", 
       RowBox[{"r0", ",", " ", "r1"}], "}"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"s0", ",", " ", "s1"}], "}"}], " ", "with", " ", "D_l"}], " ", 
     "=", " ", 
     RowBox[{"r_l", " ", "+", " ", 
      RowBox[{"s_l", " ", "ln", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"q", " ", "-", " ", 
            RowBox[{"q", "'"}]}], ")"}], "^", "2"}], " ", "+", " ", 
         RowBox[{"M", "^", "2"}]}], ")"}]}]}]}], ",", "\n", "   ", 
    RowBox[{"the", " ", "logarithm", " ", "lm"}], ",", " ", 
    RowBox[{
     RowBox[{"and", " ", "aq"}], " ", "=", " ", 
     RowBox[{"the", " ", "exact", " ", "integral", " ", "of", " ", "ln", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"q", " ", "-", " ", 
           RowBox[{"q", "'"}]}], ")"}], "^", "2"}], " ", "+", " ", 
        RowBox[{"M", "^", "2"}]}], ")"}], " ", "over", " ", 
      RowBox[{"q", "'"}], " ", 
      RowBox[{"in", " ", "[", 
       RowBox[{"0", ",", " ", "Lambda"}], "]"}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"kernSF", "[", 
      RowBox[{"g_", ",", " ", "mass_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"kr", " ", "=", " ", 
          RowBox[{"g", "[", "\"\<kr\>\"", "]"}]}], ",", " ", "q", ",", " ", 
         "qp", ",", " ", "a", ",", " ", "b", ",", " ", "lp", ",", " ", "lm", ",",
          " ", "fp"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"q", " ", "=", " ", 
         RowBox[{"Outer", "[", 
          RowBox[{
           RowBox[{"#1", " ", "&"}], ",", " ", "kr", ",", " ", "kr"}], 
          "]"}]}], ";", " ", 
        RowBox[{"qp", " ", "=", " ", 
         RowBox[{"Outer", "[", 
          RowBox[{
           RowBox[{"#2", " ", "&"}], ",", " ", "kr", ",", " ", "kr"}], 
          "]"}]}], ";", "\n", "   ", 
        RowBox[{"a", " ", "=", " ", 
         RowBox[{
          RowBox[{"q", "^", "2"}], " ", "+", " ", 
          RowBox[{"qp", "^", "2"}], " ", "+", " ", 
          RowBox[{"mass", "^", "2"}]}]}], ";", " ", 
        RowBox[{"b", " ", "=", " ", 
         RowBox[{"2", " ", "q", " ", "qp"}]}], ";", " ", 
        RowBox[{"lp", " ", "=", " ", 
         RowBox[{"Log", "[", 
          RowBox[{"a", " ", "+", " ", "b"}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"lm", " ", "=", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"mass", " ", "==", " ", "0"}], " ", "&&", " ", 
              RowBox[{"i", " ", "==", " ", "j"}]}], ",", " ", "0.", ",", " ", 
             
             RowBox[{"Log", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"kr", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], " ", "-", " ", 
                  RowBox[{"kr", "[", 
                   RowBox[{"[", "j", "]"}], "]"}]}], ")"}], "^", "2"}], " ", "+",
                " ", 
               RowBox[{"mass", "^", "2"}]}], "]"}]}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", 
             RowBox[{"Length", "[", "kr", "]"}]}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"j", ",", " ", 
             RowBox[{"Length", "[", "kr", "]"}]}], "}"}]}], "]"}]}], ";", 
        "\n", "   ", 
        RowBox[{
         RowBox[{"fp", "[", "x_", "]"}], " ", ":=", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"mass", " ", "==", " ", "0"}], ",", " ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"x", " ", "==", " ", "0"}], ",", " ", "0.", ",", " ", 
             RowBox[{
              RowBox[{"x", " ", 
               RowBox[{"Log", "[", 
                RowBox[{"x", "^", "2"}], "]"}]}], " ", "-", " ", 
              RowBox[{"2", " ", "x"}]}]}], "]"}], ",", " ", 
           RowBox[{
            RowBox[{"x", " ", 
             RowBox[{"Log", "[", 
              RowBox[{
               RowBox[{"x", "^", "2"}], " ", "+", " ", 
               RowBox[{"mass", "^", "2"}]}], "]"}]}], " ", "-", " ", 
            RowBox[{"2", " ", "x"}], " ", "+", " ", 
            RowBox[{"2", " ", "mass", " ", 
             RowBox[{"ArcTan", "[", 
              RowBox[{"x", "/", "mass"}], "]"}]}]}]}], "]"}]}], ";", "\n", 
        "   ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<r\>\"", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"lp", "/", 
              RowBox[{"(", 
               RowBox[{"2", " ", "b"}], ")"}]}], ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "1"}], "/", "b"}], " ", "+", " ", 
              RowBox[{"a", " ", 
               RowBox[{"lp", "/", 
                RowBox[{"(", 
                 RowBox[{"2", " ", 
                  RowBox[{"b", "^", "2"}]}], ")"}]}]}]}]}], "}"}]}], ",", " ", 
          RowBox[{"\"\<s\>\"", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "1"}], "/", 
              RowBox[{"(", 
               RowBox[{"2", " ", "b"}], ")"}]}], ",", " ", 
             RowBox[{
              RowBox[{"-", "a"}], "/", 
              RowBox[{"(", 
               RowBox[{"2", " ", 
                RowBox[{"b", "^", "2"}]}], ")"}]}]}], "}"}]}], ",", " ", 
          RowBox[{"\"\<lm\>\"", " ", "->", " ", "lm"}], ",", "\n", "     ", 
          RowBox[{"\"\<aq\>\"", " ", "->", " ", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"fp", "[", 
                RowBox[{"lamLL", " ", "-", " ", "#"}], "]"}], " ", "-", " ", 
               RowBox[{"fp", "[", 
                RowBox[{"-", "#"}], "]"}]}], " ", "&"}], ",", " ", "kr"}], 
            "]"}]}], ",", " ", 
          RowBox[{"\"\<g\>\"", " ", "->", " ", "g"}]}], "|>"}]}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"kernIntegral", "[", 
       RowBox[{"kern", ",", " ", "l", ",", " ", "f"}], "]"}], ":", " ", 
      RowBox[{"the", " ", "integral", " ", "over", " ", 
       RowBox[{"q", "'"}], " ", "of", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"q", "'"}], "^", "2"}], "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", 
