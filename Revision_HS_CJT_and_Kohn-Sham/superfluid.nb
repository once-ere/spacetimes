Cell[CellGroupData[{

Cell["\<\
II.4 The first excited states: the linear response of the superfluid\
\>", "Section",ExpressionUUID->"97c6d37c-489d-43e2-9c43-e87d12f87adb"],

Cell[TextData[{
 "A small change of the self-energies with the time dependence ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     RowBox[{"-", 
      StyleBox["i", "TI"]}], "\[Omega]", 
     StyleBox["t", "TI"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c483947c-b322-4f5d-a145-b5a22b62a057"],
 " is described by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["V",
      FontSlant->"Plain"]], "\[LongEqual]", "120"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d9a8af94-734c-442c-b412-ec5bb93fa0c0"],
 " complex amplitudes: the 64 entries of a change ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", 
    StyleBox["N",
     FontFamily->"Helvetica",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a1d5700a-0270-4df1-bb90-f8eb811f3e3f"],
 " of the normal self-energy and the 28 independent entries of each of two \
antisymmetric changes of the pair self-energy (",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", 
    StyleBox["P",
     FontFamily->"Helvetica",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d68fc706-f0a5-40d7-a03a-ceb64740f897"],
 " and the change of its adjoint). The change of the state in answer to a \
change of the self-energies is the response ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Chi]", 
    RowBox[{"(", "\[Omega]", ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dbb6a6b3-a348-487f-b7f7-834e63bc81a8"],
 ", a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"120", "\[Times]", "120"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "528a9fe7-856d-4fe8-82fe-1035093d2caf"],
 " matrix,"
}], "Text",ExpressionUUID->"74dbb15a-f0ca-4746-b708-657f101d8298"],

Cell[BoxData[
 FormBox[
  RowBox[{"\[Chi]", 
   RowBox[{"(", "\[Omega]", ")"}], "\[LongEqual]", 
   UnderscriptBox["\[Sum]", 
    StyleBox["n", "TI"],
    LimitsPositioning->True], 
   RowBox[{"(", 
    RowBox[{
     FractionBox[
      SubscriptBox[
       StyleBox["A",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["n", "TI"]], 
      RowBox[{"\[Omega]", "-", 
       SubscriptBox["\[CapitalOmega]", 
        StyleBox["n", "TI"]]}]], "-", 
     FractionBox[
      SubscriptBox[
       StyleBox["B",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["n", "TI"]], 
      RowBox[{"\[Omega]", "+", 
       SubscriptBox["\[CapitalOmega]", 
        StyleBox["n", "TI"]]}]]}], ")"}], ","}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"561cdd96-c8b3-4aca-9503-3a822d73e18f"],

Cell[TextData[{
 "a sum over the momenta ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "638cc58f-1887-44d2-aeea-a88be6b6fbb9"],
 " of the grid, where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalOmega]", 
     StyleBox["n", "TI"]], "\[LongEqual]", "2", 
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["n", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "78afd114-20fc-4631-a61d-1c129a25324d"],
 " is the energy of a pair of quasi-particles at the momentum ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2b0689e2-b56b-4969-8935-67ee8ab97c89"],
 " (for these states every eigenvalue of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["H",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e528be7e-3968-44aa-8c91-92eeab86db7d"],
 " at a momentum is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["n", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "64943e1e-d25c-434d-b4a5-76b92271ce0a"],
 ", which the cell checks) and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["A",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "26fe5113-e3cb-484e-8a74-d4a22bde1913"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["B",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9bdb4dd6-e75a-4a4d-b2e6-226711b26a67"],
 " are built from the eigenvectors (the creation of two quasi-particles and \
its reverse). The self-energies change by ",
 Cell[BoxData[
  FormBox[
   StyleBox["F",
    FontFamily->"Helvetica",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "25562e2a-1570-4b01-8c43-304ee5528468"],
 " times the change of the state, where ",
 Cell[BoxData[
  FormBox[
   StyleBox["F",
    FontFamily->"Helvetica",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bbad4aeb-b228-4e45-981b-1687c5ebcc42"],
 " is the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"120", "\[Times]", "120"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b810e87e-4877-4746-b271-689745531776"],
 " matrix of the self-energy maps of the contact terms (",
 StyleBox["respKernel",
  FontFamily->"Source Code Pro"],
 "). A collective mode of frequency ",
 Cell[BoxData[
  FormBox["\[Omega]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "02f190e9-7de9-4c4b-a5e6-13a3b2f4e1da"],
 " is a solution of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", "\[LongEqual]", "\[Chi]", 
    RowBox[{"(", "\[Omega]", ")"}], 
    StyleBox["F",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "\[Delta]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "44ce5424-f57d-4562-9dbf-7653ee033296"],
 ": the matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["M",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{"(", "\[Omega]", ")"}], "\[LongEqual]", "\[Chi]", 
    RowBox[{"(", "\[Omega]", ")"}], 
    StyleBox["F",
     FontFamily->"Helvetica",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fa4309cf-8b02-4a10-a255-7f7e6f0987ae"],
 " has the eigenvalue 1. At ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Omega]", "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "70a68805-9951-49b5-a1e1-1650585e9050"],
 " the three broken generators give three Goldstone modes: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["M",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{"(", "0", ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "755b3fee-acaa-45dc-b41a-93c1ab23e5e7"],
 " has the eigenvalue 1 three times. Below the threshold ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["min",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{"2", 
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["gap",
         FontSlant->"Plain"]}]], ",", 
      UnderscriptBox[
       StyleBox["min",
        FontSlant->"Plain"], 
       StyleBox["n", "TI"],
       LimitsPositioning->True], "\[ThinSpace]", 
      SubscriptBox["\[CapitalOmega]", 
       StyleBox["n", "TI"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "00dc2fa3-6290-4880-9d5b-f9cc2f2ae9c5"],
 " the modes are found where the number of real eigenvalues of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["M",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{"(", "\[Omega]", ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f99f70bd-6fe2-4276-8929-982c5390c675"],
 " above 1 changes: a scan of 300 frequencies, then 45 bisections for each \
change. The cell does this for HS ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"1", ",", "1"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "323dbab3-86a4-462a-b0e4-3b66f2316e3a"],
 ", KS and CJT with ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "2", ")"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4cfad976-6b42-4fda-9b80-6ba8fe9efa0d"],
 ", and compares the modes with the Rust program."
}], "Text",ExpressionUUID->"b0c98909-500d-431c-a924-4bcb589f10e3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", "28", " ", "pairs", " ", 
     RowBox[{"(", 
      RowBox[{"i", ",", " ", "j"}], ")"}]}], ",", " ", 
    RowBox[{"i", " ", "<", " ", "j"}], ",", " ", 
    RowBox[{"of", " ", "the", " ", "antisymmetric", " ", "matrices"}], ",", 
    " ", 
    RowBox[{
    "in", " ", "the", " ", "order", " ", "of", " ", "the", " ", "rows"}]}], 
   " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"pairsSF", " ", "=", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "j"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "8"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"j", ",", " ", 
           RowBox[{"i", " ", "+", " ", "1"}], ",", " ", "8"}], "}"}]}], "]"}],
        ",", " ", "1"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"toVec", "[", 
       RowBox[{"x", ",", " ", "a", ",", " ", "b"}], "]"}], ":", " ", 
      RowBox[{"the", " ", "120", " ", "amplitudes", " ", "of", " ", 
       RowBox[{"(", 
        RowBox[{"dN", ",", " ", "dP", ",", " ", 
         RowBox[{"dP", "-", "bar"}]}], ")"}]}], ":", " ", 
      RowBox[{"the", " ", "64", " ", "entries", " ", "of", " ", "x"}]}], ",", 
     " ", 
     RowBox[{"then", " ", 
      RowBox[{"1", "/", "2"}], " ", 
      RowBox[{"(", 
       RowBox[{"a_ij", " ", "-", " ", "a_ji"}], ")"}], " ", "and", " ", 
      RowBox[{"1", "/", "2"}], " ", 
      RowBox[{"(", 
       RowBox[{"b_ij", " ", "-", " ", "b_ji"}], ")"}]}]}], " ", "*)"}], "\n", 
   
   RowBox[{
    RowBox[{
     RowBox[{"toVec", "[", 
      RowBox[{"x_", ",", " ", "a_", ",", " ", "b_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", "x", "]"}], ",", " ", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"0.5", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"a", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}], " ", "-", 
             " ", 
             RowBox[{"a", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "]"}]}], ")"}]}], 
          " ", "&"}], ",", " ", "pairsSF"}], "]"}], ",", " ", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"0.5", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"b", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
                RowBox[{"#", "[", 
