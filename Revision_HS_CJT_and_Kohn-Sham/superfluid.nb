  SequenceForm[
  "PASS ", "WP3-T8 CJT", "  deviation ", "2.765e-13", " (tolerance ", 
   "1.000e-10", "): ", 
   "CJT: the Dirac mass of the superfluid at 0.5 T_c and 0.9 T_c equals that \
at T = 0, 0.1622929325, and the Rust value (largest difference)", 
   "   [the same check: Rust ", "P3-T8 CJT", ", Python ", "YP3-T8 CJT", "]"],
  Editable->False]], "Print",
 CellChangeTimes->{4.004286114845749*^9},
 CellLabel->
  "During evaluation of \
In[343]:=",ExpressionUUID->"925f4f44-0f2e-4c62-96df-840c43594cd8"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"PASS \"\>", "\[InvisibleSpace]", "\<\"WP3-T2 HS_0_0\"\>", 
   "\[InvisibleSpace]", "\<\"  deviation \"\>", 
   "\[InvisibleSpace]", "\<\"9.924e-12\"\>", 
   "\[InvisibleSpace]", "\<\" (tolerance \"\>", 
   "\[InvisibleSpace]", "\<\"1.000e-9\"\>", 
   "\[InvisibleSpace]", "\<\"): \"\>", 
   "\[InvisibleSpace]", "\<\"HS (0, 0): the order parameter of every \
temperature of the table from the gap equation alone (with the Dirac mass \
m_LL, without the self-consistent engine) = Rust (largest difference)\"\>", 
   "\[InvisibleSpace]", "\<\"   [the same check: Rust \"\>", 
   "\[InvisibleSpace]", "\<\"P3-T2 HS_0_0\"\>", 
   "\[InvisibleSpace]", "\<\", Python \"\>", 
   "\[InvisibleSpace]", "\<\"YP3-T4\"\>", "\[InvisibleSpace]", "\<\"]\"\>"}],
  SequenceForm[
  "PASS ", "WP3-T2 HS_0_0", "  deviation ", "9.924e-12", " (tolerance ", 
   "1.000e-9", "): ", 
   "HS (0, 0): the order parameter of every temperature of the table from the \
gap equation alone (with the Dirac mass m_LL, without the self-consistent \
engine) = Rust (largest difference)", "   [the same check: Rust ", 
   "P3-T2 HS_0_0", ", Python ", "YP3-T4", "]"],
  Editable->False]], "Print",
 CellChangeTimes->{4.00428611487285*^9},
 CellLabel->
  "During evaluation of \
In[343]:=",ExpressionUUID->"c460ab25-9dc1-4809-9b41-0a211011d3e9"]
