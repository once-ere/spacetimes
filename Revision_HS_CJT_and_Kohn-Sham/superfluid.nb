           RowBox[{"[", 
            RowBox[{"a", ",", " ", "p"}], "]"}], "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"a", ",", " ", "3"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"p", ",", " ", "4"}], "}"}]}], "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"eqsYM", " ", "=", " ", 
     RowBox[{"EulerEquations", "[", 
      RowBox[{"lYM", ",", " ", 
       RowBox[{"Flatten", "[", "wF", "]"}], ",", " ", "xs"}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"the", " ", "claimed", " ", 
     RowBox[{"form", ":", " ", 
      RowBox[{
       RowBox[{"sum_p", " ", "d_p", " ", 
        RowBox[{"F", "^", 
         RowBox[{"(", 
          RowBox[{"a", ",", 
           RowBox[{"p", " ", 
            RowBox[{"p", "'"}]}]}], ")"}]}]}], " ", "-", " ", 
       RowBox[{"g", " ", "sum", " ", "eps_abc", " ", 
        RowBox[{"W", "^", "b_p"}], " ", 
        RowBox[{"F", "^", 
         RowBox[{"(", 
          RowBox[{"c", ",", 
           RowBox[{"p", " ", 
            RowBox[{"p", "'"}]}]}], ")"}]}]}], " ", "-", " ", 
       RowBox[{"g", " ", 
        RowBox[{"J", "^", 
         RowBox[{"(", 
          RowBox[{"a", ",", 
           RowBox[{"p", "'"}]}], ")"}]}], " ", "must", " ", "equal", " ", 
        "lhs"}], " ", "-", " ", "rhs"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"fUp", "[", 
      RowBox[{"c_", ",", " ", "p_", ",", " ", "pp_"}], "]"}], " ", ":=", " ", 
     
     RowBox[{
      RowBox[{"etaD", "[", 
       RowBox[{"[", "p", "]"}], "]"}], " ", 
      RowBox[{"etaD", "[", 
       RowBox[{"[", "pp", "]"}], "]"}], " ", 
      RowBox[{"fYM", "[", 
       RowBox[{"[", 
        RowBox[{"c", ",", " ", "p", ",", " ", "pp"}], "]"}], "]"}]}]}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"claimedYM", " ", "=", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"fUp", "[", 
              RowBox[{"a", ",", " ", "p", ",", " ", "pp"}], "]"}], ",", " ", 
             RowBox[{"xs", "[", 
              RowBox[{"[", "p", "]"}], "]"}]}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"p", ",", " ", "4"}], "}"}]}], "]"}], " ", "-", " ", 
         RowBox[{"gYM", " ", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"levi", "[", 
              RowBox[{"a", ",", " ", "b", ",", " ", "c"}], "]"}], " ", 
             RowBox[{"wF", "[", 
              RowBox[{"[", 
               RowBox[{"b", ",", " ", "p"}], "]"}], "]"}], " ", 
             RowBox[{"fUp", "[", 
              RowBox[{"c", ",", " ", "p", ",", " ", "pp"}], "]"}]}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"b", ",", " ", "3"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"c", ",", " ", "3"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"p", ",", " ", "4"}], "}"}]}], "]"}]}], " ", "-", "\n", 
         "      ", 
         RowBox[{"gYM", " ", 
          RowBox[{"jF", "[", 
           RowBox[{"[", 
            RowBox[{"a", ",", " ", "pp"}], "]"}], "]"}]}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"a", ",", " ", "3"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"pp", ",", " ", "4"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
   
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
      "EulerEquations", " ", "writes", " ", "each", " ", "equation", " ", 
       "as", " ", "lhs"}], " ", "==", " ", "rhs"}], ";", " ", 
     RowBox[{"lhs", " ", "-", " ", 
      RowBox[{
      "rhs", " ", "is", " ", "compared", " ", "with", " ", "the", " ", 
       "claimed", " ", "form", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{
          "an", " ", "equation", " ", "is", " ", "the", " ", "same", "\n", 
           "   ", "equation", " ", "when", " ", "lhs"}], " ", "-", " ", 
          RowBox[{
          "rhs", " ", "equals", " ", "the", " ", "claimed", " ", "form", " ", 
           "or", " ", "its", " ", "negative"}]}], ";", " ", 
         RowBox[{
         "the", " ", "sign", " ", "that", " ", "occurred", " ", "is", " ", 
          "reported"}]}], ")"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"lhsYM", " ", "=", " ", 
     RowBox[{
      RowBox[{"eqsYM", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], " ", "-", " ", 
      RowBox[{"eqsYM", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"signYM", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Which", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Expand", "[", 
           RowBox[{
            RowBox[{"lhsYM", "[", 
             RowBox[{"[", "k", "]"}], "]"}], " ", "-", " ", 
            RowBox[{"claimedYM", "[", 
             RowBox[{"[", "k", "]"}], "]"}]}], "]"}], " ", "===", " ", "0"}], 
         ",", " ", "1", ",", " ", 
         RowBox[{
          RowBox[{"Expand", "[", 
           RowBox[{
            RowBox[{"lhsYM", "[", 
             RowBox[{"[", "k", "]"}], "]"}], " ", "+", " ", 
            RowBox[{"claimedYM", "[", 
             RowBox[{"[", "k", "]"}], "]"}]}], "]"}], " ", "===", " ", "0"}], 
         ",", " ", 
         RowBox[{"-", "1"}], ",", " ", "True", ",", " ", "0"}], "]"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", 
         RowBox[{"Length", "[", "lhsYM", "]"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"checkTrue", "[", 
     RowBox[{"\"\<WE-14\>\"", ",", 
      " ", "\"\<symbolic Euler-Lagrange equations of the Yang-Mills \
Lagrangian with the source: d_p W^(a,p p') - g eps_abc W^b_p W^(c,p p') = g \
j^(a,p') (12 components)\>\"", ",", "\n", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "eqsYM", "]"}], " ", "==", " ", "12"}], " ", "&&",
        " ", 
       RowBox[{"FreeQ", "[", 
        RowBox[{"signYM", ",", " ", "0"}], "]"}]}], ",", " ", 
