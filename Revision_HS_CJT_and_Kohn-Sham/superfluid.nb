Cell[CellGroupData[{

Cell["\<\
I.3 The spinor field and the Dirac field (item 2); theorem D1\
\>", "Section",ExpressionUUID->"aa754e1f-1f9d-443d-9651-5825a93b84e7"],

Cell[TextData[{
 "A two-component spinor transforms under the unit bi-quaternion ",
 Cell[BoxData[
  FormBox[
   StyleBox["g",
    FontWeight->"Bold",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7ac8ecc5-95cd-4b2e-907e-3100f36c90c7"],
 " as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Chi]", "\[RightTeeArrow]", 
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[Chi]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "76c16348-6d52-47a2-8e46-2a5d57d0b82a"],
 " (or, for the other kind, with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     OverscriptBox[
      StyleBox["g",
       FontWeight->"Bold",
       FontSlant->"Plain"], "~"], ")"}], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["M", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"]], 
       SuperscriptBox[
        RowBox[{"(", 
         StyleBox["g",
          FontWeight->"Bold",
          FontSlant->"Plain"], ")"}], "\[Dagger]"]}], ")"}], 
     RowBox[{"-", "1"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e261e549-282e-486d-a496-00dd721e82d1"],
 "). The Dirac matrices of a frame ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    StyleBox["p", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "96751404-f043-438d-8f97-b8aafe1c34dc"],
 " are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p", "TI"]], 
    RowBox[{"[", 
     StyleBox["f",
      FontWeight->"Bold",
      FontSlant->"Plain"], "]"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4c65b6f4-9aeb-4512-a00c-e739d0bfd5d3"],
 " with the blocks ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubscriptBox[
      StyleBox["f",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      StyleBox["p", "TI"]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "40b40cc9-27ac-4eee-83c8-9586a5b7d401"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["f",
        FontWeight->"Bold",
        FontSlant->"Plain"], "_"], 
      StyleBox["p", "TI"]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "121b3e24-65c5-4dda-8d93-10ee7758751f"],
 " off the diagonal; the spinor matrix is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["S",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[LongEqual]", 
    StyleBox["diag",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      RowBox[{"(", 
       OverscriptBox[
        StyleBox["g",
         FontWeight->"Bold",
         FontSlant->"Plain"], "~"], ")"}], ",", 
      SubscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      RowBox[{"(", 
       StyleBox["g",
        FontWeight->"Bold",
        FontSlant->"Plain"], ")"}]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3c227fa6-c1f9-4c8f-a39d-8d2dc3d535c1"],
 ", and"
}], "Text",ExpressionUUID->"d5e900ee-fd98-462a-bf24-dac0bfc95924"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["S",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   SuperscriptBox[
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    RowBox[{"-", "1"}]], 
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p", "TI"]], 
   SubscriptBox[
    StyleBox["S",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   RowBox[{"(", 
    StyleBox["g",
     FontWeight->"Bold",
     FontSlant->"Plain"], ")"}], "\[LongEqual]", 
   UnderscriptBox["\[Sum]", 
    SuperscriptBox[
     StyleBox["p", "TI"], "\[Prime]"],
    LimitsPositioning->True], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["L",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["p", "TI"], 
     SuperscriptBox[
      StyleBox["p", "TI"], "\[Prime]"]}]], 
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    SuperscriptBox[
     StyleBox["p", "TI"], "\[Prime]"]], ",", "      ", 
   SubscriptBox[
    StyleBox["S",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   SuperscriptBox[
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[Dagger]"], 
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], "0"], 
   SubscriptBox[
    StyleBox["S",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   RowBox[{"(", 
    StyleBox["g",
     FontWeight->"Bold",
     FontSlant->"Plain"], ")"}], "\[LongEqual]", 
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], "0"], ",", "      ", 
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p", "TI"]], 
   RowBox[{"[", 
    SuperscriptBox[
     StyleBox["f",
      FontWeight->"Bold",
      FontSlant->"Plain"], "\[Prime]"], "]"}], "\[LongEqual]", 
   SubscriptBox[
    StyleBox["S",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   RowBox[{"(", 
    StyleBox["g",
     FontWeight->"Bold",
     FontSlant->"Plain"], ")"}], "\[ThinSpace]", 
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p", "TI"]], 
   RowBox[{"[", 
    StyleBox["f",
     FontWeight->"Bold",
     FontSlant->"Plain"], "]"}], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["S",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   SuperscriptBox[
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    RowBox[{"-", "1"}]]}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"d258c823-4fff-47b1-88b2-5f33eb878e04"],

Cell[TextData[{
 "for the transformed frame ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["f",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["p", "TI"], "\[Prime]"], "\[LongEqual]", 
    OverscriptBox[
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], "~"], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["f",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["p", "TI"]], "\[ThinSpace]", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["g",
       FontWeight->"Bold",
       FontSlant->"Plain"], "~"], "\[Dagger]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "708fffc5-cdb4-4b45-94bb-482003e154f5"],
 " (equations (3.8) and (3.9) of the manuscript). The spinor field ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "20babf70-c5d2-4172-895e-0ff7b00fa9a1"],
 " is the Dirac isodoublet: eight anticommuting components, made of two \
spinor charges of the super-loop; it transforms as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[RightTeeArrow]", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["S",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      RowBox[{"(", 
       StyleBox["g",
        FontWeight->"Bold",
        FontSlant->"Plain"], ")"}], "\[CircleTimes]", 
      SubscriptBox[
       StyleBox["1",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], "2"]}], ")"}], 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5123a140-1a8c-4387-99e1-ab20d7e82fd7"],
 ", its isospin generators are ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e698888c-0f90-4d11-9653-6e33aa0555bc"],
 ", its fermion number is 1, and its mass term ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubscriptBox[
     OverscriptBox["\[CapitalPsi]", "_"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e849ec24-8c9d-4b8a-93c5-9207b5615286"],
 " is invariant under all of GEE."
}], "Text",ExpressionUUID->"e030e370-3c27-467e-8bd1-56fa8ed520e2"],

Cell[TextData[{
 StyleBox["Theorem D1.",
  FontWeight->"Bold"],
 " A single Dirac field with four components, on which ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["v",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "36e34ba9-c863-45f9-9fce-df241dae0565"],
 " acts by a non-trivial linear representation that commutes with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SL", "TI"], 
    RowBox[{"(", 
     RowBox[{"2", ",", 
      StyleBox["\[DoubleStruckCapitalC]",
       FontSlant->"Plain"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a905808d-a814-4ba6-a86e-ca4091a6840b"],
 " and keeps the kinetic term, has no Lorentz-invariant bilinear without \
derivatives (no Dirac, pseudoscalar or Majorana mass) that is invariant under \
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["v",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7ac8f7af-5950-44da-84c6-1f7336b7bbb4"],
 ". The reason: the two left-handed Weyl spinors ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Psi]", "-"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "be9dc35f-d957-47cb-abe9-9317c8c1968c"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["E",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SuperscriptBox["\[Psi]", "+"], ")"}], "*"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "82755d11-1f22-414e-a32c-485fa27b13f6"],
 " of the Dirac field form an isospin doublet (the group of Pauli and G\
\[CapitalATilde]\.bcrsey), and the Lorentz-invariant bilinears ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Xi]", 
     StyleBox["f", "TI"], 
     StyleBox["T", "TI"]], 
    SubscriptBox[
     StyleBox["E",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubscriptBox["\[Xi]", 
     SuperscriptBox[
      StyleBox["f", "TI"], "\[Prime]"]]}], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d6b17728-6140-4263-8f55-424a69930d93"],
 " are symmetric in the doublet indices, an isospin triplet, which contains \
no invariant. This is why the spinor field of the solution is an isodoublet \
of Dirac fields. The next cell repeats the finite part of the proof as a \
computation: on the eight operators ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["\[Psi]", "1"], ",", "\[Ellipsis]", ",", 
     SubscriptBox["\[Psi]", "4"], ",", 
     SubsuperscriptBox["\[Psi]", "1", "\[Dagger]"], ",", "\[Ellipsis]", ",", 
     SubsuperscriptBox["\[Psi]", "4", "\[Dagger]"]}], ")"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "562d27d5-614c-40bf-b81f-d0bdfd66374f"],
 " of one point, a bilinear ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["\[GothicN]",
      FontSlant->"Plain"], 
     StyleBox["T", "TI"]], 
    StyleBox["\[GothicCapitalQ]",
     FontSlant->"Plain"], 
    StyleBox["\[GothicN]",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ebf7814a-a03c-40df-939f-66be12ea13a9"],
 " with an antisymmetric ",
 Cell[BoxData[
  FormBox[
   RowBox[{"8", "\[Times]", "8"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ef108c36-ee4d-4df9-ad1c-40df3aa94539"],
 " matrix ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[GothicCapitalQ]",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0d8ec593-6c1b-447c-88da-b04cbe02fa95"],
 " is invariant under a group exactly when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["\[GothicCapitalX]",
      FontSlant->"Plain"], 
     StyleBox["T", "TI"]], 
    StyleBox["\[GothicCapitalQ]",
     FontSlant->"Plain"], "+", 
    StyleBox["\[GothicCapitalQ]",
     FontSlant->"Plain"], 
    StyleBox["\[GothicCapitalX]",
     FontSlant->"Plain"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ae308086-99d3-453b-a63e-4ce8548474e2"],
 " for every generator ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[GothicCapitalX]",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a6e2a502-2457-4862-acf5-fe97f3c7e0bc"],
 "; the dimension of the space of such ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[GothicCapitalQ]",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ac4a8d7f-4895-4b9d-98e2-ee92b43bf1b6"],
 " is ",
 Cell[BoxData[
  FormBox["28", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "57701be9-d8ec-4333-8d4c-c519303f2051"],
 " minus the rank of these linear conditions. With exact arithmetic: \
dimension 6 for the Lorentz group, 0 for the Lorentz group together with the \
Pauli-G\[CapitalATilde]\.bcrsey ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    RowBox[{"(", "2", ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d8774070-014b-4a98-a25f-9f9c73ba57e0"],
 "."
}], "Text",ExpressionUUID->"8ab9902d-ca8d-4b5e-82aa-9159255aacc1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"F", "-", "2"}], ":", " ", 
      RowBox[{"the", " ", "Clifford", " ", "algebra", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"gamma", "^", "p"}], ",", " ", 
         RowBox[{"gamma", "^", "q"}]}], "}"}]}]}], " ", "=", " ", 
     RowBox[{"2", " ", 
      RowBox[{"eta", "^", "pq"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"C", " ", 
      RowBox[{"gamma", "^", "p"}], " ", 
      RowBox[{"C", "^", "dag"}]}], " ", "=", " ", 
     RowBox[{"-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"gamma", "^", "p"}], ")"}], "^", "T"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"gamma", "^", "ch"}], " ", "=", " ", 
     RowBox[{"diag", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "1"}], ",", "1", ",", "1"}], ")"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"C", "^", "T"}], " ", "=", " ", 
     RowBox[{
      RowBox[{"-", "C"}], " ", 
      RowBox[{"(", "exact", ")"}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"dF2", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Flatten", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"gam", "[", "p", "]"}], " ", ".", " ", 
              RowBox[{"gam", "[", "q", "]"}]}], " ", "+", " ", 
             RowBox[{
              RowBox[{"gam", "[", "q", "]"}], " ", ".", " ", 
              RowBox[{"gam", "[", "p", "]"}]}], " ", "-", " ", 
             RowBox[{"2", " ", 
              RowBox[{"etaLL", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"p", " ", "+", " ", "1"}], ",", " ", 
                 RowBox[{"q", " ", "+", " ", "1"}]}], "]"}], "]"}], " ", 
              RowBox[{"IdentityMatrix", "[", "4", "]"}]}]}], "]"}], ",", " ", 
           
           RowBox[{"{", 
            RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"q", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}], ",", 
         "\n", "     ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"cLL", " ", ".", " ", 
              RowBox[{"gam", "[", "p", "]"}], " ", ".", " ", 
              RowBox[{"ConjugateTranspose", "[", "cLL", "]"}]}], " ", "+", 
             " ", 
             RowBox[{"Transpose", "[", 
              RowBox[{"gam", "[", "p", "]"}], "]"}]}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}], ",", 
         "\n", "     ", 
         RowBox[{"Abs", "[", 
          RowBox[{"gch", " ", "-", " ", 
           RowBox[{"DiagonalMatrix", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", " ", 
              RowBox[{"-", "1"}], ",", " ", "1", ",", " ", "1"}], "}"}], 
            "]"}]}], "]"}], ",", " ", 
         RowBox[{"Abs", "[", 
          RowBox[{"cLL", " ", "+", " ", 
           RowBox[{"Transpose", "[", "cLL", "]"}]}], "]"}]}], "}"}], "]"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WF-2\>\"", ",", 
      " ", "\"\<Clifford algebra, chirality, charge conjugation (exact)\>\"", 
      ",", " ", "dF2", ",", " ", "0", ",", " ", "\"\<F-2\>\"", ",", 
      " ", "\"\<F-2\>\""}], "]"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"F", "-", 
      RowBox[{"3", "a"}]}], ",", " ", 
     RowBox[{"F", "-", 
      RowBox[{"3", "b"}]}], ",", " ", 
     RowBox[{"F", "-", 
      RowBox[{"3", 
       RowBox[{"d", ":", " ", 
        RowBox[{
         RowBox[{
         "the", " ", "spinor", " ", "matrices", " ", "of", " ", "200", " ", 
          "random", " ", "unit", " ", "bi"}], "-", 
         RowBox[{"quaternions", " ", 
          RowBox[{"(", 
           RowBox[{"floating", " ", "point"}], ")"}]}]}]}]}]}]}], " ", "*)"}],
    "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dF3a", ",", " ", "dF3b", ",", " ", "dF3d"}], "}"}], " ", "=", 
     " ", 
     RowBox[{"{", 
      RowBox[{"0.", ",", " ", "0.", ",", " ", "0."}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"mg", " ", "=", " ", 
           RowBox[{"randUnitBiq", "[", "]"}]}], ",", " ", "s", ",", " ", "si",
           ",", " ", "lg", ",", " ", "mgt", ",", " ", "gf"}], "}"}], ",", 
        "\n", "   ", 
        RowBox[{
         RowBox[{"s", " ", "=", " ", 
          RowBox[{"sSpin", "[", "mg", "]"}]}], ";", " ", 
         RowBox[{"si", " ", "=", " ", 
          RowBox[{"Inverse", "[", "s", "]"}]}], ";", " ", 
         RowBox[{"lg", " ", "=", " ", 
          RowBox[{"lorentzMatrix", "[", "mg", "]"}]}], ";", " ", 
         RowBox[{"mgt", " ", "=", " ", 
          RowBox[{"Inverse", "[", 
           RowBox[{"ConjugateTranspose", "[", "mg", "]"}], "]"}]}], ";", "\n",
          "   ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"dF3a", " ", "=", " ", 
             RowBox[{"Max", "[", 
              RowBox[{"dF3a", ",", " ", 
               RowBox[{"Max", "[", 
                RowBox[{"Abs", "[", 
                 RowBox[{
                  RowBox[{"si", " ", ".", " ", 
                   RowBox[{"gam", "[", "p", "]"}], " ", ".", " ", "s"}], " ", 
                  "-", " ", 
                  RowBox[{"Sum", "[", 
                   RowBox[{
