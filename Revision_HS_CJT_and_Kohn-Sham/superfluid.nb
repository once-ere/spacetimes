Cell[CellGroupData[{

Cell["III.T.4 The critical temperature", "Section",ExpressionUUID->"d265b8d7-3504-4c81-bae2-17dc5b3ac160"],

Cell[TextData[{
 StyleBox["The effective couplings.",
  FontWeight->"Bold"],
 " A uniform scalar density ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["S",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2a2aadb1-f27a-46bb-8303-37776c73f28b"],
 " shifts the Dirac mass by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["S",
       FontSlant->"Plain"]}]], 
    SubsuperscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["S",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "544c0453-9546-4c06-86ab-349350f6e9f6"],
 ", and a pair amplitude in the channel ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f756af1c-ec75-4174-a478-995e05fcc82d"],
 " produces the pair self-energy with the strength ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["P",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0f5cb5b4-fb6e-4fe0-9ac6-cf07628b9af8"],
 " (Section II.3). For a state with the Dirac mass ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["M", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["D",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "06552c3a-0a71-414c-9cde-ba1aa0dbd608"],
 " and the pair field ",
 Cell[BoxData[
  FormBox["\[CapitalPhi]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "45844262-3dd5-4d7c-aff5-f69c66909112"],
 " at the temperature ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2930bad1-3a56-418b-a9ed-4c8fa0b9c38d"],
 " the scalar density is"
}], "Text",ExpressionUUID->"0a1c94c1-78f5-4c2d-beda-796cd2837c5b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["S",
     FontSlant->"Plain"]], "\[LongEqual]", 
   RowBox[{"-", 
    FractionBox["2", 
     SuperscriptBox["\[Pi]", "2"]]}], 
   RowBox[{"[", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["M", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["X", "TI"], ",", 
       StyleBox["D",
        FontSlant->"Plain"]}]], "\[ThinSpace]", 
     SubsuperscriptBox[
      StyleBox["I", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{"(", "1", ")"}]], 
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["E", "TI"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["X", "TI"], ",", 
         StyleBox["gap",
          FontSlant->"Plain"]}]], ",", 
       StyleBox["T", "TI"]}], ")"}], "-", 
     SubscriptBox[
      StyleBox["m", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"]], 
     SubsuperscriptBox[
      StyleBox["I", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{"(", "1", ")"}]], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["m", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"]], ",", "0"}], ")"}]}], "]"}], ",", "      ", 
   SubsuperscriptBox[
    StyleBox["I", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "1", ")"}]], 
   RowBox[{"(", 
    RowBox[{
     StyleBox["M", "TI"], ",", 
     StyleBox["T", "TI"]}], ")"}], "\[LongEqual]", 
   SubsuperscriptBox["\[Integral]", "0", 
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]], "\[ThinSpace]", 
   FractionBox[
    RowBox[{
     SuperscriptBox[
      StyleBox["q", "TI"], "2"], "\[ThinSpace]", 
     StyleBox["tanh",
      FontSlant->"Plain"], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["E", "TI"], 
        StyleBox["M", "TI"]], "/", "2", 
       StyleBox["T", "TI"]}], ")"}]}], 
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["M", "TI"]]], "\[ThinSpace]", 
   StyleBox["dq", "TI"], ","}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"896b502c-d581-4b7a-9c67-3ef720844b78"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["M", "TI"]], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        StyleBox["q", "TI"], "2"], "+", 
       SuperscriptBox[
        StyleBox["M", "TI"], "2"]}], ")"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6b70fb54-136a-4f03-83a0-e87f5bfc2b59"],
 " and the gap ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["gap",
       FontSlant->"Plain"]}]], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox[
          StyleBox["M", "TI"], 
          StyleBox["SF",
           FontSlant->"Plain"], 
          RowBox[{
           StyleBox["X", "TI"], ",", 
           StyleBox["D",
            FontSlant->"Plain"]}]], ")"}], "2"], "+", 
       SuperscriptBox["\[CapitalPhi]", "2"]}], ")"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8653a240-c982-4713-8350-7fa4397cd84f"],
 "; the factor ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["tanh",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["E", "TI"], "/", "2", 
      StyleBox["T", "TI"]}], ")"}], "\[LongEqual]", "1", "-", "2", 
    StyleBox["f", "TI"], 
    RowBox[{"(", 
     StyleBox["E", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "64ea5533-2709-4680-99af-a6e9a666c6cf"],
 " is the thermal factor of a pair of quasi-particles, and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["I", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{"(", "1", ")"}]], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["M", "TI"], ",", "0"}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "23518061-f11e-47b5-ab98-6e147e945fe2"],
 " is the integral of Part II. The Dirac mass is self-consistent when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["D",
       FontSlant->"Plain"]}]], "-", 
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["S",
       FontSlant->"Plain"]}]], 
    SubsuperscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["S",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f2b33ea5-67b8-4ee9-af40-7a192f072712"],
 ". ",
 StyleBox["The normal state and its instability.",
  FontWeight->"Bold"],
 " The normal state at ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "67951db2-b53a-4dee-9b3f-479be63a51fb"],
 " has no pair field and the Dirac mass ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["n",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4e70340b-8910-4d51-aa1f-ccfa2e8e04af"],
 " that solves this condition with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPhi]", "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "49fe2cb6-a186-4795-9642-11b1b5737b6b"],
 ": ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4bb77aff-119e-4bb0-a9a5-c68d70ff79c1"],
 " at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5d937a54-0615-4ac6-9dd6-e336f5e4a677"],
 "; at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], ">", "0"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "38900846-64d1-422e-b9fc-2379fb787bea"],
 " the thermally excited particles and antiparticles change the scalar \
density, which shifts the mass where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["S",
       FontSlant->"Plain"]}]], "\[NotEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "aa475a08-4d0f-4336-a59f-67c3e7a1e59f"],
 ". A small pair field in the normal state is amplified by the factor"
}], "Text",ExpressionUUID->"0f6bca71-0836-479a-8522-19b51f9da149"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["\[Lambda]", 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["P",
     FontSlant->"Plain"]], 
   RowBox[{"(", 
    StyleBox["T", "TI"], ")"}], "\[LongEqual]", 
   FractionBox[
    RowBox[{
     SubsuperscriptBox[
      StyleBox["g", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["X", "TI"], ",", 
       StyleBox["P",
        FontSlant->"Plain"]}]], "\[ThinSpace]", 
     SubsuperscriptBox[
      StyleBox["I", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{"(", "1", ")"}]], 
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["M", "TI"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["X", "TI"], ",", 
         StyleBox["n",
          FontSlant->"Plain"]}]], 
       RowBox[{"(", 
        StyleBox["T", "TI"], ")"}], ",", 
       StyleBox["T", "TI"]}], ")"}]}], 
    SuperscriptBox["\[Pi]", "2"]], ","}], TraditionalForm]], "DisplayFormula",\

 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"ad91fe94-adfe-4b38-bcf7-d7343c2e8258"],

Cell[TextData[{
 "the eigenvalue of the static pair response of the normal state: the normal \
state is unstable towards a superfluid when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Lambda]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["P",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}], ">", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c81704df-353d-49eb-b32d-943a568dffad"],
 " (the criterion of Thouless). The ",
 StyleBox["critical temperature",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "54d5c4ca-15a9-486c-aad1-88d3dfeba5ae"],
 " solves ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Lambda]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["P",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["T", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["X", "TI"], ",", 
       StyleBox["c",
        FontSlant->"Plain"]}]], ")"}], "\[LongEqual]", "1"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b4efcb0b-bfa0-4238-a9aa-a49338d3c4a1"],
 ". The next cell computes ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["n",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1a853540-bcb9-407e-a891-2e4c786c6320"],
 " from the scalar self-consistency alone (bisection), ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Lambda]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["P",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "25799dec-1fdf-402b-a359-012c4a7e9b0a"],
 " with the integral on the radial nodes of the grid of Part II, and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "df392361-a164-4f19-94ed-4ae45dd9f3d6"],
 " by bisection; for the three methods with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["S",
       FontSlant->"Plain"]}]], "\[NotEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fa6fa2cc-526d-4298-82d1-999dd0dbe223"],
 " it compares ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["n",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["T", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["X", "TI"], ",", 
       StyleBox["c",
        FontSlant->"Plain"]}]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b89ab44b-cc27-484e-bbcc-1c6db651989b"],
 " with the normal state of the thermal engine. It then shows that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Lambda]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["P",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b9f7fd03-84f6-4614-bf55-87c11b6f390d"],
 " does not increase from ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0.01"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6e6732d8-bd9f-489f-a3cf-606928a06fb5"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0.6"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "96fa5eed-d58f-41e1-b141-f1a48e103120"],
 ", so that ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cfe478bf-ff96-450d-84b3-68048556b237"],
 " is the only solution there."
}], "Text",ExpressionUUID->"a36a23cb-6f46-49c5-a6fa-041d70310905"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"i1Grid", "[", 
       RowBox[{"mo", ",", " ", "s", ",", " ", "t"}], "]"}], ":", " ", "I1"}], 
     " ", "=", " ", 
     RowBox[{
      RowBox[{"int_", 
       RowBox[{"0", "^", "Lambda"}], " ", 
       RowBox[{"q", "^", "2"}], " ", "tanh", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"E", "/", "2"}], "t"}], ")"}], "/", "E"}], " ", "dq", " ", 
       "with", " ", "E"}], " ", "=", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"q", "^", "2"}], " ", "+", " ", "s"}], ")"}], "^", 
       RowBox[{"(", 
        RowBox[{"1", "/", "2"}], ")"}]}]}]}], ",", " ", 
    RowBox[{
    "on", " ", "the", " ", "radial", " ", "nodes", " ", "of", " ", "the", " ",
      "grid"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"i1Grid", "[", 
      RowBox[{"mo_", ",", " ", "s_", ",", " ", "t_"}], "]"}], " ", ":=", " ", 
     
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"kr", " ", "=", " ", 
          RowBox[{
           RowBox[{"mo", "[", "\"\<g\>\"", "]"}], "[", "\"\<kr\>\"", "]"}]}], 
         ",", " ", 
         RowBox[{"wr", " ", "=", " ", 
          RowBox[{
           RowBox[{"mo", "[", "\"\<g\>\"", "]"}], "[", "\"\<wr\>\"", "]"}]}], 
         ",", " ", "e"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"e", " ", "=", " ", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{"kr", "^", "2"}], " ", "+", " ", "s"}], "]"}]}], ";", "\n",
         "   ", 
        RowBox[{"Total", "[", 
         RowBox[{"wr", " ", 
          RowBox[{"kr", "^", "2"}], " ", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"t", " ", ">", " ", "0"}], ",", " ", 
             RowBox[{"Tanh", "[", 
              RowBox[{"e", "/", 
               RowBox[{"(", 
                RowBox[{"2", " ", "t"}], ")"}]}], "]"}], ",", " ", "1."}], 
            "]"}], "/", "e"}]}], "]"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"thCoup", "[", "t", "]"}], ":", " ", 
     RowBox[{"the", " ", "effective", " ", "couplings", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"g", "^", "S"}], ",", " ", 
        RowBox[{"g", "^", "P"}]}], "}"}], " ", "of", " ", "the", " ", 
      "method", " ", "t", " ", "for", " ", 
      RowBox[{"V", "^", 
       RowBox[{"(", "2", ")"}]}], " ", 
      RowBox[{"(", 
       RowBox[{"Part", " ", "II"}], ")"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"thCoup", "[", "t_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"thCoup", "[", "t", "]"}], " ", "=", " ", 
      RowBox[{"effCouplings", "[", 
       RowBox[{
        RowBox[{"Lookup", "[", 
         RowBox[{
          RowBox[{"AssociationThread", "[", 
           RowBox[{
            RowBox[{"shortName", " ", "/@", " ", "methodsSF"}], ",", " ", 
            "methodsSF"}], "]"}], ",", " ", "t"}], "]"}], ",", " ", 
        RowBox[{"Sequence", " ", "@@", " ", 
         RowBox[{"potentialsSF", "[", "\"\<V2\>\"", "]"}]}]}], "]"}]}]}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"thMassN", "[", 
       RowBox[{"t", ",", " ", "T"}], "]"}], ":", " ", 
      RowBox[{
       RowBox[{
       "the", " ", "Dirac", " ", "mass", " ", "of", " ", "the", " ", "normal",
         " ", "state", " ", "at", " ", "the", " ", "temperature", " ", "T", " ",
         "from", " ", "M"}], " ", "-", " ", "m"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"g", "^", "S"}], " ", 
      RowBox[{"n", "^", "S"}], " ", 
      RowBox[{"(", 
       RowBox[{"bisection", " ", 
        RowBox[{"on", " ", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"1", "e"}], "-", "6"}], ",", " ", "2"}], "]"}]}], 
       ")"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"thMassN", "[", 
      RowBox[{"t_", ",", " ", "temp_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"mo", " ", "=", " ", 
          RowBox[{"thModel", "[", "t", "]"}]}], ",", " ", 
         RowBox[{"gs", " ", "=", " ", 
          RowBox[{
           RowBox[{"thCoup", "[", "t", "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
         RowBox[{"lo", " ", "=", " ", 
          RowBox[{"10.", "^", 
           RowBox[{"-", "6"}]}]}], ",", " ", 
         RowBox[{"hi", " ", "=", " ", "2."}], ",", " ", "mid", ",", " ", 
         "i1m"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", "gs", "]"}], " ", "<", " ", 
           RowBox[{"10", "^", 
            RowBox[{"-", "14"}]}]}], ",", " ", 
          RowBox[{"Return", "[", 
           RowBox[{
            RowBox[{"N", "[", "mLL", "]"}], ",", " ", "Module"}], "]"}]}], 
         "]"}], ";", "\n", "   ", 
        RowBox[{"i1m", " ", "=", " ", 
         RowBox[{"i1Grid", "[", 
          RowBox[{"mo", ",", " ", 
           RowBox[{
            RowBox[{"N", "[", "mLL", "]"}], "^", "2"}], ",", " ", "0."}], 
          "]"}]}], ";", "\n", "   ", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"mid", " ", "=", " ", 
            RowBox[{"0.5", " ", 
             RowBox[{"(", 
              RowBox[{"lo", " ", "+", " ", "hi"}], ")"}]}]}], ";", "\n", 
           "     ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"mid", " ", "-", " ", "mLL", " ", "+", " ", 
               RowBox[{"gs", " ", 
                RowBox[{"2", "/", 
                 RowBox[{"Pi", "^", "2"}]}], " ", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"mid", " ", 
                   RowBox[{"i1Grid", "[", 
                    RowBox[{"mo", ",", " ", 
                    RowBox[{"mid", "^", "2"}], ",", " ", "temp"}], "]"}]}], 
                  " ", "-", " ", 
                  RowBox[{"mLL", " ", "i1m"}]}], ")"}]}]}], " ", ">", " ", 
              "0"}], ",", " ", 
             RowBox[{"hi", " ", "=", " ", "mid"}], ",", " ", 
             RowBox[{"lo", " ", "=", " ", "mid"}]}], "]"}]}], ",", " ", 
          RowBox[{"{", "80", "}"}]}], "]"}], ";", "\n", "   ", 
        RowBox[{"0.5", " ", 
         RowBox[{"(", 
          RowBox[{"lo", " ", "+", " ", "hi"}], ")"}]}]}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"thLam", "[", 
       RowBox[{"t", ",", " ", "T"}], "]"}], ":", " ", 
      RowBox[{
       RowBox[{"lambda", "^", "P"}], 
       RowBox[{"(", "T", ")"}], " ", "of", " ", "the", " ", "normal", " ", 
       "state"}]}], ";", " ", 
     RowBox[{
      RowBox[{"thTc", "[", "t", "]"}], ":", " ", 
      RowBox[{
      "the", " ", "critical", " ", "temperature", " ", "by", " ", "bisection",
        " ", 
       RowBox[{"on", " ", "[", 
        RowBox[{"0.01", ",", " ", "1"}], "]"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"thLam", "[", 
      RowBox[{"t_", ",", " ", "temp_"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"thCoup", "[", "t", "]"}], "[", 
       RowBox[{"[", "2", "]"}], "]"}], " ", 
      RowBox[{
       RowBox[{"i1Grid", "[", 
        RowBox[{
         RowBox[{"thModel", "[", "t", "]"}], ",", " ", 
         RowBox[{
          RowBox[{"thMassN", "[", 
           RowBox[{"t", ",", " ", "temp"}], "]"}], "^", "2"}], ",", " ", 
         "temp"}], "]"}], "/", 
       RowBox[{"Pi", "^", "2"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"thTc", "[", "t_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"thTc", "[", "t", "]"}], " ", "=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"lo", " ", "=", " ", "0.01"}], ",", " ", 
          RowBox[{"hi", " ", "=", " ", "1."}], ",", " ", "mid"}], "}"}], ",", 
        "\n", "   ", 
        RowBox[{
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"mid", " ", "=", " ", 
             RowBox[{"0.5", " ", 
              RowBox[{"(", 
               RowBox[{"lo", " ", "+", " ", "hi"}], ")"}]}]}], ";", " ", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"thLam", "[", 
                RowBox[{"t", ",", " ", "mid"}], "]"}], " ", ">", " ", "1"}], ",",
               " ", 
              RowBox[{"lo", " ", "=", " ", "mid"}], ",", " ", 
              RowBox[{"hi", " ", "=", " ", "mid"}]}], "]"}]}], ",", " ", 
           RowBox[{"{", "60", "}"}]}], "]"}], ";", " ", 
         RowBox[{"0.5", " ", 
          RowBox[{"(", 
           RowBox[{"lo", " ", "+", " ", "hi"}], ")"}]}]}]}], "]"}]}]}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"tc", " ", "=", " ", 
           RowBox[{"thTc", "[", "t", "]"}]}], ",", " ", "dev", ",", " ", 
          RowBox[{"extra", " ", "=", " ", "\"\<\>\""}]}], "}"}], ",", "\n", 
        "   ", 
        RowBox[{
         RowBox[{"dev", " ", "=", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"tc", " ", "-", " ", 
              RowBox[{"rustPart3", "[", 
               RowBox[{"\"\<p3_th_Tc_\>\"", " ", "<>", " ", "t"}], "]"}]}], 
             "]"}], "/", 
            RowBox[{"rustPart3", "[", 
             RowBox[{"\"\<p3_th_Tc_\>\"", " ", "<>", " ", "t"}], "]"}]}], " ",
            "+", " ", 
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"thLam", "[", 
              RowBox[{"t", ",", " ", "0."}], "]"}], " ", "-", " ", 
             RowBox[{"rustPart3", "[", 
              RowBox[{"\"\<p3_th_lam0_\>\"", " ", "<>", " ", "t"}], "]"}]}], 
            "]"}]}]}], ";", "\n", "   ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"thCoup", "[", "t", "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}], "]"}], " ", ">", " ", 
            RowBox[{"10", "^", 
             RowBox[{"-", "14"}]}]}], ",", "\n", "     ", 
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"ns", " ", "=", " ", 
               RowBox[{"solveSFT", "[", 
                RowBox[{
                 RowBox[{"thModel", "[", "t", "]"}], ",", " ", "zero8", ",", 
                 " ", "zero8", ",", " ", "tc", ",", " ", "0.6", ",", " ", 
                 RowBox[{"10", "^", 
                  RowBox[{"-", "14"}]}]}], "]"}]}], "}"}], ",", "\n", 
             "       ", 
             RowBox[{
              RowBox[{"dev", " ", "+=", " ", 
               RowBox[{"Abs", "[", 
                RowBox[{
                 RowBox[{"diracMass", "[", "ns", "]"}], " ", "-", " ", 
                 RowBox[{"thMassN", "[", 
                  RowBox[{"t", ",", " ", "tc"}], "]"}]}], "]"}]}], ";", "\n", 
              "       ", 
              RowBox[{"extra", " ", "=", " ", 
               
               RowBox[{"\"\<; the Dirac mass of the normal state of the \
thermal engine at T_c = \>\"", " ", "<>", " ", 
                RowBox[{"ToString", "[", 
                 RowBox[{"NumberForm", "[", 
                  RowBox[{
                   RowBox[{"diracMass", "[", "ns", "]"}], ",", " ", "10"}], 
                  "]"}], "]"}], " ", "<>", 
                " ", "\"\< = the scalar self-consistency\>\""}]}]}]}], 
            "]"}]}], "]"}], ";", "\n", "   ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{"\"\<WP3-T3 \>\"", " ", "<>", " ", "t"}], ",", " ", 
           RowBox[{
            RowBox[{"thName", "[", "t", "]"}], " ", "<>", 
            " ", "\"\<: the critical temperature T_c = \>\"", " ", "<>", " ", 
            
            RowBox[{"ToString", "[", 
             RowBox[{"NumberForm", "[", 
              RowBox[{"tc", ",", " ", "10"}], "]"}], "]"}], " ", "<>", 
            " ", "\"\< (bisection of lambda^P(T) = 1) = Rust (relative), and \
lambda^P(0) = \>\"", " ", "<>", " ", 
            RowBox[{"ToString", "[", 
             RowBox[{"NumberForm", "[", 
              RowBox[{
               RowBox[{"thLam", "[", 
                RowBox[{"t", ",", " ", "0."}], "]"}], ",", " ", "10"}], "]"}],
              "]"}], " ", "<>", " ", "\"\< = Rust\>\"", " ", "<>", " ", 
            "extra"}], ",", "\n", "    ", "dev", ",", " ", 
           RowBox[{"10", "^", 
            RowBox[{"-", "10"}]}], ",", " ", 
           RowBox[{"\"\<P3-T3 \>\"", " ", "<>", " ", "t"}], ",", " ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"MemberQ", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"\"\<HS_1_1\>\"", ",", " ", "\"\<CJT\>\""}], "}"}], ",",
                " ", "t"}], "]"}], ",", " ", 
             
             RowBox[{"\"\<YP3-T3 \>\"", " ", "<>", " ", "t", " ", "<>", 
              " ", "\"\<, YP3-T9 \>\"", " ", "<>", " ", "t"}], ",", " ", 
             RowBox[{"\"\<YP3-T9 \>\"", " ", "<>", " ", "t"}]}], "]"}]}], 
          "]"}]}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"t", ",", " ", "thTags"}], "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"lams", " ", "=", " ", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"thLam", "[", 
              RowBox[{"t", ",", " ", "temp"}], "]"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"temp", ",", " ", 
               RowBox[{"Subdivide", "[", 
