       RowBox[{"t", ",", " ", "top"}], "]"}], ":", " ", 
      RowBox[{
       RowBox[{"its", " ", "points", " ", "with", " ", "Phi"}], " ", "<=", 
       " ", 
       RowBox[{"top", " ", "Phi0"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"lfCurve", "[", "t_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"rustEffPot", "[", "t", "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"lfFitted", "[", 
      RowBox[{"t_", ",", " ", "top_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"lfCurve", "[", "t", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], " ", "<=", " ", 
         RowBox[{"top", " ", 
          RowBox[{"lfPhi0", "[", "t", "]"}], " ", 
          RowBox[{"(", 
           RowBox[{"1", " ", "+", " ", 
            RowBox[{"10", "^", 
             RowBox[{"-", "12"}]}]}], ")"}]}]}], " ", "&"}]}], "]"}]}], ";"}],
    "\n", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"lfName", "[", "t", "]"}], ",", " ", 
           RowBox[{"lfPhi0", "[", "t", "]"}], ",", " ", 
           RowBox[{"lfE0", "[", "t", "]"}], ",", " ", 
           RowBox[{"Length", "[", 
            RowBox[{"lfFitted", "[", 
             RowBox[{"t", ",", " ", "1.4"}], "]"}], "]"}], ",", " ", 
           RowBox[{
            RowBox[{"Max", "[", 
             RowBox[{
              RowBox[{"lfCurve", "[", "t", "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], "]"}], "/", 
            RowBox[{"lfPhi0", "[", "t", "]"}]}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"t", ",", " ", "lfTags"}], "}"}]}], "]"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<method\>\"", ",", " ", "\"\<Phi0\>\"", ",", 
         " ", "\"\<minimum of V (minus the depth)\>\"", ",", 
         " ", "\"\<points with Phi <= 1.4 Phi0\>\"", ",", 
         " ", "\"\<end of the curve / Phi0\>\""}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "All"}]}], "]"}]}]}]], "Input",
 CellLabel->
  "In[282]:=",ExpressionUUID->"674d4850-f812-4eab-94e6-45e785db0a9c"],

