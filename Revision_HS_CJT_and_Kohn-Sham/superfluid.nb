              "}"}]}], "]"}]}], ",", " ", "rise"}], "}"}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{"rise", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"0.", ",", " ", 
            RowBox[{"Max", "[", 
             RowBox[{"Differences", "[", "lams", "]"}], "]"}]}], "]"}]}], ";",
          "\n", "   ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{"\"\<WP3-T9 \>\"", " ", "<>", " ", "t"}], ",", " ", 
           RowBox[{
            RowBox[{"thName", "[", "t", "]"}], " ", "<>", 
            " ", "\"\<: lambda^P(T) of the normal state does not increase on \
60 temperatures from 0.01 to 0.6 (from \>\"", " ", "<>", " ", 
            RowBox[{"ToString", "[", 
             RowBox[{"NumberForm", "[", 
              RowBox[{
               RowBox[{"First", "[", "lams", "]"}], ",", " ", "6"}], "]"}], 
             "]"}], " ", "<>", " ", "\"\< to \>\"", " ", "<>", " ", 
            RowBox[{"ToString", "[", 
             RowBox[{"NumberForm", "[", 
              RowBox[{
               RowBox[{"Last", "[", "lams", "]"}], ",", " ", "6"}], "]"}], 
             "]"}], " ", "<>", 
            " ", "\"\<; the largest rise), so T_c is the only solution of \
lambda^P(T) = 1 there\>\""}], ",", "\n", "    ", "rise", ",", " ", 
           RowBox[{"10", "^", 
            RowBox[{"-", "12"}]}], ",", " ", 
           RowBox[{"\"\<P3-T9 \>\"", " ", "<>", " ", "t"}], ",", " ", 
           RowBox[{"\"\<YP3-T9 \>\"", " ", "<>", " ", "t"}]}], "]"}]}]}], 
       "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"t", ",", " ", "thTags"}], "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"thName", "[", "t", "]"}], ",", " ", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"thCoup", "[", "t", "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", " ", "6"}], "]"}], ",", 
           " ", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"thCoup", "[", "t", "]"}], "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", " ", "6"}], "]"}], ",", 
           " ", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{"thLam", "[", 
              RowBox[{"t", ",", " ", "0."}], "]"}], ",", " ", "8"}], "]"}], ",",
            " ", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{"thTc", "[", "t", "]"}], ",", " ", "8"}], "]"}]}], "}"}],
          ",", " ", 
         RowBox[{"{", 
