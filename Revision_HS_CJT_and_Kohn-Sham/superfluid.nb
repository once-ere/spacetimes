   RowBox[{
    RowBox[{"id8", " ", "=", " ", 
     RowBox[{"N", "[", 
      RowBox[{"IdentityMatrix", "[", "8", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"b8", " ", "=", " ", 
     RowBox[{"N", "[", 
      RowBox[{"d8", "[", "betaLL", "]"}], "]"}]}], ";"}], 
   "                           ", 
   RowBox[{"(*", " ", 
    RowBox[{"beta_LL", " ", 
     RowBox[{"(", "x", ")"}], " ", "1", "_", "2"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"k8", "[", "iota_", "]"}], " ", ":=", " ", 
     RowBox[{"N", "[", 
      RowBox[{"kLL", "[", "iota", "]"}], "]"}]}], ";"}], 
   "                    ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"K", "^", "iota_LL"}], ",", " ", "numerical"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"zero8", " ", "=", " ", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{
       RowBox[{"0.", " ", "I"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"8", ",", " ", "8"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"gaussLegendre", "[", "n", "]"}], ":", " ", 
     RowBox[{
      RowBox[{
      "the", " ", "nodes", " ", "and", " ", "weights", " ", "of", " ", "the", 
       " ", "n"}], "-", 
      RowBox[{"point", " ", "Gauss"}], "-", 
      RowBox[{"Legendre", " ", "rule", " ", 
       RowBox[{"on", " ", "[", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "1"}], "]"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"40", " ", "digits"}], ",", " ", 
         RowBox[{"then", " ", "machine", " ", "numbers"}]}], ")"}]}]}]}], " ",
     "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"gaussLegendre", "[", "n_Integer", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "xx", ",", " ", "poly", ",", " ", "dpoly", ",", " ", "roots"}], "}"}],
        ",", "\n", "   ", 
       RowBox[{
        RowBox[{"poly", " ", "=", " ", 
         RowBox[{"LegendreP", "[", 
          RowBox[{"n", ",", " ", "xx"}], "]"}]}], ";", " ", 
        RowBox[{"dpoly", " ", "=", " ", 
         RowBox[{"D", "[", 
          RowBox[{"poly", ",", " ", "xx"}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"roots", " ", "=", " ", 
         RowBox[{"Sort", "[", 
          RowBox[{"xx", " ", "/.", " ", 
           RowBox[{"NSolve", "[", 
            RowBox[{
             RowBox[{"poly", " ", "==", " ", "0"}], ",", " ", "xx", ",", " ", 
             
             RowBox[{"WorkingPrecision", " ", "->", " ", "40"}]}], "]"}]}], 
          "]"}]}], ";", "\n", "   ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"N", "[", "roots", "]"}], ",", " ", 
          RowBox[{"N", "[", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"2", "/", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", " ", "-", " ", 
