Cell[CellGroupData[{

Cell["\<\
III.T.6 The size of the order parameter, Landau's theory, and the answer\
\>", "Section",ExpressionUUID->"c86e51d9-235f-4e6a-a116-a15777debcc8"],

Cell[TextData[{
 StyleBox["The radius of convergence.",
  FontWeight->"Bold"],
 " The free energy is built from integrals over the momenta of functions of \
the quasi-particle energies ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["E", "TI"], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        StyleBox["q", "TI"], "2"], "+", 
       SuperscriptBox[
        StyleBox["M", "TI"], "2"], "+", 
       SubsuperscriptBox["\[CapitalPhi]", 
        StyleBox["a",
         FontSlant->"Plain"], "2"]}], ")"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1e29857b-78bc-4fd8-ae27-38d2babb9ed5"],
 " and of their Fermi functions: the terms ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     StyleBox["T", "TI"]}], "\[ThinSpace]", 
    StyleBox["ln",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{"2", "\[ThinSpace]", 
      StyleBox["cosh",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       RowBox[{
        StyleBox["E", "TI"], "/", "2", 
        StyleBox["T", "TI"]}], ")"}]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9c4847d9-111a-455b-8b98-6ad0b9f4d9ff"],
 ", one for each pair of eigenvalues ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    StyleBox["E", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d5ee20f8-5b74-49f7-848e-2cbd434b33b7"],
 " (at the Fermi occupation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["f", "TI"], "\[LongEqual]", 
    StyleBox["f", "TI"], 
    RowBox[{"(", 
     StyleBox["E", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "24b7e099-45a7-4a23-951b-f1374d3fec85"],
 " the energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["E", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["f", "TI"], "-", 
      FractionBox["1", "2"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cffa86aa-1924-43cd-8487-88519f12f5c2"],
 " of the pair and its term ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], 
    RowBox[{"[", 
     RowBox[{
      StyleBox["f", "TI"], "\[ThinSpace]", 
      StyleBox["ln",
       FontSlant->"Plain"], "\[ThinSpace]", 
      StyleBox["f", "TI"], "+", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        StyleBox["f", "TI"]}], ")"}], "\[ThinSpace]", 
      StyleBox["ln",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        StyleBox["f", "TI"]}], ")"}]}], "]"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "248ee576-7597-4027-9dbf-0396fb2f7342"],
 " in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     StyleBox["T", "TI"]}], 
    SubscriptBox[
     StyleBox["\[ScriptCapitalS]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e99ed6a0-8320-4a17-b536-4f5e6080f2f1"],
 " add up to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     StyleBox["T", "TI"]}], "\[ThinSpace]", 
    StyleBox["ln",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{"2", "\[ThinSpace]", 
      StyleBox["cosh",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       RowBox[{
        StyleBox["E", "TI"], "/", "2", 
        StyleBox["T", "TI"]}], ")"}]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "eee74654-6531-446e-9abc-bfab7349882d"],
 "), and the densities with the factor ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["tanh",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["E", "TI"], "/", "2", 
      StyleBox["T", "TI"]}], ")"}], "/", 
    StyleBox["E", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "35b22ae7-d0b1-4337-a47d-880c6f81cdae"],
 ". With the Matsubara frequencies ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Omega]", 
     StyleBox["n", "TI"]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{"2", 
      StyleBox["n", "TI"], "+", "1"}], ")"}], "\[Pi]", 
    StyleBox["T", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ccabbe8d-7325-4d16-9092-996075dd9eab"],
 " they become sums over ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "0", ",", "1", ",", "2", ",", 
    "\[Ellipsis]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "945fe7b3-5aef-44db-aa3a-8047907de5a3"],
 ","
}], "Text",ExpressionUUID->"134ada08-aa14-49a9-a661-f4911f61bdee"],

Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox["ln",
    FontSlant->"Plain"], 
   RowBox[{"(", 
    RowBox[{"2", "\[ThinSpace]", 
     StyleBox["cosh",
      FontSlant->"Plain"], 
     RowBox[{"(", 
      RowBox[{
       StyleBox["E", "TI"], "/", "2", 
       StyleBox["T", "TI"]}], ")"}]}], ")"}], "\[LongEqual]", 
   StyleBox["ln",
    FontSlant->"Plain"], "\[ThinSpace]", "2", "+", 
   UnderoverscriptBox["\[Sum]", 
    RowBox[{
     StyleBox["n", "TI"], "\[LongEqual]", "0"}], "\[Infinity]",
    LimitsPositioning->True], "\[ThinSpace]", 
   StyleBox["ln",
    FontSlant->"Plain"], 
   RowBox[{"(", 
    RowBox[{"1", "+", 
     FractionBox[
      SuperscriptBox[
       StyleBox["E", "TI"], "2"], 
      SubsuperscriptBox["\[Omega]", 
       StyleBox["n", "TI"], "2"]]}], ")"}], ",", "      ", 
   FractionBox[
    RowBox[{
     StyleBox["tanh",
      FontSlant->"Plain"], 
     RowBox[{"(", 
      RowBox[{
       StyleBox["E", "TI"], "/", "2", 
       StyleBox["T", "TI"]}], ")"}]}], 
    StyleBox["E", "TI"]], "\[LongEqual]", "4", 
   StyleBox["T", "TI"], "\[ThinSpace]", 
   UnderoverscriptBox["\[Sum]", 
    RowBox[{
     StyleBox["n", "TI"], "\[LongEqual]", "0"}], "\[Infinity]",
    LimitsPositioning->True], "\[ThinSpace]", 
   FractionBox["1", 
    RowBox[{
     SubsuperscriptBox["\[Omega]", 
      StyleBox["n", "TI"], "2"], "+", 
     SuperscriptBox[
      StyleBox["E", "TI"], "2"]}]], ","}], TraditionalForm]], "DisplayFormula",\

 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"b6be04c0-916d-4e12-878e-9c687b8d6bb5"],

Cell[TextData[{
 "of functions of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Omega]", 
     StyleBox["n", "TI"], "2"], "+", 
    SuperscriptBox[
     StyleBox["q", "TI"], "2"], "+", 
    SuperscriptBox[
     StyleBox["M", "TI"], "2"], "+", 
    SubsuperscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f4ffdd36-5b0a-44a8-9de9-e0d0965de568"],
 ". Integrated over the momenta, each is singular where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Omega]", 
     StyleBox["n", "TI"], "2"], "+", 
    SuperscriptBox[
     StyleBox["M", "TI"], "2"], "+", 
    SubsuperscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"], "2"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "326c356e-72f6-492c-8e9b-2ecb0f4ec04f"],
 " (at the end ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["q", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8439144c-3db4-4f87-91fc-49fbcf41cbf7"],
 " of the integral); the nearest of these points to the origin, for the Dirac \
mass of the normal state held fixed, is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"], "2"], "\[LongEqual]", 
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["M", "TI"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["X", "TI"], ",", 
         StyleBox["n",
          FontSlant->"Plain"]}]], 
       SuperscriptBox[
        RowBox[{"(", 
         StyleBox["T", "TI"], ")"}], "2"], "+", 
       SuperscriptBox["\[Pi]", "2"], 
       SuperscriptBox[
        StyleBox["T", "TI"], "2"]}], ")"}]}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "123a9a18-bda0-4cf2-92e9-f3ac4f4e0b09"],
 ", and at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "62f00d28-f6bc-42a6-8f01-dac9262c3fec"],
 " it is the point ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"], "2"], "\[LongEqual]", 
    RowBox[{"-", 
     SubsuperscriptBox[
      StyleBox["m", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], "2"]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c05981ee-a696-4ed2-a3d2-65ca1f9c9a2d"],
 " of Section III.L.5. The series of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalF]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b7ebaf41-c8d0-4c5c-bb27-de120c8a7043"],
 " in powers of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "efd1330e-e1ea-4d50-9db6-6b433a89b102"],
 " about the normal state therefore converges within a radius of the order \
of"
}], "Text",ExpressionUUID->"1ca036ca-a8e8-4ec0-b945-91ce67ad129e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], 
   RowBox[{"(", 
    StyleBox["T", "TI"], ")"}], "\[LongEqual]", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["n",
         FontSlant->"Plain"]}]], 
      SuperscriptBox[
       RowBox[{"(", 
        StyleBox["T", "TI"], ")"}], "2"], "+", 
      SuperscriptBox["\[Pi]", "2"], 
      SuperscriptBox[
       StyleBox["T", "TI"], "2"]}], ")"}], 
    RowBox[{"1", "/", "2"}]], ","}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"d0f71646-a34c-4d2a-b45e-5e4bf45574b1"],

Cell[TextData[{
 "not exactly equal to it (the Dirac mass changes with the applied field \
where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["S",
       FontSlant->"Plain"]}]], "\[NotEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "22bde1bc-b441-4dad-a2e0-98f26952b949"],
 ", and the field of the states is not the applied field). Because ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b462e337-7b46-429b-ab8d-2a3d65be97a3"],
 " is an estimate, the answer rests also on two direct measures that do not \
use it. ",
 StyleBox["Landau's theory",
  FontWeight->"Bold"],
 " expands the free energy at the symmetric state, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalF]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["Tay",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}], 
    SuperscriptBox["\[CapitalPhi]", "2"], "+", 
    SubsuperscriptBox[
     StyleBox["b", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["Tay",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}], 
    SuperscriptBox["\[CapitalPhi]", "4"], "+", "\[Ellipsis]"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7e7e383b-da80-497c-9614-e5e2b2032835"],
 " along the polar fields, and predicts the order parameter ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       StyleBox["a", "TI"]}], "/", "2", 
      StyleBox["b", "TI"]}], ")"}], 
    RowBox[{"1", "/", "2"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4baea39d-a0cb-4195-b0be-cb9cdf6a003d"],
 ", with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["Tay",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a9a1bd32-9229-44c3-8007-a10dc4bdbd4a"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["b", "TI"], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["b", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["Tay",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b542de5c-ae04-40bd-8269-f8416d72a539"],
 ". The next cell computes them for CJT at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.9", "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["CJT",
       FontSlant->"Plain"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1012e3b2-1d4a-4f46-adb1-3d8afa9fab36"],
 " from the thermal states of four small applied fields, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"]], "\[LongEqual]", "0.01"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ffd929f5-7cf1-4b99-b1cc-9b375c36fd3a"],
 " to ",
 Cell[BoxData[
  FormBox["0.04", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "590c5c01-eaff-4f03-b55c-29ad62000d40"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalF]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], "/", 
    SuperscriptBox["\[CapitalPhi]", "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3a99d50c-e32c-4a85-bdcb-8112c026781b"],
 " interpolated exactly by a cubic polynomial in ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CapitalPhi]", "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "489e4e43-adf5-40e4-b6ea-ee3273b5d700"],
 ", whose value and slope at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[CapitalPhi]", "2"], "\[LongEqual]", "0"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8c24f644-68bc-481d-98ec-4c36b66defce"],
 " are ",
 Cell[BoxData[
  FormBox[
   StyleBox["a", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c51ccb05-a871-4dac-86d8-31a3c205018d"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["b", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "df8720ac-6030-4306-b8c5-528e8cac3608"],
 "). The cell after it fits the ",
 StyleBox["Landau form",
  FontWeight->"Bold"],
 " of Section III.L (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], 
    SuperscriptBox["\[CapitalPhi]", "2"], "+", 
    StyleBox["b", "TI"], 
    SuperscriptBox["\[CapitalPhi]", "4"], "+", 
    StyleBox["c", "TI"], 
    SuperscriptBox["\[CapitalPhi]", "6"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "faa3d449-7f7d-4fbc-be14-df4df28bebfa"],
 ") and the quartic form (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], 
    SuperscriptBox["\[CapitalPhi]", "2"], "+", 
    StyleBox["b", "TI"], 
    SuperscriptBox["\[CapitalPhi]", "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
