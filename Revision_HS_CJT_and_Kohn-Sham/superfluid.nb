        RowBox[{"dpoly", " ", "=", " ", 
         RowBox[{"D", "[", 
          RowBox[{"poly", ",", " ", "xx"}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"roots", " ", "=", " ", 
         RowBox[{"Sort", "[", 
