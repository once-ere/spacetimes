        RowBox[{"kr", " ", "=", " ", 
         RowBox[{"0.5", " ", "lamLL", " ", 
          RowBox[{"(", 
           RowBox[{"x", " ", "+", " ", "1."}], ")"}]}]}], ";", " ", 
        RowBox[{"wr", " ", "=", " ", 
         RowBox[{"0.5", " ", "lamLL", " ", "wgl"}]}], ";", "\n", "   ", 
