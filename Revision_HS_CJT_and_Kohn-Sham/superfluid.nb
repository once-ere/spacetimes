      {
       RowBox[{
        SubscriptBox[
         StyleBox["h",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], 
         StyleBox["LL",
          FontSlant->"Plain"]], 
        RowBox[{"(", 
         SubscriptBox[
          OverscriptBox[
           StyleBox["q", "TI"], "\[RightVector]"], 
          StyleBox["LL",
           FontSlant->"Plain"]], ")"}], "+", 
