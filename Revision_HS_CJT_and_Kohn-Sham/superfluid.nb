             RowBox[{"WorkingPrecision", " ", "->", " ", "40"}]}], "]"}]}], 
          "]"}]}], ";", "\n", "   ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"N", "[", "roots", "]"}], ",", " ", 
          RowBox[{"N", "[", 
