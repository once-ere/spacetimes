Cell[CellGroupData[{

Cell["III.G.6 The quartic coefficient at the critical temperature", "Section",ExpressionUUID->"4d3f9219-7dd9-42ea-876d-3d1b8688a36f"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["b", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["Tay",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["T", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["X", "TI"], ",", 
       StyleBox["c",
        FontSlant->"Plain"]}]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "51b1f38d-e0a1-4cf5-9fe0-1d71c5463a93"],
 " comes from the nonlinear free energy of four small applied fields at ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9b79405c-768e-4921-94f6-e10afa537465"],
 ", as the Taylor coefficients of Section III.T.6: the thermal states of the \
applied pair self-energies ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f2c60f17-b799-4c07-b406-32808ba656a6"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"]], "\[LongEqual]", "0.01"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a96e7049-c735-4404-b28b-44a036c471fe"],
 " to ",
 Cell[BoxData[
  FormBox["0.04", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d21e5915-ba68-491b-8f41-87559ddf6de4"],
 ", with a self-consistent normal self-energy, and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["\[ScriptCapitalF]",
     FontSlant->"Plain"], "/", 
    SuperscriptBox["\[CapitalPhi]", "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "499eddda-63bc-4519-bbae-2ff95cde77aa"],
 " interpolated by a cubic polynomial in ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CapitalPhi]", "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "428c1ab3-3f23-4e69-b5e6-17f8bfc7d900"],
 " (in the scaled variable ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[CapitalPhi]", "2"], "/", 
    SubsuperscriptBox["\[CapitalPhi]", 
     StyleBox["max",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f28030e8-d505-4c22-a8e3-ad1de0375eef"],
 ", whose matrix is well conditioned). The next cell does this for CJT and \
compares with the Rust value; the other methods use the Rust values of the \
table."
}], "Text",ExpressionUUID->"761e08a8-9353-462b-b569-569bb67ffa3d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"mo", " ", "=", " ", 
       RowBox[{"thModel", "[", "\"\<CJT\>\"", "]"}]}], ",", " ", 
      RowBox[{"tc", " ", "=", " ", 
       RowBox[{"thTc", "[", "\"\<CJT\>\"", "]"}]}], ",", " ", "nn", ",", " ", 
      "n0", ",", " ", 
      RowBox[{"xs", " ", "=", " ", 
       RowBox[{"{", "}"}]}], ",", " ", 
      RowBox[{"ys", " ", "=", " ", 
       RowBox[{"{", "}"}]}], ",", " ", "cf", ",", " ", "a", ",", " ", "b"}], 
     "}"}], ",", "\n", "  ", 
    RowBox[{
     RowBox[{"nn", " ", "=", " ", 
      RowBox[{"solveSFT", "[", 
       RowBox[{
       "mo", ",", " ", "zero8", ",", " ", "zero8", ",", " ", "tc", ",", " ", 
        "0.6", ",", " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "14"}]}]}], "]"}]}], ";", " ", 
     RowBox[{"n0", " ", "=", " ", 
      RowBox[{"nn", "[", "\"\<n\>\"", "]"}]}], ";", "\n", "  ", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"res", " ", "=", " ", 
           RowBox[{"fixedPairT", "[", 
            RowBox[{"mo", ",", " ", 
             RowBox[{"fa", " ", 
              RowBox[{"ConjugateTranspose", "[", 
               RowBox[{"k8", "[", "3", "]"}], "]"}]}], ",", " ", "n0", ",", 
             " ", "tc"}], "]"}]}], "}"}], ",", "\n", "     ", 
         RowBox[{
          RowBox[{"n0", " ", "=", " ", 
           RowBox[{"res", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ";", " ", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"xs", ",", " ", 
            RowBox[{
             RowBox[{"res", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "^", "2"}]}], "]"}], ";", " ", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"ys", ",", " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"res", "[", 
                RowBox[{"[", "3", "]"}], "]"}], " ", "-", " ", 
               RowBox[{"nn", "[", "\"\<free\>\"", "]"}]}], ")"}], "/", 
             RowBox[{
              RowBox[{"res", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "^", "2"}]}]}], "]"}]}]}], 
        "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"fa", ",", " ", 
         RowBox[{"{", 
          RowBox[{
          "0.01", ",", " ", "0.02", ",", " ", "0.03", ",", " ", "0.04"}], 
          "}"}]}], "}"}]}], "]"}], ";", "\n", "  ", 
     RowBox[{"cf", " ", "=", " ", 
      RowBox[{"LinearSolve", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"x", "/", 
             RowBox[{"Max", "[", "xs", "]"}]}], ")"}], "^", "k"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "xs"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"k", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}], ",", 
        " ", "ys"}], "]"}]}], ";", "\n", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"a", ",", " ", "b"}], "}"}], " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"cf", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
        RowBox[{
         RowBox[{"cf", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "/", 
         RowBox[{"Max", "[", "xs", "]"}]}]}], "}"}]}], ";", "\n", "  ", 
     RowBox[{
      RowBox[{"gzResults", "[", "\"\<CJT\>\"", "]"}], " ", "=", " ", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"gzResults", "[", "\"\<CJT\>\"", "]"}], ",", " ", 
        RowBox[{"<|", 
         RowBox[{"\"\<b\>\"", " ", "->", " ", "b"}], "|>"}]}], "]"}]}], ";", 
     "\n", "  ", 
     RowBox[{"check", "[", 
      RowBox[{"\"\<WP3-G12\>\"", ",", " ", 
       RowBox[{"\"\<CJT at T_c: the quartic coefficient b = \>\"", " ", "<>", 
        " ", 
        RowBox[{"ToString", "[", 
         RowBox[{"NumberForm", "[", 
          RowBox[{"b", ",", " ", "10"}], "]"}], "]"}], " ", "<>", 
        " ", "\"\< of the free energy at the origin (four applied fields, \
thermal engine) is positive and = Rust \>\"", " ", "<>", " ", 
        RowBox[{"ToString", "[", 
         RowBox[{"NumberForm", "[", 
          RowBox[{
           RowBox[{"gzRust", "[", 
            RowBox[{"\"\<CJT\>\"", ",", " ", "\"\<b\>\""}], "]"}], ",", " ", 
           "10"}], "]"}], "]"}], " ", "<>", 
        " ", "\"\< (relative difference; a(T_c) = \>\"", " ", "<>", " ", 
        RowBox[{"sci", "[", "a", "]"}], " ", "<>", " ", "\"\<)\>\""}], ",", 
       "\n", "   ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"b", " ", ">", " ", "0"}], ",", " ", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"b", " ", "-", " ", 
            RowBox[{"gzRust", "[", 
             RowBox[{"\"\<CJT\>\"", ",", " ", "\"\<b\>\""}], "]"}]}], "]"}], "/", 
          RowBox[{"gzRust", "[", 
           RowBox[{"\"\<CJT\>\"", ",", " ", "\"\<b\>\""}], "]"}]}], ",", " ", 
         "1."}], "]"}], ",", " ", 
       RowBox[{"10", "^", 
        RowBox[{"-", "6"}]}], ",", " ", "\"\<P3-G12 CJT\>\"", ",", 
       " ", "\"\<YP3-G12 CJT\>\""}], "]"}]}]}], "]"}], ";"}]], "Input",
 CellLabel->
  "In[393]:=",ExpressionUUID->"673fcf23-c7c0-4fa9-b203-85b822c2078d"],

