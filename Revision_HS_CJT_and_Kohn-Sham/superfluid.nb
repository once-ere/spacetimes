Cell[TextData[{
 "with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftBracketingBar]", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["q", "TI"], "\[RightVector]"], 
      StyleBox["LL",
       FontSlant->"Plain"]], "\[RightBracketingBar]"}], "<", 
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "60af005f-6c26-49e3-bc52-be186601388a"],
 ". The energy per volume is the kinetic part plus the contractions of the \
contact terms: a bilinear term ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Nu]", ":", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["\[CapitalPsi]", "\[Dagger]"], 
       SubscriptBox[
        StyleBox["X",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["SF",
         FontSlant->"Plain"]], "\[CapitalPsi]"}], ")"}], "2"], ":"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e0034fb1-337d-434f-aa31-b5c1b2b08910"],
 " gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Nu]", 
    RowBox[{"[", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["w", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["H",
        FontSlant->"Plain"]], "\[ThinSpace]", 
      StyleBox["tr",
       FontSlant->"Plain"], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         StyleBox["X",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], "\[Delta]", 
         SuperscriptBox[
          StyleBox["C",
           FontFamily->"Helvetica",
           FontSlant->"Plain"], 
          StyleBox["n",
           FontSlant->"Plain"]]}], ")"}], "2"], "-", 
      SubsuperscriptBox[
       StyleBox["w", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["F",
        FontSlant->"Plain"]], "\[ThinSpace]", 
      StyleBox["tr",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       RowBox[{
        StyleBox["X",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        OverscriptBox[
         StyleBox["C",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], "~"], 
        StyleBox["X",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        OverscriptBox[
         StyleBox["C",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], "~"]}], ")"}], "-", 
      SubsuperscriptBox[
       StyleBox["w", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["P",
        FontSlant->"Plain"]], "\[ThinSpace]", 
      StyleBox["tr",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          SuperscriptBox[
           StyleBox["C",
            FontFamily->"Helvetica",
            FontSlant->"Plain"], 
           StyleBox["p",
            FontSlant->"Plain"]], ")"}], "*"], 
        StyleBox["X",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        SuperscriptBox[
         StyleBox["C",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], 
         StyleBox["p",
          FontSlant->"Plain"]], 
        SuperscriptBox[
         StyleBox["X",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], 
         StyleBox["T", "TI"]]}], ")"}]}], "]"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5bd91f5c-92a9-492a-9728-b26ac5c6fd82"],
 ", and a pairing term ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", "4"]}], 
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], ":", 
    SuperscriptBox[
     RowBox[{"(", 
      SuperscriptBox["\[CapitalPi]", "\[Iota]"], ")"}], "\[Dagger]"], 
    SuperscriptBox["\[CapitalPi]", "\[Iota]"], ":"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7fbf5606-d5ba-4b8b-a012-efdf90cb014c"],
 " gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", "4"]}], 
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"[", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["w", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["P",
        FontSlant->"Plain"]], 
      SuperscriptBox[
       RowBox[{"\[LeftBracketingBar]", 
        RowBox[{
         StyleBox["tr",
          FontSlant->"Plain"], 
         RowBox[{"(", 
          RowBox[{
           SubsuperscriptBox[
            StyleBox["K",
             FontFamily->"Helvetica",
             FontSlant->"Plain"], 
            StyleBox["LL",
             FontSlant->"Plain"], "\[Iota]"], 
           SuperscriptBox[
            RowBox[{"(", 
             SuperscriptBox[
              StyleBox["C",
               FontFamily->"Helvetica",
               FontSlant->"Plain"], 
              StyleBox["p",
               FontSlant->"Plain"]], ")"}], 
            StyleBox["T", "TI"]]}], ")"}]}], "\[RightBracketingBar]"}], "2"], 
      "+", "2", 
      SubsuperscriptBox[
       StyleBox["w", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["F",
        FontSlant->"Plain"]], "\[ThinSpace]", 
      StyleBox["tr",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          SubsuperscriptBox[
           StyleBox["K",
            FontFamily->"Helvetica",
            FontSlant->"Plain"], 
           StyleBox["LL",
            FontSlant->"Plain"], "\[Iota]"], ")"}], "\[Dagger]"], 
        SuperscriptBox[
         OverscriptBox[
          StyleBox["C",
           FontFamily->"Helvetica",
           FontSlant->"Plain"], "~"], 
         StyleBox["T", "TI"]], 
        SubsuperscriptBox[
         StyleBox["K",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], 
         StyleBox["LL",
          FontSlant->"Plain"], "\[Iota]"], 
        OverscriptBox[
         StyleBox["C",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], "~"]}], ")"}]}], "]"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "89a31afe-2f81-4434-ad0c-73a379818dbe"],
 ", where the weights ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["w", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["H",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b2054a06-64e2-4f75-98f0-a14c9cdd808d"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["w", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["F",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e91bd93a-8fe4-4a93-b864-050fd8725343"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["w", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["P",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "881e3cb4-3c5f-477d-b4d0-4e682ab9f2cd"],
 " of the direct (Hartree), exchange (Fock) and pair (Bogoliubov) \
contractions define the method, and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     StyleBox["C",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "~"], "\[LongEqual]", "\[Delta]", 
    SuperscriptBox[
     StyleBox["C",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["n",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7613b085-26db-4089-95f1-8df6384cde52"],
 " except in KS, where it is the projection ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalP]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["KS",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     RowBox[{"\[Delta]", 
      SuperscriptBox[
       StyleBox["C",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["n",
        FontSlant->"Plain"]]}], ")"}], "\[LongEqual]", 
    FractionBox["1", "8"], 
    StyleBox["tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{"\[Delta]", 
      SuperscriptBox[
       StyleBox["C",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["n",
        FontSlant->"Plain"]]}], ")"}], 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "8"], "+", 
    FractionBox["1", "8"], 
    StyleBox["tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[Beta]", 
         StyleBox["LL",
          FontSlant->"Plain"]], "\[CircleTimes]", 
        SubscriptBox[
         StyleBox["1",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], "2"]}], ")"}], "\[Delta]", 
      SuperscriptBox[
       StyleBox["C",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["n",
        FontSlant->"Plain"]]}], ")"}], 
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[CircleTimes]", 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "95107389-b610-4293-89f3-95c8008ec8f4"],
 " onto the two Kohn-Sham densities. ",
 StyleBox["HS",
  FontWeight->"Bold"],
 " decouples the shares ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["s", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["HS",
      FontSlant->"Plain"], ",", 
     StyleBox["S",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "58f19ca8-a3b5-47ed-85de-e0334aa64eb3"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["s", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["HS",
      FontSlant->"Plain"], ",", 
     StyleBox["V",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "89f400a2-70fb-4683-b8fa-6bf341d9699a"],
 " of the scalar and the vector term in the density channels and the rest in \
the pair channels: weights ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["s", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["HS",
        FontSlant->"Plain"], ",", 
       StyleBox["S",
        FontSlant->"Plain"]}]], ",", "0", ",", "1", "-", 
     SubsuperscriptBox[
      StyleBox["s", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["HS",
        FontSlant->"Plain"], ",", 
       StyleBox["S",
        FontSlant->"Plain"]}]]}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "316027c6-2cf7-4d2e-98a6-062188644e11"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["s", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["HS",
        FontSlant->"Plain"], ",", 
       StyleBox["V",
        FontSlant->"Plain"]}]], ",", "0", ",", "1", "-", 
     SubsuperscriptBox[
      StyleBox["s", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["HS",
        FontSlant->"Plain"], ",", 
       StyleBox["V",
        FontSlant->"Plain"]}]]}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "81119775-b709-4989-9291-4221d4babb57"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "0", ",", "1"}], ")"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0032f443-0cea-4de4-80ac-a05f764c765a"],
 " for the pairing term; three parameter sets are computed, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"1", ",", "1"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "83a092c5-5117-4276-bf28-40e610cf5444"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "1"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "eca1d637-72a8-4f5b-ae83-3bbabdea5f73"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "0"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fa11a3c3-c93f-471e-972c-61b9bd788294"],
 ". ",
 StyleBox["KS",
  FontWeight->"Bold"],
 " and ",
 StyleBox["CJT",
  FontWeight->"Bold"],
 " keep all three contractions with weight 1; KS with the projection. The \
self-energies are the derivatives of the energy,"
}], "Text",ExpressionUUID->"58361c0a-4805-4656-be99-ad1be4b25a79"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["N",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"]], "\[LongEqual]", "\[Nu]", 
   RowBox[{"[", 
    RowBox[{"2", 
     SubsuperscriptBox[
      StyleBox["w", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      StyleBox["H",
       FontSlant->"Plain"]], "\[ThinSpace]", 
     StyleBox["X",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["tr",
      FontSlant->"Plain"], 
     RowBox[{"(", 
      RowBox[{
       StyleBox["X",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], "\[Delta]", 
       SuperscriptBox[
        StyleBox["C",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["n",
         FontSlant->"Plain"]]}], ")"}], "-", "2", 
     SubsuperscriptBox[
      StyleBox["w", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      StyleBox["F",
       FontSlant->"Plain"]], "\[ThinSpace]", 
     StyleBox["\[ScriptCapitalP]",
      FontSlant->"Plain"], 
     RowBox[{"(", 
      RowBox[{
       StyleBox["X",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       OverscriptBox[
        StyleBox["C",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], "~"], 
       StyleBox["X",
        FontFamily->"Helvetica",
        FontSlant->"Plain"]}], ")"}]}], "]"}], ",", "      ", 
   SubscriptBox[
    StyleBox["P",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"]], "\[LongEqual]", 
   RowBox[{"-", "2"}], "\[Nu]", "\[ThinSpace]", 
   SubsuperscriptBox[
    StyleBox["w", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["P",
     FontSlant->"Plain"]], "\[ThinSpace]", 
   StyleBox["X",
    FontFamily->"Helvetica",
    FontSlant->"Plain"], 
   SuperscriptBox[
    StyleBox["C",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["p",
     FontSlant->"Plain"]], 
   SuperscriptBox[
    StyleBox["X",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["T", "TI"]]}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"9c451dc8-e878-4606-b38f-ef8a03f81961"],

Cell[TextData[{
 "for a bilinear term, and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["N",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"-", 
     SubscriptBox[
      StyleBox["G", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"]]}], 
    SubsuperscriptBox[
     StyleBox["w", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]], 
    StyleBox["\[ScriptCapitalP]",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        SuperscriptBox[
         StyleBox["K",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], "\[Iota]"], ")"}], "\[Dagger]"], 
      SuperscriptBox[
       OverscriptBox[
        StyleBox["C",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], "~"], 
       StyleBox["T", "TI"]], 
      SuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], "\[Iota]"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "55a81ac3-ee89-4309-98c2-c8db72dc2ed9"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["P",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["w", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["P",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Iota]"], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "\[Iota]"], ")"}], "\[Dagger]"]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ef2fd220-988e-4ecf-906f-a384f6f7f1b1"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Iota]"], "\[LongEqual]", 
    RowBox[{"-", 
     FractionBox["1", "2"]}], 
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    StyleBox["tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "\[Iota]"], 
      SuperscriptBox[
       RowBox[{"(", 
        SuperscriptBox[
         StyleBox["C",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], 
         StyleBox["p",
          FontSlant->"Plain"]], ")"}], 
       StyleBox["T", "TI"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d0c5d9ee-bd4b-42be-b3d3-1cce48cc0939"],
 " for a pairing term. The state is the ground state of the matrix of \
Bogoliubov and de Gennes at every momentum,"
}], "Text",ExpressionUUID->"527f3351-d8ef-4acc-ab0f-54bf9296f19a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["H",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"]], 
   RowBox[{"(", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["q", "TI"], "\[RightVector]"], 
     StyleBox["LL",
      FontSlant->"Plain"]], ")"}], "\[LongEqual]", 
   RowBox[{"(", "\[NoBreak]", GridBox[{
      {
       RowBox[{
        SubscriptBox[
         StyleBox["h",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], 
         StyleBox["LL",
          FontSlant->"Plain"]], 
        RowBox[{"(", 
         SubscriptBox[
          OverscriptBox[
           StyleBox["q", "TI"], "\[RightVector]"], 
          StyleBox["LL",
           FontSlant->"Plain"]], ")"}], "+", 
        SubscriptBox[
         StyleBox["N",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], 
         StyleBox["SF",
          FontSlant->"Plain"]]}], 
       SubscriptBox[
        StyleBox["P",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["SF",
         FontSlant->"Plain"]]},
      {
       SubsuperscriptBox[
        StyleBox["P",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["SF",
         FontSlant->"Plain"], "\[Dagger]"], 
       RowBox[{"-", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SubscriptBox[
            StyleBox["h",
             FontFamily->"Helvetica",
             FontSlant->"Plain"], 
            StyleBox["LL",
             FontSlant->"Plain"]], 
           RowBox[{"(", 
            RowBox[{"-", 
             SubscriptBox[
              OverscriptBox[
               StyleBox["q", "TI"], "\[RightVector]"], 
              StyleBox["LL",
               FontSlant->"Plain"]]}], ")"}], "+", 
           SubscriptBox[
            StyleBox["N",
             FontFamily->"Helvetica",
             FontSlant->"Plain"], 
            StyleBox["SF",
             FontSlant->"Plain"]]}], ")"}], 
         StyleBox["T", "TI"]]}]}
     },
