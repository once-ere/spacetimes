Cell["\<\
I.3 The spinor field and the Dirac field (item 2); theorem D1\
\>", "Section",ExpressionUUID->"a11ba154-c934-4e9d-8f3e-534452233ce2"],

Cell[TextData[{
 "A two-component spinor transforms under the unit bi-quaternion ",
 Cell[BoxData[
  FormBox[
   StyleBox["g",
    FontWeight->"Bold",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d13178ef-cc79-45ef-b6c6-c50cf41ad2f9"],
 " as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Chi]", "\[RightTeeArrow]", 
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[Chi]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a2544d42-b29e-449b-897b-a3897b84a08a"],
 " (or, for the other kind, with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     OverscriptBox[
      StyleBox["g",
       FontWeight->"Bold",
       FontSlant->"Plain"], "~"], ")"}], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["M", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"]], 
       SuperscriptBox[
        RowBox[{"(", 
         StyleBox["g",
          FontWeight->"Bold",
          FontSlant->"Plain"], ")"}], "\[Dagger]"]}], ")"}], 
     RowBox[{"-", "1"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "79e80789-22ce-405a-913a-4384847b9b9a"],
 "). The Dirac matrices of a frame ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    StyleBox["p", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ffb3fe6e-555f-445c-875a-a65718f91bf8"],
 " are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p", "TI"]], 
    RowBox[{"[", 
     StyleBox["f",
      FontWeight->"Bold",
      FontSlant->"Plain"], "]"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "17a8691f-aefd-4f70-a140-a6843adb518a"],
 " with the blocks ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubscriptBox[
      StyleBox["f",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      StyleBox["p", "TI"]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f128e3c1-a6fc-4170-b8b7-de9cd0cbde79"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["f",
        FontWeight->"Bold",
        FontSlant->"Plain"], "_"], 
      StyleBox["p", "TI"]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ab21b188-f329-48a1-a122-aa04ca08b4ed"],
 " off the diagonal; the spinor matrix is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["S",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[LongEqual]", 
    StyleBox["diag",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      RowBox[{"(", 
       OverscriptBox[
        StyleBox["g",
         FontWeight->"Bold",
         FontSlant->"Plain"], "~"], ")"}], ",", 
      SubscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      RowBox[{"(", 
       StyleBox["g",
        FontWeight->"Bold",
        FontSlant->"Plain"], ")"}]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "de2e69d9-af96-4534-b9bc-4321cf587145"],
 ", and"
}], "Text",ExpressionUUID->"606f8945-9406-400b-aaa9-3b0a0c000059"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["S",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   SuperscriptBox[
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    RowBox[{"-", "1"}]], 
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p", "TI"]], 
   SubscriptBox[
    StyleBox["S",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   RowBox[{"(", 
    StyleBox["g",
     FontWeight->"Bold",
     FontSlant->"Plain"], ")"}], "\[LongEqual]", 
   UnderscriptBox["\[Sum]", 
    SuperscriptBox[
     StyleBox["p", "TI"], "\[Prime]"],
    LimitsPositioning->True], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["L",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["p", "TI"], 
     SuperscriptBox[
      StyleBox["p", "TI"], "\[Prime]"]}]], 
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    SuperscriptBox[
     StyleBox["p", "TI"], "\[Prime]"]], ",", "      ", 
   SubscriptBox[
    StyleBox["S",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   SuperscriptBox[
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[Dagger]"], 
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], "0"], 
   SubscriptBox[
    StyleBox["S",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   RowBox[{"(", 
    StyleBox["g",
     FontWeight->"Bold",
     FontSlant->"Plain"], ")"}], "\[LongEqual]", 
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], "0"], ",", "      ", 
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p", "TI"]], 
   RowBox[{"[", 
    SuperscriptBox[
     StyleBox["f",
      FontWeight->"Bold",
      FontSlant->"Plain"], "\[Prime]"], "]"}], "\[LongEqual]", 
   SubscriptBox[
    StyleBox["S",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   RowBox[{"(", 
    StyleBox["g",
     FontWeight->"Bold",
     FontSlant->"Plain"], ")"}], "\[ThinSpace]", 
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p", "TI"]], 
   RowBox[{"[", 
    StyleBox["f",
     FontWeight->"Bold",
     FontSlant->"Plain"], "]"}], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["S",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   SuperscriptBox[
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    RowBox[{"-", "1"}]]}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"5d407595-4152-409e-a926-ccbfe64fe283"],

Cell[TextData[{
 "for the transformed frame ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["f",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["p", "TI"], "\[Prime]"], "\[LongEqual]", 
    OverscriptBox[
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], "~"], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["f",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["p", "TI"]], "\[ThinSpace]", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["g",
       FontWeight->"Bold",
       FontSlant->"Plain"], "~"], "\[Dagger]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "42b3f988-b5bb-4222-82a1-bc10e065a636"],
 " (equations (3.8) and (3.9) of the manuscript). The spinor field ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0f11f8d5-2006-414a-be38-a952a3317c60"],
 " is the Dirac isodoublet: eight anticommuting components, made of two \
spinor charges of the super-loop; it transforms as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[RightTeeArrow]", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["S",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      RowBox[{"(", 
       StyleBox["g",
        FontWeight->"Bold",
        FontSlant->"Plain"], ")"}], "\[CircleTimes]", 
      SubscriptBox[
       StyleBox["1",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], "2"]}], ")"}], 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8663cf22-e1f1-4b01-984e-0d2913d65e01"],
 ", its isospin generators are ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fb024331-1c8b-4641-a6a5-ea5234c9360a"],
 ", its fermion number is 1, and its mass term ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubscriptBox[
     OverscriptBox["\[CapitalPsi]", "_"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "55bad50a-845b-4ff8-88ae-17edac8595a2"],
 " is invariant under all of GEE."
}], "Text",ExpressionUUID->"c82ad81d-7a07-4008-a076-92512c2b4ef6"],

Cell[TextData[{
 StyleBox["Theorem D1.",
  FontWeight->"Bold"],
 " A single Dirac field with four components, on which ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["v",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0acfcde2-bd01-4361-9d83-18c7a8acf444"],
 " acts by a non-trivial linear representation that commutes with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SL", "TI"], 
    RowBox[{"(", 
     RowBox[{"2", ",", 
      StyleBox["\[DoubleStruckCapitalC]",
       FontSlant->"Plain"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3ca4625c-e0e3-40d7-b296-50a658298004"],
 " and keeps the kinetic term, has no Lorentz-invariant bilinear without \
derivatives (no Dirac, pseudoscalar or Majorana mass) that is invariant under \
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["v",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "50ade109-6ff2-4332-a249-0039af5c1824"],
 ". The reason: the two left-handed Weyl spinors ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Psi]", "-"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c395bcf9-4c10-4805-a326-423cda46ed88"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["E",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SuperscriptBox["\[Psi]", "+"], ")"}], "*"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "378d2bff-36df-4f0f-bc7f-cbdbc3696676"],
 " of the Dirac field form an isospin doublet (the group of Pauli and G\
\[CapitalATilde]\.bcrsey), and the Lorentz-invariant bilinears ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Xi]", 
     StyleBox["f", "TI"], 
     StyleBox["T", "TI"]], 
    SubscriptBox[
     StyleBox["E",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubscriptBox["\[Xi]", 
     SuperscriptBox[
      StyleBox["f", "TI"], "\[Prime]"]]}], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a2270414-c732-43df-8581-32b8ded2d142"],
 " are symmetric in the doublet indices, an isospin triplet, which contains \
no invariant. This is why the spinor field of the solution is an isodoublet \
of Dirac fields. The next cell repeats the finite part of the proof as a \
computation: on the eight operators ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["\[Psi]", "1"], ",", "\[Ellipsis]", ",", 
     SubscriptBox["\[Psi]", "4"], ",", 
     SubsuperscriptBox["\[Psi]", "1", "\[Dagger]"], ",", "\[Ellipsis]", ",", 
     SubsuperscriptBox["\[Psi]", "4", "\[Dagger]"]}], ")"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "73788641-e2eb-48c8-9bee-d57892a04245"],
 " of one point, a bilinear ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["\[GothicN]",
      FontSlant->"Plain"], 
     StyleBox["T", "TI"]], 
    StyleBox["\[GothicCapitalQ]",
     FontSlant->"Plain"], 
    StyleBox["\[GothicN]",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fc7ab868-181e-41c3-92fd-92becf1048a9"],
 " with an antisymmetric ",
 Cell[BoxData[
  FormBox[
   RowBox[{"8", "\[Times]", "8"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d0715e0e-c122-4d95-ac3e-3659e95f71ec"],
 " matrix ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[GothicCapitalQ]",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "91d25385-e536-4b53-8e69-825061f1b798"],
 " is invariant under a group exactly when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["\[GothicCapitalX]",
      FontSlant->"Plain"], 
     StyleBox["T", "TI"]], 
    StyleBox["\[GothicCapitalQ]",
     FontSlant->"Plain"], "+", 
    StyleBox["\[GothicCapitalQ]",
     FontSlant->"Plain"], 
    StyleBox["\[GothicCapitalX]",
     FontSlant->"Plain"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "20bf7a73-817f-406e-95db-817c15d07fd9"],
 " for every generator ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[GothicCapitalX]",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e8875645-d7f6-418d-af73-f07def09e8b7"],
 "; the dimension of the space of such ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[GothicCapitalQ]",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6fdd9dc8-beaf-43e8-9c3b-dddc3ef1fc63"],
 " is ",
 Cell[BoxData[
  FormBox["28", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "36ef4203-8eb4-409b-b0a9-88b78dca8754"],
 " minus the rank of these linear conditions. With exact arithmetic: \
dimension 6 for the Lorentz group, 0 for the Lorentz group together with the \
Pauli-G\[CapitalATilde]\.bcrsey ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    RowBox[{"(", "2", ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1925f3d8-663b-4910-90ec-87e218751be3"],
 "."
}], "Text",ExpressionUUID->"dc4b4ebc-bc2b-40f0-ae89-004e936cc9a7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"F", "-", "2"}], ":", " ", 
      RowBox[{"the", " ", "Clifford", " ", "algebra", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"gamma", "^", "p"}], ",", " ", 
         RowBox[{"gamma", "^", "q"}]}], "}"}]}]}], " ", "=", " ", 
     RowBox[{"2", " ", 
      RowBox[{"eta", "^", "pq"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"C", " ", 
      RowBox[{"gamma", "^", "p"}], " ", 
      RowBox[{"C", "^", "dag"}]}], " ", "=", " ", 
     RowBox[{"-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"gamma", "^", "p"}], ")"}], "^", "T"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"gamma", "^", "ch"}], " ", "=", " ", 
     RowBox[{"diag", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "1"}], ",", "1", ",", "1"}], ")"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"C", "^", "T"}], " ", "=", " ", 
     RowBox[{
      RowBox[{"-", "C"}], " ", 
      RowBox[{"(", "exact", ")"}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"dF2", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Flatten", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"gam", "[", "p", "]"}], " ", ".", " ", 
              RowBox[{"gam", "[", "q", "]"}]}], " ", "+", " ", 
             RowBox[{
              RowBox[{"gam", "[", "q", "]"}], " ", ".", " ", 
              RowBox[{"gam", "[", "p", "]"}]}], " ", "-", " ", 
             RowBox[{"2", " ", 
              RowBox[{"etaLL", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"p", " ", "+", " ", "1"}], ",", " ", 
                 RowBox[{"q", " ", "+", " ", "1"}]}], "]"}], "]"}], " ", 
              RowBox[{"IdentityMatrix", "[", "4", "]"}]}]}], "]"}], ",", " ", 
           
           RowBox[{"{", 
            RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"q", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}], ",", 
         "\n", "     ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"cLL", " ", ".", " ", 
              RowBox[{"gam", "[", "p", "]"}], " ", ".", " ", 
              RowBox[{"ConjugateTranspose", "[", "cLL", "]"}]}], " ", "+", 
             " ", 
             RowBox[{"Transpose", "[", 
              RowBox[{"gam", "[", "p", "]"}], "]"}]}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}], ",", 
         "\n", "     ", 
         RowBox[{"Abs", "[", 
          RowBox[{"gch", " ", "-", " ", 
           RowBox[{"DiagonalMatrix", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", " ", 
              RowBox[{"-", "1"}], ",", " ", "1", ",", " ", "1"}], "}"}], 
            "]"}]}], "]"}], ",", " ", 
         RowBox[{"Abs", "[", 
          RowBox[{"cLL", " ", "+", " ", 
           RowBox[{"Transpose", "[", "cLL", "]"}]}], "]"}]}], "}"}], "]"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WF-2\>\"", ",", 
      " ", "\"\<Clifford algebra, chirality, charge conjugation (exact)\>\"", 
      ",", " ", "dF2", ",", " ", "0", ",", " ", "\"\<F-2\>\"", ",", 
      " ", "\"\<F-2\>\""}], "]"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"F", "-", 
      RowBox[{"3", "a"}]}], ",", " ", 
     RowBox[{"F", "-", 
      RowBox[{"3", "b"}]}], ",", " ", 
     RowBox[{"F", "-", 
      RowBox[{"3", 
       RowBox[{"d", ":", " ", 
        RowBox[{
         RowBox[{
         "the", " ", "spinor", " ", "matrices", " ", "of", " ", "200", " ", 
          "random", " ", "unit", " ", "bi"}], "-", 
         RowBox[{"quaternions", " ", 
          RowBox[{"(", 
           RowBox[{"floating", " ", "point"}], ")"}]}]}]}]}]}]}], " ", "*)"}],
    "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dF3a", ",", " ", "dF3b", ",", " ", "dF3d"}], "}"}], " ", "=", 
     " ", 
     RowBox[{"{", 
      RowBox[{"0.", ",", " ", "0.", ",", " ", "0."}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"mg", " ", "=", " ", 
           RowBox[{"randUnitBiq", "[", "]"}]}], ",", " ", "s", ",", " ", "si",
           ",", " ", "lg", ",", " ", "mgt", ",", " ", "gf"}], "}"}], ",", 
        "\n", "   ", 
        RowBox[{
         RowBox[{"s", " ", "=", " ", 
          RowBox[{"sSpin", "[", "mg", "]"}]}], ";", " ", 
         RowBox[{"si", " ", "=", " ", 
          RowBox[{"Inverse", "[", "s", "]"}]}], ";", " ", 
         RowBox[{"lg", " ", "=", " ", 
          RowBox[{"lorentzMatrix", "[", "mg", "]"}]}], ";", " ", 
         RowBox[{"mgt", " ", "=", " ", 
          RowBox[{"Inverse", "[", 
           RowBox[{"ConjugateTranspose", "[", "mg", "]"}], "]"}]}], ";", "\n",
          "   ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"dF3a", " ", "=", " ", 
             RowBox[{"Max", "[", 
              RowBox[{"dF3a", ",", " ", 
               RowBox[{"Max", "[", 
                RowBox[{"Abs", "[", 
                 RowBox[{
                  RowBox[{"si", " ", ".", " ", 
