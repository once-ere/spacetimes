Cell[CellGroupData[{

Cell["\<\
III.T.6 The size of the order parameter, Landau's theory, and the answer\
\>", "Section",ExpressionUUID->"08ec0d67-f3c5-4d11-8ae3-270a07279357"],

Cell[TextData[{
 StyleBox["The radius of convergence.",
  FontWeight->"Bold"],
 " The free energy is built from integrals over the momenta of functions of \
the quasi-particle energies ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["E", "TI"], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        StyleBox["q", "TI"], "2"], "+", 
       SuperscriptBox[
        StyleBox["M", "TI"], "2"], "+", 
       SubsuperscriptBox["\[CapitalPhi]", 
        StyleBox["a",
         FontSlant->"Plain"], "2"]}], ")"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "02026346-dba2-4aaf-b5ee-5c4153844d47"],
 " and of their Fermi functions: the terms ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     StyleBox["T", "TI"]}], "\[ThinSpace]", 
    StyleBox["ln",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{"2", "\[ThinSpace]", 
      StyleBox["cosh",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       RowBox[{
        StyleBox["E", "TI"], "/", "2", 
        StyleBox["T", "TI"]}], ")"}]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bfcf0df9-8a0f-4e17-8917-d246ab6137c3"],
 ", one for each pair of eigenvalues ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    StyleBox["E", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5c9929f2-8689-4b54-a5cd-11f3acee4867"],
 " (at the Fermi occupation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["f", "TI"], "\[LongEqual]", 
    StyleBox["f", "TI"], 
    RowBox[{"(", 
     StyleBox["E", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "84e3b389-4963-42b2-aa23-f18039a21332"],
 " the energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["E", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["f", "TI"], "-", 
      FractionBox["1", "2"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3a5d1111-fd75-49ed-bd26-0b94bd3e7a91"],
 " of the pair and its term ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], 
    RowBox[{"[", 
     RowBox[{
      StyleBox["f", "TI"], "\[ThinSpace]", 
      StyleBox["ln",
       FontSlant->"Plain"], "\[ThinSpace]", 
      StyleBox["f", "TI"], "+", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        StyleBox["f", "TI"]}], ")"}], "\[ThinSpace]", 
      StyleBox["ln",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        StyleBox["f", "TI"]}], ")"}]}], "]"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bc96dea9-0a53-4f8e-91b9-9947f102b313"],
 " in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     StyleBox["T", "TI"]}], 
    SubscriptBox[
     StyleBox["\[ScriptCapitalS]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "969e1890-c1d2-45b5-b6bc-4b6c1a05e9f4"],
 " add up to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     StyleBox["T", "TI"]}], "\[ThinSpace]", 
    StyleBox["ln",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{"2", "\[ThinSpace]", 
      StyleBox["cosh",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       RowBox[{
        StyleBox["E", "TI"], "/", "2", 
        StyleBox["T", "TI"]}], ")"}]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8ae07ccf-d299-46ec-a275-0701e684b17f"],
 "), and the densities with the factor ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["tanh",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["E", "TI"], "/", "2", 
      StyleBox["T", "TI"]}], ")"}], "/", 
    StyleBox["E", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b85cf0e4-58e4-467f-bca2-25af53c01df7"],
 ". With the Matsubara frequencies ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Omega]", 
     StyleBox["n", "TI"]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{"2", 
      StyleBox["n", "TI"], "+", "1"}], ")"}], "\[Pi]", 
    StyleBox["T", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8789d2ed-3a53-4b1c-816b-28a6c59a7e00"],
 " they become sums over ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "0", ",", "1", ",", "2", ",", 
    "\[Ellipsis]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9b2fb01f-4073-4678-bd2b-3666039becdd"],
 ","
}], "Text",ExpressionUUID->"fc3e3917-a560-4b6e-b528-68357b6c2fc6"],

Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox["ln",
    FontSlant->"Plain"], 
   RowBox[{"(", 
    RowBox[{"2", "\[ThinSpace]", 
     StyleBox["cosh",
      FontSlant->"Plain"], 
     RowBox[{"(", 
      RowBox[{
       StyleBox["E", "TI"], "/", "2", 
       StyleBox["T", "TI"]}], ")"}]}], ")"}], "\[LongEqual]", 
   StyleBox["ln",
    FontSlant->"Plain"], "\[ThinSpace]", "2", "+", 
   UnderoverscriptBox["\[Sum]", 
    RowBox[{
     StyleBox["n", "TI"], "\[LongEqual]", "0"}], "\[Infinity]",
    LimitsPositioning->True], "\[ThinSpace]", 
   StyleBox["ln",
    FontSlant->"Plain"], 
   RowBox[{"(", 
    RowBox[{"1", "+", 
     FractionBox[
      SuperscriptBox[
       StyleBox["E", "TI"], "2"], 
      SubsuperscriptBox["\[Omega]", 
       StyleBox["n", "TI"], "2"]]}], ")"}], ",", "      ", 
   FractionBox[
    RowBox[{
     StyleBox["tanh",
      FontSlant->"Plain"], 
     RowBox[{"(", 
      RowBox[{
       StyleBox["E", "TI"], "/", "2", 
       StyleBox["T", "TI"]}], ")"}]}], 
    StyleBox["E", "TI"]], "\[LongEqual]", "4", 
   StyleBox["T", "TI"], "\[ThinSpace]", 
   UnderoverscriptBox["\[Sum]", 
    RowBox[{
     StyleBox["n", "TI"], "\[LongEqual]", "0"}], "\[Infinity]",
    LimitsPositioning->True], "\[ThinSpace]", 
   FractionBox["1", 
    RowBox[{
     SubsuperscriptBox["\[Omega]", 
      StyleBox["n", "TI"], "2"], "+", 
     SuperscriptBox[
      StyleBox["E", "TI"], "2"]}]], ","}], TraditionalForm]], "DisplayFormula",\

 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"5c84d837-5451-4c44-91c4-f436592e1bf5"],

Cell[TextData[{
 "of functions of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Omega]", 
     StyleBox["n", "TI"], "2"], "+", 
    SuperscriptBox[
     StyleBox["q", "TI"], "2"], "+", 
    SuperscriptBox[
     StyleBox["M", "TI"], "2"], "+", 
    SubsuperscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "74c144f9-d89c-44a2-bb9a-d88cd5fbccfb"],
 ". Integrated over the momenta, each is singular where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Omega]", 
     StyleBox["n", "TI"], "2"], "+", 
    SuperscriptBox[
     StyleBox["M", "TI"], "2"], "+", 
    SubsuperscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"], "2"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9e387f05-1a92-49e3-bb08-cd0238ab62b9"],
 " (at the end ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["q", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "38395026-4d03-4527-9e42-f7f7c91a2f26"],
 " of the integral); the nearest of these points to the origin, for the Dirac \
mass of the normal state held fixed, is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"], "2"], "\[LongEqual]", 
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["M", "TI"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["X", "TI"], ",", 
         StyleBox["n",
          FontSlant->"Plain"]}]], 
       SuperscriptBox[
        RowBox[{"(", 
         StyleBox["T", "TI"], ")"}], "2"], "+", 
       SuperscriptBox["\[Pi]", "2"], 
       SuperscriptBox[
        StyleBox["T", "TI"], "2"]}], ")"}]}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6a6d68d3-7b42-42b9-9fed-6b6c48e8da37"],
 ", and at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b7216d41-e5a3-40a2-ab76-c4e40eaa972e"],
 " it is the point ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"], "2"], "\[LongEqual]", 
    RowBox[{"-", 
     SubsuperscriptBox[
      StyleBox["m", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], "2"]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b0894610-fd24-43a3-9ce4-58c68f1759b5"],
 " of Section III.L.5. The series of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalF]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d1bc1a73-eb20-4015-b192-49dc6160209d"],
 " in powers of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "93b193e4-6d92-4927-97a9-d2ab0c26f5d9"],
 " about the normal state therefore converges within a radius of the order \
of"
}], "Text",ExpressionUUID->"46a0a9c9-63e2-4ab2-b0ec-f418a6e6bf2a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], 
   RowBox[{"(", 
    StyleBox["T", "TI"], ")"}], "\[LongEqual]", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["n",
         FontSlant->"Plain"]}]], 
      SuperscriptBox[
       RowBox[{"(", 
        StyleBox["T", "TI"], ")"}], "2"], "+", 
      SuperscriptBox["\[Pi]", "2"], 
      SuperscriptBox[
       StyleBox["T", "TI"], "2"]}], ")"}], 
    RowBox[{"1", "/", "2"}]], ","}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"6e0eff6c-605d-4b80-a6fb-0327cf475fd5"],

Cell[TextData[{
 "not exactly equal to it (the Dirac mass changes with the applied field \
where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["S",
       FontSlant->"Plain"]}]], "\[NotEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "52504980-9337-4eb6-be91-308c83c05f41"],
 ", and the field of the states is not the applied field). Because ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b0b55952-9828-4593-8869-347da7bfeb7a"],
 " is an estimate, the answer rests also on two direct measures that do not \
use it. ",
 StyleBox["Landau's theory",
  FontWeight->"Bold"],
 " expands the free energy at the symmetric state, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalF]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["Tay",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}], 
    SuperscriptBox["\[CapitalPhi]", "2"], "+", 
    SubsuperscriptBox[
     StyleBox["b", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["Tay",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}], 
    SuperscriptBox["\[CapitalPhi]", "4"], "+", "\[Ellipsis]"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fbc69697-db57-4271-8aea-3518501f6e0a"],
 " along the polar fields, and predicts the order parameter ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       StyleBox["a", "TI"]}], "/", "2", 
      StyleBox["b", "TI"]}], ")"}], 
    RowBox[{"1", "/", "2"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "87480279-f289-486e-9399-e9e331f540d0"],
 ", with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["Tay",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "267718cc-5d9b-495e-aa3f-e2f0fda00916"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["b", "TI"], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["b", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["Tay",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4d15d5cf-3c3a-40fc-a018-aa0a542cea91"],
 ". The next cell computes them for CJT at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.9", "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["CJT",
       FontSlant->"Plain"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9be67979-1e2c-4ec8-bdd1-abd951192f37"],
 " from the thermal states of four small applied fields, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPhi]", 
     StyleBox["a",
