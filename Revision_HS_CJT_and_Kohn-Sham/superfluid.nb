gamma^p d_p psi (symbolic derivatives)\>\"", ",", " ", "dC8", ",", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "9"}]}], ",", " ", "\"\<C-8\>\"", ",", 
      " ", "\"\<C-8\>\""}], "]"}], ";"}]}]}]], "Input",
 CellLabel->"In[92]:=",ExpressionUUID->"e5c9fb0c-5d3e-4bfd-bfcc-f0e37473af7b"],

