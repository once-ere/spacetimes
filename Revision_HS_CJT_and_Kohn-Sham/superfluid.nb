Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "2", ")"}]], "\[LongEqual]", 
   FractionBox["1", "2"], 
   RowBox[{"(", "2.8", ")"}], ":", 
