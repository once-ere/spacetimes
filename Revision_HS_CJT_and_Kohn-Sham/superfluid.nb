Cell[CellGroupData[{

Cell["III.T.4 The critical temperature", "Section",ExpressionUUID->"e0082a43-3e4f-4f38-b296-35d76cb5a2fd"],

Cell[TextData[{
 StyleBox["The effective couplings.",
  FontWeight->"Bold"],
 " A uniform scalar density ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["S",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6047178f-8af3-41c6-9809-8d7d4024d74e"],
 " shifts the Dirac mass by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["S",
       FontSlant->"Plain"]}]], 
    SubsuperscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["S",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0d8b23b3-1571-4a0f-97ab-dc716f2eb3a0"],
 ", and a pair amplitude in the channel ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bbf1a69e-2c41-4e21-8eee-6f41652010d7"],
 " produces the pair self-energy with the strength ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["P",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a35544fd-eaeb-4a37-82af-68956bfb21a9"],
 " (Section II.3). For a state with the Dirac mass ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["M", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["D",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7708e840-01cb-440b-a71a-dc7a90867f8d"],
 " and the pair field ",
 Cell[BoxData[
  FormBox["\[CapitalPhi]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a56d44bf-1b2d-407f-8642-be674cbf05d5"],
 " at the temperature ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e8d9a066-8eae-46e4-b8a4-c69e188b34df"],
 " the scalar density is"
}], "Text",ExpressionUUID->"a8709482-1176-43b6-a850-6123b2b82b63"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["S",
     FontSlant->"Plain"]], "\[LongEqual]", 
   RowBox[{"-", 
    FractionBox["2", 
     SuperscriptBox["\[Pi]", "2"]]}], 
   RowBox[{"[", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["M", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["X", "TI"], ",", 
       StyleBox["D",
        FontSlant->"Plain"]}]], "\[ThinSpace]", 
     SubsuperscriptBox[
      StyleBox["I", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{"(", "1", ")"}]], 
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["E", "TI"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["X", "TI"], ",", 
         StyleBox["gap",
          FontSlant->"Plain"]}]], ",", 
       StyleBox["T", "TI"]}], ")"}], "-", 
     SubscriptBox[
      StyleBox["m", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"]], 
     SubsuperscriptBox[
      StyleBox["I", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{"(", "1", ")"}]], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["m", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"]], ",", "0"}], ")"}]}], "]"}], ",", "      ", 
   SubsuperscriptBox[
    StyleBox["I", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "1", ")"}]], 
   RowBox[{"(", 
    RowBox[{
     StyleBox["M", "TI"], ",", 
     StyleBox["T", "TI"]}], ")"}], "\[LongEqual]", 
   SubsuperscriptBox["\[Integral]", "0", 
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]], "\[ThinSpace]", 
   FractionBox[
    RowBox[{
     SuperscriptBox[
      StyleBox["q", "TI"], "2"], "\[ThinSpace]", 
     StyleBox["tanh",
      FontSlant->"Plain"], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["E", "TI"], 
        StyleBox["M", "TI"]], "/", "2", 
       StyleBox["T", "TI"]}], ")"}]}], 
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["M", "TI"]]], "\[ThinSpace]", 
   StyleBox["dq", "TI"], ","}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"77639783-e4c8-4caf-ad1e-6ca8925a1073"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["M", "TI"]], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        StyleBox["q", "TI"], "2"], "+", 
       SuperscriptBox[
        StyleBox["M", "TI"], "2"]}], ")"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ac9c1621-f972-4f3b-8616-1d97fb0214c7"],
 " and the gap ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["gap",
       FontSlant->"Plain"]}]], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox[
          StyleBox["M", "TI"], 
          StyleBox["SF",
           FontSlant->"Plain"], 
          RowBox[{
           StyleBox["X", "TI"], ",", 
           StyleBox["D",
            FontSlant->"Plain"]}]], ")"}], "2"], "+", 
       SuperscriptBox["\[CapitalPhi]", "2"]}], ")"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6a179ac8-82a0-4d32-9c89-1f7301773374"],
 "; the factor ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["tanh",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["E", "TI"], "/", "2", 
      StyleBox["T", "TI"]}], ")"}], "\[LongEqual]", "1", "-", "2", 
    StyleBox["f", "TI"], 
    RowBox[{"(", 
     StyleBox["E", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0e5071c5-59b8-4cfa-8f4c-30a8b2c8ee37"],
 " is the thermal factor of a pair of quasi-particles, and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["I", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{"(", "1", ")"}]], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["M", "TI"], ",", "0"}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a7ba38b9-8139-4c3c-aee7-c8223c9754b8"],
 " is the integral of Part II. The Dirac mass is self-consistent when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["D",
       FontSlant->"Plain"]}]], "-", 
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["S",
       FontSlant->"Plain"]}]], 
    SubsuperscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["S",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "63c44e16-a5a0-454e-b409-9d77a592dccf"],
 ". ",
 StyleBox["The normal state and its instability.",
  FontWeight->"Bold"],
 " The normal state at ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3fb9e712-240f-4555-9533-35b80ba92cca"],
 " has no pair field and the Dirac mass ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["n",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5c5e1134-bf45-4cdf-80ee-82e720467410"],
 " that solves this condition with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPhi]", "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "87f2cade-7d32-45ea-a1da-9b4300a3470a"],
 ": ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8c91a45d-276d-44be-a34b-111850995e42"],
 " at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f2a7365f-acbe-4816-8f30-91e0b8030728"],
 "; at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], ">", "0"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dea6f40b-9237-4c1d-853f-bfcd1b3d4794"],
 " the thermally excited particles and antiparticles change the scalar \
density, which shifts the mass where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["S",
       FontSlant->"Plain"]}]], "\[NotEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "23129bbb-2d7d-434c-b1ed-fbdfb878a8d1"],
 ". A small pair field in the normal state is amplified by the factor"
}], "Text",ExpressionUUID->"471a8b20-ae40-4da4-9855-adf68aabe869"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["\[Lambda]", 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["P",
     FontSlant->"Plain"]], 
   RowBox[{"(", 
    StyleBox["T", "TI"], ")"}], "\[LongEqual]", 
   FractionBox[
    RowBox[{
     SubsuperscriptBox[
      StyleBox["g", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["X", "TI"], ",", 
       StyleBox["P",
        FontSlant->"Plain"]}]], "\[ThinSpace]", 
     SubsuperscriptBox[
      StyleBox["I", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{"(", "1", ")"}]], 
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["M", "TI"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["X", "TI"], ",", 
         StyleBox["n",
          FontSlant->"Plain"]}]], 
       RowBox[{"(", 
        StyleBox["T", "TI"], ")"}], ",", 
       StyleBox["T", "TI"]}], ")"}]}], 
    SuperscriptBox["\[Pi]", "2"]], ","}], TraditionalForm]], "DisplayFormula",\

 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"504c5eba-04ea-42e0-9953-53b0ef268b34"],

Cell[TextData[{
 "the eigenvalue of the static pair response of the normal state: the normal \
state is unstable towards a superfluid when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Lambda]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["P",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}], ">", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e4b4e406-c9a0-435b-8aa3-d60792fa3f38"],
 " (the criterion of Thouless). The ",
 StyleBox["critical temperature",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "985313ea-371f-4b80-91b3-c4da0612a6a1"],
 " solves ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Lambda]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["P",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["T", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["X", "TI"], ",", 
       StyleBox["c",
        FontSlant->"Plain"]}]], ")"}], "\[LongEqual]", "1"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3b7204e0-6426-4be4-8267-7c1eef5ae608"],
 ". The next cell computes ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["n",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a96bf799-a353-4bad-9f77-d7cc06a137ff"],
 " from the scalar self-consistency alone (bisection), ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Lambda]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["P",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "65ae20b5-fa4e-4bf8-bcb4-49c0d824941d"],
 " with the integral on the radial nodes of the grid of Part II, and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3720c54b-96a8-41e7-87ba-d23de1137d6b"],
 " by bisection; for the three methods with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["S",
       FontSlant->"Plain"]}]], "\[NotEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1fe0e886-fb15-4dd7-b56f-c19a41c87e21"],
 " it compares ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["n",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["T", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["X", "TI"], ",", 
       StyleBox["c",
        FontSlant->"Plain"]}]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b9bc5c16-3fcf-4ca5-ba01-c7d0245dbc0f"],
 " with the normal state of the thermal engine. It then shows that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Lambda]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["P",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a9894d2d-e7f0-4b70-b1dc-b0ddce570dd3"],
 " does not increase from ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0.01"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b4d66e3d-e9b1-4b86-9980-e680ec3d7353"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0.6"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "77191a7e-d80e-4371-9380-425af61c18c9"],
 ", so that ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9df5f434-8d49-4ca0-bb2d-6e48d0f23738"],
 " is the only solution there."
}], "Text",ExpressionUUID->"0bbfb3e8-ebcd-4a7e-8aa1-10fb3eb56e22"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"i1Grid", "[", 
       RowBox[{"mo", ",", " ", "s", ",", " ", "t"}], "]"}], ":", " ", "I1"}], 
     " ", "=", " ", 
     RowBox[{
      RowBox[{"int_", 
       RowBox[{"0", "^", "Lambda"}], " ", 
       RowBox[{"q", "^", "2"}], " ", "tanh", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"E", "/", "2"}], "t"}], ")"}], "/", "E"}], " ", "dq", " ", 
       "with", " ", "E"}], " ", "=", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"q", "^", "2"}], " ", "+", " ", "s"}], ")"}], "^", 
       RowBox[{"(", 
        RowBox[{"1", "/", "2"}], ")"}]}]}]}], ",", " ", 
    RowBox[{
    "on", " ", "the", " ", "radial", " ", "nodes", " ", "of", " ", "the", " ",
      "grid"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"i1Grid", "[", 
      RowBox[{"mo_", ",", " ", "s_", ",", " ", "t_"}], "]"}], " ", ":=", " ", 
     
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"kr", " ", "=", " ", 
          RowBox[{
           RowBox[{"mo", "[", "\"\<g\>\"", "]"}], "[", "\"\<kr\>\"", "]"}]}], 
         ",", " ", 
         RowBox[{"wr", " ", "=", " ", 
          RowBox[{
           RowBox[{"mo", "[", "\"\<g\>\"", "]"}], "[", "\"\<wr\>\"", "]"}]}], 
         ",", " ", "e"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"e", " ", "=", " ", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{"kr", "^", "2"}], " ", "+", " ", "s"}], "]"}]}], ";", "\n",
         "   ", 
        RowBox[{"Total", "[", 
         RowBox[{"wr", " ", 
          RowBox[{"kr", "^", "2"}], " ", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"t", " ", ">", " ", "0"}], ",", " ", 
             RowBox[{"Tanh", "[", 
              RowBox[{"e", "/", 
               RowBox[{"(", 
                RowBox[{"2", " ", "t"}], ")"}]}], "]"}], ",", " ", "1."}], 
            "]"}], "/", "e"}]}], "]"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"thCoup", "[", "t", "]"}], ":", " ", 
     RowBox[{"the", " ", "effective", " ", "couplings", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"g", "^", "S"}], ",", " ", 
        RowBox[{"g", "^", "P"}]}], "}"}], " ", "of", " ", "the", " ", 
      "method", " ", "t", " ", "for", " ", 
      RowBox[{"V", "^", 
       RowBox[{"(", "2", ")"}]}], " ", 
      RowBox[{"(", 
       RowBox[{"Part", " ", "II"}], ")"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"thCoup", "[", "t_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"thCoup", "[", "t", "]"}], " ", "=", " ", 
      RowBox[{"effCouplings", "[", 
       RowBox[{
        RowBox[{"Lookup", "[", 
         RowBox[{
          RowBox[{"AssociationThread", "[", 
           RowBox[{
            RowBox[{"shortName", " ", "/@", " ", "methodsSF"}], ",", " ", 
            "methodsSF"}], "]"}], ",", " ", "t"}], "]"}], ",", " ", 
        RowBox[{"Sequence", " ", "@@", " ", 
         RowBox[{"potentialsSF", "[", "\"\<V2\>\"", "]"}]}]}], "]"}]}]}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"thMassN", "[", 
       RowBox[{"t", ",", " ", "T"}], "]"}], ":", " ", 
      RowBox[{
       RowBox[{
       "the", " ", "Dirac", " ", "mass", " ", "of", " ", "the", " ", "normal",
         " ", "state", " ", "at", " ", "the", " ", "temperature", " ", "T", " ",
         "from", " ", "M"}], " ", "-", " ", "m"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"g", "^", "S"}], " ", 
      RowBox[{"n", "^", "S"}], " ", 
      RowBox[{"(", 
       RowBox[{"bisection", " ", 
        RowBox[{"on", " ", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"1", "e"}], "-", "6"}], ",", " ", "2"}], "]"}]}], 
       ")"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"thMassN", "[", 
      RowBox[{"t_", ",", " ", "temp_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"mo", " ", "=", " ", 
          RowBox[{"thModel", "[", "t", "]"}]}], ",", " ", 
         RowBox[{"gs", " ", "=", " ", 
          RowBox[{
           RowBox[{"thCoup", "[", "t", "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
         RowBox[{"lo", " ", "=", " ", 
          RowBox[{"10.", "^", 
           RowBox[{"-", "6"}]}]}], ",", " ", 
         RowBox[{"hi", " ", "=", " ", "2."}], ",", " ", "mid", ",", " ", 
         "i1m"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", "gs", "]"}], " ", "<", " ", 
           RowBox[{"10", "^", 
            RowBox[{"-", "14"}]}]}], ",", " ", 
          RowBox[{"Return", "[", 
           RowBox[{
            RowBox[{"N", "[", "mLL", "]"}], ",", " ", "Module"}], "]"}]}], 
         "]"}], ";", "\n", "   ", 
        RowBox[{"i1m", " ", "=", " ", 
         RowBox[{"i1Grid", "[", 
          RowBox[{"mo", ",", " ", 
           RowBox[{
            RowBox[{"N", "[", "mLL", "]"}], "^", "2"}], ",", " ", "0."}], 
          "]"}]}], ";", "\n", "   ", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"mid", " ", "=", " ", 
            RowBox[{"0.5", " ", 
             RowBox[{"(", 
              RowBox[{"lo", " ", "+", " ", "hi"}], ")"}]}]}], ";", "\n", 
           "     ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"mid", " ", "-", " ", "mLL", " ", "+", " ", 
               RowBox[{"gs", " ", 
                RowBox[{"2", "/", 
                 RowBox[{"Pi", "^", "2"}]}], " ", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"mid", " ", 
                   RowBox[{"i1Grid", "[", 
                    RowBox[{"mo", ",", " ", 
                    RowBox[{"mid", "^", "2"}], ",", " ", "temp"}], "]"}]}], 
                  " ", "-", " ", 
                  RowBox[{"mLL", " ", "i1m"}]}], ")"}]}]}], " ", ">", " ", 
              "0"}], ",", " ", 
             RowBox[{"hi", " ", "=", " ", "mid"}], ",", " ", 
             RowBox[{"lo", " ", "=", " ", "mid"}]}], "]"}]}], ",", " ", 
          RowBox[{"{", "80", "}"}]}], "]"}], ";", "\n", "   ", 
        RowBox[{"0.5", " ", 
         RowBox[{"(", 
          RowBox[{"lo", " ", "+", " ", "hi"}], ")"}]}]}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"thLam", "[", 
       RowBox[{"t", ",", " ", "T"}], "]"}], ":", " ", 
      RowBox[{
       RowBox[{"lambda", "^", "P"}], 
       RowBox[{"(", "T", ")"}], " ", "of", " ", "the", " ", "normal", " ", 
       "state"}]}], ";", " ", 
     RowBox[{
      RowBox[{"thTc", "[", "t", "]"}], ":", " ", 
      RowBox[{
      "the", " ", "critical", " ", "temperature", " ", "by", " ", "bisection",
        " ", 
       RowBox[{"on", " ", "[", 
        RowBox[{"0.01", ",", " ", "1"}], "]"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"thLam", "[", 
      RowBox[{"t_", ",", " ", "temp_"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"thCoup", "[", "t", "]"}], "[", 
       RowBox[{"[", "2", "]"}], "]"}], " ", 
      RowBox[{
       RowBox[{"i1Grid", "[", 
        RowBox[{
         RowBox[{"thModel", "[", "t", "]"}], ",", " ", 
         RowBox[{
          RowBox[{"thMassN", "[", 
           RowBox[{"t", ",", " ", "temp"}], "]"}], "^", "2"}], ",", " ", 
         "temp"}], "]"}], "/", 
       RowBox[{"Pi", "^", "2"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"thTc", "[", "t_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"thTc", "[", "t", "]"}], " ", "=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"lo", " ", "=", " ", "0.01"}], ",", " ", 
          RowBox[{"hi", " ", "=", " ", "1."}], ",", " ", "mid"}], "}"}], ",", 
        "\n", "   ", 
        RowBox[{
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"mid", " ", "=", " ", 
             RowBox[{"0.5", " ", 
              RowBox[{"(", 
               RowBox[{"lo", " ", "+", " ", "hi"}], ")"}]}]}], ";", " ", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"thLam", "[", 
                RowBox[{"t", ",", " ", "mid"}], "]"}], " ", ">", " ", "1"}], ",",
               " ", 
              RowBox[{"lo", " ", "=", " ", "mid"}], ",", " ", 
              RowBox[{"hi", " ", "=", " ", "mid"}]}], "]"}]}], ",", " ", 
           RowBox[{"{", "60", "}"}]}], "]"}], ";", " ", 
         RowBox[{"0.5", " ", 
          RowBox[{"(", 
           RowBox[{"lo", " ", "+", " ", "hi"}], ")"}]}]}]}], "]"}]}]}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"tc", " ", "=", " ", 
           RowBox[{"thTc", "[", "t", "]"}]}], ",", " ", "dev", ",", " ", 
          RowBox[{"extra", " ", "=", " ", "\"\<\>\""}]}], "}"}], ",", "\n", 
        "   ", 
        RowBox[{
         RowBox[{"dev", " ", "=", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"tc", " ", "-", " ", 
              RowBox[{"rustPart3", "[", 
               RowBox[{"\"\<p3_th_Tc_\>\"", " ", "<>", " ", "t"}], "]"}]}], 
             "]"}], "/", 
            RowBox[{"rustPart3", "[", 
             RowBox[{"\"\<p3_th_Tc_\>\"", " ", "<>", " ", "t"}], "]"}]}], " ",
            "+", " ", 
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"thLam", "[", 
              RowBox[{"t", ",", " ", "0."}], "]"}], " ", "-", " ", 
             RowBox[{"rustPart3", "[", 
              RowBox[{"\"\<p3_th_lam0_\>\"", " ", "<>", " ", "t"}], "]"}]}], 
            "]"}]}]}], ";", "\n", "   ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"thCoup", "[", "t", "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}], "]"}], " ", ">", " ", 
            RowBox[{"10", "^", 
             RowBox[{"-", "14"}]}]}], ",", "\n", "     ", 
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"ns", " ", "=", " ", 
               RowBox[{"solveSFT", "[", 
                RowBox[{
                 RowBox[{"thModel", "[", "t", "]"}], ",", " ", "zero8", ",", 
                 " ", "zero8", ",", " ", "tc", ",", " ", "0.6", ",", " ", 
                 RowBox[{"10", "^", 
                  RowBox[{"-", "14"}]}]}], "]"}]}], "}"}], ",", "\n", 
             "       ", 
             RowBox[{
              RowBox[{"dev", " ", "+=", " ", 
               RowBox[{"Abs", "[", 
                RowBox[{
                 RowBox[{"diracMass", "[", "ns", "]"}], " ", "-", " ", 
                 RowBox[{"thMassN", "[", 
                  RowBox[{"t", ",", " ", "tc"}], "]"}]}], "]"}]}], ";", "\n", 
              "       ", 
              RowBox[{"extra", " ", "=", " ", 
               
               RowBox[{"\"\<; the Dirac mass of the normal state of the \
thermal engine at T_c = \>\"", " ", "<>", " ", 
                RowBox[{"ToString", "[", 
                 RowBox[{"NumberForm", "[", 
                  RowBox[{
                   RowBox[{"diracMass", "[", "ns", "]"}], ",", " ", "10"}], 
                  "]"}], "]"}], " ", "<>", 
                " ", "\"\< = the scalar self-consistency\>\""}]}]}]}], 
            "]"}]}], "]"}], ";", "\n", "   ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{"\"\<WP3-T3 \>\"", " ", "<>", " ", "t"}], ",", " ", 
           RowBox[{
            RowBox[{"thName", "[", "t", "]"}], " ", "<>", 
            " ", "\"\<: the critical temperature T_c = \>\"", " ", "<>", " ", 
            
            RowBox[{"ToString", "[", 
             RowBox[{"NumberForm", "[", 
              RowBox[{"tc", ",", " ", "10"}], "]"}], "]"}], " ", "<>", 
            " ", "\"\< (bisection of lambda^P(T) = 1) = Rust (relative), and \
lambda^P(0) = \>\"", " ", "<>", " ", 
            RowBox[{"ToString", "[", 
             RowBox[{"NumberForm", "[", 
              RowBox[{
               RowBox[{"thLam", "[", 
                RowBox[{"t", ",", " ", "0."}], "]"}], ",", " ", "10"}], "]"}],
              "]"}], " ", "<>", " ", "\"\< = Rust\>\"", " ", "<>", " ", 
            "extra"}], ",", "\n", "    ", "dev", ",", " ", 
           RowBox[{"10", "^", 
            RowBox[{"-", "10"}]}], ",", " ", 
           RowBox[{"\"\<P3-T3 \>\"", " ", "<>", " ", "t"}], ",", " ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"MemberQ", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"\"\<HS_1_1\>\"", ",", " ", "\"\<CJT\>\""}], "}"}], ",",
                " ", "t"}], "]"}], ",", " ", 
             
             RowBox[{"\"\<YP3-T3 \>\"", " ", "<>", " ", "t", " ", "<>", 
              " ", "\"\<, YP3-T9 \>\"", " ", "<>", " ", "t"}], ",", " ", 
             RowBox[{"\"\<YP3-T9 \>\"", " ", "<>", " ", "t"}]}], "]"}]}], 
          "]"}]}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"t", ",", " ", "thTags"}], "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"lams", " ", "=", " ", 
