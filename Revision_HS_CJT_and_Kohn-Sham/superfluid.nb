   RowBox[{
    RowBox[{
     RowBox[{"thModel", "[", "t_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"groundSF", "[", 
       RowBox[{"\"\<V2_\>\"", " ", "<>", " ", "t"}], "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"thGround", "[", "t_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"thGround", "[", "t", "]"}], " ", "=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"s", " ", "=", " ", 
          RowBox[{
           RowBox[{"groundSF", "[", 
            RowBox[{"\"\<V2_\>\"", " ", "<>", " ", "t"}], "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", " ", 
        RowBox[{"solveSF", "[", 
         RowBox[{
          RowBox[{"thModel", "[", "t", "]"}], ",", " ", 
          RowBox[{"s", "[", "\"\<n\>\"", "]"}], ",", " ", 
          RowBox[{"s", "[", "\"\<p\>\"", "]"}], ",", " ", "0.6", ",", " ", 
          RowBox[{"10", "^", 
           RowBox[{"-", "13"}]}]}], "]"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"mo", " ", "=", " ", 
           RowBox[{"thModel", "[", "t", "]"}]}], ",", " ", 
          RowBox[{"g0", " ", "=", " ", 
           RowBox[{"thGround", "[", "t", "]"}]}], ",", " ", "low", ",", " ", 
          "nlow"}], "}"}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{"low", " ", "=", " ", 
          RowBox[{"solveSFT", "[", 
           RowBox[{"mo", ",", " ", 
            RowBox[{"g0", "[", "\"\<n\>\"", "]"}], ",", " ", 
            RowBox[{"g0", "[", "\"\<p\>\"", "]"}], ",", " ", "0.005", ",", 
            " ", "0.6", ",", " ", 
            RowBox[{"10", "^", 
             RowBox[{"-", "13"}]}]}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"nlow", " ", "=", " ", 
          RowBox[{"solveSFT", "[", 
           RowBox[{
           "mo", ",", " ", "zero8", ",", " ", "zero8", ",", " ", "0.005", ",",
             " ", "0.6", ",", " ", 
            RowBox[{"10", "^", 
             RowBox[{"-", "13"}]}]}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{"\"\<WP3-T1 \>\"", " ", "<>", " ", "t"}], ",", " ", 
           RowBox[{
            RowBox[{"thName", "[", "t", "]"}], " ", "<>", 
            " ", "\"\<: the thermal states at T = 0.005 reproduce the ground \
state of T = 0 (|change of Phi0| + relative change of the energy)\>\""}], ",",
            "\n", "    ", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"phiOf", "[", "low", "]"}], " ", "-", " ", 
              RowBox[{"phiOf", "[", "g0", "]"}]}], "]"}], " ", "+", " ", 
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"low", "[", "\"\<free\>\"", "]"}], " ", "-", " ", 
                 RowBox[{"nlow", "[", "\"\<free\>\"", "]"}]}], ")"}], " ", "-",
                " ", 
               RowBox[{"g0", "[", "\"\<e\>\"", "]"}]}], "]"}], "/", 
             RowBox[{"Abs", "[", 
              RowBox[{"g0", "[", "\"\<e\>\"", "]"}], "]"}]}]}], ",", " ", 
           RowBox[{"10", "^", 
            RowBox[{"-", "11"}]}], ",", " ", 
           RowBox[{"\"\<P3-T1 \>\"", " ", "<>", " ", "t"}], ",", " ", 
           RowBox[{"\"\<YP3-T1 \>\"", " ", "<>", " ", "t"}]}], "]"}]}]}], 
       "]"}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"t", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<HS_1_1\>\"", ",", " ", "\"\<CJT\>\""}], "}"}]}], 
       "}"}]}], "]"}], ";"}]}]}]], "Input",
 CellLabel->
  "In[330]:=",ExpressionUUID->"13c463ec-f8d3-4cc5-ae5c-23aa365e7865"],

