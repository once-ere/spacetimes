Cell[CellGroupData[{

Cell["III.L.5 Why no polynomial can be exact: the cause", "Section",ExpressionUUID->"4f0934ee-047b-4b55-b124-91a81ddfb03c"],

Cell[TextData[{
 StyleBox["The pair field enters the quasi-particle energies like a mass.",
  FontWeight->"Bold"],
 " For the applied pair self-energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ab63fb09-57ec-4de0-9810-549dca306c07"],
 " and a normal self-energy that is a Dirac mass, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["D",
         FontSlant->"Plain"]}]], "-", 
      SubscriptBox[
       StyleBox["m", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}], 
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[CircleTimes]", 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b78086fe-8572-484f-99ed-4322357b2b75"],
 ", the eigenvalues of the matrix of Bogoliubov and de Gennes at the momentum \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox[
     StyleBox["q", "TI"], "\[RightVector]"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4ffe0543-6056-46d2-8217-dff026f723c8"],
 " are ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    StyleBox["E", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "50587465-972d-42ac-8f6b-b923f3949ab4"],
 ", each eight times, with"
}], "Text",ExpressionUUID->"a5dc5aee-23e9-4125-9d37-a1cecdd8ecd8"],

Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox["E", "TI"], "\[LongEqual]", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"\[LeftBracketingBar]", 
        SubscriptBox[
         OverscriptBox[
          StyleBox["q", "TI"], "\[RightVector]"], 
         StyleBox["LL",
          FontSlant->"Plain"]], "\[RightBracketingBar]"}], "2"], "+", 
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox[
         StyleBox["M", "TI"], 
         StyleBox["SF",
          FontSlant->"Plain"], 
         RowBox[{
          StyleBox["X", "TI"], ",", 
          StyleBox["D",
           FontSlant->"Plain"]}]], ")"}], "2"], "+", 
      SubsuperscriptBox["\[CapitalPhi]", 
       StyleBox["a",
        FontSlant->"Plain"], "2"]}], ")"}], 
    RowBox[{"1", "/", "2"}]], "."}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"74f8b79c-581b-4fcd-b794-58df195728cc"],

Cell[TextData[{
 "The next cell checks this for 20 random momenta, masses and fields with the \
matrices of Part I (",
 StyleBox["hLL",
  FontFamily->"Source Code Pro"],
 ", ",
 StyleBox["kLL",
  FontFamily->"Source Code Pro"],
 ", ",
 StyleBox["betaLL",
  FontFamily->"Source Code Pro"],
 "); along the whole polar curve the normal self-energy is such a Dirac mass \
(the Rust check P3-9 and the Python check YP3-9)."
}], "Text",ExpressionUUID->"97b5ca7a-56e7-438e-aa3f-eb2bf69d5b75"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
     "the", " ", "BdG", " ", "matrix", " ", "of", " ", "the", " ", "eight", " ",
       "components", " ", "with", " ", "the", " ", "Dirac", " ", "mass", " ", 
      "M", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"normal", " ", "self"}], "-", 
        RowBox[{"energy", " ", 
         RowBox[{"(", 
          RowBox[{"M", " ", "-", " ", "m"}], ")"}], " ", "beta", " ", 
         RowBox[{"(", "x", ")"}], " ", "1", "_", "2"}]}], ")"}], " ", "and", " ",
       "the", " ", "applied", "\n", "   ", "pair", " ", "self"}], "-", 
     RowBox[{"energy", " ", "fa", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"K", "^", "3"}], ")"}], "^", "dag"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"at", " ", "the", " ", "momentum", " ", "q"}], ";", " ", 
     RowBox[{
      RowBox[{"its", " ", "sorted", " ", "eigenvalues", " ", "against"}], " ",
       "-", 
      RowBox[{"E", " ", 
       RowBox[{"(", 
        RowBox[{"eight", " ", "times"}], ")"}], " ", "and"}], " ", "+", 
      RowBox[{"E", " ", 
       RowBox[{"(", 
        RowBox[{"eight", " ", "times"}], ")"}]}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"lfBdG", "[", 
      RowBox[{"q_", ",", " ", "mass_", ",", " ", "fa_"}], "]"}], " ", ":=", 
     " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"n", " ", "=", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"mass", " ", "-", " ", "mLL"}], ")"}], " ", 
           RowBox[{"d8", "[", "betaLL", "]"}]}]}], ",", " ", 
         RowBox[{"p", " ", "=", " ", 
          RowBox[{"fa", " ", 
           RowBox[{"ConjugateTranspose", "[", 
            RowBox[{"kLL", "[", "3", "]"}], "]"}]}]}], ",", " ", "a", ",", 
         " ", "d"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"a", " ", "=", " ", 
         RowBox[{
          RowBox[{"hLL", "[", 
           RowBox[{"q", ",", " ", "mLL"}], "]"}], " ", "+", " ", "n"}]}], ";",
         " ", 
        RowBox[{"d", " ", "=", " ", 
         RowBox[{
          RowBox[{"hLL", "[", 
           RowBox[{
            RowBox[{"-", "q"}], ",", " ", "mLL"}], "]"}], " ", "+", " ", 
          "n"}]}], ";", "\n", "   ", 
        RowBox[{"N", "[", 
         RowBox[{"ArrayFlatten", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"a", ",", " ", "p"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"ConjugateTranspose", "[", "p", "]"}], ",", " ", 
              RowBox[{"-", 
               RowBox[{"Transpose", "[", "d", "]"}]}]}], "}"}]}], "}"}], 
          "]"}], "]"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"SeedRandom", "[", "20261121", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"lfQpDev", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"q", " ", "=", " ", 
             RowBox[{"RandomReal", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", "3"}], 
              "]"}]}], ",", " ", 
            RowBox[{"mass", " ", "=", " ", 
             RowBox[{"RandomReal", "[", 
              RowBox[{"{", 
               RowBox[{"0.1", ",", " ", "0.5"}], "}"}], "]"}]}], ",", " ", 
            RowBox[{"fa", " ", "=", " ", 
             RowBox[{"RandomReal", "[", 
              RowBox[{"{", 
               RowBox[{"0", ",", " ", "0.6"}], "}"}], "]"}]}], ",", " ", "ev",
             ",", " ", "e"}], "}"}], ",", "\n", "     ", 
          RowBox[{
           RowBox[{"ev", " ", "=", " ", 
            RowBox[{"Sort", "[", 
             RowBox[{"Re", "[", 
              RowBox[{"Eigenvalues", "[", 
               RowBox[{"lfBdG", "[", 
                RowBox[{"q", ",", " ", "mass", ",", " ", "fa"}], "]"}], "]"}],
               "]"}], "]"}]}], ";", "\n", "     ", 
           RowBox[{"e", " ", "=", " ", 
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{"q", " ", ".", " ", "q"}], " ", "+", " ", 
              RowBox[{"mass", "^", "2"}], " ", "+", " ", 
              RowBox[{"fa", "^", "2"}]}], "]"}]}], ";", "\n", "     ", 
           RowBox[{"Max", "[", 
            RowBox[{"Abs", "[", 
             RowBox[{"ev", " ", "-", " ", 
              RowBox[{"Join", "[", 
               RowBox[{
                RowBox[{"ConstantArray", "[", 
                 RowBox[{
                  RowBox[{"-", "e"}], ",", " ", "8"}], "]"}], ",", " ", 
                RowBox[{"ConstantArray", "[", 
                 RowBox[{"e", ",", " ", "8"}], "]"}]}], "]"}]}], "]"}], 
            "]"}]}]}], "]"}], ",", " ", 
        RowBox[{"{", "20", "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WP3-8\>\"", ",", 
      " ", "\"\<the pair field enters the quasi-particle energies like a \
mass: the BdG matrix with N = (M - m) beta (x) 1_2 and P = Phi_a (K^3)^dag \
has the eigenvalues -+(q^2 + M^2 + Phi_a^2)^(1/2), eight times each (20 \
random q, M, Phi_a)\>\"", ",", " ", "lfQpDev", ",", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "13"}]}], ",", " ", "\"\<P3-8\>\"", ",", 
      " ", "\"\<YP3-8\>\""}], "]"}], ";"}]}]}]], "Input",
 CellLabel->
  "In[301]:=",ExpressionUUID->"faf8ae90-3c73-49a8-b30b-3ca4ac06277d"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"PASS \"\>", "\[InvisibleSpace]", "\<\"WP3-8\"\>", 
   "\[InvisibleSpace]", "\<\"  deviation \"\>", 
   "\[InvisibleSpace]", "\<\"1.554e-15\"\>", 
   "\[InvisibleSpace]", "\<\" (tolerance \"\>", 
   "\[InvisibleSpace]", "\<\"1.000e-13\"\>", 
   "\[InvisibleSpace]", "\<\"): \"\>", 
   "\[InvisibleSpace]", "\<\"the pair field enters the quasi-particle \
energies like a mass: the BdG matrix with N = (M - m) beta (x) 1_2 and P = \
Phi_a (K^3)^dag has the eigenvalues -+(q^2 + M^2 + Phi_a^2)^(1/2), eight \
times each (20 random q, M, Phi_a)\"\>", 
   "\[InvisibleSpace]", "\<\"   [the same check: Rust \"\>", 
   "\[InvisibleSpace]", "\<\"P3-8\"\>", 
   "\[InvisibleSpace]", "\<\", Python \"\>", 
   "\[InvisibleSpace]", "\<\"YP3-8\"\>", "\[InvisibleSpace]", "\<\"]\"\>"}],
  SequenceForm[
  "PASS ", "WP3-8", "  deviation ", "1.554e-15", " (tolerance ", "1.000e-13", 
   "): ", "the pair field enters the quasi-particle energies like a mass: the \
BdG matrix with N = (M - m) beta (x) 1_2 and P = Phi_a (K^3)^dag has the \
eigenvalues -+(q^2 + M^2 + Phi_a^2)^(1/2), eight times each (20 random q, M, \
Phi_a)", "   [the same check: Rust ", "P3-8", ", Python ", "YP3-8", "]"],
  Editable->False]], "Print",
 CellChangeTimes->{4.0042721433450413`*^9},
 CellLabel->
  "During evaluation of \
In[301]:=",ExpressionUUID->"e5d8e700-75e0-4135-a7c3-dc57e65c0162"]
}, Open  ]],

Cell[TextData[{
 StyleBox["A logarithm.",
  FontWeight->"Bold"],
 " The energy per volume is an integral over the momenta ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["q", "TI"], "<", 
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b73dae6c-545d-4cc6-8489-5205b1a46e74"],
 " of functions of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       StyleBox["q", "TI"], "2"], "+", 
      StyleBox["s", "TI"]}], ")"}], 
    RowBox[{"1", "/", "2"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b69a8c02-83d3-43b2-a3ae-e6c0bc294442"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["s", "TI"], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["D",
         FontSlant->"Plain"]}]], ")"}], "2"], "+", 
    SubsuperscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ae41af5b-df05-430f-8c92-064f402aa1d2"],
 ". The next cell integrates the simplest of them exactly and expands the \
result about ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["s", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d9c6a765-3288-4079-af2f-e73b3690ded9"],
 ": it contains the term ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "16"], 
    SuperscriptBox[
     StyleBox["s", "TI"], "2"], "\[ThinSpace]", 
    StyleBox["ln",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["s", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "10ba11cd-50a8-4efb-a507-48b3fd813092"],
 ", which is not analytic at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["s", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4dc79b74-48ea-40f0-b2f9-8ce5ae0cacbd"],
 ", that is, at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"], "2"], "\[LongEqual]", 
    RowBox[{"-", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["M", "TI"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["X", "TI"], ",", 
         StyleBox["D",
          FontSlant->"Plain"]}]], ")"}], "2"]}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3614fc01-3453-4090-ac74-fd8ba950d053"],
 ". Hence ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalV]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "56229c6e-49b3-45bb-b749-c56d75f64896"],
 " is not a polynomial in ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c1cf64fe-0c39-4876-af55-1d7693c43e18"],
 ", and a series of powers of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9352592a-5cab-45fe-b842-2b433e786bb8"],
 " about the origin can converge only within a radius of the order of the \
Dirac mass (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0.2"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c77a8fee-97e2-4dc9-9950-5465acf921a7"],
 " at the origin), while ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalPhi]", 
     RowBox[{"0", ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]], "\[LongEqual]", "0.31"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fc5495ca-a0df-493b-b864-01cc573668c6"],
 " to ",
 Cell[BoxData[
  FormBox["0.40", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f3b30654-5c30-48ec-b242-80714a29eaf5"],
 ": the superfluid is far from the regime of Landau's theory, where the order \
parameter is small and the Landau coefficients are Taylor coefficients."
}], "Text",ExpressionUUID->"8663d160-d2c6-4d52-9410-f332d824d399"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", "integral", " ", "of", " ", 
     RowBox[{"q", "^", "2"}], " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"q", "^", "2"}], " ", "+", " ", "s"}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}]}], " ", "from", " ", "0", " ", "to", " ",
      "the", " ", "cutoff", " ", "lam"}], ",", " ", "exactly", ",", " ", 
    RowBox[{
     RowBox[{"and", " ", "its", " ", "expansion", " ", "about", " ", "s"}], 
     " ", "=", " ", "0"}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"lfq", ":", " ", 
     RowBox[{
     "the", " ", "modulus", " ", "of", " ", "the", " ", "momentum"}]}], ",", 
    " ", 
    RowBox[{"lfs", ":", " ", 
     RowBox[{
      RowBox[{"the", " ", "quantity", " ", 
       RowBox[{"M", "^", "2"}]}], " ", "+", " ", 
      RowBox[{"Phi_a", "^", "2"}]}]}], ",", " ", 
    RowBox[{"lfLam", ":", " ", 
     RowBox[{"the", " ", "cutoff"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"lfInt", " ", "=", " ", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"lfq", "^", "2"}], " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"lfq", "^", "2"}], " ", "+", " ", "lfs"}], "]"}]}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"lfq", ",", " ", "0", ",", " ", "lfLam"}], "}"}], ",", " ", 
       RowBox[{"Assumptions", " ", "->", " ", 
        RowBox[{
         RowBox[{"lfs", " ", ">", " ", "0"}], " ", "&&", " ", 
         RowBox[{"lfLam", " ", ">", " ", "0"}]}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"lfClosed", " ", "=", " ", 
     RowBox[{
      RowBox[{"lfLam", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", " ", 
          RowBox[{"lfLam", "^", "2"}]}], " ", "+", " ", "lfs"}], ")"}], " ", 
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"lfLam", "^", "2"}], " ", "+", " ", "lfs"}], "]"}], "/", 
        "8"}]}], " ", "-", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"lfs", "^", "2"}], "/", "8"}], " ", 
       RowBox[{"Log", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"lfLam", " ", "+", " ", 
           RowBox[{"Sqrt", "[", 
            RowBox[{
             RowBox[{"lfLam", "^", "2"}], " ", "+", " ", "lfs"}], "]"}]}], 
          ")"}], "/", 
         RowBox[{"Sqrt", "[", "lfs", "]"}]}], "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<the integral minus the closed form: \>\"", ",", " ", 
      RowBox[{"FullSimplify", "[", 
       RowBox[{
        RowBox[{"lfInt", " ", "-", " ", "lfClosed"}], ",", " ", 
        RowBox[{"Assumptions", " ", "->", " ", 
         RowBox[{
          RowBox[{"lfs", " ", ">", " ", "0"}], " ", "&&", " ", 
          RowBox[{"lfLam", " ", ">", " ", "0"}]}]}]}], "]"}]}], "]"}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"lfSeries", " ", "=", " ", 
     RowBox[{"Expand", "[", 
      RowBox[{"Normal", "[", 
       RowBox[{"Series", "[", 
        RowBox[{
         RowBox[{"lfClosed", " ", "/.", " ", 
          RowBox[{"lfLam", " ", "->", " ", "1"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"lfs", ",", " ", "0", ",", " ", "2"}], "}"}]}], "]"}], 
       "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<the closed form about s = 0 (cutoff 1), to the order s^2: \
\>\"", ",", " ", "lfSeries"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<its term with the logarithm: \>\"", ",", " ", 
      RowBox[{"Coefficient", "[", 
       RowBox[{"lfSeries", ",", " ", 
        RowBox[{"Log", "[", "lfs", "]"}]}], "]"}], ",", 
      " ", "\"\< Log[s]\>\""}], "]"}], ";"}]}]}]], "Input",
 CellLabel->
  "In[305]:=",ExpressionUUID->"6332c6ca-86db-4f1c-8d16-1cef74d662e7"],

