Cell[CellGroupData[{

Cell["III.T.3 The limit of zero temperature", "Section",ExpressionUUID->"f7957cc7-d00b-4575-946f-37fda32b93ba"],

Cell[TextData[{
 "The next cell takes the ground states of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "2", ")"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d8c6cbd2-b55c-4e15-9821-900cfa30ba5b"],
 " of Part II (",
 StyleBox["groundSF",
  FontFamily->"Source Code Pro"],
 "), makes them self-consistent to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "13"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a4d825e3-5a80-424e-953f-122f84ee4cc7"],
 ", and computes the thermal states at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0.005"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b11ce035-c736-47e5-be2d-d94dbe43509b"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      RowBox[{"-", 
       SubsuperscriptBox[
        StyleBox["E", "TI"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["X", "TI"], ",", 
         StyleBox["gap",
          FontSlant->"Plain"]}]]}], "/", 
      StyleBox["T", "TI"]}]], "<", 
    SuperscriptBox["10", 
     RowBox[{"-", "25"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ff1597f1-0773-4864-8a50-c0476e063338"],
 ": the order parameter and the free energy measured from the normal state at \
the same temperature must be those of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "18fd7d79-3fa3-4f30-a477-0ad3d3261353"],
 "."
}], "Text",ExpressionUUID->"8f282389-2c9c-40a7-acac-486b1a5ab437"],

