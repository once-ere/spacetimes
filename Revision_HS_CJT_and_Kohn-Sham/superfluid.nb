   "\[InvisibleSpace]", "\<\", Python \"\>", 
   "\[InvisibleSpace]", "\<\"F-5a\"\>", "\[InvisibleSpace]", "\<\"]\"\>"}],
  SequenceForm[
  "PASS ", "WF-5a", "  deviation ", "0", " (tolerance ", "0", "): ", 
   "D1: the Pauli-Guersey generators commute with the Lorentz generators \
(exact)", "   [the same check: Rust ", "F-5a", ", Python ", "F-5a", "]"],
  Editable->False]], "Print",
 CellChangeTimes->{4.004272008661705*^9},
 CellLabel->
  "During evaluation of \
In[74]:=",ExpressionUUID->"327f84b1-5949-41f5-b63c-76d5fbb5bc5c"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"PASS \"\>", "\[InvisibleSpace]", "\<\"WF-5c\"\>", 
   "\[InvisibleSpace]", "\<\"  \"\>", 
   "\[InvisibleSpace]", "\<\"D1: the Lorentz-invariant bilinears of one point \
form a space of dimension 6; those invariant also under the Pauli-Guersey \
SU(2), dimension 0\"\>", "\[InvisibleSpace]", "\<\" [\"\>", 
   "\[InvisibleSpace]", "\<\"dimensions 6, 0 (exact ranks)\"\>", 
