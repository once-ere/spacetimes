Cell[TextData[{
 "the polynomial ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["\[ScriptCapitalV]",
      FontSlant->"Plain"], 
     StyleBox["L",
      FontSlant->"Plain"]], 
    RowBox[{"(", "\[CapitalPhi]", ")"}], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], 
    SuperscriptBox["\[CapitalPhi]", "2"], "+", 
    SubsuperscriptBox[
     StyleBox["b", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], 
    SuperscriptBox["\[CapitalPhi]", "4"], "+", 
    SubsuperscriptBox[
     StyleBox["c", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], 
    SuperscriptBox["\[CapitalPhi]", "6"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "eb6e8c2b-382c-4834-a582-ae9a54447df1"],
 " along the polar fields. The coefficient ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["u", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b018db13-f4db-4bf3-849c-59abacc2e128"],
 " is not fitted: it comes from the computed second derivative in a \
non-unitary direction at the minimum, and it is positive in every method (the \
sodium case of the condensates of spin 1). The next cell checks, for random \
vectors, that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
      "\[RightBracketingBar]"}], "4"], "-", 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      RowBox[{
       OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "\[CenterDot]", 
       OverscriptBox["\[CapitalPhi]", "\[RightVector]"]}], 
      "\[RightBracketingBar]"}], "2"], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      RowBox[{
       OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "\[Times]", 
       SuperscriptBox[
        OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "*"]}], 
      "\[RightBracketingBar]"}], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "02422b6c-8870-4653-a523-e58b32855865"],
 ", and that it vanishes on polar fields."
}], "Text",ExpressionUUID->"74838623-18ca-4124-a15b-fcd7b802015c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"the", " ", "identity"}], " ", "|", "Phi", "|", 
      RowBox[{
       RowBox[{"^", "4"}], " ", "-"}], " ", "|", 
      RowBox[{"Phi", ".", "Phi"}], "|", 
      RowBox[{"^", "2"}]}], " ", "=", " ", 
     RowBox[{"|", 
      RowBox[{"Phi", " ", "x", " ", 
       RowBox[{"Phi", "^"}], "*"}], "|", 
      RowBox[{
       RowBox[{
        RowBox[{"^", "2"}], " ", "for", " ", "complex", " ", "3"}], "-", 
       "vectors"}]}]}], ",", " ", "exactly", ",", " ", 
    RowBox[{"with", " ", "symbolic", " ", "components"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"lfVec", " ", "=", " ", 
     RowBox[{"Array", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"lfRe", "[", "#", "]"}], " ", "+", " ", 
         RowBox[{"I", " ", 
          RowBox[{"lfIm", "[", "#", "]"}]}]}], " ", "&"}], ",", " ", "3"}], 
      "]"}]}], ";"}], "   ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Phi", " ", "=", " ", 
      RowBox[{"lfRe", " ", "+", " ", 
       RowBox[{
       "i", " ", "lfIm", " ", "with", " ", "real", " ", "components", " ", 
        RowBox[{"lfRe", "[", "k", "]"}]}]}]}], ",", " ", 
     RowBox[{"lfIm", "[", "k", "]"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"lfNorm2", " ", "=", " ", 
     RowBox[{"ComplexExpand", "[", 
      RowBox[{
       RowBox[{"Conjugate", "[", "lfVec", "]"}], " ", ".", " ", "lfVec"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"lfIdentity", " ", "=", " ", 
     RowBox[{"Simplify", "[", 
      RowBox[{"ComplexExpand", "[", 
       RowBox[{
        RowBox[{"lfNorm2", "^", "2"}], " ", "-", " ", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"lfVec", " ", ".", " ", "lfVec"}], "]"}], "^", "2"}], " ", "-",
         " ", 
        RowBox[{
         RowBox[{"Conjugate", "[", 
          RowBox[{"Cross", "[", 
           RowBox[{"lfVec", ",", " ", 
            RowBox[{"Conjugate", "[", "lfVec", "]"}]}], "]"}], "]"}], " ", ".",
          " ", 
         RowBox[{"Cross", "[", 
          RowBox[{"lfVec", ",", " ", 
           RowBox[{"Conjugate", "[", "lfVec", "]"}]}], "]"}]}]}], "]"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"on", " ", "a", " ", "polar", " ", "field", " ", "Phi"}], " ", "=",
      " ", 
     RowBox[{
      RowBox[{"e", "^", 
       RowBox[{"(", 
        RowBox[{"i", " ", "theta"}], ")"}]}], " ", "r", " ", "n", " ", "with",
       " ", "a", " ", "real", " ", "unit", " ", "vector", " ", "n", " ", 
      "the", " ", "term", " ", "vanishes"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"lfPolar", " ", "=", " ", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{"ComplexExpand", "[", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"v", " ", "=", " ", 
            RowBox[{
             RowBox[{"Exp", "[", 
              RowBox[{"I", " ", "lfTh"}], "]"}], " ", "lfR", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"Sin", "[", "lfT1", "]"}], " ", 
                RowBox[{"Cos", "[", "lfT2", "]"}]}], ",", " ", 
               RowBox[{
                RowBox[{"Sin", "[", "lfT1", "]"}], " ", 
                RowBox[{"Sin", "[", "lfT2", "]"}]}], ",", " ", 
               RowBox[{"Cos", "[", "lfT1", "]"}]}], "}"}]}]}], "}"}], ",", 
          "\n", "      ", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Conjugate", "[", "v", "]"}], " ", ".", " ", "v"}], 
             ")"}], "^", "2"}], " ", "-", " ", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"v", " ", ".", " ", "v"}], "]"}], "^", "2"}]}]}], "]"}], 
        "]"}], ",", " ", 
       RowBox[{"Assumptions", " ", "->", " ", 
        RowBox[{"Element", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "lfTh", ",", " ", "lfR", ",", " ", "lfT1", ",", " ", "lfT2"}], 
           "}"}], ",", " ", "Reals"}], "]"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<|Phi|^4 - |Phi.Phi|^2 - |Phi x Phi*|^2 = \>\"", ",", " ", 
      "lfIdentity", ",", 
      " ", "\"\<;  on a polar field |Phi|^4 - |Phi.Phi|^2 = \>\"", ",", " ", 
      "lfPolar"}], "]"}], ";"}]}]}]], "Input",
 CellLabel->
  "In[270]:=",ExpressionUUID->"1f2bdcba-1125-499b-9d9f-6de6e3891d2b"],

