          RowBox[{"pct", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"lfResults", "[", "#", "]"}], "[", "\"\<depthfit\>\"", 
              "]"}], "/", 
             RowBox[{"lfE0", "[", "#", "]"}]}], " ", "-", " ", "1"}], "]"}], 
          " ", "&"}]}], "}"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<curvature at its minimum / V''amp - 1 (per cent)\>\"", ",",
          " ", 
         RowBox[{
          RowBox[{"pct", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"lfResults", "[", "#", "]"}], "[", "\"\<curvfit\>\"", 
              "]"}], "/", 
             RowBox[{"rustPart3", "[", 
              RowBox[{"\"\<p3_V2amp_\>\"", " ", "<>", " ", "#"}], "]"}]}], 
            " ", "-", " ", "1"}], "]"}], " ", "&"}]}], "}"}], ",", "\n", 
       "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<resulting M^H / M^H - 1 (per cent)\>\"", ",", " ", 
         RowBox[{
          RowBox[{"pct", "[", 
           RowBox[{
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"lfResults", "[", "#", "]"}], "[", "\"\<curvfit\>\"", 
               "]"}], "/", 
              RowBox[{"rustPart3", "[", 
               RowBox[{"\"\<p3_V2amp_\>\"", " ", "<>", " ", "#"}], "]"}]}], 
             "]"}], " ", "-", " ", "1"}], "]"}], " ", "&"}]}], "}"}], ",", 
       "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<largest residual / depth, powers to Phi^4 (per cent)\>\"",
          ",", " ", 
         RowBox[{
          RowBox[{"pct", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"lfResults", "[", "#", "]"}], "[", "\"\<resK2\>\"", 
             "]"}], "/", 
            RowBox[{"Abs", "[", 
             RowBox[{"lfE0", "[", "#", "]"}], "]"}]}], "]"}], " ", "&"}]}], 
        "}"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<the same, powers to Phi^6: the Landau form (per \
cent)\>\"", ",", " ", 
         RowBox[{
          RowBox[{"pct", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"lfResults", "[", "#", "]"}], "[", "\"\<resK3\>\"", 
