Cell[CellGroupData[{

Cell["I.2 The manifold M31 of the Lorentz super-loop (item 1)", "Section",ExpressionUUID->"9157405a-18de-48dc-a0f9-2736f63e56b7"],

Cell[TextData[{
 StyleBox["Bi-quaternions.",
  FontWeight->"Bold"],
 " A bi-quaternion is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["b",
     FontWeight->"Bold",
     FontSlant->"Plain"], "\[LongEqual]", 
    UnderoverscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["p", "TI"], "\[LongEqual]", "0"}], "3",
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox["\[Xi]", 
     StyleBox["p", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["p", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "64305fa8-32ba-4b38-8b3d-a0dec4e925ba"],
 " with four complex coefficients and the units ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "0"], "\[LongEqual]", "1", ",", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "1"], ",", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "2"], ",", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "3"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6aa3d29a-8e8f-4ffc-8933-5e674fc6abbc"],
 ", multiplied by the rules of the quaternions, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"], "2"], "\[LongEqual]", 
    RowBox[{"-", "1"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "46edd749-e469-499b-88e8-de98dc7cb7dc"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "1"], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "2"], "\[LongEqual]", 
    RowBox[{"-", 
     SubscriptBox[
      StyleBox["e",
       FontWeight->"Bold",
       FontSlant->"Plain"], "2"]}], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "1"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "3"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9625b880-d447-4fce-8417-c1aa77fcf366"],
 " and cyclically. The conjugation ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["b",
     FontWeight->"Bold",
     FontSlant->"Plain"], "_"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "57bdeba1-53ac-4df4-9ef7-74f6a9729e59"],
 " changes the signs of the coefficients of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "1"], ",", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "2"], ",", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "3"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "761b582d-5bfb-4edd-8ed2-fe0f22b6bda6"],
 ", the complex conjugation ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["b",
     FontWeight->"Bold",
     FontSlant->"Plain"], "*"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "44d49b01-0c7e-4534-8566-6191fc965d10"],
 " conjugates every coefficient, and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], "\[Dagger]"], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      OverscriptBox[
       StyleBox["b",
        FontWeight->"Bold",
        FontSlant->"Plain"], "_"], ")"}], "*"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "50c1334b-7b68-4247-bc56-9bbaf6b172ac"],
 ". The complex norm ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", 
     StyleBox["p", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox["\[Xi]", 
     StyleBox["p", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      StyleBox["b",
       FontWeight->"Bold",
       FontSlant->"Plain"], ")"}], "2"]}], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1517ec04-32cb-46d2-9ed0-c5619046d835"],
 " satisfies ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["b",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    OverscriptBox[
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], "_"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "0"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6bac8c5a-c0f0-4228-ab76-67f431f6f22f"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["b",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      SuperscriptBox[
       StyleBox["b",
        FontWeight->"Bold",
        FontSlant->"Plain"], "\[Prime]"]}], ")"}], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SuperscriptBox[
      StyleBox["b",
       FontWeight->"Bold",
       FontSlant->"Plain"], "\[Prime]"], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "08bbd0be-93a2-4d26-be4e-849ab2efadfa"],
 ". The matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[LongEqual]", 
    SubsuperscriptBox["\[Xi]", "0", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Sigma]", "0", 
     StyleBox["LL",
      FontSlant->"Plain"]], "-", 
    StyleBox["i", "TI"], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", 
     StyleBox["j", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox["\[Xi]", 
     StyleBox["j", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Sigma]", 
     StyleBox["j", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "828799be-4ee6-4b83-a58e-fd4e82867edc"],
 " is multiplicative, has the determinant ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e9b37552-a074-4c27-8519-c9a17cc67bdc"],
 ", satisfies ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SuperscriptBox[
      StyleBox["b",
       FontWeight->"Bold",
       FontSlant->"Plain"], "\[Dagger]"], ")"}], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      StyleBox["b",
       FontWeight->"Bold",
       FontSlant->"Plain"], ")"}], "\[Dagger]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e01260e4-49c3-4446-83e4-21e5e2a8d425"],
 ", and every complex ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Times]", "2"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "16992595-bf87-4758-9f6a-c6142c4c6702"],
 " matrix is the matrix of exactly one bi-quaternion; the unit bi-quaternions \
(",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3aaaaea4-fa52-499d-aecd-6b828911e583"],
 ") are therefore the group ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SL", "TI"], 
    RowBox[{"(", 
     RowBox[{"2", ",", 
      StyleBox["\[DoubleStruckCapitalC]",
       FontSlant->"Plain"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7749ebb1-891e-4985-8d0e-b1283a9f2f7f"],
 "."
}], "Text",ExpressionUUID->"4d21be01-84e2-402d-8474-29633cba0bc2"],

Cell[TextData[{
 StyleBox["Bi-octonions and the super-loop.",
  FontWeight->"Bold"],
 " A bi-octonion is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["x",
     FontWeight->"Bold",
     FontSlant->"Plain"], "\[LongEqual]", 
    StyleBox["a",
     FontWeight->"Bold",
     FontSlant->"Plain"], "+", 
    StyleBox["b",
     FontWeight->"Bold",
     FontSlant->"Plain"], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5614c740-47d3-4197-9868-25c87a67649a"],
 " with two bi-quaternions, multiplied by the rule of Cayley and Dickson"
}], "Text",ExpressionUUID->"e2d18de9-9a22-41f4-9f15-6d5f8643948c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     StyleBox["a",
      FontWeight->"Bold",
      FontSlant->"Plain"], "+", 
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], "\[ThinSpace]", 
     SubscriptBox[
      StyleBox["e",
       FontWeight->"Bold",
       FontSlant->"Plain"], "4"]}], ")"}], 
   RowBox[{"(", 
    RowBox[{
     StyleBox["c",
      FontWeight->"Bold",
      FontSlant->"Plain"], "+", 
     StyleBox["d",
      FontWeight->"Bold",
      FontSlant->"Plain"], "\[ThinSpace]", 
     SubscriptBox[
      StyleBox["e",
       FontWeight->"Bold",
       FontSlant->"Plain"], "4"]}], ")"}], "\[LongEqual]", 
   RowBox[{"(", 
    RowBox[{
     StyleBox["a",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["c",
      FontWeight->"Bold",
      FontSlant->"Plain"], "-", 
     OverscriptBox[
      StyleBox["d",
       FontWeight->"Bold",
       FontSlant->"Plain"], "_"], 
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"]}], ")"}], "+", 
   RowBox[{"(", 
    RowBox[{
     StyleBox["d",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["a",
      FontWeight->"Bold",
      FontSlant->"Plain"], "+", 
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     OverscriptBox[
      StyleBox["c",
       FontWeight->"Bold",
       FontSlant->"Plain"], "_"]}], ")"}], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["e",
     FontWeight->"Bold",
     FontSlant->"Plain"], "4"], ","}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"341f0e1d-21cd-4849-98c9-a15d780afe63"],

Cell[TextData[{
 "with the eight units ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "0"], ",", "\[Ellipsis]", ",", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "3"], ",", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0c72e8e6-c0a8-4d7c-a5f4-2f8c300d3beb"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     RowBox[{"4", "+", 
      StyleBox["j", "TI"]}]], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5f5d7a1e-67b3-46b2-957e-7ff896940e11"],
 ". The norm is multiplicative, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox[
      RowBox[{"x", "y"}],
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["x",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["y",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c594f78d-61b3-4436-a443-467ba9e63d58"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["x",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    OverscriptBox[
     StyleBox["x",
      FontWeight->"Bold",
      FontSlant->"Plain"], "_"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["x",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "0"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f56597e5-1f19-45d1-89f3-024e7a476cc9"],
 ". The product is not associative (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["e",
        FontWeight->"Bold",
        FontSlant->"Plain"], "1"], 
      SubscriptBox[
       StyleBox["e",
        FontWeight->"Bold",
        FontSlant->"Plain"], "2"]}], ")"}], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "4"], "-", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "1"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["e",
        FontWeight->"Bold",
        FontSlant->"Plain"], "2"], 
      SubscriptBox[
       StyleBox["e",
        FontWeight->"Bold",
        FontSlant->"Plain"], "4"]}], ")"}], "\[LongEqual]", "2", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "7"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9f915726-28c4-4371-a233-577f56086708"],
 "), but it is alternative, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     StyleBox[
      RowBox[{"x", "x"}],
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    StyleBox["y",
     FontWeight->"Bold",
     FontSlant->"Plain"], "\[LongEqual]", 
    StyleBox["x",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     StyleBox[
      RowBox[{"x", "y"}],
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "346a0767-0719-40d6-89a1-c716c12ef95a"],
 ", and satisfies the three Moufang identities ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     StyleBox[
      RowBox[{"z", "x", "z"}],
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    StyleBox["y",
     FontWeight->"Bold",
     FontSlant->"Plain"], "\[LongEqual]", 
    StyleBox["z",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["x",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       StyleBox[
        RowBox[{"z", "y"}],
        FontWeight->"Bold",
        FontSlant->"Plain"], ")"}]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4a3895a7-b839-4969-a11b-e7407e97457c"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["y",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     StyleBox[
      RowBox[{"z", "x", "z"}],
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       StyleBox[
        RowBox[{"y", "z"}],
        FontWeight->"Bold",
        FontSlant->"Plain"], ")"}], 
      StyleBox["x",
       FontWeight->"Bold",
       FontSlant->"Plain"]}], ")"}], 
    StyleBox["z",
     FontWeight->"Bold",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f19172b3-badf-46bf-bb64-fa205849b34f"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     StyleBox[
      RowBox[{"z", "x"}],
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    RowBox[{"(", 
     StyleBox[
      RowBox[{"y", "z"}],
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["z",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       StyleBox[
        RowBox[{"x", "y"}],
        FontWeight->"Bold",
        FontSlant->"Plain"], ")"}]}], ")"}], 
    StyleBox["z",
     FontWeight->"Bold",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "38f9f3d2-d2f3-4d9e-8f0f-27cc3c1cd564"],
 ". The unit bi-octonions form the Lorentz super-loop ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["\[DoubleStruckCapitalL]",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4449af1a-d8dc-4989-a796-cee9c6464f23"],
 ", a Moufang loop of real dimension 14 that contains ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SL", "TI"], 
    RowBox[{"(", 
     RowBox[{"2", ",", 
      StyleBox["\[DoubleStruckCapitalC]",
       FontSlant->"Plain"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2b7d5bfd-7f71-463c-98ea-67547021cb64"],
 "."
}], "Text",ExpressionUUID->"272bfe88-8ea1-46c3-bf61-29d46550f2cb"],

Cell["\<\
The next cell checks these rules exactly: bi-octonions with small integer \
(Gaussian integer) coefficients are multiplied in exact arithmetic, so every \
identity must hold with the deviation exactly 0. Of the 343 ordered triples \
of imaginary units, 168 have a nonzero associator: a triple with two equal \
members has none (alternativity), and of the 210 triples of distinct units a \
triple has none exactly when its third unit is plus or minus the product of \
the first two, which leaves 210 - 42 = 168.\
\>", "Text",ExpressionUUID->"c4b12778-1c4d-415e-b74e-47db1a3aa7d7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"A", "-", "2"}], ":", " ", 
      RowBox[{
      "the", " ", "rules", " ", "of", " ", "the", " ", "eight", " ", 
       "units"}], ":", " ", 
      RowBox[{"e_p", "^", "2"}]}], " ", "=", " ", 
     RowBox[{"-", "1"}]}], ",", " ", 
    RowBox[{
     RowBox[{"e_p", " ", "e_q"}], " ", "=", " ", 
     RowBox[{
      RowBox[{"-", "e_q"}], " ", "e_p", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"p", " ", "!=", " ", "q"}], ",", " ", 
        RowBox[{"both", " ", ">=", " ", "1"}]}], ")"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"e_j", " ", "e_", "4"}], " ", "=", " ", 
     RowBox[{"e_", 
      RowBox[{"(", 
       RowBox[{"4", "+", "j"}], ")"}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"dA2", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Join", "[", "\n", "    ", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"oMax", "[", 
           RowBox[{
            RowBox[{"oMul", "[", 
             RowBox[{
              RowBox[{"oUnit", "[", "p", "]"}], ",", " ", 
              RowBox[{"oUnit", "[", "p", "]"}]}], "]"}], " ", "+", " ", 
            RowBox[{"oUnit", "[", "0", "]"}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"p", ",", " ", "1", ",", " ", "7"}], "}"}]}], "]"}], ",", 
        "\n", "    ", 
        RowBox[{"Flatten", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"p", " ", "!=", " ", "q"}], ",", " ", 
             RowBox[{"oMax", "[", 
              RowBox[{
               RowBox[{"oMul", "[", 
                RowBox[{
                 RowBox[{"oUnit", "[", "p", "]"}], ",", " ", 
                 RowBox[{"oUnit", "[", "q", "]"}]}], "]"}], " ", "+", " ", 
               RowBox[{"oMul", "[", 
                RowBox[{
                 RowBox[{"oUnit", "[", "q", "]"}], ",", " ", 
                 RowBox[{"oUnit", "[", "p", "]"}]}], "]"}]}], "]"}], ",", " ",
              "0"}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"p", ",", " ", "1", ",", " ", "7"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"q", ",", " ", "1", ",", " ", "7"}], "}"}]}], "]"}], 
         "]"}], ",", "\n", "    ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"oMax", "[", 
           RowBox[{
            RowBox[{"oMul", "[", 
             RowBox[{
              RowBox[{"oUnit", "[", "j", "]"}], ",", " ", 
              RowBox[{"oUnit", "[", "4", "]"}]}], "]"}], " ", "-", " ", 
            RowBox[{"oUnit", "[", 
             RowBox[{"4", " ", "+", " ", "j"}], "]"}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"j", ",", " ", "1", ",", " ", "3"}], "}"}]}], "]"}]}], 
       "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WA-2\>\"", ",", 
      " ", "\"\<bi-octonion units: e_p^2 = -1, e_p e_q = -e_q e_p, e_j e_4 = \
e_(4+j) (exact)\>\"", ",", " ", "dA2", ",", " ", "0", ",", " ", "\"\<A-2\>\"",
       ",", " ", "\"\<A-2\>\""}], "]"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"rintBio", "[", "]"}], " ", "is", " ", "a", " ", "random", " ", 
      "bi"}], "-", 
     RowBox[{"octonion", " ", "with", " ", "Gaussian"}], "-", 
     RowBox[{"integer", " ", "coefficients", " ", "between"}], " ", "-", 
     RowBox[{"3", " ", "and", " ", "3"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"rintBio", "[", "]"}], " ", ":=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"RandomInteger", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "3"}], ",", " ", "3"}], "}"}], ",", " ", "4"}], 
         "]"}], " ", "+", " ", 
        RowBox[{"I", " ", 
         RowBox[{"RandomInteger", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "3"}], ",", " ", "3"}], "}"}], ",", " ", "4"}], 
          "]"}]}]}], ",", " ", 
       RowBox[{
        RowBox[{"RandomInteger", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "3"}], ",", " ", "3"}], "}"}], ",", " ", "4"}], 
         "]"}], " ", "+", " ", 
        RowBox[{"I", " ", 
         RowBox[{"RandomInteger", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "3"}], ",", " ", "3"}], "}"}], ",", " ", "4"}], 
          "]"}]}]}]}], "}"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"A", "-", 
      RowBox[{"3", " ", "to", " ", "A"}], "-", 
      RowBox[{
      "6", " ", "on", " ", "200", " ", "random", " ", "triples", " ", 
       RowBox[{"(", 
        RowBox[{"x", ",", " ", "y", ",", " ", "z"}], ")"}]}]}], ",", " ", 
     RowBox[{"in", " ", "exact", " ", "arithmetic"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dA3", ",", " ", "dA4", ",", " ", "dA5", ",", " ", "dA6"}], 
      "}"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], "}"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"x", " ", "=", " ", 
           RowBox[{"rintBio", "[", "]"}]}], ",", " ", 
          RowBox[{"y", " ", "=", " ", 
           RowBox[{"rintBio", "[", "]"}]}], ",", " ", 
          RowBox[{"z", " ", "=", " ", 
           RowBox[{"rintBio", "[", "]"}]}], ",", " ", "zxz"}], "}"}], ",", 
        "\n", "   ", 
        RowBox[{
         RowBox[{"dA3", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"dA3", ",", " ", 
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"oNorm", "[", 
               RowBox[{"oMul", "[", 
                RowBox[{"x", ",", " ", "y"}], "]"}], "]"}], " ", "-", " ", 
              RowBox[{
               RowBox[{"oNorm", "[", "x", "]"}], " ", 
               RowBox[{"oNorm", "[", "y", "]"}]}]}], "]"}]}], "]"}]}], ";", 
         "\n", "   ", 
         RowBox[{"dA4", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"dA4", ",", " ", 
            RowBox[{"oMax", "[", 
             RowBox[{
              RowBox[{"oMul", "[", 
               RowBox[{"x", ",", " ", 
                RowBox[{"oBar", "[", "x", "]"}]}], "]"}], " ", "-", " ", 
              RowBox[{
               RowBox[{"oNorm", "[", "x", "]"}], " ", 
               RowBox[{"oUnit", "[", "0", "]"}]}]}], "]"}]}], "]"}]}], ";", 
         "\n", "   ", 
         RowBox[{"dA5", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"dA5", ",", " ", 
            RowBox[{"oMax", "[", 
             RowBox[{
              RowBox[{"oMul", "[", 
               RowBox[{
                RowBox[{"oMul", "[", 
                 RowBox[{"x", ",", " ", "x"}], "]"}], ",", " ", "y"}], "]"}], 
              " ", "-", " ", 
              RowBox[{"oMul", "[", 
               RowBox[{"x", ",", " ", 
                RowBox[{"oMul", "[", 
                 RowBox[{"x", ",", " ", "y"}], "]"}]}], "]"}]}], "]"}], ",", 
            " ", 
            RowBox[{"oMax", "[", 
             RowBox[{
              RowBox[{"oMul", "[", 
               RowBox[{
                RowBox[{"oMul", "[", 
                 RowBox[{"y", ",", " ", "x"}], "]"}], ",", " ", "x"}], "]"}], 
              " ", "-", " ", 
              RowBox[{"oMul", "[", 
               RowBox[{"y", ",", " ", 
                RowBox[{"oMul", "[", 
                 RowBox[{"x", ",", " ", "x"}], "]"}]}], "]"}]}], "]"}]}], 
           "]"}]}], ";", "\n", "   ", 
         RowBox[{"zxz", " ", "=", " ", 
          RowBox[{"oMul", "[", 
           RowBox[{
            RowBox[{"oMul", "[", 
             RowBox[{"z", ",", " ", "x"}], "]"}], ",", " ", "z"}], "]"}]}], ";",
          "\n", "   ", 
         RowBox[{"dA6", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"dA6", ",", " ", 
            RowBox[{"oMax", "[", 
             RowBox[{
              RowBox[{"oMul", "[", 
               RowBox[{"zxz", ",", " ", "y"}], "]"}], " ", "-", " ", 
              RowBox[{"oMul", "[", 
               RowBox[{"z", ",", " ", 
                RowBox[{"oMul", "[", 
                 RowBox[{"x", ",", " ", 
                  RowBox[{"oMul", "[", 
                   RowBox[{"z", ",", " ", "y"}], "]"}]}], "]"}]}], "]"}]}], 
             "]"}], ",", " ", 
            RowBox[{"oMax", "[", 
             RowBox[{
              RowBox[{"oMul", "[", 
               RowBox[{"y", ",", " ", "zxz"}], "]"}], " ", "-", " ", 
              RowBox[{"oMul", "[", 
               RowBox[{
                RowBox[{"oMul", "[", 
                 RowBox[{
                  RowBox[{"oMul", "[", 
                   RowBox[{"y", ",", " ", "z"}], "]"}], ",", " ", "x"}], 
                 "]"}], ",", " ", "z"}], "]"}]}], "]"}], ",", "\n", "     ", 
            RowBox[{"oMax", "[", 
             RowBox[{
              RowBox[{"oMul", "[", 
               RowBox[{
                RowBox[{"oMul", "[", 
                 RowBox[{"z", ",", " ", "x"}], "]"}], ",", " ", 
                RowBox[{"oMul", "[", 
                 RowBox[{"y", ",", " ", "z"}], "]"}]}], "]"}], " ", "-", " ", 
              
              RowBox[{"oMul", "[", 
               RowBox[{
                RowBox[{"oMul", "[", 
                 RowBox[{"z", ",", " ", 
                  RowBox[{"oMul", "[", 
                   RowBox[{"x", ",", " ", "y"}], "]"}]}], "]"}], ",", " ", 
                "z"}], "]"}]}], "]"}]}], "]"}]}]}]}], "]"}], ",", " ", 
      RowBox[{"{", "200", "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WA-3\>\"", ",", 
      " ", "\"\<N(xy) = N(x) N(y), 200 random Gaussian-integer bi-octonions \
(exact)\>\"", ",", " ", "dA3", ",", " ", "0", ",", " ", "\"\<A-3\>\"", ",", 
      " ", "\"\<A-3\>\""}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WA-4\>\"", ",", " ", "\"\<x xbar = N(x) e_0 (exact)\>\"", ",",
       " ", "dA4", ",", " ", "0", ",", " ", "\"\<A-4\>\"", ",", 
      " ", "\"\<A-4\>\""}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WA-5\>\"", ",", 
      " ", "\"\<alternativity (xx)y = x(xy), (yx)x = y(xx) (exact)\>\"", ",", 
      " ", "dA5", ",", " ", "0", ",", " ", "\"\<A-5\>\"", ",", 
      " ", "\"\<A-5\>\""}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WA-6\>\"", ",", 
      " ", "\"\<the three Moufang identities (exact)\>\"", ",", " ", "dA6", ",",
       " ", "0", ",", " ", "\"\<A-6\>\"", ",", " ", "\"\<A-6\>\""}], "]"}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"A", "-", "7"}], ":", " ", 
      RowBox[{
      "the", " ", "associators", " ", "of", " ", "the", " ", "343", " ", 
       "ordered", " ", "triples", " ", "of", " ", "imaginary", " ", 
       "units"}]}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"and", " ", 
        RowBox[{"(", 
         RowBox[{"e1", " ", "e2"}], ")"}], " ", "e4"}], " ", "-", " ", 
       RowBox[{"e1", " ", 
        RowBox[{"(", 
         RowBox[{"e2", " ", "e4"}], ")"}]}]}], " ", "=", " ", 
      RowBox[{"2", " ", "e7"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"nonzeroAssociators", " ", "=", " ", 
     RowBox[{"Count", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"oMax", "[", 
           RowBox[{
            RowBox[{"oMul", "[", 
             RowBox[{
              RowBox[{"oMul", "[", 
               RowBox[{
                RowBox[{"oUnit", "[", "p", "]"}], ",", " ", 
                RowBox[{"oUnit", "[", "q", "]"}]}], "]"}], ",", " ", 
              RowBox[{"oUnit", "[", "r", "]"}]}], "]"}], " ", "-", " ", 
            RowBox[{"oMul", "[", 
             RowBox[{
              RowBox[{"oUnit", "[", "p", "]"}], ",", " ", 
              RowBox[{"oMul", "[", 
               RowBox[{
                RowBox[{"oUnit", "[", "q", "]"}], ",", " ", 
                RowBox[{"oUnit", "[", "r", "]"}]}], "]"}]}], "]"}]}], "]"}], ",",
           "\n", "      ", 
          RowBox[{"{", 
           RowBox[{"p", ",", " ", "1", ",", " ", "7"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"q", ",", " ", "1", ",", " ", "7"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"r", ",", " ", "1", ",", " ", "7"}], "}"}]}], "]"}], "]"}],
        ",", " ", 
       RowBox[{"v_", " ", "/;", " ", 
        RowBox[{"v", " ", ">", " ", "0"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"a124", " ", "=", " ", 
     RowBox[{
      RowBox[{"oMul", "[", 
       RowBox[{
        RowBox[{"oMul", "[", 
         RowBox[{
          RowBox[{"oUnit", "[", "1", "]"}], ",", " ", 
          RowBox[{"oUnit", "[", "2", "]"}]}], "]"}], ",", " ", 
        RowBox[{"oUnit", "[", "4", "]"}]}], "]"}], " ", "-", " ", 
      RowBox[{"oMul", "[", 
       RowBox[{
        RowBox[{"oUnit", "[", "1", "]"}], ",", " ", 
        RowBox[{"oMul", "[", 
         RowBox[{
          RowBox[{"oUnit", "[", "2", "]"}], ",", " ", 
          RowBox[{"oUnit", "[", "4", "]"}]}], "]"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"checkTrue", "[", 
     RowBox[{"\"\<WA-7\>\"", ",", 
      " ", "\"\<168 of the 343 triples of imaginary units have a nonzero \
associator; (e1 e2) e4 - e1 (e2 e4) = 2 e7\>\"", ",", "\n", "  ", 
      RowBox[{
       RowBox[{"nonzeroAssociators", " ", "==", " ", "168"}], " ", "&&", " ", 
       
       RowBox[{
        RowBox[{"oMax", "[", 
         RowBox[{"a124", " ", "-", " ", 
          RowBox[{"2", " ", 
           RowBox[{"oUnit", "[", "7", "]"}]}]}], "]"}], " ", "==", " ", 
        "0"}]}], ",", " ", 
      RowBox[{
       RowBox[{"ToString", "[", "nonzeroAssociators", "]"}], " ", "<>", 
       " ", "\"\< nonzero\>\""}], ",", " ", "\"\<A-7\>\"", ",", 
      " ", "\"\<A-7\>\""}], "]"}], ";"}]}]}]], "Input",
 CellLabel->"In[51]:=",ExpressionUUID->"ea50571a-0699-42aa-a8e6-da87931986c9"],

