            RowBox[{"channelOps", "[", "o", "]"}], " ", ".", " ", 
            RowBox[{"channelStates", "[", "c", "]"}]}], "]"}]}], ",", "\n", 
         "     ", 
         RowBox[{"{", 
          RowBox[{"o", ",", " ", 
           RowBox[{"Keys", "[", "channelOps", "]"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"c", ",", " ", 
           RowBox[{"Keys", "[", "channelStates", "]"}]}], "}"}]}], "]"}], 
       "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"the", " ", "table", " ", "of", " ", "the", " ", "Rust", " ", 
     RowBox[{"program", ":", " ", 
      RowBox[{"the", " ", "operator", " ", "name", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"first", " ", "word"}], ",", " ", 
         RowBox[{
          RowBox[{"or", " ", "\"\<boson W1\>\""}], " ", "..."}]}], ")"}], " ",
        "and", " ", "the", " ", "channel", " ", 
       RowBox[{"(", 
        RowBox[{"first", " ", "token"}], ")"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"rustPairEnergy", " ", "=", " ", 
     RowBox[{"Association", "[", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"StringStartsQ", "[", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", " ", "\"\<boson\>\""}], 
               "]"}], ",", " ", 
              RowBox[{"StringRiffle", "[", 
               RowBox[{"Take", "[", 
                RowBox[{
                 RowBox[{"StringSplit", "[", 
                  RowBox[{"#", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", " ", "2"}], 
                "]"}], "]"}], ",", " ", 
              RowBox[{"First", "[", 
               RowBox[{"StringSplit", "[", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}]}], "]"}], ",", 
            "\n", "       ", 
            RowBox[{"First", "[", 
             RowBox[{"StringSplit", "[", 
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}]}], "}"}], " ", "->",
           " ", 
          RowBox[{"#", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], " ", "&"}], ",", " ", 
        "rustPairChannels"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WP2-0a\>\"", ",", 
      " ", "\"\<pair-channel energies of 7 operators in 6 channels (exact \
algebra of one point) = the table of the Rust program\>\"", ",", "\n", "  ", 
      RowBox[{"Max", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"pairEnergy", "[", "k", "]"}], " ", "-", " ", 
