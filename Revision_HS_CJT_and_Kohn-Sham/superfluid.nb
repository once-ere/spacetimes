Cell[TextData[{
 "The photon attracts the condensed pair (positive eigenvalue) and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a79170b7-809c-4086-8b5c-699b2a3a0964"],
 " repels it four times as strongly. ",
 StyleBox["CJT with the exchange.",
  FontWeight->"Bold"],
 " The last cell of Part II makes the CJT state of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "2", ")"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e13bd5ad-4220-4e2a-9b45-93b904aa669a"],
 " self-consistent with the exchange of all four gauge bosons added to the \
contact terms: the self-energies now depend on the momentum, and the matrix \
of Bogoliubov and de Gennes at the momentum ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["q", "TI"], "\[RightVector]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8a43adb0-1b24-4a5a-a20a-9e1672452883"],
 " contains the exchange self-energies at ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["q", "TI"], "\[RightVector]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "18328674-024f-464c-a96e-78923f48da90"],
 " (and at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    OverscriptBox[
     StyleBox["q", "TI"], "\[RightVector]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "07a51f3d-a797-48ca-8424-31b815adf3ae"],
 " in its lower block). The boson masses are those of the Rust program, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["M", "TI"], 
    StyleBox["W", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7ccd5ff4-44a8-42b6-b602-5bafc44e92c4"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["M", "TI"], 
    StyleBox["Z", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "aeac69e6-05db-4e60-b35d-428d79a7d019"],
 " of this state and a massless photon; the iteration mixes one half of the \
new self-energies until they change by less than ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "11"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ab748d36-beef-4889-bffb-62fed4028c60"],
 ". The superfluid survives, and the energy agrees with the Rust value."
}], "Text",ExpressionUUID->"74cf32e9-5ff3-415f-8dc8-d9535fbd8f2b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
     "CJT", " ", "with", " ", "the", " ", "exchange", " ", "of", " ", "the", " ",
       "four", " ", "gauge", " ", "bosons", " ", "at", " ", "g_v"}], " ", "=",
      " ", "0.7"}], ",", " ", 
    RowBox[{"g_F", " ", "=", " ", "0.45"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "mo", ",", " ", "s", ",", " ", "bos", ",", " ", "nc", ",", " ", "pc", ",",
        " ", "nex", ",", " ", "pex", ",", " ", 
       RowBox[{"it", " ", "=", " ", "0"}], ",", " ", 
       RowBox[{"res", " ", "=", " ", "1."}], ",", " ", "cn", ",", " ", "cp", ",",
        " ", "ev", ",", " ", "rho", ",", " ", "kap", ",", " ", "ek", ",", " ",
        "ei", ",", " ", "n2", ",", " ", "p2", ",", " ", "n3", ",", " ", "p3", 
       ",", " ", "eex", ",", " ", "masses"}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"mo", ",", " ", "s"}], "}"}], " ", "=", " ", 
       RowBox[{"groundSF", "[", "\"\<V2_CJT\>\"", "]"}]}], ";", "\n", "  ", 
      RowBox[{"masses", " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"rustPart2", "[", "\"\<p2_cjtex_M_W\>\"", "]"}], ",", " ", 
         RowBox[{"rustPart2", "[", "\"\<p2_cjtex_M_W\>\"", "]"}], ",", " ", 
         "0.", ",", " ", 
         RowBox[{"rustPart2", "[", "\"\<p2_cjtex_M_Z\>\"", "]"}]}], "}"}]}], ";",
       "\n", "  ", 
      RowBox[{"bos", " ", "=", " ", 
       RowBox[{"makeBosons", "[", 
        RowBox[{
         RowBox[{"mo", "[", "\"\<g\>\"", "]"}], ",", " ", "gvLL", ",", " ", 
         "gfLL", ",", " ", "masses"}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"nc", " ", "=", " ", 
       RowBox[{"s", "[", "\"\<n\>\"", "]"}]}], ";", " ", 
      RowBox[{"pc", " ", "=", " ", 
       RowBox[{"s", "[", "\"\<p\>\"", "]"}]}], ";", "\n", "  ", 
      RowBox[{"nex", " ", "=", " ", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"zero8", ",", " ", 
         RowBox[{
          RowBox[{"mo", "[", "\"\<g\>\"", "]"}], "[", "\"\<n\>\"", "]"}]}], 
        "]"}]}], ";", " ", 
      RowBox[{"pex", " ", "=", " ", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"zero8", ",", " ", 
         RowBox[{
          RowBox[{"mo", "[", "\"\<g\>\"", "]"}], "[", "\"\<n\>\"", "]"}]}], 
        "]"}]}], ";", "\n", "  ", 
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"res", " ", ">=", " ", 
          RowBox[{"10", "^", 
           RowBox[{"-", "11"}]}]}], " ", "&&", " ", 
         RowBox[{"it", " ", "<", " ", "20000"}]}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"cn", ",", " ", "cp", ",", " ", "ev"}], "}"}], " ", "=", 
          " ", 
          RowBox[{"states", "[", 
           RowBox[{"bdg", "[", 
            RowBox[{
            "mo", ",", " ", "nc", ",", " ", "pc", ",", " ", "nex", ",", " ", 
             "pex"}], "]"}], "]"}]}], ";", "\n", "   ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"rho", ",", " ", "kap", ",", " ", "ek"}], "}"}], " ", "=", 
          " ", 
          RowBox[{"localDens", "[", 
           RowBox[{"mo", ",", " ", "cn", ",", " ", "cp"}], "]"}]}], ";", "\n",
          "   ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ei", ",", " ", "n2", ",", " ", "p2"}], "}"}], " ", "=", 
          " ", 
          RowBox[{"interaction", "[", 
           RowBox[{
            RowBox[{"mo", "[", "\"\<ts\>\"", "]"}], ",", " ", "rho", ",", " ",
             "kap"}], "]"}]}], ";", "\n", "   ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"n3", ",", " ", "p3", ",", " ", "eex"}], "}"}], " ", "=", 
          " ", 
          RowBox[{"exchangeSF", "[", 
           RowBox[{
            RowBox[{"mo", "[", "\"\<g\>\"", "]"}], ",", " ", "bos", ",", " ", 
            
            RowBox[{"cn", " ", "-", " ", 
             RowBox[{"mo", "[", "\"\<vac\>\"", "]"}]}], ",", " ", "cp"}], 
           "]"}]}], ";", "\n", "   ", 
         RowBox[{"res", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"n2", " ", "-", " ", "nc"}], "]"}], ",", " ", 
            RowBox[{"Abs", "[", 
             RowBox[{"p2", " ", "-", " ", "pc"}], "]"}], ",", " ", 
            RowBox[{"Abs", "[", 
             RowBox[{"n3", " ", "-", " ", "nex"}], "]"}], ",", " ", 
            RowBox[{"Abs", "[", 
             RowBox[{"p3", " ", "-", " ", "pex"}], "]"}]}], "]"}]}], ";", 
         "\n", "   ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"res", " ", ">=", " ", 
            RowBox[{"10", "^", 
             RowBox[{"-", "11"}]}]}], ",", "\n", "    ", 
           RowBox[{
            RowBox[{"nc", " ", "=", " ", 
             RowBox[{
              RowBox[{"0.5", " ", "n2"}], " ", "+", " ", 
              RowBox[{"0.5", " ", "nc"}]}]}], ";", " ", 
            RowBox[{"pc", " ", "=", " ", 
             RowBox[{
              RowBox[{"0.5", " ", "p2"}], " ", "+", " ", 
              RowBox[{"0.5", " ", "pc"}]}]}], ";", "\n", "    ", 
            RowBox[{"nex", " ", "=", " ", 
             RowBox[{
              RowBox[{"0.5", " ", "n3"}], " ", "+", " ", 
              RowBox[{"0.5", " ", "nex"}]}]}], ";", " ", 
            RowBox[{"pex", " ", "=", " ", 
             RowBox[{
              RowBox[{"0.5", " ", "p3"}], " ", "+", " ", 
              RowBox[{"0.5", " ", "pex"}]}]}], ";", "\n", "    ", 
            RowBox[{"it", "++"}]}]}], "]"}]}]}], "]"}], ";", "\n", "  ", 
      RowBox[{"cjtExchange", " ", "=", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<energy\>\"", " ", "->", " ", 
          RowBox[{"ek", " ", "+", " ", "ei", " ", "+", " ", "eex"}]}], ",", 
         " ", 
         RowBox[{"\"\<exchange\>\"", " ", "->", " ", "eex"}], ",", " ", 
         RowBox[{"\"\<iterations\>\"", " ", "->", " ", "it"}]}], "|>"}]}], ";",
       "\n", "  ", 
      RowBox[{"check", "[", 
       RowBox[{"\"\<WP2-8d\>\"", ",", " ", 
        RowBox[{"\"\<CJT with the exchange at g_v = 0.7, g_F = 0.45: energy \
\>\"", " ", "<>", " ", 
         RowBox[{"sci", "[", 
          RowBox[{"ek", " ", "+", " ", "ei", " ", "+", " ", "eex"}], "]"}], 
         " ", "<>", " ", "\"\< = Rust (relative; \>\"", " ", "<>", " ", 
         RowBox[{"ToString", "[", "it", "]"}], " ", "<>", 
         " ", "\"\< iterations; exchange energy \>\"", " ", "<>", " ", 
         RowBox[{"sci", "[", "eex", "]"}], " ", "<>", " ", "\"\<)\>\""}], ",",
         "\n", "   ", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"ek", " ", "+", " ", "ei", " ", "+", " ", "eex"}], ")"}], 
           " ", "-", " ", 
           RowBox[{"rustPart2", "[", "\"\<p2_cjtex_energy\>\"", "]"}]}], 
          "]"}], "/", 
         RowBox[{"Abs", "[", 
          RowBox[{"rustPart2", "[", "\"\<p2_cjtex_energy\>\"", "]"}], "]"}]}],
         ",", " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "7"}]}], ",", " ", "\"\<P2-8f\>\"", ",", 
        " ", "\"\<YP2-8d\>\""}], "]"}]}]}], "]"}], ";"}]}]], "Input",
 CellLabel->
  "In[269]:=",ExpressionUUID->"7edfeae8-b45e-4231-91cd-1d5a7c5029b1"],

