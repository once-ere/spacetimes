Cell[CellGroupData[{

Cell["\<\
Part III, first section. The Landau form of the effective potentials: what it \
is, how accurate it is, and why that matters\
\>", "Chapter",ExpressionUUID->"5321da28-d3e3-4720-aa36-abe33119c05f"],

Cell[TextData[{
 "Part III of the solution builds the effective Lagrangians ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["\[ScriptCapitalL]",
     FontSlant->"Plain"], 
    StyleBox["CJT",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "751e991b-8b5d-49c6-bd71-07d8dd47349f"],
 ", ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["\[ScriptCapitalL]",
     FontSlant->"Plain"], 
    StyleBox["HS",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3ac23241-ff30-4921-a3dc-df0a0d06bbfd"],
 ", ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["\[ScriptCapitalL]",
     FontSlant->"Plain"], 
    StyleBox["KS",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fb70d49b-b5aa-43b4-b86d-3df0febb99f1"],
 " of the field of the superfluid boson singlet state. Their potential parts \
were summarized by a polynomial, the Landau form, with the remark: \"The \
Landau form is a fit; its largest residual is 0.27-0.7 % of the depth\". The \
author asked (21 November 2026) to explain this remark clearly and completely \
and why it is important, to define the Landau form with examples, and to keep \
the answer in the documents and in this notebook. This chapter is that \
answer. It is the first section of Part III in the notebook; the other \
sections of Part III, and Part II, whose engine computes the curves used \
here, follow in the next versions. Until then the computed curves are taken \
from the Rust program ",
 StyleBox["sf_part3",
  FontFamily->"Source Code Pro"],
 " (the closed cell of Section III.L.3, with the SHA-256 checksums of its \
data files), and this chapter recomputes from them, by its own least squares, \
every number of the answer."
}], "Text",ExpressionUUID->"fdcd4e86-0797-45c1-8f66-0485de0d82ce"],

Cell[CellGroupData[{

Cell["III.L.1 The objects", "Section",ExpressionUUID->"a55c5938-a1ca-40b9-885a-18f194e3f06f"],

Cell[TextData[{
 StyleBox["The field and its effective potential.",
  FontWeight->"Bold"],
 " The field of the superfluid boson singlet state is the complex isospin \
vector ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["\[CapitalPhi]", 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", "1"}]], ",", 
      SubsuperscriptBox["\[CapitalPhi]", 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", "2"}]], ",", 
      SubsuperscriptBox["\[CapitalPhi]", 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", "3"}]]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "62375523-8977-4b95-b31e-79fb38aa497d"],
 " of the amplitudes of the pair self-energy of a uniform state, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["P",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"]], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", "\[Iota]",
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox["\[CapitalPhi]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", "\[Iota]"}]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "\[Iota]"], ")"}], "\[Dagger]"]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "25118c18-4ca5-4191-a7a4-79ed8f1b13d8"],
 ", where ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "458066dd-79d5-45cf-85ff-88cf248490be"],
 " are the three pair matrices of Part I (",
 StyleBox["kLL[iota]",
  FontFamily->"Source Code Pro"],
 " in the code) and ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "920df98a-50a7-4fe1-933e-b7c66f8a9e70"],
 " is one of the five computed methods: HS ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"1", ",", "1"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b3ab81b8-dcf5-41d2-88ad-21ced7a82ee9"],
 ", HS ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "1"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2c5343ae-0a5a-4974-be2f-455ec2a7c6d3"],
 ", HS ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "0"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a07876d2-4e27-48ea-b807-cd690df03c06"],
 " (the method of Hubbard and Stratonovich with the shares ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["s", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["HS",
      FontSlant->"Plain"], ",", 
     StyleBox["S",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0ecf9a94-4e6b-4599-ab48-7d315f7cbffb"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["s", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["HS",
      FontSlant->"Plain"], ",", 
     StyleBox["V",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "feeef637-28bc-4acd-b008-ea66373ef841"],
 " of the scalar and the vector term decoupled in the density channels), KS \
(Kohn and Sham) and CJT (Cornwall, Jackiw and Tomboulis). The effective \
potential ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalV]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], 
    RowBox[{"(", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], ")"}]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "551bc81f-d44a-4023-86eb-7ff64771324a"],
 " is the smallest energy per volume of method ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4dba718e-34fe-4f21-8edb-2526f465ee1b"],
 " among the uniform states whose field is ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[CapitalPhi]", "\[RightVector]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "896cc825-de95-4ed0-a187-8c4d89c880ba"],
 ", measured from the normal vacuum, so that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalV]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], 
    RowBox[{"(", "0", ")"}], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fb760116-ee60-4eda-8686-43c713b60bd7"],
 "."
}], "Text",ExpressionUUID->"2fe7dc05-9bf3-42d5-9f05-1465cd5454b6"],

Cell[TextData[{
 StyleBox["How it is computed.",
  FontWeight->"Bold"],
 " A fixed pair self-energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "408290e0-a32c-4643-aa20-bc54812715e5"],
 ", the applied field of amplitude ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPhi]", 
    StyleBox["a",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8b0a07cb-832d-494a-aada-6fec6873fc05"],
 ", is put into the matrix of Bogoliubov and de Gennes, the normal \
self-energy is made self-consistent, and the ground state gives one point: \
its own field ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "\[LongEqual]", 
    "\[CapitalPhi]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["e", "TI"], "\[RightVector]"], "3"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0fec7fc6-6320-41d5-9157-b29b3a73c745"],
 " and its energy per volume. The Rust program computes 61 points per method, \
with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPhi]", 
    StyleBox["a",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "13a2d346-972f-41a6-a15b-ed67a31ce400"],
 " from ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "76bcb306-e423-4fac-bc4f-9ef8a5812ba4"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    SubsuperscriptBox["\[CapitalPhi]", 
     RowBox[{"0", ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e2b529fd-c9be-4265-b85e-039691f5dd0d"],
 ", each self-consistent to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "13"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dd27af5f-e076-4d3a-88c1-436b183353b5"],
 ". Along the ",
 StyleBox["polar",
  FontWeight->"Bold"],
 " fields ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      StyleBox["i", "TI"], "\[CurlyTheta]"}]], "\[CapitalPhi]", 
    OverscriptBox[
     StyleBox["n", "TI"], "\[RightVector]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2841101a-c657-44c2-b4ac-16afd3e799e9"],
 " (real phase ",
 Cell[BoxData[
  FormBox["\[CurlyTheta]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1234dc62-6843-48b3-8910-55b7a8738e87"],
 ", real unit vector ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["n", "TI"], "\[RightVector]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7388f0e0-fe65-4699-a3f7-8188dd19b93b"],
 ") the potential depends on ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPhi]", "\[LongEqual]", 
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1215fcc7-40af-4ff7-9ea2-9452b3688c0c"],
 " alone. Its minimum lies at ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalPhi]", 
    RowBox[{"0", ",", 
     StyleBox["SF",
      FontSlant->"Plain"]}], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "521cee9b-6593-43c7-bca4-5716386fbd82"],
 " (the vacuum), and the ",
 StyleBox["depth",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftBracketingBar]", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["\[ScriptCapitalV]",
       FontSlant->"Plain"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      StyleBox["X", "TI"]], 
     RowBox[{"(", 
      SubsuperscriptBox["\[CapitalPhi]", 
       RowBox[{"0", ",", 
        StyleBox["SF",
         FontSlant->"Plain"]}], 
       StyleBox["X", "TI"]], ")"}]}], "\[RightBracketingBar]"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "56b9a275-e2c7-4436-983f-e376ca0b96d7"],
 " is the energy per volume by which the superfluid lies below the normal \
vacuum. The second derivative ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalV]",
     FontSlant->"Plain"], 
    StyleBox["amp",
     FontSlant->"Plain"], "\[Prime]\[Prime]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7756a92d-a37c-4557-9e2a-ce60b14dda33"],
 " of the polar curve at its minimum fixes the mass of the amplitude mode, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["H",
         FontSlant->"Plain"]}]], ")"}], "2"], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalV]",
      FontSlant->"Plain"], 
     StyleBox["amp",
      FontSlant->"Plain"], "\[Prime]\[Prime]"], "/", 
    RowBox[{"(", 
     RowBox[{"2", 
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox[
         StyleBox["Z", "TI"], 
         StyleBox["SF",
          FontSlant->"Plain"], 
         StyleBox["X", "TI"]], "+", 
        SubsuperscriptBox[
         StyleBox["Y", "TI"], 
         StyleBox["SF",
          FontSlant->"Plain"], 
         StyleBox["X", "TI"]]}], ")"}]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8076450f-d6ea-470d-8e20-fb3d9e01d3da"],
 ", where ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["Z", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3de6be13-1b41-4124-8792-6eb74e7c9b9e"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["Y", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1c5d07ea-9355-404c-a483-444e7941b9e4"],
 " are the two coefficients of the kinetic part of the effective Lagrangian."
}], "Text",ExpressionUUID->"024ec13a-7af4-498f-a1d5-e205a3870554"]
}, Open  ]],

Cell[CellGroupData[{

Cell["III.L.2 The Landau form: definition and examples", "Section",ExpressionUUID->"ae6b6ea2-540f-4878-ac47-8544632fc034"],

Cell[TextData[{
 StyleBox["Definition.",
  FontWeight->"Bold"],
 " A Landau form of a potential is its expansion in powers of the order \
parameter (the field that vanishes in the symmetric state and not in the \
broken one) under two rules: only polynomial invariants of the symmetry group \
occur, and the expansion stops after the lowest orders that bound the \
potential from below and produce its minima. L. D. Landau introduced it for \
phase transitions (1937): near a continuous transition the order parameter is \
small, the free energy is assumed to be analytic in it, and the form is its \
Taylor expansion, whose coefficients (the Landau coefficients) are \
derivatives at the symmetric state. The quadratic coefficient changes its \
sign at the transition; the signs of the higher coefficients decide the order \
of the transition and which broken state is the minimum. Examples:"
}], "Text",ExpressionUUID->"2af4cc8f-3a74-4d86-bbf9-e65b56d8eaf7"],

Cell[TextData[{
 "A uniaxial ferromagnet: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["F", "TI"], 
     StyleBox["mag",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["mag",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["mag",
      FontSlant->"Plain"], "2"], "+", 
    SubscriptBox[
     StyleBox["b", "TI"], 
     StyleBox["mag",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["mag",
      FontSlant->"Plain"], "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d1e95633-3594-4bb4-9769-1ebd9773374f"],
 " for the magnetization ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["mag",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4503fa2d-d532-4e20-a091-e15fc34cf9ca"],
 " (the symmetry ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["mag",
      FontSlant->"Plain"]], "\[RightArrow]", 
    RowBox[{"-", 
     SubscriptBox[
      StyleBox["m", "TI"], 
      StyleBox["mag",
       FontSlant->"Plain"]]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "593acd8d-2579-48a4-a346-fa7e5d58e157"],
 "), with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["mag",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "15d310e1-de61-4911-bc4a-a3caa6a31b72"],
 " proportional to the temperature minus the Curie temperature and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["b", "TI"], 
     StyleBox["mag",
      FontSlant->"Plain"]], ">", "0"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cd8f980d-c75f-41c9-a1ef-5ed2bdc9ddcb"],
 "; below the Curie temperature the minima are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["mag",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"\[PlusMinus]", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", 
         SubscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["mag",
           FontSlant->"Plain"]]}], "/", 
        RowBox[{"(", 
         RowBox[{"2", 
          SubscriptBox[
           StyleBox["b", "TI"], 
           StyleBox["mag",
            FontSlant->"Plain"]]}], ")"}]}], ")"}], 
      RowBox[{"1", "/", "2"}]]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "09bd10c9-b1c4-44fd-b407-2f8b67d8d2ca"],
 "."
}], "Item",ExpressionUUID->"975b0a6d-9860-41ec-a2d8-b074eeab1340"],

Cell[TextData[{
 "The theory of superconductivity of V. L. Ginzburg and L. D. Landau (1950): ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Alpha]", 
     StyleBox["GL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      SubscriptBox["\[Psi]", 
       StyleBox["GL",
        FontSlant->"Plain"]], "\[RightBracketingBar]"}], "2"], "+", 
    FractionBox["1", "2"], 
    SubscriptBox["\[Beta]", 
     StyleBox["GL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      SubscriptBox["\[Psi]", 
       StyleBox["GL",
        FontSlant->"Plain"]], "\[RightBracketingBar]"}], "4"]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cd142ce8-c96d-4c0b-b1dd-50e2be54b937"],
 " for the complex pair wave function ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Psi]", 
    StyleBox["GL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3644bd03-d5b8-4f32-912c-2a0b25d5dbe6"],
 " (the symmetry ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["U", "TI"], 
    RowBox[{"(", "1", ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "acf6a725-6c2c-44c7-93c6-a0aa502fbf21"],
 "), with gradient terms and the magnetic field added. L. P. Gor'kov (1959) \
derived it from the theory of Bardeen, Cooper and Schrieffer near the \
critical temperature, where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftBracketingBar]", 
    SubscriptBox["\[Psi]", 
     StyleBox["GL",
      FontSlant->"Plain"]], "\[RightBracketingBar]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ace0df58-fd68-4da3-856b-81ef016d3304"],
 " is small; there the coefficients are true Taylor coefficients."
}], "Item",ExpressionUUID->"57ee8020-93aa-4b3f-a3dc-8f235a52351f"],

Cell[TextData[{
 "The Higgs potential of the Standard Model, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     SuperscriptBox[
      RowBox[{"(", 
       SuperscriptBox["\[Mu]", 
        StyleBox["SM",
         FontSlant->"Plain"]], ")"}], "2"]}], 
    SuperscriptBox[
     RowBox[{"(", 
      SuperscriptBox["\[CapitalPhi]", 
       StyleBox["SM",
        FontSlant->"Plain"]], ")"}], "\[Dagger]"], 
    SuperscriptBox["\[CapitalPhi]", 
     StyleBox["SM",
      FontSlant->"Plain"]], "+", 
    SuperscriptBox["\[Lambda]", 
     StyleBox["SM",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         SuperscriptBox["\[CapitalPhi]", 
          StyleBox["SM",
           FontSlant->"Plain"]], ")"}], "\[Dagger]"], 
       SuperscriptBox["\[CapitalPhi]", 
        StyleBox["SM",
         FontSlant->"Plain"]]}], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "40b1a42e-a512-4d4a-b647-ef04327609f2"],
 ": the doublet ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CapitalPhi]", 
    StyleBox["SM",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d04e153b-2e2a-46ee-bbf5-023837348d60"],
 " has the single invariant ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SuperscriptBox["\[CapitalPhi]", 
       StyleBox["SM",
        FontSlant->"Plain"]], ")"}], "\[Dagger]"], 
    SuperscriptBox["\[CapitalPhi]", 
     StyleBox["SM",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "079e39e3-b0ae-46f2-b023-0daad0d47b95"],
 " of degree 2, and this Landau form is exact at tree level, not a truncation."
}], "Item",ExpressionUUID->"77b4d14b-3431-44fa-a00f-2093d074cc5e"],

Cell[TextData[{
 "The Bose-Einstein condensates of spin 1 (T.-L. Ho, 1998; T. Ohmi and K. \
Machida, 1998), the closest analogue of ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[CapitalPhi]", "\[RightVector]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d2488e28-8a85-4bcc-9c62-16ede8210e36"],
 ": their order parameter is a complex vector ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[CurlyPi]", "\[RightVector]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7dca5075-b782-4cef-880b-bf4661a3d5b3"],
 ", and their energy per volume ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], 
    SubscriptBox[
     StyleBox["c", "TI"], 
     StyleBox["n",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      OverscriptBox["\[CurlyPi]", "\[RightVector]"], 
      "\[RightBracketingBar]"}], "4"], "+", 
    FractionBox["1", "2"], 
    SubscriptBox[
     StyleBox["c", "TI"], 
     StyleBox["s",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"\[LeftBracketingBar]", 
        OverscriptBox["\[CurlyPi]", "\[RightVector]"], 
        "\[RightBracketingBar]"}], "4"], "-", 
      SuperscriptBox[
       RowBox[{"\[LeftBracketingBar]", 
        RowBox[{
         OverscriptBox["\[CurlyPi]", "\[RightVector]"], "\[CenterDot]", 
         OverscriptBox["\[CurlyPi]", "\[RightVector]"]}], 
        "\[RightBracketingBar]"}], "2"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fc067caf-88e7-4370-a385-d807fcee0a44"],
 " contains the same two quartic invariants as ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[CapitalPhi]", "\[RightVector]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "491ff36a-9a11-47ec-9df0-6cd2f00df6d2"],
 ", the second term being the square of the spin. ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["c", "TI"], 
     StyleBox["s",
      FontSlant->"Plain"]], ">", "0"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cb4c4f17-995e-4cca-ad02-686f6d52c3b5"],
 " (sodium-23) favors the polar state, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["c", "TI"], 
     StyleBox["s",
      FontSlant->"Plain"]], "<", "0"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9b10c4ad-bf01-4b25-adbe-4bc6b9ff5d43"],
 " (rubidium-87) the ferromagnetic state ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["\[CurlyPi]", "\[RightVector]"], "\[Proportional]", 
    RowBox[{"(", 
     RowBox[{"1", ",", 
      StyleBox["i", "TI"], ",", "0"}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b8018e6e-abce-4f40-a6fe-466015433a59"],
 "."
}], "Item",ExpressionUUID->"52566f15-d9be-4b29-9df0-332e29929921"],

Cell[TextData[{
 "The ferroelectric barium titanate (A. F. Devonshire, 1949): ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Alpha]", 
     StyleBox["D",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["P", "TI"], 
     StyleBox["D",
      FontSlant->"Plain"], "2"], "+", 
    SubscriptBox["\[Beta]", 
     StyleBox["D",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["P", "TI"], 
     StyleBox["D",
      FontSlant->"Plain"], "4"], "+", 
    SubscriptBox["\[Gamma]", 
     StyleBox["D",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["P", "TI"], 
     StyleBox["D",
      FontSlant->"Plain"], "6"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c33c3765-123a-446a-88ae-dd704c75410c"],
 " for the polarization ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["P", "TI"], 
    StyleBox["D",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "14afc067-f1b1-4f5b-b760-aec6e2f0ae3a"],
 ", with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Beta]", 
     StyleBox["D",
      FontSlant->"Plain"]], "<", "0"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ab8943d7-63b0-4b69-91a8-13ee7272d6b2"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", 
     StyleBox["D",
      FontSlant->"Plain"]], ">", "0"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5160668d-6324-4c37-946d-818f2453d780"],
 ": the sixth power is required, and the transition is of first order."
}], "Item",ExpressionUUID->"7d18c58e-3881-4268-bdb0-2305d7cdd812"],

Cell[TextData[{
 "Superfluid helium-3 (A. J. Leggett, 1975): one quadratic and five quartic \
invariants of a complex ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", "\[Times]", "3"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c814e034-3043-44cd-8564-0228cb9eb0ec"],
 " matrix, whose five coefficients decide between the phases A and B. The \
nematic liquid crystals (P. G. de Gennes, 1971): the traceless symmetric \
tensor of the nematic order admits an invariant of the third degree, so the \
transition is of first order."
}], "Item",ExpressionUUID->"879cc3c5-1a57-468c-a8c2-7b26ca3a5825"],

Cell[TextData[{
 "The name has nothing to do with the Landau levels of a charge in a magnetic \
field (Section I.6 of this notebook, AS2): the same physicist, another \
subject. ",
 StyleBox["The Landau form of $\\vec\\Phi$.",
  FontWeight->"Bold"],
 " The symmetry is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["v",
      FontSlant->"Plain"]], "\[Times]", 
    StyleBox["U", "TI"], 
    SubsuperscriptBox[
     RowBox[{"(", "1", ")"}], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7c215d5b-ee1e-4771-8a30-4e4b77d531f2"],
 ". The independent invariants up to the fourth degree are ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "959355cc-dfa9-4d46-80ef-23a730ee8b02"],
 ", ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}], "4"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "656eb25f-aa17-4d0c-b14c-8b8573e0aa77"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     RowBox[{
      OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "\[CenterDot]", 
      OverscriptBox["\[CapitalPhi]", "\[RightVector]"]}], 
     "\[RightBracketingBar]"}], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "55005330-cf0e-4e36-bb7c-554f5334b4c8"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
      "\[RightBracketingBar]"}], "4"], "-", 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      RowBox[{
       OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "\[CenterDot]", 
       OverscriptBox["\[CapitalPhi]", "\[RightVector]"]}], 
      "\[RightBracketingBar]"}], "2"], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      RowBox[{
       OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "\[Times]", 
       SuperscriptBox[
        OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "*"]}], 
      "\[RightBracketingBar]"}], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9a292b02-7175-4df5-b44f-f77b29b1192e"],
 " vanishes exactly on the polar fields. The Landau form used by the solution \
is"
}], "Text",ExpressionUUID->"c6dac679-432f-4192-a549-80afd443feee"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalV]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], "\[TildeTilde]", 
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], 
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}], "2"], "+", 
   SubsuperscriptBox[
    StyleBox["b", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], 
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}], "4"], "+", 
   SubsuperscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], 
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}], "6"], "+", 
   SubsuperscriptBox[
    StyleBox["u", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], 
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"\[LeftBracketingBar]", 
       OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
       "\[RightBracketingBar]"}], "4"], "-", 
     SuperscriptBox[
      RowBox[{"\[LeftBracketingBar]", 
       RowBox[{
        OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "\[CenterDot]", 
        OverscriptBox["\[CapitalPhi]", "\[RightVector]"]}], 
       "\[RightBracketingBar]"}], "2"]}], ")"}], ","}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"f3834989-1138-4b1b-92b7-6c04b51f5fc6"],

Cell[TextData[{
 "the polynomial ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["\[ScriptCapitalV]",
      FontSlant->"Plain"], 
     StyleBox["L",
      FontSlant->"Plain"]], 
    RowBox[{"(", "\[CapitalPhi]", ")"}], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], 
    SuperscriptBox["\[CapitalPhi]", "2"], "+", 
    SubsuperscriptBox[
     StyleBox["b", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], 
    SuperscriptBox["\[CapitalPhi]", "4"], "+", 
    SubsuperscriptBox[
     StyleBox["c", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], 
    SuperscriptBox["\[CapitalPhi]", "6"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5b8669b2-fc45-4fe8-aa4d-268ffeffd5bd"],
 " along the polar fields. The coefficient ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["u", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "da1979c0-4bc1-47fa-8285-d1385c5983ef"],
 " is not fitted: it comes from the computed second derivative in a \
non-unitary direction at the minimum, and it is positive in every method (the \
sodium case of the condensates of spin 1). The next cell checks, for random \
vectors, that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
      "\[RightBracketingBar]"}], "4"], "-", 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      RowBox[{
       OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "\[CenterDot]", 
       OverscriptBox["\[CapitalPhi]", "\[RightVector]"]}], 
      "\[RightBracketingBar]"}], "2"], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      RowBox[{
       OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "\[Times]", 
       SuperscriptBox[
        OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "*"]}], 
      "\[RightBracketingBar]"}], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1312e403-c3ed-44ee-87f0-a2cc93c8f0b9"],
 ", and that it vanishes on polar fields."
}], "Text",ExpressionUUID->"5217d42d-c9c2-4a87-b384-3b659e2998a2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"the", " ", "identity"}], " ", "|", "Phi", "|", 
      RowBox[{
       RowBox[{"^", "4"}], " ", "-"}], " ", "|", 
      RowBox[{"Phi", ".", "Phi"}], "|", 
      RowBox[{"^", "2"}]}], " ", "=", " ", 
     RowBox[{"|", 
      RowBox[{"Phi", " ", "x", " ", 
       RowBox[{"Phi", "^"}], "*"}], "|", 
      RowBox[{
       RowBox[{
        RowBox[{"^", "2"}], " ", "for", " ", "complex", " ", "3"}], "-", 
       "vectors"}]}]}], ",", " ", "exactly", ",", " ", 
    RowBox[{"with", " ", "symbolic", " ", "components"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"lfVec", " ", "=", " ", 
     RowBox[{"Array", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"lfRe", "[", "#", "]"}], " ", "+", " ", 
         RowBox[{"I", " ", 
          RowBox[{"lfIm", "[", "#", "]"}]}]}], " ", "&"}], ",", " ", "3"}], 
      "]"}]}], ";"}], "   ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Phi", " ", "=", " ", 
      RowBox[{"lfRe", " ", "+", " ", 
       RowBox[{
       "i", " ", "lfIm", " ", "with", " ", "real", " ", "components", " ", 
        RowBox[{"lfRe", "[", "k", "]"}]}]}]}], ",", " ", 
     RowBox[{"lfIm", "[", "k", "]"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"lfNorm2", " ", "=", " ", 
     RowBox[{"ComplexExpand", "[", 
      RowBox[{
       RowBox[{"Conjugate", "[", "lfVec", "]"}], " ", ".", " ", "lfVec"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"lfIdentity", " ", "=", " ", 
     RowBox[{"Simplify", "[", 
      RowBox[{"ComplexExpand", "[", 
       RowBox[{
        RowBox[{"lfNorm2", "^", "2"}], " ", "-", " ", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"lfVec", " ", ".", " ", "lfVec"}], "]"}], "^", "2"}], " ", "-",
         " ", 
        RowBox[{
         RowBox[{"Conjugate", "[", 
          RowBox[{"Cross", "[", 
           RowBox[{"lfVec", ",", " ", 
            RowBox[{"Conjugate", "[", "lfVec", "]"}]}], "]"}], "]"}], " ", ".",
          " ", 
         RowBox[{"Cross", "[", 
          RowBox[{"lfVec", ",", " ", 
           RowBox[{"Conjugate", "[", "lfVec", "]"}]}], "]"}]}]}], "]"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"on", " ", "a", " ", "polar", " ", "field", " ", "Phi"}], " ", "=",
      " ", 
     RowBox[{
      RowBox[{"e", "^", 
       RowBox[{"(", 
        RowBox[{"i", " ", "theta"}], ")"}]}], " ", "r", " ", "n", " ", "with",
       " ", "a", " ", "real", " ", "unit", " ", "vector", " ", "n", " ", 
      "the", " ", "term", " ", "vanishes"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"lfPolar", " ", "=", " ", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{"ComplexExpand", "[", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"v", " ", "=", " ", 
            RowBox[{
             RowBox[{"Exp", "[", 
              RowBox[{"I", " ", "lfTh"}], "]"}], " ", "lfR", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"Sin", "[", "lfT1", "]"}], " ", 
                RowBox[{"Cos", "[", "lfT2", "]"}]}], ",", " ", 
               RowBox[{
                RowBox[{"Sin", "[", "lfT1", "]"}], " ", 
                RowBox[{"Sin", "[", "lfT2", "]"}]}], ",", " ", 
               RowBox[{"Cos", "[", "lfT1", "]"}]}], "}"}]}]}], "}"}], ",", 
          "\n", "      ", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Conjugate", "[", "v", "]"}], " ", ".", " ", "v"}], 
             ")"}], "^", "2"}], " ", "-", " ", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"v", " ", ".", " ", "v"}], "]"}], "^", "2"}]}]}], "]"}], 
        "]"}], ",", " ", 
       RowBox[{"Assumptions", " ", "->", " ", 
        RowBox[{"Element", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "lfTh", ",", " ", "lfR", ",", " ", "lfT1", ",", " ", "lfT2"}], 
           "}"}], ",", " ", "Reals"}], "]"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<|Phi|^4 - |Phi.Phi|^2 - |Phi x Phi*|^2 = \>\"", ",", " ", 
      "lfIdentity", ",", 
