Cell["II.2 The three methods and their numerical engine", "Section",ExpressionUUID->"57a09e7b-7c20-48e6-9fe7-fa77614f64cc"],

Cell[TextData[{
 "All three methods approximate the state of the spinor field by a uniform \
quasi-free state: at every momentum ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox[
     StyleBox["q", "TI"], "\[RightVector]"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8af6c4f5-705f-48d3-bcac-755a7f396f3b"],
 " the correlation matrices ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["C",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["n",
