Cell[TextData[{
 StyleBox["Is the order parameter smaller and more physically reasonable?",
  FontWeight->"Bold"],
 " Yes, near the critical temperature, and only there."
}], "Text",ExpressionUUID->"a8a0d3f8-4ca0-4c1f-b16d-b08f70928abf"],

Cell[TextData[{
 StyleBox["It is smaller.",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalPhi]", 
     RowBox[{"0", ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "766bb1ee-c602-408b-b34f-018b29dad661"],
 " keeps its value of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7d7e3c6b-da91-4cb1-b21b-0cfc47b8003d"],
 " up to about ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.3", "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "675c2474-c966-4460-a70f-bb559e70f62e"],
 " (the gap is much larger than these temperatures, and thermal \
quasi-particles are exponentially rare), then falls and vanishes continuously \
at ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9a405671-4dae-4cb8-9aad-7cf57fb3950c"],
 ", like ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "-", 
      StyleBox["T", "TI"], "/", 
      SubsuperscriptBox[
       StyleBox["T", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["c",
         FontSlant->"Plain"]}]]}], ")"}], 
    RowBox[{"1", "/", "2"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9d19e013-006b-4468-bc11-496b489f1e35"],
 " (the table and the figure above)."
}], "ItemNumbered",ExpressionUUID->"219e4cc7-bcaf-44e7-ada9-98a4e5ea238f"],

Cell[TextData[{
 StyleBox["It lies inside the radius of convergence.",
  FontWeight->"Bold"],
 " At ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "994771a3-36fc-4b5e-88d4-aa71dc9f6c31"],
 " the order parameter is 1.5 to 2 times the radius, which is then the mass \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f70302de-72e8-4663-a340-aafc965932de"],
 "; above the reduced temperature of the table (0.35 to 0.42) it is smaller \
than the radius, and near ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2dccdd48-853d-4197-b40a-b9d338299003"],
 " much smaller. There the series of the free energy in powers of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "086b0405-b2db-41be-9c7c-cb42e0183059"],
 " converges at the minimum, and the Landau coefficients are the Taylor \
coefficients of the free energy: the regime of Landau's theory, which Section \
III.L found absent at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a160901d-ab61-4516-8187-ae25754bb997"],
 "."
}], "ItemNumbered",ExpressionUUID->"8939d951-1262-4ab3-947e-6bd48c89e120"],

Cell[TextData[{
 StyleBox["The Landau form becomes exact.",
  FontWeight->"Bold"],
 " The residual of the Landau form falls from a few tenths of a per cent of \
the depth at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "407e003f-152e-4de5-9be2-d3d89c183ed0"],
 " to about ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "3"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "371093ce-bc19-4582-b37e-a0f83bf824ab"],
 " per cent at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.98", "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "91c935fc-912f-482d-ae70-ec7eab0a8565"],
 ", and that of the quartic form (the form of the Higgs potential of the \
Standard Model and of the theory of Ginzburg and Landau) from 3 to 6 per cent \
to about 0.3 per cent; near ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c3676637-ee41-42e0-a412-392b003c38e0"],
 " it falls in proportion to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "-", 
    StyleBox["T", "TI"], "/", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "74e8c9cf-029c-4d8f-96c7-4c4922df0681"],
 "."
}], "ItemNumbered",ExpressionUUID->"20c7758f-f73b-4cfc-91bb-8b962de36db9"],

Cell[TextData[{
 StyleBox["Landau's theory predicts the order parameter.",
  FontWeight->"Bold"],
 " Near ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d36fe330-b249-418b-81c7-bfda6791366c"],
 " the error of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       StyleBox["a", "TI"]}], "/", "2", 
      StyleBox["b", "TI"]}], ")"}], 
    RowBox[{"1", "/", "2"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1a113e6f-82d3-4fe9-9c2c-166221717454"],
 " is a fraction (0.19 to 0.28 in the Rust table) of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "-", 
    StyleBox["T", "TI"], "/", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "abd4efac-fa79-4012-b2c5-3b6e521937c4"],
 ", as Landau's theory requires; the cell above computes it for CJT at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.9", "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["CJT",
       FontSlant->"Plain"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "faa66aa7-324e-4484-b16a-4c29cc8b4733"],
 "."
}], "ItemNumbered",ExpressionUUID->"55b38552-9da6-4779-820a-bd90ffc487df"],

Cell[TextData[{
 StyleBox["The scales.",
  FontWeight->"Bold"],
 " Near ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d3826004-b253-4e1b-8e9d-8ccbf46d9ef4"],
 " the order parameter is small also against the Dirac mass and the cutoff. \
The critical temperatures themselves are about a fifth to a quarter of the \
cutoff (the table above), and the states at the cutoff are occupied by 0.8 to \
1.8 per cent at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.98", "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ac81faaa-30f4-4b51-8aa0-093875e95325"],
 ", so the thermal physics reaches the cutoff only weakly. The ratio of the \
gap at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "269634c1-1dd1-4800-911d-f89a0c5acc2c"],
 " to ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fb03508c-c4ba-4c73-998b-aca6b2b316fa"],
 " is 1.65 to 1.74; the theory of Bardeen, Cooper and Schrieffer gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Pi]", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      SubscriptBox["\[Gamma]", 
       StyleBox["E",
        FontSlant->"Plain"]]}]], "\[LongEqual]", "1.764"}], TraditionalForm]],
   "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6694efaf-9b81-4727-9538-07e41d15ca95"],
 " (with Euler's constant ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", 
     StyleBox["E",
      FontSlant->"Plain"]], "\[LongEqual]", "0.5772"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6469fa90-37a1-4dad-a4b1-003c0fc2ee00"],
 ") for weak pairing at a Fermi surface. The ratios are of the same size but \
not equal: here there is no Fermi surface (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Mu]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cff0cfa2-d502-47c9-9872-3de1eea6118e"],
 "), the pairing needs a coupling above a critical one, and the gap contains \
the Dirac mass."
}], "ItemNumbered",ExpressionUUID->"611fe2dc-8b06-48cf-841c-52a6097b8c96"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
III.T.7 What the free energy of these methods does not contain, and why it \
matters\
\>", "Section",ExpressionUUID->"48102fd1-59aa-471a-bf7c-420093f47313"],

Cell[TextData[{
 StyleBox["The remark.",
  FontWeight->"Bold"],
 " All three methods give mean-field free energies: the thermal state is \
quasi-free, so the free energy contains the thermal quasi-particles of the \
spinor field, but neither the thermal fluctuations of the order parameter \
about its mean value (its amplitude, Goldstone and non-unitary modes) nor \
thermal gauge fields. ",
 StyleBox["Why it holds.",
  FontWeight->"Bold"],
 " A quasi-free state is a state whose correlations of four and more fields \
are fixed by its correlations of two fields (Wick's theorem); the three \
methods choose the best such state, and a fluctuation of the order parameter \
is a correlation of two pairs beyond the product of the pair densities. In HS \
the integral over the auxiliary fields is replaced by its saddle point, in \
CJT the effective action is truncated at the contractions of the contact \
terms in pairs, and in KS the exchange-correlation energy has no thermal part."
}], "Text",ExpressionUUID->"71ab187e-84aa-4146-b872-2a987607d707"],

Cell[TextData[{
 StyleBox["Why it matters.",
  FontWeight->"Bold"],
 " Near a continuous transition the fluctuations of the order parameter grow \
without bound. Their size relative to the order parameter is measured by the \
Ginzburg number of the transition (A. P. Levanyuk 1959, V. L. Ginzburg 1960): \
the mean-field free energy is accurate where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "-", 
    StyleBox["T", "TI"], "/", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d9385107-720f-428b-9283-d82290a97aee"],
 " is much larger than the Ginzburg number, and it fails within the critical \
region, where it is smaller. For a free energy of the form of Ginzburg and \
Landau in three dimensions, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", 
     StyleBox["GL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      RowBox[{"\[Del]", 
       SubscriptBox["\[Psi]", 
        StyleBox["GL",
         FontSlant->"Plain"]]}], "\[RightBracketingBar]"}], "2"], "+", 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["GL",
      FontSlant->"Plain"], "\[Prime]"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["T", "TI"], "/", 
      SubscriptBox[
       StyleBox["T", "TI"], 
       StyleBox["c",
        FontSlant->"Plain"]], "-", "1"}], ")"}], 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      SubscriptBox["\[Psi]", 
       StyleBox["GL",
        FontSlant->"Plain"]], "\[RightBracketingBar]"}], "2"], "+", 
    FractionBox["1", "2"], 
    SubscriptBox["\[Beta]", 
     StyleBox["GL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      SubscriptBox["\[Psi]", 
       StyleBox["GL",
        FontSlant->"Plain"]], "\[RightBracketingBar]"}], "4"]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c9c76e5c-af7e-430d-a43c-801521359f43"],
 " (the example of Section III.L.2 with the gradient coefficient ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", 
    StyleBox["GL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3ece0485-a7d4-43b4-b3cd-3599f610e20e"],
 ", the slope ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Alpha]", 
    StyleBox["GL",
     FontSlant->"Plain"], "\[Prime]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "81881b2d-a211-49c7-a800-94f85a7a100c"],
 " and the critical temperature ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["c",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "699cbc17-8804-486c-90e4-08d5bd1f7e05"],
 "), the Ginzburg number is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["c",
      FontSlant->"Plain"], "2"], 
    SubsuperscriptBox["\[Beta]", 
     StyleBox["GL",
      FontSlant->"Plain"], "2"], "/", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["\[Alpha]", 
       StyleBox["GL",
        FontSlant->"Plain"], "\[Prime]"], 
      SubsuperscriptBox["\[Gamma]", 
       StyleBox["GL",
        FontSlant->"Plain"], "3"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9478b6a9-7c0b-4265-899c-1402119d1f7e"],
 " up to a numerical factor that depends on the conventions. Within the \
critical region the order parameter vanishes with an exponent different from ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7f979d6b-cbf3-42e5-88ae-b7f77ecd8d80"],
 " (in three dimensions near 0.33 to 0.37 for the Ising, XY and Heisenberg \
universality classes), the critical temperature is in general lower than the \
mean-field one, and for an order parameter with two quartic invariants, as \
here, the fluctuations can also make the transition discontinuous (the \
renormalization-group theory of such fields is reviewed by A. Pelissetto and \
E. Vicari, 2002). A gauge field coupled to the order parameter can do the \
same: its fluctuations make the transition of a superconductor weakly first \
order (B. I. Halperin, T. C. Lubensky and S.-k. Ma, 1974), and the thermal \
transition of the Higgs field of the electroweak theory, of first order for \
small Higgs masses, ends at a critical Higgs mass, above which there is no \
transition but a smooth crossover (lattice simulations of K. Kajantie, M. \
Laine, K. Rummukainen and M. Shaposhnikov, 1996). The answer of Section \
III.T.6 therefore describes the superfluid near ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fe8c6523-05df-45db-8d97-0bcd523c4932"],
 " only outside the critical region, and whether the transition of the full \
theory is continuous is not decided here. The size of the critical region \
needs the gradient coefficient of the field at ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5645f431-a1bd-4966-a9b9-ff0c8e9da34c"],
 ", which is not computed yet (the solution computes the coefficients of the \
gradient terms at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f1619968-7f3f-4936-8e50-6c56d3b09b25"],
 " only); computing it is the next step if the critical region is to be \
located. At ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "03fe81c2-a65c-4860-9da2-5b1d5ce7ed12"],
 " the methods omit the quantum fluctuations of the order parameter as well; \
that is a property of the methods, not the subject of this remark."
}], "Text",ExpressionUUID->"efcedb0e-bed1-456e-a584-5b3c8b3e2326"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["The list of all checks", "Chapter",ExpressionUUID->"fa015c70-e5d4-43a7-8b5a-44acad97090d"],

Cell["\<\
The last cell lists every check of this notebook with its result and its \
counterparts in the Rust and the Python programs, and counts the checks that \
passed.\
\>", "Text",ExpressionUUID->"fffe901f-3491-4bc5-8f07-76ab9c1e6942"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", "table", " ", "of", " ", "all", " ", 
     RowBox[{"checks", ":", " ", "identifier"}]}], ",", " ", "result", ",", 
    " ", "deviation", ",", " ", "tolerance", ",", " ", "counterparts"}], " ", 
   "*)"}], "\n", 
  RowBox[{"Grid", "[", 
   RowBox[{
    RowBox[{"Prepend", "[", 
     RowBox[{
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"#", "[", "\"\<id\>\"", "]"}], ",", " ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"#", "[", "\"\<pass\>\"", "]"}], ",", " ", "\"\<PASS\>\"",
              ",", " ", "\"\<FAIL\>\""}], "]"}], ",", " ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"NumericQ", "[", 
              RowBox[{"#", "[", "\"\<deviation\>\"", "]"}], "]"}], ",", " ", 
             RowBox[{"sci", "[", 
              RowBox[{"#", "[", "\"\<deviation\>\"", "]"}], "]"}], ",", 
             " ", "\"\<--\>\""}], "]"}], ",", "\n", "      ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"NumericQ", "[", 
              RowBox[{"#", "[", "\"\<tolerance\>\"", "]"}], "]"}], ",", " ", 
