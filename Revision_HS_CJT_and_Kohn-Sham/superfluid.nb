  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0d408b72-2d5b-4d93-82ca-ee95ae78cb5e"],
 " the correlation matrices ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["C",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
