Cell[CellGroupData[{

Cell["III.G.5 The gradient coefficient and the regularization", "Section",ExpressionUUID->"3e800fc3-8655-485a-9e52-2ae87b149639"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["c",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0d8ea58b-5d3d-4064-8053-f86a8de43769"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"[", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["a", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["Tay",
         FontSlant->"Plain"]}]], 
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox[
         StyleBox["q", "TI"], 
         StyleBox["SF",
          FontSlant->"Plain"], 
         StyleBox["pair",
          FontSlant->"Plain"]], ";", 
        SubsuperscriptBox[
         StyleBox["T", "TI"], 
         StyleBox["SF",
          FontSlant->"Plain"], 
         RowBox[{
          StyleBox["X", "TI"], ",", 
          StyleBox["c",
           FontSlant->"Plain"]}]]}], ")"}], "-", 
      SubsuperscriptBox[
       StyleBox["a", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["Tay",
         FontSlant->"Plain"]}]], 
      RowBox[{"(", 
       RowBox[{"0", ";", 
        SubsuperscriptBox[
         StyleBox["T", "TI"], 
         StyleBox["SF",
          FontSlant->"Plain"], 
         RowBox[{
          StyleBox["X", "TI"], ",", 
          StyleBox["c",
           FontSlant->"Plain"]}]]}], ")"}]}], "]"}], "/", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["pair",
        FontSlant->"Plain"]], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "44edb038-11a5-43a8-965a-0da0eedcc2a2"],
 " at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["pair",
      FontSlant->"Plain"]], "\[LongEqual]", "0.01"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b5c5ba14-32e4-45da-a395-cbfeb3f8527c"],
 " and ",
 Cell[BoxData[
  FormBox["0.02", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "61efbfb7-dba9-4dd8-9e02-f83a8ac8281d"],
 " with the Richardson extrapolation. The six directions of the grid are \
exact at second order in the twist (the term of second order is a quadratic \
polynomial in the direction). ",
 StyleBox["The regularization (a remark: what it means and why it matters).",
  FontWeight->"Bold"],
 " The model has the cutoff ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox[
      StyleBox["q", "TI"], "\[RightVector]"], "\[RightBracketingBar]"}], "<", 
    
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fe1d0f66-e567-4041-8756-a5fec7224669"],
 " on the momenta of the uniform states, and for a moving pair it must be put \
on one of two momenta. With the cutoff on the momenta of the two charges of \
the pair, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftBracketingBar]", 
     RowBox[{
      OverscriptBox[
       StyleBox["q", "TI"], "\[RightVector]"], "\[PlusMinus]", 
      FractionBox["1", "2"], 
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["pair",
        FontSlant->"Plain"]], 
      SubscriptBox[
       OverscriptBox[
        StyleBox["e", "TI"], "\[RightVector]"], "3"]}], 
     "\[RightBracketingBar]"}], "<", 
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c3ad36b5-69dc-476b-8dd5-a8ec79a1871c"],
 " (a lens of two spheres), a moving pair loses the pairs in a shell at the \
cutoff whose thickness is of order ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftBracketingBar]", 
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["pair",
      FontSlant->"Plain"]], "\[RightBracketingBar]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0945913d-1469-4701-a100-16f074f0b317"],
 ", so that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], 
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["q", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      StyleBox["pair",
       FontSlant->"Plain"]], ")"}], "-", 
    StyleBox["a", "TI"], 
    RowBox[{"(", "0", ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8d571f72-40d7-4096-afea-120497a673ae"],
 " is linear in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftBracketingBar]", 
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["pair",
      FontSlant->"Plain"]], "\[RightBracketingBar]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8f72e1ba-7726-430d-aea0-ce61bd868328"],
 " and a gradient expansion does not exist. With the cutoff on the relative \
momentum, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox[
      StyleBox["q", "TI"], "\[RightVector]"], "\[RightBracketingBar]"}], "<", 
    
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9ddad091-54cd-4645-8327-e4d8cb815a47"],
 ", the change is quadratic; this routing is used here (it is the routing of \
the twisted states of the coefficients of the kinetic part at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4f0283a2-6eab-4801-a054-287c258baf14"],
 ", where the uniform twist shifts the momenta inside the fixed sphere). The \
remaining error of the regularization is measured by the twist ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["q", "TI"], "\[ThinSpace]", 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], "3"], "\[CircleTimes]", 
    FractionBox["1", "2"], 
    SubscriptBox["\[Tau]", "3"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c39f35b7-ca64-453a-bf58-c2232cddaa32"],
 " of the unbroken generator ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "61543962-9cc6-47ec-ac7a-9c28a0f77dcf"],
 ", which does not change the field along ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox[
     StyleBox["e", "TI"], "\[RightVector]"], "3"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5afbd44c-34e9-48bd-b4f0-cf52272ecd71"],
 " and would cost nothing in a gauge-invariant theory; with the cutoff it \
costs the spurious coefficient ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["c",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     RowBox[{
      StyleBox["T",
       FontSlant->"Plain"], "\[InvisibleSpace]", "3"}]}]], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "06dcf6e9-0667-4d82-9a03-c42d97c6c3f2"],
 ", about a fifth of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["c",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2eb70dbd-0239-409c-96e6-34d56a68fab6"],
 " (the Rust table). This matters for the size of the Ginzburg number, which \
is proportional to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SuperscriptBox[
     StyleBox["c",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "3"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0cceb904-7b29-4e1e-a361-211a1ce47de6"],
 ": changing ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["c",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "62f0c19e-7b47-4c75-933b-f45a5d15b911"],
 " by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    SubsuperscriptBox[
     StyleBox["c",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      RowBox[{
       StyleBox["T",
        FontSlant->"Plain"], "\[InvisibleSpace]", "3"}]}]]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "48323ca7-7b8d-4360-a7cd-897e5fa95f6e"],
 " changes it by a factor of about 2 either way (Section III.G.7), not enough \
to change the conclusion. The next cells compute the gradient coefficient \
from the phase twist and from the isospin twist, check that it does not \
depend on the quadrature (for CJT: 40 radial nodes, and a product rule of 144 \
directions), and compare the two regularizations on a product rule: 24 \
Gauss-Legendre nodes in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["cos",
     FontSlant->"Plain"], "\[ThinSpace]", "\[Theta]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c65c9986-7c9e-4879-b986-5916cb2e348f"],
 " (12 on each half), 6 angles ",
 Cell[BoxData[
  FormBox["\[CurlyPhi]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1ae2122d-3862-4ae5-9443-61d8e6f9e7a9"],
 " and 24 radial nodes on ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"0", ",", 
     StyleBox["r", "TI"], 
     RowBox[{"(", 
      OverscriptBox[
       StyleBox["n", "TI"], "\[RightVector]"], ")"}]}], "]"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "92e2304e-295c-4dea-b6d9-e861055de717"],
 " in the direction ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["n", "TI"], "\[RightVector]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "837bf868-c771-4e7f-94e9-6652f09b77c5"],
 ", with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r", "TI"], "\[LongEqual]", 
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7d68c57c-f376-4386-8993-d8f302f7d257"],
 " for the sphere and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r", "TI"], 
    RowBox[{"(", 
     OverscriptBox[
      StyleBox["n", "TI"], "\[RightVector]"], ")"}], "\[LongEqual]", 
    RowBox[{"-", 
     FractionBox["1", "2"]}], 
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["pair",
      FontSlant->"Plain"]], 
    RowBox[{"\[LeftBracketingBar]", 
     SubscriptBox[
      StyleBox["n", "TI"], "3"], "\[RightBracketingBar]"}], "+", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox["\[CapitalLambda]", 
        StyleBox["LL",
