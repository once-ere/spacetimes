Cell[CellGroupData[{

Cell["\<\
III.T.5 The gap equation; the Dirac mass of the superfluid does not depend on \
the temperature\
\>", "Section",ExpressionUUID->"69b18e49-4a22-42e5-9095-98cc9085fca9"],

Cell[TextData[{
 "The polar superfluid at the temperature ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2eeff8a3-27c0-4b49-a320-a2d328c76c4f"],
 " has the pair field ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalPhi]", 
     RowBox[{"0", ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "60db7a2c-2af6-4e43-8660-8fedf0179709"],
 ", and its pair self-consistency is the ",
 StyleBox["gap equation",
  FontWeight->"Bold"]
}], "Text",ExpressionUUID->"6920a6d0-0816-48c1-a146-2b7abb5ef8db"],

Cell[BoxData[
 FormBox[
  RowBox[{"1", "\[LongEqual]", 
   FractionBox[
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["P",
       FontSlant->"Plain"]}]], 
    SuperscriptBox["\[Pi]", "2"]], "\[ThinSpace]", 
   SubsuperscriptBox[
    StyleBox["I", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "1", ")"}]], 
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          SubsuperscriptBox[
           StyleBox["M", "TI"], 
           StyleBox["SF",
            FontSlant->"Plain"], 
           RowBox[{
            StyleBox["X", "TI"], ",", 
            StyleBox["D",
             FontSlant->"Plain"]}]], ")"}], "2"], "+", 
        SubsuperscriptBox["\[CapitalPhi]", 
         RowBox[{"0", ",", 
          StyleBox["SF",
           FontSlant->"Plain"]}], 
         StyleBox["X", "TI"]], 
        SuperscriptBox[
         RowBox[{"(", 
          StyleBox["T", "TI"], ")"}], "2"]}], ")"}], 
      RowBox[{"1", "/", "2"}]], ",", 
     StyleBox["T", "TI"]}], ")"}], "."}], TraditionalForm]], "DisplayFormula",\

 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"d5729d08-0490-4dfb-8933-9de702ec1e69"],

Cell[TextData[{
 "The pair coupling alone fixes the gap at every temperature. The scalar \
density of the superfluid contains the same integral, which the gap equation \
fixes to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Pi]", "2"], "/", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["P",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9ca7a975-3450-4325-ab81-f4943d675d57"],
 ": ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["S",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"-", "2"}], 
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["D",
       FontSlant->"Plain"]}]], "/", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["P",
       FontSlant->"Plain"]}]], "+", "2", 
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["I", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{"(", "1", ")"}]], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["m", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]], ",", "0"}], ")"}], "/", 
    SuperscriptBox["\[Pi]", "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "eee883b3-842a-4e94-9354-e162e244c6ca"],
 ". The scalar self-consistency ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["D",
       FontSlant->"Plain"]}]], "-", 
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["S",
       FontSlant->"Plain"]}]], 
    SubsuperscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["S",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2237a737-ee6e-4855-a3a1-e02cbdd69b0a"],
 " therefore contains no temperature: ",
 StyleBox["the Dirac mass of the superfluid does not depend on the \
temperature",
  FontWeight->"Bold"],
 " below ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9a0cbad0-d2b5-4950-a41c-6d07b099e55e"],
 ", and the order parameter follows from the gap equation alone. The next \
cell computes, with the thermal engine, the superfluid of CJT at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.5", "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["CJT",
       FontSlant->"Plain"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b36a2f46-ae85-4ded-b947-ceb8672dccbc"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.9", "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["CJT",
       FontSlant->"Plain"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a7f91a84-a472-4c6e-934c-2eb6aa822a6e"],
 " (from the ground state of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a2506d2e-0286-4567-b3c0-151e33ab4685"],
 ") and checks its order parameter, its free energy, its gap equation and its \
Dirac mass; it then solves the gap equation alone for HS ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "0"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a60d7541-667c-4bc6-a700-bed80d0dc207"],
 ", whose Dirac mass is ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1c3b0a5a-961e-4d6c-afbe-abc8d0723b15"],
 ", at the 13 temperatures of the table."
}], "Text",ExpressionUUID->"6fb127a8-508e-44ce-b514-baac47a57272"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "the", " ", "superfluid", " ", "of", " ", "CJT", " ", "at", " ", "0.5", " ",
      "T_c", " ", "and", " ", "0.9", " ", "T_c", " ", "with", " ", "the", " ",
      "thermal", " ", "engine"}], ";", " ", 
    RowBox[{
     RowBox[{"thSF", "[", "tau", "]"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"superfluid", ",", " ", 
       RowBox[{"normal", " ", "state"}]}], "}"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"thSF", " ", "=", " ", 
     RowBox[{"<|", "|>"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"mo", " ", "=", " ", 
         RowBox[{"thModel", "[", "\"\<CJT\>\"", "]"}]}], ",", " ", 
        RowBox[{"gp", " ", "=", " ", 
         RowBox[{
          RowBox[{"thCoup", "[", "\"\<CJT\>\"", "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", 
        RowBox[{"n0", " ", "=", " ", 
         RowBox[{
          RowBox[{"thGround", "[", "\"\<CJT\>\"", "]"}], "[", "\"\<n\>\"", 
          "]"}]}], ",", " ", 
        RowBox[{"p0", " ", "=", " ", 
         RowBox[{
          RowBox[{"thGround", "[", "\"\<CJT\>\"", "]"}], "[", "\"\<p\>\"", 
          "]"}]}], ",", " ", 
        RowBox[{"dev", " ", "=", " ", "0."}], ",", " ", 
        RowBox[{"gapdev", " ", "=", " ", "0."}], ",", " ", 
        RowBox[{"mdev", " ", "=", " ", "0."}], ",", " ", 
        RowBox[{"m0", " ", "=", " ", 
         RowBox[{"diracMass", "[", 
          RowBox[{"thGround", "[", "\"\<CJT\>\"", "]"}], "]"}]}]}], "}"}], ",",
       "\n", "  ", 
      RowBox[{
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"temp", " ", "=", " ", 
              RowBox[{"thGet", "[", 
               
               RowBox[{"\"\<CJT\>\"", ",", " ", "tau", ",", 
                " ", "\"\<T\>\""}], "]"}]}], ",", " ", "sf", ",", " ", "nn", ",",
              " ", "phi", ",", " ", "mass"}], "}"}], ",", "\n", "     ", 
           RowBox[{
            RowBox[{"sf", " ", "=", " ", 
             RowBox[{"solveSFT", "[", 
              RowBox[{
              "mo", ",", " ", "n0", ",", " ", "p0", ",", " ", "temp", ",", 
               " ", "0.6", ",", " ", 
               RowBox[{"10", "^", 
                RowBox[{"-", "13"}]}]}], "]"}]}], ";", "\n", "     ", 
            RowBox[{"nn", " ", "=", " ", 
             RowBox[{"solveSFT", "[", 
              RowBox[{
              "mo", ",", " ", "zero8", ",", " ", "zero8", ",", " ", "temp", ",",
                " ", "0.6", ",", " ", 
               RowBox[{"10", "^", 
                RowBox[{"-", "14"}]}]}], "]"}]}], ";", "\n", "     ", 
            RowBox[{"n0", " ", "=", " ", 
             RowBox[{"sf", "[", "\"\<n\>\"", "]"}]}], ";", " ", 
            RowBox[{"p0", " ", "=", " ", 
             RowBox[{"sf", "[", "\"\<p\>\"", "]"}]}], ";", "\n", "     ", 
            RowBox[{
             RowBox[{"thSF", "[", "tau", "]"}], " ", "=", " ", 
             RowBox[{"{", 
              RowBox[{"sf", ",", " ", "nn"}], "}"}]}], ";", "\n", "     ", 
            RowBox[{"phi", " ", "=", " ", 
             RowBox[{"phiOf", "[", "sf", "]"}]}], ";", " ", 
            RowBox[{"mass", " ", "=", " ", 
             RowBox[{"diracMass", "[", "sf", "]"}]}], ";", "\n", "     ", 
            RowBox[{"dev", " ", "=", " ", 
             RowBox[{"Max", "[", 
              RowBox[{"dev", ",", " ", 
               RowBox[{"Abs", "[", 
                RowBox[{"phi", " ", "-", " ", 
                 RowBox[{"thGet", "[", 
                  
                  RowBox[{"\"\<CJT\>\"", ",", " ", "tau", ",", 
                   " ", "\"\<Phi0\>\""}], "]"}]}], "]"}], ",", " ", 
               RowBox[{
                RowBox[{"Abs", "[", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"sf", "[", "\"\<free\>\"", "]"}], " ", "-", " ", 
                    RowBox[{"nn", "[", "\"\<free\>\"", "]"}]}], ")"}], " ", "-",
                   " ", 
                  RowBox[{"thGet", "[", 
                   
                   RowBox[{"\"\<CJT\>\"", ",", " ", "tau", ",", 
                    " ", "\"\<F\>\""}], "]"}]}], "]"}], "/", 
                RowBox[{"Abs", "[", 
                 RowBox[{"thGet", "[", 
                  
                  RowBox[{"\"\<CJT\>\"", ",", " ", "tau", ",", 
                   " ", "\"\<F\>\""}], "]"}], "]"}]}]}], "]"}]}], ";", "\n", 
            "     ", 
            RowBox[{"gapdev", " ", "=", " ", 
             RowBox[{"Max", "[", 
              RowBox[{"gapdev", ",", " ", 
               RowBox[{"Abs", "[", 
                RowBox[{
                 RowBox[{"gp", " ", 
                  RowBox[{
                   RowBox[{"i1Grid", "[", 
                    RowBox[{"mo", ",", " ", 
                    RowBox[{
                    RowBox[{"mass", "^", "2"}], " ", "+", " ", 
                    RowBox[{"phi", "^", "2"}]}], ",", " ", "temp"}], "]"}], "/", 
                   RowBox[{"Pi", "^", "2"}]}]}], " ", "-", " ", "1"}], 
                "]"}]}], "]"}]}], ";", "\n", "     ", 
            RowBox[{"mdev", " ", "=", " ", 
             RowBox[{"Max", "[", 
              RowBox[{"mdev", ",", " ", 
               RowBox[{"Abs", "[", 
                RowBox[{"mass", " ", "-", " ", "m0"}], "]"}], ",", " ", 
               RowBox[{"Abs", "[", 
                RowBox[{"mass", " ", "-", " ", 
                 RowBox[{"thGet", "[", 
                  
                  RowBox[{"\"\<CJT\>\"", ",", " ", "tau", ",", 
                   " ", "\"\<mass\>\""}], "]"}]}], "]"}]}], "]"}]}]}]}], 
          "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"tau", ",", " ", 
           RowBox[{"{", 
            RowBox[{"0.5", ",", " ", "0.9"}], "}"}]}], "}"}]}], "]"}], ";", 
       "\n", "  ", 
       RowBox[{"check", "[", 
        RowBox[{"\"\<WP3-T2 CJT\>\"", ",", 
         " ", "\"\<CJT: the superfluid at 0.5 T_c and 0.9 T_c (thermal \
engine): the order parameter and the free energy = Rust (largest difference; \
the free energy relative), and the gap equation holds (largest |g^P I1/pi^2 - \
1|; the sum of both)\>\"", ",", "\n", "   ", 
         RowBox[{"dev", " ", "+", " ", "gapdev"}], ",", " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "8"}]}], ",", " ", "\"\<P3-T2 CJT\>\"", ",", 
         " ", "\"\<YP3-T2 CJT\>\""}], "]"}], ";", "\n", "  ", 
       RowBox[{"check", "[", 
        RowBox[{"\"\<WP3-T8 CJT\>\"", ",", " ", 
         RowBox[{"\"\<CJT: the Dirac mass of the superfluid at 0.5 T_c and \
0.9 T_c equals that at T = 0, \>\"", " ", "<>", " ", 
          RowBox[{"ToString", "[", 
           RowBox[{"NumberForm", "[", 
            RowBox[{"m0", ",", " ", "10"}], "]"}], "]"}], " ", "<>", 
          " ", "\"\<, and the Rust value (largest difference)\>\""}], ",", 
         "\n", "   ", "mdev", ",", " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "10"}]}], ",", " ", "\"\<P3-T8 CJT\>\"", ",", 
         " ", "\"\<YP3-T8 CJT\>\""}], "]"}]}]}], "]"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"HS", " ", 
       RowBox[{"(", 
        RowBox[{"0", ",", " ", "0"}], ")"}]}], ":", " ", 
      RowBox[{
      "the", " ", "order", " ", "parameter", " ", "from", " ", "the", " ", 
       "gap", " ", "equation", " ", "alone"}]}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"g", "^", "P"}], " ", "I1", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"m", "^", "2"}], " ", "+", " ", 
           RowBox[{"Phi0", "^", "2"}]}], ",", " ", "T"}], ")"}], "/", 
        RowBox[{"pi", "^", "2"}]}]}], " ", "=", " ", 
      RowBox[{"1", " ", 
       RowBox[{"(", 
        RowBox[{"bisection", " ", 
         RowBox[{"on", " ", "[", 
          RowBox[{"0", ",", " ", "2"}], "]"}]}], ")"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"thGapPhi", "[", 
      RowBox[{"t_", ",", " ", "temp_", ",", " ", "mass_"}], "]"}], " ", ":=", 
     " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"mo", " ", "=", " ", 
          RowBox[{"thModel", "[", "t", "]"}]}], ",", " ", 
         RowBox[{"gp", " ", "=", " ", 
          RowBox[{
           RowBox[{"thCoup", "[", "t", "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", 
         RowBox[{"lo", " ", "=", " ", "0."}], ",", " ", 
         RowBox[{"hi", " ", "=", " ", "2."}], ",", " ", "mid"}], "}"}], ",", 
       "\n", "   ", 
       RowBox[{
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"mid", " ", "=", " ", 
            RowBox[{"0.5", " ", 
             RowBox[{"(", 
              RowBox[{"lo", " ", "+", " ", "hi"}], ")"}]}]}], ";", " ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"gp", " ", 
               RowBox[{
                RowBox[{"i1Grid", "[", 
                 RowBox[{"mo", ",", " ", 
                  RowBox[{
                   RowBox[{"mass", "^", "2"}], " ", "+", " ", 
                   RowBox[{"mid", "^", "2"}]}], ",", " ", "temp"}], "]"}], "/", 
                RowBox[{"Pi", "^", "2"}]}]}], " ", ">", " ", "1"}], ",", " ", 
             
             RowBox[{"lo", " ", "=", " ", "mid"}], ",", " ", 
             RowBox[{"hi", " ", "=", " ", "mid"}]}], "]"}]}], ",", " ", 
          RowBox[{"{", "100", "}"}]}], "]"}], ";", " ", 
        RowBox[{"0.5", " ", 
         RowBox[{"(", 
          RowBox[{"lo", " ", "+", " ", "hi"}], ")"}]}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"thPhiGap00", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"tau", ",", " ", 
         RowBox[{"thGapPhi", "[", 
          RowBox[{"\"\<HS_0_0\>\"", ",", " ", 
           RowBox[{"thGet", "[", 
            
            RowBox[{"\"\<HS_0_0\>\"", ",", " ", "tau", ",", 
             " ", "\"\<T\>\""}], "]"}], ",", " ", 
           RowBox[{"N", "[", "mLL", "]"}]}], "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"tau", ",", " ", "thTaus"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WP3-T2 HS_0_0\>\"", ",", 
      " ", "\"\<HS (0, 0): the order parameter of every temperature of the \
table from the gap equation alone (with the Dirac mass m_LL, without the \
self-consistent engine) = Rust (largest difference)\>\"", ",", "\n", "  ", 
      RowBox[{"Max", "[", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
            RowBox[{"thGet", "[", 
             RowBox[{"\"\<HS_0_0\>\"", ",", " ", 
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", " ", "\"\<Phi0\>\""}], 
             "]"}]}], "]"}], " ", "&"}], ",", " ", "thPhiGap00"}], "]"}], 
       "]"}], ",", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "9"}]}], ",", " ", "\"\<P3-T2 HS_0_0\>\"", ",", 
      " ", "\"\<YP3-T4\>\""}], "]"}], ";"}]}]}]], "Input",
 CellLabel->
  "In[343]:=",ExpressionUUID->"c8626bee-df8e-4921-95a7-1c79137ba5d4"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"PASS \"\>", "\[InvisibleSpace]", "\<\"WP3-T2 CJT\"\>", 
   "\[InvisibleSpace]", "\<\"  deviation \"\>", 
   "\[InvisibleSpace]", "\<\"1.589e-12\"\>", 
   "\[InvisibleSpace]", "\<\" (tolerance \"\>", 
   "\[InvisibleSpace]", "\<\"1.000e-8\"\>", 
   "\[InvisibleSpace]", "\<\"): \"\>", 
   "\[InvisibleSpace]", "\<\"CJT: the superfluid at 0.5 T_c and 0.9 T_c \
(thermal engine): the order parameter and the free energy = Rust (largest \
difference; the free energy relative), and the gap equation holds (largest \
|g^P I1/pi^2 - 1|; the sum of both)\"\>", 
   "\[InvisibleSpace]", "\<\"   [the same check: Rust \"\>", 
