           " ", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{"quartic", "[", 
              RowBox[{
               RowBox[{"alpha8", "[", 
                RowBox[{"[", "j", "]"}], "]"}], ",", " ", 
