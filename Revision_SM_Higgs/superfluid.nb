Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
      "the", " ", "Landau", " ", "form", " ", "and", " ", "the", " ", 
       "quartic", " ", "form", " ", "fitted", " ", "to", " ", "the", " ", 
       "free"}], "-", 
      RowBox[{
      "energy", " ", "curves", " ", "of", " ", "the", " ", "Rust", " ", 
       "program", " ", 
       RowBox[{"on", " ", "[", 
        RowBox[{"0", ",", " ", 
         RowBox[{"1.4", " ", "Phi0", 
          RowBox[{"(", "T", ")"}]}]}], "]"}]}]}], ";", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"thRes", "[", "t", "]"}], "[", "tau", "]"}], " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
        "residual", " ", "of", " ", "the", " ", "Landau", " ", "form"}], ",", 
        " ", 
        RowBox[{
        "residual", " ", "of", " ", "the", " ", "quartic", " ", "form"}]}], 
       "}"}]}]}], ",", " ", 
    RowBox[{"relative", " ", "to", " ", "the", " ", "depth"}]}], " ", "*)"}], 
  "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"thCurveTaus", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
      "0.", ",", " ", "0.5", ",", " ", "0.8", ",", " ", "0.9", ",", " ", 
       "0.95", ",", " ", "0.98"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"thRes", " ", "=", " ", 
     RowBox[{"Association", "[", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{"t", ",", " ", 
          RowBox[{"t", " ", "->", " ", 
           RowBox[{"Association", "[", 
            RowBox[{"Map", "[", 
             RowBox[{
              RowBox[{"Function", "[", 
               RowBox[{"tau", ",", " ", 
                RowBox[{"Module", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"pts", ",", " ", 
                    RowBox[{"phi0", " ", "=", " ", 
                    RowBox[{"thGet", "[", 
                    RowBox[{"t", ",", " ", "tau", ",", " ", "\"\<Phi0\>\""}], 
                    "]"}]}], ",", " ", 
                    RowBox[{"depth", " ", "=", " ", 
                    RowBox[{"Abs", "[", 
                    RowBox[{"thGet", "[", 
                    RowBox[{"t", ",", " ", "tau", ",", " ", "\"\<F\>\""}], 
                    "]"}], "]"}]}], ",", " ", "sel"}], "}"}], ",", "\n", 
                  "        ", 
                  RowBox[{
                   RowBox[{"pts", " ", "=", " ", 
                    RowBox[{
                    RowBox[{"Select", "[", 
                    RowBox[{"rustThermalCurves", ",", " ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
