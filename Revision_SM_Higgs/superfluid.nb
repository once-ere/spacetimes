Cell[TextData[{
 "whose projector onto the negative eigenvalues gives ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["C",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["n",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8b58b70a-0fdb-4966-9f94-6dc83cf4a550"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SubsuperscriptBox[
     StyleBox["C",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a98b03d3-7190-4301-b229-1956b5aa16c3"],
 " as its upper blocks. ",
 StyleBox["The grid:",
  FontWeight->"Bold"],
 " 24 Gauss-Legendre nodes of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftBracketingBar]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["q", "TI"], "\[RightVector]"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[RightBracketingBar]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "42caf817-e25a-4275-8cb3-a2bb21d4f117"],
 " on ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"0", ",", 
     SubscriptBox["\[CapitalLambda]", 
      StyleBox["LL",
       FontSlant->"Plain"]]}], "]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d947868d-608d-476e-a09e-1d8c08fcc232"],
 " times the six directions ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["e", "TI"], "\[RightVector]"], 
     StyleBox["j", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6efb5f27-13ef-482c-8bfd-1301921e9d69"],
 ", with the weight ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["w", "TI"], 
     StyleBox["r",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     StyleBox["q", "TI"], "2"], "/", 
    RowBox[{"(", 
     RowBox[{"2", 
      SuperscriptBox["\[Pi]", "2"]}], ")"}], "/", "6"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8470a8d8-0254-4d6f-8cc9-583743bfc26e"],
 " of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Integral]", "\[ThinSpace]", 
    SuperscriptBox[
     StyleBox["d", "TI"], "3"], 
    StyleBox["q", "TI"], "/", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"2", "\[Pi]"}], ")"}], "3"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b75930e2-3f4a-4aa7-aef0-7d6135fd3f57"],
 ". ",
 StyleBox["The iteration:",
  FontWeight->"Bold"],
 " the self-energies are mixed (new times 0.6 plus old times 0.4) until they \
change by less than ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "12"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "683e1f05-4b61-4a57-8e6b-78f5bf2f6f03"],
 ". The gap is the minimum over ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "\[LessEqual]", 
    RowBox[{"\[LeftBracketingBar]", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["q", "TI"], "\[RightVector]"], 
      StyleBox["LL",
       FontSlant->"Plain"]], "\[RightBracketingBar]"}], "\[LessEqual]", 
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b6029e56-a966-455b-8614-f5dd83473b35"],
 " of the smallest eigenvalue modulus of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["H",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1f85c8f7-df79-4e6e-b3f6-b5e2d76b8ee4"],
 " (401 momenta and a golden-section refinement), and the Dirac mass is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "+", 
    FractionBox["1", "8"], 
    StyleBox["tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[Beta]", 
         StyleBox["LL",
          FontSlant->"Plain"]], "\[CircleTimes]", 
        SubscriptBox[
         StyleBox["1",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], "2"]}], ")"}], 
      SubscriptBox[
       StyleBox["N",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["SF",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1af75d2f-054b-4b68-9618-5b446bac8342"],
 ". The next cell defines this engine; the cell after it checks that the \
self-energies are the derivatives of the energy (central differences on \
random states) and that the engine with the pairing term alone reproduces the \
analytic solution AS3 of Part I."
}], "Text",ExpressionUUID->"742b6418-ffd2-4e76-a54e-c0319ff39e59"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"--", " ", "the"}]}], " ", "constants", " ", "and", " ", 
    "matrices", " ", "of", " ", "the", " ", "engine", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"floating", " ", "point"}], ")"}], " ", "--"}], "--"}]}], " ", 
   "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"lamLL", " ", "=", " ", "1."}], ";"}], 
   "                                   ", 
   RowBox[{"(*", " ", 
    RowBox[{"the", " ", "momentum", " ", "cutoff", " ", "Lambda_LL"}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"gvLL", ",", " ", "gfLL"}], "}"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"0.7", ",", " ", "0.45"}], "}"}]}], ";"}], 
   "                   ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", "gauge", " ", "couplings", " ", 
      RowBox[{"g", "^", "v_LL"}]}], ",", " ", 
     RowBox[{
      RowBox[{"g", "^", "F_LL"}], " ", "of", " ", "the", " ", "project"}]}], 
    " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"id8", " ", "=", " ", 
     RowBox[{"N", "[", 
      RowBox[{"IdentityMatrix", "[", "8", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"b8", " ", "=", " ", 
     RowBox[{"N", "[", 
      RowBox[{"d8", "[", "betaLL", "]"}], "]"}]}], ";"}], 
   "                           ", 
   RowBox[{"(*", " ", 
    RowBox[{"beta_LL", " ", 
     RowBox[{"(", "x", ")"}], " ", "1", "_", "2"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"k8", "[", "iota_", "]"}], " ", ":=", " ", 
     RowBox[{"N", "[", 
      RowBox[{"kLL", "[", "iota", "]"}], "]"}]}], ";"}], 
   "                    ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"K", "^", "iota_LL"}], ",", " ", "numerical"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"zero8", " ", "=", " ", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{
       RowBox[{"0.", " ", "I"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"8", ",", " ", "8"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"gaussLegendre", "[", "n", "]"}], ":", " ", 
     RowBox[{
      RowBox[{
      "the", " ", "nodes", " ", "and", " ", "weights", " ", "of", " ", "the", 
       " ", "n"}], "-", 
      RowBox[{"point", " ", "Gauss"}], "-", 
      RowBox[{"Legendre", " ", "rule", " ", 
       RowBox[{"on", " ", "[", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "1"}], "]"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"40", " ", "digits"}], ",", " ", 
         RowBox[{"then", " ", "machine", " ", "numbers"}]}], ")"}]}]}]}], " ",
     "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"gaussLegendre", "[", "n_Integer", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "xx", ",", " ", "poly", ",", " ", "dpoly", ",", " ", "roots"}], "}"}],
        ",", "\n", "   ", 
       RowBox[{
        RowBox[{"poly", " ", "=", " ", 
         RowBox[{"LegendreP", "[", 
          RowBox[{"n", ",", " ", "xx"}], "]"}]}], ";", " ", 
        RowBox[{"dpoly", " ", "=", " ", 
         RowBox[{"D", "[", 
          RowBox[{"poly", ",", " ", "xx"}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"roots", " ", "=", " ", 
         RowBox[{"Sort", "[", 
          RowBox[{"xx", " ", "/.", " ", 
           RowBox[{"NSolve", "[", 
            RowBox[{
             RowBox[{"poly", " ", "==", " ", "0"}], ",", " ", "xx", ",", " ", 
             
             RowBox[{"WorkingPrecision", " ", "->", " ", "40"}]}], "]"}]}], 
          "]"}]}], ";", "\n", "   ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"N", "[", "roots", "]"}], ",", " ", 
          RowBox[{"N", "[", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"2", "/", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", " ", "-", " ", 
                   RowBox[{"#", "^", "2"}]}], ")"}], " ", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"dpoly", " ", "/.", " ", 
                    RowBox[{"xx", " ", "->", " ", "#"}]}], ")"}], "^", 
                  "2"}]}], ")"}]}], " ", "&"}], ",", " ", "roots"}], "]"}], 
           "]"}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"gridSF", "[", "nr", "]"}], ":", " ", 
      RowBox[{"the", " ", "radial", " ", "nodes", " ", "kr", " ", 
       RowBox[{"(", 
        RowBox[{"on", " ", "[", 
         RowBox[{"0", ",", " ", "Lambda"}], "]"}], ")"}], " ", "and", " ", 
       "weights", " ", "wr"}]}], ",", " ", 
     RowBox[{
      RowBox[{"the", " ", "momenta", " ", "q", " ", 
       RowBox[{"(", 
        RowBox[{"nr", " ", "x", " ", "6", " ", "directions"}], ")"}], " ", 
       "and", " ", "the", " ", "weights", " ", "w", " ", "of", "\n", "   ", 
       "int", " ", 
       RowBox[{"d", "^", "3"}], 
       RowBox[{"q", "/", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"2", " ", "pi"}], ")"}], "^", "3"}]}]}], ";", " ", 
      RowBox[{
       RowBox[{
       "the", " ", "node", " ", "of", " ", "radial", " ", "index", " ", "i", " ",
         "and", " ", "direction", " ", "d", " ", "is", " ", "the", " ", 
        "node", " ", "6", " ", 
        RowBox[{"(", 
         RowBox[{"i", " ", "-", " ", "1"}], ")"}]}], " ", "+", " ", "d"}]}]}],
     " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"gridSF", "[", "nr_Integer", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "x", ",", " ", "wgl", ",", " ", "kr", ",", " ", "wr", ",", " ", 
         "dirs"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "wgl"}], "}"}], " ", "=", " ", 
         RowBox[{"gaussLegendre", "[", "nr", "]"}]}], ";", "\n", "   ", 
        RowBox[{"kr", " ", "=", " ", 
         RowBox[{"0.5", " ", "lamLL", " ", 
          RowBox[{"(", 
           RowBox[{"x", " ", "+", " ", "1."}], ")"}]}]}], ";", " ", 
        RowBox[{"wr", " ", "=", " ", 
         RowBox[{"0.5", " ", "lamLL", " ", "wgl"}]}], ";", "\n", "   ", 
        RowBox[{"dirs", " ", "=", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", " ", "0", ",", " ", "0"}], "}"}], ",", 
           " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "1", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", 
             RowBox[{"-", "1"}], ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0", ",", " ", "1"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0", ",", " ", 
             RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ";", "\n", "   ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<nr\>\"", " ", "->", " ", "nr"}], ",", " ", 
          RowBox[{"\"\<kr\>\"", " ", "->", " ", "kr"}], ",", " ", 
          RowBox[{"\"\<wr\>\"", " ", "->", " ", "wr"}], ",", " ", 
          RowBox[{"\"\<dirs\>\"", " ", "->", " ", 
           RowBox[{"N", "[", "dirs", "]"}]}], ",", "\n", "     ", 
          RowBox[{"\"\<q\>\"", " ", "->", " ", 
           RowBox[{"Flatten", "[", 
            RowBox[{
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"kr", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], " ", 
                RowBox[{"dirs", "[", 
                 RowBox[{"[", "d", "]"}], "]"}]}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"i", ",", " ", "nr"}], "}"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"d", ",", " ", "6"}], "}"}]}], "]"}], ",", " ", "1"}],
             "]"}]}], ",", "\n", "     ", 
          RowBox[{"\"\<w\>\"", " ", "->", " ", 
           RowBox[{"Flatten", "[", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"wr", "[", 
                RowBox[{"[", "i", "]"}], "]"}], " ", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"kr", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "^", "2"}], "/", 
                 RowBox[{"(", 
                  RowBox[{"2", " ", 
                   RowBox[{"Pi", "^", "2"}]}], ")"}]}], "/", "6."}]}], ",", 
              " ", 
              RowBox[{"{", 
               RowBox[{"i", ",", " ", "nr"}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"d", ",", " ", "6"}], "}"}]}], "]"}], "]"}]}], ",", 
          " ", 
          RowBox[{"\"\<n\>\"", " ", "->", " ", 
           RowBox[{"6", " ", "nr"}]}]}], "|>"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"ksProj", "[", "x", "]"}], ":", " ", 
     RowBox[{
      RowBox[{"the", " ", "projection", " ", 
       RowBox[{"P", "^", "KS_SF"}], " ", "onto", " ", "the", " ", "matrices", 
       " ", "of", " ", "the", " ", "two", " ", "Kohn"}], "-", 
      RowBox[{"Sham", " ", "densities"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"ksProj", "[", "x_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Tr", "[", "x", "]"}], "/", "8"}], " ", "id8"}], " ", "+", 
      " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Tr", "[", 
         RowBox[{"b8", " ", ".", " ", "x"}], "]"}], "/", "8"}], " ", 
       "b8"}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"terms", "[", 
       RowBox[{"method", ",", " ", "gs", ",", " ", "gv", ",", " ", "g"}], 
       "]"}], ":", " ", 
      RowBox[{
      "the", " ", "contact", " ", "terms", " ", "of", " ", "the", " ", 
       "potential", " ", "with", " ", "the", " ", "couplings", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"G", "^", "S"}], ",", " ", 
         RowBox[{"G", "^", "V"}], ",", " ", "G"}], ")"}], " ", "for", " ", 
       "a", " ", "method", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<HS\>\"", ",", " ", "sS", ",", " ", "sV"}], "}"}]}]}], ",",
      " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"{", "\"\<KS\>\"", "}"}], " ", "or", " ", 
        RowBox[{"{", "\"\<CJT\>\"", "}"}]}], ":", " ", 
       RowBox[{"a", " ", "list", " ", "of", " ", 
        RowBox[{"{", 
         RowBox[{"kind", ",", " ", "data", ",", " ", 
          RowBox[{"{", 
           RowBox[{"wH", ",", " ", "wF", ",", " ", "wP"}], "}"}], ",", " ", 
          "ks"}], "}"}]}]}], ";", " ", 
      RowBox[{"kind", " ", "\"\<b\>\"", " ", "with", " ", "data", " ", 
       RowBox[{"{", 
        RowBox[{"nu", ",", " ", "X"}], "}"}], " ", "for", "\n", "   ", 
       RowBox[{"nu", " ", ":", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Psi", "^", "dag"}], " ", "X", " ", "Psi"}], ")"}], "^", 
         "2"}], ":"}]}]}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"kind", " ", "\"\<p\>\"", " ", "with", " ", "data", " ", 
         RowBox[{"{", 
          RowBox[{"G", ",", " ", "K"}], "}"}], " ", "for"}], " ", "-", 
        RowBox[{"(", 
         RowBox[{"G", "/", "4"}], ")"}]}], " ", ":", 
       RowBox[{
        RowBox[{"Pi", "^", "dag"}], " ", "Pi"}], ":"}], ";", " ", 
      RowBox[{
      "ks", " ", "is", " ", "True", " ", "for", " ", "the", " ", "KS", " ", 
       "projection"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"terms", "[", 
      RowBox[{
      "method_List", ",", " ", "gs_", ",", " ", "gv_", ",", " ", "g_"}], 
