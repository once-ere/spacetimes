       RowBox[{"G", "^"}], "*", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"i", " ", 
          RowBox[{"tau", "^", "2"}]}], ")"}], "^", "T"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"ok8b", " ", "=", " ", 
     RowBox[{
      RowBox[{"And", " ", "@@", " ", 
