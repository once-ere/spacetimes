        RowBox[{"st8", ",", " ", "InputForm"}], "]"}]}]}], "]"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "a", " ", "fixed", " ", "generic", " ", "vector", " ", "with", " ", 
      "exact", " ", "entries", " ", "for", " ", "each", " ", "channel"}], ",",
      " ", 
     RowBox[{
     "and", " ", "a", " ", "vector", " ", "of", " ", "its", " ", "neutral", " ",
       "part"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"generic", "[", "n_", "]"}], " ", ":=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"j", " ", "+", " ", "1"}], ")"}], " ", "+", " ", 
        RowBox[{"I", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", " ", "j"}], " ", "-", " ", "1"}], ")"}]}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "n"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"res11", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"w", " ", "=", " ", 
            RowBox[{"generic", "[", 
             RowBox[{"ch", "[", "\"\<dim\>\"", "]"}], "]"}]}], ",", " ", "st",
            ",", " ", "nz", ",", " ", "stn", ",", " ", "allNeutral", ",", " ", 
           RowBox[{"g4", " ", "=", " ", 
            RowBox[{
             RowBox[{"ch", "[", "\"\<lx\>\"", "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"1", " ", ";;", " ", "4"}], "]"}], "]"}]}]}], "}"}], ",",
          "\n", "    ", 
         RowBox[{
          RowBox[{"st", " ", "=", " ", 
           RowBox[{"stab", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"hg", "[", 
                 RowBox[{"[", 
                  RowBox[{"1", " ", ";;", " ", "4"}], "]"}], "]"}], ",", " ", 
                "phi0"}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"hg2", "[", 
                 RowBox[{"[", 
                  RowBox[{"1", " ", ";;", " ", "4"}], "]"}], "]"}], ",", " ", 
                "phi0p"}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"g4", ",", " ", "w"}], "}"}]}], "}"}], "]"}]}], ";", 
          "\n", "    ", 
          RowBox[{"allNeutral", " ", "=", " ", 
           RowBox[{"AllTrue", "[", 
            RowBox[{
             RowBox[{"ch", "[", "\"\<qv\>\"", "]"}], ",", " ", 
             RowBox[{
              RowBox[{"#", " ", "==", " ", "0"}], " ", "&"}]}], "]"}]}], ";", 
          "\n", "    ", 
          RowBox[{"nz", " ", "=", " ", 
           RowBox[{"NullSpace", "[", 
            RowBox[{
             RowBox[{"ch", "[", "\"\<lx\>\"", "]"}], "[", 
             RowBox[{"[", "iQ", "]"}], "]"}], "]"}]}], ";", "\n", "    ", 
          RowBox[{"stn", " ", "=", " ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"nz", " ", "===", " ", 
              RowBox[{"{", "}"}]}], ",", " ", "None", ",", "\n", "      ", 
             RowBox[{"stab", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"hg", "[", 
                   RowBox[{"[", 
                    RowBox[{"1", " ", ";;", " ", "4"}], "]"}], "]"}], ",", 
                  " ", "phi0"}], "}"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"hg2", "[", 
                   RowBox[{"[", 
                    RowBox[{"1", " ", ";;", " ", "4"}], "]"}], "]"}], ",", 
                  " ", "phi0p"}], "}"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"g4", ",", " ", 
                  RowBox[{"Total", "[", 
                   RowBox[{"MapIndexed", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"#2", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", "2"}], 
                    ")"}], " ", "#1"}], " ", "&"}], ",", " ", "nz"}], "]"}], 
                   "]"}]}], "}"}]}], "}"}], "]"}]}], "]"}]}], ";", "\n", 
          "    ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "st", "]"}], " ", "==", " ", 
             RowBox[{"If", "[", 
              RowBox[{"allNeutral", ",", " ", "1", ",", " ", "0"}], "]"}]}], ",",
             " ", 
            RowBox[{
             RowBox[{"stn", " ", "===", " ", "None"}], " ", "||", " ", 
             RowBox[{"alongQ", "[", "stn", "]"}]}]}], "}"}]}]}], "]"}], ",", 
       "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"ch", ",", " ", "channels"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rvCheck", "[", 
     RowBox[{"\"\<WQN-11f\>\"", ",", 
      " ", "\"\<a generic second condensate with a charged component, added \
to the neutral vacuum of H5, breaks Q; \\\none in the neutral part of a \
channel keeps exactly Q\>\"", ",", " ", 
      RowBox[{"And", " ", "@@", " ", 
       RowBox[{"Flatten", "[", "res11", "]"}]}], ",", "\n", "  ", 
