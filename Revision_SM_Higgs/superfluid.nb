Cell[TextData[{
 "The next cell, which is closed, holds the tables of the Rust programs of \
the revision that the checks of this part compare with: the channels of stage \
2 (",
 StyleBox["data/sh_channels.csv",
  FontFamily->"Source Code Pro"],
 ", ",
 StyleBox["sh_custodial_channels.csv",
  FontFamily->"Source Code Pro"],
 "), the normal vacuum and the ground states of stage 3 (",
 StyleBox["sh_sf_normal_vacuum.csv",
  FontFamily->"Source Code Pro"],
 ", ",
 StyleBox["sh_sf_ground.csv",
  FontFamily->"Source Code Pro"],
 "), the minimum of the effective potential, the masses and the values of \
stage 4 (",
 StyleBox["sh_hg_minimum.csv",
  FontFamily->"Source Code Pro"],
 ", ",
 StyleBox["sh_hg_masses.csv",
  FontFamily->"Source Code Pro"],
 ", ",
 StyleBox["sh_hg_values.csv",
  FontFamily->"Source Code Pro"],
 "), and the runs and the signals of stage 6 (",
 StyleBox["sh_dyn_runs.csv",
  FontFamily->"Source Code Pro"],
 ", and of ",
 StyleBox["sh_dyn_signals.csv",
  FontFamily->"Source Code Pro"],
 " the rows that the checks use). Its first lines name the data files with \
their SHA-256 checksums."
}], "Text",ExpressionUUID->"9e9cf65f-7c72-4c04-9a2d-506ebe5e6445"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "the", " ", "tables", " ", "of", " ", "the", " ", "Rust", " ", "programs", 
    " ", "of", " ", "the", " ", "revision", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"written", " ", "by", " ", 
       RowBox[{
        RowBox[{"wolfram", "/", "tools"}], "/", "make_data"}], 
       RowBox[{"_cells", ".", "py"}]}], ";", " ", 
      RowBox[{"do", " ", "not", " ", "edit"}]}], ")"}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
