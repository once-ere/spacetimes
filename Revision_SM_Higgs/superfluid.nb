                    RowBox[{"cdOps", "[", 
                    RowBox[{"[", "a", "]"}], "]"}]}], ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"a", ",", " ", "8"}], "}"}]}], "]"}], " ", ".", 
                  " ", 
                  RowBox[{"piOps", "[", 
                   RowBox[{"[", "k", "]"}], "]"}]}], ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}]}]}], "]"}], 
            "]"}], "]"}]}], "]"}]}]}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"e", ",", " ", "8"}], "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WE-2\>\"", ",", 
      " ", "\"\<scalar contact term: [Psi_e, H_S] = G^S (Psi-bar Psi)(gamma^0 \
Psi)_e (exact, 256 states)\>\"", ",", " ", "dE2", ",", " ", "0", ",", 
      " ", "\"\<E-2\>\"", ",", " ", "\"\<E-2\>\""}], "]"}], ";"}], "\n", 
   RowBox[{
