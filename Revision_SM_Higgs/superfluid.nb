          ",", " ", "\"\<width\>\"", ",", " ", "\"\<xi0\>\"", ",", 
         " ", "\"\<PhiG\>\""}], "}"}], " ", "->", " ", 
       RowBox[{"Range", "[", "19", "]"}]}], "]"}]}], ";"}], "\n", 
