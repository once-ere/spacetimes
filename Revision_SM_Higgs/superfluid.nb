Cell[TextData[{
 "with the eight units ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "0"], ",", "\[Ellipsis]", ",", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "3"], ",", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "63bbac3f-a0c0-46c8-8d84-8ac7e1e0191a"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     RowBox[{"4", "+", 
      StyleBox["j", "TI"]}]], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6f793831-7e3b-4b96-8c92-4bccb2db5f04"],
 ". The norm is multiplicative, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox[
      RowBox[{"x", "y"}],
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["x",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["y",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "15d5ee1c-fc00-4d91-9acd-89d84add86e9"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["x",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    OverscriptBox[
     StyleBox["x",
      FontWeight->"Bold",
      FontSlant->"Plain"], "_"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["x",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "0"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "937a50ab-220e-43c3-83f7-60ffd74728c0"],
 ". The product is not associative (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["e",
        FontWeight->"Bold",
        FontSlant->"Plain"], "1"], 
      SubscriptBox[
       StyleBox["e",
        FontWeight->"Bold",
        FontSlant->"Plain"], "2"]}], ")"}], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "4"], "-", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "1"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["e",
        FontWeight->"Bold",
        FontSlant->"Plain"], "2"], 
      SubscriptBox[
       StyleBox["e",
        FontWeight->"Bold",
        FontSlant->"Plain"], "4"]}], ")"}], "\[LongEqual]", "2", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "7"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ee4e1f6d-4965-49ca-bb70-81fe45fb615e"],
 "), but it is alternative, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     StyleBox[
      RowBox[{"x", "x"}],
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    StyleBox["y",
     FontWeight->"Bold",
     FontSlant->"Plain"], "\[LongEqual]", 
    StyleBox["x",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     StyleBox[
      RowBox[{"x", "y"}],
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "78ad22e9-14a5-43be-8f01-e3ad7393c31b"],
 ", and satisfies the three Moufang identities ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     StyleBox[
      RowBox[{"z", "x", "z"}],
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    StyleBox["y",
     FontWeight->"Bold",
     FontSlant->"Plain"], "\[LongEqual]", 
    StyleBox["z",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["x",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       StyleBox[
        RowBox[{"z", "y"}],
        FontWeight->"Bold",
        FontSlant->"Plain"], ")"}]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9ff8250c-e4d4-4992-a8b4-b032b2605cdd"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["y",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     StyleBox[
      RowBox[{"z", "x", "z"}],
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       StyleBox[
        RowBox[{"y", "z"}],
        FontWeight->"Bold",
        FontSlant->"Plain"], ")"}], 
      StyleBox["x",
       FontWeight->"Bold",
       FontSlant->"Plain"]}], ")"}], 
    StyleBox["z",
     FontWeight->"Bold",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9c203f7f-135e-4c14-a68d-80398d54893f"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     StyleBox[
      RowBox[{"z", "x"}],
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    RowBox[{"(", 
     StyleBox[
      RowBox[{"y", "z"}],
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["z",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       StyleBox[
        RowBox[{"x", "y"}],
        FontWeight->"Bold",
        FontSlant->"Plain"], ")"}]}], ")"}], 
    StyleBox["z",
     FontWeight->"Bold",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a31e6208-ec43-4b31-a3d7-80874da61a0f"],
 ". The unit bi-octonions form the Lorentz super-loop ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["\[DoubleStruckCapitalL]",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5d16a2c0-6f9a-4558-83bf-3b5d2e5fa8ab"],
 ", a Moufang loop of real dimension 14 that contains ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SL", "TI"], 
    RowBox[{"(", 
     RowBox[{"2", ",", 
      StyleBox["\[DoubleStruckCapitalC]",
       FontSlant->"Plain"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "039832f3-926c-4e6c-9143-19f6e85fc7e9"],
 "."
}], "Text",ExpressionUUID->"b4ede76d-cd37-4dee-a003-96645d956164"],

Cell["\<\
The next cell checks these rules exactly: bi-octonions with small integer \
(Gaussian integer) coefficients are multiplied in exact arithmetic, so every \
identity must hold with the deviation exactly 0. Of the 343 ordered triples \
of imaginary units, 168 have a nonzero associator: a triple with two equal \
members has none (alternativity), and of the 210 triples of distinct units a \
triple has none exactly when its third unit is plus or minus the product of \
the first two, which leaves 210 - 42 = 168.\
\>", "Text",ExpressionUUID->"f5183088-bbb2-419a-866f-6e37ee243c76"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"A", "-", "2"}], ":", " ", 
      RowBox[{
      "the", " ", "rules", " ", "of", " ", "the", " ", "eight", " ", 
       "units"}], ":", " ", 
      RowBox[{"e_p", "^", "2"}]}], " ", "=", " ", 
     RowBox[{"-", "1"}]}], ",", " ", 
    RowBox[{
     RowBox[{"e_p", " ", "e_q"}], " ", "=", " ", 
     RowBox[{
      RowBox[{"-", "e_q"}], " ", "e_p", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"p", " ", "!=", " ", "q"}], ",", " ", 
        RowBox[{"both", " ", ">=", " ", "1"}]}], ")"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"e_j", " ", "e_", "4"}], " ", "=", " ", 
     RowBox[{"e_", 
      RowBox[{"(", 
       RowBox[{"4", "+", "j"}], ")"}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"dA2", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Join", "[", "\n", "    ", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"oMax", "[", 
           RowBox[{
            RowBox[{"oMul", "[", 
             RowBox[{
              RowBox[{"oUnit", "[", "p", "]"}], ",", " ", 
              RowBox[{"oUnit", "[", "p", "]"}]}], "]"}], " ", "+", " ", 
            RowBox[{"oUnit", "[", "0", "]"}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"p", ",", " ", "1", ",", " ", "7"}], "}"}]}], "]"}], ",", 
        "\n", "    ", 
        RowBox[{"Flatten", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"p", " ", "!=", " ", "q"}], ",", " ", 
             RowBox[{"oMax", "[", 
              RowBox[{
               RowBox[{"oMul", "[", 
                RowBox[{
                 RowBox[{"oUnit", "[", "p", "]"}], ",", " ", 
                 RowBox[{"oUnit", "[", "q", "]"}]}], "]"}], " ", "+", " ", 
               RowBox[{"oMul", "[", 
                RowBox[{
                 RowBox[{"oUnit", "[", "q", "]"}], ",", " ", 
                 RowBox[{"oUnit", "[", "p", "]"}]}], "]"}]}], "]"}], ",", " ",
              "0"}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"p", ",", " ", "1", ",", " ", "7"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"q", ",", " ", "1", ",", " ", "7"}], "}"}]}], "]"}], 
         "]"}], ",", "\n", "    ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"oMax", "[", 
           RowBox[{
            RowBox[{"oMul", "[", 
             RowBox[{
              RowBox[{"oUnit", "[", "j", "]"}], ",", " ", 
              RowBox[{"oUnit", "[", "4", "]"}]}], "]"}], " ", "-", " ", 
            RowBox[{"oUnit", "[", 
             RowBox[{"4", " ", "+", " ", "j"}], "]"}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"j", ",", " ", "1", ",", " ", "3"}], "}"}]}], "]"}]}], 
       "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WA-2\>\"", ",", 
      " ", "\"\<bi-octonion units: e_p^2 = -1, e_p e_q = -e_q e_p, e_j e_4 = \
e_(4+j) (exact)\>\"", ",", " ", "dA2", ",", " ", "0", ",", " ", "\"\<A-2\>\"",
       ",", " ", "\"\<A-2\>\""}], "]"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"rintBio", "[", "]"}], " ", "is", " ", "a", " ", "random", " ", 
      "bi"}], "-", 
     RowBox[{"octonion", " ", "with", " ", "Gaussian"}], "-", 
     RowBox[{"integer", " ", "coefficients", " ", "between"}], " ", "-", 
     RowBox[{"3", " ", "and", " ", "3"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"rintBio", "[", "]"}], " ", ":=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"RandomInteger", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "3"}], ",", " ", "3"}], "}"}], ",", " ", "4"}], 
         "]"}], " ", "+", " ", 
        RowBox[{"I", " ", 
         RowBox[{"RandomInteger", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "3"}], ",", " ", "3"}], "}"}], ",", " ", "4"}], 
          "]"}]}]}], ",", " ", 
       RowBox[{
        RowBox[{"RandomInteger", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "3"}], ",", " ", "3"}], "}"}], ",", " ", "4"}], 
         "]"}], " ", "+", " ", 
        RowBox[{"I", " ", 
         RowBox[{"RandomInteger", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "3"}], ",", " ", "3"}], "}"}], ",", " ", "4"}], 
          "]"}]}]}]}], "}"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"A", "-", 
      RowBox[{"3", " ", "to", " ", "A"}], "-", 
      RowBox[{
      "6", " ", "on", " ", "200", " ", "random", " ", "triples", " ", 
       RowBox[{"(", 
        RowBox[{"x", ",", " ", "y", ",", " ", "z"}], ")"}]}]}], ",", " ", 
     RowBox[{"in", " ", "exact", " ", "arithmetic"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dA3", ",", " ", "dA4", ",", " ", "dA5", ",", " ", "dA6"}], 
      "}"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], "}"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"x", " ", "=", " ", 
           RowBox[{"rintBio", "[", "]"}]}], ",", " ", 
          RowBox[{"y", " ", "=", " ", 
           RowBox[{"rintBio", "[", "]"}]}], ",", " ", 
          RowBox[{"z", " ", "=", " ", 
           RowBox[{"rintBio", "[", "]"}]}], ",", " ", "zxz"}], "}"}], ",", 
        "\n", "   ", 
        RowBox[{
         RowBox[{"dA3", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"dA3", ",", " ", 
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"oNorm", "[", 
               RowBox[{"oMul", "[", 
                RowBox[{"x", ",", " ", "y"}], "]"}], "]"}], " ", "-", " ", 
              RowBox[{
               RowBox[{"oNorm", "[", "x", "]"}], " ", 
               RowBox[{"oNorm", "[", "y", "]"}]}]}], "]"}]}], "]"}]}], ";", 
         "\n", "   ", 
         RowBox[{"dA4", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"dA4", ",", " ", 
            RowBox[{"oMax", "[", 
             RowBox[{
              RowBox[{"oMul", "[", 
               RowBox[{"x", ",", " ", 
                RowBox[{"oBar", "[", "x", "]"}]}], "]"}], " ", "-", " ", 
              RowBox[{
               RowBox[{"oNorm", "[", "x", "]"}], " ", 
               RowBox[{"oUnit", "[", "0", "]"}]}]}], "]"}]}], "]"}]}], ";", 
         "\n", "   ", 
         RowBox[{"dA5", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"dA5", ",", " ", 
            RowBox[{"oMax", "[", 
             RowBox[{
              RowBox[{"oMul", "[", 
               RowBox[{
                RowBox[{"oMul", "[", 
                 RowBox[{"x", ",", " ", "x"}], "]"}], ",", " ", "y"}], "]"}], 
              " ", "-", " ", 
              RowBox[{"oMul", "[", 
               RowBox[{"x", ",", " ", 
                RowBox[{"oMul", "[", 
                 RowBox[{"x", ",", " ", "y"}], "]"}]}], "]"}]}], "]"}], ",", 
            " ", 
            RowBox[{"oMax", "[", 
             RowBox[{
              RowBox[{"oMul", "[", 
               RowBox[{
                RowBox[{"oMul", "[", 
                 RowBox[{"y", ",", " ", "x"}], "]"}], ",", " ", "x"}], "]"}], 
              " ", "-", " ", 
              RowBox[{"oMul", "[", 
               RowBox[{"y", ",", " ", 
                RowBox[{"oMul", "[", 
                 RowBox[{"x", ",", " ", "x"}], "]"}]}], "]"}]}], "]"}]}], 
           "]"}]}], ";", "\n", "   ", 
         RowBox[{"zxz", " ", "=", " ", 
          RowBox[{"oMul", "[", 
           RowBox[{
            RowBox[{"oMul", "[", 
             RowBox[{"z", ",", " ", "x"}], "]"}], ",", " ", "z"}], "]"}]}], ";",
          "\n", "   ", 
         RowBox[{"dA6", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"dA6", ",", " ", 
            RowBox[{"oMax", "[", 
             RowBox[{
              RowBox[{"oMul", "[", 
               RowBox[{"zxz", ",", " ", "y"}], "]"}], " ", "-", " ", 
              RowBox[{"oMul", "[", 
               RowBox[{"z", ",", " ", 
                RowBox[{"oMul", "[", 
                 RowBox[{"x", ",", " ", 
                  RowBox[{"oMul", "[", 
                   RowBox[{"z", ",", " ", "y"}], "]"}]}], "]"}]}], "]"}]}], 
             "]"}], ",", " ", 
            RowBox[{"oMax", "[", 
             RowBox[{
              RowBox[{"oMul", "[", 
               RowBox[{"y", ",", " ", "zxz"}], "]"}], " ", "-", " ", 
              RowBox[{"oMul", "[", 
               RowBox[{
                RowBox[{"oMul", "[", 
                 RowBox[{
                  RowBox[{"oMul", "[", 
                   RowBox[{"y", ",", " ", "z"}], "]"}], ",", " ", "x"}], 
                 "]"}], ",", " ", "z"}], "]"}]}], "]"}], ",", "\n", "     ", 
            RowBox[{"oMax", "[", 
             RowBox[{
              RowBox[{"oMul", "[", 
               RowBox[{
                RowBox[{"oMul", "[", 
                 RowBox[{"z", ",", " ", "x"}], "]"}], ",", " ", 
                RowBox[{"oMul", "[", 
                 RowBox[{"y", ",", " ", "z"}], "]"}]}], "]"}], " ", "-", " ", 
              
              RowBox[{"oMul", "[", 
               RowBox[{
                RowBox[{"oMul", "[", 
                 RowBox[{"z", ",", " ", 
                  RowBox[{"oMul", "[", 
                   RowBox[{"x", ",", " ", "y"}], "]"}]}], "]"}], ",", " ", 
                "z"}], "]"}]}], "]"}]}], "]"}]}]}]}], "]"}], ",", " ", 
      RowBox[{"{", "200", "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WA-3\>\"", ",", 
      " ", "\"\<N(xy) = N(x) N(y), 200 random Gaussian-integer bi-octonions \
(exact)\>\"", ",", " ", "dA3", ",", " ", "0", ",", " ", "\"\<A-3\>\"", ",", 
      " ", "\"\<A-3\>\""}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WA-4\>\"", ",", " ", "\"\<x xbar = N(x) e_0 (exact)\>\"", ",",
       " ", "dA4", ",", " ", "0", ",", " ", "\"\<A-4\>\"", ",", 
      " ", "\"\<A-4\>\""}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WA-5\>\"", ",", 
      " ", "\"\<alternativity (xx)y = x(xy), (yx)x = y(xx) (exact)\>\"", ",", 
      " ", "dA5", ",", " ", "0", ",", " ", "\"\<A-5\>\"", ",", 
      " ", "\"\<A-5\>\""}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WA-6\>\"", ",", 
      " ", "\"\<the three Moufang identities (exact)\>\"", ",", " ", "dA6", ",",
       " ", "0", ",", " ", "\"\<A-6\>\"", ",", " ", "\"\<A-6\>\""}], "]"}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"A", "-", "7"}], ":", " ", 
      RowBox[{
      "the", " ", "associators", " ", "of", " ", "the", " ", "343", " ", 
       "ordered", " ", "triples", " ", "of", " ", "imaginary", " ", 
       "units"}]}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"and", " ", 
        RowBox[{"(", 
         RowBox[{"e1", " ", "e2"}], ")"}], " ", "e4"}], " ", "-", " ", 
       RowBox[{"e1", " ", 
        RowBox[{"(", 
         RowBox[{"e2", " ", "e4"}], ")"}]}]}], " ", "=", " ", 
      RowBox[{"2", " ", "e7"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"nonzeroAssociators", " ", "=", " ", 
     RowBox[{"Count", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"oMax", "[", 
           RowBox[{
            RowBox[{"oMul", "[", 
             RowBox[{
              RowBox[{"oMul", "[", 
               RowBox[{
                RowBox[{"oUnit", "[", "p", "]"}], ",", " ", 
                RowBox[{"oUnit", "[", "q", "]"}]}], "]"}], ",", " ", 
              RowBox[{"oUnit", "[", "r", "]"}]}], "]"}], " ", "-", " ", 
            RowBox[{"oMul", "[", 
             RowBox[{
              RowBox[{"oUnit", "[", "p", "]"}], ",", " ", 
              RowBox[{"oMul", "[", 
               RowBox[{
                RowBox[{"oUnit", "[", "q", "]"}], ",", " ", 
                RowBox[{"oUnit", "[", "r", "]"}]}], "]"}]}], "]"}]}], "]"}], ",",
           "\n", "      ", 
          RowBox[{"{", 
           RowBox[{"p", ",", " ", "1", ",", " ", "7"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"q", ",", " ", "1", ",", " ", "7"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"r", ",", " ", "1", ",", " ", "7"}], "}"}]}], "]"}], "]"}],
        ",", " ", 
       RowBox[{"v_", " ", "/;", " ", 
        RowBox[{"v", " ", ">", " ", "0"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"a124", " ", "=", " ", 
     RowBox[{
      RowBox[{"oMul", "[", 
       RowBox[{
        RowBox[{"oMul", "[", 
         RowBox[{
          RowBox[{"oUnit", "[", "1", "]"}], ",", " ", 
          RowBox[{"oUnit", "[", "2", "]"}]}], "]"}], ",", " ", 
        RowBox[{"oUnit", "[", "4", "]"}]}], "]"}], " ", "-", " ", 
      RowBox[{"oMul", "[", 
       RowBox[{
        RowBox[{"oUnit", "[", "1", "]"}], ",", " ", 
        RowBox[{"oMul", "[", 
         RowBox[{
          RowBox[{"oUnit", "[", "2", "]"}], ",", " ", 
          RowBox[{"oUnit", "[", "4", "]"}]}], "]"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"checkTrue", "[", 
     RowBox[{"\"\<WA-7\>\"", ",", 
      " ", "\"\<168 of the 343 triples of imaginary units have a nonzero \
associator; (e1 e2) e4 - e1 (e2 e4) = 2 e7\>\"", ",", "\n", "  ", 
      RowBox[{
       RowBox[{"nonzeroAssociators", " ", "==", " ", "168"}], " ", "&&", " ", 
       
       RowBox[{
        RowBox[{"oMax", "[", 
         RowBox[{"a124", " ", "-", " ", 
          RowBox[{"2", " ", 
           RowBox[{"oUnit", "[", "7", "]"}]}]}], "]"}], " ", "==", " ", 
        "0"}]}], ",", " ", 
      RowBox[{
       RowBox[{"ToString", "[", "nonzeroAssociators", "]"}], " ", "<>", 
       " ", "\"\< nonzero\>\""}], ",", " ", "\"\<A-7\>\"", ",", 
      " ", "\"\<A-7\>\""}], "]"}], ";"}]}]}]], "Input",
 CellLabel->"In[51]:=",ExpressionUUID->"4ba8533c-8b63-413d-be27-b0c301400be4"],

