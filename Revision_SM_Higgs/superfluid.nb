Cell[TextData[{
 StyleBox["AS1: plane waves in constant gauge fields.",
  FontWeight->"Bold"],
 " In constant gauge fields the field equation without self-interaction has \
plane-wave solutions ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Chi]", "\[ThinSpace]", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      RowBox[{"-", 
       StyleBox["i", "TI"]}], "\[Omega]", 
      StyleBox["t", "TI"], "+", 
      StyleBox["i", "TI"], 
      OverscriptBox[
       StyleBox["q", "TI"], "\[RightVector]"], "\[CenterDot]", 
      OverscriptBox[
       StyleBox["x", "TI"], "\[RightVector]"]}]]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2dabb863-ff23-4de0-b8f1-2896ca58677a"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"\[Omega]", ",", "\[Chi]"}], ")"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f3a848b8-abdb-4c87-908f-fabdfd37556b"],
 " is an eigenpair of the Hermitian matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["h",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["pw",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     OverscriptBox[
      StyleBox["q", "TI"], "\[RightVector]"], ")"}], "\[LongEqual]", 
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "+", 
    SuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["F",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["B", "TI"], "0"], "+", 
    SuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["v",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["W",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "0"], "+", 
    UnderscriptBox["\[Sum]", 
     StyleBox["j", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["j", "TI"]], "+", 
      SuperscriptBox[
       StyleBox["g", "TI"], 
       StyleBox["F",
        FontSlant->"Plain"]], 
      SubscriptBox[
       StyleBox["B", "TI"], 
       StyleBox["j", "TI"]], "+", 
      SuperscriptBox[
       StyleBox["g", "TI"], 
       StyleBox["v",
        FontSlant->"Plain"]], 
      SubscriptBox[
       StyleBox["W",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["j", "TI"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c84246f9-4299-4c78-8f01-f8aabed6be23"],
 ". For the spin-isospin locked field ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["W", "TI"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["j", "TI"]}], "\[Iota]"], "\[LongEqual]", 
    StyleBox["w", "TI"], "\[ThinSpace]", 
    SubscriptBox["\[Delta]", 
     RowBox[{"\[Iota]", 
      StyleBox["j", "TI"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c4420fed-ffe3-4ca3-9a35-5aa8bf445966"],
 " the eight frequencies at the momentum ",
 Cell[BoxData[
  FormBox[
   StyleBox["q", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fd86211b-0e56-4534-955e-0a58e92eb5e8"],
 " along ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["x", "TI"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3c9e8493-cf49-4840-8576-6c4cd550c412"],
 " are ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", "\[Omega]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "363e78f7-39f6-40db-800f-b81e3bee8b8e"],
 " with the four branches ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Omega]", "2"], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["m", "TI"], "2"], "+", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       StyleBox["q", "TI"], "\[PlusMinus]", 
       StyleBox["gw", "TI"], "/", "2"}], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c60a52ba-6b53-45b8-b6e3-9eb8718aa951"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Omega]", "2"], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["m", "TI"], "2"], "+", 
    SuperscriptBox[
     StyleBox["q", "TI"], "2"], "+", 
    FractionBox["5", "4"], 
    SuperscriptBox[
     StyleBox["g", "TI"], "2"], 
    SuperscriptBox[
     StyleBox["w", "TI"], "2"], "\[PlusMinus]", 
    StyleBox["gw", "TI"], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        StyleBox["q", "TI"], "2"], "+", 
       SuperscriptBox[
        StyleBox["g", "TI"], "2"], 
       SuperscriptBox[
        StyleBox["w", "TI"], "2"]}], ")"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "66d2709f-fbed-4beb-b032-2dc851222867"],
 "."
}], "Text",ExpressionUUID->"87e7c2d2-143d-4b1e-88f4-be28d56cfbcc"],

Cell[TextData[{
 StyleBox["AS2: Landau levels.",
  FontWeight->"Bold"],
 " In a constant magnetic field ",
 Cell[BoxData[
  FormBox[
   StyleBox["B", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "751f8344-6003-4685-8600-76f06f0cde81"],
 " along ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["x", "TI"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "374c52b7-9cd8-40f5-8156-7464eac379c5"],
 " the frequencies are ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       StyleBox["m", "TI"], "2"], "+", 
      SubsuperscriptBox[
       StyleBox["q", "TI"], "3", "2"], "+", "2", 
      StyleBox["neB", "TI"]}], ")"}], 
    RowBox[{"1", "/", "2"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7d62f0c9-fb75-4213-bfc0-8552338ed9c9"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "0", ",", "1", ",", "2", ",", 
    "\[Ellipsis]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8d39477b-e2d1-47d2-930c-08445714d8e8"],
 "; the program discretizes ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["x", "TI"], "1"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7148c592-e4ae-4a30-b414-7ebb6dd98741"],
 " on a lattice with the Wilson term (spacings ",
 Cell[BoxData[
  FormBox["0.1", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5c53cfd0-4452-4ab6-a5a3-db5ef4c424d6"],
 ", ",
 Cell[BoxData[
  FormBox["0.05", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1d9fea32-1982-469b-8dc7-e6b3c5d44bbf"],
 ", ",
 Cell[BoxData[
  FormBox["0.025", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d3232ad0-64b7-4c05-b3aa-6148bd492030"],
 ") and compares the seven lowest positive frequencies, and their Richardson \
extrapolation ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    StyleBox["E", "TI"], 
    RowBox[{"(", "0.025", ")"}], "-", 
    StyleBox["E", "TI"], 
    RowBox[{"(", "0.05", ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ba8a7739-48f1-45ad-b973-a6857f5404ec"],
 ", with the Landau levels."
}], "Text",ExpressionUUID->"97d74625-707e-41b5-93db-90f2f5485651"],

Cell[TextData[{
 StyleBox["AS3: the uniform superfluid of the spin-zero pairing.",
  FontWeight->"Bold"],
 " For a uniform unitary pair field the 16 eigenvalues of the matrix of \
Bogoliubov and de Gennes are ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    SuperscriptBox[
     RowBox[{"[", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"\[CurlyEpsilon]", "\[PlusMinus]", "\[Mu]"}], ")"}], "2"], "+", 
       SuperscriptBox["\[CapitalDelta]", "2"]}], "]"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7c9dbf27-6f9c-427d-839a-43620719f5fc"],
 ", each four times; the mean-field energy is stationary where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["G", "TI"], "/", 
      SuperscriptBox["\[Pi]", "2"]}], ")"}], 
    SubscriptBox[
     StyleBox["I", "TI"], "1"], 
    RowBox[{"(", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         StyleBox["m", "TI"], "2"], "+", 
        SuperscriptBox["\[CapitalDelta]", "2"]}], ")"}], 
      RowBox[{"1", "/", "2"}]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6e648836-224c-4b32-b9d4-2d156f430370"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["I", "TI"], "1"], 
    RowBox[{"(", 
     StyleBox["M", "TI"], ")"}], "\[LongEqual]", 
    FractionBox["1", "2"], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "+", 
         SuperscriptBox[
          StyleBox["M", "TI"], "2"]}], ")"}], 
       RowBox[{"1", "/", "2"}]], "-", 
      SuperscriptBox[
       StyleBox["M", "TI"], "2"], "\[ThinSpace]", 
      StyleBox["arcsinh",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       RowBox[{"1", "/", 
        StyleBox["M", "TI"]}], ")"}]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8f13fb55-edeb-470c-9d54-5a1ba31c8b39"],
 ", and at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["G", "TI"], "\[LongEqual]", "22.5"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "47d1ecd3-a295-4fde-97b6-abe1352e2c37"],
 " the gap is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", "\[LongEqual]", "0.2094933033"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b7330709-bdfb-401e-92ae-9f03a1c1260d"],
 "."
}], "Text",ExpressionUUID->"97621f14-1500-4364-910c-75ddd3f35da5"],

Cell[TextData[{
 StyleBox["AS4: the kink of the pair field.",
  FontWeight->"Bold"],
 " For the pair field ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", 
    RowBox[{"(", 
     StyleBox["x", "TI"], ")"}], "\[LongEqual]", 
    SubscriptBox["\[CapitalDelta]", "\[Infinity]"], "\[ThinSpace]", 
    StyleBox["tanh",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["x", "TI"], "/", "\[ScriptL]"}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "717da96b-1eb3-48d0-8f18-dc387793b7fa"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalDelta]", "\[Infinity]"], "\[LongEqual]", "0.5"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0a7c6dff-acbe-48b3-a44e-5f55cde930a8"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ScriptL]", "\[LongEqual]", "4"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "59909c38-5c99-4b61-99e6-ee3e6540905f"],
 ") the reduced problem has the bound states ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["sech",
      FontSlant->"Plain"], "2"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["x", "TI"], "/", "\[ScriptL]"}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2dc2d0d2-4c08-468b-9916-2d9b841fafcb"],
 " (zero mode, energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    StyleBox["m", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "97b58168-7b7d-40eb-8ee0-8c5a7a3d2361"],
 ") and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["sech",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["x", "TI"], "/", "\[ScriptL]"}], ")"}], "\[ThinSpace]", 
    StyleBox["tanh",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["x", "TI"], "/", "\[ScriptL]"}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "120d3c2d-5a8d-417f-98aa-2952f8a78881"],
 " (energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        StyleBox["m", "TI"], "2"], "+", 
       SubsuperscriptBox[
        StyleBox["E", "TI"], "1", "2"]}], ")"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fcd43f25-dcfa-4483-b00c-36561052bbf7"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["E", "TI"], "1", "2"], "\[LongEqual]", "3", "/", "16"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "38ff6bca-53ac-4fd8-93f5-e8663456c8d2"],
 "); on the Wilson lattice exactly three bound states lie below the continuum \
",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       StyleBox["m", "TI"], "2"], "+", 
      SubsuperscriptBox["\[CapitalDelta]", "\[Infinity]", "2"]}], ")"}], 
    RowBox[{"1", "/", "2"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "11b12261-2518-4329-95c0-3aec3e7c4001"],
 "."
}], "Text",ExpressionUUID->"2191094b-d108-49cc-b010-6219acb90438"],

Cell[TextData[{
 "The next cell computes the four cases. The eigenvalues of the Hermitian \
matrices are computed by the function ",
 StyleBox["Eigenvalues",
  FontFamily->"Source Code Pro"],
 " of the Wolfram Language (dense matrices of up to 4800 rows); the gap \
equation is solved by ",
 StyleBox["FindRoot",
  FontFamily->"Source Code Pro"],
 " with 30 digits; the profiles of AS4 are checked symbolically by ",
 StyleBox["FullSimplify",
  FontFamily->"Source Code Pro"],
 "."
}], "Text",ExpressionUUID->"5ae3f26b-77e5-41b2-8dd3-9fc0f07b8c65"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"hPW", "[", 
      RowBox[{
      "q", ",", " ", "m", ",", " ", "gv", ",", " ", "gf", ",", " ", "w", ",", 
       " ", "b"}], "]"}], ":", " ", 
     RowBox[{
      RowBox[{"the", " ", "plane"}], "-", 
      RowBox[{
      "wave", " ", "matrix", " ", "of", " ", "AS1", " ", "for", " ", "the", " ",
        "constant", " ", "fields", " ", 
       RowBox[{"w", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"p", "+", "1"}], ",", " ", "i"}], "]"}], "]"}]}]}]}], " ", "=",
     " ", 
    RowBox[{
     RowBox[{
      RowBox[{"W", "^", "i_p"}], " ", "and", " ", 
      RowBox[{"b", "[", 
       RowBox[{"[", 
        RowBox[{"p", "+", "1"}], "]"}], "]"}]}], " ", "=", " ", "B_p"}]}], 
   " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"hPW", "[", 
      RowBox[{
      "q_", ",", " ", "m_", ",", " ", "gv_", ",", " ", "gf_", ",", " ", "w_", 
       ",", " ", "b_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "gauge", "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{
         RowBox[{"gauge", "[", "p_", "]"}], " ", ":=", " ", 
         RowBox[{
          RowBox[{"gf", " ", 
           RowBox[{"b", "[", 
            RowBox[{"[", 
             RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}], " ", 
           RowBox[{"IdentityMatrix", "[", "8", "]"}]}], " ", "+", " ", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{"gv", " ", 
             RowBox[{"w", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"p", " ", "+", " ", "1"}], ",", " ", "i"}], "]"}], 
              "]"}], " ", 
             RowBox[{"tLL", "[", "i", "]"}]}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"i", ",", " ", "3"}], "}"}]}], "]"}]}]}], ";", "\n", 
        "   ", 
        RowBox[{
         RowBox[{
          RowBox[{"d8", "[", "betaLL", "]"}], " ", "m"}], " ", "+", " ", 
         RowBox[{"gauge", "[", "0", "]"}], " ", "+", " ", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"d8", "[", 
             RowBox[{"alphaLL", "[", "j", "]"}], "]"}], " ", ".", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"q", "[", 
                RowBox[{"[", "j", "]"}], "]"}], " ", 
               RowBox[{"IdentityMatrix", "[", "8", "]"}]}], " ", "+", " ", 
              RowBox[{"gauge", "[", "j", "]"}]}], ")"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}]}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"AS1", "-", "3"}], ":", " ", 
       RowBox[{
        RowBox[{"the", " ", "spin"}], "-", 
        RowBox[{"isospin", " ", "locked", " ", "field", " ", 
         RowBox[{"W", "^", "i_j"}]}]}]}], " ", "=", " ", 
      RowBox[{"w", " ", "delta_ij"}]}], ",", " ", 
     RowBox[{"w", " ", "=", " ", "0.9"}], ",", " ", 
     RowBox[{"g_v", " ", "=", " ", "0.83"}], ",", " ", 
     RowBox[{"at", " ", "61", " ", "momenta", " ", "along", " ", 
      RowBox[{"x", "^", "3"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"w", " ", "=", " ", "0.9"}], ",", " ", 
        RowBox[{"gv", " ", "=", " ", "0.83"}], ",", " ", "wl", ",", " ", "gw",
         ",", " ", 
        RowBox[{"m", " ", "=", " ", 
         RowBox[{"N", "[", "mLL", "]"}]}], ",", " ", 
        RowBox[{"d", " ", "=", " ", "0."}]}], "}"}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{"wl", " ", "=", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"w", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "w", ",", " ", "0"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "0", ",", " ", "w"}], "}"}]}], "}"}]}], ";",
        "\n", "  ", 
       RowBox[{"gw", " ", "=", " ", 
        RowBox[{"gv", " ", "w"}]}], ";", "\n", "  ", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"ev", " ", "=", " ", 
              RowBox[{"Sort", "[", 
               RowBox[{"Re", "[", 
                RowBox[{"Eigenvalues", "[", 
                 RowBox[{"N", "[", 
                  RowBox[{"hPW", "[", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"0", ",", " ", "0", ",", " ", "q"}], "}"}], ",", 
                    " ", "m", ",", " ", "gv", ",", " ", "0", ",", " ", "wl", ",",
                     " ", 
                    RowBox[{"{", 
                    RowBox[{
                    "0", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], 
                    "}"}]}], "]"}], "]"}], "]"}], "]"}], "]"}]}], ",", " ", 
             "w2", ",", " ", "want"}], "}"}], ",", "\n", "     ", 
           RowBox[{
            RowBox[{"w2", " ", "=", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"m", "^", "2"}], " ", "+", " ", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"q", " ", "+", " ", 
