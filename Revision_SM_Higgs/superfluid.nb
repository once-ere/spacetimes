Cell[CellGroupData[{

Cell["R.4.2 The Josephson relation (check WD-2)", "Subsection",ExpressionUUID->"651a3d19-c60e-4186-8c76-481e88ae1f1b"],

Cell[TextData[{
 "A chemical potential ",
 Cell[BoxData[
  FormBox["\[Mu]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "841d5943-d039-42c4-93df-6083a193523b"],
 " of the particle number adds ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "\[Mu]"}], 
    SubsuperscriptBox[
     StyleBox["F", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["tot",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8cf75061-b6d9-420d-8942-1202c610e854"],
 " to the Hamiltonian; on the space of particles and holes (the Nambu space) \
the number acts as ",
 Cell[BoxData[
  FormBox[
   StyleBox["1",
    FontFamily->"Helvetica",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8728481c-ee85-452d-b432-b175ea25d00c"],
 " on the particle block and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    StyleBox["1",
     FontFamily->"Helvetica",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d84b7151-08fe-42bd-beab-10722d041292"],
 " on the hole block. If ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["\[ScriptCapitalR]",
     FontSlant->"Plain"], "0"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "326a8859-c35d-49ea-a677-bdcb57b6e867"],
 " is stationary, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"[", 
     RowBox[{
      SubscriptBox[
       StyleBox["H",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], "0"], ",", 
      SubscriptBox[
       StyleBox["\[ScriptCapitalR]",
        FontSlant->"Plain"], "0"]}], "]"}], "\[LongEqual]", "0"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "521de6df-9d0a-4a3a-809d-55b840db4323"],
 ", then ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      StyleBox["i", "TI"], "\[Mu]", 
      StyleBox["Ft", "TI"]}]], 
    SubscriptBox[
     StyleBox["\[ScriptCapitalR]",
      FontSlant->"Plain"], "0"], 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      RowBox[{"-", 
       StyleBox["i", "TI"]}], "\[Mu]", 
      StyleBox["Ft", "TI"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3fead3c7-6025-41de-a1eb-4ecb2820e4b2"],
 " solves the equation with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["H",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "-", "\[Mu]", 
    StyleBox["F", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "59dc3f5b-2215-45c0-b0a1-d7e12b4bdaaf"],
 ", and its pair block, which connects particles with holes, carries the \
factor ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"2", 
     StyleBox["i", "TI"], "\[Mu]", 
     StyleBox["t", "TI"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e177b74a-6662-4c3d-9601-395966aa6f70"],
 " because each pair carries the particle number 2. The phase of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["t", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c54bb65f-bf25-4341-a414-c481c87fa525"],
 " therefore turns at the rate ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Mu]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "77d0ed7f-a3cb-4c93-a9a3-814b668bfb57"],
 " while its modulus stays ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["d", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"], "0"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5fa64143-f0d6-4119-9c90-be9853f2fe2f"],
 ": the relation of Josephson between the chemical potential and the \
frequency of the phase of a condensate of pairs. The cell proves it \
symbolically on one Nambu block and fits a straight line, in exact arithmetic \
on the numbers of the data cell, to the unwrapped phase of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["t", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cf17f78b-30fb-48b9-93df-8fbac8d4fc22"],
 " of the two Josephson runs of the Rust program (HS (0, 0) and CJT)."
}], "Text",ExpressionUUID->"1a4f17a7-8aa9-4420-8e5e-9d23733c54ff"],

Cell[CellGroupData[{

