       RowBox[{"{", 
        RowBox[{"\"\<pa\>\"", ",", " ", "\"\<chi'\>\"", ",", 
         " ", "\"\<chi'\>\""}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"csectors", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<pair\>\"", ",", " ", "\"\<Psi\>\"", ",", 
         " ", "\"\<(chi, chi')\>\""}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<pair\>\"", ",", " ", "\"\<(chi, chi')\>\"", ",", 
         " ", "\"\<(chi, chi')\>\""}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<pa\>\"", ",", " ", "\"\<Psi\>\"", ",", 
         " ", "\"\<(chi, chi')\>\""}], "}"}], ",", "\n", "  ", 
       RowBox[{"{", 
        RowBox[{"\"\<pa\>\"", ",", " ", "\"\<(chi, chi')\>\"", ",", 
         " ", "\"\<(chi, chi')\>\""}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"secName", "[", 
      RowBox[{"{", 
       RowBox[{"k_", ",", " ", "a_", ",", " ", "b_"}], "}"}], "]"}], " ", ":=",
      " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"k", " ", "==", " ", "\"\<pair\>\""}], ",", " ", 
       RowBox[{"a", " ", "<>", " ", "\"\< \>\"", " ", "<>", " ", "b"}], ",", 
       " ", 
       RowBox[{"a", " ", "<>", " ", "\"\<^dag \>\"", " ", "<>", " ", "b"}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"samePair", "[", 
      RowBox[{"{", 
       RowBox[{"k_", ",", " ", "a_", ",", " ", "b_"}], "}"}], "]"}], " ", ":=",
      " ", 
     RowBox[{
      RowBox[{"k", " ", "==", " ", "\"\<pair\>\""}], " ", "&&", " ", 
      RowBox[{"a", " ", "==", " ", "b"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"invOps", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"kind_", ",", " ", "f1_", ",", " ", "f2_"}], "}"}], ",", " ", 
       "antisym_", ",", " ", "sym_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "ops", "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"ops", " ", "=", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"vecOp", "[", 
            RowBox[{"kind", ",", " ", 
             RowBox[{"diracOn", "[", 
              RowBox[{"f1", ",", " ", 
               RowBox[{"sGen", "[", "#", "]"}]}], "]"}], ",", " ", 
             RowBox[{"diracOn", "[", 
              RowBox[{"f2", ",", " ", 
               RowBox[{"sGen", "[", "#", "]"}]}], "]"}]}], "]"}], " ", "&"}], 
          " ", "/@", " ", "lb"}]}], ";", "\n", "  ", 
        RowBox[{"If", "[", 
         RowBox[{"antisym", ",", " ", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"ops", ",", " ", 
            RowBox[{
             RowBox[{"IdentityMatrix", "[", 
              RowBox[{
               RowBox[{"fieldN", "[", "f1", "]"}], "^", "2"}], "]"}], " ", "+",
              " ", 
             RowBox[{"transpOp", "[", 
              RowBox[{"fieldN", "[", "f1", "]"}], "]"}]}]}], "]"}]}], "]"}], ";",
         "\n", "  ", 
        RowBox[{"If", "[", 
         RowBox[{"sym", ",", " ", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"ops", ",", " ", 
            RowBox[{
             RowBox[{"IdentityMatrix", "[", 
              RowBox[{
               RowBox[{"fieldN", "[", "f1", "]"}], "^", "2"}], "]"}], " ", "-",
              " ", 
             RowBox[{"transpOp", "[", 
              RowBox[{"fieldN", "[", "f1", "]"}], "]"}]}]}], "]"}]}], "]"}], ";",
         "\n", "  ", 
        RowBox[{"Join", " ", "@@", " ", "ops"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"L_X", " ", "on", " ", "vec", 
     RowBox[{"(", "M", ")"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"chargeOp", "[", 
      RowBox[{
       RowBox[{"{", 
