  FontSize->1.1 Inherited,ExpressionUUID->
  "23af3f52-78de-482c-8074-fc84ebc4e2ce"],
 "."
}], "Text",ExpressionUUID->"e4509dcd-27dd-4cc9-82a0-b773026a616e"],

