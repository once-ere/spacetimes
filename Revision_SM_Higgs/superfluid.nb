Cell[CellGroupData[{

Cell["III.T.3 The limit of zero temperature", "Section",ExpressionUUID->"3a300c7e-9983-4f8a-ae46-75a16ce3f258"],

Cell[TextData[{
 "The next cell takes the ground states of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "2", ")"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f49e594d-37f3-4771-9447-65dd520bce56"],
 " of Part II (",
 StyleBox["groundSF",
  FontFamily->"Source Code Pro"],
 "), makes them self-consistent to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "13"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dc8bba92-1527-4512-b9f4-e0ebae610e9d"],
 ", and computes the thermal states at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0.005"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "734fc2f0-1ae5-4a47-8b7d-6462b0673fe4"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      RowBox[{"-", 
       SubsuperscriptBox[
        StyleBox["E", "TI"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["X", "TI"], ",", 
         StyleBox["gap",
          FontSlant->"Plain"]}]]}], "/", 
      StyleBox["T", "TI"]}]], "<", 
    SuperscriptBox["10", 
     RowBox[{"-", "25"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "98172029-7210-43b5-8fb6-1d6d1ca0fc2e"],
 ": the order parameter and the free energy measured from the normal state at \
the same temperature must be those of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3a0f343f-e600-470f-bb19-7be3e36cb1bd"],
 "."
}], "Text",ExpressionUUID->"84819ac4-25e4-4fbd-92fa-0f144f031029"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"thModel", "[", "t", "]"}], ",", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"thGround", "[", "t", "]"}], ":", " ", 
      RowBox[{"the", " ", "model", " ", "of", " ", 
       RowBox[{"V", "^", 
        RowBox[{"(", "2", ")"}]}], " ", "and", " ", "the", " ", "ground", " ",
        "state", " ", "at", " ", "T"}]}], " ", "=", " ", 
     RowBox[{"0", " ", "of", " ", "the", " ", "method", " ", "t", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"from", " ", "Part", " ", "II"}], ",", " ", 
        RowBox[{
         RowBox[{"iterated", " ", "to", " ", "1", "e"}], "-", "13"}]}], 
       ")"}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"thTags", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<HS_1_1\>\"", ",", " ", "\"\<HS_0_1\>\"", ",", 
       " ", "\"\<HS_0_0\>\"", ",", " ", "\"\<KS\>\"", ",", 
       " ", "\"\<CJT\>\""}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"thName", " ", "=", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<HS_1_1\>\"", " ", "->", " ", "\"\<HS (1, 1)\>\""}], ",", 
       " ", 
       RowBox[{"\"\<HS_0_1\>\"", " ", "->", " ", "\"\<HS (0, 1)\>\""}], ",", 
       " ", 
       RowBox[{"\"\<HS_0_0\>\"", " ", "->", " ", "\"\<HS (0, 0)\>\""}], ",", 
       " ", 
       RowBox[{"\"\<KS\>\"", " ", "->", " ", "\"\<KS\>\""}], ",", " ", 
       RowBox[{"\"\<CJT\>\"", " ", "->", " ", "\"\<CJT\>\""}]}], "|>"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"thModel", "[", "t_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"groundSF", "[", 
       RowBox[{"\"\<V2_\>\"", " ", "<>", " ", "t"}], "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"thGround", "[", "t_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"thGround", "[", "t", "]"}], " ", "=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"s", " ", "=", " ", 
          RowBox[{
           RowBox[{"groundSF", "[", 
            RowBox[{"\"\<V2_\>\"", " ", "<>", " ", "t"}], "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", " ", 
        RowBox[{"solveSF", "[", 
         RowBox[{
          RowBox[{"thModel", "[", "t", "]"}], ",", " ", 
          RowBox[{"s", "[", "\"\<n\>\"", "]"}], ",", " ", 
          RowBox[{"s", "[", "\"\<p\>\"", "]"}], ",", " ", "0.6", ",", " ", 
          RowBox[{"10", "^", 
           RowBox[{"-", "13"}]}]}], "]"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"mo", " ", "=", " ", 
           RowBox[{"thModel", "[", "t", "]"}]}], ",", " ", 
          RowBox[{"g0", " ", "=", " ", 
           RowBox[{"thGround", "[", "t", "]"}]}], ",", " ", "low", ",", " ", 
          "nlow"}], "}"}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{"low", " ", "=", " ", 
          RowBox[{"solveSFT", "[", 
           RowBox[{"mo", ",", " ", 
            RowBox[{"g0", "[", "\"\<n\>\"", "]"}], ",", " ", 
            RowBox[{"g0", "[", "\"\<p\>\"", "]"}], ",", " ", "0.005", ",", 
            " ", "0.6", ",", " ", 
            RowBox[{"10", "^", 
             RowBox[{"-", "13"}]}]}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"nlow", " ", "=", " ", 
          RowBox[{"solveSFT", "[", 
           RowBox[{
           "mo", ",", " ", "zero8", ",", " ", "zero8", ",", " ", "0.005", ",",
             " ", "0.6", ",", " ", 
            RowBox[{"10", "^", 
             RowBox[{"-", "13"}]}]}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{"\"\<WP3-T1 \>\"", " ", "<>", " ", "t"}], ",", " ", 
           RowBox[{
            RowBox[{"thName", "[", "t", "]"}], " ", "<>", 
            " ", "\"\<: the thermal states at T = 0.005 reproduce the ground \
state of T = 0 (|change of Phi0| + relative change of the energy)\>\""}], ",",
            "\n", "    ", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"phiOf", "[", "low", "]"}], " ", "-", " ", 
              RowBox[{"phiOf", "[", "g0", "]"}]}], "]"}], " ", "+", " ", 
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"low", "[", "\"\<free\>\"", "]"}], " ", "-", " ", 
                 RowBox[{"nlow", "[", "\"\<free\>\"", "]"}]}], ")"}], " ", "-",
                " ", 
               RowBox[{"g0", "[", "\"\<e\>\"", "]"}]}], "]"}], "/", 
             RowBox[{"Abs", "[", 
              RowBox[{"g0", "[", "\"\<e\>\"", "]"}], "]"}]}]}], ",", " ", 
           RowBox[{"10", "^", 
            RowBox[{"-", "11"}]}], ",", " ", 
           RowBox[{"\"\<P3-T1 \>\"", " ", "<>", " ", "t"}], ",", " ", 
           RowBox[{"\"\<YP3-T1 \>\"", " ", "<>", " ", "t"}]}], "]"}]}]}], 
       "]"}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"t", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<HS_1_1\>\"", ",", " ", "\"\<CJT\>\""}], "}"}]}], 
       "}"}]}], "]"}], ";"}]}]}]], "Input",
 CellLabel->
  "In[330]:=",ExpressionUUID->"3bc0ff45-03b6-4dfd-bae3-120ab3f48db3"],

