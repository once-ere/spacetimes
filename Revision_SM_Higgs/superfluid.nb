   "\[InvisibleSpace]", "\<\"the Thouless eigenvalues of the exchange per \
unit coupling squared: zeugon W^3 0.03573178317, B -0.1429271327 = Rust\"\>", 
   "\[InvisibleSpace]", "\<\"   [the same check: Rust \"\>", 
   "\[InvisibleSpace]", "\<\"P2-8c, P2-8d\"\>", 
   "\[InvisibleSpace]", "\<\", Python \"\>", 
   "\[InvisibleSpace]", "\<\"YP2-8c\"\>", "\[InvisibleSpace]", "\<\"]\"\>"}],
  SequenceForm[
  "PASS ", "WP2-8c", "  deviation ", "5.919e-12", " (tolerance ", "1.000e-9", 
   "): ", "the Thouless eigenvalues of the exchange per unit coupling \
squared: zeugon W^3 0.03573178317, B -0.1429271327 = Rust", 
   "   [the same check: Rust ", "P2-8c, P2-8d", ", Python ", "YP2-8c", "]"],
  Editable->False]], "Print",
 CellChangeTimes->{4.0043314615064297`*^9},
 CellLabel->
  "During evaluation of \
In[267]:=",ExpressionUUID->"308a568e-1fbe-479e-a2b1-361a9c03bc4f"]
}, Open  ]],

Cell[TextData[{
 "The zeugon attracts the condensed pair (positive eigenvalue) and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "499e4a83-b751-4f89-b7e5-e2ac1bd91703"],
 " repels it four times as strongly. ",
 StyleBox["CJT with the exchange.",
  FontWeight->"Bold"],
 " The last cell of Part II makes the CJT state of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "2", ")"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "39f62218-155e-48e1-bfca-156cd925e805"],
 " self-consistent with the exchange of all four gauge bosons added to the \
contact terms: the self-energies now depend on the momentum, and the matrix \
of Bogoliubov and de Gennes at the momentum ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["q", "TI"], "\[RightVector]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0a45999e-9473-4400-bc35-8689849d5137"],
 " contains the exchange self-energies at ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["q", "TI"], "\[RightVector]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "16429d1d-9dc5-4a52-b073-5fd1d68d273e"],
 " (and at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    OverscriptBox[
     StyleBox["q", "TI"], "\[RightVector]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "676f0c85-1839-489f-873e-1b9e85f60207"],
 " in its lower block). The boson masses are those of the Rust program, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["M", "TI"], 
    StyleBox["W", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f66755f2-c32f-48b5-8593-1bb082588c33"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["M", "TI"], 
    StyleBox["Z", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e3acddb4-b3bb-4939-a220-fa463dd87301"],
 " of this state and a massless zeugon; the iteration mixes one half of the \
new self-energies until they change by less than ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "11"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b5916bfc-1470-4d01-90c6-16196cf84ac1"],
 ". The superfluid survives, and the energy agrees with the Rust value."
}], "Text",ExpressionUUID->"f1593d86-39da-4b00-9d16-5b83db960ace"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
     "CJT", " ", "with", " ", "the", " ", "exchange", " ", "of", " ", "the", " ",
       "four", " ", "gauge", " ", "bosons", " ", "at", " ", "g_v"}], " ", "=",
      " ", "0.7"}], ",", " ", 
    RowBox[{"g_F", " ", "=", " ", "0.45"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "mo", ",", " ", "s", ",", " ", "bos", ",", " ", "nc", ",", " ", "pc", ",",
        " ", "nex", ",", " ", "pex", ",", " ", 
       RowBox[{"it", " ", "=", " ", "0"}], ",", " ", 
       RowBox[{"res", " ", "=", " ", "1."}], ",", " ", "cn", ",", " ", "cp", ",",
        " ", "ev", ",", " ", "rho", ",", " ", "kap", ",", " ", "ek", ",", " ",
        "ei", ",", " ", "n2", ",", " ", "p2", ",", " ", "n3", ",", " ", "p3", 
       ",", " ", "eex", ",", " ", "masses"}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"mo", ",", " ", "s"}], "}"}], " ", "=", " ", 
       RowBox[{"groundSF", "[", "\"\<V2_CJT\>\"", "]"}]}], ";", "\n", "  ", 
      RowBox[{"masses", " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"rustPart2", "[", "\"\<p2_cjtex_M_W\>\"", "]"}], ",", " ", 
         RowBox[{"rustPart2", "[", "\"\<p2_cjtex_M_W\>\"", "]"}], ",", " ", 
         "0.", ",", " ", 
         RowBox[{"rustPart2", "[", "\"\<p2_cjtex_M_Z\>\"", "]"}]}], "}"}]}], ";",
       "\n", "  ", 
      RowBox[{"bos", " ", "=", " ", 
       RowBox[{"makeBosons", "[", 
        RowBox[{
         RowBox[{"mo", "[", "\"\<g\>\"", "]"}], ",", " ", "gvLL", ",", " ", 
         "gfLL", ",", " ", "masses"}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"nc", " ", "=", " ", 
       RowBox[{"s", "[", "\"\<n\>\"", "]"}]}], ";", " ", 
      RowBox[{"pc", " ", "=", " ", 
       RowBox[{"s", "[", "\"\<p\>\"", "]"}]}], ";", "\n", "  ", 
      RowBox[{"nex", " ", "=", " ", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"zero8", ",", " ", 
         RowBox[{
          RowBox[{"mo", "[", "\"\<g\>\"", "]"}], "[", "\"\<n\>\"", "]"}]}], 
        "]"}]}], ";", " ", 
      RowBox[{"pex", " ", "=", " ", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"zero8", ",", " ", 
         RowBox[{
          RowBox[{"mo", "[", "\"\<g\>\"", "]"}], "[", "\"\<n\>\"", "]"}]}], 
        "]"}]}], ";", "\n", "  ", 
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"res", " ", ">=", " ", 
          RowBox[{"10", "^", 
           RowBox[{"-", "11"}]}]}], " ", "&&", " ", 
         RowBox[{"it", " ", "<", " ", "20000"}]}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"cn", ",", " ", "cp", ",", " ", "ev"}], "}"}], " ", "=", 
          " ", 
          RowBox[{"states", "[", 
           RowBox[{"bdg", "[", 
            RowBox[{
            "mo", ",", " ", "nc", ",", " ", "pc", ",", " ", "nex", ",", " ", 
             "pex"}], "]"}], "]"}]}], ";", "\n", "   ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"rho", ",", " ", "kap", ",", " ", "ek"}], "}"}], " ", "=", 
          " ", 
          RowBox[{"localDens", "[", 
           RowBox[{"mo", ",", " ", "cn", ",", " ", "cp"}], "]"}]}], ";", "\n",
          "   ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ei", ",", " ", "n2", ",", " ", "p2"}], "}"}], " ", "=", 
          " ", 
          RowBox[{"interaction", "[", 
           RowBox[{
            RowBox[{"mo", "[", "\"\<ts\>\"", "]"}], ",", " ", "rho", ",", " ",
             "kap"}], "]"}]}], ";", "\n", "   ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"n3", ",", " ", "p3", ",", " ", "eex"}], "}"}], " ", "=", 
          " ", 
          RowBox[{"exchangeSF", "[", 
           RowBox[{
            RowBox[{"mo", "[", "\"\<g\>\"", "]"}], ",", " ", "bos", ",", " ", 
            
            RowBox[{"cn", " ", "-", " ", 
             RowBox[{"mo", "[", "\"\<vac\>\"", "]"}]}], ",", " ", "cp"}], 
           "]"}]}], ";", "\n", "   ", 
         RowBox[{"res", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"n2", " ", "-", " ", "nc"}], "]"}], ",", " ", 
            RowBox[{"Abs", "[", 
             RowBox[{"p2", " ", "-", " ", "pc"}], "]"}], ",", " ", 
            RowBox[{"Abs", "[", 
             RowBox[{"n3", " ", "-", " ", "nex"}], "]"}], ",", " ", 
            RowBox[{"Abs", "[", 
             RowBox[{"p3", " ", "-", " ", "pex"}], "]"}]}], "]"}]}], ";", 
         "\n", "   ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"res", " ", ">=", " ", 
            RowBox[{"10", "^", 
             RowBox[{"-", "11"}]}]}], ",", "\n", "    ", 
           RowBox[{
            RowBox[{"nc", " ", "=", " ", 
             RowBox[{
              RowBox[{"0.5", " ", "n2"}], " ", "+", " ", 
              RowBox[{"0.5", " ", "nc"}]}]}], ";", " ", 
            RowBox[{"pc", " ", "=", " ", 
             RowBox[{
              RowBox[{"0.5", " ", "p2"}], " ", "+", " ", 
              RowBox[{"0.5", " ", "pc"}]}]}], ";", "\n", "    ", 
            RowBox[{"nex", " ", "=", " ", 
             RowBox[{
              RowBox[{"0.5", " ", "n3"}], " ", "+", " ", 
              RowBox[{"0.5", " ", "nex"}]}]}], ";", " ", 
            RowBox[{"pex", " ", "=", " ", 
             RowBox[{
              RowBox[{"0.5", " ", "p3"}], " ", "+", " ", 
              RowBox[{"0.5", " ", "pex"}]}]}], ";", "\n", "    ", 
            RowBox[{"it", "++"}]}]}], "]"}]}]}], "]"}], ";", "\n", "  ", 
      RowBox[{"cjtExchange", " ", "=", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<energy\>\"", " ", "->", " ", 
          RowBox[{"ek", " ", "+", " ", "ei", " ", "+", " ", "eex"}]}], ",", 
         " ", 
         RowBox[{"\"\<exchange\>\"", " ", "->", " ", "eex"}], ",", " ", 
         RowBox[{"\"\<iterations\>\"", " ", "->", " ", "it"}]}], "|>"}]}], ";",
       "\n", "  ", 
      RowBox[{"check", "[", 
       RowBox[{"\"\<WP2-8d\>\"", ",", " ", 
        RowBox[{"\"\<CJT with the exchange at g_v = 0.7, g_F = 0.45: energy \
\>\"", " ", "<>", " ", 
         RowBox[{"sci", "[", 
          RowBox[{"ek", " ", "+", " ", "ei", " ", "+", " ", "eex"}], "]"}], 
         " ", "<>", " ", "\"\< = Rust (relative; \>\"", " ", "<>", " ", 
         RowBox[{"ToString", "[", "it", "]"}], " ", "<>", 
         " ", "\"\< iterations; exchange energy \>\"", " ", "<>", " ", 
         RowBox[{"sci", "[", "eex", "]"}], " ", "<>", " ", "\"\<)\>\""}], ",",
         "\n", "   ", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"ek", " ", "+", " ", "ei", " ", "+", " ", "eex"}], ")"}], 
           " ", "-", " ", 
           RowBox[{"rustPart2", "[", "\"\<p2_cjtex_energy\>\"", "]"}]}], 
          "]"}], "/", 
         RowBox[{"Abs", "[", 
          RowBox[{"rustPart2", "[", "\"\<p2_cjtex_energy\>\"", "]"}], "]"}]}],
         ",", " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "7"}]}], ",", " ", "\"\<P2-8f\>\"", ",", 
        " ", "\"\<YP2-8d\>\""}], "]"}]}]}], "]"}], ";"}]}]], "Input",
 CellLabel->
  "In[269]:=",ExpressionUUID->"c5cf76cb-d2fb-458a-83c7-07da55e69c0a"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"PASS \"\>", "\[InvisibleSpace]", "\<\"WP2-8d\"\>", 
   "\[InvisibleSpace]", "\<\"  deviation \"\>", 
   "\[InvisibleSpace]", "\<\"1.492e-8\"\>", 
   "\[InvisibleSpace]", "\<\" (tolerance \"\>", 
   "\[InvisibleSpace]", "\<\"1.000e-7\"\>", 
   "\[InvisibleSpace]", "\<\"): \"\>", 
   "\[InvisibleSpace]", "\<\"CJT with the exchange at g_v = 0.7, g_F = 0.45: \
energy -1.324e-4 = Rust (relative; 294 iterations; exchange energy \
9.647e-5)\"\>", "\[InvisibleSpace]", "\<\"   [the same check: Rust \"\>", 
   "\[InvisibleSpace]", "\<\"P2-8f\"\>", 
   "\[InvisibleSpace]", "\<\", Python \"\>", 
   "\[InvisibleSpace]", "\<\"YP2-8d\"\>", "\[InvisibleSpace]", "\<\"]\"\>"}],
  SequenceForm[
  "PASS ", "WP2-8d", "  deviation ", "1.492e-8", " (tolerance ", "1.000e-7", 
   "): ", "CJT with the exchange at g_v = 0.7, g_F = 0.45: energy -1.324e-4 = \
Rust (relative; 294 iterations; exchange energy 9.647e-5)", 
   "   [the same check: Rust ", "P2-8f", ", Python ", "YP2-8d", "]"],
  Editable->False]], "Print",
 CellChangeTimes->{4.004331485556588*^9},
 CellLabel->
  "During evaluation of \
In[269]:=",ExpressionUUID->"6b24b93e-05ed-4c86-90fd-f3fc80ee98f6"]
}, Open  ]],

Cell[TextData[{
 StyleBox["A remark on the zeugon (what it means and why it matters).",
  FontWeight->"Bold"],
 " After the breaking exactly one gauge boson stays massless, ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "83c3a202-ff29-4dab-8e95-a05b6e4a5548"],
 " for the condensate in the channel ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e1ea53e5-b2f0-4735-a152-a60635f8b6e0"],
 " (in general ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     StyleBox["n", "TI"], "\[RightVector]"], "\[CenterDot]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["W", "TI"], "\[RightVector]"], 
     StyleBox["SF",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5f43ddc5-d6db-4553-b655-af39684fb335"],
 " for a vacuum along ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["n", "TI"], "\[RightVector]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c0f80dc4-465e-4e22-b60a-ae3b22ba73d3"],
 "), the gauge boson of the unbroken charge ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["Q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "3"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "10d3fdc7-07b4-4118-a8a1-f7e318cecad8"],
 " of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["v",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3b85ae06-25fd-41cd-ba1e-ee82026dbc5d"],
 ". It is not the photon: only the DiracLike spinor (charges ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    FractionBox["1", "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cd129b35-d555-488e-af99-32b034d2cbaf"],
 "), the bosons ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["W", "TI"], "\[PlusMinus]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a4bbba15-1bc9-4c27-ab83-8d25c494e729"],
 " and the two non-unitary scalars (charges ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "64cc18e8-055c-4d02-9ef8-de285ad7dfa6"],
 ") carry ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["Q", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "976066fe-3ef4-4eb1-969c-0c792ae3b73c"],
 ", and nothing in the model carries electric charge. The author, who asked \
for a new massless gauge boson that appears after the breaking and is not the \
photon, offered the solution its naming; the name is the zeugon (from the \
Greek zeugos, a yoked pair), because it is the only gauge boson that attracts \
the two charges of the condensed pair, as the cells above show. Two \
qualifications: its attraction alone would pair the normal vacuum only for ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["v",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5b589997-9096-405d-a1f0-7fe6dccae88f"],
 " above about 5.3, almost eight times the coupling of the project, so at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]], "\[LongEqual]", "0.7"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d7d73f26-c429-4326-94a0-9ece57b30460"],
 " it does not by itself hold the condensate, which the pairing term of the \
potential produces; and it is a prediction of the model, not an observation. \
Why it matters: the group that survives the breaking is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["O", "TI"], 
    RowBox[{"(", "2", ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "49028411-e424-47ac-a144-d8aaf536d6d7"],
 ", not ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["U", "TI"], 
    RowBox[{"(", "1", ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ebcb6e89-bb2a-4141-810a-8b95519a46ce"],
 "; its second component, a rotation by ",
 Cell[BoxData[
  FormBox["\[Pi]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0ee47504-35be-454f-ba27-0992a7eb3b75"],
 " of the isospin combined with the phase ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Pi]", "/", "2"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7001d3e2-ffe6-4a34-a389-e1f4944abe04"],
 " of the fermion number, is a gauge transformation that reverses the zeugon \
and exchanges ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["W", "TI"], "+"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f69fa48c-cc19-4001-b109-ea4e21418f5b"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["W", "TI"], "-"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "04f9c4d2-e0ad-4197-93d0-85a08f527c35"],
 ", so the charge conjugation of the zeugon is a local symmetry, which it \
never is for the photon. A ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["U", "TI"], 
    RowBox[{"(", "1", ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4ec57a95-c415-493e-845c-f533669c9883"],
 " gauge theory with a local charge conjugation is Alice electrodynamics (J. \
Kiskis 1978; A. S. Schwarz 1982; M. Bucher, H.-K. Lo and J. Preskill 1992): \
the vacua ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPhi]", "0"], 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      StyleBox["i", "TI"], "\[CurlyTheta]"}]], 
    OverscriptBox[
     StyleBox["n", "TI"], "\[RightVector]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d50b366c-050b-4262-bc9b-8c15b21ddd1c"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPhi]", "0"], 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      StyleBox["i", "TI"], 
      RowBox[{"(", 
       RowBox[{"\[CurlyTheta]", "+", "\[Pi]"}], ")"}]}]], 
    RowBox[{"(", 
     RowBox[{"-", 
      OverscriptBox[
       StyleBox["n", "TI"], "\[RightVector]"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e7a4fe18-479e-48ea-bbd6-8814baf34b77"],
 " are the same field, so a half-quantum vortex of the superfluid, along \
which ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["n", "TI"], "\[RightVector]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "be4d60de-a230-4616-8ed1-50819ee01cc2"],
 " turns into ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    OverscriptBox[
     StyleBox["n", "TI"], "\[RightVector]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "84efeccd-4e48-4da1-b67f-c47250b12ac6"],
 " while the phase advances by ",
 Cell[BoxData[
  FormBox["\[Pi]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "694b41d7-f1a4-41be-843a-b1080412204d"],
 ", is an Alice string, which reverses the charge ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["Q", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "795759b8-38e3-4c0a-a42a-2b893bf4e984"],
 " of every particle carried around it (U. Leonhardt and G. E. Volovik \
described its counterpart in a condensate of spin 1 in 2000). These strings, \
and the magnetic monopoles of the zeugon that the sphere of directions ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["n", "TI"], "\[RightVector]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "13d1ca2e-d88a-40fb-ae25-3869bb60943d"],
 " allows, follow from the topology of the vacuum and are not computed in \
this notebook."
}], "Text",ExpressionUUID->"32959a82-5e6f-4f6e-8346-80503e79ea29"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Part III, first section. The Landau form of the effective potentials: what it \
is, how accurate it is, and why that matters\
\>", "Chapter",ExpressionUUID->"54c3880e-acac-4f48-9176-3e2ff24f1f03"],

Cell[TextData[{
 "Part III of the solution builds the effective Lagrangians ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["\[ScriptCapitalL]",
     FontSlant->"Plain"], 
    StyleBox["CJT",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a9d06b78-58da-4525-acb7-6183388e2d31"],
 ", ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["\[ScriptCapitalL]",
     FontSlant->"Plain"], 
    StyleBox["HS",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "624426da-77d6-41c9-bf92-6115131aca69"],
 ", ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["\[ScriptCapitalL]",
     FontSlant->"Plain"], 
    StyleBox["KS",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "de6dd841-136d-498d-87ef-f12b809c7469"],
 " of the field of the superfluid boson singlet state. Their potential parts \
were summarized by a polynomial, the Landau form, with the remark: \"The \
Landau form is a fit; its largest residual is 0.27-0.7 % of the depth\". The \
author asked (21 November 2026) to explain this remark clearly and completely \
and why it is important, to define the Landau form with examples, and to keep \
the answer in the documents and in this notebook. This chapter is that \
answer. It is the first section of Part III in the notebook; the next chapter \
(Section III.T) is the second, and the other sections of Part III follow in \
the next versions. The computed curves are taken from the Rust program ",
 StyleBox["sf_part3",
  FontFamily->"Source Code Pro"],
 " (the closed cell of Section III.L.3, with the SHA-256 checksums of its \
data files), and this chapter recomputes from them, by its own least squares, \
every number of the answer; the engine of Part II, which computes such \
states, is used by the next chapter."
}], "Text",ExpressionUUID->"83f91f09-1937-42fc-b6a9-011c5c34b430"],

Cell[CellGroupData[{

Cell["III.L.1 The objects", "Section",ExpressionUUID->"5dc2277c-e10d-4fc9-b3e0-98d83e7afe0e"],

Cell[TextData[{
 StyleBox["The field and its effective potential.",
  FontWeight->"Bold"],
 " The field of the superfluid boson singlet state is the complex isospin \
vector ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["\[CapitalPhi]", 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", "1"}]], ",", 
      SubsuperscriptBox["\[CapitalPhi]", 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", "2"}]], ",", 
      SubsuperscriptBox["\[CapitalPhi]", 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", "3"}]]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f655a07f-9b6e-492b-b45e-baa18d63a9d5"],
 " of the amplitudes of the pair self-energy of a uniform state, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["P",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"]], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", "\[Iota]",
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox["\[CapitalPhi]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", "\[Iota]"}]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "\[Iota]"], ")"}], "\[Dagger]"]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "19860af3-f436-4d3e-ba84-acde1167d0a3"],
 ", where ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e2d43ec9-a23c-4620-b884-74d5430ecd83"],
 " are the three pair matrices of Part I (",
 StyleBox["kLL[iota]",
  FontFamily->"Source Code Pro"],
 " in the code) and ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "11f284a6-df36-4c93-86d3-9d653ee8eb5b"],
 " is one of the five computed methods: HS ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"1", ",", "1"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7646341e-4499-4921-8675-47dcb6b38bb2"],
 ", HS ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "1"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "402ffc4e-325b-430b-8e87-1c8f117f7359"],
 ", HS ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "0"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9f70f574-6696-401d-aa70-998933fbcc68"],
 " (the method of Hubbard and Stratonovich with the shares ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["s", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["HS",
      FontSlant->"Plain"], ",", 
     StyleBox["S",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dd21a095-356b-4eb7-a5e6-2da628a50c5c"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["s", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["HS",
      FontSlant->"Plain"], ",", 
     StyleBox["V",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "30fd88a6-c479-4869-9d6e-02d3b633668f"],
 " of the scalar and the vector term decoupled in the density channels), KS \
(Kohn and Sham) and CJT (Cornwall, Jackiw and Tomboulis). The effective \
potential ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalV]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], 
    RowBox[{"(", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], ")"}]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ccd291f4-4f52-46a9-a6bc-657738609a2f"],
 " is the smallest energy per volume of method ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a40a4a57-7f5f-4158-9717-dc9bc35faa4b"],
 " among the uniform states whose field is ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[CapitalPhi]", "\[RightVector]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c48ddfeb-01af-4eed-8754-2fdfdd281ddd"],
 ", measured from the normal vacuum, so that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalV]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], 
    RowBox[{"(", "0", ")"}], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3adbbd31-885b-4508-a5c1-ea6557751012"],
 "."
}], "Text",ExpressionUUID->"58e666ca-b5e1-4bcf-8e21-af261094751d"],

Cell[TextData[{
 StyleBox["How it is computed.",
  FontWeight->"Bold"],
 " A fixed pair self-energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6a91e0f3-8b4b-4c4f-a991-ba6a5eb33617"],
 ", the applied field of amplitude ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPhi]", 
    StyleBox["a",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a1f9b509-25fc-49b6-8303-62660504f27a"],
 ", is put into the matrix of Bogoliubov and de Gennes, the normal \
self-energy is made self-consistent, and the ground state gives one point: \
its own field ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "\[LongEqual]", 
    "\[CapitalPhi]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["e", "TI"], "\[RightVector]"], "3"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "92519a6a-033a-4a51-b98b-ad00ecce3d5b"],
 " and its energy per volume. The Rust program computes 61 points per method, \
with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPhi]", 
    StyleBox["a",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c9fbc61e-89a4-443a-943f-dcc34ab152e4"],
 " from ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fbfeef25-e2cb-4e90-ba30-0b3cd0f174f5"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    SubsuperscriptBox["\[CapitalPhi]", 
     RowBox[{"0", ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b2d506f9-775d-44fc-b9b0-f09c33b7bd1d"],
 ", each self-consistent to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "13"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c8751659-1bb8-40eb-97bb-f429ef8c6865"],
 ". Along the ",
 StyleBox["polar",
  FontWeight->"Bold"],
 " fields ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      StyleBox["i", "TI"], "\[CurlyTheta]"}]], "\[CapitalPhi]", 
    OverscriptBox[
     StyleBox["n", "TI"], "\[RightVector]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ea4439bf-81ce-43e2-a4e8-809b62c9b592"],
 " (real phase ",
 Cell[BoxData[
  FormBox["\[CurlyTheta]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a61e4d8f-3c15-40fc-8723-3aaebfd00946"],
 ", real unit vector ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["n", "TI"], "\[RightVector]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ede69e8c-818c-42e8-9497-d00a6ff7efdc"],
 ") the potential depends on ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPhi]", "\[LongEqual]", 
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e9ca146d-0c73-4d7c-97c3-8f0c88ff507e"],
 " alone. Its minimum lies at ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalPhi]", 
    RowBox[{"0", ",", 
     StyleBox["SF",
      FontSlant->"Plain"]}], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "34277305-0343-451b-bd0d-df819c9afe89"],
 " (the vacuum), and the ",
 StyleBox["depth",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftBracketingBar]", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["\[ScriptCapitalV]",
       FontSlant->"Plain"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      StyleBox["X", "TI"]], 
     RowBox[{"(", 
      SubsuperscriptBox["\[CapitalPhi]", 
       RowBox[{"0", ",", 
        StyleBox["SF",
         FontSlant->"Plain"]}], 
       StyleBox["X", "TI"]], ")"}]}], "\[RightBracketingBar]"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6c4b3488-3978-4be0-bcdc-792ce89c289e"],
 " is the energy per volume by which the superfluid lies below the normal \
vacuum. The second derivative ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalV]",
     FontSlant->"Plain"], 
    StyleBox["amp",
     FontSlant->"Plain"], "\[Prime]\[Prime]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dbfbf032-b129-4098-9d2d-b4ecb9213d32"],
 " of the polar curve at its minimum fixes the mass of the amplitude mode, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["H",
         FontSlant->"Plain"]}]], ")"}], "2"], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalV]",
      FontSlant->"Plain"], 
     StyleBox["amp",
      FontSlant->"Plain"], "\[Prime]\[Prime]"], "/", 
    RowBox[{"(", 
     RowBox[{"2", 
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox[
         StyleBox["Z", "TI"], 
         StyleBox["SF",
          FontSlant->"Plain"], 
         StyleBox["X", "TI"]], "+", 
        SubsuperscriptBox[
         StyleBox["Y", "TI"], 
         StyleBox["SF",
          FontSlant->"Plain"], 
         StyleBox["X", "TI"]]}], ")"}]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a75c7c9c-eb34-4857-997c-e6545743c28d"],
 ", where ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["Z", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a2f043fb-0c23-4a2e-a7be-9ceed348a69e"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["Y", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3fd7b92f-ba2b-42d2-8ceb-a1de1e2b2e46"],
 " are the two coefficients of the kinetic part of the effective Lagrangian."
}], "Text",ExpressionUUID->"6220e2d1-381e-4cc7-9d6e-8f744ce882aa"]
}, Open  ]],

Cell[CellGroupData[{

Cell["III.L.2 The Landau form: definition and examples", "Section",ExpressionUUID->"e9b802a9-4e40-459f-9a4c-2a20a52a4877"],

Cell[TextData[{
 StyleBox["Definition.",
  FontWeight->"Bold"],
 " A Landau form of a potential is its expansion in powers of the order \
parameter (the field that vanishes in the symmetric state and not in the \
broken one) under two rules: only polynomial invariants of the symmetry group \
occur, and the expansion stops after the lowest orders that bound the \
potential from below and produce its minima. L. D. Landau introduced it for \
phase transitions (1937): near a continuous transition the order parameter is \
small, the free energy is assumed to be analytic in it, and the form is its \
Taylor expansion, whose coefficients (the Landau coefficients) are \
derivatives at the symmetric state. The quadratic coefficient changes its \
sign at the transition; the signs of the higher coefficients decide the order \
of the transition and which broken state is the minimum. Examples:"
}], "Text",ExpressionUUID->"ca5a8631-1192-4b02-be56-87195e0b2d87"],

Cell[TextData[{
 "A uniaxial ferromagnet: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["F", "TI"], 
     StyleBox["mag",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["mag",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["mag",
      FontSlant->"Plain"], "2"], "+", 
    SubscriptBox[
     StyleBox["b", "TI"], 
     StyleBox["mag",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["mag",
      FontSlant->"Plain"], "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9201a7b2-301b-4d04-88bd-8ccce4596c8c"],
 " for the magnetization ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["mag",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5e294d5c-403b-42b5-8d32-bfa3be51884b"],
 " (the symmetry ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["mag",
      FontSlant->"Plain"]], "\[RightArrow]", 
    RowBox[{"-", 
     SubscriptBox[
      StyleBox["m", "TI"], 
      StyleBox["mag",
       FontSlant->"Plain"]]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "28fbc360-dffb-4b1b-b084-9272e25a029f"],
 "), with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["mag",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "852c2e56-1f43-4c95-a91d-5f89171ca8bb"],
 " proportional to the temperature minus the Curie temperature and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["b", "TI"], 
     StyleBox["mag",
      FontSlant->"Plain"]], ">", "0"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6cc467e4-6e59-4b4e-8c46-1aafb275c49d"],
 "; below the Curie temperature the minima are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["mag",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"\[PlusMinus]", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", 
         SubscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["mag",
           FontSlant->"Plain"]]}], "/", 
        RowBox[{"(", 
         RowBox[{"2", 
          SubscriptBox[
           StyleBox["b", "TI"], 
           StyleBox["mag",
            FontSlant->"Plain"]]}], ")"}]}], ")"}], 
      RowBox[{"1", "/", "2"}]]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7fc97a47-5a0c-4825-8a24-ab4e92fa54d6"],
 "."
}], "Item",ExpressionUUID->"0dcee04a-399e-41c6-a54e-fcb117b00d9a"],

Cell[TextData[{
 "The theory of superconductivity of V. L. Ginzburg and L. D. Landau (1950): ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Alpha]", 
     StyleBox["GL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      SubscriptBox["\[Psi]", 
       StyleBox["GL",
        FontSlant->"Plain"]], "\[RightBracketingBar]"}], "2"], "+", 
    FractionBox["1", "2"], 
    SubscriptBox["\[Beta]", 
     StyleBox["GL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      SubscriptBox["\[Psi]", 
       StyleBox["GL",
        FontSlant->"Plain"]], "\[RightBracketingBar]"}], "4"]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a868af21-07e6-48ce-8c8f-c8b0b1ee0fde"],
 " for the complex pair wave function ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Psi]", 
    StyleBox["GL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "372bc466-355a-4982-956c-8e20f6cba9f6"],
 " (the symmetry ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["U", "TI"], 
    RowBox[{"(", "1", ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "049cc381-a546-4233-850d-7337138b1f4f"],
 "), with gradient terms and the magnetic field added. L. P. Gor'kov (1959) \
derived it from the theory of Bardeen, Cooper and Schrieffer near the \
critical temperature, where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftBracketingBar]", 
    SubscriptBox["\[Psi]", 
     StyleBox["GL",
      FontSlant->"Plain"]], "\[RightBracketingBar]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "14d86882-c55a-4c84-8ae4-cbe512dc7695"],
 " is small; there the coefficients are true Taylor coefficients."
}], "Item",ExpressionUUID->"cabd7a69-f03d-43aa-947e-4429ebd54b15"],

Cell[TextData[{
 "The Higgs potential of the Standard Model, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     SuperscriptBox[
      RowBox[{"(", 
       SuperscriptBox["\[Mu]", 
        StyleBox["SM",
         FontSlant->"Plain"]], ")"}], "2"]}], 
    SuperscriptBox[
     RowBox[{"(", 
      SuperscriptBox["\[CapitalPhi]", 
       StyleBox["SM",
        FontSlant->"Plain"]], ")"}], "\[Dagger]"], 
    SuperscriptBox["\[CapitalPhi]", 
     StyleBox["SM",
      FontSlant->"Plain"]], "+", 
    SuperscriptBox["\[Lambda]", 
     StyleBox["SM",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         SuperscriptBox["\[CapitalPhi]", 
          StyleBox["SM",
           FontSlant->"Plain"]], ")"}], "\[Dagger]"], 
       SuperscriptBox["\[CapitalPhi]", 
        StyleBox["SM",
         FontSlant->"Plain"]]}], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c20c4a9c-2e3a-4f22-bd45-be6433b6f76f"],
 ": the doublet ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CapitalPhi]", 
    StyleBox["SM",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cff03703-be97-48e9-85d1-a293a8a9d02a"],
 " has the single invariant ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SuperscriptBox["\[CapitalPhi]", 
       StyleBox["SM",
        FontSlant->"Plain"]], ")"}], "\[Dagger]"], 
    SuperscriptBox["\[CapitalPhi]", 
     StyleBox["SM",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f5c679ae-93fd-434f-8434-27c90497ab4a"],
 " of degree 2, and this Landau form is exact at tree level, not a truncation."
}], "Item",ExpressionUUID->"b2796e58-f368-4f9e-ab9c-44e9cf097962"],

Cell[TextData[{
 "The Bose-Einstein condensates of spin 1 (T.-L. Ho, 1998; T. Ohmi and K. \
Machida, 1998), the closest analogue of ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[CapitalPhi]", "\[RightVector]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "05ab6739-64c8-4c70-b260-148473f6a176"],
 ": their order parameter is a complex vector ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[CurlyPi]", "\[RightVector]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1eb4a6bd-8594-492c-80d0-6760825fd57e"],
 ", and their energy per volume ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], 
    SubscriptBox[
     StyleBox["c", "TI"], 
     StyleBox["n",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      OverscriptBox["\[CurlyPi]", "\[RightVector]"], 
      "\[RightBracketingBar]"}], "4"], "+", 
    FractionBox["1", "2"], 
    SubscriptBox[
     StyleBox["c", "TI"], 
     StyleBox["s",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"\[LeftBracketingBar]", 
        OverscriptBox["\[CurlyPi]", "\[RightVector]"], 
        "\[RightBracketingBar]"}], "4"], "-", 
      SuperscriptBox[
       RowBox[{"\[LeftBracketingBar]", 
        RowBox[{
         OverscriptBox["\[CurlyPi]", "\[RightVector]"], "\[CenterDot]", 
         OverscriptBox["\[CurlyPi]", "\[RightVector]"]}], 
        "\[RightBracketingBar]"}], "2"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b2f9d225-1c76-4a1c-b303-cf55d3b70cbc"],
 " contains the same two quartic invariants as ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[CapitalPhi]", "\[RightVector]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "de81e545-f602-4372-8ae2-25ed5a57c885"],
 ", the second term being the square of the spin. ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["c", "TI"], 
     StyleBox["s",
      FontSlant->"Plain"]], ">", "0"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "736dbdf6-eaed-48a9-83c4-611665a07ad3"],
 " (sodium-23) favors the polar state, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["c", "TI"], 
     StyleBox["s",
      FontSlant->"Plain"]], "<", "0"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9f1caeb0-6df0-45ab-958d-b8a7fbdbc924"],
 " (rubidium-87) the ferromagnetic state ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["\[CurlyPi]", "\[RightVector]"], "\[Proportional]", 
    RowBox[{"(", 
     RowBox[{"1", ",", 
      StyleBox["i", "TI"], ",", "0"}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d8947b3c-a731-48ca-940f-502a7cbcbf73"],
 "."
}], "Item",ExpressionUUID->"e33a789b-29e6-497b-8979-662ec8376e1a"],

Cell[TextData[{
 "The ferroelectric barium titanate (A. F. Devonshire, 1949): ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Alpha]", 
     StyleBox["D",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["P", "TI"], 
     StyleBox["D",
      FontSlant->"Plain"], "2"], "+", 
    SubscriptBox["\[Beta]", 
     StyleBox["D",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["P", "TI"], 
     StyleBox["D",
      FontSlant->"Plain"], "4"], "+", 
    SubscriptBox["\[Gamma]", 
     StyleBox["D",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["P", "TI"], 
     StyleBox["D",
      FontSlant->"Plain"], "6"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c2be8c83-a619-40a2-a4cc-4cef8b4498b0"],
 " for the polarization ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["P", "TI"], 
    StyleBox["D",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a6a3b91e-464b-4c80-826b-f944fa8570b5"],
 ", with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Beta]", 
     StyleBox["D",
      FontSlant->"Plain"]], "<", "0"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "59fdcf29-17d6-4fc6-862b-e87621ef72c2"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", 
     StyleBox["D",
      FontSlant->"Plain"]], ">", "0"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fb9d1199-5fd4-4a89-9937-73175d68e08c"],
 ": the sixth power is required, and the transition is of first order."
}], "Item",ExpressionUUID->"32029ad3-b9af-4d98-82f6-6c95c48ddebf"],

Cell[TextData[{
 "Superfluid helium-3 (A. J. Leggett, 1975): one quadratic and five quartic \
invariants of a complex ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", "\[Times]", "3"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "452d47f5-036c-4f5d-aafa-e55e4a29cf87"],
 " matrix, whose five coefficients decide between the phases A and B. The \
nematic liquid crystals (P. G. de Gennes, 1971): the traceless symmetric \
tensor of the nematic order admits an invariant of the third degree, so the \
transition is of first order."
}], "Item",ExpressionUUID->"aee14069-4d36-4f5d-9acb-d1349fa1da92"],

Cell[TextData[{
 "The name has nothing to do with the Landau levels of a charge in a magnetic \
field (Section I.6 of this notebook, AS2): the same physicist, another \
subject. ",
 StyleBox["The Landau form of $\\vec\\Phi$.",
  FontWeight->"Bold"],
 " The symmetry is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["v",
      FontSlant->"Plain"]], "\[Times]", 
    StyleBox["U", "TI"], 
    SubsuperscriptBox[
     RowBox[{"(", "1", ")"}], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "79363d85-1270-40dd-9fbd-d53e8d788e5f"],
 ". The independent invariants up to the fourth degree are ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "eacd7b16-0cde-43d3-afbd-21535e8ebb5a"],
 ", ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}], "4"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3e7d71f1-07c2-4b08-a253-da79e35a0d78"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     RowBox[{
      OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "\[CenterDot]", 
      OverscriptBox["\[CapitalPhi]", "\[RightVector]"]}], 
     "\[RightBracketingBar]"}], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a2d00322-cb74-4f20-ab35-71a344d24ad7"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
      "\[RightBracketingBar]"}], "4"], "-", 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      RowBox[{
       OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "\[CenterDot]", 
       OverscriptBox["\[CapitalPhi]", "\[RightVector]"]}], 
      "\[RightBracketingBar]"}], "2"], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      RowBox[{
       OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "\[Times]", 
       SuperscriptBox[
        OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "*"]}], 
      "\[RightBracketingBar]"}], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "216388da-e7cd-43e7-8ece-b49d9fc56dd8"],
 " vanishes exactly on the polar fields. The Landau form used by the solution \
is"
}], "Text",ExpressionUUID->"8fd66462-74f2-4c95-a672-e98affce2c28"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalV]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], "\[TildeTilde]", 
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], 
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}], "2"], "+", 
   SubsuperscriptBox[
    StyleBox["b", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], 
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}], "4"], "+", 
   SubsuperscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], 
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}], "6"], "+", 
   SubsuperscriptBox[
    StyleBox["u", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], 
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"\[LeftBracketingBar]", 
       OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
       "\[RightBracketingBar]"}], "4"], "-", 
     SuperscriptBox[
      RowBox[{"\[LeftBracketingBar]", 
       RowBox[{
        OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "\[CenterDot]", 
        OverscriptBox["\[CapitalPhi]", "\[RightVector]"]}], 
       "\[RightBracketingBar]"}], "2"]}], ")"}], ","}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"6324f8fc-29ec-4f20-b2a9-99534a2de4a4"],

Cell[TextData[{
 "the polynomial ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["\[ScriptCapitalV]",
      FontSlant->"Plain"], 
     StyleBox["L",
      FontSlant->"Plain"]], 
    RowBox[{"(", "\[CapitalPhi]", ")"}], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], 
    SuperscriptBox["\[CapitalPhi]", "2"], "+", 
    SubsuperscriptBox[
     StyleBox["b", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], 
    SuperscriptBox["\[CapitalPhi]", "4"], "+", 
    SubsuperscriptBox[
     StyleBox["c", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], 
    SuperscriptBox["\[CapitalPhi]", "6"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b8c1e757-9091-4173-a67b-86e9626d6fb5"],
 " along the polar fields. The coefficient ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["u", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7fb13971-2e07-4a1c-af1d-6bef5cd13fc9"],
 " is not fitted: it comes from the computed second derivative in a \
non-unitary direction at the minimum, and it is positive in every method (the \
sodium case of the condensates of spin 1). The next cell checks, for random \
vectors, that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
      "\[RightBracketingBar]"}], "4"], "-", 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      RowBox[{
       OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "\[CenterDot]", 
       OverscriptBox["\[CapitalPhi]", "\[RightVector]"]}], 
      "\[RightBracketingBar]"}], "2"], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      RowBox[{
       OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "\[Times]", 
       SuperscriptBox[
        OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "*"]}], 
      "\[RightBracketingBar]"}], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f95edb29-2f07-4444-842b-c52e7d119a6a"],
 ", and that it vanishes on polar fields."
}], "Text",ExpressionUUID->"2140203d-f4c5-4398-afca-c304776ee54a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"the", " ", "identity"}], " ", "|", "Phi", "|", 
      RowBox[{
       RowBox[{"^", "4"}], " ", "-"}], " ", "|", 
      RowBox[{"Phi", ".", "Phi"}], "|", 
      RowBox[{"^", "2"}]}], " ", "=", " ", 
     RowBox[{"|", 
      RowBox[{"Phi", " ", "x", " ", 
       RowBox[{"Phi", "^"}], "*"}], "|", 
      RowBox[{
       RowBox[{
        RowBox[{"^", "2"}], " ", "for", " ", "complex", " ", "3"}], "-", 
       "vectors"}]}]}], ",", " ", "exactly", ",", " ", 
    RowBox[{"with", " ", "symbolic", " ", "components"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"lfVec", " ", "=", " ", 
     RowBox[{"Array", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"lfRe", "[", "#", "]"}], " ", "+", " ", 
         RowBox[{"I", " ", 
          RowBox[{"lfIm", "[", "#", "]"}]}]}], " ", "&"}], ",", " ", "3"}], 
      "]"}]}], ";"}], "   ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Phi", " ", "=", " ", 
      RowBox[{"lfRe", " ", "+", " ", 
       RowBox[{
       "i", " ", "lfIm", " ", "with", " ", "real", " ", "components", " ", 
        RowBox[{"lfRe", "[", "k", "]"}]}]}]}], ",", " ", 
     RowBox[{"lfIm", "[", "k", "]"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"lfNorm2", " ", "=", " ", 
     RowBox[{"ComplexExpand", "[", 
      RowBox[{
       RowBox[{"Conjugate", "[", "lfVec", "]"}], " ", ".", " ", "lfVec"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"lfIdentity", " ", "=", " ", 
     RowBox[{"Simplify", "[", 
      RowBox[{"ComplexExpand", "[", 
       RowBox[{
        RowBox[{"lfNorm2", "^", "2"}], " ", "-", " ", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"lfVec", " ", ".", " ", "lfVec"}], "]"}], "^", "2"}], " ", "-",
         " ", 
        RowBox[{
         RowBox[{"Conjugate", "[", 
          RowBox[{"Cross", "[", 
           RowBox[{"lfVec", ",", " ", 
            RowBox[{"Conjugate", "[", "lfVec", "]"}]}], "]"}], "]"}], " ", ".",
          " ", 
         RowBox[{"Cross", "[", 
          RowBox[{"lfVec", ",", " ", 
           RowBox[{"Conjugate", "[", "lfVec", "]"}]}], "]"}]}]}], "]"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"on", " ", "a", " ", "polar", " ", "field", " ", "Phi"}], " ", "=",
      " ", 
     RowBox[{
      RowBox[{"e", "^", 
       RowBox[{"(", 
        RowBox[{"i", " ", "theta"}], ")"}]}], " ", "r", " ", "n", " ", "with",
       " ", "a", " ", "real", " ", "unit", " ", "vector", " ", "n", " ", 
      "the", " ", "term", " ", "vanishes"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"lfPolar", " ", "=", " ", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{"ComplexExpand", "[", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"v", " ", "=", " ", 
            RowBox[{
             RowBox[{"Exp", "[", 
              RowBox[{"I", " ", "lfTh"}], "]"}], " ", "lfR", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"Sin", "[", "lfT1", "]"}], " ", 
