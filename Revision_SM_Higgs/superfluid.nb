Cell[CellGroupData[{

Cell["III.G.3 The values of the Rust program", "Section",ExpressionUUID->"c2be8c8c-3b08-4e25-b91c-8e4ffe2a0c44"],

Cell[TextData[{
 "The closed cell holds the results of the modules ",
 StyleBox["ginzburg",
  FontFamily->"Source Code Pro"],
 " and ",
 StyleBox["higgs",
  FontFamily->"Source Code Pro"],
 " of the Rust program: ",
 StyleBox["rustGinzburg",
  FontFamily->"Source Code Pro"],
 " (per method: the critical temperature, the Dirac mass of the normal state \
at it, the coefficients ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Alpha]", 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["GL",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7fc2c5e6-ab27-4440-8cc9-a75ac431ffcd"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["b", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["Tay",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a087fc3c-6601-40e9-a711-b9271e76764f"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["c",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4298bb51-1b66-437e-878b-ff423deef52b"],
 ", the gradient coefficient of the isospin twist, of the fixed channels, of \
the twist of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "256fbf23-80d7-446f-9e6a-f426fecd5e53"],
 " and of the twisted states, the two values of the extrapolation, the norms \
of the other channels, ",
 Cell[BoxData[
  FormBox[
   StyleBox["a", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "25eb2c16-be20-472d-a84b-726c8f679f53"],
 " at ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "645e6125-7279-48b4-9021-133be253e540"],
 ", the Ginzburg number, the width, ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Xi]", 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["GL",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f2a162a8-bcd1-4516-b9d1-70ec6e2e487a"],
 " and the field at the edge of the critical region), ",
 StyleBox["rustGinzburgRegions",
  FontFamily->"Source Code Pro"],
 " (the two regularizations of Section III.G.5) and ",
 StyleBox["rustHiggs",
  FontFamily->"Source Code Pro"],
 " (the numbers of Section III.G.8, one row per method)."
}], "Text",ExpressionUUID->"b40612ff-3f51-417e-a27d-21e567783b97"],

