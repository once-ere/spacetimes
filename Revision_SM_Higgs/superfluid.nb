      RowBox[{"the", " ", "vacuum", " ", "value", " ", "v", " ", 
       RowBox[{"(", 
        RowBox[{"all", " ", "positive", " ", "symbols"}], ")"}]}]}]}]}], " ", 
   "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", 
     RowBox[{"gSM", ",", " ", "gpSM", ",", " ", "vSM"}], "]"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"phiSM", ":", " ", 
      RowBox[{
       RowBox[{"the", " ", "vacuum"}], " ", "<", 
       RowBox[{"Phi", "^", "SM"}], ">"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"0", ",", " ", "v"}], ")"}], "/", "sqrt2"}], " ", "of", " ", 
      "the", " ", "Higgs", " ", "doublet"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"phiSM", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", 
       RowBox[{"vSM", "/", 
        RowBox[{"Sqrt", "[", "2", "]"}]}]}], "}"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"xSM", "[", "a", "]"}], ":", " ", 
       RowBox[{
        RowBox[{"the", " ", "vector", " ", "X_a", " ", "with", " ", "D_mu"}], 
        " ", "<", "Phi", ">"}]}], " ", "=", " ", 
      RowBox[{
       RowBox[{"sum_a", " ", 
        RowBox[{"V", "^", "a_mu"}], " ", "X_a", " ", "for", " ", "the", " ", 
        "fields", " ", "V"}], " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"W", "^", "1"}], ",", " ", 
           RowBox[{"W", "^", "2"}], ",", " ", 
           RowBox[{"W", "^", "3"}], ",", " ", "B"}], ")"}], ":", "\n", "   ", 
         
         RowBox[{
          RowBox[{"i", " ", "g", " ", 
           RowBox[{"tau_a", "/", "2"}]}], " ", "<", "Phi", ">", " ", 
          RowBox[{"for", " ", "a"}]}]}], " ", "=", " ", "1"}]}]}], ",", " ", 
     "2", ",", " ", 
     RowBox[{
      RowBox[{"3", " ", "and", " ", "i", " ", 
       RowBox[{"g", "'"}], " ", "Y"}], " ", "<", "Phi", ">", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Y", " ", "=", " ", 
         RowBox[{"1", "/", "2"}]}], ")"}], " ", "for", " ", "B"}]}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"xSM", " ", "=", " ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"I", " ", 
            RowBox[{"gSM", "/", "2"}]}], ")"}], " ", 
          RowBox[{
           RowBox[{"sig", "[", 
            RowBox[{"[", 
             RowBox[{"a", " ", "+", " ", "1"}], "]"}], "]"}], " ", ".", " ", 
           "phiSM"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"a", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"I", " ", 
           RowBox[{"gpSM", "/", "2"}]}], ")"}], " ", "phiSM"}], "}"}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", "mass", " ", "matrix", " ", "M_ab"}], " ", "=", " ", 
     
     RowBox[{
      RowBox[{
       RowBox[{"2", " ", "Re", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"X_a", "^", "dag"}], " ", "X_b"}], ")"}]}], ":", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"D", " ", "<", "Phi", ">"}], ")"}], "^", "dag"}], " ", 
        RowBox[{"(", 
         RowBox[{"D", " ", "<", "Phi", ">"}], ")"}]}]}], " ", "=", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "/", "2"}], ")"}], " ", "sum_ab", " ", "M_ab", " ", 
       RowBox[{"V", "^", "a"}], " ", 
       RowBox[{"V", "^", "b"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"mSM", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"2", " ", 
        RowBox[{"ComplexExpand", "[", 
         RowBox[{"Re", "[", 
          RowBox[{
           RowBox[{"Conjugate", "[", 
            RowBox[{"xSM", "[", 
             RowBox[{"[", "a", "]"}], "]"}], "]"}], " ", ".", " ", 
           RowBox[{"xSM", "[", 
            RowBox[{"[", "b", "]"}], "]"}]}], "]"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "4"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"b", ",", " ", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", "predicted", " ", 
      RowBox[{"eigenvalues", ":", " ", "0"}]}], ",", " ", 
     RowBox[{
      RowBox[{"M_W", "^", "2"}], " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"g", " ", 
          RowBox[{"v", "/", "2"}]}], ")"}], "^", "2"}], " ", "twice"}]}], ",",
      " ", 
     RowBox[{
      RowBox[{
       RowBox[{"M_Z", "^", "2"}], " ", "=", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"g", "^", "2"}], " ", "+", " ", 
          RowBox[{
           RowBox[{"g", "'"}], "^", "2"}]}], ")"}], " ", 
        RowBox[{
         RowBox[{"v", "^", "2"}], "/", "4"}]}]}], ";", " ", 
      RowBox[{
      "they", " ", "are", " ", "the", " ", "eigenvalues", " ", "exactly", " ",
        "when", "\n", "   ", "the", " ", "characteristic", " ", "polynomial", 
       " ", "det", 
       RowBox[{"(", 
        RowBox[{"M", " ", "-", " ", 
         RowBox[{"lam", " ", "1"}]}], ")"}], " ", "equals", " ", "the", " ", 
       "product", " ", "of", " ", "the", " ", "factors", " ", 
       RowBox[{"(", 
        RowBox[{"lam", " ", "-", " ", "eigenvalue"}], ")"}]}]}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"evSMpred", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"gSM", " ", 
          RowBox[{"vSM", "/", "2"}]}], ")"}], "^", "2"}], ",", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"gSM", " ", 
          RowBox[{"vSM", "/", "2"}]}], ")"}], "^", "2"}], ",", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"gSM", "^", "2"}], " ", "+", " ", 
          RowBox[{"gpSM", "^", "2"}]}], ")"}], " ", 
        RowBox[{
         RowBox[{"vSM", "^", "2"}], "/", "4"}]}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"charSM", " ", "=", " ", 
     RowBox[{"Expand", "[", 
      RowBox[{
       RowBox[{"CharacteristicPolynomial", "[", 
        RowBox[{"mSM", ",", " ", "lam"}], "]"}], " ", "-", " ", 
       RowBox[{"Product", "[", 
        RowBox[{
         RowBox[{"lam", " ", "-", " ", "ev"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"ev", ",", " ", "evSMpred"}], "}"}]}], "]"}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", "photon", " ", "A"}], " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"sin", 
        RowBox[{"(", "thetaW", ")"}], " ", 
        RowBox[{"W", "^", "3"}]}], " ", "+", " ", 
       RowBox[{"cos", 
        RowBox[{"(", "thetaW", ")"}], " ", "B", " ", "with", " ", "tan", 
        RowBox[{"(", "thetaW", ")"}]}]}], " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"g", "'"}], "/", "g"}], " ", "is", " ", "the", " ", "null", " ",
        "vector"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"photonSM", " ", "=", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "0", ",", " ", "gpSM", ",", " ", "gSM"}], "}"}],
       "/", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"gSM", "^", "2"}], " ", "+", " ", 
        RowBox[{"gpSM", "^", "2"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<the mass matrix of (W1, W2, W3, B): \>\"", ",", " ", 
      RowBox[{"MatrixForm", "[", "mSM", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"checkTrue", "[", 
     RowBox[{"\"\<WSM-1\>\"", ",", 
      " ", "\"\<Standard Model with +i g: the eigenvalues of the mass matrix \
are 0, M_W^2 (twice), M_Z^2, and the photon sin(thetaW) W^3 + cos(thetaW) B \
is massless\>\"", ",", "\n", "  ", 
      RowBox[{
       RowBox[{"charSM", " ", "===", " ", "0"}], " ", "&&", " ", 
       RowBox[{
        RowBox[{"Simplify", "[", 
         RowBox[{"mSM", " ", ".", " ", "photonSM"}], "]"}], " ", "===", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], 
         "}"}]}]}], ",", " ", "\"\<exact, with symbolic g, g', v\>\"", ",", 
      "\n", "  ", "\"\<SM-1\>\"", ",", " ", "\"\<SM-1\>\""}], "]"}], 
    ";"}]}]}]], "Input",
 CellLabel->"In[42]:=",ExpressionUUID->"7fee163f-5a2b-40e1-91f7-5c52007d4437"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"the mass matrix of (W1, W2, W3, B): \"\>", "\[InvisibleSpace]", 
   TagBox[
    RowBox[{"(", "\[NoBreak]", GridBox[{
       {
        FractionBox[
         RowBox[{
          SuperscriptBox["gSM", "2"], " ", 
          SuperscriptBox["vSM", "2"]}], "4"], "0", "0", "0"},
       {"0", 
        FractionBox[
         RowBox[{
          SuperscriptBox["gSM", "2"], " ", 
          SuperscriptBox["vSM", "2"]}], "4"], "0", "0"},
       {"0", "0", 
        FractionBox[
         RowBox[{
          SuperscriptBox["gSM", "2"], " ", 
          SuperscriptBox["vSM", "2"]}], "4"], 
        RowBox[{
         RowBox[{"-", 
          FractionBox["1", "4"]}], " ", "gpSM", " ", "gSM", " ", 
