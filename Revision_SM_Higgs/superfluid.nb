Cell[CellGroupData[{

Cell["III.T.4 The critical temperature", "Section",ExpressionUUID->"9c516431-12dc-4ac4-9087-795b0745d618"],

Cell[TextData[{
 StyleBox["The effective couplings.",
  FontWeight->"Bold"],
 " A uniform scalar density ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["S",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "523cac40-eff4-4756-a6a5-5fe8bbc4b8ea"],
 " shifts the Dirac mass by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["S",
       FontSlant->"Plain"]}]], 
    SubsuperscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["S",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2befc8f9-0ec6-4b70-8284-8209071c80e8"],
 ", and a pair amplitude in the channel ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9a7a4e53-ca4f-476c-8885-e3995b23c91b"],
 " produces the pair self-energy with the strength ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["P",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d1fd1e9b-162b-4a77-bc03-a634e1d131e5"],
 " (Section II.3). For a state with the Dirac mass ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["M", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["D",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d6b28d97-31e8-4114-adc6-a9a1972b9b14"],
 " and the pair field ",
 Cell[BoxData[
  FormBox["\[CapitalPhi]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "20cd7c7f-9e3a-4c22-a115-dc585a051e72"],
 " at the temperature ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "95902b46-2940-4e74-9fda-635e5861ca75"],
 " the scalar density is"
}], "Text",ExpressionUUID->"c7650258-5c65-40d1-b011-ae0a6eb6d91c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["S",
     FontSlant->"Plain"]], "\[LongEqual]", 
   RowBox[{"-", 
    FractionBox["2", 
     SuperscriptBox["\[Pi]", "2"]]}], 
   RowBox[{"[", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["M", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["X", "TI"], ",", 
       StyleBox["D",
        FontSlant->"Plain"]}]], "\[ThinSpace]", 
     SubsuperscriptBox[
      StyleBox["I", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{"(", "1", ")"}]], 
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["E", "TI"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["X", "TI"], ",", 
         StyleBox["gap",
          FontSlant->"Plain"]}]], ",", 
       StyleBox["T", "TI"]}], ")"}], "-", 
     SubscriptBox[
      StyleBox["m", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"]], 
     SubsuperscriptBox[
      StyleBox["I", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{"(", "1", ")"}]], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["m", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"]], ",", "0"}], ")"}]}], "]"}], ",", "      ", 
   SubsuperscriptBox[
    StyleBox["I", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "1", ")"}]], 
   RowBox[{"(", 
    RowBox[{
     StyleBox["M", "TI"], ",", 
     StyleBox["T", "TI"]}], ")"}], "\[LongEqual]", 
   SubsuperscriptBox["\[Integral]", "0", 
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]], "\[ThinSpace]", 
   FractionBox[
    RowBox[{
     SuperscriptBox[
      StyleBox["q", "TI"], "2"], "\[ThinSpace]", 
     StyleBox["tanh",
      FontSlant->"Plain"], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["E", "TI"], 
        StyleBox["M", "TI"]], "/", "2", 
       StyleBox["T", "TI"]}], ")"}]}], 
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["M", "TI"]]], "\[ThinSpace]", 
   StyleBox["dq", "TI"], ","}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"0a5bf951-00e3-4085-b12d-403ef07e4562"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["M", "TI"]], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        StyleBox["q", "TI"], "2"], "+", 
       SuperscriptBox[
        StyleBox["M", "TI"], "2"]}], ")"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "43803df6-5ff8-4a5e-8072-07541f229fb9"],
 " and the gap ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["gap",
       FontSlant->"Plain"]}]], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox[
          StyleBox["M", "TI"], 
          StyleBox["SF",
           FontSlant->"Plain"], 
          RowBox[{
           StyleBox["X", "TI"], ",", 
           StyleBox["D",
            FontSlant->"Plain"]}]], ")"}], "2"], "+", 
       SuperscriptBox["\[CapitalPhi]", "2"]}], ")"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8812284f-fb43-4a06-a5c3-3f16a5d07b0c"],
 "; the factor ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["tanh",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["E", "TI"], "/", "2", 
      StyleBox["T", "TI"]}], ")"}], "\[LongEqual]", "1", "-", "2", 
    StyleBox["f", "TI"], 
    RowBox[{"(", 
     StyleBox["E", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c2b72b92-b266-43be-8577-1e8d7b275dac"],
 " is the thermal factor of a pair of quasi-particles, and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["I", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{"(", "1", ")"}]], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["M", "TI"], ",", "0"}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "17a47f63-ca35-489c-9443-830916b8dc9d"],
 " is the integral of Part II. The Dirac mass is self-consistent when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["D",
       FontSlant->"Plain"]}]], "-", 
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["S",
       FontSlant->"Plain"]}]], 
    SubsuperscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["S",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0d809611-5617-4c75-a859-95a355c8c480"],
 ". ",
 StyleBox["The normal state and its instability.",
  FontWeight->"Bold"],
 " The normal state at ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fbd181bc-3184-4076-958a-6753d3e7ddc6"],
 " has no pair field and the Dirac mass ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["n",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5a8a517d-838d-4ce5-a81b-a9a88f85f025"],
 " that solves this condition with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPhi]", "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "392ca326-1649-49c2-b57d-1846b0504bab"],
 ": ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "65556632-aa6b-4ae8-b7f4-5676732c118a"],
 " at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0665debd-ebfc-4b90-b636-82d9231ffcf1"],
 "; at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], ">", "0"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "23017d95-eea4-44b2-a075-b1e07f48477a"],
 " the thermally excited particles and antiparticles change the scalar \
density, which shifts the mass where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["S",
       FontSlant->"Plain"]}]], "\[NotEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "69b230ac-dd94-4809-964c-8d82a7f2559e"],
 ". A small pair field in the normal state is amplified by the factor"
}], "Text",ExpressionUUID->"fa1fd128-2dee-4103-bdd9-a85b922d21aa"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["\[Lambda]", 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["P",
     FontSlant->"Plain"]], 
   RowBox[{"(", 
    StyleBox["T", "TI"], ")"}], "\[LongEqual]", 
   FractionBox[
    RowBox[{
     SubsuperscriptBox[
      StyleBox["g", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["X", "TI"], ",", 
       StyleBox["P",
        FontSlant->"Plain"]}]], "\[ThinSpace]", 
     SubsuperscriptBox[
      StyleBox["I", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{"(", "1", ")"}]], 
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["M", "TI"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["X", "TI"], ",", 
         StyleBox["n",
          FontSlant->"Plain"]}]], 
       RowBox[{"(", 
        StyleBox["T", "TI"], ")"}], ",", 
       StyleBox["T", "TI"]}], ")"}]}], 
    SuperscriptBox["\[Pi]", "2"]], ","}], TraditionalForm]], "DisplayFormula",\

 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"fe6031c1-2a9c-4547-9976-91df16954430"],

Cell[TextData[{
 "the eigenvalue of the static pair response of the normal state: the normal \
state is unstable towards a superfluid when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Lambda]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["P",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}], ">", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5eda19d8-943f-48ff-935d-8ce646d03fac"],
 " (the criterion of Thouless). The ",
 StyleBox["critical temperature",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "217a243b-d51d-4e72-84c5-ce175d675c6c"],
 " solves ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Lambda]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["P",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["T", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["X", "TI"], ",", 
       StyleBox["c",
        FontSlant->"Plain"]}]], ")"}], "\[LongEqual]", "1"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3d42ab8d-1381-4ba3-913a-6fc8c8362450"],
 ". The next cell computes ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["n",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7fd9161c-40b0-491d-9a35-c70d51aa1e07"],
 " from the scalar self-consistency alone (bisection), ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Lambda]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["P",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b4451d82-77ae-454b-9a25-a5faa7ebf3ff"],
 " with the integral on the radial nodes of the grid of Part II, and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d99ff5c5-1138-4224-8c5f-a8e7f15f9077"],
 " by bisection; for the three methods with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["S",
       FontSlant->"Plain"]}]], "\[NotEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c76bf00a-89e3-411f-853e-9d4bc109f1a1"],
 " it compares ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["n",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["T", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["X", "TI"], ",", 
       StyleBox["c",
        FontSlant->"Plain"]}]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5dd07d6d-767d-46ae-ba7c-47724fe5c37f"],
 " with the normal state of the thermal engine. It then shows that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Lambda]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["P",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "306b27e8-41ed-4f37-9803-8ac8190bdbb9"],
 " does not increase from ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0.01"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4348bfca-447a-4d33-a3f5-26920c9c8b63"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0.6"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "71f44cf9-badb-4d98-b595-0f0dc97d56fb"],
 ", so that ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "11fb8650-0e10-4cd7-ba24-dfdc4c391b22"],
 " is the only solution there."
}], "Text",ExpressionUUID->"d77c35d1-8c0c-41f4-a393-7caeb95ca9a5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"i1Grid", "[", 
       RowBox[{"mo", ",", " ", "s", ",", " ", "t"}], "]"}], ":", " ", "I1"}], 
     " ", "=", " ", 
     RowBox[{
      RowBox[{"int_", 
       RowBox[{"0", "^", "Lambda"}], " ", 
       RowBox[{"q", "^", "2"}], " ", "tanh", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"E", "/", "2"}], "t"}], ")"}], "/", "E"}], " ", "dq", " ", 
       "with", " ", "E"}], " ", "=", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"q", "^", "2"}], " ", "+", " ", "s"}], ")"}], "^", 
       RowBox[{"(", 
        RowBox[{"1", "/", "2"}], ")"}]}]}]}], ",", " ", 
    RowBox[{
    "on", " ", "the", " ", "radial", " ", "nodes", " ", "of", " ", "the", " ",
      "grid"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"i1Grid", "[", 
      RowBox[{"mo_", ",", " ", "s_", ",", " ", "t_"}], "]"}], " ", ":=", " ", 
     
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"kr", " ", "=", " ", 
          RowBox[{
           RowBox[{"mo", "[", "\"\<g\>\"", "]"}], "[", "\"\<kr\>\"", "]"}]}], 
         ",", " ", 
         RowBox[{"wr", " ", "=", " ", 
          RowBox[{
           RowBox[{"mo", "[", "\"\<g\>\"", "]"}], "[", "\"\<wr\>\"", "]"}]}], 
         ",", " ", "e"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"e", " ", "=", " ", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{"kr", "^", "2"}], " ", "+", " ", "s"}], "]"}]}], ";", "\n",
         "   ", 
        RowBox[{"Total", "[", 
         RowBox[{"wr", " ", 
          RowBox[{"kr", "^", "2"}], " ", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"t", " ", ">", " ", "0"}], ",", " ", 
             RowBox[{"Tanh", "[", 
              RowBox[{"e", "/", 
               RowBox[{"(", 
                RowBox[{"2", " ", "t"}], ")"}]}], "]"}], ",", " ", "1."}], 
            "]"}], "/", "e"}]}], "]"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"thCoup", "[", "t", "]"}], ":", " ", 
     RowBox[{"the", " ", "effective", " ", "couplings", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"g", "^", "S"}], ",", " ", 
        RowBox[{"g", "^", "P"}]}], "}"}], " ", "of", " ", "the", " ", 
      "method", " ", "t", " ", "for", " ", 
      RowBox[{"V", "^", 
       RowBox[{"(", "2", ")"}]}], " ", 
      RowBox[{"(", 
       RowBox[{"Part", " ", "II"}], ")"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"thCoup", "[", "t_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"thCoup", "[", "t", "]"}], " ", "=", " ", 
      RowBox[{"effCouplings", "[", 
       RowBox[{
        RowBox[{"Lookup", "[", 
         RowBox[{
          RowBox[{"AssociationThread", "[", 
           RowBox[{
            RowBox[{"shortName", " ", "/@", " ", "methodsSF"}], ",", " ", 
            "methodsSF"}], "]"}], ",", " ", "t"}], "]"}], ",", " ", 
        RowBox[{"Sequence", " ", "@@", " ", 
         RowBox[{"potentialsSF", "[", "\"\<V2\>\"", "]"}]}]}], "]"}]}]}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"thMassN", "[", 
       RowBox[{"t", ",", " ", "T"}], "]"}], ":", " ", 
      RowBox[{
       RowBox[{
       "the", " ", "Dirac", " ", "mass", " ", "of", " ", "the", " ", "normal",
         " ", "state", " ", "at", " ", "the", " ", "temperature", " ", "T", " ",
         "from", " ", "M"}], " ", "-", " ", "m"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"g", "^", "S"}], " ", 
      RowBox[{"n", "^", "S"}], " ", 
      RowBox[{"(", 
       RowBox[{"bisection", " ", 
        RowBox[{"on", " ", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"1", "e"}], "-", "6"}], ",", " ", "2"}], "]"}]}], 
       ")"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"thMassN", "[", 
      RowBox[{"t_", ",", " ", "temp_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"mo", " ", "=", " ", 
          RowBox[{"thModel", "[", "t", "]"}]}], ",", " ", 
         RowBox[{"gs", " ", "=", " ", 
          RowBox[{
           RowBox[{"thCoup", "[", "t", "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
         RowBox[{"lo", " ", "=", " ", 
          RowBox[{"10.", "^", 
           RowBox[{"-", "6"}]}]}], ",", " ", 
         RowBox[{"hi", " ", "=", " ", "2."}], ",", " ", "mid", ",", " ", 
         "i1m"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", "gs", "]"}], " ", "<", " ", 
           RowBox[{"10", "^", 
            RowBox[{"-", "14"}]}]}], ",", " ", 
          RowBox[{"Return", "[", 
           RowBox[{
            RowBox[{"N", "[", "mLL", "]"}], ",", " ", "Module"}], "]"}]}], 
         "]"}], ";", "\n", "   ", 
        RowBox[{"i1m", " ", "=", " ", 
         RowBox[{"i1Grid", "[", 
          RowBox[{"mo", ",", " ", 
           RowBox[{
            RowBox[{"N", "[", "mLL", "]"}], "^", "2"}], ",", " ", "0."}], 
          "]"}]}], ";", "\n", "   ", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"mid", " ", "=", " ", 
            RowBox[{"0.5", " ", 
             RowBox[{"(", 
              RowBox[{"lo", " ", "+", " ", "hi"}], ")"}]}]}], ";", "\n", 
           "     ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"mid", " ", "-", " ", "mLL", " ", "+", " ", 
               RowBox[{"gs", " ", 
                RowBox[{"2", "/", 
                 RowBox[{"Pi", "^", "2"}]}], " ", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"mid", " ", 
                   RowBox[{"i1Grid", "[", 
                    RowBox[{"mo", ",", " ", 
                    RowBox[{"mid", "^", "2"}], ",", " ", "temp"}], "]"}]}], 
                  " ", "-", " ", 
                  RowBox[{"mLL", " ", "i1m"}]}], ")"}]}]}], " ", ">", " ", 
              "0"}], ",", " ", 
             RowBox[{"hi", " ", "=", " ", "mid"}], ",", " ", 
             RowBox[{"lo", " ", "=", " ", "mid"}]}], "]"}]}], ",", " ", 
          RowBox[{"{", "80", "}"}]}], "]"}], ";", "\n", "   ", 
        RowBox[{"0.5", " ", 
         RowBox[{"(", 
          RowBox[{"lo", " ", "+", " ", "hi"}], ")"}]}]}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"thLam", "[", 
       RowBox[{"t", ",", " ", "T"}], "]"}], ":", " ", 
      RowBox[{
       RowBox[{"lambda", "^", "P"}], 
       RowBox[{"(", "T", ")"}], " ", "of", " ", "the", " ", "normal", " ", 
       "state"}]}], ";", " ", 
     RowBox[{
      RowBox[{"thTc", "[", "t", "]"}], ":", " ", 
      RowBox[{
      "the", " ", "critical", " ", "temperature", " ", "by", " ", "bisection",
        " ", 
       RowBox[{"on", " ", "[", 
        RowBox[{"0.01", ",", " ", "1"}], "]"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"thLam", "[", 
      RowBox[{"t_", ",", " ", "temp_"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"thCoup", "[", "t", "]"}], "[", 
       RowBox[{"[", "2", "]"}], "]"}], " ", 
      RowBox[{
       RowBox[{"i1Grid", "[", 
        RowBox[{
         RowBox[{"thModel", "[", "t", "]"}], ",", " ", 
         RowBox[{
          RowBox[{"thMassN", "[", 
           RowBox[{"t", ",", " ", "temp"}], "]"}], "^", "2"}], ",", " ", 
         "temp"}], "]"}], "/", 
       RowBox[{"Pi", "^", "2"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
