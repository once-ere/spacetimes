Cell[CellGroupData[{

Cell["III.G.3 The values of the Rust program", "Section",ExpressionUUID->"9b777ee4-60de-46b9-bf03-46a3586b71ca"],

Cell[TextData[{
 "The closed cell holds the results of the modules ",
 StyleBox["ginzburg",
  FontFamily->"Source Code Pro"],
 " and ",
 StyleBox["higgs",
  FontFamily->"Source Code Pro"],
 " of the Rust program: ",
 StyleBox["rustGinzburg",
  FontFamily->"Source Code Pro"],
 " (per method: the critical temperature, the Dirac mass of the normal state \
at it, the coefficients ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Alpha]", 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["GL",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "45b6bfe5-f335-4c1f-9ab1-9b0b876a451a"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["b", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["Tay",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "07855d60-f354-4a7a-8313-96f7fb6a5e19"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["c",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2f13b47b-c428-4fe2-8470-c2224aefcb1d"],
 ", the gradient coefficient of the isospin twist, of the fixed channels, of \
the twist of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fb0e3499-15d6-4cdc-816b-c22a78051399"],
 " and of the twisted states, the two values of the extrapolation, the norms \
of the other channels, ",
 Cell[BoxData[
  FormBox[
   StyleBox["a", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a272ac56-1dd1-45d9-a334-e085ee24c9b7"],
 " at ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d27f9e2d-6230-4a24-bb11-19a6bcc12d05"],
 ", the Ginzburg number, the width, ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Xi]", 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["GL",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cc96c198-d259-43ef-9441-e668c094f7c1"],
 " and the field at the edge of the critical region), ",
 StyleBox["rustGinzburgRegions",
  FontFamily->"Source Code Pro"],
 " (the two regularizations of Section III.G.5) and ",
 StyleBox["rustHiggs",
  FontFamily->"Source Code Pro"],
 " (the numbers of Section III.G.8, one row per method)."
}], "Text",ExpressionUUID->"89b81ee0-39cf-4c1f-9062-d1d4d6a96c0c"],

