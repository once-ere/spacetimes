Cell[CellGroupData[{

Cell["I.2 The manifold M31 of the Lorentz super-loop (item 1)", "Section",ExpressionUUID->"ebe2c457-f98a-4abd-b85b-4e877f67a065"],

Cell[TextData[{
 StyleBox["Bi-quaternions.",
  FontWeight->"Bold"],
 " A bi-quaternion is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["b",
     FontWeight->"Bold",
     FontSlant->"Plain"], "\[LongEqual]", 
    UnderoverscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["p", "TI"], "\[LongEqual]", "0"}], "3",
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox["\[Xi]", 
     StyleBox["p", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["p", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3b27c7e6-0b57-4af3-8c6e-5d037c2b8869"],
 " with four complex coefficients and the units ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "0"], "\[LongEqual]", "1", ",", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "1"], ",", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "2"], ",", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "3"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2a079fef-8dc8-4a62-91ac-e03c479645ca"],
 ", multiplied by the rules of the quaternions, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"], "2"], "\[LongEqual]", 
    RowBox[{"-", "1"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c4bdc4d0-3f47-46dc-8d62-392d69dc823d"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "1"], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "2"], "\[LongEqual]", 
    RowBox[{"-", 
     SubscriptBox[
      StyleBox["e",
       FontWeight->"Bold",
       FontSlant->"Plain"], "2"]}], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "1"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "3"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bab472c1-b9ab-48a9-a011-1423047d7135"],
 " and cyclically. The conjugation ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["b",
     FontWeight->"Bold",
     FontSlant->"Plain"], "_"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7c5189db-0468-4210-95b2-52c3e6c8f71c"],
 " changes the signs of the coefficients of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "1"], ",", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "2"], ",", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "3"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e5275362-72d1-4678-b9d2-2f128c7ea0e5"],
 ", the complex conjugation ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["b",
     FontWeight->"Bold",
     FontSlant->"Plain"], "*"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f5f5e4c7-ea95-4ba2-9615-bf5e5b884f14"],
 " conjugates every coefficient, and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], "\[Dagger]"], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      OverscriptBox[
       StyleBox["b",
        FontWeight->"Bold",
        FontSlant->"Plain"], "_"], ")"}], "*"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0b9aa418-9827-4d65-8261-c4d79322a759"],
 ". The complex norm ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", 
     StyleBox["p", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox["\[Xi]", 
     StyleBox["p", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      StyleBox["b",
       FontWeight->"Bold",
       FontSlant->"Plain"], ")"}], "2"]}], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0f538775-8b13-4bbb-9b65-7e6b7cccfb24"],
 " satisfies ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["b",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    OverscriptBox[
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], "_"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "0"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f628dbc0-41b0-46b4-8f07-8b468782f0e5"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["b",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      SuperscriptBox[
       StyleBox["b",
        FontWeight->"Bold",
        FontSlant->"Plain"], "\[Prime]"]}], ")"}], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SuperscriptBox[
      StyleBox["b",
       FontWeight->"Bold",
       FontSlant->"Plain"], "\[Prime]"], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e567e0fe-2490-426d-8738-147dacdc16a7"],
 ". The matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[LongEqual]", 
    SubsuperscriptBox["\[Xi]", "0", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Sigma]", "0", 
     StyleBox["LL",
      FontSlant->"Plain"]], "-", 
    StyleBox["i", "TI"], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", 
     StyleBox["j", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox["\[Xi]", 
     StyleBox["j", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Sigma]", 
     StyleBox["j", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "11fe15ab-e309-483b-bf0e-1b205841a368"],
 " is multiplicative, has the determinant ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d1808cab-d4ee-4dc5-87f2-0ae4e0d0575c"],
 ", satisfies ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SuperscriptBox[
      StyleBox["b",
       FontWeight->"Bold",
       FontSlant->"Plain"], "\[Dagger]"], ")"}], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      StyleBox["b",
       FontWeight->"Bold",
       FontSlant->"Plain"], ")"}], "\[Dagger]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2787eea6-0c09-4dcd-a8a7-73722371ccb4"],
 ", and every complex ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Times]", "2"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fb31f36e-fc49-4994-80fc-0c315b305d4e"],
 " matrix is the matrix of exactly one bi-quaternion; the unit bi-quaternions \
(",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a2e7d090-b35e-4ca8-9205-0052f3d16210"],
 ") are therefore the group ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SL", "TI"], 
    RowBox[{"(", 
     RowBox[{"2", ",", 
      StyleBox["\[DoubleStruckCapitalC]",
       FontSlant->"Plain"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "df9afbb9-fd4a-4de3-ab1f-16eff133f6c2"],
 "."
}], "Text",ExpressionUUID->"86193906-ad66-42f9-ae57-2fd72d9500d1"],

Cell[TextData[{
 StyleBox["Bi-octonions and the super-loop.",
  FontWeight->"Bold"],
 " A bi-octonion is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["x",
     FontWeight->"Bold",
     FontSlant->"Plain"], "\[LongEqual]", 
    StyleBox["a",
     FontWeight->"Bold",
     FontSlant->"Plain"], "+", 
    StyleBox["b",
     FontWeight->"Bold",
     FontSlant->"Plain"], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b5332bed-31af-4c6c-8c88-4a034180d216"],
 " with two bi-quaternions, multiplied by the rule of Cayley and Dickson"
}], "Text",ExpressionUUID->"14ed38df-0c57-4a70-8d90-08145e761900"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     StyleBox["a",
      FontWeight->"Bold",
      FontSlant->"Plain"], "+", 
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], "\[ThinSpace]", 
     SubscriptBox[
      StyleBox["e",
       FontWeight->"Bold",
       FontSlant->"Plain"], "4"]}], ")"}], 
   RowBox[{"(", 
    RowBox[{
     StyleBox["c",
      FontWeight->"Bold",
      FontSlant->"Plain"], "+", 
     StyleBox["d",
      FontWeight->"Bold",
      FontSlant->"Plain"], "\[ThinSpace]", 
     SubscriptBox[
      StyleBox["e",
       FontWeight->"Bold",
       FontSlant->"Plain"], "4"]}], ")"}], "\[LongEqual]", 
   RowBox[{"(", 
    RowBox[{
     StyleBox["a",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["c",
      FontWeight->"Bold",
      FontSlant->"Plain"], "-", 
     OverscriptBox[
      StyleBox["d",
       FontWeight->"Bold",
       FontSlant->"Plain"], "_"], 
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"]}], ")"}], "+", 
   RowBox[{"(", 
    RowBox[{
     StyleBox["d",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["a",
      FontWeight->"Bold",
      FontSlant->"Plain"], "+", 
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     OverscriptBox[
      StyleBox["c",
       FontWeight->"Bold",
       FontSlant->"Plain"], "_"]}], ")"}], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["e",
     FontWeight->"Bold",
     FontSlant->"Plain"], "4"], ","}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"d2c4fe5d-79e0-4569-89bb-6beebf44c4ba"],

Cell[TextData[{
 "with the eight units ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "0"], ",", "\[Ellipsis]", ",", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "3"], ",", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e265062d-e496-45e3-a4a9-420f08b76860"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     RowBox[{"4", "+", 
      StyleBox["j", "TI"]}]], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c42775df-a4e1-4195-b48f-3908acc6299a"],
 ". The norm is multiplicative, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox[
      RowBox[{"x", "y"}],
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["x",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["y",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0678ee4d-e4a1-400a-86e7-e5cfc96cbc0e"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["x",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    OverscriptBox[
     StyleBox["x",
      FontWeight->"Bold",
      FontSlant->"Plain"], "_"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["x",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "0"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c06ab1ad-92df-4706-b46b-d5fee5bab621"],
 ". The product is not associative (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["e",
        FontWeight->"Bold",
        FontSlant->"Plain"], "1"], 
      SubscriptBox[
       StyleBox["e",
        FontWeight->"Bold",
        FontSlant->"Plain"], "2"]}], ")"}], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "4"], "-", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "1"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["e",
        FontWeight->"Bold",
        FontSlant->"Plain"], "2"], 
      SubscriptBox[
       StyleBox["e",
        FontWeight->"Bold",
        FontSlant->"Plain"], "4"]}], ")"}], "\[LongEqual]", "2", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "7"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4c86080f-2683-4ff0-810c-0cbc3c57596c"],
 "), but it is alternative, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     StyleBox[
      RowBox[{"x", "x"}],
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    StyleBox["y",
     FontWeight->"Bold",
     FontSlant->"Plain"], "\[LongEqual]", 
    StyleBox["x",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     StyleBox[
      RowBox[{"x", "y"}],
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "353f62b7-2724-433f-9332-6ddc2ad217b3"],
 ", and satisfies the three Moufang identities ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     StyleBox[
      RowBox[{"z", "x", "z"}],
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    StyleBox["y",
     FontWeight->"Bold",
     FontSlant->"Plain"], "\[LongEqual]", 
    StyleBox["z",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["x",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       StyleBox[
        RowBox[{"z", "y"}],
        FontWeight->"Bold",
        FontSlant->"Plain"], ")"}]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f540798f-16a6-4d30-a185-eb4b898ec089"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["y",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     StyleBox[
      RowBox[{"z", "x", "z"}],
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       StyleBox[
        RowBox[{"y", "z"}],
        FontWeight->"Bold",
        FontSlant->"Plain"], ")"}], 
      StyleBox["x",
       FontWeight->"Bold",
       FontSlant->"Plain"]}], ")"}], 
    StyleBox["z",
     FontWeight->"Bold",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bf42c833-d8ec-4c93-8f4c-91e6c09ae64f"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     StyleBox[
      RowBox[{"z", "x"}],
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    RowBox[{"(", 
     StyleBox[
      RowBox[{"y", "z"}],
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["z",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       StyleBox[
        RowBox[{"x", "y"}],
        FontWeight->"Bold",
        FontSlant->"Plain"], ")"}]}], ")"}], 
    StyleBox["z",
     FontWeight->"Bold",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "35238439-513f-4223-946a-007663e58d05"],
 ". The unit bi-octonions form the Lorentz super-loop ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["\[DoubleStruckCapitalL]",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "198d1250-799c-488c-93f2-d70e9040a92c"],
 ", a Moufang loop of real dimension 14 that contains ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SL", "TI"], 
    RowBox[{"(", 
     RowBox[{"2", ",", 
      StyleBox["\[DoubleStruckCapitalC]",
       FontSlant->"Plain"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "af39ec1f-7311-4073-924c-3ccc780ebd9c"],
 "."
}], "Text",ExpressionUUID->"9be72b18-0142-4198-af12-9c59eb1b088f"],

Cell["\<\
The next cell checks these rules exactly: bi-octonions with small integer \
(Gaussian integer) coefficients are multiplied in exact arithmetic, so every \
identity must hold with the deviation exactly 0. Of the 343 ordered triples \
of imaginary units, 168 have a nonzero associator: a triple with two equal \
members has none (alternativity), and of the 210 triples of distinct units a \
triple has none exactly when its third unit is plus or minus the product of \
the first two, which leaves 210 - 42 = 168.\
\>", "Text",ExpressionUUID->"02cf6212-94f2-4c8e-b8b4-c56644f904bb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"A", "-", "2"}], ":", " ", 
      RowBox[{
      "the", " ", "rules", " ", "of", " ", "the", " ", "eight", " ", 
       "units"}], ":", " ", 
      RowBox[{"e_p", "^", "2"}]}], " ", "=", " ", 
     RowBox[{"-", "1"}]}], ",", " ", 
    RowBox[{
     RowBox[{"e_p", " ", "e_q"}], " ", "=", " ", 
     RowBox[{
      RowBox[{"-", "e_q"}], " ", "e_p", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"p", " ", "!=", " ", "q"}], ",", " ", 
        RowBox[{"both", " ", ">=", " ", "1"}]}], ")"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"e_j", " ", "e_", "4"}], " ", "=", " ", 
     RowBox[{"e_", 
      RowBox[{"(", 
       RowBox[{"4", "+", "j"}], ")"}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"dA2", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Join", "[", "\n", "    ", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"oMax", "[", 
           RowBox[{
            RowBox[{"oMul", "[", 
             RowBox[{
              RowBox[{"oUnit", "[", "p", "]"}], ",", " ", 
              RowBox[{"oUnit", "[", "p", "]"}]}], "]"}], " ", "+", " ", 
            RowBox[{"oUnit", "[", "0", "]"}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"p", ",", " ", "1", ",", " ", "7"}], "}"}]}], "]"}], ",", 
        "\n", "    ", 
        RowBox[{"Flatten", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"p", " ", "!=", " ", "q"}], ",", " ", 
             RowBox[{"oMax", "[", 
              RowBox[{
               RowBox[{"oMul", "[", 
                RowBox[{
                 RowBox[{"oUnit", "[", "p", "]"}], ",", " ", 
                 RowBox[{"oUnit", "[", "q", "]"}]}], "]"}], " ", "+", " ", 
               RowBox[{"oMul", "[", 
                RowBox[{
                 RowBox[{"oUnit", "[", "q", "]"}], ",", " ", 
                 RowBox[{"oUnit", "[", "p", "]"}]}], "]"}]}], "]"}], ",", " ",
              "0"}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"p", ",", " ", "1", ",", " ", "7"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"q", ",", " ", "1", ",", " ", "7"}], "}"}]}], "]"}], 
         "]"}], ",", "\n", "    ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"oMax", "[", 
           RowBox[{
            RowBox[{"oMul", "[", 
             RowBox[{
              RowBox[{"oUnit", "[", "j", "]"}], ",", " ", 
              RowBox[{"oUnit", "[", "4", "]"}]}], "]"}], " ", "-", " ", 
            RowBox[{"oUnit", "[", 
             RowBox[{"4", " ", "+", " ", "j"}], "]"}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"j", ",", " ", "1", ",", " ", "3"}], "}"}]}], "]"}]}], 
       "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WA-2\>\"", ",", 
      " ", "\"\<bi-octonion units: e_p^2 = -1, e_p e_q = -e_q e_p, e_j e_4 = \
e_(4+j) (exact)\>\"", ",", " ", "dA2", ",", " ", "0", ",", " ", "\"\<A-2\>\"",
       ",", " ", "\"\<A-2\>\""}], "]"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"rintBio", "[", "]"}], " ", "is", " ", "a", " ", "random", " ", 
      "bi"}], "-", 
     RowBox[{"octonion", " ", "with", " ", "Gaussian"}], "-", 
     RowBox[{"integer", " ", "coefficients", " ", "between"}], " ", "-", 
     RowBox[{"3", " ", "and", " ", "3"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"rintBio", "[", "]"}], " ", ":=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"RandomInteger", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "3"}], ",", " ", "3"}], "}"}], ",", " ", "4"}], 
         "]"}], " ", "+", " ", 
        RowBox[{"I", " ", 
         RowBox[{"RandomInteger", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "3"}], ",", " ", "3"}], "}"}], ",", " ", "4"}], 
          "]"}]}]}], ",", " ", 
       RowBox[{
        RowBox[{"RandomInteger", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "3"}], ",", " ", "3"}], "}"}], ",", " ", "4"}], 
         "]"}], " ", "+", " ", 
        RowBox[{"I", " ", 
         RowBox[{"RandomInteger", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "3"}], ",", " ", "3"}], "}"}], ",", " ", "4"}], 
          "]"}]}]}]}], "}"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"A", "-", 
      RowBox[{"3", " ", "to", " ", "A"}], "-", 
      RowBox[{
      "6", " ", "on", " ", "200", " ", "random", " ", "triples", " ", 
       RowBox[{"(", 
        RowBox[{"x", ",", " ", "y", ",", " ", "z"}], ")"}]}]}], ",", " ", 
     RowBox[{"in", " ", "exact", " ", "arithmetic"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dA3", ",", " ", "dA4", ",", " ", "dA5", ",", " ", "dA6"}], 
      "}"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], "}"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"x", " ", "=", " ", 
           RowBox[{"rintBio", "[", "]"}]}], ",", " ", 
          RowBox[{"y", " ", "=", " ", 
           RowBox[{"rintBio", "[", "]"}]}], ",", " ", 
          RowBox[{"z", " ", "=", " ", 
           RowBox[{"rintBio", "[", "]"}]}], ",", " ", "zxz"}], "}"}], ",", 
        "\n", "   ", 
        RowBox[{
         RowBox[{"dA3", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"dA3", ",", " ", 
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"oNorm", "[", 
               RowBox[{"oMul", "[", 
                RowBox[{"x", ",", " ", "y"}], "]"}], "]"}], " ", "-", " ", 
              RowBox[{
               RowBox[{"oNorm", "[", "x", "]"}], " ", 
               RowBox[{"oNorm", "[", "y", "]"}]}]}], "]"}]}], "]"}]}], ";", 
         "\n", "   ", 
         RowBox[{"dA4", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"dA4", ",", " ", 
            RowBox[{"oMax", "[", 
             RowBox[{
              RowBox[{"oMul", "[", 
               RowBox[{"x", ",", " ", 
                RowBox[{"oBar", "[", "x", "]"}]}], "]"}], " ", "-", " ", 
              RowBox[{
               RowBox[{"oNorm", "[", "x", "]"}], " ", 
               RowBox[{"oUnit", "[", "0", "]"}]}]}], "]"}]}], "]"}]}], ";", 
         "\n", "   ", 
         RowBox[{"dA5", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"dA5", ",", " ", 
            RowBox[{"oMax", "[", 
             RowBox[{
              RowBox[{"oMul", "[", 
               RowBox[{
                RowBox[{"oMul", "[", 
                 RowBox[{"x", ",", " ", "x"}], "]"}], ",", " ", "y"}], "]"}], 
              " ", "-", " ", 
              RowBox[{"oMul", "[", 
               RowBox[{"x", ",", " ", 
                RowBox[{"oMul", "[", 
                 RowBox[{"x", ",", " ", "y"}], "]"}]}], "]"}]}], "]"}], ",", 
            " ", 
            RowBox[{"oMax", "[", 
             RowBox[{
              RowBox[{"oMul", "[", 
               RowBox[{
                RowBox[{"oMul", "[", 
                 RowBox[{"y", ",", " ", "x"}], "]"}], ",", " ", "x"}], "]"}], 
              " ", "-", " ", 
              RowBox[{"oMul", "[", 
               RowBox[{"y", ",", " ", 
                RowBox[{"oMul", "[", 
                 RowBox[{"x", ",", " ", "x"}], "]"}]}], "]"}]}], "]"}]}], 
           "]"}]}], ";", "\n", "   ", 
         RowBox[{"zxz", " ", "=", " ", 
          RowBox[{"oMul", "[", 
           RowBox[{
            RowBox[{"oMul", "[", 
             RowBox[{"z", ",", " ", "x"}], "]"}], ",", " ", "z"}], "]"}]}], ";",
          "\n", "   ", 
         RowBox[{"dA6", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"dA6", ",", " ", 
            RowBox[{"oMax", "[", 
             RowBox[{
              RowBox[{"oMul", "[", 
               RowBox[{"zxz", ",", " ", "y"}], "]"}], " ", "-", " ", 
              RowBox[{"oMul", "[", 
               RowBox[{"z", ",", " ", 
                RowBox[{"oMul", "[", 
                 RowBox[{"x", ",", " ", 
                  RowBox[{"oMul", "[", 
                   RowBox[{"z", ",", " ", "y"}], "]"}]}], "]"}]}], "]"}]}], 
             "]"}], ",", " ", 
            RowBox[{"oMax", "[", 
             RowBox[{
              RowBox[{"oMul", "[", 
               RowBox[{"y", ",", " ", "zxz"}], "]"}], " ", "-", " ", 
              RowBox[{"oMul", "[", 
               RowBox[{
                RowBox[{"oMul", "[", 
                 RowBox[{
                  RowBox[{"oMul", "[", 
                   RowBox[{"y", ",", " ", "z"}], "]"}], ",", " ", "x"}], 
                 "]"}], ",", " ", "z"}], "]"}]}], "]"}], ",", "\n", "     ", 
            RowBox[{"oMax", "[", 
             RowBox[{
              RowBox[{"oMul", "[", 
               RowBox[{
                RowBox[{"oMul", "[", 
                 RowBox[{"z", ",", " ", "x"}], "]"}], ",", " ", 
                RowBox[{"oMul", "[", 
                 RowBox[{"y", ",", " ", "z"}], "]"}]}], "]"}], " ", "-", " ", 
              
              RowBox[{"oMul", "[", 
               RowBox[{
                RowBox[{"oMul", "[", 
                 RowBox[{"z", ",", " ", 
                  RowBox[{"oMul", "[", 
                   RowBox[{"x", ",", " ", "y"}], "]"}]}], "]"}], ",", " ", 
                "z"}], "]"}]}], "]"}]}], "]"}]}]}]}], "]"}], ",", " ", 
      RowBox[{"{", "200", "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WA-3\>\"", ",", 
      " ", "\"\<N(xy) = N(x) N(y), 200 random Gaussian-integer bi-octonions \
(exact)\>\"", ",", " ", "dA3", ",", " ", "0", ",", " ", "\"\<A-3\>\"", ",", 
      " ", "\"\<A-3\>\""}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WA-4\>\"", ",", " ", "\"\<x xbar = N(x) e_0 (exact)\>\"", ",",
       " ", "dA4", ",", " ", "0", ",", " ", "\"\<A-4\>\"", ",", 
      " ", "\"\<A-4\>\""}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WA-5\>\"", ",", 
      " ", "\"\<alternativity (xx)y = x(xy), (yx)x = y(xx) (exact)\>\"", ",", 
      " ", "dA5", ",", " ", "0", ",", " ", "\"\<A-5\>\"", ",", 
      " ", "\"\<A-5\>\""}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WA-6\>\"", ",", 
      " ", "\"\<the three Moufang identities (exact)\>\"", ",", " ", "dA6", ",",
       " ", "0", ",", " ", "\"\<A-6\>\"", ",", " ", "\"\<A-6\>\""}], "]"}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"A", "-", "7"}], ":", " ", 
      RowBox[{
      "the", " ", "associators", " ", "of", " ", "the", " ", "343", " ", 
       "ordered", " ", "triples", " ", "of", " ", "imaginary", " ", 
       "units"}]}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"and", " ", 
        RowBox[{"(", 
         RowBox[{"e1", " ", "e2"}], ")"}], " ", "e4"}], " ", "-", " ", 
       RowBox[{"e1", " ", 
        RowBox[{"(", 
         RowBox[{"e2", " ", "e4"}], ")"}]}]}], " ", "=", " ", 
      RowBox[{"2", " ", "e7"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"nonzeroAssociators", " ", "=", " ", 
     RowBox[{"Count", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"oMax", "[", 
           RowBox[{
            RowBox[{"oMul", "[", 
             RowBox[{
              RowBox[{"oMul", "[", 
               RowBox[{
                RowBox[{"oUnit", "[", "p", "]"}], ",", " ", 
                RowBox[{"oUnit", "[", "q", "]"}]}], "]"}], ",", " ", 
              RowBox[{"oUnit", "[", "r", "]"}]}], "]"}], " ", "-", " ", 
            RowBox[{"oMul", "[", 
             RowBox[{
              RowBox[{"oUnit", "[", "p", "]"}], ",", " ", 
              RowBox[{"oMul", "[", 
               RowBox[{
                RowBox[{"oUnit", "[", "q", "]"}], ",", " ", 
                RowBox[{"oUnit", "[", "r", "]"}]}], "]"}]}], "]"}]}], "]"}], ",",
           "\n", "      ", 
          RowBox[{"{", 
           RowBox[{"p", ",", " ", "1", ",", " ", "7"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"q", ",", " ", "1", ",", " ", "7"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"r", ",", " ", "1", ",", " ", "7"}], "}"}]}], "]"}], "]"}],
        ",", " ", 
       RowBox[{"v_", " ", "/;", " ", 
        RowBox[{"v", " ", ">", " ", "0"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"a124", " ", "=", " ", 
     RowBox[{
      RowBox[{"oMul", "[", 
       RowBox[{
        RowBox[{"oMul", "[", 
         RowBox[{
          RowBox[{"oUnit", "[", "1", "]"}], ",", " ", 
          RowBox[{"oUnit", "[", "2", "]"}]}], "]"}], ",", " ", 
        RowBox[{"oUnit", "[", "4", "]"}]}], "]"}], " ", "-", " ", 
      RowBox[{"oMul", "[", 
       RowBox[{
        RowBox[{"oUnit", "[", "1", "]"}], ",", " ", 
        RowBox[{"oMul", "[", 
         RowBox[{
          RowBox[{"oUnit", "[", "2", "]"}], ",", " ", 
          RowBox[{"oUnit", "[", "4", "]"}]}], "]"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"checkTrue", "[", 
     RowBox[{"\"\<WA-7\>\"", ",", 
      " ", "\"\<168 of the 343 triples of imaginary units have a nonzero \
associator; (e1 e2) e4 - e1 (e2 e4) = 2 e7\>\"", ",", "\n", "  ", 
      RowBox[{
       RowBox[{"nonzeroAssociators", " ", "==", " ", "168"}], " ", "&&", " ", 
       
       RowBox[{
        RowBox[{"oMax", "[", 
         RowBox[{"a124", " ", "-", " ", 
          RowBox[{"2", " ", 
           RowBox[{"oUnit", "[", "7", "]"}]}]}], "]"}], " ", "==", " ", 
        "0"}]}], ",", " ", 
      RowBox[{
       RowBox[{"ToString", "[", "nonzeroAssociators", "]"}], " ", "<>", 
       " ", "\"\< nonzero\>\""}], ",", " ", "\"\<A-7\>\"", ",", 
      " ", "\"\<A-7\>\""}], "]"}], ";"}]}]}]], "Input",
 CellLabel->"In[51]:=",ExpressionUUID->"6a2a59dc-39a0-4109-8e45-803422f1a23f"],

