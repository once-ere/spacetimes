        RowBox[{
         RowBox[{"k8", "[", "3", "]"}], " ", ".", " ", 
         RowBox[{"sol", "[", "\"\<p\>\"", "]"}]}], "]"}], "/", "8"}], "]"}]}],
     ";"}], "\n", 
