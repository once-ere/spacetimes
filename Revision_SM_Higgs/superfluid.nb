Cell[CellGroupData[{

Cell["\<\
II.1 The pair channels and the gauge bosons that mediate the pairing\
\>", "Section",ExpressionUUID->"fd41c875-9b90-4de1-8b8c-4724f82a4122"],

Cell[TextData[{
 "The spin-zero pairs are the six antisymmetric unitary matrices ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d0e23c07-a61b-446d-a0f6-e726867262a1"],
 " (scalar, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["0", "+"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bd1e1655-32aa-4099-8eb1-e62f7aea6ad8"],
 ") and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     RowBox[{"\[Prime]", "\[Iota]"}]], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[CircleTimes]", 
    SubscriptBox[
     StyleBox["E",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Tau]", "\[Iota]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6be5f722-2217-47e0-933c-6118b558dc9b"],
 " (pseudoscalar, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["0", "-"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e207a8a7-d5c5-4249-9851-25ec5b9061bc"],
 "). The state of two spinor charges at one point in the channel ",
 Cell[BoxData[
  FormBox[
   StyleBox["K",
    FontFamily->"Helvetica",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "94d35214-6e12-4be1-99d4-797e84c0047f"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftBracketingBar]", 
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "\[RightAngleBracket]", "\[Proportional]", 
    FractionBox["1", "2"], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["c", "TI"], 
      SuperscriptBox[
       StyleBox["c", "TI"], "\[Prime]"]}],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["c", "TI"], 
      SuperscriptBox[
       StyleBox["c", "TI"], "\[Prime]"]}], "*"], 
    SubsuperscriptBox["\[CapitalPsi]", 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["c", "TI"]}], "\[Dagger]"], 
    SubsuperscriptBox["\[CapitalPsi]", 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      SuperscriptBox[
       StyleBox["c", "TI"], "\[Prime]"]}], "\[Dagger]"], "\[LeftBracketingBar]",
     "0", "\[RightAngleBracket]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "277127f7-b78f-4d45-a4e9-a081bae75299"],
 ", normalized, and the pair energy of a contact operator ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[ScriptCapitalO]",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d47dd5c9-adb6-47b4-94cf-9af9673c47f8"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["pair",
      FontSlant->"Plain"]], 
    RowBox[{"[", 
     RowBox[{
      StyleBox["\[ScriptCapitalO]",
       FontSlant->"Plain"], ";", 
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"]}], "]"}], "\[LongEqual]", 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "\[RightBracketingBar]", 
      StyleBox["\[ScriptCapitalO]",
       FontSlant->"Plain"], "\[LeftBracketingBar]", 
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"]}], "\[RightAngleBracket]"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b59911f4-bb6f-4f0b-b89b-666e12a5845f"],
 ", per unit coupling; negative means attraction. The operators are the three \
terms of the potentials and the contact limit of the exchange of the four \
gauge bosons of GEE, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", 
     StyleBox["p", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox["\[Eta]", 
     StyleBox["pp", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], ":", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["\[CapitalPsi]", "\[Dagger]"], 
       SubsuperscriptBox[
        StyleBox["A",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["SF",
          FontSlant->"Plain"], ",", 
         StyleBox["p", "TI"]}], 
        StyleBox["b",
         FontSlant->"Plain"]], "\[CapitalPsi]"}], ")"}], "2"], ":"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fe985a62-f4b1-4585-adb4-a7bb550b7dfb"],
 " with the vertex matrices ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["A",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], 
     StyleBox["b",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["\[Gamma]", 
       StyleBox["LL",
        FontSlant->"Plain"], "0"], 
      SubsuperscriptBox["\[Gamma]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["p", "TI"]]}], ")"}], "\[CircleTimes]", 
    SubsuperscriptBox[
     StyleBox["t",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["b",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "37757d2e-6912-4aef-8d05-d2c422331ac5"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["t",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["b",
      FontSlant->"Plain"]], "\[LongEqual]", 
    FractionBox["1", "2"], 
    SubsuperscriptBox["\[Tau]", "\[Iota]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b693a50c-305f-4593-b25d-b02a97accdd5"],
 " for ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1e6657e2-6b4d-4f61-b7c4-222b874e4387"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["1",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9a2cdb3d-3466-4892-ac21-69f63ebe2096"],
 " for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "47dd2ab0-6ca0-4be1-b85b-e6046687224d"],
 "). The result: the scalar term has ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8bc9eeb9-e4d0-4a98-855b-a66ed935a998"],
 " in the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["0", "+"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "14f15e76-9f5f-4457-a85c-090fa8895b70"],
 " channels and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5c27238b-1022-4864-abfc-426090677cb7"],
 " in the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["0", "-"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0693f20f-a9d1-4ed7-a4b3-a8413e842405"],
 " channels, the vector term ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", "4"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "729e8461-bf54-42dd-9125-18d13a223cfb"],
 " everywhere, the pairing term ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "4"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c5c2b2cd-97a9-49ae-86fe-3acc19235c0e"],
 " in the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["0", "+"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "96f085be-a526-4be2-9b02-01a6b8a1d21b"],
 " channels, each ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6b07bffc-2f10-4b8e-b38e-82935b755917"],
 " attracts (",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "24c29403-5d11-4aed-b100-81e432ba27b3"],
 ") in the two channels with the same index and repels (",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f1c5faf0-f827-4dad-835b-d70aec750c22"],
 ") in the other four, and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "45bdb2d7-3c67-45e7-9558-00c8006d25b6"],
 " repels (",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", "4"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "22ca7d5c-b66d-4fa6-bb0b-7c1caee534a4"],
 ") everywhere. In every channel"
}], "Text",ExpressionUUID->"85dd6a78-8f7f-49f5-a830-c00a038e740a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   UnderoverscriptBox["\[Sum]", 
    RowBox[{"\[Iota]", "\[LongEqual]", "1"}], "3",
    LimitsPositioning->True], "\[ThinSpace]", 
   SubsuperscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["pair",
     FontSlant->"Plain"]], 
   RowBox[{"[", 
    RowBox[{
     SuperscriptBox[
      StyleBox["W", "TI"], "\[Iota]"], ";", 
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"]}], "]"}], "\[LongEqual]", 
   FractionBox["1", "4"], 
   SubsuperscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["pair",
     FontSlant->"Plain"]], 
   RowBox[{"[", 
    RowBox[{
     StyleBox["B", "TI"], ";", 
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"]}], "]"}], "\[LongEqual]", 
   RowBox[{"+", "1"}], ","}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"ade026d4-d6f5-498f-9efc-2bf5b78dd242"],

Cell[TextData[{
 "the isospin Casimir of a triplet pair (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["T", "TI"], "\[RightVector]"], "1"], "\[CenterDot]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["T", "TI"], "\[RightVector]"], "2"], "\[LongEqual]", 
    RowBox[{"+", 
     FractionBox["1", "4"]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "40378369-57f1-44f3-8577-84b025b80053"],
 "): no gauge boson attracts a spin-zero pair in the symmetric vacuum. After \
the breaking of the symmetry in the channel ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "db62b07a-6687-448b-99cc-0ce723f0d3d0"],
 ", the gauge field ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ac9a1cda-5dbd-4eee-84b9-348f09c1f21f"],
 " of the unbroken generator stays massless (the zeugon, the massless gauge \
boson of the superfluid; not the photon, since the DiracLike spinor has \
electric charge 0) and attracts the two charges of the condensed pair, which \
carry the opposite charges ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["T", "TI"], "3"], "\[LongEqual]", 
    RowBox[{"\[PlusMinus]", 
     FractionBox["1", "2"]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "58a93fe0-98c6-4471-8621-ec19575a0ffd"],
 ". The next cell computes the 42 pair energies exactly on the 256 states of \
one point (with the operators of Section I.5) and compares them with the \
table of the Rust program."
}], "Text",ExpressionUUID->"3d700e72-5842-4d2f-b117-9f6c88d11682"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"kPs", "[", "iota", "]"}], ":", " ", 
     RowBox[{"the", " ", "matrices", " ", 
      RowBox[{
       RowBox[{"K", "'"}], "^", "iota_LL"}]}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{"C_LL", " ", 
      RowBox[{"(", "x", ")"}], " ", "E_LL", " ", "tau_iota", " ", "of", " ", 
      "the", " ", "pseudoscalar", " ", "spin"}], "-", 
     RowBox[{"zero", " ", "pairs"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"kPs", "[", "iota_Integer", "]"}], " ", ":=", " ", 
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{"cLL", ",", " ", 
       RowBox[{"eLL", " ", ".", " ", 
        RowBox[{"sig", "[", 
         RowBox[{"[", 
          RowBox[{"iota", " ", "+", " ", "1"}], "]"}], "]"}]}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"pairState", "[", "k", "]"}], ":", " ", 
      RowBox[{
      "the", " ", "normalized", " ", "state", " ", "of", " ", "two", " ", 
       "charges", " ", "at", " ", "one", " ", "point", " ", "in", " ", "the", 
       " ", "channel", " ", "k"}], ":", " ", 
      RowBox[{
       RowBox[{"sum_ab", " ", "conj", 
        RowBox[{"(", "k_ab", ")"}], " ", 
        RowBox[{"c_a", "^", "dag"}], " ", 
        RowBox[{"c_b", "^", "dag"}]}], " ", "|", 
       RowBox[{"0", ">"}]}]}], ";", "\n", "   ", 
     RowBox[{
      RowBox[{"the", " ", "empty", " ", "state"}], " ", "|", 
      RowBox[{"0", ">", " ", 
       RowBox[{
       "is", " ", "the", " ", "first", " ", "basis", " ", "state"}]}]}]}], 
    " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"pairState", "[", "k_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"op", ",", " ", "w"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"op", " ", "=", " ", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"k", "[", 
               RowBox[{"[", 
                RowBox[{"a", ",", " ", "b"}], "]"}], "]"}], " ", "=!=", " ", 
              "0"}], ",", " ", 
             RowBox[{
              RowBox[{"Conjugate", "[", 
               RowBox[{"k", "[", 
                RowBox[{"[", 
                 RowBox[{"a", ",", " ", "b"}], "]"}], "]"}], "]"}], " ", 
              RowBox[{
               RowBox[{"cdOps", "[", 
                RowBox[{"[", "a", "]"}], "]"}], " ", ".", " ", 
               RowBox[{"cdOps", "[", 
                RowBox[{"[", "b", "]"}], "]"}]}]}], ",", " ", "0"}], "]"}], ",",
            " ", 
           RowBox[{"{", 
            RowBox[{"a", ",", " ", "8"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"b", ",", " ", "8"}], "}"}]}], "]"}]}], ";", "\n", "   ", 
        
        RowBox[{"w", " ", "=", " ", 
         RowBox[{"op", " ", ".", " ", 
          RowBox[{"UnitVector", "[", 
           RowBox[{"256", ",", " ", "1"}], "]"}]}]}], ";", "\n", "   ", 
        RowBox[{"w", "/", 
         RowBox[{"Norm", "[", "w", "]"}]}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"the", " ", "seven", " ", "contact", " ", 
     RowBox[{"operators", ":", " ", 
      RowBox[{
      "the", " ", "three", " ", "terms", " ", "of", " ", "the", " ", 
       "potentials", " ", "and", " ", "the", " ", "contact", " ", "limit", " ",
        "of", " ", "the", " ", "four", " ", "gauge", " ", "bosons"}]}]}], " ",
     "*)"}], "\n", 
   RowBox[{
    RowBox[{"channelOps", " ", "=", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<scalar\>\"", " ", "->", " ", 
        RowBox[{
         RowBox[{"1", "/", "2"}], " ", 
         RowBox[{"quartic", "[", 
          RowBox[{"beta8", ",", " ", "beta8"}], "]"}]}]}], ",", "\n", "   ", 
       RowBox[{"\"\<vector\>\"", " ", "->", " ", 
