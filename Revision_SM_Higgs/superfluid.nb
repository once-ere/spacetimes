Cell[CellGroupData[{

Cell["III.L.6 Why it matters", "Section",ExpressionUUID->"1ec966a4-7b70-476c-b56a-9d8532e34153"],

Cell[TextData[{
 StyleBox["It enters no other result.",
  FontWeight->"Bold"],
 " The effective Lagrangians of the solution contain the computed function ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalV]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3e243dc3-86f1-4317-9e9e-30d4ff721b6e"],
 ", not the Landau form, and no other result uses ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a3fc9d1b-3ec8-4cd9-91a3-e04f693f5a5b"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["b", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "97af7889-ff7f-4970-92ed-b1a9e3ee6eb6"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b20a42e5-e559-4806-86fd-16feb1e5fee0"],
 ": the mass of the amplitude mode uses the curvature ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalV]",
     FontSlant->"Plain"], 
    StyleBox["amp",
     FontSlant->"Plain"], "\[Prime]\[Prime]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "abe554b5-df0f-461f-b5a9-a7f3620d3a3f"],
 " of the computed curve, ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["u", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "84466271-9669-4891-86b8-777684665e45"],
 " and the mass of the non-unitary modes use the computed curvature in the \
non-unitary direction, and the masses of the gauge bosons and the dynamics \
use ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalPhi]", 
    RowBox[{"0", ",", 
     StyleBox["SF",
      FontSlant->"Plain"]}], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ad3c99a8-b6d5-454d-acd2-2e9b5413464d"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["Z", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "269a17b1-c878-4bf0-b512-d8c73f870351"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["Y", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "19496108-1d4f-4904-b955-02cfa541eedf"],
 " and the susceptibilities."
}], "ItemNumbered",ExpressionUUID->"7447b7b1-5ced-4d9a-b0d6-4f2c6eb45a67"],

Cell[TextData[{
 StyleBox["It matters to whoever replaces $\\mathcal V^X_{\\rm SF}$ by the \
Landau form",
  FontWeight->"Bold"],
 ", as in a model of the type of Ginzburg and Landau or of Higgs: the minimum \
of the polynomial is 0.04 to 0.11 per cent too small, its depth 0.12 to 0.31 \
per cent too large, its curvature at its minimum 0.86 to 2.3 per cent too \
large, and the mass of the amplitude mode 0.43 to 1.1 per cent too large (the \
table above). A derivative enlarges the relative error of the function. \
Beyond the fitted interval the error grows: fitted on the whole computed \
curve, the form misses by 1.2 to 1.7 per cent of the depth."
}], "ItemNumbered",ExpressionUUID->"17cce5c7-e588-43b8-939a-85a1712f7932"],

Cell[TextData[{
 StyleBox["The coefficients are not constants of the theory.",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e59f371d-b99d-4c2d-ba36-6c97f6bf191f"],
 " differs from the Taylor coefficient at the origin, and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["b", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1909f77e-fe83-40eb-9fa8-724320f08f1a"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "34dec29d-a598-4d4a-9970-decb0562f842"],
 " change with the fitted interval and with the number of powers (the last \
four rows of the table). No physical meaning may be given to ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["b", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9f472bee-a1b7-447b-9563-3074b3a9febb"],
 " or ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "914e20b3-6caf-43b7-9e52-84e87841bd4a"],
 " alone. The physical quantities are those that the computed function \
defines: ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalPhi]", 
    RowBox[{"0", ",", 
     StyleBox["SF",
      FontSlant->"Plain"]}], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fd51f968-6c61-4fc9-9cd0-bf46514b5fe9"],
 ", the depth, the curvatures at the minimum, and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["Tay",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cc34cfb4-dab8-46b0-9b2a-b6bf5e791af8"],
 "."
}], "ItemNumbered",ExpressionUUID->"28eeb104-ad46-4706-8ae7-c0649762fc01"],

Cell[TextData[{
 StyleBox["The qualitative results do not depend on the fit.",
  FontWeight->"Bold"],
 " That ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalV]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "182429e7-5448-4d85-a8c3-7021808fcea4"],
 " vanishes at the origin, is negative near it, has its minimum at ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalPhi]", 
    RowBox[{"0", ",", 
     StyleBox["SF",
      FontSlant->"Plain"]}], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "da12bde0-d3b7-4b7d-8d3c-4e9b626ac30f"],
 ", depends only on the two invariants, and has a stable polar minimum (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["u", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], ">", "0"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f192f0dc-4689-4a06-8359-f9d1dc7a3efa"],
 ") are properties of the computed function, checked on it directly; the sign \
of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "188b568d-52d2-4287-86b1-65189ac87390"],
 " is that of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["Tay",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "31df77fd-e6d3-4f40-9bd1-5f62c35a8041"],
 " (negative: the normal vacuum is unstable)."
}], "ItemNumbered",ExpressionUUID->"81d587d9-9f2e-4526-a687-bf45a8b8fef4"],

Cell[TextData[{
 StyleBox["The comparison with the Standard Model.",
  FontWeight->"Bold"],
 " The field has a Mexican hat with the symmetry structure of the Higgs \
sector and of the polar phase of a condensate of spin 1, but its potential is \
not the quartic potential of the Standard Model: the quartic form misses ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalV]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "67f19016-50b4-4123-b41e-40d133191c80"],
 " by 2.8 to 5.9 per cent of the depth, about ten times more than the Landau \
form with the sixth power."
}], "ItemNumbered",ExpressionUUID->"a6c5d0c0-c832-4398-9b25-d6e2b89eb741"],

Cell[TextData[{
 StyleBox["Corrections of the first answers.",
  FontWeight->"Bold"],
 " The first answers to the author contained five statements that were not \
exact; the numbers of this chapter are the corrected ones. (1) The residual \
changes its sign three times, not five. (2) The fit called a fit on ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"0", ",", "2", 
     SubscriptBox["\[CapitalPhi]", "0"]}], "]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f5a494a0-c3d0-48f7-98c6-f64bb68c5dc5"],
 " used all 61 points of the curve, whose fields reach 1.52 to 1.64 times ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalPhi]", 
    RowBox[{"0", ",", 
     StyleBox["SF",
      FontSlant->"Plain"]}], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2e768519-9c3e-4525-bd81-41853922823e"],
 "; the applied field, not the field of the states, reaches ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    SubsuperscriptBox["\[CapitalPhi]", 
     RowBox[{"0", ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a73f9c67-3c4b-443a-ad07-590c48b017b9"],
 ". (3) The range of the end of the curve is 1.52 to 1.64 (HS ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "0"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "789ab4ba-f0be-45b0-acc7-9b25471d9c54"],
 "), not 1.52 to 1.61. (4) The singularity lies at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"], "2"], "\[LongEqual]", 
    RowBox[{"-", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["M", "TI"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["X", "TI"], ",", 
         StyleBox["D",
          FontSlant->"Plain"]}]], ")"}], "2"]}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "68f1f8ca-4235-4a63-97e9-aa6d188601e7"],
 " in the applied field; in the field of the states the radius of convergence \
is of the order of the Dirac mass, not equal to it. (5) The errors of the \
curvature quoted first, 1.1 to 2.7 per cent, are those of the polynomial at \
the minimum of the computed curve; at the polynomial's own minimum, where a \
user evaluates it, they are 0.86 to 2.3 per cent, as the table shows."
}], "Text",ExpressionUUID->"2404e2ad-6922-4ab5-9119-ee603359eb6c"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Part III, second section. The free energy at finite temperature: the critical \
temperatures and the size of the order parameter\
\>", "Chapter",ExpressionUUID->"18356e26-572f-4bf2-bad0-c02d69b397b0"],

Cell[TextData[{
 "On 21 November 2026 the author asked to add to the analysis and the \
solution the effective potential and the free energy of each of the five \
computed methods ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0da384e6-06e6-4d66-bc04-d5d54b4994b8"],
 " (HS ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"1", ",", "1"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "83088da1-d21e-4a3f-8e5e-ca14150b7186"],
 ", HS ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "1"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4e8e568f-1fd5-49f8-a807-7e4fd5505e1c"],
 ", HS ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "0"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "28d6ee6e-6e26-4fcf-9ad6-30826d6aff29"],
 ", KS and CJT), to determine whether the order parameter is then smaller and \
more physically reasonable, and to document this addendum with its \
provenance. The effective potential of each method is the subject of Section \
III.L. This chapter computes the free energy at the temperature ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "77eb25fe-f169-476e-bd6b-3a7ac951be67"],
 " with the engine of Part II, shows that its value at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "55538e9e-0860-44b3-a86c-4464708c932c"],
 " is the effective potential, finds the critical temperatures, and answers \
the question (Section III.T.6). The Rust program ",
 StyleBox["sf_part3",
  FontFamily->"Source Code Pro"],
 " (module ",
 StyleBox["thermal",
  FontFamily->"Source Code Pro"],
 ") and the Python program ",
 StyleBox["sf_part3.py",
  FontFamily->"Source Code Pro"],
 " compute the same things; the closed cell of Section III.T.2 holds their \
values for the comparison."
}], "Text",ExpressionUUID->"2c76dd8a-b241-4f22-98e5-37fe13cb870e"],

Cell[CellGroupData[{

Cell["III.T.1 The free energy of a state at the temperature T", "Section",ExpressionUUID->"db41daef-b8bb-4947-a131-4bbee4e91a9f"],

Cell[TextData[{
 StyleBox["Units and conditions.",
  FontWeight->"Bold"],
 " The temperature ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7607ddb7-5190-4f8d-8c48-7727b2eff96c"],
 " is measured in units of energy (Boltzmann's constant ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["k", "TI"], 
     StyleBox["B",
      FontSlant->"Plain"]], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "386a6627-fc59-49d9-bb0d-e8154bf2a5e2"],
 "), in the units of the project (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "292ce351-a2f7-463e-b42a-896af474f282"],
 "). The chemical potential ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Mu]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fa7ac1d4-405a-4dea-9765-8ddacdabaf1f"],
 " of the fermion number is zero, as everywhere in the solution: the states \
hold as many particles as antiparticles. ",
 StyleBox["The thermal states.",
  FontWeight->"Bold"],
 " At the temperature ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9af3a31e-52d6-400c-89c5-b51c04590222"],
 " a uniform quasi-free state is the thermal state of its matrix of \
Bogoliubov and de Gennes ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["H",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d6fe8dca-8791-461a-955d-c78da6e222d4"],
 " (Section II.2): at every momentum its generalized density, the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"16", "\[Times]", "16"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "955fd8da-9ecd-4389-a100-9d1994d9a93e"],
 " matrix of the normal and the pair correlations, is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["f", "TI"], 
    RowBox[{"(", 
     SubscriptBox[
      StyleBox["H",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["SF",
       FontSlant->"Plain"]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0d5c998e-9c15-49b0-b2ed-60a78ac1d783"],
 ", the Fermi function ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["f", "TI"], 
    RowBox[{"(", "\[CurlyEpsilon]", ")"}], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        StyleBox["e", "TI"], 
        RowBox[{"\[CurlyEpsilon]", "/", 
         StyleBox["T", "TI"]}]], "+", "1"}], ")"}], 
     RowBox[{"-", "1"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3422c080-62db-42e6-9d16-2998582dc47b"],
 " applied to the eigenvalues ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CurlyEpsilon]", 
    StyleBox["k", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6b6bd998-a78b-4c15-9a02-aae950feb448"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["k", "TI"], "\[LongEqual]", "1", ",", "\[Ellipsis]", ",", "16"}],
    TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bad56f22-49e6-4f0a-a702-21e5989379df"],
 ") of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["H",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3fa40d7a-f51d-4dff-96ab-527aeefcfecd"],
 ", with the occupations ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["f", "TI"], 
     StyleBox["k", "TI"]], "\[LongEqual]", 
    StyleBox["f", "TI"], 
    RowBox[{"(", 
     SubscriptBox["\[CurlyEpsilon]", 
      StyleBox["k", "TI"]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c90d6085-8066-431e-aef6-dcd81eb3f55d"],
 ". At ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "73fbea60-72c5-4077-89a8-312fbcdcd18b"],
 " the Fermi function is 1 for the negative and 0 for the positive \
eigenvalues, and the thermal state is the ground state of Part II. ",
 StyleBox["The free energy",
  FontWeight->"Bold"],
 " per volume of method ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "29ec78a6-649b-4fec-bda3-7caeb88f59d9"],
 " is"
}], "Text",ExpressionUUID->"c7d2fc0c-efa1-428d-b558-9e1c7066b748"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalE]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], "-", 
   StyleBox["T", "TI"], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["\[ScriptCapitalS]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"]], ",", "      ", 
   SubscriptBox[
    StyleBox["\[ScriptCapitalS]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"]], "\[LongEqual]", 
   RowBox[{"-", 
    FractionBox["1", "2"]}], "\[ThinSpace]", "\[Integral]", 
   FractionBox[
    RowBox[{
     SuperscriptBox[
      StyleBox["d", "TI"], "3"], 
     StyleBox["q", "TI"]}], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"2", "\[Pi]"}], ")"}], "3"]], "\[ThinSpace]", 
   UnderoverscriptBox["\[Sum]", 
    RowBox[{
     StyleBox["k", "TI"], "\[LongEqual]", "1"}], "16",
    LimitsPositioning->True], 
   RowBox[{"[", 
    RowBox[{
     SubscriptBox[
      StyleBox["f", "TI"], 
      StyleBox["k", "TI"]], "\[ThinSpace]", 
     StyleBox["ln",
      FontSlant->"Plain"], "\[ThinSpace]", 
     SubscriptBox[
      StyleBox["f", "TI"], 
      StyleBox["k", "TI"]], "+", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       SubscriptBox[
        StyleBox["f", "TI"], 
        StyleBox["k", "TI"]]}], ")"}], "\[ThinSpace]", 
     StyleBox["ln",
      FontSlant->"Plain"], 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       SubscriptBox[
        StyleBox["f", "TI"], 
        StyleBox["k", "TI"]]}], ")"}]}], "]"}], ","}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"4549c054-2a0f-42fd-82d1-a5b65d9bb186"],

Cell[TextData[{
 "with the energy per volume ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalE]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "136e78f0-d8f6-44ac-ac37-ca4701629985"],
 " of method ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "af98f3f4-b1de-42cf-a942-b963e08cfbbf"],
 " (unchanged, Section II.2) and the entropy per volume ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["\[ScriptCapitalS]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e84fb86f-0cdd-42e8-936f-46c687a9fc18"],
 " of the quasi-free state. Every mode of the doubled space of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["H",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "33e5a1bf-3a54-4612-932f-b119c5c5b52a"],
 " appears twice, at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", "\[CurlyEpsilon]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c3e09a71-9986-40b0-8f31-f9e5b99c20bf"],
 " with the occupations ",
 Cell[BoxData[
  FormBox[
   StyleBox["f", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f27223ea-617a-4402-9137-1292dd5f10de"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "-", 
    StyleBox["f", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "262363a7-9817-42cf-8d12-077134b5e977"],
 ", hence the factor ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "329ce163-4c33-4abe-adb8-d2a9c34ec40e"],
 ". The self-energies are the derivatives of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalE]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "94322b6f-8c02-4c95-a7a7-ae07d669e7b6"],
 " as at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "14d78999-9071-40bc-8996-72ef6439237e"],
 ", and the stationary points of the free energy are the self-consistent \
thermal states. In HS this is the free energy of the saddle point of the \
auxiliary fields; in CJT the effective action at the temperature ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2753e51b-4916-4ccb-9de3-ab7f76f2287d"],
 " with the truncation of the method at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5c072c7c-47e7-4867-b392-80e023bf9284"],
 "; in KS the functional of N. D. Mermin (the theory of Hohenberg, Kohn and \
Sham at finite temperature) with the entropy of the quasi-free state of Kohn \
and Sham and the exchange-correlation energy of the method at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fcb5e847-e84c-484b-a735-ad54f6ef2d83"],
 " (in the exact theory of Mermin the exchange-correlation free energy \
depends on the temperature; here only the states do, an approximation of the \
method). ",
 StyleBox["The free energy of the field",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[CapitalPhi]", "\[RightVector]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3c0afd25-4b39-4978-aeee-aa54c9909fc6"],
 " is the smallest free energy among the thermal states with this field, \
measured from the normal state at the same temperature:"
}], "Text",ExpressionUUID->"e9246c4f-6fd2-4c08-b7f9-02704e656c93"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalF]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], 
   RowBox[{"(", 
    RowBox[{
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], ";", 
     StyleBox["T", "TI"]}], ")"}], "\[LongEqual]", 
   StyleBox["min",
    FontSlant->"Plain"], 
   RowBox[{"{", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["\[ScriptCapitalE]",
       FontSlant->"Plain"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      StyleBox["X", "TI"]], "-", 
     StyleBox["T", "TI"], 
     SubscriptBox[
      StyleBox["\[ScriptCapitalS]",
       FontSlant->"Plain"], 
      StyleBox["SF",
       FontSlant->"Plain"]], ":", " ", 
     SubsuperscriptBox[
      OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      StyleBox["X", "TI"]], "\[LongEqual]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"]}], "}"}], "-", 
   SubscriptBox[
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["\[ScriptCapitalE]",
        FontSlant->"Plain"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["X", "TI"]], "-", 
      StyleBox["T", "TI"], 
      SubscriptBox[
       StyleBox["\[ScriptCapitalS]",
        FontSlant->"Plain"], 
       StyleBox["SF",
        FontSlant->"Plain"]]}], ")"}], 
    StyleBox["normal",
     FontSlant->"Plain"]], "."}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"9b9ff8de-00a3-4915-a0b1-8b1076c2eb06"],

Cell[TextData[{
 "It is computed point by point as the effective potential of Section III.L: \
a fixed pair self-energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "eb4e8b8a-b7bd-4d08-a0dc-ee2edc1f3156"],
 " (the applied field) is put into ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["H",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9680b494-3812-4730-9c0c-bb6f60e63bfe"],
 ", the normal self-energy is made self-consistent at the temperature ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0f7dd223-edd7-4ab7-bf95-501a7960da4d"],
 ", and the thermal state gives one point, its own field ",
 Cell[BoxData[
  FormBox["\[CapitalPhi]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "89f6e7f1-6a4f-4e06-94e7-dec0a57337c9"],
 " and its free energy. Its minimum lies at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}], "\[LongEqual]", 
    SubsuperscriptBox["\[CapitalPhi]", 
     RowBox[{"0", ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b0dc6b01-ee50-47d9-8a70-7d2369c839b7"],
 ", the ",
 StyleBox["order parameter at the temperature $T$",
  FontWeight->"Bold"],
 ": the modulus of the field of the self-consistent superfluid at ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2bcf6595-98c6-41ff-8961-4a5b9842904f"],
 ". At ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9020e98b-4723-4620-85d5-24599d3eb7e7"],
 " the entropy vanishes and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalF]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], 
    RowBox[{"(", 
     RowBox[{
      OverscriptBox["\[CapitalPhi]", "\[RightVector]"], ";", "0"}], ")"}], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalV]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], 
    RowBox[{"(", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], ")"}]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "56d1e46f-8eb9-44f5-aea2-d91e50cf7445"],
 ": ",
 StyleBox["the effective potential is the free energy at zero temperature",
  FontWeight->"Bold"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalPhi]", 
     RowBox[{"0", ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]], 
    RowBox[{"(", "0", ")"}], "\[LongEqual]", 
    SubsuperscriptBox["\[CapitalPhi]", 
     RowBox[{"0", ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a13d680e-f135-407e-b829-fb35995ad283"],
 ". The next cell defines the thermal states of the engine of Part II: ",
 StyleBox["thermalNode",
  FontFamily->"Source Code Pro"],
 " makes ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["f", "TI"], 
    RowBox[{"(", 
     SubscriptBox[
      StyleBox["H",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["SF",
       FontSlant->"Plain"]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9bd7ca60-0efc-4ae4-8aea-8d63f4ac5473"],
 " and the entropy of one node of the grid, ",
 StyleBox["solveSFT",
  FontFamily->"Source Code Pro"],
 " the self-consistent thermal state, and ",
 StyleBox["fixedPairT",
  FontFamily->"Source Code Pro"],
 " the thermal state of an applied pair field."
}], "Text",ExpressionUUID->"4683b2d6-2363-4994-898a-d35a334c46c5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"fermiSF", "[", 
     RowBox[{"e", ",", " ", "t"}], "]"}], ":", " ", 
    RowBox[{"the", " ", "Fermi", " ", "function", " ", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"e", "^", 
         RowBox[{"(", 
          RowBox[{"e", "/", "t"}], ")"}]}], " ", "+", " ", "1"}], ")"}]}], " ",
      "of", " ", "the", " ", "energy", " ", "e", " ", "at", " ", "the", " ", 
     "temperature", " ", "t", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"the", " ", "step", " ", "function", " ", "at", " ", "t"}], 
       " ", "=", " ", "0"}], ")"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"fermiSF", "[", 
      RowBox[{
       RowBox[{"e_", "?", "NumericQ"}], ",", " ", 
       RowBox[{"t_", "?", "NumericQ"}]}], "]"}], " ", ":=", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"t", " ", "<=", " ", "0"}], ",", " ", 
       RowBox[{"Which", "[", 
        RowBox[{
         RowBox[{"e", " ", "<", " ", "0"}], ",", " ", "1.", ",", " ", 
         RowBox[{"e", " ", ">", " ", "0"}], ",", " ", "0.", ",", " ", "True", 
         ",", " ", "0.5"}], "]"}], ",", " ", 
       RowBox[{"1.", "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{"Clip", "[", 
            RowBox[{
             RowBox[{"e", "/", "t"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "700."}], ",", " ", "700."}], "}"}]}], "]"}], 
           "]"}], " ", "+", " ", "1."}], ")"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"binEntropy", "[", "f", "]"}], ":", " ", 
     RowBox[{
      RowBox[{"the", " ", "entropy"}], " ", "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"f", " ", "ln", " ", "f"}], " ", "+", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", " ", "-", " ", "f"}], ")"}], " ", "ln", 
          RowBox[{"(", 
           RowBox[{"1", " ", "-", " ", "f"}], ")"}]}]}], ")"}], " ", "of", " ",
        "a", " ", "mode", " ", "with", " ", "the", " ", "occupation", " ", 
       "f", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"zero", " ", "at", " ", "f"}], " ", "=", " ", 
         RowBox[{
          RowBox[{"0", " ", "and", " ", "f"}], " ", "=", " ", "1"}]}], 
        ")"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"binEntropy", "[", "f_", "]"}], " ", ":=", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"0", " ", "<", " ", "f", " ", "<", " ", "1"}], ",", " ", 
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"f", " ", 
           RowBox[{"Log", "[", "f", "]"}]}], " ", "+", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", " ", "-", " ", "f"}], ")"}], " ", 
           RowBox[{"Log", "[", 
            RowBox[{"1", " ", "-", " ", "f"}], "]"}]}]}], ")"}]}], ",", " ", 
       "0."}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"thermalNode", "[", 
      RowBox[{"h", ",", " ", "t"}], "]"}], ":", " ", 
     RowBox[{"the", " ", "thermal", " ", "state", " ", "f", 
      RowBox[{"(", "H", ")"}], " ", "of", " ", "one", " ", "BdG", " ", 
      "matrix", " ", "h", " ", "at", " ", "the", " ", "temperature", " ", 
      "t"}], ":", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"C", "^", "n"}], ",", " ", 
       RowBox[{"C", "^", "p"}], ",", " ", 
       RowBox[{"the", " ", "sorted", " ", "eigenvalues"}], ",", " ", 
       RowBox[{
       "the", " ", "sum", " ", "of", " ", "the", " ", "entropies", " ", "of", 
        " ", "the", " ", "16", " ", "modes"}]}], "}"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"thermalNode", "[", 
      RowBox[{"h_", ",", " ", "t_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ev", ",", " ", "vec", ",", " ", "f", ",", " ", "r"}], "}"}], 
       ",", "\n", "   ", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"ev", ",", " ", "vec"}], "}"}], " ", "=", " ", 
         RowBox[{"Eigensystem", "[", 
          RowBox[{"0.5", " ", 
           RowBox[{"(", 
            RowBox[{"h", " ", "+", " ", 
             RowBox[{"ConjugateTranspose", "[", "h", "]"}]}], ")"}]}], 
          "]"}]}], ";", " ", 
        RowBox[{"ev", " ", "=", " ", 
         RowBox[{"Re", "[", "ev", "]"}]}], ";", "\n", "   ", 
        RowBox[{"f", " ", "=", " ", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"fermiSF", "[", 
             RowBox[{"#", ",", " ", "t"}], "]"}], " ", "&"}], ",", " ", 
           "ev"}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"r", " ", "=", " ", 
         RowBox[{
          RowBox[{"Transpose", "[", "vec", "]"}], " ", ".", " ", 
          RowBox[{"DiagonalMatrix", "[", "f", "]"}], " ", ".", " ", 
          RowBox[{"Conjugate", "[", "vec", "]"}]}]}], ";", "   ", 
        RowBox[{"(*", " ", 
         RowBox[{"R", " ", "=", " ", 
          RowBox[{"sum_k", " ", "f_k", " ", "v_k", " ", 
           RowBox[{"v_k", "^", "dag"}]}]}], " ", "*)"}], "\n", "   ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"r", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"1", " ", ";;", " ", "8"}], ",", " ", 
             RowBox[{"1", " ", ";;", " ", "8"}]}], "]"}], "]"}], ",", " ", 
          RowBox[{"-", 
           RowBox[{"r", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"1", " ", ";;", " ", "8"}], ",", " ", 
              RowBox[{"9", " ", ";;", " ", "16"}]}], "]"}], "]"}]}], ",", " ", 
          RowBox[{"Sort", "[", "ev", "]"}], ",", " ", 
          RowBox[{"Total", "[", 
           RowBox[{"Map", "[", 
            RowBox[{"binEntropy", ",", " ", "f"}], "]"}], "]"}]}], "}"}]}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"solveSFT", "[", 
       RowBox[{
       "mo", ",", " ", "N0", ",", " ", "P0", ",", " ", "t", ",", " ", "mix", ",",
         " ", "tol", ",", " ", "maxit"}], "]"}], ":", " ", 
      RowBox[{
       RowBox[{"the", " ", "self"}], "-", 
       RowBox[{
       "consistent", " ", "thermal", " ", "state", " ", "at", " ", "the", " ",
         "temperature", " ", "t", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
          "the", " ", "stationary", "\n", "   ", "point", " ", "of", " ", 
           "E"}], " ", "-", " ", 
          RowBox[{"t", " ", "S"}]}], ")"}], " ", "from", " ", "the", " ", 
        "initial", " ", "self"}], "-", 
       RowBox[{"energies", " ", "N0"}]}]}], ",", " ", 
     RowBox[{"P0", ":", " ", 
      RowBox[{
       RowBox[{"the", " ", "self"}], "-", "energies"}]}], ",", " ", 
     RowBox[{"the", " ", "energy", " ", "per", " ", "volume", " ", 
      RowBox[{"(", 
       RowBox[{"from", " ", "the", " ", "normal", "\n", "   ", "vacuum"}], 
       ")"}]}], ",", " ", 
     RowBox[{"the", " ", "entropy", " ", "per", " ", "volume"}], ",", " ", 
     RowBox[{
     "the", " ", "free", " ", "energy", " ", "per", " ", "volume", " ", "and",
       " ", "the", " ", "number", " ", "of", " ", "iterations"}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"solveSFT", "[", 
      RowBox[{
      "mo_", ",", " ", "n0_", ",", " ", "p0_", ",", " ", "t_", ",", " ", 
       RowBox[{"mix_", " ", ":", " ", "0.6"}], ",", " ", 
       RowBox[{"tol_", " ", ":", " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "13"}]}]}], ",", " ", 
       RowBox[{"maxit_", " ", ":", " ", "400000"}]}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", "\n", "   ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ns", " ", "=", " ", "n0"}], ",", " ", 
         RowBox[{"ps", " ", "=", " ", "p0"}], ",", " ", "res", ",", " ", "cn",
          ",", " ", "cp", ",", " ", "ent", ",", " ", "rho", ",", " ", "kap", ",",
          " ", "ek", ",", " ", "ei", ",", " ", "n2", ",", " ", "p2", ",", " ",
          "r", ",", " ", 
         RowBox[{"it", " ", "=", " ", "0"}], ",", " ", 
         RowBox[{"out", " ", "=", " ", "None"}]}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{"out", " ", "===", " ", "None"}], ",", "\n", "     ", 
          RowBox[{
           RowBox[{"res", " ", "=", " ", 
            RowBox[{"Map", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"thermalNode", "[", 
                RowBox[{"#", ",", " ", "t"}], "]"}], " ", "&"}], ",", " ", 
              RowBox[{"bdg", "[", 
               RowBox[{"mo", ",", " ", "ns", ",", " ", "ps"}], "]"}]}], 
             "]"}]}], ";", "\n", "     ", 
           RowBox[{"cn", " ", "=", " ", 
            RowBox[{"res", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], ";", " ", 
           RowBox[{"cp", " ", "=", " ", 
            RowBox[{"res", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], ";", "\n", 
           "     ", 
           RowBox[{"ent", " ", "=", " ", 
            RowBox[{"0.5", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"mo", "[", "\"\<g\>\"", "]"}], "[", "\"\<w\>\"", "]"}],
               " ", ".", " ", 
              RowBox[{"res", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", " ", "4"}], "]"}], "]"}]}]}]}], ";", "\n",
            "     ", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"rho", ",", " ", "kap", ",", " ", "ek"}], "}"}], " ", "=",
             " ", 
            RowBox[{"localDens", "[", 
             RowBox[{"mo", ",", " ", "cn", ",", " ", "cp"}], "]"}]}], ";", 
           "\n", "     ", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"ei", ",", " ", "n2", ",", " ", "p2"}], "}"}], " ", "=", 
            " ", 
            RowBox[{"interaction", "[", 
             RowBox[{
              RowBox[{"mo", "[", "\"\<ts\>\"", "]"}], ",", " ", "rho", ",", 
              " ", "kap"}], "]"}]}], ";", "\n", "     ", 
           RowBox[{"r", " ", "=", " ", 
            RowBox[{"Max", "[", 
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{"n2", " ", "-", " ", "ns"}], "]"}], ",", " ", 
              RowBox[{"Abs", "[", 
               RowBox[{"p2", " ", "-", " ", "ps"}], "]"}]}], "]"}]}], ";", 
           "\n", "     ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"r", " ", "<", " ", "tol"}], " ", "||", " ", 
              RowBox[{"it", " ", ">=", " ", "maxit"}]}], ",", "\n", "       ", 
             RowBox[{"out", " ", "=", " ", 
              RowBox[{"<|", 
               RowBox[{
                RowBox[{"\"\<n\>\"", " ", "->", " ", "n2"}], ",", " ", 
                RowBox[{"\"\<p\>\"", " ", "->", " ", "p2"}], ",", " ", 
                RowBox[{"\"\<e\>\"", " ", "->", " ", 
                 RowBox[{"ek", " ", "+", " ", "ei"}]}], ",", " ", 
                RowBox[{"\"\<s\>\"", " ", "->", " ", "ent"}], ",", " ", 
                RowBox[{"\"\<free\>\"", " ", "->", " ", 
                 RowBox[{"ek", " ", "+", " ", "ei", " ", "-", " ", 
                  RowBox[{"t", " ", "ent"}]}]}], ",", " ", 
                RowBox[{"\"\<it\>\"", " ", "->", " ", "it"}], ",", " ", 
                RowBox[{"\"\<res\>\"", " ", "->", " ", "r"}]}], "|>"}]}], ",",
              "\n", "       ", 
             RowBox[{
              RowBox[{"ns", " ", "=", " ", 
               RowBox[{
                RowBox[{"mix", " ", "n2"}], " ", "+", " ", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", " ", "-", " ", "mix"}], ")"}], " ", "ns"}]}]}],
               ";", " ", 
              RowBox[{"ps", " ", "=", " ", 
               RowBox[{
                RowBox[{"mix", " ", "p2"}], " ", "+", " ", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", " ", "-", " ", "mix"}], ")"}], " ", "ps"}]}]}],
               ";", "\n", "       ", 
              RowBox[{"ns", " ", "=", " ", 
               RowBox[{"0.5", " ", 
                RowBox[{"(", 
                 RowBox[{"ns", " ", "+", " ", 
                  RowBox[{"ConjugateTranspose", "[", "ns", "]"}]}], ")"}]}]}],
               ";", " ", 
              RowBox[{"ps", " ", "=", " ", 
               RowBox[{"0.5", " ", 
                RowBox[{"(", 
                 RowBox[{"ps", " ", "-", " ", 
                  RowBox[{"Transpose", "[", "ps", "]"}]}], ")"}]}]}], ";", 
              "\n", "       ", 
              RowBox[{"it", "++"}]}]}], "]"}]}]}], "]"}], ";", "\n", "   ", 
        "out"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"fixedPairT", "[", 
       RowBox[{"mo", ",", " ", "pfix", ",", " ", "N0", ",", " ", "t"}], "]"}],
       ":", " ", 
      RowBox[{
       RowBox[{
       "the", " ", "thermal", " ", "state", " ", "of", " ", "the", " ", 
        "applied", " ", "pair", " ", "self"}], "-", 
       RowBox[{
       "energy", " ", "pfix", " ", "at", " ", "the", " ", "temperature", " ", 
        "t"}]}]}], ",", " ", 
     RowBox[{
      RowBox[{"with", " ", "the", "\n", "   ", "normal", " ", "self"}], "-", 
      RowBox[{"energy", " ", "made", " ", "self"}], "-", 
      RowBox[{"consistent", ":", " ", 
       RowBox[{"{", 
        RowBox[{"N", ",", " ", 
         RowBox[{
         "the", " ", "field", " ", "Phi", " ", "of", " ", "the", " ", "state",
           " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
            "the", " ", "modulus", " ", "of", " ", "the", " ", "amplitude", " ",
              "of", " ", "its", " ", "own", "\n", "   ", "pair", " ", 
             "self"}], "-", 
            RowBox[{"energy", " ", "in", " ", "the", " ", "channel", " ", 
             RowBox[{"K", "^", "3"}]}]}], ")"}]}], ",", " ", 
         RowBox[{
         "its", " ", "free", " ", "energy", " ", "per", " ", "volume"}]}], 
        "}"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"fixedPairT", "[", 
      RowBox[{
      "mo_", ",", " ", "pfix_", ",", " ", "n0_", ",", " ", "t_", ",", " ", 
       RowBox[{"tol_", " ", ":", " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "14"}]}]}]}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ns", " ", "=", " ", "n0"}], ",", " ", "res", ",", " ", "cn",
          ",", " ", "cp", ",", " ", "ent", ",", " ", "rho", ",", " ", "kap", ",",
          " ", "ek", ",", " ", "ei", ",", " ", "n2", ",", " ", "p2", ",", " ", 
         RowBox[{"done", " ", "=", " ", "False"}], ",", " ", 
         RowBox[{"it", " ", "=", " ", "0"}]}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{"!", " ", "done"}], ",", "\n", "     ", 
          RowBox[{
           RowBox[{"res", " ", "=", " ", 
            RowBox[{"Map", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"thermalNode", "[", 
                RowBox[{"#", ",", " ", "t"}], "]"}], " ", "&"}], ",", " ", 
              RowBox[{"bdg", "[", 
               RowBox[{"mo", ",", " ", "ns", ",", " ", "pfix"}], "]"}]}], 
             "]"}]}], ";", "\n", "     ", 
           RowBox[{"cn", " ", "=", " ", 
            RowBox[{"res", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], ";", " ", 
           RowBox[{"cp", " ", "=", " ", 
            RowBox[{"res", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], ";", "\n", 
           "     ", 
           RowBox[{"ent", " ", "=", " ", 
            RowBox[{"0.5", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"mo", "[", "\"\<g\>\"", "]"}], "[", "\"\<w\>\"", "]"}],
               " ", ".", " ", 
              RowBox[{"res", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", " ", "4"}], "]"}], "]"}]}]}]}], ";", "\n",
            "     ", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"rho", ",", " ", "kap", ",", " ", "ek"}], "}"}], " ", "=",
             " ", 
            RowBox[{"localDens", "[", 
             RowBox[{"mo", ",", " ", "cn", ",", " ", "cp"}], "]"}]}], ";", 
           "\n", "     ", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"ei", ",", " ", "n2", ",", " ", "p2"}], "}"}], " ", "=", 
            " ", 
            RowBox[{"interaction", "[", 
             RowBox[{
              RowBox[{"mo", "[", "\"\<ts\>\"", "]"}], ",", " ", "rho", ",", 
              " ", "kap"}], "]"}]}], ";", "\n", "     ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Max", "[", 
                RowBox[{"Abs", "[", 
                 RowBox[{"n2", " ", "-", " ", "ns"}], "]"}], "]"}], " ", "<", 
               " ", "tol"}], " ", "||", " ", 
              RowBox[{"it", " ", ">=", " ", "200000"}]}], ",", " ", 
             RowBox[{"done", " ", "=", " ", "True"}], ",", "\n", "       ", 
             RowBox[{
              RowBox[{"ns", " ", "=", " ", 
               RowBox[{
                RowBox[{"0.7", " ", "n2"}], " ", "+", " ", 
                RowBox[{"0.3", " ", "ns"}]}]}], ";", " ", 
              RowBox[{"ns", " ", "=", " ", 
               RowBox[{"0.5", " ", 
                RowBox[{"(", 
                 RowBox[{"ns", " ", "+", " ", 
                  RowBox[{"ConjugateTranspose", "[", "ns", "]"}]}], ")"}]}]}],
               ";", " ", 
              RowBox[{"it", "++"}]}]}], "]"}]}]}], "]"}], ";", "\n", "   ", 
        RowBox[{"{", 
         RowBox[{"n2", ",", " ", 
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"Tr", "[", 
             RowBox[{
              RowBox[{"k8", "[", "3", "]"}], " ", ".", " ", "p2"}], "]"}], "/",
             "8"}], "]"}], ",", " ", 
          RowBox[{"ek", " ", "+", " ", "ei", " ", "-", " ", 
           RowBox[{"t", " ", "ent"}]}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"phiOf", "[", "sol", "]"}], ":", " ", 
      RowBox[{
       RowBox[{
       "the", " ", "order", " ", "parameter", " ", "of", " ", "a", " ", 
        "self"}], "-", 
       RowBox[{"consistent", " ", "state"}]}]}], ",", " ", 
     RowBox[{
      RowBox[{
      "the", " ", "modulus", " ", "of", " ", "the", " ", "amplitude", " ", 
       "of", " ", "its", " ", "pair", " ", "self"}], "-", "energy"}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"phiOf", "[", "sol_", "]"}], " ", ":=", " ", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"Tr", "[", 
        RowBox[{
         RowBox[{"k8", "[", "3", "]"}], " ", ".", " ", 
         RowBox[{"sol", "[", "\"\<p\>\"", "]"}]}], "]"}], "/", "8"}], "]"}]}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<the thermal engine is defined\>\"", "]"}], 
    ";"}]}]}]], "Input",
