         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"i1", "[", "mm", "]"}], ",", " ", "mm"}], "]"}], " ", "+",
           " ", 
          RowBox[{"mm", " ", 
           RowBox[{"jj", "[", "mm", "]"}]}]}], ",", " ", 
         RowBox[{"mm", " ", ">", " ", "0"}]}], "]"}], " ", "==", " ", "0"}], 
      " ", "&&", "\n", "  ", 
      RowBox[{
       RowBox[{"Max", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"NIntegrate", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"q", "^", "2"}], " ", 
                 RowBox[{
                  RowBox[{"(", 
