Cell[TextData[{
 StyleBox["AS1: plane waves in constant gauge fields.",
  FontWeight->"Bold"],
 " In constant gauge fields the field equation without self-interaction has \
plane-wave solutions ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Chi]", "\[ThinSpace]", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      RowBox[{"-", 
       StyleBox["i", "TI"]}], "\[Omega]", 
      StyleBox["t", "TI"], "+", 
      StyleBox["i", "TI"], 
      OverscriptBox[
       StyleBox["q", "TI"], "\[RightVector]"], "\[CenterDot]", 
      OverscriptBox[
       StyleBox["x", "TI"], "\[RightVector]"]}]]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8c74fea1-5494-4c62-9665-3ef79f73dc7e"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"\[Omega]", ",", "\[Chi]"}], ")"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c560d30e-c7f9-4ea1-a383-d5d8bb23394b"],
 " is an eigenpair of the Hermitian matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["h",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["pw",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     OverscriptBox[
      StyleBox["q", "TI"], "\[RightVector]"], ")"}], "\[LongEqual]", 
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "+", 
    SuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["F",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["B", "TI"], "0"], "+", 
    SuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["v",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["W",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "0"], "+", 
    UnderscriptBox["\[Sum]", 
     StyleBox["j", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["j", "TI"]], "+", 
      SuperscriptBox[
       StyleBox["g", "TI"], 
       StyleBox["F",
        FontSlant->"Plain"]], 
      SubscriptBox[
       StyleBox["B", "TI"], 
       StyleBox["j", "TI"]], "+", 
      SuperscriptBox[
       StyleBox["g", "TI"], 
       StyleBox["v",
        FontSlant->"Plain"]], 
      SubscriptBox[
       StyleBox["W",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["j", "TI"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "92cba121-8c92-41b1-83e1-eb400ab55f5c"],
 ". For the spin-isospin locked field ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["W", "TI"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["j", "TI"]}], "\[Iota]"], "\[LongEqual]", 
    StyleBox["w", "TI"], "\[ThinSpace]", 
    SubscriptBox["\[Delta]", 
     RowBox[{"\[Iota]", 
      StyleBox["j", "TI"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "38ec0eef-2c09-4b83-906f-8dd00602d864"],
 " the eight frequencies at the momentum ",
 Cell[BoxData[
  FormBox[
   StyleBox["q", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "25653cec-bda5-4bff-b6af-fce309fb79f3"],
 " along ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["x", "TI"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "246dfae0-ddaf-4c72-97e4-fd190c260485"],
 " are ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", "\[Omega]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b4bea1b8-91b5-4e49-ad53-49eae60c5239"],
 " with the four branches ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Omega]", "2"], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["m", "TI"], "2"], "+", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       StyleBox["q", "TI"], "\[PlusMinus]", 
       StyleBox["gw", "TI"], "/", "2"}], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7bf93e95-64c7-448e-ad01-6f042874bfca"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Omega]", "2"], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["m", "TI"], "2"], "+", 
    SuperscriptBox[
     StyleBox["q", "TI"], "2"], "+", 
    FractionBox["5", "4"], 
    SuperscriptBox[
     StyleBox["g", "TI"], "2"], 
    SuperscriptBox[
     StyleBox["w", "TI"], "2"], "\[PlusMinus]", 
    StyleBox["gw", "TI"], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        StyleBox["q", "TI"], "2"], "+", 
       SuperscriptBox[
        StyleBox["g", "TI"], "2"], 
       SuperscriptBox[
        StyleBox["w", "TI"], "2"]}], ")"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3165161b-d941-4b95-95c1-c09612560dc9"],
 "."
}], "Text",ExpressionUUID->"53be0329-72df-4939-9562-7d29ec258d7e"],

Cell[TextData[{
 StyleBox["AS2: Landau levels.",
  FontWeight->"Bold"],
 " In a constant magnetic field ",
 Cell[BoxData[
  FormBox[
   StyleBox["B", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "52cd6877-0f70-4132-bccb-94b7ce1279bb"],
 " along ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["x", "TI"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "808fbcac-2270-45f8-9f96-7e0b1bae06e5"],
 " the frequencies are ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       StyleBox["m", "TI"], "2"], "+", 
      SubsuperscriptBox[
       StyleBox["q", "TI"], "3", "2"], "+", "2", 
      StyleBox["neB", "TI"]}], ")"}], 
    RowBox[{"1", "/", "2"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "be664d2e-47fc-4fd4-b13d-9406cca7418c"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "0", ",", "1", ",", "2", ",", 
    "\[Ellipsis]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ea78eed0-2997-4c10-927f-c87a10ba1f55"],
 "; the program discretizes ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["x", "TI"], "1"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "892a7315-2ecc-482e-99e0-3e44ea98c3e7"],
 " on a lattice with the Wilson term (spacings ",
 Cell[BoxData[
  FormBox["0.1", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "66e056eb-44a6-4e65-a769-0ea678bf0326"],
 ", ",
 Cell[BoxData[
  FormBox["0.05", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2791c908-bfdb-4446-ac57-89ce485695bd"],
 ", ",
 Cell[BoxData[
  FormBox["0.025", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bc34b3e5-c352-4088-ab27-7b2a404eb580"],
 ") and compares the seven lowest positive frequencies, and their Richardson \
extrapolation ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    StyleBox["E", "TI"], 
    RowBox[{"(", "0.025", ")"}], "-", 
    StyleBox["E", "TI"], 
    RowBox[{"(", "0.05", ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b06c1048-549c-42b3-9267-13f895fe4e68"],
 ", with the Landau levels."
}], "Text",ExpressionUUID->"ab71587b-a91e-4f9f-8c31-492c7e8c5fb2"],

Cell[TextData[{
 StyleBox["AS3: the uniform superfluid of the spin-zero pairing.",
  FontWeight->"Bold"],
 " For a uniform unitary pair field the 16 eigenvalues of the matrix of \
Bogoliubov and de Gennes are ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    SuperscriptBox[
     RowBox[{"[", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"\[CurlyEpsilon]", "\[PlusMinus]", "\[Mu]"}], ")"}], "2"], "+", 
       SuperscriptBox["\[CapitalDelta]", "2"]}], "]"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2d01700b-bdd0-40bd-a1bc-406dd60659bb"],
 ", each four times; the mean-field energy is stationary where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["G", "TI"], "/", 
      SuperscriptBox["\[Pi]", "2"]}], ")"}], 
    SubscriptBox[
     StyleBox["I", "TI"], "1"], 
    RowBox[{"(", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         StyleBox["m", "TI"], "2"], "+", 
        SuperscriptBox["\[CapitalDelta]", "2"]}], ")"}], 
      RowBox[{"1", "/", "2"}]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "177511c2-3dff-4f0f-8147-f66ede8b9932"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["I", "TI"], "1"], 
    RowBox[{"(", 
     StyleBox["M", "TI"], ")"}], "\[LongEqual]", 
    FractionBox["1", "2"], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "+", 
         SuperscriptBox[
          StyleBox["M", "TI"], "2"]}], ")"}], 
       RowBox[{"1", "/", "2"}]], "-", 
      SuperscriptBox[
       StyleBox["M", "TI"], "2"], "\[ThinSpace]", 
      StyleBox["arcsinh",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       RowBox[{"1", "/", 
        StyleBox["M", "TI"]}], ")"}]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e468313a-8eb6-4309-9a2b-7123aebd7736"],
 ", and at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["G", "TI"], "\[LongEqual]", "22.5"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "81c29afc-b130-4d41-a88a-055eae1d20a2"],
 " the gap is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", "\[LongEqual]", "0.2094933033"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "30a068d7-b7b4-4eee-b5d5-c162a38d0440"],
 "."
}], "Text",ExpressionUUID->"2d10e592-5f3d-42e6-ac9e-3b816fe557c3"],

Cell[TextData[{
 StyleBox["AS4: the kink of the pair field.",
  FontWeight->"Bold"],
 " For the pair field ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", 
    RowBox[{"(", 
     StyleBox["x", "TI"], ")"}], "\[LongEqual]", 
    SubscriptBox["\[CapitalDelta]", "\[Infinity]"], "\[ThinSpace]", 
    StyleBox["tanh",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["x", "TI"], "/", "\[ScriptL]"}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b8d54b6b-f7f3-4afa-8c08-5f62a564e8bd"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalDelta]", "\[Infinity]"], "\[LongEqual]", "0.5"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3e21793d-e9aa-49ea-baca-a14c45cc9b3b"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ScriptL]", "\[LongEqual]", "4"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "08557fa6-ba75-4310-b5c7-27b9e4dae1a2"],
 ") the reduced problem has the bound states ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["sech",
      FontSlant->"Plain"], "2"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["x", "TI"], "/", "\[ScriptL]"}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7892de6a-270f-45ea-b9b5-a56f4d867415"],
 " (zero mode, energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    StyleBox["m", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "25d4ea9a-bd16-4d99-8ce1-37063ab7a81d"],
 ") and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["sech",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["x", "TI"], "/", "\[ScriptL]"}], ")"}], "\[ThinSpace]", 
    StyleBox["tanh",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["x", "TI"], "/", "\[ScriptL]"}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "64892474-abf7-43eb-a253-ce42d4dfb350"],
 " (energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        StyleBox["m", "TI"], "2"], "+", 
       SubsuperscriptBox[
        StyleBox["E", "TI"], "1", "2"]}], ")"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5ba2b4d3-d461-4504-a43c-6d7565d82224"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["E", "TI"], "1", "2"], "\[LongEqual]", "3", "/", "16"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f638f397-2442-4316-b76d-8747b0fa534d"],
 "); on the Wilson lattice exactly three bound states lie below the continuum \
",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       StyleBox["m", "TI"], "2"], "+", 
      SubsuperscriptBox["\[CapitalDelta]", "\[Infinity]", "2"]}], ")"}], 
    RowBox[{"1", "/", "2"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e383d91a-913c-486b-9a1b-6e57ab9eddc7"],
 "."
}], "Text",ExpressionUUID->"06663ba4-099b-4668-80fe-958472c6fab7"],

Cell[TextData[{
 "The next cell computes the four cases. The eigenvalues of the Hermitian \
matrices are computed by the function ",
 StyleBox["Eigenvalues",
  FontFamily->"Source Code Pro"],
 " of the Wolfram Language (dense matrices of up to 4800 rows); the gap \
equation is solved by ",
 StyleBox["FindRoot",
  FontFamily->"Source Code Pro"],
 " with 30 digits; the profiles of AS4 are checked symbolically by ",
 StyleBox["FullSimplify",
  FontFamily->"Source Code Pro"],
 "."
}], "Text",ExpressionUUID->"06c90847-2a43-430e-8465-d4327764f34e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"hPW", "[", 
      RowBox[{
      "q", ",", " ", "m", ",", " ", "gv", ",", " ", "gf", ",", " ", "w", ",", 
       " ", "b"}], "]"}], ":", " ", 
     RowBox[{
      RowBox[{"the", " ", "plane"}], "-", 
      RowBox[{
      "wave", " ", "matrix", " ", "of", " ", "AS1", " ", "for", " ", "the", " ",
        "constant", " ", "fields", " ", 
       RowBox[{"w", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"p", "+", "1"}], ",", " ", "i"}], "]"}], "]"}]}]}]}], " ", "=",
     " ", 
    RowBox[{
     RowBox[{
      RowBox[{"W", "^", "i_p"}], " ", "and", " ", 
      RowBox[{"b", "[", 
       RowBox[{"[", 
        RowBox[{"p", "+", "1"}], "]"}], "]"}]}], " ", "=", " ", "B_p"}]}], 
   " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"hPW", "[", 
      RowBox[{
      "q_", ",", " ", "m_", ",", " ", "gv_", ",", " ", "gf_", ",", " ", "w_", 
       ",", " ", "b_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "gauge", "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{
         RowBox[{"gauge", "[", "p_", "]"}], " ", ":=", " ", 
         RowBox[{
          RowBox[{"gf", " ", 
           RowBox[{"b", "[", 
            RowBox[{"[", 
             RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}], " ", 
           RowBox[{"IdentityMatrix", "[", "8", "]"}]}], " ", "+", " ", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{"gv", " ", 
             RowBox[{"w", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"p", " ", "+", " ", "1"}], ",", " ", "i"}], "]"}], 
              "]"}], " ", 
             RowBox[{"tLL", "[", "i", "]"}]}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"i", ",", " ", "3"}], "}"}]}], "]"}]}]}], ";", "\n", 
        "   ", 
        RowBox[{
         RowBox[{
          RowBox[{"d8", "[", "betaLL", "]"}], " ", "m"}], " ", "+", " ", 
         RowBox[{"gauge", "[", "0", "]"}], " ", "+", " ", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"d8", "[", 
             RowBox[{"alphaLL", "[", "j", "]"}], "]"}], " ", ".", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"q", "[", 
                RowBox[{"[", "j", "]"}], "]"}], " ", 
               RowBox[{"IdentityMatrix", "[", "8", "]"}]}], " ", "+", " ", 
              RowBox[{"gauge", "[", "j", "]"}]}], ")"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}]}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"AS1", "-", "3"}], ":", " ", 
       RowBox[{
        RowBox[{"the", " ", "spin"}], "-", 
        RowBox[{"isospin", " ", "locked", " ", "field", " ", 
         RowBox[{"W", "^", "i_j"}]}]}]}], " ", "=", " ", 
      RowBox[{"w", " ", "delta_ij"}]}], ",", " ", 
     RowBox[{"w", " ", "=", " ", "0.9"}], ",", " ", 
     RowBox[{"g_v", " ", "=", " ", "0.83"}], ",", " ", 
     RowBox[{"at", " ", "61", " ", "momenta", " ", "along", " ", 
      RowBox[{"x", "^", "3"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"w", " ", "=", " ", "0.9"}], ",", " ", 
        RowBox[{"gv", " ", "=", " ", "0.83"}], ",", " ", "wl", ",", " ", "gw",
         ",", " ", 
        RowBox[{"m", " ", "=", " ", 
         RowBox[{"N", "[", "mLL", "]"}]}], ",", " ", 
        RowBox[{"d", " ", "=", " ", "0."}]}], "}"}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{"wl", " ", "=", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"w", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "w", ",", " ", "0"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "0", ",", " ", "w"}], "}"}]}], "}"}]}], ";",
        "\n", "  ", 
       RowBox[{"gw", " ", "=", " ", 
        RowBox[{"gv", " ", "w"}]}], ";", "\n", "  ", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"ev", " ", "=", " ", 
              RowBox[{"Sort", "[", 
               RowBox[{"Re", "[", 
                RowBox[{"Eigenvalues", "[", 
                 RowBox[{"N", "[", 
                  RowBox[{"hPW", "[", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"0", ",", " ", "0", ",", " ", "q"}], "}"}], ",", 
                    " ", "m", ",", " ", "gv", ",", " ", "0", ",", " ", "wl", ",",
                     " ", 
                    RowBox[{"{", 
                    RowBox[{
                    "0", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], 
                    "}"}]}], "]"}], "]"}], "]"}], "]"}], "]"}]}], ",", " ", 
             "w2", ",", " ", "want"}], "}"}], ",", "\n", "     ", 
           RowBox[{
            RowBox[{"w2", " ", "=", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"m", "^", "2"}], " ", "+", " ", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"q", " ", "+", " ", 
                   RowBox[{"gw", "/", "2"}]}], ")"}], "^", "2"}]}], ",", " ", 
               
               RowBox[{
