Cell[CellGroupData[{

Cell["\<\
I.4 The gauge group GEE and its covariant derivatives (item 3)\
\>", "Section",ExpressionUUID->"d56007f5-7ee1-4813-bb5f-3cb6c2c4c74e"],

Cell[TextData[{
 "The gauge group is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["GEE",
     FontSlant->"Plain"], "\[LongEqual]", 
    StyleBox["SL", "TI"], 
    RowBox[{"(", 
     RowBox[{"2", ",", 
      StyleBox["\[DoubleStruckCapitalC]",
       FontSlant->"Plain"]}], ")"}], "\[Times]", 
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["v",
      FontSlant->"Plain"]], "\[Times]", 
    StyleBox["U", "TI"], 
    SubsuperscriptBox[
     RowBox[{"(", "1", ")"}], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "46f9f26a-bc89-49a2-9821-ad0ab9a5330a"],
 ". A local transformation is a unit bi-quaternion ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["g",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     StyleBox["x", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b3b1e800-0bbf-44a0-99c2-af0cfc4cf3dc"],
 ", an isospin rotation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["U",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["x", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8c4e4aea-db2f-4c75-ba4c-0f03cef4b71a"],
 " and a phase ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Theta]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["x", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dd927858-7531-4bfc-99f5-6b78eb50ceea"],
 "; it acts on the spinor field as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[RightTeeArrow]", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      StyleBox["i", "TI"], 
      SubsuperscriptBox["\[Theta]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["F",
        FontSlant->"Plain"]]}]], 
    SubscriptBox[
     StyleBox["S",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[CircleTimes]", 
    SubscriptBox[
     StyleBox["U",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[ThinSpace]", 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "502b0de2-408d-4862-9403-1c96fecc45bb"],
 ". The gauge fields are the Lorentz connection with the spin connection ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalGamma]", 
    StyleBox["p", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4bec2070-8e71-4874-97bd-d993ba4555bf"],
 ", the field of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["v",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d188c445-361d-4df4-92ae-c637947d896f"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["W",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}]], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", "\[Iota]",
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["W", "TI"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], "\[Iota]"], 
    SubsuperscriptBox["\[Tau]", "\[Iota]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "/", "2"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9abc3eb8-fc7b-4f80-b991-cea6d7783dba"],
 ", and the field ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["B", "TI"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "535aa526-74e8-44e2-89f8-1e84e25156ed"],
 " of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["U", "TI"], 
    SubsuperscriptBox[
     RowBox[{"(", "1", ")"}], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2b70ed9d-36c6-4d4e-8504-395a25037f56"],
 ", with the couplings ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["v",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a3e0c1ab-f5c5-40d0-a641-309c6d6c2a83"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["F",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4b730b34-11d9-4e49-b862-2ea26f66b456"],
 ". The covariant derivative of the spinor field is"
}], "Text",ExpressionUUID->"99ab6fd6-1f88-4822-a3ee-b7b609dd48f3"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["\[Del]", 
    StyleBox["p", "TI"], 
    StyleBox["GEE",
     FontSlant->"Plain"]], 
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], "\[LongEqual]", 
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["\[PartialD]", 
      StyleBox["p", "TI"]], "+", 
     SubsuperscriptBox["\[CapitalGamma]", 
      StyleBox["p", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"]], "+", 
     StyleBox["i", "TI"], 
     SubsuperscriptBox[
      StyleBox["g", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["v",
       FontSlant->"Plain"]], "\[ThinSpace]", 
     SubscriptBox[
      StyleBox["1",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "4"], "\[CircleTimes]", 
     SubscriptBox[
      StyleBox["W",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["SF",
        FontSlant->"Plain"], ",", 
       StyleBox["p", "TI"]}]], "+", 
     StyleBox["i", "TI"], 
     SubsuperscriptBox[
      StyleBox["g", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["F",
       FontSlant->"Plain"]], 
     SubscriptBox[
      StyleBox["B", "TI"], 
      RowBox[{
       StyleBox["SF",
        FontSlant->"Plain"], ",", 
       StyleBox["p", "TI"]}]]}], ")"}], 
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], ","}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"fe107237-0d83-424a-9cf9-714f28b45a8d"],

Cell[TextData[{
 "and it is covariant, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Del]", 
     StyleBox["p", "TI"], 
     RowBox[{"\[Prime]", 
      StyleBox["GEE",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["\[ScriptCapitalU]",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      SubscriptBox["\[CapitalPsi]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["\[ScriptCapitalU]",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Del]", 
     StyleBox["p", "TI"], 
     StyleBox["GEE",
      FontSlant->"Plain"]], 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6181a8cb-9698-4456-9419-45d7384d8cce"],
 ", when the gauge fields transform as"
}], "Text",ExpressionUUID->"0796d8a3-1f5f-4c9d-8c9f-a91b3884a122"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["\[CapitalGamma]", 
    StyleBox["p", "TI"], 
    RowBox[{"\[Prime]", 
     StyleBox["LL",
      FontSlant->"Plain"]}]], "\[LongEqual]", 
   StyleBox["S",
    FontFamily->"Helvetica",
    FontSlant->"Plain"], "\[ThinSpace]", 
   SubsuperscriptBox["\[CapitalGamma]", 
    StyleBox["p", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["S",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{"-", "1"}]], "-", 
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["\[PartialD]", 
      StyleBox["p", "TI"]], 
     StyleBox["S",
      FontFamily->"Helvetica",
      FontSlant->"Plain"]}], ")"}], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["S",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{"-", "1"}]], ",", "      ", 
   SubsuperscriptBox[
    StyleBox["W",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}], "\[Prime]"], "\[LongEqual]", 
   SubscriptBox[
    StyleBox["U",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   SubscriptBox[
    StyleBox["W",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}]], 
   SubsuperscriptBox[
    StyleBox["U",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Dagger]"], "+", 
   FractionBox[
    StyleBox["i", "TI"], 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]]], 
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["\[PartialD]", 
      StyleBox["p", "TI"]], 
     SubscriptBox[
      StyleBox["U",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"]]}], ")"}], 
   SubsuperscriptBox[
    StyleBox["U",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Dagger]"], ",", "      ", 
   SubsuperscriptBox[
    StyleBox["B", "TI"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}], "\[Prime]"], "\[LongEqual]", 
   SubscriptBox[
    StyleBox["B", "TI"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}]], "-", 
   FractionBox["1", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]]], 
   SubscriptBox["\[PartialD]", 
    StyleBox["p", "TI"]], 
   SubsuperscriptBox["\[Theta]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["F",
     FontSlant->"Plain"]], "."}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"d79fb5e7-a4d9-4daf-8134-8b0bc3a54d83"],

Cell[TextData[{
 "An isospin vector of fermion number 2 and spin 0, such as the pair field ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[CapitalPhi]", "\[RightVector]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1c2d14d5-3e48-4bd7-b603-04068eadbc9f"],
 " of the superfluid, has the covariant derivative ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Del]", 
     StyleBox["p", "TI"]], 
    OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "\[LongEqual]", 
    SubscriptBox["\[PartialD]", 
     StyleBox["p", "TI"]], 
    OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "-", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["W", "TI"], "\[RightVector]"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}]], "\[Times]", 
    OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "+", "2", 
    StyleBox["i", "TI"], 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["B", "TI"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}]], 
    OverscriptBox["\[CapitalPhi]", "\[RightVector]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b2502fa1-7e98-444d-9e59-5f35b3620dc9"],
 "; the field strengths are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["W",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], "\[LongEqual]", 
    SubscriptBox["\[PartialD]", 
     StyleBox["p", "TI"]], 
    SubscriptBox[
     StyleBox["W",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], "-", 
    SubscriptBox["\[PartialD]", 
     SuperscriptBox[
      StyleBox["p", "TI"], "\[Prime]"]], 
    SubscriptBox[
     StyleBox["W",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}]], "+", 
    StyleBox["i", "TI"], 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]], 
    RowBox[{"[", 
     RowBox[{
      SubscriptBox[
       StyleBox["W",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["SF",
         FontSlant->"Plain"], ",", 
        StyleBox["p", "TI"]}]], ",", 
      SubscriptBox[
       StyleBox["W",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["SF",
         FontSlant->"Plain"], ",", 
        SuperscriptBox[
         StyleBox["p", "TI"], "\[Prime]"]}]]}], "]"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7fb3afc9-6a70-4c41-9dd9-96624ad905e7"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["B", "TI"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], "\[LongEqual]", 
    SubscriptBox["\[PartialD]", 
     StyleBox["p", "TI"]], 
    SubscriptBox[
     StyleBox["B", "TI"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], "-", 
    SubscriptBox["\[PartialD]", 
     SuperscriptBox[
      StyleBox["p", "TI"], "\[Prime]"]], 
    SubscriptBox[
     StyleBox["B", "TI"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d0685de8-98e7-457e-95c8-a35086b1c4fc"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["W",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}], "\[Prime]"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["U",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["W",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], 
    SubsuperscriptBox[
     StyleBox["U",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Dagger]"]}], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b4b0a31b-b41a-4129-bc02-f410ac9a6a44"],
 "."
}], "Text",ExpressionUUID->"9beceb3d-81dd-4673-8785-b860770f79c8"],

Cell[TextData[{
 "The next cell checks these covariance laws with random smooth fields: the \
isospin rotation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["U",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["x", "TI"], ")"}], "\[LongEqual]", 
    StyleBox["exp",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       StyleBox["i", "TI"], "2"], "\[ThinSpace]", 
      UnderscriptBox["\[Sum]", "\[Iota]",
       LimitsPositioning->True], "\[ThinSpace]", 
      SuperscriptBox[
       StyleBox["a", "TI"], "\[Iota]"], 
      RowBox[{"(", 
       StyleBox["x", "TI"], ")"}], 
      SubsuperscriptBox["\[Tau]", "\[Iota]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3cdd3ebb-d674-4a68-89cb-ae548f45d2d3"],
 ", the phase, the gauge fields and the test fields are sums of sines of the \
four coordinates with random coefficients. The derivatives are computed \
symbolically by the function ",
 StyleBox["D",
  FontFamily->"Source Code Pro"],
 " of the Wolfram Language and evaluated at four random points: a third \
method, next to the automatic differentiation of the Rust program and the \
differences of eighth order of the Python program. The couplings of the test \
are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["v",
      FontSlant->"Plain"]], "\[LongEqual]", "0.83"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "983d2d0d-3353-4a9d-ae93-529d6d48ba7a"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["F",
      FontSlant->"Plain"]], "\[LongEqual]", "0.47"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b32e2a33-441c-400e-9348-f0b479affa07"],
 ". The last check of the cell is the local ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SL", "TI"], 
    RowBox[{"(", 
     RowBox[{"2", ",", 
      StyleBox["\[DoubleStruckCapitalC]",
       FontSlant->"Plain"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "35ad6865-1679-437c-99fc-82eb35b60d18"],
 " transformation with the frame: with the spinor matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["S",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     StyleBox["x", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d4c2233d-c4fe-433f-9066-19ba28db5ed6"],
 " of a random field of unit bi-quaternions and the connection ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalGamma]", 
     StyleBox["p", "TI"], "\[Prime]"], "\[LongEqual]", 
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[PartialD]", 
        StyleBox["p", "TI"]], 
       StyleBox["S",
        FontFamily->"Helvetica",
        FontSlant->"Plain"]}], ")"}]}], 
    SuperscriptBox[
     StyleBox["S",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{"-", "1"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d8a7f40e-7fcb-492a-bda3-f5c68ce6782e"],
 " of the transformed frame, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["p", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SuperscriptBox["\[Gamma]", 
     StyleBox["p", "TI"]], 
    RowBox[{"[", 
     SuperscriptBox[
      StyleBox["f",
       FontWeight->"Bold",
       FontSlant->"Plain"], "\[Prime]"], "]"}], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[PartialD]", 
       StyleBox["p", "TI"]], "+", 
      SubsuperscriptBox["\[CapitalGamma]", 
       StyleBox["p", "TI"], "\[Prime]"]}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["S",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "\[Psi]"}], ")"}], "\[LongEqual]", 
    StyleBox["S",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", 
     StyleBox["p", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SuperscriptBox["\[Gamma]", 
     StyleBox["p", "TI"]], 
    SubscriptBox["\[PartialD]", 
     StyleBox["p", "TI"]], "\[Psi]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7e075711-04b1-44bc-af60-bbcca210fc4f"],
 "."
}], "Text",ExpressionUUID->"4b8141bc-42ba-4dc4-a7d8-205021a941a9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"the", " ", "four", " ", "coordinates", " ", 
       RowBox[{"x", "^", "0"}]}], " ", ".."}], " ", 
     RowBox[{"x", "^", "3"}], " ", "of", " ", "the", " ", "test"}], ",", " ", 
    
    RowBox[{"as", " ", "symbols"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", 
     RowBox[{"x0", ",", " ", "x1", ",", " ", "x2", ",", " ", "x3"}], "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"xs", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"x0", ",", " ", "x1", ",", " ", "x2", ",", " ", "x3"}], "}"}]}],
     ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"gvT", ",", " ", 
     RowBox[{"gfT", ":", " ", 
      RowBox[{
      "the", " ", "couplings", " ", "of", " ", "the", " ", "test"}]}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"gvT", ",", " ", "gfT"}], "}"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"0.83", ",", " ", "0.47"}], "}"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"smooth", "[", "off", "]"}], ":", " ", 
     RowBox[{
      RowBox[{
      "a", " ", "random", " ", "smooth", " ", "real", " ", "function", " ", 
       "off"}], " ", "+", " ", 
      RowBox[{"a1", " ", "sin", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"k1", ".", "x"}], " ", "+", " ", "ph1"}], ")"}]}], " ", "+", 
      " ", 
      RowBox[{"a2", " ", "sin", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"k2", ".", "x"}], " ", "+", " ", "ph2"}], ")"}]}]}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"smooth", "[", "off_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"a", " ", "=", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"off", " ", "+", " ", 
             RowBox[{"0.5", " ", 
              RowBox[{"RandomReal", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], "]"}]}]}], ",", 
            " ", 
            RowBox[{"0.6", " ", 
             RowBox[{"RandomReal", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], "]"}]}], ",", " ", 
            RowBox[{"0.4", " ", 
             RowBox[{"RandomReal", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], "]"}]}]}], 
           "}"}]}], ",", "\n", "    ", 
         RowBox[{"k", " ", "=", " ", 
          RowBox[{"RandomReal", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"2", ",", " ", "4"}], "}"}]}], "]"}]}], ",", " ", 
         RowBox[{"ph", " ", "=", " ", 
          RowBox[{"RandomReal", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "3"}], ",", " ", "3"}], "}"}], ",", " ", "2"}], 
           "]"}]}]}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"a", "[", 
         RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", 
        RowBox[{
         RowBox[{"a", "[", 
          RowBox[{"[", "2", "]"}], "]"}], " ", 
         RowBox[{"Sin", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"k", "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", ".", " ", "xs"}], " ", "+", 
           " ", 
           RowBox[{"ph", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], " ", "+", " ", 
        RowBox[{
         RowBox[{"a", "[", 
          RowBox[{"[", "3", "]"}], "]"}], " ", 
         RowBox[{"Sin", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"k", "[", 
             RowBox[{"[", "2", "]"}], "]"}], " ", ".", " ", "xs"}], " ", "+", 
           " ", 
           RowBox[{"ph", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}]}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"the", " ", "isospin", " ", "rotation", " ", "U"}], " ", "=", 
      " ", 
      RowBox[{
       RowBox[{"exp", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"i", "/", "2"}], ")"}], " ", 
          RowBox[{"a", " ", ".", " ", "tau"}]}], ")"}]}], " ", "=", " ", 
       RowBox[{
        RowBox[{"cos", 
         RowBox[{"(", 
          RowBox[{"r", "/", "2"}], ")"}], " ", "1"}], " ", "+", " ", 
        RowBox[{"i", " ", "sin", 
         RowBox[{"(", 
          RowBox[{"r", "/", "2"}], ")"}], " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"a", " ", ".", " ", "tau"}], ")"}], "/", "r"}]}]}]}]}], ",",
      " ", 
     RowBox[{"r", " ", "=", " ", 
      RowBox[{"|", "a", "|"}]}], ",", " ", 
     RowBox[{"and", " ", "its", " ", "adjoint"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"aT", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"smooth", "[", "1.2", "]"}], ",", " ", 
       RowBox[{"{", "3", "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rT", " ", "=", " ", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"aT", " ", ".", " ", "aT"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"uT", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Cos", "[", 
        RowBox[{"rT", "/", "2"}], "]"}], " ", 
       RowBox[{"IdentityMatrix", "[", "2", "]"}]}], " ", "+", " ", 
      RowBox[{"I", " ", 
       RowBox[{"Sin", "[", 
        RowBox[{"rT", "/", "2"}], "]"}], " ", 
       RowBox[{
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"aT", "[", 
            RowBox[{"[", "i", "]"}], "]"}], " ", 
           RowBox[{"sig", "[", 
            RowBox[{"[", 
             RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", "3"}], "}"}]}], "]"}], "/", "rT"}]}]}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"uTdag", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Cos", "[", 
        RowBox[{"rT", "/", "2"}], "]"}], " ", 
       RowBox[{"IdentityMatrix", "[", "2", "]"}]}], " ", "-", " ", 
      RowBox[{"I", " ", 
       RowBox[{"Sin", "[", 
        RowBox[{"rT", "/", "2"}], "]"}], " ", 
       RowBox[{
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"aT", "[", 
            RowBox[{"[", "i", "]"}], "]"}], " ", 
           RowBox[{"sig", "[", 
            RowBox[{"[", 
             RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", "3"}], "}"}]}], "]"}], "/", "rT"}]}]}]}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"the", " ", "phase", " ", 
     RowBox[{"theta", "^", "F"}], " ", "of", " ", "U", 
     RowBox[{
      RowBox[{"(", "1", ")"}], "^", "F"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"thT", " ", "=", " ", 
     RowBox[{"smooth", "[", "0.3", "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"the", " ", "gauge", " ", 
       RowBox[{"fields", ":", " ", 
        RowBox[{"wT", "[", "p", "]"}]}]}], " ", "=", " ", 
      RowBox[{"sum_i", " ", 
       RowBox[{"W", "^", "i_p"}], " ", 
       RowBox[{"tau_i", "/", "2"}], " ", 
       RowBox[{"(", 
        RowBox[{"real", " ", "components"}], ")"}]}]}], ",", " ", 
     RowBox[{
      RowBox[{"bT", "[", "p", "]"}], " ", "=", " ", "B_p"}], ",", " ", 
     RowBox[{"p", " ", "=", " ", 
      RowBox[{
       RowBox[{"0", ".."}], "3"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"wComp", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"smooth", "[", "0.", "]"}], ",", " ", 
       RowBox[{"{", "4", "}"}], ",", " ", 
       RowBox[{"{", "3", "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"bComp", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"smooth", "[", "0.", "]"}], ",", " ", 
       RowBox[{"{", "4", "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"wT", "[", "p_", "]"}], " ", ":=", " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"wComp", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"p", " ", "+", " ", "1"}], ",", " ", "i"}], "]"}], "]"}], " ", 
        RowBox[{
         RowBox[{"sig", "[", 
          RowBox[{"[", 
           RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}], "/", "2"}]}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"bT", "[", "p_", "]"}], " ", ":=", " ", 
     RowBox[{"bComp", "[", 
      RowBox[{"[", 
       RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"dd", "[", 
      RowBox[{"f", ",", " ", "p"}], "]"}], ":", " ", 
     RowBox[{
     "the", " ", "derivative", " ", "with", " ", "respect", " ", "to", " ", 
      RowBox[{"x", "^", "p"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"dd", "[", 
      RowBox[{"f_", ",", " ", "p_"}], "]"}], " ", ":=", " ", 
     RowBox[{"D", "[", 
      RowBox[{"f", ",", " ", 
       RowBox[{"xs", "[", 
        RowBox[{"[", 
         RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"the", " ", "transformed", " ", "gauge", " ", "fields", " ", 
     RowBox[{"(", "4.5", ")"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"wTp", "[", "p_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"uT", " ", ".", " ", 
       RowBox[{"wT", "[", "p", "]"}], " ", ".", " ", "uTdag"}], " ", "+", " ", 
      RowBox[{
       RowBox[{"I", "/", "gvT"}], " ", 
       RowBox[{
        RowBox[{"dd", "[", 
         RowBox[{"uT", ",", " ", "p"}], "]"}], " ", ".", " ", "uTdag"}]}]}]}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"bTp", "[", "p_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"bT", "[", "p", "]"}], " ", "-", " ", 
      RowBox[{
       RowBox[{"dd", "[", 
        RowBox[{"thT", ",", " ", "p"}], "]"}], "/", "gfT"}]}]}], ";"}], "\n", 
   
   RowBox[{"(*", " ", 
    RowBox[{"the", " ", "test", " ", "spinor", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"eight", " ", "components"}], ",", " ", 
       RowBox[{"two", " ", "plane", " ", "waves"}]}], ")"}], " ", "and", " ", 
     "its", " ", "transform", " ", 
     RowBox[{"e", "^", 
      RowBox[{"(", 
       RowBox[{"i", " ", "theta"}], ")"}]}], " ", 
     RowBox[{"(", 
      RowBox[{"1", "_", "4", " ", 
       RowBox[{"(", "x", ")"}], " ", "U"}], ")"}], " ", "psi"}], " ", "*)"}], 
   "\n", 
   RowBox[{
    RowBox[{"kT", " ", "=", " ", 
     RowBox[{"RandomReal", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ampT", " ", "=", " ", 
     RowBox[{
      RowBox[{"RandomReal", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"8", ",", " ", "2"}], "}"}]}], "]"}], " ", "+", " ", 
      RowBox[{"I", " ", 
       RowBox[{"RandomReal", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"8", ",", " ", "2"}], "}"}]}], "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"psiT", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"ampT", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], " ", 
       RowBox[{"Exp", "[", 
        RowBox[{"I", " ", 
         RowBox[{
          RowBox[{"kT", "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", ".", " ", "xs"}]}], "]"}]}], 
      " ", "+", " ", 
      RowBox[{
       RowBox[{"ampT", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], " ", 
       RowBox[{"Exp", "[", 
        RowBox[{"I", " ", 
         RowBox[{
          RowBox[{"kT", "[", 
           RowBox[{"[", "2", "]"}], "]"}], " ", ".", " ", "xs"}]}], 
        "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"psiTp", " ", "=", " ", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{"I", " ", "thT"}], "]"}], " ", 
      RowBox[{
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{
         RowBox[{"IdentityMatrix", "[", "4", "]"}], ",", " ", "uT"}], "]"}], 
       " ", ".", " ", "psiT"}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"covPsi", "[", 
       RowBox[{"w", ",", " ", "b", ",", " ", "v", ",", " ", "p"}], "]"}], ":",
       " ", 
      RowBox[{"nabla_p", " ", "v"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"d_p", " ", "v"}], " ", "+", " ", 
      RowBox[{"i", " ", "g_v", " ", 
       RowBox[{"(", 
        RowBox[{"1", "_", "4", " ", 
         RowBox[{"(", "x", ")"}], " ", "W_p"}], ")"}], " ", "v"}], " ", "+", 
      " ", 
      RowBox[{"i", " ", "g_F", " ", "B_p", " ", "v"}]}]}], " ", "*)"}], "\n", 
   
   RowBox[{
    RowBox[{
     RowBox[{"covPsi", "[", 
      RowBox[{"w_", ",", " ", "b_", ",", " ", "v_", ",", " ", "p_"}], "]"}], 
     " ", ":=", " ", 
     RowBox[{
      RowBox[{"dd", "[", 
       RowBox[{"v", ",", " ", "p"}], "]"}], " ", "+", " ", 
      RowBox[{"I", " ", "gvT", " ", 
       RowBox[{
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{
          RowBox[{"IdentityMatrix", "[", "4", "]"}], ",", " ", 
