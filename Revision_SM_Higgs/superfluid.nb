Cell[CellGroupData[{

Cell["R.2 The ground state of the superfluid (stage 3)", "Section",ExpressionUUID->"ea481531-f57a-421f-924d-5cbfc2fe1403"],

Cell[TextData[{
 "Stage 3 computed the ground state of the three fields by the five methods, \
in the normal vacuum and with the pairing terms switched on. ",
 StyleBox["The normal vacuum.",
  FontWeight->"Bold"],
 " Without a condensate the ground state is the vacuum of the free Dirac \
fields; it is unstable towards a condensate in a channel when the largest \
eigenvalue of its static response in that channel exceeds 1, and the pairing \
terms give the doublet-singlet pairs the eigenvalue ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]], "/", 
    SubsuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["crit",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a33e2026-e705-435a-9246-0ff16c3ec4ed"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["crit",
      FontSlant->"Plain"]], "\[LongEqual]", "4", 
    SuperscriptBox["\[Pi]", "2"], "/", 
    SubsuperscriptBox[
     StyleBox["I", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{"(", "1", ")"}]], 
    RowBox[{"(", 
     SubscriptBox[
      StyleBox["m", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d800ea06-83bb-4717-adc8-7750c8d99576"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["I", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{"(", "1", ")"}]], 
    RowBox[{"(", 
     StyleBox["M", "TI"], ")"}], "\[LongEqual]", 
    SubsuperscriptBox["\[Integral]", "0", 
     SubscriptBox["\[CapitalLambda]", 
      StyleBox["LL",
       FontSlant->"Plain"]]], "\[ThinSpace]", 
    SuperscriptBox[
     StyleBox["q", "TI"], "2"], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        StyleBox["q", "TI"], "2"], "+", 
       SuperscriptBox[
        StyleBox["M", "TI"], "2"]}], ")"}], 
     RowBox[{
      RowBox[{"-", "1"}], "/", "2"}]], 
    StyleBox["dq", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "84fc61be-2f08-450c-be62-b60f4d9a0573"],
 ". With ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]], "\[LongEqual]", "100.8"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "21508875-7028-4d41-a359-25ed13ba2a5e"],
 " this eigenvalue is about 1.18, eightfold in the second version (two \
doublets, each component with its real and its imaginary part), and the \
normal vacuum is unstable towards the pairs. ",
 StyleBox["The ground state.",
  FontWeight->"Bold"],
 " In every method it is the custodial condensate: the down component of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "08d9b193-19e5-40a5-b820-3346a891292a"],
 " is paired with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Chi]", 
    StyleBox["SH",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9d2d93ab-c039-4aae-bd2e-df819955e77c"],
 " and the up component with ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Chi]", 
    StyleBox["SH",
     FontSlant->"Plain"], "\[Prime]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "74ad36c1-2a30-4699-8efa-39ecda8c64bb"],
 ", with equal singular values ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[FinalSigma]", 
     StyleBox["SH",
      FontSlant->"Plain"], 
     RowBox[{"(", "1", ")"}]], "\[LongEqual]", 
    SubsuperscriptBox["\[FinalSigma]", 
     StyleBox["SH",
      FontSlant->"Plain"], 
     RowBox[{"(", "2", ")"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "67c38659-e5cb-4e65-a861-b9c19bc32320"],
 " of the bidoublet of the coefficients of the pair self-energy; it breaks ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["L", "TI"]], "\[Times]", 
    StyleBox["U", "TI"], 
    SubscriptBox[
     RowBox[{"(", "1", ")"}], 
     StyleBox["Y", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "065e3b1c-dc14-4d84-a0ff-4333f5bd4875"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["U", "TI"], 
    SubscriptBox[
     RowBox[{"(", "1", ")"}], 
     StyleBox["Q", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5e56b9c3-bd44-48c4-a3ed-468e21c2b98d"],
 " and keeps ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["V",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bcb6e02c-9ddc-4958-923c-83dbf6b39eb4"],
 " (Section R.1.11). The checks of this section derive in exact arithmetic \
the formulas with which the Rust program compares its static responses and \
its ground states. The section starts from a clean slate."
}], "Text",ExpressionUUID->"c9cce690-1b34-419b-b5aa-7580de2b0d4e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"--", " ", "Section"}]}], " ", "R", ".2", " ", "starts", " ", 
    "from", " ", "a", " ", "clean", " ", 
    RowBox[{
     RowBox[{"slate", " ", "--"}], "--"}]}], " ", "*)"}], "\n", 
