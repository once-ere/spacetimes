  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"i1", "[", "mm_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{"1", " ", "+", " ", 
          RowBox[{"mm", "^", "2"}]}], "]"}], " ", "-", " ", 
        RowBox[{
         RowBox[{"mm", "^", "2"}], " ", 
         RowBox[{"ArcSinh", "[", 
          RowBox[{"1", "/", "mm"}], "]"}]}]}], ")"}], "/", "2"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
