        RowBox[{"eqs", " ", "=", " ", 
         RowBox[{"Flatten", "[", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"ComplexExpand", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"{", 
