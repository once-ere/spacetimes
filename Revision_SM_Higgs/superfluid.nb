Cell["\<\
I.3 The spinor field and the DiracLike field (item 2); theorem D1\
\>", "Section",ExpressionUUID->"1823309a-018c-4b8c-b552-f188b9bac920"],

Cell[TextData[{
 "A two-component spinor transforms under the unit bi-quaternion ",
 Cell[BoxData[
  FormBox[
   StyleBox["g",
    FontWeight->"Bold",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "60a00d1f-a878-4c5f-8d15-1ed69ddacce6"],
 " as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Chi]", "\[RightTeeArrow]", 
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[Chi]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "47996b64-19ae-4aeb-8703-0d674ac3bb57"],
 " (or, for the other kind, with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     OverscriptBox[
      StyleBox["g",
       FontWeight->"Bold",
       FontSlant->"Plain"], "~"], ")"}], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["M", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"]], 
       SuperscriptBox[
        RowBox[{"(", 
         StyleBox["g",
          FontWeight->"Bold",
          FontSlant->"Plain"], ")"}], "\[Dagger]"]}], ")"}], 
     RowBox[{"-", "1"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c86b38b3-8a94-4953-bbcc-755a833a2b91"],
 "). The Dirac matrices of a frame ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    StyleBox["p", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3bba7977-8e30-4032-8a6f-8382bb1c80f3"],
 " are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p", "TI"]], 
    RowBox[{"[", 
     StyleBox["f",
      FontWeight->"Bold",
      FontSlant->"Plain"], "]"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dcdf31a9-15cf-4e93-aed2-39660a551f5f"],
 " with the blocks ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubscriptBox[
      StyleBox["f",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      StyleBox["p", "TI"]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "89011dbd-d4f4-4c4e-8608-242fa2f44ae6"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["f",
        FontWeight->"Bold",
        FontSlant->"Plain"], "_"], 
      StyleBox["p", "TI"]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9c228052-63a2-46ba-bc65-3bc6c03be330"],
 " off the diagonal; the spinor matrix is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["S",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[LongEqual]", 
    StyleBox["diag",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      RowBox[{"(", 
       OverscriptBox[
        StyleBox["g",
         FontWeight->"Bold",
         FontSlant->"Plain"], "~"], ")"}], ",", 
      SubscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      RowBox[{"(", 
       StyleBox["g",
        FontWeight->"Bold",
        FontSlant->"Plain"], ")"}]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b8cc9528-e6e3-4953-854c-1df9bde13aea"],
 ", and"
}], "Text",ExpressionUUID->"f63f1d85-8c80-4d62-8154-bffa482d8ec9"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["S",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   SuperscriptBox[
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    RowBox[{"-", "1"}]], 
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p", "TI"]], 
   SubscriptBox[
    StyleBox["S",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   RowBox[{"(", 
    StyleBox["g",
     FontWeight->"Bold",
     FontSlant->"Plain"], ")"}], "\[LongEqual]", 
   UnderscriptBox["\[Sum]", 
    SuperscriptBox[
     StyleBox["p", "TI"], "\[Prime]"],
    LimitsPositioning->True], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["L",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["p", "TI"], 
     SuperscriptBox[
      StyleBox["p", "TI"], "\[Prime]"]}]], 
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    SuperscriptBox[
     StyleBox["p", "TI"], "\[Prime]"]], ",", "      ", 
   SubscriptBox[
    StyleBox["S",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   SuperscriptBox[
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[Dagger]"], 
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], "0"], 
   SubscriptBox[
    StyleBox["S",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   RowBox[{"(", 
    StyleBox["g",
     FontWeight->"Bold",
     FontSlant->"Plain"], ")"}], "\[LongEqual]", 
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], "0"], ",", "      ", 
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p", "TI"]], 
   RowBox[{"[", 
    SuperscriptBox[
     StyleBox["f",
      FontWeight->"Bold",
      FontSlant->"Plain"], "\[Prime]"], "]"}], "\[LongEqual]", 
   SubscriptBox[
    StyleBox["S",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   RowBox[{"(", 
    StyleBox["g",
     FontWeight->"Bold",
     FontSlant->"Plain"], ")"}], "\[ThinSpace]", 
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p", "TI"]], 
   RowBox[{"[", 
    StyleBox["f",
     FontWeight->"Bold",
     FontSlant->"Plain"], "]"}], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["S",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   SuperscriptBox[
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    RowBox[{"-", "1"}]]}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"2575a987-8797-4937-9f0e-43dd43d3169e"],

Cell[TextData[{
 "for the transformed frame ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["f",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["p", "TI"], "\[Prime]"], "\[LongEqual]", 
    OverscriptBox[
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], "~"], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["f",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["p", "TI"]], "\[ThinSpace]", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["g",
       FontWeight->"Bold",
       FontSlant->"Plain"], "~"], "\[Dagger]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2bd0df96-926a-4d2a-8013-bb2fb8fb18f4"],
 " (equations (3.8) and (3.9) of the manuscript). The spinor field ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c07cd291-c0e3-4153-b988-82ae2327a7a5"],
 " is the DiracLike isodoublet: eight anticommuting components, made of two \
spinor charges of the super-loop; it transforms as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[RightTeeArrow]", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["S",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      RowBox[{"(", 
       StyleBox["g",
        FontWeight->"Bold",
        FontSlant->"Plain"], ")"}], "\[CircleTimes]", 
      SubscriptBox[
       StyleBox["1",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], "2"]}], ")"}], 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4f8e4a09-8c14-4415-a6f2-8c603f80d619"],
 ", its isospin generators are ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6045cdc2-e38c-4b38-a2a8-23934fed9418"],
 ", its fermion number is 1, and its mass term ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubscriptBox[
     OverscriptBox["\[CapitalPsi]", "_"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "caa14815-8f1b-4954-bb96-4bb2fa89e717"],
 " is invariant under all of GEE."
}], "Text",ExpressionUUID->"7f47309d-b261-49e6-871b-3e13e0b41fc6"],

Cell[TextData[{
 StyleBox["Theorem D1.",
  FontWeight->"Bold"],
 " A single DiracLike field with four components, on which ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["v",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0b9a2977-f364-4b1b-9f53-3074ea162faa"],
 " acts by a non-trivial linear representation that commutes with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SL", "TI"], 
    RowBox[{"(", 
     RowBox[{"2", ",", 
      StyleBox["\[DoubleStruckCapitalC]",
       FontSlant->"Plain"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "faea4c30-7fb9-4d77-84dd-dc850d7c24cd"],
 " and keeps the kinetic term, has no Lorentz-invariant bilinear without \
derivatives (no Dirac, pseudoscalar or Majorana mass) that is invariant under \
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["v",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bd87969d-11a1-4e28-b29b-9ee60026c0fb"],
 ". The reason: the two left-handed Weyl spinors ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Psi]", "-"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0bb0b875-8eb3-49b0-8df6-b347a77e9a9f"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["E",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SuperscriptBox["\[Psi]", "+"], ")"}], "*"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "92c38350-1aef-4443-adbf-6a4547107017"],
 " of the DiracLike field form an isospin doublet (the group of Pauli and G\
\[CapitalATilde]\.bcrsey), and the Lorentz-invariant bilinears ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Xi]", 
     StyleBox["f", "TI"], 
     StyleBox["T", "TI"]], 
    SubscriptBox[
     StyleBox["E",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubscriptBox["\[Xi]", 
     SuperscriptBox[
      StyleBox["f", "TI"], "\[Prime]"]]}], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cfc21cb9-8894-441d-9471-717c7a0abe01"],
 " are symmetric in the doublet indices, an isospin triplet, which contains \
no invariant. This is why the spinor field of the solution is an isodoublet \
of DiracLike fields. The next cell repeats the finite part of the proof as a \
computation: on the eight operators ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["\[Psi]", "1"], ",", "\[Ellipsis]", ",", 
     SubscriptBox["\[Psi]", "4"], ",", 
     SubsuperscriptBox["\[Psi]", "1", "\[Dagger]"], ",", "\[Ellipsis]", ",", 
     SubsuperscriptBox["\[Psi]", "4", "\[Dagger]"]}], ")"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e6a15596-b55d-438f-bdef-84b24c4bba8f"],
 " of one point, a bilinear ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["\[GothicN]",
      FontSlant->"Plain"], 
     StyleBox["T", "TI"]], 
    StyleBox["\[GothicCapitalQ]",
     FontSlant->"Plain"], 
    StyleBox["\[GothicN]",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f859f358-ad73-46ac-af21-567d54085dea"],
 " with an antisymmetric ",
 Cell[BoxData[
  FormBox[
   RowBox[{"8", "\[Times]", "8"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f928dbfb-7035-40fb-a848-ec0a9c5a872b"],
 " matrix ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[GothicCapitalQ]",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1ab4241f-9cab-4daf-973e-f87dd389042e"],
 " is invariant under a group exactly when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["\[GothicCapitalX]",
      FontSlant->"Plain"], 
     StyleBox["T", "TI"]], 
    StyleBox["\[GothicCapitalQ]",
     FontSlant->"Plain"], "+", 
    StyleBox["\[GothicCapitalQ]",
     FontSlant->"Plain"], 
    StyleBox["\[GothicCapitalX]",
     FontSlant->"Plain"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1f9d1589-b268-4098-a71e-09b7ffc374ce"],
 " for every generator ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[GothicCapitalX]",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5e4443d8-4b5f-4bf2-8513-0639d9d5ea00"],
 "; the dimension of the space of such ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[GothicCapitalQ]",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "06b5113a-4ebb-4744-8348-82a6412dfda7"],
 " is ",
 Cell[BoxData[
  FormBox["28", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "81d2af1f-ce71-430c-8c66-f779d1a8f4ac"],
 " minus the rank of these linear conditions. With exact arithmetic: \
dimension 6 for the Lorentz group, 0 for the Lorentz group together with the \
Pauli-G\[CapitalATilde]\.bcrsey ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    RowBox[{"(", "2", ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1130d40e-b6d4-4831-9591-944322aac349"],
 "."
}], "Text",ExpressionUUID->"d14be453-6f94-4226-9092-5eaf7890d232"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"F", "-", "2"}], ":", " ", 
      RowBox[{"the", " ", "Clifford", " ", "algebra", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"gamma", "^", "p"}], ",", " ", 
         RowBox[{"gamma", "^", "q"}]}], "}"}]}]}], " ", "=", " ", 
     RowBox[{"2", " ", 
      RowBox[{"eta", "^", "pq"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"C", " ", 
      RowBox[{"gamma", "^", "p"}], " ", 
      RowBox[{"C", "^", "dag"}]}], " ", "=", " ", 
     RowBox[{"-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"gamma", "^", "p"}], ")"}], "^", "T"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"gamma", "^", "ch"}], " ", "=", " ", 
     RowBox[{"diag", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "1"}], ",", "1", ",", "1"}], ")"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"C", "^", "T"}], " ", "=", " ", 
     RowBox[{
      RowBox[{"-", "C"}], " ", 
      RowBox[{"(", "exact", ")"}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"dF2", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Flatten", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"gam", "[", "p", "]"}], " ", ".", " ", 
              RowBox[{"gam", "[", "q", "]"}]}], " ", "+", " ", 
             RowBox[{
              RowBox[{"gam", "[", "q", "]"}], " ", ".", " ", 
              RowBox[{"gam", "[", "p", "]"}]}], " ", "-", " ", 
             RowBox[{"2", " ", 
              RowBox[{"etaLL", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"p", " ", "+", " ", "1"}], ",", " ", 
                 RowBox[{"q", " ", "+", " ", "1"}]}], "]"}], "]"}], " ", 
              RowBox[{"IdentityMatrix", "[", "4", "]"}]}]}], "]"}], ",", " ", 
           
           RowBox[{"{", 
            RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"q", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}], ",", 
         "\n", "     ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"cLL", " ", ".", " ", 
              RowBox[{"gam", "[", "p", "]"}], " ", ".", " ", 
              RowBox[{"ConjugateTranspose", "[", "cLL", "]"}]}], " ", "+", 
             " ", 
             RowBox[{"Transpose", "[", 
              RowBox[{"gam", "[", "p", "]"}], "]"}]}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}], ",", 
         "\n", "     ", 
         RowBox[{"Abs", "[", 
          RowBox[{"gch", " ", "-", " ", 
           RowBox[{"DiagonalMatrix", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", " ", 
              RowBox[{"-", "1"}], ",", " ", "1", ",", " ", "1"}], "}"}], 
            "]"}]}], "]"}], ",", " ", 
         RowBox[{"Abs", "[", 
          RowBox[{"cLL", " ", "+", " ", 
           RowBox[{"Transpose", "[", "cLL", "]"}]}], "]"}]}], "}"}], "]"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WF-2\>\"", ",", 
      " ", "\"\<Clifford algebra, chirality, charge conjugation (exact)\>\"", 
      ",", " ", "dF2", ",", " ", "0", ",", " ", "\"\<F-2\>\"", ",", 
