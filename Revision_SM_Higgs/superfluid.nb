  RowBox[{
   RowBox[{
    RowBox[{"hb", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Flatten", "[", "#", "]"}], "/", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"Total", "[", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"Flatten", "[", "#", "]"}], "]"}], "^", "2"}], "]"}], 
         "]"}]}], " ", "&"}], " ", "/@", " ", "kp"}]}], ";"}], "      ", 
   RowBox[{"(*", " ", "orthonormal", " ", "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"the", " ", "generators", " ", "G_", 
       RowBox[{"{", 
        RowBox[{"s", " ", 
         RowBox[{"s", "'"}]}], "}"}]}], " ", "=", " ", 
      RowBox[{"<", 
       RowBox[{"M_s", "'"}]}]}], ",", " ", 
     RowBox[{
      RowBox[{"L_X", 
       RowBox[{"(", "M_s", ")"}]}], ">", " ", 
      RowBox[{"on", " ", "an", " ", "orthonormal", " ", "basis"}]}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"gOn", "[", 
      RowBox[{"sec_", ",", " ", "basis_", ",", " ", "x_"}], "]"}], " ", ":=", 
     " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"Conjugate", "[", 
          RowBox[{"basis", "[", 
           RowBox[{"[", "sp", "]"}], "]"}], "]"}], ".", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"chargeOp", "[", 
            RowBox[{"sec", ",", " ", "x"}], "]"}], ".", 
           RowBox[{"basis", "[", 
            RowBox[{"[", "s", "]"}], "]"}]}], ")"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"s", ",", " ", 
         RowBox[{"Length", "[", "basis", "]"}]}], "}"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"sp", ",", " ", 
         RowBox[{"Length", "[", "basis", "]"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"closed", "[", 
      RowBox[{"sec_", ",", " ", "basis_", ",", " ", "glist_"}], "]"}], " ", ":=",
      " ", 
     RowBox[{"And", " ", "@@", " ", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Table", "[", 
