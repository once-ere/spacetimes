]}]}]}]}]}]}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"fieldOff", " ", "=", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Psi\>\"", " ", "->", " ", "0"}], ",", " ", 
       RowBox[{"\"\<chi\>\"", " ", "->", " ", "8"}], ",", " ", 
       RowBox[{"\"\<chi'\>\"", " ", "->", " ", "12"}], ",", " ", 
       RowBox[{"\"\<(chi, chi')\>\"", " ", "->", " ", "8"}]}], "|>"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"fieldN", " ", "=", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Psi\>\"", " ", "->", " ", "8"}], ",", " ", 
       RowBox[{"\"\<chi\>\"", " ", "->", " ", "4"}], ",", " ", 
       RowBox[{"\"\<chi'\>\"", " ", "->", " ", "4"}], ",", " ", 
       RowBox[{"\"\<(chi, chi')\>\"", " ", "->", " ", "8"}]}], "|>"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"onField", "[", 
      RowBox[{"x_", ",", " ", "f_"}], "]"}], " ", ":=", " ", 
     RowBox[{"x", "[", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"fieldOff", "[", "f", "]"}], " ", "+", " ", "1"}], " ", ";;",
          " ", 
         RowBox[{
          RowBox[{"fieldOff", "[", "f", "]"}], " ", "+", " ", 
          RowBox[{"fieldN", "[", "f", "]"}]}]}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"fieldOff", "[", "f", "]"}], " ", "+", " ", "1"}], " ", ";;",
          " ", 
         RowBox[{
          RowBox[{"fieldOff", "[", "f", "]"}], " ", "+", " ", 
          RowBox[{"fieldN", "[", "f", "]"}]}]}]}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"diracOn", "[", 
      RowBox[{"f_", ",", " ", "a_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Which", "[", 
      RowBox[{
       RowBox[{"f", " ", "==", " ", "\"\<Psi\>\""}], ",", " ", 
       RowBox[{"d8", "[", "a", "]"}], ",", " ", 
       RowBox[{"f", " ", "==", " ", "\"\<(chi, chi')\>\""}], ",", " ", 
       RowBox[{"blk", "[", 
        RowBox[{"a", ",", " ", "a"}], "]"}], ",", " ", "True", ",", " ", 
       "a"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"leftOp", "[", 
      RowBox[{"kind_", ",", " ", "a_"}], "]"}], " ", ":=", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"kind", " ", "==", " ", "\"\<pair\>\""}], ",", " ", 
       RowBox[{"Transpose", "[", "a", "]"}], ",", " ", 
       RowBox[{"ConjugateTranspose", "[", "a", "]"}]}], "]"}]}], ";"}], "\n", 
   
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", "matrix", " ", "on", " ", "vec", 
      RowBox[{"(", "M", ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"row", " ", "by", " ", "row"}], ")"}], " ", "of", " ", "M"}], 
     " ", "->", " ", 
     RowBox[{
      RowBox[{"left", 
       RowBox[{"(", "A1", ")"}], " ", "M"}], " ", "+", " ", 
      RowBox[{"M", " ", "A2"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"vecOp", "[", 
      RowBox[{"kind_", ",", " ", "a1_", ",", " ", "a2_"}], "]"}], " ", ":=", 
     " ", 
     RowBox[{
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{
        RowBox[{"leftOp", "[", 
         RowBox[{"kind", ",", " ", "a1"}], "]"}], ",", " ", 
        RowBox[{"IdentityMatrix", "[", 
         RowBox[{"Length", "[", "a2", "]"}], "]"}]}], "]"}], " ", "+", "\n", 
      "  ", 
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{
        RowBox[{"IdentityMatrix", "[", 
         RowBox[{"Length", "[", "a1", "]"}], "]"}], ",", " ", 
        RowBox[{"Transpose", "[", "a2", "]"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"transpOp", "[", "n_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"p", " ", "=", " ", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0", ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"n", "^", "2"}], ",", " ", 
             RowBox[{"n", "^", "2"}]}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
       "  ", 
       RowBox[{
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"p", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{
               RowBox[{"j", " ", "n"}], " ", "+", " ", "i", " ", "+", " ", 
               "1"}], ",", " ", 
              RowBox[{
               RowBox[{"i", " ", "n"}], " ", "+", " ", "j", " ", "+", " ", 
               "1"}]}], "]"}], "]"}], " ", "=", " ", "1"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", "0", ",", " ", 
            RowBox[{"n", " ", "-", " ", "1"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"j", ",", " ", "0", ",", " ", 
            RowBox[{"n", " ", "-", " ", "1"}]}], "}"}]}], "]"}], ";", " ", 
        "p"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sectors", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<pair\>\"", ",", " ", "\"\<Psi\>\"", ",", 
         " ", "\"\<Psi\>\""}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<pair\>\"", ",", " ", "\"\<Psi\>\"", ",", 
         " ", "\"\<chi\>\""}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<pair\>\"", ",", " ", "\"\<Psi\>\"", ",", 
