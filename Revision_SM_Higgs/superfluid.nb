   RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Alignment", " ", "->", " ", "Right"}], ",", " ", 
   RowBox[{"BaseStyle", " ", "->", " ", 
    RowBox[{"{", 
