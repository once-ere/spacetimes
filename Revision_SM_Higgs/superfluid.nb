         FontSlant->"Plain"], 
        RowBox[{"(", "1", ")"}]], "-", 
       SuperscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox[
          StyleBox["d", "TI"], 
          StyleBox["SH",
           FontSlant->"Plain"], "0"], ")"}], "2"], 
       SubsuperscriptBox[
        StyleBox["J", "TI"], 
        StyleBox["SH",
         FontSlant->"Plain"], 
        RowBox[{"(", "3", ")"}]], "/", "4"}], ")"}]}]], ","}], 
