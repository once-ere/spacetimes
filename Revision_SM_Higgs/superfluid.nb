              RowBox[{
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", 
                  RowBox[{"col", "[", 
                   RowBox[{"shdr", ",", " ", "\"\<run\>\""}], "]"}], "]"}], 
                 "]"}], " ", "==", " ", "r"}], " ", "&"}]}], "]"}]}], ",", 
           " ", "ts", ",", " ", "ph", ",", " ", "fit"}], "}"}], ",", "\n", 
         "    ", 
         RowBox[{
          RowBox[{"ts", " ", "=", " ", 
           RowBox[{"num", " ", "/@", " ", 
            RowBox[{"rows", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", 
               RowBox[{"col", "[", 
                RowBox[{"shdr", ",", " ", "\"\<t\>\""}], "]"}]}], "]"}], 
             "]"}]}]}], ";", "\n", "    ", 
          RowBox[{"ph", " ", "=", " ", 
           RowBox[{"Arg", " ", "/@", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"num", "[", 
                 RowBox[{"#", "[", 
                  RowBox[{"[", 
                   RowBox[{"col", "[", 
                    RowBox[{"shdr", ",", " ", "\"\<re_d\>\""}], "]"}], "]"}], 
                  "]"}], "]"}], " ", "+", " ", 
                RowBox[{"I", " ", 
                 RowBox[{"num", "[", 
                  RowBox[{"#", "[", 
                   RowBox[{"[", 
                    RowBox[{"col", "[", 
                    RowBox[{"shdr", ",", " ", "\"\<im_d\>\""}], "]"}], "]"}], 
                   "]"}], "]"}]}]}], " ", "&"}], " ", "/@", " ", "rows"}], 
             ")"}]}]}], ";", "\n", "    ", 
          RowBox[{"(*", " ", "unwrap", " ", "*)"}], "\n", "    ", 
          RowBox[{"ph", " ", "=", " ", 
           RowBox[{"FoldList", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"#1", " ", "+", " ", 
               RowBox[{"Mod", "[", 
                RowBox[{
                 RowBox[{"#2", " ", "-", " ", "#1", " ", "+", " ", "Pi"}], ",",
                  " ", 
                 RowBox[{"2", " ", "Pi"}]}], "]"}], " ", "-", " ", "Pi"}], 
              " ", "&"}], ",", " ", 
             RowBox[{"First", "[", "ph", "]"}], ",", " ", 
             RowBox[{"Rest", "[", "ph", "]"}]}], "]"}]}], ";", "\n", "    ", 
          RowBox[{"fit", " ", "=", " ", 
           RowBox[{"Fit", "[", 
            RowBox[{
             RowBox[{"Transpose", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Rationalize", "[", 
                 RowBox[{"ts", ",", " ", "0"}], "]"}], ",", " ", 
                RowBox[{"Rationalize", "[", 
                 RowBox[{"ph", ",", " ", "0"}], "]"}]}], "}"}], "]"}], ",", 
             " ", 
             RowBox[{"{", 
              RowBox[{"1", ",", " ", "x"}], "}"}], ",", " ", "x"}], "]"}]}], ";",
           "\n", "    ", 
          RowBox[{"{", 
           RowBox[{"r", ",", " ", 
            RowBox[{"Coefficient", "[", 
             RowBox[{"fit", ",", " ", "x"}], "]"}]}], "}"}]}]}], "]"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "jruns"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dev2", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "]"}], " ", "-", " ", 
           RowBox[{"2", "/", "100"}]}], "]"}], "/", 
         RowBox[{"(", 
          RowBox[{"2", "/", "100"}], ")"}]}], " ", "&"}], " ", "/@", " ", 
       "rates"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rvCheck", "[", 
     RowBox[{"\"\<WD-2\>\"", ",", 
      " ", "\"\<the Josephson relation: exp(i mu F t) R_0 exp(-i mu F t) \
solves i dR/dt = [H - mu F, R] for a stationary R_0 \\\nand multiplies the \
pair block by exp(2 i mu t) (symbolic); the phases of d(t) of the Josephson \
runs of the Rust program grow at \\\nthe rate 2 mu = 0.02 (straight-line fit \
in exact arithmetic on the numbers of the file; relative)\>\"", ",", "\n", 
