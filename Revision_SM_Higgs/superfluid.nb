         "noNeutral"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nNeutral", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Count", "[", 
        RowBox[{
         RowBox[{"#", "[", "\"\<qv\>\"", "]"}], ",", " ", "0"}], "]"}], " ", 
       "&"}], " ", "/@", " ", 
      RowBox[{"Select", "[", 
       RowBox[{"channels", ",", " ", 
        RowBox[{
         RowBox[{"StringFreeQ", "[", 
          RowBox[{
           RowBox[{"#", "[", "\"\<sector\>\"", "]"}], ",", 
           " ", "\"\<^dag\>\""}], "]"}], " ", "&"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rvCheck", "[", 
     RowBox[{"\"\<WQN-10e\>\"", ",", 
      " ", "\"\<no pair of two particles of one field and no chi chi' pair is \
