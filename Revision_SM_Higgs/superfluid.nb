           " ", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{"quartic", "[", 
              RowBox[{
               RowBox[{"alpha8", "[", 
                RowBox[{"[", "j", "]"}], "]"}], ",", " ", 
               RowBox[{"alpha8", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}], ")"}]}]}], ",", 
       "\n", "   ", 
