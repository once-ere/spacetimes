Cell[TextData[{
 StyleBox["The decay into pairs of gauge bosons (a remark: what it means and \
why it matters).",
  FontWeight->"Bold"],
 " The width formula above is the width into ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["W", "TI"], "+"], 
    SuperscriptBox[
     StyleBox["W", "TI"], "-"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e29e999a-6633-42ea-a8a2-9146d24b8e05"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["ZZ", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "14386268-e820-4133-a211-5703ac53a83e"],
 " of the new group up to corrections of the relative order of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["M", "TI"], 
       RowBox[{
        StyleBox["W", "TI"], ",", 
        StyleBox["SF",
         FontSlant->"Plain"]}], 
       StyleBox["X", "TI"]], "/", 
      SubsuperscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["H",
         FontSlant->"Plain"]}]]}], ")"}], "2"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a5edb35d-2b5d-4817-bff5-5b4b8592ddff"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["M", "TI"], 
       RowBox[{
        StyleBox["Z", "TI"], ",", 
        StyleBox["SF",
         FontSlant->"Plain"]}], 
       StyleBox["X", "TI"]], "/", 
      SubsuperscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["H",
         FontSlant->"Plain"]}]]}], ")"}], "2"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cbbedee6-27c7-4f78-9005-c0960ccd3e43"],
 ": the equivalence theorem holds at energies large against the masses of the \
bosons, and the decay at rest gives each boson the energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["H",
       FontSlant->"Plain"]}]], "/", "2"}], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "842312df-d5f8-4883-9798-2db3df46dbb0"],
 ". The kinetic part couples ",
 Cell[BoxData[
  FormBox[
   StyleBox["h", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2dafccc3-74be-4193-97c3-3e47ce97f6c3"],
 " to the gauge bosons through their mass terms: both squared masses are \
proportional to the square of the field of the vacuum, so the term linear in ",
 Cell[BoxData[
  FormBox[
   StyleBox["h", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8a324301-3e01-459d-8b84-b2bd50b3ad6d"],
 " of each mass term is that mass term times ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    StyleBox["h", "TI"], "/", 
    SubsuperscriptBox[
     StyleBox["f", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["F",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "41bf3ec3-7a58-41a5-b984-57252d274d42"],
 ", and at tree level the width into a pair of ",
 Cell[BoxData[
  FormBox[
   StyleBox["W", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cb2ff55c-bfbb-48b3-8fb5-aa660eba101f"],
 " bosons is that of the two corresponding Goldstone channels times the factor"
}], "Text",ExpressionUUID->"6b357572-e84d-4170-85fd-444e7127d050"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "-", 
      FractionBox[
       RowBox[{"4", 
        SuperscriptBox[
         RowBox[{"(", 
          SubsuperscriptBox[
           StyleBox["M", "TI"], 
           RowBox[{
            StyleBox["W", "TI"], ",", 
            StyleBox["SF",
             FontSlant->"Plain"]}], 
           StyleBox["X", "TI"]], ")"}], "2"]}], 
       SuperscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox[
          StyleBox["M", "TI"], 
          StyleBox["SF",
           FontSlant->"Plain"], 
          RowBox[{
           StyleBox["X", "TI"], ",", 
           StyleBox["H",
            FontSlant->"Plain"]}]], ")"}], "2"]]}], ")"}], 
    RowBox[{"1", "/", "2"}]], 
   RowBox[{"(", 
    RowBox[{"1", "-", 
     FractionBox[
      RowBox[{"4", 
       SuperscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox[
          StyleBox["M", "TI"], 
          RowBox[{
           StyleBox["W", "TI"], ",", 
           StyleBox["SF",
            FontSlant->"Plain"]}], 
          StyleBox["X", "TI"]], ")"}], "2"]}], 
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox[
         StyleBox["M", "TI"], 
         StyleBox["SF",
          FontSlant->"Plain"], 
         RowBox[{
          StyleBox["X", "TI"], ",", 
          StyleBox["H",
           FontSlant->"Plain"]}]], ")"}], "2"]], "+", 
     FractionBox[
      RowBox[{"12", 
       SuperscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox[
          StyleBox["M", "TI"], 
          RowBox[{
           StyleBox["W", "TI"], ",", 
           StyleBox["SF",
            FontSlant->"Plain"]}], 
          StyleBox["X", "TI"]], ")"}], "4"]}], 
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox[
         StyleBox["M", "TI"], 
         StyleBox["SF",
          FontSlant->"Plain"], 
         RowBox[{
          StyleBox["X", "TI"], ",", 
          StyleBox["H",
           FontSlant->"Plain"]}]], ")"}], "4"]]}], ")"}]}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"5bf0f2bd-ca1c-4ba4-adb6-4f9aadbbe886"],

Cell[TextData[{
 "(the phase space, and the sum over the polarizations of the two bosons, \
whose transverse parts the Goldstone fields do not have), and the same with \
",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["M", "TI"], 
    RowBox[{
     StyleBox["Z", "TI"], ",", 
     StyleBox["SF",
      FontSlant->"Plain"]}], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bbfc2ad8-1b35-4991-a2b6-a9aa53432a2b"],
 " for ",
 Cell[BoxData[
  FormBox[
   StyleBox["ZZ", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4a21276f-1885-42c0-988f-713ca861bfcb"],
 ". The next cell computes, for every method, the larger of the ratios ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     RowBox[{
      StyleBox["W", "TI"], ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]], "/", 
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["H",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e689d615-5ff4-45b8-88cd-075e10b67fe5"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     RowBox[{
      StyleBox["Z", "TI"], ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]], "/", 
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["H",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2ba3207b-a245-4226-947e-ea769c0c6bab"],
 ", the smaller of the two factors, and how much the masses of the effective \
Lagrangian exceed those of the linear response. The ratio is at most 0.106 \
(KS and CJT) and the factor at least 0.934, so the width formula \
overestimates the width into ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["W", "TI"], "+"], 
    SuperscriptBox[
     StyleBox["W", "TI"], "-"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7cd4ca26-4bf0-4c3a-87ec-4c9ac4bbd5da"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["ZZ", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d18f0575-c40b-4e61-9469-8894226ca854"],
 " of the new group by less than 7 per cent. It matters little: that is far \
less than the uncertainty of the effective Lagrangian at the energy of the \
mode (the remark above), and the conclusion, a broad resonance, does not \
depend on it."
}], "Text",ExpressionUUID->"f3cfe24b-13fc-4259-900a-1e9081033a9c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "the", " ", "decay", " ", "into", " ", "a", " ", "pair", " ", "of", " ", 
     "W", " ", "or", " ", "Z", " ", 
     RowBox[{"bosons", ":", " ", 
      RowBox[{"the", " ", "larger", " ", "of", " ", "the", " ", "ratios", " ", 
       RowBox[{"M_W", "/", "M_H"}], " ", "and", " ", 
       RowBox[{"M_Z", "/", "M_H"}], " ", 
       RowBox[{"(", 
        RowBox[{"gzVV", "[", "\"\<ratio\>\"", "]"}], ")"}]}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"the", " ", "tree"}], "-", 
     RowBox[{"level", "\n", "   ", "factor", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", " ", "-", " ", 
         RowBox[{"4", " ", "r"}]}], ")"}], "^", 
       RowBox[{"(", 
        RowBox[{"1", "/", "2"}], ")"}]}], " ", 
      RowBox[{"(", 
       RowBox[{"1", " ", "-", " ", 
        RowBox[{"4", " ", "r"}], " ", "+", " ", 
        RowBox[{"12", " ", 
         RowBox[{"r", "^", "2"}]}]}], ")"}], " ", "with", " ", "r", " ", 
      "the", " ", "square", " ", "of", " ", "that", " ", "ratio", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"gzVV", "[", "\"\<factor\>\"", "]"}], ";", " ", 
        RowBox[{
        "the", " ", "smaller", " ", "of", " ", "the", " ", "factors", "\n", 
         "   ", "of", " ", "W", " ", "and", " ", "Z"}]}], ")"}]}]}], ",", " ", 
    RowBox[{
    "and", " ", "the", " ", "masses", " ", "of", " ", "the", " ", "effective",
      " ", "Lagrangian", " ", 
     RowBox[{"(", 
      RowBox[{
      "the", " ", "curvature", " ", "of", " ", "the", " ", "potential", " ", 
       "and", " ", "the", " ", "kinetic", " ", "part"}], ")"}], " ", 
     "against", "\n", "   ", "the", " ", "linear", " ", "response"}], ",", 
    " ", 
    RowBox[{"in", " ", "per", " ", "cent"}], ",", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"for", " ", "the", " ", "amplitude", " ", "mode", " ", 
       RowBox[{"(", 
        RowBox[{"gzVV", "[", "\"\<effH\>\"", "]"}], ")"}], " ", "and", " ", 
       "for", " ", "the", " ", "non"}], "-", 
      RowBox[{"unitary", " ", "modes", " ", 
       RowBox[{"(", 
        RowBox[{"gzVV", "[", "\"\<effNU\>\"", "]"}], ")"}]}]}], ";", "\n", 
     "   ", 
     RowBox[{
      RowBox[{"the", " ", "masses", " ", "M_W"}], " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"g", "^", "v"}], " ", "f_I", " ", "and", " ", "M_Z"}], " ", "=",
        " ", 
       RowBox[{"2", " ", 
        RowBox[{"g", "^", "F"}], " ", "f_F", " ", "are", " ", "those", " ", 
        "of", " ", "gzHiggs"}]}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"gzVV", "[", "t_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"hg", " ", "=", " ", 
          RowBox[{"gzHiggs", "[", "t", "]"}]}], ",", " ", "mw", ",", " ", 
         "mz", ",", " ", "r"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"mw", " ", "=", " ", 
         RowBox[{"gvLL", " ", 
          RowBox[{"hg", "[", "\"\<fI\>\"", "]"}]}]}], ";", " ", 
        RowBox[{"mz", " ", "=", " ", 
         RowBox[{"2", " ", "gfLL", " ", 
          RowBox[{"hg", "[", "\"\<fF\>\"", "]"}]}]}], ";", " ", 
        RowBox[{"r", " ", "=", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Max", "[", 
             RowBox[{"mw", ",", " ", "mz"}], "]"}], "/", 
            RowBox[{"hg", "[", "\"\<MH\>\"", "]"}]}], ")"}], "^", "2"}]}], ";",
         "\n", "   ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<ratio\>\"", " ", "->", " ", 
           RowBox[{"Sqrt", "[", "r", "]"}]}], ",", " ", 
          RowBox[{"\"\<factor\>\"", " ", "->", " ", 
           RowBox[{
            RowBox[{"Sqrt", "[", 
             RowBox[{"1", " ", "-", " ", 
              RowBox[{"4", " ", "r"}]}], "]"}], " ", 
            RowBox[{"(", 
             RowBox[{"1", " ", "-", " ", 
              RowBox[{"4", " ", "r"}], " ", "+", " ", 
              RowBox[{"12", " ", 
               RowBox[{"r", "^", "2"}]}]}], ")"}]}]}], ",", "\n", "     ", 
          RowBox[{"\"\<effH\>\"", " ", "->", " ", 
           RowBox[{"100", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"rustPart3", "[", 
                RowBox[{"\"\<p3_MH_\>\"", " ", "<>", " ", "t"}], "]"}], "/", 
               RowBox[{"rustPart3", "[", 
                RowBox[{"\"\<p3_MH_RPA_\>\"", " ", "<>", " ", "t"}], "]"}]}], 
              " ", "-", " ", "1"}], ")"}]}]}], ",", " ", 
          RowBox[{"\"\<effNU\>\"", " ", "->", " ", 
           RowBox[{"100", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"rustPart3", "[", 
                RowBox[{"\"\<p3_MNU_\>\"", " ", "<>", " ", "t"}], "]"}], "/", 
               
               RowBox[{"rustPart3", "[", 
                RowBox[{"\"\<p3_MNU_RPA_\>\"", " ", "<>", " ", "t"}], "]"}]}],
               " ", "-", " ", "1"}], ")"}]}]}]}], "|>"}]}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"q", " ", "=", " ", 
             RowBox[{"gzVV", "[", "t", "]"}]}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"thName", "[", "t", "]"}], ",", " ", 
             RowBox[{"NumberForm", "[", 
              RowBox[{
               RowBox[{"q", "[", "\"\<ratio\>\"", "]"}], ",", " ", "4"}], 
              "]"}], ",", " ", 
             RowBox[{"NumberForm", "[", 
              RowBox[{
               RowBox[{"q", "[", "\"\<factor\>\"", "]"}], ",", " ", "4"}], 
              "]"}], ",", " ", 
             RowBox[{"NumberForm", "[", 
              RowBox[{
               RowBox[{"q", "[", "\"\<effH\>\"", "]"}], ",", " ", "3"}], 
              "]"}], ",", " ", 
             RowBox[{"NumberForm", "[", 
              RowBox[{
               RowBox[{"q", "[", "\"\<effNU\>\"", "]"}], ",", " ", "3"}], 
              "]"}]}], "}"}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"t", ",", " ", "thTags"}], "}"}]}], "]"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<method\>\"", ",", " ", "\"\<max(M_W, M_Z)/M_H\>\"", ",", 
         " ", "\"\<tree-level factor\>\"", ",", 
         " ", "\"\<M_H: L^X over response - 1 (per cent)\>\"", ",", 
         " ", "\"\<M_NU: L^X over response - 1 (per cent)\>\""}], "}"}]}], 
      "]"}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
     RowBox[{"Alignment", " ", "->", " ", "Right"}], ",", " ", 
     RowBox[{"BaseStyle", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"FontSize", " ", "->", " ", "8"}], "}"}]}]}], 
    "]"}]}]}]], "Input",
 CellLabel->
  "In[405]:=",ExpressionUUID->"eb0bf06d-3df4-421f-b5b9-b8fd78d90ed3"],

