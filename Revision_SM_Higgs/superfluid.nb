Cell[CellGroupData[{

Cell["R.1.4 The charges (check WQN-4)", "Subsection",ExpressionUUID->"454dbbfb-4fe8-4eb4-b54a-15ab05236dfc"],

Cell[TextData[{
 "The diagonal of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["Q", "TI"], 
    StyleBox["SM",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "efc00222-5b83-4883-ac2f-783afdc7e3a3"],
 " gives the electric charges of the sixteen components: ",
 Cell[BoxData[
  FormBox[
   FractionBox["3", "4"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b654504d-4753-4b81-bd60-42ae0d876701"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    FractionBox["1", "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bf7d33df-9813-4771-9960-95215f14543f"],
 " alternating on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1cede420-ba34-41e9-8647-9f6ca4ca3c44"],
 " (up and down), ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "4"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "39c7416a-5db5-400b-bd8c-3bf45bfaccb0"],
 " on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Chi]", 
    StyleBox["SH",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2a655372-594f-42eb-bbac-e78a3d0c6d6e"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    FractionBox["3", "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8a94c82b-852d-4deb-a7ea-1bd6ef1641c0"],
 " on ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Chi]", 
    StyleBox["SH",
     FontSlant->"Plain"], "\[Prime]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "07e52cad-28c9-4f31-8f1d-d0963c9d691d"],
 ". The first version made the fermion number the hypercharge, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["Y", "TI"], 
     StyleBox["SM",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["F", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "/", "4"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8f7b2007-2f39-43c9-a4ee-512831d391a8"],
 "; with ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Chi]", 
    StyleBox["SH",
     FontSlant->"Plain"], "\[Prime]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5d8de4e9-3b16-44f2-baf5-a6cf14b3e204"],
 " that holds on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d922f0f3-a05a-4b16-9679-7779b71a1855"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Chi]", 
    StyleBox["SH",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "272ce9aa-9e49-480a-8de3-c8164e9143f5"],
 " but not on ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Chi]", 
    StyleBox["SH",
     FontSlant->"Plain"], "\[Prime]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "31044cd2-ec7f-4c52-85f9-1af6b4e94266"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"4", 
    SuperscriptBox[
     StyleBox["Y", "TI"], 
     StyleBox["SM",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"-", "3"}], 
    SubsuperscriptBox[
     StyleBox["F", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["tot",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7ad197da-7fb8-40d7-b009-2b0b2310b71f"],
 ". The quadratic Casimir operators show the multiplets: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["a", "TI"],
     LimitsPositioning->True], 
    SuperscriptBox[
     RowBox[{"(", 
      SuperscriptBox[
       StyleBox["T", "TI"], 
       RowBox[{
        StyleBox["a", "TI"], ",", 
        StyleBox["SM",
         FontSlant->"Plain"]}]], ")"}], "2"], "\[LongEqual]", 
    FractionBox["3", "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "68978a69-be8a-4e8f-af40-7cbc083d30fe"],
 " on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "75483283-f91a-4c8b-84f2-ff2d3fb0f39f"],
 " (a doublet of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["L", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9585673b-0989-4437-9b1e-d48545cb2d54"],
 ") and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["a", "TI"],
     LimitsPositioning->True], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["T", "TI"], 
       StyleBox["SH",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["a", "TI"], ",", 
        StyleBox["R",
         FontSlant->"Plain"]}]], ")"}], "2"], "\[LongEqual]", 
    FractionBox["3", "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "168ace5c-0e85-47da-929b-575ab1f27e4f"],
 " on the singlets (a doublet of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["R",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "91641201-b0c2-485d-8ca8-eef71c2a8810"],
 ")."
}], "Text",ExpressionUUID->"5df63876-3e00-4c55-8680-228fc6e714d9"],

