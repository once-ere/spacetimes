      RowBox[{"Join", "[", 
       RowBox[{"wq", ",", " ", "wq"}], "]"}], "/", "2"}]}], ";", " ", 
    RowBox[{"nps", " ", "=", " ", 
     RowBox[{"Length", "[", "eps2", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dl0", " ", "=", " ", 
     RowBox[{"dd", " ", "/.", " ", 
      RowBox[{"FindRoot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"gSH", "/", "2"}], " ", 
          RowBox[{"Total", "[", 
           RowBox[{"w2", "/", 
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{"eps2", "^", "2"}], " ", "+", " ", 
              RowBox[{"dd", "^", "2"}]}], "]"}]}], "]"}]}], " ", "==", " ", 
         "1"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"dd", ",", " ", 
          RowBox[{"2", "/", "5"}]}], "}"}], ",", " ", 
        RowBox[{"WorkingPrecision", " ", "->", " ", "25"}]}], "]"}]}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"kick", " ", "=", " ", 
