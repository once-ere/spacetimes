   RowBox[{
    RowBox[{"vx", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Symbol", "[", 
        RowBox[{"\"\<px\>\"", " ", "<>", " ", 
         RowBox[{"ToString", "[", "j", "]"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "nps"}], "}"}]}], "]"}]}], ";", " ", 
    RowBox[{"vy", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Symbol", "[", 
        RowBox[{"\"\<py\>\"", " ", "<>", " ", 
         RowBox[{"ToString", "[", "j", "]"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "nps"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"vz", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Symbol", "[", 
        RowBox[{"\"\<pz\>\"", " ", "<>", " ", 
         RowBox[{"ToString", "[", "j", "]"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "nps"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dxt", " ", "=", " ", 
     RowBox[{
      RowBox[{"gSH", "/", "2"}], " ", 
      RowBox[{"Total", "[", 
       RowBox[{"w2", " ", 
        RowBox[{"Through", "[", 
         RowBox[{"vx", "[", "tq", "]"}], "]"}]}], "]"}]}]}], ";", " ", 
    RowBox[{"dyt", " ", "=", " ", 
     RowBox[{
      RowBox[{"gSH", "/", "2"}], " ", 
      RowBox[{"Total", "[", 
       RowBox[{"w2", " ", 
        RowBox[{"Through", "[", 
         RowBox[{"vy", "[", "tq", "]"}], "]"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"eqs", " ", "=", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", "\n", "     ", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"vx", "[", 
              RowBox[{"[", "j", "]"}], "]"}], "'"}], "[", "tq", "]"}], " ", "==",
            " ", 
           RowBox[{"2", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"-", "dyt"}], ")"}], " ", 
               RowBox[{
                RowBox[{"vz", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], "[", "tq", "]"}]}], " ", "-",
               " ", 
              RowBox[{
               RowBox[{"eps2", "[", 
                RowBox[{"[", "j", "]"}], "]"}], " ", 
               RowBox[{
                RowBox[{"vy", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], "[", "tq", "]"}]}]}], 
             ")"}]}]}], ",", "\n", "     ", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"vy", "[", 
              RowBox[{"[", "j", "]"}], "]"}], "'"}], "[", "tq", "]"}], " ", "==",
            " ", 
           RowBox[{"2", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"eps2", "[", 
                RowBox[{"[", "j", "]"}], "]"}], " ", 
               RowBox[{
                RowBox[{"vx", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], "[", "tq", "]"}]}], " ", "-",
               " ", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"-", "dxt"}], ")"}], " ", 
               RowBox[{
                RowBox[{"vz", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], "[", "tq", "]"}]}]}], 
             ")"}]}]}], ",", "\n", "     ", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"vz", "[", 
              RowBox[{"[", "j", "]"}], "]"}], "'"}], "[", "tq", "]"}], " ", "==",
            " ", 
           RowBox[{"2", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"-", "dxt"}], ")"}], " ", 
               RowBox[{
                RowBox[{"vy", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], "[", "tq", "]"}]}], " ", "-",
               " ", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"-", "dyt"}], ")"}], " ", 
               RowBox[{
                RowBox[{"vx", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], "[", "tq", "]"}]}]}], 
             ")"}]}]}], ",", "\n", "     ", 
          RowBox[{
           RowBox[{
            RowBox[{"vx", "[", 
             RowBox[{"[", "j", "]"}], "]"}], "[", "0", "]"}], " ", "==", " ", 
           
           RowBox[{"N", "[", 
            RowBox[{"nx0", "[", 
             RowBox[{"[", "j", "]"}], "]"}], "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"vy", "[", 
             RowBox[{"[", "j", "]"}], "]"}], "[", "0", "]"}], " ", "==", " ", 
           "0"}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"vz", "[", 
             RowBox[{"[", "j", "]"}], "]"}], "[", "0", "]"}], " ", "==", " ", 
           
           RowBox[{"N", "[", 
            RowBox[{"nz0", "[", 
             RowBox[{"[", "j", "]"}], "]"}], "]"}]}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"j", ",", " ", "nps"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sol", " ", "=", " ", 
     RowBox[{"First", "[", 
      RowBox[{"NDSolve", "[", 
       RowBox[{"eqs", ",", " ", 
        RowBox[{"Join", "[", 
         RowBox[{"vx", ",", " ", "vy", ",", " ", "vz"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"tq", ",", " ", "0", ",", " ", "50"}], "}"}], ",", " ", 
        RowBox[{"Method", " ", "->", " ", 
         RowBox[{"{", "\"\<IDA\>\"", "}"}]}], ",", " ", 
        RowBox[{"PrecisionGoal", " ", "->", " ", "11"}], ",", " ", 
        RowBox[{"AccuracyGoal", " ", "->", " ", "13"}], ",", "\n", "     ", 
        RowBox[{"MaxSteps", " ", "->", " ", 
         RowBox[{"10", "^", "7"}]}]}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"dps", "[", "t_", "]"}], " ", ":=", " ", 
     RowBox[{"2", " ", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"gSH", "/", "2"}], " ", 
           RowBox[{"Total", "[", 
            RowBox[{"w2", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Through", "[", 
                RowBox[{"vx", "[", "t", "]"}], "]"}], " ", "/.", " ", "sol"}],
               ")"}]}], "]"}]}], ")"}], "^", "2"}], " ", "+", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"gSH", "/", "2"}], " ", 
           RowBox[{"Total", "[", 
            RowBox[{"w2", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Through", "[", 
                RowBox[{"vy", "[", "t", "]"}], "]"}], " ", "/.", " ", "sol"}],
               ")"}]}], "]"}]}], ")"}], "^", "2"}]}], "]"}]}]}], ";"}], "\n", 
   
   RowBox[{
    RowBox[{"amp", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{"srows", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", 
            RowBox[{"col", "[", 
             RowBox[{"shdr", ",", " ", "\"\<run\>\""}], "]"}], "]"}], "]"}], 
          " ", "==", " ", "\"\<amplitude_second_HS0_0\>\""}], " ", "&&", " ", 
         
         RowBox[{
          RowBox[{"num", "[", 
           RowBox[{"#", "[", 
            RowBox[{"[", 
             RowBox[{"col", "[", 
              RowBox[{"shdr", ",", " ", "\"\<t\>\""}], "]"}], "]"}], "]"}], 
           "]"}], " ", "<=", " ", "50"}]}], " ", "&"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dev5", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"dps", "[", 
            RowBox[{"num", "[", 
             RowBox[{"r", "[", 
              RowBox[{"[", 
               RowBox[{"col", "[", 
                RowBox[{"shdr", ",", " ", "\"\<t\>\""}], "]"}], "]"}], "]"}], 
             "]"}], "]"}], " ", "-", " ", 
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"num", "[", 
              RowBox[{"r", "[", 
               RowBox[{"[", 
                RowBox[{"col", "[", 
                 RowBox[{"shdr", ",", " ", "\"\<re_d\>\""}], "]"}], "]"}], 
               "]"}], "]"}], " ", "+", " ", 
             RowBox[{"I", " ", 
              RowBox[{"num", "[", 
               RowBox[{"r", "[", 
                RowBox[{"[", 
                 RowBox[{"col", "[", 
                  RowBox[{"shdr", ",", " ", "\"\<im_d\>\""}], "]"}], "]"}], 
                "]"}], "]"}]}]}], "]"}]}], "]"}], "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "dl0"}], ")"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"r", ",", " ", "amp"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rvCheck", "[", 
     RowBox[{"\"\<WD-5\>\"", ",", " ", 
      RowBox[{"\"\<HS (0, 0): the reduced model of 48 Anderson pseudospins \
(one at +eps_k and one at -eps_k for each of the 24 \\\nradial nodes, eps_k = \
(k^2 + m^2)^(1/2)), integrated here by NDSolve with the method IDA, gives d_0 \
= 2 Delta_0 = \>\"", " ", "<>", "\n", "  ", 
       RowBox[{"ToString", "[", 
        RowBox[{"NumberForm", "[", 
         RowBox[{
          RowBox[{"N", "[", 
           RowBox[{
            RowBox[{"2", " ", "dl0"}], ",", " ", "15"}], "]"}], ",", " ", 
          "15"}], "]"}], "]"}], " ", "<>", 
       " ", "\"\< from its gap equation and, after the kick 1e-3, the d(t) of \
the Rust program for \\\n0 <= t <= 50 (largest |difference| / d_0, at the \
\>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"Length", "[", "amp", "]"}], "]"}], " ", "<>", 
       " ", "\"\< stored times)\>\""}], ",", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
