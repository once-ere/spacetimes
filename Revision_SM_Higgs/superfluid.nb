               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", 
                  RowBox[{"col", "[", 
                   RowBox[{"shdr", ",", " ", "\"\<run\>\""}], "]"}], "]"}], 
                 "]"}], " ", "==", " ", "r"}], " ", "&"}]}], "]"}]}], ",", 
           " ", "ts", ",", " ", "ph", ",", " ", "fit"}], "}"}], ",", "\n", 
         "    ", 
         RowBox[{
          RowBox[{"ts", " ", "=", " ", 
           RowBox[{"num", " ", "/@", " ", 
            RowBox[{"rows", "[", 
