]}]}]}]}]}]}]}], " ", "and", " ", "Dirac", " ", "matrices"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sig", "[", "0", "]"}], " ", "=", " ", 
   RowBox[{"IdentityMatrix", "[", "2", "]"}]}], ";", " ", 
  RowBox[{
   RowBox[{"sig", "[", "1", "]"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "0"}], "}"}]}], "}"}]}], ";", " ", 
  RowBox[{
   RowBox[{"sig", "[", "2", "]"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", " ", 
       RowBox[{"-", "I"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"I", ",", " ", "0"}], "}"}]}], "}"}]}], ";", " ", 
  RowBox[{
   RowBox[{"sig", "[", "3", "]"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", 
       RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sigbar", "[", "0", "]"}], " ", "=", " ", 
   RowBox[{"sig", "[", "0", "]"}]}], ";", " ", 
  RowBox[{
   RowBox[{"sigbar", "[", "j_", "]"}], " ", ":=", " ", 
   RowBox[{"-", 
    RowBox[{"sig", "[", "j", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"z2", " ", "=", " ", 
