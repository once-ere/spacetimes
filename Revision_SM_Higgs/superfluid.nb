              RowBox[{"[", "k", "]"}], "]"}], "]"}], " ", ".", " ", 
            RowBox[{"piOps", "[", 
             RowBox[{"[", "k", "]"}], "]"}]}], ",", " ", 
           RowBox[{"{", 
