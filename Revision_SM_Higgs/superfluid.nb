      RowBox[{"{", 
       RowBox[{"8", ",", " ", "8"}], "}"}]}], "]"}]}], ";", " ", 
   RowBox[{"i2", " ", "=", " ", 
    RowBox[{"IdentityMatrix", "[", "2", "]"}]}], ";", " ", 
   RowBox[{"i4", " ", "=", " ", 
    RowBox[{"IdentityMatrix", "[", "4", "]"}]}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", 
          RowBox[{"--", 
           RowBox[{"--", 
