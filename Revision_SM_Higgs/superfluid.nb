Cell[CellGroupData[{

Cell["II.3 The recursion of the potential and the ground states", "Section",ExpressionUUID->"2e9c4510-bce2-4d05-8ddf-391f7f4a6e59"],

Cell[TextData[{
 "The task asks to change the potential until all three methods admit a \
superfluid. ",
 StyleBox["The effective couplings.",
  FontWeight->"Bold"],
 " For a uniform state whose normal self-energy is a Dirac mass and whose \
pair self-energy lies in the channel ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "76924896-de73-44d7-b0c0-9cdd8a10c62e"],
 ", every method acts through two numbers: the scalar coupling ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["S",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2d4cf8c8-8ebc-4a26-adaa-42c40aacd98e"],
 " (the shift of the Dirac mass per unit scalar density) and the pair \
coupling ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["P",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "40f2db42-d07e-4e32-a2d9-56a6f1ab9d0c"],
 " (the pair self-energy per unit pair amplitude), computed by ",
 StyleBox["effCouplings",
  FontFamily->"Source Code Pro"],
 " from the self-energy maps of the terms. The normal vacuum is unstable \
towards pairing when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Lambda]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["P",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["P",
       FontSlant->"Plain"]}]], "/", 
    SubsuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["crit",
      FontSlant->"Plain"]], ">", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dbe23a56-fbd8-4d14-8aca-fb250c80c1fc"],
 ", with the critical pair coupling of AS3,"
}], "Text",ExpressionUUID->"b3035f72-169f-4af8-aebf-bd2a2b1b2576"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["crit",
     FontSlant->"Plain"]], "\[LongEqual]", 
   FractionBox[
    SuperscriptBox["\[Pi]", "2"], 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["I", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{"(", "1", ")"}]], 
     RowBox[{"(", 
      SubscriptBox[
       StyleBox["m", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]], ")"}]}]], ",", "      ", 
   SubsuperscriptBox[
    StyleBox["I", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "1", ")"}]], 
   RowBox[{"(", 
    StyleBox["M", "TI"], ")"}], "\[LongEqual]", 
   SubsuperscriptBox["\[Integral]", "0", 
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]], "\[ThinSpace]", 
   FractionBox[
    RowBox[{
     SuperscriptBox[
      StyleBox["q", "TI"], "2"], "\[ThinSpace]", 
     StyleBox["dq", "TI"]}], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        StyleBox["q", "TI"], "2"], "+", 
       SuperscriptBox[
        StyleBox["M", "TI"], "2"]}], ")"}], 
     RowBox[{"1", "/", "2"}]]], "\[LongEqual]", 
   FractionBox["1", "2"], 
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "+", 
        SuperscriptBox[
         StyleBox["M", "TI"], "2"]}], ")"}], 
      RowBox[{"1", "/", "2"}]], "-", 
     SuperscriptBox[
      StyleBox["M", "TI"], "2"], "\[ThinSpace]", 
     StyleBox["arsinh",
      FontSlant->"Plain"], 
     FractionBox["1", 
      StyleBox["M", "TI"]]}], ")"}], "."}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"0d3398e1-168e-49da-b825-2d09cfccafcc"],

Cell[TextData[{
 StyleBox["The three potentials.",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "0", ")"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f514ca8e-3a64-47f7-8915-54a6d420ccf7"],
 " (the author's: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["S",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"-", "8"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "360df55e-42f6-42d9-8b5d-8d5f959fefc5"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["V",
      FontSlant->"Plain"]], "\[LongEqual]", "0.8"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1ba75270-373b-48c0-8fb8-facf90f9cf16"],
 ", no pairing term) admits no superfluid in any method. ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "1", ")"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4ae932d7-17e1-464b-9409-e1e786db778f"],
 " adds the pairing term with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "22.5"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a58158a7-8d02-4c7a-a63b-f928f5da76e0"],
 ", the value of AS3: HS becomes superfluid, but in KS and CJT the exchange \
contraction of the pairing term acts in the scalar channel as an attraction, \
the scalar channel becomes unstable, and the ground state is a massive state. \
",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "2", ")"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "828fa2bb-f0a8-4e23-b98c-99054224cab5"],
 " keeps the form and the vector coupling and fixes ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["S",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "62c5b409-fcb5-4b3c-a668-99a8a0996480"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "50fdab3d-8aca-4b90-b782-e845bf4f4b46"],
 " by two conditions on the CJT couplings: the scalar coupling of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "0", ")"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "99495b18-b4c8-4c00-81b0-90903dbf71c6"],
 " (stable) and the pair coupling of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "1", ")"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c25410ed-0022-432b-aa58-4da157b58064"],
 " (supercritical). The couplings are linear in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["G", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      StyleBox["S",
       FontSlant->"Plain"]], ",", 
     SubscriptBox[
      StyleBox["G", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"]]}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "31316fe9-124d-4271-9bd1-291a132a65da"],
 ", so the conditions are two linear equations, which the next cell solves \
from the computed couplings; the solution is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["S",
      FontSlant->"Plain"]], "\[LongEqual]", "2.8"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "314c3c3f-0b0b-44a4-9ea9-55d851992259"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "25.2"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b828d5fb-e4d4-41d2-ad85-7e7c41a94668"],
 ":"
}], "Text",ExpressionUUID->"1c3f937b-f04b-4232-b2c2-ab9171e6b37c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "2", ")"}]], "\[LongEqual]", 
   FractionBox["1", "2"], 
   RowBox[{"(", "2.8", ")"}], ":", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       OverscriptBox["\[CapitalPsi]", "_"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      SubscriptBox["\[CapitalPsi]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}], "2"], ":", 
   RowBox[{"+", 
    FractionBox["1", "2"]}], 
   RowBox[{"(", "0.8", ")"}], "\[ThinSpace]", 
   UnderscriptBox["\[Sum]", 
    StyleBox["p", "TI"],
    LimitsPositioning->True], "\[ThinSpace]", 
   SubsuperscriptBox["\[Eta]", 
    StyleBox["pp", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], ":", 
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["j", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["F",
        FontSlant->"Plain"], ",", 
       StyleBox["p", "TI"]}]], ")"}], "2"], ":", 
   RowBox[{"-", 
    FractionBox["1", "4"]}], 
   RowBox[{"(", "25.2", ")"}], "\[ThinSpace]", 
   UnderscriptBox["\[Sum]", "\[Iota]",
    LimitsPositioning->True], ":", 
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox["\[CapitalPi]", 
      StyleBox["LL",
       FontSlant->"Plain"], "\[Iota]"], ")"}], "\[Dagger]"], 
   SubsuperscriptBox["\[CapitalPi]", 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Iota]"], ":", "."}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"6c3ed712-8edd-4b3a-a9dd-aea46ef96579"],

Cell[TextData[{
 "For each of the three potentials and the five methods, the cell after it \
computes the effective couplings and the stationary states reached from three \
starts (a polar pair ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.3", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "27468b69-da63-4d81-8887-d235bd74975e"],
 "; a Dirac mass lowered by 1; a Dirac mass raised by 0.5), keeps the one of \
lowest energy (the ground state), and computes its energy per volume, its \
pair amplitude ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftBracketingBar]", 
    SubsuperscriptBox[
     StyleBox["D", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], "\[RightBracketingBar]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "881ed310-941e-480e-afe0-92550cfa70e9"],
 ", its Dirac mass and its gap. The ground state of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "2", ")"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3c9c470d-2016-40b0-9db5-8e3a4c7593b8"],
 " is a polar superfluid in every method. Each number is compared with that \
of the Rust program. (This cell computes 45 self-consistent states; it takes \
a few minutes.)"
}], "Text",ExpressionUUID->"78cf92a9-43d5-40e4-bf9d-2f25244ca835"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"the", " ", "critical", " ", "pair", " ", "coupling", " ", 
    RowBox[{
     RowBox[{"pi", "^", "2"}], "/", "I1"}], 
    RowBox[{"(", "m", ")"}], " ", "and", " ", "the", " ", "coefficients", " ",
     "of", " ", 
    RowBox[{"V", "^", 
     RowBox[{"(", "2", ")"}]}], " ", "from", " ", "the", " ", "two", " ", 
    "conditions", " ", "on", " ", "the", " ", "CJT", " ", "couplings"}], " ", 
   "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"gCrit", " ", "=", " ", 
     RowBox[{
      RowBox[{"Pi", "^", "2"}], "/", 
      RowBox[{"(", 
       RowBox[{"0.5", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Sqrt", "[", 
           RowBox[{"1", " ", "+", " ", 
            RowBox[{"mLL", "^", "2"}]}], "]"}], " ", "-", " ", 
          RowBox[{
           RowBox[{"mLL", "^", "2"}], " ", 
           RowBox[{"ArcSinh", "[", 
            RowBox[{"1", "/", "mLL"}], "]"}]}]}], ")"}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WP2-6b\>\"", ",", " ", 
      RowBox[{"\"\<the critical pair coupling pi^2/I1(m) = \>\"", " ", "<>", 
       " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"NumberForm", "[", 
         RowBox[{
          RowBox[{"N", "[", "gCrit", "]"}], ",", " ", "11"}], "]"}], "]"}]}], 
      ",", " ", 
      RowBox[{"Abs", "[", 
       RowBox[{"gCrit", " ", "-", " ", 
        RowBox[{"rustPart2", "[", "\"\<p2_Gcrit\>\"", "]"}]}], "]"}], ",", 
      " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}], ",", " ", "\"\<P2-6b\>\"", ",", 
      " ", "\"\<YP2-6b\>\""}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"f", " ", "=", " ", 
         RowBox[{
          RowBox[{"effCouplings", "[", 
           RowBox[{
            RowBox[{"{", "\"\<CJT\>\"", "}"}], ",", " ", "#1", ",", " ", 
            "0.8", ",", " ", "#2"}], "]"}], " ", "&"}]}], ",", " ", "s0", ",",
         " ", "p0", ",", " ", "s1", ",", " ", "p1", ",", " ", "s2", ",", " ", 
        "p2", ",", " ", "st", ",", " ", "pt"}], "}"}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"s0", ",", " ", "p0"}], "}"}], " ", "=", " ", 
        RowBox[{"f", "[", 
         RowBox[{"0.", ",", " ", "0."}], "]"}]}], ";", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"s1", ",", " ", "p1"}], "}"}], " ", "=", " ", 
        RowBox[{"f", "[", 
         RowBox[{"1.", ",", " ", "0."}], "]"}]}], ";", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"s2", ",", " ", "p2"}], "}"}], " ", "=", " ", 
        RowBox[{"f", "[", 
         RowBox[{"0.", ",", " ", "1."}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"st", " ", "=", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"effCouplings", "[", 
           RowBox[{
            RowBox[{"{", "\"\<CJT\>\"", "}"}], ",", " ", 
            RowBox[{"-", "8."}], ",", " ", "0.8", ",", " ", "0."}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", "s0"}]}], ";", "\n", 
       "  ", 
       RowBox[{"pt", " ", "=", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"effCouplings", "[", 
           RowBox[{
            RowBox[{"{", "\"\<CJT\>\"", "}"}], ",", " ", 
            RowBox[{"-", "8."}], ",", " ", "0.8", ",", " ", "22.5"}], "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", "p0"}]}], ";", "\n", 
       "  ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"gS2", ",", " ", "gP2"}], "}"}], " ", "=", " ", 
        RowBox[{"LinearSolve", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"s1", " ", "-", " ", "s0"}], ",", " ", 
              RowBox[{"s2", " ", "-", " ", "s0"}]}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"p1", " ", "-", " ", "p0"}], ",", " ", 
              RowBox[{"p2", " ", "-", " ", "p0"}]}], "}"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"st", ",", " ", "pt"}], "}"}]}], "]"}]}]}]}], "]"}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WP2-6a\>\"", ",", " ", 
      RowBox[{"\"\<V^(2) from the conditions on the CJT effective couplings: \
(G^S, G) = (\>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"NumberForm", "[", 
         RowBox[{"gS2", ",", " ", "11"}], "]"}], "]"}], " ", "<>", 
       " ", "\"\<, \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"NumberForm", "[", 
         RowBox[{"gP2", ",", " ", "11"}], "]"}], "]"}], " ", "<>", 
       " ", "\"\<)\>\""}], ",", "\n", "  ", 
      RowBox[{"Max", "[", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"gS2", " ", "-", " ", 
          RowBox[{"rustPart2", "[", "\"\<p2_V2_GS\>\"", "]"}]}], "]"}], ",", 
        " ", 
        RowBox[{"Abs", "[", 
         RowBox[{"gP2", " ", "-", " ", 
          RowBox[{"rustPart2", "[", "\"\<p2_V2_G\>\"", "]"}]}], "]"}]}], 
       "]"}], ",", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}], ",", " ", "\"\<P2-6a\>\"", ",", 
      " ", "\"\<YP2-6a\>\""}], "]"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"the", " ", "three", " ", "potentials", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"G", "^", "S"}], ",", " ", 
       RowBox[{"G", "^", "V"}], ",", " ", "G"}], "}"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"potentialsSF", " ", "=", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<V0\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "8."}], ",", " ", "0.8", ",", " ", "0."}], "}"}]}], ",",
        " ", 
       RowBox[{"\"\<V1\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "8."}], ",", " ", "0.8", ",", " ", "22.5"}], "}"}]}], ",",
        " ", 
       RowBox[{"\"\<V2\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"gS2", ",", " ", "0.8", ",", " ", "gP2"}], "}"}]}]}], 
      "|>"}]}], ";"}]}]}]], "Input",
 CellLabel->
  "In[227]:=",ExpressionUUID->"3ba7922b-9615-454c-bb41-c09f5f486ed1"],

