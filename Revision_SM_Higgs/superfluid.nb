         " ", "\"\<chi_33\>\"", ",", " ", "\"\<chi_FF\>\"", ",", 
         " ", "\"\<M_W = g_v sqrt(chi_11)\>\"", ",", 
         " ", "\"\<M_Z = g_F sqrt(chi_FF)\>\""}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
     RowBox[{"Alignment", " ", "->", " ", "Right"}]}], "]"}]}]}]], "Input",
