Cell[CellGroupData[{

Cell["\<\
III.T.6 The size of the order parameter, Landau's theory, and the answer\
\>", "Section",ExpressionUUID->"cc5ffd6e-89c5-4887-93bc-6fa7194cdff2"],

Cell[TextData[{
 StyleBox["The radius of convergence.",
  FontWeight->"Bold"],
 " The free energy is built from integrals over the momenta of functions of \
the quasi-particle energies ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["E", "TI"], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        StyleBox["q", "TI"], "2"], "+", 
       SuperscriptBox[
        StyleBox["M", "TI"], "2"], "+", 
       SubsuperscriptBox["\[CapitalPhi]", 
        StyleBox["a",
         FontSlant->"Plain"], "2"]}], ")"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5bd49316-c4cc-45bd-b011-8e79029a4f67"],
 " and of their Fermi functions: the terms ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     StyleBox["T", "TI"]}], "\[ThinSpace]", 
    StyleBox["ln",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{"2", "\[ThinSpace]", 
      StyleBox["cosh",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       RowBox[{
        StyleBox["E", "TI"], "/", "2", 
        StyleBox["T", "TI"]}], ")"}]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3505be92-134f-4ab7-8edf-01e05b0dc87c"],
 ", one for each pair of eigenvalues ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    StyleBox["E", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "533cecfb-c14c-477c-85fd-be59f3790663"],
 " (at the Fermi occupation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["f", "TI"], "\[LongEqual]", 
    StyleBox["f", "TI"], 
    RowBox[{"(", 
     StyleBox["E", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6a6d5837-b57a-4c7d-93c2-bbdd9e9c28df"],
 " the energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["E", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["f", "TI"], "-", 
      FractionBox["1", "2"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "13d526d9-be4b-4e27-bffe-8dce4c2194f2"],
 " of the pair and its term ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], 
    RowBox[{"[", 
     RowBox[{
      StyleBox["f", "TI"], "\[ThinSpace]", 
      StyleBox["ln",
       FontSlant->"Plain"], "\[ThinSpace]", 
      StyleBox["f", "TI"], "+", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        StyleBox["f", "TI"]}], ")"}], "\[ThinSpace]", 
      StyleBox["ln",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        StyleBox["f", "TI"]}], ")"}]}], "]"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bbab5a11-3358-4cf4-a564-aa4ed895bc70"],
 " in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     StyleBox["T", "TI"]}], 
    SubscriptBox[
     StyleBox["\[ScriptCapitalS]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "09c0bfdd-046a-4c3b-8c6f-00fa3277f509"],
 " add up to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     StyleBox["T", "TI"]}], "\[ThinSpace]", 
    StyleBox["ln",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{"2", "\[ThinSpace]", 
      StyleBox["cosh",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       RowBox[{
        StyleBox["E", "TI"], "/", "2", 
        StyleBox["T", "TI"]}], ")"}]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "eb2d4535-8388-46d9-8bbe-e405345cd80d"],
 "), and the densities with the factor ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["tanh",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["E", "TI"], "/", "2", 
      StyleBox["T", "TI"]}], ")"}], "/", 
    StyleBox["E", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "68f6cb62-5612-426e-92bb-713f8a1389e6"],
 ". With the Matsubara frequencies ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Omega]", 
     StyleBox["n", "TI"]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{"2", 
      StyleBox["n", "TI"], "+", "1"}], ")"}], "\[Pi]", 
    StyleBox["T", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a2ddf9e4-9d21-461f-b802-c158744cb6ec"],
 " they become sums over ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "0", ",", "1", ",", "2", ",", 
    "\[Ellipsis]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9e05dfed-8c2f-4e87-9e15-5e5f9d014b92"],
 ","
}], "Text",ExpressionUUID->"a663248f-c2b8-4112-878a-966c9c9271c9"],

Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox["ln",
    FontSlant->"Plain"], 
   RowBox[{"(", 
    RowBox[{"2", "\[ThinSpace]", 
     StyleBox["cosh",
      FontSlant->"Plain"], 
     RowBox[{"(", 
      RowBox[{
       StyleBox["E", "TI"], "/", "2", 
       StyleBox["T", "TI"]}], ")"}]}], ")"}], "\[LongEqual]", 
   StyleBox["ln",
    FontSlant->"Plain"], "\[ThinSpace]", "2", "+", 
   UnderoverscriptBox["\[Sum]", 
    RowBox[{
     StyleBox["n", "TI"], "\[LongEqual]", "0"}], "\[Infinity]",
    LimitsPositioning->True], "\[ThinSpace]", 
   StyleBox["ln",
    FontSlant->"Plain"], 
   RowBox[{"(", 
    RowBox[{"1", "+", 
     FractionBox[
      SuperscriptBox[
       StyleBox["E", "TI"], "2"], 
      SubsuperscriptBox["\[Omega]", 
       StyleBox["n", "TI"], "2"]]}], ")"}], ",", "      ", 
   FractionBox[
    RowBox[{
     StyleBox["tanh",
      FontSlant->"Plain"], 
     RowBox[{"(", 
      RowBox[{
       StyleBox["E", "TI"], "/", "2", 
       StyleBox["T", "TI"]}], ")"}]}], 
    StyleBox["E", "TI"]], "\[LongEqual]", "4", 
   StyleBox["T", "TI"], "\[ThinSpace]", 
   UnderoverscriptBox["\[Sum]", 
    RowBox[{
     StyleBox["n", "TI"], "\[LongEqual]", "0"}], "\[Infinity]",
    LimitsPositioning->True], "\[ThinSpace]", 
   FractionBox["1", 
    RowBox[{
     SubsuperscriptBox["\[Omega]", 
      StyleBox["n", "TI"], "2"], "+", 
     SuperscriptBox[
      StyleBox["E", "TI"], "2"]}]], ","}], TraditionalForm]], "DisplayFormula",\

 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"e02c0076-83b5-4862-be13-8cd41c4edcfd"],

Cell[TextData[{
 "of functions of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Omega]", 
     StyleBox["n", "TI"], "2"], "+", 
    SuperscriptBox[
     StyleBox["q", "TI"], "2"], "+", 
    SuperscriptBox[
     StyleBox["M", "TI"], "2"], "+", 
    SubsuperscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "81069793-36fc-43a4-be9a-b740b00206ee"],
 ". Integrated over the momenta, each is singular where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Omega]", 
     StyleBox["n", "TI"], "2"], "+", 
    SuperscriptBox[
     StyleBox["M", "TI"], "2"], "+", 
    SubsuperscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"], "2"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0359cb8f-38c5-48af-ada3-739ba42b5109"],
 " (at the end ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["q", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c73a5b11-e8c2-4ffd-97fc-399f247e7bd2"],
 " of the integral); the nearest of these points to the origin, for the Dirac \
mass of the normal state held fixed, is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"], "2"], "\[LongEqual]", 
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["M", "TI"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["X", "TI"], ",", 
         StyleBox["n",
          FontSlant->"Plain"]}]], 
       SuperscriptBox[
        RowBox[{"(", 
         StyleBox["T", "TI"], ")"}], "2"], "+", 
       SuperscriptBox["\[Pi]", "2"], 
       SuperscriptBox[
        StyleBox["T", "TI"], "2"]}], ")"}]}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e25b30b4-6e1a-455b-a888-85d2c1395a98"],
 ", and at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9cbe82fc-5231-4140-b153-15bcda75c0b3"],
 " it is the point ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"], "2"], "\[LongEqual]", 
    RowBox[{"-", 
     SubsuperscriptBox[
      StyleBox["m", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], "2"]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "31dea039-dbc8-4ec4-b44b-042641b6f123"],
 " of Section III.L.5. The series of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalF]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "604d5486-7eab-4a32-a180-a8f6d68fb35e"],
 " in powers of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0e734134-5464-41bd-8ea2-27b6c224a604"],
 " about the normal state therefore converges within a radius of the order \
of"
}], "Text",ExpressionUUID->"699737b4-e2db-496a-bcd7-d000159e3b5b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], 
   RowBox[{"(", 
    StyleBox["T", "TI"], ")"}], "\[LongEqual]", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["n",
         FontSlant->"Plain"]}]], 
      SuperscriptBox[
       RowBox[{"(", 
        StyleBox["T", "TI"], ")"}], "2"], "+", 
      SuperscriptBox["\[Pi]", "2"], 
      SuperscriptBox[
       StyleBox["T", "TI"], "2"]}], ")"}], 
    RowBox[{"1", "/", "2"}]], ","}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"6a620f64-1b52-4354-afc2-2a0292f4ab97"],

Cell[TextData[{
 "not exactly equal to it (the Dirac mass changes with the applied field \
where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["S",
       FontSlant->"Plain"]}]], "\[NotEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5a840ccb-6743-4349-b3d8-b8c4915de2f6"],
 ", and the field of the states is not the applied field). Because ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0f6d843f-4e7e-405e-9452-e0710e645413"],
 " is an estimate, the answer rests also on two direct measures that do not \
use it. ",
 StyleBox["Landau's theory",
  FontWeight->"Bold"],
 " expands the free energy at the symmetric state, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalF]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["Tay",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}], 
    SuperscriptBox["\[CapitalPhi]", "2"], "+", 
    SubsuperscriptBox[
     StyleBox["b", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["Tay",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}], 
    SuperscriptBox["\[CapitalPhi]", "4"], "+", "\[Ellipsis]"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "45bdbc35-8e03-4ab1-b320-9e8d3eea6695"],
 " along the polar fields, and predicts the order parameter ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       StyleBox["a", "TI"]}], "/", "2", 
      StyleBox["b", "TI"]}], ")"}], 
    RowBox[{"1", "/", "2"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "422a8e93-57d7-40cf-b0fe-e9ca9d06bdd6"],
 ", with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["Tay",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4433eed7-00db-40dd-bc59-f76f33d75fbe"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["b", "TI"], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["b", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["Tay",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fce6216e-3c33-43da-a4a4-57d3dd541a72"],
 ". The next cell computes them for CJT at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.9", "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["CJT",
       FontSlant->"Plain"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c287d5eb-ae7d-4595-a54a-f339e6bceab9"],
 " from the thermal states of four small applied fields, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"]], "\[LongEqual]", "0.01"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9126931b-7937-4004-a3fc-18c59e727bad"],
 " to ",
 Cell[BoxData[
  FormBox["0.04", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "727c0cad-6740-4b60-9cfe-47dc0878757e"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalF]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], "/", 
    SuperscriptBox["\[CapitalPhi]", "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "da4bc82c-8687-4797-bc0d-237b13df06d6"],
 " interpolated exactly by a cubic polynomial in ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CapitalPhi]", "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "251897aa-db78-4c65-8866-65aed1dc29f3"],
 ", whose value and slope at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[CapitalPhi]", "2"], "\[LongEqual]", "0"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8d8031ab-9a94-4e5f-b45f-c7f85aa31cda"],
 " are ",
 Cell[BoxData[
  FormBox[
   StyleBox["a", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f75dc2d0-2ae9-4c59-8560-908c161db438"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["b", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cc4e6f03-02ae-4dc1-abfe-b47df590662a"],
 "). The cell after it fits the ",
 StyleBox["Landau form",
  FontWeight->"Bold"],
 " of Section III.L (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], 
    SuperscriptBox["\[CapitalPhi]", "2"], "+", 
    StyleBox["b", "TI"], 
    SuperscriptBox["\[CapitalPhi]", "4"], "+", 
    StyleBox["c", "TI"], 
    SuperscriptBox["\[CapitalPhi]", "6"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "13207325-b2ae-49b7-b8e2-f376c8660a6a"],
 ") and the quartic form (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], 
    SuperscriptBox["\[CapitalPhi]", "2"], "+", 
    StyleBox["b", "TI"], 
    SuperscriptBox["\[CapitalPhi]", "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7fda762b-f8fb-42f9-9eb2-6cec8e33e2d3"],
 ") to the free-energy curves of the Rust program at six temperatures, with \
the least squares of Section III.L.4."
}], "Text",ExpressionUUID->"fe3a3260-4134-4af7-a4ab-a68bb3c716e5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", "Taylor", " ", "coefficients", " ", "a"}], ",", " ", 
    RowBox[{
    "b", " ", "of", " ", "the", " ", "free", " ", "energy", " ", "of", " ", 
     "CJT", " ", "at", " ", "0.9", " ", "T_c", " ", "at", " ", "the", " ", 
     "origin"}], ",", " ", 
    RowBox[{"and", " ", "the", " ", "order", " ", "parameter", " ", "of", " ", 
     RowBox[{"Landau", "'"}], "s", " ", "theory"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"mo", " ", "=", " ", 
        RowBox[{"thModel", "[", "\"\<CJT\>\"", "]"}]}], ",", " ", 
       RowBox[{"temp", " ", "=", " ", 
        RowBox[{"thGet", "[", 
         RowBox[{"\"\<CJT\>\"", ",", " ", "0.9", ",", " ", "\"\<T\>\""}], 
         "]"}]}], ",", " ", 
       RowBox[{"nn", " ", "=", " ", 
        RowBox[{
         RowBox[{"thSF", "[", "0.9", "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", "n0", ",", " ", 
       RowBox[{"xs", " ", "=", " ", 
        RowBox[{"{", "}"}]}], ",", " ", 
       RowBox[{"ys", " ", "=", " ", 
        RowBox[{"{", "}"}]}], ",", " ", "c", ",", " ", "a", ",", " ", "b", ",",
        " ", "err", ",", " ", "errRust"}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"n0", " ", "=", " ", 
       RowBox[{"nn", "[", "\"\<n\>\"", "]"}]}], ";", "\n", "  ", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"res", " ", "=", " ", 
            RowBox[{"fixedPairT", "[", 
             RowBox[{"mo", ",", " ", 
              RowBox[{"fa", " ", 
               RowBox[{"ConjugateTranspose", "[", 
                RowBox[{"k8", "[", "3", "]"}], "]"}]}], ",", " ", "n0", ",", 
              " ", "temp"}], "]"}]}], "}"}], ",", "\n", "     ", 
          RowBox[{
           RowBox[{"n0", " ", "=", " ", 
            RowBox[{"res", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", "     ", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"xs", ",", " ", 
             RowBox[{
              RowBox[{"res", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "^", "2"}]}], "]"}], ";", " ", 
           
           RowBox[{"AppendTo", "[", 
            RowBox[{"ys", ",", " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"res", "[", 
                 RowBox[{"[", "3", "]"}], "]"}], " ", "-", " ", 
                RowBox[{"nn", "[", "\"\<free\>\"", "]"}]}], ")"}], "/", 
              RowBox[{
               RowBox[{"res", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "^", "2"}]}]}], "]"}]}]}], 
         "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"fa", ",", " ", 
          RowBox[{"{", 
           RowBox[{
           "0.01", ",", " ", "0.02", ",", " ", "0.03", ",", " ", "0.04"}], 
           "}"}]}], "}"}]}], "]"}], ";", "\n", "  ", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
        "the", " ", "cubic", " ", "polynomial", " ", "in", " ", "the", " ", 
         "scaled", " ", "variable", " ", 
         RowBox[{"x", "/", "xmax"}]}], ",", " ", 
        RowBox[{
         RowBox[{
         "whose", " ", "matrix", " ", "is", " ", "well", " ", "conditioned"}],
          ";", " ", 
         RowBox[{"then", " ", "back", " ", "to", " ", "a"}]}], ",", " ", 
        "b"}], " ", "*)"}], "\n", "  ", 
      RowBox[{"c", " ", "=", " ", 
       RowBox[{"LinearSolve", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"x", "/", 
              RowBox[{"Max", "[", "xs", "]"}]}], ")"}], "^", "k"}], ",", " ", 
           
           RowBox[{"{", 
            RowBox[{"x", ",", " ", "xs"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"k", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}], ",", 
         " ", "ys"}], "]"}]}], ";", "\n", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "b"}], "}"}], " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"c", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
         RowBox[{
          RowBox[{"c", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "/", 
          RowBox[{"Max", "[", "xs", "]"}]}]}], "}"}]}], ";", "\n", "  ", 
      RowBox[{"err", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{"-", "a"}], "/", 
           RowBox[{"(", 
            RowBox[{"2", " ", "b"}], ")"}]}], "]"}], "/", 
         RowBox[{"thGet", "[", 
          RowBox[{"\"\<CJT\>\"", ",", " ", "0.9", ",", " ", "\"\<Phi0\>\""}], 
          "]"}]}], " ", "-", " ", "1"}]}], ";", "\n", "  ", 
      RowBox[{"errRust", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"thGet", "[", 
          RowBox[{"\"\<CJT\>\"", ",", " ", "0.9", ",", " ", "\"\<phiL\>\""}], 
          "]"}], "/", 
         RowBox[{"thGet", "[", 
          RowBox[{"\"\<CJT\>\"", ",", " ", "0.9", ",", " ", "\"\<Phi0\>\""}], 
          "]"}]}], " ", "-", " ", "1"}]}], ";", "\n", "  ", 
      RowBox[{"check", "[", 
       RowBox[{"\"\<WP3-T5 CJT\>\"", ",", " ", 
        RowBox[{"\"\<CJT at 0.9 T_c: the Taylor coefficients a = \>\"", " ", "<>",
          " ", 
         RowBox[{"ToString", "[", 
          RowBox[{"NumberForm", "[", 
           RowBox[{"a", ",", " ", "8"}], "]"}], "]"}], " ", "<>", 
         " ", "\"\<, b = \>\"", " ", "<>", " ", 
         RowBox[{"ToString", "[", 
          RowBox[{"NumberForm", "[", 
           RowBox[{"b", ",", " ", "8"}], "]"}], "]"}], " ", "<>", 
         " ", "\"\< of the free energy at the origin and the error \>\"", " ",
          "<>", " ", 
         RowBox[{"sci", "[", "err", "]"}], " ", "<>", 
         " ", "\"\< of the order parameter (-a/2b)^(1/2) of Landau's theory (\
\>\"", " ", "<>", " ", 
         RowBox[{"ToString", "[", 
          RowBox[{"NumberForm", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", "err", "]"}], "/", "0.1"}], ",", " ", "3"}], 
           "]"}], "]"}], " ", "<>", 
         " ", "\"\< times 1 - T/T_c) = Rust (largest relative difference of a \
and b, difference of the error)\>\""}], ",", "\n", "   ", 
        RowBox[{"Max", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"a", " ", "-", " ", 
             RowBox[{"thGet", "[", 
              RowBox[{"\"\<CJT\>\"", ",", " ", "0.9", ",", " ", "\"\<a\>\""}],
               "]"}]}], "]"}], "/", 
           RowBox[{"Abs", "[", 
            RowBox[{"thGet", "[", 
             RowBox[{"\"\<CJT\>\"", ",", " ", "0.9", ",", " ", "\"\<a\>\""}], 
             "]"}], "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"b", " ", "-", " ", 
             RowBox[{"thGet", "[", 
              RowBox[{"\"\<CJT\>\"", ",", " ", "0.9", ",", " ", "\"\<b\>\""}],
               "]"}]}], "]"}], "/", 
           RowBox[{"Abs", "[", 
            RowBox[{"thGet", "[", 
             RowBox[{"\"\<CJT\>\"", ",", " ", "0.9", ",", " ", "\"\<b\>\""}], 
             "]"}], "]"}]}], ",", " ", 
          RowBox[{"Abs", "[", 
           RowBox[{"err", " ", "-", " ", "errRust"}], "]"}]}], "]"}], ",", 
        " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "5"}]}], ",", " ", "\"\<P3-T5 CJT\>\"", ",", 
        " ", "\"\<YP3-T5 CJT\>\""}], "]"}]}]}], "]"}], ";"}]}]], "Input",
 CellLabel->
  "In[348]:=",ExpressionUUID->"99eb5fad-edb3-4337-ae8d-8f097098862e"],

