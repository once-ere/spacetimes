Cell[CellGroupData[{

Cell["\<\
R.2.4 The ground state of the pairing-only methods (check WSF-5)\
\>", "Subsection",ExpressionUUID->"0b843bf1-a6a4-4ca0-837c-b46c3ef49d3c"],

Cell[TextData[{
 "In HS (0, 1) and HS (0, 0) the ground state has no normal self-energy, and \
only the pairing terms act. Its pair self-energy is ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["D", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"], 
    StyleBox["d",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "394af683-7d97-4881-88cd-e1c0031947f4"],
 " times the pair matrix of the down components with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Chi]", 
    StyleBox["SH",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "36f61bd4-b5a1-4fcc-822d-8c388f92e480"],
 ", and in the second version also ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["D", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"], 
    RowBox[{"\[Prime]", 
     StyleBox["u",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "eb775473-833e-4547-bb80-e385193ddcc1"],
 " times that of the up components with ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Chi]", 
    StyleBox["SH",
     FontSlant->"Plain"], "\[Prime]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e9c808c9-1ff2-4679-9ecf-ab1925fec582"],
 ", with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftBracketingBar]", 
     SubsuperscriptBox[
      StyleBox["D", "TI"], 
      StyleBox["SH",
       FontSlant->"Plain"], 
      RowBox[{"\[Prime]", 
       StyleBox["u",
        FontSlant->"Plain"]}]], "\[RightBracketingBar]"}], "\[LongEqual]", 
    RowBox[{"\[LeftBracketingBar]", 
     SubsuperscriptBox[
      StyleBox["D", "TI"], 
      StyleBox["SH",
       FontSlant->"Plain"], 
      StyleBox["d",
       FontSlant->"Plain"]], "\[RightBracketingBar]"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "825bb5e3-32d7-4932-8c96-60a5a8e78c74"],
 ": the two channels are decoupled and equal. Every paired quasi-particle has \
the energy ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       StyleBox["q", "TI"], "2"], "+", 
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox[
         StyleBox["M", "TI"], 
         StyleBox["SH",
          FontSlant->"Plain"], 
         StyleBox["eff",
          FontSlant->"Plain"]], ")"}], "2"]}], ")"}], 
    RowBox[{"1", "/", "2"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ae87cbda-f269-4b05-bf39-ad7f3a9b5e2a"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["eff",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["m", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], "2"], "+", 
       SuperscriptBox[
        RowBox[{"\[LeftBracketingBar]", 
         SubsuperscriptBox[
          StyleBox["D", "TI"], 
          StyleBox["SH",
           FontSlant->"Plain"], 
          StyleBox["d",
           FontSlant->"Plain"]], "\[RightBracketingBar]"}], "2"], "/", "4"}], 
      ")"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b2f5567e-5a88-44da-a335-ca8213b44e5e"],
 ", and the condition of self-consistency is the gap equation"
}], "Text",ExpressionUUID->"3d54064e-18ab-4d70-b084-2b5f0203efe7"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]], 
    RowBox[{"4", 
     SuperscriptBox["\[Pi]", "2"]}]], "\[ThinSpace]", 
   SubsuperscriptBox[
    StyleBox["I", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "1", ")"}]], 
   RowBox[{"(", 
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["eff",
      FontSlant->"Plain"]], ")"}], "\[LongEqual]", "1", "."}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"bb36f9f5-5252-49fe-aa14-3225af9b0060"],

Cell[TextData[{
 "The cell solves it with 40 digits and compares ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftBracketingBar]", 
    SubsuperscriptBox[
     StyleBox["D", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["d",
      FontSlant->"Plain"]], "\[RightBracketingBar]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c21c6cf8-38a6-4b78-aa6b-5654b927e48a"],
 " with the singular values of the bidoublet of the Rust program: both equal ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftBracketingBar]", 
    SubsuperscriptBox[
     StyleBox["D", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["d",
      FontSlant->"Plain"]], "\[RightBracketingBar]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "64786445-c41c-429a-b7bd-5eedf376573e"],
 " in the second version, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftBracketingBar]", 
    SubsuperscriptBox[
     StyleBox["D", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["d",
      FontSlant->"Plain"]], "\[RightBracketingBar]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4b43a20b-6af1-4155-9696-0810dce86442"],
 " and 0 in the first."
}], "Text",ExpressionUUID->"8a3de8e7-48a4-4c25-bd35-5691debc7fae"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"WSF", "-", "5"}], ":", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "gap", " ", "equation", " ", "of", " ", "the", " ", 
      "pairing"}], "-", 
     RowBox[{"only", " ", "ground", " ", "states"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"mEff", " ", "=", " ", 
     RowBox[{"mm", " ", "/.", " ", 
      RowBox[{"FindRoot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"gSH", " ", 
          RowBox[{
           RowBox[{"i1closed", "[", "mm", "]"}], "/", 
           RowBox[{"(", 
            RowBox[{"4", " ", 
             RowBox[{"Pi", "^", "2"}]}], ")"}]}]}], " ", "==", " ", "1"}], ",",
         " ", 
        RowBox[{"{", 
         RowBox[{"mm", ",", " ", 
          RowBox[{"9", "/", "20"}]}], "}"}], ",", " ", 
        RowBox[{"WorkingPrecision", " ", "->", " ", "40"}]}], "]"}]}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"dAbs", " ", "=", " ", 
     RowBox[{"2", " ", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"mEff", "^", "2"}], " ", "-", " ", 
        RowBox[{"mLL", "^", "2"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dev5", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"r", " ", "=", " ", 
              RowBox[{"grOf", "[", 
               RowBox[{"ver", ",", " ", "meth"}], "]"}]}], ",", " ", "s1", ",",
              " ", "s2"}], "}"}], ",", "\n", "      ", 
           RowBox[{
            RowBox[{"s1", " ", "=", " ", 
             RowBox[{"num", "[", 
              RowBox[{"r", "[", 
               RowBox[{"[", 
                RowBox[{"col", "[", 
                 RowBox[{"ghdr", ",", " ", "\"\<sing1\>\""}], "]"}], "]"}], 
               "]"}], "]"}]}], ";", " ", 
            RowBox[{"s2", " ", "=", " ", 
             RowBox[{"num", "[", 
              RowBox[{"r", "[", 
               RowBox[{"[", 
                RowBox[{"col", "[", 
                 RowBox[{"ghdr", ",", " ", "\"\<sing2\>\""}], "]"}], "]"}], 
               "]"}], "]"}]}], ";", "\n", "      ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{"s1", " ", "-", " ", "dAbs"}], "]"}], ",", " ", 
              RowBox[{"Abs", "[", 
               RowBox[{"s2", " ", "-", " ", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"ver", " ", "==", " ", "\"\<second\>\""}], ",", " ",
                   "dAbs", ",", " ", "0"}], "]"}]}], "]"}]}], "}"}]}]}], 
          "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"ver", ",", " ", 
           RowBox[{"{", 
            RowBox[{"\"\<second\>\"", ",", " ", "\"\<first\>\""}], "}"}]}], 
          "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"meth", ",", " ", 
           RowBox[{"{", 
            RowBox[{"\"\<HS (0, 1)\>\"", ",", " ", "\"\<HS (0, 0)\>\""}], 
            "}"}]}], "}"}]}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rvCheck", "[", 
     RowBox[{"\"\<WSF-5\>\"", ",", " ", 
      RowBox[{"\"\<HS (0, 1) and HS (0, 0), where only the pairing terms act: \
the gap equation G_SH I1(M_eff) / (4 pi^2) = 1 \\\ngives M_eff = \>\"", " ", "<>",
        " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"NumberForm", "[", 
         RowBox[{
          RowBox[{"N", "[", 
           RowBox[{"mEff", ",", " ", "16"}], "]"}], ",", " ", "16"}], "]"}], 
        "]"}], " ", "<>", " ", "\"\< and |D| = 2 (M_eff^2 - m^2)^(1/2) = \>\"",
        " ", "<>", "\n", "  ", 
       RowBox[{"ToString", "[", 
        RowBox[{"NumberForm", "[", 
         RowBox[{
          RowBox[{"N", "[", 
           RowBox[{"dAbs", ",", " ", "16"}], "]"}], ",", " ", "16"}], "]"}], 
        "]"}], " ", "<>", 
       " ", "\"\< (30 digits); the singular values of the bidoublet of the \
Rust program are |D| \\\nand |D| in the second version and |D| and 0 in the \
first\>\""}], ",", " ", 
      RowBox[{"dev5", " ", "<", " ", 
       RowBox[{"10", "^", 
        RowBox[{"-", "9"}]}]}], ",", " ", 
      RowBox[{"\"\<deviation \>\"", " ", "<>", " ", 
       RowBox[{"sci", "[", "dev5", "]"}]}]}], "]"}], ";"}]}]}]], "Input",
 CellLabel->
  "In[618]:=",ExpressionUUID->"bcfcebe2-03e0-4911-8b88-858b14dd9a18"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"PASS \"\>", "\[InvisibleSpace]", "\<\"WSF-5\"\>", 
   "\[InvisibleSpace]", "\<\"  \"\>", 
   "\[InvisibleSpace]", "\<\"HS (0, 1) and HS (0, 0), where only the pairing \
terms act: the gap equation G_SH I1(M_eff) / (4 pi^2) = 1 gives M_eff = \
0.4529674056079986 and |D| = 2 (M_eff^2 - m^2)^(1/2) = 0.8128455463204339 (30 \
digits); the singular values of the bidoublet of the Rust program are |D| and \
|D| in the second version and |D| and 0 in the first\"\>", 
   "\[InvisibleSpace]", "\<\" [\"\>", 
   "\[InvisibleSpace]", "\<\"deviation 4.841e-12\"\>", 
   "\[InvisibleSpace]", "\<\"]   [the same check: Rust \"\>", 
   "\[InvisibleSpace]", "\<\"SF-6a, SF-6b\"\>", 
   "\[InvisibleSpace]", "\<\", Python \"\>", 
   "\[InvisibleSpace]", "\<\"YSF-6, YSF-12\"\>", 
   "\[InvisibleSpace]", "\<\"]\"\>"}],
  SequenceForm[
  "PASS ", "WSF-5", "  ", 
   "HS (0, 1) and HS (0, 0), where only the pairing terms act: the gap \
equation G_SH I1(M_eff) / (4 pi^2) = 1 gives M_eff = 0.4529674056079986 and \
|D| = 2 (M_eff^2 - m^2)^(1/2) = 0.8128455463204339 (30 digits); the singular \
values of the bidoublet of the Rust program are |D| and |D| in the second \
version and |D| and 0 in the first", " [", "deviation 4.841e-12", 
   "]   [the same check: Rust ", "SF-6a, SF-6b", ", Python ", "YSF-6, YSF-12",
    "]"],
