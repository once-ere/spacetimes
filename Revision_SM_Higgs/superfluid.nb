Cell[CellGroupData[{

Cell["\<\
II.4 The first excited states: the linear response of the superfluid\
\>", "Section",ExpressionUUID->"5cba1cdd-fd7a-4ac7-94be-451bf05668cb"],

Cell[TextData[{
 "A small change of the self-energies with the time dependence ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     RowBox[{"-", 
      StyleBox["i", "TI"]}], "\[Omega]", 
     StyleBox["t", "TI"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c9950c8a-d025-41c4-be40-ddf02ce14392"],
 " is described by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["V",
      FontSlant->"Plain"]], "\[LongEqual]", "120"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "db2e66ec-c96a-410a-bb1a-0aa532647a9a"],
 " complex amplitudes: the 64 entries of a change ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", 
    StyleBox["N",
     FontFamily->"Helvetica",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "91de5883-b4a0-4a06-b486-f982efc7a781"],
 " of the normal self-energy and the 28 independent entries of each of two \
antisymmetric changes of the pair self-energy (",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", 
    StyleBox["P",
     FontFamily->"Helvetica",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7c6097d0-0c0e-4831-9dd9-c3ff225d3658"],
 " and the change of its adjoint). The change of the state in answer to a \
change of the self-energies is the response ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Chi]", 
    RowBox[{"(", "\[Omega]", ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a0079107-7948-4b85-87c5-24e1dd8de3d3"],
 ", a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"120", "\[Times]", "120"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a4cff926-5030-45a8-8ef0-ba4f0c88f139"],
 " matrix,"
}], "Text",ExpressionUUID->"50509d99-ce10-4ef8-9110-ae6eaffc7f75"],

Cell[BoxData[
 FormBox[
  RowBox[{"\[Chi]", 
   RowBox[{"(", "\[Omega]", ")"}], "\[LongEqual]", 
   UnderscriptBox["\[Sum]", 
    StyleBox["n", "TI"],
    LimitsPositioning->True], 
   RowBox[{"(", 
    RowBox[{
     FractionBox[
      SubscriptBox[
       StyleBox["A",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["n", "TI"]], 
      RowBox[{"\[Omega]", "-", 
       SubscriptBox["\[CapitalOmega]", 
        StyleBox["n", "TI"]]}]], "-", 
     FractionBox[
      SubscriptBox[
       StyleBox["B",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["n", "TI"]], 
      RowBox[{"\[Omega]", "+", 
       SubscriptBox["\[CapitalOmega]", 
        StyleBox["n", "TI"]]}]]}], ")"}], ","}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"e38639df-567e-4b4f-98e0-1538f35e9cc1"],

Cell[TextData[{
 "a sum over the momenta ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "51a50d85-ad5f-431e-bf43-341e5b055c68"],
 " of the grid, where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalOmega]", 
     StyleBox["n", "TI"]], "\[LongEqual]", "2", 
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["n", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "aca5037f-1adb-4946-9707-e2ef48753aae"],
 " is the energy of a pair of quasi-particles at the momentum ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "780a912f-05a3-4320-adba-4048c7e96b4f"],
 " (for these states every eigenvalue of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["H",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4e875826-12c8-4000-9796-70c284c22b14"],
 " at a momentum is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["n", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bddcba46-7d28-4007-ade9-1321b3bbd90f"],
 ", which the cell checks) and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["A",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "44ed25b9-758e-4f7e-b445-13a46454855e"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["B",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "76915ec4-54af-47db-bd2d-fa252fb9b93e"],
 " are built from the eigenvectors (the creation of two quasi-particles and \
its reverse). The self-energies change by ",
 Cell[BoxData[
  FormBox[
   StyleBox["F",
    FontFamily->"Helvetica",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6d4687fe-5248-41c8-a73a-694e4f716b11"],
 " times the change of the state, where ",
 Cell[BoxData[
  FormBox[
   StyleBox["F",
    FontFamily->"Helvetica",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b0453b89-8f27-4064-a4e7-93c7aeb05903"],
 " is the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"120", "\[Times]", "120"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0c8e7470-f23c-4cfe-945a-b3cb729059ba"],
 " matrix of the self-energy maps of the contact terms (",
 StyleBox["respKernel",
  FontFamily->"Source Code Pro"],
 "). A collective mode of frequency ",
 Cell[BoxData[
  FormBox["\[Omega]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c1f2f9cf-9f85-4299-ab65-615d2b3fbbe9"],
 " is a solution of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", "\[LongEqual]", "\[Chi]", 
    RowBox[{"(", "\[Omega]", ")"}], 
    StyleBox["F",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "\[Delta]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bf0c2ab1-dffe-4bec-a338-d60a24722399"],
 ": the matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["M",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{"(", "\[Omega]", ")"}], "\[LongEqual]", "\[Chi]", 
    RowBox[{"(", "\[Omega]", ")"}], 
    StyleBox["F",
     FontFamily->"Helvetica",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cfbe2545-f1b2-4237-bacd-53e5b83db219"],
 " has the eigenvalue 1. At ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Omega]", "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1416661a-12ca-44fd-969f-def0cd87182c"],
 " the three broken generators give three Goldstone modes: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["M",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{"(", "0", ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7710f91b-bdf1-4e9b-a7de-8df856bd2629"],
 " has the eigenvalue 1 three times. Below the threshold ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["min",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{"2", 
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["gap",
         FontSlant->"Plain"]}]], ",", 
      UnderscriptBox[
       StyleBox["min",
        FontSlant->"Plain"], 
       StyleBox["n", "TI"],
       LimitsPositioning->True], "\[ThinSpace]", 
      SubscriptBox["\[CapitalOmega]", 
       StyleBox["n", "TI"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b960e0f3-1762-4168-a2f6-e729cf9ca648"],
 " the modes are found where the number of real eigenvalues of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["M",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{"(", "\[Omega]", ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5cb65f85-01d5-47ba-8bad-cf730fe7e4d9"],
 " above 1 changes: a scan of 300 frequencies, then 45 bisections for each \
change. The cell does this for HS ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"1", ",", "1"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "63e3140d-4215-4dd2-ad90-b96e2c4123ae"],
 ", KS and CJT with ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "2", ")"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a0a3c2b1-f33b-4b98-94d4-4f01a8aed2b2"],
 ", and compares the modes with the Rust program."
}], "Text",ExpressionUUID->"9616d03a-e5db-45fa-b3ff-6e9abac90011"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", "28", " ", "pairs", " ", 
     RowBox[{"(", 
      RowBox[{"i", ",", " ", "j"}], ")"}]}], ",", " ", 
    RowBox[{"i", " ", "<", " ", "j"}], ",", " ", 
    RowBox[{"of", " ", "the", " ", "antisymmetric", " ", "matrices"}], ",", 
    " ", 
    RowBox[{
    "in", " ", "the", " ", "order", " ", "of", " ", "the", " ", "rows"}]}], 
   " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"pairsSF", " ", "=", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
