Cell[CellGroupData[{

Cell["R.1.3 The Lorentz generators (check WQN-2)", "Subsection",ExpressionUUID->"526e1b9f-de3f-447b-a7f5-e49ec55cecca"],

Cell[TextData[{
 "The six real generators of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SL", "TI"], 
    RowBox[{"(", 
     RowBox[{"2", ",", 
      StyleBox["\[DoubleStruckCapitalC]",
       FontSlant->"Plain"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "801be911-889d-4b24-b40a-a9f1e467688f"],
 " are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["u", "TI"], "\[LongEqual]", 
    RowBox[{"-", 
     StyleBox["i", "TI"]}], 
    SuperscriptBox["\[Sigma]", 
     StyleBox["j", "TI"]], "/", "2"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "806a48f1-ce1f-4492-86ff-084ecef44406"],
 " (rotations) and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["u", "TI"], "\[LongEqual]", 
    SuperscriptBox["\[Sigma]", 
     StyleBox["j", "TI"]], "/", "2"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5c76ffcd-e85a-46bc-9754-986444470d3d"],
 " (boosts); on a Dirac field they act as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["S", "TI"], 
    RowBox[{"(", 
     StyleBox["u", "TI"], ")"}], "\[LongEqual]", 
    StyleBox["diag",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox[
        StyleBox["u", "TI"], "\[Dagger]"]}], ",", 
      StyleBox["u", "TI"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "564e1af3-59ac-4d5a-9d62-0156456a9629"],
 ". The map ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["u", "TI"], "\[RightTeeArrow]", 
    StyleBox["S", "TI"], 
    RowBox[{"(", 
     StyleBox["u", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "92c0b6e3-c375-4202-8533-49f5236e01b4"],
 " must respect the commutators, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["S", "TI"], 
    RowBox[{"(", 
     RowBox[{"[", 
      RowBox[{
       StyleBox["u", "TI"], ",", 
       SuperscriptBox[
        StyleBox["u", "TI"], "\[Prime]"]}], "]"}], ")"}], "\[LongEqual]", 
    RowBox[{"[", 
     RowBox[{
      StyleBox["S", "TI"], 
      RowBox[{"(", 
       StyleBox["u", "TI"], ")"}], ",", 
      StyleBox["S", "TI"], 
      RowBox[{"(", 
       SuperscriptBox[
        StyleBox["u", "TI"], "\[Prime]"], ")"}]}], "]"}]}], TraditionalForm]],
   "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6d73b734-a22a-49f8-ab32-e3419c60a472"],
 "; the six images must be independent over the real numbers; and every image \
must commute with the ten internal generators, so that the space-time and the \
internal symmetries are independent and the charges of a field do not depend \
on the frame."
}], "Text",ExpressionUUID->"f25859ed-2ea2-4f06-b3ea-fe91c6b34ae2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", 
          RowBox[{"--", 
           RowBox[{"--", 
            RowBox[{"--", 
             RowBox[{"--", 
              RowBox[{"--", 
               RowBox[{"--", 
                RowBox[{"--", 
                 RowBox[{"--", 
                  RowBox[{"--", 
                   RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{
                    "--", " ", 
                    "the"}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}\
]}]}]}]}]}]}], " ", "Lorentz", " ", "generators"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"lb", " ", "=", " ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "I"}], " ", 
          RowBox[{
           RowBox[{"sig", "[", "j", "]"}], "/", "2"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"sig", "[", "j", "]"}], "/", "2"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}], "]"}]}], ";"}], 
   "   ", 
   RowBox[{"(*", " ", 
    RowBox[{"rotations", ",", " ", "boosts"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"sGen", "[", "mu_", "]"}], " ", ":=", " ", 
     RowBox[{"blk", "[", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"ConjugateTranspose", "[", "mu", "]"}]}], ",", " ", "mu"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"l16", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"dirac16", "[", 
        RowBox[{"sGen", "[", "#", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
      "lb"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ok2", " ", "=", " ", 
     RowBox[{
      RowBox[{"And", " ", "@@", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"dirac16", "[", 
            RowBox[{"sGen", "[", 
             RowBox[{"comm", "[", 
              RowBox[{
               RowBox[{"lb", "[", 
                RowBox[{"[", "k", "]"}], "]"}], ",", " ", 
               RowBox[{"lb", "[", 
                RowBox[{"[", "l", "]"}], "]"}]}], "]"}], "]"}], "]"}], " ", "==",
            " ", 
           RowBox[{"comm", "[", 
            RowBox[{
             RowBox[{"l16", "[", 
              RowBox[{"[", "k", "]"}], "]"}], ",", " ", 
             RowBox[{"l16", "[", 
              RowBox[{"[", "l", "]"}], "]"}]}], "]"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"k", ",", " ", "6"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"l", ",", " ", "6"}], "}"}]}], "]"}], "]"}]}], " ", "&&", 
      "\n", "  ", 
      RowBox[{"And", " ", "@@", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"comm", "[", 
            RowBox[{"s", ",", " ", "x"}], "]"}], " ", "==", " ", "z16"}], ",",
           " ", 
          RowBox[{"{", 
           RowBox[{"s", ",", " ", "l16"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "gensAll"}], "}"}]}], "]"}], "]"}]}], " ", "&&",
       "\n", "  ", 
      RowBox[{
       RowBox[{"MatrixRank", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"Re", "[", 
             RowBox[{"Flatten", "[", "#", "]"}], "]"}], ",", " ", 
            RowBox[{"Im", "[", 
             RowBox[{"Flatten", "[", "#", "]"}], "]"}]}], "]"}], " ", "&"}], 
         " ", "/@", " ", "l16"}], "]"}], " ", "==", " ", "6"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rvCheck", "[", 
     RowBox[{"\"\<WQN-2\>\"", ",", 
      " ", "\"\<the six real Lorentz generators: S([u, u']) = [S(u), S(u')], \
independent over the reals, commuting with \\\nthe ten internal \
generators\>\"", ",", " ", "ok2", ",", 
      " ", "\"\<identities of exact matrices; real rank 6\>\""}], "]"}], 
    ";"}]}]}]], "Input",
 CellLabel->
  "In[443]:=",ExpressionUUID->"5b4dea9a-794c-456a-9cf4-7f4502f1712e"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"PASS \"\>", "\[InvisibleSpace]", "\<\"WQN-2\"\>", 
   "\[InvisibleSpace]", "\<\"  \"\>", 
   "\[InvisibleSpace]", "\<\"the six real Lorentz generators: S([u, u']) = \
[S(u), S(u')], independent over the reals, commuting with the ten internal \
generators\"\>", "\[InvisibleSpace]", "\<\" [\"\>", 
   "\[InvisibleSpace]", "\<\"identities of exact matrices; real rank 6\"\>", 
   "\[InvisibleSpace]", "\<\"]   [the same check: Rust \"\>", 
