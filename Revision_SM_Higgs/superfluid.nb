Cell[TextData[{
 "The next cell prints the numbers in the form of a table (in per cent where \
marked): what the polynomial gets wrong at its own minimum (the position, the \
depth, the curvature and the resulting mass of the amplitude mode), the \
largest residuals of the fits with more or fewer powers, the sign changes, \
and the coefficient ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d41dcdde-ff9b-4ca7-a440-2496aca7775f"],
 " fitted on the three intervals. The figure after it shows the residuals \
(top) and the decrease of the largest residual with the number of powers \
(bottom)."
}], "Text",ExpressionUUID->"03b428fd-9435-4bca-9c61-f04e2848156f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "the", " ", "table", " ", "of", " ", "the", " ", "accuracy", " ", "of", " ",
      "the", " ", "Landau", " ", "form"}], ";", " ", 
    RowBox[{
     RowBox[{"pct", "[", "x", "]"}], ":", " ", 
     RowBox[{
     "x", " ", "in", " ", "per", " ", "cent", " ", "with", " ", "three", " ", 
      "significant", " ", "digits"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"pct", "[", "x_", "]"}], " ", ":=", " ", 
     RowBox[{"NumberForm", "[", 
      RowBox[{
       RowBox[{"100.", " ", "x"}], ",", " ", "3"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"lfRows", " ", "=", " ", 
     RowBox[{"{", "\n", "   ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<minimum of the polynomial: Phi_L/Phi0 - 1 (per cent)\>\"",
          ",", " ", 
         RowBox[{
          RowBox[{"pct", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"lfResults", "[", "#", "]"}], "[", "\"\<phifit\>\"", 
              "]"}], "/", 
             RowBox[{"lfPhi0", "[", "#", "]"}]}], " ", "-", " ", "1"}], "]"}],
           " ", "&"}]}], "}"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<depth of the polynomial / depth - 1 (per cent)\>\"", ",",
          " ", 
         RowBox[{
          RowBox[{"pct", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"lfResults", "[", "#", "]"}], "[", "\"\<depthfit\>\"", 
              "]"}], "/", 
             RowBox[{"lfE0", "[", "#", "]"}]}], " ", "-", " ", "1"}], "]"}], 
          " ", "&"}]}], "}"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<curvature at its minimum / V''amp - 1 (per cent)\>\"", ",",
          " ", 
         RowBox[{
          RowBox[{"pct", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"lfResults", "[", "#", "]"}], "[", "\"\<curvfit\>\"", 
              "]"}], "/", 
             RowBox[{"rustPart3", "[", 
              RowBox[{"\"\<p3_V2amp_\>\"", " ", "<>", " ", "#"}], "]"}]}], 
            " ", "-", " ", "1"}], "]"}], " ", "&"}]}], "}"}], ",", "\n", 
       "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<resulting M^H / M^H - 1 (per cent)\>\"", ",", " ", 
         RowBox[{
          RowBox[{"pct", "[", 
           RowBox[{
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"lfResults", "[", "#", "]"}], "[", "\"\<curvfit\>\"", 
               "]"}], "/", 
              RowBox[{"rustPart3", "[", 
               RowBox[{"\"\<p3_V2amp_\>\"", " ", "<>", " ", "#"}], "]"}]}], 
             "]"}], " ", "-", " ", "1"}], "]"}], " ", "&"}]}], "}"}], ",", 
       "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<largest residual / depth, powers to Phi^4 (per cent)\>\"",
          ",", " ", 
         RowBox[{
          RowBox[{"pct", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"lfResults", "[", "#", "]"}], "[", "\"\<resK2\>\"", 
             "]"}], "/", 
            RowBox[{"Abs", "[", 
             RowBox[{"lfE0", "[", "#", "]"}], "]"}]}], "]"}], " ", "&"}]}], 
        "}"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<the same, powers to Phi^6: the Landau form (per \
cent)\>\"", ",", " ", 
         RowBox[{
          RowBox[{"pct", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"lfResults", "[", "#", "]"}], "[", "\"\<resK3\>\"", 
             "]"}], "/", 
            RowBox[{"Abs", "[", 
             RowBox[{"lfE0", "[", "#", "]"}], "]"}]}], "]"}], " ", "&"}]}], 
        "}"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<the same, powers to Phi^8 (per cent)\>\"", ",", " ", 
         RowBox[{
          RowBox[{"pct", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"lfResults", "[", "#", "]"}], "[", "\"\<resK4\>\"", 
             "]"}], "/", 
            RowBox[{"Abs", "[", 
             RowBox[{"lfE0", "[", "#", "]"}], "]"}]}], "]"}], " ", "&"}]}], 
        "}"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<the same, powers to Phi^10 (per cent)\>\"", ",", " ", 
         RowBox[{
          RowBox[{"pct", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"lfResults", "[", "#", "]"}], "[", "\"\<resK5\>\"", 
             "]"}], "/", 
            RowBox[{"Abs", "[", 
             RowBox[{"lfE0", "[", "#", "]"}], "]"}]}], "]"}], " ", "&"}]}], 
        "}"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<the same, powers to Phi^12 (per cent)\>\"", ",", " ", 
         RowBox[{
          RowBox[{"pct", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"lfResults", "[", "#", "]"}], "[", "\"\<resK6\>\"", 
             "]"}], "/", 
            RowBox[{"Abs", "[", 
             RowBox[{"lfE0", "[", "#", "]"}], "]"}]}], "]"}], " ", "&"}]}], 
        "}"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<sign changes of the residual of the Landau form\>\"", ",",
          " ", 
         RowBox[{
          RowBox[{
           RowBox[{"lfResults", "[", "#", "]"}], "[", "\"\<signs\>\"", "]"}], 
          " ", "&"}]}], "}"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<10^3 c fitted on [0, Phi0]\>\"", ",", " ", 
         RowBox[{
          RowBox[{"NumberForm", "[", 
           RowBox[{
            RowBox[{"1000", " ", 
             RowBox[{
              RowBox[{"lfResults", "[", "#", "]"}], "[", "\"\<rng1_c\>\"", 
              "]"}]}], ",", " ", "4"}], "]"}], " ", "&"}]}], "}"}], ",", "\n",
        "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<10^3 c fitted on [0, 1.4 Phi0]\>\"", ",", " ", 
         RowBox[{
          RowBox[{"NumberForm", "[", 
           RowBox[{
            RowBox[{"1000", " ", 
             RowBox[{
              RowBox[{"lfResults", "[", "#", "]"}], "[", "\"\<rng2_c\>\"", 
              "]"}]}], ",", " ", "4"}], "]"}], " ", "&"}]}], "}"}], ",", "\n",
        "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<10^3 c fitted on the whole curve\>\"", ",", " ", 
         RowBox[{
          RowBox[{"NumberForm", "[", 
           RowBox[{
            RowBox[{"1000", " ", 
             RowBox[{
              RowBox[{"lfResults", "[", "#", "]"}], "[", "\"\<rng3_c\>\"", 
              "]"}]}], ",", " ", "4"}], "]"}], " ", "&"}]}], "}"}], ",", "\n",
        "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<10^3 c of the fit with powers to Phi^8\>\"", ",", " ", 
         RowBox[{
          RowBox[{"NumberForm", "[", 
           RowBox[{
            RowBox[{"1000", " ", 
             RowBox[{
              RowBox[{"lfResults", "[", "#", "]"}], "[", "\"\<cK4\>\"", 
              "]"}]}], ",", " ", "4"}], "]"}], " ", "&"}]}], "}"}]}], "}"}]}],
     ";"}], "\n", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{"row", ",", " ", 
           RowBox[{"Prepend", "[", 
            RowBox[{
             RowBox[{"Map", "[", 
              RowBox[{
               RowBox[{"row", "[", 
                RowBox[{"[", "2", "]"}], "]"}], ",", " ", "lfTags"}], "]"}], ",",
              " ", 
             RowBox[{"row", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], "]"}], ",", " ", 
         "lfRows"}], "]"}], ",", " ", 
       RowBox[{"Prepend", "[", 
        RowBox[{
         RowBox[{"lfName", " ", "/@", " ", "lfTags"}], ",", 
         " ", "\"\<quantity\>\""}], "]"}]}], "]"}], ",", "\n", "  ", 
     RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
     RowBox[{"Alignment", " ", "->", " ", "Left"}], ",", " ", 
     RowBox[{"BaseStyle", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"FontSize", " ", "->", " ", "9"}], "}"}]}]}], 
    "]"}]}]}]], "Input",
