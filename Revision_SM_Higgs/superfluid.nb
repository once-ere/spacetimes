Cell[CellGroupData[{

Cell["III.L.5 Why no polynomial can be exact: the cause", "Section",ExpressionUUID->"0be4c9a7-0d97-402e-88ef-b867ed34d74f"],

Cell[TextData[{
 StyleBox["The pair field enters the quasi-particle energies like a mass.",
  FontWeight->"Bold"],
 " For the applied pair self-energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d0bd9e3c-e8a3-49a3-a290-20db91ec6248"],
 " and a normal self-energy that is a Dirac mass, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["D",
         FontSlant->"Plain"]}]], "-", 
      SubscriptBox[
       StyleBox["m", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}], 
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[CircleTimes]", 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "566225bf-be1d-47c5-9961-39882d359f24"],
 ", the eigenvalues of the matrix of Bogoliubov and de Gennes at the momentum \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox[
     StyleBox["q", "TI"], "\[RightVector]"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ea577cc3-79aa-4339-8562-a4d48be33427"],
 " are ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    StyleBox["E", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "07c1f98b-dc75-4759-81ae-c5433c4fdca4"],
 ", each eight times, with"
}], "Text",ExpressionUUID->"f4f45379-78cd-4ab1-a316-0d0d14b02af3"],

Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox["E", "TI"], "\[LongEqual]", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"\[LeftBracketingBar]", 
        SubscriptBox[
         OverscriptBox[
          StyleBox["q", "TI"], "\[RightVector]"], 
         StyleBox["LL",
          FontSlant->"Plain"]], "\[RightBracketingBar]"}], "2"], "+", 
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox[
         StyleBox["M", "TI"], 
         StyleBox["SF",
          FontSlant->"Plain"], 
         RowBox[{
          StyleBox["X", "TI"], ",", 
          StyleBox["D",
           FontSlant->"Plain"]}]], ")"}], "2"], "+", 
      SubsuperscriptBox["\[CapitalPhi]", 
       StyleBox["a",
        FontSlant->"Plain"], "2"]}], ")"}], 
    RowBox[{"1", "/", "2"}]], "."}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"fd71adfa-8303-45f1-95f8-f2bb906266de"],

Cell[TextData[{
 "The next cell checks this for 20 random momenta, masses and fields with the \
matrices of Part I (",
 StyleBox["hLL",
  FontFamily->"Source Code Pro"],
 ", ",
 StyleBox["kLL",
  FontFamily->"Source Code Pro"],
 ", ",
 StyleBox["betaLL",
  FontFamily->"Source Code Pro"],
 "); along the whole polar curve the normal self-energy is such a Dirac mass \
(the Rust check P3-9 and the Python check YP3-9)."
}], "Text",ExpressionUUID->"9c435928-ed5b-4d02-90e0-bb1feb7b30d8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
     "the", " ", "BdG", " ", "matrix", " ", "of", " ", "the", " ", "eight", " ",
       "components", " ", "with", " ", "the", " ", "Dirac", " ", "mass", " ", 
      "M", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"normal", " ", "self"}], "-", 
        RowBox[{"energy", " ", 
         RowBox[{"(", 
          RowBox[{"M", " ", "-", " ", "m"}], ")"}], " ", "beta", " ", 
         RowBox[{"(", "x", ")"}], " ", "1", "_", "2"}]}], ")"}], " ", "and", " ",
       "the", " ", "applied", "\n", "   ", "pair", " ", "self"}], "-", 
     RowBox[{"energy", " ", "fa", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"K", "^", "3"}], ")"}], "^", "dag"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"at", " ", "the", " ", "momentum", " ", "q"}], ";", " ", 
     RowBox[{
      RowBox[{"its", " ", "sorted", " ", "eigenvalues", " ", "against"}], " ",
       "-", 
      RowBox[{"E", " ", 
       RowBox[{"(", 
        RowBox[{"eight", " ", "times"}], ")"}], " ", "and"}], " ", "+", 
      RowBox[{"E", " ", 
       RowBox[{"(", 
        RowBox[{"eight", " ", "times"}], ")"}]}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"lfBdG", "[", 
      RowBox[{"q_", ",", " ", "mass_", ",", " ", "fa_"}], "]"}], " ", ":=", 
     " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"n", " ", "=", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"mass", " ", "-", " ", "mLL"}], ")"}], " ", 
           RowBox[{"d8", "[", "betaLL", "]"}]}]}], ",", " ", 
         RowBox[{"p", " ", "=", " ", 
          RowBox[{"fa", " ", 
           RowBox[{"ConjugateTranspose", "[", 
            RowBox[{"kLL", "[", "3", "]"}], "]"}]}]}], ",", " ", "a", ",", 
         " ", "d"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"a", " ", "=", " ", 
         RowBox[{
          RowBox[{"hLL", "[", 
           RowBox[{"q", ",", " ", "mLL"}], "]"}], " ", "+", " ", "n"}]}], ";",
         " ", 
        RowBox[{"d", " ", "=", " ", 
         RowBox[{
          RowBox[{"hLL", "[", 
           RowBox[{
            RowBox[{"-", "q"}], ",", " ", "mLL"}], "]"}], " ", "+", " ", 
          "n"}]}], ";", "\n", "   ", 
        RowBox[{"N", "[", 
         RowBox[{"ArrayFlatten", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"a", ",", " ", "p"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"ConjugateTranspose", "[", "p", "]"}], ",", " ", 
              RowBox[{"-", 
               RowBox[{"Transpose", "[", "d", "]"}]}]}], "}"}]}], "}"}], 
          "]"}], "]"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"SeedRandom", "[", "20261121", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"lfQpDev", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"q", " ", "=", " ", 
             RowBox[{"RandomReal", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", "3"}], 
              "]"}]}], ",", " ", 
            RowBox[{"mass", " ", "=", " ", 
             RowBox[{"RandomReal", "[", 
              RowBox[{"{", 
               RowBox[{"0.1", ",", " ", "0.5"}], "}"}], "]"}]}], ",", " ", 
            RowBox[{"fa", " ", "=", " ", 
             RowBox[{"RandomReal", "[", 
              RowBox[{"{", 
               RowBox[{"0", ",", " ", "0.6"}], "}"}], "]"}]}], ",", " ", "ev",
             ",", " ", "e"}], "}"}], ",", "\n", "     ", 
          RowBox[{
           RowBox[{"ev", " ", "=", " ", 
            RowBox[{"Sort", "[", 
             RowBox[{"Re", "[", 
              RowBox[{"Eigenvalues", "[", 
               RowBox[{"lfBdG", "[", 
                RowBox[{"q", ",", " ", "mass", ",", " ", "fa"}], "]"}], "]"}],
               "]"}], "]"}]}], ";", "\n", "     ", 
           RowBox[{"e", " ", "=", " ", 
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{"q", " ", ".", " ", "q"}], " ", "+", " ", 
              RowBox[{"mass", "^", "2"}], " ", "+", " ", 
              RowBox[{"fa", "^", "2"}]}], "]"}]}], ";", "\n", "     ", 
           RowBox[{"Max", "[", 
            RowBox[{"Abs", "[", 
             RowBox[{"ev", " ", "-", " ", 
              RowBox[{"Join", "[", 
               RowBox[{
                RowBox[{"ConstantArray", "[", 
                 RowBox[{
                  RowBox[{"-", "e"}], ",", " ", "8"}], "]"}], ",", " ", 
                RowBox[{"ConstantArray", "[", 
                 RowBox[{"e", ",", " ", "8"}], "]"}]}], "]"}]}], "]"}], 
            "]"}]}]}], "]"}], ",", " ", 
        RowBox[{"{", "20", "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WP3-8\>\"", ",", 
      " ", "\"\<the pair field enters the quasi-particle energies like a \
mass: the BdG matrix with N = (M - m) beta (x) 1_2 and P = Phi_a (K^3)^dag \
has the eigenvalues -+(q^2 + M^2 + Phi_a^2)^(1/2), eight times each (20 \
random q, M, Phi_a)\>\"", ",", " ", "lfQpDev", ",", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "13"}]}], ",", " ", "\"\<P3-8\>\"", ",", 
      " ", "\"\<YP3-8\>\""}], "]"}], ";"}]}]}]], "Input",
 CellLabel->
  "In[301]:=",ExpressionUUID->"cf8c5909-153e-4422-86a1-b4de14d771e9"],

