Cell[CellGroupData[{

Cell["\<\
R.1 The quantum numbers of the fields, of their pairs and of the bidoublet \
(stage 2)\
\>", "Section",ExpressionUUID->"2b26ef59-d0a1-4b96-bdae-04f19df52dbc"],

Cell["\<\
This section builds the generators of all symmetries on the sixteen \
components as exact matrices and derives from them every quantum number that \
the revision uses: the algebra of the groups, the charges, the absence of \
anomalies, the Lorentz-invariant bilinears and their parity, the quantum \
numbers of the pair fields and of the bidoublet, the invariance of the \
pairing terms, the table of all pair channels, the pattern of the breaking \
and the masses of the gauge bosons. All arithmetic is exact (rational \
numbers, square roots and symbols), so the checks of this section need no \
tolerance.\
\>", "Text",ExpressionUUID->"4a4b9479-cb68-4f4d-b502-580db6c26ec2"],

Cell[CellGroupData[{

Cell["R.1.1 The matrices and the generators", "Subsection",ExpressionUUID->"30cd8cc1-b998-4aec-8e55-e5f52ada2843"],

Cell[TextData[{
 "The Pauli matrices ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Sigma]", 
    StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "577fd81f-03c3-4821-b7bb-2a9c64804133"],
 " and the Dirac matrices of the chiral basis, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p", "TI"]], "\[LongEqual]", 
    RowBox[{"(", "\[NoBreak]", GridBox[{
       {"0", 
        SuperscriptBox["\[Sigma]", 
         StyleBox["p", "TI"]]},
       {
        SuperscriptBox[
         OverscriptBox["\[Sigma]", "_"], 
         StyleBox["p", "TI"]], "0"}
      },
      GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
      GridBoxSpacings->{"Columns" -> {
          Offset[0.27999999999999997`], {
           Offset[0.7]}, 
          Offset[0.27999999999999997`]}, "Rows" -> {
          Offset[0.2], {
           Offset[0.4]}, 
          Offset[0.2]}}], "\[NoBreak]", ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1ace40ba-b90b-4006-8d2e-402bdb2e1196"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Sigma]", "0"], "\[LongEqual]", 
    SuperscriptBox[
     OverscriptBox["\[Sigma]", "_"], "0"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2d7a3991-27cf-4df9-b00a-295e203aff99"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     OverscriptBox["\[Sigma]", "_"], 
     StyleBox["j", "TI"]], "\[LongEqual]", 
    RowBox[{"-", 
     SuperscriptBox["\[Sigma]", 
      StyleBox["j", "TI"]]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "87a87523-2376-474d-890d-58e321190400"],
 ", give the chirality ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["ch",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a72e7094-f200-4ebf-9fc5-a134e311813a"],
 " and the charge-conjugation matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    StyleBox["i", "TI"], 
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], "2"], 
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], "0"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3fed55c2-5932-4934-b652-8c41b85304e2"],
 ". A matrix ",
 Cell[BoxData[
  FormBox[
   StyleBox["a", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b15fd6e4-e5e3-40dc-b815-98449c147a75"],
 " that acts on the Dirac index acts on the whole field as ",
 StyleBox["dirac16[a]",
  FontFamily->"Source Code Pro"],
 ": ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], "\[CircleTimes]", 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a875e812-35b3-42da-82c0-d978a3579fbc"],
 " on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8af98715-1ad7-4fff-a96d-1264ba9180d7"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["a", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b9a9100a-c846-411f-8487-cd9254c7ec16"],
 " on each singlet. The internal generators are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["T", "TI"], 
     RowBox[{
      StyleBox["a", "TI"], ",", 
      StyleBox["SM",
       FontSlant->"Plain"]}]], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "4"], "\[CircleTimes]", 
    SuperscriptBox["\[Tau]", 
     StyleBox["a", "TI"]], "/", "2"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bc5aa354-47b2-42c1-92b0-33ea6d91eb85"],
 " on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "74a863d8-6518-4ef3-889f-f95e88d698f6"],
 " (zero on the singlets), ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["a", "TI"], ",", 
      StyleBox["R",
       FontSlant->"Plain"]}]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["\[Tau]", 
       StyleBox["a", "TI"]], "/", "2"}], ")"}], "\[CircleTimes]", 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9b2c65a1-3701-4e99-8c96-c1691f753ec4"],
 " on the pair ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["\[Chi]", 
      StyleBox["SH",
       FontSlant->"Plain"]], ",", 
     SubsuperscriptBox["\[Chi]", 
      StyleBox["SH",
       FontSlant->"Plain"], "\[Prime]"]}], ")"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "85c2cfeb-2ba1-41a7-8274-4cd835b37ac2"],
 " (zero on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "beeb4527-41f5-479f-9b3f-21cc432a905f"],
 "), ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["F", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["tot",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "16"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "214343d1-2ebf-47da-8b77-d14208a936d1"],
 ", the hypercharge ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["Y", "TI"], 
    StyleBox["SM",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c1835853-887c-4bc4-aaf9-333c2f2b57de"],
 " of the table of the hypotheses (",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "4"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2249b7dc-a39e-44f8-a4b7-e311748c29c5"],
 " on the first twelve components, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    FractionBox["3", "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a7236e51-ab73-4cd9-9690-854a3e4cb5cd"],
 " on ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Chi]", 
    StyleBox["SH",
     FontSlant->"Plain"], "\[Prime]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bec3a369-7200-40dc-8222-119e97c8cdb6"],
 "), ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]], "\[LongEqual]", 
    StyleBox["diag",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["1",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], "8"], ",", 
      RowBox[{"-", 
       SubscriptBox[
        StyleBox["1",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], "8"]}]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f4783661-d0ac-4ad4-8427-379b9d88c1f5"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["Q", "TI"], 
     StyleBox["SM",
      FontSlant->"Plain"]], "\[LongEqual]", 
