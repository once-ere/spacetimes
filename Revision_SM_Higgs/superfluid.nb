        RowBox[{
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", 
            RowBox[{"col", "[", 
             RowBox[{"h", ",", " ", "\"\<sector\>\""}], "]"}], "]"}], "]"}], 
          " ", "==", " ", "sec"}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"parityOf", "[", 
           RowBox[{"#", "[", 
            RowBox[{"[", 
             RowBox[{"col", "[", 
              RowBox[{"h", ",", " ", "\"\<parity\>\""}], "]"}], "]"}], "]"}], 
           "]"}], " ", "==", " ", "par"}]}], " ", "&"}], ",", "\n", "   ", 
       RowBox[{"Missing", "[", "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"str", "[", "x_", "]"}], " ", ":=", " ", 
