Cell[CellGroupData[{

Cell["II.5 The gauge bosons in the superfluid", "Section",ExpressionUUID->"ecedfa9f-414b-4815-b850-8cb61176b0f6"],

Cell[TextData[{
 StyleBox["The masses from the susceptibilities.",
  FontWeight->"Bold"],
 " A constant gauge field ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["A", "TI"], "0", 
    StyleBox["a", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "89ea09b9-a16f-47ed-ba98-a69652cafc1d"],
 " along the generator ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["Q",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["a", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a229b1e8-78b1-4ff4-8d42-b7be77fb2b14"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], "\[LongEqual]", "1", ",", "2", ",", "3"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3a28e68b-6c9e-49c1-bfc4-ed6bbfab0415"],
 ": ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "69674f42-2b6f-4433-8e07-ed4032dc9a34"],
 "; ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], "\[LongEqual]", "4"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "19a18474-d0c1-4fba-832f-530ae2f5be02"],
 ": the fermion number ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["1",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "8"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "917a0e91-5bb1-42bf-b7e6-90c463c1fbf3"],
 ") enters like a chemical potential ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Mu]", 
    StyleBox["a", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1c3bb491-a54f-48d3-b4ac-917937f4c565"],
 " of that charge. The static susceptibility ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Chi]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["ab", "TI"]], "\[LongEqual]", "\[PartialD]", 
    RowBox[{"\[LeftAngleBracket]", 
     SubscriptBox[
      StyleBox["Q",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["a", "TI"]], "\[RightAngleBracket]"}], "/", "\[PartialD]", 
    SuperscriptBox["\[Mu]", 
     StyleBox["b", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4997d195-c9bf-41c8-ac84-5aac813172fa"],
 " of the superfluid gives the mass matrix of the gauge bosons, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"(", 
      SuperscriptBox[
       StyleBox["M", "TI"], "2"], ")"}], 
     StyleBox["ab", "TI"]], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["a", "TI"]], 
    SubscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["b", "TI"]], 
    SubsuperscriptBox["\[Chi]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["ab", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4bd6454c-48d4-4621-9b41-c29c931895c6"],
 " (the Higgs mechanism of the condensate), with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["a", "TI"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9b7f1e94-5357-4f0e-8fa5-178584b7beda"],
 " for the three ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a5852e48-b674-4455-85df-5a1df8bc8a7a"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["F",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0e97803f-e9f0-4d0a-89f0-5861f66dc80d"],
 " for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "02192501-d4ee-458f-9d79-f42328bbc19f"],
 ". The next cell computes ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Chi]", 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["ab", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "af38c25f-2d55-4cc9-bef7-2eefa7477388"],
 " by central differences of the self-consistent states with the external \
self-energies ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[MinusPlus]", 
     StyleBox["h", "TI"]}], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["Q",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["b", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fcacf9e0-ad3b-41a1-a7ab-c91e67c6e634"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["h", "TI"], "\[LongEqual]", "2", "\[Times]", 
    SuperscriptBox["10", 
     RowBox[{"-", "3"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "456fd0d6-a915-49b5-b0bd-857607868386"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    StyleBox["h", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5b109cf4-bc35-47f2-96ac-31a62db95922"],
 ", and the Richardson extrapolation. The generator ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ba048a2d-f5a5-4726-ba4a-50b7d57f607a"],
 " leaves the condensate in the channel ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f7028562-3bad-41cb-9654-10742dd16bec"],
 " unchanged, so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Chi]", 
     StyleBox["SF",
      FontSlant->"Plain"], "33"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a731d2e1-6e79-4a0b-ac44-724343a397c4"],
 ": ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4d227d44-95cb-4b9e-92e1-66ce8125a409"],
 " stays massless (the zeugon), and there is no mixing."
}], "Text",ExpressionUUID->"a3e9b9f3-bc2c-4abe-a95d-c493b249231d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", "four", " ", 
     RowBox[{"charges", ":", " ", 
      RowBox[{"T", "^", "1"}]}]}], ",", " ", 
    RowBox[{"T", "^", "2"}], ",", " ", 
    RowBox[{
     RowBox[{"T", "^", "3"}], " ", 
     RowBox[{"(", 
      RowBox[{"1", "_", "4", " ", 
       RowBox[{"(", "x", ")"}], " ", 
       RowBox[{"tau", "/", "2"}]}], ")"}], " ", "and", " ", "the", " ", 
     "fermion", " ", "number", " ", "1", "_", "8"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"chargesSF", " ", "=", " ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"N", "[", 
          RowBox[{"i8", "[", 
           RowBox[{
            RowBox[{"sig", "[", 
             RowBox[{"[", 
              RowBox[{"k", " ", "+", " ", "1"}], "]"}], "]"}], "/", "2"}], 
           "]"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"{", "id8", "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"susceptibilitySF", "[", 
      RowBox[{"mo", ",", " ", "s"}], "]"}], ":", " ", 
     RowBox[{
     "the", " ", "4", " ", "x", " ", "4", " ", "static", " ", 
      "susceptibilities", " ", "by", " ", "central", " ", "differences", " ", 
      "and", " ", "Richardson"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"susceptibilitySF", "[", 
      RowBox[{"mo_", ",", " ", "s_", ",", " ", 
       RowBox[{"h_", " ", ":", " ", 
        RowBox[{"2.", " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "3"}]}]}]}]}], "]"}], " ", ":=", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", "dn", "}"}], ",", "\n", "     ", 
          RowBox[{
           RowBox[{"dn", " ", "=", " ", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"Module", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"r", " ", "=", " ", 
                  RowBox[{"Table", "[", 
                   RowBox[{
                    RowBox[{"Module", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"ext", " ", "=", " ", 
                    RowBox[{
                    RowBox[{"-", "sg"}], " ", "step", " ", 
                    RowBox[{"chargesSF", "[", 
                    RowBox[{"[", "bb", "]"}], "]"}]}]}], "}"}], ",", "\n", 
                    "            ", 
                    RowBox[{
                    RowBox[{"solveSF", "[", 
                    RowBox[{"mo", ",", " ", 
                    RowBox[{
                    RowBox[{"s", "[", "\"\<n\>\"", "]"}], " ", "+", " ", 
                    "ext"}], ",", " ", 
                    RowBox[{"s", "[", "\"\<p\>\"", "]"}], ",", " ", "0.6", ",",
                     " ", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", "14"}]}], ",", " ", "40000", ",", " ", 
                    "ext"}], "]"}], "[", "\"\<rho\>\"", "]"}]}], "]"}], ",", 
                    " ", 
                    RowBox[{"{", 
                    RowBox[{"sg", ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"1", ",", " ", 
                    RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], "]"}]}], "}"}], ",",
                 "\n", "        ", 
                RowBox[{"Table", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Re", "[", 
                    RowBox[{
                    RowBox[{"Tr", "[", 
                    RowBox[{
                    RowBox[{"chargesSF", "[", 
                    RowBox[{"[", "a", "]"}], "]"}], " ", ".", " ", 
                    RowBox[{"r", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "]"}], " ", "-", " ", 
                    RowBox[{"Tr", "[", 
                    RowBox[{
                    RowBox[{"chargesSF", "[", 
                    RowBox[{"[", "a", "]"}], "]"}], " ", ".", " ", 
                    RowBox[{"r", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], "]"}], "/", 
                   RowBox[{"(", 
                    RowBox[{"2", " ", "step"}], ")"}]}], ",", " ", 
                  RowBox[{"{", 
                   RowBox[{"a", ",", " ", "4"}], "}"}]}], "]"}]}], "]"}], ",",
               " ", 
              RowBox[{"{", 
               RowBox[{"step", ",", " ", 
                RowBox[{"{", 
                 RowBox[{"h", ",", " ", 
                  RowBox[{"2", " ", "h"}]}], "}"}]}], "}"}]}], "]"}]}], ";", 
           "\n", "     ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"4", " ", 
               RowBox[{"dn", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], " ", "-", " ", 
              RowBox[{"dn", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "/", "3"}]}]}], "]"}],
         ",", " ", 
        RowBox[{"{", 
         RowBox[{"bb", ",", " ", "4"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
   
   RowBox[{
    RowBox[{"chiRows", " ", "=", " ", 
     RowBox[{"{", "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"key", " ", "=", " ", 
           RowBox[{"shortName", "[", "m", "]"}]}], ",", " ", "mo", ",", " ", 
          "s", ",", " ", "chi", ",", " ", "off"}], "}"}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"mo", ",", " ", "s"}], "}"}], " ", "=", " ", 
          RowBox[{"groundSF", "[", 
           RowBox[{"\"\<V2_\>\"", " ", "<>", " ", "key"}], "]"}]}], ";", "\n",
          "   ", 
         RowBox[{"chi", " ", "=", " ", 
          RowBox[{"susceptibilitySF", "[", 
           RowBox[{"mo", ",", " ", "s"}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"off", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{"chi", " ", "-", " ", 
             RowBox[{"DiagonalMatrix", "[", 
              RowBox[{"Diagonal", "[", "chi", "]"}], "]"}]}], "]"}], "]"}]}], 
         ";", "\n", "   ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{"\"\<WP2-8a \>\"", " ", "<>", " ", "key"}], ",", " ", 
           RowBox[{
           "key", " ", "<>", " ", "\"\<: chi_11 = \>\"", " ", "<>", " ", 
            RowBox[{"ToString", "[", 
             RowBox[{"NumberForm", "[", 
              RowBox[{
               RowBox[{"chi", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], ",", " ", "10"}],
               "]"}], "]"}], " ", "<>", " ", "\"\<, chi_FF = \>\"", " ", "<>",
             " ", 
            RowBox[{"ToString", "[", 
             RowBox[{"NumberForm", "[", 
              RowBox[{
               RowBox[{"chi", "[", 
                RowBox[{"[", 
                 RowBox[{"4", ",", " ", "4"}], "]"}], "]"}], ",", " ", "10"}],
               "]"}], "]"}], " ", "<>", " ", "\"\< = Rust; chi_33 = \>\"", 
            " ", "<>", " ", 
            RowBox[{"sci", "[", 
             RowBox[{"chi", "[", 
              RowBox[{"[", 
               RowBox[{"3", ",", " ", "3"}], "]"}], "]"}], "]"}], " ", "<>", 
            " ", "\"\< (massless zeugon), no mixing\>\""}], ",", "\n", "    ", 
           RowBox[{"Max", "[", 
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{"chi", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], " ", "-", " ", 
               RowBox[{"rustPart2", "[", 
                RowBox[{"\"\<p2_chi11_\>\"", " ", "<>", " ", "key"}], "]"}]}],
               "]"}], ",", " ", 
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{"chi", "[", 
                RowBox[{"[", 
                 RowBox[{"4", ",", " ", "4"}], "]"}], "]"}], " ", "-", " ", 
               RowBox[{"rustPart2", "[", 
                RowBox[{"\"\<p2_chiFF_\>\"", " ", "<>", " ", "key"}], "]"}]}],
               "]"}], ",", " ", 
             RowBox[{"Abs", "[", 
              RowBox[{"chi", "[", 
               RowBox[{"[", 
                RowBox[{"3", ",", " ", "3"}], "]"}], "]"}], "]"}], ",", " ", 
             "off"}], "]"}], ",", " ", 
           RowBox[{"10", "^", 
            RowBox[{"-", "8"}]}], ",", "\n", "    ", 
           
           RowBox[{"\"\<P2-8a \>\"", " ", "<>", " ", "key", " ", "<>", 
            " ", "\"\<, P2-8b \>\"", " ", "<>", " ", "key"}], ",", " ", 
           RowBox[{"\"\<YP2-8a \>\"", " ", "<>", " ", "key"}]}], "]"}], ";", 
         "\n", "   ", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"chiRows", ",", " ", 
           RowBox[{"{", 
            RowBox[{"key", ",", " ", 
             RowBox[{"chi", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
             RowBox[{"chi", "[", 
              RowBox[{"[", 
               RowBox[{"3", ",", " ", "3"}], "]"}], "]"}], ",", " ", 
             RowBox[{"chi", "[", 
              RowBox[{"[", 
               RowBox[{"4", ",", " ", "4"}], "]"}], "]"}], ",", " ", 
             RowBox[{"gvLL", " ", 
              RowBox[{"Sqrt", "[", 
               RowBox[{"chi", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], "]"}]}], ",", 
             " ", 
             RowBox[{"gfLL", " ", 
              RowBox[{"Sqrt", "[", 
               RowBox[{"chi", "[", 
                RowBox[{"[", 
                 RowBox[{"4", ",", " ", "4"}], "]"}], "]"}], "]"}]}]}], 
            "}"}]}], "]"}]}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"m", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\"\<HS\>\"", ",", " ", "1.", ",", " ", "1."}], "}"}], ",",
           " ", 
          RowBox[{"{", "\"\<KS\>\"", "}"}], ",", " ", 
          RowBox[{"{", "\"\<CJT\>\"", "}"}]}], "}"}]}], "}"}]}], "]"}], ";"}],
    "\n", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
            RowBox[{"NumberForm", "[", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", " ", "8"}], "]"}], ",", 
            " ", 
            RowBox[{"sci", "[", 
             RowBox[{"#", "[", 
              RowBox[{"[", "3", "]"}], "]"}], "]"}], ",", " ", 
            RowBox[{"NumberForm", "[", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "4", "]"}], "]"}], ",", " ", "8"}], "]"}], ",", 
            " ", 
            RowBox[{"NumberForm", "[", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "5", "]"}], "]"}], ",", " ", "8"}], "]"}], ",", 
            " ", 
            RowBox[{"NumberForm", "[", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "6", "]"}], "]"}], ",", " ", "8"}], "]"}]}], 
           "}"}], " ", "&"}], ",", " ", "chiRows"}], "]"}], ",", "\n", "   ", 
       
       RowBox[{"{", 
        RowBox[{"\"\<method\>\"", ",", " ", "\"\<chi_11 = chi_22\>\"", ",", 
         " ", "\"\<chi_33\>\"", ",", " ", "\"\<chi_FF\>\"", ",", 
         " ", "\"\<M_W = g_v sqrt(chi_11)\>\"", ",", 
         " ", "\"\<M_Z = g_F sqrt(chi_FF)\>\""}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
     RowBox[{"Alignment", " ", "->", " ", "Right"}]}], "]"}]}]}]], "Input",
 CellLabel->
  "In[256]:=",ExpressionUUID->"b262eb10-e02e-4735-882f-d5f41bcd19b6"],

