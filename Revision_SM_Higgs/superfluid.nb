energy -1.324e-4 = Rust (relative; 294 iterations; exchange energy \
9.647e-5)\"\>", "\[InvisibleSpace]", "\<\"   [the same check: Rust \"\>", 
   "\[InvisibleSpace]", "\<\"P2-8f\"\>", 
   "\[InvisibleSpace]", "\<\", Python \"\>", 
   "\[InvisibleSpace]", "\<\"YP2-8d\"\>", "\[InvisibleSpace]", "\<\"]\"\>"}],
  SequenceForm[
  "PASS ", "WP2-8d", "  deviation ", "1.492e-8", " (tolerance ", "1.000e-7", 
   "): ", "CJT with the exchange at g_v = 0.7, g_F = 0.45: energy -1.324e-4 = \
Rust (relative; 294 iterations; exchange energy 9.647e-5)", 
   "   [the same check: Rust ", "P2-8f", ", Python ", "YP2-8d", "]"],
  Editable->False]], "Print",
 CellChangeTimes->{4.004330824701144*^9},
