Cell[CellGroupData[{

Cell["III.G.4 The coefficient at zero pair momentum and the slope", "Section",ExpressionUUID->"859d70cc-01e1-49a2-a70f-428fc10bfcc9"],

Cell[TextData[{
 "The next cell computes, for every method with its own critical temperature \
(Section III.T.4), the coefficient at zero pair momentum from the static pair \
response and checks it four ways: at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.9", "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2dbc57f2-2960-4a2a-b65f-bcfc042fe801"],
 " it is the Taylor coefficient of the nonlinear free energy of the Rust \
table (Section III.T); at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "/", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]], "\[LongEqual]", "0.9"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ebb464d8-6d02-4091-8e1d-b7c0bc78d84c"],
 ", ",
 Cell[BoxData[
  FormBox["0.998", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "42d16ca8-0f85-4e9b-aa92-161fb1260630"],
 ", ",
 Cell[BoxData[
  FormBox["1.002", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a7efb3b4-6c70-4e06-9f97-eba07ab2792a"],
 " it is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "-", 
      SubsuperscriptBox["\[Lambda]", 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["P",
        FontSlant->"Plain"]]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["\[Lambda]", 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["P",
        FontSlant->"Plain"]], 
      SubsuperscriptBox[
       StyleBox["g", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["P",
         FontSlant->"Plain"]}]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fecb4c9a-c2a2-44b3-97c5-a76654c82931"],
 " with the eigenvalue of Section III.T.4; at ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "600cc7d0-d809-47e1-97c8-9f555125ea36"],
 " it vanishes; and no other pair channel is induced. The slope ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Alpha]", 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["GL",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "660312c5-d2fb-4ccd-8cad-e27fc7978fd2"],
 " is computed twice: from central differences of the coefficient at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     RowBox[{"1", "\[PlusMinus]", "0.002"}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a3d385e5-d32f-4098-9a36-bac300c52263"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     RowBox[{"1", "\[PlusMinus]", "0.004"}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "02e946e6-ed58-4368-a2b6-452c9a0a9b07"],
 " with the Richardson extrapolation, and in closed form with the derivatives \
of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["I", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "1", ")"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ad8c748b-821c-401f-bea4-80c83c0c7693"],
 " on the radial nodes,"
}], "Text",ExpressionUUID->"6b02e921-fa9b-4d25-afe0-9ee58546cc1a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[PartialD]", 
    StyleBox["T", "TI"]], 
   SubsuperscriptBox[
    StyleBox["I", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "1", ")"}]], "\[LongEqual]", 
   RowBox[{"-", 
    FractionBox["1", 
     RowBox[{"2", 
      SuperscriptBox[
       StyleBox["T", "TI"], "2"]}]]}], "\[ThinSpace]", 
   SubsuperscriptBox["\[Integral]", "0", 
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]], "\[ThinSpace]", 
   FractionBox[
    RowBox[{
     SuperscriptBox[
      StyleBox["q", "TI"], "2"], "\[ThinSpace]", 
     StyleBox["dq", "TI"]}], 
    RowBox[{
     SuperscriptBox[
      StyleBox["cosh",
       FontSlant->"Plain"], "2"], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["E", "TI"], 
        StyleBox["M", "TI"]], "/", "2", 
       StyleBox["T", "TI"]}], ")"}]}]], ",", "      ", 
   SubscriptBox["\[PartialD]", 
    StyleBox["M", "TI"]], 
   SubsuperscriptBox[
    StyleBox["I", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "1", ")"}]], "\[LongEqual]", 
   SubsuperscriptBox["\[Integral]", "0", 
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["q", "TI"], "2"], 
   FractionBox[
    StyleBox["M", "TI"], 
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["M", "TI"]]], 
   RowBox[{"[", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"2", 
       StyleBox["T", "TI"], 
       SubscriptBox[
        StyleBox["E", "TI"], 
        StyleBox["M", "TI"]], "\[ThinSpace]", 
       SuperscriptBox[
        StyleBox["cosh",
         FontSlant->"Plain"], "2"], 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox[
          StyleBox["E", "TI"], 
          StyleBox["M", "TI"]], "/", "2", 
         StyleBox["T", "TI"]}], ")"}]}]], "-", 
     FractionBox[
      RowBox[{
       StyleBox["tanh",
        FontSlant->"Plain"], 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox[
          StyleBox["E", "TI"], 
          StyleBox["M", "TI"]], "/", "2", 
         StyleBox["T", "TI"]}], ")"}]}], 
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["M", "TI"], "2"]]}], "]"}], 
   StyleBox["dq", "TI"], ","}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
