      RowBox[{
       RowBox[{"StringQ", "[", "x", "]"}], ",", " ", "x", ",", " ", 
       RowBox[{"ToString", "[", "x", "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"mism", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{"channels", ",", " ", 
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"r", " ", "=", " ", 
            RowBox[{"rowOf", "[", 
             RowBox[{"hdr", ",", " ", "rows", ",", " ", 
              RowBox[{"#", "[", "\"\<sector\>\"", "]"}], ",", " ", 
              RowBox[{"#", "[", "\"\<parity\>\"", "]"}]}], "]"}]}], "}"}], ",",
           "\n", "     ", 
          RowBox[{
           RowBox[{"MissingQ", "[", "r", "]"}], " ", "||", " ", 
           RowBox[{
            RowBox[{"str", "[", 
             RowBox[{"r", "[", 
              RowBox[{"[", 
               RowBox[{"col", "[", 
                RowBox[{"hdr", ",", " ", "\"\<dimension\>\""}], "]"}], "]"}], 
              "]"}], "]"}], " ", "!=", " ", 
            RowBox[{"ToString", "[", 
             RowBox[{"#", "[", "\"\<dim\>\"", "]"}], "]"}]}], " ", "||", "\n",
            "      ", 
           RowBox[{
            RowBox[{"str", "[", 
             RowBox[{"r", "[", 
              RowBox[{"[", 
               RowBox[{"col", "[", 
                RowBox[{"hdr", ",", " ", "\"\<SU2_multiplets\>\""}], "]"}], 
               "]"}], "]"}], "]"}], " ", "!=", " ", 
            RowBox[{"#", "[", "\"\<su2\>\"", "]"}]}], " ", "||", "\n", 
           "      ", 
           RowBox[{"AnyTrue", "[", 
