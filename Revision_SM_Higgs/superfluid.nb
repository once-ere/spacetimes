              RowBox[{"1", "/", "5"}], ",", " ", 
              RowBox[{"1", "/", "2"}], ",", " ", "1"}], "}"}]}], "}"}]}], 
         "]"}], "]"}], " ", "<", " ", 
       RowBox[{"10", "^", 
        RowBox[{"-", "30"}]}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"mLL", " ", "=", " ", 
     RowBox[{"1", "/", "5"}]}], ";", " ", 
