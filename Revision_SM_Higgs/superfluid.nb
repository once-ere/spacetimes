Cell[CellGroupData[{

Cell["III.L.4 The fit and its residual", "Section",ExpressionUUID->"0d3f3957-b6a7-4786-a1d7-7e955afd8dfc"],

Cell[TextData[{
 StyleBox["\"The Landau form is a fit.\"",
  FontWeight->"Bold"],
 " The coefficients ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ea1f9a90-aba2-407e-8388-7dde498d6203"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["b", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f2cd74aa-08e1-44f9-80d1-2559de548437"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7c45deb0-4e3e-4b03-95e0-06b7a55fccf9"],
 " are not derived from the theory: they minimize the sum of the squares of \
the residuals ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["\[ScriptCapitalV]",
      FontSlant->"Plain"], 
     StyleBox["L",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubscriptBox["\[CapitalPhi]", 
      StyleBox["i", "TI"]], ")"}], "-", 
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalV]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], 
    RowBox[{"(", 
     SubscriptBox["\[CapitalPhi]", 
      StyleBox["i", "TI"]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "924c4c23-ecdb-403b-b116-3bf1d8b9f1d7"],
 " over the computed points ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPhi]", 
     StyleBox["i", "TI"]], "\[LessEqual]", "1.4", 
    SubsuperscriptBox["\[CapitalPhi]", 
     RowBox[{"0", ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fbd35979-2205-47b7-8265-06abc1790cc1"],
 ". ",
 StyleBox["\"Its largest residual is 0.27-0.7 % of the depth.\"",
  FontWeight->"Bold"],
 " The largest of these residuals, divided by the depth, lies between these \
two numbers for the five methods. The next cell defines the least squares \
(the function ",
 StyleBox["LeastSquares",
  FontFamily->"Source Code Pro"],
 " of the Wolfram Language on the columns ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["t", "TI"], 
    StyleBox["k", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "470a8d8b-9a2e-4431-9497-0249f4959c95"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["t", "TI"], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"\[CapitalPhi]", "/", 
       SubscriptBox["\[CapitalPhi]", 
        StyleBox["max",
         FontSlant->"Plain"]]}], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9baecc2d-74c8-459e-b189-d9490ea71796"],
 ", which keeps the fits with many powers well conditioned) and computes, for \
each method: the minimum ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPhi]", 
    StyleBox["L",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1ec4d1ec-30cf-4dd0-af46-ea54b3c2908b"],
 " of the fitted polynomial, its value and its second derivative there; the \
largest residual of the fits ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["k", "TI"], "\[LongEqual]", "1"}], 
     StyleBox["K", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["c", "TI"], 
     StyleBox["k", "TI"]], 
    SuperscriptBox["\[CapitalPhi]", 
     RowBox[{"2", 
      StyleBox["k", "TI"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1f0a4cde-ff9b-4452-8b13-e5c319c73b32"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["K", "TI"], "\[LongEqual]", "2"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5d36ad97-68f5-482a-80b7-f660fc86f432"],
 " (the quartic form of the Standard Model) to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["K", "TI"], "\[LongEqual]", "6"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b3939b5a-06de-4e56-a141-577b7d385b19"],
 " (powers to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CapitalPhi]", "12"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "81e06279-add3-4872-aeba-794bf8775d7a"],
 "); the number of sign changes of the residual of the Landau form; and the \
Landau form fitted on three intervals, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"0", ",", 
     SubsuperscriptBox["\[CapitalPhi]", 
      RowBox[{"0", ",", 
       StyleBox["SF",
        FontSlant->"Plain"]}], 
      StyleBox["X", "TI"]]}], "]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bf5eb2b8-bee8-4a0d-b646-3fd0842ecc6e"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"0", ",", "1.4", 
     SubsuperscriptBox["\[CapitalPhi]", 
      RowBox[{"0", ",", 
       StyleBox["SF",
        FontSlant->"Plain"]}], 
      StyleBox["X", "TI"]]}], "]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3a7275d1-ddc0-4f7e-b2b3-e4b6069e38f4"],
 " and the whole curve. Every number is compared with that of the Rust \
program, which computes it with Householder reflections; the Python program \
computes it a third time with the singular-value decomposition."
}], "Text",ExpressionUUID->"3c4a96cf-79e9-4939-9227-ce614e997d3f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"evenFit", "[", 
        RowBox[{"pts", ",", " ", "kk"}], "]"}], ":", " ", 
       RowBox[{
        RowBox[{"the", " ", "least"}], "-", 
        RowBox[{"squares", " ", "fit", " ", "V"}]}]}], " ", "=", " ", 
      RowBox[{"sum_", 
       RowBox[{"{", 
        RowBox[{"k", "=", 
         RowBox[{
          RowBox[{"1", ".."}], "kk"}]}], "}"}], " ", "c_k", " ", 
       RowBox[{"Phi", "^", 
        RowBox[{"(", 
         RowBox[{"2", "k"}], ")"}]}], " ", "to", " ", "the", " ", "points", " ", 
       RowBox[{"{", 
        RowBox[{"Phi", ",", " ", "V"}], "}"}]}]}], ";", " ", 
     RowBox[{"returns", " ", "the", "\n", "   ", "coefficients", " ", 
      RowBox[{"{", 
