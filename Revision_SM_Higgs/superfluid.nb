]}]}]}]}]}]}], "-", "10"}], ":", " ", 
     RowBox[{"the", " ", "channels"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"su2Content", "[", "cas_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"dims", " ", "=", " ", 
         RowBox[{"{", "}"}]}], "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"d", " ", "=", " ", 
              RowBox[{"Sqrt", "[", 
               RowBox[{"1", " ", "+", " ", 
                RowBox[{"4", " ", 
                 RowBox[{"t", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}]}], "}"}], ",", 
            " ", 
            RowBox[{"dims", " ", "=", " ", 
             RowBox[{"Join", "[", 
              RowBox[{"dims", ",", " ", 
               RowBox[{"ConstantArray", "[", 
                RowBox[{"d", ",", " ", 
                 RowBox[{
                  RowBox[{"t", "[", 
                   RowBox[{"[", "2", "]"}], "]"}], "/", "d"}]}], "]"}]}], 
              "]"}]}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"t", ",", " ", 
            RowBox[{"Tally", "[", 
             RowBox[{"Sort", "[", "cas", "]"}], "]"}]}], "}"}]}], "]"}], ";", 
        "\n", "  ", 
        RowBox[{"StringRiffle", "[", 
         RowBox[{
          RowBox[{"ToString", " ", "/@", " ", 
           RowBox[{"Sort", "[", "dims", "]"}]}], ",", " ", "\"\< + \>\""}], 
         "]"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"the", " ", "multiplets", " ", "of", " ", "SU", 
     RowBox[{"(", "2", ")"}], "_L", " ", "x", " ", "SU", 
     RowBox[{"(", "2", ")"}], 
     RowBox[{"_R", ":", " ", 
      RowBox[{"the", " ", "Casimir", " ", "of", " ", "SU", 
       RowBox[{"(", "2", ")"}], "_R", " ", "restricted", " ", "to", " ", 
       "each", " ", "eigenspace", " ", "of", " ", "that", " ", "of", " ", 
       "SU", 
       RowBox[{"(", "2", ")"}], "_L"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"su2x2Content", "[", 
      RowBox[{"cl_", ",", " ", "cr_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"mult", " ", "=", " ", 
         RowBox[{"{", "}"}]}], "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"bsp", " ", "=", " ", 
               RowBox[{"Transpose", "[", 
                RowBox[{"NullSpace", "[", 
                 RowBox[{"cl", " ", "-", " ", 
                  RowBox[{"lam", " ", 
                   RowBox[{"IdentityMatrix", "[", 
                    RowBox[{"Length", "[", "cl", "]"}], "]"}]}]}], "]"}], 
                "]"}]}], ",", " ", "sub", ",", " ", 
              RowBox[{"dl", " ", "=", " ", 
               RowBox[{"Sqrt", "[", 
                RowBox[{"1", " ", "+", " ", 
                 RowBox[{"4", " ", "lam"}]}], "]"}]}]}], "}"}], ",", "\n", 
            "     ", 
            RowBox[{
             RowBox[{"sub", " ", "=", " ", 
              RowBox[{
               RowBox[{"PseudoInverse", "[", "bsp", "]"}], ".", "cr", ".", 
               "bsp"}]}], ";", "\n", "     ", 
             RowBox[{"Do", "[", 
              RowBox[{
               RowBox[{"With", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"dr", " ", "=", " ", 
                   RowBox[{"Sqrt", "[", 
                    RowBox[{"1", " ", "+", " ", 
                    RowBox[{"4", " ", 
                    RowBox[{"t", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}]}], "}"}], ",", 
                 " ", 
                 RowBox[{"mult", " ", "=", " ", 
                  RowBox[{"Join", "[", 
                   RowBox[{"mult", ",", " ", 
                    RowBox[{"ConstantArray", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"dl", ",", " ", "dr"}], "}"}], ",", " ", 
                    RowBox[{
                    RowBox[{"t", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "/", 
                    RowBox[{"(", 
                    RowBox[{"dl", " ", "dr"}], ")"}]}]}], "]"}]}], "]"}]}]}], 
                "]"}], ",", "\n", "      ", 
               RowBox[{"{", 
                RowBox[{"t", ",", " ", 
                 RowBox[{"Tally", "[", 
                  RowBox[{"Simplify", "[", 
                   RowBox[{"Eigenvalues", "[", "sub", "]"}], "]"}], "]"}]}], 
                "}"}]}], "]"}]}]}], "]"}], ",", "\n", "   ", 
          RowBox[{"{", 
           RowBox[{"lam", ",", " ", 
            RowBox[{"DeleteDuplicates", "[", 
             RowBox[{"Simplify", "[", 
              RowBox[{"Eigenvalues", "[", "cl", "]"}], "]"}], "]"}]}], 
           "}"}]}], "]"}], ";", "\n", "  ", 
        RowBox[{"StringRiffle", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"\"\<(\>\"", " ", "<>", " ", 
             RowBox[{"ToString", "[", 
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "]"}], " ", "<>", 
             " ", "\"\<,\>\"", " ", "<>", " ", 
             RowBox[{"ToString", "[", 
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "]"}], " ", "<>", 
             " ", "\"\<)\>\""}], " ", "&"}], " ", "/@", " ", 
           RowBox[{"Sort", "[", "mult", "]"}]}], ",", " ", "\"\< + \>\""}], 
         "]"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"fracStr", "[", "x_", "]"}], " ", ":=", " ", 
     RowBox[{"ToString", "[", 
      RowBox[{"x", ",", " ", "InputForm"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"fracsStr", "[", "v_", "]"}], " ", ":=", " ", 
     RowBox[{"StringRiffle", "[", 
      RowBox[{
       RowBox[{"fracStr", " ", "/@", " ", 
        RowBox[{"Reverse", "[", 
         RowBox[{"Sort", "[", "v", "]"}], "]"}]}], ",", " ", "\"\<; \>\""}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"the", " ", "parts", " ", "of", " ", "parity"}], " ", "+", 
      RowBox[{"1", " ", "and"}], " ", "-", 
      RowBox[{
      "1", " ", "of", " ", "the", " ", "space", " ", "b", " ", "of", " ", "a",
        " ", "sector"}]}], ",", " ", 
     RowBox[{
     "with", " ", "the", " ", "matrices", " ", "of", " ", "the", " ", 
      "generators", " ", "glist", " ", "on", " ", "each"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"channelsOf", "[", 
      RowBox[{"sec_", ",", " ", "b_", ",", " ", "glist_"}], "]"}], " ", ":=", 
     " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"pr", ",", " ", "res", ",", " ", 
         RowBox[{"out", " ", "=", " ", 
          RowBox[{"{", "}"}]}]}], "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"pr", ",", " ", "res"}], "}"}], " ", "=", " ", 
         RowBox[{"restrict", "[", 
          RowBox[{
           RowBox[{"parityOp", "[", "sec", "]"}], ",", " ", "b"}], "]"}]}], ";",
         "\n", "  ", 
        RowBox[{"closureAll", " ", "=", " ", 
         RowBox[{"closureAll", " ", "&&", " ", 
          RowBox[{"allZero", "[", "res", "]"}]}]}], ";", "\n", "  ", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"subb", " ", "=", " ", 
               RowBox[{
                RowBox[{"NullSpace", "[", 
                 RowBox[{"pr", " ", "-", " ", 
                  RowBox[{"sign", " ", 
                   RowBox[{"IdentityMatrix", "[", 
                    RowBox[{"Length", "[", "pr", "]"}], "]"}]}]}], "]"}], ".",
                 "b"}]}], ",", " ", "lx"}], "}"}], ",", "\n", "     ", 
            RowBox[{
             RowBox[{"lx", " ", "=", " ", 
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{"Module", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"c", ",", " ", "r"}], "}"}], ",", " ", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"c", ",", " ", "r"}], "}"}], " ", "=", " ", 
                    RowBox[{"restrict", "[", 
                    RowBox[{
                    RowBox[{"chargeOp", "[", 
                    RowBox[{"sec", ",", " ", 
                    RowBox[{"glist", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", " ", 
                    "subb"}], "]"}]}], ";", "\n", "        ", 
                   RowBox[{"closureAll", " ", "=", " ", 
                    RowBox[{"closureAll", " ", "&&", " ", 
                    RowBox[{"allZero", "[", "r", "]"}]}]}], ";", " ", "c"}]}],
                  "]"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"i", ",", " ", 
                  RowBox[{"Length", "[", "glist", "]"}]}], "}"}]}], "]"}]}], ";",
              "\n", "     ", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"out", ",", " ", 
               RowBox[{"<|", 
                RowBox[{
                 RowBox[{"\"\<sector\>\"", " ", "->", " ", 
                  RowBox[{"secName", "[", "sec", "]"}]}], ",", " ", 
                 RowBox[{"\"\<parity\>\"", " ", "->", " ", "sign"}], ",", " ", 
                 RowBox[{"\"\<dim\>\"", " ", "->", " ", 
                  RowBox[{"Length", "[", "subb", "]"}]}], ",", " ", 
                 RowBox[{"\"\<lx\>\"", " ", "->", " ", "lx"}]}], "|>"}]}], 
              "]"}]}]}], "]"}], ",", "\n", "   ", 
          RowBox[{"{", 
           RowBox[{"sign", ",", " ", 
            RowBox[{"{", 
             RowBox[{"1", ",", " ", 
              RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], "]"}], ";", "\n", "  ", 
        "out"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"closureAll", " ", "=", " ", "True"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"channels", " ", "=", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"channelsOf", "[", 
         RowBox[{
          RowBox[{"sectors", "[", 
           RowBox[{"[", "k", "]"}], "]"}], ",", " ", 
          RowBox[{"spaces", "[", 
           RowBox[{"[", "k", "]"}], "]"}], ",", " ", "gens"}], "]"}], ",", 
        " ", 
        RowBox[{"{", 
         RowBox[{"k", ",", " ", "12"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
   
   RowBox[{
    RowBox[{"channels", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Append", "[", 
        RowBox[{"#", ",", " ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<su2\>\"", " ", "->", " ", 
            RowBox[{"su2Content", "[", 
             RowBox[{"Simplify", "[", 
              RowBox[{"Eigenvalues", "[", 
               RowBox[{"Sum", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"#", "[", "\"\<lx\>\"", "]"}], "[", 
                   RowBox[{"[", "a", "]"}], "]"}], ".", 
                  RowBox[{
                   RowBox[{"#", "[", "\"\<lx\>\"", "]"}], "[", 
                   RowBox[{"[", "a", "]"}], "]"}]}], ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"a", ",", " ", "3"}], "}"}]}], "]"}], "]"}], "]"}], 
             "]"}]}], ",", "\n", "      ", 
           RowBox[{"\"\<Y\>\"", " ", "->", " ", 
            RowBox[{"fracsStr", "[", 
             RowBox[{"Simplify", "[", 
              RowBox[{"Eigenvalues", "[", 
               RowBox[{
                RowBox[{"#", "[", "\"\<lx\>\"", "]"}], "[", 
                RowBox[{"[", "iY", "]"}], "]"}], "]"}], "]"}], "]"}]}], ",", 
           " ", 
           RowBox[{"\"\<qv\>\"", " ", "->", " ", 
            RowBox[{"Simplify", "[", 
             RowBox[{"Eigenvalues", "[", 
              RowBox[{
               RowBox[{"#", "[", "\"\<lx\>\"", "]"}], "[", 
               RowBox[{"[", "iQ", "]"}], "]"}], "]"}], "]"}]}], ",", "\n", 
           "      ", 
           RowBox[{"\"\<F\>\"", " ", "->", " ", 
            RowBox[{"fracsStr", "[", 
             RowBox[{"Simplify", "[", 
              RowBox[{"Eigenvalues", "[", 
               RowBox[{
                RowBox[{"#", "[", "\"\<lx\>\"", "]"}], "[", 
                RowBox[{"[", "iF", "]"}], "]"}], "]"}], "]"}], "]"}]}], ",", 
           " ", 
           RowBox[{"\"\<R\>\"", " ", "->", " ", 
            RowBox[{"fracsStr", "[", 
             RowBox[{"Simplify", "[", 
              RowBox[{"Eigenvalues", "[", 
               RowBox[{
                RowBox[{"#", "[", "\"\<lx\>\"", "]"}], "[", 
                RowBox[{"[", "iR", "]"}], "]"}], "]"}], "]"}], "]"}]}], ",", 
           "\n", "      ", 
           RowBox[{"\"\<T3R\>\"", " ", "->", " ", 
            RowBox[{"fracsStr", "[", 
             RowBox[{"Simplify", "[", 
              RowBox[{"Eigenvalues", "[", 
               RowBox[{
                RowBox[{"#", "[", "\"\<lx\>\"", "]"}], "[", 
                RowBox[{"[", "8", "]"}], "]"}], "]"}], "]"}], "]"}]}]}], 
          "|>"}]}], "]"}], " ", "&"}], " ", "/@", " ", "channels"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"channels", " ", "=", " ", 
     RowBox[{
