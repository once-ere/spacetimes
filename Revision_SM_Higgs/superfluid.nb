Cell["R.1.8 The pair fields and the bidoublet (check WQN-8)", "Subsection",ExpressionUUID->"71ff0caa-0251-467c-a4a9-2ac8c887c081"],

Cell[TextData[{
 "On an orthonormal basis of the two pairs ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPsi]", "\[Chi]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3993b19f-8a72-4519-885d-af7e46ee9bf4"],
 " of positive parity, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubsuperscriptBox["\[CapitalPi]", 
      StyleBox["SH",
       FontSlant->"Plain"], 
      StyleBox["u",
       FontSlant->"Plain"]], ",", 
     SubsuperscriptBox["\[CapitalPi]", 
      StyleBox["SH",
       FontSlant->"Plain"], 
      StyleBox["d",
       FontSlant->"Plain"]]}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4383b986-702a-4309-829b-d862d76583e6"],
 ", every generator ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ce3341bc-f988-4d04-acde-b421555d84ba"],
 " acts as a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Times]", "2"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ec58a3bf-6f93-44c6-9359-bad648ba2f44"],
 " matrix ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "08635693-3dfd-47f1-8492-750fa5527d24"],
 " with the entries ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftAngleBracket]", 
    RowBox[{
     SubscriptBox[
      StyleBox["M",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      SuperscriptBox[
       StyleBox["s", "TI"], "\[Prime]"]], ",", 
     SubscriptBox[
      StyleBox["L", "TI"], 
      StyleBox["X", "TI"]], 
     RowBox[{"(", 
      SubscriptBox[
       StyleBox["M",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["s", "TI"]], ")"}]}], "\[RightAngleBracket]"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "48e47e65-cc92-484b-a9a5-c7b466b1cbef"],
 ". A Higgs doublet of the Standard Model has ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["G", "TI"], 
     SuperscriptBox[
      StyleBox["T", "TI"], 
