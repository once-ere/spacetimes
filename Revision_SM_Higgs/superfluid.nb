     StyleBox["T", "TI"], 
     RowBox[{"3", ",", 
      StyleBox["SM",
       FontSlant->"Plain"]}]], "+", 
    SuperscriptBox[
     StyleBox["Y", "TI"], 
     StyleBox["SM",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6d8d61c5-23a1-4989-a410-64724ca39569"],
 ". The list ",
 StyleBox["gens",
  FontFamily->"Source Code Pro"],
 " holds them in the order of the tables of the Rust program: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
