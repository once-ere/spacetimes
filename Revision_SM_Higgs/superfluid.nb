             RowBox[{"IdentityMatrix", "[", "28", "]"}], " ", "-", " ", 
             RowBox[{"Transpose", "[", 
              RowBox[{"Map", "[", 
               RowBox[{"perp", ",", " ", 
                RowBox[{"Transpose", "[", "cols", "]"}]}], "]"}], "]"}]}]}], ";",
            "\n", "     ", 
           RowBox[{"pp", " ", "=", " ", 
            RowBox[{"LinearSolve", "[", 
             RowBox[{"amat", ",", " ", 
              RowBox[{"perp", "[", 
               RowBox[{"cols", " ", ".", " ", 
                RowBox[{"kd", "[", 
                 RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}], "]"}]}], ";", 
           "\n", "     ", 
           RowBox[{"pnorm", " ", "=", " ", 
            RowBox[{"Norm", "[", "pp", "]"}]}], ";", " ", 
           RowBox[{"p", " ", "=", " ", 
            RowBox[{
             RowBox[{"kd", "[", 
              RowBox[{"[", "3", "]"}], "]"}], " ", "+", " ", "pp"}]}]}]}], 
         "]"}], ";", "\n", "   ", 
        RowBox[{"kap", " ", "=", " ", 
         RowBox[{"p", " ", ".", " ", "chi"}]}], ";", "\n", "   ", 
        RowBox[{"pm", " ", "=", " ", 
         RowBox[{
          RowBox[{"interaction", "[", 
           RowBox[{"ts", ",", " ", "zero8", ",", " ", "kap"}], "]"}], "[", 
          RowBox[{"[", "3", "]"}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"phi", " ", "=", " ", 
         RowBox[{
          RowBox[{"Tr", "[", 
           RowBox[{
            RowBox[{"k8", "[", "3", "]"}], " ", ".", " ", "pm"}], "]"}], "/", 
          "8"}]}], ";", "\n", "   ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"0.5", " ", 
           RowBox[{
            RowBox[{"Re", "[", 
             RowBox[{"Tr", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"gzFromCoeffs", "[", "p", "]"}], " ", "-", " ", 
                 "pm"}], ")"}], " ", ".", " ", 
               RowBox[{"ConjugateTranspose", "[", "kap", "]"}]}], "]"}], 
             "]"}], "/", 
            RowBox[{
             RowBox[{"Abs", "[", "phi", "]"}], "^", "2"}]}]}], ",", " ", 
          "pnorm"}], "}"}]}]}], "]"}]}], ";"}], "\n", 
