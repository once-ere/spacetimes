              RowBox[{"[", "k", "]"}], "]"}], "]"}], " ", ".", " ", 
            RowBox[{"piOps", "[", 
             RowBox[{"[", "k", "]"}], "]"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}]}]}]}], "|>"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
