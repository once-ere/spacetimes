Cell[CellGroupData[{

Cell["III.L.4 The fit and its residual", "Section",ExpressionUUID->"e787b816-a847-46b3-96d7-1eea5bc5e2db"],

Cell[TextData[{
 StyleBox["\"The Landau form is a fit.\"",
  FontWeight->"Bold"],
 " The coefficients ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "01bde10b-2a87-41f0-9a19-ab296c1e2123"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["b", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5086924a-c599-41ab-938d-b95671a6fa58"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "89c4a69d-9858-4685-8fc7-ba76877a1586"],
 " are not derived from the theory: they minimize the sum of the squares of \
the residuals ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["\[ScriptCapitalV]",
      FontSlant->"Plain"], 
     StyleBox["L",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubscriptBox["\[CapitalPhi]", 
      StyleBox["i", "TI"]], ")"}], "-", 
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalV]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], 
    RowBox[{"(", 
     SubscriptBox["\[CapitalPhi]", 
      StyleBox["i", "TI"]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "36d5a9f1-8ec6-4c14-8c92-62970ce806b6"],
 " over the computed points ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPhi]", 
     StyleBox["i", "TI"]], "\[LessEqual]", "1.4", 
    SubsuperscriptBox["\[CapitalPhi]", 
     RowBox[{"0", ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3e74103e-fd17-4a0d-902d-c94717e01c99"],
 ". ",
 StyleBox["\"Its largest residual is 0.27-0.7 % of the depth.\"",
  FontWeight->"Bold"],
 " The largest of these residuals, divided by the depth, lies between these \
two numbers for the five methods. The next cell defines the least squares \
(the function ",
 StyleBox["LeastSquares",
  FontFamily->"Source Code Pro"],
 " of the Wolfram Language on the columns ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["t", "TI"], 
    StyleBox["k", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c65fa46c-ee7d-4fab-bde9-c35bbba50de4"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["t", "TI"], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"\[CapitalPhi]", "/", 
       SubscriptBox["\[CapitalPhi]", 
        StyleBox["max",
         FontSlant->"Plain"]]}], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5c7747ca-e9ff-4b37-b92c-aaefa772901b"],
 ", which keeps the fits with many powers well conditioned) and computes, for \
each method: the minimum ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPhi]", 
    StyleBox["L",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "86e26608-db4d-48a4-af3c-bf22adbf5d9c"],
 " of the fitted polynomial, its value and its second derivative there; the \
largest residual of the fits ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["k", "TI"], "\[LongEqual]", "1"}], 
     StyleBox["K", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["c", "TI"], 
     StyleBox["k", "TI"]], 
    SuperscriptBox["\[CapitalPhi]", 
     RowBox[{"2", 
      StyleBox["k", "TI"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "297dbeb0-8776-4335-a233-3a5d9aa6634a"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["K", "TI"], "\[LongEqual]", "2"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "92e6bbc4-03c1-48d0-b1d0-2c3ce68bf66c"],
 " (the quartic form of the Standard Model) to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["K", "TI"], "\[LongEqual]", "6"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2a26ba5f-9372-461a-abc5-d8d1e5110826"],
 " (powers to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CapitalPhi]", "12"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9d5a6708-cee0-4135-a87e-0849fc44d4ee"],
 "); the number of sign changes of the residual of the Landau form; and the \
Landau form fitted on three intervals, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"0", ",", 
     SubsuperscriptBox["\[CapitalPhi]", 
      RowBox[{"0", ",", 
       StyleBox["SF",
        FontSlant->"Plain"]}], 
      StyleBox["X", "TI"]]}], "]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "045df4c5-e8ca-4f11-99ce-6b3904f9915c"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"0", ",", "1.4", 
     SubsuperscriptBox["\[CapitalPhi]", 
      RowBox[{"0", ",", 
       StyleBox["SF",
        FontSlant->"Plain"]}], 
      StyleBox["X", "TI"]]}], "]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "36891044-9f01-447e-8d4c-1fbc3a0eef9e"],
 " and the whole curve. Every number is compared with that of the Rust \
program, which computes it with Householder reflections; the Python program \
computes it a third time with the singular-value decomposition."
}], "Text",ExpressionUUID->"dce0f498-1e10-42f3-aba1-630b74d4a12f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"evenFit", "[", 
        RowBox[{"pts", ",", " ", "kk"}], "]"}], ":", " ", 
       RowBox[{
        RowBox[{"the", " ", "least"}], "-", 
        RowBox[{"squares", " ", "fit", " ", "V"}]}]}], " ", "=", " ", 
      RowBox[{"sum_", 
       RowBox[{"{", 
        RowBox[{"k", "=", 
         RowBox[{
          RowBox[{"1", ".."}], "kk"}]}], "}"}], " ", "c_k", " ", 
       RowBox[{"Phi", "^", 
        RowBox[{"(", 
         RowBox[{"2", "k"}], ")"}]}], " ", "to", " ", "the", " ", "points", " ", 
       RowBox[{"{", 
        RowBox[{"Phi", ",", " ", "V"}], "}"}]}]}], ";", " ", 
     RowBox[{"returns", " ", "the", "\n", "   ", "coefficients", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"c_", "1"}], ",", " ", "...", ",", " ", "c_kk"}], "}"}]}]}], ",",
     " ", 
    RowBox[{
    "the", " ", "largest", " ", "residual", " ", "and", " ", "the", " ", 
     "list", " ", "of", " ", "the", " ", "residuals", " ", 
     RowBox[{"(", 
      RowBox[{"fit", " ", "minus", " ", "computed", " ", "value"}], ")"}]}]}],
    " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"evenFit", "[", 
      RowBox[{"pts_", ",", " ", "kk_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", " ", "=", " ", 
          RowBox[{"pts", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], ",", " ", 
         RowBox[{"y", " ", "=", " ", 
          RowBox[{"pts", "[", 
