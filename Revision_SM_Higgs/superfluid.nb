Cell[CellGroupData[{

Cell["III.L.4 The fit and its residual", "Section",ExpressionUUID->"9a968335-89dd-413e-bc39-6553236104c4"],

Cell[TextData[{
 StyleBox["\"The Landau form is a fit.\"",
  FontWeight->"Bold"],
 " The coefficients ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d397b440-bde8-456a-b685-ea031603ed08"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["b", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b359d4b5-e2f1-4c22-82c4-4e407e2fc7f8"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7225f0d5-8ea9-45a9-b284-866773b66959"],
 " are not derived from the theory: they minimize the sum of the squares of \
the residuals ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["\[ScriptCapitalV]",
      FontSlant->"Plain"], 
     StyleBox["L",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubscriptBox["\[CapitalPhi]", 
      StyleBox["i", "TI"]], ")"}], "-", 
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalV]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], 
    RowBox[{"(", 
     SubscriptBox["\[CapitalPhi]", 
      StyleBox["i", "TI"]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "247546e4-5e4b-4aea-8a33-79dcf5477191"],
 " over the computed points ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPhi]", 
     StyleBox["i", "TI"]], "\[LessEqual]", "1.4", 
    SubsuperscriptBox["\[CapitalPhi]", 
     RowBox[{"0", ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "13661e39-ea1d-4d42-94a8-36701c32d48e"],
 ". ",
 StyleBox["\"Its largest residual is 0.27-0.7 % of the depth.\"",
  FontWeight->"Bold"],
 " The largest of these residuals, divided by the depth, lies between these \
two numbers for the five methods. The next cell defines the least squares \
(the function ",
 StyleBox["LeastSquares",
  FontFamily->"Source Code Pro"],
 " of the Wolfram Language on the columns ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["t", "TI"], 
    StyleBox["k", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2cf39c9f-341e-4773-9913-066535f65101"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["t", "TI"], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"\[CapitalPhi]", "/", 
       SubscriptBox["\[CapitalPhi]", 
        StyleBox["max",
         FontSlant->"Plain"]]}], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8c65040c-bfad-4976-b079-fff59b00dae0"],
 ", which keeps the fits with many powers well conditioned) and computes, for \
each method: the minimum ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPhi]", 
    StyleBox["L",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "43d9c200-d019-4ddf-97a3-ccf9a71a067d"],
 " of the fitted polynomial, its value and its second derivative there; the \
largest residual of the fits ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["k", "TI"], "\[LongEqual]", "1"}], 
     StyleBox["K", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["c", "TI"], 
     StyleBox["k", "TI"]], 
    SuperscriptBox["\[CapitalPhi]", 
     RowBox[{"2", 
      StyleBox["k", "TI"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "49e04fba-5742-44c8-b70e-860d1bfb4db9"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["K", "TI"], "\[LongEqual]", "2"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d0d9ef77-3a14-4a6e-9a0e-df1b8b3e9f60"],
 " (the quartic form of the Standard Model) to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["K", "TI"], "\[LongEqual]", "6"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c5e594b0-40f7-4c78-8f3b-d32f4ddfed49"],
 " (powers to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CapitalPhi]", "12"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "357c2d0e-fe92-4d16-a7cb-d0468c3213fc"],
 "); the number of sign changes of the residual of the Landau form; and the \
Landau form fitted on three intervals, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"0", ",", 
     SubsuperscriptBox["\[CapitalPhi]", 
      RowBox[{"0", ",", 
       StyleBox["SF",
        FontSlant->"Plain"]}], 
      StyleBox["X", "TI"]]}], "]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c767eb6b-096c-44b8-9f3c-17da51d8c706"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"0", ",", "1.4", 
     SubsuperscriptBox["\[CapitalPhi]", 
      RowBox[{"0", ",", 
       StyleBox["SF",
        FontSlant->"Plain"]}], 
      StyleBox["X", "TI"]]}], "]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "49cfb5de-b326-4bce-93ba-072212e3d34e"],
 " and the whole curve. Every number is compared with that of the Rust \
program, which computes it with Householder reflections; the Python program \
computes it a third time with the singular-value decomposition."
}], "Text",ExpressionUUID->"42f362c2-5c74-4a68-ba7f-70b456a4c219"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"evenFit", "[", 
        RowBox[{"pts", ",", " ", "kk"}], "]"}], ":", " ", 
       RowBox[{
        RowBox[{"the", " ", "least"}], "-", 
        RowBox[{"squares", " ", "fit", " ", "V"}]}]}], " ", "=", " ", 
      RowBox[{"sum_", 
       RowBox[{"{", 
        RowBox[{"k", "=", 
         RowBox[{
          RowBox[{"1", ".."}], "kk"}]}], "}"}], " ", "c_k", " ", 
       RowBox[{"Phi", "^", 
        RowBox[{"(", 
         RowBox[{"2", "k"}], ")"}]}], " ", "to", " ", "the", " ", "points", " ", 
       RowBox[{"{", 
        RowBox[{"Phi", ",", " ", "V"}], "}"}]}]}], ";", " ", 
     RowBox[{"returns", " ", "the", "\n", "   ", "coefficients", " ", 
      RowBox[{"{", 
