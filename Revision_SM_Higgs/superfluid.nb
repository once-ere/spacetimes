Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"gzI1D", "[", 
     RowBox[{"mo", ",", " ", "m", ",", " ", "temp"}], "]"}], ":", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"I1", ",", " ", 
       RowBox[{"dI1", "/", "dT"}], ",", " ", 
       RowBox[{"dI1", "/", "dM"}]}], "}"}], " ", "on", " ", "the", " ", 
     "radial", " ", "nodes", " ", "of", " ", "the", " ", "grid", " ", "of", " ",
      "the", " ", "model", " ", "mo", " ", 
     RowBox[{"(", 
      RowBox[{"temp", " ", ">", " ", "0"}], ")"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"gzI1D", "[", 
      RowBox[{"mo_", ",", " ", "m_", ",", " ", "temp_"}], "]"}], " ", ":=", 
     " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"kr", " ", "=", " ", 
          RowBox[{
           RowBox[{"mo", "[", "\"\<g\>\"", "]"}], "[", "\"\<kr\>\"", "]"}]}], 
         ",", " ", 
         RowBox[{"wr", " ", "=", " ", 
          RowBox[{
           RowBox[{"mo", "[", "\"\<g\>\"", "]"}], "[", "\"\<wr\>\"", "]"}]}], 
         ",", " ", "e", ",", " ", "x"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"e", " ", "=", " ", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{"kr", "^", "2"}], " ", "+", " ", 
           RowBox[{"m", "^", "2"}]}], "]"}]}], ";", " ", 
        RowBox[{"x", " ", "=", " ", 
         RowBox[{"e", "/", 
          RowBox[{"(", 
           RowBox[{"2", " ", "temp"}], ")"}]}]}], ";", "\n", "   ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Total", "[", 
           RowBox[{"wr", " ", 
            RowBox[{"kr", "^", "2"}], " ", 
            RowBox[{
             RowBox[{"Tanh", "[", "x", "]"}], "/", "e"}]}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"Total", "[", 
             RowBox[{"wr", " ", 
              RowBox[{"kr", "^", "2"}], " ", 
              RowBox[{
               RowBox[{"Sech", "[", "x", "]"}], "^", "2"}]}], "]"}]}], "/", 
           RowBox[{"(", 
            RowBox[{"2", " ", 
             RowBox[{"temp", "^", "2"}]}], ")"}]}], ",", " ", 
          RowBox[{"Total", "[", 
           RowBox[{"wr", " ", 
            RowBox[{"kr", "^", "2"}], " ", 
            RowBox[{"(", 
             RowBox[{"m", "/", "e"}], ")"}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"Sech", "[", "x", "]"}], "^", "2"}], "/", 
               RowBox[{"(", 
                RowBox[{"2", " ", "temp", " ", "e"}], ")"}]}], " ", "-", " ", 
              
              RowBox[{
               RowBox[{"Tanh", "[", "x", "]"}], "/", 
               RowBox[{"e", "^", "2"}]}]}], ")"}]}], "]"}]}], "}"}]}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"gzAlphaClosed", "[", "t", "]"}], ":", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"alpha", ",", " ", 
        RowBox[{
         RowBox[{"lambda", "^", "P"}], 
         RowBox[{"(", "T_c", ")"}]}], ",", " ", 
        RowBox[{"M_n", 
         RowBox[{"(", "T_c", ")"}]}]}], "}"}], " ", "in", " ", "closed", " ", 
      "form", " ", "at", " ", "the", " ", "critical", " ", "temperature", " ",
       "of", " ", "the", " ", "notebook"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"gzAlphaClosed", "[", "t_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"mo", " ", "=", " ", 
          RowBox[{"thModel", "[", "t", "]"}]}], ",", " ", 
         RowBox[{"tc", " ", "=", " ", 
          RowBox[{"thTc", "[", "t", "]"}]}], ",", " ", "gs", ",", " ", "gp", ",",
          " ", "mn", ",", " ", "i1", ",", " ", "i1t", ",", " ", "i1m", ",", 
         " ", "i10", ",", " ", "dnt", ",", " ", "dnm", ",", " ", "dmt", ",", 
         " ", "lam", ",", " ", "dlam"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"gs", ",", " ", "gp"}], "}"}], " ", "=", " ", 
         RowBox[{"thCoup", "[", "t", "]"}]}], ";", "\n", "   ", 
        RowBox[{"mn", " ", "=", " ", 
         RowBox[{"thMassN", "[", 
          RowBox[{"t", ",", " ", "tc"}], "]"}]}], ";", "\n", "   ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"i1", ",", " ", "i1t", ",", " ", "i1m"}], "}"}], " ", "=", 
         " ", 
         RowBox[{"gzI1D", "[", 
          RowBox[{"mo", ",", " ", "mn", ",", " ", "tc"}], "]"}]}], ";", "\n", 
        "   ", 
        RowBox[{"dnt", " ", "=", " ", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{"2", "/", 
             RowBox[{"Pi", "^", "2"}]}], ")"}]}], " ", "mn", " ", "i1t"}]}], ";",
         " ", 
        RowBox[{"dnm", " ", "=", " ", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{"2", "/", 
             RowBox[{"Pi", "^", "2"}]}], ")"}]}], " ", 
          RowBox[{"(", 
           RowBox[{"i1", " ", "+", " ", 
            RowBox[{"mn", " ", "i1m"}]}], ")"}]}]}], ";", "\n", "   ", 
        RowBox[{"dmt", " ", "=", " ", 
         RowBox[{"gs", " ", 
          RowBox[{"dnt", "/", 
           RowBox[{"(", 
            RowBox[{"1", " ", "-", " ", 
             RowBox[{"gs", " ", "dnm"}]}], ")"}]}]}]}], ";", "\n", "   ", 
        RowBox[{"lam", " ", "=", " ", 
         RowBox[{"gp", " ", 
          RowBox[{"i1", "/", 
           RowBox[{"Pi", "^", "2"}]}]}]}], ";", " ", 
        RowBox[{"dlam", " ", "=", " ", 
