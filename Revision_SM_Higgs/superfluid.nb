Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"YP2", "-", "1"}], ":", " ", 
     RowBox[{
      RowBox[{"the", " ", "self"}], "-", 
      RowBox[{
      "energies", " ", "are", " ", "the", " ", "derivatives", " ", "of", " ", 
       "the", " ", "energy"}]}], ":", " ", 
     RowBox[{
     "central", " ", "differences", " ", "on", " ", "three", " ", "random", " ",
       "states", " ", "per", " ", "method"}]}], ",", "\n", "   ", 
    RowBox[{"for", " ", "the", " ", "terms", " ", "of", " ", 
     RowBox[{"V", "^", 
      RowBox[{"(", "2", ")"}]}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"G", "^", "S"}], " ", "=", " ", "2.8"}], ",", " ", 
       RowBox[{
        RowBox[{"G", "^", "V"}], " ", "=", " ", "0.8"}], ",", " ", 
       RowBox[{"G", " ", "=", " ", "25.2"}]}], ")"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"dP21", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ts", " ", "=", " ", 
            RowBox[{"terms", "[", 
             RowBox[{
             "m", ",", " ", "2.8", ",", " ", "0.8", ",", " ", "25.2"}], 
             "]"}]}], "}"}], ",", "\n", "     ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Module", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
               "a", ",", " ", "rho", ",", " ", "b", ",", " ", "kap", ",", " ",
                 "dr", ",", " ", "dk", ",", " ", 
                RowBox[{"h", " ", "=", " ", 
                 RowBox[{"10.", "^", 
                  RowBox[{"-", "4"}]}]}], ",", " ", "ep", ",", " ", "em", ",",
                 " ", "n", ",", " ", "p", ",", " ", "pred"}], "}"}], ",", 
              "\n", "       ", 
              RowBox[{
               RowBox[{"a", " ", "=", " ", 
                RowBox[{
                 RowBox[{"RandomVariate", "[", 
                  RowBox[{
                   RowBox[{"NormalDistribution", "[", "]"}], ",", " ", 
                   RowBox[{"{", 
                    RowBox[{"8", ",", " ", "8"}], "}"}]}], "]"}], " ", "+", 
                 " ", 
                 RowBox[{"I", " ", 
                  RowBox[{"RandomVariate", "[", 
                   RowBox[{
                    RowBox[{"NormalDistribution", "[", "]"}], ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"8", ",", " ", "8"}], "}"}]}], "]"}]}]}]}], ";", 
               " ", 
               RowBox[{"rho", " ", "=", " ", 
                RowBox[{"0.05", " ", 
                 RowBox[{"(", 
                  RowBox[{"a", " ", "+", " ", 
                   RowBox[{"ConjugateTranspose", "[", "a", "]"}]}], ")"}]}]}],
                ";", "\n", "       ", 
               RowBox[{"b", " ", "=", " ", 
                RowBox[{
                 RowBox[{"RandomVariate", "[", 
                  RowBox[{
                   RowBox[{"NormalDistribution", "[", "]"}], ",", " ", 
                   RowBox[{"{", 
                    RowBox[{"8", ",", " ", "8"}], "}"}]}], "]"}], " ", "+", 
                 " ", 
                 RowBox[{"I", " ", 
                  RowBox[{"RandomVariate", "[", 
                   RowBox[{
                    RowBox[{"NormalDistribution", "[", "]"}], ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"8", ",", " ", "8"}], "}"}]}], "]"}]}]}]}], ";", 
               " ", 
               RowBox[{"kap", " ", "=", " ", 
                RowBox[{"0.05", " ", 
                 RowBox[{"(", 
                  RowBox[{"b", " ", "-", " ", 
                   RowBox[{"Transpose", "[", "b", "]"}]}], ")"}]}]}], ";", 
               "\n", "       ", 
               RowBox[{"a", " ", "=", " ", 
                RowBox[{
                 RowBox[{"RandomVariate", "[", 
                  RowBox[{
                   RowBox[{"NormalDistribution", "[", "]"}], ",", " ", 
                   RowBox[{"{", 
                    RowBox[{"8", ",", " ", "8"}], "}"}]}], "]"}], " ", "+", 
                 " ", 
                 RowBox[{"I", " ", 
                  RowBox[{"RandomVariate", "[", 
                   RowBox[{
                    RowBox[{"NormalDistribution", "[", "]"}], ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"8", ",", " ", "8"}], "}"}]}], "]"}]}]}]}], ";", 
               " ", 
               RowBox[{"dr", " ", "=", " ", 
                RowBox[{"a", " ", "+", " ", 
                 RowBox[{"ConjugateTranspose", "[", "a", "]"}]}]}], ";", "\n",
                "       ", 
               RowBox[{"b", " ", "=", " ", 
                RowBox[{
                 RowBox[{"RandomVariate", "[", 
                  RowBox[{
                   RowBox[{"NormalDistribution", "[", "]"}], ",", " ", 
                   RowBox[{"{", 
                    RowBox[{"8", ",", " ", "8"}], "}"}]}], "]"}], " ", "+", 
                 " ", 
                 RowBox[{"I", " ", 
                  RowBox[{"RandomVariate", "[", 
                   RowBox[{
                    RowBox[{"NormalDistribution", "[", "]"}], ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"8", ",", " ", "8"}], "}"}]}], "]"}]}]}]}], ";", 
               " ", 
               RowBox[{"dk", " ", "=", " ", 
                RowBox[{"b", " ", "-", " ", 
                 RowBox[{"Transpose", "[", "b", "]"}]}]}], ";", "\n", 
               "       ", 
               RowBox[{"ep", " ", "=", " ", 
                RowBox[{
                 RowBox[{"interaction", "[", 
                  RowBox[{"ts", ",", " ", 
                   RowBox[{"rho", " ", "+", " ", 
                    RowBox[{"h", " ", "dr"}]}], ",", " ", 
                   RowBox[{"kap", " ", "+", " ", 
                    RowBox[{"h", " ", "dk"}]}]}], "]"}], "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", "       ", 
               RowBox[{"em", " ", "=", " ", 
                RowBox[{
                 RowBox[{"interaction", "[", 
                  RowBox[{"ts", ",", " ", 
                   RowBox[{"rho", " ", "-", " ", 
                    RowBox[{"h", " ", "dr"}]}], ",", " ", 
                   RowBox[{"kap", " ", "-", " ", 
                    RowBox[{"h", " ", "dk"}]}]}], "]"}], "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", "       ", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"n", ",", " ", "p"}], "}"}], " ", "=", " ", 
                RowBox[{"Rest", "[", 
                 RowBox[{"interaction", "[", 
                  RowBox[{"ts", ",", " ", "rho", ",", " ", "kap"}], "]"}], 
                 "]"}]}], ";", "\n", "       ", 
               RowBox[{"pred", " ", "=", " ", 
                RowBox[{
                 RowBox[{"Re", "[", 
                  RowBox[{"Tr", "[", 
                   RowBox[{"n", " ", ".", " ", "dr"}], "]"}], "]"}], " ", "-",
                  " ", 
                 RowBox[{"Re", "[", 
                  RowBox[{"Tr", "[", 
                   RowBox[{"p", " ", ".", " ", 
                    RowBox[{"ConjugateTranspose", "[", "dk", "]"}]}], "]"}], 
                  "]"}]}]}], ";", "\n", "       ", 
               RowBox[{
                RowBox[{"Abs", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"ep", " ", "-", " ", "em"}], ")"}], "/", 
                   RowBox[{"(", 
                    RowBox[{"2", " ", "h"}], ")"}]}], " ", "-", " ", "pred"}],
                  "]"}], "/", 
                RowBox[{"(", 
                 RowBox[{"1", " ", "+", " ", 
                  RowBox[{"Abs", "[", "pred", "]"}]}], ")"}]}]}]}], "]"}], ",",
             " ", 
            RowBox[{"{", "3", "}"}]}], "]"}]}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"m", ",", " ", "methodsSF"}], "}"}]}], "]"}], "]"}]}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WP2-1\>\"", ",", 
      " ", "\"\<self-energies = derivatives of the energy, V^(2), five \
methods, random states\>\"", ",", " ", "dP21", ",", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "8"}]}], ",", " ", "\"\<P2-1a\>\"", ",", 
      " ", "\"\<YP2-1\>\""}], "]"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"YP2", "-", "2"}], ":", " ", 
      RowBox[{
      "the", " ", "pairing", " ", "term", " ", "alone", " ", "on", " ", "48", 
       " ", "radial", " ", "nodes", " ", "reproduces", " ", "AS3"}], ":", " ", 
      RowBox[{"|", 
       RowBox[{"d", "^", "3"}], "|"}]}], " ", "=", " ", "0.2094933033"}], " ",
     "*)"}], "\n", 
   RowBox[{
    RowBox[{"moAS3", " ", "=", " ", 
     RowBox[{"makeModel", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\"\<p\>\"", ",", " ", 
           RowBox[{"{", 
            RowBox[{"22.5", ",", " ", 
             RowBox[{"k8", "[", "i", "]"}]}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"0.", ",", " ", "0.", ",", " ", "1."}], "}"}], ",", " ", 
           "False"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", "48"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"solAS3", " ", "=", " ", 
     RowBox[{"solveSF", "[", 
      RowBox[{"moAS3", ",", " ", "zero8", ",", " ", 
       RowBox[{"0.3", " ", 
        RowBox[{"ConjugateTranspose", "[", 
         RowBox[{"k8", "[", "3", "]"}], "]"}]}], ",", " ", "1.", ",", " ", 
       RowBox[{"10", "^", 
        RowBox[{"-", "13"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"d3AS3", " ", "=", " ", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"-", "0.5"}], " ", "22.5", " ", 
       RowBox[{"Tr", "[", 
        RowBox[{
         RowBox[{"k8", "[", "3", "]"}], " ", ".", " ", 
         RowBox[{"Transpose", "[", 
          RowBox[{"solAS3", "[", "\"\<kap\>\"", "]"}], "]"}]}], "]"}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WP2-2\>\"", ",", " ", 
      RowBox[{"\"\<pairing-only limit = AS3 of Part I: |d^3| = \>\"", " ", "<>",
        " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"NumberForm", "[", 
         RowBox[{"d3AS3", ",", " ", "11"}], "]"}], "]"}], " ", "<>", 
       " ", "\"\< (\>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"solAS3", "[", "\"\<it\>\"", "]"}], "]"}], " ", "<>", 
       " ", "\"\< iterations)\>\""}], ",", "\n", "  ", 
      RowBox[{"Abs", "[", 
       RowBox[{"d3AS3", " ", "-", " ", "0.2094933033"}], "]"}], ",", " ", 
      RowBox[{"3", " ", 
       RowBox[{"10", "^", 
        RowBox[{"-", "10"}]}]}], ",", " ", "\"\<P2-2a\>\"", ",", 
      " ", "\"\<YP2-2\>\""}], "]"}], ";"}]}]}]], "Input",
 CellLabel->
