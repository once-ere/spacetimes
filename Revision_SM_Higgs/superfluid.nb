         RowBox[{"down", " ", 
          RowBox[{"chi", "'"}]}]}], ")"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"bb", " ", "=", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"m", " ", "=", " ", 
             RowBox[{"ConstantArray", "[", 
              RowBox[{"0", ",", " ", 
               RowBox[{"{", 
                RowBox[{"8", ",", " ", "8"}], "}"}]}], "]"}]}], "}"}], ",", 
           "\n", "      ", 
           RowBox[{
            RowBox[{
             RowBox[{"m", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", " ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"4", " ", "a"}], " ", "+", " ", "1"}], " ", ";;", 
                 " ", 
                 RowBox[{
                  RowBox[{"4", " ", "a"}], " ", "+", " ", "4"}]}]}], "]"}], 
              "]"}], " ", "=", " ", 
             RowBox[{
              RowBox[{"kp", "[", 
               RowBox[{"[", 
                RowBox[{"s", " ", "+", " ", "1"}], "]"}], "]"}], "/", 
              RowBox[{"Sqrt", "[", 
               RowBox[{"Total", "[", 
                RowBox[{
                 RowBox[{"Abs", "[", 
                  RowBox[{"Flatten", "[", 
                   RowBox[{"kp", "[", 
                    RowBox[{"[", 
                    RowBox[{"s", " ", "+", " ", "1"}], "]"}], "]"}], "]"}], 
                  "]"}], "^", "2"}], "]"}], "]"}]}]}], ";", " ", 
            RowBox[{"Flatten", "[", "m", "]"}]}]}], "]"}], ",", "\n", "     ", 
         RowBox[{"{", 
          RowBox[{"s", ",", " ", "0", ",", " ", "1"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"a", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}], ",", 
       " ", "1"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"bg", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"gOn", "[", 
        RowBox[{
         RowBox[{"csectors", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", " ", "bb", ",", " ", "#"}], 
        "]"}], " ", "&"}], " ", "/@", " ", "gensAll"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ok8c", " ", "=", " ", 
     RowBox[{
      RowBox[{"And", " ", "@@", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"bg", "[", 
            RowBox[{"[", "a", "]"}], "]"}], " ", "==", " ", 
           RowBox[{"KroneckerProduct", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"sig", "[", "a", "]"}], "/", "2"}], ",", " ", "i2"}], 
            "]"}]}], " ", "&&", " ", 
          RowBox[{
           RowBox[{"bg", "[", 
            RowBox[{"[", 
             RowBox[{"iTR", "[", 
              RowBox[{"[", "a", "]"}], "]"}], "]"}], "]"}], " ", "==", " ", 
           RowBox[{"KroneckerProduct", "[", 
            RowBox[{"i2", ",", " ", 
             RowBox[{
              RowBox[{"sig", "[", "a", "]"}], "/", "2"}]}], "]"}]}]}], ",", 
         "\n", "    ", 
         RowBox[{"{", 
          RowBox[{"a", ",", " ", "3"}], "}"}]}], "]"}]}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"bg", "[", 
        RowBox[{"[", "iY", "]"}], "]"}], " ", "==", " ", 
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"i2", ",", " ", 
         RowBox[{
          RowBox[{"sig", "[", "3", "]"}], "/", "2"}]}], "]"}]}], " ", "&&", 
      " ", 
      RowBox[{
       RowBox[{"bg", "[", 
        RowBox[{"[", "iF", "]"}], "]"}], " ", "==", " ", 
       RowBox[{"2", " ", "i4"}]}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"bg", "[", 
        RowBox[{"[", "iR", "]"}], "]"}], " ", "==", " ", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0", ",", " ", 
         RowBox[{"{", 
          RowBox[{"4", ",", " ", "4"}], "}"}]}], "]"}]}], " ", "&&", "\n", 
      "  ", 
      RowBox[{"closed", "[", 
       RowBox[{
        RowBox[{"csectors", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", " ", "bb", ",", " ", 
        "gensAll"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rvCheck", "[", 
     RowBox[{"\"\<WQN-8\>\"", ",", 
      " ", "\"\<on Phi_SH: tau^a/2, Y = 1/2, Q = diag(1, 0); on Phi'_SH: \
tau^a/2, Y = -1/2, Q = diag(0, -1); F_tot = 2, \\\nR = 0, T^3_R = +-1/2, \
Casimir 3/4, closure; i tau^2 Phi'^* has tau^a/2 and Y = 1/2; the bidoublet \
has (tau^a/2) (x) 1 \\\nand 1 (x) (tau^a/2): M_SH -> L M_SH R^T\>\"", ",", 
      " ", 
      RowBox[{"ok8a", " ", "&&", " ", "ok8b", " ", "&&", " ", "ok8c"}], ",", 
      "\n", "  ", 
      RowBox[{"\"\<G_Y = \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{
         RowBox[{"hg", "[", 
          RowBox[{"[", "iY", "]"}], "]"}], ",", " ", "InputForm"}], "]"}], 
       " ", "<>", " ", "\"\< and \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{
         RowBox[{"hg2", "[", 
          RowBox[{"[", "iY", "]"}], "]"}], ",", " ", "InputForm"}], "]"}]}]}],
      "]"}], ";"}]}]}]], "Input",
 CellLabel->
  "In[485]:=",ExpressionUUID->"90bbda70-8507-43de-82fc-32f3b771b8c5"],

