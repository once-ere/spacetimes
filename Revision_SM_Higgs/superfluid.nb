        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "172fbbc3-3dd7-4dbd-ac0f-6e00aed03279"],
 "; the chemical potential of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["T", "TI"], 
    RowBox[{"3", ",", 
     StyleBox["SM",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f1d1086b-9d5b-4d6d-84f6-8cc60bcf4152"],
 " gives ",
