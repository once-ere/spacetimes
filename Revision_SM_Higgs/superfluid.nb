Cell[CellGroupData[{

Cell["III.G.5 The gradient coefficient and the regularization", "Section",ExpressionUUID->"fcebca21-28fe-4da0-83b3-06f0846d864e"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["c",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ac400a6d-5b97-42b9-8655-0afcefc8c8e4"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"[", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["a", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["Tay",
         FontSlant->"Plain"]}]], 
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox[
         StyleBox["q", "TI"], 
         StyleBox["SF",
          FontSlant->"Plain"], 
         StyleBox["pair",
          FontSlant->"Plain"]], ";", 
        SubsuperscriptBox[
         StyleBox["T", "TI"], 
         StyleBox["SF",
          FontSlant->"Plain"], 
         RowBox[{
          StyleBox["X", "TI"], ",", 
          StyleBox["c",
           FontSlant->"Plain"]}]]}], ")"}], "-", 
      SubsuperscriptBox[
       StyleBox["a", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["Tay",
         FontSlant->"Plain"]}]], 
      RowBox[{"(", 
       RowBox[{"0", ";", 
        SubsuperscriptBox[
         StyleBox["T", "TI"], 
         StyleBox["SF",
          FontSlant->"Plain"], 
         RowBox[{
          StyleBox["X", "TI"], ",", 
          StyleBox["c",
           FontSlant->"Plain"]}]]}], ")"}]}], "]"}], "/", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["pair",
        FontSlant->"Plain"]], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4f2bd5ea-75a5-4417-960a-941b2d7f8946"],
 " at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["pair",
      FontSlant->"Plain"]], "\[LongEqual]", "0.01"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "447bbb0b-a6f1-4b24-8df0-cf442f7c7bc7"],
 " and ",
 Cell[BoxData[
  FormBox["0.02", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e537bac9-7191-49e7-917f-21937c21a16d"],
 " with the Richardson extrapolation. The six directions of the grid are \
exact at second order in the twist (the term of second order is a quadratic \
polynomial in the direction). ",
 StyleBox["The regularization (a remark: what it means and why it matters).",
  FontWeight->"Bold"],
 " The model has the cutoff ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox[
      StyleBox["q", "TI"], "\[RightVector]"], "\[RightBracketingBar]"}], "<", 
    
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a63449a1-9d0d-4324-b6ab-dd8ec57ce8b1"],
 " on the momenta of the uniform states, and for a moving pair it must be put \
on one of two momenta. With the cutoff on the momenta of the two charges of \
the pair, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftBracketingBar]", 
     RowBox[{
      OverscriptBox[
       StyleBox["q", "TI"], "\[RightVector]"], "\[PlusMinus]", 
      FractionBox["1", "2"], 
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["pair",
        FontSlant->"Plain"]], 
      SubscriptBox[
       OverscriptBox[
        StyleBox["e", "TI"], "\[RightVector]"], "3"]}], 
     "\[RightBracketingBar]"}], "<", 
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0454f6f6-946a-4284-869c-d67c4719a268"],
 " (a lens of two spheres), a moving pair loses the pairs in a shell at the \
cutoff whose thickness is of order ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftBracketingBar]", 
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["pair",
      FontSlant->"Plain"]], "\[RightBracketingBar]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1d8a4f2d-7ca9-4f6e-b318-5202e14239a0"],
 ", so that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], 
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["q", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      StyleBox["pair",
       FontSlant->"Plain"]], ")"}], "-", 
    StyleBox["a", "TI"], 
    RowBox[{"(", "0", ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9cabcf1d-282c-48af-9689-25d72d48b046"],
 " is linear in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftBracketingBar]", 
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["pair",
      FontSlant->"Plain"]], "\[RightBracketingBar]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8994ac2f-5dfb-459e-b775-ae3cdf8212ad"],
 " and a gradient expansion does not exist. With the cutoff on the relative \
momentum, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox[
      StyleBox["q", "TI"], "\[RightVector]"], "\[RightBracketingBar]"}], "<", 
    
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4f1bcb7d-11c5-4e78-ad2c-a263ce22b7b3"],
 ", the change is quadratic; this routing is used here (it is the routing of \
the twisted states of the coefficients of the kinetic part at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "44f521ef-7354-447d-858d-0aa5bd7d5927"],
 ", where the uniform twist shifts the momenta inside the fixed sphere). The \
remaining error of the regularization is measured by the twist ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["q", "TI"], "\[ThinSpace]", 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], "3"], "\[CircleTimes]", 
    FractionBox["1", "2"], 
    SubscriptBox["\[Tau]", "3"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "93a7644a-5502-4fd9-831b-61469b1bfd50"],
 " of the unbroken generator ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2b39ccbd-0885-46f2-becf-aec3f7fc8bec"],
 ", which does not change the field along ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox[
     StyleBox["e", "TI"], "\[RightVector]"], "3"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bf0e8399-fe0a-48fd-95b2-35933a03a372"],
 " and would cost nothing in a gauge-invariant theory; with the cutoff it \
costs the spurious coefficient ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["c",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     RowBox[{
      StyleBox["T",
       FontSlant->"Plain"], "\[InvisibleSpace]", "3"}]}]], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6d0e0257-db99-4b75-8637-0fe2e9c4bc0a"],
 ", about a fifth of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["c",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e61d9b1a-272b-4610-84ad-99dfd69f4695"],
 " (the Rust table). This matters for the size of the Ginzburg number, which \
is proportional to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SuperscriptBox[
     StyleBox["c",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "3"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "edd77546-b6df-4b00-bf7b-d1f672ceb494"],
 ": changing ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["c",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "12f814b1-8637-4237-961c-79690f54dca0"],
 " by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    SubsuperscriptBox[
     StyleBox["c",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      RowBox[{
       StyleBox["T",
        FontSlant->"Plain"], "\[InvisibleSpace]", "3"}]}]]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "74c72310-7dfb-4d62-a642-f6ea2b0d6a40"],
 " changes it by a factor of about 2 either way (Section III.G.7), not enough \
to change the conclusion. The next cells compute the gradient coefficient \
from the phase twist and from the isospin twist, check that it does not \
depend on the quadrature (for CJT: 40 radial nodes, and a product rule of 144 \
directions), and compare the two regularizations on a product rule: 24 \
Gauss-Legendre nodes in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["cos",
     FontSlant->"Plain"], "\[ThinSpace]", "\[Theta]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e6846dab-859b-4b24-ac54-60086d8b997f"],
 " (12 on each half), 6 angles ",
 Cell[BoxData[
  FormBox["\[CurlyPhi]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4a444886-0d58-47bb-ab60-3fdf720c1554"],
 " and 24 radial nodes on ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"0", ",", 
     StyleBox["r", "TI"], 
     RowBox[{"(", 
      OverscriptBox[
       StyleBox["n", "TI"], "\[RightVector]"], ")"}]}], "]"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "593be35e-0fcd-498e-ba11-0a34cc24ebe6"],
 " in the direction ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["n", "TI"], "\[RightVector]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3a0393c5-df1a-4414-9be7-b63637759b3e"],
 ", with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r", "TI"], "\[LongEqual]", 
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0204f0ec-3062-4e34-a035-63bc3daa1bd5"],
 " for the sphere and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r", "TI"], 
    RowBox[{"(", 
     OverscriptBox[
      StyleBox["n", "TI"], "\[RightVector]"], ")"}], "\[LongEqual]", 
    RowBox[{"-", 
     FractionBox["1", "2"]}], 
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["pair",
      FontSlant->"Plain"]], 
    RowBox[{"\[LeftBracketingBar]", 
     SubscriptBox[
      StyleBox["n", "TI"], "3"], "\[RightBracketingBar]"}], "+", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox["\[CapitalLambda]", 
        StyleBox["LL",
         FontSlant->"Plain"], "2"], "-", 
       FractionBox["1", "4"], 
       SuperscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox[
          StyleBox["q", "TI"], 
          StyleBox["SF",
           FontSlant->"Plain"], 
          StyleBox["pair",
           FontSlant->"Plain"]], ")"}], "2"], 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         SubsuperscriptBox[
          StyleBox["n", "TI"], "3", "2"]}], ")"}]}], ")"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "af4e3e22-085f-40f4-8b21-062a3ffaeecb"],
 " for the lens."
}], "Text",ExpressionUUID->"4c2d2dff-e898-446c-ba3e-daef6e6f7ae7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"gzGrad", "[", 
      RowBox[{
      "t", ",", " ", "t2", ",", " ", "s", ",", " ", "relax", ",", " ", 
       "nodes"}], "]"}], ":", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"c", ",", " ", 
        RowBox[{"c", 
         RowBox[{"(", "0.01", ")"}]}], ",", " ", 
        RowBox[{"c", 
         RowBox[{"(", "0.02", ")"}]}]}], "}"}], " ", "at", " ", "T_c", " ", 
      "from", " ", "the", " ", "twist", " ", "of", " ", "the", " ", "isospin",
       " ", "matrix", " ", "t2"}]}], ",", " ", 
    RowBox[{
     RowBox[{"twist", " ", "strength", "\n", "   ", "q"}], " ", "=", " ", 
     RowBox[{
      RowBox[{"k", "/", "s"}], " ", "for", " ", "the", " ", "pair", " ", 
      "momentum", " ", "k", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"s", " ", "=", " ", 
         RowBox[{"2", " ", "for", " ", "the", " ", "phase", " ", "twist"}]}], 
        ",", " ", 
        RowBox[{"s", " ", "=", " ", 
         RowBox[{
         "1", " ", "for", " ", "the", " ", "isospin", " ", "twists"}]}]}], 
       ")"}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"gzGrad", "[", 
      RowBox[{"t_", ",", " ", "t2_", ",", " ", "s_", ",", " ", 
       RowBox[{"relax_", " ", ":", " ", "True"}], ",", " ", 
       RowBox[{"nodes_", " ", ":", " ", "Automatic"}]}], "]"}], " ", ":=", 
     " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"tc", " ", "=", " ", 
          RowBox[{"thTc", "[", "t", "]"}]}], ",", " ", "a0", ",", " ", "c1", ",",
          " ", "c2"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"a0", " ", "=", " ", 
         RowBox[{
          RowBox[{"gzA", "[", 
           RowBox[{
           "t", ",", " ", "tc", ",", " ", "0.", ",", " ", "t2", ",", " ", 
            "relax", ",", " ", "nodes"}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"c1", " ", "=", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"gzA", "[", 
              RowBox[{"t", ",", " ", "tc", ",", " ", 
               RowBox[{"0.01", "/", "s"}], ",", " ", "t2", ",", " ", "relax", 
               ",", " ", "nodes"}], "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", "a0"}], ")"}], "/", 
          RowBox[{"0.01", "^", "2"}]}]}], ";", "\n", "   ", 
        RowBox[{"c2", " ", "=", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"gzA", "[", 
              RowBox[{"t", ",", " ", "tc", ",", " ", 
               RowBox[{"0.02", "/", "s"}], ",", " ", "t2", ",", " ", "relax", 
               ",", " ", "nodes"}], "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", "a0"}], ")"}], "/", 
          RowBox[{"0.02", "^", "2"}]}]}], ";", "\n", "   ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"4", " ", "c1"}], " ", "-", " ", "c2"}], ")"}], "/", 
           "3"}], ",", " ", "c1", ",", " ", "c2"}], "}"}]}]}], "]"}]}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"c", ",", " ", "c1", ",", " ", "c2", ",", " ", "cIso"}], 
         "}"}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"c", ",", " ", "c1", ",", " ", "c2"}], "}"}], " ", "=", 
          " ", 
          RowBox[{"gzGrad", "[", 
           RowBox[{"t", ",", " ", 
            RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", " ", "2."}], 
           "]"}]}], ";", "\n", "   ", 
         RowBox[{"cIso", " ", "=", " ", 
          RowBox[{
           RowBox[{"gzGrad", "[", 
            RowBox[{"t", ",", " ", 
             RowBox[{
              RowBox[{"PauliMatrix", "[", "1", "]"}], "/", "2"}], ",", " ", 
             "1."}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{"\"\<WP3-G5 \>\"", " ", "<>", " ", "t"}], ",", " ", 
           RowBox[{
            RowBox[{"thName", "[", "t", "]"}], " ", "<>", 
            " ", "\"\<: the isospin twist gives the gradient coefficient of \
the phase twist, c = \>\"", " ", "<>", " ", 
            RowBox[{"ToString", "[", 
             RowBox[{"NumberForm", "[", 
              RowBox[{"c", ",", " ", "10"}], "]"}], "]"}], " ", "<>", 
            " ", "\"\< (isospin invariance; relative difference)\>\""}], ",", 
           "\n", "    ", 
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"cIso", "/", "c"}], " ", "-", " ", "1"}], "]"}], ",", 
           " ", 
           RowBox[{"10", "^", 
            RowBox[{"-", "8"}]}], ",", " ", 
           RowBox[{"\"\<P3-G5 \>\"", " ", "<>", " ", "t"}], ",", " ", 
           RowBox[{"\"\<YP3-G5 \>\"", " ", "<>", " ", "t"}]}], "]"}], ";", 
         "\n", "   ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{"\"\<WP3-G6 \>\"", " ", "<>", " ", "t"}], ",", " ", 
           RowBox[{
            RowBox[{"thName", "[", "t", "]"}], " ", "<>", 
            " ", "\"\<: c > 0 and the extrapolation in k converges: c(0.01) = \
\>\"", " ", "<>", " ", 
            RowBox[{"ToString", "[", 
             RowBox[{"NumberForm", "[", 
              RowBox[{"c1", ",", " ", "10"}], "]"}], "]"}], " ", "<>", 
            " ", "\"\<, c(0.02) = \>\"", " ", "<>", " ", 
            RowBox[{"ToString", "[", 
             RowBox[{"NumberForm", "[", 
              RowBox[{"c2", ",", " ", "10"}], "]"}], "]"}], " ", "<>", 
            " ", "\"\<, extrapolated \>\"", " ", "<>", " ", 
            RowBox[{"ToString", "[", 
             RowBox[{"NumberForm", "[", 
              RowBox[{"c", ",", " ", "10"}], "]"}], "]"}], " ", "<>", 
            " ", "\"\< = Rust (relative difference; 1 is added if c <= 0 or \
the two values differ by more than 1e-3 of c)\>\""}], ",", "\n", "    ", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"c", " ", "-", " ", 
               RowBox[{"gzRust", "[", 
                RowBox[{"t", ",", " ", "\"\<c\>\""}], "]"}]}], "]"}], "/", 
             RowBox[{"gzRust", "[", 
              RowBox[{"t", ",", " ", "\"\<c\>\""}], "]"}]}], " ", "+", " ", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"c", " ", ">", " ", "0"}], " ", "&&", " ", 
               RowBox[{
                RowBox[{
                 RowBox[{"Abs", "[", 
                  RowBox[{"c2", " ", "-", " ", "c1"}], "]"}], "/", "c"}], " ",
                 "<", " ", 
                RowBox[{"10", "^", 
                 RowBox[{"-", "3"}]}]}]}], ",", " ", "0", ",", " ", "1"}], 
             "]"}]}], ",", " ", 
           RowBox[{"10", "^", 
            RowBox[{"-", "8"}]}], ",", " ", 
           RowBox[{"\"\<P3-G6 \>\"", " ", "<>", " ", "t"}], ",", " ", 
           RowBox[{"\"\<YP3-G6 \>\"", " ", "<>", " ", "t"}]}], "]"}], ";", 
         "\n", "   ", 
         RowBox[{
          RowBox[{"gzResults", "[", "t", "]"}], " ", "=", " ", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"gzResults", "[", "t", "]"}], ",", " ", 
            RowBox[{"<|", 
             RowBox[{"\"\<c\>\"", " ", "->", " ", "c"}], "|>"}]}], 
           "]"}]}]}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"t", ",", " ", "thTags"}], "}"}]}], "]"}], ";"}]}]}]], "Input",\

