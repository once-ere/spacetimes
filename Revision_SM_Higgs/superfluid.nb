         RowBox[{"{", 
          RowBox[{"0", ",", " ", 
           RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"hg", "[", 
        RowBox[{"[", "iF", "]"}], "]"}], " ", "==", " ", 
       RowBox[{"2", " ", "i2"}]}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"hg2", "[", 
