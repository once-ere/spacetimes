Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"the first pair has equal charges: \"\>", "\[InvisibleSpace]", 
   "True", "\[InvisibleSpace]", "\<\"; the second: \"\>", "\[InvisibleSpace]",
    "True"}],
  SequenceForm[
  "the first pair has equal charges: ", True, "; the second: ", True],
  Editable->False]], "Print",
 CellChangeTimes->{4.0043309401466722`*^9},
