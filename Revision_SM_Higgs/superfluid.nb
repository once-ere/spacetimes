    RowBox[{
     RowBox[{"generic", "[", "n_", "]"}], " ", ":=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"j", " ", "+", " ", "1"}], ")"}], " ", "+", " ", 
        RowBox[{"I", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", " ", "j"}], " ", "-", " ", "1"}], ")"}]}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "n"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"res11", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"w", " ", "=", " ", 
            RowBox[{"generic", "[", 
             RowBox[{"ch", "[", "\"\<dim\>\"", "]"}], "]"}]}], ",", " ", "st",
            ",", " ", "nz", ",", " ", "stn", ",", " ", "allNeutral", ",", " ", 
           RowBox[{"g4", " ", "=", " ", 
            RowBox[{
             RowBox[{"ch", "[", "\"\<lx\>\"", "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"1", " ", ";;", " ", "4"}], "]"}], "]"}]}]}], "}"}], ",",
          "\n", "    ", 
         RowBox[{
          RowBox[{"st", " ", "=", " ", 
           RowBox[{"stab", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"hg", "[", 
                 RowBox[{"[", 
                  RowBox[{"1", " ", ";;", " ", "4"}], "]"}], "]"}], ",", " ", 
                "phi0"}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"hg2", "[", 
