      " ", 
     RowBox[{"every", " ", "field", " ", "a", " ", "string"}], ",", " ", 
     RowBox[{
     "taken", " ", "from", " ", "the", " ", "data", " ", "cell", "\n", "   ", 
      "below", " ", 
      RowBox[{"(", 
       RowBox[{"the", " ", "notebook", " ", "reads", " ", "no", " ", "file"}],
        ")"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"readTable", "[", "file_String", "]"}], " ", ":=", " ", 
     RowBox[{"rvData", "[", "file", "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"num", "[", "s", "]"}], ":", " ", 
      RowBox[{
      "a", " ", "number", " ", "as", " ", "the", " ", "Rust", " ", "programs",
        " ", "write", " ", "it", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2.5", "e"}], "-", 
         RowBox[{"3", " ", "for", " ", "2.5", " ", 
          RowBox[{"10", "^", 
           RowBox[{"-", "3"}]}]}]}], ")"}]}]}], ",", " ", 
     RowBox[{"read", " ", "with", " ", "all", " ", "its", " ", "digits"}]}], 
    " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"num", "[", "s_String", "]"}], " ", ":=", " ", 
     RowBox[{"ToExpression", "[", 
      RowBox[{"StringReplace", "[", 
       RowBox[{"s", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<e\>\"", " ", "->", " ", "\"\<*^\>\""}], "}"}]}], "]"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"num", "[", 
      RowBox[{"x_", "?", "NumericQ"}], "]"}], " ", ":=", " ", "x"}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"col", "[", 
      RowBox[{"h", ",", " ", "name"}], "]"}], ":", " ", 
     RowBox[{
     "the", " ", "position", " ", "of", " ", "the", " ", "column", " ", 
      "name", " ", "in", " ", "the", " ", "header", " ", "h", " ", "of", " ", 
      "a", " ", "table"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"col", "[", 
      RowBox[{"h_", ",", " ", "n_"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"Position", "[", 
       RowBox[{"h", ",", " ", "n"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", " ", "1"}], "]"}], "]"}]}], ";"}]}]}]], "Input",
 CellLabel->
  "In[407]:=",ExpressionUUID->"2163c175-0af2-455f-b63a-4806eaa1e5cf"],

