Cell[CellGroupData[{

Cell["R.1.12 The masses of the gauge bosons (check WQN-12)", "Subsection",ExpressionUUID->"3ee2cd90-91e9-4570-b910-9dbe5fcb7220"],

Cell[TextData[{
 "With the gauge fields ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["W", "TI"], "\[Mu]", "1"], ",", 
     SubsuperscriptBox[
      StyleBox["W", "TI"], "\[Mu]", "2"], ",", 
     SubsuperscriptBox[
      StyleBox["W", "TI"], "\[Mu]", "3"], ",", 
     SubscriptBox[
      StyleBox["B", "TI"], "\[Mu]"]}], ")"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e7df16ff-a3ac-4361-ac0f-9d7671d3a88e"],
 " and the couplings ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["g", "TI"], ",", 
     StyleBox["g", "TI"], ",", 
     StyleBox["g", "TI"], ",", 
     SuperscriptBox[
      StyleBox["g", "TI"], "\[Prime]"]}], ")"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8340c3a1-6c9e-44a9-aeb5-d0d38e9e1c7d"],
 ", the kinetic terms of the two pair fields give the mass matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["a", "TI"]], 
    SubscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["b", "TI"]], "\[ThinSpace]", 
    StyleBox["Re",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["\[CapitalPhi]", "\[Dagger]"], 
      RowBox[{"{", 
       RowBox[{
        SubscriptBox[
         StyleBox["G", "TI"], 
         StyleBox["a", "TI"]], ",", 
        SubscriptBox[
         StyleBox["G", "TI"], 
         StyleBox["b", "TI"]]}], "}"}], "\[CapitalPhi]", "+", 
      SuperscriptBox["\[CapitalPhi]", 
       RowBox[{"\[Prime]", "\[Dagger]"}]], 
      RowBox[{"{", 
       RowBox[{
        SubsuperscriptBox[
         StyleBox["G", "TI"], 
         StyleBox["a", "TI"], "\[Prime]"], ",", 
        SubsuperscriptBox[
         StyleBox["G", "TI"], 
         StyleBox["b", "TI"], "\[Prime]"]}], "}"}], 
      SuperscriptBox["\[CapitalPhi]", "\[Prime]"]}], ")"}]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "104aa7d2-48ae-4f5e-bac2-887d8e605a23"],
 " at the vacuum ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPhi]", 
     StyleBox["SH",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{"0", ",", "\[Phi]"}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4702ec5b-0bc7-4dba-92b6-10f939905ee5"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalPhi]", 
     StyleBox["SH",
      FontSlant->"Plain"], "\[Prime]"], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["\[Phi]", "\[Prime]"], ",", "0"}], ")"}]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dc0b3b90-d4c4-4e13-bfc6-556c88aa4038"],
 ". Its eigenvalues are ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dbcc1c62-a98c-4887-8dd7-e4011f9b6264"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["g", "TI"], "2"], 
    SubsuperscriptBox[
     StyleBox["v", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], "2"], "/", "4"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b17c4b71-f96b-43ee-af2b-d8d99b2b3d11"],
 " (twice) and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       StyleBox["g", "TI"], "2"], "+", 
      SuperscriptBox[
       StyleBox["g", "TI"], 
       RowBox[{"\[Prime]", "2"}]]}], ")"}], 
    SubsuperscriptBox[
     StyleBox["v", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], "2"], "/", "4"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dbcb2309-af47-4128-b366-a41360525ab0"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["v", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], "2"], "\[LongEqual]", "2", 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["\[Phi]", "2"], "+", 
      SuperscriptBox["\[Phi]", 
       RowBox[{"\[Prime]", "2"}]]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0b3f3115-6461-4110-962c-352c3bc88df0"],
 ", for any lengths ",
 Cell[BoxData[
  FormBox["\[Phi]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ecf2f46d-aa91-4ef2-ba63-af34771a056d"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Phi]", "\[Prime]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4064455f-d1fc-4bf4-ba7e-934e1f3c8c36"],
 "; the massless vector lies along ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "0", ",", 
     SuperscriptBox[
      StyleBox["g", "TI"], "\[Prime]"], ",", 
     StyleBox["g", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3c32b98c-e6d1-4df2-9724-2fb2a482f51c"],
 ", the photon ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["A", "TI"], "\[Mu]"], "\[LongEqual]", 
    StyleBox["sin",
     FontSlant->"Plain"], "\[ThinSpace]", 
    SubscriptBox["\[Theta]", 
     StyleBox["W", "TI"]], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["W", "TI"], "\[Mu]", "3"], "+", 
    StyleBox["cos",
     FontSlant->"Plain"], "\[ThinSpace]", 
    SubscriptBox["\[Theta]", 
     StyleBox["W", "TI"]], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["B", "TI"], "\[Mu]"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "eb4fe0ab-4e0c-421a-8984-1dd01a9e2fec"],
 "; and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["W", "TI"], "2"], "/", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["Z", "TI"], "2"], "\[ThinSpace]", 
      SuperscriptBox[
       StyleBox["cos",
        FontSlant->"Plain"], "2"], "\[ThinSpace]", 
      SubscriptBox["\[Theta]", 
       StyleBox["W", "TI"]]}], ")"}], "\[LongEqual]", "1"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7a73784d-38ff-4091-971f-1045e98b5eee"],
 ". The couplings, the lengths and therefore the whole statement are symbolic."
}], "Text",ExpressionUUID->"715284aa-fda3-4891-8512-2ceb6814ddc6"],

