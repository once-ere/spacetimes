   "\[InvisibleSpace]", "\<\", Python \"\>", 
   "\[InvisibleSpace]", "\<\"F-3b\"\>", "\[InvisibleSpace]", "\<\"]\"\>"}],
  SequenceForm[
  "PASS ", "WF-3b", "  deviation ", "8.951e-16", " (tolerance ", "1.000e-10", 
   "): ", "S^dag gamma^0 S = gamma^0 (200 random g)", 
   "   [the same check: Rust ", "F-3b", ", Python ", "F-3b", "]"],
  Editable->False]], "Print",
 CellChangeTimes->{4.004331353065336*^9},
 CellLabel->
