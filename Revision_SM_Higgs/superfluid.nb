Cell[CellGroupData[{

Cell["\<\
R.2.6 Remark R10: the current response of the normal vacuum is an artifact of \
the sharp cutoff\
\>", "Subsection",ExpressionUUID->"018421b5-f6e8-4ed9-8611-9fb16576622c"],

Cell[TextData[{
 StyleBox["The remark.",
  FontWeight->"Bold"],
 " With the sharp momentum cutoff the normal vacuum of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bb6c1b0d-38a4-47de-881c-41b49708b3b5"],
 " answers a uniform vector potential with a current. Add the uniform term ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["\[ScriptCapitalA]",
     FontSlant->"Plain"], "\[ThinSpace]", 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], "3"], "\[CircleTimes]", 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b0fccfc7-0a88-423a-b083-773108ef535d"],
 " to the Hamiltonian of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e3c8ab59-72e5-4a81-acf8-f47283e1062e"],
 ": it shifts the momentum of every state by ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[ScriptCapitalA]",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d1b10765-8af3-490a-8639-5f6c6a6f2baa"],
 " along the third axis. Without a cutoff this is a change of variables, and \
the current of the filled Dirac sea does not change. With the cutoff ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox[
      StyleBox["q", "TI"], "\[RightVector]"], "\[RightBracketingBar]"}], "<", 
    
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "131ac418-acd8-472c-bfa2-232e4ead1c5f"],
 " the shifted ball loses states on one side of its surface and gains them on \
the other, and the current ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox["\[Alpha]", 
         StyleBox["LL",
          FontSlant->"Plain"], "3"], "\[CircleTimes]", 
        SubscriptBox[
         StyleBox["1",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], "2"]}], ")"}], 
      SubscriptBox["\[CurlyRho]", 
       StyleBox["SH",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "130c7657-df52-4737-9ed2-1fc3651d7d29"],
 " changes by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     SubsuperscriptBox["\[Chi]", 
      StyleBox["SH",
       FontSlant->"Plain"], 
      StyleBox["J",
       FontSlant->"Plain"]]}], 
    StyleBox["\[ScriptCapitalA]",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7732a200-1de1-4252-8ca2-a51bd71081b8"],
 ", a surface term. Each of the four states of negative energy at the \
momentum ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["q", "TI"], "\[RightVector]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "79415598-bcdc-4c10-891b-ab076d06ac15"],
 " (two of spin, two of isospin) carries the current ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     SuperscriptBox[
      StyleBox["q", "TI"], "3"]}], "/", 
    SubscriptBox["\[CurlyEpsilon]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "547208f7-b2dd-45d0-8c95-3fe2e2d329d8"],
 " along the axis, the derivative of its energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SubscriptBox["\[CurlyEpsilon]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e6d017b2-ebdc-48cc-9533-7fbf55f28256"],
 " by ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["q", "TI"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7bd1f61a-b658-4ae8-9cb0-7b321661a6f1"],
 "; the shift moves the ball by ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[ScriptCapitalA]",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b1ed3b9d-0d39-4eda-9ed3-7ce4c7c71448"],
 ", and by the theorem of Gauss the change of the current at first order is \
an integral over its surface, which gives"
}], "Text",ExpressionUUID->"9193c05c-bdcd-4892-908f-f0a31cc2510b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["\[Chi]", 
    StyleBox["SH",
     FontSlant->"Plain"], 
    StyleBox["J",
     FontSlant->"Plain"]], "\[LongEqual]", 
   FractionBox["4", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"2", "\[Pi]"}], ")"}], "3"]], "\[ThinSpace]", 
   SubscriptBox["\[ContourIntegral]", 
    RowBox[{
     RowBox[{"\[LeftBracketingBar]", 
      OverscriptBox[
       StyleBox["q", "TI"], "\[RightVector]"], "\[RightBracketingBar]"}], "\[LongEqual]", 
     SubscriptBox["\[CapitalLambda]", 
      StyleBox["LL",
       FontSlant->"Plain"]]}]], "\[ThinSpace]", 
   FractionBox[
    SuperscriptBox[
     StyleBox["q", "TI"], "3"], 
    SubscriptBox["\[CurlyEpsilon]", 
     StyleBox["LL",
      FontSlant->"Plain"]]], "\[ThinSpace]", 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", "\[Theta]", "\[ThickSpace]", 
   StyleBox["dS", "TI"], "\[LongEqual]", 
   FractionBox[
    RowBox[{"4", 
     SubsuperscriptBox["\[CapitalLambda]", 
      StyleBox["LL",
       FontSlant->"Plain"], "3"]}], 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"2", "\[Pi]"}], ")"}], "3"], "\[ThinSpace]", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox["\[CapitalLambda]", 
         StyleBox["LL",
          FontSlant->"Plain"], "2"], "+", 
        SubsuperscriptBox[
         StyleBox["m", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], "2"]}], ")"}], 
      RowBox[{"1", "/", "2"}]]}]], "\[ThinSpace]", "\[Integral]", 
   "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["cos",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", "\[Theta]", "\[ThinSpace]", 
   StyleBox["d", "TI"], "\[CapitalOmega]", "\[LongEqual]", 
   FractionBox[
    RowBox[{"2", 
     SubsuperscriptBox["\[CapitalLambda]", 
      StyleBox["LL",
       FontSlant->"Plain"], "3"]}], 
    RowBox[{"3", 
     SuperscriptBox["\[Pi]", "2"], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox["\[CapitalLambda]", 
         StyleBox["LL",
          FontSlant->"Plain"], "2"], "+", 
        SubsuperscriptBox[
         StyleBox["m", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], "2"]}], ")"}], 
      RowBox[{"1", "/", "2"}]]}]], ","}], TraditionalForm]], "DisplayFormula",\

 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"66c62e9f-9938-4125-9da1-442f67270407"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["q", "TI"], "3"], "\[LongEqual]", 
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[ThinSpace]", 
    StyleBox["cos",
     FontSlant->"Plain"], "\[ThinSpace]", "\[Theta]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c9b5c5df-6a5e-4ab7-8af0-eeb13bd291eb"],
 " on the surface. The vector contact term turns the current into a \
self-energy along the same direction, which gives the static response of the \
normal vacuum the eigenvalue ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["V",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Chi]", 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["J",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a034efd4-5ffd-439c-8b60-d30271194dc0"],
 " in the method HS (0, 1), where only the vector term acts in the normal \
self-energies. The next cell evaluates the closed form and compares it with \
the largest eigenvalue of the normal self-energies of HS (0, 1) of the Rust \
program, for the three potentials (the Python check YSF-13 tests the same). \
",
 StyleBox["Why it matters.",
  FontWeight->"Bold"],
 " It violates gauge invariance: a uniform vector potential is a gauge \
transformation, the gradient of a linear function, and the vacuum must answer \
it with zero current, as it does in a regularization that respects the gauge \
symmetry. Here it is harmless, since the eigenvalue, about 0.053, is far \
below 1 and does not change the stability of the normal vacuum. But the \
masses of the gauge bosons must not be computed from the response to the \
space components of uniform gauge fields with this cutoff, because the normal \
vacuum would give them spurious masses without any condensate. Stage 4 uses \
their time components instead, the chemical potentials of the charges, to \
which the normal vacuum, which has a gap and keeps every charge, does not \
respond at all (Section R.3)."
}], "Text",ExpressionUUID->"d0240437-7265-4c9c-a677-70e3b15eb5e6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"--", " ", "remark"}]}], " ", 
     RowBox[{"R10", ":", " ", 
      RowBox[{
      "the", " ", "response", " ", "of", " ", "the", " ", "current", " ", 
       "of", " ", "the", " ", "normal", " ", "vacuum"}]}]}], ",", " ", 
    RowBox[{
    "a", " ", "surface", " ", "term", " ", "of", " ", "the", " ", "sharp", " ", 
     RowBox[{
      RowBox[{"cutoff", " ", "--"}], "--"}]}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", "integral", " ", "of", " ", 
     RowBox[{"cos", "^", "2"}], " ", "over", " ", "the", " ", "unit", " ", 
     "sphere"}], ",", " ", 
    RowBox[{
     RowBox[{"and", " ", "chi_J"}], " ", "=", " ", 
     RowBox[{
      RowBox[{"4", " ", "/", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"2", " ", "pi"}], ")"}], "^", "3"}]}], " ", 
      RowBox[{
       RowBox[{"Lambda", "^", "3"}], " ", "/", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Lambda", "^", "2"}], " ", "+", " ", 
          RowBox[{"m", "^", "2"}]}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{"1", "/", "2"}], ")"}]}]}], " ", "times", " ", "it"}]}]}], 
   " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"r10Sphere", " ", "=", " ", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Cos", "[", "th", "]"}], "^", "2"}], " ", 
        RowBox[{"Sin", "[", "th", "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"th", ",", " ", "0", ",", " ", "Pi"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"ph", ",", " ", "0", ",", " ", 
         RowBox[{"2", " ", "Pi"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"r10ChiJ", " ", "=", " ", 
     RowBox[{
      RowBox[{"4", "/", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"2", " ", "Pi"}], ")"}], "^", "3"}]}], " ", 
      RowBox[{"1", "/", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"1", " ", "+", " ", 
         RowBox[{"mLL", "^", "2"}]}], "]"}]}], " ", "r10Sphere"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<integral of cos^2 over the sphere: \>\"", ",", " ", 
      "r10Sphere", ",", " ", "\"\<; chi_J = \>\"", ",", " ", "r10ChiJ", ",", 
      " ", "\"\< = \>\"", ",", " ", 
      RowBox[{"ToString", "[", 
       RowBox[{"NumberForm", "[", 
        RowBox[{
         RowBox[{"N", "[", 
          RowBox[{"r10ChiJ", ",", " ", "12"}], "]"}], ",", " ", "12"}], "]"}],
        "]"}], ",", "\n", 
      "  ", "\"\<; closed form 2 / (3 pi^2 (1 + m^2)^(1/2)) equal: \>\"", ",",
       " ", 
      RowBox[{
       RowBox[{"Simplify", "[", 
        RowBox[{"r10ChiJ", " ", "-", " ", 
         RowBox[{"2", "/", 
          RowBox[{"(", 
           RowBox[{"3", " ", 
            RowBox[{"Pi", "^", "2"}], " ", 
            RowBox[{"Sqrt", "[", 
             RowBox[{"1", " ", "+", " ", 
              RowBox[{"mLL", "^", "2"}]}], "]"}]}], ")"}]}]}], "]"}], " ", "==",
        " ", "0"}]}], "]"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"G", "^", "V"}], " ", "chi_J", " ", "against", " ", "the", " ", 
      "largest", " ", "eigenvalue", " ", "of", " ", "the", " ", "normal", " ",
       "self"}], "-", 
     RowBox[{"energies", " ", "of", " ", "HS", " ", 
      RowBox[{"(", 
       RowBox[{"0", ",", " ", "1"}], ")"}], " ", "of", " ", "the", " ", 
      "Rust", " ", "program"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"r10GV", " ", "=", " ", 
     RowBox[{"4", "/", "5"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<G^V chi_J = \>\"", ",", " ", 
      RowBox[{"ToString", "[", 
       RowBox[{"NumberForm", "[", 
        RowBox[{
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{"r10GV", " ", "r10ChiJ"}], ",", " ", "12"}], "]"}], ",", 
         " ", "12"}], "]"}], "]"}], ",", 
      " ", "\"\<; Rust (HS (0, 1), the three potentials): \>\"", ",", "\n", 
      "  ", 
      RowBox[{"StringRiffle", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"ToString", "[", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{"num", "[", 
              RowBox[{
               RowBox[{"rowOf", "[", 
                RowBox[{"p", ",", " ", "\"\<HS (0, 1)\>\""}], "]"}], "[", 
               RowBox[{"[", 
                RowBox[{"col", "[", 
                 RowBox[{"hdr", ",", " ", "\"\<lam_max_normal\>\""}], "]"}], 
                "]"}], "]"}], "]"}], ",", " ", "12"}], "]"}], "]"}], ",", 
          "\n", "    ", 
          RowBox[{"{", 
           RowBox[{"p", ",", " ", 
            RowBox[{"{", 
             
             RowBox[{"\"\<V0_SH\>\"", ",", " ", "\"\<V1_SH first version\>\"",
               ",", " ", "\"\<V1_SH\>\""}], "}"}]}], "}"}]}], "]"}], ",", 
        " ", "\"\<, \>\""}], "]"}]}], "]"}], ";"}]}]}]], "Input",
 CellLabel->
  "In[631]:=",ExpressionUUID->"53527b43-0af7-4c6c-b4a9-063b3bb3f253"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"integral of cos^2 over the sphere: \"\>", "\[InvisibleSpace]", 
   
   FractionBox[
    RowBox[{"4", " ", "\[Pi]"}], "3"], 
   "\[InvisibleSpace]", "\<\"; chi_J = \"\>", "\[InvisibleSpace]", 
   FractionBox[
    RowBox[{"5", " ", 
     SqrtBox[
      FractionBox["2", "13"]]}], 
    RowBox[{"3", " ", 
     SuperscriptBox["\[Pi]", "2"]}]], "\[InvisibleSpace]", "\<\" = \"\>", 
   "\[InvisibleSpace]", "\<\"0.0662357298119\"\>", 
   "\[InvisibleSpace]", "\<\"; closed form 2 / (3 pi^2 (1 + m^2)^(1/2)) \
equal: \"\>", "\[InvisibleSpace]", "True"}],
  SequenceForm[
  "integral of cos^2 over the sphere: ", Rational[4, 3] Pi, "; chi_J = ", 
   Rational[5, 3] Rational[2, 13]^Rational[1, 2] Pi^(-2), " = ", 
   "0.0662357298119", "; closed form 2 / (3 pi^2 (1 + m^2)^(1/2)) equal: ", 
   True],
  Editable->False]], "Print",
 CellChangeTimes->{4.004330940183846*^9},
 CellLabel->
  "During evaluation of \
In[631]:=",ExpressionUUID->"f7426b4a-ed22-42e9-ad12-01c9eedb8b7c"],

