Cell[TextData[{
 "whose projector onto the negative eigenvalues gives ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["C",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["n",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7e8f6fb2-83e7-4cfe-a1d9-09274f5cea84"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SubsuperscriptBox[
     StyleBox["C",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "eedbad20-4728-4787-a1c3-06f8c696b0ba"],
 " as its upper blocks. ",
 StyleBox["The grid:",
  FontWeight->"Bold"],
 " 24 Gauss-Legendre nodes of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftBracketingBar]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["q", "TI"], "\[RightVector]"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[RightBracketingBar]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "06a04dbb-9752-4731-8643-7ba7600d73d2"],
 " on ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"0", ",", 
     SubscriptBox["\[CapitalLambda]", 
      StyleBox["LL",
       FontSlant->"Plain"]]}], "]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "305af608-9439-4aba-a09f-cd1bf688d9c0"],
 " times the six directions ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["e", "TI"], "\[RightVector]"], 
     StyleBox["j", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0e80d1aa-dc4f-4784-8bf6-5897a49c37e3"],
 ", with the weight ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["w", "TI"], 
     StyleBox["r",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     StyleBox["q", "TI"], "2"], "/", 
    RowBox[{"(", 
     RowBox[{"2", 
      SuperscriptBox["\[Pi]", "2"]}], ")"}], "/", "6"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "98a9f320-d9c8-4d27-b362-a18c933d757d"],
 " of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Integral]", "\[ThinSpace]", 
    SuperscriptBox[
     StyleBox["d", "TI"], "3"], 
    StyleBox["q", "TI"], "/", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"2", "\[Pi]"}], ")"}], "3"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a2b05b2a-ad9c-4f50-85fa-ae055cd8dc4c"],
 ". ",
 StyleBox["The iteration:",
  FontWeight->"Bold"],
 " the self-energies are mixed (new times 0.6 plus old times 0.4) until they \
change by less than ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "12"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a73ea7a6-f0f8-472a-9798-1a79faca2480"],
 ". The gap is the minimum over ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "\[LessEqual]", 
    RowBox[{"\[LeftBracketingBar]", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["q", "TI"], "\[RightVector]"], 
      StyleBox["LL",
       FontSlant->"Plain"]], "\[RightBracketingBar]"}], "\[LessEqual]", 
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "af1ddc69-4f28-4a60-a79b-e9556e4afb6b"],
 " of the smallest eigenvalue modulus of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["H",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1a7db7fb-3523-4427-a962-3ab6c71ea3fc"],
 " (401 momenta and a golden-section refinement), and the Dirac mass is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "+", 
    FractionBox["1", "8"], 
    StyleBox["tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[Beta]", 
         StyleBox["LL",
          FontSlant->"Plain"]], "\[CircleTimes]", 
        SubscriptBox[
         StyleBox["1",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], "2"]}], ")"}], 
      SubscriptBox[
       StyleBox["N",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["SF",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a26c2862-f40f-4b58-8a58-1902de4f5c56"],
 ". The next cell defines this engine; the cell after it checks that the \
self-energies are the derivatives of the energy (central differences on \
random states) and that the engine with the pairing term alone reproduces the \
analytic solution AS3 of Part I."
}], "Text",ExpressionUUID->"3ed199c3-32e2-45c4-9c73-e4253b1462ec"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"--", " ", "the"}]}], " ", "constants", " ", "and", " ", 
    "matrices", " ", "of", " ", "the", " ", "engine", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"floating", " ", "point"}], ")"}], " ", "--"}], "--"}]}], " ", 
   "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"lamLL", " ", "=", " ", "1."}], ";"}], 
   "                                   ", 
   RowBox[{"(*", " ", 
    RowBox[{"the", " ", "momentum", " ", "cutoff", " ", "Lambda_LL"}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"gvLL", ",", " ", "gfLL"}], "}"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"0.7", ",", " ", "0.45"}], "}"}]}], ";"}], 
   "                   ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", "gauge", " ", "couplings", " ", 
      RowBox[{"g", "^", "v_LL"}]}], ",", " ", 
     RowBox[{
      RowBox[{"g", "^", "F_LL"}], " ", "of", " ", "the", " ", "project"}]}], 
    " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"id8", " ", "=", " ", 
     RowBox[{"N", "[", 
      RowBox[{"IdentityMatrix", "[", "8", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"b8", " ", "=", " ", 
     RowBox[{"N", "[", 
      RowBox[{"d8", "[", "betaLL", "]"}], "]"}]}], ";"}], 
   "                           ", 
   RowBox[{"(*", " ", 
    RowBox[{"beta_LL", " ", 
     RowBox[{"(", "x", ")"}], " ", "1", "_", "2"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"k8", "[", "iota_", "]"}], " ", ":=", " ", 
     RowBox[{"N", "[", 
      RowBox[{"kLL", "[", "iota", "]"}], "]"}]}], ";"}], 
   "                    ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"K", "^", "iota_LL"}], ",", " ", "numerical"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"zero8", " ", "=", " ", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{
       RowBox[{"0.", " ", "I"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"8", ",", " ", "8"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"gaussLegendre", "[", "n", "]"}], ":", " ", 
     RowBox[{
      RowBox[{
      "the", " ", "nodes", " ", "and", " ", "weights", " ", "of", " ", "the", 
       " ", "n"}], "-", 
      RowBox[{"point", " ", "Gauss"}], "-", 
      RowBox[{"Legendre", " ", "rule", " ", 
       RowBox[{"on", " ", "[", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "1"}], "]"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"40", " ", "digits"}], ",", " ", 
         RowBox[{"then", " ", "machine", " ", "numbers"}]}], ")"}]}]}]}], " ",
     "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"gaussLegendre", "[", "n_Integer", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "xx", ",", " ", "poly", ",", " ", "dpoly", ",", " ", "roots"}], "}"}],
        ",", "\n", "   ", 
       RowBox[{
        RowBox[{"poly", " ", "=", " ", 
         RowBox[{"LegendreP", "[", 
          RowBox[{"n", ",", " ", "xx"}], "]"}]}], ";", " ", 
        RowBox[{"dpoly", " ", "=", " ", 
         RowBox[{"D", "[", 
          RowBox[{"poly", ",", " ", "xx"}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"roots", " ", "=", " ", 
         RowBox[{"Sort", "[", 
          RowBox[{"xx", " ", "/.", " ", 
           RowBox[{"NSolve", "[", 
            RowBox[{
             RowBox[{"poly", " ", "==", " ", "0"}], ",", " ", "xx", ",", " ", 
             
             RowBox[{"WorkingPrecision", " ", "->", " ", "40"}]}], "]"}]}], 
          "]"}]}], ";", "\n", "   ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"N", "[", "roots", "]"}], ",", " ", 
          RowBox[{"N", "[", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"2", "/", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", " ", "-", " ", 
                   RowBox[{"#", "^", "2"}]}], ")"}], " ", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"dpoly", " ", "/.", " ", 
                    RowBox[{"xx", " ", "->", " ", "#"}]}], ")"}], "^", 
                  "2"}]}], ")"}]}], " ", "&"}], ",", " ", "roots"}], "]"}], 
           "]"}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"gridSF", "[", "nr", "]"}], ":", " ", 
      RowBox[{"the", " ", "radial", " ", "nodes", " ", "kr", " ", 
       RowBox[{"(", 
        RowBox[{"on", " ", "[", 
         RowBox[{"0", ",", " ", "Lambda"}], "]"}], ")"}], " ", "and", " ", 
       "weights", " ", "wr"}]}], ",", " ", 
     RowBox[{
      RowBox[{"the", " ", "momenta", " ", "q", " ", 
       RowBox[{"(", 
        RowBox[{"nr", " ", "x", " ", "6", " ", "directions"}], ")"}], " ", 
       "and", " ", "the", " ", "weights", " ", "w", " ", "of", "\n", "   ", 
       "int", " ", 
       RowBox[{"d", "^", "3"}], 
       RowBox[{"q", "/", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"2", " ", "pi"}], ")"}], "^", "3"}]}]}], ";", " ", 
      RowBox[{
       RowBox[{
       "the", " ", "node", " ", "of", " ", "radial", " ", "index", " ", "i", " ",
         "and", " ", "direction", " ", "d", " ", "is", " ", "the", " ", 
        "node", " ", "6", " ", 
        RowBox[{"(", 
         RowBox[{"i", " ", "-", " ", "1"}], ")"}]}], " ", "+", " ", "d"}]}]}],
     " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"gridSF", "[", "nr_Integer", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "x", ",", " ", "wgl", ",", " ", "kr", ",", " ", "wr", ",", " ", 
         "dirs"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "wgl"}], "}"}], " ", "=", " ", 
         RowBox[{"gaussLegendre", "[", "nr", "]"}]}], ";", "\n", "   ", 
        RowBox[{"kr", " ", "=", " ", 
         RowBox[{"0.5", " ", "lamLL", " ", 
          RowBox[{"(", 
           RowBox[{"x", " ", "+", " ", "1."}], ")"}]}]}], ";", " ", 
        RowBox[{"wr", " ", "=", " ", 
         RowBox[{"0.5", " ", "lamLL", " ", "wgl"}]}], ";", "\n", "   ", 
        RowBox[{"dirs", " ", "=", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", " ", "0", ",", " ", "0"}], "}"}], ",", 
           " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "1", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", 
             RowBox[{"-", "1"}], ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0", ",", " ", "1"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0", ",", " ", 
             RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ";", "\n", "   ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<nr\>\"", " ", "->", " ", "nr"}], ",", " ", 
          RowBox[{"\"\<kr\>\"", " ", "->", " ", "kr"}], ",", " ", 
          RowBox[{"\"\<wr\>\"", " ", "->", " ", "wr"}], ",", " ", 
          RowBox[{"\"\<dirs\>\"", " ", "->", " ", 
           RowBox[{"N", "[", "dirs", "]"}]}], ",", "\n", "     ", 
          RowBox[{"\"\<q\>\"", " ", "->", " ", 
           RowBox[{"Flatten", "[", 
            RowBox[{
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"kr", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], " ", 
                RowBox[{"dirs", "[", 
                 RowBox[{"[", "d", "]"}], "]"}]}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"i", ",", " ", "nr"}], "}"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"d", ",", " ", "6"}], "}"}]}], "]"}], ",", " ", "1"}],
             "]"}]}], ",", "\n", "     ", 
          RowBox[{"\"\<w\>\"", " ", "->", " ", 
           RowBox[{"Flatten", "[", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"wr", "[", 
                RowBox[{"[", "i", "]"}], "]"}], " ", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"kr", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "^", "2"}], "/", 
                 RowBox[{"(", 
                  RowBox[{"2", " ", 
                   RowBox[{"Pi", "^", "2"}]}], ")"}]}], "/", "6."}]}], ",", 
              " ", 
              RowBox[{"{", 
               RowBox[{"i", ",", " ", "nr"}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"d", ",", " ", "6"}], "}"}]}], "]"}], "]"}]}], ",", 
          " ", 
          RowBox[{"\"\<n\>\"", " ", "->", " ", 
           RowBox[{"6", " ", "nr"}]}]}], "|>"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"ksProj", "[", "x", "]"}], ":", " ", 
     RowBox[{
      RowBox[{"the", " ", "projection", " ", 
       RowBox[{"P", "^", "KS_SF"}], " ", "onto", " ", "the", " ", "matrices", 
       " ", "of", " ", "the", " ", "two", " ", "Kohn"}], "-", 
      RowBox[{"Sham", " ", "densities"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"ksProj", "[", "x_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Tr", "[", "x", "]"}], "/", "8"}], " ", "id8"}], " ", "+", 
      " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Tr", "[", 
         RowBox[{"b8", " ", ".", " ", "x"}], "]"}], "/", "8"}], " ", 
       "b8"}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"terms", "[", 
       RowBox[{"method", ",", " ", "gs", ",", " ", "gv", ",", " ", "g"}], 
       "]"}], ":", " ", 
      RowBox[{
      "the", " ", "contact", " ", "terms", " ", "of", " ", "the", " ", 
       "potential", " ", "with", " ", "the", " ", "couplings", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"G", "^", "S"}], ",", " ", 
         RowBox[{"G", "^", "V"}], ",", " ", "G"}], ")"}], " ", "for", " ", 
       "a", " ", "method", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<HS\>\"", ",", " ", "sS", ",", " ", "sV"}], "}"}]}]}], ",",
      " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"{", "\"\<KS\>\"", "}"}], " ", "or", " ", 
        RowBox[{"{", "\"\<CJT\>\"", "}"}]}], ":", " ", 
       RowBox[{"a", " ", "list", " ", "of", " ", 
        RowBox[{"{", 
         RowBox[{"kind", ",", " ", "data", ",", " ", 
          RowBox[{"{", 
           RowBox[{"wH", ",", " ", "wF", ",", " ", "wP"}], "}"}], ",", " ", 
          "ks"}], "}"}]}]}], ";", " ", 
      RowBox[{"kind", " ", "\"\<b\>\"", " ", "with", " ", "data", " ", 
       RowBox[{"{", 
        RowBox[{"nu", ",", " ", "X"}], "}"}], " ", "for", "\n", "   ", 
       RowBox[{"nu", " ", ":", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Psi", "^", "dag"}], " ", "X", " ", "Psi"}], ")"}], "^", 
         "2"}], ":"}]}]}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"kind", " ", "\"\<p\>\"", " ", "with", " ", "data", " ", 
         RowBox[{"{", 
          RowBox[{"G", ",", " ", "K"}], "}"}], " ", "for"}], " ", "-", 
        RowBox[{"(", 
         RowBox[{"G", "/", "4"}], ")"}]}], " ", ":", 
       RowBox[{
        RowBox[{"Pi", "^", "dag"}], " ", "Pi"}], ":"}], ";", " ", 
      RowBox[{
      "ks", " ", "is", " ", "True", " ", "for", " ", "the", " ", "KS", " ", 
       "projection"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"terms", "[", 
      RowBox[{
      "method_List", ",", " ", "gs_", ",", " ", "gv_", ",", " ", "g_"}], 
      "]"}], " ", ":=", " ", 
