Cell[CellGroupData[{

Cell["R.2.2 The scalar channel of the normal vacuum (check WSF-3)", \
"Subsection",ExpressionUUID->"acaf180a-d8ea-440c-bc97-b04c9e3dd319"],

Cell[TextData[{
 "Besides the pair self-energies, the pairing terms give normal self-energies \
by exchange: contracting one particle of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "63c753bf-fa6a-4f27-8c83-e06510dcb310"],
 " with one of a singlet inside ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[CapitalPi]", 
       StyleBox["SH",
        FontSlant->"Plain"], 
       StyleBox["s", "TI"]], ")"}], "\[Dagger]"], 
    SubsuperscriptBox["\[CapitalPi]", 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["s", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "55600a21-4b94-4f92-819f-4e175965c531"],
 " leaves a bilinear of the other two. The exact contraction shows that a \
scalar density ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "42f9c62e-c5e1-4383-924a-8b5feb289f54"],
 " of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "55740d70-4b3d-4832-af61-32f86c9f55f9"],
 " gives each paired singlet the self-energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["G", "TI"], 
        StyleBox["SH",
         FontSlant->"Plain"]], "/", "16"}], ")"}]}], "\[ThinSpace]", 
    StyleBox["n", "TI"], "\[ThinSpace]", 
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0099eeeb-b4ab-4727-a6a5-55f299bb4141"],
 ", and a scalar density ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d112e76d-d38b-4d42-8f69-273c3e40e652"],
 " of a paired singlet gives ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f4a92e26-da8d-4f88-b6c9-bcf706f5f8a9"],
 " the self-energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["G", "TI"], 
        StyleBox["SH",
         FontSlant->"Plain"]], "/", "16"}], ")"}]}], "\[ThinSpace]", 
    StyleBox["n", "TI"], "\[ThinSpace]", 
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[CircleTimes]", 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c862f91f-eead-4966-ade4-aa15f6ba6e04"],
 ". The scalar susceptibility of a free Dirac field of eight components is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Chi]", 
     StyleBox["S", "TI"]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{"2", "/", 
      SuperscriptBox["\[Pi]", "2"]}], ")"}], "\[ThinSpace]", 
    SubsuperscriptBox["\[Integral]", "0", "1"], "\[ThinSpace]", 
    SuperscriptBox[
     StyleBox["q", "TI"], "4"], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        StyleBox["q", "TI"], "2"], "+", 
       SuperscriptBox[
        StyleBox["m", "TI"], "2"]}], ")"}], 
     RowBox[{
      RowBox[{"-", "3"}], "/", "2"}]], 
    StyleBox["dq", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "63ca7f03-e7d9-4b83-966e-e93ca9c98636"],
 ", half of it for a singlet. Together with the scalar coupling of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "68669324-35ea-4429-a360-5a21cf588228"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["7", "8"], 
    SubsuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["S",
      FontSlant->"Plain"]], "-", 
    FractionBox["1", "2"], 
    SubsuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["V",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "085a8794-26a9-4671-8a6e-523a06fc049c"],
 " in CJT, they make a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", "\[Times]", "3"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "963c1837-53b4-4011-9d47-fb0a99f6d633"],
 " response of the masses of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4958de94-5371-41dd-8dcd-f63d8cdb05a9"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Chi]", 
    StyleBox["SH",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "60d28632-29ec-4ba2-a13b-912b45327f63"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Chi]", 
    StyleBox["SH",
     FontSlant->"Plain"], "\[Prime]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f07c05bd-bce0-4acb-ab22-0b8c504c9824"],
 ", whose largest eigenvalue ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Lambda]", 
    StyleBox["SH",
     FontSlant->"Plain"], 
    StyleBox["S",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a18ee769-c631-4960-a851-b8677f7a2197"],
 " must agree with that of the Rust program and lie below 1: the normal \
vacuum is stable in the scalar channel, and the condensate is that of the \
pairs."
}], "Text",ExpressionUUID->"fb02c4ea-0d5c-42b5-ac2a-6f8ffc2624b6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"WSF", "-", "3"}], ":", " ", 
    RowBox[{
    "the", " ", "exchange", " ", "contraction", " ", "of", " ", "the", " ", 
     "pairing", " ", "terms", " ", "in", " ", "the", " ", "scalar", " ", 
     "channel"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"emb", "[", 
      RowBox[{"x_", ",", " ", "r_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"m", " ", "=", " ", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0", ",", " ", 
           RowBox[{"{", 
            RowBox[{"16", ",", " ", "16"}], "}"}]}], "]"}]}], "}"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"m", "[", 
          RowBox[{"[", 
           RowBox[{"r", ",", " ", "r"}], "]"}], "]"}], " ", "=", " ", "x"}], ";",
         " ", "m"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"rhoPsi", "[", "n_", "]"}], " ", ":=", " ", 
     RowBox[{"emb", "[", 
      RowBox[{
       RowBox[{"n", " ", 
        RowBox[{
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{"bet", ",", " ", 
           RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}], "/", "8"}]}], ",",
        " ", 
       RowBox[{"Range", "[", 
        RowBox[{"1", ",", " ", "8"}], "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"rhoChi", "[", "n_", "]"}], " ", ":=", " ", 
     RowBox[{"emb", "[", 
      RowBox[{
       RowBox[{"n", " ", 
        RowBox[{"bet", "/", "4"}]}], ",", " ", "chiIdx"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"rhoChi2", "[", "n_", "]"}], " ", ":=", " ", 
     RowBox[{"emb", "[", 
      RowBox[{
       RowBox[{"n", " ", 
        RowBox[{"bet", "/", "4"}]}], ",", " ", "chi2Idx"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"fock", "[", 
      RowBox[{"rho_", ",", " ", "a_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "g"}], " ", 
        RowBox[{
         RowBox[{"ConjugateTranspose", "[", 
          RowBox[{"kP", "[", 
           RowBox[{"a", ",", " ", "s"}], "]"}], "]"}], ".", 
         RowBox[{"Transpose", "[", "rho", "]"}], ".", 
         RowBox[{"kP", "[", 
          RowBox[{"a", ",", " ", "s"}], "]"}]}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"s", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"fock2", "[", "rho_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"fock", "[", 
       RowBox[{"rho", ",", " ", "0"}], "]"}], " ", "+", " ", 
      RowBox[{"fock", "[", 
       RowBox[{"rho", ",", " ", "1"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"f1", " ", "=", " ", 
     RowBox[{"fock2", "[", 
      RowBox[{"rhoPsi", "[", "n", "]"}], "]"}]}], ";", " ", 
    RowBox[{"f2", " ", "=", " ", 
     RowBox[{"fock2", "[", 
      RowBox[{"rhoChi", "[", "n", "]"}], "]"}]}], ";", " ", 
    RowBox[{"f3", " ", "=", " ", 
     RowBox[{"fock2", "[", 
      RowBox[{"rhoChi2", "[", "n", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"z88", " ", "=", " ", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", " ", 
       RowBox[{"{", 
        RowBox[{"8", ",", " ", "8"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ok3a", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"f1", "[", 
          RowBox[{"[", 
           RowBox[{"chiIdx", ",", " ", "chiIdx"}], "]"}], "]"}], " ", "-", 
         " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{"g", "/", "16"}], ")"}]}], " ", "n", " ", "bet"}], 
          ")"}]}], "]"}], " ", "==", " ", "z44"}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"f1", "[", 
          RowBox[{"[", 
           RowBox[{"chi2Idx", ",", " ", "chi2Idx"}], "]"}], "]"}], " ", "-", 
         " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{"g", "/", "16"}], ")"}]}], " ", "n", " ", "bet"}], 
          ")"}]}], "]"}], " ", "==", " ", "z44"}], " ", "&&", "\n", "  ", 
      RowBox[{
       RowBox[{"Simplify", "[", 
        RowBox[{"f1", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"1", " ", ";;", " ", "8"}], ",", " ", 
           RowBox[{"1", " ", ";;", " ", "8"}]}], "]"}], "]"}], "]"}], " ", "==",
        " ", "z88"}], " ", "&&", "\n", "  ", 
      RowBox[{
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"f2", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"1", " ", ";;", " ", "8"}], ",", " ", 
            RowBox[{"1", " ", ";;", " ", "8"}]}], "]"}], "]"}], " ", "-", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{"g", "/", "16"}], ")"}]}], " ", "n", " ", 
           RowBox[{"KroneckerProduct", "[", 
            RowBox[{"bet", ",", " ", 
             RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}]}], ")"}]}], 
        "]"}], " ", "==", " ", "z88"}], " ", "&&", "\n", "  ", 
      RowBox[{
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"f3", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"1", " ", ";;", " ", "8"}], ",", " ", 
            RowBox[{"1", " ", ";;", " ", "8"}]}], "]"}], "]"}], " ", "-", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{"g", "/", "16"}], ")"}]}], " ", "n", " ", 
           RowBox[{"KroneckerProduct", "[", 
            RowBox[{"bet", ",", " ", 
             RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}]}], ")"}]}], 
        "]"}], " ", "==", " ", "z88"}], " ", "&&", "\n", "  ", 
      RowBox[{
       RowBox[{"Simplify", "[", 
        RowBox[{"f2", "[", 
         RowBox[{"[", 
          RowBox[{"chiIdx", ",", " ", "chiIdx"}], "]"}], "]"}], "]"}], " ", "==",
        " ", "z44"}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"Simplify", "[", 
        RowBox[{"f3", "[", 
         RowBox[{"[", 
          RowBox[{"chi2Idx", ",", " ", "chi2Idx"}], "]"}], "]"}], "]"}], " ", 
       "==", " ", "z44"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"chiInt", " ", "=", " ", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"q", "^", "4"}], "/", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"q", "^", "2"}], " ", "+", " ", 
           RowBox[{"m", "^", "2"}]}], ")"}], "^", 
         RowBox[{"(", 
          RowBox[{"3", "/", "2"}], ")"}]}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"q", ",", " ", "0", ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"Assumptions", " ", "->", " ", 
        RowBox[{"m", " ", ">", " ", "0"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"chi8", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"2", "/", 
        RowBox[{"Pi", "^", "2"}]}], " ", "chiInt"}], " ", "/.", " ", 
      RowBox[{"m", " ", "->", " ", "mLL"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"chi4", " ", "=", " ", 
     RowBox[{"chi8", "/", "2"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gPP", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"7", "/", "8"}], " ", 
       RowBox[{"(", 
        RowBox[{"-", "8"}], ")"}]}], " ", "-", " ", 
      RowBox[{
       RowBox[{"1", "/", "2"}], " ", 
       RowBox[{"(", 
        RowBox[{"4", "/", "5"}], ")"}]}]}]}], ";"}], "                   ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"7", "/", "8"}], ")"}], " ", 
        RowBox[{"G", "^", "S"}]}], " ", "-", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "/", "2"}], ")"}], " ", 
        RowBox[{"G", "^", "V"}], " ", "with", " ", 
        RowBox[{"G", "^", "S"}]}]}], " ", "=", " ", 
      RowBox[{"-", "8"}]}], ",", " ", 
     RowBox[{
      RowBox[{"G", "^", "V"}], " ", "=", " ", 
      RowBox[{"4", "/", "5"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"lamOf", "[", "g2_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"gPX", " ", "=", " ", 
          RowBox[{
           RowBox[{"-", "gSH"}], "/", "16"}]}], ",", " ", 
         RowBox[{"gPX2", " ", "=", " ", 
          RowBox[{
           RowBox[{"-", "g2"}], "/", "16"}]}], ",", " ", "smat"}], "}"}], ",",
        "\n", "  ", 
       RowBox[{
        RowBox[{"smat", " ", "=", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "gPP"}], " ", "chi8"}], ",", " ", 
             RowBox[{
              RowBox[{"-", "gPX"}], " ", "chi4"}], ",", " ", 
             RowBox[{
              RowBox[{"-", "gPX2"}], " ", "chi4"}]}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "gPX"}], " ", "chi8"}], ",", " ", "0", ",", " ", 
             "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "gPX2"}], " ", "chi8"}], ",", " ", "0", ",", " ", 
             "0"}], "}"}]}], "}"}]}], ";", "\n", "  ", 
        RowBox[{"Max", "[", 
         RowBox[{"Re", "[", 
          RowBox[{"Eigenvalues", "[", 
           RowBox[{"N", "[", 
            RowBox[{"smat", ",", " ", "30"}], "]"}], "]"}], "]"}], "]"}]}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"lamS", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"lamOf", "[", "gSH", "]"}], ",", " ", 
       RowBox[{"lamOf", "[", "0", "]"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"lamSRust", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"num", "[", 
        RowBox[{
         RowBox[{"rowOf", "[", 
          RowBox[{"#", ",", " ", "\"\<CJT\>\""}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"col", "[", 
           RowBox[{"hdr", ",", " ", "\"\<lam_scalar\>\""}], "]"}], "]"}], 
         "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<V1_SH\>\"", ",", " ", "\"\<V1_SH first version\>\""}], 
       "}"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dev3", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{"lamS", " ", "-", " ", "lamSRust"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rvCheck", "[", 
     RowBox[{"\"\<WSF-3\>\"", ",", " ", 
      RowBox[{"\"\<the exchange contraction of the pairing terms: a scalar \
density n of Psi_LL gives each paired singlet \\\nthe self-energy -(G_SH/16) \
n beta and a scalar density of a paired singlet gives Psi_LL -(G_SH/16) n \
beta (x) 1_2 (exact); \\\nthe susceptibility chi_S = (2/pi^2) int_0^1 \
q^4/(q^2 + m^2)^(3/2) dq = \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"NumberForm", "[", 
         RowBox[{
          RowBox[{"N", "[", 
           RowBox[{"chi8", ",", " ", "16"}], "]"}], ",", " ", "16"}], "]"}], 
        "]"}], " ", "<>", "\n", 
       "  ", "\"\< (Psi_LL; half for a singlet); the largest eigenvalue of \
the 3 x 3 scalar response of CJT for V^(1)_SH = \>\"", " ", "<>", "\n", "  ", 
       
       RowBox[{"ToString", "[", 
        RowBox[{"NumberForm", "[", 
         RowBox[{
          RowBox[{"lamS", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", " ", "12"}], "]"}], "]"}], 
       " ", "<>", " ", "\"\< (second version) and \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"NumberForm", "[", 
         RowBox[{
          RowBox[{"lamS", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", " ", "12"}], "]"}], "]"}], 
       " ", "<>", "\n", "  ", "\"\< (first), against the Rust values\>\""}], ",",
       " ", 
      RowBox[{"ok3a", " ", "&&", " ", 
       RowBox[{"dev3", " ", "<", " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "9"}]}]}]}], ",", " ", 
      RowBox[{"\"\<deviation \>\"", " ", "<>", " ", 
       RowBox[{"sci", "[", "dev3", "]"}]}]}], "]"}], ";"}]}]}]], "Input",
 CellLabel->
  "In[595]:=",ExpressionUUID->"5d7527c6-f701-4f61-9309-6dfb249eb9b5"],

