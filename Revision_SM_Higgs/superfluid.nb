Cell[CellGroupData[{

Cell["\<\
I.4 The gauge group GEE and its covariant derivatives (item 3)\
\>", "Section",ExpressionUUID->"46c87d34-7cc7-4f0f-bd7a-aaad6534eba0"],

Cell[TextData[{
 "The gauge group is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["GEE",
     FontSlant->"Plain"], "\[LongEqual]", 
    StyleBox["SL", "TI"], 
    RowBox[{"(", 
     RowBox[{"2", ",", 
      StyleBox["\[DoubleStruckCapitalC]",
       FontSlant->"Plain"]}], ")"}], "\[Times]", 
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["v",
      FontSlant->"Plain"]], "\[Times]", 
    StyleBox["U", "TI"], 
    SubsuperscriptBox[
     RowBox[{"(", "1", ")"}], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c482910f-c582-4765-abc3-5b40ec036eea"],
 ". A local transformation is a unit bi-quaternion ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["g",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     StyleBox["x", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "930d76cd-f652-4899-b0af-f880f6e3033f"],
 ", an isospin rotation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["U",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["x", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "26520d76-e539-49d4-b7dd-c5cfe31d9ec1"],
 " and a phase ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Theta]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["x", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fc47bd12-7ba7-4bc3-8c30-adbe89f63abb"],
 "; it acts on the spinor field as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[RightTeeArrow]", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      StyleBox["i", "TI"], 
      SubsuperscriptBox["\[Theta]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["F",
        FontSlant->"Plain"]]}]], 
    SubscriptBox[
     StyleBox["S",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[CircleTimes]", 
    SubscriptBox[
     StyleBox["U",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[ThinSpace]", 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "14776661-7932-40d0-9584-766e9f4ff4a7"],
 ". The gauge fields are the Lorentz connection with the spin connection ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalGamma]", 
    StyleBox["p", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d8da5974-0bde-4ec6-bbba-92b8f50d9fc8"],
 ", the field of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["v",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "35be3b1f-059a-4446-8b9a-087c0e38355a"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["W",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}]], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", "\[Iota]",
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["W", "TI"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], "\[Iota]"], 
    SubsuperscriptBox["\[Tau]", "\[Iota]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "/", "2"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7fdd8f4f-b406-4b3a-9f50-99f4d42953a0"],
 ", and the field ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["B", "TI"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "16cad4dd-620c-4dc6-b94b-42e6a9e5d01b"],
 " of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["U", "TI"], 
    SubsuperscriptBox[
     RowBox[{"(", "1", ")"}], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a56cff97-3083-4ced-b859-66ef7b6dd452"],
 ", with the couplings ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["v",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "25441eee-eef0-42fc-817f-3afca635b185"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["F",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "41cde3ec-246f-4023-b1b0-33e99632165d"],
 ". The covariant derivative of the spinor field is"
}], "Text",ExpressionUUID->"2d77de1f-89da-49fc-b2f4-d1a4aa5ab83c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["\[Del]", 
    StyleBox["p", "TI"], 
    StyleBox["GEE",
     FontSlant->"Plain"]], 
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], "\[LongEqual]", 
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["\[PartialD]", 
      StyleBox["p", "TI"]], "+", 
     SubsuperscriptBox["\[CapitalGamma]", 
      StyleBox["p", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"]], "+", 
     StyleBox["i", "TI"], 
     SubsuperscriptBox[
      StyleBox["g", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["v",
       FontSlant->"Plain"]], "\[ThinSpace]", 
     SubscriptBox[
      StyleBox["1",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "4"], "\[CircleTimes]", 
     SubscriptBox[
      StyleBox["W",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["SF",
        FontSlant->"Plain"], ",", 
       StyleBox["p", "TI"]}]], "+", 
     StyleBox["i", "TI"], 
     SubsuperscriptBox[
      StyleBox["g", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["F",
       FontSlant->"Plain"]], 
     SubscriptBox[
      StyleBox["B", "TI"], 
      RowBox[{
       StyleBox["SF",
        FontSlant->"Plain"], ",", 
       StyleBox["p", "TI"]}]]}], ")"}], 
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], ","}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"3c9c1a33-1bfc-44e8-88b3-31d89e2e4295"],

Cell[TextData[{
 "and it is covariant, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Del]", 
     StyleBox["p", "TI"], 
     RowBox[{"\[Prime]", 
      StyleBox["GEE",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["\[ScriptCapitalU]",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      SubscriptBox["\[CapitalPsi]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["\[ScriptCapitalU]",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Del]", 
     StyleBox["p", "TI"], 
     StyleBox["GEE",
      FontSlant->"Plain"]], 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7f21e180-1850-47ce-b47e-9899a6c950be"],
 ", when the gauge fields transform as"
}], "Text",ExpressionUUID->"0dbf9b9b-9e02-44ef-b2a9-777b0828beb9"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["\[CapitalGamma]", 
    StyleBox["p", "TI"], 
    RowBox[{"\[Prime]", 
     StyleBox["LL",
      FontSlant->"Plain"]}]], "\[LongEqual]", 
   StyleBox["S",
    FontFamily->"Helvetica",
    FontSlant->"Plain"], "\[ThinSpace]", 
   SubsuperscriptBox["\[CapitalGamma]", 
    StyleBox["p", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["S",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{"-", "1"}]], "-", 
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["\[PartialD]", 
      StyleBox["p", "TI"]], 
     StyleBox["S",
      FontFamily->"Helvetica",
      FontSlant->"Plain"]}], ")"}], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["S",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{"-", "1"}]], ",", "      ", 
   SubsuperscriptBox[
    StyleBox["W",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}], "\[Prime]"], "\[LongEqual]", 
   SubscriptBox[
    StyleBox["U",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   SubscriptBox[
    StyleBox["W",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}]], 
   SubsuperscriptBox[
    StyleBox["U",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Dagger]"], "+", 
   FractionBox[
    StyleBox["i", "TI"], 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]]], 
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["\[PartialD]", 
      StyleBox["p", "TI"]], 
     SubscriptBox[
      StyleBox["U",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"]]}], ")"}], 
   SubsuperscriptBox[
    StyleBox["U",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Dagger]"], ",", "      ", 
   SubsuperscriptBox[
    StyleBox["B", "TI"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}], "\[Prime]"], "\[LongEqual]", 
   SubscriptBox[
    StyleBox["B", "TI"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}]], "-", 
   FractionBox["1", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]]], 
   SubscriptBox["\[PartialD]", 
    StyleBox["p", "TI"]], 
   SubsuperscriptBox["\[Theta]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["F",
     FontSlant->"Plain"]], "."}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"3d9f5004-76b8-409f-82ef-e2850e9b5edb"],

Cell[TextData[{
 "An isospin vector of fermion number 2 and spin 0, such as the pair field ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[CapitalPhi]", "\[RightVector]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2b5a50e2-4692-4c6d-bfac-34dc0298fcc9"],
 " of the superfluid, has the covariant derivative ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Del]", 
     StyleBox["p", "TI"]], 
    OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "\[LongEqual]", 
    SubscriptBox["\[PartialD]", 
     StyleBox["p", "TI"]], 
    OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "-", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["W", "TI"], "\[RightVector]"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}]], "\[Times]", 
    OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "+", "2", 
    StyleBox["i", "TI"], 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["B", "TI"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}]], 
    OverscriptBox["\[CapitalPhi]", "\[RightVector]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e4e131c0-9983-4ef1-9cf3-5062178d74d0"],
 "; the field strengths are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["W",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], "\[LongEqual]", 
    SubscriptBox["\[PartialD]", 
     StyleBox["p", "TI"]], 
    SubscriptBox[
     StyleBox["W",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], "-", 
    SubscriptBox["\[PartialD]", 
     SuperscriptBox[
      StyleBox["p", "TI"], "\[Prime]"]], 
    SubscriptBox[
     StyleBox["W",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}]], "+", 
    StyleBox["i", "TI"], 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]], 
    RowBox[{"[", 
     RowBox[{
      SubscriptBox[
       StyleBox["W",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["SF",
         FontSlant->"Plain"], ",", 
        StyleBox["p", "TI"]}]], ",", 
      SubscriptBox[
       StyleBox["W",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["SF",
         FontSlant->"Plain"], ",", 
        SuperscriptBox[
         StyleBox["p", "TI"], "\[Prime]"]}]]}], "]"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e57272d3-f03e-4973-b410-455ef62e23a9"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["B", "TI"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], "\[LongEqual]", 
    SubscriptBox["\[PartialD]", 
     StyleBox["p", "TI"]], 
    SubscriptBox[
     StyleBox["B", "TI"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], "-", 
    SubscriptBox["\[PartialD]", 
     SuperscriptBox[
      StyleBox["p", "TI"], "\[Prime]"]], 
    SubscriptBox[
     StyleBox["B", "TI"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e5fd8bc2-78fc-4510-8bbb-0a3f391158f9"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["W",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}], "\[Prime]"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["U",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["W",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], 
    SubsuperscriptBox[
     StyleBox["U",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Dagger]"]}], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4dbfc310-dc01-4793-a443-942b65edee8e"],
 "."
}], "Text",ExpressionUUID->"0f2db22e-a7f8-4cb7-bdf8-12fbff7d0ec0"],

Cell[TextData[{
 "The next cell checks these covariance laws with random smooth fields: the \
isospin rotation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["U",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["x", "TI"], ")"}], "\[LongEqual]", 
    StyleBox["exp",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       StyleBox["i", "TI"], "2"], "\[ThinSpace]", 
      UnderscriptBox["\[Sum]", "\[Iota]",
       LimitsPositioning->True], "\[ThinSpace]", 
      SuperscriptBox[
       StyleBox["a", "TI"], "\[Iota]"], 
      RowBox[{"(", 
       StyleBox["x", "TI"], ")"}], 
      SubsuperscriptBox["\[Tau]", "\[Iota]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dbc052d5-4c33-4ffc-8b5c-f9793a991d2f"],
 ", the phase, the gauge fields and the test fields are sums of sines of the \
four coordinates with random coefficients. The derivatives are computed \
symbolically by the function ",
 StyleBox["D",
  FontFamily->"Source Code Pro"],
 " of the Wolfram Language and evaluated at four random points: a third \
method, next to the automatic differentiation of the Rust program and the \
differences of eighth order of the Python program. The couplings of the test \
are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["v",
      FontSlant->"Plain"]], "\[LongEqual]", "0.83"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "79f9ba64-edb6-4022-9f48-4d5e62eeacfa"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["F",
      FontSlant->"Plain"]], "\[LongEqual]", "0.47"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d35a2e51-3a38-4aa5-b5ba-f26e5b1e13a8"],
 ". The last check of the cell is the local ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SL", "TI"], 
    RowBox[{"(", 
     RowBox[{"2", ",", 
      StyleBox["\[DoubleStruckCapitalC]",
       FontSlant->"Plain"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "235a9642-40d9-40d8-96f8-1a61c2b4b1c7"],
 " transformation with the frame: with the spinor matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["S",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     StyleBox["x", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9b3a2387-dec8-4a06-91b6-80efff47ed7a"],
 " of a random field of unit bi-quaternions and the connection ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalGamma]", 
     StyleBox["p", "TI"], "\[Prime]"], "\[LongEqual]", 
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[PartialD]", 
        StyleBox["p", "TI"]], 
       StyleBox["S",
        FontFamily->"Helvetica",
        FontSlant->"Plain"]}], ")"}]}], 
    SuperscriptBox[
     StyleBox["S",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{"-", "1"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "74dacdcc-fe50-4413-b755-0d48c075f91a"],
 " of the transformed frame, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["p", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SuperscriptBox["\[Gamma]", 
     StyleBox["p", "TI"]], 
    RowBox[{"[", 
     SuperscriptBox[
      StyleBox["f",
       FontWeight->"Bold",
       FontSlant->"Plain"], "\[Prime]"], "]"}], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[PartialD]", 
       StyleBox["p", "TI"]], "+", 
      SubsuperscriptBox["\[CapitalGamma]", 
       StyleBox["p", "TI"], "\[Prime]"]}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["S",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "\[Psi]"}], ")"}], "\[LongEqual]", 
    StyleBox["S",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", 
     StyleBox["p", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SuperscriptBox["\[Gamma]", 
     StyleBox["p", "TI"]], 
    SubscriptBox["\[PartialD]", 
     StyleBox["p", "TI"]], "\[Psi]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c49ff69c-00c5-4b08-a186-6ea69c91451e"],
 "."
}], "Text",ExpressionUUID->"e0abb42f-a20e-4839-b40f-edc5fadcad8c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"the", " ", "four", " ", "coordinates", " ", 
       RowBox[{"x", "^", "0"}]}], " ", ".."}], " ", 
     RowBox[{"x", "^", "3"}], " ", "of", " ", "the", " ", "test"}], ",", " ", 
    
    RowBox[{"as", " ", "symbols"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", 
     RowBox[{"x0", ",", " ", "x1", ",", " ", "x2", ",", " ", "x3"}], "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"xs", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"x0", ",", " ", "x1", ",", " ", "x2", ",", " ", "x3"}], "}"}]}],
     ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"gvT", ",", " ", 
     RowBox[{"gfT", ":", " ", 
      RowBox[{
      "the", " ", "couplings", " ", "of", " ", "the", " ", "test"}]}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"gvT", ",", " ", "gfT"}], "}"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"0.83", ",", " ", "0.47"}], "}"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"smooth", "[", "off", "]"}], ":", " ", 
     RowBox[{
      RowBox[{
      "a", " ", "random", " ", "smooth", " ", "real", " ", "function", " ", 
       "off"}], " ", "+", " ", 
      RowBox[{"a1", " ", "sin", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"k1", ".", "x"}], " ", "+", " ", "ph1"}], ")"}]}], " ", "+", 
      " ", 
      RowBox[{"a2", " ", "sin", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"k2", ".", "x"}], " ", "+", " ", "ph2"}], ")"}]}]}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"smooth", "[", "off_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"a", " ", "=", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"off", " ", "+", " ", 
             RowBox[{"0.5", " ", 
              RowBox[{"RandomReal", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], "]"}]}]}], ",", 
            " ", 
            RowBox[{"0.6", " ", 
             RowBox[{"RandomReal", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], "]"}]}], ",", " ", 
            RowBox[{"0.4", " ", 
             RowBox[{"RandomReal", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], "]"}]}]}], 
           "}"}]}], ",", "\n", "    ", 
         RowBox[{"k", " ", "=", " ", 
          RowBox[{"RandomReal", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"2", ",", " ", "4"}], "}"}]}], "]"}]}], ",", " ", 
         RowBox[{"ph", " ", "=", " ", 
          RowBox[{"RandomReal", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "3"}], ",", " ", "3"}], "}"}], ",", " ", "2"}], 
           "]"}]}]}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"a", "[", 
         RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", 
        RowBox[{
         RowBox[{"a", "[", 
          RowBox[{"[", "2", "]"}], "]"}], " ", 
         RowBox[{"Sin", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"k", "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", ".", " ", "xs"}], " ", "+", 
           " ", 
           RowBox[{"ph", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], " ", "+", " ", 
        RowBox[{
         RowBox[{"a", "[", 
          RowBox[{"[", "3", "]"}], "]"}], " ", 
         RowBox[{"Sin", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"k", "[", 
             RowBox[{"[", "2", "]"}], "]"}], " ", ".", " ", "xs"}], " ", "+", 
           " ", 
           RowBox[{"ph", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}]}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"the", " ", "isospin", " ", "rotation", " ", "U"}], " ", "=", 
      " ", 
      RowBox[{
       RowBox[{"exp", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"i", "/", "2"}], ")"}], " ", 
          RowBox[{"a", " ", ".", " ", "tau"}]}], ")"}]}], " ", "=", " ", 
       RowBox[{
        RowBox[{"cos", 
         RowBox[{"(", 
          RowBox[{"r", "/", "2"}], ")"}], " ", "1"}], " ", "+", " ", 
        RowBox[{"i", " ", "sin", 
         RowBox[{"(", 
          RowBox[{"r", "/", "2"}], ")"}], " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"a", " ", ".", " ", "tau"}], ")"}], "/", "r"}]}]}]}]}], ",",
      " ", 
     RowBox[{"r", " ", "=", " ", 
      RowBox[{"|", "a", "|"}]}], ",", " ", 
     RowBox[{"and", " ", "its", " ", "adjoint"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"aT", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"smooth", "[", "1.2", "]"}], ",", " ", 
       RowBox[{"{", "3", "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rT", " ", "=", " ", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"aT", " ", ".", " ", "aT"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"uT", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Cos", "[", 
        RowBox[{"rT", "/", "2"}], "]"}], " ", 
       RowBox[{"IdentityMatrix", "[", "2", "]"}]}], " ", "+", " ", 
      RowBox[{"I", " ", 
       RowBox[{"Sin", "[", 
        RowBox[{"rT", "/", "2"}], "]"}], " ", 
       RowBox[{
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"aT", "[", 
            RowBox[{"[", "i", "]"}], "]"}], " ", 
           RowBox[{"sig", "[", 
            RowBox[{"[", 
             RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", "3"}], "}"}]}], "]"}], "/", "rT"}]}]}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"uTdag", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Cos", "[", 
        RowBox[{"rT", "/", "2"}], "]"}], " ", 
       RowBox[{"IdentityMatrix", "[", "2", "]"}]}], " ", "-", " ", 
      RowBox[{"I", " ", 
       RowBox[{"Sin", "[", 
        RowBox[{"rT", "/", "2"}], "]"}], " ", 
       RowBox[{
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"aT", "[", 
            RowBox[{"[", "i", "]"}], "]"}], " ", 
           RowBox[{"sig", "[", 
            RowBox[{"[", 
             RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", "3"}], "}"}]}], "]"}], "/", "rT"}]}]}]}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"the", " ", "phase", " ", 
     RowBox[{"theta", "^", "F"}], " ", "of", " ", "U", 
     RowBox[{
      RowBox[{"(", "1", ")"}], "^", "F"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"thT", " ", "=", " ", 
     RowBox[{"smooth", "[", "0.3", "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"the", " ", "gauge", " ", 
       RowBox[{"fields", ":", " ", 
        RowBox[{"wT", "[", "p", "]"}]}]}], " ", "=", " ", 
      RowBox[{"sum_i", " ", 
       RowBox[{"W", "^", "i_p"}], " ", 
       RowBox[{"tau_i", "/", "2"}], " ", 
       RowBox[{"(", 
        RowBox[{"real", " ", "components"}], ")"}]}]}], ",", " ", 
     RowBox[{
      RowBox[{"bT", "[", "p", "]"}], " ", "=", " ", "B_p"}], ",", " ", 
     RowBox[{"p", " ", "=", " ", 
      RowBox[{
       RowBox[{"0", ".."}], "3"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"wComp", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"smooth", "[", "0.", "]"}], ",", " ", 
       RowBox[{"{", "4", "}"}], ",", " ", 
       RowBox[{"{", "3", "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"bComp", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"smooth", "[", "0.", "]"}], ",", " ", 
       RowBox[{"{", "4", "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"wT", "[", "p_", "]"}], " ", ":=", " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"wComp", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"p", " ", "+", " ", "1"}], ",", " ", "i"}], "]"}], "]"}], " ", 
        RowBox[{
         RowBox[{"sig", "[", 
          RowBox[{"[", 
           RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}], "/", "2"}]}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"bT", "[", "p_", "]"}], " ", ":=", " ", 
     RowBox[{"bComp", "[", 
      RowBox[{"[", 
       RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"dd", "[", 
      RowBox[{"f", ",", " ", "p"}], "]"}], ":", " ", 
     RowBox[{
     "the", " ", "derivative", " ", "with", " ", "respect", " ", "to", " ", 
      RowBox[{"x", "^", "p"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"dd", "[", 
      RowBox[{"f_", ",", " ", "p_"}], "]"}], " ", ":=", " ", 
     RowBox[{"D", "[", 
      RowBox[{"f", ",", " ", 
       RowBox[{"xs", "[", 
        RowBox[{"[", 
         RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"the", " ", "transformed", " ", "gauge", " ", "fields", " ", 
     RowBox[{"(", "4.5", ")"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"wTp", "[", "p_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"uT", " ", ".", " ", 
       RowBox[{"wT", "[", "p", "]"}], " ", ".", " ", "uTdag"}], " ", "+", " ", 
      RowBox[{
       RowBox[{"I", "/", "gvT"}], " ", 
       RowBox[{
        RowBox[{"dd", "[", 
         RowBox[{"uT", ",", " ", "p"}], "]"}], " ", ".", " ", "uTdag"}]}]}]}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"bTp", "[", "p_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"bT", "[", "p", "]"}], " ", "-", " ", 
      RowBox[{
       RowBox[{"dd", "[", 
        RowBox[{"thT", ",", " ", "p"}], "]"}], "/", "gfT"}]}]}], ";"}], "\n", 
   
   RowBox[{"(*", " ", 
    RowBox[{"the", " ", "test", " ", "spinor", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"eight", " ", "components"}], ",", " ", 
       RowBox[{"two", " ", "plane", " ", "waves"}]}], ")"}], " ", "and", " ", 
     "its", " ", "transform", " ", 
     RowBox[{"e", "^", 
      RowBox[{"(", 
       RowBox[{"i", " ", "theta"}], ")"}]}], " ", 
     RowBox[{"(", 
      RowBox[{"1", "_", "4", " ", 
       RowBox[{"(", "x", ")"}], " ", "U"}], ")"}], " ", "psi"}], " ", "*)"}], 
   "\n", 
   RowBox[{
    RowBox[{"kT", " ", "=", " ", 
     RowBox[{"RandomReal", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ampT", " ", "=", " ", 
     RowBox[{
      RowBox[{"RandomReal", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"8", ",", " ", "2"}], "}"}]}], "]"}], " ", "+", " ", 
      RowBox[{"I", " ", 
       RowBox[{"RandomReal", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"8", ",", " ", "2"}], "}"}]}], "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"psiT", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"ampT", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], " ", 
       RowBox[{"Exp", "[", 
        RowBox[{"I", " ", 
         RowBox[{
          RowBox[{"kT", "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", ".", " ", "xs"}]}], "]"}]}], 
      " ", "+", " ", 
      RowBox[{
       RowBox[{"ampT", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], " ", 
       RowBox[{"Exp", "[", 
        RowBox[{"I", " ", 
         RowBox[{
          RowBox[{"kT", "[", 
           RowBox[{"[", "2", "]"}], "]"}], " ", ".", " ", "xs"}]}], 
        "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"psiTp", " ", "=", " ", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{"I", " ", "thT"}], "]"}], " ", 
      RowBox[{
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{
         RowBox[{"IdentityMatrix", "[", "4", "]"}], ",", " ", "uT"}], "]"}], 
       " ", ".", " ", "psiT"}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"covPsi", "[", 
       RowBox[{"w", ",", " ", "b", ",", " ", "v", ",", " ", "p"}], "]"}], ":",
       " ", 
      RowBox[{"nabla_p", " ", "v"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"d_p", " ", "v"}], " ", "+", " ", 
      RowBox[{"i", " ", "g_v", " ", 
       RowBox[{"(", 
        RowBox[{"1", "_", "4", " ", 
         RowBox[{"(", "x", ")"}], " ", "W_p"}], ")"}], " ", "v"}], " ", "+", 
      " ", 
      RowBox[{"i", " ", "g_F", " ", "B_p", " ", "v"}]}]}], " ", "*)"}], "\n", 
   
   RowBox[{
    RowBox[{
     RowBox[{"covPsi", "[", 
      RowBox[{"w_", ",", " ", "b_", ",", " ", "v_", ",", " ", "p_"}], "]"}], 
     " ", ":=", " ", 
     RowBox[{
      RowBox[{"dd", "[", 
       RowBox[{"v", ",", " ", "p"}], "]"}], " ", "+", " ", 
      RowBox[{"I", " ", "gvT", " ", 
       RowBox[{
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{
          RowBox[{"IdentityMatrix", "[", "4", "]"}], ",", " ", 
          RowBox[{"w", "[", "p", "]"}]}], "]"}], " ", ".", " ", "v"}]}], " ", 
      "+", " ", 
      RowBox[{"I", " ", "gfT", " ", 
       RowBox[{"b", "[", "p", "]"}], " ", "v"}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "four", " ", "random", " ", "points", " ", "of", " ", "the", " ", 
     "test"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"ptsT", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Thread", "[", 
        RowBox[{"xs", " ", "->", " ", 
         RowBox[{"RandomReal", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "2"}], ",", " ", "2"}], "}"}], ",", " ", "4"}], 
          "]"}]}], "]"}], ",", " ", 
       RowBox[{"{", "4", "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
