          RowBox[{"gzResponse", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"mo40", "[", "\"\<g\>\"", "]"}], "[", "\"\<q\>\"", "]"}],
             ",", " ", 
            RowBox[{
             RowBox[{"mo40", "[", "\"\<g\>\"", "]"}], "[", "\"\<w\>\"", "]"}],
             ",", " ", "n40", ",", " ", 
            RowBox[{"gzTwist", "[", 
             RowBox[{"q", ",", " ", 
              RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}], ",", " ", 
            "tc"}], "]"}]}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", "  ", 
