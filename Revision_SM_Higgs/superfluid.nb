Cell[CellGroupData[{

Cell["R.1.10 The pair channels (checks WQN-10 and WQN-10e)", "Subsection",ExpressionUUID->"fa7e4ff0-b71b-4259-bf64-71e783a3b099"],

Cell[TextData[{
 "Each of the twelve spaces of invariant bilinears splits into a part of \
parity ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "66515506-cb42-4c4f-a3e4-a6b60b9f43a1"],
 " and one of parity ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2881de00-8297-4c3a-ba3a-dc6ceeb13687"],
 ", and each of the 24 parts must be mapped onto itself by every generator. \
On each part the code computes the content in multiplets of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["L", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bc7d9cbd-9a8d-4b36-8abe-2f122bb4f1c4"],
 " (from the eigenvalues ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["j", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["j", "TI"], "+", "1"}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "737a3794-0ffa-4d56-9b32-d31184ea4cba"],
 " of the Casimir operator, the dimension ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    StyleBox["j", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fb4b4aac-e2ec-4c47-b2f6-dfa78616ea94"],
 ") and the eigenvalues of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["Y", "TI"], 
    StyleBox["SM",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bfe0201f-117f-4abf-8e26-c1c9641b1861"],
 ", ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["Q", "TI"], 
    StyleBox["SM",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "19d5c7e3-45c0-44ae-9b47-39645ed0e171"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["F", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"], 
    StyleBox["tot",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "818b2775-7740-42d7-bda7-17c154d327dd"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a7aedf63-be20-4173-89d3-4804acf179e7"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"], 
    RowBox[{"3", ",", 
     StyleBox["R",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c321c9da-a83d-4ef7-8de0-d4fb648973c6"],
 ", and on the eight parts of the custodial sectors the multiplets of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["L", "TI"]], "\[Times]", 
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["R",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f2a54853-654c-4879-abea-930ddb618fc2"],
 " (the Casimir of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["R",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8869c56c-0a63-48b5-be75-f4f05c2f18b1"],
 " inside each eigenspace of that of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["L", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "528f6baf-144c-403f-a008-8d6fc2b1ee82"],
 "). The tables must equal those of the Rust program, which the data cell \
holds. ",
 StyleBox["What it means (WQN-10e).",
  FontWeight->"Bold"],
 " No pair of two particles of one field and no pair of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Chi]", 
    StyleBox["SH",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "853243ec-c48f-4555-8dc0-49ecfbbad836"],
 " with ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Chi]", 
    StyleBox["SH",
     FontSlant->"Plain"], "\[Prime]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4912a516-c710-40b6-94f8-723852baa583"],
 " has a neutral component, so a condensate of such pairs would carry \
electric charge and break ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["U", "TI"], 
    SubscriptBox[
     RowBox[{"(", "1", ")"}], 
     StyleBox["Q", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9e5c1209-509a-4666-826b-a7c7ce3d436d"],
 "; the only neutral pairs are those of a down particle with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Chi]", 
    StyleBox["SH",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4ae58d4f-38fc-48f2-b6d2-62ef1d400c5a"],
 " and of an up particle with ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Chi]", 
    StyleBox["SH",
     FontSlant->"Plain"], "\[Prime]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3b70578a-35a8-4c07-ac8c-b2de7f87bb78"],
 ", one in each of the channels ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPsi]", "\[Chi]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "58e52c6c-6425-45a1-937c-d92b9b94c34d"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPsi]", 
    SuperscriptBox["\[Chi]", "\[Prime]"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1086c1e9-e20e-403e-bcff-fca6a15ad77c"],
 ". These are the pairs that the hypotheses condense."
}], "Text",ExpressionUUID->"7a4c3c32-6887-4ab3-943d-593f086776c6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
