                RowBox[{"dirs", "[", 
                 RowBox[{"[", "d", "]"}], "]"}]}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"i", ",", " ", "nr"}], "}"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"d", ",", " ", "6"}], "}"}]}], "]"}], ",", " ", "1"}],
             "]"}]}], ",", "\n", "     ", 
          RowBox[{"\"\<w\>\"", " ", "->", " ", 
