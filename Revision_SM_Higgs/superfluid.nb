Cell[CellGroupData[{

Cell["R.1.10 The pair channels (checks WQN-10 and WQN-10e)", "Subsection",ExpressionUUID->"21d7a2f5-4c04-47bf-a7b5-59891164ea52"],

Cell[TextData[{
 "Each of the twelve spaces of invariant bilinears splits into a part of \
parity ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6c01a2a7-9f70-4592-8802-a2c60dac656d"],
 " and one of parity ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "05c1a6e2-4f1d-4793-865b-72697afebdb2"],
 ", and each of the 24 parts must be mapped onto itself by every generator. \
On each part the code computes the content in multiplets of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["L", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b5942ab8-50a8-4eef-9e7d-86e25b580e28"],
 " (from the eigenvalues ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["j", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["j", "TI"], "+", "1"}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6e135a39-91b1-4d67-a263-6893e7e0be2c"],
 " of the Casimir operator, the dimension ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    StyleBox["j", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a80973b6-d06c-455b-945e-caaa7458faab"],
 ") and the eigenvalues of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["Y", "TI"], 
    StyleBox["SM",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9ffe31e3-cd5f-4120-93fb-7f19c3879d74"],
 ", ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["Q", "TI"], 
    StyleBox["SM",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1b276dcd-5991-47be-a07c-dc14f2af982f"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["F", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"], 
    StyleBox["tot",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ec2df198-b86e-4372-8b1a-9729117fa1fc"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ae141560-46c1-4a06-8134-90b0d44a2bc6"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"], 
    RowBox[{"3", ",", 
     StyleBox["R",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0033108f-b9aa-40de-a22f-32e26f7936a4"],
 ", and on the eight parts of the custodial sectors the multiplets of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["L", "TI"]], "\[Times]", 
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["R",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "334fd870-d404-4161-aeb9-db07982a1b06"],
 " (the Casimir of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["R",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f7376992-bddd-4920-a02e-48610a21a86d"],
 " inside each eigenspace of that of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["L", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5e9ad631-34d3-460a-8ce4-29a48c316a58"],
 "). The tables must equal those of the Rust program, which the data cell \
holds. ",
 StyleBox["What it means (WQN-10e).",
  FontWeight->"Bold"],
 " No pair of two particles of one field and no pair of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Chi]", 
    StyleBox["SH",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f8d15891-d567-4fe6-a243-801a9fec1ba8"],
 " with ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Chi]", 
    StyleBox["SH",
     FontSlant->"Plain"], "\[Prime]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "62590d75-dec6-458b-90a3-934dc8d7768b"],
 " has a neutral component, so a condensate of such pairs would carry \
electric charge and break ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["U", "TI"], 
    SubscriptBox[
     RowBox[{"(", "1", ")"}], 
     StyleBox["Q", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fcbf98de-705a-4c99-81a9-44587de1fc39"],
 "; the only neutral pairs are those of a down particle with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Chi]", 
    StyleBox["SH",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4ec52782-2cb4-4c7a-8edd-b06c519cd33b"],
 " and of an up particle with ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Chi]", 
    StyleBox["SH",
     FontSlant->"Plain"], "\[Prime]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "be411637-7108-4cfd-b996-c19c81ed4777"],
 ", one in each of the channels ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPsi]", "\[Chi]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "83beb18f-f090-4bab-afe6-2075a0a18470"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPsi]", 
    SuperscriptBox["\[Chi]", "\[Prime]"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2b509533-48d5-481b-86f0-e97b6f2a8c24"],
 ". These are the pairs that the hypotheses condense."
}], "Text",ExpressionUUID->"4fcdfd03-265a-4988-97cf-8337f73703d9"],

