Cell[CellGroupData[{

Cell["\<\
R.4.5 The pseudospins of the pairing-only method (check WD-5)\
\>", "Subsection",ExpressionUUID->"2457f257-ea4a-48df-b98a-798aeba2b70b"],

Cell[TextData[{
 "In HS (0, 0) the whole dynamics of the runs reduces to Anderson \
pseudospins, the classical picture of the theory of Bardeen, Cooper and \
Schrieffer. For every radial node ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["q", "TI"], 
    StyleBox["i", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "799b3c58-77d3-430c-aba2-f2b320b5dac6"],
 " of the grid there are two unit vectors, one for the particles and one for \
the antiparticles, each precessing in its own field:"
}], "Text",ExpressionUUID->"df56ade4-673d-403f-bbcc-1ea89a27dcaa"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    RowBox[{
     StyleBox["d", "TI"], 
     SubsuperscriptBox[
      StyleBox["n",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      StyleBox["SH",
       FontSlant->"Plain"], "\[PlusMinus]"]}], 
    StyleBox["dt", "TI"]], "\[LongEqual]", "2", "\[ThinSpace]", 
   SubsuperscriptBox[
    StyleBox["b",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    StyleBox["SH",
     FontSlant->"Plain"], "\[PlusMinus]"], "\[Times]", 
   SubsuperscriptBox[
    StyleBox["n",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    StyleBox["SH",
     FontSlant->"Plain"], "\[PlusMinus]"], ",", "      ", 
   SubsuperscriptBox[
    StyleBox["b",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    StyleBox["SH",
     FontSlant->"Plain"], "\[PlusMinus]"], "\[LongEqual]", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", 
      StyleBox["Re",
       FontSlant->"Plain"]}], "\[ThinSpace]", 
     SubscriptBox["\[CapitalDelta]", 
      StyleBox["SH",
       FontSlant->"Plain"]], ",", " ", 
     StyleBox["Im",
      FontSlant->"Plain"], "\[ThinSpace]", 
     SubscriptBox["\[CapitalDelta]", 
      StyleBox["SH",
       FontSlant->"Plain"]], ",", " ", 
     RowBox[{"\[PlusMinus]", 
      SubscriptBox["\[CurlyEpsilon]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], 
     RowBox[{"(", 
      SubscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["i", "TI"]], ")"}]}], ")"}], ",", "      ", 
   SubscriptBox["\[CapitalDelta]", 
    StyleBox["SH",
     FontSlant->"Plain"]], "\[LongEqual]", 
   FractionBox[
    SubscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]], "2"], "\[LongEqual]", 
   FractionBox[
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]], "2"], "\[ThinSpace]", 
   UnderscriptBox["\[Sum]", 
    StyleBox["i", "TI"],
    LimitsPositioning->True], "\[ThinSpace]", 
   FractionBox[
    SubscriptBox[
     StyleBox["w", "TI"], 
     StyleBox["i", "TI"]], "2"], 
   RowBox[{"(", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["n", "TI"], 
      RowBox[{
       StyleBox["SH",
        FontSlant->"Plain"], ",", 
       StyleBox["i", "TI"]}], 
      RowBox[{"+", ",", 
       StyleBox["x", "TI"]}]], "+", 
     SubsuperscriptBox[
      StyleBox["n", "TI"], 
      RowBox[{
       StyleBox["SH",
        FontSlant->"Plain"], ",", 
       StyleBox["i", "TI"]}], 
      RowBox[{"-", ",", 
       StyleBox["x", "TI"]}]], "-", 
     StyleBox["i", "TI"], 
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["n", "TI"], 
        RowBox[{
         StyleBox["SH",
          FontSlant->"Plain"], ",", 
         StyleBox["i", "TI"]}], 
        RowBox[{"+", ",", 
         StyleBox["y", "TI"]}]], "+", 
       SubsuperscriptBox[
        StyleBox["n", "TI"], 
        RowBox[{
         StyleBox["SH",
          FontSlant->"Plain"], ",", 
         StyleBox["i", "TI"]}], 
        RowBox[{"-", ",", 
         StyleBox["y", "TI"]}]]}], ")"}]}], ")"}], ","}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"133bffff-ff64-499c-986e-34bbcce4415a"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CurlyEpsilon]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        StyleBox["q", "TI"], "2"], "+", 
       SubsuperscriptBox[
        StyleBox["m", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], "2"]}], ")"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0d252a75-198b-4a52-b9bf-e305d1bf581e"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["w", "TI"], 
    StyleBox["i", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5b5c3c4a-f3ae-4098-9592-b687e3d69061"],
 " the weight of the node times ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["i", "TI"], "2"], "/", 
    RowBox[{"(", 
     RowBox[{"2", 
      SuperscriptBox["\[Pi]", "2"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a758c406-e000-46c0-a9dd-8958635371a5"],
 ". At ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["t", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7ef99d8e-f870-481a-8797-025dd9be98c1"],
 " each vector points against its field; for the ground state this is the gap \
equation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["G", "TI"], 
       StyleBox["SH",
        FontSlant->"Plain"]], "/", "2"}], ")"}], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", 
     StyleBox["i", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["w", "TI"], 
     StyleBox["i", "TI"]], "/", 
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["i", "TI"]], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "76608c41-6e75-4259-865c-e89bd28830cd"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["i", "TI"]], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[CurlyEpsilon]", 
        StyleBox["LL",
         FontSlant->"Plain"]], 
       SuperscriptBox[
        RowBox[{"(", 
         SubscriptBox[
          StyleBox["q", "TI"], 
          StyleBox["i", "TI"]], ")"}], "2"], "+", 
       SubsuperscriptBox["\[CapitalDelta]", 
        StyleBox["SH",
         FontSlant->"Plain"], "2"]}], ")"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b21ff742-c692-444c-9c9b-bb25ad6eef3c"],
 ", whose solution is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["SH",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], "0"], "/", "2"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c4fe31d5-76cc-4fec-ad14-67161380287c"],
 ", and a kicked state starts with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["SH",
      FontSlant->"Plain"]], 
    RowBox[{"(", "0", ")"}], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      SubsuperscriptBox["\[Epsilon]", 
       StyleBox["SH",
        FontSlant->"Plain"], 
       StyleBox["kick",
        FontSlant->"Plain"]]}], ")"}], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], "0"], "/", "2"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e5229710-96e8-4cc6-b177-7c365bb17cc1"],
 ". The cell integrates the 48 pseudospins with ",
 StyleBox["NDSolve",
  FontFamily->"Source Code Pro"],
 " and the method IDA of SUNDIALS and compares ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["t", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e09174d3-142d-4b17-af84-f65546d760b2"],
 " with that of the Rust program, which evolves all sixteen components at 144 \
momenta, for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "\[LessEqual]", 
    StyleBox["t", "TI"], "\[LessEqual]", "50"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b30a44a5-b05e-40b8-a6c2-de66a35353d5"],
 ". ",
 StyleBox["Where it comes from.",
  FontWeight->"Bold"],
 " This reduction was found by comparing it with the full computation, not by \
deriving it. Both kinds of pseudospin are needed: with the particles alone \
the phase of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalDelta]", 
    StyleBox["SH",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fcaeb579-c7a6-4ce8-824d-b5c5a99e2838"],
 " drifts, which the full computation does not show. ",
 StyleBox["Why it matters.",
  FontWeight->"Bold"],
 " Its linearization is the response of the theory of Bardeen, Cooper and \
Schrieffer, whose amplitude mode lies at twice the gap parameter, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["SH",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], "0"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0338b2d0-c021-43c3-87c4-63e2f6b6a5bd"],
 ": the reduced model explains why the pairing-only methods put the candidate \
for the Higgs boson exactly at ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["d", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"], "0"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9e23c600-9eef-4b5d-9f6e-101270891f74"],
 ", undamped."
}], "Text",ExpressionUUID->"66ea9ae1-817c-4481-b7e1-87a049eba09a"],

