       RowBox[{"{", 
        RowBox[{"\"\<pa\>\"", ",", " ", "\"\<chi\>\"", ",", 
         " ", "\"\<chi\>\""}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<pa\>\"", ",", " ", "\"\<chi\>\"", ",", 
