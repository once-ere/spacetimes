Cell[CellGroupData[{

Cell["\<\
R.3.6 Remark R12: the second version has the scalars of two Higgs doublets\
\>", "Subsection",ExpressionUUID->"8f1cbf7a-0c55-42ee-8270-1d6c0516dd75"],

Cell[TextData[{
 StyleBox["The remark.",
  FontWeight->"Bold"],
 " The four complex pair fields of the second version, the bidoublet, have \
eight real directions of fluctuation around the vacuum ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Phi]", "\[ThinSpace]", 
    StyleBox["i", "TI"], 
    SuperscriptBox["\[Tau]", "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bfb9f699-7427-4c29-ad70-86e1e1da61fc"],
 ". Four are Goldstone modes: three are absorbed by ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["W", "TI"], "\[Mu]", "\[PlusMinus]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3d8edc5f-b7af-423c-9995-29b34a91d0ef"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["Z", "TI"], "\[Mu]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f3fffa18-0592-4c8a-823f-62a5f48a7bcd"],
 ", and the fourth belongs to the broken particle number ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["F", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"], 
    StyleBox["tot",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0765549f-7215-46ce-8c98-1bd81b56fdb7"],
 " (decision D32). The other four are massive: the amplitude mode, a singlet \
of the custodial group ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["V",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "69d1c0da-8860-43e6-a6f4-aab9550b5795"],
 ", and a triplet of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["V",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "90d5baa4-a132-4499-822a-138756ad0728"],
 ", one neutral and one charged pair. This is the scalar content of a model \
with two Higgs doublets, and in the pairing-only methods the four massive \
modes are degenerate at ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["d", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"], "0"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1064a11d-622e-4f84-aac1-f961e5d1e092"],
 ". ",
 StyleBox["The computation.",
  FontWeight->"Bold"],
 " Write a fluctuation of the bidoublet as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", 
    StyleBox["\[ScriptCapitalM]",
     FontSlant->"Plain"], "\[LongEqual]", 
    StyleBox["X", "TI"], "\[ThinSpace]", 
    StyleBox["i", "TI"], 
    SuperscriptBox["\[Tau]", "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8d928c54-35ec-4eb9-966e-9a51cccc5804"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["X", "TI"], "\[LongEqual]", "\[Sigma]", 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "2"], "+", 
    StyleBox["i", "TI"], 
    OverscriptBox["\[Pi]", "\[RightVector]"], "\[CenterDot]", 
    OverscriptBox["\[Tau]", "\[RightVector]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "19e11570-9739-4e70-b662-09ef1c9e1373"],
 ", ",
 Cell[BoxData[
  FormBox["\[Sigma]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4aebfda9-e69d-43dc-9fe7-6723a79d4fec"],
 " and ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[Pi]", "\[RightVector]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8cd4599e-4a1a-4f0c-b70f-465c6c59d392"],
 " complex. The custodial group acts as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["\[ScriptCapitalM]",
     FontSlant->"Plain"], "\[RightArrow]", 
    StyleBox["L", "TI"], 
    StyleBox["\[ScriptCapitalM]",
     FontSlant->"Plain"], 
    SuperscriptBox[
     StyleBox["R", "TI"], 
     StyleBox["T", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e9018e66-9151-4e95-ad5b-83976fd02b3a"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["L", "TI"], "\[LongEqual]", 
    StyleBox["R", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ef4c182a-6941-43de-b2c4-d059f2658426"],
 ", which keeps ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["i", "TI"], 
    SuperscriptBox["\[Tau]", "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "91ff5f63-e961-4214-b5c8-84cf365d6d23"],
 ", and on ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8f3dbef7-bd24-4bdb-aa78-fb24f1403014"],
 " as the adjoint, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["X", "TI"], "\[RightArrow]", 
    StyleBox["LX", "TI"], 
    SuperscriptBox[
     StyleBox["L", "TI"], 
     RowBox[{"-", "1"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bff81c1c-8ae4-4033-8fca-8916adad9476"],
 ": ",
 Cell[BoxData[
  FormBox["\[Sigma]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0f46e915-095f-4365-9dbf-0c5ec1854d26"],
 " is a singlet and ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[Pi]", "\[RightVector]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5e9c2ecf-ed81-40d6-9710-2841c1721bf9"],
 " a triplet. The next cell computes the Casimir operator of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["V",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0ebcc862-4a45-441a-8f9d-4fc26d9d6080"],
 " on the eight real directions, finds which of them the broken generators \
produce from the vacuum (the Goldstone directions), and the charges of the \
triplet. The degeneracy of the triplet with the amplitude mode is computed by \
the Python check YH-8 (four eigenvalues equal to 1 of the response at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Omega]", "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "16f10b8d-b52c-4006-9284-49f346f7eb98"],
 " and four at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Omega]", "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], "0"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f03418f7-6196-46bd-9aa1-e355b8e537ce"],
 ", with the Casimir values 0, 2, 2, 2 of the massive ones) and seen in the \
time domain by the Rust check D-5 (Section R.4). ",
 StyleBox["Why it matters.",
  FontWeight->"Bold"],
 " (1) The two versions fail in opposite ways: the first has the scalar \
content of the Standard Model (three Goldstone modes and one amplitude mode) \
but a ratio ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Rho]", 
    StyleBox["SH",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "54caf98f-9afd-4bb1-a3c1-996796e199bf"],
 " different from 1, which the measured ",
 Cell[BoxData[
  FormBox["\[Rho]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "19e752a1-b50b-4d32-bcee-a3c212adef12"],
 " excludes; the second has ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Rho]", 
     StyleBox["SH",
      FontSlant->"Plain"]], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a87e2664-d293-4a49-a530-2b73e854855e"],
 " exactly but twice the scalar content, three more massive scalars and one \
massless Goldstone boson. (2) The triplet is a prediction: in the \
pairing-only methods it is degenerate with the candidate for the Higgs boson, \
and the dynamics in time shows that the scalar and the vector terms split it \
from the singlet, by about 2 per cent in HS (1, 1) and by about half a per \
cent, downwards, in KS and CJT (Section R.4); whether the fluctuations beyond \
the mean field split it further is not computed. (3) It is the structure of a \
model with two Higgs doublets, in which the custodial symmetry of the scalar \
potential likewise groups the extra scalars into multiplets of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["V",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e2e6a091-0b87-4562-8b56-223cbf0121c0"],
 "; here the pairing-only methods make all four massive modes degenerate, \
because the pairing terms act on the four complex pair fields alike."
}], "Text",ExpressionUUID->"743226d8-b308-4925-8937-41a98ff7b37d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"--", " ", "remark"}]}], " ", 
    RowBox[{"R12", ":", " ", 
     RowBox[{
     "the", " ", "eight", " ", "real", " ", "directions", " ", "of", " ", "a",
       " ", "fluctuation", " ", "of", " ", "the", " ", "bidoublet", " ", 
      "around", " ", "phi", " ", "i", " ", 
      RowBox[{"tau", "^", 
       RowBox[{
        RowBox[{"2", " ", "--"}], "--"}]}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"r12Tau", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "0"}], "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", 
           RowBox[{"-", "I"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"I", ",", " ", "0"}], "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", 
           RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"r12Eps", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "0"}], "}"}]}], "}"}]}], ";"}], 
   "                                 ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"i", " ", 
      RowBox[{"tau", "^", "2"}]}], ",", " ", 
     RowBox[{
      RowBox[{"the", " ", "vacuum", " ", "with", " ", "phi"}], " ", "=", " ", 
      "1"}]}], " ", "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", "directions", " ", "delta", " ", "M"}], " ", "=", 
     " ", 
     RowBox[{
      RowBox[{"X", " ", "i", " ", 
       RowBox[{"tau", "^", "2"}], " ", "with", " ", "X"}], " ", "=", " ", 
      RowBox[{
       RowBox[{"sigma", " ", "1"}], " ", "+", " ", 
       RowBox[{"i", " ", 
        RowBox[{"pi", ".", 
         RowBox[{"tau", ":", " ", 
          RowBox[{
          "the", " ", "real", " ", "and", " ", "imaginary", " ", "parts", " ",
            "of", " ", "sigma", " ", "and", " ", 
           RowBox[{"pi", "^", "a"}]}]}]}]}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"r12Dirs", " ", "=", " ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\"\<Re sigma\>\"", ",", " ", 
           RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<Im sigma\>\"", ",", " ", 
           RowBox[{"I", " ", 
            RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], "}"}]}], "}"}], ",",
        "\n", "   ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\"\<Re pi^\>\"", " ", "<>", " ", 
            RowBox[{"ToString", "[", "a", "]"}]}], ",", " ", 
           RowBox[{"I", " ", 
            RowBox[{"r12Tau", "[", 
             RowBox[{"[", "a", "]"}], "]"}]}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"a", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\"\<Im pi^\>\"", " ", "<>", " ", 
            RowBox[{"ToString", "[", "a", "]"}]}], ",", " ", 
           RowBox[{"-", 
            RowBox[{"r12Tau", "[", 
             RowBox[{"[", "a", "]"}], "]"}]}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"a", ",", " ", "3"}], "}"}]}], "]"}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "custodial", " ", "generators", " ", "on", " ", "the", " ", 
      "bidoublet"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"T", "^", "a"}], " ", "+", " ", 
       RowBox[{"T", "^", 
        RowBox[{"a_R", ":", " ", "M"}]}]}], " ", "->", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"tau", "^", "a"}], "/", "2"}], ")"}], " ", "M"}], " ", "+", 
       " ", 
       RowBox[{"M", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"tau", "^", "a"}], "/", "2"}], ")"}], "^", "T"}]}]}]}], ",",
      " ", 
     RowBox[{"and", " ", "their", " ", "Casimir"}]}], " ", "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"the", " ", "parentheses", " ", 
     RowBox[{"matter", ":", " ", 
      RowBox[{"the", " ", 
       RowBox[{"product", " ", ".", " ", "binds"}], " ", "more", " ", 
       "strongly", " ", "than", " ", "the", " ", 
       RowBox[{"division", " ", "/"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"r12Tv", "[", 
      RowBox[{"a_", ",", " ", "m_"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"r12Tau", "[", 
          RowBox[{"[", "a", "]"}], "]"}], "/", "2"}], ")"}], " ", ".", " ", 
       "m"}], " ", "+", " ", 
      RowBox[{"m", " ", ".", " ", 
       RowBox[{"Transpose", "[", 
        RowBox[{
         RowBox[{"r12Tau", "[", 
          RowBox[{"[", "a", "]"}], "]"}], "/", "2"}], "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"r12Cas", "[", "m_", "]"}], " ", ":=", " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"r12Tv", "[", 
        RowBox[{"a", ",", " ", 
         RowBox[{"r12Tv", "[", 
          RowBox[{"a", ",", " ", "m"}], "]"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "the", " ", "real", " ", "vector", " ", "of", " ", "a", " ", "complex", " ",
      "2", " ", "x", " ", "2", " ", "matrix"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"r12Vec", "[", "m_", "]"}], " ", ":=", " ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Re", "[", 
        RowBox[{"Flatten", "[", "m", "]"}], "]"}], ",", " ", 
       RowBox[{"Im", "[", 
        RowBox[{"Flatten", "[", "m", "]"}], "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "directions", " ", "that", " ", "the", " ", "broken", " ", 
      "generators", " ", "produce", " ", "from", " ", "the", " ", "vacuum"}], 
     ",", " ", 
     RowBox[{
      RowBox[{"delta", " ", "M"}], " ", "=", " ", 
      RowBox[{"i", " ", "G", " ", 
       RowBox[{"M", ":", " ", 
        RowBox[{
         RowBox[{"T", "^", "a"}], " ", 
         RowBox[{"(", 
          RowBox[{"on", " ", "the", " ", "left"}], ")"}]}]}]}]}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"T", "^", "a_R"}], " ", 
       RowBox[{"(", 
        RowBox[{"on", " ", "the", "\n", "   ", "right"}], ")"}], " ", "and", " ",
        "F_tot", " ", 
       RowBox[{"(", 
        RowBox[{"charge", " ", "2", " ", "on", " ", "the", " ", "bidoublet"}],
         ")"}]}], ";", " ", 
      RowBox[{
      "R", " ", "is", " ", "zero", " ", "on", " ", "the", " ", 
       "bidoublet"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"r12Broken", " ", "=", " ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"I", " ", 
            RowBox[{
             RowBox[{"r12Tau", "[", 
              RowBox[{"[", "a", "]"}], "]"}], "/", "2"}]}], ")"}], " ", ".", 
          " ", "r12Eps"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"a", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"I", " ", 
          RowBox[{"r12Eps", " ", ".", " ", 
           RowBox[{"Transpose", "[", 
            RowBox[{
             RowBox[{"r12Tau", "[", 
              RowBox[{"[", "a", "]"}], "]"}], "/", "2"}], "]"}]}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"a", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", " ", "I", " ", "r12Eps"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"r12Rank", " ", "=", " ", 
     RowBox[{"MatrixRank", "[", 
      RowBox[{"r12Vec", " ", "/@", " ", "r12Broken"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"r12Rows", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"m", " ", "=", " ", 
            RowBox[{
             RowBox[{"d", "[", 
              RowBox[{"[", "2", "]"}], "]"}], " ", ".", " ", "r12Eps"}]}], ",",
            " ", "cas", ",", " ", "c", ",", " ", "gold"}], "}"}], ",", "\n", 
         "    ", 
         RowBox[{
          RowBox[{"cas", " ", "=", " ", 
           RowBox[{"r12Cas", "[", "m", "]"}]}], ";", "\n", "    ", 
          RowBox[{"c", " ", "=", " ", 
           RowBox[{"Which", "[", 
            RowBox[{
             RowBox[{"cas", " ", "==", " ", 
              RowBox[{"0", " ", "m"}]}], ",", " ", "0", ",", " ", 
             RowBox[{"cas", " ", "==", " ", 
              RowBox[{"2", " ", "m"}]}], ",", " ", "2", ",", " ", "True", ",",
              " ", "\"\<none\>\""}], "]"}]}], ";", "\n", "    ", 
          RowBox[{"gold", " ", "=", " ", 
           RowBox[{
            RowBox[{"MatrixRank", "[", 
             RowBox[{"Append", "[", 
              RowBox[{
               RowBox[{"r12Vec", " ", "/@", " ", "r12Broken"}], ",", " ", 
               RowBox[{"r12Vec", "[", "m", "]"}]}], "]"}], "]"}], " ", "==", 
            " ", "r12Rank"}]}], ";", "\n", "    ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"d", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", " ", "c", ",", " ", 
            RowBox[{"If", "[", 
             RowBox[{
             "gold", ",", " ", "\"\<Goldstone\>\"", ",", 
              " ", "\"\<massive\>\""}], "]"}]}], "}"}]}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"d", ",", " ", "r12Dirs"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<the broken generators produce \>\"", ",", " ", "r12Rank", ",",
       " ", "\"\< independent directions\>\""}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"Grid", "[", 
      RowBox[{
       RowBox[{"Prepend", "[", 
        RowBox[{"r12Rows", ",", " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<direction\>\"", ",", " ", "\"\<Casimir of SU(2)_V\>\"",
            ",", " ", "\"\<mode\>\""}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
       RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}], "]"}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"the", " ", "charge", " ", "Q"}], " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"T", "^", "3"}], " ", "+", " ", 
         RowBox[{
          RowBox[{"T", "^", "3"}], "_R"}], " ", "+", " ", 
         RowBox[{
          RowBox[{"R", "/", "4"}], " ", "on", " ", "the", " ", "bidoublet", " ", 
          RowBox[{"(", 
           RowBox[{"R", " ", "=", " ", "0"}], ")"}]}]}], ":", " ", 
        RowBox[{"the", " ", "custodial", " ", 
         RowBox[{"T", "^", "3"}]}]}]}], ";", " ", 
      RowBox[{
       RowBox[{
       "on", " ", "the", " ", "massive", " ", "triplet", "\n", "   ", "X"}], 
       " ", "=", " ", 
       RowBox[{"-", 
        RowBox[{"tau", "^", 
         RowBox[{"+", "-"}]}]}]}]}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"tau", "^", "3"}]}], " ", "with", " ", 
       RowBox[{"tau", "^", 
        RowBox[{"+", "-"}]}]}], " ", "=", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"tau", "^", "1"}], " ", "+", 
         RowBox[{
          RowBox[{"-", " ", "i"}], " ", 
          RowBox[{"tau", "^", "2"}]}]}], ")"}], "/", "2"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"r12Trip", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<-(tau^1 + i tau^2)/2\>\"", ",", " ", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"r12Tau", "[", 
              RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", 
             RowBox[{"I", " ", 
              RowBox[{"r12Tau", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}]}], ")"}]}], "/", "2"}]}], 
        "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<-tau^3\>\"", ",", " ", 
         RowBox[{"-", 
          RowBox[{"r12Tau", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}]}], "}"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<-(tau^1 - i tau^2)/2\>\"", ",", " ", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"r12Tau", "[", 
              RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", 
             RowBox[{"I", " ", 
              RowBox[{"r12Tau", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}]}], ")"}]}], "/", "2"}]}], 
        "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<the charges of the massive triplet: \>\"", ",", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"m", " ", "=", " ", 
             RowBox[{
              RowBox[{"t", "[", 
               RowBox[{"[", "2", "]"}], "]"}], " ", ".", " ", "r12Eps"}]}], ",",
             " ", "q"}], "}"}], ",", "\n", "     ", 
          RowBox[{
           RowBox[{"q", " ", "=", " ", 
            RowBox[{"Select", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "1"}], ",", " ", "0", ",", " ", "1"}], "}"}], ",",
               " ", 
              RowBox[{
               RowBox[{
                RowBox[{"r12Tv", "[", 
                 RowBox[{"3", ",", " ", "m"}], "]"}], " ", "==", " ", 
                RowBox[{"#", " ", "m"}]}], " ", "&"}]}], "]"}]}], ";", " ", 
           RowBox[{
            RowBox[{"t", "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", "->", " ", 
            RowBox[{"First", "[", "q", "]"}]}]}]}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"t", ",", " ", "r12Trip"}], "}"}]}], "]"}]}], "]"}], 
    ";"}]}]}]], "Input",
 CellLabel->
  "In[700]:=",ExpressionUUID->"8b9f35be-3150-4e2d-bf3a-86b20a79813b"],

