          RowBox[{"\"\<q\>\"", " ", "->", " ", 
           RowBox[{"Flatten", "[", 
            RowBox[{
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"kr", "[", 
