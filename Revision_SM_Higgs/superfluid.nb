Cell[CellGroupData[{

Cell["R.1.5 The anomalies (check WQN-5)", "Subsection",ExpressionUUID->"6ca48c74-46ff-4b6c-9c3f-2df2b3036341"],

Cell[TextData[{
 "A gauge theory is consistent only if the triangle anomalies of its gauged \
currents cancel. For Dirac fields the anomaly traces are traces with the \
chirality, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["\[Gamma]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["ch",
        FontSlant->"Plain"]], 
      SuperscriptBox[
       StyleBox["Y", "TI"], "3"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "457d2ab3-cc44-44c8-b69e-a40b90129f9d"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["\[Gamma]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["ch",
        FontSlant->"Plain"]], 
      StyleBox["Y", "TI"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "db447d03-4594-4a35-bd9b-d989b2640586"],
 " (the mixed anomaly with gravity), ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["\[Gamma]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["ch",
        FontSlant->"Plain"]], 
      RowBox[{"{", 
       RowBox[{
        SuperscriptBox[
         StyleBox["T", "TI"], 
         StyleBox["a", "TI"]], ",", 
        SuperscriptBox[
         StyleBox["T", "TI"], 
         StyleBox["b", "TI"]]}], "}"}], 
      StyleBox["Y", "TI"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "143e0b82-c6cb-42e9-ab9b-1943a1261d64"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["\[Gamma]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["ch",
        FontSlant->"Plain"]], 
      SuperscriptBox[
       StyleBox["Y", "TI"], "2"], 
      SuperscriptBox[
       StyleBox["T", "TI"], 
       StyleBox["a", "TI"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "656b165a-16cf-4ff9-a505-7fc90bea6a45"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["\[Gamma]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["ch",
        FontSlant->"Plain"]], 
      SuperscriptBox[
       StyleBox["T", "TI"], 
       StyleBox["a", "TI"]], 
      RowBox[{"{", 
       RowBox[{
        SuperscriptBox[
         StyleBox["T", "TI"], 
         StyleBox["b", "TI"]], ",", 
        SuperscriptBox[
         StyleBox["T", "TI"], 
         StyleBox["c", "TI"]]}], "}"}]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0f9e86ab-ea1f-4100-baa8-0aa11a5575f1"],
 ", with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["a", "TI"]], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["T", "TI"], 
     RowBox[{
      StyleBox["a", "TI"], ",", 
      StyleBox["SM",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c43d8085-c3e7-432a-8de7-3326a75694da"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Y", "TI"], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["Y", "TI"], 
     StyleBox["SM",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3506a8ea-ac4d-4206-8216-04fe0f5042e4"],
 ". The fields of the hypotheses are vector-like: ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], "0"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c1a49b1d-abb5-40fc-a222-31c2d5e20c96"],
 ", which exchanges the two chiralities, commutes with every internal \
generator, so both chiralities carry the same charges and every trace \
vanishes. The global anomaly of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    RowBox[{"(", "2", ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "375ae9c4-6328-4057-885c-0d76bcfe82a6"],
 " (Witten's) requires an even number of Weyl doublets of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["L", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5240dec2-d13f-43aa-a0ef-c450b9edb682"],
 "; the isodoublet ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f6a4c736-91c8-44fd-baad-4f4f2dd6879e"],
 " gives two (one of each chirality)."
}], "Text",ExpressionUUID->"432428fb-4647-47d9-8231-8d4bbada69b1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
