Cell[CellGroupData[{

Cell["R.4.3 The amplitude mode in the time domain (check WD-3)", "Subsection",ExpressionUUID->"4fd861c9-1666-42e0-9ca2-9cf2812e2d90"],

Cell[TextData[{
 "In the pairing-only methods the linear response puts the amplitude mode \
exactly at ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["d", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"], "0"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3af72200-ccb3-48f3-b9a4-7edda1ef6fa7"],
 " (remark R11). The cell solves the gap equation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["G", "TI"], 
       StyleBox["SH",
        FontSlant->"Plain"]], "/", "4", 
      SuperscriptBox["\[Pi]", "2"]}], ")"}], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["I", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{"(", "1", ")"}]], 
    RowBox[{"(", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox[
         StyleBox["m", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], "2"], "+", 
        SuperscriptBox[
         RowBox[{"(", 
          SubsuperscriptBox[
           StyleBox["d", "TI"], 
           StyleBox["SH",
            FontSlant->"Plain"], "0"], ")"}], "2"], "/", "4"}], ")"}], 
      RowBox[{"1", "/", "2"}]], ")"}], "\[LongEqual]", "1"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1e389b8f-db67-4d16-be7a-67554554a3d0"],
 " with 40 digits and compares the peaks of the spectra of the amplitude runs \
of HS (0, 1) and HS (0, 0) of the Rust program, both versions, with ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["d", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"], "0"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "37a41a3a-1498-4185-a772-cd8cd3aca18d"],
 ". The difference, of the order of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "6"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bf376b62-8c80-45f3-819c-d590e64dd5db"],
 ", is of the order of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox["\[Epsilon]", 
      StyleBox["SH",
       FontSlant->"Plain"], 
      StyleBox["kick",
       FontSlant->"Plain"]], ")"}], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b61ca135-90f8-47aa-9cf2-7c12e937cba3"],
 ", the size of the first correction to a linear oscillation."
}], "Text",ExpressionUUID->"5d3857b0-1c88-4e7f-bfeb-d9c1cbf95066"],

