       RowBox[{"1", " ", "+", " ", "kick"}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nx0", " ", "=", " ", 
     RowBox[{"dli", "/", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"eps2", "^", "2"}], " ", "+", " ", 
        RowBox[{"dli", "^", "2"}]}], "]"}]}]}], ";", " ", 
    RowBox[{"nz0", " ", "=", " ", 
     RowBox[{
      RowBox[{"-", "eps2"}], "/", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"eps2", "^", "2"}], " ", "+", " ", 
