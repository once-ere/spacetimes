Cell[CellGroupData[{

Cell["\<\
I.4 The gauge group GEE and its covariant derivatives (item 3)\
\>", "Section",ExpressionUUID->"6d92642e-8761-45ea-a82e-64d920d6dee2"],

Cell[TextData[{
 "The gauge group is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["GEE",
     FontSlant->"Plain"], "\[LongEqual]", 
    StyleBox["SL", "TI"], 
    RowBox[{"(", 
     RowBox[{"2", ",", 
      StyleBox["\[DoubleStruckCapitalC]",
       FontSlant->"Plain"]}], ")"}], "\[Times]", 
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["v",
      FontSlant->"Plain"]], "\[Times]", 
    StyleBox["U", "TI"], 
    SubsuperscriptBox[
     RowBox[{"(", "1", ")"}], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "59e6f09f-34ee-4044-9470-1d5a31711365"],
 ". A local transformation is a unit bi-quaternion ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["g",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     StyleBox["x", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8132f4b1-ce74-42f2-8aca-208658b039de"],
 ", an isospin rotation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["U",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["x", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5255d2e4-3e3e-4d06-8de3-7f7f8a6f65cc"],
 " and a phase ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Theta]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["x", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1f54981e-7162-4bc7-92ac-60681e089b63"],
 "; it acts on the spinor field as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[RightTeeArrow]", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      StyleBox["i", "TI"], 
      SubsuperscriptBox["\[Theta]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["F",
        FontSlant->"Plain"]]}]], 
    SubscriptBox[
     StyleBox["S",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[CircleTimes]", 
    SubscriptBox[
     StyleBox["U",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[ThinSpace]", 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7e01da88-968a-48f3-9c0a-5c0334f4f2cf"],
 ". The gauge fields are the Lorentz connection with the spin connection ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalGamma]", 
    StyleBox["p", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "86cfb6a3-8e36-44d6-bdbd-b50dcec74796"],
 ", the field of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["v",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ce12f0b8-aa94-45c8-96c2-90001a54c6a6"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["W",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}]], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", "\[Iota]",
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["W", "TI"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], "\[Iota]"], 
    SubsuperscriptBox["\[Tau]", "\[Iota]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "/", "2"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "674b9b15-2b30-40fd-9989-4af2ea0d639d"],
 ", and the field ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["B", "TI"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "571d476d-9383-4bcc-9317-02276ca367ed"],
 " of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["U", "TI"], 
    SubsuperscriptBox[
     RowBox[{"(", "1", ")"}], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "91d7c9b4-030d-46ab-b2b4-2bc7fa3e3609"],
 ", with the couplings ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["v",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e55f9df0-76bd-48fa-b494-985bafa27e04"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["F",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c38f42d5-3452-42e1-8627-be4135c95595"],
 ". The covariant derivative of the spinor field is"
}], "Text",ExpressionUUID->"076a72a3-5b4b-4d5f-84d8-8386cda42e4f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["\[Del]", 
    StyleBox["p", "TI"], 
    StyleBox["GEE",
     FontSlant->"Plain"]], 
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], "\[LongEqual]", 
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["\[PartialD]", 
      StyleBox["p", "TI"]], "+", 
     SubsuperscriptBox["\[CapitalGamma]", 
      StyleBox["p", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"]], "+", 
     StyleBox["i", "TI"], 
     SubsuperscriptBox[
      StyleBox["g", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["v",
       FontSlant->"Plain"]], "\[ThinSpace]", 
     SubscriptBox[
      StyleBox["1",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "4"], "\[CircleTimes]", 
     SubscriptBox[
      StyleBox["W",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["SF",
        FontSlant->"Plain"], ",", 
       StyleBox["p", "TI"]}]], "+", 
     StyleBox["i", "TI"], 
     SubsuperscriptBox[
      StyleBox["g", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["F",
       FontSlant->"Plain"]], 
     SubscriptBox[
      StyleBox["B", "TI"], 
      RowBox[{
       StyleBox["SF",
        FontSlant->"Plain"], ",", 
       StyleBox["p", "TI"]}]]}], ")"}], 
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], ","}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"dc6d139c-5d52-4bf3-aa47-0d151df8464c"],

Cell[TextData[{
 "and it is covariant, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Del]", 
     StyleBox["p", "TI"], 
     RowBox[{"\[Prime]", 
      StyleBox["GEE",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["\[ScriptCapitalU]",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      SubscriptBox["\[CapitalPsi]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["\[ScriptCapitalU]",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Del]", 
     StyleBox["p", "TI"], 
     StyleBox["GEE",
      FontSlant->"Plain"]], 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0edfc4a0-8bfb-4763-98c4-814cbc73b228"],
 ", when the gauge fields transform as"
}], "Text",ExpressionUUID->"b31a82ca-4230-4c53-9d5b-74019808f21a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["\[CapitalGamma]", 
    StyleBox["p", "TI"], 
    RowBox[{"\[Prime]", 
     StyleBox["LL",
      FontSlant->"Plain"]}]], "\[LongEqual]", 
   StyleBox["S",
    FontFamily->"Helvetica",
    FontSlant->"Plain"], "\[ThinSpace]", 
   SubsuperscriptBox["\[CapitalGamma]", 
    StyleBox["p", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["S",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{"-", "1"}]], "-", 
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["\[PartialD]", 
      StyleBox["p", "TI"]], 
     StyleBox["S",
      FontFamily->"Helvetica",
      FontSlant->"Plain"]}], ")"}], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["S",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{"-", "1"}]], ",", "      ", 
   SubsuperscriptBox[
    StyleBox["W",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}], "\[Prime]"], "\[LongEqual]", 
   SubscriptBox[
    StyleBox["U",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   SubscriptBox[
    StyleBox["W",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}]], 
   SubsuperscriptBox[
    StyleBox["U",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Dagger]"], "+", 
   FractionBox[
    StyleBox["i", "TI"], 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]]], 
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["\[PartialD]", 
      StyleBox["p", "TI"]], 
     SubscriptBox[
      StyleBox["U",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"]]}], ")"}], 
   SubsuperscriptBox[
    StyleBox["U",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Dagger]"], ",", "      ", 
   SubsuperscriptBox[
    StyleBox["B", "TI"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}], "\[Prime]"], "\[LongEqual]", 
   SubscriptBox[
    StyleBox["B", "TI"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}]], "-", 
   FractionBox["1", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]]], 
   SubscriptBox["\[PartialD]", 
    StyleBox["p", "TI"]], 
   SubsuperscriptBox["\[Theta]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["F",
     FontSlant->"Plain"]], "."}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"04d18510-17db-4fcb-84d2-a7aeb70d035f"],

Cell[TextData[{
 "An isospin vector of fermion number 2 and spin 0, such as the pair field ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[CapitalPhi]", "\[RightVector]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "502fe928-b883-4fe1-99af-b9e29b03a32e"],
 " of the superfluid, has the covariant derivative ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Del]", 
     StyleBox["p", "TI"]], 
    OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "\[LongEqual]", 
    SubscriptBox["\[PartialD]", 
     StyleBox["p", "TI"]], 
    OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "-", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["W", "TI"], "\[RightVector]"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}]], "\[Times]", 
    OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "+", "2", 
    StyleBox["i", "TI"], 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["B", "TI"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}]], 
    OverscriptBox["\[CapitalPhi]", "\[RightVector]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "51c982f2-2629-4705-8bd7-e9a03c88a187"],
 "; the field strengths are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["W",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], "\[LongEqual]", 
    SubscriptBox["\[PartialD]", 
     StyleBox["p", "TI"]], 
    SubscriptBox[
     StyleBox["W",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], "-", 
    SubscriptBox["\[PartialD]", 
     SuperscriptBox[
      StyleBox["p", "TI"], "\[Prime]"]], 
    SubscriptBox[
     StyleBox["W",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}]], "+", 
    StyleBox["i", "TI"], 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]], 
    RowBox[{"[", 
     RowBox[{
      SubscriptBox[
       StyleBox["W",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["SF",
         FontSlant->"Plain"], ",", 
        StyleBox["p", "TI"]}]], ",", 
      SubscriptBox[
       StyleBox["W",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["SF",
         FontSlant->"Plain"], ",", 
        SuperscriptBox[
         StyleBox["p", "TI"], "\[Prime]"]}]]}], "]"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0b81f9c4-146d-403a-9e5d-3419ecd702b9"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["B", "TI"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], "\[LongEqual]", 
    SubscriptBox["\[PartialD]", 
     StyleBox["p", "TI"]], 
    SubscriptBox[
     StyleBox["B", "TI"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], "-", 
    SubscriptBox["\[PartialD]", 
     SuperscriptBox[
      StyleBox["p", "TI"], "\[Prime]"]], 
    SubscriptBox[
     StyleBox["B", "TI"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "707c8c91-2957-45b2-b4e0-5b8efa608f71"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["W",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}], "\[Prime]"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["U",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["W",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], 
    SubsuperscriptBox[
     StyleBox["U",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Dagger]"]}], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4d516bdd-165d-488f-bd8d-56cf892189b5"],
 "."
}], "Text",ExpressionUUID->"d969c43a-9fec-4fb0-ad8d-1fe26fce84c8"],

Cell[TextData[{
 "The next cell checks these covariance laws with random smooth fields: the \
isospin rotation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["U",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["x", "TI"], ")"}], "\[LongEqual]", 
    StyleBox["exp",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       StyleBox["i", "TI"], "2"], "\[ThinSpace]", 
      UnderscriptBox["\[Sum]", "\[Iota]",
       LimitsPositioning->True], "\[ThinSpace]", 
      SuperscriptBox[
       StyleBox["a", "TI"], "\[Iota]"], 
      RowBox[{"(", 
       StyleBox["x", "TI"], ")"}], 
      SubsuperscriptBox["\[Tau]", "\[Iota]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f3a8d824-1739-42ab-a9b8-3cdfff151f47"],
 ", the phase, the gauge fields and the test fields are sums of sines of the \
four coordinates with random coefficients. The derivatives are computed \
symbolically by the function ",
 StyleBox["D",
  FontFamily->"Source Code Pro"],
 " of the Wolfram Language and evaluated at four random points: a third \
method, next to the automatic differentiation of the Rust program and the \
differences of eighth order of the Python program. The couplings of the test \
are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["v",
      FontSlant->"Plain"]], "\[LongEqual]", "0.83"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2f999dd3-7ba3-43fa-826a-e29c9f915935"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["F",
      FontSlant->"Plain"]], "\[LongEqual]", "0.47"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7fcad813-e130-4117-b568-fe5f259f2ce0"],
 ". The last check of the cell is the local ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SL", "TI"], 
    RowBox[{"(", 
     RowBox[{"2", ",", 
      StyleBox["\[DoubleStruckCapitalC]",
       FontSlant->"Plain"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "97ca8a63-afa0-4787-a9c5-ad93a6eb9c21"],
 " transformation with the frame: with the spinor matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["S",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     StyleBox["x", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "01cc4668-2fd8-41df-8397-251e1d0b244f"],
 " of a random field of unit bi-quaternions and the connection ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalGamma]", 
     StyleBox["p", "TI"], "\[Prime]"], "\[LongEqual]", 
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[PartialD]", 
        StyleBox["p", "TI"]], 
       StyleBox["S",
        FontFamily->"Helvetica",
        FontSlant->"Plain"]}], ")"}]}], 
    SuperscriptBox[
     StyleBox["S",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{"-", "1"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "39a9ad20-703d-4b4f-b39b-78d1c559de6f"],
 " of the transformed frame, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["p", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SuperscriptBox["\[Gamma]", 
     StyleBox["p", "TI"]], 
    RowBox[{"[", 
     SuperscriptBox[
      StyleBox["f",
       FontWeight->"Bold",
       FontSlant->"Plain"], "\[Prime]"], "]"}], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[PartialD]", 
       StyleBox["p", "TI"]], "+", 
      SubsuperscriptBox["\[CapitalGamma]", 
       StyleBox["p", "TI"], "\[Prime]"]}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["S",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "\[Psi]"}], ")"}], "\[LongEqual]", 
    StyleBox["S",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", 
     StyleBox["p", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SuperscriptBox["\[Gamma]", 
     StyleBox["p", "TI"]], 
    SubscriptBox["\[PartialD]", 
     StyleBox["p", "TI"]], "\[Psi]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2ff89936-5d10-4749-9476-b4c6a3e61a47"],
 "."
}], "Text",ExpressionUUID->"e80d2995-e040-40de-b469-dbd05b5a6aae"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"the", " ", "four", " ", "coordinates", " ", 
       RowBox[{"x", "^", "0"}]}], " ", ".."}], " ", 
     RowBox[{"x", "^", "3"}], " ", "of", " ", "the", " ", "test"}], ",", " ", 
    
    RowBox[{"as", " ", "symbols"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", 
     RowBox[{"x0", ",", " ", "x1", ",", " ", "x2", ",", " ", "x3"}], "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"xs", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"x0", ",", " ", "x1", ",", " ", "x2", ",", " ", "x3"}], "}"}]}],
     ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"gvT", ",", " ", 
     RowBox[{"gfT", ":", " ", 
      RowBox[{
      "the", " ", "couplings", " ", "of", " ", "the", " ", "test"}]}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"gvT", ",", " ", "gfT"}], "}"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"0.83", ",", " ", "0.47"}], "}"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"smooth", "[", "off", "]"}], ":", " ", 
     RowBox[{
      RowBox[{
      "a", " ", "random", " ", "smooth", " ", "real", " ", "function", " ", 
       "off"}], " ", "+", " ", 
      RowBox[{"a1", " ", "sin", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"k1", ".", "x"}], " ", "+", " ", "ph1"}], ")"}]}], " ", "+", 
      " ", 
      RowBox[{"a2", " ", "sin", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"k2", ".", "x"}], " ", "+", " ", "ph2"}], ")"}]}]}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"smooth", "[", "off_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"a", " ", "=", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"off", " ", "+", " ", 
             RowBox[{"0.5", " ", 
              RowBox[{"RandomReal", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], "]"}]}]}], ",", 
            " ", 
            RowBox[{"0.6", " ", 
             RowBox[{"RandomReal", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], "]"}]}], ",", " ", 
            RowBox[{"0.4", " ", 
             RowBox[{"RandomReal", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], "]"}]}]}], 
           "}"}]}], ",", "\n", "    ", 
         RowBox[{"k", " ", "=", " ", 
          RowBox[{"RandomReal", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"2", ",", " ", "4"}], "}"}]}], "]"}]}], ",", " ", 
         RowBox[{"ph", " ", "=", " ", 
          RowBox[{"RandomReal", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "3"}], ",", " ", "3"}], "}"}], ",", " ", "2"}], 
           "]"}]}]}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"a", "[", 
         RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", 
        RowBox[{
         RowBox[{"a", "[", 
          RowBox[{"[", "2", "]"}], "]"}], " ", 
         RowBox[{"Sin", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"k", "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", ".", " ", "xs"}], " ", "+", 
           " ", 
           RowBox[{"ph", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], " ", "+", " ", 
        RowBox[{
         RowBox[{"a", "[", 
          RowBox[{"[", "3", "]"}], "]"}], " ", 
         RowBox[{"Sin", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"k", "[", 
             RowBox[{"[", "2", "]"}], "]"}], " ", ".", " ", "xs"}], " ", "+", 
           " ", 
           RowBox[{"ph", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}]}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"the", " ", "isospin", " ", "rotation", " ", "U"}], " ", "=", 
      " ", 
      RowBox[{
       RowBox[{"exp", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"i", "/", "2"}], ")"}], " ", 
          RowBox[{"a", " ", ".", " ", "tau"}]}], ")"}]}], " ", "=", " ", 
       RowBox[{
        RowBox[{"cos", 
         RowBox[{"(", 
          RowBox[{"r", "/", "2"}], ")"}], " ", "1"}], " ", "+", " ", 
        RowBox[{"i", " ", "sin", 
         RowBox[{"(", 
          RowBox[{"r", "/", "2"}], ")"}], " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"a", " ", ".", " ", "tau"}], ")"}], "/", "r"}]}]}]}]}], ",",
      " ", 
     RowBox[{"r", " ", "=", " ", 
      RowBox[{"|", "a", "|"}]}], ",", " ", 
     RowBox[{"and", " ", "its", " ", "adjoint"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"aT", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"smooth", "[", "1.2", "]"}], ",", " ", 
       RowBox[{"{", "3", "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rT", " ", "=", " ", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"aT", " ", ".", " ", "aT"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"uT", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Cos", "[", 
        RowBox[{"rT", "/", "2"}], "]"}], " ", 
       RowBox[{"IdentityMatrix", "[", "2", "]"}]}], " ", "+", " ", 
      RowBox[{"I", " ", 
       RowBox[{"Sin", "[", 
        RowBox[{"rT", "/", "2"}], "]"}], " ", 
       RowBox[{
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"aT", "[", 
            RowBox[{"[", "i", "]"}], "]"}], " ", 
           RowBox[{"sig", "[", 
            RowBox[{"[", 
             RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", "3"}], "}"}]}], "]"}], "/", "rT"}]}]}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"uTdag", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Cos", "[", 
        RowBox[{"rT", "/", "2"}], "]"}], " ", 
       RowBox[{"IdentityMatrix", "[", "2", "]"}]}], " ", "-", " ", 
      RowBox[{"I", " ", 
       RowBox[{"Sin", "[", 
        RowBox[{"rT", "/", "2"}], "]"}], " ", 
       RowBox[{
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"aT", "[", 
            RowBox[{"[", "i", "]"}], "]"}], " ", 
           RowBox[{"sig", "[", 
            RowBox[{"[", 
             RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", "3"}], "}"}]}], "]"}], "/", "rT"}]}]}]}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"the", " ", "phase", " ", 
     RowBox[{"theta", "^", "F"}], " ", "of", " ", "U", 
     RowBox[{
      RowBox[{"(", "1", ")"}], "^", "F"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"thT", " ", "=", " ", 
     RowBox[{"smooth", "[", "0.3", "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"the", " ", "gauge", " ", 
       RowBox[{"fields", ":", " ", 
        RowBox[{"wT", "[", "p", "]"}]}]}], " ", "=", " ", 
      RowBox[{"sum_i", " ", 
       RowBox[{"W", "^", "i_p"}], " ", 
       RowBox[{"tau_i", "/", "2"}], " ", 
       RowBox[{"(", 
        RowBox[{"real", " ", "components"}], ")"}]}]}], ",", " ", 
     RowBox[{
      RowBox[{"bT", "[", "p", "]"}], " ", "=", " ", "B_p"}], ",", " ", 
     RowBox[{"p", " ", "=", " ", 
      RowBox[{
       RowBox[{"0", ".."}], "3"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"wComp", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"smooth", "[", "0.", "]"}], ",", " ", 
       RowBox[{"{", "4", "}"}], ",", " ", 
       RowBox[{"{", "3", "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"bComp", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"smooth", "[", "0.", "]"}], ",", " ", 
       RowBox[{"{", "4", "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"wT", "[", "p_", "]"}], " ", ":=", " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"wComp", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"p", " ", "+", " ", "1"}], ",", " ", "i"}], "]"}], "]"}], " ", 
        RowBox[{
         RowBox[{"sig", "[", 
          RowBox[{"[", 
           RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}], "/", "2"}]}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"bT", "[", "p_", "]"}], " ", ":=", " ", 
     RowBox[{"bComp", "[", 
      RowBox[{"[", 
       RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"dd", "[", 
      RowBox[{"f", ",", " ", "p"}], "]"}], ":", " ", 
     RowBox[{
     "the", " ", "derivative", " ", "with", " ", "respect", " ", "to", " ", 
      RowBox[{"x", "^", "p"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"dd", "[", 
      RowBox[{"f_", ",", " ", "p_"}], "]"}], " ", ":=", " ", 
     RowBox[{"D", "[", 
      RowBox[{"f", ",", " ", 
       RowBox[{"xs", "[", 
        RowBox[{"[", 
         RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"the", " ", "transformed", " ", "gauge", " ", "fields", " ", 
     RowBox[{"(", "4.5", ")"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"wTp", "[", "p_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"uT", " ", ".", " ", 
       RowBox[{"wT", "[", "p", "]"}], " ", ".", " ", "uTdag"}], " ", "+", " ", 
      RowBox[{
       RowBox[{"I", "/", "gvT"}], " ", 
       RowBox[{
        RowBox[{"dd", "[", 
         RowBox[{"uT", ",", " ", "p"}], "]"}], " ", ".", " ", "uTdag"}]}]}]}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"bTp", "[", "p_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"bT", "[", "p", "]"}], " ", "-", " ", 
      RowBox[{
       RowBox[{"dd", "[", 
        RowBox[{"thT", ",", " ", "p"}], "]"}], "/", "gfT"}]}]}], ";"}], "\n", 
   
   RowBox[{"(*", " ", 
    RowBox[{"the", " ", "test", " ", "spinor", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"eight", " ", "components"}], ",", " ", 
       RowBox[{"two", " ", "plane", " ", "waves"}]}], ")"}], " ", "and", " ", 
     "its", " ", "transform", " ", 
     RowBox[{"e", "^", 
      RowBox[{"(", 
       RowBox[{"i", " ", "theta"}], ")"}]}], " ", 
     RowBox[{"(", 
      RowBox[{"1", "_", "4", " ", 
       RowBox[{"(", "x", ")"}], " ", "U"}], ")"}], " ", "psi"}], " ", "*)"}], 
   "\n", 
   RowBox[{
    RowBox[{"kT", " ", "=", " ", 
     RowBox[{"RandomReal", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ampT", " ", "=", " ", 
     RowBox[{
      RowBox[{"RandomReal", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"8", ",", " ", "2"}], "}"}]}], "]"}], " ", "+", " ", 
      RowBox[{"I", " ", 
       RowBox[{"RandomReal", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"8", ",", " ", "2"}], "}"}]}], "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"psiT", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"ampT", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], " ", 
       RowBox[{"Exp", "[", 
        RowBox[{"I", " ", 
         RowBox[{
          RowBox[{"kT", "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", ".", " ", "xs"}]}], "]"}]}], 
      " ", "+", " ", 
      RowBox[{
       RowBox[{"ampT", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], " ", 
       RowBox[{"Exp", "[", 
        RowBox[{"I", " ", 
         RowBox[{
          RowBox[{"kT", "[", 
           RowBox[{"[", "2", "]"}], "]"}], " ", ".", " ", "xs"}]}], 
        "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"psiTp", " ", "=", " ", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{"I", " ", "thT"}], "]"}], " ", 
      RowBox[{
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{
         RowBox[{"IdentityMatrix", "[", "4", "]"}], ",", " ", "uT"}], "]"}], 
       " ", ".", " ", "psiT"}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"covPsi", "[", 
       RowBox[{"w", ",", " ", "b", ",", " ", "v", ",", " ", "p"}], "]"}], ":",
       " ", 
      RowBox[{"nabla_p", " ", "v"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"d_p", " ", "v"}], " ", "+", " ", 
      RowBox[{"i", " ", "g_v", " ", 
       RowBox[{"(", 
        RowBox[{"1", "_", "4", " ", 
         RowBox[{"(", "x", ")"}], " ", "W_p"}], ")"}], " ", "v"}], " ", "+", 
      " ", 
      RowBox[{"i", " ", "g_F", " ", "B_p", " ", "v"}]}]}], " ", "*)"}], "\n", 
   
   RowBox[{
    RowBox[{
     RowBox[{"covPsi", "[", 
      RowBox[{"w_", ",", " ", "b_", ",", " ", "v_", ",", " ", "p_"}], "]"}], 
     " ", ":=", " ", 
     RowBox[{
      RowBox[{"dd", "[", 
       RowBox[{"v", ",", " ", "p"}], "]"}], " ", "+", " ", 
      RowBox[{"I", " ", "gvT", " ", 
       RowBox[{
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{
          RowBox[{"IdentityMatrix", "[", "4", "]"}], ",", " ", 
          RowBox[{"w", "[", "p", "]"}]}], "]"}], " ", ".", " ", "v"}]}], " ", 
