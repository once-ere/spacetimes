                    RowBox[{"--", 
                    RowBox[{
                    "--", " ", 
                    "WD"}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]\
}]}]}]}]}]}], "-", "5"}], ":", " ", 
    RowBox[{
    "the", " ", "reduced", " ", "model", " ", "of", " ", "pseudospins"}]}], 
   " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"HS", " ", 
      RowBox[{"(", 
       RowBox[{"0", ",", " ", "0"}], ")"}]}], ":", " ", 
     RowBox[{
      RowBox[{
      "for", " ", "every", " ", "radial", " ", "node", " ", "k", " ", "one", " ",
        "pseudospin", " ", "n", " ", "at"}], " ", "+", 
      RowBox[{"eps_k", " ", "and", " ", "one", " ", "at"}], " ", "-", 
      "eps_k"}]}], ",", " ", 
    RowBox[{"eps_k", " ", "=", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"k", "^", "2"}], " ", "+", " ", 
        RowBox[{"m", "^", "2"}]}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
      "each", "\n", "   ", "with", " ", "half", " ", "the", " ", "weight", " ",
        "w_k"}], " ", "=", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Gauss", "-", 
         RowBox[{"Legendre", " ", "weight"}]}], ")"}], " ", 
       RowBox[{
        RowBox[{"k", "^", "2"}], " ", "/", " ", 
        RowBox[{"(", 
         RowBox[{"2", " ", 
          RowBox[{"pi", "^", "2"}]}], ")"}]}], " ", "of", " ", "the", " ", 
       "node"}]}], ";", " ", 
     RowBox[{
      RowBox[{"dn", "/", "dt"}], " ", "=", " ", 
      RowBox[{
       RowBox[{
       "2", " ", "b", " ", "x", " ", "n", " ", "with", "\n", "   ", "b"}], 
       " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "Dx"}], ",", " ", 
            RowBox[{"-", "Dy"}], ",", " ", "eps"}], ")"}], " ", "and", " ", 
          "the", " ", "gap", " ", "parameter", " ", "Dx"}], " ", "-", " ", 
         RowBox[{"i", " ", "Dy"}]}], " ", "=", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"G", "/", "2"}], ")"}], " ", "sum", " ", 
         RowBox[{"(", 
          RowBox[{"w", "/", "2"}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"n", "^", "x"}], " ", "-", " ", 
           RowBox[{"i", " ", 
            RowBox[{"n", "^", "y"}]}]}], ")"}]}]}]}]}], ";", " ", 
     RowBox[{
      RowBox[{"d", 
       RowBox[{"(", "t", ")"}]}], " ", "=", " ", 
      RowBox[{"2", " ", "|", 
       RowBox[{"Dx", " ", "-", " ", 
        RowBox[{"i", " ", "Dy"}]}], "|"}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
    "Needs", "[", "\"\<NumericalDifferentialEquationAnalysis`\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"gl", " ", "=", " ", 
     RowBox[{"GaussianQuadratureWeights", "[", 
      RowBox[{"24", ",", " ", "0", ",", " ", "1", ",", " ", "40"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"kq", " ", "=", " ", 
     RowBox[{"gl", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], ";", " ", 
    RowBox[{"wq", " ", "=", " ", 
     RowBox[{
      RowBox[{"gl", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], " ", 
      RowBox[{
       RowBox[{"kq", "^", "2"}], "/", 
       RowBox[{"(", 
        RowBox[{"2", " ", 
         RowBox[{"Pi", "^", "2"}]}], ")"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ekq", " ", "=", " ", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"kq", "^", "2"}], " ", "+", " ", 
       RowBox[{"mLL", "^", "2"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"eps2", " ", "=", " ", 
     RowBox[{"Join", "[", 
