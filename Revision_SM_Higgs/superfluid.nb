Cell[CellGroupData[{

Cell["R.4.4 The width of the Hann window (check WD-4)", "Subsection",ExpressionUUID->"2f5a418c-9f0b-4d4b-9722-cd213b369227"],

Cell[TextData[{
 "A peak of the spectrum can be no narrower than the window allows. The \
Fourier transform of the Hann window over a run of the length ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2f561b9c-049a-4f49-bf12-4bd75cca0874"],
 ", normalized to 1 at its centre, has at the offset ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Pi]", 
    StyleBox["x", "TI"], "/", 
    StyleBox["T", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5cb12ddc-d81b-4f35-b71c-fd35a59d53e4"],
 " the modulus"
}], "Text",ExpressionUUID->"8d502841-23b2-4213-9c45-fc17bc007c05"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[LeftBracketingBar]", 
    FractionBox[
     RowBox[{
      StyleBox["sin",
       FontSlant->"Plain"], "\[ThinSpace]", "\[Pi]", 
      StyleBox["x", "TI"]}], 
     RowBox[{"\[Pi]", 
      StyleBox["x", "TI"], "\[ThinSpace]", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        SuperscriptBox[
         StyleBox["x", "TI"], "2"]}], ")"}]}]], "\[RightBracketingBar]"}], 
   ","}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"623babc6-7ae9-4894-845a-ebaad374ec63"],

Cell[TextData[{
 "which is exactly ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f8069c78-f39f-4555-9cbe-243332a7654c"],
 " at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["x", "TI"], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b6f227e1-c0f7-4521-9a55-5e80c2bc4de1"],
 ". A cosine that lasts the whole run, without damping, therefore has the \
half width at half maximum ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalGamma]", 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["win",
      FontSlant->"Plain"]], "\[LongEqual]", "2", "\[Pi]", "/", 
    StyleBox["T", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0b4203b3-46ca-4456-8273-6f8ded5663db"],
 " in the limit of continuous sampling, and the ratio ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalGamma]", 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["pk",
      FontSlant->"Plain"]], "/", 
    SubsuperscriptBox["\[CapitalGamma]", 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["win",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3567735a-996d-4e1d-ae6a-e729d378345f"],
 " measures the damping: 1 for an undamped mode, larger for one that decays. \
The cell checks the closed form against the exact integral at nine rational \
offsets, the limit at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["x", "TI"], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a414ffa7-638a-4994-bfcd-5def396b7c5b"],
 ", and the widths ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalGamma]", 
    StyleBox["SH",
     FontSlant->"Plain"], 
    StyleBox["win",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8f11990c-aabc-4072-a0e3-778a2bf55dc7"],
 " of the pure cosines that the Rust program sampled like its signals."
}], "Text",ExpressionUUID->"8d25aac4-5c77-4fc3-b0ef-4f3ced21be20"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", 
          RowBox[{"--", 
           RowBox[{"--", 
            RowBox[{"--", 
             RowBox[{"--", 
              RowBox[{"--", 
               RowBox[{"--", 
                RowBox[{"--", 
                 RowBox[{"--", 
                  RowBox[{"--", 
                   RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{
                    "--", " ", 
                    "WD"}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]\
}]}]}]}]}]}], "-", "4"}], ":", " ", 
    RowBox[{
    "the", " ", "width", " ", "of", " ", "the", " ", "Hann", " ", 
     "window"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"wHann", "[", "x_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"Sin", "[", 
       RowBox[{"x", " ", "Pi"}], "]"}], "/", 
      RowBox[{"(", 
       RowBox[{"x", " ", "Pi", " ", 
        RowBox[{"(", 
         RowBox[{"1", " ", "-", " ", 
          RowBox[{"x", "^", "2"}]}], ")"}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", "transform", " ", "of", " ", 
      RowBox[{"sin", "^", "2"}], 
      RowBox[{"(", 
       RowBox[{"pi", " ", 
        RowBox[{"t", " ", "/", " ", "T"}]}], ")"}], " ", "exp", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "i"}], " ", "w", " ", "t"}], ")"}], " ", 
      RowBox[{"over", " ", "[", 
       RowBox[{"0", ",", " ", "T"}], "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{"normalized", " ", "at", " ", "w"}], " ", "=", " ", "0"}], ",", 
     " ", 
     RowBox[{
      RowBox[{"at", " ", "w"}], " ", "=", " ", 
      RowBox[{"x", " ", "2", " ", 
       RowBox[{"pi", " ", "/", " ", "T"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"tw", "[", "x_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Sin", "[", 
           RowBox[{"Pi", " ", "s"}], "]"}], "^", "2"}], " ", 
         RowBox[{"Exp", "[", 
          RowBox[{"I", " ", "2", " ", "Pi", " ", "x", " ", "s"}], "]"}]}], ",",
         " ", 
        RowBox[{"{", 
         RowBox[{"s", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}], "/", 
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Sin", "[", 
          RowBox[{"Pi", " ", "s"}], "]"}], "^", "2"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"s", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}]}]}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "squared", " ", "modulus", " ", "of", " ", "the", " ", 
      "exact", " ", "transform", " ", "against", " ", "the", " ", "closed", " ",
       "form", " ", "at", " ", "nine", " ", "rational", " ", "offsets"}], ",",
      " ", 
     RowBox[{"in", " ", "exact", " ", "arithmetic"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"formOK", " ", "=", " ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "/", "10"}], ",", " ", 
         RowBox[{"3", "/", "10"}], ",", " ", 
         RowBox[{"1", "/", "2"}], ",", " ", 
         RowBox[{"7", "/", "10"}], ",", " ", 
         RowBox[{"9", "/", "10"}], ",", " ", 
         RowBox[{"11", "/", "10"}], ",", " ", 
         RowBox[{"3", "/", "2"}], ",", " ", 
         RowBox[{"5", "/", "2"}], ",", " ", 
         RowBox[{"7", "/", "2"}]}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{
         RowBox[{"FullSimplify", "[", 
          RowBox[{
           RowBox[{"ComplexExpand", "[", 
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"tw", "[", "#", "]"}], "]"}], "^", "2"}], "]"}], " ", "-",
            " ", 
           RowBox[{
            RowBox[{"wHann", "[", "#", "]"}], "^", "2"}]}], "]"}], " ", "===",
          " ", "0"}], " ", "&"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"halfOK", " ", "=", " ", 
     RowBox[{
      RowBox[{"Limit", "[", 
       RowBox[{
        RowBox[{"wHann", "[", "x", "]"}], ",", " ", 
        RowBox[{"x", " ", "->", " ", "1"}]}], "]"}], " ", "==", " ", 
      RowBox[{"1", "/", "2"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"tLong", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"num", " ", "/@", " ", 
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{"rrows", ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", 
              RowBox[{"col", "[", 
               RowBox[{"rhdr", ",", " ", "\"\<kind\>\""}], "]"}], "]"}], 
             "]"}], " ", "==", " ", "\"\<amplitude\>\""}], " ", "&"}]}], 
         "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", 
          RowBox[{"col", "[", 
           RowBox[{"rhdr", ",", " ", "\"\<t_end\>\""}], "]"}]}], "]"}], 
        "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ww", " ", "=", " ", 
     RowBox[{"2", " ", 
      RowBox[{"Pi", "/", "tLong"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"hw", " ", "=", " ", 
     RowBox[{"num", " ", "/@", " ", 
      RowBox[{
       RowBox[{"Select", "[", 
        RowBox[{"rrows", ",", " ", 
         RowBox[{
          RowBox[{"MemberQ", "[", 
           RowBox[{
            RowBox[{"{", 
             
             RowBox[{"\"\<amplitude\>\"", ",", " ", "\"\<triplet\>\"", ",", 
              " ", "\"\<large\>\""}], "}"}], ",", " ", 
            RowBox[{"#", "[", 
             RowBox[{"[", 
              RowBox[{"col", "[", 
               RowBox[{"rhdr", ",", " ", "\"\<kind\>\""}], "]"}], "]"}], 
             "]"}]}], "]"}], " ", "&"}]}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", " ", 
         RowBox[{"col", "[", 
          RowBox[{"rhdr", ",", " ", "\"\<hwhm_window\>\""}], "]"}]}], "]"}], 
       "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dev4", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"hw", " ", "-", " ", "ww"}], "]"}], "/", "ww"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"rvCheck", "[", 
     RowBox[{"\"\<WD-4\>\"", ",", " ", 
      RowBox[{"\"\<the Hann window: its normalized transform has the modulus \
|sin(x pi) / (x pi (1 - x^2))| at the offset x 2 pi / T \\\n(the squared \
modulus of the exact integral equals that of the closed form at nine rational \
offsets, exactly) and the \\\nvalue 1/2 at x = 1 (limit), so that the half \
width at half maximum of a pure cosine is 2 pi / T = \>\"", " ", "<>", "\n", 
       "  ", 
       RowBox[{"ToString", "[", 
        RowBox[{"NumberForm", "[", 
         RowBox[{
          RowBox[{"N", "[", 
           RowBox[{"ww", ",", " ", "8"}], "]"}], ",", " ", "8"}], "]"}], 
        "]"}], " ", "<>", " ", "\"\< for the runs of length \>\"", " ", "<>", 
       " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"Round", "[", "tLong", "]"}], "]"}], " ", "<>", 
       " ", "\"\<; the widths of the sampled cosines of \\\nthe Rust program \
against it (relative)\>\""}], ",", " ", 
      RowBox[{"formOK", " ", "&&", " ", "halfOK", " ", "&&", " ", 
       RowBox[{"dev4", " ", "<", " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "2"}]}]}]}], ",", "\n", "  ", 
      RowBox[{"\"\<form \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", "formOK", "]"}], " ", "<>", 
       " ", "\"\<, half \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", "halfOK", "]"}], " ", "<>", 
       " ", "\"\<, deviation \>\"", " ", "<>", " ", 
       RowBox[{"sci", "[", "dev4", "]"}]}]}], "]"}], ";"}]}]}]], "Input",
 CellLabel->
  "In[748]:=",ExpressionUUID->"7bd5cabb-61b7-4786-8b50-3e838446cbba"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"PASS \"\>", "\[InvisibleSpace]", "\<\"WD-4\"\>", 
   "\[InvisibleSpace]", "\<\"  \"\>", 
