Cell[CellGroupData[{

Cell["\<\
II.4 The first excited states: the linear response of the superfluid\
\>", "Section",ExpressionUUID->"bb2a63ca-691a-42b1-8612-2e659423a5cb"],

Cell[TextData[{
 "A small change of the self-energies with the time dependence ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     RowBox[{"-", 
      StyleBox["i", "TI"]}], "\[Omega]", 
     StyleBox["t", "TI"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e485decb-d799-463f-a55f-141f05d33be4"],
 " is described by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["V",
      FontSlant->"Plain"]], "\[LongEqual]", "120"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4f07207e-dfcb-4400-a2eb-2f1a14c3b0f2"],
 " complex amplitudes: the 64 entries of a change ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", 
    StyleBox["N",
     FontFamily->"Helvetica",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9b3e1c0c-87c2-4dd3-adf5-1f331509859a"],
 " of the normal self-energy and the 28 independent entries of each of two \
antisymmetric changes of the pair self-energy (",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", 
    StyleBox["P",
     FontFamily->"Helvetica",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "033615b5-9a8c-4437-9ec0-8a854525e615"],
 " and the change of its adjoint). The change of the state in answer to a \
change of the self-energies is the response ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Chi]", 
    RowBox[{"(", "\[Omega]", ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3a614b6c-1f4a-43eb-8afb-2058efe6c37e"],
 ", a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"120", "\[Times]", "120"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "15e13ce8-661f-4e48-9fee-b60c88cbceb4"],
 " matrix,"
}], "Text",ExpressionUUID->"9cb52df1-da55-44f9-9c99-842661f05ff2"],

Cell[BoxData[
 FormBox[
  RowBox[{"\[Chi]", 
   RowBox[{"(", "\[Omega]", ")"}], "\[LongEqual]", 
   UnderscriptBox["\[Sum]", 
    StyleBox["n", "TI"],
    LimitsPositioning->True], 
   RowBox[{"(", 
    RowBox[{
     FractionBox[
      SubscriptBox[
       StyleBox["A",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["n", "TI"]], 
      RowBox[{"\[Omega]", "-", 
       SubscriptBox["\[CapitalOmega]", 
        StyleBox["n", "TI"]]}]], "-", 
     FractionBox[
      SubscriptBox[
       StyleBox["B",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["n", "TI"]], 
      RowBox[{"\[Omega]", "+", 
       SubscriptBox["\[CapitalOmega]", 
        StyleBox["n", "TI"]]}]]}], ")"}], ","}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"a41d80a2-0ccf-4953-b76e-a04f9bca80dd"],

Cell[TextData[{
 "a sum over the momenta ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6a2574ff-2b54-4158-bad3-5e2a97750482"],
 " of the grid, where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalOmega]", 
     StyleBox["n", "TI"]], "\[LongEqual]", "2", 
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["n", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "229c653a-cd52-4a1b-96fa-b9663215539b"],
 " is the energy of a pair of quasi-particles at the momentum ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "affbbee8-992d-48b8-b140-b507ebb079a8"],
 " (for these states every eigenvalue of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["H",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5b70faef-e33d-49f2-aa2f-613e43b4a086"],
 " at a momentum is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["n", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "64492a90-6d6b-4a6d-886e-1c9c844d1e5e"],
 ", which the cell checks) and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["A",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "094730e0-eaf1-4825-b3f7-ef2d5b5c145d"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["B",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ee7dd37e-687c-4318-8e5c-fafef01e4343"],
 " are built from the eigenvectors (the creation of two quasi-particles and \
its reverse). The self-energies change by ",
 Cell[BoxData[
  FormBox[
   StyleBox["F",
    FontFamily->"Helvetica",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "eca90d47-6579-428d-8aac-65d98e3f5aa9"],
 " times the change of the state, where ",
 Cell[BoxData[
  FormBox[
   StyleBox["F",
    FontFamily->"Helvetica",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8a05c000-9a7a-470b-81ed-f896311a2776"],
 " is the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"120", "\[Times]", "120"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fdc25f27-7f02-4898-a5cc-847fecdf4fdb"],
 " matrix of the self-energy maps of the contact terms (",
 StyleBox["respKernel",
  FontFamily->"Source Code Pro"],
 "). A collective mode of frequency ",
 Cell[BoxData[
  FormBox["\[Omega]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "30a6769d-443f-472f-83ec-7bbad9bb5d13"],
 " is a solution of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", "\[LongEqual]", "\[Chi]", 
    RowBox[{"(", "\[Omega]", ")"}], 
    StyleBox["F",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "\[Delta]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "79f006c4-d582-4577-ae48-a7626044616c"],
 ": the matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["M",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{"(", "\[Omega]", ")"}], "\[LongEqual]", "\[Chi]", 
    RowBox[{"(", "\[Omega]", ")"}], 
    StyleBox["F",
     FontFamily->"Helvetica",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7e67abbb-7357-40c8-87d0-d9e7d12a2efd"],
 " has the eigenvalue 1. At ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Omega]", "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "95282484-2eb1-4478-a441-f972e8a3a692"],
 " the three broken generators give three Goldstone modes: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["M",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{"(", "0", ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e4bd5fe0-4705-4bde-a305-1d3292d18ea4"],
 " has the eigenvalue 1 three times. Below the threshold ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["min",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{"2", 
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["gap",
         FontSlant->"Plain"]}]], ",", 
      UnderscriptBox[
       StyleBox["min",
        FontSlant->"Plain"], 
       StyleBox["n", "TI"],
       LimitsPositioning->True], "\[ThinSpace]", 
      SubscriptBox["\[CapitalOmega]", 
       StyleBox["n", "TI"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "51c0a44f-c680-4214-aec7-110487661768"],
 " the modes are found where the number of real eigenvalues of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["M",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{"(", "\[Omega]", ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f50bd707-97e2-4f97-bf52-ba87f5c0453e"],
 " above 1 changes: a scan of 300 frequencies, then 45 bisections for each \
change. The cell does this for HS ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"1", ",", "1"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a0508ef6-af21-43cd-b3c7-9b7af6dc21f3"],
 ", KS and CJT with ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "2", ")"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cae3f2de-dc92-43d3-bcaf-7ba54e6b4e7c"],
 ", and compares the modes with the Rust program."
}], "Text",ExpressionUUID->"15e5399d-2bee-419d-83ef-442fc37f3d31"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", "28", " ", "pairs", " ", 
     RowBox[{"(", 
      RowBox[{"i", ",", " ", "j"}], ")"}]}], ",", " ", 
    RowBox[{"i", " ", "<", " ", "j"}], ",", " ", 
    RowBox[{"of", " ", "the", " ", "antisymmetric", " ", "matrices"}], ",", 
    " ", 
    RowBox[{
    "in", " ", "the", " ", "order", " ", "of", " ", "the", " ", "rows"}]}], 
   " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"pairsSF", " ", "=", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "j"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "8"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"j", ",", " ", 
           RowBox[{"i", " ", "+", " ", "1"}], ",", " ", "8"}], "}"}]}], "]"}],
        ",", " ", "1"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"toVec", "[", 
       RowBox[{"x", ",", " ", "a", ",", " ", "b"}], "]"}], ":", " ", 
      RowBox[{"the", " ", "120", " ", "amplitudes", " ", "of", " ", 
       RowBox[{"(", 
        RowBox[{"dN", ",", " ", "dP", ",", " ", 
         RowBox[{"dP", "-", "bar"}]}], ")"}]}], ":", " ", 
      RowBox[{"the", " ", "64", " ", "entries", " ", "of", " ", "x"}]}], ",", 
     " ", 
     RowBox[{"then", " ", 
      RowBox[{"1", "/", "2"}], " ", 
