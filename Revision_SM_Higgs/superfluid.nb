       RowBox[{"{", 
        RowBox[{
         RowBox[{"bt", " ", "=", " ", 
          RowBox[{"Transpose", "[", "b", "]"}]}], ",", " ", "c"}], "}"}], ",",
        "\n", "  ", 
       RowBox[{
        RowBox[{"c", " ", "=", " ", 
         RowBox[{
          RowBox[{"Inverse", "[", 
