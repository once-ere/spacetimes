Cell[CellGroupData[{

Cell["R.1.12 The masses of the gauge bosons (check WQN-12)", "Subsection",ExpressionUUID->"cf9fa599-461a-4064-be33-fac2bbbb6f95"],

Cell[TextData[{
 "With the gauge fields ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["W", "TI"], "\[Mu]", "1"], ",", 
     SubsuperscriptBox[
      StyleBox["W", "TI"], "\[Mu]", "2"], ",", 
     SubsuperscriptBox[
      StyleBox["W", "TI"], "\[Mu]", "3"], ",", 
     SubscriptBox[
      StyleBox["B", "TI"], "\[Mu]"]}], ")"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b9f94abf-5cbb-4974-86f7-f30977ab563b"],
 " and the couplings ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["g", "TI"], ",", 
     StyleBox["g", "TI"], ",", 
     StyleBox["g", "TI"], ",", 
     SuperscriptBox[
      StyleBox["g", "TI"], "\[Prime]"]}], ")"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "35bbccaa-c2c4-4b2e-bd5e-d0ae27f985ce"],
 ", the kinetic terms of the two pair fields give the mass matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["a", "TI"]], 
    SubscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["b", "TI"]], "\[ThinSpace]", 
    StyleBox["Re",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["\[CapitalPhi]", "\[Dagger]"], 
      RowBox[{"{", 
       RowBox[{
        SubscriptBox[
         StyleBox["G", "TI"], 
         StyleBox["a", "TI"]], ",", 
        SubscriptBox[
         StyleBox["G", "TI"], 
         StyleBox["b", "TI"]]}], "}"}], "\[CapitalPhi]", "+", 
      SuperscriptBox["\[CapitalPhi]", 
       RowBox[{"\[Prime]", "\[Dagger]"}]], 
      RowBox[{"{", 
       RowBox[{
        SubsuperscriptBox[
         StyleBox["G", "TI"], 
         StyleBox["a", "TI"], "\[Prime]"], ",", 
        SubsuperscriptBox[
         StyleBox["G", "TI"], 
         StyleBox["b", "TI"], "\[Prime]"]}], "}"}], 
      SuperscriptBox["\[CapitalPhi]", "\[Prime]"]}], ")"}]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "159df61c-78b8-48bf-95b6-761cc3199797"],
 " at the vacuum ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPhi]", 
     StyleBox["SH",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{"0", ",", "\[Phi]"}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "202be05a-bc01-4447-926e-6a7dca832eb9"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalPhi]", 
     StyleBox["SH",
      FontSlant->"Plain"], "\[Prime]"], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["\[Phi]", "\[Prime]"], ",", "0"}], ")"}]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0fee7ae9-b35d-437c-9cb6-b8fff4f4aae7"],
 ". Its eigenvalues are ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b078f9c6-44a6-4dbd-a9e6-c9fbdfc9ec1a"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["g", "TI"], "2"], 
    SubsuperscriptBox[
     StyleBox["v", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], "2"], "/", "4"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a5db592b-ac3b-43c5-9798-c87bdf13f972"],
 " (twice) and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       StyleBox["g", "TI"], "2"], "+", 
      SuperscriptBox[
       StyleBox["g", "TI"], 
       RowBox[{"\[Prime]", "2"}]]}], ")"}], 
    SubsuperscriptBox[
     StyleBox["v", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], "2"], "/", "4"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a35dce77-1ffd-4e09-bf0c-1dc3c0ebea05"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["v", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], "2"], "\[LongEqual]", "2", 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["\[Phi]", "2"], "+", 
      SuperscriptBox["\[Phi]", 
       RowBox[{"\[Prime]", "2"}]]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1a7b67b0-66e4-49d5-b8a7-0b88056eb1d9"],
 ", for any lengths ",
 Cell[BoxData[
  FormBox["\[Phi]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a4d8b29b-ae03-436c-b45f-4ad30a18d22c"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Phi]", "\[Prime]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8199ec76-b2d4-4367-838d-80a2f0bcb949"],
 "; the massless vector lies along ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "0", ",", 
     SuperscriptBox[
      StyleBox["g", "TI"], "\[Prime]"], ",", 
     StyleBox["g", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "91ed6066-4a18-4809-9b2f-e531af94939b"],
 ", the photon ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["A", "TI"], "\[Mu]"], "\[LongEqual]", 
    StyleBox["sin",
     FontSlant->"Plain"], "\[ThinSpace]", 
    SubscriptBox["\[Theta]", 
     StyleBox["W", "TI"]], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["W", "TI"], "\[Mu]", "3"], "+", 
    StyleBox["cos",
     FontSlant->"Plain"], "\[ThinSpace]", 
    SubscriptBox["\[Theta]", 
     StyleBox["W", "TI"]], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["B", "TI"], "\[Mu]"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0debe977-9c64-484a-8195-330e2c3d5042"],
 "; and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["W", "TI"], "2"], "/", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["Z", "TI"], "2"], "\[ThinSpace]", 
      SuperscriptBox[
       StyleBox["cos",
        FontSlant->"Plain"], "2"], "\[ThinSpace]", 
      SubscriptBox["\[Theta]", 
       StyleBox["W", "TI"]]}], ")"}], "\[LongEqual]", "1"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "977c2dc2-a2c4-416e-93cf-501918ea8479"],
 ". The couplings, the lengths and therefore the whole statement are symbolic."
}], "Text",ExpressionUUID->"e7bc2841-791f-4a94-b0bc-5457f21eda95"],

