          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", "6", "}"}], ",", " ", "None"}], "}"}]}], ",", " ", 
         RowBox[{"ImageSize", " ", "->", " ", "460"}], ",", "\n", "   ", 
