        RowBox[{"kr", " ", "=", " ", 
         RowBox[{"0.5", " ", "lamLL", " ", 
          RowBox[{"(", 
           RowBox[{"x", " ", "+", " ", "1."}], ")"}]}]}], ";", " ", 
        RowBox[{"wr", " ", "=", " ", 
