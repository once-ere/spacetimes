             RowBox[{"sci", "[", 
              RowBox[{"#", "[", "\"\<tolerance\>\"", "]"}], "]"}], ",", 
             " ", "\"\<--\>\""}], "]"}], ",", " ", 
           RowBox[{"#", "[", "\"\<rust\>\"", "]"}], ",", " ", 
           RowBox[{"#", "[", "\"\<python\>\"", "]"}]}], "}"}], " ", "&"}], ",",
         " ", "SFNB`Test`$Results"}], "]"}], ",", "\n", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"#", ",", " ", "Bold"}], "]"}], " ", "&"}], " ", "/@", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<check\>\"", ",", " ", "\"\<result\>\"", ",", 
