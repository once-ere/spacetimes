Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"gzRust", "[", 
      RowBox[{"t", ",", " ", "key"}], "]"}], ":", " ", 
     RowBox[{"an", " ", "entry", " ", "of", " ", "rustGinzburg"}]}], ";", " ", 
    RowBox[{
     RowBox[{"hgRust", "[", 
      RowBox[{"t", ",", " ", "key"}], "]"}], ":", " ", 
     RowBox[{"an", " ", "entry", " ", "of", " ", "rustHiggs", " ", 
      RowBox[{"(", 
       RowBox[{"one", " ", "row", " ", "per", " ", "method"}], ")"}]}]}]}], 
   " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"gzCols", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<method\>\"", ",", " ", "\"\<Tc\>\"", ",", 
         " ", "\"\<massN\>\"", ",", " ", "\"\<alpha\>\"", ",", 
         " ", "\"\<b\>\"", ",", " ", "\"\<c\>\"", ",", " ", "\"\<cIso\>\"", ",",
          " ", "\"\<cFixed\>\"", ",", " ", "\"\<cT3\>\"", ",", 
