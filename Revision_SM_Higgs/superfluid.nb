Cell[CellGroupData[{

Cell["III.T.4 The critical temperature", "Section",ExpressionUUID->"f6541af8-f182-4081-a11e-af58e7bd5a97"],

Cell[TextData[{
 StyleBox["The effective couplings.",
  FontWeight->"Bold"],
 " A uniform scalar density ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["S",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bd94ce39-6022-438d-934c-4bea75e10e63"],
 " shifts the Dirac mass by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["S",
       FontSlant->"Plain"]}]], 
    SubsuperscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["S",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "014aafce-b2a5-4f76-81bb-da9b70a36363"],
 ", and a pair amplitude in the channel ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a8452f6e-8fd9-4476-9b84-b678e79d9529"],
 " produces the pair self-energy with the strength ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["P",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1e28f006-6cb1-444e-b152-84df1cfabd9d"],
 " (Section II.3). For a state with the Dirac mass ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["M", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["D",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9e5f8602-07b8-4da0-882f-1d6fe60577ad"],
 " and the pair field ",
 Cell[BoxData[
  FormBox["\[CapitalPhi]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e915c13b-2d94-4099-8563-7cdb00658498"],
 " at the temperature ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4d8ac700-e9f5-456e-88e2-1c2c7ac001f2"],
 " the scalar density is"
}], "Text",ExpressionUUID->"4fcdca94-3671-4bec-99b0-c850c427f7b6"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["S",
     FontSlant->"Plain"]], "\[LongEqual]", 
   RowBox[{"-", 
    FractionBox["2", 
     SuperscriptBox["\[Pi]", "2"]]}], 
   RowBox[{"[", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["M", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["X", "TI"], ",", 
       StyleBox["D",
        FontSlant->"Plain"]}]], "\[ThinSpace]", 
     SubsuperscriptBox[
      StyleBox["I", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{"(", "1", ")"}]], 
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["E", "TI"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["X", "TI"], ",", 
         StyleBox["gap",
          FontSlant->"Plain"]}]], ",", 
       StyleBox["T", "TI"]}], ")"}], "-", 
     SubscriptBox[
      StyleBox["m", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"]], 
     SubsuperscriptBox[
      StyleBox["I", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{"(", "1", ")"}]], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["m", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"]], ",", "0"}], ")"}]}], "]"}], ",", "      ", 
   SubsuperscriptBox[
    StyleBox["I", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "1", ")"}]], 
   RowBox[{"(", 
    RowBox[{
     StyleBox["M", "TI"], ",", 
     StyleBox["T", "TI"]}], ")"}], "\[LongEqual]", 
   SubsuperscriptBox["\[Integral]", "0", 
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]], "\[ThinSpace]", 
   FractionBox[
    RowBox[{
     SuperscriptBox[
      StyleBox["q", "TI"], "2"], "\[ThinSpace]", 
     StyleBox["tanh",
      FontSlant->"Plain"], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["E", "TI"], 
        StyleBox["M", "TI"]], "/", "2", 
       StyleBox["T", "TI"]}], ")"}]}], 
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["M", "TI"]]], "\[ThinSpace]", 
   StyleBox["dq", "TI"], ","}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"58a66da3-6784-4441-b17f-abe0e997838e"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["M", "TI"]], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        StyleBox["q", "TI"], "2"], "+", 
       SuperscriptBox[
        StyleBox["M", "TI"], "2"]}], ")"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "62ab4221-45f9-410f-94e7-f67d52fbccc5"],
 " and the gap ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["gap",
       FontSlant->"Plain"]}]], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox[
          StyleBox["M", "TI"], 
          StyleBox["SF",
           FontSlant->"Plain"], 
          RowBox[{
           StyleBox["X", "TI"], ",", 
           StyleBox["D",
            FontSlant->"Plain"]}]], ")"}], "2"], "+", 
       SuperscriptBox["\[CapitalPhi]", "2"]}], ")"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b4603db5-d1da-48e1-b013-3ecfff7fdd7c"],
 "; the factor ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["tanh",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["E", "TI"], "/", "2", 
      StyleBox["T", "TI"]}], ")"}], "\[LongEqual]", "1", "-", "2", 
    StyleBox["f", "TI"], 
    RowBox[{"(", 
     StyleBox["E", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9246333e-36db-4d90-8224-7312497aa2ce"],
 " is the thermal factor of a pair of quasi-particles, and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["I", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{"(", "1", ")"}]], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["M", "TI"], ",", "0"}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dc82d17d-d396-457d-a567-c4f838da26ff"],
 " is the integral of Part II. The Dirac mass is self-consistent when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["D",
       FontSlant->"Plain"]}]], "-", 
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["S",
       FontSlant->"Plain"]}]], 
    SubsuperscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["S",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4d51aa72-2a51-468a-8b9c-4cc78c16926f"],
 ". ",
 StyleBox["The normal state and its instability.",
  FontWeight->"Bold"],
 " The normal state at ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "58f5d0a1-e1f5-4865-9af8-c77a06f1e6a5"],
 " has no pair field and the Dirac mass ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["n",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5ba60fd6-94bd-45e1-a956-96cc83180236"],
 " that solves this condition with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPhi]", "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b13b269f-4052-4ac4-a77c-3d9c96ca04c8"],
 ": ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c7131edc-ce6d-4fb2-9669-d6a10591d7dd"],
 " at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "31ef0dbe-951c-4488-bea4-87ca18c6ea17"],
 "; at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], ">", "0"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e3b7973b-715b-4a90-b9b6-67e817c16f45"],
 " the thermally excited particles and antiparticles change the scalar \
density, which shifts the mass where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["S",
       FontSlant->"Plain"]}]], "\[NotEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "945db739-f823-4992-9237-4cf7535ea920"],
 ". A small pair field in the normal state is amplified by the factor"
}], "Text",ExpressionUUID->"9c5a9d50-365a-4127-b52d-1a8299951348"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["\[Lambda]", 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["P",
     FontSlant->"Plain"]], 
   RowBox[{"(", 
    StyleBox["T", "TI"], ")"}], "\[LongEqual]", 
   FractionBox[
    RowBox[{
     SubsuperscriptBox[
      StyleBox["g", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["X", "TI"], ",", 
       StyleBox["P",
        FontSlant->"Plain"]}]], "\[ThinSpace]", 
     SubsuperscriptBox[
      StyleBox["I", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{"(", "1", ")"}]], 
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["M", "TI"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["X", "TI"], ",", 
         StyleBox["n",
          FontSlant->"Plain"]}]], 
       RowBox[{"(", 
        StyleBox["T", "TI"], ")"}], ",", 
       StyleBox["T", "TI"]}], ")"}]}], 
    SuperscriptBox["\[Pi]", "2"]], ","}], TraditionalForm]], "DisplayFormula",\

 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"63d30afd-db71-43af-90a7-99470a04fec7"],

Cell[TextData[{
 "the eigenvalue of the static pair response of the normal state: the normal \
state is unstable towards a superfluid when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Lambda]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["P",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}], ">", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "554233dd-a02f-4452-b4a2-26eb43bcdafb"],
 " (the criterion of Thouless). The ",
 StyleBox["critical temperature",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "88b79939-cef0-442f-b136-94acd6fa031a"],
 " solves ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Lambda]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["P",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["T", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["X", "TI"], ",", 
       StyleBox["c",
        FontSlant->"Plain"]}]], ")"}], "\[LongEqual]", "1"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9eb22750-6da6-4a25-8fa6-178656e2c84d"],
 ". The next cell computes ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["n",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "14e0f070-fe20-48b0-963e-f27926fdc39c"],
 " from the scalar self-consistency alone (bisection), ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Lambda]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["P",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0f031e77-aef0-4398-942b-06407ff062ec"],
 " with the integral on the radial nodes of the grid of Part II, and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f5e5ed92-3ef0-4f94-8d8a-dfcda099c33a"],
 " by bisection; for the three methods with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["S",
       FontSlant->"Plain"]}]], "\[NotEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a511c98f-97ee-437f-a61c-adf183436190"],
 " it compares ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["n",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["T", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["X", "TI"], ",", 
       StyleBox["c",
        FontSlant->"Plain"]}]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a4dd3804-5030-4b55-8473-f0da94531eff"],
 " with the normal state of the thermal engine. It then shows that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Lambda]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["P",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2023f794-4191-4604-bdce-ca6cb7ec9859"],
 " does not increase from ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0.01"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6b1f1f06-427a-41b4-9ffe-0dc93ae0449d"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0.6"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "781c4114-ed6f-4da2-8a9a-268cfbb8530b"],
 ", so that ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "414a4143-8567-493a-923d-0d3e6ed09da6"],
 " is the only solution there."
}], "Text",ExpressionUUID->"27c3c6dd-cce3-43d1-8382-642083ba0ef6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"i1Grid", "[", 
       RowBox[{"mo", ",", " ", "s", ",", " ", "t"}], "]"}], ":", " ", "I1"}], 
     " ", "=", " ", 
     RowBox[{
      RowBox[{"int_", 
       RowBox[{"0", "^", "Lambda"}], " ", 
       RowBox[{"q", "^", "2"}], " ", "tanh", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"E", "/", "2"}], "t"}], ")"}], "/", "E"}], " ", "dq", " ", 
       "with", " ", "E"}], " ", "=", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"q", "^", "2"}], " ", "+", " ", "s"}], ")"}], "^", 
       RowBox[{"(", 
        RowBox[{"1", "/", "2"}], ")"}]}]}]}], ",", " ", 
    RowBox[{
    "on", " ", "the", " ", "radial", " ", "nodes", " ", "of", " ", "the", " ",
      "grid"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"i1Grid", "[", 
      RowBox[{"mo_", ",", " ", "s_", ",", " ", "t_"}], "]"}], " ", ":=", " ", 
     
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"kr", " ", "=", " ", 
          RowBox[{
           RowBox[{"mo", "[", "\"\<g\>\"", "]"}], "[", "\"\<kr\>\"", "]"}]}], 
         ",", " ", 
         RowBox[{"wr", " ", "=", " ", 
          RowBox[{
           RowBox[{"mo", "[", "\"\<g\>\"", "]"}], "[", "\"\<wr\>\"", "]"}]}], 
         ",", " ", "e"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"e", " ", "=", " ", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{"kr", "^", "2"}], " ", "+", " ", "s"}], "]"}]}], ";", "\n",
         "   ", 
        RowBox[{"Total", "[", 
         RowBox[{"wr", " ", 
          RowBox[{"kr", "^", "2"}], " ", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"t", " ", ">", " ", "0"}], ",", " ", 
             RowBox[{"Tanh", "[", 
              RowBox[{"e", "/", 
               RowBox[{"(", 
                RowBox[{"2", " ", "t"}], ")"}]}], "]"}], ",", " ", "1."}], 
            "]"}], "/", "e"}]}], "]"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"thCoup", "[", "t", "]"}], ":", " ", 
     RowBox[{"the", " ", "effective", " ", "couplings", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"g", "^", "S"}], ",", " ", 
        RowBox[{"g", "^", "P"}]}], "}"}], " ", "of", " ", "the", " ", 
      "method", " ", "t", " ", "for", " ", 
      RowBox[{"V", "^", 
       RowBox[{"(", "2", ")"}]}], " ", 
      RowBox[{"(", 
       RowBox[{"Part", " ", "II"}], ")"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"thCoup", "[", "t_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"thCoup", "[", "t", "]"}], " ", "=", " ", 
      RowBox[{"effCouplings", "[", 
       RowBox[{
        RowBox[{"Lookup", "[", 
         RowBox[{
          RowBox[{"AssociationThread", "[", 
           RowBox[{
            RowBox[{"shortName", " ", "/@", " ", "methodsSF"}], ",", " ", 
            "methodsSF"}], "]"}], ",", " ", "t"}], "]"}], ",", " ", 
        RowBox[{"Sequence", " ", "@@", " ", 
         RowBox[{"potentialsSF", "[", "\"\<V2\>\"", "]"}]}]}], "]"}]}]}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"thMassN", "[", 
       RowBox[{"t", ",", " ", "T"}], "]"}], ":", " ", 
      RowBox[{
       RowBox[{
       "the", " ", "Dirac", " ", "mass", " ", "of", " ", "the", " ", "normal",
         " ", "state", " ", "at", " ", "the", " ", "temperature", " ", "T", " ",
         "from", " ", "M"}], " ", "-", " ", "m"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"g", "^", "S"}], " ", 
      RowBox[{"n", "^", "S"}], " ", 
      RowBox[{"(", 
       RowBox[{"bisection", " ", 
        RowBox[{"on", " ", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"1", "e"}], "-", "6"}], ",", " ", "2"}], "]"}]}], 
       ")"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"thMassN", "[", 
      RowBox[{"t_", ",", " ", "temp_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"mo", " ", "=", " ", 
          RowBox[{"thModel", "[", "t", "]"}]}], ",", " ", 
         RowBox[{"gs", " ", "=", " ", 
          RowBox[{
           RowBox[{"thCoup", "[", "t", "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
         RowBox[{"lo", " ", "=", " ", 
          RowBox[{"10.", "^", 
           RowBox[{"-", "6"}]}]}], ",", " ", 
         RowBox[{"hi", " ", "=", " ", "2."}], ",", " ", "mid", ",", " ", 
         "i1m"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", "gs", "]"}], " ", "<", " ", 
           RowBox[{"10", "^", 
            RowBox[{"-", "14"}]}]}], ",", " ", 
          RowBox[{"Return", "[", 
           RowBox[{
            RowBox[{"N", "[", "mLL", "]"}], ",", " ", "Module"}], "]"}]}], 
         "]"}], ";", "\n", "   ", 
        RowBox[{"i1m", " ", "=", " ", 
         RowBox[{"i1Grid", "[", 
          RowBox[{"mo", ",", " ", 
           RowBox[{
            RowBox[{"N", "[", "mLL", "]"}], "^", "2"}], ",", " ", "0."}], 
          "]"}]}], ";", "\n", "   ", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"mid", " ", "=", " ", 
            RowBox[{"0.5", " ", 
             RowBox[{"(", 
              RowBox[{"lo", " ", "+", " ", "hi"}], ")"}]}]}], ";", "\n", 
           "     ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"mid", " ", "-", " ", "mLL", " ", "+", " ", 
               RowBox[{"gs", " ", 
                RowBox[{"2", "/", 
                 RowBox[{"Pi", "^", "2"}]}], " ", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"mid", " ", 
                   RowBox[{"i1Grid", "[", 
                    RowBox[{"mo", ",", " ", 
                    RowBox[{"mid", "^", "2"}], ",", " ", "temp"}], "]"}]}], 
                  " ", "-", " ", 
                  RowBox[{"mLL", " ", "i1m"}]}], ")"}]}]}], " ", ">", " ", 
              "0"}], ",", " ", 
             RowBox[{"hi", " ", "=", " ", "mid"}], ",", " ", 
             RowBox[{"lo", " ", "=", " ", "mid"}]}], "]"}]}], ",", " ", 
          RowBox[{"{", "80", "}"}]}], "]"}], ";", "\n", "   ", 
        RowBox[{"0.5", " ", 
         RowBox[{"(", 
          RowBox[{"lo", " ", "+", " ", "hi"}], ")"}]}]}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"thLam", "[", 
