Cell[TextData[{
 "The next cell prints the numbers of the answer: the critical temperature, \
the order parameter at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4eb4acfe-7929-45f4-87c6-4c35fe81a767"],
 " and at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.98", "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "abfa99d9-8702-45e5-90f3-d67c09185281"],
 ", the radius of convergence at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.98", "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4ac787d1-f525-44fc-91e5-6e2aa817b216"],
 " (from the Dirac mass of the normal state computed by the notebook), the \
reduced temperature above which the order parameter lies inside the radius, \
and the residuals of the two forms at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "384abe92-0e18-432f-b419-996360986578"],
 " and at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.98", "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "318a0164-c434-44ff-b46f-d2b867573064"],
 " (in per cent of the depth). The two cells of the figure after it show the \
order parameter and the radius against ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "/", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9423d640-95e6-4675-bb1b-f7c0074324ff"],
 " and their ratio, and the residuals of the two forms."
}], "Text",ExpressionUUID->"e1f65c59-6a5d-431f-9515-c34f9acb03c4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"thRadius", "[", 
     RowBox[{"t", ",", " ", "tau"}], "]"}], ":", " ", 
    RowBox[{"the", " ", "radius", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"M_n", 
         RowBox[{
          RowBox[{"(", "T", ")"}], "^", "2"}]}], " ", "+", " ", 
        RowBox[{
         RowBox[{"pi", "^", "2"}], " ", 
         RowBox[{"T", "^", "2"}]}]}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}]}], " ", "with", " ", "the", " ", 
     "Dirac", " ", "mass", " ", "of", " ", "the", " ", "normal", " ", "state",
      " ", "computed", " ", "by", " ", "the", " ", "notebook"}]}], " ", 
   "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"thRadius", "[", 
      RowBox[{"t_", ",", " ", "tau_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"temp", " ", "=", " ", 
         RowBox[{"tau", " ", 
          RowBox[{"thTc", "[", "t", "]"}]}]}], "}"}], ",", " ", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"thMassN", "[", 
           RowBox[{"t", ",", " ", "temp"}], "]"}], "^", "2"}], " ", "+", " ", 
         
         RowBox[{
          RowBox[{"Pi", "^", "2"}], " ", 
          RowBox[{"temp", "^", "2"}]}]}], "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"thCross", "[", "t", "]"}], ":", " ", 
     RowBox[{
      RowBox[{
      "the", " ", "reduced", " ", "temperature", " ", "above", " ", "which", " ",
        "Phi0", 
       RowBox[{"(", "T", ")"}]}], " ", "<", " ", 
      RowBox[{"r", 
       RowBox[{"(", "T", ")"}], " ", 
       RowBox[{"(", 
        RowBox[{
        "linear", " ", "interpolation", " ", "in", " ", "the", " ", "table", " ",
          "of", " ", "temperatures"}], ")"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"thCross", "[", "t_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"v", " ", "=", " ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"tau", ",", " ", 
              RowBox[{
               RowBox[{"thGet", "[", 
                RowBox[{"t", ",", " ", "tau", ",", " ", "\"\<Phi0\>\""}], 
                "]"}], "/", 
               RowBox[{"thRadius", "[", 
                RowBox[{"t", ",", " ", "tau"}], "]"}]}]}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"tau", ",", " ", "thTaus"}], "}"}]}], "]"}]}], ",", " ", 
         "k"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"k", " ", "=", " ", 
         RowBox[{"First", "[", 
          RowBox[{"Flatten", "[", 
           RowBox[{"Position", "[", 
            RowBox[{
             RowBox[{"Differences", "[", 
              RowBox[{"Sign", "[", 
               RowBox[{
                RowBox[{"v", "[", 
                 RowBox[{"[", 
                  RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], " ", "-", " ",
                 "1"}], "]"}], "]"}], ",", " ", 
             RowBox[{"d_", " ", "/;", " ", 
              RowBox[{"d", " ", "!=", " ", "0"}]}]}], "]"}], "]"}], "]"}]}], ";",
         "\n", "   ", 
        RowBox[{
         RowBox[{"v", "[", 
          RowBox[{"[", 
           RowBox[{"k", ",", " ", "1"}], "]"}], "]"}], " ", "+", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"v", "[", 
             RowBox[{"[", 
              RowBox[{"k", ",", " ", "2"}], "]"}], "]"}], " ", "-", " ", 
            "1"}], ")"}], " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"v", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"k", " ", "+", " ", "1"}], ",", " ", "1"}], "]"}], 
              "]"}], " ", "-", " ", 
             RowBox[{"v", "[", 
              RowBox[{"[", 
               RowBox[{"k", ",", " ", "1"}], "]"}], "]"}]}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"v", "[", 
              RowBox[{"[", 
               RowBox[{"k", ",", " ", "2"}], "]"}], "]"}], " ", "-", " ", 
             RowBox[{"v", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"k", " ", "+", " ", "1"}], ",", " ", "2"}], "]"}], 
              "]"}]}], ")"}]}]}]}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"thName", "[", "t", "]"}], ",", " ", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{"thTc", "[", "t", "]"}], ",", " ", "6"}], "]"}], ",", 
           " ", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{"thGet", "[", 
              RowBox[{"t", ",", " ", "0.", ",", " ", "\"\<Phi0\>\""}], "]"}], 
             ",", " ", "6"}], "]"}], ",", " ", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{"thGet", "[", 
              RowBox[{"t", ",", " ", "0.98", ",", " ", "\"\<Phi0\>\""}], 
              "]"}], ",", " ", "6"}], "]"}], ",", "\n", "     ", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{"thRadius", "[", 
              RowBox[{"t", ",", " ", "0.98"}], "]"}], ",", " ", "6"}], "]"}], 
           ",", " ", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{"thCross", "[", "t", "]"}], ",", " ", "3"}], "]"}], ",", 
           " ", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{"100", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"thRes", "[", "t", "]"}], "[", "0.", "]"}], "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", "3"}], "]"}], ",", 
           " ", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{"100", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"thRes", "[", "t", "]"}], "[", "0.98", "]"}], "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", "3"}], "]"}], ",", 
           "\n", "     ", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{"100", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"thRes", "[", "t", "]"}], "[", "0.", "]"}], "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", "3"}], "]"}], ",", 
           " ", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{"100", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"thRes", "[", "t", "]"}], "[", "0.98", "]"}], "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", "3"}], "]"}]}], 
          "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"t", ",", " ", "thTags"}], "}"}]}], "]"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<method\>\"", ",", " ", "\"\<T_c\>\"", ",", 
         " ", "\"\<Phi0(0)\>\"", ",", " ", "\"\<Phi0(0.98 T_c)\>\"", ",", 
         " ", "\"\<r(0.98 T_c)\>\"", ",", 
         " ", "\"\<Phi0 < r above T/T_c =\>\"", ",", 
         " ", "\"\<Landau form, T = 0 (%)\>\"", ",", 
         " ", "\"\<Landau form, 0.98 T_c (%)\>\"", ",", "\n", 
         "    ", "\"\<quartic form, T = 0 (%)\>\"", ",", 
         " ", "\"\<quartic form, 0.98 T_c (%)\>\""}], "}"}]}], "]"}], ",", 
     " ", 
     RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
     RowBox[{"Alignment", " ", "->", " ", "Right"}], ",", " ", 
     RowBox[{"BaseStyle", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"FontSize", " ", "->", " ", "8"}], "}"}]}]}], 
    "]"}]}]}]], "Input",
 CellLabel->
  "In[353]:=",ExpressionUUID->"34b8f180-027e-464b-8a19-980b8a42e06f"],

