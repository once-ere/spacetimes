Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", "table", " ", "of", " ", "all", " ", 
     RowBox[{"checks", ":", " ", "identifier"}]}], ",", " ", "result", ",", 
    " ", "deviation", ",", " ", "tolerance", ",", " ", "counterparts"}], " ", 
   "*)"}], "\n", 
  RowBox[{"Grid", "[", 
   RowBox[{
    RowBox[{"Prepend", "[", 
     RowBox[{
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"#", "[", "\"\<id\>\"", "]"}], ",", " ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"#", "[", "\"\<pass\>\"", "]"}], ",", " ", "\"\<PASS\>\"",
              ",", " ", "\"\<FAIL\>\""}], "]"}], ",", " ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"NumericQ", "[", 
              RowBox[{"#", "[", "\"\<deviation\>\"", "]"}], "]"}], ",", " ", 
