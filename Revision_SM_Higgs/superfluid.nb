]}]}]}]}]}]}], "-", "12"}], ":", " ", 
    RowBox[{"the", " ", "mass", " ", "matrix"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"phiv", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "ph"}], "}"}]}], ";", " ", 
    RowBox[{"phivp", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"php", ",", " ", "0"}], "}"}]}], ";"}], 
   "                      ", 
   RowBox[{"(*", " ", 
    RowBox[{"the", " ", "lengths", " ", "phi", " ", "and", " ", 
     RowBox[{"phi", "'"}], " ", "of", " ", "the", " ", "two", " ", 
     "condensates"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"ga", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"g", ",", " ", "g", ",", " ", "g", ",", " ", "gp"}], "}"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"m2", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"ga", "[", 
           RowBox[{"[", "a", "]"}], "]"}], " ", 
          RowBox[{"ga", "[", 
           RowBox[{"[", "b", "]"}], "]"}], " ", 
          RowBox[{"ComplexExpand", "[", 
           RowBox[{"Re", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Conjugate", "[", "phiv", "]"}], ".", 
              RowBox[{"acomm", "[", 
               RowBox[{
                RowBox[{"hg", "[", 
                 RowBox[{"[", "a", "]"}], "]"}], ",", " ", 
                RowBox[{"hg", "[", 
                 RowBox[{"[", "b", "]"}], "]"}]}], "]"}], ".", "phiv"}], " ", 
             "+", "\n", "        ", 
             RowBox[{
              RowBox[{"Conjugate", "[", "phivp", "]"}], ".", 
              RowBox[{"acomm", "[", 
               RowBox[{
                RowBox[{"hg2", "[", 
                 RowBox[{"[", "a", "]"}], "]"}], ",", " ", 
                RowBox[{"hg2", "[", 
                 RowBox[{"[", "b", "]"}], "]"}]}], "]"}], ".", "phivp"}]}], 
            "]"}], "]"}]}], ",", " ", 
         RowBox[{"Assumptions", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"g", " ", ">", " ", "0"}], ",", " ", 
            RowBox[{"gp", " ", ">", " ", "0"}], ",", " ", 
            RowBox[{"ph", " ", ">", " ", "0"}], ",", " ", 
            RowBox[{"php", " ", ">", " ", "0"}]}], "}"}]}]}], "]"}], ",", 
       "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "4"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"b", ",", " ", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ev12", " ", "=", " ", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{"Eigenvalues", "[", "m2", "]"}], ",", " ", 
       RowBox[{"Assumptions", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"g", " ", ">", " ", "0"}], ",", " ", 
          RowBox[{"gp", " ", ">", " ", "0"}], ",", " ", 
          RowBox[{"ph", " ", ">", " ", "0"}], ",", " ", 
          RowBox[{"php", " ", ">", " ", "0"}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"vv", " ", "=", " ", 
     RowBox[{"2", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"ph", "^", "2"}], " ", "+", " ", 
        RowBox[{"php", "^", "2"}]}], ")"}]}]}], ";"}], 
   "                                  ", 
   RowBox[{"(*", " ", 
    RowBox[{"v_SH", "^", "2"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"wantEv", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", 
       RowBox[{
        RowBox[{"g", "^", "2"}], " ", 
        RowBox[{"vv", "/", "4"}]}], ",", " ", 
       RowBox[{
        RowBox[{"g", "^", "2"}], " ", 
        RowBox[{"vv", "/", "4"}]}], ",", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"g", "^", "2"}], " ", "+", " ", 
          RowBox[{"gp", "^", "2"}]}], ")"}], " ", 
        RowBox[{"vv", "/", "4"}]}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nul", " ", "=", " ", 
     RowBox[{"NullSpace", "[", "m2", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rho12", " ", "=", " ", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"g", "^", "2"}], " ", 
         RowBox[{"vv", "/", "4"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"g", "^", "2"}], " ", "+", " ", 
           RowBox[{"gp", "^", "2"}]}], ")"}], " ", 
         RowBox[{"vv", "/", "4"}], " ", 
         RowBox[{
          RowBox[{"g", "^", "2"}], "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"g", "^", "2"}], " ", "+", " ", 
            RowBox[{"gp", "^", "2"}]}], ")"}]}]}], ")"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ok12", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Sort", "[", 
        RowBox[{"Expand", "[", "ev12", "]"}], "]"}], " ", "===", " ", 
       RowBox[{"Sort", "[", 
        RowBox[{"Expand", "[", "wantEv", "]"}], "]"}]}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"Length", "[", "nul", "]"}], " ", "==", " ", "1"}], " ", "&&", 
      "\n", "  ", 
      RowBox[{
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"nul", "[", 
          RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"nul", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", " ", "4"}], "]"}], "]"}], "/", "g"}], ")"}], " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "0", ",", " ", "gp", ",", " ", "g"}], 
           "}"}]}]}], "]"}], " ", "==", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], "}"}]}], 
      " ", "&&", " ", 
      RowBox[{"rho12", " ", "===", " ", "1"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rvCheck", "[", 
     RowBox[{"\"\<WQN-12\>\"", ",", 
      " ", "\"\<the mass matrix of (W^1, W^2, W^3, B) from Phi_SH = (0, phi) \
and Phi'_SH = (phi', 0): eigenvalues 0, \\\ng^2 v_SH^2/4 (twice), (g^2 + \
g'^2) v_SH^2/4 with v_SH^2 = 2 (phi^2 + phi'^2) for any phi, phi', the \
massless vector \\\nalong (0, 0, g', g), and rho = 1 (symbolic couplings and \
lengths)\>\"", ",", " ", "ok12", ",", "\n", "  ", 
      RowBox[{"\"\<eigenvalues \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"ev12", ",", " ", "InputForm"}], "]"}]}]}], "]"}], 
    ";"}]}]}]], "Input",
 CellLabel->
  "In[545]:=",ExpressionUUID->"8f80135c-b825-4a64-8a1b-80f86651188e"],

