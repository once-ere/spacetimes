  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dbcc1611-c14e-44da-b01a-16a73078aba0"],
 " (the pairs with ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Chi]", 
    StyleBox["SH",
     FontSlant->"Plain"], "\[Prime]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "08ac8883-7960-43bc-9d0f-8f8c2ecdaea3"],
