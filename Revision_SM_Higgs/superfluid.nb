Cell[CellGroupData[{

Cell["III.L.6 Why it matters", "Section",ExpressionUUID->"c5453adf-c47d-444b-a84b-590fc1784bb0"],

Cell[TextData[{
 StyleBox["It enters no other result.",
  FontWeight->"Bold"],
 " The effective Lagrangians of the solution contain the computed function ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalV]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8da8af68-38a5-4f2b-91c7-75f207160bb5"],
 ", not the Landau form, and no other result uses ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "62480621-263f-40b9-95c9-e1c9d55bf920"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["b", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ead2e183-67e9-4152-90d3-dbe292f56080"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "48ff723d-6a8e-49a2-8dc8-8d72d308c8e6"],
 ": the mass of the amplitude mode uses the curvature ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalV]",
     FontSlant->"Plain"], 
    StyleBox["amp",
     FontSlant->"Plain"], "\[Prime]\[Prime]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f99eee02-2df7-4070-a6a7-67b8c05d325d"],
 " of the computed curve, ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["u", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "febc2dde-13ba-4a36-a907-d1e55dd0c8cf"],
 " and the mass of the non-unitary modes use the computed curvature in the \
non-unitary direction, and the masses of the gauge bosons and the dynamics \
use ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalPhi]", 
    RowBox[{"0", ",", 
     StyleBox["SF",
      FontSlant->"Plain"]}], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8f3bf95e-8fef-4816-987a-e487ed3abbc4"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["Z", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e9caa46c-5562-4b97-a44b-a4a73ac74ad0"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["Y", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "01c07ca3-6383-4afd-a507-0d1ce5d1868e"],
 " and the susceptibilities."
}], "ItemNumbered",ExpressionUUID->"1b0dce81-e588-485c-a78a-e3bd0525035c"],

Cell[TextData[{
 StyleBox["It matters to whoever replaces $\\mathcal V^X_{\\rm SF}$ by the \
Landau form",
  FontWeight->"Bold"],
 ", as in a model of the type of Ginzburg and Landau or of Higgs: the minimum \
of the polynomial is 0.04 to 0.11 per cent too small, its depth 0.12 to 0.31 \
per cent too large, its curvature at its minimum 0.86 to 2.3 per cent too \
large, and the mass of the amplitude mode 0.43 to 1.1 per cent too large (the \
table above). A derivative enlarges the relative error of the function. \
Beyond the fitted interval the error grows: fitted on the whole computed \
curve, the form misses by 1.2 to 1.7 per cent of the depth."
}], "ItemNumbered",ExpressionUUID->"e4d549e1-d914-46c1-9435-7b7eb35ed2bc"],

Cell[TextData[{
 StyleBox["The coefficients are not constants of the theory.",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7dd89d37-db0d-434d-b1d6-147b4d0b908a"],
 " differs from the Taylor coefficient at the origin, and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["b", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "df3abe10-d14f-4b38-a588-d3ee889855ee"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0fbf2fb9-c9bd-4efb-a3a2-7b79769fe7a4"],
 " change with the fitted interval and with the number of powers (the last \
four rows of the table). No physical meaning may be given to ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["b", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "74d4a7df-8122-4590-bb32-300abca6f006"],
 " or ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "111f8a41-d55b-4cd9-938f-96df7438214b"],
 " alone. The physical quantities are those that the computed function \
defines: ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalPhi]", 
    RowBox[{"0", ",", 
     StyleBox["SF",
      FontSlant->"Plain"]}], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e86f2ae6-a29d-406c-b2ac-9ab1835c7ddc"],
 ", the depth, the curvatures at the minimum, and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["Tay",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8fca02c6-097a-44b5-9071-8632b573b5bf"],
 "."
}], "ItemNumbered",ExpressionUUID->"60ab7616-41ea-4716-a04b-4429db6ccadd"],

Cell[TextData[{
 StyleBox["The qualitative results do not depend on the fit.",
  FontWeight->"Bold"],
 " That ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalV]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1b9cf7ec-bc01-424c-ad36-17042d0aa473"],
 " vanishes at the origin, is negative near it, has its minimum at ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalPhi]", 
    RowBox[{"0", ",", 
     StyleBox["SF",
      FontSlant->"Plain"]}], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "658a0482-8a80-4166-9d59-36e62324f85e"],
 ", depends only on the two invariants, and has a stable polar minimum (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["u", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], ">", "0"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fa61fe15-6d83-47ed-b8ec-47362feab877"],
 ") are properties of the computed function, checked on it directly; the sign \
of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "df96a73e-ac5c-43c1-946d-fe96250f69e3"],
 " is that of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["Tay",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8fe61ccf-2613-4a59-82fb-9914c3775867"],
 " (negative: the normal vacuum is unstable)."
}], "ItemNumbered",ExpressionUUID->"1d82938c-a79b-47da-b5ce-bf045cce8e92"],

Cell[TextData[{
 StyleBox["The comparison with the Standard Model.",
  FontWeight->"Bold"],
 " The field has a Mexican hat with the symmetry structure of the Higgs \
sector and of the polar phase of a condensate of spin 1, but its potential is \
not the quartic potential of the Standard Model: the quartic form misses ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalV]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d771e159-a4a1-44a7-9ec8-1c4ecc7a25b6"],
 " by 2.8 to 5.9 per cent of the depth, about ten times more than the Landau \
form with the sixth power."
}], "ItemNumbered",ExpressionUUID->"60317834-2578-40c8-a7d9-9733df487be1"],

Cell[TextData[{
 StyleBox["Corrections of the first answers.",
  FontWeight->"Bold"],
 " The first answers to the author contained five statements that were not \
exact; the numbers of this chapter are the corrected ones. (1) The residual \
changes its sign three times, not five. (2) The fit called a fit on ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"0", ",", "2", 
     SubscriptBox["\[CapitalPhi]", "0"]}], "]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c14df122-3c5b-4430-a431-ece0b7ce4590"],
 " used all 61 points of the curve, whose fields reach 1.52 to 1.64 times ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalPhi]", 
    RowBox[{"0", ",", 
     StyleBox["SF",
      FontSlant->"Plain"]}], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1309aab5-4211-4c6c-ba08-b3ad313a9b62"],
 "; the applied field, not the field of the states, reaches ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    SubsuperscriptBox["\[CapitalPhi]", 
     RowBox[{"0", ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "32d73c30-b088-4025-883f-69695c2c7e90"],
 ". (3) The range of the end of the curve is 1.52 to 1.64 (HS ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "0"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "034bf508-7a15-4f34-b4c0-4c2c377be39a"],
 "), not 1.52 to 1.61. (4) The singularity lies at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"], "2"], "\[LongEqual]", 
    RowBox[{"-", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["M", "TI"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["X", "TI"], ",", 
         StyleBox["D",
          FontSlant->"Plain"]}]], ")"}], "2"]}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b0e3dc13-abf0-4e37-b335-316965c012cc"],
 " in the applied field; in the field of the states the radius of convergence \
is of the order of the Dirac mass, not equal to it. (5) The errors of the \
curvature quoted first, 1.1 to 2.7 per cent, are those of the polynomial at \
the minimum of the computed curve; at the polynomial's own minimum, where a \
user evaluates it, they are 0.86 to 2.3 per cent, as the table shows."
}], "Text",ExpressionUUID->"9c89223c-3a28-41fd-96ad-d846d69dd9bb"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Part III, second section. The free energy at finite temperature: the critical \
temperatures and the size of the order parameter\
\>", "Chapter",ExpressionUUID->"20b0eb9f-6248-4ca5-a94c-4d5e6d6617c0"],

Cell[TextData[{
 "On 21 November 2026 the author asked to add to the analysis and the \
solution the effective potential and the free energy of each of the five \
computed methods ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d8f277f7-0863-453a-8d31-a17c9a396d1b"],
 " (HS ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"1", ",", "1"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fa7ce760-64bf-4cf8-b0fa-401d86d8d2da"],
 ", HS ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "1"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8718f93c-9b7d-43d6-af60-76a7321d459c"],
 ", HS ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "0"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "08acb93c-06b1-4f0f-9774-96e074156ed1"],
 ", KS and CJT), to determine whether the order parameter is then smaller and \
more physically reasonable, and to document this addendum with its \
provenance. The effective potential of each method is the subject of Section \
III.L. This chapter computes the free energy at the temperature ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b065e4da-8219-406d-b2d0-860852694261"],
 " with the engine of Part II, shows that its value at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c594e54c-d8c5-44c9-9a81-3904eedd3cf4"],
 " is the effective potential, finds the critical temperatures, and answers \
the question (Section III.T.6). The Rust program ",
 StyleBox["sf_part3",
  FontFamily->"Source Code Pro"],
 " (module ",
 StyleBox["thermal",
  FontFamily->"Source Code Pro"],
 ") and the Python program ",
 StyleBox["sf_part3.py",
  FontFamily->"Source Code Pro"],
 " compute the same things; the closed cell of Section III.T.2 holds their \
values for the comparison."
}], "Text",ExpressionUUID->"864c7f02-beb2-4633-9ad6-d03257e29bc0"],

Cell[CellGroupData[{

Cell["III.T.1 The free energy of a state at the temperature T", "Section",ExpressionUUID->"5ae19247-0bc5-4ed2-94aa-40c69dd1cea1"],

Cell[TextData[{
 StyleBox["Units and conditions.",
  FontWeight->"Bold"],
 " The temperature ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "760a0d79-a556-479d-a60a-ac4dd3a7ea0d"],
 " is measured in units of energy (Boltzmann's constant ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["k", "TI"], 
     StyleBox["B",
      FontSlant->"Plain"]], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f9406b0f-7232-4e8b-a5b4-b28816367c54"],
 "), in the units of the project (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9ad8437b-3087-4778-9712-70767fa47bf5"],
 "). The chemical potential ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Mu]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d313272a-bda7-4a1a-970e-f97129e6142e"],
 " of the fermion number is zero, as everywhere in the solution: the states \
hold as many particles as antiparticles. ",
 StyleBox["The thermal states.",
  FontWeight->"Bold"],
 " At the temperature ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c525ecda-4af7-4be2-a103-28a76c3c5bb1"],
 " a uniform quasi-free state is the thermal state of its matrix of \
Bogoliubov and de Gennes ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["H",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e8b3268f-5e3b-478d-a5bc-5b969985f19c"],
 " (Section II.2): at every momentum its generalized density, the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"16", "\[Times]", "16"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1d5547d9-5324-4ffe-8230-c3428a607af6"],
 " matrix of the normal and the pair correlations, is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["f", "TI"], 
    RowBox[{"(", 
     SubscriptBox[
      StyleBox["H",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["SF",
       FontSlant->"Plain"]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e9fd03bb-8e31-4ef0-a600-5b08f6f73f9d"],
 ", the Fermi function ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["f", "TI"], 
    RowBox[{"(", "\[CurlyEpsilon]", ")"}], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        StyleBox["e", "TI"], 
        RowBox[{"\[CurlyEpsilon]", "/", 
         StyleBox["T", "TI"]}]], "+", "1"}], ")"}], 
     RowBox[{"-", "1"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1e38e5b1-04cc-49aa-bbed-2f08abe6e1a9"],
 " applied to the eigenvalues ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CurlyEpsilon]", 
    StyleBox["k", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "282be07e-5774-48be-81b4-3ff8d8097a4b"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["k", "TI"], "\[LongEqual]", "1", ",", "\[Ellipsis]", ",", "16"}],
    TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1b147aa1-b560-4919-91b4-cfbcb557c905"],
 ") of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["H",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "84ddc06e-108a-4e74-a124-24d53f4d4b48"],
 ", with the occupations ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["f", "TI"], 
     StyleBox["k", "TI"]], "\[LongEqual]", 
    StyleBox["f", "TI"], 
    RowBox[{"(", 
     SubscriptBox["\[CurlyEpsilon]", 
      StyleBox["k", "TI"]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "66b86df4-b095-4d85-a93e-65bf253d1ac2"],
 ". At ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b86e38bc-98a7-44c0-a7a5-861e86622821"],
 " the Fermi function is 1 for the negative and 0 for the positive \
eigenvalues, and the thermal state is the ground state of Part II. ",
 StyleBox["The free energy",
  FontWeight->"Bold"],
 " per volume of method ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7adb0b40-5850-4b38-9975-1b12355540ef"],
 " is"
}], "Text",ExpressionUUID->"35837a9b-e6cc-41ad-90f1-7628a40665ea"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalE]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], "-", 
   StyleBox["T", "TI"], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["\[ScriptCapitalS]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"]], ",", "      ", 
   SubscriptBox[
    StyleBox["\[ScriptCapitalS]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"]], "\[LongEqual]", 
   RowBox[{"-", 
    FractionBox["1", "2"]}], "\[ThinSpace]", "\[Integral]", 
   FractionBox[
    RowBox[{
     SuperscriptBox[
      StyleBox["d", "TI"], "3"], 
     StyleBox["q", "TI"]}], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"2", "\[Pi]"}], ")"}], "3"]], "\[ThinSpace]", 
   UnderoverscriptBox["\[Sum]", 
    RowBox[{
     StyleBox["k", "TI"], "\[LongEqual]", "1"}], "16",
    LimitsPositioning->True], 
   RowBox[{"[", 
    RowBox[{
     SubscriptBox[
      StyleBox["f", "TI"], 
      StyleBox["k", "TI"]], "\[ThinSpace]", 
     StyleBox["ln",
      FontSlant->"Plain"], "\[ThinSpace]", 
     SubscriptBox[
      StyleBox["f", "TI"], 
      StyleBox["k", "TI"]], "+", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       SubscriptBox[
        StyleBox["f", "TI"], 
        StyleBox["k", "TI"]]}], ")"}], "\[ThinSpace]", 
     StyleBox["ln",
      FontSlant->"Plain"], 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       SubscriptBox[
        StyleBox["f", "TI"], 
        StyleBox["k", "TI"]]}], ")"}]}], "]"}], ","}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"24e966fd-a29c-46be-9444-ccde0aa63f7e"],

Cell[TextData[{
 "with the energy per volume ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalE]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c08d2e1e-44fa-49b9-82c7-8ea7b21c62bd"],
 " of method ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e53767c0-492a-4e2b-852b-55aaba3edc3a"],
 " (unchanged, Section II.2) and the entropy per volume ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["\[ScriptCapitalS]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "28291a89-8147-426c-a19c-63f72eaf909a"],
 " of the quasi-free state. Every mode of the doubled space of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["H",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "71678134-0c91-4d3f-9718-87f7118898ec"],
 " appears twice, at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", "\[CurlyEpsilon]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6a027296-b750-436e-b81e-ad8827e3f68c"],
 " with the occupations ",
 Cell[BoxData[
  FormBox[
   StyleBox["f", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2f08e59a-b1ad-461c-adc4-b256aa2787f9"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "-", 
    StyleBox["f", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cc9bf837-9329-4767-9385-68547b8efa44"],
 ", hence the factor ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "af1f07e2-7b00-44c4-aee8-069dda960b78"],
 ". The self-energies are the derivatives of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalE]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "42f8b598-d75e-4418-9e9c-611bcf9a8be3"],
 " as at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "17bd1665-7c1c-4e87-9a3b-e7d963e8f776"],
 ", and the stationary points of the free energy are the self-consistent \
thermal states. In HS this is the free energy of the saddle point of the \
auxiliary fields; in CJT the effective action at the temperature ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "650676cb-a879-4f22-975b-8c697a7f66d8"],
 " with the truncation of the method at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "335819cc-8996-421a-bff2-2172bdefcbea"],
 "; in KS the functional of N. D. Mermin (the theory of Hohenberg, Kohn and \
Sham at finite temperature) with the entropy of the quasi-free state of Kohn \
and Sham and the exchange-correlation energy of the method at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ef945dcf-0d99-48fc-896e-b08cfac26e4a"],
 " (in the exact theory of Mermin the exchange-correlation free energy \
depends on the temperature; here only the states do, an approximation of the \
method). ",
 StyleBox["The free energy of the field",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[CapitalPhi]", "\[RightVector]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5781ac2f-ad66-45ae-ba2c-6c7fc8f4b79d"],
 " is the smallest free energy among the thermal states with this field, \
measured from the normal state at the same temperature:"
}], "Text",ExpressionUUID->"054f2712-ada2-4161-9619-71fef3f6a76e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalF]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], 
   RowBox[{"(", 
    RowBox[{
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], ";", 
     StyleBox["T", "TI"]}], ")"}], "\[LongEqual]", 
   StyleBox["min",
    FontSlant->"Plain"], 
   RowBox[{"{", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["\[ScriptCapitalE]",
       FontSlant->"Plain"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      StyleBox["X", "TI"]], "-", 
     StyleBox["T", "TI"], 
     SubscriptBox[
      StyleBox["\[ScriptCapitalS]",
       FontSlant->"Plain"], 
      StyleBox["SF",
       FontSlant->"Plain"]], ":", " ", 
     SubsuperscriptBox[
      OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      StyleBox["X", "TI"]], "\[LongEqual]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"]}], "}"}], "-", 
   SubscriptBox[
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["\[ScriptCapitalE]",
        FontSlant->"Plain"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["X", "TI"]], "-", 
      StyleBox["T", "TI"], 
      SubscriptBox[
       StyleBox["\[ScriptCapitalS]",
        FontSlant->"Plain"], 
       StyleBox["SF",
        FontSlant->"Plain"]]}], ")"}], 
    StyleBox["normal",
     FontSlant->"Plain"]], "."}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"ff444485-5e07-4857-8d6d-89e6e5c69122"],

Cell[TextData[{
 "It is computed point by point as the effective potential of Section III.L: \
a fixed pair self-energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a14c19d3-22ba-4028-98c1-75b9c7cf3303"],
 " (the applied field) is put into ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["H",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b3ba5511-85b8-4557-a561-fa160468ed2d"],
 ", the normal self-energy is made self-consistent at the temperature ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d2af4c14-e380-451f-9a44-6bfe6b95e5aa"],
 ", and the thermal state gives one point, its own field ",
 Cell[BoxData[
  FormBox["\[CapitalPhi]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c1684390-35d0-4e39-a3f9-8ad34e60be22"],
 " and its free energy. Its minimum lies at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}], "\[LongEqual]", 
    SubsuperscriptBox["\[CapitalPhi]", 
     RowBox[{"0", ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b6e6cc57-a296-4916-9539-6e694bd62abb"],
 ", the ",
 StyleBox["order parameter at the temperature $T$",
  FontWeight->"Bold"],
 ": the modulus of the field of the self-consistent superfluid at ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8231a9b8-c2bd-4804-8c68-1e60c0b8f588"],
 ". At ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9cf96d0e-4601-4df9-9bec-fd4a77361c78"],
 " the entropy vanishes and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalF]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], 
    RowBox[{"(", 
     RowBox[{
      OverscriptBox["\[CapitalPhi]", "\[RightVector]"], ";", "0"}], ")"}], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalV]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], 
    RowBox[{"(", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], ")"}]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "935209a2-6c9f-46a3-8780-e9ab3e760b43"],
 ": ",
 StyleBox["the effective potential is the free energy at zero temperature",
  FontWeight->"Bold"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalPhi]", 
     RowBox[{"0", ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]], 
    RowBox[{"(", "0", ")"}], "\[LongEqual]", 
    SubsuperscriptBox["\[CapitalPhi]", 
     RowBox[{"0", ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0ee187cc-5d4d-4310-b21b-7958a2c7d569"],
 ". The next cell defines the thermal states of the engine of Part II: ",
 StyleBox["thermalNode",
  FontFamily->"Source Code Pro"],
 " makes ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["f", "TI"], 
    RowBox[{"(", 
     SubscriptBox[
      StyleBox["H",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["SF",
       FontSlant->"Plain"]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3b02365d-cac1-4b9a-a258-b5c32b6e32a9"],
 " and the entropy of one node of the grid, ",
 StyleBox["solveSFT",
  FontFamily->"Source Code Pro"],
 " the self-consistent thermal state, and ",
 StyleBox["fixedPairT",
  FontFamily->"Source Code Pro"],
 " the thermal state of an applied pair field."
}], "Text",ExpressionUUID->"366d1a9a-d84d-4ccf-81e3-f998ac2eb422"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"fermiSF", "[", 
     RowBox[{"e", ",", " ", "t"}], "]"}], ":", " ", 
    RowBox[{"the", " ", "Fermi", " ", "function", " ", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"e", "^", 
         RowBox[{"(", 
          RowBox[{"e", "/", "t"}], ")"}]}], " ", "+", " ", "1"}], ")"}]}], " ",
      "of", " ", "the", " ", "energy", " ", "e", " ", "at", " ", "the", " ", 
     "temperature", " ", "t", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"the", " ", "step", " ", "function", " ", "at", " ", "t"}], 
       " ", "=", " ", "0"}], ")"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"fermiSF", "[", 
      RowBox[{
       RowBox[{"e_", "?", "NumericQ"}], ",", " ", 
       RowBox[{"t_", "?", "NumericQ"}]}], "]"}], " ", ":=", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"t", " ", "<=", " ", "0"}], ",", " ", 
       RowBox[{"Which", "[", 
        RowBox[{
         RowBox[{"e", " ", "<", " ", "0"}], ",", " ", "1.", ",", " ", 
         RowBox[{"e", " ", ">", " ", "0"}], ",", " ", "0.", ",", " ", "True", 
         ",", " ", "0.5"}], "]"}], ",", " ", 
       RowBox[{"1.", "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{"Clip", "[", 
            RowBox[{
             RowBox[{"e", "/", "t"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "700."}], ",", " ", "700."}], "}"}]}], "]"}], 
           "]"}], " ", "+", " ", "1."}], ")"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"binEntropy", "[", "f", "]"}], ":", " ", 
     RowBox[{
      RowBox[{"the", " ", "entropy"}], " ", "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"f", " ", "ln", " ", "f"}], " ", "+", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", " ", "-", " ", "f"}], ")"}], " ", "ln", 
          RowBox[{"(", 
           RowBox[{"1", " ", "-", " ", "f"}], ")"}]}]}], ")"}], " ", "of", " ",
        "a", " ", "mode", " ", "with", " ", "the", " ", "occupation", " ", 
       "f", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"zero", " ", "at", " ", "f"}], " ", "=", " ", 
         RowBox[{
          RowBox[{"0", " ", "and", " ", "f"}], " ", "=", " ", "1"}]}], 
        ")"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"binEntropy", "[", "f_", "]"}], " ", ":=", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"0", " ", "<", " ", "f", " ", "<", " ", "1"}], ",", " ", 
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"f", " ", 
           RowBox[{"Log", "[", "f", "]"}]}], " ", "+", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", " ", "-", " ", "f"}], ")"}], " ", 
           RowBox[{"Log", "[", 
            RowBox[{"1", " ", "-", " ", "f"}], "]"}]}]}], ")"}]}], ",", " ", 
       "0."}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"thermalNode", "[", 
      RowBox[{"h", ",", " ", "t"}], "]"}], ":", " ", 
     RowBox[{"the", " ", "thermal", " ", "state", " ", "f", 
      RowBox[{"(", "H", ")"}], " ", "of", " ", "one", " ", "BdG", " ", 
      "matrix", " ", "h", " ", "at", " ", "the", " ", "temperature", " ", 
      "t"}], ":", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"C", "^", "n"}], ",", " ", 
       RowBox[{"C", "^", "p"}], ",", " ", 
       RowBox[{"the", " ", "sorted", " ", "eigenvalues"}], ",", " ", 
       RowBox[{
       "the", " ", "sum", " ", "of", " ", "the", " ", "entropies", " ", "of", 
        " ", "the", " ", "16", " ", "modes"}]}], "}"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"thermalNode", "[", 
      RowBox[{"h_", ",", " ", "t_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ev", ",", " ", "vec", ",", " ", "f", ",", " ", "r"}], "}"}], 
       ",", "\n", "   ", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"ev", ",", " ", "vec"}], "}"}], " ", "=", " ", 
         RowBox[{"Eigensystem", "[", 
          RowBox[{"0.5", " ", 
           RowBox[{"(", 
            RowBox[{"h", " ", "+", " ", 
             RowBox[{"ConjugateTranspose", "[", "h", "]"}]}], ")"}]}], 
          "]"}]}], ";", " ", 
        RowBox[{"ev", " ", "=", " ", 
         RowBox[{"Re", "[", "ev", "]"}]}], ";", "\n", "   ", 
        RowBox[{"f", " ", "=", " ", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"fermiSF", "[", 
             RowBox[{"#", ",", " ", "t"}], "]"}], " ", "&"}], ",", " ", 
           "ev"}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"r", " ", "=", " ", 
         RowBox[{
          RowBox[{"Transpose", "[", "vec", "]"}], " ", ".", " ", 
          RowBox[{"DiagonalMatrix", "[", "f", "]"}], " ", ".", " ", 
          RowBox[{"Conjugate", "[", "vec", "]"}]}]}], ";", "   ", 
        RowBox[{"(*", " ", 
         RowBox[{"R", " ", "=", " ", 
          RowBox[{"sum_k", " ", "f_k", " ", "v_k", " ", 
           RowBox[{"v_k", "^", "dag"}]}]}], " ", "*)"}], "\n", "   ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"r", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"1", " ", ";;", " ", "8"}], ",", " ", 
             RowBox[{"1", " ", ";;", " ", "8"}]}], "]"}], "]"}], ",", " ", 
          RowBox[{"-", 
           RowBox[{"r", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"1", " ", ";;", " ", "8"}], ",", " ", 
              RowBox[{"9", " ", ";;", " ", "16"}]}], "]"}], "]"}]}], ",", " ", 
          RowBox[{"Sort", "[", "ev", "]"}], ",", " ", 
          RowBox[{"Total", "[", 
           RowBox[{"Map", "[", 
            RowBox[{"binEntropy", ",", " ", "f"}], "]"}], "]"}]}], "}"}]}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"solveSFT", "[", 
       RowBox[{
       "mo", ",", " ", "N0", ",", " ", "P0", ",", " ", "t", ",", " ", "mix", ",",
         " ", "tol", ",", " ", "maxit"}], "]"}], ":", " ", 
      RowBox[{
       RowBox[{"the", " ", "self"}], "-", 
       RowBox[{
       "consistent", " ", "thermal", " ", "state", " ", "at", " ", "the", " ",
         "temperature", " ", "t", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
          "the", " ", "stationary", "\n", "   ", "point", " ", "of", " ", 
           "E"}], " ", "-", " ", 
          RowBox[{"t", " ", "S"}]}], ")"}], " ", "from", " ", "the", " ", 
        "initial", " ", "self"}], "-", 
       RowBox[{"energies", " ", "N0"}]}]}], ",", " ", 
     RowBox[{"P0", ":", " ", 
      RowBox[{
       RowBox[{"the", " ", "self"}], "-", "energies"}]}], ",", " ", 
     RowBox[{"the", " ", "energy", " ", "per", " ", "volume", " ", 
      RowBox[{"(", 
       RowBox[{"from", " ", "the", " ", "normal", "\n", "   ", "vacuum"}], 
       ")"}]}], ",", " ", 
     RowBox[{"the", " ", "entropy", " ", "per", " ", "volume"}], ",", " ", 
     RowBox[{
     "the", " ", "free", " ", "energy", " ", "per", " ", "volume", " ", "and",
       " ", "the", " ", "number", " ", "of", " ", "iterations"}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"solveSFT", "[", 
      RowBox[{
      "mo_", ",", " ", "n0_", ",", " ", "p0_", ",", " ", "t_", ",", " ", 
       RowBox[{"mix_", " ", ":", " ", "0.6"}], ",", " ", 
       RowBox[{"tol_", " ", ":", " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "13"}]}]}], ",", " ", 
       RowBox[{"maxit_", " ", ":", " ", "400000"}]}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", "\n", "   ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ns", " ", "=", " ", "n0"}], ",", " ", 
         RowBox[{"ps", " ", "=", " ", "p0"}], ",", " ", "res", ",", " ", "cn",
          ",", " ", "cp", ",", " ", "ent", ",", " ", "rho", ",", " ", "kap", ",",
          " ", "ek", ",", " ", "ei", ",", " ", "n2", ",", " ", "p2", ",", " ",
          "r", ",", " ", 
         RowBox[{"it", " ", "=", " ", "0"}], ",", " ", 
         RowBox[{"out", " ", "=", " ", "None"}]}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{"out", " ", "===", " ", "None"}], ",", "\n", "     ", 
          RowBox[{
           RowBox[{"res", " ", "=", " ", 
            RowBox[{"Map", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"thermalNode", "[", 
                RowBox[{"#", ",", " ", "t"}], "]"}], " ", "&"}], ",", " ", 
              RowBox[{"bdg", "[", 
               RowBox[{"mo", ",", " ", "ns", ",", " ", "ps"}], "]"}]}], 
             "]"}]}], ";", "\n", "     ", 
           RowBox[{"cn", " ", "=", " ", 
            RowBox[{"res", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], ";", " ", 
           RowBox[{"cp", " ", "=", " ", 
            RowBox[{"res", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], ";", "\n", 
           "     ", 
           RowBox[{"ent", " ", "=", " ", 
            RowBox[{"0.5", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"mo", "[", "\"\<g\>\"", "]"}], "[", "\"\<w\>\"", "]"}],
               " ", ".", " ", 
              RowBox[{"res", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", " ", "4"}], "]"}], "]"}]}]}]}], ";", "\n",
            "     ", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"rho", ",", " ", "kap", ",", " ", "ek"}], "}"}], " ", "=",
             " ", 
            RowBox[{"localDens", "[", 
             RowBox[{"mo", ",", " ", "cn", ",", " ", "cp"}], "]"}]}], ";", 
           "\n", "     ", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"ei", ",", " ", "n2", ",", " ", "p2"}], "}"}], " ", "=", 
            " ", 
            RowBox[{"interaction", "[", 
             RowBox[{
              RowBox[{"mo", "[", "\"\<ts\>\"", "]"}], ",", " ", "rho", ",", 
              " ", "kap"}], "]"}]}], ";", "\n", "     ", 
           RowBox[{"r", " ", "=", " ", 
            RowBox[{"Max", "[", 
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{"n2", " ", "-", " ", "ns"}], "]"}], ",", " ", 
              RowBox[{"Abs", "[", 
               RowBox[{"p2", " ", "-", " ", "ps"}], "]"}]}], "]"}]}], ";", 
           "\n", "     ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"r", " ", "<", " ", "tol"}], " ", "||", " ", 
              RowBox[{"it", " ", ">=", " ", "maxit"}]}], ",", "\n", "       ", 
             RowBox[{"out", " ", "=", " ", 
              RowBox[{"<|", 
               RowBox[{
                RowBox[{"\"\<n\>\"", " ", "->", " ", "n2"}], ",", " ", 
                RowBox[{"\"\<p\>\"", " ", "->", " ", "p2"}], ",", " ", 
                RowBox[{"\"\<e\>\"", " ", "->", " ", 
                 RowBox[{"ek", " ", "+", " ", "ei"}]}], ",", " ", 
                RowBox[{"\"\<s\>\"", " ", "->", " ", "ent"}], ",", " ", 
                RowBox[{"\"\<free\>\"", " ", "->", " ", 
                 RowBox[{"ek", " ", "+", " ", "ei", " ", "-", " ", 
                  RowBox[{"t", " ", "ent"}]}]}], ",", " ", 
                RowBox[{"\"\<it\>\"", " ", "->", " ", "it"}], ",", " ", 
                RowBox[{"\"\<res\>\"", " ", "->", " ", "r"}]}], "|>"}]}], ",",
              "\n", "       ", 
             RowBox[{
              RowBox[{"ns", " ", "=", " ", 
               RowBox[{
                RowBox[{"mix", " ", "n2"}], " ", "+", " ", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", " ", "-", " ", "mix"}], ")"}], " ", "ns"}]}]}],
               ";", " ", 
              RowBox[{"ps", " ", "=", " ", 
               RowBox[{
                RowBox[{"mix", " ", "p2"}], " ", "+", " ", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", " ", "-", " ", "mix"}], ")"}], " ", "ps"}]}]}],
               ";", "\n", "       ", 
              RowBox[{"ns", " ", "=", " ", 
               RowBox[{"0.5", " ", 
                RowBox[{"(", 
                 RowBox[{"ns", " ", "+", " ", 
                  RowBox[{"ConjugateTranspose", "[", "ns", "]"}]}], ")"}]}]}],
               ";", " ", 
              RowBox[{"ps", " ", "=", " ", 
               RowBox[{"0.5", " ", 
                RowBox[{"(", 
                 RowBox[{"ps", " ", "-", " ", 
                  RowBox[{"Transpose", "[", "ps", "]"}]}], ")"}]}]}], ";", 
              "\n", "       ", 
              RowBox[{"it", "++"}]}]}], "]"}]}]}], "]"}], ";", "\n", "   ", 
        "out"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"fixedPairT", "[", 
       RowBox[{"mo", ",", " ", "pfix", ",", " ", "N0", ",", " ", "t"}], "]"}],
       ":", " ", 
      RowBox[{
       RowBox[{
       "the", " ", "thermal", " ", "state", " ", "of", " ", "the", " ", 
        "applied", " ", "pair", " ", "self"}], "-", 
       RowBox[{
       "energy", " ", "pfix", " ", "at", " ", "the", " ", "temperature", " ", 
        "t"}]}]}], ",", " ", 
     RowBox[{
      RowBox[{"with", " ", "the", "\n", "   ", "normal", " ", "self"}], "-", 
      RowBox[{"energy", " ", "made", " ", "self"}], "-", 
      RowBox[{"consistent", ":", " ", 
       RowBox[{"{", 
        RowBox[{"N", ",", " ", 
         RowBox[{
         "the", " ", "field", " ", "Phi", " ", "of", " ", "the", " ", "state",
           " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
            "the", " ", "modulus", " ", "of", " ", "the", " ", "amplitude", " ",
              "of", " ", "its", " ", "own", "\n", "   ", "pair", " ", 
             "self"}], "-", 
            RowBox[{"energy", " ", "in", " ", "the", " ", "channel", " ", 
             RowBox[{"K", "^", "3"}]}]}], ")"}]}], ",", " ", 
         RowBox[{
         "its", " ", "free", " ", "energy", " ", "per", " ", "volume"}]}], 
        "}"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"fixedPairT", "[", 
      RowBox[{
      "mo_", ",", " ", "pfix_", ",", " ", "n0_", ",", " ", "t_", ",", " ", 
       RowBox[{"tol_", " ", ":", " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "14"}]}]}]}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ns", " ", "=", " ", "n0"}], ",", " ", "res", ",", " ", "cn",
          ",", " ", "cp", ",", " ", "ent", ",", " ", "rho", ",", " ", "kap", ",",
          " ", "ek", ",", " ", "ei", ",", " ", "n2", ",", " ", "p2", ",", " ", 
         RowBox[{"done", " ", "=", " ", "False"}], ",", " ", 
         RowBox[{"it", " ", "=", " ", "0"}]}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{"!", " ", "done"}], ",", "\n", "     ", 
          RowBox[{
           RowBox[{"res", " ", "=", " ", 
            RowBox[{"Map", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"thermalNode", "[", 
                RowBox[{"#", ",", " ", "t"}], "]"}], " ", "&"}], ",", " ", 
              RowBox[{"bdg", "[", 
               RowBox[{"mo", ",", " ", "ns", ",", " ", "pfix"}], "]"}]}], 
             "]"}]}], ";", "\n", "     ", 
           RowBox[{"cn", " ", "=", " ", 
            RowBox[{"res", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], ";", " ", 
           RowBox[{"cp", " ", "=", " ", 
            RowBox[{"res", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], ";", "\n", 
           "     ", 
           RowBox[{"ent", " ", "=", " ", 
            RowBox[{"0.5", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"mo", "[", "\"\<g\>\"", "]"}], "[", "\"\<w\>\"", "]"}],
               " ", ".", " ", 
              RowBox[{"res", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", " ", "4"}], "]"}], "]"}]}]}]}], ";", "\n",
            "     ", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"rho", ",", " ", "kap", ",", " ", "ek"}], "}"}], " ", "=",
             " ", 
            RowBox[{"localDens", "[", 
             RowBox[{"mo", ",", " ", "cn", ",", " ", "cp"}], "]"}]}], ";", 
           "\n", "     ", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"ei", ",", " ", "n2", ",", " ", "p2"}], "}"}], " ", "=", 
            " ", 
            RowBox[{"interaction", "[", 
             RowBox[{
              RowBox[{"mo", "[", "\"\<ts\>\"", "]"}], ",", " ", "rho", ",", 
              " ", "kap"}], "]"}]}], ";", "\n", "     ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Max", "[", 
                RowBox[{"Abs", "[", 
                 RowBox[{"n2", " ", "-", " ", "ns"}], "]"}], "]"}], " ", "<", 
               " ", "tol"}], " ", "||", " ", 
              RowBox[{"it", " ", ">=", " ", "200000"}]}], ",", " ", 
             RowBox[{"done", " ", "=", " ", "True"}], ",", "\n", "       ", 
             RowBox[{
              RowBox[{"ns", " ", "=", " ", 
               RowBox[{
                RowBox[{"0.7", " ", "n2"}], " ", "+", " ", 
                RowBox[{"0.3", " ", "ns"}]}]}], ";", " ", 
              RowBox[{"ns", " ", "=", " ", 
               RowBox[{"0.5", " ", 
                RowBox[{"(", 
                 RowBox[{"ns", " ", "+", " ", 
                  RowBox[{"ConjugateTranspose", "[", "ns", "]"}]}], ")"}]}]}],
               ";", " ", 
              RowBox[{"it", "++"}]}]}], "]"}]}]}], "]"}], ";", "\n", "   ", 
        RowBox[{"{", 
         RowBox[{"n2", ",", " ", 
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"Tr", "[", 
             RowBox[{
              RowBox[{"k8", "[", "3", "]"}], " ", ".", " ", "p2"}], "]"}], "/",
             "8"}], "]"}], ",", " ", 
          RowBox[{"ek", " ", "+", " ", "ei", " ", "-", " ", 
           RowBox[{"t", " ", "ent"}]}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"phiOf", "[", "sol", "]"}], ":", " ", 
      RowBox[{
       RowBox[{
       "the", " ", "order", " ", "parameter", " ", "of", " ", "a", " ", 
        "self"}], "-", 
       RowBox[{"consistent", " ", "state"}]}]}], ",", " ", 
     RowBox[{
      RowBox[{
      "the", " ", "modulus", " ", "of", " ", "the", " ", "amplitude", " ", 
       "of", " ", "its", " ", "pair", " ", "self"}], "-", "energy"}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"phiOf", "[", "sol_", "]"}], " ", ":=", " ", 
