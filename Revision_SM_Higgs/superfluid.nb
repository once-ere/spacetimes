  "5754e5f4-4fd8-4336-abb4-94b016fd884a"],
 ", as the Taylor coefficients of Section III.T.6: the thermal states of the \
applied pair self-energies ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9bd0d41a-8a98-40f2-a77f-fcabcb36aa21"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"]], "\[LongEqual]", "0.01"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b2b270d5-a58b-4f54-846f-c0b5ae2d9887"],
 " to ",
 Cell[BoxData[
  FormBox["0.04", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cdd53268-b676-4124-abc1-ffa4e6e59c00"],
 ", with a self-consistent normal self-energy, and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["\[ScriptCapitalF]",
     FontSlant->"Plain"], "/", 
    SuperscriptBox["\[CapitalPhi]", "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5fff42c8-20e9-4d77-b1a0-6584b23ccfab"],
 " interpolated by a cubic polynomial in ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CapitalPhi]", "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6f91453e-d224-4c00-be80-3458764c70de"],
 " (in the scaled variable ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[CapitalPhi]", "2"], "/", 
    SubsuperscriptBox["\[CapitalPhi]", 
     StyleBox["max",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ef562085-f4b9-4bc2-8599-01ac706b50bb"],
 ", whose matrix is well conditioned). The next cell does this for CJT and \
compares with the Rust value; the other methods use the Rust values of the \
table."
}], "Text",ExpressionUUID->"4c3ab555-8dea-47d6-90da-bc33947a9e92"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"mo", " ", "=", " ", 
       RowBox[{"thModel", "[", "\"\<CJT\>\"", "]"}]}], ",", " ", 
      RowBox[{"tc", " ", "=", " ", 
       RowBox[{"thTc", "[", "\"\<CJT\>\"", "]"}]}], ",", " ", "nn", ",", " ", 
      "n0", ",", " ", 
      RowBox[{"xs", " ", "=", " ", 
       RowBox[{"{", "}"}]}], ",", " ", 
      RowBox[{"ys", " ", "=", " ", 
       RowBox[{"{", "}"}]}], ",", " ", "cf", ",", " ", "a", ",", " ", "b"}], 
     "}"}], ",", "\n", "  ", 
    RowBox[{
     RowBox[{"nn", " ", "=", " ", 
      RowBox[{"solveSFT", "[", 
       RowBox[{
       "mo", ",", " ", "zero8", ",", " ", "zero8", ",", " ", "tc", ",", " ", 
        "0.6", ",", " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "14"}]}]}], "]"}]}], ";", " ", 
     RowBox[{"n0", " ", "=", " ", 
      RowBox[{"nn", "[", "\"\<n\>\"", "]"}]}], ";", "\n", "  ", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"res", " ", "=", " ", 
           RowBox[{"fixedPairT", "[", 
            RowBox[{"mo", ",", " ", 
             RowBox[{"fa", " ", 
              RowBox[{"ConjugateTranspose", "[", 
               RowBox[{"k8", "[", "3", "]"}], "]"}]}], ",", " ", "n0", ",", 
             " ", "tc"}], "]"}]}], "}"}], ",", "\n", "     ", 
         RowBox[{
          RowBox[{"n0", " ", "=", " ", 
           RowBox[{"res", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ";", " ", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"xs", ",", " ", 
            RowBox[{
             RowBox[{"res", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "^", "2"}]}], "]"}], ";", " ", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"ys", ",", " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"res", "[", 
                RowBox[{"[", "3", "]"}], "]"}], " ", "-", " ", 
               RowBox[{"nn", "[", "\"\<free\>\"", "]"}]}], ")"}], "/", 
             RowBox[{
              RowBox[{"res", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "^", "2"}]}]}], "]"}]}]}], 
        "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"fa", ",", " ", 
         RowBox[{"{", 
          RowBox[{
          "0.01", ",", " ", "0.02", ",", " ", "0.03", ",", " ", "0.04"}], 
          "}"}]}], "}"}]}], "]"}], ";", "\n", "  ", 
     RowBox[{"cf", " ", "=", " ", 
      RowBox[{"LinearSolve", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"x", "/", 
             RowBox[{"Max", "[", "xs", "]"}]}], ")"}], "^", "k"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "xs"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"k", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}], ",", 
        " ", "ys"}], "]"}]}], ";", "\n", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"a", ",", " ", "b"}], "}"}], " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"cf", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
        RowBox[{
         RowBox[{"cf", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "/", 
         RowBox[{"Max", "[", "xs", "]"}]}]}], "}"}]}], ";", "\n", "  ", 
     RowBox[{
      RowBox[{"gzResults", "[", "\"\<CJT\>\"", "]"}], " ", "=", " ", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"gzResults", "[", "\"\<CJT\>\"", "]"}], ",", " ", 
        RowBox[{"<|", 
         RowBox[{"\"\<b\>\"", " ", "->", " ", "b"}], "|>"}]}], "]"}]}], ";", 
     "\n", "  ", 
     RowBox[{"check", "[", 
      RowBox[{"\"\<WP3-G12\>\"", ",", " ", 
       RowBox[{"\"\<CJT at T_c: the quartic coefficient b = \>\"", " ", "<>", 
        " ", 
        RowBox[{"ToString", "[", 
         RowBox[{"NumberForm", "[", 
          RowBox[{"b", ",", " ", "10"}], "]"}], "]"}], " ", "<>", 
        " ", "\"\< of the free energy at the origin (four applied fields, \
thermal engine) is positive and = Rust \>\"", " ", "<>", " ", 
        RowBox[{"ToString", "[", 
         RowBox[{"NumberForm", "[", 
          RowBox[{
           RowBox[{"gzRust", "[", 
            RowBox[{"\"\<CJT\>\"", ",", " ", "\"\<b\>\""}], "]"}], ",", " ", 
           "10"}], "]"}], "]"}], " ", "<>", 
        " ", "\"\< (relative difference; a(T_c) = \>\"", " ", "<>", " ", 
        RowBox[{"sci", "[", "a", "]"}], " ", "<>", " ", "\"\<)\>\""}], ",", 
       "\n", "   ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"b", " ", ">", " ", "0"}], ",", " ", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"b", " ", "-", " ", 
            RowBox[{"gzRust", "[", 
             RowBox[{"\"\<CJT\>\"", ",", " ", "\"\<b\>\""}], "]"}]}], "]"}], "/", 
          RowBox[{"gzRust", "[", 
           RowBox[{"\"\<CJT\>\"", ",", " ", "\"\<b\>\""}], "]"}]}], ",", " ", 
         "1."}], "]"}], ",", " ", 
       RowBox[{"10", "^", 
        RowBox[{"-", "6"}]}], ",", " ", "\"\<P3-G12 CJT\>\"", ",", 
       " ", "\"\<YP3-G12 CJT\>\""}], "]"}]}]}], "]"}], ";"}]], "Input",
 CellLabel->
  "In[393]:=",ExpressionUUID->"713e3dc3-4610-4f5c-acf0-f40dde78adcd"],

