Cell[TextData[{
 "and twice that in the second version, where both pairs move together. The \
cell checks the derivative exactly, the closed form of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"], 
    RowBox[{"(", "3", ")"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4277198e-d2f1-427e-8f46-5c55f6e80330"],
 " against its integral with 40 digits, and the values against those of the \
Rust program in both versions."
}], "Text",ExpressionUUID->"3f7d746c-6bb1-4a1c-b97e-c3608e148681"],

