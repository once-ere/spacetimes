        "&"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rvCheck", "[", 
     RowBox[{"\"\<WQN-10\>\"", ",", 
      " ", "\"\<the 24 channels (parity split, closure, SU(2) multiplets, Y, \
