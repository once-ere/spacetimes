         RowBox[{"1", "/", "2"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"quartic", "[", 
            RowBox[{
             RowBox[{"IdentityMatrix", "[", "8", "]"}], ",", " ", 
