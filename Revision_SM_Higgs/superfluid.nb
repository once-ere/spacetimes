Cell[CellGroupData[{

Cell["II.3 The recursion of the potential and the ground states", "Section",ExpressionUUID->"c9b237b1-5f77-4d4f-b36d-345385b3fdde"],

Cell[TextData[{
 "The task asks to change the potential until all three methods admit a \
superfluid. ",
 StyleBox["The effective couplings.",
  FontWeight->"Bold"],
 " For a uniform state whose normal self-energy is a Dirac mass and whose \
pair self-energy lies in the channel ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "215939df-e0e1-40de-ac69-0fe652e70260"],
 ", every method acts through two numbers: the scalar coupling ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["S",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "704247ce-8a7b-4c0f-aaab-18f1d9db8004"],
 " (the shift of the Dirac mass per unit scalar density) and the pair \
coupling ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["P",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9c5b5568-6b2f-4e61-b6f8-96c90d405570"],
 " (the pair self-energy per unit pair amplitude), computed by ",
 StyleBox["effCouplings",
  FontFamily->"Source Code Pro"],
 " from the self-energy maps of the terms. The normal vacuum is unstable \
towards pairing when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Lambda]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["P",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["P",
       FontSlant->"Plain"]}]], "/", 
    SubsuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["crit",
      FontSlant->"Plain"]], ">", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fc060161-5d1b-4b7a-8a5b-d990d4083ebc"],
 ", with the critical pair coupling of AS3,"
}], "Text",ExpressionUUID->"61e71439-4cda-4b27-a5cb-65a4aac5b089"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["crit",
     FontSlant->"Plain"]], "\[LongEqual]", 
   FractionBox[
    SuperscriptBox["\[Pi]", "2"], 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["I", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{"(", "1", ")"}]], 
     RowBox[{"(", 
      SubscriptBox[
       StyleBox["m", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]], ")"}]}]], ",", "      ", 
   SubsuperscriptBox[
    StyleBox["I", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "1", ")"}]], 
   RowBox[{"(", 
    StyleBox["M", "TI"], ")"}], "\[LongEqual]", 
   SubsuperscriptBox["\[Integral]", "0", 
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]], "\[ThinSpace]", 
   FractionBox[
    RowBox[{
     SuperscriptBox[
      StyleBox["q", "TI"], "2"], "\[ThinSpace]", 
     StyleBox["dq", "TI"]}], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        StyleBox["q", "TI"], "2"], "+", 
       SuperscriptBox[
        StyleBox["M", "TI"], "2"]}], ")"}], 
     RowBox[{"1", "/", "2"}]]], "\[LongEqual]", 
   FractionBox["1", "2"], 
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "+", 
        SuperscriptBox[
         StyleBox["M", "TI"], "2"]}], ")"}], 
      RowBox[{"1", "/", "2"}]], "-", 
     SuperscriptBox[
      StyleBox["M", "TI"], "2"], "\[ThinSpace]", 
     StyleBox["arsinh",
      FontSlant->"Plain"], 
     FractionBox["1", 
      StyleBox["M", "TI"]]}], ")"}], "."}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"c37bb534-79ba-4e2d-91fd-c3228b19c2a1"],

Cell[TextData[{
 StyleBox["The three potentials.",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "0", ")"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8f2a5b98-0f7d-4d4f-bb95-7cfa47fe52fc"],
 " (the author's: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["S",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"-", "8"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1421cf74-983d-41a7-bf61-a72d758f6116"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["V",
      FontSlant->"Plain"]], "\[LongEqual]", "0.8"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "30ea0809-268f-4351-86c3-3480ef2eb39c"],
 ", no pairing term) admits no superfluid in any method. ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "1", ")"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "52757f0e-4fb2-4132-b801-3886a372196b"],
 " adds the pairing term with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "22.5"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f3fedc52-67f4-4b85-85d2-fcab567369f8"],
 ", the value of AS3: HS becomes superfluid, but in KS and CJT the exchange \
contraction of the pairing term acts in the scalar channel as an attraction, \
the scalar channel becomes unstable, and the ground state is a massive state. \
",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "2", ")"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3642deaf-129a-4b18-8c61-04929407acf0"],
 " keeps the form and the vector coupling and fixes ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["S",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cf0d926a-d5c4-48a0-afd2-262d9512ad79"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3979a3a4-8d1a-404d-b64b-548707e92f68"],
 " by two conditions on the CJT couplings: the scalar coupling of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "0", ")"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dc6a51fb-3905-4a1f-a0c5-f7a1777103ff"],
 " (stable) and the pair coupling of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "1", ")"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "433cd8b2-f3fd-4fc9-9b58-58dfeac60e41"],
 " (supercritical). The couplings are linear in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["G", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      StyleBox["S",
       FontSlant->"Plain"]], ",", 
     SubscriptBox[
      StyleBox["G", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"]]}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "92b5e8c7-4e60-4b2c-8deb-62cc0f8dbb5b"],
 ", so the conditions are two linear equations, which the next cell solves \
from the computed couplings; the solution is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["S",
      FontSlant->"Plain"]], "\[LongEqual]", "2.8"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "243cf952-e514-4415-b129-13f8102153af"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "25.2"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "37333ac5-a5e2-404b-8083-c74bf597f12b"],
 ":"
}], "Text",ExpressionUUID->"eec92b10-e4ce-4d3c-8b14-701f4a1af9a6"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "2", ")"}]], "\[LongEqual]", 
   FractionBox["1", "2"], 
   RowBox[{"(", "2.8", ")"}], ":", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       OverscriptBox["\[CapitalPsi]", "_"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      SubscriptBox["\[CapitalPsi]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}], "2"], ":", 
   RowBox[{"+", 
    FractionBox["1", "2"]}], 
   RowBox[{"(", "0.8", ")"}], "\[ThinSpace]", 
   UnderscriptBox["\[Sum]", 
    StyleBox["p", "TI"],
    LimitsPositioning->True], "\[ThinSpace]", 
   SubsuperscriptBox["\[Eta]", 
    StyleBox["pp", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], ":", 
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["j", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["F",
        FontSlant->"Plain"], ",", 
       StyleBox["p", "TI"]}]], ")"}], "2"], ":", 
   RowBox[{"-", 
    FractionBox["1", "4"]}], 
   RowBox[{"(", "25.2", ")"}], "\[ThinSpace]", 
   UnderscriptBox["\[Sum]", "\[Iota]",
    LimitsPositioning->True], ":", 
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox["\[CapitalPi]", 
      StyleBox["LL",
       FontSlant->"Plain"], "\[Iota]"], ")"}], "\[Dagger]"], 
   SubsuperscriptBox["\[CapitalPi]", 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Iota]"], ":", "."}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"dac28601-a5a9-4d06-8c11-e576d6610533"],

Cell[TextData[{
 "For each of the three potentials and the five methods, the cell after it \
computes the effective couplings and the stationary states reached from three \
starts (a polar pair ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.3", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8821a04a-62ee-439e-bf68-0f325089874a"],
 "; a Dirac mass lowered by 1; a Dirac mass raised by 0.5), keeps the one of \
lowest energy (the ground state), and computes its energy per volume, its \
pair amplitude ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftBracketingBar]", 
    SubsuperscriptBox[
     StyleBox["D", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], "\[RightBracketingBar]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f60750f4-b6d7-4b7c-9246-ed822812652c"],
 ", its Dirac mass and its gap. The ground state of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "2", ")"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "28629934-15df-4d1a-b144-9b7de0d4d5d9"],
 " is a polar superfluid in every method. Each number is compared with that \
of the Rust program. (This cell computes 45 self-consistent states; it takes \
a few minutes.)"
}], "Text",ExpressionUUID->"91bd50a7-571b-4de2-b4eb-78230bd3c6c9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"the", " ", "critical", " ", "pair", " ", "coupling", " ", 
    RowBox[{
     RowBox[{"pi", "^", "2"}], "/", "I1"}], 
    RowBox[{"(", "m", ")"}], " ", "and", " ", "the", " ", "coefficients", " ",
     "of", " ", 
    RowBox[{"V", "^", 
     RowBox[{"(", "2", ")"}]}], " ", "from", " ", "the", " ", "two", " ", 
    "conditions", " ", "on", " ", "the", " ", "CJT", " ", "couplings"}], " ", 
   "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"gCrit", " ", "=", " ", 
     RowBox[{
      RowBox[{"Pi", "^", "2"}], "/", 
      RowBox[{"(", 
       RowBox[{"0.5", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Sqrt", "[", 
           RowBox[{"1", " ", "+", " ", 
            RowBox[{"mLL", "^", "2"}]}], "]"}], " ", "-", " ", 
          RowBox[{
           RowBox[{"mLL", "^", "2"}], " ", 
           RowBox[{"ArcSinh", "[", 
            RowBox[{"1", "/", "mLL"}], "]"}]}]}], ")"}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WP2-6b\>\"", ",", " ", 
      RowBox[{"\"\<the critical pair coupling pi^2/I1(m) = \>\"", " ", "<>", 
       " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"NumberForm", "[", 
         RowBox[{
          RowBox[{"N", "[", "gCrit", "]"}], ",", " ", "11"}], "]"}], "]"}]}], 
      ",", " ", 
      RowBox[{"Abs", "[", 
       RowBox[{"gCrit", " ", "-", " ", 
        RowBox[{"rustPart2", "[", "\"\<p2_Gcrit\>\"", "]"}]}], "]"}], ",", 
      " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}], ",", " ", "\"\<P2-6b\>\"", ",", 
      " ", "\"\<YP2-6b\>\""}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"f", " ", "=", " ", 
         RowBox[{
          RowBox[{"effCouplings", "[", 
           RowBox[{
            RowBox[{"{", "\"\<CJT\>\"", "}"}], ",", " ", "#1", ",", " ", 
            "0.8", ",", " ", "#2"}], "]"}], " ", "&"}]}], ",", " ", "s0", ",",
         " ", "p0", ",", " ", "s1", ",", " ", "p1", ",", " ", "s2", ",", " ", 
        "p2", ",", " ", "st", ",", " ", "pt"}], "}"}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"s0", ",", " ", "p0"}], "}"}], " ", "=", " ", 
        RowBox[{"f", "[", 
         RowBox[{"0.", ",", " ", "0."}], "]"}]}], ";", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"s1", ",", " ", "p1"}], "}"}], " ", "=", " ", 
        RowBox[{"f", "[", 
         RowBox[{"1.", ",", " ", "0."}], "]"}]}], ";", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"s2", ",", " ", "p2"}], "}"}], " ", "=", " ", 
        RowBox[{"f", "[", 
         RowBox[{"0.", ",", " ", "1."}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"st", " ", "=", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"effCouplings", "[", 
           RowBox[{
            RowBox[{"{", "\"\<CJT\>\"", "}"}], ",", " ", 
            RowBox[{"-", "8."}], ",", " ", "0.8", ",", " ", "0."}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", "s0"}]}], ";", "\n", 
       "  ", 
       RowBox[{"pt", " ", "=", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"effCouplings", "[", 
           RowBox[{
            RowBox[{"{", "\"\<CJT\>\"", "}"}], ",", " ", 
            RowBox[{"-", "8."}], ",", " ", "0.8", ",", " ", "22.5"}], "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", "p0"}]}], ";", "\n", 
       "  ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"gS2", ",", " ", "gP2"}], "}"}], " ", "=", " ", 
        RowBox[{"LinearSolve", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"s1", " ", "-", " ", "s0"}], ",", " ", 
              RowBox[{"s2", " ", "-", " ", "s0"}]}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"p1", " ", "-", " ", "p0"}], ",", " ", 
              RowBox[{"p2", " ", "-", " ", "p0"}]}], "}"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"st", ",", " ", "pt"}], "}"}]}], "]"}]}]}]}], "]"}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WP2-6a\>\"", ",", " ", 
      RowBox[{"\"\<V^(2) from the conditions on the CJT effective couplings: \
(G^S, G) = (\>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"NumberForm", "[", 
         RowBox[{"gS2", ",", " ", "11"}], "]"}], "]"}], " ", "<>", 
       " ", "\"\<, \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"NumberForm", "[", 
         RowBox[{"gP2", ",", " ", "11"}], "]"}], "]"}], " ", "<>", 
       " ", "\"\<)\>\""}], ",", "\n", "  ", 
      RowBox[{"Max", "[", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"gS2", " ", "-", " ", 
          RowBox[{"rustPart2", "[", "\"\<p2_V2_GS\>\"", "]"}]}], "]"}], ",", 
        " ", 
        RowBox[{"Abs", "[", 
         RowBox[{"gP2", " ", "-", " ", 
          RowBox[{"rustPart2", "[", "\"\<p2_V2_G\>\"", "]"}]}], "]"}]}], 
       "]"}], ",", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}], ",", " ", "\"\<P2-6a\>\"", ",", 
      " ", "\"\<YP2-6a\>\""}], "]"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"the", " ", "three", " ", "potentials", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"G", "^", "S"}], ",", " ", 
       RowBox[{"G", "^", "V"}], ",", " ", "G"}], "}"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"potentialsSF", " ", "=", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<V0\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "8."}], ",", " ", "0.8", ",", " ", "0."}], "}"}]}], ",",
        " ", 
       RowBox[{"\"\<V1\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "8."}], ",", " ", "0.8", ",", " ", "22.5"}], "}"}]}], ",",
        " ", 
       RowBox[{"\"\<V2\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"gS2", ",", " ", "0.8", ",", " ", "gP2"}], "}"}]}]}], 
      "|>"}]}], ";"}]}]}]], "Input",
 CellLabel->
  "In[227]:=",ExpressionUUID->"5dc3fa72-fcdc-4a4d-8073-cd3b7a43376a"],

