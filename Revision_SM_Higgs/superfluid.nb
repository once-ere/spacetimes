    RowBox[{
     RowBox[{"d8", "[", "a", "]"}], ",", " ", "a", ",", " ", "a"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"comm", "[", 
    RowBox[{"a_", ",", " ", "b_"}], "]"}], " ", ":=", " ", 
