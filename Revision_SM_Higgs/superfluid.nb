  FormBox[
   SubscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a2c36fd8-4aec-4e10-aebf-1be22e728336"],
 " with the entries ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftAngleBracket]", 
    RowBox[{
     SubscriptBox[
      StyleBox["M",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      SuperscriptBox[
       StyleBox["s", "TI"], "\[Prime]"]], ",", 
