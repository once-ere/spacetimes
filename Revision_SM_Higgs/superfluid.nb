       "x_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x1", " ", "=", " ", 
          RowBox[{"onField", "[", 
           RowBox[{"x", ",", " ", "f1"}], "]"}]}], ",", " ", 
         RowBox[{"x2", " ", "=", " ", 
          RowBox[{"onField", "[", 
           RowBox[{"x", ",", " ", "f2"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"kind", " ", "==", " ", "\"\<pair\>\""}], ",", " ", 
