                RowBox[{"col", "[", 
                 RowBox[{"shdr", ",", " ", "\"\<re_d\>\""}], "]"}], "]"}], 
               "]"}], "]"}], " ", "+", " ", 
             RowBox[{"I", " ", 
              RowBox[{"num", "[", 
               RowBox[{"r", "[", 
                RowBox[{"[", 
                 RowBox[{"col", "[", 
                  RowBox[{"shdr", ",", " ", "\"\<im_d\>\""}], "]"}], "]"}], 
                "]"}], "]"}]}]}], "]"}]}], "]"}], "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "dl0"}], ")"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"r", ",", " ", "amp"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
