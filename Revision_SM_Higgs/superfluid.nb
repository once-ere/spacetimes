Cell[TextData[{
 "The first check of the conventions: the mass matrix of the gauge fields of \
the Standard Model, computed from the covariant derivative (1.1) with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", 
    StyleBox["ig", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1a939bb3-d5fc-41a6-ac76-520bf1a6c2e8"],
 ", has the eigenvalues ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7c513ec3-b154-44ee-97a4-0a088b1d9672"],
 " (the photon), ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["M", "TI"], 
    StyleBox["W", "TI"], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "83a1736a-8180-4574-abcd-359b9c2b2be2"],
 " (twice) and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["M", "TI"], 
    StyleBox["Z", "TI"], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "195249d0-f8df-4add-a999-ff266dbd3e7e"],
 ", with the eigenvectors ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["A", "TI"], "\[Mu]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9f7d7815-7849-4519-b62f-6e6608cdb655"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["Z", "TI"], "\[Mu]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1754b462-d0e2-4e33-9f73-192d928ceccc"],
 " of the text. The kinetic term ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["D", "TI"], "\[Mu]"], 
       RowBox[{"\[LeftAngleBracket]", 
        SuperscriptBox["\[CapitalPhi]", 
         StyleBox["SM",
          FontSlant->"Plain"]], "\[RightAngleBracket]"}]}], ")"}], 
     "\[Dagger]"], 
    SuperscriptBox[
     StyleBox["D", "TI"], "\[Mu]"], 
    RowBox[{"\[LeftAngleBracket]", 
     SuperscriptBox["\[CapitalPhi]", 
      StyleBox["SM",
       FontSlant->"Plain"]], "\[RightAngleBracket]"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0f980edd-9585-4266-9525-3c1cd6db1787"],
 " of the constant vacuum is the quadratic form ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", 
     StyleBox["ab", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["M",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["ab", "TI"]], 
    SubsuperscriptBox[
     StyleBox["V", "TI"], "\[Mu]", 
     StyleBox["a", "TI"]], 
    SuperscriptBox[
     StyleBox["V", "TI"], 
     RowBox[{
      StyleBox["b", "TI"], ",", "\[Mu]"}]]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "634c8962-17ec-4e66-895c-76b93e9f89fa"],
 " of the four fields ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox[
      StyleBox["W", "TI"], "1"], ",", 
     SuperscriptBox[
      StyleBox["W", "TI"], "2"], ",", 
     SuperscriptBox[
      StyleBox["W", "TI"], "3"], ",", 
     StyleBox["B", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c99b0720-eb6c-41ff-a188-a757bd0780dc"],
 "; the cell computes ",
 Cell[BoxData[
  FormBox[
   StyleBox["M",
    FontFamily->"Helvetica",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "21c56a49-230c-4179-8621-50bf34c0d421"],
 " exactly, with symbolic couplings, and diagonalizes it. The Rust program ",
 StyleBox["sf_part1",
  FontFamily->"Source Code Pro"],
 " checks the same statement with numbers through the four eigenvectors, and \
the Python program ",
 StyleBox["sf_part1.py",
  FontFamily->"Source Code Pro"],
 " through the eigenvalues computed by LAPACK (check SM-1 of both); the same \
computation for the superfluid is the mass matrix (14.3) of Part IV."
}], "Text",ExpressionUUID->"9a874fb3-cc1e-4345-a0cc-0c7105459a18"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"gSM", ",", " ", 
    RowBox[{
     RowBox[{"gpSM", ":", " ", 
      RowBox[{"the", " ", "couplings", " ", "g", " ", "and", " ", 
       RowBox[{"g", "'"}], " ", "of", " ", "SU", 
       RowBox[{"(", "2", ")"}], "_L", " ", "and", " ", "U", 
