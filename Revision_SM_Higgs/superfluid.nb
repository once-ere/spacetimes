      "critical", " ", "strength", " ", 
     RowBox[{"pi", "/", "3"}], " ", "of", " ", "the", " ", "ladder", " ", 
     "approximation"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"r8Alpha", " ", "=", " ", 
