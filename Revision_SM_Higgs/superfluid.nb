Cell[CellGroupData[{

Cell["\<\
R.1.9 The invariance of the pairing terms and the determinant (check WQN-9)\
\>", "Subsection",ExpressionUUID->"635f0ad3-b0b3-4f7b-bca8-47a0401ae15b"],

Cell[TextData[{
 "The pairing terms are ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a6bf3d2c-85e9-4cf9-a84a-98683330da96"],
 " times the sum of the squared lengths of the two pair operators, that is, \
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     SubscriptBox[
      StyleBox["G", "TI"], 
      StyleBox["SH",
       FontSlant->"Plain"]]}], "\[ThinSpace]", 
    StyleBox["tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       StyleBox["\[ScriptCapitalM]",
        FontSlant->"Plain"], "\[Dagger]"], 
      StyleBox["\[ScriptCapitalM]",
       FontSlant->"Plain"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "799eedbc-2d49-430a-9102-e109031e0eac"],
 " on the bidoublet; they are invariant under every transformation that acts \
on the components of the pair fields by a unitary matrix, which is the case \
when the generators ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3f1c598d-29d4-4dc8-a6dd-237e17e6d418"],
 " are Hermitian. The finite transformations of the Rust check QN-9 are here \
replaced by this infinitesimal statement: the groups are connected, so every \
element is a product of exponentials of generators. The determinant ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["det",
     FontSlant->"Plain"], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["\[ScriptCapitalM]",
      FontSlant->"Plain"], 
     StyleBox["SH",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubscriptBox["\[Epsilon]", 
     StyleBox["st", "TI"]], 
    SubsuperscriptBox["\[CapitalPi]", 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["s", "TI"]], 
    SubsuperscriptBox["\[CapitalPi]", 
     StyleBox["SH",
      FontSlant->"Plain"], 
     RowBox[{"\[Prime]", 
      StyleBox["t", "TI"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c933e829-16bb-41f7-9719-57d70afdbabc"],
 " changes under ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["\[ScriptCapitalM]",
     FontSlant->"Plain"], "\[RightArrow]", 
    StyleBox["\[ScriptCapitalM]",
     FontSlant->"Plain"], "+", 
    StyleBox["i", "TI"], "\[Epsilon]", 
    StyleBox["G", "TI"], 
    StyleBox["\[ScriptCapitalM]",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f9e848ae-f3f9-4420-bd9b-bee54a15a4b7"],
 " by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["i", "TI"], "\[Epsilon]", 
    StyleBox["q", "TI"], "\[ThinSpace]", 
    StyleBox["det",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["\[ScriptCapitalM]",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "87ccf24d-56cc-4d0d-989c-5bfb971bac28"],
 " with the charge ",
 Cell[BoxData[
  FormBox[
   StyleBox["q", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "acebf47a-2334-49eb-8ea9-fc7b1eceadde"],
 "; it has ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["q", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ce38fb1d-4acb-4fa7-852b-a4f8e142270c"],
 " under ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["T", "TI"], 
    RowBox[{
     StyleBox["a", "TI"], ",", 
     StyleBox["SM",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5b721778-6f94-44f8-a05e-3b3caf41b38e"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["a", "TI"], ",", 
     StyleBox["R",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a3be2f01-17fc-4968-9321-03ca66bd142b"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b45f6df4-f02e-48d4-99ce-fb4906607b46"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["Y", "TI"], 
    StyleBox["SM",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9e4a5da5-6759-4333-8038-491ee7f9a89a"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["q", "TI"], "\[LongEqual]", "4"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b571800f-f012-4f7e-a581-9f36694bc884"],
 " under ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["F", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"], 
    StyleBox["tot",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5f8d8269-7e08-42fa-a724-9d961cfd397d"],
 ". ",
 StyleBox["Why it matters.",
  FontWeight->"Bold"],
 " The superfluid of the second version breaks ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["F", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"], 
    StyleBox["tot",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "47a02ff2-786c-451b-99e0-64774683e5ab"],
 " and has one Goldstone boson more than the Standard Model (decision D32 of \
the task record, pending the author's choice). A term ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["det",
     FontSlant->"Plain"], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["\[ScriptCapitalM]",
      FontSlant->"Plain"], 
     StyleBox["SH",
      FontSlant->"Plain"]], "+", 
    RowBox[{
     StyleBox["h",
      FontSlant->"Plain"], ".", 
     StyleBox["c",
      FontSlant->"Plain"], "."}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3a9e7d93-d325-42f2-93a8-f5850b82d97e"],
 " in the Hamiltonian, one of the three choices of D32, would break ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["U", "TI"], 
    SubscriptBox[
     RowBox[{"(", "1", ")"}], 
     StyleBox["F",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f7293850-9493-4fa6-bf63-7ccd36e8f446"],
 " alone and give that boson a mass, without breaking any other symmetry."
}], "Text",ExpressionUUID->"053f3eca-8bb4-47cd-9612-f9e377c14b70"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", 
          RowBox[{"--", 
           RowBox[{"--", 
            RowBox[{"--", 
             RowBox[{"--", 
              RowBox[{"--", 
               RowBox[{"--", 
                RowBox[{"--", 
                 RowBox[{"--", 
                  RowBox[{"--", 
                   RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
