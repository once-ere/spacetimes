           RowBox[{"[", "k", "]"}], "]"}], ",", " ", "gensAll"}], "]"}], ",", 
        " ", 
        RowBox[{"{", 
         RowBox[{"k", ",", " ", "4"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"cchannels", " ", "=", " ", 
