                RowBox[{"glist", "[", 
                 RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ".", 
              RowBox[{"basis", "[", 
               RowBox[{"[", "s", "]"}], "]"}]}], " ", "-", " ", 
             RowBox[{"Sum", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"g", "[", 
                 RowBox[{"[", 
                  RowBox[{"s", ",", " ", "sp"}], "]"}], "]"}], " ", 
                RowBox[{"basis", "[", 
                 RowBox[{"[", "sp", "]"}], "]"}]}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"sp", ",", " ", 
                 RowBox[{"Length", "[", "basis", "]"}]}], "}"}]}], "]"}]}], 
            "]"}]}], "]"}], ",", "\n", "     ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", 
           RowBox[{"Length", "[", "glist", "]"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
