        RowBox[{"ts", ",", " ", "40"}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"n40", " ", "=", " ", 
       RowBox[{
        RowBox[{"solveSFT", "[", 
         RowBox[{
         "mo40", ",", " ", "zero8", ",", " ", "zero8", ",", " ", "tc", ",", 
