   RowBox[{
    RowBox[{"thCol", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<method\>\"", ",", " ", "\"\<tau\>\"", ",", 
         " ", "\"\<T\>\"", ",", " ", "\"\<Phi0\>\"", ",", " ", "\"\<mass\>\"",
          ",", " ", "\"\<gap\>\"", ",", " ", "\"\<massN\>\"", ",", 
         " ", "\"\<radius\>\"", ",", " ", "\"\<ratio\>\"", ",", 
         " ", "\"\<F\>\"", ",", " ", "\"\<dS\>\"", ",", " ", "\"\<gapeq\>\"", 
         ",", "\n", "     ", "\"\<a\>\"", ",", " ", "\"\<b\>\"", ",", 
         " ", "\"\<phiL\>\"", ",", " ", "\"\<it\>\""}], "}"}], " ", "->", " ", 
       RowBox[{"Range", "[", "16", "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"thRow", "[", 
       RowBox[{"t", ",", " ", "tau"}], "]"}], ":", " ", 
      RowBox[{
      "the", " ", "row", " ", "of", " ", "the", " ", "method", " ", "t", " ", 
       "at", " ", "the", " ", "reduced", " ", "temperature", " ", "tau"}]}], ";",
      " ", 
     RowBox[{
      RowBox[{"thGet", "[", 
       RowBox[{"t", ",", " ", "tau", ",", " ", "key"}], "]"}], ":", " ", 
      RowBox[{"one", " ", "entry"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"thRow", "[", 
      RowBox[{"t_", ",", " ", "tau_"}], "]"}], " ", ":=", " ", 
     RowBox[{"First", "[", 
      RowBox[{"Select", "[", 
       RowBox[{"rustThermal", ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], " ", "==", " ", "t"}], " ", "&&", 
          " ", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", "tau"}], "]"}], 
           " ", "<", " ", 
           RowBox[{"10", "^", 
            RowBox[{"-", "9"}]}]}]}], " ", "&"}]}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"thGet", "[", 
      RowBox[{"t_", ",", " ", "tau_", ",", " ", "key_"}], "]"}], " ", ":=", 
     " ", 
     RowBox[{
      RowBox[{"thRow", "[", 
       RowBox[{"t", ",", " ", "tau"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"thCol", "[", "key", "]"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"thTaus", " ", "=", " ", 
     RowBox[{"Union", "[", 
      RowBox[{"rustThermal", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<the reduced temperatures of the table: \>\"", ",", " ", 
      "thTaus"}], "]"}], ";"}]}]}]], "Input",
 CellLabel->
  "In[325]:=",ExpressionUUID->"664a6081-31e5-48d5-ad8b-4ce45b013432"],

