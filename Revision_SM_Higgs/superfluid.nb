                  RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}], "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], ";", " ", 
              RowBox[{"lam", " ", "=", " ", 
               RowBox[{"thLam", "[", 
                RowBox[{"t", ",", " ", "temp"}], "]"}]}], ";", "\n", "      ", 
              RowBox[{"worst", " ", "=", " ", 
               RowBox[{"Max", "[", 
                RowBox[{"worst", ",", " ", 
                 RowBox[{
                  RowBox[{"Abs", "[", 
                   RowBox[{"a", " ", "-", " ", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"1", " ", "-", " ", "lam"}], ")"}], "/", 
                    RowBox[{"(", 
                    RowBox[{"lam", " ", "gp"}], ")"}]}]}], "]"}], "/", 
                  RowBox[{"Abs", "[", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"1", " ", "-", " ", "lam"}], ")"}], "/", 
                    RowBox[{"(", 
                    RowBox[{"lam", " ", "gp"}], ")"}]}], "]"}]}]}], 
                "]"}]}]}]}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"tau", ",", " ", 
             RowBox[{"{", 
              RowBox[{"0.9", ",", " ", "0.998", ",", " ", "1.002"}], "}"}]}], 
            "}"}]}], "]"}], ";", "\n", "   ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{"\"\<WP3-G2 \>\"", " ", "<>", " ", "t"}], ",", " ", 
           RowBox[{
            RowBox[{"thName", "[", "t", "]"}], " ", "<>", 
            " ", "\"\<: a(0, T) = (1 - lambda^P(T))/(lambda^P(T) g^P) at \
T/T_c = 0.9, 0.998, 1.002, with lambda^P(T) of Section III.T.4 (largest \
relative difference)\>\""}], ",", "\n", "    ", "worst", ",", " ", 
           RowBox[{"10", "^", 
            RowBox[{"-", "9"}]}], ",", " ", 
           RowBox[{"\"\<P3-G2 \>\"", " ", "<>", " ", "t"}], ",", " ", 
           RowBox[{"\"\<YP3-G2 \>\"", " ", "<>", " ", "t"}]}], "]"}], ";", 
         "\n", "   ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{"the", " ", 
            RowBox[{"slope", ":", " ", 
             RowBox[{
             "central", " ", "differences", " ", "with", " ", "the", " ", 
              "Richardson", " ", "extrapolation"}]}]}], ",", " ", 
           RowBox[{"and", " ", "the", " ", "closed", " ", "form"}]}], " ", 
          "*)"}], "\n", "   ", 
         RowBox[{"d1", " ", "=", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"gzA", "[", 
               RowBox[{"t", ",", " ", 
                RowBox[{"1.002", " ", "tc"}], ",", " ", "0.", ",", " ", 
                RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", 
             RowBox[{
              RowBox[{"gzA", "[", 
               RowBox[{"t", ",", " ", 
                RowBox[{"0.998", " ", "tc"}], ",", " ", "0.", ",", " ", 
                RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"2", " ", "0.002", " ", "tc"}], ")"}]}]}], ";", "\n", 
         "   ", 
         RowBox[{"d2", " ", "=", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"gzA", "[", 
               RowBox[{"t", ",", " ", 
                RowBox[{"1.004", " ", "tc"}], ",", " ", "0.", ",", " ", 
                RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", 
             RowBox[{
              RowBox[{"gzA", "[", 
               RowBox[{"t", ",", " ", 
                RowBox[{"0.996", " ", "tc"}], ",", " ", "0.", ",", " ", 
                RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"2", " ", "0.004", " ", "tc"}], ")"}]}]}], ";", "\n", 
         "   ", 
         RowBox[{"alFD", " ", "=", " ", 
          RowBox[{"tc", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"4", " ", "d1"}], " ", "-", " ", "d2"}], ")"}], "/", 
            "3"}]}]}], ";", "\n", "   ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"alCl", ",", " ", "lamC", ",", " ", "mnC"}], "}"}], " ", "=",
           " ", 
          RowBox[{"gzAlphaClosed", "[", "t", "]"}]}], ";", "\n", "   ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{"\"\<WP3-G10 \>\"", " ", "<>", " ", "t"}], ",", " ", 
           RowBox[{
            RowBox[{"thName", "[", "t", "]"}], " ", "<>", 
            " ", "\"\<: alpha = T_c da/dT = \>\"", " ", "<>", " ", 
            RowBox[{"ToString", "[", 
             RowBox[{"NumberForm", "[", 
              RowBox[{"alFD", ",", " ", "10"}], "]"}], "]"}], " ", "<>", 
            " ", "\"\< from central differences of the static pair response \
(Richardson) = \>\"", " ", "<>", " ", 
            RowBox[{"ToString", "[", 
             RowBox[{"NumberForm", "[", 
              RowBox[{"alCl", ",", " ", "10"}], "]"}], "]"}], " ", "<>", 
            " ", "\"\< in closed form (lambda^P(T_c) = \>\"", " ", "<>", " ", 
            
            RowBox[{"ToString", "[", 
             RowBox[{"NumberForm", "[", 
              RowBox[{"lamC", ",", " ", "12"}], "]"}], "]"}], " ", "<>", 
            " ", "\"\<, M_n = \>\"", " ", "<>", " ", 
            RowBox[{"ToString", "[", 
             RowBox[{"NumberForm", "[", 
              RowBox[{"mnC", ",", " ", "10"}], "]"}], "]"}], " ", "<>", 
            " ", "\"\<) = Rust (largest relative difference)\>\""}], ",", 
           "\n", "    ", 
           RowBox[{"Max", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{"alFD", " ", "-", " ", "alCl"}], "]"}], "/", "alCl"}], 
             ",", " ", 
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{"alCl", " ", "-", " ", 
                RowBox[{"gzRust", "[", 
                 RowBox[{"t", ",", " ", "\"\<alpha\>\""}], "]"}]}], "]"}], "/", 
              RowBox[{"gzRust", "[", 
               RowBox[{"t", ",", " ", "\"\<alpha\>\""}], "]"}]}]}], "]"}], ",",
            " ", 
           RowBox[{"10", "^", 
            RowBox[{"-", "8"}]}], ",", " ", 
           RowBox[{"\"\<P3-G10 \>\"", " ", "<>", " ", "t"}], ",", " ", 
           RowBox[{"\"\<YP3-G10 \>\"", " ", "<>", " ", "t"}]}], "]"}], ";", 
         "\n", "   ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{"at", " ", "the", " ", "critical", " ", 
            RowBox[{"temperature", ":", " ", 
             RowBox[{"a", " ", "vanishes"}]}]}], ",", " ", 
           RowBox[{
           "and", " ", "no", " ", "other", " ", "pair", " ", "channel", " ", 
            "is", " ", "induced"}]}], " ", "*)"}], "\n", "   ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ac", ",", " ", "perp0"}], "}"}], " ", "=", " ", 
          RowBox[{"gzA", "[", 
           RowBox[{"t", ",", " ", "tc", ",", " ", "0.", ",", " ", 
            RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}]}], ";", "\n", 
         "   ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{"\"\<WP3-G3 \>\"", " ", "<>", " ", "t"}], ",", " ", 
           RowBox[{
            RowBox[{"thName", "[", "t", "]"}], " ", "<>", 
            " ", "\"\<: a(0, T_c) vanishes to the accuracy of T_c (|a(0, \
T_c)| / alpha)\>\""}], ",", " ", 
           RowBox[{
            RowBox[{"Abs", "[", "ac", "]"}], "/", "alCl"}], ",", " ", 
           RowBox[{"10", "^", 
            RowBox[{"-", "9"}]}], ",", " ", 
           RowBox[{"\"\<P3-G3 \>\"", " ", "<>", " ", "t"}], ",", " ", 
           RowBox[{"\"\<YP3-G3 \>\"", " ", "<>", " ", "t"}]}], "]"}], ";", 
         "\n", "   ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{"\"\<WP3-G4 \>\"", " ", "<>", " ", "t"}], ",", " ", 
           RowBox[{
            RowBox[{"thName", "[", "t", "]"}], " ", "<>", 
