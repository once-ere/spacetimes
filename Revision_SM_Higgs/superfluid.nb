       RowBox[{"\"\<HS_\>\"", " ", "<>", " ", 
        RowBox[{"ToString", "[", 
         RowBox[{"Round", "[", 
          RowBox[{"m", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}], " ", "<>", 
        " ", "\"\<_\>\"", " ", "<>", " ", 
        RowBox[{"ToString", "[", 
         RowBox[{"Round", "[", 
          RowBox[{"m", "[", 
           RowBox[{"[", "3", "]"}], "]"}], "]"}], "]"}]}], ",", " ", 
       RowBox[{"m", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<the engine is defined; grid of 24 radial nodes: \>\"", ",", 
      " ", 
      RowBox[{
       RowBox[{"gridSF", "[", "24", "]"}], "[", "\"\<n\>\"", "]"}], ",", 
      " ", "\"\< momenta\>\""}], "]"}], ";"}]}]}]], "Input",
