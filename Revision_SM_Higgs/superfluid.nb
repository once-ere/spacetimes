          RowBox[{
           RowBox[{"(", 
            RowBox[{"i1t", " ", "+", " ", 
             RowBox[{"i1m", " ", "dmt"}]}], ")"}], "/", 
           RowBox[{"Pi", "^", "2"}]}]}]}], ";", "\n", "   ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "tc"}], " ", 
