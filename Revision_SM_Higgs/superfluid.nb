Cell[CellGroupData[{

Cell["\<\
R.3.6 Remark R12: the second version has the scalars of two Higgs doublets\
\>", "Subsection",ExpressionUUID->"c14a9e58-3bff-47a9-8312-24843476bfa7"],

Cell[TextData[{
 StyleBox["The remark.",
  FontWeight->"Bold"],
 " The four complex pair fields of the second version, the bidoublet, have \
eight real directions of fluctuation around the vacuum ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Phi]", "\[ThinSpace]", 
    StyleBox["i", "TI"], 
    SuperscriptBox["\[Tau]", "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7b1e0778-993b-4b00-81e1-2831ff63182e"],
 ". Four are Goldstone modes: three are absorbed by ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["W", "TI"], "\[Mu]", "\[PlusMinus]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5039932c-7a0f-49bf-bd08-97f3833fdb7d"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["Z", "TI"], "\[Mu]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "129a96c6-c520-47f3-9ecb-5411004acd30"],
 ", and the fourth belongs to the broken particle number ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["F", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"], 
    StyleBox["tot",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "83fa7707-687e-495a-bf50-b28fb9d4441e"],
 " (decision D32). The other four are massive: the amplitude mode, a singlet \
of the custodial group ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["V",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "48337a69-6b57-47ed-ac34-9367807ea548"],
 ", and a triplet of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["V",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "eb5e4700-da63-4491-95f9-1367448a8209"],
 ", one neutral and one charged pair. This is the scalar content of a model \
with two Higgs doublets, and in the pairing-only methods the four massive \
modes are degenerate at ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["d", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"], "0"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fbb8d700-fd36-48e6-b032-ae59958e55b1"],
 ". ",
 StyleBox["The computation.",
  FontWeight->"Bold"],
 " Write a fluctuation of the bidoublet as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", 
    StyleBox["\[ScriptCapitalM]",
     FontSlant->"Plain"], "\[LongEqual]", 
    StyleBox["X", "TI"], "\[ThinSpace]", 
    StyleBox["i", "TI"], 
    SuperscriptBox["\[Tau]", "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a9030d13-4e67-4d61-b9ac-9faed468fb15"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["X", "TI"], "\[LongEqual]", "\[Sigma]", 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "2"], "+", 
    StyleBox["i", "TI"], 
    OverscriptBox["\[Pi]", "\[RightVector]"], "\[CenterDot]", 
    OverscriptBox["\[Tau]", "\[RightVector]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f0307ee7-e6bb-4926-8195-faafdeb02790"],
 ", ",
 Cell[BoxData[
  FormBox["\[Sigma]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9099ce28-5b93-4fa7-95d6-5d4cee694636"],
 " and ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[Pi]", "\[RightVector]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c241e9dc-393e-48e9-b59f-c35a3507e8d5"],
 " complex. The custodial group acts as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["\[ScriptCapitalM]",
     FontSlant->"Plain"], "\[RightArrow]", 
    StyleBox["L", "TI"], 
    StyleBox["\[ScriptCapitalM]",
     FontSlant->"Plain"], 
    SuperscriptBox[
     StyleBox["R", "TI"], 
     StyleBox["T", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cd935a85-dcec-49d4-94a2-c3340a3917ef"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["L", "TI"], "\[LongEqual]", 
    StyleBox["R", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e47ee668-63eb-4082-82ae-72da268ad45a"],
 ", which keeps ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["i", "TI"], 
    SuperscriptBox["\[Tau]", "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "092509ba-aa28-4ae8-8643-841c45ed1d15"],
 ", and on ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "33baa675-e744-49f0-9f27-6641f747149e"],
 " as the adjoint, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["X", "TI"], "\[RightArrow]", 
    StyleBox["LX", "TI"], 
    SuperscriptBox[
     StyleBox["L", "TI"], 
     RowBox[{"-", "1"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3ce7b155-4309-4483-a883-e04ddd4595cc"],
 ": ",
 Cell[BoxData[
  FormBox["\[Sigma]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d1919d5b-90a0-4cbd-b457-e7216e5113da"],
 " is a singlet and ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[Pi]", "\[RightVector]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1c35357a-d403-4bb5-b17d-69f4e1e6f406"],
 " a triplet. The next cell computes the Casimir operator of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["V",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e5741569-b21d-4950-88bf-babc006c0fa3"],
 " on the eight real directions, finds which of them the broken generators \
produce from the vacuum (the Goldstone directions), and the charges of the \
triplet. The degeneracy of the triplet with the amplitude mode is computed by \
the Python check YH-8 (four eigenvalues equal to 1 of the response at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Omega]", "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b901f037-3cef-49df-b90c-40ca56c104cd"],
 " and four at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Omega]", "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], "0"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "44bf1cbd-60d2-4564-bf2b-d31d4b72a61b"],
 ", with the Casimir values 0, 2, 2, 2 of the massive ones) and seen in the \
time domain by the Rust check D-5 (Section R.4). ",
 StyleBox["Why it matters.",
  FontWeight->"Bold"],
 " (1) The two versions fail in opposite ways: the first has the scalar \
content of the Standard Model (three Goldstone modes and one amplitude mode) \
but a ratio ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Rho]", 
    StyleBox["SH",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ad908125-7552-4c12-8dcb-9c10335f9a38"],
 " different from 1, which the measured ",
 Cell[BoxData[
  FormBox["\[Rho]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b3e08c1d-9250-4e6f-9575-c67e4e149f8d"],
 " excludes; the second has ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Rho]", 
     StyleBox["SH",
      FontSlant->"Plain"]], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bd9543bc-f38f-4971-89f1-428014b31901"],
 " exactly but twice the scalar content, three more massive scalars and one \
massless Goldstone boson. (2) The triplet is a prediction: in the \
pairing-only methods it is degenerate with the candidate for the Higgs boson, \
and the dynamics in time shows that the scalar and the vector terms split it \
from the singlet, by about 2 per cent in HS (1, 1) and by about half a per \
cent, downwards, in KS and CJT (Section R.4); whether the fluctuations beyond \
the mean field split it further is not computed. (3) It is the structure of a \
model with two Higgs doublets, in which the custodial symmetry of the scalar \
potential likewise groups the extra scalars into multiplets of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["V",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d03a369c-b39c-43d3-9ec8-078daf6ff214"],
 "; here the pairing-only methods make all four massive modes degenerate, \
because the pairing terms act on the four complex pair fields alike."
}], "Text",ExpressionUUID->"d0acd992-0277-41bb-87d9-506cc54d9482"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"--", " ", "remark"}]}], " ", 
    RowBox[{"R12", ":", " ", 
     RowBox[{
     "the", " ", "eight", " ", "real", " ", "directions", " ", "of", " ", "a",
       " ", "fluctuation", " ", "of", " ", "the", " ", "bidoublet", " ", 
      "around", " ", "phi", " ", "i", " ", 
      RowBox[{"tau", "^", 
       RowBox[{
        RowBox[{"2", " ", "--"}], "--"}]}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"r12Tau", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "0"}], "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", 
           RowBox[{"-", "I"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"I", ",", " ", "0"}], "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", 
           RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"r12Eps", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "0"}], "}"}]}], "}"}]}], ";"}], 
   "                                 ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"i", " ", 
      RowBox[{"tau", "^", "2"}]}], ",", " ", 
     RowBox[{
      RowBox[{"the", " ", "vacuum", " ", "with", " ", "phi"}], " ", "=", " ", 
      "1"}]}], " ", "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", "directions", " ", "delta", " ", "M"}], " ", "=", 
     " ", 
     RowBox[{
      RowBox[{"X", " ", "i", " ", 
       RowBox[{"tau", "^", "2"}], " ", "with", " ", "X"}], " ", "=", " ", 
      RowBox[{
       RowBox[{"sigma", " ", "1"}], " ", "+", " ", 
       RowBox[{"i", " ", 
        RowBox[{"pi", ".", 
         RowBox[{"tau", ":", " ", 
          RowBox[{
          "the", " ", "real", " ", "and", " ", "imaginary", " ", "parts", " ",
            "of", " ", "sigma", " ", "and", " ", 
           RowBox[{"pi", "^", "a"}]}]}]}]}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"r12Dirs", " ", "=", " ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\"\<Re sigma\>\"", ",", " ", 
           RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<Im sigma\>\"", ",", " ", 
           RowBox[{"I", " ", 
            RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], "}"}]}], "}"}], ",",
        "\n", "   ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\"\<Re pi^\>\"", " ", "<>", " ", 
            RowBox[{"ToString", "[", "a", "]"}]}], ",", " ", 
           RowBox[{"I", " ", 
            RowBox[{"r12Tau", "[", 
             RowBox[{"[", "a", "]"}], "]"}]}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"a", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\"\<Im pi^\>\"", " ", "<>", " ", 
            RowBox[{"ToString", "[", "a", "]"}]}], ",", " ", 
           RowBox[{"-", 
            RowBox[{"r12Tau", "[", 
             RowBox[{"[", "a", "]"}], "]"}]}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"a", ",", " ", "3"}], "}"}]}], "]"}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "custodial", " ", "generators", " ", "on", " ", "the", " ", 
      "bidoublet"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"T", "^", "a"}], " ", "+", " ", 
       RowBox[{"T", "^", 
        RowBox[{"a_R", ":", " ", "M"}]}]}], " ", "->", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"tau", "^", "a"}], "/", "2"}], ")"}], " ", "M"}], " ", "+", 
       " ", 
       RowBox[{"M", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"tau", "^", "a"}], "/", "2"}], ")"}], "^", "T"}]}]}]}], ",",
      " ", 
     RowBox[{"and", " ", "their", " ", "Casimir"}]}], " ", "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"the", " ", "parentheses", " ", 
     RowBox[{"matter", ":", " ", 
      RowBox[{"the", " ", 
       RowBox[{"product", " ", ".", " ", "binds"}], " ", "more", " ", 
       "strongly", " ", "than", " ", "the", " ", 
       RowBox[{"division", " ", "/"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"r12Tv", "[", 
      RowBox[{"a_", ",", " ", "m_"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"r12Tau", "[", 
          RowBox[{"[", "a", "]"}], "]"}], "/", "2"}], ")"}], " ", ".", " ", 
       "m"}], " ", "+", " ", 
      RowBox[{"m", " ", ".", " ", 
       RowBox[{"Transpose", "[", 
        RowBox[{
         RowBox[{"r12Tau", "[", 
          RowBox[{"[", "a", "]"}], "]"}], "/", "2"}], "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"r12Cas", "[", "m_", "]"}], " ", ":=", " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"r12Tv", "[", 
        RowBox[{"a", ",", " ", 
         RowBox[{"r12Tv", "[", 
          RowBox[{"a", ",", " ", "m"}], "]"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "the", " ", "real", " ", "vector", " ", "of", " ", "a", " ", "complex", " ",
      "2", " ", "x", " ", "2", " ", "matrix"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"r12Vec", "[", "m_", "]"}], " ", ":=", " ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Re", "[", 
        RowBox[{"Flatten", "[", "m", "]"}], "]"}], ",", " ", 
       RowBox[{"Im", "[", 
        RowBox[{"Flatten", "[", "m", "]"}], "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "directions", " ", "that", " ", "the", " ", "broken", " ", 
      "generators", " ", "produce", " ", "from", " ", "the", " ", "vacuum"}], 
     ",", " ", 
     RowBox[{
      RowBox[{"delta", " ", "M"}], " ", "=", " ", 
      RowBox[{"i", " ", "G", " ", 
       RowBox[{"M", ":", " ", 
        RowBox[{
         RowBox[{"T", "^", "a"}], " ", 
         RowBox[{"(", 
          RowBox[{"on", " ", "the", " ", "left"}], ")"}]}]}]}]}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"T", "^", "a_R"}], " ", 
       RowBox[{"(", 
        RowBox[{"on", " ", "the", "\n", "   ", "right"}], ")"}], " ", "and", " ",
        "F_tot", " ", 
       RowBox[{"(", 
        RowBox[{"charge", " ", "2", " ", "on", " ", "the", " ", "bidoublet"}],
         ")"}]}], ";", " ", 
      RowBox[{
      "R", " ", "is", " ", "zero", " ", "on", " ", "the", " ", 
       "bidoublet"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"r12Broken", " ", "=", " ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"I", " ", 
            RowBox[{
             RowBox[{"r12Tau", "[", 
              RowBox[{"[", "a", "]"}], "]"}], "/", "2"}]}], ")"}], " ", ".", 
          " ", "r12Eps"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"a", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"I", " ", 
          RowBox[{"r12Eps", " ", ".", " ", 
           RowBox[{"Transpose", "[", 
            RowBox[{
             RowBox[{"r12Tau", "[", 
              RowBox[{"[", "a", "]"}], "]"}], "/", "2"}], "]"}]}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"a", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", " ", "I", " ", "r12Eps"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"r12Rank", " ", "=", " ", 
     RowBox[{"MatrixRank", "[", 
      RowBox[{"r12Vec", " ", "/@", " ", "r12Broken"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"r12Rows", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"m", " ", "=", " ", 
            RowBox[{
             RowBox[{"d", "[", 
              RowBox[{"[", "2", "]"}], "]"}], " ", ".", " ", "r12Eps"}]}], ",",
            " ", "cas", ",", " ", "c", ",", " ", "gold"}], "}"}], ",", "\n", 
         "    ", 
         RowBox[{
          RowBox[{"cas", " ", "=", " ", 
           RowBox[{"r12Cas", "[", "m", "]"}]}], ";", "\n", "    ", 
          RowBox[{"c", " ", "=", " ", 
           RowBox[{"Which", "[", 
            RowBox[{
             RowBox[{"cas", " ", "==", " ", 
              RowBox[{"0", " ", "m"}]}], ",", " ", "0", ",", " ", 
             RowBox[{"cas", " ", "==", " ", 
              RowBox[{"2", " ", "m"}]}], ",", " ", "2", ",", " ", "True", ",",
              " ", "\"\<none\>\""}], "]"}]}], ";", "\n", "    ", 
          RowBox[{"gold", " ", "=", " ", 
           RowBox[{
            RowBox[{"MatrixRank", "[", 
             RowBox[{"Append", "[", 
              RowBox[{
               RowBox[{"r12Vec", " ", "/@", " ", "r12Broken"}], ",", " ", 
               RowBox[{"r12Vec", "[", "m", "]"}]}], "]"}], "]"}], " ", "==", 
            " ", "r12Rank"}]}], ";", "\n", "    ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"d", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", " ", "c", ",", " ", 
            RowBox[{"If", "[", 
             RowBox[{
             "gold", ",", " ", "\"\<Goldstone\>\"", ",", 
              " ", "\"\<massive\>\""}], "]"}]}], "}"}]}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"d", ",", " ", "r12Dirs"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<the broken generators produce \>\"", ",", " ", "r12Rank", ",",
       " ", "\"\< independent directions\>\""}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"Grid", "[", 
      RowBox[{
       RowBox[{"Prepend", "[", 
        RowBox[{"r12Rows", ",", " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<direction\>\"", ",", " ", "\"\<Casimir of SU(2)_V\>\"",
            ",", " ", "\"\<mode\>\""}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
       RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}], "]"}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"the", " ", "charge", " ", "Q"}], " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"T", "^", "3"}], " ", "+", " ", 
         RowBox[{
          RowBox[{"T", "^", "3"}], "_R"}], " ", "+", " ", 
         RowBox[{
          RowBox[{"R", "/", "4"}], " ", "on", " ", "the", " ", "bidoublet", " ", 
          RowBox[{"(", 
           RowBox[{"R", " ", "=", " ", "0"}], ")"}]}]}], ":", " ", 
        RowBox[{"the", " ", "custodial", " ", 
         RowBox[{"T", "^", "3"}]}]}]}], ";", " ", 
      RowBox[{
       RowBox[{
       "on", " ", "the", " ", "massive", " ", "triplet", "\n", "   ", "X"}], 
       " ", "=", " ", 
       RowBox[{"-", 
        RowBox[{"tau", "^", 
         RowBox[{"+", "-"}]}]}]}]}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"tau", "^", "3"}]}], " ", "with", " ", 
       RowBox[{"tau", "^", 
        RowBox[{"+", "-"}]}]}], " ", "=", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"tau", "^", "1"}], " ", "+", 
         RowBox[{
          RowBox[{"-", " ", "i"}], " ", 
          RowBox[{"tau", "^", "2"}]}]}], ")"}], "/", "2"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"r12Trip", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<-(tau^1 + i tau^2)/2\>\"", ",", " ", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"r12Tau", "[", 
              RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", 
             RowBox[{"I", " ", 
              RowBox[{"r12Tau", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}]}], ")"}]}], "/", "2"}]}], 
        "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<-tau^3\>\"", ",", " ", 
         RowBox[{"-", 
          RowBox[{"r12Tau", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}]}], "}"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<-(tau^1 - i tau^2)/2\>\"", ",", " ", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"r12Tau", "[", 
              RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", 
             RowBox[{"I", " ", 
              RowBox[{"r12Tau", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}]}], ")"}]}], "/", "2"}]}], 
        "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<the charges of the massive triplet: \>\"", ",", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"m", " ", "=", " ", 
             RowBox[{
              RowBox[{"t", "[", 
               RowBox[{"[", "2", "]"}], "]"}], " ", ".", " ", "r12Eps"}]}], ",",
             " ", "q"}], "}"}], ",", "\n", "     ", 
          RowBox[{
           RowBox[{"q", " ", "=", " ", 
            RowBox[{"Select", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "1"}], ",", " ", "0", ",", " ", "1"}], "}"}], ",",
               " ", 
              RowBox[{
               RowBox[{
                RowBox[{"r12Tv", "[", 
                 RowBox[{"3", ",", " ", "m"}], "]"}], " ", "==", " ", 
                RowBox[{"#", " ", "m"}]}], " ", "&"}]}], "]"}]}], ";", " ", 
           RowBox[{
            RowBox[{"t", "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", "->", " ", 
            RowBox[{"First", "[", "q", "]"}]}]}]}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"t", ",", " ", "r12Trip"}], "}"}]}], "]"}]}], "]"}], 
    ";"}]}]}]], "Input",
 CellLabel->
  "In[700]:=",ExpressionUUID->"c455dbd9-0bcb-4222-a9eb-6dc9892ee93d"],

