       RowBox[{"{", 
        RowBox[{"\"\<pa\>\"", ",", " ", "\"\<Psi\>\"", ",", 
         " ", "\"\<Psi\>\""}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<pa\>\"", ",", " ", "\"\<Psi\>\"", ",", 
         " ", "\"\<chi\>\""}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<pa\>\"", ",", " ", "\"\<Psi\>\"", ",", 
         " ", "\"\<chi'\>\""}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<pa\>\"", ",", " ", "\"\<chi\>\"", ",", 
         " ", "\"\<chi\>\""}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<pa\>\"", ",", " ", "\"\<chi\>\"", ",", 
         " ", "\"\<chi'\>\""}], "}"}], ",", "\n", "  ", 
       RowBox[{"{", 
        RowBox[{"\"\<pa\>\"", ",", " ", "\"\<chi'\>\"", ",", 
         " ", "\"\<chi'\>\""}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"csectors", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<pair\>\"", ",", " ", "\"\<Psi\>\"", ",", 
         " ", "\"\<(chi, chi')\>\""}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<pair\>\"", ",", " ", "\"\<(chi, chi')\>\"", ",", 
         " ", "\"\<(chi, chi')\>\""}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<pa\>\"", ",", " ", "\"\<Psi\>\"", ",", 
         " ", "\"\<(chi, chi')\>\""}], "}"}], ",", "\n", "  ", 
       RowBox[{"{", 
        RowBox[{"\"\<pa\>\"", ",", " ", "\"\<(chi, chi')\>\"", ",", 
         " ", "\"\<(chi, chi')\>\""}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"secName", "[", 
      RowBox[{"{", 
       RowBox[{"k_", ",", " ", "a_", ",", " ", "b_"}], "}"}], "]"}], " ", ":=",
      " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"k", " ", "==", " ", "\"\<pair\>\""}], ",", " ", 
       RowBox[{"a", " ", "<>", " ", "\"\< \>\"", " ", "<>", " ", "b"}], ",", 
       " ", 
       RowBox[{"a", " ", "<>", " ", "\"\<^dag \>\"", " ", "<>", " ", "b"}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"samePair", "[", 
      RowBox[{"{", 
       RowBox[{"k_", ",", " ", "a_", ",", " ", "b_"}], "}"}], "]"}], " ", ":=",
      " ", 
     RowBox[{
      RowBox[{"k", " ", "==", " ", "\"\<pair\>\""}], " ", "&&", " ", 
      RowBox[{"a", " ", "==", " ", "b"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"invOps", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"kind_", ",", " ", "f1_", ",", " ", "f2_"}], "}"}], ",", " ", 
       "antisym_", ",", " ", "sym_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "ops", "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"ops", " ", "=", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"vecOp", "[", 
            RowBox[{"kind", ",", " ", 
             RowBox[{"diracOn", "[", 
              RowBox[{"f1", ",", " ", 
               RowBox[{"sGen", "[", "#", "]"}]}], "]"}], ",", " ", 
             RowBox[{"diracOn", "[", 
              RowBox[{"f2", ",", " ", 
               RowBox[{"sGen", "[", "#", "]"}]}], "]"}]}], "]"}], " ", "&"}], 
          " ", "/@", " ", "lb"}]}], ";", "\n", "  ", 
        RowBox[{"If", "[", 
         RowBox[{"antisym", ",", " ", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"ops", ",", " ", 
            RowBox[{
             RowBox[{"IdentityMatrix", "[", 
              RowBox[{
               RowBox[{"fieldN", "[", "f1", "]"}], "^", "2"}], "]"}], " ", "+",
              " ", 
             RowBox[{"transpOp", "[", 
              RowBox[{"fieldN", "[", "f1", "]"}], "]"}]}]}], "]"}]}], "]"}], ";",
         "\n", "  ", 
        RowBox[{"If", "[", 
         RowBox[{"sym", ",", " ", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"ops", ",", " ", 
            RowBox[{
             RowBox[{"IdentityMatrix", "[", 
              RowBox[{
               RowBox[{"fieldN", "[", "f1", "]"}], "^", "2"}], "]"}], " ", "-",
              " ", 
             RowBox[{"transpOp", "[", 
              RowBox[{"fieldN", "[", "f1", "]"}], "]"}]}]}], "]"}]}], "]"}], ";",
         "\n", "  ", 
        RowBox[{"Join", " ", "@@", " ", "ops"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"L_X", " ", "on", " ", "vec", 
     RowBox[{"(", "M", ")"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"chargeOp", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"kind_", ",", " ", "f1_", ",", " ", "f2_"}], "}"}], ",", " ", 
       "x_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x1", " ", "=", " ", 
          RowBox[{"onField", "[", 
           RowBox[{"x", ",", " ", "f1"}], "]"}]}], ",", " ", 
         RowBox[{"x2", " ", "=", " ", 
          RowBox[{"onField", "[", 
           RowBox[{"x", ",", " ", "f2"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"kind", " ", "==", " ", "\"\<pair\>\""}], ",", " ", 
            RowBox[{"Transpose", "[", "x1", "]"}], ",", " ", 
            RowBox[{"-", "x1"}]}], "]"}], ",", " ", 
          RowBox[{"IdentityMatrix", "[", 
           RowBox[{"Length", "[", "x2", "]"}], "]"}]}], "]"}], " ", "+", "\n",
         "   ", 
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{
          RowBox[{"IdentityMatrix", "[", 
           RowBox[{"Length", "[", "x1", "]"}], "]"}], ",", " ", 
          RowBox[{"Transpose", "[", "x2", "]"}]}], "]"}]}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"parityOp", "[", 
      RowBox[{"{", 
       RowBox[{"kind_", ",", " ", "f1_", ",", " ", "f2_"}], "}"}], "]"}], " ",
      ":=", " ", 
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{
       RowBox[{"leftOp", "[", 
        RowBox[{"kind", ",", " ", 
         RowBox[{"diracOn", "[", 
          RowBox[{"f1", ",", " ", 
           RowBox[{"gam", "[", "0", "]"}]}], "]"}]}], "]"}], ",", " ", 
       RowBox[{"Transpose", "[", 
        RowBox[{"diracOn", "[", 
         RowBox[{"f2", ",", " ", 
          RowBox[{"gam", "[", "0", "]"}]}], "]"}], "]"}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "matrix", " ", "of", " ", "an", " ", "operator", " ", "on", " ",
       "the", " ", "span", " ", "of", " ", "the", " ", "columns", " ", "of", " ",
       "b", " ", 
      RowBox[{"(", 
       RowBox[{"b", " ", "need", " ", "not", " ", "be", " ", "orthonormal"}], 
       ")"}]}], ";", " ", 
     RowBox[{
     "the", " ", "residual", " ", "tells", " ", "whether", "\n", "   ", "the",
       " ", "span", " ", "is", " ", "invariant"}]}], " ", "*)"}], "\n", 
   RowBox[{
