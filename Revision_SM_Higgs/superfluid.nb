            RowBox[{"0", ",", " ", 
             RowBox[{"-", "1"}], ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0", ",", " ", "1"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0", ",", " ", 
             RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ";", "\n", "   ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<nr\>\"", " ", "->", " ", "nr"}], ",", " ", 
          RowBox[{"\"\<kr\>\"", " ", "->", " ", "kr"}], ",", " ", 
