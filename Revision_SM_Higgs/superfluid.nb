               RowBox[{"ConjugateTranspose", "[", "kap", "]"}]}], "]"}], 
             "]"}], "/", 
            RowBox[{
             RowBox[{"Abs", "[", "phi", "]"}], "^", "2"}]}]}], ",", " ", 
          "pnorm"}], "}"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"gzNormal", "[", 
      RowBox[{"t", ",", " ", "temp"}], "]"}], ":", " ", 
