        StyleBox["SF",
         FontSlant->"Plain"], 
        StyleBox["a",
         FontSlant->"Plain"]], "-", 
       SubscriptBox[
        StyleBox["P",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["SF",
         FontSlant->"Plain"]], 
       RowBox[{"[", 
        SubsuperscriptBox[
         StyleBox["C",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], 
         StyleBox["SF",
          FontSlant->"Plain"], 
         RowBox[{
          StyleBox["p",
           FontSlant->"Plain"], ",", 
          StyleBox["tot",
           FontSlant->"Plain"]}]], "]"}]}], ")"}], 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["C",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["p",
          FontSlant->"Plain"], ",", 
         StyleBox["tot",
          FontSlant->"Plain"]}]], ")"}], "\[Dagger]"]}], ")"}], ","}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"a020c5c6-ba22-47b7-83ee-f95bc2acdaab"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["P",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"]], 
    RowBox[{"[", 
     SubsuperscriptBox[
      StyleBox["C",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["p",
        FontSlant->"Plain"], ",", 
       StyleBox["tot",
        FontSlant->"Plain"]}]], "]"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "60c1c439-3541-42c3-8361-b49b754a8e01"],
 " is the pair self-energy of method ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "53c4b9df-b22a-492b-ad50-76d0d071309c"],
 " for the pair matrix ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["C",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["p",
      FontSlant->"Plain"], ",", 
     StyleBox["tot",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bd1d33d5-7c3c-46b9-8180-dad3c0c711c7"],
 " (Section II.2; linear in it, and it contains every pair channel of the \
method, not only the channels ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d3de9bb6-37ab-4220-a4b1-c85ea09e3835"],
 "). ",
 StyleBox["Derivation.",
  FontWeight->"Bold"],
 " The expectation value of the pair term of the BdG Hamiltonian is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     StyleBox["V", "TI"], "\[RightAngleBracket]"}], "\[LongEqual]", 
    RowBox[{"-", 
     StyleBox["Re",
      FontSlant->"Plain"]}], "\[ThinSpace]", 
    StyleBox["tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["P",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["a",
        FontSlant->"Plain"]], 
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox[
         StyleBox["C",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], 
         StyleBox["SF",
          FontSlant->"Plain"], 
         RowBox[{
          StyleBox["p",
           FontSlant->"Plain"], ",", 
          StyleBox["tot",
           FontSlant->"Plain"]}]], ")"}], "\[Dagger]"]}], ")"}]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9ea1bfe8-5b7a-4ae0-94b7-0da7fa4c0cdf"],
 "; the thermal state of the Hamiltonian with the pair term has the \
thermodynamic potential ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{"\[LeftAngleBracket]", 
     StyleBox["V", "TI"], "\[RightAngleBracket]"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6b1649b9-1890-4ff5-bae7-2c5c5ed29351"],
 " below that of the normal state (second-order perturbation theory); the \
free energy of the method contains this potential minus ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftAngleBracket]", 
    StyleBox["V", "TI"], "\[RightAngleBracket]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "567d8027-6fa7-4d6a-abb0-59fda2a0bc06"],
 " (the pair term is not part of the Hamiltonian of the model) plus the pair \
part of the interaction energy, which is quadratic in the pair matrix and \
equals ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", "2"]}], 
    StyleBox["Re",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["P",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["SF",
        FontSlant->"Plain"]], 
      RowBox[{"[", 
       SubsuperscriptBox[
        StyleBox["C",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["p",
          FontSlant->"Plain"], ",", 
         StyleBox["tot",
          FontSlant->"Plain"]}]], "]"}], 
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox[
         StyleBox["C",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], 
         StyleBox["SF",
          FontSlant->"Plain"], 
         RowBox[{
          StyleBox["p",
           FontSlant->"Plain"], ",", 
          StyleBox["tot",
           FontSlant->"Plain"]}]], ")"}], "\[Dagger]"]}], ")"}]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "03dd9521-b74c-44cf-8289-2aa147260c57"],
 "; the sum is the formula above. The field of the state is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[CapitalPhi]", "3"], "\[LongEqual]", 
    StyleBox["tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], 
      SubscriptBox[
       StyleBox["P",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["SF",
        FontSlant->"Plain"]], 
      RowBox[{"[", 
       SubsuperscriptBox[
        StyleBox["C",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["p",
          FontSlant->"Plain"], ",", 
         StyleBox["tot",
          FontSlant->"Plain"]}]], "]"}]}], ")"}], "/", "8"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "63cb1283-ab99-420f-b295-c4fa0128eef9"],
 ". The free energy of the field is the smallest ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalF]",
     FontSlant->"Plain"], 
    RowBox[{"2", ",", 
     StyleBox["SF",
      FontSlant->"Plain"]}], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c1c49212-f7a8-41ca-93c4-6b074a79f9d7"],
 " among the states with this field: the components of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["P",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["a",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "733ffd46-85a2-4f4b-9d00-934d6023b277"],
 " along ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], "1"], ")"}], "\[Dagger]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "aad32023-4844-4245-8201-b68d24ee6dcc"],
 ", ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], "2"], ")"}], "\[Dagger]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f7a5762d-6305-4d8b-8848-7b1a2bbb0bcf"],
 ", ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "746f26f7-5008-4fec-98da-533ea36a8984"],
 " are held at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "0", ",", "1"}], ")"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "94306333-b662-4aff-871d-d82c8a0f60f9"],
 ", and its components along the other 25 antisymmetric matrices are made \
self-consistent (a linear system of 25 complex unknowns: the stationarity of \
the free energy with a Lagrange multiplier for the field). Then ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["Tay",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["pair",
        FontSlant->"Plain"]], ";", 
      StyleBox["T", "TI"]}], ")"}], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalF]",
      FontSlant->"Plain"], 
     RowBox[{"2", ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]], "/", 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      SuperscriptBox["\[CapitalPhi]", "3"], "\[RightBracketingBar]"}], "2"]}],
    TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3353fa3a-104e-4ff9-be88-4dd82211ff96"],
 ". At ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["pair",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c46ebd0d-16d2-41c3-9763-df54436ee35b"],
 " and in the channel ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "886c7372-4e0e-428e-9ab9-554bdc38f200"],
 " alone this is"
}], "Text",ExpressionUUID->"6b9832d6-9ef4-46fd-b44c-ce48a52a5cbe"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["Tay",
      FontSlant->"Plain"]}]], 
   RowBox[{"(", 
    RowBox[{"0", ";", 
     StyleBox["T", "TI"]}], ")"}], "\[LongEqual]", 
   FractionBox[
    RowBox[{"1", "-", 
     SubsuperscriptBox["\[Lambda]", 
      StyleBox["SF",
       FontSlant->"Plain"], 
      StyleBox["P",
       FontSlant->"Plain"]], 
     RowBox[{"(", 
      StyleBox["T", "TI"], ")"}]}], 
    RowBox[{
     SubsuperscriptBox["\[Lambda]", 
      StyleBox["SF",
       FontSlant->"Plain"], 
      StyleBox["P",
       FontSlant->"Plain"]], 
     RowBox[{"(", 
      StyleBox["T", "TI"], ")"}], "\[ThinSpace]", 
     SubsuperscriptBox[
      StyleBox["g", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["X", "TI"], ",", 
       StyleBox["P",
        FontSlant->"Plain"]}]]}]], ","}], TraditionalForm]], "DisplayFormula",\

 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"43c59728-8c66-4f47-8e6a-dcf8afc111d7"],

Cell[TextData[{
 "with the eigenvalue ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Lambda]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["P",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6c54105f-e0dc-40b6-8930-cc81f47f365b"],
 " of Section III.T.4: the applied block ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8d71af09-a3b9-47a1-ab03-1dfe6ca196d0"],
 " produces the field ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[CapitalPhi]", "3"], "\[LongEqual]", 
    SubsuperscriptBox["\[Lambda]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["P",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f0fcadf4-4408-4ec1-a520-da3c97a9f841"],
 ", and the formula for ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalF]",
     FontSlant->"Plain"], 
    RowBox[{"2", ",", 
     StyleBox["SF",
      FontSlant->"Plain"]}], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b51b23db-4ebf-4759-8836-7d44373f7a03"],
 " gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      SubsuperscriptBox["\[Lambda]", 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["P",
        FontSlant->"Plain"]]}], ")"}], "\[CenterDot]", "2", 
    SubsuperscriptBox["\[Lambda]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["P",
      FontSlant->"Plain"]], "/", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["P",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6721b753-d70a-4fe7-85c4-dc96a54573c1"],
 ". Hence the slope in closed form, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["GL",
       FontSlant->"Plain"]}]], "\[LongEqual]", 
    RowBox[{"-", 
     SubsuperscriptBox[
      StyleBox["T", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["X", "TI"], ",", 
       StyleBox["c",
        FontSlant->"Plain"]}]]}], "\[ThinSpace]", 
    SubscriptBox["\[PartialD]", 
     StyleBox["T", "TI"]], 
    SubsuperscriptBox["\[Lambda]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["P",
      FontSlant->"Plain"]], "/", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[Lambda]", 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["P",
        FontSlant->"Plain"]], ")"}], "2"], 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["P",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "834b482c-3e02-4b20-b1b0-05dda6a61461"],
 " at ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9721e623-1632-4ea5-9028-ae6136131859"],
 ". ",
 StyleBox["The engine.",
  FontWeight->"Bold"],
 " The next cell defines the static pair response on any set of momenta with \
weights, the quadratic free energy of the field, the normal self-energy at ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d037fb5f-bdb2-4b7d-941d-2336a7cfe4ff"],
 ", and the coefficient for a twist ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["q", "TI"], "\[ThinSpace]", 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], "3"], "\[CircleTimes]", 
    StyleBox["t",
     FontFamily->"Helvetica",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ccdf9394-bfeb-494b-a430-04cc76494937"],
 " with an isospin matrix ",
 Cell[BoxData[
  FormBox[
   StyleBox["t",
    FontFamily->"Helvetica",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ee811885-22b9-440b-941d-b2fc91f4d2bd"],
 ": ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["t",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bfbe8b62-115a-4e0d-bd9a-a4faf6ef4d81"],
 " moves the pair (fermion number 2) with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["pair",
      FontSlant->"Plain"]], "\[LongEqual]", "2", 
    StyleBox["q", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dc0cd96c-0e39-4f04-be99-e6c472a90241"],
 "; ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["t",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "\[LongEqual]", 
    FractionBox["1", "2"], 
    SubscriptBox["\[Tau]", "1"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "89dd7fe2-782b-4755-b0bf-538e7d2ed240"],
 " turns the isospin direction of the field (its components of charge ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "66b88ac6-aa3c-497a-9f50-960f3b81651c"],
 " of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "1"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "079a7da2-8eb9-4250-9b60-dbe22b1cecc1"],
 " get the momenta ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    StyleBox["q", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f0059782-1833-4c06-8602-0dc60d3c3f6d"],
 "), and must give the same coefficient by the isospin invariance of the form."
}], "Text",ExpressionUUID->"c04edec7-d49a-4d9d-9df1-8b2f1de4115b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"--", " ", "the"}]}], " ", "static", " ", "pair", " ", 
    "response", " ", "and", " ", "the", " ", "quadratic", " ", "free", " ", 
    "energy", " ", "of", " ", "a", " ", "field", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"Section", " ", 
        RowBox[{"III", ".", "G"}], ".2"}], ")"}], " ", "--"}], "--"}]}], " ", 
   "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"gzPairs", ":", " ", 
     RowBox[{"the", " ", "28", " ", "index", " ", "pairs", " ", 
      RowBox[{"{", 
       RowBox[{"a", ",", " ", "b"}], "}"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"a", " ", "<", " ", "b"}], ";", " ", 
     RowBox[{"gzBasis", ":", " ", 
      RowBox[{
       RowBox[{
       "the", " ", "antisymmetric", " ", "basis", " ", "matrices", " ", 
        "E_ab"}], " ", "-", " ", "E_ba"}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"gzPairs", " ", "=", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"a", ",", " ", "b"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"a", ",", " ", "8"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"b", ",", " ", 
           RowBox[{"a", " ", "+", " ", "1"}], ",", " ", "8"}], "}"}]}], "]"}],
        ",", " ", "1"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gzBasis", " ", "=", " ", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{"pr", ",", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Which", "[", 
            RowBox[{
             RowBox[{
