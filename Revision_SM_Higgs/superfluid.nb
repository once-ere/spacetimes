 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[CapitalPhi]", "2"], "/", 
    SubsuperscriptBox["\[CapitalPhi]", 
     StyleBox["max",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a2b8ba7a-8cb0-4c5a-8137-cbd799fb3962"],
 ", whose matrix is well conditioned). The next cell does this for CJT and \
compares with the Rust value; the other methods use the Rust values of the \
table."
}], "Text",ExpressionUUID->"813e9208-68ee-482d-b663-51061c88c662"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"mo", " ", "=", " ", 
       RowBox[{"thModel", "[", "\"\<CJT\>\"", "]"}]}], ",", " ", 
      RowBox[{"tc", " ", "=", " ", 
       RowBox[{"thTc", "[", "\"\<CJT\>\"", "]"}]}], ",", " ", "nn", ",", " ", 
      "n0", ",", " ", 
      RowBox[{"xs", " ", "=", " ", 
       RowBox[{"{", "}"}]}], ",", " ", 
      RowBox[{"ys", " ", "=", " ", 
       RowBox[{"{", "}"}]}], ",", " ", "cf", ",", " ", "a", ",", " ", "b"}], 
     "}"}], ",", "\n", "  ", 
    RowBox[{
     RowBox[{"nn", " ", "=", " ", 
      RowBox[{"solveSFT", "[", 
       RowBox[{
       "mo", ",", " ", "zero8", ",", " ", "zero8", ",", " ", "tc", ",", " ", 
        "0.6", ",", " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "14"}]}]}], "]"}]}], ";", " ", 
     RowBox[{"n0", " ", "=", " ", 
      RowBox[{"nn", "[", "\"\<n\>\"", "]"}]}], ";", "\n", "  ", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"res", " ", "=", " ", 
           RowBox[{"fixedPairT", "[", 
            RowBox[{"mo", ",", " ", 
             RowBox[{"fa", " ", 
              RowBox[{"ConjugateTranspose", "[", 
               RowBox[{"k8", "[", "3", "]"}], "]"}]}], ",", " ", "n0", ",", 
             " ", "tc"}], "]"}]}], "}"}], ",", "\n", "     ", 
         RowBox[{
          RowBox[{"n0", " ", "=", " ", 
           RowBox[{"res", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ";", " ", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"xs", ",", " ", 
            RowBox[{
             RowBox[{"res", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "^", "2"}]}], "]"}], ";", " ", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"ys", ",", " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"res", "[", 
                RowBox[{"[", "3", "]"}], "]"}], " ", "-", " ", 
               RowBox[{"nn", "[", "\"\<free\>\"", "]"}]}], ")"}], "/", 
             RowBox[{
              RowBox[{"res", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "^", "2"}]}]}], "]"}]}]}], 
        "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"fa", ",", " ", 
         RowBox[{"{", 
          RowBox[{
          "0.01", ",", " ", "0.02", ",", " ", "0.03", ",", " ", "0.04"}], 
          "}"}]}], "}"}]}], "]"}], ";", "\n", "  ", 
     RowBox[{"cf", " ", "=", " ", 
      RowBox[{"LinearSolve", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"x", "/", 
             RowBox[{"Max", "[", "xs", "]"}]}], ")"}], "^", "k"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "xs"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"k", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}], ",", 
        " ", "ys"}], "]"}]}], ";", "\n", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"a", ",", " ", "b"}], "}"}], " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"cf", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
        RowBox[{
         RowBox[{"cf", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "/", 
         RowBox[{"Max", "[", "xs", "]"}]}]}], "}"}]}], ";", "\n", "  ", 
     RowBox[{
      RowBox[{"gzResults", "[", "\"\<CJT\>\"", "]"}], " ", "=", " ", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"gzResults", "[", "\"\<CJT\>\"", "]"}], ",", " ", 
        RowBox[{"<|", 
         RowBox[{"\"\<b\>\"", " ", "->", " ", "b"}], "|>"}]}], "]"}]}], ";", 
     "\n", "  ", 
     RowBox[{"check", "[", 
      RowBox[{"\"\<WP3-G12\>\"", ",", " ", 
       RowBox[{"\"\<CJT at T_c: the quartic coefficient b = \>\"", " ", "<>", 
        " ", 
        RowBox[{"ToString", "[", 
         RowBox[{"NumberForm", "[", 
          RowBox[{"b", ",", " ", "10"}], "]"}], "]"}], " ", "<>", 
        " ", "\"\< of the free energy at the origin (four applied fields, \
thermal engine) is positive and = Rust \>\"", " ", "<>", " ", 
        RowBox[{"ToString", "[", 
         RowBox[{"NumberForm", "[", 
          RowBox[{
           RowBox[{"gzRust", "[", 
            RowBox[{"\"\<CJT\>\"", ",", " ", "\"\<b\>\""}], "]"}], ",", " ", 
           "10"}], "]"}], "]"}], " ", "<>", 
        " ", "\"\< (relative difference; a(T_c) = \>\"", " ", "<>", " ", 
        RowBox[{"sci", "[", "a", "]"}], " ", "<>", " ", "\"\<)\>\""}], ",", 
       "\n", "   ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"b", " ", ">", " ", "0"}], ",", " ", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"b", " ", "-", " ", 
            RowBox[{"gzRust", "[", 
             RowBox[{"\"\<CJT\>\"", ",", " ", "\"\<b\>\""}], "]"}]}], "]"}], "/", 
          RowBox[{"gzRust", "[", 
           RowBox[{"\"\<CJT\>\"", ",", " ", "\"\<b\>\""}], "]"}]}], ",", " ", 
         "1."}], "]"}], ",", " ", 
       RowBox[{"10", "^", 
        RowBox[{"-", "6"}]}], ",", " ", "\"\<P3-G12 CJT\>\"", ",", 
       " ", "\"\<YP3-G12 CJT\>\""}], "]"}]}]}], "]"}], ";"}]], "Input",
 CellLabel->
  "In[393]:=",ExpressionUUID->"d2be94cd-6fbc-4c1c-9899-ce494e1e0954"],

