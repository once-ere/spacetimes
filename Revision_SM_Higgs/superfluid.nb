Cell[TextData[{
 StyleBox["A logarithm.",
  FontWeight->"Bold"],
 " The energy per volume is an integral over the momenta ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["q", "TI"], "<", 
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "14fd72ac-1b53-464b-8051-436cd087b1f7"],
 " of functions of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       StyleBox["q", "TI"], "2"], "+", 
      StyleBox["s", "TI"]}], ")"}], 
    RowBox[{"1", "/", "2"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6d77f2ad-86aa-4079-9b19-8c6a4e54cce2"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["s", "TI"], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["D",
         FontSlant->"Plain"]}]], ")"}], "2"], "+", 
    SubsuperscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4dbb4815-84d8-4cbc-a583-8bca02969b78"],
 ". The next cell integrates the simplest of them exactly and expands the \
result about ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["s", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "45ae1232-7e87-4474-a716-97af2e008e22"],
 ": it contains the term ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "16"], 
    SuperscriptBox[
     StyleBox["s", "TI"], "2"], "\[ThinSpace]", 
    StyleBox["ln",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["s", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5d40ed39-0b9c-417c-b4d9-7173e5840a78"],
 ", which is not analytic at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["s", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9b45824c-8a66-4022-b122-f3c8c61de969"],
 ", that is, at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"], "2"], "\[LongEqual]", 
    RowBox[{"-", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["M", "TI"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["X", "TI"], ",", 
         StyleBox["D",
          FontSlant->"Plain"]}]], ")"}], "2"]}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "808dc355-b7f1-4f9b-b1a7-fbac974ab832"],
 ". Hence ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalV]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "930846e5-56ac-4374-8c52-a4ba6985d6bd"],
 " is not a polynomial in ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e664f48f-ce63-405a-af41-a3517f1ed3e7"],
 ", and a series of powers of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "80697ea7-7925-4597-bc9f-460a333e96b3"],
 " about the origin can converge only within a radius of the order of the \
Dirac mass (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0.2"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0deb88f5-3e0e-4ce9-88c5-d50bca8a64ce"],
 " at the origin), while ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalPhi]", 
     RowBox[{"0", ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]], "\[LongEqual]", "0.31"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "66a3f4c6-381d-4bda-8d9d-94e6edb168a1"],
 " to ",
 Cell[BoxData[
  FormBox["0.40", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d7d00480-a516-4cd5-a5d9-023244d45652"],
 ": the superfluid is far from the regime of Landau's theory, where the order \
parameter is small and the Landau coefficients are Taylor coefficients."
}], "Text",ExpressionUUID->"6c2a57ca-5626-4c77-a0cd-4dce5c26632e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", "integral", " ", "of", " ", 
     RowBox[{"q", "^", "2"}], " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"q", "^", "2"}], " ", "+", " ", "s"}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}]}], " ", "from", " ", "0", " ", "to", " ",
      "the", " ", "cutoff", " ", "lam"}], ",", " ", "exactly", ",", " ", 
    RowBox[{
     RowBox[{"and", " ", "its", " ", "expansion", " ", "about", " ", "s"}], 
     " ", "=", " ", "0"}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"lfq", ":", " ", 
     RowBox[{
     "the", " ", "modulus", " ", "of", " ", "the", " ", "momentum"}]}], ",", 
    " ", 
    RowBox[{"lfs", ":", " ", 
     RowBox[{
      RowBox[{"the", " ", "quantity", " ", 
       RowBox[{"M", "^", "2"}]}], " ", "+", " ", 
      RowBox[{"Phi_a", "^", "2"}]}]}], ",", " ", 
    RowBox[{"lfLam", ":", " ", 
     RowBox[{"the", " ", "cutoff"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"lfInt", " ", "=", " ", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"lfq", "^", "2"}], " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"lfq", "^", "2"}], " ", "+", " ", "lfs"}], "]"}]}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"lfq", ",", " ", "0", ",", " ", "lfLam"}], "}"}], ",", " ", 
       RowBox[{"Assumptions", " ", "->", " ", 
        RowBox[{
         RowBox[{"lfs", " ", ">", " ", "0"}], " ", "&&", " ", 
         RowBox[{"lfLam", " ", ">", " ", "0"}]}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"lfClosed", " ", "=", " ", 
     RowBox[{
      RowBox[{"lfLam", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", " ", 
          RowBox[{"lfLam", "^", "2"}]}], " ", "+", " ", "lfs"}], ")"}], " ", 
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"lfLam", "^", "2"}], " ", "+", " ", "lfs"}], "]"}], "/", 
        "8"}]}], " ", "-", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"lfs", "^", "2"}], "/", "8"}], " ", 
       RowBox[{"Log", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"lfLam", " ", "+", " ", 
           RowBox[{"Sqrt", "[", 
            RowBox[{
             RowBox[{"lfLam", "^", "2"}], " ", "+", " ", "lfs"}], "]"}]}], 
          ")"}], "/", 
         RowBox[{"Sqrt", "[", "lfs", "]"}]}], "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<the integral minus the closed form: \>\"", ",", " ", 
      RowBox[{"FullSimplify", "[", 
       RowBox[{
        RowBox[{"lfInt", " ", "-", " ", "lfClosed"}], ",", " ", 
        RowBox[{"Assumptions", " ", "->", " ", 
         RowBox[{
          RowBox[{"lfs", " ", ">", " ", "0"}], " ", "&&", " ", 
          RowBox[{"lfLam", " ", ">", " ", "0"}]}]}]}], "]"}]}], "]"}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"lfSeries", " ", "=", " ", 
     RowBox[{"Expand", "[", 
      RowBox[{"Normal", "[", 
       RowBox[{"Series", "[", 
        RowBox[{
         RowBox[{"lfClosed", " ", "/.", " ", 
          RowBox[{"lfLam", " ", "->", " ", "1"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"lfs", ",", " ", "0", ",", " ", "2"}], "}"}]}], "]"}], 
       "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<the closed form about s = 0 (cutoff 1), to the order s^2: \
\>\"", ",", " ", "lfSeries"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<its term with the logarithm: \>\"", ",", " ", 
      RowBox[{"Coefficient", "[", 
       RowBox[{"lfSeries", ",", " ", 
        RowBox[{"Log", "[", "lfs", "]"}]}], "]"}], ",", 
      " ", "\"\< Log[s]\>\""}], "]"}], ";"}]}]}]], "Input",
 CellLabel->
  "In[305]:=",ExpressionUUID->"17af70fc-30b2-460b-866a-7726f2755cbd"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"the integral minus the closed form: \"\>", "\[InvisibleSpace]",
    "0"}],
  SequenceForm["the integral minus the closed form: ", 0],
  Editable->False]], "Print",
 CellChangeTimes->{4.0042970012974977`*^9},
 CellLabel->
  "During evaluation of \
In[305]:=",ExpressionUUID->"c1c21a55-4889-4ec9-9cc5-c0136d98a881"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"the closed form about s = 0 (cutoff 1), to the order s^2: \
\"\>", "\[InvisibleSpace]", 
   RowBox[{
    FractionBox["1", "4"], "+", 
    FractionBox["lfs", "4"], "+", 
    FractionBox[
     SuperscriptBox["lfs", "2"], "32"], "-", 
    RowBox[{
     FractionBox["1", "8"], " ", 
     SuperscriptBox["lfs", "2"], " ", 
     RowBox[{"Log", "[", "2", "]"}]}], "+", 
    RowBox[{
     FractionBox["1", "16"], " ", 
     SuperscriptBox["lfs", "2"], " ", 
     RowBox[{"Log", "[", "lfs", "]"}]}]}]}],
  SequenceForm[
  "the closed form about s = 0 (cutoff 1), to the order s^2: ", 
   Rational[1, 4] + Rational[1, 4] $CellContext`lfs + 
   Rational[1, 32] $CellContext`lfs^2 + 
   Rational[-1, 8] $CellContext`lfs^2 Log[2] + 
   Rational[1, 16] $CellContext`lfs^2 Log[$CellContext`lfs]],
  Editable->False]], "Print",
 CellChangeTimes->{4.004297001301939*^9},
 CellLabel->
  "During evaluation of \
In[305]:=",ExpressionUUID->"d48e9997-eb81-434d-bd1a-b8d37092b62b"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"its term with the logarithm: \"\>", "\[InvisibleSpace]", 
   FractionBox[
    SuperscriptBox["lfs", "2"], "16"], 
   "\[InvisibleSpace]", "\<\" Log[s]\"\>"}],
  SequenceForm[
  "its term with the logarithm: ", Rational[1, 16] $CellContext`lfs^2, 
   " Log[s]"],
  Editable->False]], "Print",
 CellChangeTimes->{4.0042970013024893`*^9},
 CellLabel->
  "During evaluation of \
In[305]:=",ExpressionUUID->"641ae99d-af2f-4458-9c43-2af14a36fe84"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 StyleBox["The Taylor coefficient at the origin.",
  FontWeight->"Bold"],
 " The coefficient ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["Tay",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ba4d1f9f-910a-49da-8bfc-c5d555ca0d0e"],
 " of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f8c90811-0083-49d8-b58f-8b2d0f5742dc"],
 " of the Taylor series at the origin is the limit of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalV]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], "/", 
    SuperscriptBox["\[CapitalPhi]", "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e7b137e4-4d7f-45b1-aa90-c042263940f3"],
 " at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPhi]", "\[RightArrow]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "aa6d61a4-d316-4c05-aa51-03d9589e02fe"],
 ". The Rust and the Python program compute it from three states with small \
applied fields (0.004, 0.008, 0.016) and the Richardson elimination of the \
term proportional to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CapitalPhi]", "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d1fa4443-7cb0-476b-be5c-b0d6c3a22317"],
 ". The next cell estimates it from the first six points of the computed \
curve (",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPhi]", "<", "0.1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "588b6b18-8bf7-44ce-9395-8da5d0bac1c6"],
 ", well inside the radius of convergence) by fitting ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalV]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], "/", 
    SuperscriptBox["\[CapitalPhi]", "2"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["a", "TI"], "0"], "+", 
    SubscriptBox[
     StyleBox["a", "TI"], "1"], 
    SuperscriptBox["\[CapitalPhi]", "2"], "+", 
    SubscriptBox[
     StyleBox["a", "TI"], "2"], 
    SuperscriptBox["\[CapitalPhi]", "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1d73889a-db61-4baf-95b1-183e838d70d1"],
 "; the truncation of this local series limits the agreement to about ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", "\[Times]", 
    SuperscriptBox["10", 
     RowBox[{"-", "7"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9761a2bc-6a78-4ccd-9987-ed69fb5e35a1"],
 ". The fitted ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "76261b4d-985f-4da2-b541-4d51e8bbf6d7"],
 " of the Landau form differs from ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["Tay",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0980ffb9-15b7-47b2-84c1-6c72b6b86da9"],
 " by 0.7 to 2 per cent: it is a property of the fit."
}], "Text",ExpressionUUID->"2f69fc22-ed74-4a7e-9997-a0079abe447a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"lfTaylor", "[", "t", "]"}], ":", " ", 
    RowBox[{
     RowBox[{"a", "^", "Tay"}], " ", "estimated", " ", "from", " ", "the", " ",
      "points", " ", "2", " ", "to", " ", "7", " ", "of", " ", "the", " ", 
     "curve", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"the", " ", "first", " ", "point", " ", "is", " ", "Phi"}], 
       " ", "=", " ", "0"}], ")"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"lfTaylor", "[", "t_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"p", " ", "=", " ", 
         RowBox[{
          RowBox[{"lfCurve", "[", "t", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"2", " ", ";;", " ", "7"}], "]"}], "]"}]}], "}"}], ",", 
       " ", 
       RowBox[{
        RowBox[{"LeastSquares", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", " ", 
              RowBox[{"x", "^", "2"}], ",", " ", 
              RowBox[{"x", "^", "4"}]}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"x", ",", " ", 
              RowBox[{"p", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], "}"}]}], 
           "]"}], ",", " ", 
          RowBox[{
           RowBox[{"p", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "/", 
           RowBox[{
            RowBox[{"p", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], "^", "2"}]}]}], 
         "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{"\"\<WP3-10 \>\"", " ", "<>", " ", "t"}], ",", " ", 
        RowBox[{
         RowBox[{"lfName", "[", "t", "]"}], " ", "<>", 
         " ", "\"\<: the coefficient of Phi^2 of the Taylor series at the \
origin from the first six points of the curve = the Rust value a^Tay = \>\"", 
         " ", "<>", " ", 
         RowBox[{"ToString", "[", 
          RowBox[{"rustPart3", "[", 
           RowBox[{"\"\<p3_a_taylor_\>\"", " ", "<>", " ", "t"}], "]"}], 
          "]"}], " ", "<>", " ", "\"\< (relative)\>\""}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"lfTaylor", "[", "t", "]"}], " ", "-", " ", 
           RowBox[{"rustPart3", "[", 
            RowBox[{"\"\<p3_a_taylor_\>\"", " ", "<>", " ", "t"}], "]"}]}], 
          "]"}], "/", 
         RowBox[{"Abs", "[", 
          RowBox[{"rustPart3", "[", 
           RowBox[{"\"\<p3_a_taylor_\>\"", " ", "<>", " ", "t"}], "]"}], 
          "]"}]}], ",", " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "6"}]}], ",", " ", 
        RowBox[{"\"\<P3-10 \>\"", " ", "<>", " ", "t"}], ",", " ", 
        RowBox[{"\"\<YP3-10 \>\"", " ", "<>", " ", "t"}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"t", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<HS_1_1\>\"", ",", " ", "\"\<CJT\>\""}], "}"}]}], 
       "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"lfName", "[", "t", "]"}], ",", " ", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{"lfTaylor", "[", "t", "]"}], ",", " ", "10"}], "]"}], ",",
            " ", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{"rustPart3", "[", 
              RowBox[{"\"\<p3_a_taylor_\>\"", " ", "<>", " ", "t"}], "]"}], ",",
              " ", "10"}], "]"}], ",", " ", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"lfResults", "[", "t", "]"}], "[", "\"\<a\>\"", "]"}], ",",
              " ", "10"}], "]"}], ",", " ", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{"100", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"lfResults", "[", "t", "]"}], "[", "\"\<a\>\"", 
                  "]"}], "/", 
                 RowBox[{"rustPart3", "[", 
                  RowBox[{"\"\<p3_a_taylor_\>\"", " ", "<>", " ", "t"}], 
                  "]"}]}], " ", "-", " ", "1"}], ")"}]}], ",", " ", "3"}], 
            "]"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"t", ",", " ", "lfTags"}], "}"}]}], "]"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<method\>\"", ",", " ", "\"\<a^Tay from the curve\>\"", ",",
          " ", "\"\<a^Tay of the Rust program\>\"", ",", 
         " ", "\"\<a of the Landau form\>\"", ",", 
         " ", "\"\<a/a^Tay - 1 (per cent)\>\""}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "All"}]}], "]"}]}]}]], "Input",
 CellLabel->
  "In[311]:=",ExpressionUUID->"16fab28c-2988-451e-b567-597da18e6213"],

