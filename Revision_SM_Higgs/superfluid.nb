Cell[CellGroupData[{

Cell["\<\
R.1 The quantum numbers of the fields, of their pairs and of the bidoublet \
(stage 2)\
\>", "Section",ExpressionUUID->"bd4428f3-f575-43f2-9382-b9fdfb4970a1"],

Cell["\<\
This section builds the generators of all symmetries on the sixteen \
components as exact matrices and derives from them every quantum number that \
the revision uses: the algebra of the groups, the charges, the absence of \
anomalies, the Lorentz-invariant bilinears and their parity, the quantum \
numbers of the pair fields and of the bidoublet, the invariance of the \
pairing terms, the table of all pair channels, the pattern of the breaking \
and the masses of the gauge bosons. All arithmetic is exact (rational \
numbers, square roots and symbols), so the checks of this section need no \
tolerance.\
\>", "Text",ExpressionUUID->"33c309bb-9665-4011-88fd-6b7afcc7073b"],

Cell[CellGroupData[{

Cell["R.1.1 The matrices and the generators", "Subsection",ExpressionUUID->"3cdf8c6d-26f1-48f1-b7ed-d3158b671d61"],

Cell[TextData[{
 "The Pauli matrices ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Sigma]", 
    StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0d00d123-7aea-4a20-960e-34e533527e2b"],
 " and the Dirac matrices of the chiral basis, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p", "TI"]], "\[LongEqual]", 
    RowBox[{"(", "\[NoBreak]", GridBox[{
       {"0", 
        SuperscriptBox["\[Sigma]", 
         StyleBox["p", "TI"]]},
       {
        SuperscriptBox[
         OverscriptBox["\[Sigma]", "_"], 
         StyleBox["p", "TI"]], "0"}
      },
      GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
      GridBoxSpacings->{"Columns" -> {
          Offset[0.27999999999999997`], {
           Offset[0.7]}, 
          Offset[0.27999999999999997`]}, "Rows" -> {
          Offset[0.2], {
           Offset[0.4]}, 
          Offset[0.2]}}], "\[NoBreak]", ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "348bb6e1-6093-4ffa-bf1c-0966dff7d208"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Sigma]", "0"], "\[LongEqual]", 
    SuperscriptBox[
     OverscriptBox["\[Sigma]", "_"], "0"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c95e89b5-72b4-4343-98a4-3ad26af3ccb5"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     OverscriptBox["\[Sigma]", "_"], 
     StyleBox["j", "TI"]], "\[LongEqual]", 
    RowBox[{"-", 
     SuperscriptBox["\[Sigma]", 
      StyleBox["j", "TI"]]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e3c641b7-2792-4938-b844-fc456960e31c"],
 ", give the chirality ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["ch",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7602be7e-801f-40b7-bc1a-db0c733d0d7c"],
 " and the charge-conjugation matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    StyleBox["i", "TI"], 
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], "2"], 
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], "0"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "97958533-b09f-4d5a-ae07-4b929752feb9"],
 ". A matrix ",
 Cell[BoxData[
  FormBox[
   StyleBox["a", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1e052660-5a94-474f-838b-292557ca557a"],
 " that acts on the Dirac index acts on the whole field as ",
 StyleBox["dirac16[a]",
  FontFamily->"Source Code Pro"],
 ": ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], "\[CircleTimes]", 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "07e368d3-56a8-4e2c-a317-9e31d23ff25b"],
 " on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "409fad25-c7da-4c7e-a0ef-cdecfa9623c7"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["a", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "63617af0-6a89-445c-afb2-a1cfcbc66709"],
 " on each singlet. The internal generators are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["T", "TI"], 
     RowBox[{
      StyleBox["a", "TI"], ",", 
      StyleBox["SM",
       FontSlant->"Plain"]}]], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "4"], "\[CircleTimes]", 
    SuperscriptBox["\[Tau]", 
     StyleBox["a", "TI"]], "/", "2"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "80ed30b3-646a-47c3-87a2-816faf2115a2"],
 " on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c2a8818f-1e79-4a6e-9e70-46d876aa2ba9"],
 " (zero on the singlets), ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["a", "TI"], ",", 
      StyleBox["R",
       FontSlant->"Plain"]}]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["\[Tau]", 
       StyleBox["a", "TI"]], "/", "2"}], ")"}], "\[CircleTimes]", 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c24d4d53-cc94-4354-8727-f14e3107ac33"],
 " on the pair ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["\[Chi]", 
      StyleBox["SH",
       FontSlant->"Plain"]], ",", 
     SubsuperscriptBox["\[Chi]", 
      StyleBox["SH",
       FontSlant->"Plain"], "\[Prime]"]}], ")"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3afef8ad-21e5-429b-bcea-57ec15621c49"],
 " (zero on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "94d293ea-1765-412f-b4dc-04e39742d271"],
 "), ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["F", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["tot",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "16"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "86266520-8b0d-44b1-9024-f704a4852802"],
 ", the hypercharge ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["Y", "TI"], 
    StyleBox["SM",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d5fc9124-f2e0-4d5a-bd37-4e836622a01d"],
 " of the table of the hypotheses (",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "4"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "98924c25-b1f7-4e68-a278-fbf4a57a395c"],
 " on the first twelve components, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    FractionBox["3", "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "add6735f-f6bb-49c8-b32d-59f9bf514982"],
 " on ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Chi]", 
    StyleBox["SH",
     FontSlant->"Plain"], "\[Prime]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "eb1aeac6-c318-4492-8499-43cec8219fa4"],
 "), ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]], "\[LongEqual]", 
    StyleBox["diag",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["1",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], "8"], ",", 
