            RowBox[{"(", 
             RowBox[{
              RowBox[{"lam", "^", "2"}], " ", "gp"}], ")"}]}]}], ",", " ", 
          "lam", ",", " ", "mn"}], "}"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"gzResults", "[", "t", "]"}], ":", " ", 
      RowBox[{
      "the", " ", "results", " ", "of", " ", "the", " ", "method", " ", "t", " ", 
       RowBox[{"(", "association", ")"}]}]}], ",", " ", 
     RowBox[{
     "filled", " ", "by", " ", "the", " ", "cells", " ", "of", " ", "this", " ",
       "section", " ", "and", " ", "the", " ", "next"}]}], " ", "*)"}], "\n", 
   
   RowBox[{
    RowBox[{"gzResults", " ", "=", " ", 
     RowBox[{"<|", "|>"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"tc", " ", "=", " ", 
           RowBox[{"thTc", "[", "t", "]"}]}], ",", " ", 
          RowBox[{"gp", " ", "=", " ", 
           RowBox[{
            RowBox[{"thCoup", "[", "t", "]"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", 
          RowBox[{"t09", " ", "=", " ", 
           RowBox[{"thGet", "[", 
            RowBox[{"t", ",", " ", "0.9", ",", " ", "\"\<T\>\""}], "]"}]}], ",",
           " ", "a09", ",", " ", "at", ",", " ", 
          RowBox[{"worst", " ", "=", " ", "0."}], ",", " ", "ac", ",", " ", 
          "perp0", ",", " ", "d1", ",", " ", "d2", ",", " ", "alFD", ",", " ",
           "alCl", ",", " ", "lamC", ",", " ", "mnC"}], "}"}], ",", "\n", 
        "   ", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{"at", " ", "0.9", " ", "T_c"}], ",", " ", 
          RowBox[{
          "against", " ", "the", " ", "Taylor", " ", "coefficient", " ", "of",
            " ", "the", " ", "nonlinear", " ", "free", " ", "energy", " ", 
           "of", " ", "the", " ", "Rust", " ", "table"}]}], " ", "*)"}], "\n",
         "   ", 
        RowBox[{
         RowBox[{"a09", " ", "=", " ", 
          RowBox[{
           RowBox[{"gzA", "[", 
            RowBox[{"t", ",", " ", "t09", ",", " ", "0.", ",", " ", 
             RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ";", " ", 
         RowBox[{"at", " ", "=", " ", 
          RowBox[{"thGet", "[", 
           RowBox[{"t", ",", " ", "0.9", ",", " ", "\"\<a\>\""}], "]"}]}], ";",
          "\n", "   ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{"\"\<WP3-G1 \>\"", " ", "<>", " ", "t"}], ",", " ", 
           RowBox[{
            RowBox[{"thName", "[", "t", "]"}], " ", "<>", 
            " ", "\"\<: at 0.9 T_c the coefficient a(0) of |Phi|^2 from the \
static pair response (\>\"", " ", "<>", " ", 
            RowBox[{"sci", "[", "a09", "]"}], " ", "<>", 
            " ", "\"\<) equals the Taylor coefficient a^Tay of the nonlinear \
free energy of Section III.T (\>\"", " ", "<>", " ", 
            RowBox[{"sci", "[", "at", "]"}], " ", "<>", 
            " ", "\"\<) (relative difference)\>\""}], ",", "\n", "    ", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"a09", " ", "-", " ", "at"}], "]"}], "/", 
            RowBox[{"Abs", "[", "at", "]"}]}], ",", " ", 
           RowBox[{"10", "^", 
            RowBox[{"-", "7"}]}], ",", " ", 
           RowBox[{"\"\<P3-G1 \>\"", " ", "<>", " ", "t"}], ",", " ", 
           RowBox[{"\"\<YP3-G1 \>\"", " ", "<>", " ", "t"}]}], "]"}], ";", 
         "\n", "   ", 
         RowBox[{"(*", " ", 
          RowBox[{
          "the", " ", "closed", " ", "form", " ", "at", " ", "three", " ", 
           "temperatures"}], " ", "*)"}], "\n", "   ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"temp", " ", "=", " ", 
                RowBox[{"tau", " ", "tc"}]}], ",", " ", "a", ",", " ", 
               "lam"}], "}"}], ",", "\n", "      ", 
             RowBox[{
              RowBox[{"a", " ", "=", " ", 
               RowBox[{
                RowBox[{"gzA", "[", 
