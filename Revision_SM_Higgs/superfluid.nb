      "id", ",", " ", "text", ",", " ", "ok", ",", " ", "detail", ",", " ", 
       RowBox[{"rvRust", "[", "id", "]"}], ",", " ", 
       RowBox[{"rvPython", "[", "id", "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"readTable", "[", "file", "]"}], ":", " ", 
