       SubscriptBox[
        StyleBox["1",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], "8"]}]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "467a87c0-51f8-4934-849d-ecb044206079"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["Q", "TI"], 
     StyleBox["SM",
      FontSlant->"Plain"]], "\[LongEqual]", 
