Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"gzRust", "[", 
      RowBox[{"t", ",", " ", "key"}], "]"}], ":", " ", 
     RowBox[{"an", " ", "entry", " ", "of", " ", "rustGinzburg"}]}], ";", " ", 
    RowBox[{
     RowBox[{"hgRust", "[", 
      RowBox[{"t", ",", " ", "key"}], "]"}], ":", " ", 
     RowBox[{"an", " ", "entry", " ", "of", " ", "rustHiggs", " ", 
      RowBox[{"(", 
       RowBox[{"one", " ", "row", " ", "per", " ", "method"}], ")"}]}]}]}], 
   " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"gzCols", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<method\>\"", ",", " ", "\"\<Tc\>\"", ",", 
         " ", "\"\<massN\>\"", ",", " ", "\"\<alpha\>\"", ",", 
         " ", "\"\<b\>\"", ",", " ", "\"\<c\>\"", ",", " ", "\"\<cIso\>\"", ",",
          " ", "\"\<cFixed\>\"", ",", " ", "\"\<cT3\>\"", ",", 
         " ", "\"\<cTwisted\>\"", ",", " ", "\"\<c1\>\"", ",", 
         " ", "\"\<c2\>\"", ",", " ", "\"\<perp0\>\"", ",", 
         " ", "\"\<perpK\>\"", ",", " ", "\"\<aTc\>\"", ",", " ", "\"\<Gi\>\"",
          ",", " ", "\"\<width\>\"", ",", " ", "\"\<xi0\>\"", ",", 
         " ", "\"\<PhiG\>\""}], "}"}], " ", "->", " ", 
       RowBox[{"Range", "[", "19", "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"gzRust", "[", 
      RowBox[{"t_", ",", " ", "key_"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"First", "[", 
       RowBox[{"Select", "[", 
        RowBox[{"rustGinzburg", ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], " ", "==", " ", "t"}], " ", 
          "&"}]}], "]"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"gzCols", "[", "key", "]"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"hgCols", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<method\>\"", ",", " ", "\"\<v\>\"", ",", 
         " ", "\"\<fF\>\"", ",", " ", "\"\<fI\>\"", ",", " ", "\"\<MH\>\"", ",",
          " ", "\"\<MNU\>\"", ",", " ", "\"\<MW\>\"", ",", " ", "\"\<MZ\>\"", 
         ",", " ", "\"\<MHv\>\"", ",", " ", "\"\<lambda\>\"", ",", 
