     StyleBox["T", "TI"], 
     RowBox[{"2", ",", 
      StyleBox["SM",
       FontSlant->"Plain"]}]], ",", 
    SuperscriptBox[
     StyleBox["T", "TI"], 
     RowBox[{"3", ",", 
      StyleBox["SM",
       FontSlant->"Plain"]}]], ",", 
    SuperscriptBox[
     StyleBox["Y", "TI"], 
     StyleBox["SM",
      FontSlant->"Plain"]], ",", 
