Cell[TextData[{
 StyleBox["The manifold M31 and its Lorentz group.",
  FontWeight->"Bold"],
 " M31 is the real vector space of the Hermitian bi-quaternions ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["x",
     FontWeight->"Bold",
     FontSlant->"Plain"], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "0"], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "0"], "+", 
    StyleBox["i", "TI"], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", 
     StyleBox["j", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "865daa2c-4418-48a8-ba5c-646a3ccfda55"],
 "; their matrices ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["x",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", 
     StyleBox["p", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p", "TI"]], 
    SubsuperscriptBox["\[Sigma]", 
     StyleBox["p", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4dd3b8f7-86dc-418f-9b08-9bf6253dbd6e"],
 " are the Hermitian ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Times]", "2"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "32cae55e-2dbf-41d6-a337-801f2aed3d85"],
 " matrices, and the norm ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["x",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "0"], ")"}], "2"], "-", 
    UnderscriptBox["\[Sum]", 
     StyleBox["j", "TI"],
     LimitsPositioning->True], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["j", "TI"]], ")"}], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d90d8fbd-8f34-4ab0-bf5d-040bb8fa7cc1"],
 " is the Minkowski interval. A unit bi-quaternion ",
 Cell[BoxData[
  FormBox[
   StyleBox["g",
    FontWeight->"Bold",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7f02cad3-1776-4c62-b858-da03128937e2"],
 " acts by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["x",
     FontWeight->"Bold",
     FontSlant->"Plain"], "\[RightTeeArrow]", 
    StyleBox["g",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    StyleBox["x",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    SuperscriptBox[
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], "\[Dagger]"]}], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "67dbce3e-6f4e-4003-98b4-c20abc55c409"],
 "; this keeps M31 and the interval, so it is a Lorentz transformation, with \
the real matrix"
}], "Text",ExpressionUUID->"fed57772-d436-46a2-852d-a869853a67f4"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["L",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   SubscriptBox[
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    RowBox[{
     StyleBox["p", "TI"], 
     SuperscriptBox[
      StyleBox["p", "TI"], "\[Prime]"]}]], "\[LongEqual]", 
   FractionBox["1", "2"], "\[ThinSpace]", 
   StyleBox["Re",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["tr",
    FontSlant->"Plain"], 
   RowBox[{"(", 
    RowBox[{
     SubsuperscriptBox["\[Sigma]", 
      StyleBox["p", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"]], 
     SubscriptBox[
      StyleBox["M", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"]], 
     RowBox[{"(", 
      StyleBox["g",
       FontWeight->"Bold",
       FontSlant->"Plain"], ")"}], "\[ThinSpace]", 
     SubsuperscriptBox["\[Sigma]", 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"], 
      StyleBox["LL",
       FontSlant->"Plain"]], 
     SubscriptBox[
      StyleBox["M", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"]], 
     SuperscriptBox[
      RowBox[{"(", 
       StyleBox["g",
        FontWeight->"Bold",
        FontSlant->"Plain"], ")"}], "\[Dagger]"]}], ")"}], ","}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"3c327eb1-5264-4db3-a77f-0258bb497e35"],

Cell[TextData[{
 "which is proper and orthochronous (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["L",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["T", "TI"]], "\[Eta]", 
    StyleBox["L",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "\[LongEqual]", "\[Eta]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "21c33e53-c279-42fc-99cc-32bca9c41053"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["det",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["L",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d1831991-6322-4964-a341-2bc309515e3f"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["L",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "00"], "\[GreaterEqual]", "1"}], TraditionalForm]],
   "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0ebf1051-e486-44d8-aa55-6d603a81bcfc"],
 ") and multiplicative, with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["L",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     RowBox[{"-", 
      StyleBox["g",
       FontWeight->"Bold",
       FontSlant->"Plain"]}], ")"}], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["L",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "44f34ef3-e578-4346-8edd-4f897840dee3"],
 ": ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SL", "TI"], 
    RowBox[{"(", 
     RowBox[{"2", ",", 
      StyleBox["\[DoubleStruckCapitalC]",
       FontSlant->"Plain"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f4ca96e5-28d8-4fde-821a-cf6d6a553aad"],
 " is the double cover of the proper orthochronous Lorentz group. The next \
cell checks the properties of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["M", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ff66d875-f8fb-44a1-a958-fc446ef70ee6"],
 " exactly (with Gaussian-integer coefficients) and those of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["L",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8c10d473-8fa1-4079-ad97-3cdbdfe99a30"],
 " with 200 random unit bi-quaternions in floating point. A spinor charge of \
the super-loop is a bi-octonion ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["b",
     FontWeight->"Bold",
     FontSlant->"Plain"], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e85bb836-20dc-4149-ad7b-b9a72b93830d"],
 "; by the product rule the super-loop acts on it as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      StyleBox["b",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      SubscriptBox[
       StyleBox["e",
        FontWeight->"Bold",
        FontSlant->"Plain"], "4"]}], ")"}], 
    StyleBox["g",
     FontWeight->"Bold",
     FontSlant->"Plain"], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["b",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      OverscriptBox[
       StyleBox["g",
        FontWeight->"Bold",
        FontSlant->"Plain"], "_"]}], ")"}], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
