Cell["R.1.7 The parity of the pair matrices (check WQN-7)", "Subsection",ExpressionUUID->"400724dc-8b70-4396-b6d4-311ccae2a5b6"],

Cell[TextData[{
 "Under parity, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Phi]", "\[RightArrow]", 
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], "0"], "\[Phi]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "969eab84-d665-47ec-b718-21e082fc70d6"],
 " with the intrinsic parity ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e31013a3-c04a-408d-96e3-5a7b1bf6bc4c"],
 " for every field, a pair matrix goes over into ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], "0"], 
    StyleBox["M",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], "0"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "505a363f-3a1a-464e-b15c-8ca0dad8e9d0"],
 ". The pairs of the hypotheses, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["ch",
      FontSlant->"Plain"]], "\[CircleTimes]", 
    SubsuperscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["s", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dc9ab729-3ba1-40dc-8772-6b93b0b6d524"],
 ", are even (a scalar), and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[CircleTimes]", 
    SubsuperscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["s", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cfd22b22-ec59-4ab8-8806-7849b8d8d059"],
 " is odd (a pseudoscalar), with either singlet."
}], "Text",ExpressionUUID->"40a37f0b-9009-4bca-a580-7158cc638372"],

