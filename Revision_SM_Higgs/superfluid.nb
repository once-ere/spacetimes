     RowBox[{"(", 
      RowBox[{"0", ",", " ", "0"}], ")"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"i1", "[", "mm_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{"1", " ", "+", " ", 
          RowBox[{"mm", "^", "2"}]}], "]"}], " ", "-", " ", 
        RowBox[{
         RowBox[{"mm", "^", "2"}], " ", 
         RowBox[{"ArcSinh", "[", 
          RowBox[{"1", "/", "mm"}], "]"}]}]}], ")"}], "/", "2"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"jj", "[", "mm_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"ArcSinh", "[", 
       RowBox[{"1", "/", "mm"}], "]"}], " ", "-", " ", 
      RowBox[{"1", "/", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"1", " ", "+", " ", 
         RowBox[{"mm", "^", "2"}]}], "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"okJ", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"i1", "[", "mm", "]"}], ",", " ", "mm"}], "]"}], " ", "+",
           " ", 
          RowBox[{"mm", " ", 
           RowBox[{"jj", "[", "mm", "]"}]}]}], ",", " ", 
         RowBox[{"mm", " ", ">", " ", "0"}]}], "]"}], " ", "==", " ", "0"}], 
      " ", "&&", "\n", "  ", 
      RowBox[{
       RowBox[{"Max", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"NIntegrate", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"q", "^", "2"}], " ", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"q", "^", "2"}], " ", "+", " ", 
                    RowBox[{"mm", "^", "2"}]}], ")"}], "^", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"-", "3"}], "/", "2"}], ")"}]}]}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"q", ",", " ", "0", ",", " ", "1"}], "}"}], ",", " ", 
                RowBox[{"WorkingPrecision", " ", "->", " ", "40"}]}], "]"}], 
              " ", "-", " ", 
              RowBox[{"jj", "[", "mm", "]"}]}], ",", " ", "40"}], "]"}], 
           "]"}], ",", " ", 
          RowBox[{"{", 
