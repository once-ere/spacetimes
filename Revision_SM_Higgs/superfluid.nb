Cell[TextData[{
 StyleBox["A logarithm.",
  FontWeight->"Bold"],
 " The energy per volume is an integral over the momenta ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["q", "TI"], "<", 
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "31c1e855-d49a-4a79-b18f-b7f563f35e1f"],
 " of functions of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       StyleBox["q", "TI"], "2"], "+", 
      StyleBox["s", "TI"]}], ")"}], 
    RowBox[{"1", "/", "2"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "84bbc206-9b8c-4c94-853e-3899888bb3eb"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["s", "TI"], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["D",
         FontSlant->"Plain"]}]], ")"}], "2"], "+", 
    SubsuperscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a0885288-46e3-404c-9f76-fefaf564c261"],
 ". The next cell integrates the simplest of them exactly and expands the \
result about ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["s", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "41f71e76-b9a9-4838-a44c-8b46b55fa323"],
 ": it contains the term ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "16"], 
    SuperscriptBox[
     StyleBox["s", "TI"], "2"], "\[ThinSpace]", 
    StyleBox["ln",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["s", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7ba93375-55bc-4d6d-b545-f6126550e369"],
 ", which is not analytic at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["s", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "37b8f0bb-c65b-462d-a314-de4aaeeb6901"],
 ", that is, at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"], "2"], "\[LongEqual]", 
    RowBox[{"-", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["M", "TI"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["X", "TI"], ",", 
         StyleBox["D",
          FontSlant->"Plain"]}]], ")"}], "2"]}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "56aae8f2-fdf2-41ee-8c89-bbe2daf530ed"],
 ". Hence ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalV]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0cb1a61b-4de0-468c-a1e3-d13c26b9f413"],
 " is not a polynomial in ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dc68a160-be13-4d48-a518-078e2fc1b0a3"],
 ", and a series of powers of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7662eb03-1d9f-46ce-aebe-4ee092bc0c53"],
 " about the origin can converge only within a radius of the order of the \
Dirac mass (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0.2"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7b29f397-2eee-4792-9135-1d752ccaf6ce"],
 " at the origin), while ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalPhi]", 
     RowBox[{"0", ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]], "\[LongEqual]", "0.31"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9af65d7b-2784-4ba5-bec2-60b41cbc0c4b"],
 " to ",
 Cell[BoxData[
  FormBox["0.40", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "108b1173-7e0e-462f-97d7-7c5d54f198b9"],
 ": the superfluid is far from the regime of Landau's theory, where the order \
parameter is small and the Landau coefficients are Taylor coefficients."
}], "Text",ExpressionUUID->"a9d775ef-0ab6-4039-b0e7-1610062a1b06"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", "integral", " ", "of", " ", 
     RowBox[{"q", "^", "2"}], " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"q", "^", "2"}], " ", "+", " ", "s"}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}]}], " ", "from", " ", "0", " ", "to", " ",
      "the", " ", "cutoff", " ", "lam"}], ",", " ", "exactly", ",", " ", 
    RowBox[{
     RowBox[{"and", " ", "its", " ", "expansion", " ", "about", " ", "s"}], 
     " ", "=", " ", "0"}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"lfq", ":", " ", 
     RowBox[{
     "the", " ", "modulus", " ", "of", " ", "the", " ", "momentum"}]}], ",", 
    " ", 
    RowBox[{"lfs", ":", " ", 
     RowBox[{
      RowBox[{"the", " ", "quantity", " ", 
       RowBox[{"M", "^", "2"}]}], " ", "+", " ", 
      RowBox[{"Phi_a", "^", "2"}]}]}], ",", " ", 
    RowBox[{"lfLam", ":", " ", 
     RowBox[{"the", " ", "cutoff"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"lfInt", " ", "=", " ", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"lfq", "^", "2"}], " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"lfq", "^", "2"}], " ", "+", " ", "lfs"}], "]"}]}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"lfq", ",", " ", "0", ",", " ", "lfLam"}], "}"}], ",", " ", 
       RowBox[{"Assumptions", " ", "->", " ", 
        RowBox[{
         RowBox[{"lfs", " ", ">", " ", "0"}], " ", "&&", " ", 
         RowBox[{"lfLam", " ", ">", " ", "0"}]}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"lfClosed", " ", "=", " ", 
     RowBox[{
      RowBox[{"lfLam", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", " ", 
          RowBox[{"lfLam", "^", "2"}]}], " ", "+", " ", "lfs"}], ")"}], " ", 
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"lfLam", "^", "2"}], " ", "+", " ", "lfs"}], "]"}], "/", 
        "8"}]}], " ", "-", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"lfs", "^", "2"}], "/", "8"}], " ", 
       RowBox[{"Log", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"lfLam", " ", "+", " ", 
           RowBox[{"Sqrt", "[", 
            RowBox[{
             RowBox[{"lfLam", "^", "2"}], " ", "+", " ", "lfs"}], "]"}]}], 
          ")"}], "/", 
         RowBox[{"Sqrt", "[", "lfs", "]"}]}], "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<the integral minus the closed form: \>\"", ",", " ", 
      RowBox[{"FullSimplify", "[", 
       RowBox[{
        RowBox[{"lfInt", " ", "-", " ", "lfClosed"}], ",", " ", 
        RowBox[{"Assumptions", " ", "->", " ", 
         RowBox[{
          RowBox[{"lfs", " ", ">", " ", "0"}], " ", "&&", " ", 
          RowBox[{"lfLam", " ", ">", " ", "0"}]}]}]}], "]"}]}], "]"}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"lfSeries", " ", "=", " ", 
     RowBox[{"Expand", "[", 
      RowBox[{"Normal", "[", 
       RowBox[{"Series", "[", 
        RowBox[{
         RowBox[{"lfClosed", " ", "/.", " ", 
          RowBox[{"lfLam", " ", "->", " ", "1"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"lfs", ",", " ", "0", ",", " ", "2"}], "}"}]}], "]"}], 
       "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<the closed form about s = 0 (cutoff 1), to the order s^2: \
\>\"", ",", " ", "lfSeries"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<its term with the logarithm: \>\"", ",", " ", 
      RowBox[{"Coefficient", "[", 
       RowBox[{"lfSeries", ",", " ", 
        RowBox[{"Log", "[", "lfs", "]"}]}], "]"}], ",", 
      " ", "\"\< Log[s]\>\""}], "]"}], ";"}]}]}]], "Input",
 CellLabel->
  "In[305]:=",ExpressionUUID->"430a3782-8af1-4a8a-8697-152a5eb26142"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"the integral minus the closed form: \"\>", "\[InvisibleSpace]",
    "0"}],
  SequenceForm["the integral minus the closed form: ", 0],
  Editable->False]], "Print",
 CellChangeTimes->{4.004330826253687*^9},
 CellLabel->
  "During evaluation of \
In[305]:=",ExpressionUUID->"62375781-2f1d-4616-8f80-79046147e52b"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"the closed form about s = 0 (cutoff 1), to the order s^2: \
\"\>", "\[InvisibleSpace]", 
   RowBox[{
    FractionBox["1", "4"], "+", 
    FractionBox["lfs", "4"], "+", 
    FractionBox[
     SuperscriptBox["lfs", "2"], "32"], "-", 
    RowBox[{
     FractionBox["1", "8"], " ", 
     SuperscriptBox["lfs", "2"], " ", 
     RowBox[{"Log", "[", "2", "]"}]}], "+", 
    RowBox[{
     FractionBox["1", "16"], " ", 
     SuperscriptBox["lfs", "2"], " ", 
     RowBox[{"Log", "[", "lfs", "]"}]}]}]}],
  SequenceForm[
  "the closed form about s = 0 (cutoff 1), to the order s^2: ", 
   Rational[1, 4] + Rational[1, 4] $CellContext`lfs + 
   Rational[1, 32] $CellContext`lfs^2 + 
   Rational[-1, 8] $CellContext`lfs^2 Log[2] + 
   Rational[1, 16] $CellContext`lfs^2 Log[$CellContext`lfs]],
  Editable->False]], "Print",
 CellChangeTimes->{4.004330826258374*^9},
 CellLabel->
  "During evaluation of \
In[305]:=",ExpressionUUID->"ec0e198b-a67e-4e32-b302-e99d95d449a1"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"its term with the logarithm: \"\>", "\[InvisibleSpace]", 
   FractionBox[
    SuperscriptBox["lfs", "2"], "16"], 
   "\[InvisibleSpace]", "\<\" Log[s]\"\>"}],
  SequenceForm[
  "its term with the logarithm: ", Rational[1, 16] $CellContext`lfs^2, 
   " Log[s]"],
  Editable->False]], "Print",
 CellChangeTimes->{4.004330826260907*^9},
 CellLabel->
  "During evaluation of \
In[305]:=",ExpressionUUID->"09ee96ec-60f1-4b2a-9931-0be5d480a026"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 StyleBox["The Taylor coefficient at the origin.",
  FontWeight->"Bold"],
 " The coefficient ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["Tay",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "faf3cc6b-7a61-42c4-8f7a-adcba48e9147"],
 " of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6be90a8f-f2b0-4ea4-83c8-d884108003eb"],
 " of the Taylor series at the origin is the limit of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalV]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], "/", 
    SuperscriptBox["\[CapitalPhi]", "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "52409279-13cf-4a66-896f-34f102aaeb3e"],
 " at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPhi]", "\[RightArrow]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "211722a5-641c-4805-ab7c-f590aef0ddd2"],
 ". The Rust and the Python program compute it from three states with small \
applied fields (0.004, 0.008, 0.016) and the Richardson elimination of the \
term proportional to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CapitalPhi]", "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ee2bfcd8-3b1e-422d-ba3f-e3cb18b3989b"],
 ". The next cell estimates it from the first six points of the computed \
curve (",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPhi]", "<", "0.1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "51d47dc8-f8f2-4fd0-9f82-477de48f9e5f"],
 ", well inside the radius of convergence) by fitting ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalV]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], "/", 
    SuperscriptBox["\[CapitalPhi]", "2"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["a", "TI"], "0"], "+", 
    SubscriptBox[
     StyleBox["a", "TI"], "1"], 
    SuperscriptBox["\[CapitalPhi]", "2"], "+", 
    SubscriptBox[
     StyleBox["a", "TI"], "2"], 
    SuperscriptBox["\[CapitalPhi]", "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "99b4625c-4a8c-488a-bae4-9c42ef866888"],
 "; the truncation of this local series limits the agreement to about ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", "\[Times]", 
    SuperscriptBox["10", 
     RowBox[{"-", "7"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4a40ccc5-1629-419b-8254-b6d66b6ac4d5"],
 ". The fitted ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a45a548b-049c-413b-abaa-829c35faa522"],
 " of the Landau form differs from ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["Tay",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b83019ae-92f0-40e6-9b99-efdf52f3178d"],
 " by 0.7 to 2 per cent: it is a property of the fit."
}], "Text",ExpressionUUID->"114fbec8-fd1b-441a-b284-72e31e33e92d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"lfTaylor", "[", "t", "]"}], ":", " ", 
    RowBox[{
     RowBox[{"a", "^", "Tay"}], " ", "estimated", " ", "from", " ", "the", " ",
      "points", " ", "2", " ", "to", " ", "7", " ", "of", " ", "the", " ", 
     "curve", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"the", " ", "first", " ", "point", " ", "is", " ", "Phi"}], 
       " ", "=", " ", "0"}], ")"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"lfTaylor", "[", "t_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"p", " ", "=", " ", 
         RowBox[{
          RowBox[{"lfCurve", "[", "t", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"2", " ", ";;", " ", "7"}], "]"}], "]"}]}], "}"}], ",", 
       " ", 
       RowBox[{
        RowBox[{"LeastSquares", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", " ", 
              RowBox[{"x", "^", "2"}], ",", " ", 
              RowBox[{"x", "^", "4"}]}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"x", ",", " ", 
              RowBox[{"p", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], "}"}]}], 
           "]"}], ",", " ", 
          RowBox[{
           RowBox[{"p", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "/", 
           RowBox[{
            RowBox[{"p", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], "^", "2"}]}]}], 
         "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{"\"\<WP3-10 \>\"", " ", "<>", " ", "t"}], ",", " ", 
        RowBox[{
         RowBox[{"lfName", "[", "t", "]"}], " ", "<>", 
         " ", "\"\<: the coefficient of Phi^2 of the Taylor series at the \
origin from the first six points of the curve = the Rust value a^Tay = \>\"", 
         " ", "<>", " ", 
         RowBox[{"ToString", "[", 
          RowBox[{"rustPart3", "[", 
           RowBox[{"\"\<p3_a_taylor_\>\"", " ", "<>", " ", "t"}], "]"}], 
          "]"}], " ", "<>", " ", "\"\< (relative)\>\""}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"lfTaylor", "[", "t", "]"}], " ", "-", " ", 
           RowBox[{"rustPart3", "[", 
            RowBox[{"\"\<p3_a_taylor_\>\"", " ", "<>", " ", "t"}], "]"}]}], 
          "]"}], "/", 
         RowBox[{"Abs", "[", 
          RowBox[{"rustPart3", "[", 
           RowBox[{"\"\<p3_a_taylor_\>\"", " ", "<>", " ", "t"}], "]"}], 
          "]"}]}], ",", " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "6"}]}], ",", " ", 
        RowBox[{"\"\<P3-10 \>\"", " ", "<>", " ", "t"}], ",", " ", 
        RowBox[{"\"\<YP3-10 \>\"", " ", "<>", " ", "t"}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"t", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<HS_1_1\>\"", ",", " ", "\"\<CJT\>\""}], "}"}]}], 
       "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"lfName", "[", "t", "]"}], ",", " ", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{"lfTaylor", "[", "t", "]"}], ",", " ", "10"}], "]"}], ",",
            " ", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{"rustPart3", "[", 
              RowBox[{"\"\<p3_a_taylor_\>\"", " ", "<>", " ", "t"}], "]"}], ",",
              " ", "10"}], "]"}], ",", " ", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"lfResults", "[", "t", "]"}], "[", "\"\<a\>\"", "]"}], ",",
              " ", "10"}], "]"}], ",", " ", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{"100", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"lfResults", "[", "t", "]"}], "[", "\"\<a\>\"", 
                  "]"}], "/", 
                 RowBox[{"rustPart3", "[", 
                  RowBox[{"\"\<p3_a_taylor_\>\"", " ", "<>", " ", "t"}], 
                  "]"}]}], " ", "-", " ", "1"}], ")"}]}], ",", " ", "3"}], 
            "]"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"t", ",", " ", "lfTags"}], "}"}]}], "]"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<method\>\"", ",", " ", "\"\<a^Tay from the curve\>\"", ",",
          " ", "\"\<a^Tay of the Rust program\>\"", ",", 
         " ", "\"\<a of the Landau form\>\"", ",", 
         " ", "\"\<a/a^Tay - 1 (per cent)\>\""}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "All"}]}], "]"}]}]}]], "Input",
 CellLabel->
  "In[311]:=",ExpressionUUID->"603c48d4-61d5-42fd-958d-df849a77bfdd"],

