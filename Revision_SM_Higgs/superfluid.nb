           "]"}], " ", "<=", " ", "50"}]}], " ", "&"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dev5", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"dps", "[", 
            RowBox[{"num", "[", 
             RowBox[{"r", "[", 
              RowBox[{"[", 
               RowBox[{"col", "[", 
                RowBox[{"shdr", ",", " ", "\"\<t\>\""}], "]"}], "]"}], "]"}], 
             "]"}], "]"}], " ", "-", " ", 
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"num", "[", 
              RowBox[{"r", "[", 
