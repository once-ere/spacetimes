                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{
                    "--", " ", 
                    "WQN"}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}\
]}]}]}]}]}]}], "-", "9"}], ":", " ", 
     RowBox[{"the", " ", "invariants"}]}], ",", " ", "infinitesimally"}], " ",
    "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"the", " ", "pairing", " ", "term", " ", "tr", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"M", "^", "dag"}], " ", "M"}], ")"}], " ", "is", " ", 
      "invariant", " ", "when", " ", "the", " ", "generators", " ", "on", " ",
       "the", " ", "components", " ", "are", " ", "Hermitian"}], ";", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
       "the", " ", "change", " ", "of", "\n", "   ", "det", " ", "M", " ", 
        "under", " ", "m"}], " ", "->", " ", 
       RowBox[{"m", " ", "+", " ", 
        RowBox[{
        "i", " ", "eps", " ", "G", " ", "m", " ", "is", " ", "i", " ", "eps", 
         " ", "q", " ", "det", " ", "M", " ", "with", " ", "q"}]}]}], " ", "=",
       " ", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"grad", " ", "det"}], ")"}], ".", 
        RowBox[{"(", 
         RowBox[{"G", " ", "m"}], ")"}]}], " ", "/", " ", 
       RowBox[{"det", ":", " ", 
        RowBox[{"0", " ", "for", " ", 
         RowBox[{"T", "^", "a"}]}]}]}]}]}], ",", " ", 
    RowBox[{"T", "^", "a_R"}], ",", " ", 
    RowBox[{"R", " ", "and", " ", "Y"}], ",", " ", 
    RowBox[{"4", " ", "for", "\n", "   ", "F_tot"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"mm", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"m1", ",", " ", "m2", ",", " ", "m3", ",", " ", "m4"}], "}"}]}],
     ";", " ", 
    RowBox[{"detM", " ", "=", " ", 
     RowBox[{
      RowBox[{"m1", " ", "m4"}], " ", "-", " ", 
      RowBox[{"m2", " ", "m3"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"charge", "[", "g_", "]"}], " ", ":=", " ", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"detM", ",", " ", 
           RowBox[{"{", "mm", "}"}]}], "]"}], ".", 
         RowBox[{"(", 
          RowBox[{"g", ".", "mm"}], ")"}]}], ")"}], "/", "detM"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"okH", " ", "=", " ", 
     RowBox[{"And", " ", "@@", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"#", " ", "==", " ", 
          RowBox[{"ConjugateTranspose", "[", "#", "]"}]}], " ", "&"}], " ", "/@",
         " ", 
        RowBox[{"Join", "[", 
         RowBox[{"hg", ",", " ", "hg2", ",", " ", "bg"}], "]"}]}], ")"}]}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"qdet", " ", "=", " ", 
     RowBox[{"charge", " ", "/@", " ", 
      RowBox[{"bg", "[", 
       RowBox[{"[", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", 
          RowBox[{"iTR", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
          RowBox[{"iTR", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
          RowBox[{"iTR", "[", 
           RowBox[{"[", "3", "]"}], "]"}], ",", " ", "iR", ",", " ", "iY", ",",
           " ", "iF"}], "}"}], "]"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rvCheck", "[", 
     RowBox[{"\"\<WQN-9\>\"", ",", 
      " ", "\"\<the generators on Phi_SH, Phi'_SH and M_SH are Hermitian, so \
the pairing term (4.2) is invariant; det M_SH \\\nhas the charges 0 under \
T^a, T^a_R, R and Y and 4 under F_tot (the determinant term breaks only \
U(1)_F_tot)\>\"", ",", "\n", "  ", 
      RowBox[{"okH", " ", "&&", " ", 
       RowBox[{"qdet", " ", "==", " ", 
        RowBox[{"{", 
         RowBox[{
         "0", ",", " ", "0", ",", " ", "0", ",", " ", "0", ",", " ", "0", ",",
           " ", "0", ",", " ", "0", ",", " ", "0", ",", " ", "4"}], "}"}]}]}],
       ",", " ", 
      RowBox[{"\"\<charges of det M_SH \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", "qdet", "]"}]}]}], "]"}], ";"}]}]}]], "Input",\

 CellLabel->
  "In[497]:=",ExpressionUUID->"0d8de95a-83c8-4cf9-abce-dc6e4f5b2a2d"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"PASS \"\>", "\[InvisibleSpace]", "\<\"WQN-9\"\>", 
   "\[InvisibleSpace]", "\<\"  \"\>", 
   "\[InvisibleSpace]", "\<\"the generators on Phi_SH, Phi'_SH and M_SH are \
Hermitian, so the pairing term (4.2) is invariant; det M_SH has the charges 0 \
under T^a, T^a_R, R and Y and 4 under F_tot (the determinant term breaks only \
U(1)_F_tot)\"\>", "\[InvisibleSpace]", "\<\" [\"\>", 
   "\[InvisibleSpace]", "\<\"charges of det M_SH {0, 0, 0, 0, 0, 0, 0, 0, \
4}\"\>", "\[InvisibleSpace]", "\<\"]   [the same check: Rust \"\>", 
   "\[InvisibleSpace]", "\<\"QN-9a to QN-9d\"\>", 
   "\[InvisibleSpace]", "\<\", Python \"\>", 
   "\[InvisibleSpace]", "\<\"YQN-9a, YQN-9b\"\>", 
   "\[InvisibleSpace]", "\<\"]\"\>"}],
  SequenceForm[
  "PASS ", "WQN-9", "  ", 
   "the generators on Phi_SH, Phi'_SH and M_SH are Hermitian, so the pairing \
term (4.2) is invariant; det M_SH has the charges 0 under T^a, T^a_R, R and Y \
and 4 under F_tot (the determinant term breaks only U(1)_F_tot)", " [", 
   "charges of det M_SH {0, 0, 0, 0, 0, 0, 0, 0, 4}", 
   "]   [the same check: Rust ", "QN-9a to QN-9d", ", Python ", 
   "YQN-9a, YQN-9b", "]"],
  Editable->False]], "Print",
 CellChangeTimes->{4.0043309384481993`*^9},
 CellLabel->
  "During evaluation of \
In[497]:=",ExpressionUUID->"6275238f-943f-4e4c-ac6e-cce3a30c1395"]
