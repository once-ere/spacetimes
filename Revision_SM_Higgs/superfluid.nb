Cell[TextData[{
 StyleBox["Is the order parameter smaller and more physically reasonable?",
  FontWeight->"Bold"],
 " Yes, near the critical temperature, and only there, for the mean-field \
free energy of the methods (Section III.G shows that these temperatures lie \
inside the critical region of the transition, where the fluctuations that the \
methods omit dominate)."
}], "Text",ExpressionUUID->"bee2b361-0be1-4981-af3b-83743df4093f"],

Cell[TextData[{
 StyleBox["It is smaller.",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalPhi]", 
     RowBox[{"0", ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8a1df5ae-5a14-4fa8-a8ca-c10a70a945e9"],
 " keeps its value of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bb396a77-a3f6-4d58-8e20-1e2d53c7bf16"],
 " up to about ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.3", "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "57efdcf5-c147-4a0d-bb88-74f6a7082c7c"],
 " (the gap is much larger than these temperatures, and thermal \
quasi-particles are exponentially rare), then falls and vanishes continuously \
at ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "91d05e3b-0526-4e77-8908-7ee1920060ac"],
 ", like ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "-", 
      StyleBox["T", "TI"], "/", 
      SubsuperscriptBox[
       StyleBox["T", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["c",
         FontSlant->"Plain"]}]]}], ")"}], 
    RowBox[{"1", "/", "2"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "647d7fdf-182c-40d0-a010-f78a6e9c9613"],
 " (the table and the figure above)."
}], "ItemNumbered",ExpressionUUID->"061f7366-d617-4a07-a40e-92491b76d8ff"],

Cell[TextData[{
 StyleBox["It lies inside the radius of convergence.",
  FontWeight->"Bold"],
 " At ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d694af32-c992-4718-a5b9-14738692ca8f"],
 " the order parameter is 1.5 to 2 times the radius, which is then the mass \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "776b9b84-17bc-47a5-ae09-afb9537bf547"],
 "; above the reduced temperature of the table (0.35 to 0.42) it is smaller \
than the radius, and near ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "49e28a9a-6e4a-48e7-ae0d-4832b39ec419"],
 " much smaller. There the series of the free energy in powers of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "73443c2a-ce6b-4341-9b2f-553cb7b7dabb"],
 " converges at the minimum, and the Landau coefficients are the Taylor \
coefficients of the free energy: the regime of Landau's theory, which Section \
III.L found absent at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8cec84d0-a5d9-455b-a547-abc033418cc7"],
 "."
}], "ItemNumbered",ExpressionUUID->"abc63c6d-b3d9-4178-9e13-4bbf36fa0c9c"],

Cell[TextData[{
 StyleBox["The Landau form becomes exact.",
  FontWeight->"Bold"],
 " The residual of the Landau form falls from a few tenths of a per cent of \
the depth at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4a00fde1-2fdf-4c35-a289-5b9db3a16485"],
 " to about ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "3"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6160fc29-69e7-4c89-83f2-9c0644aa528b"],
 " per cent at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.98", "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d8c6515f-ef15-409e-aff7-9ce658b6b1d5"],
 ", and that of the quartic form (the form of the Higgs potential of the \
Standard Model and of the theory of Ginzburg and Landau) from 3 to 6 per cent \
to about 0.3 per cent; near ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5208e730-eee8-4db2-913a-30f10ca9178a"],
 " it falls in proportion to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "-", 
    StyleBox["T", "TI"], "/", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6b544bb6-9efc-494f-962a-228cb1a09fa3"],
 "."
}], "ItemNumbered",ExpressionUUID->"a8a50be9-31c2-4562-969e-b5d294af7167"],

Cell[TextData[{
 StyleBox["Landau's theory predicts the order parameter.",
  FontWeight->"Bold"],
 " Near ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "999e2cbd-e5ba-4ce6-a45f-153010bc225d"],
 " the error of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       StyleBox["a", "TI"]}], "/", "2", 
      StyleBox["b", "TI"]}], ")"}], 
    RowBox[{"1", "/", "2"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "02368eeb-3a5d-4b1e-bcf1-76cb7254b9d2"],
 " is a fraction (0.19 to 0.28 in the Rust table) of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "-", 
    StyleBox["T", "TI"], "/", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9b28202d-99fb-48ec-b2b2-578e951f1e38"],
 ", as Landau's theory requires; the cell above computes it for CJT at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.9", "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["CJT",
       FontSlant->"Plain"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4043d6fa-7846-4510-880a-097904ad5f2e"],
 "."
}], "ItemNumbered",ExpressionUUID->"32485b05-42a3-4fc7-854b-1f068502f118"],

Cell[TextData[{
 StyleBox["The scales.",
  FontWeight->"Bold"],
 " Near ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a1dcc0be-d563-4cd3-970e-ab900af52e95"],
 " the order parameter is small also against the Dirac mass and the cutoff. \
The critical temperatures themselves are about a fifth to a quarter of the \
cutoff (the table above), and the states at the cutoff are occupied by 0.8 to \
1.8 per cent at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.98", "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b61131fd-9f9b-408a-b172-912e21db199e"],
 ", so the thermal physics reaches the cutoff only weakly. The ratio of the \
gap at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "897f7c7e-8cb1-4e35-ba8a-ca14dbae808b"],
 " to ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4f42943a-3049-4d33-8838-227e84724304"],
 " is 1.65 to 1.74; the theory of Bardeen, Cooper and Schrieffer gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Pi]", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      SubscriptBox["\[Gamma]", 
       StyleBox["E",
        FontSlant->"Plain"]]}]], "\[LongEqual]", "1.764"}], TraditionalForm]],
   "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d5b30c4f-9eaf-4d27-bd2e-0cb179270fe1"],
 " (with Euler's constant ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", 
     StyleBox["E",
      FontSlant->"Plain"]], "\[LongEqual]", "0.5772"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1c108d50-4ae0-4cbe-928a-a3e76162dd3c"],
 ") for weak pairing at a Fermi surface. The ratios are of the same size but \
not equal: here there is no Fermi surface (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Mu]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3119ad5b-456b-4d0e-9a96-c527254ccea1"],
 "), the pairing needs a coupling above a critical one, and the gap contains \
the Dirac mass."
}], "ItemNumbered",ExpressionUUID->"bf568d5a-cae3-462f-b677-83a08c28c4ae"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
III.T.7 What the free energy of these methods does not contain, and why it \
matters\
\>", "Section",ExpressionUUID->"967e9cda-c35d-4af3-8bc7-18408e5fc8c6"],

Cell[TextData[{
 StyleBox["The remark.",
  FontWeight->"Bold"],
 " All three methods give mean-field free energies: the thermal state is \
quasi-free, so the free energy contains the thermal quasi-particles of the \
spinor field, but neither the thermal fluctuations of the order parameter \
about its mean value (its amplitude, Goldstone and non-unitary modes) nor \
thermal gauge fields. ",
 StyleBox["Why it holds.",
  FontWeight->"Bold"],
 " A quasi-free state is a state whose correlations of four and more fields \
are fixed by its correlations of two fields (Wick's theorem); the three \
methods choose the best such state, and a fluctuation of the order parameter \
is a correlation of two pairs beyond the product of the pair densities. In HS \
the integral over the auxiliary fields is replaced by its saddle point, in \
CJT the effective action is truncated at the contractions of the contact \
terms in pairs, and in KS the exchange-correlation energy has no thermal part."
}], "Text",ExpressionUUID->"66b2fc5b-d3fa-4fcb-a0c5-827eff732e30"],

Cell[TextData[{
 StyleBox["Why it matters.",
  FontWeight->"Bold"],
 " Near a continuous transition the fluctuations of the order parameter grow \
without bound. Their size relative to the order parameter is measured by the \
Ginzburg number of the transition (A. P. Levanyuk 1959, V. L. Ginzburg 1960): \
the mean-field free energy is accurate where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "-", 
    StyleBox["T", "TI"], "/", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f32c008f-1235-4732-8472-d6294061f8e0"],
 " is much larger than the Ginzburg number, and it fails within the critical \
region, where it is smaller. For a free energy of the form of Ginzburg and \
Landau in three dimensions, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", 
     StyleBox["GL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      RowBox[{"\[Del]", 
       SubscriptBox["\[Psi]", 
        StyleBox["GL",
         FontSlant->"Plain"]]}], "\[RightBracketingBar]"}], "2"], "+", 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["GL",
      FontSlant->"Plain"], "\[Prime]"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["T", "TI"], "/", 
      SubscriptBox[
       StyleBox["T", "TI"], 
       StyleBox["c",
        FontSlant->"Plain"]], "-", "1"}], ")"}], 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      SubscriptBox["\[Psi]", 
       StyleBox["GL",
        FontSlant->"Plain"]], "\[RightBracketingBar]"}], "2"], "+", 
    FractionBox["1", "2"], 
    SubscriptBox["\[Beta]", 
     StyleBox["GL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      SubscriptBox["\[Psi]", 
       StyleBox["GL",
        FontSlant->"Plain"]], "\[RightBracketingBar]"}], "4"]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f15a084d-4b33-42b6-9655-2a9fd324b8a1"],
 " (the example of Section III.L.2 with the gradient coefficient ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", 
    StyleBox["GL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8d7fcbd0-efe1-40d5-ad1d-af2dfd9727bf"],
 ", the slope ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Alpha]", 
    StyleBox["GL",
     FontSlant->"Plain"], "\[Prime]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4031caee-064c-4f4b-8911-53db48560a95"],
 " and the critical temperature ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["c",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b9e9bee5-4965-418c-9442-031dc26fd60c"],
 "), the Ginzburg number is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["c",
      FontSlant->"Plain"], "2"], 
    SubsuperscriptBox["\[Beta]", 
     StyleBox["GL",
      FontSlant->"Plain"], "2"], "/", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["\[Alpha]", 
       StyleBox["GL",
        FontSlant->"Plain"], "\[Prime]"], 
      SubsuperscriptBox["\[Gamma]", 
       StyleBox["GL",
        FontSlant->"Plain"], "3"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "41d0f21e-f87b-420c-994a-2bfcac14c90f"],
 " up to a numerical factor that depends on the conventions. Within the \
critical region the order parameter vanishes with an exponent different from ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ebe75181-289e-4d84-8777-29eb5587b3a7"],
 " (in three dimensions near 0.33 to 0.37 for the Ising, XY and Heisenberg \
universality classes), the critical temperature is in general lower than the \
mean-field one, and for an order parameter with two quartic invariants, as \
here, the fluctuations can also make the transition discontinuous (the \
renormalization-group theory of such fields is reviewed by A. Pelissetto and \
E. Vicari, 2002). A gauge field coupled to the order parameter can do the \
same: its fluctuations make the transition of a superconductor weakly first \
order (B. I. Halperin, T. C. Lubensky and S.-k. Ma, 1974), and the thermal \
transition of the Higgs field of the electroweak theory, of first order for \
small Higgs masses, ends at a critical Higgs mass, above which there is no \
transition but a smooth crossover (lattice simulations of K. Kajantie, M. \
Laine, K. Rummukainen and M. Shaposhnikov, 1996). The answer of Section \
III.T.6 therefore describes the superfluid near ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fd56bd0b-334d-4569-a3fd-0a6b9b29b3dd"],
 " only outside the critical region, and whether the transition of the full \
theory is continuous is not decided here. The size of the critical region \
needs the gradient coefficient of the field at ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "77d59acf-fb5d-42a2-b955-65f329a4b678"],
 ", which Section III.G computes: the Ginzburg number is 7.6 to 11.4, so that \
the whole range of temperatures of Section III.T.6 where the free energy \
behaves as Landau's theory lies inside the critical region. At ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c3894413-b82e-4908-bcb0-23eff65d1991"],
 " the methods omit the quantum fluctuations of the order parameter as well; \
that is a property of the methods, not the subject of this remark."
}], "Text",ExpressionUUID->"4481a700-63e2-49e1-84fa-96ffa04d5114"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Part III, third section. The width of the critical region, and the superfluid \
as a Higgs sector\
\>", "Chapter",ExpressionUUID->"70e0c1fd-8ba0-4399-b4a5-a85cfa8558e8"],

Cell[TextData[{
 "On 21 November 2026 the author asked to find how wide the region of the \
fluctuations near the critical temperature is, which needs one more \
calculation, the gradient coefficient of the field at the critical \
temperature; then to determine for each of the five methods ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b8c2b659-84f6-4a84-9b1f-b9618d8ab4f5"],
 " (HS ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"1", ",", "1"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2f0996e3-38ed-4e3f-8940-ef1d6b0d38d1"],
 ", HS ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "1"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0758d911-2b2f-4a1c-93ae-051d6ad6b33a"],
 ", HS ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "0"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "46dd1232-459f-4d94-96a4-4ddc4e8e93bd"],
 ", KS and CJT) whether the superfluid can play the role of the Higgs \
particle, and whether the Higgs is really a composite particle. This chapter \
does both with the engines of Part II and of Section III.T, and repeats the \
checks of the Rust program ",
 StyleBox["sf_part3",
  FontFamily->"Source Code Pro"],
 " (modules ",
 StyleBox["ginzburg",
  FontFamily->"Source Code Pro"],
 " and ",
 StyleBox["higgs",
  FontFamily->"Source Code Pro"],
 ") and of the Python program ",
 StyleBox["sf_part3.py",
  FontFamily->"Source Code Pro"],
 ". ",
 StyleBox["The answers.",
  FontWeight->"Bold"],
 " The Ginzburg number is 7.6 to 11.4 (Section III.G.7): the critical region \
is wider than the critical temperature itself, so the mean-field description \
of the five methods holds nowhere near the transition. Every method realizes \
the Higgs mechanism and has a composite neutral scalar below the threshold of \
two quasi-particles, but in no method can it be the Higgs boson that is \
observed (Section III.G.8). Within this model the Higgs field is composite by \
construction."
}], "Text",ExpressionUUID->"815d8241-d6b3-4fc7-a32d-cf1da1e7e83e"],

Cell[CellGroupData[{

Cell["\<\
III.G.1 The free energy of Ginzburg and Landau and the Ginzburg number\
\>", "Section",ExpressionUUID->"5c84f448-e813-4cba-8431-d04e61c645a6"],

Cell[TextData[{
 StyleBox["Units.",
  FontWeight->"Bold"],
 " As in Section III.T: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["k", "TI"], 
     StyleBox["B",
      FontSlant->"Plain"]], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "81f18242-81b3-4610-b703-09629e0ee01f"],
 ", the cutoff ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "09eaa618-d8d6-4d70-9cf4-6894c99386a6"],
 ", the chemical potential zero. ",
 StyleBox["The field.",
  FontWeight->"Bold"],
 " The field of the superfluid is the complex isospin vector ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["\[CapitalPhi]", "1"], ",", 
      SuperscriptBox["\[CapitalPhi]", "2"], ",", 
      SuperscriptBox["\[CapitalPhi]", "3"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9828225b-1795-4747-aee3-99dcc0e118d7"],
 " of the components of the pair self-energy along ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], "\[Iota]"], ")"}], "\[Dagger]"], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "abf789cc-6e83-4bbf-b5e3-4f42713c9c9f"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[CapitalPhi]", "\[Iota]"], "\[LongEqual]", 
    StyleBox["tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "\[Iota]"], 
      SubscriptBox[
       StyleBox["P",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["SF",
        FontSlant->"Plain"]]}], ")"}], "/", "8"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8657ebad-61a7-432c-b732-219de5faa225"],
 "; it has ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], "\[CapitalPhi]"], "\[LongEqual]", "6"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "06be16bf-a101-4fa7-9d72-501fcfb59eb3"],
 " real components, and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
      "\[RightBracketingBar]"}], "2"], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", "\[Iota]",
     LimitsPositioning->True], 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      SuperscriptBox["\[CapitalPhi]", "\[Iota]"], "\[RightBracketingBar]"}], 
     "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dbe7c928-a9a7-4a2e-9426-50e678cc121a"],
 ". ",
 StyleBox["The form of Ginzburg and Landau.",
  FontWeight->"Bold"],
 " Near the critical temperature ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f99ec9cc-1c39-4c9b-8b75-fe0377d15125"],
 " the field is small. For a static field that varies slowly in space, the \
free energy of method ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6bd96504-d814-4d38-a263-1c6dcf1de351"],
 " to second order in the field and in its derivatives and to fourth order in \
the field is"
}], "Text",ExpressionUUID->"2b83ec32-767c-478e-8ca2-fccdea2b59ed"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalF]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["GL",
      FontSlant->"Plain"]}]], 
   RowBox[{"[", 
    OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "]"}], "\[LongEqual]", "\[Integral]",
    "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["d", "TI"], "3"], 
   StyleBox["x", "TI"], 
   RowBox[{"[", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["c",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      StyleBox["X", "TI"]], "\[ThinSpace]", 
     UnderoverscriptBox["\[Sum]", 
      RowBox[{
       StyleBox["j", "TI"], "\[LongEqual]", "1"}], "3",
      LimitsPositioning->True], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[PartialD]", 
         StyleBox["j", "TI"]], 
        OverscriptBox["\[CapitalPhi]", "\[RightVector]"]}], ")"}], 
      "\[Dagger]"], "\[CenterDot]", 
     SubscriptBox["\[PartialD]", 
      StyleBox["j", "TI"]], 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "+", 
     SubsuperscriptBox[
      StyleBox["a", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["X", "TI"], ",", 
       StyleBox["Tay",
        FontSlant->"Plain"]}]], 
     RowBox[{"(", 
      StyleBox["T", "TI"], ")"}], "\[ThinSpace]", 
     SuperscriptBox[
      RowBox[{"\[LeftBracketingBar]", 
       OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
       "\[RightBracketingBar]"}], "2"], "+", 
     SubsuperscriptBox[
      StyleBox["b", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["X", "TI"], ",", 
       StyleBox["Tay",
        FontSlant->"Plain"]}]], 
     RowBox[{"(", 
      StyleBox["T", "TI"], ")"}], "\[ThinSpace]", 
     SuperscriptBox[
      RowBox[{"\[LeftBracketingBar]", 
       OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
       "\[RightBracketingBar]"}], "4"]}], "]"}], ","}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"c66704a0-f5b9-4fc3-be37-bfeb301f3f4c"],

Cell[TextData[{
 "with the Taylor coefficients ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["Tay",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6a943808-b67a-4581-8880-79c000203e8a"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["b", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["Tay",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a585c235-a5ea-42de-b8e7-4fa3029ff3e0"],
 " of the free energy at the origin (Section III.T.6), ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["Tay",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}], "\[TildeTilde]", 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["GL",
       FontSlant->"Plain"]}]], 
    SubsuperscriptBox[
     StyleBox["t", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["red",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2f21717f-807f-46d7-a5bd-c0df9ac9ad8d"],
 " near ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "02afa2a0-7c29-4433-93f3-b4b68c5cd0f0"],
 ", the reduced temperature ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["t", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["red",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["T", "TI"], "-", 
      SubsuperscriptBox[
       StyleBox["T", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["c",
         FontSlant->"Plain"]}]]}], ")"}], "/", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6ce6b9c9-a40c-4838-a077-80c6d973e675"],
 ", the slope ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["GL",
       FontSlant->"Plain"]}]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]], "\[ThinSpace]", 
    SubscriptBox["\[PartialD]", 
     StyleBox["T", "TI"]], 
    SubsuperscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["Tay",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7fb757ee-7670-4ad6-8ab1-b13bba23dfa2"],
 " at ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d735ae75-32af-4bb2-9d9e-a7b22687d226"],
 ", and the ",
 StyleBox["gradient coefficient",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["c",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "eb5c7031-8b87-423a-b120-d83166abd3b7"],
 " at ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "00b5e0a4-577e-434c-b5a3-08439f308fed"],
 ". The rotations and the isospin rotations allow no other term of second \
order, and a term with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "\[CenterDot]", 
    OverscriptBox["\[CapitalPhi]", "\[RightVector]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3eefac6e-a219-4ac3-838d-0fec5edc91ad"],
 " has the fermion number 4 and is not invariant under ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["U", "TI"], 
    SubsuperscriptBox[
     RowBox[{"(", "1", ")"}], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d15f4750-f534-493a-ba9e-b003c97e096e"],
 ". Of the two quartic invariants ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}], "4"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e8e78d10-d144-4193-8303-80c614561da8"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     RowBox[{
      OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "\[CenterDot]", 
      OverscriptBox["\[CapitalPhi]", "\[RightVector]"]}], 
     "\[RightBracketingBar]"}], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4acc9fd6-abee-406a-bc2d-5acd2eed6e1a"],
 ", which are equal on the polar fields of the minimum, the form keeps the \
coefficient along these fields. ",
 StyleBox["The Ginzburg number.",
  FontWeight->"Bold"],
 " Above ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6386c313-d4d3-4985-a7e4-9e669be89516"],
 " the field fluctuates about zero with the probability density proportional \
to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["exp",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       SubsuperscriptBox[
        StyleBox["\[ScriptCapitalF]",
         FontSlant->"Plain"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["X", "TI"], ",", 
         StyleBox["GL",
          FontSlant->"Plain"]}]]}], "/", 
      StyleBox["T", "TI"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "57361e9e-d116-4807-a8ee-c4a4fe134afe"],
 ". To second order the fluctuations are Gaussian, and their free energy per \
volume is, up to terms analytic in ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "81b51525-50de-41ef-ac9e-1e365aaf7077"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], 
    SubsuperscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], "\[CapitalPhi]"], 
    StyleBox["T", "TI"], "\[ThinSpace]", "\[Integral]", "\[ThinSpace]", 
    FractionBox[
     RowBox[{
      SuperscriptBox[
       StyleBox["d", "TI"], "3"], 
      StyleBox["k", "TI"]}], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"2", "\[Pi]"}], ")"}], "3"]], "\[ThinSpace]", 
    StyleBox["ln",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["c",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["X", "TI"]], 
      SuperscriptBox[
       StyleBox["k", "TI"], "2"], "+", 
      SubsuperscriptBox[
       StyleBox["a", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["Tay",
         FontSlant->"Plain"]}]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3b6a224d-f74c-4227-88bf-084e03b25474"],
 ". With ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Integral]", "\[ThinSpace]", 
    FractionBox[
     RowBox[{
      SuperscriptBox[
       StyleBox["d", "TI"], "3"], 
      StyleBox["k", "TI"]}], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"2", "\[Pi]"}], ")"}], "3"]], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       StyleBox["c",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       SuperscriptBox[
        StyleBox["k", "TI"], "2"], "+", 
       StyleBox["a", "TI"]}], ")"}], 
     RowBox[{"-", "2"}]], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"8", "\[Pi]", 
       SuperscriptBox[
        StyleBox["c",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        RowBox[{"3", "/", "2"}]], 
       SuperscriptBox[
        StyleBox["a", "TI"], 
        RowBox[{"1", "/", "2"}]]}], ")"}], 
     RowBox[{"-", "1"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f44ce9c7-6094-484b-82a2-8a8f8f872915"],
 " its specific heat per volume, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["C", "TI"], "\[LongEqual]", 
    RowBox[{"-", 
     StyleBox["T", "TI"]}], 
    SubsuperscriptBox["\[PartialD]", 
     StyleBox["T", "TI"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9ae69ecb-464c-44f6-9e23-40801cf12398"],
 " of the free energy, is near ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2a6f8bd6-00eb-43d9-a3ae-4a0d035310ac"]
}], "Text",ExpressionUUID->"bd4d7a37-80a9-4cf8-ab3f-4a284078fcf7"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["C", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["fl",
      FontSlant->"Plain"]}]], "\[LongEqual]", 
   FractionBox[
    RowBox[{
     SubsuperscriptBox[
      StyleBox["n", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], "\[CapitalPhi]"], "\[ThinSpace]", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox["\[Alpha]", 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["X", "TI"], ",", 
         StyleBox["GL",
          FontSlant->"Plain"]}]], ")"}], 
      RowBox[{"3", "/", "2"}]]}], 
    RowBox[{"16", "\[Pi]", "\[ThinSpace]", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["c",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        StyleBox["X", "TI"]], ")"}], 
      RowBox[{"3", "/", "2"}]], "\[ThinSpace]", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["t", "TI"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        StyleBox["red",
         FontSlant->"Plain"]], ")"}], 
      RowBox[{"1", "/", "2"}]]}]], ",", "      ", "\[CapitalDelta]", 
   SubsuperscriptBox[
    StyleBox["C", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], "\[LongEqual]", 
   FractionBox[
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[Alpha]", 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["GL",
         FontSlant->"Plain"]}]], ")"}], "2"], 
    RowBox[{"2", "\[ThinSpace]", 
     SubsuperscriptBox[
      StyleBox["b", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["X", "TI"], ",", 
       StyleBox["Tay",
        FontSlant->"Plain"]}]], "\[ThinSpace]", 
     SubsuperscriptBox[
      StyleBox["T", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["X", "TI"], ",", 
       StyleBox["c",
        FontSlant->"Plain"]}]]}]], ","}], TraditionalForm]], "DisplayFormula",\

 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"7dcb7970-a619-4f5e-8921-f833f67d1c5b"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", 
    SubsuperscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "88d7a555-2776-447f-8120-50025b416f6a"],
 " is the jump of the specific heat of mean-field theory at ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "695a8089-86e3-4de2-a15c-91a5e8e77c0f"],
 " (below it the minimum of the form is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
      "\[RightBracketingBar]"}], "2"], "\[LongEqual]", 
    RowBox[{"-", 
     StyleBox["a", "TI"]}], "/", 
    RowBox[{"(", 
     RowBox[{"2", 
      StyleBox["b", "TI"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "79bbcf0d-9926-4fb0-af8f-3babd5e474a1"],
 " with the free energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     SuperscriptBox[
      StyleBox["a", "TI"], "2"]}], "/", 
    RowBox[{"(", 
     RowBox[{"4", 
      StyleBox["b", "TI"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cc6ca4e8-88fa-425a-b30b-aaec6ab251b0"],
 " per volume). Mean-field theory holds where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["fl",
       FontSlant->"Plain"]}]], "\[LessLess]", "\[CapitalDelta]", 
    SubsuperscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "56cc7f06-f29b-48d3-85f7-ff2671037089"],
 ". The two are equal at the ",
 StyleBox["Ginzburg number",
  FontWeight->"Bold"],
 " (A. P. Levanyuk 1959, V. L. Ginzburg 1960)"
}], "Text",ExpressionUUID->"93a0e1fa-57df-48cd-8e88-2e38e9aee61c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["Gi",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], "\[LongEqual]", 
   FractionBox[
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["n", "TI"], 
        StyleBox["SF",
         FontSlant->"Plain"], "\[CapitalPhi]"], ")"}], "2"], "\[ThinSpace]", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["b", "TI"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["X", "TI"], ",", 
         StyleBox["Tay",
          FontSlant->"Plain"]}]], ")"}], "2"], "\[ThinSpace]", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["T", "TI"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["X", "TI"], ",", 
         StyleBox["c",
          FontSlant->"Plain"]}]], ")"}], "2"]}], 
    RowBox[{"64", 
     SuperscriptBox["\[Pi]", "2"], "\[ThinSpace]", 
     SubsuperscriptBox["\[Alpha]", 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["X", "TI"], ",", 
       StyleBox["GL",
        FontSlant->"Plain"]}]], "\[ThinSpace]", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["c",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        StyleBox["X", "TI"]], ")"}], "3"]}]], "\[LongEqual]", 
   FractionBox[
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["n", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], "\[CapitalPhi]"], ")"}], "2"], 
    RowBox[{"256", 
     SuperscriptBox["\[Pi]", "2"], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"\[CapitalDelta]", 
        SubsuperscriptBox[
         StyleBox["C", "TI"], 
         StyleBox["SF",
          FontSlant->"Plain"], 
         StyleBox["X", "TI"]], 
        SuperscriptBox[
         RowBox[{"(", 
          SubsuperscriptBox["\[Xi]", 
           StyleBox["SF",
            FontSlant->"Plain"], 
           RowBox[{
            StyleBox["X", "TI"], ",", 
            StyleBox["GL",
             FontSlant->"Plain"]}]], ")"}], "3"]}], ")"}], "2"]}]], ",", 
   "      ", 
   SubsuperscriptBox["\[Xi]", 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["GL",
      FontSlant->"Plain"]}]], "\[LongEqual]", 
   SuperscriptBox[
    RowBox[{"(", 
     FractionBox[
      SubsuperscriptBox[
       StyleBox["c",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["X", "TI"]], 
      SubsuperscriptBox["\[Alpha]", 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["GL",
         FontSlant->"Plain"]}]]], ")"}], 
    RowBox[{"1", "/", "2"}]], "."}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"051fc092-d19e-491a-81c2-e91172b52329"],

Cell[TextData[{
 "Mean-field theory holds for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftBracketingBar]", 
     SubsuperscriptBox[
      StyleBox["t", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      StyleBox["red",
       FontSlant->"Plain"]], "\[RightBracketingBar]"}], "\[GreaterGreater]", 
    SubsuperscriptBox[
     StyleBox["Gi",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9da43217-b97d-49e5-a57e-293e2581d99d"],
 ", and the critical region, where it fails, has the width of about ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["Gi",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bfd015ed-64a2-4743-87d5-ce0548a90251"],
 " on both sides of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "37fcb6f8-0b98-4cc4-baaa-fb6392656f49"],
 ". The second form shows the meaning: the correlation length of mean-field \
theory is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Xi]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["GL",
       FontSlant->"Plain"]}]], 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      SubsuperscriptBox[
       StyleBox["t", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["red",
        FontSlant->"Plain"]], "\[RightBracketingBar]"}], 
     RowBox[{
      RowBox[{"-", "1"}], "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "94eae1a0-2bc7-44bc-9c8a-120c2c7d7193"],
 ", and mean-field theory needs many degrees of freedom in a correlation \
volume, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", 
    SubsuperscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[Xi]", 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["GL",
         FontSlant->"Plain"]}]], ")"}], "3"], "\[GreaterGreater]", "1"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1f3b38d5-5fab-4ed4-b401-0aa1e680508a"],
 ". ",
 StyleBox["A remark on the factors (what it means and why it matters).",
  FontWeight->"Bold"],
 " Other forms of the criterion (the mean square fluctuation of the field in \
a correlation volume against the square of its mean value, or the first \
correction to ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["b", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["Tay",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "68ccd99b-8089-46a7-af3e-342305f93c4a"],
 " against ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["b", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["Tay",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "19843e45-9319-4daa-9637-08ff680d9f3a"],
 ") give the same combination of ",
 Cell[BoxData[
  FormBox["\[Alpha]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "09165021-1a05-426f-9657-aa2b40420ff0"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["b", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5ea417b4-4fe3-4348-8eb7-69fb996b0e88"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["c",
    FontFamily->"Helvetica",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bd4bb0ef-db96-42c3-a9fd-df8d3045370d"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["c",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c9283033-2512-42dd-8111-0c0c6a0dd494"],
 " with other numerical factors of order one, and books on the subject differ \
by such factors. The formula above is the definition used here. It matters \
only when the number is near 1; the numbers found below are far above 1, so a \
factor of order one does not change the conclusion."
}], "Text",ExpressionUUID->"5a16bec6-5e20-41b1-9e85-ab8c202e7873"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
III.G.2 The coefficient of the field of a moving pair: the static pair \
response\
\>", "Section",ExpressionUUID->"d6050f6e-0964-4b6b-8703-0fd32cc6783e"],

Cell[TextData[{
 "A pair field with the momentum ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["q", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["pair",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5d28c5b1-323d-4e3b-8c78-e8dcfd012550"],
 " along ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox[
     StyleBox["e", "TI"], "\[RightVector]"], "3"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "982bbb3e-202d-4437-975d-ca8399a737c1"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
    RowBox[{"(", 
     OverscriptBox[
      StyleBox["x", "TI"], "\[RightVector]"], ")"}], "\[LongEqual]", 
    OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "\[ThinSpace]", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      StyleBox["i", "TI"], 
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["pair",
        FontSlant->"Plain"]], 
      SuperscriptBox[
       StyleBox["x", "TI"], "3"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "53c900a0-4cdc-4fc3-97bc-960d9dd9770b"],
 ", has the gradient term ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["c",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["pair",
        FontSlant->"Plain"]], ")"}], "2"], 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
      "\[RightBracketingBar]"}], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "18a2d983-f2d0-4312-a17a-6a19ac8d6f1a"],
 ", so its coefficient of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c38f808c-e932-4bce-a24a-01c58e702b60"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["Tay",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["pair",
        FontSlant->"Plain"]], ";", 
      StyleBox["T", "TI"]}], ")"}], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["Tay",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}], "+", 
    SubsuperscriptBox[
     StyleBox["c",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["pair",
        FontSlant->"Plain"]], ")"}], "2"], "+", 
    StyleBox["O", "TI"], 
    RowBox[{"(", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["q", "TI"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        StyleBox["pair",
         FontSlant->"Plain"]], ")"}], "4"], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "99c11414-15ed-4581-a3bd-fb299bb7c6a7"],
 ". The state of a moving pair pairs the momenta ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     StyleBox["q", "TI"], "\[RightVector]"], "+", 
    FractionBox["1", "2"], 
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["pair",
      FontSlant->"Plain"]], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["e", "TI"], "\[RightVector]"], "3"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "33b7e96b-1388-464d-9fde-a484d34667ca"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     OverscriptBox[
      StyleBox["q", "TI"], "\[RightVector]"]}], "+", 
    FractionBox["1", "2"], 
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["pair",
      FontSlant->"Plain"]], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["e", "TI"], "\[RightVector]"], "3"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a4fed442-4ac8-4f04-bf73-9260aea73361"],
 " (relative momentum ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["q", "TI"], "\[RightVector]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "627bcfa9-7a51-4e3f-8cb2-dadfe9deb92a"],
 "). After the gauge transformation ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPsi]", "\[RightArrow]", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      StyleBox["i", "TI"], 
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["pair",
        FontSlant->"Plain"]], 
      SuperscriptBox[
       StyleBox["x", "TI"], "3"], "/", "2"}]], "\[CapitalPsi]"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0f4f3ac4-0203-4bb0-a616-f6421147b467"],
 ", which makes the pair field uniform, it is the thermal state of the matrix \
of Bogoliubov and de Gennes (Section II.2) with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["h",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     RowBox[{"\[PlusMinus]", 
      OverscriptBox[
       StyleBox["q", "TI"], "\[RightVector]"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "216e34e3-a355-41b8-8304-8ee13da25004"],
 " replaced by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["h",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     RowBox[{"\[PlusMinus]", 
      OverscriptBox[
       StyleBox["q", "TI"], "\[RightVector]"]}], ")"}], "+", 
    SubsuperscriptBox[
     StyleBox["T",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["tw",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3170b78d-4f4d-4756-b70d-ad1401e825d5"],
 ", the ",
 StyleBox["twist",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["T",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["tw",
      FontSlant->"Plain"]], "\[LongEqual]", 
    FractionBox["1", "2"], 
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["pair",
      FontSlant->"Plain"]], "\[ThinSpace]", 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], "3"], "\[CircleTimes]", 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d32b4ad4-c090-4345-a978-e8aba8c660a3"],
 ", with the normal self-energy ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["N",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["n",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c2ac33ff-56c5-4f0f-91d6-1de73f9c9f8d"],
 " of the normal state at ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "010a5c1a-3f9c-4ffe-a0cb-8066045b25c8"],
 " (a change of the normal self-energy changes the free energy only at fourth \
order in the field, because the free energy is stationary in it) and with a \
small antisymmetric pair block ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["P",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["a",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0e5982df-900c-4fc0-835f-0c31bafbc558"],
 ". To first order in ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["P",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["a",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1b44e0c9-753b-4398-9cd3-eca936bed318"],
 " the pair matrix summed over the momenta, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["C",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["p",
       FontSlant->"Plain"], ",", 
      StyleBox["tot",
       FontSlant->"Plain"]}]], "\[LongEqual]", "\[Integral]", "\[ThinSpace]", 
    
    FractionBox[
     RowBox[{
      SuperscriptBox[
       StyleBox["d", "TI"], "3"], 
      StyleBox["q", "TI"]}], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"2", "\[Pi]"}], ")"}], "3"]], 
    SubsuperscriptBox[
     StyleBox["C",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     OverscriptBox[
      StyleBox["q", "TI"], "\[RightVector]"], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "83938a50-2ba4-422f-bbdd-d344ae02c1fa"],
 ", is the ",
 StyleBox["static pair response",
  FontWeight->"Bold"]
}], "Text",ExpressionUUID->"0f0aa611-55b9-40ad-93b4-ccae30d50fe0"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["C",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["p",
      FontSlant->"Plain"], ",", 
     StyleBox["tot",
      FontSlant->"Plain"]}]], "\[LongEqual]", 
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalX]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["P",
     FontSlant->"Plain"]], 
   RowBox[{"[", 
    SubsuperscriptBox[
     StyleBox["P",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["a",
      FontSlant->"Plain"]], "]"}], "\[LongEqual]", 
   RowBox[{"-", "\[Integral]"}], "\[ThinSpace]", 
   FractionBox[
    RowBox[{
     SuperscriptBox[
      StyleBox["d", "TI"], "3"], 
     StyleBox["q", "TI"]}], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"2", "\[Pi]"}], ")"}], "3"]], "\[ThinSpace]", 
   UnderoverscriptBox["\[Sum]", 
    RowBox[{
     StyleBox["a", "TI"], ",", 
     StyleBox["b", "TI"], "\[LongEqual]", "1"}], "8",
    LimitsPositioning->True], "\[ThinSpace]", 
   FractionBox[
    RowBox[{
     StyleBox["f", "TI"], 
     RowBox[{"(", 
      SubsuperscriptBox["\[CurlyEpsilon]", 
       RowBox[{
        StyleBox["SF",
         FontSlant->"Plain"], ",", 
        StyleBox["a", "TI"]}], 
       StyleBox["A",
        FontSlant->"Plain"]], ")"}], "-", 
     StyleBox["f", "TI"], 
     RowBox[{"(", 
      SubsuperscriptBox["\[CurlyEpsilon]", 
       RowBox[{
        StyleBox["SF",
         FontSlant->"Plain"], ",", 
        StyleBox["b", "TI"]}], 
       StyleBox["D",
        FontSlant->"Plain"]], ")"}]}], 
    RowBox[{
     SubsuperscriptBox["\[CurlyEpsilon]", 
      RowBox[{
       StyleBox["SF",
        FontSlant->"Plain"], ",", 
       StyleBox["a", "TI"]}], 
      StyleBox["A",
       FontSlant->"Plain"]], "-", 
     SubsuperscriptBox["\[CurlyEpsilon]", 
      RowBox[{
       StyleBox["SF",
        FontSlant->"Plain"], ",", 
       StyleBox["b", "TI"]}], 
      StyleBox["D",
       FontSlant->"Plain"]]}]], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["u",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["a", "TI"]}]], 
   SubsuperscriptBox[
    StyleBox["u",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["a", "TI"]}], "\[Dagger]"], "\[ThinSpace]", 
   SubsuperscriptBox[
    StyleBox["P",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["a",
     FontSlant->"Plain"]], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["w",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["b", "TI"]}]], 
   SubsuperscriptBox[
    StyleBox["w",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["b", "TI"]}], "\[Dagger]"], ","}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"0042dd95-a188-49f5-8ca3-bc1ec26806b9"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CurlyEpsilon]", 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["a", "TI"]}], 
    StyleBox["A",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d357d333-0d7b-4d56-acb6-3ce8a220fd16"],
 " and the normalized eigenvectors ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["u",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["a", "TI"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e46611ef-6ed1-432a-93c7-d623970a2fc4"],
 " are those of the particle block ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["h",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     OverscriptBox[
      StyleBox["q", "TI"], "\[RightVector]"], ")"}], "+", 
    SubsuperscriptBox[
     StyleBox["N",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["n",
      FontSlant->"Plain"]], "+", 
    SubsuperscriptBox[
     StyleBox["T",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["tw",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a58f0bd7-59b7-48a4-877e-c8b796f5f8ba"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CurlyEpsilon]", 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["b", "TI"]}], 
    StyleBox["D",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d6c7d866-cabf-46b4-bd43-61b63e5d91a3"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["w",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["b", "TI"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0fa37193-bbc5-4d86-8486-feb5760f4167"],
 " those of the hole block ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["h",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["LL",
         FontSlant->"Plain"]], 
       RowBox[{"(", 
        RowBox[{"-", 
         OverscriptBox[
          StyleBox["q", "TI"], "\[RightVector]"]}], ")"}], "+", 
       SubsuperscriptBox[
        StyleBox["N",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        StyleBox["n",
         FontSlant->"Plain"]], "+", 
       SubsuperscriptBox[
        StyleBox["T",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        StyleBox["tw",
         FontSlant->"Plain"]]}], ")"}], 
     StyleBox["T", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "391f002f-c1fc-47fb-9387-5aa49653b406"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["f", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9fe93c7c-ce39-45d7-9d7d-dda145b9e734"],
 " is the Fermi function, and the quotient is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["f", "TI"], "\[Prime]"], 
    RowBox[{"(", "\[CurlyEpsilon]", ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "eb667df2-2e8e-445b-a7f4-fb9898d75bc2"],
 " where the two energies coincide (the first-order term of the function ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["f", "TI"], 
    RowBox[{"(", 
     SubscriptBox[
      StyleBox["H",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["SF",
       FontSlant->"Plain"]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a918e664-2b08-464f-9ebb-39d766a5b3f2"],
 " of a Hermitian matrix in its off-diagonal block). The free energy of the \
state, measured from the normal state at ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2cc3ac9c-5865-4ec2-94e6-3a6a67b1a122"],
 ", is to second order"
}], "Text",ExpressionUUID->"01bec0db-4739-43d4-8389-dc59cef8cee7"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalF]",
     FontSlant->"Plain"], 
    RowBox[{"2", ",", 
     StyleBox["SF",
      FontSlant->"Plain"]}], 
    StyleBox["X", "TI"]], "\[LongEqual]", 
   FractionBox["1", "2"], "\[ThinSpace]", 
   StyleBox["Re",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["tr",
    FontSlant->"Plain"], 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["P",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        StyleBox["a",
         FontSlant->"Plain"]], "-", 
       SubscriptBox[
        StyleBox["P",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["SF",
         FontSlant->"Plain"]], 
       RowBox[{"[", 
        SubsuperscriptBox[
         StyleBox["C",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], 
         StyleBox["SF",
          FontSlant->"Plain"], 
         RowBox[{
          StyleBox["p",
           FontSlant->"Plain"], ",", 
          StyleBox["tot",
           FontSlant->"Plain"]}]], "]"}]}], ")"}], 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["C",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["p",
          FontSlant->"Plain"], ",", 
         StyleBox["tot",
          FontSlant->"Plain"]}]], ")"}], "\[Dagger]"]}], ")"}], ","}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"10519cc5-d8d4-4ba4-899e-6a329599863c"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["P",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"]], 
    RowBox[{"[", 
     SubsuperscriptBox[
      StyleBox["C",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["p",
        FontSlant->"Plain"], ",", 
       StyleBox["tot",
        FontSlant->"Plain"]}]], "]"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8a47d97e-8bc0-4365-bdd7-20fa840de305"],
 " is the pair self-energy of method ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0abc3446-a60c-4bf9-9a42-de9d50a839cd"],
 " for the pair matrix ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["C",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["p",
      FontSlant->"Plain"], ",", 
     StyleBox["tot",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bed2c9e3-8bdb-4ebc-902d-92e507207da2"],
 " (Section II.2; linear in it, and it contains every pair channel of the \
method, not only the channels ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c0cf1b3a-67f2-4373-8f34-ad11e847c002"],
 "). ",
 StyleBox["Derivation.",
  FontWeight->"Bold"],
 " The expectation value of the pair term of the BdG Hamiltonian is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     StyleBox["V", "TI"], "\[RightAngleBracket]"}], "\[LongEqual]", 
    RowBox[{"-", 
     StyleBox["Re",
      FontSlant->"Plain"]}], "\[ThinSpace]", 
    StyleBox["tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["P",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["a",
        FontSlant->"Plain"]], 
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox[
         StyleBox["C",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], 
         StyleBox["SF",
          FontSlant->"Plain"], 
         RowBox[{
          StyleBox["p",
           FontSlant->"Plain"], ",", 
          StyleBox["tot",
           FontSlant->"Plain"]}]], ")"}], "\[Dagger]"]}], ")"}]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4240737c-a0f5-4470-bbc5-0db80f9efba5"],
 "; the thermal state of the Hamiltonian with the pair term has the \
thermodynamic potential ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{"\[LeftAngleBracket]", 
     StyleBox["V", "TI"], "\[RightAngleBracket]"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "aaf33a14-6b34-419a-beb1-c8d93a5cdab2"],
 " below that of the normal state (second-order perturbation theory); the \
free energy of the method contains this potential minus ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftAngleBracket]", 
    StyleBox["V", "TI"], "\[RightAngleBracket]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "56fa0428-534e-4ad4-9afd-4edbc1410e41"],
 " (the pair term is not part of the Hamiltonian of the model) plus the pair \
part of the interaction energy, which is quadratic in the pair matrix and \
equals ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", "2"]}], 
    StyleBox["Re",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["P",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["SF",
        FontSlant->"Plain"]], 
      RowBox[{"[", 
       SubsuperscriptBox[
        StyleBox["C",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["p",
          FontSlant->"Plain"], ",", 
         StyleBox["tot",
          FontSlant->"Plain"]}]], "]"}], 
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox[
         StyleBox["C",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], 
         StyleBox["SF",
          FontSlant->"Plain"], 
         RowBox[{
          StyleBox["p",
           FontSlant->"Plain"], ",", 
          StyleBox["tot",
           FontSlant->"Plain"]}]], ")"}], "\[Dagger]"]}], ")"}]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f611f4ef-8497-43d7-a55b-85259921163f"],
 "; the sum is the formula above. The field of the state is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[CapitalPhi]", "3"], "\[LongEqual]", 
    StyleBox["tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], 
      SubscriptBox[
       StyleBox["P",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["SF",
        FontSlant->"Plain"]], 
      RowBox[{"[", 
       SubsuperscriptBox[
        StyleBox["C",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["p",
          FontSlant->"Plain"], ",", 
         StyleBox["tot",
          FontSlant->"Plain"]}]], "]"}]}], ")"}], "/", "8"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "71de7e95-3247-434b-a5bb-2a5b0d1c77ca"],
 ". The free energy of the field is the smallest ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalF]",
     FontSlant->"Plain"], 
    RowBox[{"2", ",", 
     StyleBox["SF",
      FontSlant->"Plain"]}], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a796d8c4-3a3d-4352-9d19-c361851f2ce4"],
 " among the states with this field: the components of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["P",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["a",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e4999d08-97ec-4a55-8523-8c1757660ade"],
 " along ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], "1"], ")"}], "\[Dagger]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3b4d5c1e-8f9f-4db1-be64-0ec6066681dc"],
 ", ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], "2"], ")"}], "\[Dagger]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d0128925-1df4-4f8b-bf2a-b2606ee7d2ab"],
 ", ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ac6f4849-e4be-4954-9cd3-4c3c5e02fe72"],
 " are held at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "0", ",", "1"}], ")"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "374de8c0-d8b2-4ab8-b9b0-2c52dd891bd8"],
 ", and its components along the other 25 antisymmetric matrices are made \
self-consistent (a linear system of 25 complex unknowns: the stationarity of \
the free energy with a Lagrange multiplier for the field). Then ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["Tay",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["pair",
        FontSlant->"Plain"]], ";", 
      StyleBox["T", "TI"]}], ")"}], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalF]",
      FontSlant->"Plain"], 
     RowBox[{"2", ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]], "/", 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      SuperscriptBox["\[CapitalPhi]", "3"], "\[RightBracketingBar]"}], "2"]}],
    TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "16320d40-e745-4e26-a853-915b6c7bcb35"],
 ". At ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["pair",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "215302cc-88e7-41bf-8a55-2e1a5ea2363f"],
 " and in the channel ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c2d15e00-7168-43d3-9bdb-ca927ab06377"],
 " alone this is"
}], "Text",ExpressionUUID->"1f5e5447-e6b5-421d-bdd5-ddf754011f38"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["Tay",
      FontSlant->"Plain"]}]], 
   RowBox[{"(", 
    RowBox[{"0", ";", 
     StyleBox["T", "TI"]}], ")"}], "\[LongEqual]", 
   FractionBox[
    RowBox[{"1", "-", 
     SubsuperscriptBox["\[Lambda]", 
      StyleBox["SF",
       FontSlant->"Plain"], 
      StyleBox["P",
       FontSlant->"Plain"]], 
     RowBox[{"(", 
      StyleBox["T", "TI"], ")"}]}], 
    RowBox[{
     SubsuperscriptBox["\[Lambda]", 
      StyleBox["SF",
       FontSlant->"Plain"], 
      StyleBox["P",
       FontSlant->"Plain"]], 
     RowBox[{"(", 
      StyleBox["T", "TI"], ")"}], "\[ThinSpace]", 
     SubsuperscriptBox[
      StyleBox["g", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["X", "TI"], ",", 
       StyleBox["P",
        FontSlant->"Plain"]}]]}]], ","}], TraditionalForm]], "DisplayFormula",\

 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"0fa1edb1-0d63-4d01-9c49-59aee17ddf94"],

Cell[TextData[{
 "with the eigenvalue ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Lambda]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["P",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1ee87673-3697-4a92-a636-fd18537f9060"],
 " of Section III.T.4: the applied block ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "311d79b3-6b3d-4086-8175-f97d2641a68b"],
 " produces the field ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[CapitalPhi]", "3"], "\[LongEqual]", 
    SubsuperscriptBox["\[Lambda]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["P",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5be529bb-5823-48e3-9ccd-5945100ee7bf"],
 ", and the formula for ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalF]",
     FontSlant->"Plain"], 
    RowBox[{"2", ",", 
     StyleBox["SF",
      FontSlant->"Plain"]}], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "899ead6b-1750-44a2-9171-622fe1404260"],
 " gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      SubsuperscriptBox["\[Lambda]", 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["P",
        FontSlant->"Plain"]]}], ")"}], "\[CenterDot]", "2", 
    SubsuperscriptBox["\[Lambda]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["P",
      FontSlant->"Plain"]], "/", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["P",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fbbc7967-c016-4875-89d0-19b8c453ff44"],
 ". Hence the slope in closed form, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["GL",
       FontSlant->"Plain"]}]], "\[LongEqual]", 
    RowBox[{"-", 
     SubsuperscriptBox[
      StyleBox["T", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["X", "TI"], ",", 
       StyleBox["c",
        FontSlant->"Plain"]}]]}], "\[ThinSpace]", 
    SubscriptBox["\[PartialD]", 
     StyleBox["T", "TI"]], 
    SubsuperscriptBox["\[Lambda]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["P",
      FontSlant->"Plain"]], "/", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[Lambda]", 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["P",
        FontSlant->"Plain"]], ")"}], "2"], 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["P",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1218a0b0-7b37-412a-a576-c821edfd5eb4"],
 " at ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4d9d31a4-e65e-4470-8eec-21b6663d209a"],
 ". ",
 StyleBox["The engine.",
  FontWeight->"Bold"],
 " The next cell defines the static pair response on any set of momenta with \
weights, the quadratic free energy of the field, the normal self-energy at ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a08add85-5b37-47ca-b603-7e0ce0cb6c2a"],
 ", and the coefficient for a twist ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["q", "TI"], "\[ThinSpace]", 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], "3"], "\[CircleTimes]", 
    StyleBox["t",
     FontFamily->"Helvetica",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f12d6f9e-2f91-4619-b486-879ce579b717"],
 " with an isospin matrix ",
 Cell[BoxData[
  FormBox[
   StyleBox["t",
    FontFamily->"Helvetica",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "374845b0-faf8-480f-9fde-37b048c7b7b6"],
 ": ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["t",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "93a86629-df86-41c3-972e-0bddbab611a2"],
 " moves the pair (fermion number 2) with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["pair",
      FontSlant->"Plain"]], "\[LongEqual]", "2", 
    StyleBox["q", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9fccace8-aa6b-4255-a4cf-d160f4919df0"],
 "; ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["t",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "\[LongEqual]", 
    FractionBox["1", "2"], 
    SubscriptBox["\[Tau]", "1"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "79270a9b-a476-41fa-8f8c-38e7c7769a01"],
 " turns the isospin direction of the field (its components of charge ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "694e3d6a-1a66-44e1-880a-e6a74308cb68"],
 " of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "1"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "88b41ef5-b49e-405f-8782-823e8bf3d3af"],
 " get the momenta ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    StyleBox["q", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3b47e717-ac0c-466a-a031-02db67d23341"],
 "), and must give the same coefficient by the isospin invariance of the form."
}], "Text",ExpressionUUID->"9621faca-3c5b-456a-b749-ef639f5e96a9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"--", " ", "the"}]}], " ", "static", " ", "pair", " ", 
    "response", " ", "and", " ", "the", " ", "quadratic", " ", "free", " ", 
    "energy", " ", "of", " ", "a", " ", "field", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"Section", " ", 
        RowBox[{"III", ".", "G"}], ".2"}], ")"}], " ", "--"}], "--"}]}], " ", 
   "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"gzPairs", ":", " ", 
     RowBox[{"the", " ", "28", " ", "index", " ", "pairs", " ", 
      RowBox[{"{", 
       RowBox[{"a", ",", " ", "b"}], "}"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"a", " ", "<", " ", "b"}], ";", " ", 
     RowBox[{"gzBasis", ":", " ", 
      RowBox[{
       RowBox[{
       "the", " ", "antisymmetric", " ", "basis", " ", "matrices", " ", 
        "E_ab"}], " ", "-", " ", "E_ba"}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"gzPairs", " ", "=", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"a", ",", " ", "b"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"a", ",", " ", "8"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"b", ",", " ", 
           RowBox[{"a", " ", "+", " ", "1"}], ",", " ", "8"}], "}"}]}], "]"}],
        ",", " ", "1"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gzBasis", " ", "=", " ", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{"pr", ",", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Which", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{"i", ",", " ", "j"}], "}"}], " ", "==", " ", "pr"}], ",",
