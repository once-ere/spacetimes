       "  ", 
       RowBox[{
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"p", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{
               RowBox[{"j", " ", "n"}], " ", "+", " ", "i", " ", "+", " ", 
               "1"}], ",", " ", 
              RowBox[{
               RowBox[{"i", " ", "n"}], " ", "+", " ", "j", " ", "+", " ", 
               "1"}]}], "]"}], "]"}], " ", "=", " ", "1"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", "0", ",", " ", 
            RowBox[{"n", " ", "-", " ", "1"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"j", ",", " ", "0", ",", " ", 
            RowBox[{"n", " ", "-", " ", "1"}]}], "}"}]}], "]"}], ";", " ", 
        "p"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sectors", " ", "=", " ", 
     RowBox[{"{", 
