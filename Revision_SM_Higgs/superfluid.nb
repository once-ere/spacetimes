Cell[TextData[{
 "On an orthonormal basis of the two pairs ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPsi]", "\[Chi]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "64415a9b-65ff-4da9-ba01-0f26790d39c6"],
 " of positive parity, ",
