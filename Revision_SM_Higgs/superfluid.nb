    RowBox[{"the", " ", "conservation", " ", "laws"}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "a", " ", "symbolic", " ", "Hermitian", " ", "3", " ", "x", " ", "3", " ", 
     RowBox[{"matrix", ":", " ", 
      RowBox[{"real", " ", "parts", " ", 
       RowBox[{"s", "[", 
        RowBox[{"i", ",", " ", "j"}], "]"}]}]}]}], ",", " ", 
    RowBox[{"imaginary", " ", "parts", " ", 
     RowBox[{"u", "[", 
      RowBox[{"i", ",", " ", "j"}], "]"}], " ", "above", " ", "the", " ", 
     "diagonal"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"herm", "[", 
      RowBox[{"s_", ",", " ", "u_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"i", " ", "==", " ", "j"}], ",", " ", 
         RowBox[{"s", "[", 
          RowBox[{"i", ",", " ", "i"}], "]"}], ",", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"i", " ", "<", " ", "j"}], ",", " ", 
           RowBox[{
            RowBox[{"s", "[", 
             RowBox[{"i", ",", " ", "j"}], "]"}], " ", "+", " ", 
            RowBox[{"I", " ", 
             RowBox[{"u", "[", 
              RowBox[{"i", ",", " ", "j"}], "]"}]}]}], ",", " ", 
           RowBox[{
            RowBox[{"s", "[", 
             RowBox[{"j", ",", " ", "i"}], "]"}], " ", "-", " ", 
            RowBox[{"I", " ", 
             RowBox[{"u", "[", 
              RowBox[{"j", ",", " ", "i"}], "]"}]}]}]}], "]"}]}], "]"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"hh", " ", "=", " ", 
     RowBox[{"herm", "[", 
      RowBox[{"a", ",", " ", "ai"}], "]"}]}], ";", " ", 
    RowBox[{"rr", " ", "=", " ", 
     RowBox[{"herm", "[", 
      RowBox[{"b", ",", " ", "bi"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dR", " ", "=", " ", 
     RowBox[{
      RowBox[{"-", "I"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"hh", " ", ".", " ", "rr"}], " ", "-", " ", 
        RowBox[{"rr", " ", ".", " ", "hh"}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"consOK", " ", "=", " ", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{
        RowBox[{"ComplexExpand", "[", 
         RowBox[{"Tr", "[", 
          RowBox[{"hh", " ", ".", " ", "dR"}], "]"}], "]"}], ",", " ", 
        RowBox[{"Element", "[", 
         RowBox[{"_", ",", " ", "Reals"}], "]"}]}], "]"}], " ", "===", " ", 
      "0"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
