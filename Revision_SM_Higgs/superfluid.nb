Cell[CellGroupData[{

Cell["R.1.6 The Lorentz-invariant bilinears (check WQN-6)", "Subsection",ExpressionUUID->"bd216661-3ffb-4c14-84f7-81105806bd3c"],

Cell[TextData[{
 "A pair of two fields ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Phi]", "1"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "db33fea3-6fd4-42af-9860-17234c964dee"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Phi]", "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "38a86134-f644-4d9d-832b-19db7c69fcaf"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPi]", 
    RowBox[{"[", 
     StyleBox["M",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "]"}], "\[LongEqual]", 
    SubsuperscriptBox["\[Phi]", "1", 
     StyleBox["T", "TI"]], 
    StyleBox["M",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    SubscriptBox["\[Phi]", "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "661de227-18d0-4d5a-8862-fa6eaa871a9f"],
 ", and a particle-antiparticle bilinear is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Phi]", "1", "\[Dagger]"], 
    StyleBox["M",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    SubscriptBox["\[Phi]", "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "21ab4c7d-3db3-41c5-8de4-9931b66501f3"],
 ". Under ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Phi]", "\[RightArrow]", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      StyleBox["i", "TI"], "\[Epsilon]", 
      StyleBox["X", "TI"]}]], "\[Phi]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3aadd919-b13b-4d4e-840d-af38270f2661"],
 " the matrix ",
 Cell[BoxData[
  FormBox[
   StyleBox["M",
    FontFamily->"Helvetica",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bc18059e-bb3e-4803-a0fa-6f4f3b71f0af"],
 " changes, to first order, by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["i", "TI"], "\[Epsilon]", 
    SubscriptBox[
     StyleBox["L", "TI"], 
     StyleBox["X", "TI"]], 
    RowBox[{"(", 
     StyleBox["M",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "77e7ed08-dddb-4063-90c7-6490a70dca87"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["L", "TI"], 
     StyleBox["X", "TI"]], 
    RowBox[{"(", 
     StyleBox["M",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], ")"}], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["X", "TI"], "1", 
     StyleBox["T", "TI"]], 
    StyleBox["M",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "+", 
    StyleBox["M",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    SubscriptBox[
     StyleBox["X", "TI"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "81077908-ca30-403a-939f-7e6718daf1a9"],
 " for a pair and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     SubscriptBox[
      StyleBox["X", "TI"], "1"]}], 
    StyleBox["M",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "+", 
    StyleBox["M",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    SubscriptBox[
     StyleBox["X", "TI"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e031c793-dbe6-41a6-9702-29e5adf55529"],
 " for a particle-antiparticle bilinear, where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["X", "TI"], "1"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a6070c76-2f35-4b09-95ad-a298b6eae5a8"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["X", "TI"], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "345147b1-18aa-440d-ad9d-3a12a8a913be"],
 " are the blocks of ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c8d041a0-fade-4511-a603-38112001affb"],
 " on the two fields. A bilinear is Lorentz invariant when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["L", "TI"], 
     RowBox[{
      StyleBox["S", "TI"], 
      RowBox[{"(", 
       StyleBox["u", "TI"], ")"}]}]], 
    RowBox[{"(", 
     StyleBox["M",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], ")"}], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6c8442ac-6a04-41a2-be91-6d2ccff9b750"],
 " for the six generators; the invariant matrices are the null space of these \
linear conditions, computed exactly on the vector of the entries of ",
 Cell[BoxData[
  FormBox[
   StyleBox["M",
    FontFamily->"Helvetica",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "52346c50-9261-43ca-a6c8-4ff0bfb0dd20"],
 " (taken row by row). For a pair of two particles of one field, Fermi \
statistics keeps only the antisymmetric part of ",
 Cell[BoxData[
  FormBox[
   StyleBox["M",
    FontFamily->"Helvetica",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4f630e0a-f670-498f-bfe4-24af6be5d5b7"],
 ", so the condition ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["M",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "\[LongEqual]", 
    RowBox[{"-", 
     SuperscriptBox[
      StyleBox["M",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["T", "TI"]]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "65a52be0-f9cb-44b2-b4b5-3263bb1a94c9"],
 " is added. The twelve sectors are the six pairs ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPsi]", "\[CapitalPsi]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8671795d-18bd-4664-aab1-fac08fcfaaf0"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPsi]", "\[Chi]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6d01880a-730a-4229-a45d-ca0ceb8fba29"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPsi]", 
    SuperscriptBox["\[Chi]", "\[Prime]"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ccbb5f80-6544-43bc-b9cd-b07dc94c196f"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Chi]", "\[Chi]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8ff00275-7ac0-4969-aeea-cb69fe0fb956"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Chi]", 
    SuperscriptBox["\[Chi]", "\[Prime]"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "050238d8-361b-4a84-9472-d2bf69ba81e3"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Chi]", "\[Prime]"], 
    SuperscriptBox["\[Chi]", "\[Prime]"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c2a09531-ba31-426b-ab4c-9e9ec96ea9c5"],
 " and the six particle-antiparticle bilinears; the four sectors in which the \
pair of singlets is taken as one field, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"\[Chi]", ",", 
     SuperscriptBox["\[Chi]", "\[Prime]"]}], ")"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "83616941-b290-4f73-aa4f-130f27013476"],
 ", show the custodial multiplets. The pair matrices ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["ch",
      FontSlant->"Plain"]], "\[CircleTimes]", 
    SubsuperscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["s", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4b84522d-b897-41f8-859c-6b2356125421"],
 " (spin zero, positive parity) and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[CircleTimes]", 
    SubsuperscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["s", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "aa39d09c-dc62-44f7-9a1a-717545a6646c"],
 " (spin zero, negative parity) must lie in the invariant spaces of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPsi]", "\[Chi]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "71d8f84a-d42b-40a4-822c-032bc2a6d7bb"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPsi]", 
    SuperscriptBox["\[Chi]", "\[Prime]"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "197cf075-e7e4-435d-bcfa-8ce6fe213863"],
 " and span them."
}], "Text",ExpressionUUID->"8e23292b-633c-4b6e-b4a0-61b05bf9413d"],

