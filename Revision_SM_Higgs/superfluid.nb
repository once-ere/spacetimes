Cell[TextData[{
 StyleBox["AS1: plane waves in constant gauge fields.",
  FontWeight->"Bold"],
 " In constant gauge fields the field equation without self-interaction has \
plane-wave solutions ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Chi]", "\[ThinSpace]", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      RowBox[{"-", 
       StyleBox["i", "TI"]}], "\[Omega]", 
      StyleBox["t", "TI"], "+", 
      StyleBox["i", "TI"], 
      OverscriptBox[
       StyleBox["q", "TI"], "\[RightVector]"], "\[CenterDot]", 
      OverscriptBox[
       StyleBox["x", "TI"], "\[RightVector]"]}]]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a690914b-3f2e-4a5c-9c83-63312f79de98"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"\[Omega]", ",", "\[Chi]"}], ")"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b961b113-baa7-433d-9b3a-4d3c330ebcc4"],
 " is an eigenpair of the Hermitian matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["h",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["pw",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     OverscriptBox[
      StyleBox["q", "TI"], "\[RightVector]"], ")"}], "\[LongEqual]", 
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "+", 
    SuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["F",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["B", "TI"], "0"], "+", 
    SuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["v",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["W",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "0"], "+", 
    UnderscriptBox["\[Sum]", 
     StyleBox["j", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["j", "TI"]], "+", 
      SuperscriptBox[
       StyleBox["g", "TI"], 
       StyleBox["F",
        FontSlant->"Plain"]], 
      SubscriptBox[
       StyleBox["B", "TI"], 
       StyleBox["j", "TI"]], "+", 
      SuperscriptBox[
       StyleBox["g", "TI"], 
       StyleBox["v",
        FontSlant->"Plain"]], 
      SubscriptBox[
       StyleBox["W",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["j", "TI"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8e3bc039-4db8-44db-817e-752f3504a9fb"],
 ". For the spin-isospin locked field ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["W", "TI"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["j", "TI"]}], "\[Iota]"], "\[LongEqual]", 
    StyleBox["w", "TI"], "\[ThinSpace]", 
    SubscriptBox["\[Delta]", 
     RowBox[{"\[Iota]", 
      StyleBox["j", "TI"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cfd4a3b9-8f65-4bd9-bdeb-bb809b0ec371"],
 " the eight frequencies at the momentum ",
 Cell[BoxData[
  FormBox[
   StyleBox["q", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "16ee563e-fb00-4fa8-a6ec-e16aa0c14b4e"],
 " along ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["x", "TI"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "962cdecb-d7d2-4e21-9892-40ce2303a293"],
 " are ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", "\[Omega]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f90b00d2-c2c1-4045-8482-7777b0ab4976"],
 " with the four branches ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Omega]", "2"], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["m", "TI"], "2"], "+", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       StyleBox["q", "TI"], "\[PlusMinus]", 
       StyleBox["gw", "TI"], "/", "2"}], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bacf578f-c64c-452f-b277-94aba19fed59"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Omega]", "2"], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["m", "TI"], "2"], "+", 
    SuperscriptBox[
     StyleBox["q", "TI"], "2"], "+", 
    FractionBox["5", "4"], 
    SuperscriptBox[
     StyleBox["g", "TI"], "2"], 
    SuperscriptBox[
     StyleBox["w", "TI"], "2"], "\[PlusMinus]", 
    StyleBox["gw", "TI"], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        StyleBox["q", "TI"], "2"], "+", 
       SuperscriptBox[
        StyleBox["g", "TI"], "2"], 
       SuperscriptBox[
        StyleBox["w", "TI"], "2"]}], ")"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cf354ae5-7e5f-48f4-a4b7-04992f47625b"],
 "."
}], "Text",ExpressionUUID->"9f0267cb-38da-456c-bdc5-46621877fe98"],

Cell[TextData[{
 StyleBox["AS2: Landau levels.",
  FontWeight->"Bold"],
 " In a constant magnetic field ",
 Cell[BoxData[
  FormBox[
   StyleBox["B", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f1c9e5dc-82a8-4658-a683-dfacf8d3a6d9"],
 " along ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["x", "TI"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a19a6490-f21d-48d0-83fc-3eff9c3e2d4e"],
 " the frequencies are ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       StyleBox["m", "TI"], "2"], "+", 
      SubsuperscriptBox[
       StyleBox["q", "TI"], "3", "2"], "+", "2", 
      StyleBox["neB", "TI"]}], ")"}], 
    RowBox[{"1", "/", "2"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ff17c44d-b707-4afc-9e6f-93e3bc2e6efd"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "0", ",", "1", ",", "2", ",", 
    "\[Ellipsis]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a7854e2e-6ac1-4eec-8d80-9a6b77155c0e"],
 "; the program discretizes ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["x", "TI"], "1"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bf8fb455-f6fb-466c-a97c-586eaf1d9cdc"],
 " on a lattice with the Wilson term (spacings ",
 Cell[BoxData[
  FormBox["0.1", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d044eb08-ddec-4ab1-bf74-be84532d3de8"],
 ", ",
 Cell[BoxData[
  FormBox["0.05", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6b68fd0b-724b-4ced-8aba-0a900a8978e9"],
 ", ",
 Cell[BoxData[
  FormBox["0.025", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d1f502f0-db9e-4283-9ece-08135e998e9e"],
 ") and compares the seven lowest positive frequencies, and their Richardson \
extrapolation ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    StyleBox["E", "TI"], 
    RowBox[{"(", "0.025", ")"}], "-", 
    StyleBox["E", "TI"], 
    RowBox[{"(", "0.05", ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1175f777-99ae-40dc-b72c-ee7dc47f0626"],
 ", with the Landau levels."
}], "Text",ExpressionUUID->"5e5a1509-e790-4f43-a875-7a088eef26a7"],

Cell[TextData[{
 StyleBox["AS3: the uniform superfluid of the spin-zero pairing.",
  FontWeight->"Bold"],
 " For a uniform unitary pair field the 16 eigenvalues of the matrix of \
Bogoliubov and de Gennes are ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    SuperscriptBox[
     RowBox[{"[", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"\[CurlyEpsilon]", "\[PlusMinus]", "\[Mu]"}], ")"}], "2"], "+", 
       SuperscriptBox["\[CapitalDelta]", "2"]}], "]"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4af1b0e6-61af-4197-a7e8-6b0fe3fea4fe"],
 ", each four times; the mean-field energy is stationary where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["G", "TI"], "/", 
      SuperscriptBox["\[Pi]", "2"]}], ")"}], 
    SubscriptBox[
     StyleBox["I", "TI"], "1"], 
    RowBox[{"(", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         StyleBox["m", "TI"], "2"], "+", 
        SuperscriptBox["\[CapitalDelta]", "2"]}], ")"}], 
      RowBox[{"1", "/", "2"}]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c8aec0ae-3fbd-4130-8544-56444962fb5c"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["I", "TI"], "1"], 
    RowBox[{"(", 
     StyleBox["M", "TI"], ")"}], "\[LongEqual]", 
    FractionBox["1", "2"], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "+", 
         SuperscriptBox[
          StyleBox["M", "TI"], "2"]}], ")"}], 
       RowBox[{"1", "/", "2"}]], "-", 
      SuperscriptBox[
       StyleBox["M", "TI"], "2"], "\[ThinSpace]", 
      StyleBox["arcsinh",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       RowBox[{"1", "/", 
        StyleBox["M", "TI"]}], ")"}]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "95a2d8a1-63e3-49ba-8b8f-771ce0744b7a"],
 ", and at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["G", "TI"], "\[LongEqual]", "22.5"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "44b9673e-9f73-45c0-a831-b6854ed2410b"],
 " the gap is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", "\[LongEqual]", "0.2094933033"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d28f0aee-7155-4fcb-a923-9cc225ced729"],
 "."
}], "Text",ExpressionUUID->"259c7423-281f-4a57-bffe-8646055fb032"],

Cell[TextData[{
 StyleBox["AS4: the kink of the pair field.",
  FontWeight->"Bold"],
 " For the pair field ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", 
    RowBox[{"(", 
     StyleBox["x", "TI"], ")"}], "\[LongEqual]", 
    SubscriptBox["\[CapitalDelta]", "\[Infinity]"], "\[ThinSpace]", 
    StyleBox["tanh",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["x", "TI"], "/", "\[ScriptL]"}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a10dfd56-7f43-4a87-a650-9201bf5d65a8"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalDelta]", "\[Infinity]"], "\[LongEqual]", "0.5"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "68bc6a21-f507-4561-a145-7ab37208b0df"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ScriptL]", "\[LongEqual]", "4"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9f90d274-3034-409d-a577-0b3d82a3919a"],
 ") the reduced problem has the bound states ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["sech",
      FontSlant->"Plain"], "2"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["x", "TI"], "/", "\[ScriptL]"}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c1964908-9906-4d63-a858-672d8b6fe885"],
 " (zero mode, energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    StyleBox["m", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f5bde451-2030-40af-b331-b068517a6f87"],
 ") and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["sech",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["x", "TI"], "/", "\[ScriptL]"}], ")"}], "\[ThinSpace]", 
    StyleBox["tanh",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["x", "TI"], "/", "\[ScriptL]"}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2bf682a7-c0b2-45b4-9ddd-a152e74029c0"],
 " (energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        StyleBox["m", "TI"], "2"], "+", 
       SubsuperscriptBox[
        StyleBox["E", "TI"], "1", "2"]}], ")"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f37b32a9-a695-4b9f-9001-59c5e38d0ba2"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["E", "TI"], "1", "2"], "\[LongEqual]", "3", "/", "16"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "163987c3-bf4d-4925-af70-443def445582"],
 "); on the Wilson lattice exactly three bound states lie below the continuum \
",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       StyleBox["m", "TI"], "2"], "+", 
      SubsuperscriptBox["\[CapitalDelta]", "\[Infinity]", "2"]}], ")"}], 
    RowBox[{"1", "/", "2"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "134976ee-b9fa-4cac-a423-93491c8595f5"],
 "."
}], "Text",ExpressionUUID->"796e1134-a802-43ef-a231-a0224a06c9f0"],

Cell[TextData[{
 "The next cell computes the four cases. The eigenvalues of the Hermitian \
matrices are computed by the function ",
 StyleBox["Eigenvalues",
  FontFamily->"Source Code Pro"],
 " of the Wolfram Language (dense matrices of up to 4800 rows); the gap \
equation is solved by ",
 StyleBox["FindRoot",
  FontFamily->"Source Code Pro"],
 " with 30 digits; the profiles of AS4 are checked symbolically by ",
 StyleBox["FullSimplify",
  FontFamily->"Source Code Pro"],
 "."
}], "Text",ExpressionUUID->"0d9f2a2a-a471-42e7-ada4-dcff63a61e90"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"hPW", "[", 
      RowBox[{
      "q", ",", " ", "m", ",", " ", "gv", ",", " ", "gf", ",", " ", "w", ",", 
       " ", "b"}], "]"}], ":", " ", 
     RowBox[{
      RowBox[{"the", " ", "plane"}], "-", 
      RowBox[{
      "wave", " ", "matrix", " ", "of", " ", "AS1", " ", "for", " ", "the", " ",
        "constant", " ", "fields", " ", 
       RowBox[{"w", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"p", "+", "1"}], ",", " ", "i"}], "]"}], "]"}]}]}]}], " ", "=",
     " ", 
    RowBox[{
     RowBox[{
      RowBox[{"W", "^", "i_p"}], " ", "and", " ", 
      RowBox[{"b", "[", 
       RowBox[{"[", 
        RowBox[{"p", "+", "1"}], "]"}], "]"}]}], " ", "=", " ", "B_p"}]}], 
   " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"hPW", "[", 
      RowBox[{
      "q_", ",", " ", "m_", ",", " ", "gv_", ",", " ", "gf_", ",", " ", "w_", 
       ",", " ", "b_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "gauge", "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{
         RowBox[{"gauge", "[", "p_", "]"}], " ", ":=", " ", 
         RowBox[{
          RowBox[{"gf", " ", 
           RowBox[{"b", "[", 
            RowBox[{"[", 
             RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}], " ", 
           RowBox[{"IdentityMatrix", "[", "8", "]"}]}], " ", "+", " ", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{"gv", " ", 
             RowBox[{"w", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"p", " ", "+", " ", "1"}], ",", " ", "i"}], "]"}], 
              "]"}], " ", 
             RowBox[{"tLL", "[", "i", "]"}]}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"i", ",", " ", "3"}], "}"}]}], "]"}]}]}], ";", "\n", 
        "   ", 
        RowBox[{
         RowBox[{
          RowBox[{"d8", "[", "betaLL", "]"}], " ", "m"}], " ", "+", " ", 
         RowBox[{"gauge", "[", "0", "]"}], " ", "+", " ", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"d8", "[", 
             RowBox[{"alphaLL", "[", "j", "]"}], "]"}], " ", ".", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"q", "[", 
                RowBox[{"[", "j", "]"}], "]"}], " ", 
               RowBox[{"IdentityMatrix", "[", "8", "]"}]}], " ", "+", " ", 
              RowBox[{"gauge", "[", "j", "]"}]}], ")"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}]}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"AS1", "-", "3"}], ":", " ", 
       RowBox[{
        RowBox[{"the", " ", "spin"}], "-", 
        RowBox[{"isospin", " ", "locked", " ", "field", " ", 
         RowBox[{"W", "^", "i_j"}]}]}]}], " ", "=", " ", 
      RowBox[{"w", " ", "delta_ij"}]}], ",", " ", 
     RowBox[{"w", " ", "=", " ", "0.9"}], ",", " ", 
     RowBox[{"g_v", " ", "=", " ", "0.83"}], ",", " ", 
     RowBox[{"at", " ", "61", " ", "momenta", " ", "along", " ", 
      RowBox[{"x", "^", "3"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"w", " ", "=", " ", "0.9"}], ",", " ", 
        RowBox[{"gv", " ", "=", " ", "0.83"}], ",", " ", "wl", ",", " ", "gw",
         ",", " ", 
        RowBox[{"m", " ", "=", " ", 
         RowBox[{"N", "[", "mLL", "]"}]}], ",", " ", 
        RowBox[{"d", " ", "=", " ", "0."}]}], "}"}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{"wl", " ", "=", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"w", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "w", ",", " ", "0"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "0", ",", " ", "w"}], "}"}]}], "}"}]}], ";",
        "\n", "  ", 
       RowBox[{"gw", " ", "=", " ", 
        RowBox[{"gv", " ", "w"}]}], ";", "\n", "  ", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"ev", " ", "=", " ", 
              RowBox[{"Sort", "[", 
               RowBox[{"Re", "[", 
                RowBox[{"Eigenvalues", "[", 
                 RowBox[{"N", "[", 
                  RowBox[{"hPW", "[", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"0", ",", " ", "0", ",", " ", "q"}], "}"}], ",", 
                    " ", "m", ",", " ", "gv", ",", " ", "0", ",", " ", "wl", ",",
                     " ", 
                    RowBox[{"{", 
                    RowBox[{
                    "0", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], 
                    "}"}]}], "]"}], "]"}], "]"}], "]"}], "]"}]}], ",", " ", 
             "w2", ",", " ", "want"}], "}"}], ",", "\n", "     ", 
           RowBox[{
            RowBox[{"w2", " ", "=", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"m", "^", "2"}], " ", "+", " ", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"q", " ", "+", " ", 
                   RowBox[{"gw", "/", "2"}]}], ")"}], "^", "2"}]}], ",", " ", 
               
               RowBox[{
                RowBox[{"m", "^", "2"}], " ", "+", " ", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"q", " ", "-", " ", 
                   RowBox[{"gw", "/", "2"}]}], ")"}], "^", "2"}]}], ",", " ", 
               
               RowBox[{
                RowBox[{"m", "^", "2"}], " ", "+", " ", 
                RowBox[{"q", "^", "2"}], " ", "+", " ", 
                RowBox[{"1.25", " ", 
                 RowBox[{"gw", "^", "2"}]}], " ", "+", " ", 
                RowBox[{"gw", " ", 
                 RowBox[{"Sqrt", "[", 
                  RowBox[{
                   RowBox[{"q", "^", "2"}], " ", "+", " ", 
                   RowBox[{"gw", "^", "2"}]}], "]"}]}]}], ",", " ", 
               RowBox[{
                RowBox[{"m", "^", "2"}], " ", "+", " ", 
                RowBox[{"q", "^", "2"}], " ", "+", " ", 
                RowBox[{"1.25", " ", 
