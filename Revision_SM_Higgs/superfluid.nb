Cell[CellGroupData[{

Cell["\<\
III.G.7 The Ginzburg number: how wide is the critical region?\
\>", "Section",ExpressionUUID->"1d8f0ea1-d57e-47b2-8230-e9d05b24521d"],

Cell[TextData[{
 "The next cell computes the Ginzburg number by both forms of Section \
III.G.1, with the slope and the gradient coefficient of the notebook and the \
quartic coefficient of the notebook (CJT) or of the Rust table (the other \
methods), and prints the table of the answer: the correlation length ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Xi]", 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["GL",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a7d7f952-fed6-4981-8613-51829b817f0f"],
 " in units of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "97152836-ee88-4354-92f8-b9ca400b95da"],
 ", the specific-heat jump per correlation volume ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", 
    SubsuperscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[Xi]", 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["GL",
         FontSlant->"Plain"]}]], ")"}], "3"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "498d769f-7f94-49ea-a54a-449a4665352b"],
 ", the Ginzburg number, the width ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["Gi",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a4485c53-9800-4606-b04c-24799691ab09"],
 " of the critical region in temperature, and the Ginzburg number with ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["c",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a2107d72-0cff-4cc5-9773-4c7cf27b1867"],
 " changed by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    SubsuperscriptBox[
     StyleBox["c",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      RowBox[{
       StyleBox["T",
        FontSlant->"Plain"], "\[InvisibleSpace]", "3"}]}]]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "595abcc8-1b45-4194-a649-c4e186054b08"],
 " of the Rust table."
}], "Text",ExpressionUUID->"9ae81add-644c-46c3-ac91-ad54280db6f7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"gzGi", "[", "t_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"r", " ", "=", " ", 
        RowBox[{"gzResults", "[", "t", "]"}]}], ",", " ", 
       RowBox[{"b", " ", "=", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"t", " ", "===", " ", "\"\<CJT\>\""}], ",", " ", 
          RowBox[{
           RowBox[{"gzResults", "[", "\"\<CJT\>\"", "]"}], "[", "\"\<b\>\"", 
           "]"}], ",", " ", 
          RowBox[{"gzRust", "[", 
           RowBox[{"t", ",", " ", "\"\<b\>\""}], "]"}]}], "]"}]}], ",", " ", 
       "gi1", ",", " ", "dc", ",", " ", "xi", ",", " ", "gi2"}], "}"}], ",", 
     "\n", "   ", 
     RowBox[{
      RowBox[{"gi1", " ", "=", " ", 
       RowBox[{"36", " ", 
        RowBox[{"b", "^", "2"}], " ", 
        RowBox[{
         RowBox[{
          RowBox[{"r", "[", "\"\<Tc\>\"", "]"}], "^", "2"}], "/", 
         RowBox[{"(", 
          RowBox[{"64", " ", 
           RowBox[{"Pi", "^", "2"}], " ", 
           RowBox[{"r", "[", "\"\<alpha\>\"", "]"}], " ", 
           RowBox[{
            RowBox[{"r", "[", "\"\<c\>\"", "]"}], "^", "3"}]}], ")"}]}]}]}], ";",
       "\n", "   ", 
      RowBox[{"dc", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"r", "[", "\"\<alpha\>\"", "]"}], "^", "2"}], "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", "b", " ", 
          RowBox[{"r", "[", "\"\<Tc\>\"", "]"}]}], ")"}]}]}], ";", " ", 
      RowBox[{"xi", " ", "=", " ", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"r", "[", "\"\<c\>\"", "]"}], "/", 
         RowBox[{"r", "[", "\"\<alpha\>\"", "]"}]}], "]"}]}], ";", "\n", 
      "   ", 
      RowBox[{"gi2", " ", "=", " ", 
       RowBox[{"36", "/", 
        RowBox[{"(", 
         RowBox[{"256", " ", 
          RowBox[{"Pi", "^", "2"}], " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"dc", " ", 
             RowBox[{"xi", "^", "3"}]}], ")"}], "^", "2"}]}], ")"}]}]}], ";", 
      "\n", "   ", 
      RowBox[{"{", 
       RowBox[{"gi1", ",", " ", "gi2", ",", " ", "xi", ",", " ", 
        RowBox[{"dc", " ", 
         RowBox[{"xi", "^", "3"}]}], ",", " ", "b"}], "}"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"gzGi", "[", "t", "]"}]}], "}"}], ",", "\n", "   ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{"\"\<WP3-G11 \>\"", " ", "<>", " ", "t"}], ",", " ", 
        RowBox[{
         RowBox[{"thName", "[", "t", "]"}], " ", "<>", 
         " ", "\"\<: the Ginzburg number by the first form \>\"", " ", "<>", 
         " ", 
         RowBox[{"ToString", "[", 
          RowBox[{"NumberForm", "[", 
           RowBox[{
            RowBox[{"g", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", " ", "8"}], "]"}], "]"}], 
         " ", "<>", " ", "\"\< and by the second form \>\"", " ", "<>", " ", 
         RowBox[{"ToString", "[", 
          RowBox[{"NumberForm", "[", 
           RowBox[{
            RowBox[{"g", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", " ", "8"}], "]"}], "]"}], 
         " ", "<>", " ", "\"\< = Rust \>\"", " ", "<>", " ", 
         RowBox[{"ToString", "[", 
          RowBox[{"NumberForm", "[", 
           RowBox[{
            RowBox[{"gzRust", "[", 
             RowBox[{"t", ",", " ", "\"\<Gi\>\""}], "]"}], ",", " ", "8"}], 
           "]"}], "]"}], " ", "<>", 
         " ", "\"\< (largest relative difference)\>\""}], ",", "\n", "    ", 
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"g", "[", 
              RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", 
             RowBox[{"gzRust", "[", 
              RowBox[{"t", ",", " ", "\"\<Gi\>\""}], "]"}]}], "]"}], ",", " ", 
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"g", "[", 
              RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
             RowBox[{"g", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], "]"}], "/", 
         RowBox[{"gzRust", "[", 
          RowBox[{"t", ",", " ", "\"\<Gi\>\""}], "]"}]}], ",", " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "6"}]}], ",", " ", 
        RowBox[{"\"\<P3-G11 \>\"", " ", "<>", " ", "t"}], ",", " ", 
        RowBox[{"\"\<YP3-G11 \>\"", " ", "<>", " ", "t"}]}], "]"}]}], "]"}], ",",
     " ", 
    RowBox[{"{", 
     RowBox[{"t", ",", " ", "thTags"}], "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"g", " ", "=", " ", 
            RowBox[{"gzGi", "[", "t", "]"}]}], ",", " ", 
           RowBox[{"r", " ", "=", " ", 
            RowBox[{"gzResults", "[", "t", "]"}]}], ",", " ", 
           RowBox[{"ct3", " ", "=", " ", 
            RowBox[{"gzRust", "[", 
             RowBox[{"t", ",", " ", "\"\<cT3\>\""}], "]"}]}]}], "}"}], ",", 
         "\n", "     ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"thName", "[", "t", "]"}], ",", " ", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{"r", "[", "\"\<Tc\>\"", "]"}], ",", " ", "6"}], "]"}], ",",
            " ", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{"r", "[", "\"\<alpha\>\"", "]"}], ",", " ", "6"}], "]"}],
            ",", " ", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{"g", "[", 
              RowBox[{"[", "5", "]"}], "]"}], ",", " ", "6"}], "]"}], ",", 
           " ", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{"r", "[", "\"\<c\>\"", "]"}], ",", " ", "6"}], "]"}], ",",
            " ", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{"g", "[", 
              RowBox[{"[", "3", "]"}], "]"}], ",", " ", "4"}], "]"}], ",", 
           " ", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{"g", "[", 
              RowBox[{"[", "4", "]"}], "]"}], ",", " ", "3"}], "]"}], ",", 
           "\n", "      ", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{"g", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", " ", "4"}], "]"}], ",", 
           " ", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"g", "[", 
               RowBox[{"[", "1", "]"}], "]"}], " ", 
              RowBox[{"r", "[", "\"\<Tc\>\"", "]"}]}], ",", " ", "4"}], "]"}],
            ",", "\n", "      ", 
           RowBox[{
            RowBox[{"ToString", "[", 
             RowBox[{"NumberForm", "[", 
              RowBox[{
               RowBox[{"36", " ", 
                RowBox[{
                 RowBox[{"g", "[", 
                  RowBox[{"[", "5", "]"}], "]"}], "^", "2"}], " ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"r", "[", "\"\<Tc\>\"", "]"}], "^", "2"}], "/", 
                 RowBox[{"(", 
                  RowBox[{"64", " ", 
                   RowBox[{"Pi", "^", "2"}], " ", 
                   RowBox[{"r", "[", "\"\<alpha\>\"", "]"}], " ", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"r", "[", "\"\<c\>\"", "]"}], " ", "+", " ", 
                    "ct3"}], ")"}], "^", "3"}]}], ")"}]}]}], ",", " ", "3"}], 
              "]"}], "]"}], " ", "<>", " ", "\"\< to \>\"", " ", "<>", " ", 
            RowBox[{"ToString", "[", 
             RowBox[{"NumberForm", "[", 
              RowBox[{
               RowBox[{"36", " ", 
                RowBox[{
                 RowBox[{"g", "[", 
                  RowBox[{"[", "5", "]"}], "]"}], "^", "2"}], " ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"r", "[", "\"\<Tc\>\"", "]"}], "^", "2"}], "/", 
                 RowBox[{"(", 
                  RowBox[{"64", " ", 
                   RowBox[{"Pi", "^", "2"}], " ", 
                   RowBox[{"r", "[", "\"\<alpha\>\"", "]"}], " ", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"r", "[", "\"\<c\>\"", "]"}], " ", "-", " ", 
                    "ct3"}], ")"}], "^", "3"}]}], ")"}]}]}], ",", " ", "3"}], 
              "]"}], "]"}]}]}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "thTags"}], "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"\"\<method\>\"", ",", " ", "\"\<T_c\>\"", ",", 
       " ", "\"\<alpha\>\"", ",", " ", "\"\<b\>\"", ",", " ", "\"\<c\>\"", ",",
        " ", "\"\<xi0\>\"", ",", " ", "\"\<Delta C xi0^3\>\"", ",", 
       " ", "\"\<Gi\>\"", ",", " ", "\"\<Gi T_c\>\"", ",", 
       " ", "\"\<Gi with c -+ c_T3\>\""}], "}"}]}], "]"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Alignment", " ", "->", " ", "Right"}], ",", " ", 
