Cell[CellGroupData[{

Cell["\<\
R.3 The masses of the gauge bosons and the modes of the superfluid (stage 4)\
\>", "Section",ExpressionUUID->"d329a4c9-0bd7-4382-a887-862ec31c7b03"],

Cell[TextData[{
 "Stage 4 computed, for the five methods and both versions, the effective \
potential ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["V", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["eff",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubscriptBox["\[CurlyPhi]", 
      StyleBox["SH",
       FontSlant->"Plain"]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c8cd6e02-f1e8-4326-9470-d5369be0cb8f"],
 " of the pair fields along the direction of the vacuum and its minimum at \
the pair amplitude ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CurlyPhi]", 
    StyleBox["SH",
     FontSlant->"Plain"], "0"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2ebaec73-c302-4569-88e1-e5292429b091"],
 "; the susceptibilities ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Chi]", 
    StyleBox["SH",
     FontSlant->"Plain"], 
    StyleBox["ab", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a2473d41-36e4-4282-a38f-26c38fc3fead"],
 " of the charge densities of the eight generators to their chemical \
potentials ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Mu]", 
    StyleBox["SH",
     FontSlant->"Plain"], 
    StyleBox["b", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "38b26d49-e2ac-4990-b666-5897dc1933d9"],
 "; from them the scale ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["v", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]], "\[LongEqual]", "2", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[Chi]", 
       StyleBox["SH",
        FontSlant->"Plain"], "11"], ")"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1690eecb-98d8-4ad1-8f78-6bdcd79d5469"],
 ", defined by the mass ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     RowBox[{
      StyleBox["W", "TI"], ",", 
      StyleBox["SH",
       FontSlant->"Plain"]}]], "\[LongEqual]", 
    StyleBox["g", "TI"], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["v", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]], "/", "2"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5a25f109-0b58-4ace-b783-aebc66f95a33"],
 " of the ",
 Cell[BoxData[
  FormBox[
   StyleBox["W", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e0532f15-beed-4e38-a2af-d2b9d52a85c0"],
 " boson, the mass ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["M", "TI"], 
    RowBox[{
     StyleBox["Z", "TI"], ",", 
     StyleBox["SH",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "919d849e-4b1d-4ade-87c8-6d9c10a85db0"],
 " and the ratio ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Rho]", 
     StyleBox["SH",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubsuperscriptBox["\[Chi]", 
     StyleBox["SH",
      FontSlant->"Plain"], "11"], "/", 
    SubsuperscriptBox["\[Chi]", 
     StyleBox["SH",
      FontSlant->"Plain"], "33"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ba3db17b-ca73-4cb5-8f62-07adff8cab9f"],
 "; and the frequency of the amplitude mode, the candidate for the Higgs \
boson, once from the effective Lagrangian of the pair fields (",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["M", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"], 
    StyleBox["EFT",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "49b99cb0-ffe3-4730-8040-6cedbceeea34"],
 ") and once from the linear response of the time-dependent mean field at a \
frequency (",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Omega]", 
    StyleBox["SH",
     FontSlant->"Plain"], 
    StyleBox["H",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "570ed60e-7fe0-4fb8-ae8d-5539a05eeb55"],
 "). ",
 StyleBox["Why the chemical potentials.",
  FontWeight->"Bold"],
 " A uniform time component of a gauge field acts on the fields as a chemical \
potential of its charge. The normal vacuum has a gap and keeps every charge, \
so it does not respond to a small chemical potential, and the masses of the \
gauge bosons come from the condensate alone; the space components would carry \
the artifact of remark R10 (Section R.2.6). For a Lorentz-invariant vacuum \
the time and the space components of a gauge field have the same mass. The \
checks of this section derive the formulas of the Rust program symbolically \
and evaluate the closed forms of the pairing-only methods. The section starts \
from a clean slate."
}], "Text",ExpressionUUID->"6dd8f567-88f0-43bd-8c0e-02dd7f6cd46a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"--", " ", "Section"}]}], " ", "R", ".3", " ", "starts", " ", 
    "from", " ", "a", " ", "clean", " ", 
    RowBox[{
     RowBox[{"slate", " ", "--"}], "--"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"rvClean", "[", "]"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "the", " ", "names", " ", "of", " ", "the", " ", "three", " ", "tables", " ",
      "of", " ", "the", " ", "Rust", " ", "program", " ", "sh_higgs", " ", 
     "that", " ", "this", " ", "section", " ", "reads", " ", 
     RowBox[{"(", 
      RowBox[{"rows", " ", "of", " ", "the", " ", "data", " ", "cell"}], 
      ")"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"minFile", ",", " ", "massFile", ",", " ", "valFile"}], "}"}], 
     " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<sh_hg_minimum.csv\>\"", ",", 
       " ", "\"\<sh_hg_masses.csv\>\"", ",", 
       " ", "\"\<sh_hg_values.csv\>\""}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"num", "[", "s_String", "]"}], " ", ":=", " ", 
     RowBox[{"ToExpression", "[", 
      RowBox[{"StringReplace", "[", 
       RowBox[{"s", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<e\>\"", " ", "->", " ", "\"\<*^\>\""}], "}"}]}], "]"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"col", "[", 
      RowBox[{"h_", ",", " ", "n_"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"Position", "[", 
       RowBox[{"h", ",", " ", "n"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", " ", "1"}], "]"}], "]"}]}], ";"}]}]}]], "Input",
 CellLabel->
  "In[636]:=",ExpressionUUID->"2cad662b-aca2-4e81-899a-af0105a70f50"],

Cell[CellGroupData[{

Cell["\<\
R.3.1 The custodial algebra of the effective Lagrangian (check WH-1)\
\>", "Subsection",ExpressionUUID->"60487555-a7a3-44e4-a25b-d2a3533fb5bb"],

Cell[TextData[{
 "Near its vacuum the bidoublet has the effective Lagrangian ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["Z", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]], "\[ThinSpace]", 
    StyleBox["tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"\[PartialD]", 
         StyleBox["\[ScriptCapitalM]",
          FontSlant->"Plain"]}], ")"}], "\[Dagger]"], "\[PartialD]", 
      StyleBox["\[ScriptCapitalM]",
       FontSlant->"Plain"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4b5800c1-72f6-4c55-a002-d5cd6e6b2659"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["\[ScriptCapitalM]",
      FontSlant->"Plain"], 
     StyleBox["SH",
      FontSlant->"Plain"]], "\[RightArrow]", 
    StyleBox["L", "TI"], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["\[ScriptCapitalM]",
      FontSlant->"Plain"], 
     StyleBox["SH",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     StyleBox["R", "TI"], 
     StyleBox["T", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a5d7bdc4-19c6-46ff-93ab-e21267b5025d"],
 ". Chemical potentials ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Mu]", 
    StyleBox["a", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4770bc67-079b-4a95-b996-56514b1fe8f0"],
 " of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["T", "TI"], 
    RowBox[{
     StyleBox["a", "TI"], ",", 
     StyleBox["SM",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e43ee160-5402-49e8-af56-d1271d5728eb"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Nu]", 
    StyleBox["a", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0dfb93ae-6ebe-4e5a-abd8-1a7fd88b9aa5"],
 " of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["a", "TI"], ",", 
     StyleBox["R",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fd76d106-60a2-48f6-82e3-aaa108392fef"],
 " replace ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "0"], 
    StyleBox["\[ScriptCapitalM]",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "55d663ad-c3f3-4646-97c1-e5f3b93e9497"],
 " by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["i", "TI"], 
    RowBox[{"(", 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       StyleBox["a", "TI"],
       LimitsPositioning->True], "\[ThinSpace]", 
      SubscriptBox["\[Mu]", 
       StyleBox["a", "TI"]], 
      FractionBox[
       SuperscriptBox["\[Tau]", 
        StyleBox["a", "TI"]], "2"], 
      StyleBox["\[ScriptCapitalM]",
       FontSlant->"Plain"], "+", 
      StyleBox["\[ScriptCapitalM]",
       FontSlant->"Plain"], "\[ThinSpace]", 
      UnderscriptBox["\[Sum]", 
       StyleBox["a", "TI"],
       LimitsPositioning->True], "\[ThinSpace]", 
      SubscriptBox["\[Nu]", 
       StyleBox["a", "TI"]], 
      FractionBox[
       SuperscriptBox[
        RowBox[{"(", 
         SuperscriptBox["\[Tau]", 
          StyleBox["a", "TI"]], ")"}], 
        StyleBox["T", "TI"]], "2"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "62faa5b5-ed33-4f13-b6ca-5800a4617fdc"],
 " and lower the energy of the static vacuum ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["\[ScriptCapitalM]",
     FontSlant->"Plain"], "\[LongEqual]", "\[Phi]", "\[ThinSpace]", 
    StyleBox["i", "TI"], 
    SuperscriptBox["\[Tau]", "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "36262bc8-ed6a-4dfc-b8e5-8f20c279a5c6"],
 " by ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["Z", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b4b39be5-09bb-484c-bc27-86f7d70803a1"],
 " times the squared norm of that matrix. The susceptibilities are minus the \
second derivatives of the energy: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Chi]", 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       StyleBox["T", "TI"], 
       StyleBox["a", "TI"]], ",", 
      SuperscriptBox[
       StyleBox["T", "TI"], 
       StyleBox["b", "TI"]]}], ")"}], "\[LongEqual]", "\[Chi]", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["T", "TI"], 
       StyleBox["R",
        FontSlant->"Plain"], 
       StyleBox["a", "TI"]], ",", 
      SubsuperscriptBox[
       StyleBox["T", "TI"], 
       StyleBox["R",
        FontSlant->"Plain"], 
       StyleBox["b", "TI"]]}], ")"}], "\[LongEqual]", 
    RowBox[{"-", "\[Chi]"}], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       StyleBox["T", "TI"], 
       StyleBox["a", "TI"]], ",", 
      SubsuperscriptBox[
       StyleBox["T", "TI"], 
       StyleBox["R",
        FontSlant->"Plain"], 
       StyleBox["b", "TI"]]}], ")"}], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["Z", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]], 
    SuperscriptBox["\[Phi]", "2"], 
    SubscriptBox["\[Delta]", 
     StyleBox["ab", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e4188664-d01d-48f8-a0f9-9155f29d426d"],
 ". With ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["Y", "TI"], 
     StyleBox["SM",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     RowBox[{"3", ",", 
      StyleBox["R",
       FontSlant->"Plain"]}]], "+", 
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]], "/", "4"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9bc5ee9b-fea3-40cf-ada2-07b1d2194bcf"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "25606a7b-0662-4c9c-8b6b-9d0b28ddee2e"],
 " unbroken, the charge ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["Q", "TI"], 
    StyleBox["SM",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5aecbe6b-f6b6-4e3a-b3cd-e552487055c7"],
 " does not respond; the mass matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["a", "TI"]], 
    SubscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["b", "TI"]], 
    SuperscriptBox["\[Chi]", 
     StyleBox["ab", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c894bdfe-7dbe-4cc1-b1eb-3613b28fead0"],
 " of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox[
      StyleBox["W", "TI"], "1"], ",", 
     SuperscriptBox[
      StyleBox["W", "TI"], "2"], ",", 
     SuperscriptBox[
      StyleBox["W", "TI"], "3"], ",", 
     StyleBox["B", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e09e7e8a-cd50-482a-a03c-234db41527e5"],
 " has the eigenvalues ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f70a989a-a568-4427-a42b-2c9bcf4a26ca"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["g", "TI"], "2"], 
    SubscriptBox[
     StyleBox["Z", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]], 
    SuperscriptBox["\[Phi]", "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f2e82385-8d12-42c3-a70d-fbc4fabeca44"],
 " (twice) and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       StyleBox["g", "TI"], "2"], "+", 
      SuperscriptBox[
       StyleBox["g", "TI"], 
       RowBox[{"\[Prime]", "2"}]]}], ")"}], 
    SubscriptBox[
     StyleBox["Z", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]], 
    SuperscriptBox["\[Phi]", "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1184d11b-53bc-4a7f-8a22-fa4f1b8c7ab9"],
 ", so that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["W", "TI"]], "\[LongEqual]", 
    StyleBox["gv", "TI"], "/", "2"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "463f1233-4cf0-4db6-9d5d-8fd89d6b5e26"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["Z", "TI"]], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        StyleBox["g", "TI"], "2"], "+", 
       SuperscriptBox[
        StyleBox["g", "TI"], 
        RowBox[{"\[Prime]", "2"}]]}], ")"}], 
     RowBox[{"1", "/", "2"}]], 
    StyleBox["v", "TI"], "/", "2"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fc327bb9-2831-40b3-9692-2bc9397e0fa1"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["v", "TI"], "2"], "\[LongEqual]", "4", 
    SubscriptBox[
     StyleBox["Z", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]], 
    SuperscriptBox["\[Phi]", "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9d5663a3-0daf-47ac-87d9-8c88a66363ab"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", "\[LongEqual]", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7e6e7d0d-a5d2-4ab0-aaae-c77dc3b1024e"],
 ". This is the custodial structure that the Rust program finds numerically \
in all five methods."
}], "Text",ExpressionUUID->"d053235e-e107-4640-999a-4b13a47dd11c"],

