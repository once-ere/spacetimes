Cell[TextData[{
 StyleBox["The manifold M31 and its Lorentz group.",
  FontWeight->"Bold"],
 " M31 is the real vector space of the Hermitian bi-quaternions ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["x",
     FontWeight->"Bold",
     FontSlant->"Plain"], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "0"], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "0"], "+", 
    StyleBox["i", "TI"], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", 
     StyleBox["j", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "af56001f-eed0-4799-a733-9205d0407ee2"],
 "; their matrices ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["x",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", 
     StyleBox["p", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p", "TI"]], 
    SubsuperscriptBox["\[Sigma]", 
     StyleBox["p", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c76848d5-c08d-4a46-82ef-8e05254dc6d9"],
 " are the Hermitian ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Times]", "2"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2e47342b-9909-43fc-aef8-9609140b8858"],
 " matrices, and the norm ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["x",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "0"], ")"}], "2"], "-", 
    UnderscriptBox["\[Sum]", 
     StyleBox["j", "TI"],
     LimitsPositioning->True], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["j", "TI"]], ")"}], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0768e549-8520-49c0-a7fb-0205eb27aab2"],
 " is the Minkowski interval. A unit bi-quaternion ",
 Cell[BoxData[
  FormBox[
   StyleBox["g",
    FontWeight->"Bold",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "db8ddf78-1cb4-484f-a617-3671527bfcbd"],
 " acts by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["x",
     FontWeight->"Bold",
     FontSlant->"Plain"], "\[RightTeeArrow]", 
    StyleBox["g",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    StyleBox["x",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    SuperscriptBox[
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], "\[Dagger]"]}], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2431d6d0-273b-4e94-ae4c-c0d4a13b109c"],
 "; this keeps M31 and the interval, so it is a Lorentz transformation, with \
the real matrix"
}], "Text",ExpressionUUID->"d7e093a3-f4a9-441b-9bad-404a31b8388c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["L",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   SubscriptBox[
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    RowBox[{
     StyleBox["p", "TI"], 
     SuperscriptBox[
      StyleBox["p", "TI"], "\[Prime]"]}]], "\[LongEqual]", 
   FractionBox["1", "2"], "\[ThinSpace]", 
   StyleBox["Re",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["tr",
    FontSlant->"Plain"], 
   RowBox[{"(", 
    RowBox[{
     SubsuperscriptBox["\[Sigma]", 
      StyleBox["p", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"]], 
     SubscriptBox[
      StyleBox["M", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"]], 
     RowBox[{"(", 
      StyleBox["g",
       FontWeight->"Bold",
       FontSlant->"Plain"], ")"}], "\[ThinSpace]", 
     SubsuperscriptBox["\[Sigma]", 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"], 
      StyleBox["LL",
       FontSlant->"Plain"]], 
     SubscriptBox[
      StyleBox["M", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"]], 
     SuperscriptBox[
      RowBox[{"(", 
       StyleBox["g",
        FontWeight->"Bold",
        FontSlant->"Plain"], ")"}], "\[Dagger]"]}], ")"}], ","}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"47957f50-9380-44df-b2e0-2b57245206d2"],

Cell[TextData[{
 "which is proper and orthochronous (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["L",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["T", "TI"]], "\[Eta]", 
    StyleBox["L",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "\[LongEqual]", "\[Eta]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "71a66419-25a5-4c13-88a1-ea80d85d3cab"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["det",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["L",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "50b0f2f4-6693-4aed-838a-b0e8d93d8628"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["L",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "00"], "\[GreaterEqual]", "1"}], TraditionalForm]],
   "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fa0e4df9-7b13-4892-ab75-80f14f5905ca"],
 ") and multiplicative, with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["L",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     RowBox[{"-", 
      StyleBox["g",
       FontWeight->"Bold",
       FontSlant->"Plain"]}], ")"}], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["L",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "929960d4-9d22-40d9-b37a-21ef4ed53726"],
 ": ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SL", "TI"], 
    RowBox[{"(", 
     RowBox[{"2", ",", 
      StyleBox["\[DoubleStruckCapitalC]",
       FontSlant->"Plain"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4d4d4e6c-4c46-4bcd-ace4-ea29132e4b4a"],
 " is the double cover of the proper orthochronous Lorentz group. The next \
cell checks the properties of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["M", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "90b7ce85-7633-41bc-9827-6f0aff1bf673"],
 " exactly (with Gaussian-integer coefficients) and those of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["L",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9b518969-7992-4225-ab6d-87d70fac9da9"],
 " with 200 random unit bi-quaternions in floating point. A spinor charge of \
the super-loop is a bi-octonion ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["b",
     FontWeight->"Bold",
     FontSlant->"Plain"], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ebb61b32-5a27-4254-b956-249918703efa"],
 "; by the product rule the super-loop acts on it as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
