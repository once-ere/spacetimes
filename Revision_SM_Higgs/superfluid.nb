}]}]}]}]}]}], "-", "1"}], ":", " ", 
    RowBox[{"the", " ", "conservation", " ", "laws"}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "a", " ", "symbolic", " ", "Hermitian", " ", "3", " ", "x", " ", "3", " ", 
     RowBox[{"matrix", ":", " ", 
      RowBox[{"real", " ", "parts", " ", 
       RowBox[{"s", "[", 
        RowBox[{"i", ",", " ", "j"}], "]"}]}]}]}], ",", " ", 
    RowBox[{"imaginary", " ", "parts", " ", 
     RowBox[{"u", "[", 
      RowBox[{"i", ",", " ", "j"}], "]"}], " ", "above", " ", "the", " ", 
     "diagonal"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"herm", "[", 
      RowBox[{"s_", ",", " ", "u_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"i", " ", "==", " ", "j"}], ",", " ", 
         RowBox[{"s", "[", 
          RowBox[{"i", ",", " ", "i"}], "]"}], ",", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"i", " ", "<", " ", "j"}], ",", " ", 
           RowBox[{
            RowBox[{"s", "[", 
             RowBox[{"i", ",", " ", "j"}], "]"}], " ", "+", " ", 
            RowBox[{"I", " ", 
             RowBox[{"u", "[", 
              RowBox[{"i", ",", " ", "j"}], "]"}]}]}], ",", " ", 
           RowBox[{
            RowBox[{"s", "[", 
             RowBox[{"j", ",", " ", "i"}], "]"}], " ", "-", " ", 
            RowBox[{"I", " ", 
             RowBox[{"u", "[", 
              RowBox[{"j", ",", " ", "i"}], "]"}]}]}]}], "]"}]}], "]"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"hh", " ", "=", " ", 
     RowBox[{"herm", "[", 
      RowBox[{"a", ",", " ", "ai"}], "]"}]}], ";", " ", 
    RowBox[{"rr", " ", "=", " ", 
     RowBox[{"herm", "[", 
      RowBox[{"b", ",", " ", "bi"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dR", " ", "=", " ", 
     RowBox[{
      RowBox[{"-", "I"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"hh", " ", ".", " ", "rr"}], " ", "-", " ", 
        RowBox[{"rr", " ", ".", " ", "hh"}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"consOK", " ", "=", " ", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{
        RowBox[{"ComplexExpand", "[", 
         RowBox[{"Tr", "[", 
          RowBox[{"hh", " ", ".", " ", "dR"}], "]"}], "]"}], ",", " ", 
        RowBox[{"Element", "[", 
         RowBox[{"_", ",", " ", "Reals"}], "]"}]}], "]"}], " ", "===", " ", 
      "0"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"R", "^", "2"}], " ", "=", " ", 
      RowBox[{
       RowBox[{"R", " ", "is", " ", 
        RowBox[{"kept", ":", " ", 
         RowBox[{"d", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"R", "^", "2"}], " ", "-", " ", "R"}], ")"}], "/", 
           "dt"}]}]}]}], " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"dR", " ", "R"}], " ", "+", " ", 
         RowBox[{"R", " ", "dR"}], " ", "-", " ", 
         RowBox[{"dR", " ", "vanishes", " ", "at", " ", 
          RowBox[{"R", "^", "2"}]}]}], " ", "=", " ", "R"}]}]}], ";", " ", 
     RowBox[{
      RowBox[{"with", " ", "R"}], " ", "=", " ", 
      RowBox[{
      "P", " ", "a", " ", "projector", " ", "of", " ", "rank", " ", "1"}]}]}],
     " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"pv", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"p1", ",", " ", "p2", ",", " ", "p3"}], "}"}]}], ";", " ", 
    RowBox[{"proj", " ", "=", " ", 
     RowBox[{"Outer", "[", 
      RowBox[{"Times", ",", " ", "pv", ",", " ", 
       RowBox[{"Conjugate", "[", "pv", "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dP", " ", "=", " ", 
     RowBox[{
      RowBox[{"-", "I"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"hh", " ", ".", " ", "proj"}], " ", "-", " ", 
        RowBox[{"proj", " ", ".", " ", "hh"}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"projOK2", " ", "=", " ", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{"ComplexExpand", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"dP", " ", ".", " ", "proj"}], " ", "+", " ", 
           RowBox[{"proj", " ", ".", " ", "dP"}], " ", "-", " ", "dP"}], 
          ")"}], " ", "/.", " ", 
         RowBox[{"Thread", "[", 
          RowBox[{"pv", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "0", ",", " ", "0"}], "}"}]}], "]"}]}], 
        "]"}], "]"}], " ", "===", " ", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "3"}], "}"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"hermOK", " ", "=", " ", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{
        RowBox[{"ComplexExpand", "[", 
         RowBox[{
          RowBox[{"ConjugateTranspose", "[", "dR", "]"}], " ", "-", " ", 
          "dR"}], "]"}], ",", " ", 
        RowBox[{"Element", "[", 
         RowBox[{"_", ",", " ", "Reals"}], "]"}]}], "]"}], " ", "===", " ", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "3"}], "}"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rvCheck", "[", 
     RowBox[{"\"\<WD-1\>\"", ",", 
      " ", "\"\<the time-dependent mean field i dR/dt = [H, R] conserves tr(H \
R) when H is the derivative of the energy \\\n(d tr(H R)/dt = -i tr(H [H, R]) \
= 0), keeps R Hermitian, and keeps a projector a projector (symbolic, 3 x 3 \
Hermitian matrices \\\nwith symbolic entries; the projector of rank 1 along \
the first axis)\>\"", ",", " ", 
      RowBox[{"consOK", " ", "&&", " ", "hermOK", " ", "&&", " ", "projOK2"}],
       ",", "\n", "  ", 
      RowBox[{"\"\<energy \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", "consOK", "]"}], " ", "<>", 
