         FontSlant->"Plain"], 
        StyleBox["SF",
         FontSlant->"Plain"], "\[Dagger]"], 
       RowBox[{"-", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SubscriptBox[
            StyleBox["h",
             FontFamily->"Helvetica",
