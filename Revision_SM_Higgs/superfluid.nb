      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", " ", 
         RowBox[{"|", "p_perp", "|"}]}], "}"}], " ", "of", " ", "the", " ", 
       "method", " ", "t", " ", "at", " ", "the", " ", "temperature", " ", 
       "temp", " ", "for", " ", "the", " ", "twist", " ", "q", " ", 
       RowBox[{"alpha", "^", "3"}], " ", 
       RowBox[{"(", "x", ")"}], " ", "t2"}]}], ",", "\n", "   ", 
     RowBox[{"on", " ", "the", " ", "nodes", " ", 
      RowBox[{"{", 
       RowBox[{"qs", ",", " ", "ws"}], "}"}], " ", 
