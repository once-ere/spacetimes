Cell[CellGroupData[{

Cell["\<\
R.3.3 The closed forms of the pairing-only method HS (0, 0) (check WH-3)\
\>", "Subsection",ExpressionUUID->"84ed762b-2f59-4273-b851-a4e155f3fad8"],

Cell[TextData[{
 "In HS (0, 0) the states with a fixed pair self-energy ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["d", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7122f3ce-c7cd-4900-bf7f-026ae75d4779"],
 " along the vacuum direction have the quasi-particle energies ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       StyleBox["q", "TI"], "2"], "+", 
      SuperscriptBox[
       StyleBox["M", "TI"], "2"]}], ")"}], 
    RowBox[{"1", "/", "2"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e6cc4696-d975-48ef-a592-d935dbaccb2f"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["M", "TI"], "2"], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "2"], "+", 
    SubsuperscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], "2"], "/", "4"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a57fa164-abcd-45b9-b641-5a6b1328e693"],
 ", and the effective potential has closed forms. The gap equation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["G", "TI"], 
       StyleBox["SH",
        FontSlant->"Plain"]], "/", "4", 
      SuperscriptBox["\[Pi]", "2"]}], ")"}], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["I", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{"(", "1", ")"}]], 
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["M", "TI"], 
      StyleBox["SH",
       FontSlant->"Plain"], 
      StyleBox["eff",
       FontSlant->"Plain"]], ")"}], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b5fd133a-ad6b-4181-9e23-d0edfe1b2a18"],
 " gives ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["d", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"], "0"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dae6ade3-1a61-49c8-8914-5a9997c00c41"],
 "; the pair amplitude of the ground state is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CurlyPhi]", 
     StyleBox["SH",
      FontSlant->"Plain"], "0"], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], "0"], 
    SubsuperscriptBox[
     StyleBox["I", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{"(", "1", ")"}]], 
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["M", "TI"], 
      StyleBox["SH",
       FontSlant->"Plain"], 
      StyleBox["eff",
       FontSlant->"Plain"]], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"4", 
      SuperscriptBox["\[Pi]", "2"]}], ")"}], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], "0"], "/", 
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fc3798a3-6e6b-4d89-9963-d50d07431789"],
 ". With ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], 
    SubsuperscriptBox[
     StyleBox["I", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{"(", "1", ")"}]], "/", 
    StyleBox["dM", "TI"], "\[LongEqual]", 
    RowBox[{"-", 
     StyleBox["M", "TI"]}], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["J", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     RowBox[{"(", "3", ")"}]], 
    RowBox[{"(", 
     StyleBox["M", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d56f4190-3aa2-4fd3-8632-bc7c5c0139f7"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["J", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     RowBox[{"(", "3", ")"}]], 
    RowBox[{"(", 
     StyleBox["M", "TI"], ")"}], "\[LongEqual]", 
    SubsuperscriptBox["\[Integral]", "0", "1"], "\[ThinSpace]", 
    SuperscriptBox[
     StyleBox["q", "TI"], "2"], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        StyleBox["q", "TI"], "2"], "+", 
       SuperscriptBox[
        StyleBox["M", "TI"], "2"]}], ")"}], 
     RowBox[{
      RowBox[{"-", "3"}], "/", "2"}]], 
    StyleBox["dq", "TI"], "\[LongEqual]", 
    StyleBox["arsinh",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{"1", "/", 
      StyleBox["M", "TI"]}], ")"}], "-", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "+", 
       SuperscriptBox[
        StyleBox["M", "TI"], "2"]}], ")"}], 
     RowBox[{
      RowBox[{"-", "1"}], "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "412a6a1f-44b2-42dc-b814-ab837952ef50"],
 ", the curvature of the potential of one pair at its minimum is"
}], "Text",ExpressionUUID->"23b14b02-d11c-42de-8aeb-407f4b8445eb"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["eff",
      FontSlant->"Plain"], "\[ThinSpace]", "\[Prime]", "\[Prime]"}]], 
   RowBox[{"(", 
    SubsuperscriptBox["\[CurlyPhi]", 
     StyleBox["SH",
      FontSlant->"Plain"], "0"], ")"}], "\[LongEqual]", 
   FractionBox[
    RowBox[{"2", 
     SuperscriptBox["\[Pi]", "2"], 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["d", "TI"], 
        StyleBox["SH",
         FontSlant->"Plain"], "0"], ")"}], "2"], 
     SubsuperscriptBox[
      StyleBox["J", "TI"], 
      StyleBox["SH",
       FontSlant->"Plain"], 
      RowBox[{"(", "3", ")"}]]}], 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["I", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{"(", "1", ")"}]], 
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["I", "TI"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{"(", "1", ")"}]], "-", 
       SuperscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox[
          StyleBox["d", "TI"], 
          StyleBox["SH",
           FontSlant->"Plain"], "0"], ")"}], "2"], 
       SubsuperscriptBox[
        StyleBox["J", "TI"], 
        StyleBox["SH",
