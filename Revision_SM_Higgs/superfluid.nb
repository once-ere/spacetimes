           RowBox[{"(", 
            RowBox[{"-", 
             SubscriptBox[
              OverscriptBox[
               StyleBox["q", "TI"], "\[RightVector]"], 
              StyleBox["LL",
               FontSlant->"Plain"]]}], ")"}], "+", 
           SubscriptBox[
            StyleBox["N",
             FontFamily->"Helvetica",
