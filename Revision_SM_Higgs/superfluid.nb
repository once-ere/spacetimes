Cell[CellGroupData[{

Cell["I.5 The Lagrangian and the field equations (item 4)", "Section",ExpressionUUID->"3aba5da4-7dc1-4ed4-9090-4e606d553935"],

Cell[TextData[{
 "The Lagrangian density of the solution is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["\[ScriptCapitalL]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalL]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], "\[CapitalPsi]"], "+", 
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalL]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["self",
      FontSlant->"Plain"]], "+", 
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalL]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["YM",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d40c4a92-1ea1-4a26-91c5-0bade2946a89"],
 ", with the Dirac part ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalL]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], "\[CapitalPsi]"], "\[LongEqual]", 
    SubscriptBox[
     OverscriptBox["\[CapitalPsi]", "_"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["i", "TI"], "\[ThinSpace]", 
      UnderscriptBox["\[Sum]", 
       StyleBox["p", "TI"],
       LimitsPositioning->True], "\[ThinSpace]", 
      SubsuperscriptBox["\[Gamma]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["p", "TI"]], 
      SubsuperscriptBox["\[Del]", 
       StyleBox["p", "TI"], 
       StyleBox["GEE",
        FontSlant->"Plain"]], "-", 
      SubscriptBox[
       StyleBox["m", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}], 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "268a0f79-b108-436a-9f73-c636b8f9003f"],
 ", the Yang-Mills part ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalL]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["YM",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"-", 
     FractionBox["1", "4"]}], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", "\[Iota]",
     LimitsPositioning->True], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["W", "TI"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}], "\[Iota]"], 
    SubsuperscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{"\[Iota]", ",", 
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], "-", 
    FractionBox["1", "4"], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["B", "TI"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], 
    SubsuperscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f4574fa5-a288-4c82-8d9c-77b14298ae70"],
 ", and the self-interaction ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalL]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["self",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"-", 
     SubsuperscriptBox[
      StyleBox["V", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       StyleBox["n", "TI"], ")"}]]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "74b0b76e-8cb4-4838-8ea4-56f0c7911ef3"],
 ", a normal-ordered GEE-invariant contact interaction. Its first two steps \
are"
}], "Text",ExpressionUUID->"5e35a728-0c17-492d-9c26-3a451f7c4e70"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "0", ")"}]], "\[LongEqual]", 
   FractionBox["1", "2"], 
   SubsuperscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["S",
     FontSlant->"Plain"]], ":", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       OverscriptBox["\[CapitalPsi]", "_"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      SubscriptBox["\[CapitalPsi]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}], "2"], ":", 
   RowBox[{"+", 
    FractionBox["1", "2"]}], 
   SubsuperscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["V",
     FontSlant->"Plain"]], "\[ThinSpace]", 
   UnderscriptBox["\[Sum]", 
    StyleBox["p", "TI"],
    LimitsPositioning->True], "\[ThinSpace]", 
   SubsuperscriptBox["\[Eta]", 
    StyleBox["pp", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], ":", 
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["j", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["F",
        FontSlant->"Plain"], ",", 
       StyleBox["p", "TI"]}]], ")"}], "2"], ":", ",", "      ", 
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "1", ")"}]], "\[LongEqual]", 
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "0", ")"}]], "-", 
   FractionBox["1", "4"], 
   SubscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], "\[ThinSpace]", 
   UnderscriptBox["\[Sum]", "\[Iota]",
    LimitsPositioning->True], ":", 
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox["\[CapitalPi]", 
      StyleBox["LL",
       FontSlant->"Plain"], "\[Iota]"], ")"}], "\[Dagger]"], 
   SubsuperscriptBox["\[CapitalPi]", 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Iota]"], ":", ","}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"4f711972-bfe4-4f40-8595-6adff0d506df"],

Cell[TextData[{
 "with the fermion-number current ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["j", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["F",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}]], "\[LongEqual]", 
    SubscriptBox[
     OverscriptBox["\[CapitalPsi]", "_"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p", "TI"]], 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "72e5c4e4-b736-4c08-8f0a-075242a804a9"],
 " and the pair operators ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalPi]", 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Iota]"], "\[LongEqual]", 
    SubsuperscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["T", "TI"]], 
    SubsuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Iota]"], 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "abf642f2-369f-4608-9406-7c0cd4741d38"],
 " of one point. ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "0", ")"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "aee500af-98e5-45a3-862c-21382023e911"],
 " is formed after the author's Kohn-Sham ansatz, whose interaction energy \
density of uniform matter is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], 
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["V", "TI"]], 
    SuperscriptBox[
     StyleBox["n", "TI"], "2"], "+", 
    FractionBox["1", "2"], 
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["S", "TI"]], 
    SubsuperscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["S", "TI"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "402373a3-d493-4f03-8286-cb7819a683c6"],
 "; ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "1", ")"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3769ce07-ca3d-412f-9220-3678c017a943"],
 " adds the attraction in the spin-zero pair channel. Varying the action with \
respect to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox["\[CapitalPsi]", "_"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "65213ef0-a43f-4cbb-be86-c4e536b9863d"],
 " gives the field equation of the spinor field,"
}], "Text",ExpressionUUID->"b0ebeffb-dccd-47d7-827b-b20319fc5229"],

Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox["i", "TI"], "\[ThinSpace]", 
   UnderscriptBox["\[Sum]", 
    StyleBox["p", "TI"],
    LimitsPositioning->True], "\[ThinSpace]", 
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p", "TI"]], 
   SubsuperscriptBox["\[Del]", 
    StyleBox["p", "TI"], 
    StyleBox["GEE",
     FontSlant->"Plain"]], 
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], "-", 
   SubscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], "\[LongEqual]", 
   SubsuperscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["S",
     FontSlant->"Plain"]], 
   RowBox[{"(", 
    RowBox[{
     SubscriptBox[
      OverscriptBox["\[CapitalPsi]", "_"], 
      StyleBox["LL",
       FontSlant->"Plain"]], 
     SubscriptBox["\[CapitalPsi]", 
      StyleBox["LL",
       FontSlant->"Plain"]]}], ")"}], 
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], "+", 
   SubsuperscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["V",
     FontSlant->"Plain"]], "\[ThinSpace]", 
   UnderscriptBox["\[Sum]", 
    StyleBox["p", "TI"],
    LimitsPositioning->True], "\[ThinSpace]", 
   SubsuperscriptBox[
    StyleBox["j", "TI"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}], 
    StyleBox["F",
     FontSlant->"Plain"]], 
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p", "TI"]], 
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], "-", 
   FractionBox["1", "2"], 
   SubscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], "\[ThinSpace]", 
   UnderscriptBox["\[Sum]", "\[Iota]",
    LimitsPositioning->True], "\[ThinSpace]", 
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], "0"], 
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], "\[Iota]"], ")"}], "\[Dagger]"], 
   SubsuperscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"], "*"], "\[ThinSpace]", 
   SubsuperscriptBox["\[CapitalPi]", 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Iota]"], ","}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"aa55dff0-de25-4cd4-b4a4-5df313724eeb"],

Cell[TextData[{
 "and varying with respect to the gauge fields gives the Yang-Mills equations \
with the currents of the spinor field as sources, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["p", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubscriptBox["\[PartialD]", 
     StyleBox["p", "TI"]], 
    SubsuperscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{"\[Iota]", ",", 
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], "-", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      SuperscriptBox["\[Iota]", "\[Prime]"], 
      SuperscriptBox["\[Iota]", "\[Prime]\[Prime]"]}],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox["\[Epsilon]", 
     RowBox[{"\[Iota]", 
      SuperscriptBox["\[Iota]", "\[Prime]"], 
      SuperscriptBox["\[Iota]", "\[Prime]\[Prime]"]}], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", 
     StyleBox["p", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["W", "TI"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], 
     SuperscriptBox["\[Iota]", "\[Prime]"]], 
    SubsuperscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      SuperscriptBox["\[Iota]", "\[Prime]\[Prime]"], ",", 
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["j", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{"\[Iota]", ",", 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0b07bd76-1ba0-42cf-9ece-49b5c7442861"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["p", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubscriptBox["\[PartialD]", 
     StyleBox["p", "TI"]], 
    SubsuperscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["j", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["F",
       FontSlant->"Plain"], ",", 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9430b5f3-ed7c-4053-8fbe-7208cf5ecbbe"],
 "."
}], "Text",ExpressionUUID->"10c8e8fe-c797-48e8-a546-1ac0a63fdb5b"],

Cell[TextData[{
 "The right side of the field equation of the spinor field is the commutator \
of the field with the Hamiltonian of the contact terms. The next cell checks \
this exactly, as an identity of operators on the Fock space of the eight \
components of one point (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["2", "8"], "\[LongEqual]", "256"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ce1af7f6-1d25-4dc8-b0e2-5d7c9101006c"],
 " states), for each contact term: with the Hamiltonians ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["S",
      FontSlant->"Plain"]], "\[LongEqual]", 
    FractionBox["1", "2"], 
    SuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["S",
      FontSlant->"Plain"]], ":", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["\[CapitalPsi]", "\[Dagger]"], "\[Beta]", 
       "\[CapitalPsi]"}], ")"}], "2"], ":"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2563edfa-4d08-4bcc-811f-9376b53c93ff"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["V",
      FontSlant->"Plain"]], "\[LongEqual]", 
    FractionBox["1", "2"], 
    SuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["V",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     RowBox[{":", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["\[CapitalPsi]", "\[Dagger]"], "\[CapitalPsi]"}], 
        ")"}], "2"], ":", 
      RowBox[{"-", 
       UnderscriptBox["\[Sum]", 
        StyleBox["j", "TI"],
        LimitsPositioning->True]}], ":", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["\[CapitalPsi]", "\[Dagger]"], 
         SuperscriptBox["\[Alpha]", 
          StyleBox["j", "TI"]], "\[CapitalPsi]"}], ")"}], "2"], ":"}], 
     ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cadfffc8-4cd5-4a01-848f-77c7651ffff6"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["P",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"-", 
     FractionBox["1", "4"]}], 
    StyleBox["G", "TI"], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", "\[Iota]",
     LimitsPositioning->True], "\[ThinSpace]", 
    SuperscriptBox["\[CapitalPi]", 
     RowBox[{"\[Iota]", "\[Dagger]"}]], 
    SuperscriptBox["\[CapitalPi]", "\[Iota]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8004d4e8-4b11-40b2-8195-31f992eedded"],
 ", the commutators ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{
     SubscriptBox["\[CapitalPsi]", 
      StyleBox["e", "TI"]], ",", 
     StyleBox["H", "TI"]}], "]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "735133ed-91a8-42f0-a92f-b4b99ffdaeab"],
 " equal ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["S",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     RowBox[{
      OverscriptBox["\[CapitalPsi]", "_"], "\[CapitalPsi]"}], ")"}], 
    SubscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["\[Gamma]", "0"], "\[CapitalPsi]"}], ")"}], 
     StyleBox["e", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "59fd4d1f-429d-4815-8f5f-06feb8648069"],
 ", the vector term, and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", "2"]}], 
    StyleBox["G", "TI"], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", "\[Iota]",
     LimitsPositioning->True], 
    SubscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        StyleBox["K",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        RowBox[{"\[Iota]", "\[Dagger]"}]], 
       SuperscriptBox["\[CapitalPsi]", "*"]}], ")"}], 
     StyleBox["e", "TI"]], 
    SuperscriptBox["\[CapitalPi]", "\[Iota]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e8c291b5-ab2e-4659-8dc4-8d719f868d18"],
 ". The couplings of the test are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["S",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"-", "8"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "43b17400-3083-4311-888f-feb7144b2ac5"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["V",
      FontSlant->"Plain"]], "\[LongEqual]", "4", "/", "5"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1b61f49b-f6aa-4fe2-b673-5a7564eee3ef"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["G", "TI"], "\[LongEqual]", "45", "/", "2"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c6f1596b-69a8-45ca-a882-65b19a8ad76b"],
 ", exact numbers, so every deviation must be exactly 0. The last check of \
the cell derives the Yang-Mills equations with a source symbolically, with \
the function ",
 StyleBox["EulerEquations",
  FontFamily->"Source Code Pro"],
 " of the package ",
 StyleBox["VariationalMethods",
  FontFamily->"Source Code Pro"],
 " of the Wolfram Language, and compares all twelve equations with the form \
above."
}], "Text",ExpressionUUID->"37f7a30b-29d7-4967-99b1-17e7ec8ad14f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", "annihilation", " ", "operators", " ", "c_e", " ", 
     RowBox[{"(", 
      RowBox[{"e", " ", "=", " ", 
       RowBox[{
        RowBox[{"1", ".."}], "8"}]}], ")"}], " ", "of", " ", "the", " ", 
     "eight", " ", "components", " ", "and", " ", "their", " ", "adjoints"}], 
    ",", " ", 
    RowBox[{"256", " ", "x", " ", "256", " ", "sparse", " ", "matrices"}]}], 
   " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"cOps", " ", "=", " ", 
     RowBox[{"fockOps", "[", "8", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"cdOps", " ", "=", " ", 
     RowBox[{"ConjugateTranspose", " ", "/@", " ", "cOps"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"bilinear", "[", "a", "]"}], ":", " ", 
     RowBox[{"sum_ij", " ", "a_ij", " ", 
      RowBox[{"c_i", "^", "dag"}], " ", "c_j"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"bilinear", "[", "a_", "]"}], " ", ":=", " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"a", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", " ", "j"}], "]"}], "]"}], " ", "=!=", " ", 
          "0"}], ",", " ", 
         RowBox[{
          RowBox[{"a", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", " ", "j"}], "]"}], "]"}], " ", 
          RowBox[{
           RowBox[{"cdOps", "[", 
            RowBox[{"[", "i", "]"}], "]"}], " ", ".", " ", 
           RowBox[{"cOps", "[", 
            RowBox[{"[", "j", "]"}], "]"}]}]}], ",", " ", "0"}], "]"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "8"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "8"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"quartic", "[", 
      RowBox[{"a", ",", " ", "b"}], "]"}], ":", " ", 
     RowBox[{
      RowBox[{"the", " ", "normal"}], "-", 
      RowBox[{
      "ordered", " ", "product", " ", "sum_ijkl", " ", "a_ij", " ", "b_kl", " ", 
       RowBox[{"c_i", "^", "dag"}], " ", 
       RowBox[{"c_k", "^", "dag"}], " ", "c_l", " ", "c_j"}]}]}], " ", "*)"}],
    "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"quartic", "[", 
      RowBox[{"a_", ",", " ", "b_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"a", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", " ", "j"}], "]"}], "]"}], " ", "=!=", " ", 
           "0"}], " ", "&&", " ", 
          RowBox[{
           RowBox[{"b", "[", 
            RowBox[{"[", 
             RowBox[{"k", ",", " ", "l"}], "]"}], "]"}], " ", "=!=", " ", 
           "0"}]}], ",", " ", 
         RowBox[{
          RowBox[{"a", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", " ", "j"}], "]"}], "]"}], " ", 
          RowBox[{"b", "[", 
           RowBox[{"[", 
            RowBox[{"k", ",", " ", "l"}], "]"}], "]"}], " ", 
          RowBox[{
           RowBox[{"cdOps", "[", 
            RowBox[{"[", "i", "]"}], "]"}], " ", ".", " ", 
           RowBox[{"cdOps", "[", 
            RowBox[{"[", "k", "]"}], "]"}], " ", ".", " ", 
           RowBox[{"cOps", "[", 
            RowBox[{"[", "l", "]"}], "]"}], " ", ".", " ", 
           RowBox[{"cOps", "[", 
            RowBox[{"[", "j", "]"}], "]"}]}]}], ",", " ", "0"}], "]"}], ",", 
       "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "8"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "8"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", "8"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"l", ",", " ", "8"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"gScal", ",", " ", "gVec", ",", " ", 
     RowBox[{"gPair", ":", " ", 
      RowBox[{
      "the", " ", "exact", " ", "couplings", " ", "of", " ", "the", " ", 
       "test"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"gScal", ",", " ", "gVec", ",", " ", "gPair"}], "}"}], " ", "=",
      " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "8"}], ",", " ", 
       RowBox[{"4", "/", "5"}], ",", " ", 
       RowBox[{"45", "/", "2"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"beta8", " ", "=", " ", 
     RowBox[{"d8", "[", "betaLL", "]"}]}], ";", " ", 
    RowBox[{"alpha8", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"d8", "[", 
        RowBox[{"alphaLL", "[", "j", "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"hS", " ", "=", " ", 
     RowBox[{
      RowBox[{"gScal", "/", "2"}], " ", 
      RowBox[{"quartic", "[", 
       RowBox[{"beta8", ",", " ", "beta8"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"hV", " ", "=", " ", 
     RowBox[{
      RowBox[{"gVec", "/", "2"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"quartic", "[", 
         RowBox[{
          RowBox[{"IdentityMatrix", "[", "8", "]"}], ",", " ", 
          RowBox[{"IdentityMatrix", "[", "8", "]"}]}], "]"}], " ", "-", " ", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{"quartic", "[", 
           RowBox[{
            RowBox[{"alpha8", "[", 
             RowBox[{"[", "j", "]"}], "]"}], ",", " ", 
            RowBox[{"alpha8", "[", 
             RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}], ")"}]}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", "pair", " ", "operators", " ", 
      RowBox[{"Pi", "^", "iota"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{
      "sum_ij", " ", "K_ij", " ", "c_i", " ", "c_j", " ", "and", " ", "the", " ",
        "pairing", " ", "Hamiltonian"}], " ", "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"G", "/", "4"}], ")"}], " ", "sum", " ", 
       RowBox[{"Pi", "^", "dag"}], " ", "Pi"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"piOps", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"k", " ", "=", " ", 
           RowBox[{"kLL", "[", "iota", "]"}]}], "}"}], ",", " ", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"k", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", " ", "j"}], "]"}], "]"}], " ", "=!=", " ", 
              "0"}], ",", " ", 
             RowBox[{
              RowBox[{"k", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", " ", "j"}], "]"}], "]"}], " ", 
              RowBox[{
               RowBox[{"cOps", "[", 
                RowBox[{"[", "i", "]"}], "]"}], " ", ".", " ", 
               RowBox[{"cOps", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}]}], ",", " ", "0"}], "]"}], ",",
            " ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "8"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"j", ",", " ", "8"}], "}"}]}], "]"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"iota", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"hP", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "gPair"}], "/", "4"}], " ", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ConjugateTranspose", "[", 
          RowBox[{"piOps", "[", 
           RowBox[{"[", "k", "]"}], "]"}], "]"}], " ", ".", " ", 
         RowBox[{"piOps", "[", 
          RowBox[{"[", "k", "]"}], "]"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nBeta", " ", "=", " ", 
     RowBox[{"bilinear", "[", "beta8", "]"}]}], ";", " ", 
    RowBox[{"nOne", " ", "=", " ", 
     RowBox[{"bilinear", "[", 
      RowBox[{"IdentityMatrix", "[", "8", "]"}], "]"}]}], ";", " ", 
    RowBox[{"nAlpha", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"bilinear", "[", 
        RowBox[{"alpha8", "[", 
         RowBox[{"[", "j", "]"}], "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"lin", "[", "v", "]"}], " ", "=", " ", 
     RowBox[{"sum_b", " ", "v_b", " ", "c_b"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"lin", "[", "v_", "]"}], " ", ":=", " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"v", "[", 
         RowBox[{"[", "b", "]"}], "]"}], " ", 
        RowBox[{"cOps", "[", 
         RowBox[{"[", "b", "]"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"b", ",", " ", "8"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dE2", ",", " ", "dE3", ",", " ", "dE4"}], "}"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", "\n", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"dE2", " ", "=", " ", 
        RowBox[{"Max", "[", 
         RowBox[{"dE2", ",", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{"Normal", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"cOps", "[", 
                RowBox[{"[", "e", "]"}], "]"}], " ", ".", " ", "hS"}], " ", "-",
               " ", 
              RowBox[{"hS", " ", ".", " ", 
               RowBox[{"cOps", "[", 
                RowBox[{"[", "e", "]"}], "]"}]}], " ", "-", " ", 
              RowBox[{"gScal", " ", 
               RowBox[{"nBeta", " ", ".", " ", 
                RowBox[{"lin", "[", 
                 RowBox[{"beta8", "[", 
                  RowBox[{"[", "e", "]"}], "]"}], "]"}]}]}]}], "]"}], "]"}], 
           "]"}]}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"dE3", " ", "=", " ", 
        RowBox[{"Max", "[", 
         RowBox[{"dE3", ",", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{"Normal", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"cOps", "[", 
                RowBox[{"[", "e", "]"}], "]"}], " ", ".", " ", "hV"}], " ", "-",
               " ", 
              RowBox[{"hV", " ", ".", " ", 
               RowBox[{"cOps", "[", 
                RowBox[{"[", "e", "]"}], "]"}]}], " ", "-", " ", 
              RowBox[{"gVec", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"nOne", " ", ".", " ", 
                  RowBox[{"cOps", "[", 
                   RowBox[{"[", "e", "]"}], "]"}]}], " ", "-", " ", 
                 RowBox[{"Sum", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"nAlpha", "[", 
