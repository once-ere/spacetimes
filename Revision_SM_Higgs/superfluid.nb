          "}"}]}], "]"}], ",", " ", "1"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"Grid", "[", 
      RowBox[{
       RowBox[{"Prepend", "[", 
        RowBox[{"r8Rows", ",", " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<pair\>\"", ",", " ", "\"\<Y Y (B)\>\"", ",", 
           " ", "\"\<Q Q (photon)\>\""}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
       RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}], "]"}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "the", " ", "strongest", " ", "attraction", " ", "against", " ", "the", " ",
      "critical", " ", "strength", " ", 
     RowBox[{"pi", "/", "3"}], " ", "of", " ", "the", " ", "ladder", " ", 
     "approximation"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"r8Alpha", " ", "=", " ", 
     RowBox[{"1", "/", "137.036"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<(9/16) alpha = \>\"", ",", " ", 
      RowBox[{"ToString", "[", 
       RowBox[{"NumberForm", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"9", "/", "16"}], " ", "r8Alpha"}], ",", " ", "3"}], "]"}], 
       "]"}], ",", " ", "\"\<; pi/3 = \>\"", ",", " ", 
      RowBox[{"ToString", "[", 
       RowBox[{"NumberForm", "[", 
        RowBox[{
         RowBox[{"N", "[", 
          RowBox[{"Pi", "/", "3"}], "]"}], ",", " ", "4"}], "]"}], "]"}], ",",
       "\n", "  ", "\"\<; ratio \>\"", ",", " ", 
      RowBox[{"ToString", "[", 
       RowBox[{"NumberForm", "[", 
        RowBox[{
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{"Pi", "/", "3"}], "/", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"9", "/", "16"}], " ", "r8Alpha"}], ")"}]}], "]"}], ",", 
         " ", "4"}], "]"}], "]"}]}], "]"}], ";"}]}]}]], "Input",
