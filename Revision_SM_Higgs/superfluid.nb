            RowBox[{"Abs", "[", 
             RowBox[{"lfE0", "[", "#", "]"}], "]"}]}], "]"}], " ", "&"}]}], 
        "}"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<sign changes of the residual of the Landau form\>\"", ",",
          " ", 
         RowBox[{
          RowBox[{
           RowBox[{"lfResults", "[", "#", "]"}], "[", "\"\<signs\>\"", "]"}], 
          " ", "&"}]}], "}"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<10^3 c fitted on [0, Phi0]\>\"", ",", " ", 
         RowBox[{
          RowBox[{"NumberForm", "[", 
           RowBox[{
            RowBox[{"1000", " ", 
             RowBox[{
              RowBox[{"lfResults", "[", "#", "]"}], "[", "\"\<rng1_c\>\"", 
              "]"}]}], ",", " ", "4"}], "]"}], " ", "&"}]}], "}"}], ",", "\n",
        "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<10^3 c fitted on [0, 1.4 Phi0]\>\"", ",", " ", 
         RowBox[{
          RowBox[{"NumberForm", "[", 
           RowBox[{
            RowBox[{"1000", " ", 
             RowBox[{
              RowBox[{"lfResults", "[", "#", "]"}], "[", "\"\<rng2_c\>\"", 
              "]"}]}], ",", " ", "4"}], "]"}], " ", "&"}]}], "}"}], ",", "\n",
        "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<10^3 c fitted on the whole curve\>\"", ",", " ", 
         RowBox[{
          RowBox[{"NumberForm", "[", 
           RowBox[{
            RowBox[{"1000", " ", 
             RowBox[{
              RowBox[{"lfResults", "[", "#", "]"}], "[", "\"\<rng3_c\>\"", 
              "]"}]}], ",", " ", "4"}], "]"}], " ", "&"}]}], "}"}], ",", "\n",
        "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<10^3 c of the fit with powers to Phi^8\>\"", ",", " ", 
         RowBox[{
          RowBox[{"NumberForm", "[", 
           RowBox[{
            RowBox[{"1000", " ", 
             RowBox[{
              RowBox[{"lfResults", "[", "#", "]"}], "[", "\"\<cK4\>\"", 
              "]"}]}], ",", " ", "4"}], "]"}], " ", "&"}]}], "}"}]}], "}"}]}],
     ";"}], "\n", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{"row", ",", " ", 
           RowBox[{"Prepend", "[", 
            RowBox[{
             RowBox[{"Map", "[", 
              RowBox[{
               RowBox[{"row", "[", 
                RowBox[{"[", "2", "]"}], "]"}], ",", " ", "lfTags"}], "]"}], ",",
              " ", 
             RowBox[{"row", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], "]"}], ",", " ", 
         "lfRows"}], "]"}], ",", " ", 
       RowBox[{"Prepend", "[", 
        RowBox[{
         RowBox[{"lfName", " ", "/@", " ", "lfTags"}], ",", 
         " ", "\"\<quantity\>\""}], "]"}]}], "]"}], ",", "\n", "  ", 
     RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
     RowBox[{"Alignment", " ", "->", " ", "Left"}], ",", " ", 
     RowBox[{"BaseStyle", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"FontSize", " ", "->", " ", "9"}], "}"}]}]}], 
    "]"}]}]}]], "Input",
