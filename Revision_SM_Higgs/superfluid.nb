Cell[CellGroupData[{

Cell["\<\
R.3.4 The scale in GeV and the comparison with the Standard Model (check WH-4)\
\>", "Subsection",ExpressionUUID->"679a64fb-40f8-4f0a-aa8e-87d3c5c5ba2e"],

Cell[TextData[{
 "The model has the unit ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8640ac3a-42eb-47f5-85c2-14a698aa73d8"],
 ". Setting ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["v", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b59523d0-10df-49a7-8fbf-0858e87447c5"],
 " equal to the scale ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["v", "TI"], "\[LongEqual]", "246.22"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c0ba037b-d070-425f-9ef6-5c4ba7d9f3f9"],
 " GeV of the Standard Model fixes the cutoff, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    StyleBox["v", "TI"], "/", 
    SubscriptBox[
     StyleBox["v", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "18418a66-7409-4cae-ba02-da4864b1c5d9"],
 " in GeV, and converts the frequency of the amplitude mode into the mass ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["H",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubsuperscriptBox["\[Omega]", 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["H",
      FontSlant->"Plain"]], 
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0f3199ee-d591-4df2-9449-3ea7d39741ac"],
 ", with the ratio ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["H",
      FontSlant->"Plain"]], "/", 
    StyleBox["v", "TI"], "\[LongEqual]", 
    SubsuperscriptBox["\[Omega]", 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["H",
      FontSlant->"Plain"]], "/", 
    SubscriptBox[
     StyleBox["v", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b39da792-b9c1-4e3e-892d-a59d9c150181"],
 " independent of the conversion. The Standard Model has ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["H", "TI"]], "/", 
    StyleBox["v", "TI"], "\[LongEqual]", "125.13", "/", "246.22"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bb068045-6171-4586-8ee0-19333b4b1f28"],
 ". The cell checks every row of the table of masses of the Rust program in \
exact rational arithmetic on its numbers and prints the range of the ratios."
}], "Text",ExpressionUUID->"c17a8925-3082-420e-b97d-c60181923316"],

