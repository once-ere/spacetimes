Cell[TextData[{
 StyleBox["The exchange of the gauge bosons.",
  FontWeight->"Bold"],
 " Beyond their contact limit, the four gauge bosons are exchanged between \
the charges with the propagator ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"\[LeftBracketingBar]", 
        RowBox[{
         OverscriptBox[
          StyleBox["q", "TI"], "\[RightVector]"], "-", 
         RowBox[{
          OverscriptBox[
           StyleBox["q", "TI"], "\[RightVector]"], "\[ThinSpace]", 
          SuperscriptBox["", "\[Prime]"]}]}], "\[RightBracketingBar]"}], "2"],
       "+", 
      SuperscriptBox[
       StyleBox["M", "TI"], "2"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7b64bb2d-6a3e-465f-b543-263343ac9233"],
 " of a boson of mass ",
 Cell[BoxData[
  FormBox[
   StyleBox["M", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d1e93e17-9f7a-4bde-bc7b-345b3c4f0feb"],
 ". In a uniform state the exchange self-energies at the momentum ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["q", "TI"], "\[RightVector]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4eebd1c7-098a-49c3-8c9a-83c86772617a"],
 " are integrals over ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     StyleBox["q", "TI"], "\[RightVector]"], "\[ThinSpace]", 
    SuperscriptBox["", "\[Prime]"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c3cc60b5-994f-4f26-bf93-30618f8a89fe"],
 " of the correlation matrices; with the six directions of the grid the \
correlation matrix at a radius has a part of angular momentum 0 (the mean \
over the directions) and three parts of angular momentum 1, and the angular \
integrals reduce to the two angular averages"
}], "Text",ExpressionUUID->"7b680384-4282-4a87-96e7-1ba065a38480"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["D", "TI"], "0"], 
   RowBox[{"(", 
    RowBox[{
     StyleBox["q", "TI"], ",", 
     SuperscriptBox[
      StyleBox["q", "TI"], "\[Prime]"]}], ")"}], "\[LongEqual]", 
   FractionBox["1", "2"], "\[ThinSpace]", 
   SubsuperscriptBox["\[Integral]", 
    RowBox[{"-", "1"}], "1"], "\[ThinSpace]", 
   FractionBox[
    StyleBox["dx", "TI"], 
    RowBox[{
     SuperscriptBox[
      StyleBox["q", "TI"], "2"], "+", 
     SuperscriptBox[
      StyleBox["q", "TI"], 
      RowBox[{"\[Prime]", "2"}]], "+", 
     SuperscriptBox[
      StyleBox["M", "TI"], "2"], "-", "2", 
     StyleBox["q", "TI"], 
     SuperscriptBox[
      StyleBox["q", "TI"], "\[Prime]"], 
     StyleBox["x", "TI"]}]], ",", "      ", 
   SubscriptBox[
    StyleBox["D", "TI"], "1"], 
   RowBox[{"(", 
    RowBox[{
     StyleBox["q", "TI"], ",", 
     SuperscriptBox[
      StyleBox["q", "TI"], "\[Prime]"]}], ")"}], "\[LongEqual]", 
   FractionBox["1", "2"], "\[ThinSpace]", 
   SubsuperscriptBox["\[Integral]", 
    RowBox[{"-", "1"}], "1"], "\[ThinSpace]", 
   FractionBox[
    RowBox[{
     StyleBox["x", "TI"], "\[ThinSpace]", 
     StyleBox["dx", "TI"]}], 
    RowBox[{
     SuperscriptBox[
      StyleBox["q", "TI"], "2"], "+", 
     SuperscriptBox[
      StyleBox["q", "TI"], 
      RowBox[{"\[Prime]", "2"}]], "+", 
     SuperscriptBox[
      StyleBox["M", "TI"], "2"], "-", "2", 
     StyleBox["q", "TI"], 
     SuperscriptBox[
      StyleBox["q", "TI"], "\[Prime]"], 
     StyleBox["x", "TI"]}]], ","}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"c0302447-bb0f-466f-ac65-9a1db7467a7c"],

Cell[TextData[{
 "whose closed forms contain ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["ln",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         StyleBox["q", "TI"], "-", 
         SuperscriptBox[
          StyleBox["q", "TI"], "\[Prime]"]}], ")"}], "2"], "+", 
      SuperscriptBox[
       StyleBox["M", "TI"], "2"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4b835897-8ddb-4dbd-bbe8-2f31020ab951"],
 ", singular at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["q", "TI"], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["q", "TI"], "\[Prime]"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bec74724-8c0a-492f-a7f0-55496a5d4bca"],
 " for a massless boson; the radial integral subtracts this logarithm at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["q", "TI"], "\[Prime]"], "\[LongEqual]", 
    StyleBox["q", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "22eed1a4-e592-40d7-8240-cf75f5067cf3"],
 " and integrates it exactly (",
 StyleBox["kernIntegral",
  FontFamily->"Source Code Pro"],
 "). The next cell compares the closed forms with a numerical integration \
over the angle; then it computes the Thouless eigenvalues of the exchange of \
the zeugon ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ebc4bb6a-208a-4aa6-b40a-b340f1376df2"],
 " alone and of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d66c135b-ad98-406e-a304-3f183255aebc"],
 " alone in the normal vacuum (per unit squared coupling; a positive \
eigenvalue attracts the pair ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "016970f1-79a9-4517-9274-5294ba2e410f"],
 "), by power iteration; and finally the CJT state of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "2", ")"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5747e0de-cc5a-4fa1-a393-adae319c9d85"],
 " with the exchange of all four bosons at the couplings ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]], "\[LongEqual]", "0.7"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3b6bc212-6acc-49c1-9307-3002054583a1"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]], "\[LongEqual]", "0.45"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "313fcd91-1c29-4f74-be15-c4033edc4d44"],
 " and the boson masses of the Rust program."
}], "Text",ExpressionUUID->"6058e3b5-bdd7-4fcc-996c-530f1028a121"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"kernSF", "[", 
      RowBox[{"g", ",", " ", "mass"}], "]"}], ":", " ", 
     RowBox[{"the", " ", "radial", " ", "kernels", " ", "of", " ", "D0"}]}], ",",
     " ", 
    RowBox[{"D1", " ", "in", " ", "closed", " ", 
     RowBox[{"form", ":", " ", 
      RowBox[{"{", 
       RowBox[{"r0", ",", " ", "r1"}], "}"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"s0", ",", " ", "s1"}], "}"}], " ", "with", " ", "D_l"}], " ", 
     "=", " ", 
     RowBox[{"r_l", " ", "+", " ", 
      RowBox[{"s_l", " ", "ln", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"q", " ", "-", " ", 
            RowBox[{"q", "'"}]}], ")"}], "^", "2"}], " ", "+", " ", 
         RowBox[{"M", "^", "2"}]}], ")"}]}]}]}], ",", "\n", "   ", 
    RowBox[{"the", " ", "logarithm", " ", "lm"}], ",", " ", 
    RowBox[{
     RowBox[{"and", " ", "aq"}], " ", "=", " ", 
     RowBox[{"the", " ", "exact", " ", "integral", " ", "of", " ", "ln", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"q", " ", "-", " ", 
           RowBox[{"q", "'"}]}], ")"}], "^", "2"}], " ", "+", " ", 
        RowBox[{"M", "^", "2"}]}], ")"}], " ", "over", " ", 
      RowBox[{"q", "'"}], " ", 
      RowBox[{"in", " ", "[", 
       RowBox[{"0", ",", " ", "Lambda"}], "]"}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"kernSF", "[", 
      RowBox[{"g_", ",", " ", "mass_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"kr", " ", "=", " ", 
          RowBox[{"g", "[", "\"\<kr\>\"", "]"}]}], ",", " ", "q", ",", " ", 
         "qp", ",", " ", "a", ",", " ", "b", ",", " ", "lp", ",", " ", "lm", ",",
          " ", "fp"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"q", " ", "=", " ", 
         RowBox[{"Outer", "[", 
          RowBox[{
           RowBox[{"#1", " ", "&"}], ",", " ", "kr", ",", " ", "kr"}], 
          "]"}]}], ";", " ", 
        RowBox[{"qp", " ", "=", " ", 
         RowBox[{"Outer", "[", 
          RowBox[{
           RowBox[{"#2", " ", "&"}], ",", " ", "kr", ",", " ", "kr"}], 
          "]"}]}], ";", "\n", "   ", 
        RowBox[{"a", " ", "=", " ", 
         RowBox[{
          RowBox[{"q", "^", "2"}], " ", "+", " ", 
          RowBox[{"qp", "^", "2"}], " ", "+", " ", 
          RowBox[{"mass", "^", "2"}]}]}], ";", " ", 
        RowBox[{"b", " ", "=", " ", 
         RowBox[{"2", " ", "q", " ", "qp"}]}], ";", " ", 
        RowBox[{"lp", " ", "=", " ", 
         RowBox[{"Log", "[", 
          RowBox[{"a", " ", "+", " ", "b"}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"lm", " ", "=", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"mass", " ", "==", " ", "0"}], " ", "&&", " ", 
              RowBox[{"i", " ", "==", " ", "j"}]}], ",", " ", "0.", ",", " ", 
             
             RowBox[{"Log", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"kr", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], " ", "-", " ", 
                  RowBox[{"kr", "[", 
                   RowBox[{"[", "j", "]"}], "]"}]}], ")"}], "^", "2"}], " ", "+",
                " ", 
               RowBox[{"mass", "^", "2"}]}], "]"}]}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", 
             RowBox[{"Length", "[", "kr", "]"}]}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"j", ",", " ", 
             RowBox[{"Length", "[", "kr", "]"}]}], "}"}]}], "]"}]}], ";", 
        "\n", "   ", 
        RowBox[{
         RowBox[{"fp", "[", "x_", "]"}], " ", ":=", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"mass", " ", "==", " ", "0"}], ",", " ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"x", " ", "==", " ", "0"}], ",", " ", "0.", ",", " ", 
             RowBox[{
              RowBox[{"x", " ", 
               RowBox[{"Log", "[", 
                RowBox[{"x", "^", "2"}], "]"}]}], " ", "-", " ", 
              RowBox[{"2", " ", "x"}]}]}], "]"}], ",", " ", 
           RowBox[{
