Cell[CellGroupData[{

Cell["\<\
R.4.5 The pseudospins of the pairing-only method (check WD-5)\
\>", "Subsection",ExpressionUUID->"2d05b203-8327-4d77-9dd8-231fef8adf51"],

Cell[TextData[{
 "In HS (0, 0) the whole dynamics of the runs reduces to Anderson \
pseudospins, the classical picture of the theory of Bardeen, Cooper and \
Schrieffer. For every radial node ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["q", "TI"], 
    StyleBox["i", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f3a2151a-1451-40fe-8530-f18f9f1ad294"],
 " of the grid there are two unit vectors, one for the particles and one for \
the antiparticles, each precessing in its own field:"
}], "Text",ExpressionUUID->"908caf24-987e-4f48-95ca-6f370878b59c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    RowBox[{
     StyleBox["d", "TI"], 
     SubsuperscriptBox[
      StyleBox["n",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      StyleBox["SH",
       FontSlant->"Plain"], "\[PlusMinus]"]}], 
    StyleBox["dt", "TI"]], "\[LongEqual]", "2", "\[ThinSpace]", 
   SubsuperscriptBox[
    StyleBox["b",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    StyleBox["SH",
     FontSlant->"Plain"], "\[PlusMinus]"], "\[Times]", 
   SubsuperscriptBox[
    StyleBox["n",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    StyleBox["SH",
     FontSlant->"Plain"], "\[PlusMinus]"], ",", "      ", 
   SubsuperscriptBox[
    StyleBox["b",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    StyleBox["SH",
     FontSlant->"Plain"], "\[PlusMinus]"], "\[LongEqual]", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", 
      StyleBox["Re",
       FontSlant->"Plain"]}], "\[ThinSpace]", 
     SubscriptBox["\[CapitalDelta]", 
      StyleBox["SH",
       FontSlant->"Plain"]], ",", " ", 
     StyleBox["Im",
      FontSlant->"Plain"], "\[ThinSpace]", 
     SubscriptBox["\[CapitalDelta]", 
      StyleBox["SH",
       FontSlant->"Plain"]], ",", " ", 
     RowBox[{"\[PlusMinus]", 
      SubscriptBox["\[CurlyEpsilon]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], 
     RowBox[{"(", 
      SubscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["i", "TI"]], ")"}]}], ")"}], ",", "      ", 
   SubscriptBox["\[CapitalDelta]", 
    StyleBox["SH",
     FontSlant->"Plain"]], "\[LongEqual]", 
   FractionBox[
    SubscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]], "2"], "\[LongEqual]", 
   FractionBox[
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]], "2"], "\[ThinSpace]", 
   UnderscriptBox["\[Sum]", 
    StyleBox["i", "TI"],
    LimitsPositioning->True], "\[ThinSpace]", 
   FractionBox[
    SubscriptBox[
     StyleBox["w", "TI"], 
     StyleBox["i", "TI"]], "2"], 
   RowBox[{"(", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["n", "TI"], 
      RowBox[{
       StyleBox["SH",
        FontSlant->"Plain"], ",", 
       StyleBox["i", "TI"]}], 
      RowBox[{"+", ",", 
       StyleBox["x", "TI"]}]], "+", 
     SubsuperscriptBox[
      StyleBox["n", "TI"], 
      RowBox[{
       StyleBox["SH",
        FontSlant->"Plain"], ",", 
       StyleBox["i", "TI"]}], 
      RowBox[{"-", ",", 
       StyleBox["x", "TI"]}]], "-", 
     StyleBox["i", "TI"], 
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["n", "TI"], 
        RowBox[{
         StyleBox["SH",
          FontSlant->"Plain"], ",", 
         StyleBox["i", "TI"]}], 
        RowBox[{"+", ",", 
         StyleBox["y", "TI"]}]], "+", 
       SubsuperscriptBox[
        StyleBox["n", "TI"], 
        RowBox[{
         StyleBox["SH",
          FontSlant->"Plain"], ",", 
         StyleBox["i", "TI"]}], 
        RowBox[{"-", ",", 
         StyleBox["y", "TI"]}]]}], ")"}]}], ")"}], ","}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"6345c0ad-08d9-439f-aee2-ff983da005b0"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CurlyEpsilon]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        StyleBox["q", "TI"], "2"], "+", 
       SubsuperscriptBox[
        StyleBox["m", "TI"], 
