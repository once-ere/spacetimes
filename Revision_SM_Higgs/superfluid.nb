          " ", 
         RowBox[{"{", 
          RowBox[{"ver", ",", " ", 
           RowBox[{"{", 
            RowBox[{"\"\<second\>\"", ",", " ", "\"\<first\>\""}], "}"}]}], 
          "}"}]}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rvCheck", "[", 
     RowBox[{"\"\<WH-3\>\"", ",", " ", 
      RowBox[{"\"\<HS (0, 0): the gap equation (G_SH / 4 pi^2) I1(M_eff) = 1 \
gives M_eff = \>\"", " ", "<>", " ", 
