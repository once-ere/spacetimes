      RowBox[{"ToString", "[", 
       RowBox[{"NumberForm", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"9", "/", "16"}], " ", "r8Alpha"}], ",", " ", "3"}], "]"}], 
       "]"}], ",", " ", "\"\<; pi/3 = \>\"", ",", " ", 
      RowBox[{"ToString", "[", 
       RowBox[{"NumberForm", "[", 
        RowBox[{
