Cell[TextData[{
 StyleBox["The decay into pairs of gauge bosons (a remark: what it means and \
why it matters).",
  FontWeight->"Bold"],
 " The width formula above is the width into ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["W", "TI"], "+"], 
    SuperscriptBox[
     StyleBox["W", "TI"], "-"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "35e712a9-468e-477c-95e1-17b6d1c02d33"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["ZZ", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "caa4436b-800b-4ec6-9e3f-4524da2badeb"],
 " of the new group up to corrections of the relative order of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["M", "TI"], 
       RowBox[{
        StyleBox["W", "TI"], ",", 
        StyleBox["SF",
         FontSlant->"Plain"]}], 
       StyleBox["X", "TI"]], "/", 
      SubsuperscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["H",
         FontSlant->"Plain"]}]]}], ")"}], "2"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "44c0ae60-6c30-4e83-9f8f-4b819d328715"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["M", "TI"], 
       RowBox[{
        StyleBox["Z", "TI"], ",", 
        StyleBox["SF",
         FontSlant->"Plain"]}], 
       StyleBox["X", "TI"]], "/", 
      SubsuperscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["H",
         FontSlant->"Plain"]}]]}], ")"}], "2"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "514f4e2e-c501-46c0-852f-5bbd4871a79c"],
 ": the equivalence theorem holds at energies large against the masses of the \
bosons, and the decay at rest gives each boson the energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["H",
       FontSlant->"Plain"]}]], "/", "2"}], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "83db5248-1979-4a62-9648-742b4d88ffec"],
 ". The kinetic part couples ",
 Cell[BoxData[
  FormBox[
   StyleBox["h", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "37e1183e-62f6-4c1d-8033-38edb1f092d6"],
 " to the gauge bosons through their mass terms: both squared masses are \
proportional to the square of the field of the vacuum, so the term linear in ",
 Cell[BoxData[
  FormBox[
   StyleBox["h", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6c369255-6fde-43f2-b9b1-f8df5099d4a8"],
 " of each mass term is that mass term times ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    StyleBox["h", "TI"], "/", 
    SubsuperscriptBox[
     StyleBox["f", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["F",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ff46d7e4-b248-45b8-953f-3b7f41c13e25"],
 ", and at tree level the width into a pair of ",
 Cell[BoxData[
  FormBox[
   StyleBox["W", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "70d76f31-9358-46cb-833b-a22cf7260540"],
 " bosons is that of the two corresponding Goldstone channels times the factor"
}], "Text",ExpressionUUID->"0307148f-4576-430e-8f39-def821302236"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "-", 
      FractionBox[
       RowBox[{"4", 
        SuperscriptBox[
         RowBox[{"(", 
          SubsuperscriptBox[
           StyleBox["M", "TI"], 
           RowBox[{
            StyleBox["W", "TI"], ",", 
            StyleBox["SF",
             FontSlant->"Plain"]}], 
           StyleBox["X", "TI"]], ")"}], "2"]}], 
       SuperscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox[
          StyleBox["M", "TI"], 
          StyleBox["SF",
           FontSlant->"Plain"], 
          RowBox[{
           StyleBox["X", "TI"], ",", 
           StyleBox["H",
            FontSlant->"Plain"]}]], ")"}], "2"]]}], ")"}], 
    RowBox[{"1", "/", "2"}]], 
   RowBox[{"(", 
    RowBox[{"1", "-", 
     FractionBox[
      RowBox[{"4", 
       SuperscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox[
          StyleBox["M", "TI"], 
          RowBox[{
           StyleBox["W", "TI"], ",", 
           StyleBox["SF",
            FontSlant->"Plain"]}], 
          StyleBox["X", "TI"]], ")"}], "2"]}], 
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox[
         StyleBox["M", "TI"], 
         StyleBox["SF",
          FontSlant->"Plain"], 
         RowBox[{
          StyleBox["X", "TI"], ",", 
          StyleBox["H",
           FontSlant->"Plain"]}]], ")"}], "2"]], "+", 
     FractionBox[
      RowBox[{"12", 
       SuperscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox[
          StyleBox["M", "TI"], 
          RowBox[{
           StyleBox["W", "TI"], ",", 
           StyleBox["SF",
            FontSlant->"Plain"]}], 
          StyleBox["X", "TI"]], ")"}], "4"]}], 
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox[
         StyleBox["M", "TI"], 
         StyleBox["SF",
          FontSlant->"Plain"], 
         RowBox[{
          StyleBox["X", "TI"], ",", 
          StyleBox["H",
           FontSlant->"Plain"]}]], ")"}], "4"]]}], ")"}]}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"bc686914-5f8b-4fab-b2fd-ecb7655a6701"],

Cell[TextData[{
 "(the phase space, and the sum over the polarizations of the two bosons, \
whose transverse parts the Goldstone fields do not have), and the same with \
",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["M", "TI"], 
    RowBox[{
     StyleBox["Z", "TI"], ",", 
     StyleBox["SF",
      FontSlant->"Plain"]}], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "186b41fb-3d56-4fa5-ad1a-17db0dbbea6a"],
 " for ",
 Cell[BoxData[
  FormBox[
   StyleBox["ZZ", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1401f182-0808-4569-b1f4-64b4f04c9809"],
 ". The next cell computes, for every method, the larger of the ratios ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     RowBox[{
      StyleBox["W", "TI"], ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]], "/", 
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["H",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8380f6ba-2f8e-44e6-8931-184f9e91e354"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     RowBox[{
      StyleBox["Z", "TI"], ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]], "/", 
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["H",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "28e58ee0-bf19-4964-bc12-06580f60c1be"],
 ", the smaller of the two factors, and how much the masses of the effective \
Lagrangian exceed those of the linear response. The ratio is at most 0.106 \
(KS and CJT) and the factor at least 0.934, so the width formula \
overestimates the width into ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["W", "TI"], "+"], 
    SuperscriptBox[
     StyleBox["W", "TI"], "-"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d57c1c6b-4613-48db-a419-559a99222f97"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["ZZ", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "46d73f8c-1999-4ef5-b52b-bdea77e71fdf"],
 " of the new group by less than 7 per cent. It matters little: that is far \
less than the uncertainty of the effective Lagrangian at the energy of the \
mode (the remark above), and the conclusion, a broad resonance, does not \
depend on it."
}], "Text",ExpressionUUID->"3239cb8b-2597-4088-879f-3d14248fc3ad"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "the", " ", "decay", " ", "into", " ", "a", " ", "pair", " ", "of", " ", 
     "W", " ", "or", " ", "Z", " ", 
     RowBox[{"bosons", ":", " ", 
      RowBox[{"the", " ", "larger", " ", "of", " ", "the", " ", "ratios", " ", 
       RowBox[{"M_W", "/", "M_H"}], " ", "and", " ", 
       RowBox[{"M_Z", "/", "M_H"}], " ", 
       RowBox[{"(", 
        RowBox[{"gzVV", "[", "\"\<ratio\>\"", "]"}], ")"}]}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"the", " ", "tree"}], "-", 
     RowBox[{"level", "\n", "   ", "factor", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", " ", "-", " ", 
         RowBox[{"4", " ", "r"}]}], ")"}], "^", 
       RowBox[{"(", 
        RowBox[{"1", "/", "2"}], ")"}]}], " ", 
      RowBox[{"(", 
       RowBox[{"1", " ", "-", " ", 
        RowBox[{"4", " ", "r"}], " ", "+", " ", 
        RowBox[{"12", " ", 
         RowBox[{"r", "^", "2"}]}]}], ")"}], " ", "with", " ", "r", " ", 
      "the", " ", "square", " ", "of", " ", "that", " ", "ratio", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"gzVV", "[", "\"\<factor\>\"", "]"}], ";", " ", 
        RowBox[{
        "the", " ", "smaller", " ", "of", " ", "the", " ", "factors", "\n", 
         "   ", "of", " ", "W", " ", "and", " ", "Z"}]}], ")"}]}]}], ",", " ", 
    RowBox[{
    "and", " ", "the", " ", "masses", " ", "of", " ", "the", " ", "effective",
      " ", "Lagrangian", " ", 
     RowBox[{"(", 
      RowBox[{
      "the", " ", "curvature", " ", "of", " ", "the", " ", "potential", " ", 
       "and", " ", "the", " ", "kinetic", " ", "part"}], ")"}], " ", 
     "against", "\n", "   ", "the", " ", "linear", " ", "response"}], ",", 
    " ", 
    RowBox[{"in", " ", "per", " ", "cent"}], ",", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"for", " ", "the", " ", "amplitude", " ", "mode", " ", 
       RowBox[{"(", 
        RowBox[{"gzVV", "[", "\"\<effH\>\"", "]"}], ")"}], " ", "and", " ", 
       "for", " ", "the", " ", "non"}], "-", 
      RowBox[{"unitary", " ", "modes", " ", 
       RowBox[{"(", 
        RowBox[{"gzVV", "[", "\"\<effNU\>\"", "]"}], ")"}]}]}], ";", "\n", 
     "   ", 
     RowBox[{
      RowBox[{"the", " ", "masses", " ", "M_W"}], " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"g", "^", "v"}], " ", "f_I", " ", "and", " ", "M_Z"}], " ", "=",
        " ", 
       RowBox[{"2", " ", 
        RowBox[{"g", "^", "F"}], " ", "f_F", " ", "are", " ", "those", " ", 
        "of", " ", "gzHiggs"}]}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"gzVV", "[", "t_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"hg", " ", "=", " ", 
          RowBox[{"gzHiggs", "[", "t", "]"}]}], ",", " ", "mw", ",", " ", 
         "mz", ",", " ", "r"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"mw", " ", "=", " ", 
         RowBox[{"gvLL", " ", 
          RowBox[{"hg", "[", "\"\<fI\>\"", "]"}]}]}], ";", " ", 
        RowBox[{"mz", " ", "=", " ", 
         RowBox[{"2", " ", "gfLL", " ", 
          RowBox[{"hg", "[", "\"\<fF\>\"", "]"}]}]}], ";", " ", 
        RowBox[{"r", " ", "=", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Max", "[", 
             RowBox[{"mw", ",", " ", "mz"}], "]"}], "/", 
            RowBox[{"hg", "[", "\"\<MH\>\"", "]"}]}], ")"}], "^", "2"}]}], ";",
         "\n", "   ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<ratio\>\"", " ", "->", " ", 
           RowBox[{"Sqrt", "[", "r", "]"}]}], ",", " ", 
          RowBox[{"\"\<factor\>\"", " ", "->", " ", 
           RowBox[{
            RowBox[{"Sqrt", "[", 
             RowBox[{"1", " ", "-", " ", 
              RowBox[{"4", " ", "r"}]}], "]"}], " ", 
            RowBox[{"(", 
             RowBox[{"1", " ", "-", " ", 
              RowBox[{"4", " ", "r"}], " ", "+", " ", 
              RowBox[{"12", " ", 
               RowBox[{"r", "^", "2"}]}]}], ")"}]}]}], ",", "\n", "     ", 
          RowBox[{"\"\<effH\>\"", " ", "->", " ", 
           RowBox[{"100", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"rustPart3", "[", 
                RowBox[{"\"\<p3_MH_\>\"", " ", "<>", " ", "t"}], "]"}], "/", 
               RowBox[{"rustPart3", "[", 
                RowBox[{"\"\<p3_MH_RPA_\>\"", " ", "<>", " ", "t"}], "]"}]}], 
              " ", "-", " ", "1"}], ")"}]}]}], ",", " ", 
          RowBox[{"\"\<effNU\>\"", " ", "->", " ", 
           RowBox[{"100", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"rustPart3", "[", 
                RowBox[{"\"\<p3_MNU_\>\"", " ", "<>", " ", "t"}], "]"}], "/", 
               
               RowBox[{"rustPart3", "[", 
                RowBox[{"\"\<p3_MNU_RPA_\>\"", " ", "<>", " ", "t"}], "]"}]}],
               " ", "-", " ", "1"}], ")"}]}]}]}], "|>"}]}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"q", " ", "=", " ", 
             RowBox[{"gzVV", "[", "t", "]"}]}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"thName", "[", "t", "]"}], ",", " ", 
             RowBox[{"NumberForm", "[", 
              RowBox[{
               RowBox[{"q", "[", "\"\<ratio\>\"", "]"}], ",", " ", "4"}], 
              "]"}], ",", " ", 
             RowBox[{"NumberForm", "[", 
              RowBox[{
               RowBox[{"q", "[", "\"\<factor\>\"", "]"}], ",", " ", "4"}], 
              "]"}], ",", " ", 
             RowBox[{"NumberForm", "[", 
              RowBox[{
               RowBox[{"q", "[", "\"\<effH\>\"", "]"}], ",", " ", "3"}], 
              "]"}], ",", " ", 
             RowBox[{"NumberForm", "[", 
              RowBox[{
               RowBox[{"q", "[", "\"\<effNU\>\"", "]"}], ",", " ", "3"}], 
              "]"}]}], "}"}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"t", ",", " ", "thTags"}], "}"}]}], "]"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<method\>\"", ",", " ", "\"\<max(M_W, M_Z)/M_H\>\"", ",", 
         " ", "\"\<tree-level factor\>\"", ",", 
         " ", "\"\<M_H: L^X over response - 1 (per cent)\>\"", ",", 
         " ", "\"\<M_NU: L^X over response - 1 (per cent)\>\""}], "}"}]}], 
      "]"}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
     RowBox[{"Alignment", " ", "->", " ", "Right"}], ",", " ", 
     RowBox[{"BaseStyle", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"FontSize", " ", "->", " ", "8"}], "}"}]}]}], 
    "]"}]}]}]], "Input",
 CellLabel->
  "In[405]:=",ExpressionUUID->"dfb9677c-cca6-452b-8c39-e3b8d758363c"],

