     RowBox[{"d8", "[", "a", "]"}], ",", " ", "a", ",", " ", "a"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"comm", "[", 
    RowBox[{"a_", ",", " ", "b_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"a", ".", "b"}], " ", "-", " ", 
