Cell[CellGroupData[{

Cell["\<\
R.2.3 The triplet pairs of the earlier superfluid (check WSF-4)\
\>", "Subsection",ExpressionUUID->"5f27e397-f7dc-4d03-b1b9-9c520f4904ef"],

Cell[TextData[{
 "In KS and CJT the contact terms of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "92ff8f7e-bc94-421e-8d0e-300b1991b1e3"],
 " give the scalar triplet pairs of Parts II and III the coupling ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", "4"]}], 
    SubsuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["S",
      FontSlant->"Plain"]], "-", 
    SubsuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["V",
      FontSlant->"Plain"]], "\[LongEqual]", 
    FractionBox["6", "5"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ea5aef44-80c3-478b-ac1a-48d0cf4c0ec4"],
 ", and in the normal vacuum the eigenvalue ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Lambda]", 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["T",
      FontSlant->"Plain"]], "\[LongEqual]", 
    FractionBox["6", "5"], "/", 
    SubsuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["crit",
      FontSlant->"Plain"]], "\[LongEqual]", 
    FractionBox["6", "5"], 
    SubsuperscriptBox[
     StyleBox["I", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{"(", "1", ")"}]], 
    RowBox[{"(", 
     FractionBox["1", "5"], ")"}], "/", 
    SuperscriptBox["\[Pi]", "2"], "\[TildeTilde]", "0.056"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5b0e72e6-f5f9-435a-9adb-d47111de8fc5"],
 ", far below 1: the superfluid of the earlier hypotheses does not form under \
the revised ones, which change only the fields and the pairing."
}], "Text",ExpressionUUID->"209ea49d-4668-4278-b683-8dc38ff2323d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"WSF", "-", "4"}], ":", " ", 
    RowBox[{"the", " ", "triplet", " ", "pair", " ", "coupling"}]}], " ", 
   "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"gTrip", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", "1"}], "/", "4"}], " ", 
       RowBox[{"(", 
        RowBox[{"-", "8"}], ")"}]}], " ", "-", " ", 
      RowBox[{"4", "/", "5"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"lamTrip", " ", "=", " ", 
     RowBox[{"gTrip", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Pi", "^", "2"}], "/", 
        RowBox[{"i1closed", "[", "mLL", "]"}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"lamTripRust", " ", "=", " ", 
     RowBox[{"num", "[", 
      RowBox[{
       RowBox[{"rowOf", "[", 
        RowBox[{"\"\<V1_SH\>\"", ",", " ", "\"\<CJT\>\""}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"col", "[", 
         RowBox[{"hdr", ",", " ", "\"\<lam_triplet\>\""}], "]"}], "]"}], 
       "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dev4", " ", "=", " ", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"N", "[", 
        RowBox[{"lamTrip", ",", " ", "30"}], "]"}], " ", "-", " ", 
       "lamTripRust"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rvCheck", "[", 
     RowBox[{"\"\<WSF-4\>\"", ",", " ", 
      RowBox[{"\"\<the scalar triplet pair coupling of KS and CJT, -(1/4) G^S \
- G^V = \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"gTrip", ",", " ", "InputForm"}], "]"}], " ", "<>", "\n", 
       "  ", "\"\<, and its eigenvalue in the normal vacuum, (6/5) I1(1/5) / \
pi^2 = \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"NumberForm", "[", 
         RowBox[{
          RowBox[{"N", "[", 
           RowBox[{"lamTrip", ",", " ", "16"}], "]"}], ",", " ", "16"}], 
         "]"}], "]"}], " ", "<>", "\n", 
       "  ", "\"\<, against the Rust value\>\""}], ",", " ", 
      RowBox[{
       RowBox[{"gTrip", " ", "==", " ", 
        RowBox[{"6", "/", "5"}]}], " ", "&&", " ", 
       RowBox[{"dev4", " ", "<", " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "9"}]}]}]}], ",", " ", 
      RowBox[{"\"\<deviation \>\"", " ", "<>", " ", 
       RowBox[{"sci", "[", "dev4", "]"}]}]}], "]"}], ";"}]}]}]], "Input",
 CellLabel->
  "In[613]:=",ExpressionUUID->"d191c4ff-2978-4260-92fb-e2c0ead663c9"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"PASS \"\>", "\[InvisibleSpace]", "\<\"WSF-4\"\>", 
   "\[InvisibleSpace]", "\<\"  \"\>", 
   "\[InvisibleSpace]", "\<\"the scalar triplet pair coupling of KS and CJT, \
-(1/4) G^S - G^V = 6/5, and its eigenvalue in the normal vacuum, (6/5) \
I1(1/5) / pi^2 = 0.05637346734780750, against the Rust value\"\>", 
   "\[InvisibleSpace]", "\<\" [\"\>", 
   "\[InvisibleSpace]", "\<\"deviation 8.097e-12\"\>", 
   "\[InvisibleSpace]", "\<\"]   [the same check: Rust \"\>", 
   "\[InvisibleSpace]", "\<\"SF-4a\"\>", 
   "\[InvisibleSpace]", "\<\", Python \"\>", 
   "\[InvisibleSpace]", "\<\"none\"\>", "\[InvisibleSpace]", "\<\"]\"\>"}],
  SequenceForm[
  "PASS ", "WSF-4", "  ", 
   "the scalar triplet pair coupling of KS and CJT, -(1/4) G^S - G^V = 6/5, \
and its eigenvalue in the normal vacuum, (6/5) I1(1/5) / pi^2 = \
0.05637346734780750, against the Rust value", " [", "deviation 8.097e-12", 
   "]   [the same check: Rust ", "SF-4a", ", Python ", "none", "]"],
  Editable->False]], "Print",
 CellChangeTimes->{4.004331601088777*^9},
