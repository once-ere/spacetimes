        RowBox[{"sectors", "[", 
         RowBox[{"[", "3", "]"}], "]"}], ",", " ", "hb", ",", " ", "gens"}], 
       "]"}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
