Cell[TextData[{
 StyleBox["The decay into pairs of gauge bosons (a remark: what it means and \
why it matters).",
  FontWeight->"Bold"],
 " The width formula above is the width into ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["W", "TI"], "+"], 
    SuperscriptBox[
     StyleBox["W", "TI"], "-"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b18fa0e0-ad3d-46be-b572-adddd42fa395"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["ZZ", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d8b2d9bc-fd5a-4616-8621-7e7774d4dbaa"],
 " of the new group up to corrections of the relative order of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["M", "TI"], 
       RowBox[{
        StyleBox["W", "TI"], ",", 
        StyleBox["SF",
         FontSlant->"Plain"]}], 
       StyleBox["X", "TI"]], "/", 
      SubsuperscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["H",
         FontSlant->"Plain"]}]]}], ")"}], "2"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e62089c6-a2ad-4fed-858e-a3d348437366"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["M", "TI"], 
       RowBox[{
        StyleBox["Z", "TI"], ",", 
        StyleBox["SF",
         FontSlant->"Plain"]}], 
       StyleBox["X", "TI"]], "/", 
      SubsuperscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["H",
         FontSlant->"Plain"]}]]}], ")"}], "2"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fd49b4d9-945c-4d5e-9e66-00a3d0d9933c"],
 ": the equivalence theorem holds at energies large against the masses of the \
bosons, and the decay at rest gives each boson the energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["H",
       FontSlant->"Plain"]}]], "/", "2"}], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "79108004-97dd-482d-aab8-fd3b5a707d23"],
 ". The kinetic part couples ",
 Cell[BoxData[
  FormBox[
   StyleBox["h", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d8799cf7-efc5-4d71-893b-21dac5ad8c9a"],
 " to the gauge bosons through their mass terms: both squared masses are \
proportional to the square of the field of the vacuum, so the term linear in ",
 Cell[BoxData[
  FormBox[
   StyleBox["h", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3114a0f4-7fbc-47b8-a3c4-37e31f0ba8e0"],
 " of each mass term is that mass term times ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    StyleBox["h", "TI"], "/", 
    SubsuperscriptBox[
     StyleBox["f", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["F",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d871d883-0dc5-4a65-af1d-9bc0cdceb944"],
 ", and at tree level the width into a pair of ",
 Cell[BoxData[
  FormBox[
   StyleBox["W", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6fe510b8-6291-4b4c-8ca5-2d5a51bd69d0"],
 " bosons is that of the two corresponding Goldstone channels times the factor"
}], "Text",ExpressionUUID->"88dbf020-b70a-4964-b22a-27f1ce610650"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "-", 
      FractionBox[
       RowBox[{"4", 
        SuperscriptBox[
         RowBox[{"(", 
          SubsuperscriptBox[
           StyleBox["M", "TI"], 
           RowBox[{
            StyleBox["W", "TI"], ",", 
            StyleBox["SF",
             FontSlant->"Plain"]}], 
           StyleBox["X", "TI"]], ")"}], "2"]}], 
       SuperscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox[
          StyleBox["M", "TI"], 
          StyleBox["SF",
           FontSlant->"Plain"], 
          RowBox[{
           StyleBox["X", "TI"], ",", 
           StyleBox["H",
            FontSlant->"Plain"]}]], ")"}], "2"]]}], ")"}], 
    RowBox[{"1", "/", "2"}]], 
   RowBox[{"(", 
    RowBox[{"1", "-", 
     FractionBox[
      RowBox[{"4", 
       SuperscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox[
          StyleBox["M", "TI"], 
          RowBox[{
           StyleBox["W", "TI"], ",", 
           StyleBox["SF",
            FontSlant->"Plain"]}], 
          StyleBox["X", "TI"]], ")"}], "2"]}], 
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox[
         StyleBox["M", "TI"], 
         StyleBox["SF",
          FontSlant->"Plain"], 
         RowBox[{
          StyleBox["X", "TI"], ",", 
          StyleBox["H",
           FontSlant->"Plain"]}]], ")"}], "2"]], "+", 
     FractionBox[
      RowBox[{"12", 
       SuperscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox[
          StyleBox["M", "TI"], 
          RowBox[{
           StyleBox["W", "TI"], ",", 
           StyleBox["SF",
            FontSlant->"Plain"]}], 
          StyleBox["X", "TI"]], ")"}], "4"]}], 
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox[
         StyleBox["M", "TI"], 
         StyleBox["SF",
          FontSlant->"Plain"], 
         RowBox[{
          StyleBox["X", "TI"], ",", 
          StyleBox["H",
           FontSlant->"Plain"]}]], ")"}], "4"]]}], ")"}]}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"a1c42aa6-a117-41c9-abb1-2dc7f3ea32da"],

Cell[TextData[{
 "(the phase space, and the sum over the polarizations of the two bosons, \
whose transverse parts the Goldstone fields do not have), and the same with \
",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["M", "TI"], 
    RowBox[{
     StyleBox["Z", "TI"], ",", 
     StyleBox["SF",
      FontSlant->"Plain"]}], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "999b297a-6d37-43ef-9666-0b28eb57a71c"],
 " for ",
 Cell[BoxData[
  FormBox[
   StyleBox["ZZ", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "12f31756-1da3-47b0-8f11-c31212800ace"],
 ". The next cell computes, for every method, the larger of the ratios ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     RowBox[{
      StyleBox["W", "TI"], ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]], "/", 
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["H",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2c70353c-b45f-4af6-bd5f-aa6759bedadb"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     RowBox[{
      StyleBox["Z", "TI"], ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]], "/", 
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["H",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2de63552-6df1-4f0e-b748-fcac22b926ec"],
 ", the smaller of the two factors, and how much the masses of the effective \
Lagrangian exceed those of the linear response. The ratio is at most 0.106 \
(KS and CJT) and the factor at least 0.934, so the width formula \
overestimates the width into ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["W", "TI"], "+"], 
    SuperscriptBox[
     StyleBox["W", "TI"], "-"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "eeac542e-b3b2-4277-bedf-89f6cf5bbbef"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["ZZ", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a801946f-f426-414f-b61c-e6fb78673692"],
 " of the new group by less than 7 per cent. It matters little: that is far \
less than the uncertainty of the effective Lagrangian at the energy of the \
mode (the remark above), and the conclusion, a broad resonance, does not \
depend on it."
}], "Text",ExpressionUUID->"d35f558a-84d4-4a6d-9392-b466efa21097"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "the", " ", "decay", " ", "into", " ", "a", " ", "pair", " ", "of", " ", 
     "W", " ", "or", " ", "Z", " ", 
     RowBox[{"bosons", ":", " ", 
      RowBox[{"the", " ", "larger", " ", "of", " ", "the", " ", "ratios", " ", 
       RowBox[{"M_W", "/", "M_H"}], " ", "and", " ", 
       RowBox[{"M_Z", "/", "M_H"}], " ", 
       RowBox[{"(", 
        RowBox[{"gzVV", "[", "\"\<ratio\>\"", "]"}], ")"}]}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"the", " ", "tree"}], "-", 
     RowBox[{"level", "\n", "   ", "factor", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", " ", "-", " ", 
         RowBox[{"4", " ", "r"}]}], ")"}], "^", 
       RowBox[{"(", 
        RowBox[{"1", "/", "2"}], ")"}]}], " ", 
      RowBox[{"(", 
       RowBox[{"1", " ", "-", " ", 
        RowBox[{"4", " ", "r"}], " ", "+", " ", 
        RowBox[{"12", " ", 
         RowBox[{"r", "^", "2"}]}]}], ")"}], " ", "with", " ", "r", " ", 
      "the", " ", "square", " ", "of", " ", "that", " ", "ratio", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"gzVV", "[", "\"\<factor\>\"", "]"}], ";", " ", 
        RowBox[{
        "the", " ", "smaller", " ", "of", " ", "the", " ", "factors", "\n", 
         "   ", "of", " ", "W", " ", "and", " ", "Z"}]}], ")"}]}]}], ",", " ", 
    RowBox[{
    "and", " ", "the", " ", "masses", " ", "of", " ", "the", " ", "effective",
      " ", "Lagrangian", " ", 
     RowBox[{"(", 
      RowBox[{
      "the", " ", "curvature", " ", "of", " ", "the", " ", "potential", " ", 
       "and", " ", "the", " ", "kinetic", " ", "part"}], ")"}], " ", 
     "against", "\n", "   ", "the", " ", "linear", " ", "response"}], ",", 
    " ", 
    RowBox[{"in", " ", "per", " ", "cent"}], ",", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"for", " ", "the", " ", "amplitude", " ", "mode", " ", 
       RowBox[{"(", 
        RowBox[{"gzVV", "[", "\"\<effH\>\"", "]"}], ")"}], " ", "and", " ", 
       "for", " ", "the", " ", "non"}], "-", 
      RowBox[{"unitary", " ", "modes", " ", 
       RowBox[{"(", 
        RowBox[{"gzVV", "[", "\"\<effNU\>\"", "]"}], ")"}]}]}], ";", "\n", 
     "   ", 
     RowBox[{
      RowBox[{"the", " ", "masses", " ", "M_W"}], " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"g", "^", "v"}], " ", "f_I", " ", "and", " ", "M_Z"}], " ", "=",
        " ", 
       RowBox[{"2", " ", 
        RowBox[{"g", "^", "F"}], " ", "f_F", " ", "are", " ", "those", " ", 
        "of", " ", "gzHiggs"}]}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"gzVV", "[", "t_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"hg", " ", "=", " ", 
          RowBox[{"gzHiggs", "[", "t", "]"}]}], ",", " ", "mw", ",", " ", 
         "mz", ",", " ", "r"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"mw", " ", "=", " ", 
         RowBox[{"gvLL", " ", 
          RowBox[{"hg", "[", "\"\<fI\>\"", "]"}]}]}], ";", " ", 
        RowBox[{"mz", " ", "=", " ", 
         RowBox[{"2", " ", "gfLL", " ", 
          RowBox[{"hg", "[", "\"\<fF\>\"", "]"}]}]}], ";", " ", 
        RowBox[{"r", " ", "=", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Max", "[", 
             RowBox[{"mw", ",", " ", "mz"}], "]"}], "/", 
            RowBox[{"hg", "[", "\"\<MH\>\"", "]"}]}], ")"}], "^", "2"}]}], ";",
         "\n", "   ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<ratio\>\"", " ", "->", " ", 
           RowBox[{"Sqrt", "[", "r", "]"}]}], ",", " ", 
          RowBox[{"\"\<factor\>\"", " ", "->", " ", 
           RowBox[{
            RowBox[{"Sqrt", "[", 
             RowBox[{"1", " ", "-", " ", 
              RowBox[{"4", " ", "r"}]}], "]"}], " ", 
            RowBox[{"(", 
             RowBox[{"1", " ", "-", " ", 
              RowBox[{"4", " ", "r"}], " ", "+", " ", 
              RowBox[{"12", " ", 
               RowBox[{"r", "^", "2"}]}]}], ")"}]}]}], ",", "\n", "     ", 
          RowBox[{"\"\<effH\>\"", " ", "->", " ", 
           RowBox[{"100", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"rustPart3", "[", 
                RowBox[{"\"\<p3_MH_\>\"", " ", "<>", " ", "t"}], "]"}], "/", 
               RowBox[{"rustPart3", "[", 
                RowBox[{"\"\<p3_MH_RPA_\>\"", " ", "<>", " ", "t"}], "]"}]}], 
              " ", "-", " ", "1"}], ")"}]}]}], ",", " ", 
          RowBox[{"\"\<effNU\>\"", " ", "->", " ", 
           RowBox[{"100", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"rustPart3", "[", 
                RowBox[{"\"\<p3_MNU_\>\"", " ", "<>", " ", "t"}], "]"}], "/", 
               
               RowBox[{"rustPart3", "[", 
                RowBox[{"\"\<p3_MNU_RPA_\>\"", " ", "<>", " ", "t"}], "]"}]}],
               " ", "-", " ", "1"}], ")"}]}]}]}], "|>"}]}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"q", " ", "=", " ", 
             RowBox[{"gzVV", "[", "t", "]"}]}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"thName", "[", "t", "]"}], ",", " ", 
             RowBox[{"NumberForm", "[", 
              RowBox[{
               RowBox[{"q", "[", "\"\<ratio\>\"", "]"}], ",", " ", "4"}], 
              "]"}], ",", " ", 
             RowBox[{"NumberForm", "[", 
              RowBox[{
               RowBox[{"q", "[", "\"\<factor\>\"", "]"}], ",", " ", "4"}], 
              "]"}], ",", " ", 
             RowBox[{"NumberForm", "[", 
              RowBox[{
               RowBox[{"q", "[", "\"\<effH\>\"", "]"}], ",", " ", "3"}], 
              "]"}], ",", " ", 
             RowBox[{"NumberForm", "[", 
              RowBox[{
               RowBox[{"q", "[", "\"\<effNU\>\"", "]"}], ",", " ", "3"}], 
              "]"}]}], "}"}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"t", ",", " ", "thTags"}], "}"}]}], "]"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<method\>\"", ",", " ", "\"\<max(M_W, M_Z)/M_H\>\"", ",", 
         " ", "\"\<tree-level factor\>\"", ",", 
         " ", "\"\<M_H: L^X over response - 1 (per cent)\>\"", ",", 
         " ", "\"\<M_NU: L^X over response - 1 (per cent)\>\""}], "}"}]}], 
      "]"}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
     RowBox[{"Alignment", " ", "->", " ", "Right"}], ",", " ", 
     RowBox[{"BaseStyle", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"FontSize", " ", "->", " ", "8"}], "}"}]}]}], 
    "]"}]}]}]], "Input",
 CellLabel->
  "In[405]:=",ExpressionUUID->"8875bbb6-0eb3-4135-b312-cc4ee019fcef"],

