          RowBox[{
           RowBox[{"g", "^", "2"}], " ", "+", " ", 
           RowBox[{"gp", "^", "2"}]}], ")"}], " ", 
         RowBox[{"vv", "/", "4"}], " ", 
         RowBox[{
          RowBox[{"g", "^", "2"}], "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"g", "^", "2"}], " ", "+", " ", 
            RowBox[{"gp", "^", "2"}]}], ")"}]}]}], ")"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ok12", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Sort", "[", 
        RowBox[{"Expand", "[", "ev12", "]"}], "]"}], " ", "===", " ", 
       RowBox[{"Sort", "[", 
        RowBox[{"Expand", "[", "wantEv", "]"}], "]"}]}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"Length", "[", "nul", "]"}], " ", "==", " ", "1"}], " ", "&&", 
      "\n", "  ", 
      RowBox[{
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"nul", "[", 
          RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"nul", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", " ", "4"}], "]"}], "]"}], "/", "g"}], ")"}], " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "0", ",", " ", "gp", ",", " ", "g"}], 
           "}"}]}]}], "]"}], " ", "==", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], "}"}]}], 
      " ", "&&", " ", 
      RowBox[{"rho12", " ", "===", " ", "1"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rvCheck", "[", 
     RowBox[{"\"\<WQN-12\>\"", ",", 
      " ", "\"\<the mass matrix of (W^1, W^2, W^3, B) from Phi_SH = (0, phi) \
and Phi'_SH = (phi', 0): eigenvalues 0, \\\ng^2 v_SH^2/4 (twice), (g^2 + \
g'^2) v_SH^2/4 with v_SH^2 = 2 (phi^2 + phi'^2) for any phi, phi', the \
massless vector \\\nalong (0, 0, g', g), and rho = 1 (symbolic couplings and \
lengths)\>\"", ",", " ", "ok12", ",", "\n", "  ", 
      RowBox[{"\"\<eigenvalues \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"ev12", ",", " ", "InputForm"}], "]"}]}]}], "]"}], 
    ";"}]}]}]], "Input",
 CellLabel->
  "In[545]:=",ExpressionUUID->"0cfa5919-ebbf-48df-a2d4-9de77589c567"],

