   "\[InvisibleSpace]", "\<\"): \"\>", 
   "\[InvisibleSpace]", "\<\"the Dirac matrices of the transformed frame are \
S gamma^p S^-1 (200 random g)\"\>", 
   "\[InvisibleSpace]", "\<\"   [the same check: Rust \"\>", 
   "\[InvisibleSpace]", "\<\"F-3d\"\>", 
   "\[InvisibleSpace]", "\<\", Python \"\>", 
   "\[InvisibleSpace]", "\<\"F-3d\"\>", "\[InvisibleSpace]", "\<\"]\"\>"}],
  SequenceForm[
  "PASS ", "WF-3d", "  deviation ", "3.762e-15", " (tolerance ", "1.000e-10", 
   "): ", "the Dirac matrices of the transformed frame are S gamma^p S^-1 \
(200 random g)", "   [the same check: Rust ", "F-3d", ", Python ", "F-3d", 
   "]"],
  Editable->False]], "Print",
 CellChangeTimes->{4.004296864046496*^9},
 CellLabel->
  "During evaluation of \
In[74]:=",ExpressionUUID->"fd0493ec-b625-46df-8626-fd551765b8b5"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"PASS \"\>", "\[InvisibleSpace]", "\<\"WF-5a\"\>", 
   "\[InvisibleSpace]", "\<\"  deviation \"\>", 
   "\[InvisibleSpace]", "\<\"0\"\>", 
   "\[InvisibleSpace]", "\<\" (tolerance \"\>", 
