Cell[CellGroupData[{

Cell["\<\
II.1 The pair channels and the gauge bosons that mediate the pairing\
\>", "Section",ExpressionUUID->"faab2d17-9ee8-4e7a-b29f-3f07e36fa207"],

Cell[TextData[{
 "The spin-zero pairs are the six antisymmetric unitary matrices ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "891cf07c-256b-4fc9-b04d-fd3cce2e4364"],
 " (scalar, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["0", "+"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "02f1d93a-7253-4b8c-bd28-152ee6648725"],
 ") and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     RowBox[{"\[Prime]", "\[Iota]"}]], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[CircleTimes]", 
    SubscriptBox[
     StyleBox["E",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Tau]", "\[Iota]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e9e6738d-e896-4bd6-85aa-13561d3ed488"],
 " (pseudoscalar, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["0", "-"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8fb5e21e-d271-4cc7-9ceb-48cc20011c8b"],
 "). The state of two spinor charges at one point in the channel ",
 Cell[BoxData[
  FormBox[
   StyleBox["K",
    FontFamily->"Helvetica",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0d7983e1-664a-465e-a750-617515b8306d"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftBracketingBar]", 
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "\[RightAngleBracket]", "\[Proportional]", 
    FractionBox["1", "2"], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["c", "TI"], 
      SuperscriptBox[
       StyleBox["c", "TI"], "\[Prime]"]}],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["c", "TI"], 
      SuperscriptBox[
       StyleBox["c", "TI"], "\[Prime]"]}], "*"], 
    SubsuperscriptBox["\[CapitalPsi]", 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["c", "TI"]}], "\[Dagger]"], 
    SubsuperscriptBox["\[CapitalPsi]", 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      SuperscriptBox[
       StyleBox["c", "TI"], "\[Prime]"]}], "\[Dagger]"], "\[LeftBracketingBar]",
     "0", "\[RightAngleBracket]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d321c1e5-81ee-43a6-8bb0-286c3ab7bfcc"],
 ", normalized, and the pair energy of a contact operator ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[ScriptCapitalO]",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ca680b7e-cedb-4405-9e2f-9c9e365653c8"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["pair",
      FontSlant->"Plain"]], 
    RowBox[{"[", 
     RowBox[{
      StyleBox["\[ScriptCapitalO]",
       FontSlant->"Plain"], ";", 
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"]}], "]"}], "\[LongEqual]", 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "\[RightBracketingBar]", 
      StyleBox["\[ScriptCapitalO]",
       FontSlant->"Plain"], "\[LeftBracketingBar]", 
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"]}], "\[RightAngleBracket]"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "43cf6b8f-ea53-4831-b1ca-3aa39c286081"],
 ", per unit coupling; negative means attraction. The operators are the three \
terms of the potentials and the contact limit of the exchange of the four \
gauge bosons of GEE, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", 
     StyleBox["p", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox["\[Eta]", 
     StyleBox["pp", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], ":", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["\[CapitalPsi]", "\[Dagger]"], 
       SubsuperscriptBox[
        StyleBox["A",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["SF",
          FontSlant->"Plain"], ",", 
         StyleBox["p", "TI"]}], 
        StyleBox["b",
         FontSlant->"Plain"]], "\[CapitalPsi]"}], ")"}], "2"], ":"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1f213b27-efbd-450e-a4d1-4d04609da91b"],
 " with the vertex matrices ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["A",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], 
     StyleBox["b",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["\[Gamma]", 
       StyleBox["LL",
        FontSlant->"Plain"], "0"], 
      SubsuperscriptBox["\[Gamma]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["p", "TI"]]}], ")"}], "\[CircleTimes]", 
    SubsuperscriptBox[
     StyleBox["t",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["b",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cb8dfa45-2357-4b94-99b5-01c4b6b8dc2d"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["t",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["b",
      FontSlant->"Plain"]], "\[LongEqual]", 
    FractionBox["1", "2"], 
    SubsuperscriptBox["\[Tau]", "\[Iota]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "41e8b2c4-9666-4041-b92e-ee3ab13e9b76"],
 " for ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c4878056-d9b4-47c7-917c-4a0f5eba0268"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["1",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c8be09ff-a9ed-4119-86d8-73b67cbe3062"],
 " for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "51107cc1-8f57-47ce-b78a-05e3c402f33f"],
 "). The result: the scalar term has ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a19dcbc2-3b6c-4a7d-9e18-6f7ff9a13170"],
 " in the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["0", "+"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f120d4b9-9be0-4095-b5a3-f56eac52961e"],
 " channels and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "11cb8449-aa1b-4bcb-8833-70bd27840327"],
 " in the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["0", "-"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "12a5d073-c7be-4a76-a9b9-2fef01ba0084"],
 " channels, the vector term ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", "4"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b6365a18-0efc-4fc3-bcf5-f035fb292395"],
 " everywhere, the pairing term ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "4"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "55a3ee88-09f0-4cc7-9393-3c54e3dd7d0c"],
 " in the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["0", "+"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b3f83b7d-6871-469d-8900-f5140e7d9873"],
 " channels, each ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d123fbc6-e492-4652-9ccc-e78465639f48"],
 " attracts (",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5e771f3b-a108-4274-8c6e-8d51cfdc52ed"],
 ") in the two channels with the same index and repels (",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "254a52e1-8e89-4bf1-bfb3-1ac0f983a0d8"],
 ") in the other four, and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6973b5c3-c403-47eb-b8b3-136e5760a56e"],
 " repels (",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", "4"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "64aba3f5-8ef0-408f-a345-a337389d38ae"],
 ") everywhere. In every channel"
}], "Text",ExpressionUUID->"0a8ccce3-ce83-4837-8d55-8f3bc28fa472"],

Cell[BoxData[
 FormBox[
  RowBox[{
   UnderoverscriptBox["\[Sum]", 
    RowBox[{"\[Iota]", "\[LongEqual]", "1"}], "3",
    LimitsPositioning->True], "\[ThinSpace]", 
   SubsuperscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["pair",
     FontSlant->"Plain"]], 
   RowBox[{"[", 
    RowBox[{
     SuperscriptBox[
      StyleBox["W", "TI"], "\[Iota]"], ";", 
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"]}], "]"}], "\[LongEqual]", 
   FractionBox["1", "4"], 
   SubsuperscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["pair",
     FontSlant->"Plain"]], 
   RowBox[{"[", 
    RowBox[{
     StyleBox["B", "TI"], ";", 
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"]}], "]"}], "\[LongEqual]", 
   RowBox[{"+", "1"}], ","}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"020e02d0-a73d-43c1-940d-c140e3c12a2d"],

Cell[TextData[{
 "the isospin Casimir of a triplet pair (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["T", "TI"], "\[RightVector]"], "1"], "\[CenterDot]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["T", "TI"], "\[RightVector]"], "2"], "\[LongEqual]", 
    RowBox[{"+", 
     FractionBox["1", "4"]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7256a7bb-6910-4032-92fb-8e9f69c68edb"],
 "): no gauge boson attracts a spin-zero pair in the symmetric vacuum. After \
the breaking of the symmetry in the channel ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5c24d63e-b43a-45bd-adb3-c428664f93c3"],
 ", the gauge field ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4d4350e8-cfc7-4596-bbfe-8abe36bf84e1"],
 " of the unbroken generator stays massless (the zeugon, the massless gauge \
boson of the superfluid; not the photon, since the DiracLike spinor has \
electric charge 0) and attracts the two charges of the condensed pair, which \
carry the opposite charges ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["T", "TI"], "3"], "\[LongEqual]", 
    RowBox[{"\[PlusMinus]", 
     FractionBox["1", "2"]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "59d8a05c-a2f5-4229-950d-7096278d079e"],
 ". The next cell computes the 42 pair energies exactly on the 256 states of \
one point (with the operators of Section I.5) and compares them with the \
table of the Rust program."
}], "Text",ExpressionUUID->"e62db8c1-4280-4359-9f7e-bf3e3459116b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"kPs", "[", "iota", "]"}], ":", " ", 
     RowBox[{"the", " ", "matrices", " ", 
      RowBox[{
       RowBox[{"K", "'"}], "^", "iota_LL"}]}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{"C_LL", " ", 
      RowBox[{"(", "x", ")"}], " ", "E_LL", " ", "tau_iota", " ", "of", " ", 
      "the", " ", "pseudoscalar", " ", "spin"}], "-", 
     RowBox[{"zero", " ", "pairs"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"kPs", "[", "iota_Integer", "]"}], " ", ":=", " ", 
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{"cLL", ",", " ", 
       RowBox[{"eLL", " ", ".", " ", 
        RowBox[{"sig", "[", 
         RowBox[{"[", 
          RowBox[{"iota", " ", "+", " ", "1"}], "]"}], "]"}]}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"pairState", "[", "k", "]"}], ":", " ", 
      RowBox[{
      "the", " ", "normalized", " ", "state", " ", "of", " ", "two", " ", 
       "charges", " ", "at", " ", "one", " ", "point", " ", "in", " ", "the", 
       " ", "channel", " ", "k"}], ":", " ", 
      RowBox[{
       RowBox[{"sum_ab", " ", "conj", 
        RowBox[{"(", "k_ab", ")"}], " ", 
        RowBox[{"c_a", "^", "dag"}], " ", 
        RowBox[{"c_b", "^", "dag"}]}], " ", "|", 
       RowBox[{"0", ">"}]}]}], ";", "\n", "   ", 
     RowBox[{
      RowBox[{"the", " ", "empty", " ", "state"}], " ", "|", 
      RowBox[{"0", ">", " ", 
       RowBox[{
       "is", " ", "the", " ", "first", " ", "basis", " ", "state"}]}]}]}], 
    " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"pairState", "[", "k_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"op", ",", " ", "w"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"op", " ", "=", " ", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"k", "[", 
               RowBox[{"[", 
                RowBox[{"a", ",", " ", "b"}], "]"}], "]"}], " ", "=!=", " ", 
              "0"}], ",", " ", 
             RowBox[{
              RowBox[{"Conjugate", "[", 
               RowBox[{"k", "[", 
                RowBox[{"[", 
                 RowBox[{"a", ",", " ", "b"}], "]"}], "]"}], "]"}], " ", 
              RowBox[{
               RowBox[{"cdOps", "[", 
                RowBox[{"[", "a", "]"}], "]"}], " ", ".", " ", 
               RowBox[{"cdOps", "[", 
                RowBox[{"[", "b", "]"}], "]"}]}]}], ",", " ", "0"}], "]"}], ",",
            " ", 
           RowBox[{"{", 
            RowBox[{"a", ",", " ", "8"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"b", ",", " ", "8"}], "}"}]}], "]"}]}], ";", "\n", "   ", 
        
        RowBox[{"w", " ", "=", " ", 
         RowBox[{"op", " ", ".", " ", 
          RowBox[{"UnitVector", "[", 
           RowBox[{"256", ",", " ", "1"}], "]"}]}]}], ";", "\n", "   ", 
        RowBox[{"w", "/", 
         RowBox[{"Norm", "[", "w", "]"}]}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"the", " ", "seven", " ", "contact", " ", 
     RowBox[{"operators", ":", " ", 
      RowBox[{
      "the", " ", "three", " ", "terms", " ", "of", " ", "the", " ", 
       "potentials", " ", "and", " ", "the", " ", "contact", " ", "limit", " ",
        "of", " ", "the", " ", "four", " ", "gauge", " ", "bosons"}]}]}], " ",
     "*)"}], "\n", 
   RowBox[{
    RowBox[{"channelOps", " ", "=", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<scalar\>\"", " ", "->", " ", 
        RowBox[{
         RowBox[{"1", "/", "2"}], " ", 
         RowBox[{"quartic", "[", 
