Cell[CellGroupData[{

Cell["III.G.5 The gradient coefficient and the regularization", "Section",ExpressionUUID->"490a8ca6-8902-4f57-9f1e-6318617e2b29"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["c",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7ed1be08-9c44-4ea8-94f9-41bd66a9dd39"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"[", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["a", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["Tay",
         FontSlant->"Plain"]}]], 
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox[
         StyleBox["q", "TI"], 
         StyleBox["SF",
          FontSlant->"Plain"], 
         StyleBox["pair",
          FontSlant->"Plain"]], ";", 
        SubsuperscriptBox[
         StyleBox["T", "TI"], 
         StyleBox["SF",
          FontSlant->"Plain"], 
         RowBox[{
          StyleBox["X", "TI"], ",", 
          StyleBox["c",
           FontSlant->"Plain"]}]]}], ")"}], "-", 
      SubsuperscriptBox[
       StyleBox["a", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["Tay",
         FontSlant->"Plain"]}]], 
      RowBox[{"(", 
       RowBox[{"0", ";", 
        SubsuperscriptBox[
         StyleBox["T", "TI"], 
         StyleBox["SF",
          FontSlant->"Plain"], 
         RowBox[{
          StyleBox["X", "TI"], ",", 
          StyleBox["c",
           FontSlant->"Plain"]}]]}], ")"}]}], "]"}], "/", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["pair",
        FontSlant->"Plain"]], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f20822e7-3120-4adf-8122-06ca38e38490"],
 " at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["pair",
      FontSlant->"Plain"]], "\[LongEqual]", "0.01"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "af41bed5-ab41-4394-ba67-5f34c16d56d7"],
 " and ",
 Cell[BoxData[
  FormBox["0.02", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6fc100b0-5dfb-4c61-af34-558673103828"],
 " with the Richardson extrapolation. The six directions of the grid are \
exact at second order in the twist (the term of second order is a quadratic \
polynomial in the direction). ",
 StyleBox["The regularization (a remark: what it means and why it matters).",
  FontWeight->"Bold"],
 " The model has the cutoff ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox[
      StyleBox["q", "TI"], "\[RightVector]"], "\[RightBracketingBar]"}], "<", 
    
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d1cb264e-3ddb-4d05-bdec-219ed3638563"],
 " on the momenta of the uniform states, and for a moving pair it must be put \
on one of two momenta. With the cutoff on the momenta of the two charges of \
the pair, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftBracketingBar]", 
     RowBox[{
      OverscriptBox[
       StyleBox["q", "TI"], "\[RightVector]"], "\[PlusMinus]", 
      FractionBox["1", "2"], 
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["pair",
        FontSlant->"Plain"]], 
      SubscriptBox[
       OverscriptBox[
        StyleBox["e", "TI"], "\[RightVector]"], "3"]}], 
     "\[RightBracketingBar]"}], "<", 
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0a63f356-b1b3-4e5d-9a96-03e4258d4981"],
 " (a lens of two spheres), a moving pair loses the pairs in a shell at the \
cutoff whose thickness is of order ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftBracketingBar]", 
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["pair",
      FontSlant->"Plain"]], "\[RightBracketingBar]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4cc08d3b-2add-4417-bcc3-f1cea919ad98"],
 ", so that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], 
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["q", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      StyleBox["pair",
       FontSlant->"Plain"]], ")"}], "-", 
    StyleBox["a", "TI"], 
    RowBox[{"(", "0", ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b854c02c-9c5b-494e-8761-f35a89f1ca8d"],
 " is linear in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftBracketingBar]", 
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["pair",
      FontSlant->"Plain"]], "\[RightBracketingBar]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e6002531-6a81-45e6-ae85-c74037ba28a6"],
 " and a gradient expansion does not exist. With the cutoff on the relative \
momentum, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox[
      StyleBox["q", "TI"], "\[RightVector]"], "\[RightBracketingBar]"}], "<", 
    
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c726e5b4-f1e3-4ebe-a409-2bb157fe3766"],
 ", the change is quadratic; this routing is used here (it is the routing of \
the twisted states of the coefficients of the kinetic part at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "05b4b221-2aee-4239-afc2-7b7f23be55cd"],
 ", where the uniform twist shifts the momenta inside the fixed sphere). The \
remaining error of the regularization is measured by the twist ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["q", "TI"], "\[ThinSpace]", 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], "3"], "\[CircleTimes]", 
    FractionBox["1", "2"], 
    SubscriptBox["\[Tau]", "3"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ce11f9ea-8466-43b5-8fa5-151d34baa677"],
 " of the unbroken generator ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7d1dd252-7f4d-453f-a97b-fbf07e73225b"],
 ", which does not change the field along ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox[
     StyleBox["e", "TI"], "\[RightVector]"], "3"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5d778e66-7af8-4d7b-b7c7-73ab46e63e60"],
 " and would cost nothing in a gauge-invariant theory; with the cutoff it \
costs the spurious coefficient ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["c",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     RowBox[{
      StyleBox["T",
       FontSlant->"Plain"], "\[InvisibleSpace]", "3"}]}]], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e6e288b5-7901-4762-aa19-45874d176943"],
 ", about a fifth of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["c",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "96805725-5db3-417a-a9a6-f09041de9600"],
 " (the Rust table). This matters for the size of the Ginzburg number, which \
is proportional to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SuperscriptBox[
     StyleBox["c",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "3"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a9964432-39e9-416a-9154-25b0a3eca9a9"],
 ": changing ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["c",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "851fdb3b-0aff-4486-87a4-1b212095d5a9"],
 " by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    SubsuperscriptBox[
     StyleBox["c",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      RowBox[{
       StyleBox["T",
        FontSlant->"Plain"], "\[InvisibleSpace]", "3"}]}]]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3899ba38-37dc-4549-8972-884f2d530fb7"],
 " changes it by a factor of about 2 either way (Section III.G.7), not enough \
to change the conclusion. The next cells compute the gradient coefficient \
from the phase twist and from the isospin twist, check that it does not \
depend on the quadrature (for CJT: 40 radial nodes, and a product rule of 144 \
directions), and compare the two regularizations on a product rule: 24 \
Gauss-Legendre nodes in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["cos",
     FontSlant->"Plain"], "\[ThinSpace]", "\[Theta]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ba3a296d-f3cb-45b8-b065-d94ad7d89da3"],
 " (12 on each half), 6 angles ",
 Cell[BoxData[
  FormBox["\[CurlyPhi]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1f376a04-9d63-4e2d-8226-f83e79c1f0bd"],
 " and 24 radial nodes on ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"0", ",", 
     StyleBox["r", "TI"], 
     RowBox[{"(", 
      OverscriptBox[
       StyleBox["n", "TI"], "\[RightVector]"], ")"}]}], "]"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "29c7d1f8-e63b-48f0-8fc3-86622ecc6004"],
 " in the direction ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["n", "TI"], "\[RightVector]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3eb45f3b-271c-4622-921f-f09cf2e71104"],
 ", with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r", "TI"], "\[LongEqual]", 
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2bad5046-6712-42ec-9837-080e6e118712"],
 " for the sphere and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r", "TI"], 
    RowBox[{"(", 
     OverscriptBox[
      StyleBox["n", "TI"], "\[RightVector]"], ")"}], "\[LongEqual]", 
    RowBox[{"-", 
     FractionBox["1", "2"]}], 
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["pair",
      FontSlant->"Plain"]], 
    RowBox[{"\[LeftBracketingBar]", 
     SubscriptBox[
      StyleBox["n", "TI"], "3"], "\[RightBracketingBar]"}], "+", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox["\[CapitalLambda]", 
        StyleBox["LL",
         FontSlant->"Plain"], "2"], "-", 
       FractionBox["1", "4"], 
       SuperscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox[
          StyleBox["q", "TI"], 
          StyleBox["SF",
           FontSlant->"Plain"], 
          StyleBox["pair",
           FontSlant->"Plain"]], ")"}], "2"], 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         SubsuperscriptBox[
          StyleBox["n", "TI"], "3", "2"]}], ")"}]}], ")"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "01c154e0-77ac-4816-b4db-ae947f7e17e7"],
 " for the lens."
}], "Text",ExpressionUUID->"64c0d7da-0336-4601-b6e1-2773f6a30c34"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"gzGrad", "[", 
      RowBox[{
      "t", ",", " ", "t2", ",", " ", "s", ",", " ", "relax", ",", " ", 
       "nodes"}], "]"}], ":", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"c", ",", " ", 
        RowBox[{"c", 
         RowBox[{"(", "0.01", ")"}]}], ",", " ", 
        RowBox[{"c", 
         RowBox[{"(", "0.02", ")"}]}]}], "}"}], " ", "at", " ", "T_c", " ", 
      "from", " ", "the", " ", "twist", " ", "of", " ", "the", " ", "isospin",
       " ", "matrix", " ", "t2"}]}], ",", " ", 
    RowBox[{
     RowBox[{"twist", " ", "strength", "\n", "   ", "q"}], " ", "=", " ", 
     RowBox[{
      RowBox[{"k", "/", "s"}], " ", "for", " ", "the", " ", "pair", " ", 
      "momentum", " ", "k", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"s", " ", "=", " ", 
         RowBox[{"2", " ", "for", " ", "the", " ", "phase", " ", "twist"}]}], 
        ",", " ", 
        RowBox[{"s", " ", "=", " ", 
         RowBox[{
         "1", " ", "for", " ", "the", " ", "isospin", " ", "twists"}]}]}], 
       ")"}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"gzGrad", "[", 
      RowBox[{"t_", ",", " ", "t2_", ",", " ", "s_", ",", " ", 
       RowBox[{"relax_", " ", ":", " ", "True"}], ",", " ", 
       RowBox[{"nodes_", " ", ":", " ", "Automatic"}]}], "]"}], " ", ":=", 
     " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"tc", " ", "=", " ", 
          RowBox[{"thTc", "[", "t", "]"}]}], ",", " ", "a0", ",", " ", "c1", ",",
          " ", "c2"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"a0", " ", "=", " ", 
         RowBox[{
          RowBox[{"gzA", "[", 
           RowBox[{
           "t", ",", " ", "tc", ",", " ", "0.", ",", " ", "t2", ",", " ", 
            "relax", ",", " ", "nodes"}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"c1", " ", "=", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"gzA", "[", 
              RowBox[{"t", ",", " ", "tc", ",", " ", 
               RowBox[{"0.01", "/", "s"}], ",", " ", "t2", ",", " ", "relax", 
               ",", " ", "nodes"}], "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", "a0"}], ")"}], "/", 
          RowBox[{"0.01", "^", "2"}]}]}], ";", "\n", "   ", 
        RowBox[{"c2", " ", "=", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"gzA", "[", 
              RowBox[{"t", ",", " ", "tc", ",", " ", 
               RowBox[{"0.02", "/", "s"}], ",", " ", "t2", ",", " ", "relax", 
               ",", " ", "nodes"}], "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", "a0"}], ")"}], "/", 
          RowBox[{"0.02", "^", "2"}]}]}], ";", "\n", "   ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"4", " ", "c1"}], " ", "-", " ", "c2"}], ")"}], "/", 
           "3"}], ",", " ", "c1", ",", " ", "c2"}], "}"}]}]}], "]"}]}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"c", ",", " ", "c1", ",", " ", "c2", ",", " ", "cIso"}], 
         "}"}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"c", ",", " ", "c1", ",", " ", "c2"}], "}"}], " ", "=", 
          " ", 
          RowBox[{"gzGrad", "[", 
           RowBox[{"t", ",", " ", 
            RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", " ", "2."}], 
           "]"}]}], ";", "\n", "   ", 
         RowBox[{"cIso", " ", "=", " ", 
          RowBox[{
           RowBox[{"gzGrad", "[", 
            RowBox[{"t", ",", " ", 
             RowBox[{
              RowBox[{"PauliMatrix", "[", "1", "]"}], "/", "2"}], ",", " ", 
             "1."}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{"\"\<WP3-G5 \>\"", " ", "<>", " ", "t"}], ",", " ", 
           RowBox[{
            RowBox[{"thName", "[", "t", "]"}], " ", "<>", 
            " ", "\"\<: the isospin twist gives the gradient coefficient of \
the phase twist, c = \>\"", " ", "<>", " ", 
            RowBox[{"ToString", "[", 
             RowBox[{"NumberForm", "[", 
              RowBox[{"c", ",", " ", "10"}], "]"}], "]"}], " ", "<>", 
            " ", "\"\< (isospin invariance; relative difference)\>\""}], ",", 
           "\n", "    ", 
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"cIso", "/", "c"}], " ", "-", " ", "1"}], "]"}], ",", 
           " ", 
           RowBox[{"10", "^", 
            RowBox[{"-", "8"}]}], ",", " ", 
           RowBox[{"\"\<P3-G5 \>\"", " ", "<>", " ", "t"}], ",", " ", 
           RowBox[{"\"\<YP3-G5 \>\"", " ", "<>", " ", "t"}]}], "]"}], ";", 
         "\n", "   ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{"\"\<WP3-G6 \>\"", " ", "<>", " ", "t"}], ",", " ", 
           RowBox[{
            RowBox[{"thName", "[", "t", "]"}], " ", "<>", 
            " ", "\"\<: c > 0 and the extrapolation in k converges: c(0.01) = \
\>\"", " ", "<>", " ", 
            RowBox[{"ToString", "[", 
             RowBox[{"NumberForm", "[", 
              RowBox[{"c1", ",", " ", "10"}], "]"}], "]"}], " ", "<>", 
            " ", "\"\<, c(0.02) = \>\"", " ", "<>", " ", 
            RowBox[{"ToString", "[", 
             RowBox[{"NumberForm", "[", 
              RowBox[{"c2", ",", " ", "10"}], "]"}], "]"}], " ", "<>", 
            " ", "\"\<, extrapolated \>\"", " ", "<>", " ", 
            RowBox[{"ToString", "[", 
             RowBox[{"NumberForm", "[", 
              RowBox[{"c", ",", " ", "10"}], "]"}], "]"}], " ", "<>", 
            " ", "\"\< = Rust (relative difference; 1 is added if c <= 0 or \
the two values differ by more than 1e-3 of c)\>\""}], ",", "\n", "    ", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"c", " ", "-", " ", 
               RowBox[{"gzRust", "[", 
                RowBox[{"t", ",", " ", "\"\<c\>\""}], "]"}]}], "]"}], "/", 
             RowBox[{"gzRust", "[", 
              RowBox[{"t", ",", " ", "\"\<c\>\""}], "]"}]}], " ", "+", " ", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"c", " ", ">", " ", "0"}], " ", "&&", " ", 
               RowBox[{
                RowBox[{
                 RowBox[{"Abs", "[", 
                  RowBox[{"c2", " ", "-", " ", "c1"}], "]"}], "/", "c"}], " ",
                 "<", " ", 
                RowBox[{"10", "^", 
                 RowBox[{"-", "3"}]}]}]}], ",", " ", "0", ",", " ", "1"}], 
             "]"}]}], ",", " ", 
           RowBox[{"10", "^", 
            RowBox[{"-", "8"}]}], ",", " ", 
           RowBox[{"\"\<P3-G6 \>\"", " ", "<>", " ", "t"}], ",", " ", 
           RowBox[{"\"\<YP3-G6 \>\"", " ", "<>", " ", "t"}]}], "]"}], ";", 
         "\n", "   ", 
         RowBox[{
          RowBox[{"gzResults", "[", "t", "]"}], " ", "=", " ", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"gzResults", "[", "t", "]"}], ",", " ", 
            RowBox[{"<|", 
             RowBox[{"\"\<c\>\"", " ", "->", " ", "c"}], "|>"}]}], 
           "]"}]}]}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"t", ",", " ", "thTags"}], "}"}]}], "]"}], ";"}]}]}]], "Input",\

