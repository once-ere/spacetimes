                    "--", " ", 
                    "matrices"}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]\
}]}]}]}]}]}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"sig", "[", "0", "]"}], " ", "=", " ", 
     RowBox[{"IdentityMatrix", "[", "2", "]"}]}], ";", " ", 
    RowBox[{
     RowBox[{"sig", "[", "1", "]"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}]}], "}"}]}], ";", " ", 
    RowBox[{
     RowBox[{"sig", "[", "2", "]"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", 
         RowBox[{"-", "I"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"I", ",", " ", "0"}], "}"}]}], "}"}]}], ";", " ", 
    RowBox[{
     RowBox[{"sig", "[", "3", "]"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", 
         RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"sigbar", "[", "0", "]"}], " ", "=", " ", 
     RowBox[{"sig", "[", "0", "]"}]}], ";", " ", 
    RowBox[{
     RowBox[{"sigbar", "[", "j_", "]"}], " ", ":=", " ", 
     RowBox[{"-", 
      RowBox[{"sig", "[", "j", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"z2", " ", "=", " ", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"gam", "[", "p_", "]"}], " ", ":=", " ", 
     RowBox[{"ArrayFlatten", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"z2", ",", " ", 
          RowBox[{"sig", "[", "p", "]"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"sigbar", "[", "p", "]"}], ",", " ", "z2"}], "}"}]}], "}"}],
       "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gch", " ", "=", " ", 
     RowBox[{"I", " ", 
      RowBox[{
       RowBox[{"gam", "[", "0", "]"}], ".", 
       RowBox[{"gam", "[", "1", "]"}], ".", 
       RowBox[{"gam", "[", "2", "]"}], ".", 
       RowBox[{"gam", "[", "3", "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"cC", " ", "=", " ", 
     RowBox[{"I", " ", 
      RowBox[{
       RowBox[{"gam", "[", "2", "]"}], ".", 
       RowBox[{"gam", "[", "0", "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"bet", " ", "=", " ", 
     RowBox[{"gam", "[", "0", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"eps2", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "0"}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"aa", " ", "=", " ", 
     RowBox[{"cC", ".", "gch"}]}], ";"}], 
   "                                     ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "Lorentz", " ", "scalar", " ", "pair", " ", "matrix", " ", 
      "C", " ", 
      RowBox[{"gamma", "^", "ch"}]}], ",", " ", 
     RowBox[{"4", " ", "x", " ", "4"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"eIso", "[", "s_", "]"}], " ", ":=", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"s", " ", "==", " ", "0"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", "1", "}"}], ",", " ", 
         RowBox[{"{", "0", "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", "0", "}"}], ",", " ", 
         RowBox[{"{", "1", "}"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"upIdx", " ", "=", " ", 
     RowBox[{"Range", "[", 
      RowBox[{"1", ",", " ", "8", ",", " ", "2"}], "]"}]}], ";", " ", 
    RowBox[{"dnIdx", " ", "=", " ", 
     RowBox[{"Range", "[", 
      RowBox[{"2", ",", " ", "8", ",", " ", "2"}], "]"}]}], ";", " ", 
    RowBox[{"chiIdx", " ", "=", " ", 
     RowBox[{"Range", "[", 
      RowBox[{"9", ",", " ", "12"}], "]"}]}], ";", " ", 
    RowBox[{"chi2Idx", " ", "=", " ", 
     RowBox[{"Range", "[", 
      RowBox[{"13", ",", " ", "16"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"z44", " ", "=", " ", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", " ", 
       RowBox[{"{", 
        RowBox[{"4", ",", " ", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"k3", " ", "=", " ", 
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{"aa", ",", " ", 
       RowBox[{"eps2", ".", 
        RowBox[{"sig", "[", "3", "]"}]}]}], "]"}]}], ";"}], "        ", 
   RowBox[{"(*", " ", 
    RowBox[{
    "the", " ", "old", " ", "triplet", " ", "matrix", " ", "on", " ", "the", " ",
      "eight", " ", "components"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"vS", "[", "s_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{"aa", ",", " ", 
        RowBox[{"eIso", "[", "s", "]"}]}], "]"}], "/", "2"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "the", " ", "pair", " ", "matrix", " ", "of", " ", "Psi_LL", " ", "with", 
     " ", "the", " ", "singlet", " ", "a", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"0", ":", " ", "chi_SH"}], ",", " ", 
       RowBox[{"1", ":", " ", 
        RowBox[{
         RowBox[{"chi", "'"}], "_SH"}]}]}], ")"}], " ", "and", " ", "the", " ",
      "isospin", " ", "component", " ", "s"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"kP", "[", 
      RowBox[{"a_", ",", " ", "s_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"k", " ", "=", " ", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0", ",", " ", 
            RowBox[{"{", 
             RowBox[{"16", ",", " ", "16"}], "}"}]}], "]"}]}], ",", " ", 
         RowBox[{"o", " ", "=", " ", 
          RowBox[{"8", " ", "+", " ", 
           RowBox[{"4", " ", "a"}]}]}]}], "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{
         RowBox[{"k", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"1", " ", ";;", " ", "8"}], ",", " ", 
            RowBox[{
             RowBox[{"o", " ", "+", " ", "1"}], " ", ";;", " ", 
             RowBox[{"o", " ", "+", " ", "4"}]}]}], "]"}], "]"}], " ", "=", 
         " ", 
         RowBox[{"vS", "[", "s", "]"}]}], ";", " ", 
        RowBox[{
         RowBox[{"k", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{
             RowBox[{"o", " ", "+", " ", "1"}], " ", ";;", " ", 
             RowBox[{"o", " ", "+", " ", "4"}]}], ",", " ", 
            RowBox[{"1", " ", ";;", " ", "8"}]}], "]"}], "]"}], " ", "=", " ", 
         RowBox[{"-", 
          RowBox[{"Transpose", "[", 
           RowBox[{"vS", "[", "s", "]"}], "]"}]}]}], ";", " ", "k"}]}], 
      "]"}]}], ";"}]}]}]], "Input",
