            RowBox[{"Join", "[", 
             RowBox[{"mism", ",", " ", "cmism"}], "]"}]}], ",", 
           " ", "\"\<; \>\""}], "]"}]}]}], "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"noNeutral", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{"channels", ",", " ", 
       RowBox[{
