       " ", "\"\<sh_hg_masses.csv\>\"", ",", 
       " ", "\"\<sh_hg_values.csv\>\""}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"num", "[", "s_String", "]"}], " ", ":=", " ", 
     RowBox[{"ToExpression", "[", 
      RowBox[{"StringReplace", "[", 
       RowBox[{"s", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<e\>\"", " ", "->", " ", "\"\<*^\>\""}], "}"}]}], "]"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"col", "[", 
      RowBox[{"h_", ",", " ", "n_"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"Position", "[", 
       RowBox[{"h", ",", " ", "n"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", " ", "1"}], "]"}], "]"}]}], ";"}]}]}]], "Input",
 CellLabel->
  "In[636]:=",ExpressionUUID->"69cc210e-a8b3-480f-a744-1a62d36cc472"],

Cell[CellGroupData[{

Cell["\<\
R.3.1 The custodial algebra of the effective Lagrangian (check WH-1)\
\>", "Subsection",ExpressionUUID->"db9bc078-70cb-401b-a7af-7ca8603a1eee"],

Cell[TextData[{
 "Near its vacuum the bidoublet has the effective Lagrangian ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["Z", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]], "\[ThinSpace]", 
    StyleBox["tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"\[PartialD]", 
         StyleBox["\[ScriptCapitalM]",
          FontSlant->"Plain"]}], ")"}], "\[Dagger]"], "\[PartialD]", 
      StyleBox["\[ScriptCapitalM]",
       FontSlant->"Plain"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fc0ccdc7-e7b5-4720-8400-3e9d61a39e63"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["\[ScriptCapitalM]",
      FontSlant->"Plain"], 
     StyleBox["SH",
      FontSlant->"Plain"]], "\[RightArrow]", 
    StyleBox["L", "TI"], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["\[ScriptCapitalM]",
      FontSlant->"Plain"], 
     StyleBox["SH",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     StyleBox["R", "TI"], 
     StyleBox["T", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f59f5a4e-546c-4aa6-a207-cb8eb0e9eb54"],
 ". Chemical potentials ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Mu]", 
    StyleBox["a", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ba983840-abac-4e62-a35e-b4e921e8c3cd"],
 " of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["T", "TI"], 
    RowBox[{
     StyleBox["a", "TI"], ",", 
     StyleBox["SM",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ce86423d-48ca-491f-94da-7a49535fec4b"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Nu]", 
    StyleBox["a", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "adc9062f-f20f-4b89-8b28-e054895cfe89"],
 " of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["a", "TI"], ",", 
     StyleBox["R",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "58e12161-6ff1-41ea-8bc0-289e0ead3bc3"],
 " replace ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "0"], 
    StyleBox["\[ScriptCapitalM]",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0bc58ccc-fecd-407c-aae9-a86477fcd46e"],
 " by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["i", "TI"], 
    RowBox[{"(", 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       StyleBox["a", "TI"],
       LimitsPositioning->True], "\[ThinSpace]", 
      SubscriptBox["\[Mu]", 
       StyleBox["a", "TI"]], 
      FractionBox[
       SuperscriptBox["\[Tau]", 
        StyleBox["a", "TI"]], "2"], 
      StyleBox["\[ScriptCapitalM]",
       FontSlant->"Plain"], "+", 
      StyleBox["\[ScriptCapitalM]",
       FontSlant->"Plain"], "\[ThinSpace]", 
      UnderscriptBox["\[Sum]", 
       StyleBox["a", "TI"],
       LimitsPositioning->True], "\[ThinSpace]", 
      SubscriptBox["\[Nu]", 
       StyleBox["a", "TI"]], 
      FractionBox[
       SuperscriptBox[
        RowBox[{"(", 
         SuperscriptBox["\[Tau]", 
          StyleBox["a", "TI"]], ")"}], 
        StyleBox["T", "TI"]], "2"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "91ebf1d2-9a3b-4cb8-882a-06b33040814a"],
 " and lower the energy of the static vacuum ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["\[ScriptCapitalM]",
     FontSlant->"Plain"], "\[LongEqual]", "\[Phi]", "\[ThinSpace]", 
    StyleBox["i", "TI"], 
    SuperscriptBox["\[Tau]", "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "47965198-206b-4fcb-983e-3e4814865f2c"],
 " by ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["Z", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5358c9b2-ab46-483e-9608-1576dc9b5b30"],
 " times the squared norm of that matrix. The susceptibilities are minus the \
second derivatives of the energy: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Chi]", 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       StyleBox["T", "TI"], 
       StyleBox["a", "TI"]], ",", 
      SuperscriptBox[
       StyleBox["T", "TI"], 
       StyleBox["b", "TI"]]}], ")"}], "\[LongEqual]", "\[Chi]", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["T", "TI"], 
       StyleBox["R",
        FontSlant->"Plain"], 
       StyleBox["a", "TI"]], ",", 
      SubsuperscriptBox[
       StyleBox["T", "TI"], 
       StyleBox["R",
        FontSlant->"Plain"], 
       StyleBox["b", "TI"]]}], ")"}], "\[LongEqual]", 
    RowBox[{"-", "\[Chi]"}], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       StyleBox["T", "TI"], 
       StyleBox["a", "TI"]], ",", 
      SubsuperscriptBox[
       StyleBox["T", "TI"], 
       StyleBox["R",
        FontSlant->"Plain"], 
       StyleBox["b", "TI"]]}], ")"}], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["Z", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]], 
    SuperscriptBox["\[Phi]", "2"], 
    SubscriptBox["\[Delta]", 
     StyleBox["ab", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "105f08d7-a4ad-47a9-8c7f-c04ef6f093e0"],
 ". With ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["Y", "TI"], 
     StyleBox["SM",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     RowBox[{"3", ",", 
      StyleBox["R",
       FontSlant->"Plain"]}]], "+", 
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]], "/", "4"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "572954c2-4bd7-461a-a2fd-cb9f7f45f21c"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "59cded16-b202-4d0b-b57d-52faed64fc12"],
 " unbroken, the charge ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["Q", "TI"], 
    StyleBox["SM",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ad7ccaf6-99d2-4ef4-85c5-4524c7d762a9"],
 " does not respond; the mass matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["a", "TI"]], 
    SubscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["b", "TI"]], 
    SuperscriptBox["\[Chi]", 
     StyleBox["ab", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d989faa9-e34c-44a5-beac-f147e53ffd22"],
 " of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox[
      StyleBox["W", "TI"], "1"], ",", 
     SuperscriptBox[
      StyleBox["W", "TI"], "2"], ",", 
     SuperscriptBox[
      StyleBox["W", "TI"], "3"], ",", 
     StyleBox["B", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5934f4ca-ac12-40de-b1ed-bd96e6306ed2"],
 " has the eigenvalues ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "38560ecb-9c1a-4286-ab5e-77be14252368"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["g", "TI"], "2"], 
    SubscriptBox[
     StyleBox["Z", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]], 
    SuperscriptBox["\[Phi]", "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c0d8f8fe-1fbe-400e-8096-9df411270bcc"],
 " (twice) and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       StyleBox["g", "TI"], "2"], "+", 
      SuperscriptBox[
       StyleBox["g", "TI"], 
       RowBox[{"\[Prime]", "2"}]]}], ")"}], 
    SubscriptBox[
     StyleBox["Z", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]], 
    SuperscriptBox["\[Phi]", "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0c5c6b27-d05f-4c5f-b379-4282fa535952"],
 ", so that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["W", "TI"]], "\[LongEqual]", 
    StyleBox["gv", "TI"], "/", "2"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "68c1a553-8465-4cb9-9028-6afae415263e"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["Z", "TI"]], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        StyleBox["g", "TI"], "2"], "+", 
       SuperscriptBox[
        StyleBox["g", "TI"], 
        RowBox[{"\[Prime]", "2"}]]}], ")"}], 
     RowBox[{"1", "/", "2"}]], 
    StyleBox["v", "TI"], "/", "2"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "466da2d8-398e-4f29-a165-1c52bda82d61"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["v", "TI"], "2"], "\[LongEqual]", "4", 
    SubscriptBox[
     StyleBox["Z", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]], 
    SuperscriptBox["\[Phi]", "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6366df4e-1896-4e99-8e9d-40c25ac25687"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", "\[LongEqual]", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5c9cf754-013c-42a6-a60a-fbf048751e43"],
 ". This is the custodial structure that the Rust program finds numerically \
in all five methods."
}], "Text",ExpressionUUID->"f85337ab-ac41-4668-8535-78942161c2fa"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", 
          RowBox[{"--", 
