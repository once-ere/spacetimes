      " ", 
      RowBox[{
       RowBox[{"hg2", "[", 
        RowBox[{"[", "iR", "]"}], "]"}], " ", "==", " ", "z2"}], " ", "&&", 
      " ", 
      RowBox[{
       RowBox[{"hg", "[", 
        RowBox[{"[", "8", "]"}], "]"}], " ", "==", " ", 
       RowBox[{"i2", "/", "2"}]}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"hg2", "[", 
        RowBox[{"[", "8", "]"}], "]"}], " ", "==", " ", 
       RowBox[{
        RowBox[{"-", "i2"}], "/", "2"}]}], " ", "&&", "\n", "  ", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"hg", "[", 
           RowBox[{"[", "a", "]"}], "]"}], ".", 
          RowBox[{"hg", "[", 
           RowBox[{"[", "a", "]"}], "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"a", ",", " ", "3"}], "}"}]}], "]"}], " ", "==", " ", 
       RowBox[{
        RowBox[{"3", "/", "4"}], " ", "i2"}]}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"hg2", "[", 
           RowBox[{"[", "a", "]"}], "]"}], ".", 
          RowBox[{"hg2", "[", 
           RowBox[{"[", "a", "]"}], "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"a", ",", " ", "3"}], "}"}]}], "]"}], " ", "==", " ", 
