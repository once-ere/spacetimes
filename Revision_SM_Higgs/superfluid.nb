 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"660b0a7c-9471-4935-966b-33cc88abf7e8"],

Cell[TextData[{
 "for a bilinear term, and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["N",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"-", 
     SubscriptBox[
      StyleBox["G", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"]]}], 
    SubsuperscriptBox[
     StyleBox["w", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]], 
    StyleBox["\[ScriptCapitalP]",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
