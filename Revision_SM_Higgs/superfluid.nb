                RowBox[{"Transpose", "[", "cols", "]"}]}], "]"}], "]"}]}]}], ";",
            "\n", "     ", 
           RowBox[{"pp", " ", "=", " ", 
            RowBox[{"LinearSolve", "[", 
             RowBox[{"amat", ",", " ", 
              RowBox[{"perp", "[", 
               RowBox[{"cols", " ", ".", " ", 
                RowBox[{"kd", "[", 
                 RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}], "]"}]}], ";", 
           "\n", "     ", 
           RowBox[{"pnorm", " ", "=", " ", 
            RowBox[{"Norm", "[", "pp", "]"}]}], ";", " ", 
           RowBox[{"p", " ", "=", " ", 
            RowBox[{
             RowBox[{"kd", "[", 
              RowBox[{"[", "3", "]"}], "]"}], " ", "+", " ", "pp"}]}]}]}], 
         "]"}], ";", "\n", "   ", 
        RowBox[{"kap", " ", "=", " ", 
         RowBox[{"p", " ", ".", " ", "chi"}]}], ";", "\n", "   ", 
        RowBox[{"pm", " ", "=", " ", 
         RowBox[{
          RowBox[{"interaction", "[", 
           RowBox[{"ts", ",", " ", "zero8", ",", " ", "kap"}], "]"}], "[", 
          RowBox[{"[", "3", "]"}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"phi", " ", "=", " ", 
         RowBox[{
