Cell[CellGroupData[{

Cell["R.2.5 Remark R9: the charges of the lightest quasi-particles", \
"Subsection",ExpressionUUID->"551aeda1-6086-472b-9ea4-464251e0a030"],

Cell[TextData[{
 StyleBox["The remark.",
  FontWeight->"Bold"],
 " \"The lightest quasi-particle of the superfluid has the electric charge ",
 Cell[BoxData[
  FormBox[
   FractionBox["3", "4"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e7a3a451-4574-40f2-a25c-52019cfde9e0"],
 ".\" It is true in the first version and not in the second. ",
 StyleBox["First version.",
  FontWeight->"Bold"],
 " The condensate along ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalPhi]", 
    StyleBox["SH",
     FontSlant->"Plain"], 
    StyleBox["d",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d8fc17f9-da17-4619-a284-f053234da886"],
 " pairs the down component of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "154f83ac-50cf-4297-889f-03b1721ebfbf"],
 " with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Chi]", 
    StyleBox["SH",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a14634ab-43b3-4478-9dbf-35d2f018e729"],
 " and leaves the up component unpaired; its block of the Bogoliubov-de \
Gennes matrix is that of a free Dirac field of the mass ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["M", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"], 
    StyleBox["u",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0d7e7793-a2f9-4479-a7aa-fc6e74ccd15f"],
 ", so the lowest excitation is an up particle, of the charge ",
 Cell[BoxData[
  FormBox[
   FractionBox["3", "4"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5b89e6f0-adbc-4415-81a3-8651ae75eeb4"],
 ", with the energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftBracketingBar]", 
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["u",
      FontSlant->"Plain"]], "\[RightBracketingBar]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "816cba55-8dd7-4532-8d15-45f1a49b3a09"],
 " at zero momentum, and this is the gap. ",
 StyleBox["Second version.",
  FontWeight->"Bold"],
 " Every constituent is paired, the gap is larger in every method, and no \
block is that of a free field. The quasi-particles of the first pair mix a \
down particle with a hole of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Chi]", 
    StyleBox["SH",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1727e785-8a76-4f8b-b68c-69c72ad72ae8"],
 ", those of the second an up particle with a hole of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Chi]", 
    StyleBox["SH",
     FontSlant->"Plain"], "\[Prime]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "575cc98a-876c-4679-92ba-c68d671cce6b"],
 "; a hole carries the opposite charges of the particle that is missing. The \
next cell computes the charges: within each pair the two constituents have \
the same charges, so the mixing keeps them, and the two pairs have ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["T", "TI"], 
     RowBox[{"3", ",", 
      StyleBox["SM",
       FontSlant->"Plain"]}]], "+", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     RowBox[{"3", ",", 
      StyleBox["R",
       FontSlant->"Plain"]}]], "\[LongEqual]", 
    RowBox[{"-", 
     FractionBox["1", "2"]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "453f0819-1595-464a-9d40-f20891444d10"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", 
    FractionBox["1", "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "71b225a1-1621-4078-adf0-7eb1bd5b6b0a"],
 " with the same ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "de036095-3017-47ab-93c3-c10822801c37"],
 ", a doublet of the custodial group ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["V",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "608bddbc-4f94-40fc-b6a8-edfa810d562b"],
 " that the ground state keeps. The lightest quasi-particles of the second \
version are therefore a doublet of the charges ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    FractionBox["1", "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0c7dbbdc-1813-4a30-9184-adb3a797edf6"],
 " and ",
 Cell[BoxData[
  FormBox[
   FractionBox["3", "4"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "78277bfd-25f9-4de3-b9c5-29d9b34ab54a"],
 ", of one mass, with their antiparticles. ",
 StyleBox["Why it matters.",
  FontWeight->"Bold"],
 " No particle of such a charge has been observed, and the lightest of them \
would be stable, since the charges of the particles of the Standard Model are \
multiples of ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "56a3a73d-6f80-4765-b514-8fa3c0c94aa7"],
 ". Whether this excludes the model depends on their mass in GeV, the gap \
times ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalLambda]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7869c024-0184-4c7d-ab34-65ec1c4a1794"],
 ", which stage 4 fixes (Section R.3). The constituents have fractional \
charges because of the chosen hypercharges: with ",
 Cell[BoxData[
  FormBox[
   StyleBox["y", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1212bb14-4d9e-4ec4-82fe-1d1ffeab6ef2"],
 " for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f1be89d7-0337-4e7c-b25a-c10f542a8f7e"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], "-", 
    StyleBox["y", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "51e3095d-d006-4938-ba33-ed8b85bdf9e6"],
 " for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Chi]", 
    StyleBox["SH",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "01c32cf5-dd3e-4ecd-87a9-61228711138a"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", "2"]}], "-", 
    StyleBox["y", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b341a6f8-297a-406c-9128-6f1440d1d785"],
 " for ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Chi]", 
    StyleBox["SH",
     FontSlant->"Plain"], "\[Prime]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a0bb18ab-d35e-4337-a966-ccbc20b824eb"],
 " the pair fields keep the hypercharges ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    FractionBox["1", "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2696e2d7-367c-4447-aa03-6de30f702f6f"],
 " for every ",
 Cell[BoxData[
  FormBox[
   StyleBox["y", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "85724876-e3e9-468b-97ce-e5a8f09b49cc"],
 ", and the charges are integers only for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["y", "TI"], "\[LongEqual]", 
    RowBox[{"\[PlusMinus]", 
     FractionBox["1", "2"]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fc6cafbb-9631-48e6-a6dd-8d8010422a86"],
 "."
}], "Text",ExpressionUUID->"820231dd-74e1-440d-afe0-39f11c298e62"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"--", " ", "remark"}]}], " ", 
    RowBox[{"R9", ":", " ", 
     RowBox[{
      RowBox[{
      "the", " ", "charges", " ", "of", " ", "the", " ", "constituents", " ", 
       "of", " ", "the", " ", "quasi"}], "-", 
      RowBox[{"particles", " ", "of", " ", "the", " ", "second", " ", 
       RowBox[{
        RowBox[{"version", " ", "--"}], "--"}]}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "the", " ", "diagonal", " ", "charges", " ", "of", " ", "the", " ", 
     "hypotheses", " ", "on", " ", "one", " ", "Dirac", " ", "component", " ",
      "of", " ", "each", " ", 
     RowBox[{"species", ":", " ", 
      RowBox[{
       RowBox[{"T", "^", "3"}], " ", 
       RowBox[{"(", "SM", ")"}]}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"T", "^", "3"}], "_R", " ", "and", " ", "R"}]}], " ", "*)"}], 
  "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"r9T3", " ", "=", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<up\>\"", " ", "->", " ", 
        RowBox[{"1", "/", "2"}]}], ",", " ", 
       RowBox[{"\"\<down\>\"", " ", "->", " ", 
        RowBox[{
         RowBox[{"-", "1"}], "/", "2"}]}], ",", " ", 
       RowBox[{"\"\<chi\>\"", " ", "->", " ", "0"}], ",", " ", 
       RowBox[{"\"\<chi'\>\"", " ", "->", " ", "0"}]}], "|>"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"r9T3R", " ", "=", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<up\>\"", " ", "->", " ", "0"}], ",", " ", 
       RowBox[{"\"\<down\>\"", " ", "->", " ", "0"}], ",", " ", 
       RowBox[{"\"\<chi\>\"", " ", "->", " ", 
        RowBox[{"1", "/", "2"}]}], ",", " ", 
       RowBox[{"\"\<chi'\>\"", " ", "->", " ", 
        RowBox[{
         RowBox[{"-", "1"}], "/", "2"}]}]}], "|>"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"r9R", " ", "=", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<up\>\"", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"\"\<down\>\"", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"\"\<chi\>\"", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"\"\<chi'\>\"", " ", "->", " ", 
        RowBox[{"-", "1"}]}]}], "|>"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "a", " ", "particle", " ", "of", " ", "a", " ", "species", " ", 
      "carries", " ", "its", " ", "charges"}], ",", " ", 
     RowBox[{
      RowBox[{"a", " ", "hole", " ", "their", " ", "negatives"}], ";", " ", 
      RowBox[{"Q", " ", "=", " ", 
       RowBox[{
        RowBox[{"T", "^", "3"}], " ", "+", " ", 
        RowBox[{
         RowBox[{"T", "^", "3"}], "_R"}], " ", "+", " ", 
        RowBox[{"R", "/", "4"}]}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"r9Charges", "[", 
      RowBox[{"sp_", ",", " ", "sign_"}], "]"}], " ", ":=", " ", 
     RowBox[{"sign", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"r9T3", "[", "sp", "]"}], " ", "+", " ", 
         RowBox[{"r9T3R", "[", "sp", "]"}]}], ",", " ", 
        RowBox[{"r9R", "[", "sp", "]"}], ",", " ", 
        RowBox[{
         RowBox[{"r9T3", "[", "sp", "]"}], " ", "+", " ", 
         RowBox[{"r9T3R", "[", "sp", "]"}], " ", "+", " ", 
         RowBox[{
          RowBox[{"r9R", "[", "sp", "]"}], "/", "4"}]}]}], "}"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"r9Rows", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<down particle\>\"", ",", " ", 
         RowBox[{"Sequence", " ", "@@", " ", 
          RowBox[{"r9Charges", "[", 
           RowBox[{"\"\<down\>\"", ",", " ", "1"}], "]"}]}]}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"\"\<hole of chi_SH\>\"", ",", " ", 
         RowBox[{"Sequence", " ", "@@", " ", 
          RowBox[{"r9Charges", "[", 
           RowBox[{"\"\<chi\>\"", ",", " ", 
            RowBox[{"-", "1"}]}], "]"}]}]}], "}"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<up particle\>\"", ",", " ", 
         RowBox[{"Sequence", " ", "@@", " ", 
          RowBox[{"r9Charges", "[", 
           RowBox[{"\"\<up\>\"", ",", " ", "1"}], "]"}]}]}], "}"}], ",", " ", 
       
       RowBox[{"{", 
        RowBox[{"\"\<hole of chi'_SH\>\"", ",", " ", 
         RowBox[{"Sequence", " ", "@@", " ", 
          RowBox[{"r9Charges", "[", 
           RowBox[{"\"\<chi'\>\"", ",", " ", 
            RowBox[{"-", "1"}]}], "]"}]}]}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"Grid", "[", 
      RowBox[{
       RowBox[{"Prepend", "[", 
        RowBox[{"r9Rows", ",", " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<constituent\>\"", ",", " ", "\"\<T^3 + T^3_R\>\"", ",",
            " ", "\"\<R\>\"", ",", " ", "\"\<Q\>\""}], "}"}]}], "]"}], ",", 
       " ", 
       RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
       RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<the first pair has equal charges: \>\"", ",", " ", 
      RowBox[{
       RowBox[{"r9Charges", "[", 
        RowBox[{"\"\<down\>\"", ",", " ", "1"}], "]"}], " ", "==", " ", 
       RowBox[{"r9Charges", "[", 
        RowBox[{"\"\<chi\>\"", ",", " ", 
         RowBox[{"-", "1"}]}], "]"}]}], ",", "\n", 
      "  ", "\"\<; the second: \>\"", ",", " ", 
      RowBox[{
       RowBox[{"r9Charges", "[", 
        RowBox[{"\"\<up\>\"", ",", " ", "1"}], "]"}], " ", "==", " ", 
       RowBox[{"r9Charges", "[", 
        RowBox[{"\"\<chi'\>\"", ",", " ", 
         RowBox[{"-", "1"}]}], "]"}]}]}], "]"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
      "the", " ", "gaps", " ", "of", " ", "the", " ", "Rust", " ", "program", 
       " ", 
       RowBox[{"(", 
        RowBox[{"data", " ", "cell"}], ")"}]}], ":", " ", 
      RowBox[{
       RowBox[{
       "in", " ", "the", " ", "first", " ", "version", " ", "the", " ", "gap",
         " ", "is"}], " ", "|", "M_up", "|"}]}], ",", " ", 
     RowBox[{"the", " ", "unpaired", " ", "up", " ", "component"}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"r9h", ",", " ", "r9rows"}], "}"}], " ", "=", " ", 
     RowBox[{"readTable", "[", "grFile", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"Grid", "[", 
      RowBox[{
       RowBox[{"Prepend", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"r", "[", 
              RowBox[{"[", 
               RowBox[{"col", "[", 
                RowBox[{"r9h", ",", " ", "\"\<version\>\""}], "]"}], "]"}], 
              "]"}], ",", " ", 
             RowBox[{"r", "[", 
              RowBox[{"[", 
               RowBox[{"col", "[", 
                RowBox[{"r9h", ",", " ", "\"\<method\>\""}], "]"}], "]"}], 
              "]"}], ",", " ", 
             RowBox[{"NumberForm", "[", 
