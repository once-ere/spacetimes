]}]}]}]}]}]}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"fieldOff", " ", "=", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Psi\>\"", " ", "->", " ", "0"}], ",", " ", 
       RowBox[{"\"\<chi\>\"", " ", "->", " ", "8"}], ",", " ", 
       RowBox[{"\"\<chi'\>\"", " ", "->", " ", "12"}], ",", " ", 
       RowBox[{"\"\<(chi, chi')\>\"", " ", "->", " ", "8"}]}], "|>"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"fieldN", " ", "=", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Psi\>\"", " ", "->", " ", "8"}], ",", " ", 
       RowBox[{"\"\<chi\>\"", " ", "->", " ", "4"}], ",", " ", 
       RowBox[{"\"\<chi'\>\"", " ", "->", " ", "4"}], ",", " ", 
       RowBox[{"\"\<(chi, chi')\>\"", " ", "->", " ", "8"}]}], "|>"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"onField", "[", 
      RowBox[{"x_", ",", " ", "f_"}], "]"}], " ", ":=", " ", 
     RowBox[{"x", "[", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"fieldOff", "[", "f", "]"}], " ", "+", " ", "1"}], " ", ";;",
          " ", 
         RowBox[{
          RowBox[{"fieldOff", "[", "f", "]"}], " ", "+", " ", 
          RowBox[{"fieldN", "[", "f", "]"}]}]}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"fieldOff", "[", "f", "]"}], " ", "+", " ", "1"}], " ", ";;",
          " ", 
         RowBox[{
          RowBox[{"fieldOff", "[", "f", "]"}], " ", "+", " ", 
          RowBox[{"fieldN", "[", "f", "]"}]}]}]}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"diracOn", "[", 
      RowBox[{"f_", ",", " ", "a_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Which", "[", 
      RowBox[{
       RowBox[{"f", " ", "==", " ", "\"\<Psi\>\""}], ",", " ", 
       RowBox[{"d8", "[", "a", "]"}], ",", " ", 
