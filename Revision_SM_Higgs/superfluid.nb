            RowBox[{"-", "x1"}]}], "]"}], ",", " ", 
          RowBox[{"IdentityMatrix", "[", 
           RowBox[{"Length", "[", "x2", "]"}], "]"}]}], "]"}], " ", "+", "\n",
         "   ", 
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{
          RowBox[{"IdentityMatrix", "[", 
           RowBox[{"Length", "[", "x1", "]"}], "]"}], ",", " ", 
          RowBox[{"Transpose", "[", "x2", "]"}]}], "]"}]}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"parityOp", "[", 
      RowBox[{"{", 
       RowBox[{"kind_", ",", " ", "f1_", ",", " ", "f2_"}], "}"}], "]"}], " ",
      ":=", " ", 
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{
       RowBox[{"leftOp", "[", 
        RowBox[{"kind", ",", " ", 
         RowBox[{"diracOn", "[", 
          RowBox[{"f1", ",", " ", 
           RowBox[{"gam", "[", "0", "]"}]}], "]"}]}], "]"}], ",", " ", 
       RowBox[{"Transpose", "[", 
        RowBox[{"diracOn", "[", 
         RowBox[{"f2", ",", " ", 
          RowBox[{"gam", "[", "0", "]"}]}], "]"}], "]"}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "matrix", " ", "of", " ", "an", " ", "operator", " ", "on", " ",
       "the", " ", "span", " ", "of", " ", "the", " ", "columns", " ", "of", " ",
       "b", " ", 
      RowBox[{"(", 
       RowBox[{"b", " ", "need", " ", "not", " ", "be", " ", "orthonormal"}], 
       ")"}]}], ";", " ", 
     RowBox[{
     "the", " ", "residual", " ", "tells", " ", "whether", "\n", "   ", "the",
       " ", "span", " ", "is", " ", "invariant"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"restrict", "[", 
      RowBox[{"op_", ",", " ", "b_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
