Cell[CellGroupData[{

Cell["II.3 The recursion of the potential and the ground states", "Section",ExpressionUUID->"6e3a8c53-7f28-4d69-aa3b-d4f2cb3d1a0c"],

Cell[TextData[{
 "The task asks to change the potential until all three methods admit a \
superfluid. ",
 StyleBox["The effective couplings.",
  FontWeight->"Bold"],
 " For a uniform state whose normal self-energy is a Dirac mass and whose \
pair self-energy lies in the channel ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4bfb0490-4abc-431b-a41a-d0ad168a27e1"],
 ", every method acts through two numbers: the scalar coupling ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["S",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b93ace9a-8ec7-4dd7-9e26-e8fdd8f918eb"],
 " (the shift of the Dirac mass per unit scalar density) and the pair \
coupling ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["P",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6484c67e-6732-4cf8-b1cc-1480abac41cb"],
 " (the pair self-energy per unit pair amplitude), computed by ",
 StyleBox["effCouplings",
  FontFamily->"Source Code Pro"],
 " from the self-energy maps of the terms. The normal vacuum is unstable \
towards pairing when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Lambda]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["P",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["P",
       FontSlant->"Plain"]}]], "/", 
    SubsuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["crit",
      FontSlant->"Plain"]], ">", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "99524d48-50c9-40bc-a7e8-55cf14216fef"],
 ", with the critical pair coupling of AS3,"
}], "Text",ExpressionUUID->"9fce0318-eacf-43c2-8ea6-b11431d20adf"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["crit",
     FontSlant->"Plain"]], "\[LongEqual]", 
   FractionBox[
    SuperscriptBox["\[Pi]", "2"], 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["I", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{"(", "1", ")"}]], 
     RowBox[{"(", 
      SubscriptBox[
       StyleBox["m", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]], ")"}]}]], ",", "      ", 
   SubsuperscriptBox[
    StyleBox["I", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "1", ")"}]], 
   RowBox[{"(", 
    StyleBox["M", "TI"], ")"}], "\[LongEqual]", 
   SubsuperscriptBox["\[Integral]", "0", 
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]], "\[ThinSpace]", 
   FractionBox[
    RowBox[{
     SuperscriptBox[
      StyleBox["q", "TI"], "2"], "\[ThinSpace]", 
     StyleBox["dq", "TI"]}], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        StyleBox["q", "TI"], "2"], "+", 
       SuperscriptBox[
        StyleBox["M", "TI"], "2"]}], ")"}], 
     RowBox[{"1", "/", "2"}]]], "\[LongEqual]", 
   FractionBox["1", "2"], 
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "+", 
        SuperscriptBox[
         StyleBox["M", "TI"], "2"]}], ")"}], 
      RowBox[{"1", "/", "2"}]], "-", 
     SuperscriptBox[
      StyleBox["M", "TI"], "2"], "\[ThinSpace]", 
     StyleBox["arsinh",
      FontSlant->"Plain"], 
     FractionBox["1", 
      StyleBox["M", "TI"]]}], ")"}], "."}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"d80ce324-ca24-413e-9817-aac228f3b479"],

Cell[TextData[{
 StyleBox["The three potentials.",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "0", ")"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bb7dbd8c-d954-47c3-b421-c1007c07875f"],
 " (the author's: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["S",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"-", "8"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f841714a-e04e-4fee-b7ef-a9034ae8fa30"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["V",
      FontSlant->"Plain"]], "\[LongEqual]", "0.8"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d9fb5d5b-b74c-43ba-a24e-56d65b746aa9"],
 ", no pairing term) admits no superfluid in any method. ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "1", ")"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cc61e2c8-d339-4303-ab9b-852e8780fce7"],
 " adds the pairing term with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "22.5"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b648f1b6-57d8-48f2-a893-76270e7d61cb"],
 ", the value of AS3: HS becomes superfluid, but in KS and CJT the exchange \
contraction of the pairing term acts in the scalar channel as an attraction, \
the scalar channel becomes unstable, and the ground state is a massive state. \
",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "2", ")"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f1c58e1f-9f3d-4501-9014-4f4bfad91426"],
 " keeps the form and the vector coupling and fixes ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["S",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ae30a58f-38d7-4712-819e-1dbfb8c9a0a8"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d851bae2-6c7f-454b-a0ff-dd651d4d07b0"],
 " by two conditions on the CJT couplings: the scalar coupling of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "0", ")"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c0b116a7-9ccb-4788-85c7-3d918f0ddf31"],
 " (stable) and the pair coupling of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "1", ")"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "72aadb3d-e16b-4cfb-8693-60de21f1a394"],
 " (supercritical). The couplings are linear in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["G", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      StyleBox["S",
       FontSlant->"Plain"]], ",", 
     SubscriptBox[
      StyleBox["G", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"]]}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cc7e5003-2765-41cb-ab15-f908ed7aaf43"],
 ", so the conditions are two linear equations, which the next cell solves \
from the computed couplings; the solution is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["S",
      FontSlant->"Plain"]], "\[LongEqual]", "2.8"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "48765d7c-0250-44ed-8f78-ff68ebcb477c"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "25.2"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "eb84d129-8d6a-44cc-a989-c33c0bb23640"],
 ":"
}], "Text",ExpressionUUID->"720e96b6-b2b7-4093-bbd7-8a8254d0396c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "2", ")"}]], "\[LongEqual]", 
   FractionBox["1", "2"], 
   RowBox[{"(", "2.8", ")"}], ":", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       OverscriptBox["\[CapitalPsi]", "_"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      SubscriptBox["\[CapitalPsi]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}], "2"], ":", 
   RowBox[{"+", 
    FractionBox["1", "2"]}], 
   RowBox[{"(", "0.8", ")"}], "\[ThinSpace]", 
   UnderscriptBox["\[Sum]", 
    StyleBox["p", "TI"],
    LimitsPositioning->True], "\[ThinSpace]", 
   SubsuperscriptBox["\[Eta]", 
    StyleBox["pp", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], ":", 
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["j", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["F",
        FontSlant->"Plain"], ",", 
       StyleBox["p", "TI"]}]], ")"}], "2"], ":", 
   RowBox[{"-", 
    FractionBox["1", "4"]}], 
   RowBox[{"(", "25.2", ")"}], "\[ThinSpace]", 
   UnderscriptBox["\[Sum]", "\[Iota]",
    LimitsPositioning->True], ":", 
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox["\[CapitalPi]", 
      StyleBox["LL",
       FontSlant->"Plain"], "\[Iota]"], ")"}], "\[Dagger]"], 
   SubsuperscriptBox["\[CapitalPi]", 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Iota]"], ":", "."}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"bc408ccd-668f-45fd-9a95-165faf64d1db"],

Cell[TextData[{
 "For each of the three potentials and the five methods, the cell after it \
computes the effective couplings and the stationary states reached from three \
starts (a polar pair ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.3", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "23785d16-1287-43ea-af4b-3b5d1ba5d19b"],
 "; a Dirac mass lowered by 1; a Dirac mass raised by 0.5), keeps the one of \
lowest energy (the ground state), and computes its energy per volume, its \
pair amplitude ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftBracketingBar]", 
    SubsuperscriptBox[
     StyleBox["D", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], "\[RightBracketingBar]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ecbc4ffa-5281-4665-aa2e-8e5d2e5e7cf2"],
 ", its Dirac mass and its gap. The ground state of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "2", ")"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "10ff1c63-0cdc-41cc-8147-b911cdc09d88"],
 " is a polar superfluid in every method. Each number is compared with that \
of the Rust program. (This cell computes 45 self-consistent states; it takes \
a few minutes.)"
}], "Text",ExpressionUUID->"adf841cb-b27a-4052-83f9-0fcb1ca2a94b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"the", " ", "critical", " ", "pair", " ", "coupling", " ", 
    RowBox[{
     RowBox[{"pi", "^", "2"}], "/", "I1"}], 
    RowBox[{"(", "m", ")"}], " ", "and", " ", "the", " ", "coefficients", " ",
     "of", " ", 
    RowBox[{"V", "^", 
     RowBox[{"(", "2", ")"}]}], " ", "from", " ", "the", " ", "two", " ", 
    "conditions", " ", "on", " ", "the", " ", "CJT", " ", "couplings"}], " ", 
   "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"gCrit", " ", "=", " ", 
     RowBox[{
      RowBox[{"Pi", "^", "2"}], "/", 
      RowBox[{"(", 
       RowBox[{"0.5", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Sqrt", "[", 
           RowBox[{"1", " ", "+", " ", 
            RowBox[{"mLL", "^", "2"}]}], "]"}], " ", "-", " ", 
          RowBox[{
           RowBox[{"mLL", "^", "2"}], " ", 
           RowBox[{"ArcSinh", "[", 
            RowBox[{"1", "/", "mLL"}], "]"}]}]}], ")"}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WP2-6b\>\"", ",", " ", 
      RowBox[{"\"\<the critical pair coupling pi^2/I1(m) = \>\"", " ", "<>", 
       " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"NumberForm", "[", 
         RowBox[{
          RowBox[{"N", "[", "gCrit", "]"}], ",", " ", "11"}], "]"}], "]"}]}], 
      ",", " ", 
      RowBox[{"Abs", "[", 
       RowBox[{"gCrit", " ", "-", " ", 
        RowBox[{"rustPart2", "[", "\"\<p2_Gcrit\>\"", "]"}]}], "]"}], ",", 
      " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}], ",", " ", "\"\<P2-6b\>\"", ",", 
      " ", "\"\<YP2-6b\>\""}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"f", " ", "=", " ", 
         RowBox[{
          RowBox[{"effCouplings", "[", 
           RowBox[{
            RowBox[{"{", "\"\<CJT\>\"", "}"}], ",", " ", "#1", ",", " ", 
            "0.8", ",", " ", "#2"}], "]"}], " ", "&"}]}], ",", " ", "s0", ",",
         " ", "p0", ",", " ", "s1", ",", " ", "p1", ",", " ", "s2", ",", " ", 
        "p2", ",", " ", "st", ",", " ", "pt"}], "}"}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"s0", ",", " ", "p0"}], "}"}], " ", "=", " ", 
        RowBox[{"f", "[", 
         RowBox[{"0.", ",", " ", "0."}], "]"}]}], ";", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"s1", ",", " ", "p1"}], "}"}], " ", "=", " ", 
        RowBox[{"f", "[", 
         RowBox[{"1.", ",", " ", "0."}], "]"}]}], ";", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"s2", ",", " ", "p2"}], "}"}], " ", "=", " ", 
        RowBox[{"f", "[", 
         RowBox[{"0.", ",", " ", "1."}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"st", " ", "=", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"effCouplings", "[", 
           RowBox[{
            RowBox[{"{", "\"\<CJT\>\"", "}"}], ",", " ", 
            RowBox[{"-", "8."}], ",", " ", "0.8", ",", " ", "0."}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", "s0"}]}], ";", "\n", 
       "  ", 
       RowBox[{"pt", " ", "=", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"effCouplings", "[", 
           RowBox[{
            RowBox[{"{", "\"\<CJT\>\"", "}"}], ",", " ", 
            RowBox[{"-", "8."}], ",", " ", "0.8", ",", " ", "22.5"}], "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", "p0"}]}], ";", "\n", 
       "  ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"gS2", ",", " ", "gP2"}], "}"}], " ", "=", " ", 
        RowBox[{"LinearSolve", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"s1", " ", "-", " ", "s0"}], ",", " ", 
              RowBox[{"s2", " ", "-", " ", "s0"}]}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"p1", " ", "-", " ", "p0"}], ",", " ", 
              RowBox[{"p2", " ", "-", " ", "p0"}]}], "}"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"st", ",", " ", "pt"}], "}"}]}], "]"}]}]}]}], "]"}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WP2-6a\>\"", ",", " ", 
      RowBox[{"\"\<V^(2) from the conditions on the CJT effective couplings: \
(G^S, G) = (\>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"NumberForm", "[", 
         RowBox[{"gS2", ",", " ", "11"}], "]"}], "]"}], " ", "<>", 
       " ", "\"\<, \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"NumberForm", "[", 
         RowBox[{"gP2", ",", " ", "11"}], "]"}], "]"}], " ", "<>", 
       " ", "\"\<)\>\""}], ",", "\n", "  ", 
      RowBox[{"Max", "[", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"gS2", " ", "-", " ", 
          RowBox[{"rustPart2", "[", "\"\<p2_V2_GS\>\"", "]"}]}], "]"}], ",", 
        " ", 
        RowBox[{"Abs", "[", 
         RowBox[{"gP2", " ", "-", " ", 
          RowBox[{"rustPart2", "[", "\"\<p2_V2_G\>\"", "]"}]}], "]"}]}], 
       "]"}], ",", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}], ",", " ", "\"\<P2-6a\>\"", ",", 
      " ", "\"\<YP2-6a\>\""}], "]"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"the", " ", "three", " ", "potentials", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"G", "^", "S"}], ",", " ", 
       RowBox[{"G", "^", "V"}], ",", " ", "G"}], "}"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"potentialsSF", " ", "=", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<V0\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "8."}], ",", " ", "0.8", ",", " ", "0."}], "}"}]}], ",",
        " ", 
       RowBox[{"\"\<V1\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "8."}], ",", " ", "0.8", ",", " ", "22.5"}], "}"}]}], ",",
        " ", 
       RowBox[{"\"\<V2\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"gS2", ",", " ", "0.8", ",", " ", "gP2"}], "}"}]}]}], 
      "|>"}]}], ";"}]}]}]], "Input",
 CellLabel->
  "In[227]:=",ExpressionUUID->"fbff388b-32d2-40cf-83ba-f48596d58027"],

