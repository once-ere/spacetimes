               RowBox[{
                RowBox[{"#", "[", "\"\<lx\>\"", "]"}], "[", 
                RowBox[{"[", "a", "]"}], "]"}]}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"a", ",", " ", "3"}], "}"}]}], "]"}], ",", "\n", 
            "       ", 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"#", "[", "\"\<lx\>\"", "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"iTR", "[", 
                  RowBox[{"[", "a", "]"}], "]"}], "]"}], "]"}], ".", 
               RowBox[{
                RowBox[{"#", "[", "\"\<lx\>\"", "]"}], "[", 
                RowBox[{"[", 
