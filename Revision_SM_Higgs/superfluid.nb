      RowBox[{"Max", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"pairEnergy", "[", 
            RowBox[{"{", 
             RowBox[{"\"\<boson W1\>\"", ",", " ", "c"}], "}"}], "]"}], " ", "+",
            " ", 
           RowBox[{"pairEnergy", "[", 
            RowBox[{"{", 
             RowBox[{"\"\<boson W2\>\"", ",", " ", "c"}], "}"}], "]"}], " ", "+",
            " ", 
           RowBox[{"pairEnergy", "[", 
            RowBox[{"{", 
             RowBox[{"\"\<boson W3\>\"", ",", " ", "c"}], "}"}], "]"}], " ", "-",
            " ", 
           RowBox[{
            RowBox[{"1", "/", "4"}], " ", 
            RowBox[{"pairEnergy", "[", 
             RowBox[{"{", 
              RowBox[{"\"\<boson B\>\"", ",", " ", "c"}], "}"}], "]"}]}]}], 
          "]"}], ",", "\n", "    ", 
         RowBox[{"{", 
          RowBox[{"c", ",", " ", 
           RowBox[{"Keys", "[", "channelStates", "]"}]}], "}"}]}], "]"}], 
       "]"}], ",", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "12"}]}], ",", " ", "\"\<P2-0d\>\"", ",", 
      " ", "\"\<YP2-0b\>\""}], "]"}], ";"}], "\n", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Prepend", "[", 
