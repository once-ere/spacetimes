             RowBox[{
              RowBox[{
               RowBox[{"wr", "[", 
                RowBox[{"[", "i", "]"}], "]"}], " ", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"kr", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "^", "2"}], "/", 
                 RowBox[{"(", 
                  RowBox[{"2", " ", 
                   RowBox[{"Pi", "^", "2"}]}], ")"}]}], "/", "6."}]}], ",", 
              " ", 
              RowBox[{"{", 
               RowBox[{"i", ",", " ", "nr"}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"d", ",", " ", "6"}], "}"}]}], "]"}], "]"}]}], ",", 
          " ", 
          RowBox[{"\"\<n\>\"", " ", "->", " ", 
