          "}"}]}], "]"}], ",", " ", "1"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"Grid", "[", 
      RowBox[{
       RowBox[{"Prepend", "[", 
        RowBox[{"r8Rows", ",", " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<pair\>\"", ",", " ", "\"\<Y Y (B)\>\"", ",", 
           " ", "\"\<Q Q (photon)\>\""}], "}"}]}], "]"}], ",", " ", 
