Cell[CellGroupData[{

Cell["R.4 The dynamics in time of the superfluid (stage 6)", "Section",ExpressionUUID->"b4f56320-3197-415b-a737-0f22c1d7bc37"],

Cell[TextData[{
 "Stage 6 follows the superfluid in time. A uniform state is given, at every \
momentum ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox[
     StyleBox["q", "TI"], "\[RightVector]"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1a4ba15f-ed09-4830-b444-9f612d07684c"],
 " of the grid, by its sixteen occupied quasi-particle vectors, the columns \
of the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"32", "\[Times]", "16"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fe6f3b04-d82a-4ec7-85e4-7f8488882456"],
 " matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["O",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SH",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       OverscriptBox[
        StyleBox["q", "TI"], "\[RightVector]"], 
       StyleBox["LL",
        FontSlant->"Plain"]], ",", 
      StyleBox["t", "TI"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6737eff5-ab85-4d73-b784-adaf720e2fd9"],
 "; its generalized density ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["\[ScriptCapitalR]",
      FontSlant->"Plain"], 
     StyleBox["SH",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["O",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SH",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["O",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SH",
      FontSlant->"Plain"], "\[Dagger]"]}], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c3128492-1b17-4f44-a98f-a3fa14f3910d"],
 " holds the normal and the pair correlations, from which each method \
computes its self-energies ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["N",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SH",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["t", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "506a839f-e56b-4881-abec-3fb1bb671ee9"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["P",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SH",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["t", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a815d0d6-2e73-4e2a-be60-0b106d925efa"],
 " exactly as for a static state. The time-dependent mean field of the method \
is"
}], "Text",ExpressionUUID->"e7845b7c-7c99-4e53-adf3-2c6e989ca004"],

Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox["i", "TI"], "\[ThinSpace]", 
   FractionBox[
    StyleBox["d", "TI"], 
    StyleBox["dt", "TI"]], 
   SubscriptBox[
    StyleBox["O",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SH",
     FontSlant->"Plain"]], 
   RowBox[{"(", 
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["q", "TI"], "\[RightVector]"], 
      StyleBox["LL",
       FontSlant->"Plain"]], ",", 
     StyleBox["t", "TI"]}], ")"}], "\[LongEqual]", 
   SubscriptBox[
    StyleBox["H",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SH",
     FontSlant->"Plain"]], 
   RowBox[{"(", 
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["q", "TI"], "\[RightVector]"], 
      StyleBox["LL",
       FontSlant->"Plain"]], ";", 
     SubscriptBox[
      StyleBox["N",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["SH",
       FontSlant->"Plain"]], 
     RowBox[{"(", 
      StyleBox["t", "TI"], ")"}], ",", 
     SubscriptBox[
      StyleBox["P",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["SH",
       FontSlant->"Plain"]], 
     RowBox[{"(", 
      StyleBox["t", "TI"], ")"}]}], ")"}], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["O",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SH",
     FontSlant->"Plain"]], 
   RowBox[{"(", 
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["q", "TI"], "\[RightVector]"], 
      StyleBox["LL",
       FontSlant->"Plain"]], ",", 
     StyleBox["t", "TI"]}], ")"}], ",", "      ", 
   StyleBox["i", "TI"], "\[ThinSpace]", 
   FractionBox[
    RowBox[{
     StyleBox["d", "TI"], 
     SubscriptBox[
      StyleBox["\[ScriptCapitalR]",
       FontSlant->"Plain"], 
      StyleBox["SH",
       FontSlant->"Plain"]]}], 
    StyleBox["dt", "TI"]], "\[LongEqual]", 
   RowBox[{"[", 
    RowBox[{
     SubscriptBox[
      StyleBox["H",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["SH",
       FontSlant->"Plain"]], ",", 
     SubscriptBox[
      StyleBox["\[ScriptCapitalR]",
       FontSlant->"Plain"], 
      StyleBox["SH",
       FontSlant->"Plain"]]}], "]"}], ","}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"1bf0ec94-2b19-40db-a8ba-5d315a956e05"],

Cell[TextData[{
 "with the BdG matrix ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["H",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SH",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a76442d6-dbfd-472b-bf3e-ee4d717873d6"],
 " of the self-energies at the time ",
 Cell[BoxData[
  FormBox[
   StyleBox["t", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9330ad05-5cb1-492e-8655-d4b27d680272"],
 "; its linearization about the ground state is the linear response of stage \
4. The Rust program integrated it with CVODE of SUNDIALS (the formulas of \
Adams and Moulton, the relative tolerance ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "12"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c8baee10-f2d9-4547-bc48-3b6ee0c80a0d"],
 " and the absolute tolerance ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "14"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c2c81895-e4ac-4259-b80d-79c5caed12e4"],
 ") on 144 momenta, for the five methods: the ground state at rest; the \
amplitude runs, in which the pair self-energy starts displaced along the \
direction of the vacuum by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Epsilon]", 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["kick",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox["10", 
     RowBox[{"-", "3"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2254008b-8d62-40d5-a5d3-6ee9a385fb1c"],
 " of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["d", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"], "0"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4f5211e7-a11e-4909-8860-a102d8475fe5"],
 "; the triplet runs, with the two pair fields displaced oppositely (the \
neutral member of the custodial triplet of remark R12); two Josephson runs \
with a chemical potential ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Mu]", "\[LongEqual]", "0.01"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3629279d-2c1c-40aa-8497-c27bc458893c"],
 " of the particle number; and two large displacements, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Epsilon]", 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["kick",
      FontSlant->"Plain"]], "\[LongEqual]", "0.3"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8d34d15f-bbdf-4f50-9399-61d64b79b906"],
 ". It recorded the coefficient ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["t", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cccfc054-6273-402a-a3fe-42553f93a479"],
 " of the pair self-energy along the vacuum direction every 0.2 and read the \
frequencies from the spectra of the signals with the Hann window ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["h", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["Hann",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["t", "TI"], ")"}], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["sin",
      FontSlant->"Plain"], "2"], 
    RowBox[{"(", 
     RowBox[{"\[Pi]", 
      StyleBox["t", "TI"], "/", 
      SubsuperscriptBox[
       StyleBox["t", "TI"], 
       StyleBox["SH",
        FontSlant->"Plain"], 
       StyleBox["end",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0af88834-0784-4166-8cec-d3c91c0b25d7"],
 " over runs of the length ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["t", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["end",
      FontSlant->"Plain"]], "\[LongEqual]", "300"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1e7f4851-24ea-4bac-9aa7-5601eb50e115"],
 ": the peak ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Omega]", 
    StyleBox["SH",
     FontSlant->"Plain"], 
    StyleBox["pk",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6bad8a01-d0b0-436a-b1ac-e5a37f8d069f"],
 " and its half width ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalGamma]", 
    StyleBox["SH",
     FontSlant->"Plain"], 
    StyleBox["pk",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f04f3e5a-7548-4df2-8d3b-bc2dcfc2ee06"],
 ", compared with the width ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalGamma]", 
    StyleBox["SH",
     FontSlant->"Plain"], 
    StyleBox["win",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8c4f5074-f25c-48e4-b3f5-16dff3cacdf8"],
 " of the window alone. ",
 StyleBox["What it found.",
  FontWeight->"Bold"],
 " In HS (0, 1) and HS (0, 0) the amplitude mode oscillates at ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["d", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"], "0"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "820fa8f6-8789-4f2e-9a15-4362954e012d"],
 ", undamped, and the triplet at the same frequency, as stage 4 predicted. In \
HS (1, 1) the mode lies at 0.9736 times its ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["d", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"], "0"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bc895ad2-fb49-4ae5-bcc7-4bfceca1c0cc"],
 ", below the energy that breaks a pair and undamped, and the triplet 2.2 per \
cent above it; in KS and CJT the spectrum peaks above the energy that breaks \
a pair, with 1.8 times the width of the window, a mode that decays into pairs \
of quasi-particles, and KS and CJT give the same dynamics. A large \
displacement softens the oscillation. The checks of this section derive \
exactly what the program relies on and compare its numbers. The section \
starts from a clean slate."
}], "Text",ExpressionUUID->"03f03a57-a169-4928-9a23-81886b65a1a6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"--", " ", "Section"}]}], " ", "R", ".4", " ", "starts", " ", 
    "from", " ", "a", " ", "clean", " ", 
    RowBox[{
     RowBox[{"slate", " ", "--"}], "--"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"rvClean", "[", "]"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "the", " ", "names", " ", "of", " ", "the", " ", "two", " ", "tables", " ",
      "of", " ", "the", " ", "Rust", " ", "program", " ", "sh_dynamics", " ", 
     "that", " ", "this", " ", "section", " ", "reads", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"rows", " ", "of", " ", "the", " ", "data", " ", "cell"}], ";",
         " ", 
        RowBox[{
        "of", "\n", "   ", "the", " ", "signals", " ", "only", " ", "the", " ",
          "rows", " ", "of", " ", "the", " ", "Josephson", " ", "runs", " ", 
         "and", " ", "of", " ", "the", " ", "amplitude", " ", "run", " ", 
         "of", " ", "HS", " ", 
         RowBox[{"(", 
          RowBox[{"0", ",", " ", "0"}], ")"}]}]}], ",", " ", 
       RowBox[{"second", " ", "version"}], ",", " ", 
       RowBox[{"t", " ", "<=", " ", "50"}]}], ")"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"runsFile", ",", " ", "sigFile"}], "}"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<sh_dyn_runs.csv\>\"", ",", 
       " ", "\"\<sh_dyn_signals.csv\>\""}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"num", "[", "s_String", "]"}], " ", ":=", " ", 
     RowBox[{"ToExpression", "[", 
      RowBox[{"StringReplace", "[", 
       RowBox[{"s", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<e\>\"", " ", "->", " ", "\"\<*^\>\""}], "}"}]}], "]"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"num", "[", 
      RowBox[{"x_", "?", "NumericQ"}], "]"}], " ", ":=", " ", "x"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"col", "[", 
      RowBox[{"h_", ",", " ", "n_"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"Position", "[", 
       RowBox[{"h", ",", " ", "n"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", " ", "1"}], "]"}], "]"}]}], ";"}]}]}]], "Input",
 CellLabel->
  "In[713]:=",ExpressionUUID->"8665b22c-e42b-4904-b5dd-f4024836a583"],

Cell[CellGroupData[{

Cell["R.4.1 The conservation laws (check WD-1)", "Subsection",ExpressionUUID->"dd09d52c-828b-46b0-94ea-85513fd0ba07"],

Cell[TextData[{
 "The self-energies of every method are the derivatives of its energy per \
volume with respect to the local matrices, so that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["\[ScriptCapitalE]",
     FontSlant->"Plain"], "\[LongEqual]", 
    StyleBox["tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     StyleBox[
      RowBox[{
       StyleBox["H",
        FontFamily->"Helvetica"], "\[ScriptCapitalR]"}],
      FontSlant->"Plain"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6d5e6d6a-ef56-4d5c-9d06-4664e98b4124"],
 " up to terms whose variation the self-energies already contain; along the \
flow its rate of change is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     StyleBox["i", "TI"]}], "\[ThinSpace]", 
    StyleBox["tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["H",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      RowBox[{"[", 
       RowBox[{
        StyleBox["H",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], ",", 
        StyleBox["\[ScriptCapitalR]",
         FontSlant->"Plain"]}], "]"}]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f3bf462c-e21a-4ad1-9fd3-c27a42613c14"],
 ", which vanishes because the trace of a matrix times its commutator with \
another is zero (cyclicity of the trace). The flow is a unitary similarity, \
so it keeps ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[ScriptCapitalR]",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4d6a5c1e-e000-4bde-a3d5-44acf062f477"],
 " Hermitian and keeps a projector a projector, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["\[ScriptCapitalR]",
      FontSlant->"Plain"], "2"], "\[LongEqual]", 
    StyleBox["\[ScriptCapitalR]",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f91439de-e49b-4a79-a980-02f8fd914f2f"],
 ", which is the orthonormality ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["O",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "\[Dagger]"], 
    StyleBox["O",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "\[LongEqual]", 
    StyleBox["1",
     FontFamily->"Helvetica",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3ff00812-1be4-4425-877d-b1f4ec198503"],
 " of the vectors. The cell proves these statements symbolically for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", "\[Times]", "3"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e571dab3-5866-4fa2-8207-023d6dd87e5a"],
 " Hermitian matrices with symbolic entries (the energy identity holds for \
any size by the cyclicity of the trace). The Rust program finds the energy \
conserved to about ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "6"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e35922d4-a428-493b-a055-4a8488112275"],
 " of its size over 300 units of time and the vectors orthonormal to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Times]", 
    SuperscriptBox["10", 
     RowBox[{"-", "8"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1887d56e-deac-4228-a7cf-138dff2d5d2a"],
 ": the energy is the difference of its kinetic and interaction parts, each \
about ten times larger, and its drift follows the loss of orthonormality that \
the error of the integration causes, not the equations."
}], "Text",ExpressionUUID->"13e75087-3381-4cd7-bf73-ac3b73596676"],

