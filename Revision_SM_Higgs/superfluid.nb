      RowBox[{"m", " ", "=", " ", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0", ",", " ", 
         RowBox[{"{", 
          RowBox[{"n", ",", " ", "n"}], "}"}]}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"m", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{
              RowBox[{"o", " ", "+", " ", "1"}], " ", ";;", " ", 
              RowBox[{"o", " ", "+", " ", 
               RowBox[{"Length", "[", "x", "]"}]}]}], ",", " ", 
             RowBox[{
              RowBox[{"o", " ", "+", " ", "1"}], " ", ";;", " ", 
              RowBox[{"o", " ", "+", " ", 
               RowBox[{"Length", "[", "x", "]"}]}]}]}], "]"}], "]"}], " ", "=",
           " ", "x"}], ";", " ", 
         RowBox[{"o", " ", "+=", " ", 
          RowBox[{"Length", "[", "x", "]"}]}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"x", ",", " ", "l"}], "}"}]}], "]"}], ";", " ", "m"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"dirac16", "[", "a_", "]"}], " ", ":=", " ", 
