      RowBox[{"gam", "[", "0", "]"}], ".", 
      RowBox[{"gam", "[", "1", "]"}], ".", 
      RowBox[{"gam", "[", "2", "]"}], ".", 
      RowBox[{"gam", "[", "3", "]"}]}]}]}], ";"}], "          ", 
  RowBox[{"(*", " ", 
