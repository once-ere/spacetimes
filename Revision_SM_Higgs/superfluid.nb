Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"WSF", "-", 
     RowBox[{"2", 
      RowBox[{"b", ":", " ", "I1"}]}]}], ",", " ", 
    RowBox[{"G", "^", "crit"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"i1closed", "[", "m_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{"1", " ", "+", " ", 
          RowBox[{"m", "^", "2"}]}], "]"}], " ", "-", " ", 
        RowBox[{
         RowBox[{"m", "^", "2"}], " ", 
         RowBox[{"ArcSinh", "[", 
          RowBox[{"1", "/", "m"}], "]"}]}]}], ")"}], "/", "2"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"i1int", " ", "=", " ", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"q", "^", "2"}], "/", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"q", "^", "2"}], " ", "+", " ", 
          RowBox[{"m", "^", "2"}]}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"q", ",", " ", "0", ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"Assumptions", " ", "->", " ", 
        RowBox[{"m", " ", ">", " ", "0"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "closed", " ", "form", " ", "against", " ", "the", " ", 
      "exact", " ", "integral", " ", "at", " ", "ten", " ", "rational", " ", 
      "masses"}], ",", " ", 
     RowBox[{"with", " ", "40", " ", "digits"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"okI1", " ", "=", " ", 
     RowBox[{
      RowBox[{"Max", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{"i1int", " ", "/.", " ", 
              RowBox[{"m", " ", "->", " ", "mm"}]}], ",", " ", "40"}], "]"}], 
           " ", "-", " ", 
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{"i1closed", "[", "mm", "]"}], ",", " ", "40"}], "]"}]}], 
          "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"mm", ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"1", "/", "50"}], ",", " ", 
             RowBox[{"1", "/", "10"}], ",", " ", 
             RowBox[{"1", "/", "5"}], ",", " ", 
             RowBox[{"3", "/", "10"}], ",", " ", 
             RowBox[{"1", "/", "2"}], ",", " ", 
             RowBox[{"3", "/", "4"}], ",", " ", "1", ",", " ", 
             RowBox[{"3", "/", "2"}], ",", " ", "2", ",", " ", "5"}], "}"}]}],
           "}"}]}], "]"}], "]"}], " ", "<", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "35"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"mLL", " ", "=", " ", 
     RowBox[{"1", "/", "5"}]}], ";", " ", 
    RowBox[{"gSH", " ", "=", " ", 
     RowBox[{"504", "/", "5"}]}], ";"}], "                      ", 
   RowBox[{"(*", " ", 
    RowBox[{"G_SH", " ", "=", " ", 
     RowBox[{"100.8", " ", "=", " ", 
      RowBox[{"504", "/", "5"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"gcritSH", " ", "=", " ", 
     RowBox[{"4", " ", 
      RowBox[{
       RowBox[{"Pi", "^", "2"}], "/", 
       RowBox[{"i1closed", "[", "mLL", "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"lamExact", " ", "=", " ", 
     RowBox[{"gSH", "/", "gcritSH"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"hdr", ",", " ", "rows"}], "}"}], " ", "=", " ", 
     RowBox[{"readTable", "[", "nvFile", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ghdr", ",", " ", "grows"}], "}"}], " ", "=", " ", 
     RowBox[{"readTable", "[", "grFile", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"col", "[", 
      RowBox[{"h_", ",", " ", "n_"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"Position", "[", 
       RowBox[{"h", ",", " ", "n"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", " ", "1"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"rowOf", "[", 
      RowBox[{"pot_", ",", " ", "meth_"}], "]"}], " ", ":=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{"rows", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", 
            RowBox[{"col", "[", 
             RowBox[{"hdr", ",", " ", "\"\<potential\>\""}], "]"}], "]"}], 
           "]"}], " ", "==", " ", "pot"}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", 
            RowBox[{"col", "[", 
             RowBox[{"hdr", ",", " ", "\"\<method\>\""}], "]"}], "]"}], "]"}],
           " ", "==", " ", "meth"}]}], " ", "&"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"grOf", "[", 
      RowBox[{"ver_", ",", " ", "meth_"}], "]"}], " ", ":=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{"grows", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", 
            RowBox[{"col", "[", 
             RowBox[{"ghdr", ",", " ", "\"\<version\>\""}], "]"}], "]"}], 
           "]"}], " ", "==", " ", "ver"}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", 
            RowBox[{"col", "[", 
             RowBox[{"ghdr", ",", " ", "\"\<method\>\""}], "]"}], "]"}], 
           "]"}], " ", "==", " ", "meth"}]}], " ", "&"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"num", "[", "s_String", "]"}], " ", ":=", " ", 
     RowBox[{"ToExpression", "[", 
      RowBox[{"StringReplace", "[", 
       RowBox[{"s", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<e\>\"", " ", "->", " ", "\"\<*^\>\""}], "}"}]}], "]"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"lamRust", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"num", "[", 
        RowBox[{
         RowBox[{"rowOf", "[", 
          RowBox[{"#", ",", " ", "\"\<CJT\>\""}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"col", "[", 
           RowBox[{"hdr", ",", " ", "\"\<lam_higgs\>\""}], "]"}], "]"}], 
         "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<V1_SH\>\"", ",", " ", "\"\<V1_SH first version\>\""}], 
       "}"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dev2b", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"N", "[", 
         RowBox[{"lamExact", ",", " ", "30"}], "]"}], " ", "-", " ", 
        "lamRust"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rvCheck", "[", 
     RowBox[{"\"\<WSF-2b\>\"", ",", " ", 
      RowBox[{"\"\<I1(m) = int_0^1 q^2 / sqrt(q^2 + m^2) dq = (sqrt(1 + m^2) \
- m^2 arsinh(1/m)) / 2 \\\n(the exact integral equals it at ten masses, to 40 \
digits); G^crit_SH = 4 pi^2 / I1(1/5) = \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"NumberForm", "[", 
         RowBox[{
          RowBox[{"N", "[", 
           RowBox[{"gcritSH", ",", " ", "20"}], "]"}], ",", " ", "20"}], 
         "]"}], "]"}], " ", "<>", " ", "\"\< and G_SH / G^crit_SH = \>\"", 
       " ", "<>", "\n", "  ", 
       RowBox[{"ToString", "[", 
        RowBox[{"NumberForm", "[", 
         RowBox[{
          RowBox[{"N", "[", 
           RowBox[{"lamExact", ",", " ", "16"}], "]"}], ",", " ", "16"}], 
         "]"}], "]"}], " ", "<>", 
       " ", "\"\< (G_SH = 504/5), against the Rust values of both \
versions\>\""}], ",", " ", 
      RowBox[{"okI1", " ", "&&", " ", 
       RowBox[{"dev2b", " ", "<", " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "9"}]}]}]}], ",", "\n", "  ", 
      RowBox[{"\"\<deviation \>\"", " ", "<>", " ", 
       RowBox[{"sci", "[", "dev2b", "]"}]}]}], "]"}], ";"}]}]}]], "Input",
 CellLabel->
  "In[580]:=",ExpressionUUID->"8db1ae65-e19b-4cda-a5da-6b41b8bb77a0"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"PASS \"\>", "\[InvisibleSpace]", "\<\"WSF-2b\"\>", 
   "\[InvisibleSpace]", "\<\"  \"\>", 
   "\[InvisibleSpace]", "\<\"I1(m) = int_0^1 q^2 / sqrt(q^2 + m^2) dq = \
(sqrt(1 + m^2) - m^2 arsinh(1/m)) / 2 (the exact integral equals it at ten \
masses, to 40 digits); G^crit_SH = 4 pi^2 / I1(1/5) = 85.146439022198692144 \
and G_SH / G^crit_SH = 1.183842814303957 (G_SH = 504/5), against the Rust \
values of both versions\"\>", "\[InvisibleSpace]", "\<\" [\"\>", 
   "\[InvisibleSpace]", "\<\"deviation 3.508e-11\"\>", 
   "\[InvisibleSpace]", "\<\"]   [the same check: Rust \"\>", 
   "\[InvisibleSpace]", "\<\"SF-2a\"\>", 
   "\[InvisibleSpace]", "\<\", Python \"\>", 
   "\[InvisibleSpace]", "\<\"YSF-2\"\>", "\[InvisibleSpace]", "\<\"]\"\>"}],
  SequenceForm[
  "PASS ", "WSF-2b", "  ", 
   "I1(m) = int_0^1 q^2 / sqrt(q^2 + m^2) dq = (sqrt(1 + m^2) - m^2 \
arsinh(1/m)) / 2 (the exact integral equals it at ten masses, to 40 digits); \
G^crit_SH = 4 pi^2 / I1(1/5) = 85.146439022198692144 and G_SH / G^crit_SH = \
1.183842814303957 (G_SH = 504/5), against the Rust values of both versions", 
   " [", "deviation 3.508e-11", "]   [the same check: Rust ", "SF-2a", 
   ", Python ", "YSF-2", "]"],
  Editable->False]], "Print",
 CellChangeTimes->{4.004330939416499*^9},
