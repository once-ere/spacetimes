Cell[CellGroupData[{

Cell["R.4.3 The amplitude mode in the time domain (check WD-3)", "Subsection",ExpressionUUID->"88057d6d-f237-4aa7-8fd7-2e211fa6e031"],

Cell[TextData[{
 "In the pairing-only methods the linear response puts the amplitude mode \
exactly at ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["d", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"], "0"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "aee1df51-38f4-45dd-bd21-9e8672212ea8"],
 " (remark R11). The cell solves the gap equation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["G", "TI"], 
       StyleBox["SH",
        FontSlant->"Plain"]], "/", "4", 
      SuperscriptBox["\[Pi]", "2"]}], ")"}], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["I", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{"(", "1", ")"}]], 
    RowBox[{"(", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox[
         StyleBox["m", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], "2"], "+", 
        SuperscriptBox[
         RowBox[{"(", 
          SubsuperscriptBox[
           StyleBox["d", "TI"], 
           StyleBox["SH",
            FontSlant->"Plain"], "0"], ")"}], "2"], "/", "4"}], ")"}], 
      RowBox[{"1", "/", "2"}]], ")"}], "\[LongEqual]", "1"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8bc5e426-401b-406d-88ee-3f0dfae9720e"],
 " with 40 digits and compares the peaks of the spectra of the amplitude runs \
of HS (0, 1) and HS (0, 0) of the Rust program, both versions, with ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["d", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"], "0"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5b54cb42-235d-4eb5-9f7d-63ef2ff219eb"],
 ". The difference, of the order of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "6"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "636e165e-d462-4e84-8acb-c4b0ea634ef7"],
 ", is of the order of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox["\[Epsilon]", 
      StyleBox["SH",
       FontSlant->"Plain"], 
      StyleBox["kick",
       FontSlant->"Plain"]], ")"}], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e11c9255-0cda-4f03-b26e-db76f4b3dabb"],
 ", the size of the first correction to a linear oscillation."
}], "Text",ExpressionUUID->"89af8b71-1b51-490d-8d9f-f1d1fce6c6b2"],

