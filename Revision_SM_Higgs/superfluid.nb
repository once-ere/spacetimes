Cell[CellGroupData[{

Cell["I.5 The Lagrangian and the field equations (item 4)", "Section",ExpressionUUID->"4f2d3f1d-e690-464d-a549-36bd0f13361d"],

Cell[TextData[{
 "The Lagrangian density of the solution is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["\[ScriptCapitalL]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalL]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], "\[CapitalPsi]"], "+", 
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalL]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["self",
      FontSlant->"Plain"]], "+", 
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalL]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["YM",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5f01e4fb-d461-4b9d-af13-d0519f123349"],
 ", with the Dirac part ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalL]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], "\[CapitalPsi]"], "\[LongEqual]", 
    SubscriptBox[
     OverscriptBox["\[CapitalPsi]", "_"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["i", "TI"], "\[ThinSpace]", 
      UnderscriptBox["\[Sum]", 
       StyleBox["p", "TI"],
       LimitsPositioning->True], "\[ThinSpace]", 
      SubsuperscriptBox["\[Gamma]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["p", "TI"]], 
      SubsuperscriptBox["\[Del]", 
       StyleBox["p", "TI"], 
       StyleBox["GEE",
        FontSlant->"Plain"]], "-", 
      SubscriptBox[
       StyleBox["m", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}], 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "01624e64-b63d-49b2-b6f1-a1147631f167"],
 ", the Yang-Mills part ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalL]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["YM",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"-", 
     FractionBox["1", "4"]}], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", "\[Iota]",
     LimitsPositioning->True], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["W", "TI"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}], "\[Iota]"], 
    SubsuperscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{"\[Iota]", ",", 
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], "-", 
    FractionBox["1", "4"], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["B", "TI"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], 
    SubsuperscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "304ba2f8-f9d7-4018-9337-f0453e83f6c5"],
 ", and the self-interaction ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalL]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["self",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"-", 
     SubsuperscriptBox[
      StyleBox["V", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       StyleBox["n", "TI"], ")"}]]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3fcb881c-0970-4cc8-b4bf-e59b8d7413f2"],
 ", a normal-ordered GEE-invariant contact interaction. Its first two steps \
are"
}], "Text",ExpressionUUID->"4c3ee0fe-c3e1-4e57-8f92-0f8fbd6c9fa9"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "0", ")"}]], "\[LongEqual]", 
   FractionBox["1", "2"], 
   SubsuperscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["S",
     FontSlant->"Plain"]], ":", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       OverscriptBox["\[CapitalPsi]", "_"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      SubscriptBox["\[CapitalPsi]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}], "2"], ":", 
   RowBox[{"+", 
    FractionBox["1", "2"]}], 
   SubsuperscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["V",
     FontSlant->"Plain"]], "\[ThinSpace]", 
   UnderscriptBox["\[Sum]", 
    StyleBox["p", "TI"],
    LimitsPositioning->True], "\[ThinSpace]", 
   SubsuperscriptBox["\[Eta]", 
    StyleBox["pp", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], ":", 
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["j", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["F",
        FontSlant->"Plain"], ",", 
       StyleBox["p", "TI"]}]], ")"}], "2"], ":", ",", "      ", 
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "1", ")"}]], "\[LongEqual]", 
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "0", ")"}]], "-", 
   FractionBox["1", "4"], 
   SubscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], "\[ThinSpace]", 
   UnderscriptBox["\[Sum]", "\[Iota]",
    LimitsPositioning->True], ":", 
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox["\[CapitalPi]", 
      StyleBox["LL",
       FontSlant->"Plain"], "\[Iota]"], ")"}], "\[Dagger]"], 
   SubsuperscriptBox["\[CapitalPi]", 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Iota]"], ":", ","}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"b7939903-648a-41bc-8585-54fa0845a62c"],

Cell[TextData[{
 "with the fermion-number current ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["j", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["F",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}]], "\[LongEqual]", 
    SubscriptBox[
     OverscriptBox["\[CapitalPsi]", "_"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p", "TI"]], 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b49d740c-9421-4c5b-a281-94a9872ec652"],
 " and the pair operators ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalPi]", 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Iota]"], "\[LongEqual]", 
    SubsuperscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["T", "TI"]], 
    SubsuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Iota]"], 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "48f42b10-9356-4b09-8fd3-1c7ecde9e349"],
 " of one point. ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "0", ")"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7e37464c-0b0d-4d60-b9f5-fdd8597830db"],
 " is formed after the author's Kohn-Sham ansatz, whose interaction energy \
density of uniform matter is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], 
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["V", "TI"]], 
    SuperscriptBox[
     StyleBox["n", "TI"], "2"], "+", 
    FractionBox["1", "2"], 
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["S", "TI"]], 
    SubsuperscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["S", "TI"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d1ecb35f-2c50-4b1b-a13f-9a5bee350cd6"],
 "; ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "1", ")"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "297e97a7-52c6-4374-a598-5c8c9aa41d87"],
 " adds the attraction in the spin-zero pair channel. Varying the action with \
respect to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox["\[CapitalPsi]", "_"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4ea4f79c-9dad-4b8c-9209-66614e2ec249"],
 " gives the field equation of the spinor field,"
}], "Text",ExpressionUUID->"3ce78193-0a2a-4c86-9050-3604194766ad"],

Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox["i", "TI"], "\[ThinSpace]", 
   UnderscriptBox["\[Sum]", 
    StyleBox["p", "TI"],
    LimitsPositioning->True], "\[ThinSpace]", 
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p", "TI"]], 
   SubsuperscriptBox["\[Del]", 
    StyleBox["p", "TI"], 
    StyleBox["GEE",
     FontSlant->"Plain"]], 
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], "-", 
   SubscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], "\[LongEqual]", 
   SubsuperscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["S",
     FontSlant->"Plain"]], 
   RowBox[{"(", 
    RowBox[{
     SubscriptBox[
      OverscriptBox["\[CapitalPsi]", "_"], 
      StyleBox["LL",
       FontSlant->"Plain"]], 
     SubscriptBox["\[CapitalPsi]", 
      StyleBox["LL",
       FontSlant->"Plain"]]}], ")"}], 
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], "+", 
   SubsuperscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["V",
     FontSlant->"Plain"]], "\[ThinSpace]", 
   UnderscriptBox["\[Sum]", 
    StyleBox["p", "TI"],
    LimitsPositioning->True], "\[ThinSpace]", 
   SubsuperscriptBox[
    StyleBox["j", "TI"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}], 
    StyleBox["F",
     FontSlant->"Plain"]], 
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p", "TI"]], 
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], "-", 
   FractionBox["1", "2"], 
   SubscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], "\[ThinSpace]", 
   UnderscriptBox["\[Sum]", "\[Iota]",
    LimitsPositioning->True], "\[ThinSpace]", 
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], "0"], 
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], "\[Iota]"], ")"}], "\[Dagger]"], 
   SubsuperscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"], "*"], "\[ThinSpace]", 
   SubsuperscriptBox["\[CapitalPi]", 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Iota]"], ","}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"af9fa93c-85d9-4c90-b36c-f445379671ff"],

Cell[TextData[{
 "and varying with respect to the gauge fields gives the Yang-Mills equations \
with the currents of the spinor field as sources, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["p", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubscriptBox["\[PartialD]", 
     StyleBox["p", "TI"]], 
    SubsuperscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{"\[Iota]", ",", 
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], "-", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      SuperscriptBox["\[Iota]", "\[Prime]"], 
      SuperscriptBox["\[Iota]", "\[Prime]\[Prime]"]}],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox["\[Epsilon]", 
     RowBox[{"\[Iota]", 
      SuperscriptBox["\[Iota]", "\[Prime]"], 
      SuperscriptBox["\[Iota]", "\[Prime]\[Prime]"]}], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", 
     StyleBox["p", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["W", "TI"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], 
     SuperscriptBox["\[Iota]", "\[Prime]"]], 
    SubsuperscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      SuperscriptBox["\[Iota]", "\[Prime]\[Prime]"], ",", 
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["j", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{"\[Iota]", ",", 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c84be759-3bb4-460f-b22f-a0bfe3c3101f"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["p", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubscriptBox["\[PartialD]", 
     StyleBox["p", "TI"]], 
    SubsuperscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["j", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["F",
       FontSlant->"Plain"], ",", 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e0a2e602-0599-45c7-8faa-0b253906e18c"],
 "."
}], "Text",ExpressionUUID->"cde23a23-efa1-4456-95c0-8ec7f1729271"],

Cell[TextData[{
 "The right side of the field equation of the spinor field is the commutator \
of the field with the Hamiltonian of the contact terms. The next cell checks \
this exactly, as an identity of operators on the Fock space of the eight \
components of one point (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["2", "8"], "\[LongEqual]", "256"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b8ea7d35-21ab-4b5b-afa2-8f106a61a32a"],
 " states), for each contact term: with the Hamiltonians ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["S",
      FontSlant->"Plain"]], "\[LongEqual]", 
    FractionBox["1", "2"], 
    SuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["S",
      FontSlant->"Plain"]], ":", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["\[CapitalPsi]", "\[Dagger]"], "\[Beta]", 
       "\[CapitalPsi]"}], ")"}], "2"], ":"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c4776986-3ac9-4b6e-95f5-910a20a23aec"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["V",
      FontSlant->"Plain"]], "\[LongEqual]", 
    FractionBox["1", "2"], 
    SuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["V",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     RowBox[{":", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["\[CapitalPsi]", "\[Dagger]"], "\[CapitalPsi]"}], 
        ")"}], "2"], ":", 
      RowBox[{"-", 
       UnderscriptBox["\[Sum]", 
        StyleBox["j", "TI"],
        LimitsPositioning->True]}], ":", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["\[CapitalPsi]", "\[Dagger]"], 
         SuperscriptBox["\[Alpha]", 
          StyleBox["j", "TI"]], "\[CapitalPsi]"}], ")"}], "2"], ":"}], 
     ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "817b7d39-9238-455d-ab54-3a8608bea79f"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["P",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"-", 
     FractionBox["1", "4"]}], 
    StyleBox["G", "TI"], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", "\[Iota]",
     LimitsPositioning->True], "\[ThinSpace]", 
    SuperscriptBox["\[CapitalPi]", 
     RowBox[{"\[Iota]", "\[Dagger]"}]], 
    SuperscriptBox["\[CapitalPi]", "\[Iota]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "66b005ef-eb4d-43c2-8452-1c0fed930105"],
 ", the commutators ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{
     SubscriptBox["\[CapitalPsi]", 
      StyleBox["e", "TI"]], ",", 
     StyleBox["H", "TI"]}], "]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bfb9d75a-3f79-40c6-965b-568f6ecdf604"],
 " equal ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["S",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     RowBox[{
      OverscriptBox["\[CapitalPsi]", "_"], "\[CapitalPsi]"}], ")"}], 
    SubscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["\[Gamma]", "0"], "\[CapitalPsi]"}], ")"}], 
     StyleBox["e", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1f5e00f5-e23e-4dab-a1af-c55eb54750cd"],
 ", the vector term, and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", "2"]}], 
    StyleBox["G", "TI"], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", "\[Iota]",
     LimitsPositioning->True], 
    SubscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        StyleBox["K",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        RowBox[{"\[Iota]", "\[Dagger]"}]], 
       SuperscriptBox["\[CapitalPsi]", "*"]}], ")"}], 
     StyleBox["e", "TI"]], 
    SuperscriptBox["\[CapitalPi]", "\[Iota]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "31165fe9-ab12-4269-a6f9-90a50c62c77c"],
 ". The couplings of the test are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["S",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"-", "8"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cc18366c-03ba-4171-a34d-ac0540b73426"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["V",
      FontSlant->"Plain"]], "\[LongEqual]", "4", "/", "5"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a063f653-82f1-404e-842e-7613b90dd661"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["G", "TI"], "\[LongEqual]", "45", "/", "2"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "74caa341-0b2e-400d-a888-f067f9d3a90a"],
 ", exact numbers, so every deviation must be exactly 0. The last check of \
the cell derives the Yang-Mills equations with a source symbolically, with \
the function ",
 StyleBox["EulerEquations",
  FontFamily->"Source Code Pro"],
 " of the package ",
 StyleBox["VariationalMethods",
  FontFamily->"Source Code Pro"],
 " of the Wolfram Language, and compares all twelve equations with the form \
above."
}], "Text",ExpressionUUID->"37ff8356-f982-48c3-92be-d9a96987bc8a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", "annihilation", " ", "operators", " ", "c_e", " ", 
     RowBox[{"(", 
      RowBox[{"e", " ", "=", " ", 
       RowBox[{
        RowBox[{"1", ".."}], "8"}]}], ")"}], " ", "of", " ", "the", " ", 
     "eight", " ", "components", " ", "and", " ", "their", " ", "adjoints"}], 
    ",", " ", 
    RowBox[{"256", " ", "x", " ", "256", " ", "sparse", " ", "matrices"}]}], 
   " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"cOps", " ", "=", " ", 
     RowBox[{"fockOps", "[", "8", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"cdOps", " ", "=", " ", 
     RowBox[{"ConjugateTranspose", " ", "/@", " ", "cOps"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"bilinear", "[", "a", "]"}], ":", " ", 
     RowBox[{"sum_ij", " ", "a_ij", " ", 
      RowBox[{"c_i", "^", "dag"}], " ", "c_j"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"bilinear", "[", "a_", "]"}], " ", ":=", " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"a", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", " ", "j"}], "]"}], "]"}], " ", "=!=", " ", 
          "0"}], ",", " ", 
         RowBox[{
          RowBox[{"a", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", " ", "j"}], "]"}], "]"}], " ", 
          RowBox[{
           RowBox[{"cdOps", "[", 
            RowBox[{"[", "i", "]"}], "]"}], " ", ".", " ", 
           RowBox[{"cOps", "[", 
            RowBox[{"[", "j", "]"}], "]"}]}]}], ",", " ", "0"}], "]"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "8"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "8"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"quartic", "[", 
      RowBox[{"a", ",", " ", "b"}], "]"}], ":", " ", 
     RowBox[{
      RowBox[{"the", " ", "normal"}], "-", 
      RowBox[{
      "ordered", " ", "product", " ", "sum_ijkl", " ", "a_ij", " ", "b_kl", " ", 
       RowBox[{"c_i", "^", "dag"}], " ", 
       RowBox[{"c_k", "^", "dag"}], " ", "c_l", " ", "c_j"}]}]}], " ", "*)"}],
    "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"quartic", "[", 
      RowBox[{"a_", ",", " ", "b_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"a", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", " ", "j"}], "]"}], "]"}], " ", "=!=", " ", 
           "0"}], " ", "&&", " ", 
          RowBox[{
           RowBox[{"b", "[", 
            RowBox[{"[", 
             RowBox[{"k", ",", " ", "l"}], "]"}], "]"}], " ", "=!=", " ", 
           "0"}]}], ",", " ", 
         RowBox[{
          RowBox[{"a", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", " ", "j"}], "]"}], "]"}], " ", 
          RowBox[{"b", "[", 
           RowBox[{"[", 
            RowBox[{"k", ",", " ", "l"}], "]"}], "]"}], " ", 
          RowBox[{
           RowBox[{"cdOps", "[", 
            RowBox[{"[", "i", "]"}], "]"}], " ", ".", " ", 
           RowBox[{"cdOps", "[", 
            RowBox[{"[", "k", "]"}], "]"}], " ", ".", " ", 
           RowBox[{"cOps", "[", 
            RowBox[{"[", "l", "]"}], "]"}], " ", ".", " ", 
           RowBox[{"cOps", "[", 
            RowBox[{"[", "j", "]"}], "]"}]}]}], ",", " ", "0"}], "]"}], ",", 
       "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "8"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "8"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", "8"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"l", ",", " ", "8"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"gScal", ",", " ", "gVec", ",", " ", 
     RowBox[{"gPair", ":", " ", 
      RowBox[{
      "the", " ", "exact", " ", "couplings", " ", "of", " ", "the", " ", 
       "test"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"gScal", ",", " ", "gVec", ",", " ", "gPair"}], "}"}], " ", "=",
      " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "8"}], ",", " ", 
       RowBox[{"4", "/", "5"}], ",", " ", 
       RowBox[{"45", "/", "2"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"beta8", " ", "=", " ", 
     RowBox[{"d8", "[", "betaLL", "]"}]}], ";", " ", 
    RowBox[{"alpha8", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"d8", "[", 
        RowBox[{"alphaLL", "[", "j", "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"hS", " ", "=", " ", 
     RowBox[{
      RowBox[{"gScal", "/", "2"}], " ", 
      RowBox[{"quartic", "[", 
       RowBox[{"beta8", ",", " ", "beta8"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"hV", " ", "=", " ", 
     RowBox[{
      RowBox[{"gVec", "/", "2"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"quartic", "[", 
         RowBox[{
          RowBox[{"IdentityMatrix", "[", "8", "]"}], ",", " ", 
          RowBox[{"IdentityMatrix", "[", "8", "]"}]}], "]"}], " ", "-", " ", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{"quartic", "[", 
           RowBox[{
            RowBox[{"alpha8", "[", 
             RowBox[{"[", "j", "]"}], "]"}], ",", " ", 
            RowBox[{"alpha8", "[", 
             RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}], ")"}]}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", "pair", " ", "operators", " ", 
      RowBox[{"Pi", "^", "iota"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{
      "sum_ij", " ", "K_ij", " ", "c_i", " ", "c_j", " ", "and", " ", "the", " ",
        "pairing", " ", "Hamiltonian"}], " ", "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"G", "/", "4"}], ")"}], " ", "sum", " ", 
       RowBox[{"Pi", "^", "dag"}], " ", "Pi"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"piOps", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"k", " ", "=", " ", 
           RowBox[{"kLL", "[", "iota", "]"}]}], "}"}], ",", " ", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"k", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", " ", "j"}], "]"}], "]"}], " ", "=!=", " ", 
              "0"}], ",", " ", 
             RowBox[{
              RowBox[{"k", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", " ", "j"}], "]"}], "]"}], " ", 
              RowBox[{
               RowBox[{"cOps", "[", 
                RowBox[{"[", "i", "]"}], "]"}], " ", ".", " ", 
               RowBox[{"cOps", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}]}], ",", " ", "0"}], "]"}], ",",
            " ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "8"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"j", ",", " ", "8"}], "}"}]}], "]"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"iota", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"hP", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "gPair"}], "/", "4"}], " ", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ConjugateTranspose", "[", 
          RowBox[{"piOps", "[", 
           RowBox[{"[", "k", "]"}], "]"}], "]"}], " ", ".", " ", 
         RowBox[{"piOps", "[", 
          RowBox[{"[", "k", "]"}], "]"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nBeta", " ", "=", " ", 
     RowBox[{"bilinear", "[", "beta8", "]"}]}], ";", " ", 
    RowBox[{"nOne", " ", "=", " ", 
     RowBox[{"bilinear", "[", 
      RowBox[{"IdentityMatrix", "[", "8", "]"}], "]"}]}], ";", " ", 
    RowBox[{"nAlpha", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"bilinear", "[", 
        RowBox[{"alpha8", "[", 
         RowBox[{"[", "j", "]"}], "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"lin", "[", "v", "]"}], " ", "=", " ", 
     RowBox[{"sum_b", " ", "v_b", " ", "c_b"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"lin", "[", "v_", "]"}], " ", ":=", " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"v", "[", 
         RowBox[{"[", "b", "]"}], "]"}], " ", 
        RowBox[{"cOps", "[", 
         RowBox[{"[", "b", "]"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"b", ",", " ", "8"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dE2", ",", " ", "dE3", ",", " ", "dE4"}], "}"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", "\n", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"dE2", " ", "=", " ", 
        RowBox[{"Max", "[", 
         RowBox[{"dE2", ",", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{"Normal", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"cOps", "[", 
                RowBox[{"[", "e", "]"}], "]"}], " ", ".", " ", "hS"}], " ", "-",
               " ", 
              RowBox[{"hS", " ", ".", " ", 
               RowBox[{"cOps", "[", 
                RowBox[{"[", "e", "]"}], "]"}]}], " ", "-", " ", 
              RowBox[{"gScal", " ", 
               RowBox[{"nBeta", " ", ".", " ", 
                RowBox[{"lin", "[", 
                 RowBox[{"beta8", "[", 
                  RowBox[{"[", "e", "]"}], "]"}], "]"}]}]}]}], "]"}], "]"}], 
           "]"}]}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"dE3", " ", "=", " ", 
        RowBox[{"Max", "[", 
         RowBox[{"dE3", ",", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{"Normal", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"cOps", "[", 
                RowBox[{"[", "e", "]"}], "]"}], " ", ".", " ", "hV"}], " ", "-",
               " ", 
              RowBox[{"hV", " ", ".", " ", 
               RowBox[{"cOps", "[", 
                RowBox[{"[", "e", "]"}], "]"}]}], " ", "-", " ", 
              RowBox[{"gVec", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"nOne", " ", ".", " ", 
                  RowBox[{"cOps", "[", 
                   RowBox[{"[", "e", "]"}], "]"}]}], " ", "-", " ", 
                 RowBox[{"Sum", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"nAlpha", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], " ", ".", " ", 
                    RowBox[{"lin", "[", 
                    RowBox[{"alpha8", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", ",", " ", "e"}], "]"}], "]"}], "]"}]}], ",", 
                   " ", 
                   RowBox[{"{", 
                    RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}], ")"}]}]}],
              "]"}], "]"}], "]"}]}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"dE4", " ", "=", " ", 
        RowBox[{"Max", "[", 
         RowBox[{"dE4", ",", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{"Normal", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"cOps", "[", 
                RowBox[{"[", "e", "]"}], "]"}], " ", ".", " ", "hP"}], " ", "-",
               " ", 
              RowBox[{"hP", " ", ".", " ", 
               RowBox[{"cOps", "[", 
                RowBox[{"[", "e", "]"}], "]"}]}], " ", "+", " ", 
              RowBox[{
               RowBox[{"gPair", "/", "2"}], " ", 
               RowBox[{"Sum", "[", 
