Cell[CellGroupData[{

Cell["\<\
R.1.11 The pattern of the breaking (checks WQN-11 and WQN-11f)\
\>", "Subsection",ExpressionUUID->"e217c928-a819-4911-8b48-0447c693e168"],

Cell[TextData[{
 "The generators that leave a condensate unchanged span its stabilizer; the \
code finds them as the null space of the real linear conditions ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       StyleBox["A", "TI"],
       LimitsPositioning->True], "\[ThinSpace]", 
      SubscriptBox[
       StyleBox["c", "TI"], 
       StyleBox["A", "TI"]], 
      SubscriptBox[
       StyleBox["G", "TI"], 
       StyleBox["A", "TI"]]}], ")"}], 
    StyleBox["w", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b2306521-b409-4739-adaa-51fd569b429b"],
 " on the coefficients ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["A", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "30d14c14-12b8-48b1-a101-77256b3e4d93"],
 ", for each pair field ",
 Cell[BoxData[
  FormBox[
   StyleBox["w", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c552d475-a98d-4dc3-b9b9-e983b8c30b28"],
 " of the condensate with its generators ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["A", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e31ab441-e5f8-440c-811b-4bc47391f51e"],
 ". In ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["L", "TI"]], "\[Times]", 
    StyleBox["U", "TI"], 
    SubscriptBox[
     RowBox[{"(", "1", ")"}], 
     StyleBox["Y", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a964b30f-812d-43f7-8cff-f3980f1d2e3d"],
 " the stabilizer of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPhi]", 
     StyleBox["SH",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{"0", ",", "\[Phi]"}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "aa8a9e9e-e5ca-43bd-8017-75fe526e6c33"],
 ", and of the neutral vacuum of the hypotheses with both pair fields, is \
spanned by ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["Q", "TI"], 
    StyleBox["SM",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d92a0ddd-be0e-41a2-9e76-c09f0b33d4e5"],
 ": the breaking ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["L", "TI"]], "\[Times]", 
    StyleBox["U", "TI"], 
    SubscriptBox[
     RowBox[{"(", "1", ")"}], 
     StyleBox["Y", "TI"]], "\[RightArrow]", 
    StyleBox["U", "TI"], 
    SubscriptBox[
     RowBox[{"(", "1", ")"}], 
     StyleBox["Q", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "106ee14a-64b7-4dda-8ba9-a4ccb8ebd404"],
 " of the Standard Model. Among the eight generators ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["T", "TI"], 
     RowBox[{
      StyleBox["a", "TI"], ",", 
      StyleBox["SM",
       FontSlant->"Plain"]}]], ",", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["a", "TI"], ",", 
      StyleBox["R",
       FontSlant->"Plain"]}]], ",", 
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]], ",", 
    SubsuperscriptBox[
     StyleBox["F", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["tot",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dafd094c-25b1-4995-b516-023157db27ab"],
 " the stabilizer of the bidoublet ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Phi]", "\[ThinSpace]", 
    StyleBox["i", "TI"], 
    SuperscriptBox["\[Tau]", "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "da9a22c0-32af-4f54-b609-21bdb24173de"],
 " (equal lengths of the two pair fields) is spanned by the three generators ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["T", "TI"], 
     RowBox[{
      StyleBox["a", "TI"], ",", 
      StyleBox["SM",
       FontSlant->"Plain"]}]], "+", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["a", "TI"], ",", 
      StyleBox["R",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1ade6374-ec58-446d-83f5-618e61d638e8"],
 " of the custodial group ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["V",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d4febb9e-04f3-4e02-ad33-59a2f749463b"],
 " and by ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6592ee81-3762-4d15-b6a7-67e398d9c318"],
 "; three gauged generators and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["F", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"], 
    StyleBox["tot",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "67dd7757-04e2-4dde-bcbc-19e509aa32a2"],
 " are broken. A neutral vacuum of equal lengths with other phases keeps four \
generators (a conjugate of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["V",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2bba5bd9-2de2-40d8-86ba-d6e7ec47352a"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "957239ac-87c4-4b2f-9e79-2b33811f2d01"],
 "), and one of unequal lengths keeps only ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["T", "TI"], 
     RowBox[{"3", ",", 
      StyleBox["SM",
       FontSlant->"Plain"]}]], "+", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     RowBox[{"3", ",", 
      StyleBox["R",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ae505ac9-f621-4665-8e0a-88462c8d98e9"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c25be5ab-8a56-47b7-ac12-06e2e4bccd59"],
 ". ",
 StyleBox["WQN-11f.",
  FontWeight->"Bold"],
 " A generic second condensate in any channel with a charged component, added \
to the neutral vacuum, leaves no generator of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["L", "TI"]], "\[Times]", 
    StyleBox["U", "TI"], 
    SubscriptBox[
     RowBox[{"(", "1", ")"}], 
     StyleBox["Y", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b78f4a39-04fe-47f7-a7e5-e8d21edef2b3"],
 " unbroken, while one in the neutral part of a channel keeps exactly ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["Q", "TI"], 
    StyleBox["SM",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2e38dcd9-a7a4-4e75-8ca4-2b5f0d1b6cbc"],
 ": the mean fields of the methods must keep the second kind only."
}], "Text",ExpressionUUID->"48bbdb44-86e7-4ded-b5dc-201910de41f7"],

