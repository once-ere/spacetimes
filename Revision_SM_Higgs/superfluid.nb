     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"ArrayFlatten", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", 
             RowBox[{"mFt", " ", ".", " ", 
              RowBox[{"sig", "[", 
               RowBox[{"[", 
                RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}], " ", ".", 
              " ", "mFtdag"}]}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"mF", " ", ".", " ", 
              RowBox[{"sigbar", "[", 
               RowBox[{"[", 
                RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}], " ", ".", 
              " ", "mFdag"}], ",", " ", "0"}], "}"}]}], "}"}], "]"}], " ", ".",
         "\n", "     ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"dd", "[", 
           RowBox[{"spsi", ",", " ", "p"}], "]"}], " ", "-", " ", 
          RowBox[{
           RowBox[{"dd", "[", 
            RowBox[{"sF", ",", " ", "p"}], "]"}], " ", ".", " ", "sFinv", " ",
            ".", " ", "spsi"}]}], ")"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"rhsC8", " ", "=", " ", 
     RowBox[{"sF", " ", ".", " ", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"gam", "[", "p", "]"}], " ", ".", " ", 
         RowBox[{"dd", "[", 
          RowBox[{"psi4", ",", " ", "p"}], "]"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"dC8", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"lhsC8", " ", "-", " ", "rhsC8"}], ")"}], " ", "/.", " ", 
           "pt"}], "]"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"pt", ",", " ", "ptsT"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WC-8\>\"", ",", 
      " ", "\"\<local SL(2,C): gamma^p[f'] (d_p + Gamma'_p)(S psi) = S \
gamma^p d_p psi (symbolic derivatives)\>\"", ",", " ", "dC8", ",", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "9"}]}], ",", " ", "\"\<C-8\>\"", ",", 
      " ", "\"\<C-8\>\""}], "]"}], ";"}]}]}]], "Input",
 CellLabel->"In[92]:=",ExpressionUUID->"dee614b4-0634-4c04-ac40-5b87b0c8de45"],

