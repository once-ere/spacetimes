}]}]}]}]}]}], "-", "2"}], ":", " ", 
    RowBox[{"the", " ", "Josephson", " ", "relation"}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"the", " ", "Nambu", " ", "space", " ", "of", " ", "one", " ", 
      RowBox[{"component", ":", " ", "F"}]}], " ", "=", " ", 
     RowBox[{"diag", 
      RowBox[{"(", 
       RowBox[{"1", ",", " ", 
        RowBox[{"-", "1"}]}], ")"}]}]}], ";", " ", 
    RowBox[{"the", " ", "BdG", " ", "matrix", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "p"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Conjugate", "[", "p", "]"}], ",", " ", 
         RowBox[{"-", "a"}]}], "}"}]}], "}"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"fN", " ", "=", " ", 
     RowBox[{"DiagonalMatrix", "[", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", 
        RowBox[{"-", "1"}]}], "}"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"uu", " ", "=", " ", 
     RowBox[{"MatrixExp", "[", 
      RowBox[{"I", " ", "mu", " ", "fN", " ", "tt"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
      "ComplexExpand", " ", "takes", " ", "every", " ", "symbol", " ", "as", " ",
        "real"}], ";", " ", 
      RowBox[{
      "the", " ", "identities", " ", "are", " ", "polynomial", " ", "in", " ",
        "the", " ", "entries", " ", "r"}]}], ",", " ", "h", ",", " ", 
     RowBox[{
     "so", " ", "that", " ", "they", " ", "then", " ", "hold", "\n", "   ", 
      "for", " ", "complex", " ", "entries", " ", "too"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"rot", " ", "=", " ", 
     RowBox[{"ComplexExpand", "[", 
      RowBox[{"uu", " ", ".", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"r11", ",", " ", "r12"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"r21", ",", " ", "r22"}], "}"}]}], "}"}], " ", ".", " ", 
       RowBox[{"ConjugateTranspose", "[", "uu", "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"josOK", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"rot", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", " ", "2"}], "]"}], "]"}], " ", "-", " ", 
         RowBox[{
          RowBox[{"ComplexExpand", "[", 
           RowBox[{"Exp", "[", 
            RowBox[{"2", " ", "I", " ", "mu", " ", "tt"}], "]"}], "]"}], " ", 
          "r12"}]}], "]"}], " ", "===", " ", "0"}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"rot", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], " ", "-", " ", "r11"}],
         "]"}], " ", "===", " ", "0"}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", 
      RowBox[{"equation", ":", " ", 
       RowBox[{"i", " ", 
        RowBox[{"d", "/", "dt"}], " ", 
        RowBox[{"(", 
         RowBox[{"U", " ", "R0", " ", 
          RowBox[{"U", "^", "dag"}]}], ")"}]}]}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"[", 
        RowBox[{
         RowBox[{
          RowBox[{"H0", "'"}], " ", "-", " ", 
          RowBox[{"mu", " ", "F"}]}], ",", " ", 
         RowBox[{"U", " ", "R0", " ", 
          RowBox[{"U", "^", "dag"}]}]}], "]"}], " ", "with", " ", 
       RowBox[{"H0", "'"}]}], " ", "=", " ", 
      RowBox[{
       RowBox[{"U", " ", "H0", " ", 
        RowBox[{"U", "^", "dag"}], " ", 
        RowBox[{"and", " ", "[", 
         RowBox[{"H0", ",", " ", "R0"}], "]"}]}], " ", "=", " ", "0"}]}]}], 
    " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"h0", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"h11", ",", " ", "h12"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"h21", ",", " ", "h22"}], "}"}]}], "}"}]}], ";", " ", 
    RowBox[{"r0", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"q11", ",", " ", "q12"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"q21", ",", " ", "q22"}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"lhs", " ", "=", " ", 
     RowBox[{"I", " ", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"uu", " ", ".", " ", "r0", " ", ".", " ", 
         RowBox[{"ConjugateTranspose", "[", "uu", "]"}]}], ",", " ", "tt"}], 
       "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rhs", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"uu", " ", ".", " ", "h0", " ", ".", " ", 
          RowBox[{"ConjugateTranspose", "[", "uu", "]"}]}], " ", "-", " ", 
         RowBox[{"mu", " ", "fN"}]}], ")"}], " ", ".", " ", 
       RowBox[{"(", 
        RowBox[{"uu", " ", ".", " ", "r0", " ", ".", " ", 
         RowBox[{"ConjugateTranspose", "[", "uu", "]"}]}], ")"}]}], " ", "-", 
      "\n", "   ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"uu", " ", ".", " ", "r0", " ", ".", " ", 
         RowBox[{"ConjugateTranspose", "[", "uu", "]"}]}], ")"}], " ", ".", 
       " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"uu", " ", ".", " ", "h0", " ", ".", " ", 
          RowBox[{"ConjugateTranspose", "[", "uu", "]"}]}], " ", "-", " ", 
         RowBox[{"mu", " ", "fN"}]}], ")"}]}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"i", " ", 
      RowBox[{"dR", "/", "dt"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          RowBox[{"mu", " ", "[", 
           RowBox[{"F", ",", " ", 
            RowBox[{"R", 
             RowBox[{"(", "t", ")"}]}]}], "]"}]}], " ", "and", " ", "the", " ",
          "right", " ", "side", " ", "is", " ", 
         RowBox[{"U", " ", "[", 
          RowBox[{"H0", ",", " ", "R0"}], "]"}], " ", 
         RowBox[{"U", "^", "dag"}]}], " ", "-", " ", 
        RowBox[{"mu", " ", "[", 
         RowBox[{"F", ",", " ", 
          RowBox[{"R", 
           RowBox[{"(", "t", ")"}]}]}], "]"}]}], ":", " ", 
       RowBox[{"they", " ", "agree", " ", 
        RowBox[{"when", " ", "[", 
         RowBox[{"H0", ",", " ", "R0"}], "]"}]}]}], " ", "=", " ", "0"}]}], 
    " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"eqOK", " ", "=", " ", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{"ComplexExpand", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"lhs", " ", "-", " ", "rhs"}], ")"}], " ", "+", " ", 
         RowBox[{"uu", " ", ".", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"h0", " ", ".", " ", "r0"}], " ", "-", " ", 
            RowBox[{"r0", " ", ".", " ", "h0"}]}], ")"}], " ", ".", " ", 
          RowBox[{"ConjugateTranspose", "[", "uu", "]"}]}]}], "]"}], "]"}], 
      " ", "===", " ", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"shdr", ",", " ", "srows"}], "}"}], " ", "=", " ", 
     RowBox[{"readTable", "[", "sigFile", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"jruns", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"DeleteDuplicates", "[", 
        RowBox[{"srows", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", 
           RowBox[{"col", "[", 
