Cell[TextData[{
 "The zeugon attracts the condensed pair (positive eigenvalue) and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2938846f-ef2b-46c4-872f-3dbe8a50f6be"],
 " repels it four times as strongly. ",
 StyleBox["CJT with the exchange.",
  FontWeight->"Bold"],
 " The last cell of Part II makes the CJT state of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "2", ")"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f0423702-8290-4f79-8a9f-42f2dc831d68"],
 " self-consistent with the exchange of all four gauge bosons added to the \
contact terms: the self-energies now depend on the momentum, and the matrix \
of Bogoliubov and de Gennes at the momentum ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["q", "TI"], "\[RightVector]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "79b78d9e-ee14-4b46-aa28-7cfb477be213"],
 " contains the exchange self-energies at ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["q", "TI"], "\[RightVector]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cfedac36-2733-4e9b-a503-33ada6064297"],
 " (and at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    OverscriptBox[
     StyleBox["q", "TI"], "\[RightVector]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4da477d7-ccc0-4a1e-8a30-9ddab06d6405"],
 " in its lower block). The boson masses are those of the Rust program, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["M", "TI"], 
    StyleBox["W", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ed444a57-0bc5-4430-9ff8-92b63d7c5438"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["M", "TI"], 
    StyleBox["Z", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4af6523e-6d0e-4767-9395-50f389c83c15"],
 " of this state and a massless zeugon; the iteration mixes one half of the \
new self-energies until they change by less than ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "11"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f0449773-48a9-48cc-8066-5af5221d9c32"],
 ". The superfluid survives, and the energy agrees with the Rust value."
}], "Text",ExpressionUUID->"7578eac7-9376-4a13-b81a-6b890a03a82d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
     "CJT", " ", "with", " ", "the", " ", "exchange", " ", "of", " ", "the", " ",
       "four", " ", "gauge", " ", "bosons", " ", "at", " ", "g_v"}], " ", "=",
      " ", "0.7"}], ",", " ", 
    RowBox[{"g_F", " ", "=", " ", "0.45"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "mo", ",", " ", "s", ",", " ", "bos", ",", " ", "nc", ",", " ", "pc", ",",
        " ", "nex", ",", " ", "pex", ",", " ", 
       RowBox[{"it", " ", "=", " ", "0"}], ",", " ", 
       RowBox[{"res", " ", "=", " ", "1."}], ",", " ", "cn", ",", " ", "cp", ",",
        " ", "ev", ",", " ", "rho", ",", " ", "kap", ",", " ", "ek", ",", " ",
        "ei", ",", " ", "n2", ",", " ", "p2", ",", " ", "n3", ",", " ", "p3", 
       ",", " ", "eex", ",", " ", "masses"}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"mo", ",", " ", "s"}], "}"}], " ", "=", " ", 
       RowBox[{"groundSF", "[", "\"\<V2_CJT\>\"", "]"}]}], ";", "\n", "  ", 
      RowBox[{"masses", " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"rustPart2", "[", "\"\<p2_cjtex_M_W\>\"", "]"}], ",", " ", 
         RowBox[{"rustPart2", "[", "\"\<p2_cjtex_M_W\>\"", "]"}], ",", " ", 
         "0.", ",", " ", 
         RowBox[{"rustPart2", "[", "\"\<p2_cjtex_M_Z\>\"", "]"}]}], "}"}]}], ";",
       "\n", "  ", 
      RowBox[{"bos", " ", "=", " ", 
       RowBox[{"makeBosons", "[", 
        RowBox[{
         RowBox[{"mo", "[", "\"\<g\>\"", "]"}], ",", " ", "gvLL", ",", " ", 
         "gfLL", ",", " ", "masses"}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"nc", " ", "=", " ", 
       RowBox[{"s", "[", "\"\<n\>\"", "]"}]}], ";", " ", 
      RowBox[{"pc", " ", "=", " ", 
       RowBox[{"s", "[", "\"\<p\>\"", "]"}]}], ";", "\n", "  ", 
      RowBox[{"nex", " ", "=", " ", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"zero8", ",", " ", 
         RowBox[{
          RowBox[{"mo", "[", "\"\<g\>\"", "]"}], "[", "\"\<n\>\"", "]"}]}], 
        "]"}]}], ";", " ", 
      RowBox[{"pex", " ", "=", " ", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"zero8", ",", " ", 
         RowBox[{
          RowBox[{"mo", "[", "\"\<g\>\"", "]"}], "[", "\"\<n\>\"", "]"}]}], 
        "]"}]}], ";", "\n", "  ", 
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"res", " ", ">=", " ", 
          RowBox[{"10", "^", 
           RowBox[{"-", "11"}]}]}], " ", "&&", " ", 
         RowBox[{"it", " ", "<", " ", "20000"}]}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"cn", ",", " ", "cp", ",", " ", "ev"}], "}"}], " ", "=", 
          " ", 
          RowBox[{"states", "[", 
           RowBox[{"bdg", "[", 
            RowBox[{
            "mo", ",", " ", "nc", ",", " ", "pc", ",", " ", "nex", ",", " ", 
             "pex"}], "]"}], "]"}]}], ";", "\n", "   ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"rho", ",", " ", "kap", ",", " ", "ek"}], "}"}], " ", "=", 
          " ", 
          RowBox[{"localDens", "[", 
           RowBox[{"mo", ",", " ", "cn", ",", " ", "cp"}], "]"}]}], ";", "\n",
          "   ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ei", ",", " ", "n2", ",", " ", "p2"}], "}"}], " ", "=", 
          " ", 
          RowBox[{"interaction", "[", 
           RowBox[{
            RowBox[{"mo", "[", "\"\<ts\>\"", "]"}], ",", " ", "rho", ",", " ",
             "kap"}], "]"}]}], ";", "\n", "   ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"n3", ",", " ", "p3", ",", " ", "eex"}], "}"}], " ", "=", 
          " ", 
          RowBox[{"exchangeSF", "[", 
           RowBox[{
            RowBox[{"mo", "[", "\"\<g\>\"", "]"}], ",", " ", "bos", ",", " ", 
            
            RowBox[{"cn", " ", "-", " ", 
             RowBox[{"mo", "[", "\"\<vac\>\"", "]"}]}], ",", " ", "cp"}], 
           "]"}]}], ";", "\n", "   ", 
         RowBox[{"res", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"n2", " ", "-", " ", "nc"}], "]"}], ",", " ", 
            RowBox[{"Abs", "[", 
             RowBox[{"p2", " ", "-", " ", "pc"}], "]"}], ",", " ", 
            RowBox[{"Abs", "[", 
             RowBox[{"n3", " ", "-", " ", "nex"}], "]"}], ",", " ", 
            RowBox[{"Abs", "[", 
             RowBox[{"p3", " ", "-", " ", "pex"}], "]"}]}], "]"}]}], ";", 
         "\n", "   ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"res", " ", ">=", " ", 
            RowBox[{"10", "^", 
             RowBox[{"-", "11"}]}]}], ",", "\n", "    ", 
           RowBox[{
            RowBox[{"nc", " ", "=", " ", 
             RowBox[{
              RowBox[{"0.5", " ", "n2"}], " ", "+", " ", 
              RowBox[{"0.5", " ", "nc"}]}]}], ";", " ", 
            RowBox[{"pc", " ", "=", " ", 
             RowBox[{
              RowBox[{"0.5", " ", "p2"}], " ", "+", " ", 
              RowBox[{"0.5", " ", "pc"}]}]}], ";", "\n", "    ", 
            RowBox[{"nex", " ", "=", " ", 
             RowBox[{
              RowBox[{"0.5", " ", "n3"}], " ", "+", " ", 
              RowBox[{"0.5", " ", "nex"}]}]}], ";", " ", 
            RowBox[{"pex", " ", "=", " ", 
             RowBox[{
              RowBox[{"0.5", " ", "p3"}], " ", "+", " ", 
              RowBox[{"0.5", " ", "pex"}]}]}], ";", "\n", "    ", 
            RowBox[{"it", "++"}]}]}], "]"}]}]}], "]"}], ";", "\n", "  ", 
      RowBox[{"cjtExchange", " ", "=", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<energy\>\"", " ", "->", " ", 
          RowBox[{"ek", " ", "+", " ", "ei", " ", "+", " ", "eex"}]}], ",", 
         " ", 
         RowBox[{"\"\<exchange\>\"", " ", "->", " ", "eex"}], ",", " ", 
         RowBox[{"\"\<iterations\>\"", " ", "->", " ", "it"}]}], "|>"}]}], ";",
       "\n", "  ", 
      RowBox[{"check", "[", 
       RowBox[{"\"\<WP2-8d\>\"", ",", " ", 
        RowBox[{"\"\<CJT with the exchange at g_v = 0.7, g_F = 0.45: energy \
\>\"", " ", "<>", " ", 
         RowBox[{"sci", "[", 
          RowBox[{"ek", " ", "+", " ", "ei", " ", "+", " ", "eex"}], "]"}], 
         " ", "<>", " ", "\"\< = Rust (relative; \>\"", " ", "<>", " ", 
         RowBox[{"ToString", "[", "it", "]"}], " ", "<>", 
         " ", "\"\< iterations; exchange energy \>\"", " ", "<>", " ", 
         RowBox[{"sci", "[", "eex", "]"}], " ", "<>", " ", "\"\<)\>\""}], ",",
         "\n", "   ", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"ek", " ", "+", " ", "ei", " ", "+", " ", "eex"}], ")"}], 
           " ", "-", " ", 
           RowBox[{"rustPart2", "[", "\"\<p2_cjtex_energy\>\"", "]"}]}], 
          "]"}], "/", 
         RowBox[{"Abs", "[", 
          RowBox[{"rustPart2", "[", "\"\<p2_cjtex_energy\>\"", "]"}], "]"}]}],
         ",", " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "7"}]}], ",", " ", "\"\<P2-8f\>\"", ",", 
        " ", "\"\<YP2-8d\>\""}], "]"}]}]}], "]"}], ";"}]}]], "Input",
 CellLabel->
  "In[269]:=",ExpressionUUID->"40caa12d-e64f-4ff7-af1a-3f45bf18434b"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"PASS \"\>", "\[InvisibleSpace]", "\<\"WP2-8d\"\>", 
