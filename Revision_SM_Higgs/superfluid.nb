Cell[TextData[{
 StyleBox["The exchange of the gauge bosons.",
  FontWeight->"Bold"],
 " Beyond their contact limit, the four gauge bosons are exchanged between \
the charges with the propagator ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"\[LeftBracketingBar]", 
        RowBox[{
         OverscriptBox[
          StyleBox["q", "TI"], "\[RightVector]"], "-", 
         RowBox[{
          OverscriptBox[
           StyleBox["q", "TI"], "\[RightVector]"], "\[ThinSpace]", 
          SuperscriptBox["", "\[Prime]"]}]}], "\[RightBracketingBar]"}], "2"],
       "+", 
      SuperscriptBox[
       StyleBox["M", "TI"], "2"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e585dd59-f61a-4cf6-b339-c8f73eafd2d6"],
 " of a boson of mass ",
 Cell[BoxData[
  FormBox[
   StyleBox["M", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d3d435b9-f7d1-44e0-a344-3c9c033cd8ea"],
 ". In a uniform state the exchange self-energies at the momentum ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["q", "TI"], "\[RightVector]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8aedcb48-22c7-43de-b10e-2f27b99164ac"],
 " are integrals over ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     StyleBox["q", "TI"], "\[RightVector]"], "\[ThinSpace]", 
    SuperscriptBox["", "\[Prime]"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "357c9011-6e02-4df9-8ad9-86c9f32b8ccd"],
 " of the correlation matrices; with the six directions of the grid the \
correlation matrix at a radius has a part of angular momentum 0 (the mean \
over the directions) and three parts of angular momentum 1, and the angular \
integrals reduce to the two angular averages"
}], "Text",ExpressionUUID->"d3667a36-9b6b-43bb-8d16-d0dbf12d21ce"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["D", "TI"], "0"], 
   RowBox[{"(", 
    RowBox[{
     StyleBox["q", "TI"], ",", 
     SuperscriptBox[
      StyleBox["q", "TI"], "\[Prime]"]}], ")"}], "\[LongEqual]", 
   FractionBox["1", "2"], "\[ThinSpace]", 
   SubsuperscriptBox["\[Integral]", 
    RowBox[{"-", "1"}], "1"], "\[ThinSpace]", 
   FractionBox[
    StyleBox["dx", "TI"], 
    RowBox[{
     SuperscriptBox[
      StyleBox["q", "TI"], "2"], "+", 
     SuperscriptBox[
      StyleBox["q", "TI"], 
      RowBox[{"\[Prime]", "2"}]], "+", 
     SuperscriptBox[
      StyleBox["M", "TI"], "2"], "-", "2", 
     StyleBox["q", "TI"], 
     SuperscriptBox[
      StyleBox["q", "TI"], "\[Prime]"], 
     StyleBox["x", "TI"]}]], ",", "      ", 
   SubscriptBox[
    StyleBox["D", "TI"], "1"], 
   RowBox[{"(", 
    RowBox[{
     StyleBox["q", "TI"], ",", 
     SuperscriptBox[
      StyleBox["q", "TI"], "\[Prime]"]}], ")"}], "\[LongEqual]", 
   FractionBox["1", "2"], "\[ThinSpace]", 
   SubsuperscriptBox["\[Integral]", 
    RowBox[{"-", "1"}], "1"], "\[ThinSpace]", 
   FractionBox[
    RowBox[{
     StyleBox["x", "TI"], "\[ThinSpace]", 
     StyleBox["dx", "TI"]}], 
    RowBox[{
     SuperscriptBox[
      StyleBox["q", "TI"], "2"], "+", 
     SuperscriptBox[
      StyleBox["q", "TI"], 
      RowBox[{"\[Prime]", "2"}]], "+", 
     SuperscriptBox[
      StyleBox["M", "TI"], "2"], "-", "2", 
     StyleBox["q", "TI"], 
     SuperscriptBox[
      StyleBox["q", "TI"], "\[Prime]"], 
     StyleBox["x", "TI"]}]], ","}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"2250d69c-ad70-48d0-81e1-210e83976f32"],

Cell[TextData[{
 "whose closed forms contain ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["ln",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         StyleBox["q", "TI"], "-", 
         SuperscriptBox[
          StyleBox["q", "TI"], "\[Prime]"]}], ")"}], "2"], "+", 
      SuperscriptBox[
       StyleBox["M", "TI"], "2"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3adf85b1-daed-41f3-908d-60cf4e199755"],
 ", singular at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["q", "TI"], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["q", "TI"], "\[Prime]"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "766b7fa6-45f2-46c9-85f3-928b1cb81f18"],
 " for a massless boson; the radial integral subtracts this logarithm at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["q", "TI"], "\[Prime]"], "\[LongEqual]", 
    StyleBox["q", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "aaf8a3ef-27fa-458c-a474-85331eac7657"],
 " and integrates it exactly (",
 StyleBox["kernIntegral",
  FontFamily->"Source Code Pro"],
 "). The next cell compares the closed forms with a numerical integration \
over the angle; then it computes the Thouless eigenvalues of the exchange of \
the zeugon ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d2b11133-8be6-41c0-a8fa-fd0fd15c775d"],
 " alone and of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f95e4c27-7c13-4ddf-b185-4aa6f9ab931e"],
 " alone in the normal vacuum (per unit squared coupling; a positive \
eigenvalue attracts the pair ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a5be73bd-c043-4616-ae72-69949695deab"],
 "), by power iteration; and finally the CJT state of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "2", ")"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b9d555f9-8fe4-43eb-ba74-08cae54f593d"],
 " with the exchange of all four bosons at the couplings ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]], "\[LongEqual]", "0.7"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a10fe5bb-5dea-4b6c-8028-2e486ae7b466"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]], "\[LongEqual]", "0.45"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "af4da21a-fcc0-405e-9dad-b1815b25d156"],
 " and the boson masses of the Rust program."
}], "Text",ExpressionUUID->"d71fc879-a8ca-448e-bc35-5abdd68476d3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"kernSF", "[", 
      RowBox[{"g", ",", " ", "mass"}], "]"}], ":", " ", 
     RowBox[{"the", " ", "radial", " ", "kernels", " ", "of", " ", "D0"}]}], ",",
     " ", 
    RowBox[{"D1", " ", "in", " ", "closed", " ", 
     RowBox[{"form", ":", " ", 
      RowBox[{"{", 
       RowBox[{"r0", ",", " ", "r1"}], "}"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"s0", ",", " ", "s1"}], "}"}], " ", "with", " ", "D_l"}], " ", 
     "=", " ", 
     RowBox[{"r_l", " ", "+", " ", 
      RowBox[{"s_l", " ", "ln", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"q", " ", "-", " ", 
            RowBox[{"q", "'"}]}], ")"}], "^", "2"}], " ", "+", " ", 
         RowBox[{"M", "^", "2"}]}], ")"}]}]}]}], ",", "\n", "   ", 
    RowBox[{"the", " ", "logarithm", " ", "lm"}], ",", " ", 
    RowBox[{
     RowBox[{"and", " ", "aq"}], " ", "=", " ", 
     RowBox[{"the", " ", "exact", " ", "integral", " ", "of", " ", "ln", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"q", " ", "-", " ", 
           RowBox[{"q", "'"}]}], ")"}], "^", "2"}], " ", "+", " ", 
        RowBox[{"M", "^", "2"}]}], ")"}], " ", "over", " ", 
      RowBox[{"q", "'"}], " ", 
      RowBox[{"in", " ", "[", 
       RowBox[{"0", ",", " ", "Lambda"}], "]"}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"kernSF", "[", 
      RowBox[{"g_", ",", " ", "mass_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"kr", " ", "=", " ", 
          RowBox[{"g", "[", "\"\<kr\>\"", "]"}]}], ",", " ", "q", ",", " ", 
         "qp", ",", " ", "a", ",", " ", "b", ",", " ", "lp", ",", " ", "lm", ",",
          " ", "fp"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"q", " ", "=", " ", 
         RowBox[{"Outer", "[", 
          RowBox[{
           RowBox[{"#1", " ", "&"}], ",", " ", "kr", ",", " ", "kr"}], 
          "]"}]}], ";", " ", 
        RowBox[{"qp", " ", "=", " ", 
         RowBox[{"Outer", "[", 
          RowBox[{
           RowBox[{"#2", " ", "&"}], ",", " ", "kr", ",", " ", "kr"}], 
          "]"}]}], ";", "\n", "   ", 
        RowBox[{"a", " ", "=", " ", 
         RowBox[{
          RowBox[{"q", "^", "2"}], " ", "+", " ", 
          RowBox[{"qp", "^", "2"}], " ", "+", " ", 
          RowBox[{"mass", "^", "2"}]}]}], ";", " ", 
        RowBox[{"b", " ", "=", " ", 
         RowBox[{"2", " ", "q", " ", "qp"}]}], ";", " ", 
        RowBox[{"lp", " ", "=", " ", 
         RowBox[{"Log", "[", 
          RowBox[{"a", " ", "+", " ", "b"}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"lm", " ", "=", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"mass", " ", "==", " ", "0"}], " ", "&&", " ", 
              RowBox[{"i", " ", "==", " ", "j"}]}], ",", " ", "0.", ",", " ", 
             
             RowBox[{"Log", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"kr", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], " ", "-", " ", 
                  RowBox[{"kr", "[", 
                   RowBox[{"[", "j", "]"}], "]"}]}], ")"}], "^", "2"}], " ", "+",
                " ", 
               RowBox[{"mass", "^", "2"}]}], "]"}]}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", 
             RowBox[{"Length", "[", "kr", "]"}]}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"j", ",", " ", 
             RowBox[{"Length", "[", "kr", "]"}]}], "}"}]}], "]"}]}], ";", 
        "\n", "   ", 
        RowBox[{
         RowBox[{"fp", "[", "x_", "]"}], " ", ":=", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"mass", " ", "==", " ", "0"}], ",", " ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"x", " ", "==", " ", "0"}], ",", " ", "0.", ",", " ", 
             RowBox[{
              RowBox[{"x", " ", 
               RowBox[{"Log", "[", 
                RowBox[{"x", "^", "2"}], "]"}]}], " ", "-", " ", 
              RowBox[{"2", " ", "x"}]}]}], "]"}], ",", " ", 
           RowBox[{
