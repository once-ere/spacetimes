Cell[TextData[{
 StyleBox["Is the order parameter smaller and more physically reasonable?",
  FontWeight->"Bold"],
 " Yes, near the critical temperature, and only there, for the mean-field \
free energy of the methods (Section III.G shows that these temperatures lie \
inside the critical region of the transition, where the fluctuations that the \
methods omit dominate)."
}], "Text",ExpressionUUID->"10b51bbd-7a09-4e91-a1c1-4616ecda5bda"],

Cell[TextData[{
 StyleBox["It is smaller.",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalPhi]", 
     RowBox[{"0", ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c9f6ec0a-4010-443c-9806-74fbe5e30cfd"],
 " keeps its value of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "423da063-7f34-423f-92d1-27267e709cd6"],
 " up to about ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.3", "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "12388b66-1b09-4c76-8b45-cf435d446120"],
 " (the gap is much larger than these temperatures, and thermal \
quasi-particles are exponentially rare), then falls and vanishes continuously \
at ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9daedd74-6754-4db6-a049-46e0288f98e6"],
 ", like ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "-", 
      StyleBox["T", "TI"], "/", 
      SubsuperscriptBox[
       StyleBox["T", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["c",
         FontSlant->"Plain"]}]]}], ")"}], 
    RowBox[{"1", "/", "2"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ec12d3e3-4937-48d6-bc73-766a5538602a"],
 " (the table and the figure above)."
}], "ItemNumbered",ExpressionUUID->"ac6b4848-ea13-46df-9cf5-95cb5c8e01f9"],

Cell[TextData[{
 StyleBox["It lies inside the radius of convergence.",
  FontWeight->"Bold"],
 " At ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "63623cef-0d9f-4b75-b8d7-fa30c4f02a9e"],
 " the order parameter is 1.5 to 2 times the radius, which is then the mass \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "de98dc08-0182-498e-b9ff-71e8e91ede80"],
 "; above the reduced temperature of the table (0.35 to 0.42) it is smaller \
than the radius, and near ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8e2bdd6f-7880-4a12-9994-3e65b4f91795"],
 " much smaller. There the series of the free energy in powers of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "984fe925-0d2d-4177-9164-d4e6842652ee"],
 " converges at the minimum, and the Landau coefficients are the Taylor \
coefficients of the free energy: the regime of Landau's theory, which Section \
III.L found absent at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ed9e421b-4070-4760-996b-1d0b27adb4d3"],
 "."
}], "ItemNumbered",ExpressionUUID->"7eff4e64-22d2-4e0a-b93c-4263793369b0"],

Cell[TextData[{
 StyleBox["The Landau form becomes exact.",
  FontWeight->"Bold"],
 " The residual of the Landau form falls from a few tenths of a per cent of \
the depth at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3c5e897b-33b5-4d5a-a22f-cf90db17bb23"],
 " to about ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "3"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c14da592-f44f-4f06-92ed-48498f269cb5"],
 " per cent at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.98", "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f494eb18-8c78-4b5e-805d-62dfbae81430"],
 ", and that of the quartic form (the form of the Higgs potential of the \
Standard Model and of the theory of Ginzburg and Landau) from 3 to 6 per cent \
to about 0.3 per cent; near ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e9bcfdde-1f35-4b6f-8933-96a427f81cc6"],
 " it falls in proportion to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "-", 
    StyleBox["T", "TI"], "/", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b7891a25-cfc3-4e34-8c8f-b0b1aa6a3de0"],
 "."
}], "ItemNumbered",ExpressionUUID->"0c1b0d5e-9bf0-47f5-8184-ae437f0b0151"],

Cell[TextData[{
 StyleBox["Landau's theory predicts the order parameter.",
  FontWeight->"Bold"],
 " Near ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "09d53d0c-13f5-44a7-9cad-27c1eecb9556"],
 " the error of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       StyleBox["a", "TI"]}], "/", "2", 
      StyleBox["b", "TI"]}], ")"}], 
    RowBox[{"1", "/", "2"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "68416ecf-50aa-4e0b-8b23-8e72a147cf3a"],
 " is a fraction (0.19 to 0.28 in the Rust table) of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "-", 
    StyleBox["T", "TI"], "/", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "310940ef-1e44-4332-a70a-47dd0a23245a"],
 ", as Landau's theory requires; the cell above computes it for CJT at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.9", "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["CJT",
       FontSlant->"Plain"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "86b8c97e-e4c0-4cec-88dd-bae20b1d844d"],
 "."
}], "ItemNumbered",ExpressionUUID->"03e9c2b8-500d-46e7-bde2-104f5747e62a"],

Cell[TextData[{
 StyleBox["The scales.",
  FontWeight->"Bold"],
 " Near ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1b9f6db8-745d-4a62-a9d4-0724545b3f93"],
 " the order parameter is small also against the Dirac mass and the cutoff. \
The critical temperatures themselves are about a fifth to a quarter of the \
cutoff (the table above), and the states at the cutoff are occupied by 0.8 to \
1.8 per cent at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.98", "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "24a2d11a-60fd-441b-8235-cd9f92654ac9"],
 ", so the thermal physics reaches the cutoff only weakly. The ratio of the \
gap at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c668c616-a653-4887-b73d-937895ee0fb2"],
 " to ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b08db20d-d724-4901-9411-b6b23dec726e"],
 " is 1.65 to 1.74; the theory of Bardeen, Cooper and Schrieffer gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Pi]", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      SubscriptBox["\[Gamma]", 
       StyleBox["E",
        FontSlant->"Plain"]]}]], "\[LongEqual]", "1.764"}], TraditionalForm]],
   "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6d6ebcb9-67b6-4773-9d31-493cdeed8023"],
 " (with Euler's constant ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", 
     StyleBox["E",
      FontSlant->"Plain"]], "\[LongEqual]", "0.5772"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8250b904-cbd8-4732-9439-2c08311c80cb"],
 ") for weak pairing at a Fermi surface. The ratios are of the same size but \
not equal: here there is no Fermi surface (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Mu]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9394cfde-3b5d-4e0d-84c2-4ea185631348"],
 "), the pairing needs a coupling above a critical one, and the gap contains \
the Dirac mass."
}], "ItemNumbered",ExpressionUUID->"89598a90-d6d7-4ea8-a9c1-a7ca1b5f0298"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
III.T.7 What the free energy of these methods does not contain, and why it \
matters\
\>", "Section",ExpressionUUID->"a99e9314-6a79-41df-9b52-2b667312608c"],

Cell[TextData[{
 StyleBox["The remark.",
  FontWeight->"Bold"],
 " All three methods give mean-field free energies: the thermal state is \
quasi-free, so the free energy contains the thermal quasi-particles of the \
spinor field, but neither the thermal fluctuations of the order parameter \
about its mean value (its amplitude, Goldstone and non-unitary modes) nor \
thermal gauge fields. ",
 StyleBox["Why it holds.",
  FontWeight->"Bold"],
 " A quasi-free state is a state whose correlations of four and more fields \
are fixed by its correlations of two fields (Wick's theorem); the three \
methods choose the best such state, and a fluctuation of the order parameter \
is a correlation of two pairs beyond the product of the pair densities. In HS \
the integral over the auxiliary fields is replaced by its saddle point, in \
CJT the effective action is truncated at the contractions of the contact \
terms in pairs, and in KS the exchange-correlation energy has no thermal part."
}], "Text",ExpressionUUID->"86224633-4b33-49bf-993d-915ec2e52e1b"],

Cell[TextData[{
 StyleBox["Why it matters.",
  FontWeight->"Bold"],
 " Near a continuous transition the fluctuations of the order parameter grow \
without bound. Their size relative to the order parameter is measured by the \
Ginzburg number of the transition (A. P. Levanyuk 1959, V. L. Ginzburg 1960): \
the mean-field free energy is accurate where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "-", 
    StyleBox["T", "TI"], "/", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9915f8dc-1467-48bb-ae44-7d3c99be791e"],
 " is much larger than the Ginzburg number, and it fails within the critical \
region, where it is smaller. For a free energy of the form of Ginzburg and \
Landau in three dimensions, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", 
     StyleBox["GL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      RowBox[{"\[Del]", 
       SubscriptBox["\[Psi]", 
        StyleBox["GL",
         FontSlant->"Plain"]]}], "\[RightBracketingBar]"}], "2"], "+", 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["GL",
      FontSlant->"Plain"], "\[Prime]"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["T", "TI"], "/", 
      SubscriptBox[
       StyleBox["T", "TI"], 
       StyleBox["c",
        FontSlant->"Plain"]], "-", "1"}], ")"}], 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      SubscriptBox["\[Psi]", 
       StyleBox["GL",
        FontSlant->"Plain"]], "\[RightBracketingBar]"}], "2"], "+", 
    FractionBox["1", "2"], 
    SubscriptBox["\[Beta]", 
     StyleBox["GL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      SubscriptBox["\[Psi]", 
       StyleBox["GL",
        FontSlant->"Plain"]], "\[RightBracketingBar]"}], "4"]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "84da59a5-3e70-42f5-b87e-ff85be4accb8"],
 " (the example of Section III.L.2 with the gradient coefficient ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", 
    StyleBox["GL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e14aaeaa-f43a-4edb-ac66-ad1e58d5d0cf"],
 ", the slope ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Alpha]", 
    StyleBox["GL",
     FontSlant->"Plain"], "\[Prime]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3638e0d4-1619-4df7-abdb-4f670b063cf5"],
 " and the critical temperature ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["c",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e4289244-79e1-41dd-90ef-276c6625e9fd"],
 "), the Ginzburg number is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["c",
      FontSlant->"Plain"], "2"], 
    SubsuperscriptBox["\[Beta]", 
     StyleBox["GL",
      FontSlant->"Plain"], "2"], "/", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["\[Alpha]", 
       StyleBox["GL",
        FontSlant->"Plain"], "\[Prime]"], 
      SubsuperscriptBox["\[Gamma]", 
       StyleBox["GL",
        FontSlant->"Plain"], "3"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fd652584-4e3c-40ef-95bd-18cf9e6e8457"],
 " up to a numerical factor that depends on the conventions. Within the \
critical region the order parameter vanishes with an exponent different from ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b8d8ec66-24ad-4ccb-ba71-ac2d4db864e7"],
 " (in three dimensions near 0.33 to 0.37 for the Ising, XY and Heisenberg \
universality classes), the critical temperature is in general lower than the \
mean-field one, and for an order parameter with two quartic invariants, as \
here, the fluctuations can also make the transition discontinuous (the \
renormalization-group theory of such fields is reviewed by A. Pelissetto and \
E. Vicari, 2002). A gauge field coupled to the order parameter can do the \
same: its fluctuations make the transition of a superconductor weakly first \
order (B. I. Halperin, T. C. Lubensky and S.-k. Ma, 1974), and the thermal \
transition of the Higgs field of the electroweak theory, of first order for \
small Higgs masses, ends at a critical Higgs mass, above which there is no \
transition but a smooth crossover (lattice simulations of K. Kajantie, M. \
Laine, K. Rummukainen and M. Shaposhnikov, 1996). The answer of Section \
III.T.6 therefore describes the superfluid near ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "41590fc3-0ed8-4fde-ab4f-f746b56c10d9"],
 " only outside the critical region, and whether the transition of the full \
theory is continuous is not decided here. The size of the critical region \
needs the gradient coefficient of the field at ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8c03dfb3-379c-4be8-b685-506ae0361923"],
 ", which Section III.G computes: the Ginzburg number is 7.6 to 11.4, so that \
the whole range of temperatures of Section III.T.6 where the free energy \
behaves as Landau's theory lies inside the critical region. At ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5294c260-5c75-45a4-bb30-5852615606c2"],
 " the methods omit the quantum fluctuations of the order parameter as well; \
that is a property of the methods, not the subject of this remark."
}], "Text",ExpressionUUID->"8c5de147-0ed5-4860-894a-1875ffd208ba"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Part III, third section. The width of the critical region, and the superfluid \
as a Higgs sector\
\>", "Chapter",ExpressionUUID->"38a7dd35-e85b-4d11-b291-26b64062d70a"],

Cell[TextData[{
 "On 21 November 2026 the author asked to find how wide the region of the \
fluctuations near the critical temperature is, which needs one more \
calculation, the gradient coefficient of the field at the critical \
temperature; then to determine for each of the five methods ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c95a3c13-a874-4cf1-a696-438ca8d8abe7"],
 " (HS ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"1", ",", "1"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "00c0b365-758d-441b-8e21-a0dfaa437c01"],
 ", HS ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "1"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "72f884be-c10a-4451-86e4-5615154d5556"],
 ", HS ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "0"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "19d43a6b-5538-45fd-9cda-8fd7827de464"],
 ", KS and CJT) whether the superfluid can play the role of the Higgs \
particle, and whether the Higgs is really a composite particle. This chapter \
does both with the engines of Part II and of Section III.T, and repeats the \
checks of the Rust program ",
 StyleBox["sf_part3",
  FontFamily->"Source Code Pro"],
 " (modules ",
 StyleBox["ginzburg",
  FontFamily->"Source Code Pro"],
 " and ",
 StyleBox["higgs",
  FontFamily->"Source Code Pro"],
 ") and of the Python program ",
 StyleBox["sf_part3.py",
  FontFamily->"Source Code Pro"],
 ". ",
 StyleBox["The answers.",
  FontWeight->"Bold"],
 " The Ginzburg number is 7.6 to 11.4 (Section III.G.7): the critical region \
is wider than the critical temperature itself, so the mean-field description \
of the five methods holds nowhere near the transition. Every method realizes \
the Higgs mechanism and has a composite neutral scalar below the threshold of \
two quasi-particles, but in no method can it be the Higgs boson that is \
observed (Section III.G.8). Within this model the Higgs field is composite by \
construction."
}], "Text",ExpressionUUID->"21ce7493-7f5e-441c-b70e-05258ea1f401"],

Cell[CellGroupData[{

Cell["\<\
III.G.1 The free energy of Ginzburg and Landau and the Ginzburg number\
\>", "Section",ExpressionUUID->"355f092f-41cb-4d5b-8b84-d2dedb9701b0"],

Cell[TextData[{
 StyleBox["Units.",
  FontWeight->"Bold"],
 " As in Section III.T: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["k", "TI"], 
     StyleBox["B",
      FontSlant->"Plain"]], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "532f1bba-ac51-4911-af35-028380974075"],
 ", the cutoff ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4df6d873-330c-4d0b-980a-bfe3fd3aa629"],
 ", the chemical potential zero. ",
 StyleBox["The field.",
  FontWeight->"Bold"],
 " The field of the superfluid is the complex isospin vector ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["\[CapitalPhi]", "1"], ",", 
      SuperscriptBox["\[CapitalPhi]", "2"], ",", 
      SuperscriptBox["\[CapitalPhi]", "3"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b5a70364-0566-4335-82c1-25faaf13b390"],
 " of the components of the pair self-energy along ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], "\[Iota]"], ")"}], "\[Dagger]"], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a40a26e8-3091-4b22-b7e0-277d778b898d"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[CapitalPhi]", "\[Iota]"], "\[LongEqual]", 
    StyleBox["tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "\[Iota]"], 
      SubscriptBox[
       StyleBox["P",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["SF",
        FontSlant->"Plain"]]}], ")"}], "/", "8"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "07c5a5a1-ae3f-4c9c-b4b2-7c07f329276c"],
 "; it has ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], "\[CapitalPhi]"], "\[LongEqual]", "6"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2540c3c8-54ed-4d1c-8cca-dc06c8504303"],
 " real components, and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
      "\[RightBracketingBar]"}], "2"], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", "\[Iota]",
     LimitsPositioning->True], 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      SuperscriptBox["\[CapitalPhi]", "\[Iota]"], "\[RightBracketingBar]"}], 
     "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f0f7079e-52d9-4b4c-9cbf-b6b9798970a4"],
 ". ",
 StyleBox["The form of Ginzburg and Landau.",
  FontWeight->"Bold"],
 " Near the critical temperature ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2d073844-a1bf-4917-a0f6-19557c565ac3"],
 " the field is small. For a static field that varies slowly in space, the \
free energy of method ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "08cb154f-6ace-4286-ba2a-6127b0fe8f61"],
 " to second order in the field and in its derivatives and to fourth order in \
the field is"
}], "Text",ExpressionUUID->"f07b1bee-a943-4474-a3f1-fb31062a2f7e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalF]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["GL",
      FontSlant->"Plain"]}]], 
   RowBox[{"[", 
    OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "]"}], "\[LongEqual]", "\[Integral]",
    "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["d", "TI"], "3"], 
   StyleBox["x", "TI"], 
   RowBox[{"[", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["c",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      StyleBox["X", "TI"]], "\[ThinSpace]", 
     UnderoverscriptBox["\[Sum]", 
      RowBox[{
       StyleBox["j", "TI"], "\[LongEqual]", "1"}], "3",
      LimitsPositioning->True], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[PartialD]", 
         StyleBox["j", "TI"]], 
        OverscriptBox["\[CapitalPhi]", "\[RightVector]"]}], ")"}], 
      "\[Dagger]"], "\[CenterDot]", 
     SubscriptBox["\[PartialD]", 
      StyleBox["j", "TI"]], 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "+", 
     SubsuperscriptBox[
      StyleBox["a", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["X", "TI"], ",", 
       StyleBox["Tay",
        FontSlant->"Plain"]}]], 
     RowBox[{"(", 
      StyleBox["T", "TI"], ")"}], "\[ThinSpace]", 
     SuperscriptBox[
      RowBox[{"\[LeftBracketingBar]", 
       OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
       "\[RightBracketingBar]"}], "2"], "+", 
     SubsuperscriptBox[
      StyleBox["b", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["X", "TI"], ",", 
       StyleBox["Tay",
        FontSlant->"Plain"]}]], 
     RowBox[{"(", 
      StyleBox["T", "TI"], ")"}], "\[ThinSpace]", 
     SuperscriptBox[
      RowBox[{"\[LeftBracketingBar]", 
       OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
       "\[RightBracketingBar]"}], "4"]}], "]"}], ","}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"5a51044e-6b0d-4de7-a295-4910506ca795"],

Cell[TextData[{
 "with the Taylor coefficients ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["Tay",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f9cb466d-6508-477f-a841-3fcc69c4730b"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["b", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["Tay",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ebba1d88-9df8-4133-a747-b8518d0f846e"],
 " of the free energy at the origin (Section III.T.6), ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["Tay",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}], "\[TildeTilde]", 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["GL",
       FontSlant->"Plain"]}]], 
    SubsuperscriptBox[
     StyleBox["t", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["red",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4c75e361-8340-42fa-bf00-e761e74de79a"],
 " near ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ef701fd3-e3b9-4113-8300-310cf24b250f"],
 ", the reduced temperature ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["t", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["red",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["T", "TI"], "-", 
      SubsuperscriptBox[
       StyleBox["T", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["c",
         FontSlant->"Plain"]}]]}], ")"}], "/", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "15ccf23f-2ee5-48fb-8571-0ecd13f8ed9c"],
 ", the slope ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["GL",
       FontSlant->"Plain"]}]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]], "\[ThinSpace]", 
    SubscriptBox["\[PartialD]", 
     StyleBox["T", "TI"]], 
    SubsuperscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["Tay",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f40d1844-c753-4240-90b3-c108217252d0"],
 " at ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9222f3f9-fda8-48d6-a21c-ed36b83ff751"],
 ", and the ",
 StyleBox["gradient coefficient",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["c",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e64079e7-d9df-499f-aceb-f6d14663a2c1"],
 " at ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "36a5fc9b-6302-4403-9e90-ae480f54298d"],
 ". The rotations and the isospin rotations allow no other term of second \
order, and a term with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "\[CenterDot]", 
    OverscriptBox["\[CapitalPhi]", "\[RightVector]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a4c78f98-d867-4cae-ac09-91c5fd466c4c"],
 " has the fermion number 4 and is not invariant under ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["U", "TI"], 
    SubsuperscriptBox[
     RowBox[{"(", "1", ")"}], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "12f8d01a-44d3-47bc-9a76-9d762b088a96"],
 ". Of the two quartic invariants ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}], "4"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "42845764-167b-4f3b-ab2e-780ac1e58e1c"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     RowBox[{
      OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "\[CenterDot]", 
      OverscriptBox["\[CapitalPhi]", "\[RightVector]"]}], 
     "\[RightBracketingBar]"}], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9adf1e66-29e5-4d96-819c-6340a1da9106"],
 ", which are equal on the polar fields of the minimum, the form keeps the \
coefficient along these fields. ",
 StyleBox["The Ginzburg number.",
  FontWeight->"Bold"],
 " Above ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2694e665-905f-46ab-a794-ff81fa5b008e"],
 " the field fluctuates about zero with the probability density proportional \
to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["exp",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       SubsuperscriptBox[
        StyleBox["\[ScriptCapitalF]",
         FontSlant->"Plain"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["X", "TI"], ",", 
         StyleBox["GL",
          FontSlant->"Plain"]}]]}], "/", 
      StyleBox["T", "TI"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "682956b8-b65a-47fe-a2fe-9e024e8b2173"],
 ". To second order the fluctuations are Gaussian, and their free energy per \
volume is, up to terms analytic in ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d1710cfa-2624-46bf-b5e9-6e7717ada33c"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], 
    SubsuperscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], "\[CapitalPhi]"], 
    StyleBox["T", "TI"], "\[ThinSpace]", "\[Integral]", "\[ThinSpace]", 
    FractionBox[
     RowBox[{
      SuperscriptBox[
       StyleBox["d", "TI"], "3"], 
      StyleBox["k", "TI"]}], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"2", "\[Pi]"}], ")"}], "3"]], "\[ThinSpace]", 
    StyleBox["ln",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["c",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["X", "TI"]], 
      SuperscriptBox[
       StyleBox["k", "TI"], "2"], "+", 
      SubsuperscriptBox[
       StyleBox["a", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["Tay",
         FontSlant->"Plain"]}]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8acabd0a-5b74-4d6e-9d63-ce8008a379ed"],
 ". With ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Integral]", "\[ThinSpace]", 
    FractionBox[
     RowBox[{
      SuperscriptBox[
       StyleBox["d", "TI"], "3"], 
      StyleBox["k", "TI"]}], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"2", "\[Pi]"}], ")"}], "3"]], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       StyleBox["c",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       SuperscriptBox[
        StyleBox["k", "TI"], "2"], "+", 
       StyleBox["a", "TI"]}], ")"}], 
     RowBox[{"-", "2"}]], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"8", "\[Pi]", 
       SuperscriptBox[
        StyleBox["c",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        RowBox[{"3", "/", "2"}]], 
       SuperscriptBox[
        StyleBox["a", "TI"], 
        RowBox[{"1", "/", "2"}]]}], ")"}], 
     RowBox[{"-", "1"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f05ec35b-32aa-47c0-b234-a9b2e7179bd3"],
 " its specific heat per volume, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["C", "TI"], "\[LongEqual]", 
    RowBox[{"-", 
     StyleBox["T", "TI"]}], 
    SubsuperscriptBox["\[PartialD]", 
     StyleBox["T", "TI"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ee513dad-b39b-4fc3-9872-36cffe8bc814"],
 " of the free energy, is near ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5700a343-daf1-41ef-abeb-ecdacaf534eb"]
}], "Text",ExpressionUUID->"6b3d50a1-6fb2-4a0d-b540-d3c51b07f296"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["C", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["fl",
      FontSlant->"Plain"]}]], "\[LongEqual]", 
   FractionBox[
    RowBox[{
     SubsuperscriptBox[
      StyleBox["n", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], "\[CapitalPhi]"], "\[ThinSpace]", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox["\[Alpha]", 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["X", "TI"], ",", 
         StyleBox["GL",
          FontSlant->"Plain"]}]], ")"}], 
      RowBox[{"3", "/", "2"}]]}], 
    RowBox[{"16", "\[Pi]", "\[ThinSpace]", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["c",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        StyleBox["X", "TI"]], ")"}], 
      RowBox[{"3", "/", "2"}]], "\[ThinSpace]", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["t", "TI"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        StyleBox["red",
         FontSlant->"Plain"]], ")"}], 
      RowBox[{"1", "/", "2"}]]}]], ",", "      ", "\[CapitalDelta]", 
   SubsuperscriptBox[
    StyleBox["C", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], "\[LongEqual]", 
   FractionBox[
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[Alpha]", 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["GL",
         FontSlant->"Plain"]}]], ")"}], "2"], 
    RowBox[{"2", "\[ThinSpace]", 
     SubsuperscriptBox[
      StyleBox["b", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["X", "TI"], ",", 
       StyleBox["Tay",
        FontSlant->"Plain"]}]], "\[ThinSpace]", 
     SubsuperscriptBox[
      StyleBox["T", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["X", "TI"], ",", 
       StyleBox["c",
        FontSlant->"Plain"]}]]}]], ","}], TraditionalForm]], "DisplayFormula",\

 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"9dc79cd2-37c8-432a-85ac-e9db2b843c4b"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", 
    SubsuperscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fe7d49af-07c3-4946-9111-274563ab320b"],
 " is the jump of the specific heat of mean-field theory at ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "949d493e-d4c8-4def-956b-a6e6a770512a"],
 " (below it the minimum of the form is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
      "\[RightBracketingBar]"}], "2"], "\[LongEqual]", 
    RowBox[{"-", 
     StyleBox["a", "TI"]}], "/", 
    RowBox[{"(", 
     RowBox[{"2", 
      StyleBox["b", "TI"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "262eefdd-ddca-4461-900e-cfd5528dd7d3"],
 " with the free energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     SuperscriptBox[
      StyleBox["a", "TI"], "2"]}], "/", 
    RowBox[{"(", 
     RowBox[{"4", 
      StyleBox["b", "TI"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "35243e58-7857-4468-8525-4ab8c6e80991"],
 " per volume). Mean-field theory holds where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["fl",
       FontSlant->"Plain"]}]], "\[LessLess]", "\[CapitalDelta]", 
    SubsuperscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f56ed510-311b-4e15-b939-4bb963d9077a"],
 ". The two are equal at the ",
 StyleBox["Ginzburg number",
  FontWeight->"Bold"],
 " (A. P. Levanyuk 1959, V. L. Ginzburg 1960)"
}], "Text",ExpressionUUID->"ccd41c82-012e-478c-805f-a91b6947df41"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["Gi",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], "\[LongEqual]", 
   FractionBox[
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["n", "TI"], 
        StyleBox["SF",
         FontSlant->"Plain"], "\[CapitalPhi]"], ")"}], "2"], "\[ThinSpace]", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["b", "TI"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["X", "TI"], ",", 
         StyleBox["Tay",
          FontSlant->"Plain"]}]], ")"}], "2"], "\[ThinSpace]", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["T", "TI"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["X", "TI"], ",", 
         StyleBox["c",
          FontSlant->"Plain"]}]], ")"}], "2"]}], 
    RowBox[{"64", 
     SuperscriptBox["\[Pi]", "2"], "\[ThinSpace]", 
     SubsuperscriptBox["\[Alpha]", 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["X", "TI"], ",", 
       StyleBox["GL",
        FontSlant->"Plain"]}]], "\[ThinSpace]", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["c",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        StyleBox["X", "TI"]], ")"}], "3"]}]], "\[LongEqual]", 
   FractionBox[
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["n", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], "\[CapitalPhi]"], ")"}], "2"], 
    RowBox[{"256", 
     SuperscriptBox["\[Pi]", "2"], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"\[CapitalDelta]", 
        SubsuperscriptBox[
         StyleBox["C", "TI"], 
         StyleBox["SF",
          FontSlant->"Plain"], 
         StyleBox["X", "TI"]], 
        SuperscriptBox[
         RowBox[{"(", 
          SubsuperscriptBox["\[Xi]", 
           StyleBox["SF",
            FontSlant->"Plain"], 
           RowBox[{
            StyleBox["X", "TI"], ",", 
            StyleBox["GL",
             FontSlant->"Plain"]}]], ")"}], "3"]}], ")"}], "2"]}]], ",", 
   "      ", 
   SubsuperscriptBox["\[Xi]", 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["GL",
      FontSlant->"Plain"]}]], "\[LongEqual]", 
   SuperscriptBox[
    RowBox[{"(", 
     FractionBox[
      SubsuperscriptBox[
       StyleBox["c",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["X", "TI"]], 
      SubsuperscriptBox["\[Alpha]", 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["GL",
         FontSlant->"Plain"]}]]], ")"}], 
    RowBox[{"1", "/", "2"}]], "."}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"c99466ea-3f6d-428e-978e-03e0f9cd9c4a"],

Cell[TextData[{
 "Mean-field theory holds for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftBracketingBar]", 
     SubsuperscriptBox[
      StyleBox["t", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      StyleBox["red",
       FontSlant->"Plain"]], "\[RightBracketingBar]"}], "\[GreaterGreater]", 
    SubsuperscriptBox[
     StyleBox["Gi",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "781a975c-c821-4c9f-970a-092e339b5d8c"],
 ", and the critical region, where it fails, has the width of about ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["Gi",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "709d8ba3-1569-4cfe-a521-bd44c6276e83"],
 " on both sides of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e9668850-7c1e-4f4f-8a02-a36e0162d487"],
 ". The second form shows the meaning: the correlation length of mean-field \
theory is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Xi]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["GL",
       FontSlant->"Plain"]}]], 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      SubsuperscriptBox[
       StyleBox["t", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["red",
        FontSlant->"Plain"]], "\[RightBracketingBar]"}], 
     RowBox[{
      RowBox[{"-", "1"}], "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a9ed6d73-a5e4-45f6-918d-382baff8761c"],
 ", and mean-field theory needs many degrees of freedom in a correlation \
volume, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", 
    SubsuperscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[Xi]", 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["GL",
         FontSlant->"Plain"]}]], ")"}], "3"], "\[GreaterGreater]", "1"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "71ac64d7-c520-4630-aab0-77d227246ebb"],
 ". ",
 StyleBox["A remark on the factors (what it means and why it matters).",
  FontWeight->"Bold"],
 " Other forms of the criterion (the mean square fluctuation of the field in \
a correlation volume against the square of its mean value, or the first \
correction to ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["b", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["Tay",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7fba4be4-9a2e-4588-910e-8cad69adf1c0"],
 " against ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["b", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["Tay",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0db6e3c1-ea65-4048-ba9a-c949abdf2f59"],
 ") give the same combination of ",
 Cell[BoxData[
  FormBox["\[Alpha]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d50fea1b-bf31-4992-ae23-5c6e5581d30e"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["b", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d6ae2975-72f2-4ab0-9339-2ed6064758ec"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["c",
    FontFamily->"Helvetica",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d769fb77-a0e5-44f1-8efc-4af47f21d7b1"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["c",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1d1f6635-f3f2-4431-930c-ab0d8dfbd181"],
 " with other numerical factors of order one, and books on the subject differ \
by such factors. The formula above is the definition used here. It matters \
only when the number is near 1; the numbers found below are far above 1, so a \
factor of order one does not change the conclusion."
}], "Text",ExpressionUUID->"b06a177f-7548-4cbe-b118-61491b21286c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
III.G.2 The coefficient of the field of a moving pair: the static pair \
response\
\>", "Section",ExpressionUUID->"5aacbfe9-5d18-4e35-896e-94000d17e6e4"],

Cell[TextData[{
 "A pair field with the momentum ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["q", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["pair",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0a2395ef-4af9-4054-8d63-189c8f9e3f77"],
 " along ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox[
     StyleBox["e", "TI"], "\[RightVector]"], "3"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b510816b-f41e-4cf4-a298-44cd53fa5c1e"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
    RowBox[{"(", 
     OverscriptBox[
      StyleBox["x", "TI"], "\[RightVector]"], ")"}], "\[LongEqual]", 
    OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "\[ThinSpace]", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      StyleBox["i", "TI"], 
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["pair",
        FontSlant->"Plain"]], 
      SuperscriptBox[
       StyleBox["x", "TI"], "3"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "23eff65e-151a-4e95-8dcf-ee19872a6191"],
 ", has the gradient term ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["c",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["pair",
        FontSlant->"Plain"]], ")"}], "2"], 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
      "\[RightBracketingBar]"}], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9bef0f0c-7844-43d8-ada0-ade47beeff83"],
 ", so its coefficient of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "95c18cda-270c-4ee0-97cc-9bd93e160d5a"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["Tay",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["pair",
        FontSlant->"Plain"]], ";", 
      StyleBox["T", "TI"]}], ")"}], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["Tay",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}], "+", 
    SubsuperscriptBox[
     StyleBox["c",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["pair",
        FontSlant->"Plain"]], ")"}], "2"], "+", 
    StyleBox["O", "TI"], 
    RowBox[{"(", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["q", "TI"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        StyleBox["pair",
         FontSlant->"Plain"]], ")"}], "4"], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "db9f693b-b805-463e-8a6c-6620e5eedc50"],
 ". The state of a moving pair pairs the momenta ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     StyleBox["q", "TI"], "\[RightVector]"], "+", 
    FractionBox["1", "2"], 
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["pair",
      FontSlant->"Plain"]], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["e", "TI"], "\[RightVector]"], "3"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b8c53506-9bbf-432a-ad6c-4e7590aa9a93"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     OverscriptBox[
      StyleBox["q", "TI"], "\[RightVector]"]}], "+", 
    FractionBox["1", "2"], 
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["pair",
      FontSlant->"Plain"]], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["e", "TI"], "\[RightVector]"], "3"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "61f84464-eddc-46ad-af5a-d1f3f7e0c244"],
 " (relative momentum ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["q", "TI"], "\[RightVector]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a367f27e-d02c-4f18-9421-f988747b7213"],
 "). After the gauge transformation ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPsi]", "\[RightArrow]", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      StyleBox["i", "TI"], 
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["pair",
        FontSlant->"Plain"]], 
      SuperscriptBox[
       StyleBox["x", "TI"], "3"], "/", "2"}]], "\[CapitalPsi]"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e0114611-d741-419e-bd29-bf835debc7dc"],
 ", which makes the pair field uniform, it is the thermal state of the matrix \
of Bogoliubov and de Gennes (Section II.2) with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["h",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     RowBox[{"\[PlusMinus]", 
      OverscriptBox[
       StyleBox["q", "TI"], "\[RightVector]"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c6cfc25b-be61-4269-b3c4-f874055d54d4"],
 " replaced by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["h",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     RowBox[{"\[PlusMinus]", 
      OverscriptBox[
       StyleBox["q", "TI"], "\[RightVector]"]}], ")"}], "+", 
    SubsuperscriptBox[
     StyleBox["T",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["tw",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d0dbdf0c-daa2-4416-9669-5611e4fca00e"],
 ", the ",
 StyleBox["twist",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["T",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["tw",
      FontSlant->"Plain"]], "\[LongEqual]", 
    FractionBox["1", "2"], 
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["pair",
      FontSlant->"Plain"]], "\[ThinSpace]", 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], "3"], "\[CircleTimes]", 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9eb0995a-d323-4ddd-97c5-d67a0207fc2f"],
 ", with the normal self-energy ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["N",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["n",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "58009aca-8429-467d-9f92-0320f1690cf3"],
 " of the normal state at ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c0f69507-e1ac-4060-9733-2a72a0513cf5"],
 " (a change of the normal self-energy changes the free energy only at fourth \
order in the field, because the free energy is stationary in it) and with a \
small antisymmetric pair block ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["P",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["a",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7fc8038a-2826-4fcd-8ded-30d0aa54ae03"],
 ". To first order in ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["P",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["a",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "64470b4b-9f6e-42cc-b0f8-1c39813d7498"],
 " the pair matrix summed over the momenta, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["C",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["p",
       FontSlant->"Plain"], ",", 
      StyleBox["tot",
       FontSlant->"Plain"]}]], "\[LongEqual]", "\[Integral]", "\[ThinSpace]", 
    
    FractionBox[
     RowBox[{
      SuperscriptBox[
       StyleBox["d", "TI"], "3"], 
      StyleBox["q", "TI"]}], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"2", "\[Pi]"}], ")"}], "3"]], 
    SubsuperscriptBox[
     StyleBox["C",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     OverscriptBox[
      StyleBox["q", "TI"], "\[RightVector]"], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8cde720e-e5a6-4eb2-be25-d28a780899ac"],
 ", is the ",
 StyleBox["static pair response",
  FontWeight->"Bold"]
}], "Text",ExpressionUUID->"6bb45b89-8e28-4500-834f-d561dfee85bd"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["C",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["p",
      FontSlant->"Plain"], ",", 
     StyleBox["tot",
      FontSlant->"Plain"]}]], "\[LongEqual]", 
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalX]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["P",
     FontSlant->"Plain"]], 
   RowBox[{"[", 
    SubsuperscriptBox[
     StyleBox["P",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["a",
      FontSlant->"Plain"]], "]"}], "\[LongEqual]", 
   RowBox[{"-", "\[Integral]"}], "\[ThinSpace]", 
   FractionBox[
    RowBox[{
     SuperscriptBox[
      StyleBox["d", "TI"], "3"], 
     StyleBox["q", "TI"]}], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"2", "\[Pi]"}], ")"}], "3"]], "\[ThinSpace]", 
   UnderoverscriptBox["\[Sum]", 
    RowBox[{
     StyleBox["a", "TI"], ",", 
     StyleBox["b", "TI"], "\[LongEqual]", "1"}], "8",
    LimitsPositioning->True], "\[ThinSpace]", 
   FractionBox[
    RowBox[{
     StyleBox["f", "TI"], 
     RowBox[{"(", 
      SubsuperscriptBox["\[CurlyEpsilon]", 
       RowBox[{
        StyleBox["SF",
         FontSlant->"Plain"], ",", 
        StyleBox["a", "TI"]}], 
       StyleBox["A",
        FontSlant->"Plain"]], ")"}], "-", 
     StyleBox["f", "TI"], 
     RowBox[{"(", 
      SubsuperscriptBox["\[CurlyEpsilon]", 
       RowBox[{
        StyleBox["SF",
         FontSlant->"Plain"], ",", 
        StyleBox["b", "TI"]}], 
       StyleBox["D",
        FontSlant->"Plain"]], ")"}]}], 
    RowBox[{
     SubsuperscriptBox["\[CurlyEpsilon]", 
      RowBox[{
       StyleBox["SF",
        FontSlant->"Plain"], ",", 
       StyleBox["a", "TI"]}], 
      StyleBox["A",
       FontSlant->"Plain"]], "-", 
     SubsuperscriptBox["\[CurlyEpsilon]", 
      RowBox[{
       StyleBox["SF",
        FontSlant->"Plain"], ",", 
       StyleBox["b", "TI"]}], 
      StyleBox["D",
       FontSlant->"Plain"]]}]], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["u",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["a", "TI"]}]], 
   SubsuperscriptBox[
    StyleBox["u",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["a", "TI"]}], "\[Dagger]"], "\[ThinSpace]", 
   SubsuperscriptBox[
    StyleBox["P",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["a",
     FontSlant->"Plain"]], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["w",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["b", "TI"]}]], 
   SubsuperscriptBox[
    StyleBox["w",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["b", "TI"]}], "\[Dagger]"], ","}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"646432e4-874e-4a06-a067-919f10f7a26d"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CurlyEpsilon]", 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["a", "TI"]}], 
    StyleBox["A",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cef80526-b01a-44bd-a222-ac4fd61ce221"],
 " and the normalized eigenvectors ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["u",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["a", "TI"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d3ea29cc-49b9-4c42-9bce-bb3d5ef68fc2"],
 " are those of the particle block ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["h",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     OverscriptBox[
      StyleBox["q", "TI"], "\[RightVector]"], ")"}], "+", 
    SubsuperscriptBox[
     StyleBox["N",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["n",
      FontSlant->"Plain"]], "+", 
    SubsuperscriptBox[
     StyleBox["T",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["tw",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "db2b0598-fe48-45e6-b8d2-b959b4bf244c"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CurlyEpsilon]", 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["b", "TI"]}], 
    StyleBox["D",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a174b9cf-76c1-454b-9f67-ed4e4fa80680"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["w",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["b", "TI"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d6d4a077-d9de-41aa-b3c3-2ab8b064f1be"],
 " those of the hole block ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["h",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["LL",
         FontSlant->"Plain"]], 
       RowBox[{"(", 
        RowBox[{"-", 
         OverscriptBox[
          StyleBox["q", "TI"], "\[RightVector]"]}], ")"}], "+", 
       SubsuperscriptBox[
        StyleBox["N",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        StyleBox["n",
         FontSlant->"Plain"]], "+", 
       SubsuperscriptBox[
        StyleBox["T",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        StyleBox["tw",
         FontSlant->"Plain"]]}], ")"}], 
     StyleBox["T", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "44a1076b-8ced-43a0-bcb7-96a82e3d4d39"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["f", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "41efb3ea-619b-40a9-96b7-9444b387cfe6"],
 " is the Fermi function, and the quotient is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["f", "TI"], "\[Prime]"], 
    RowBox[{"(", "\[CurlyEpsilon]", ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7a194a35-4e4b-4ca3-b2ae-e8b51d4b2449"],
 " where the two energies coincide (the first-order term of the function ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["f", "TI"], 
    RowBox[{"(", 
     SubscriptBox[
      StyleBox["H",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["SF",
       FontSlant->"Plain"]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ee3e5ac4-07dc-43d2-8ea1-1e5bf7301bb8"],
 " of a Hermitian matrix in its off-diagonal block). The free energy of the \
state, measured from the normal state at ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dbda8a65-76f9-419b-a617-6c21cada9024"],
 ", is to second order"
}], "Text",ExpressionUUID->"21dbcd24-7ad9-4b6d-ab40-667b25642165"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalF]",
     FontSlant->"Plain"], 
    RowBox[{"2", ",", 
     StyleBox["SF",
      FontSlant->"Plain"]}], 
    StyleBox["X", "TI"]], "\[LongEqual]", 
   FractionBox["1", "2"], "\[ThinSpace]", 
   StyleBox["Re",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["tr",
    FontSlant->"Plain"], 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["P",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        StyleBox["a",
         FontSlant->"Plain"]], "-", 
       SubscriptBox[
        StyleBox["P",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["SF",
         FontSlant->"Plain"]], 
       RowBox[{"[", 
        SubsuperscriptBox[
         StyleBox["C",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], 
         StyleBox["SF",
          FontSlant->"Plain"], 
         RowBox[{
          StyleBox["p",
           FontSlant->"Plain"], ",", 
          StyleBox["tot",
           FontSlant->"Plain"]}]], "]"}]}], ")"}], 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["C",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["p",
          FontSlant->"Plain"], ",", 
         StyleBox["tot",
          FontSlant->"Plain"]}]], ")"}], "\[Dagger]"]}], ")"}], ","}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"c1f6362a-88a7-42d6-bbcb-36ebb1856d47"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["P",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"]], 
    RowBox[{"[", 
     SubsuperscriptBox[
      StyleBox["C",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["p",
        FontSlant->"Plain"], ",", 
       StyleBox["tot",
        FontSlant->"Plain"]}]], "]"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "444840ab-7953-41d9-a112-75093c84995c"],
 " is the pair self-energy of method ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "255e7dd5-fe17-4a6b-81db-84b81eb88c60"],
 " for the pair matrix ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["C",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["p",
      FontSlant->"Plain"], ",", 
     StyleBox["tot",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7e8676e3-e337-46ab-8d0a-28de9b1fa161"],
 " (Section II.2; linear in it, and it contains every pair channel of the \
method, not only the channels ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7fcba661-b3ff-4503-9834-21a9ca46db29"],
 "). ",
 StyleBox["Derivation.",
  FontWeight->"Bold"],
 " The expectation value of the pair term of the BdG Hamiltonian is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     StyleBox["V", "TI"], "\[RightAngleBracket]"}], "\[LongEqual]", 
    RowBox[{"-", 
     StyleBox["Re",
      FontSlant->"Plain"]}], "\[ThinSpace]", 
    StyleBox["tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["P",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["a",
        FontSlant->"Plain"]], 
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox[
         StyleBox["C",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], 
         StyleBox["SF",
          FontSlant->"Plain"], 
         RowBox[{
          StyleBox["p",
           FontSlant->"Plain"], ",", 
          StyleBox["tot",
           FontSlant->"Plain"]}]], ")"}], "\[Dagger]"]}], ")"}]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7f18f7a3-db66-463f-b0b0-d2e1ab8ef23b"],
 "; the thermal state of the Hamiltonian with the pair term has the \
thermodynamic potential ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{"\[LeftAngleBracket]", 
     StyleBox["V", "TI"], "\[RightAngleBracket]"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5f2c3805-74eb-47c7-bf17-00b4ebd9e850"],
 " below that of the normal state (second-order perturbation theory); the \
free energy of the method contains this potential minus ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftAngleBracket]", 
    StyleBox["V", "TI"], "\[RightAngleBracket]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ded4d5ed-71ef-4268-88b8-97cab6946918"],
 " (the pair term is not part of the Hamiltonian of the model) plus the pair \
part of the interaction energy, which is quadratic in the pair matrix and \
equals ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", "2"]}], 
    StyleBox["Re",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["P",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["SF",
        FontSlant->"Plain"]], 
      RowBox[{"[", 
       SubsuperscriptBox[
        StyleBox["C",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["p",
          FontSlant->"Plain"], ",", 
         StyleBox["tot",
          FontSlant->"Plain"]}]], "]"}], 
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox[
         StyleBox["C",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], 
         StyleBox["SF",
          FontSlant->"Plain"], 
         RowBox[{
          StyleBox["p",
           FontSlant->"Plain"], ",", 
          StyleBox["tot",
           FontSlant->"Plain"]}]], ")"}], "\[Dagger]"]}], ")"}]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6f4bc14a-a3c8-4779-91ef-37b46d8f6faa"],
 "; the sum is the formula above. The field of the state is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[CapitalPhi]", "3"], "\[LongEqual]", 
    StyleBox["tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], 
      SubscriptBox[
       StyleBox["P",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["SF",
        FontSlant->"Plain"]], 
      RowBox[{"[", 
       SubsuperscriptBox[
        StyleBox["C",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["p",
          FontSlant->"Plain"], ",", 
         StyleBox["tot",
          FontSlant->"Plain"]}]], "]"}]}], ")"}], "/", "8"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0a9f6cc8-523f-440b-bca9-6d6f765dcbac"],
 ". The free energy of the field is the smallest ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalF]",
     FontSlant->"Plain"], 
    RowBox[{"2", ",", 
     StyleBox["SF",
      FontSlant->"Plain"]}], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "59515884-39fc-4eee-a2cb-8548c2285756"],
 " among the states with this field: the components of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["P",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["a",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2b92c353-22f3-4f5a-b8a8-1671742ab28c"],
 " along ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], "1"], ")"}], "\[Dagger]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "eefdd45d-7784-4d0e-8ba9-1e7f9268fc20"],
 ", ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], "2"], ")"}], "\[Dagger]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c8fa358b-d25c-4487-9e2b-b6d48f75b3b6"],
 ", ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d0ffbd46-fbf0-4e68-89ac-a11b629375a4"],
 " are held at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "0", ",", "1"}], ")"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a4277fad-1509-4665-8a50-ac0caae4cedc"],
 ", and its components along the other 25 antisymmetric matrices are made \
self-consistent (a linear system of 25 complex unknowns: the stationarity of \
the free energy with a Lagrange multiplier for the field). Then ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["Tay",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["pair",
        FontSlant->"Plain"]], ";", 
      StyleBox["T", "TI"]}], ")"}], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalF]",
      FontSlant->"Plain"], 
     RowBox[{"2", ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]], "/", 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      SuperscriptBox["\[CapitalPhi]", "3"], "\[RightBracketingBar]"}], "2"]}],
    TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2b936e3f-5415-436b-8d6b-f057077a64be"],
 ". At ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["pair",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4aa2499d-831f-4714-ba27-08ebcc157467"],
 " and in the channel ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7e0906c6-fc22-4418-83a4-f220b9dc4c8a"],
 " alone this is"
}], "Text",ExpressionUUID->"6cb61a7b-215f-4f49-b857-90afaeb8d063"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["Tay",
      FontSlant->"Plain"]}]], 
   RowBox[{"(", 
    RowBox[{"0", ";", 
     StyleBox["T", "TI"]}], ")"}], "\[LongEqual]", 
   FractionBox[
    RowBox[{"1", "-", 
     SubsuperscriptBox["\[Lambda]", 
      StyleBox["SF",
       FontSlant->"Plain"], 
      StyleBox["P",
       FontSlant->"Plain"]], 
     RowBox[{"(", 
      StyleBox["T", "TI"], ")"}]}], 
    RowBox[{
     SubsuperscriptBox["\[Lambda]", 
      StyleBox["SF",
       FontSlant->"Plain"], 
      StyleBox["P",
       FontSlant->"Plain"]], 
     RowBox[{"(", 
      StyleBox["T", "TI"], ")"}], "\[ThinSpace]", 
     SubsuperscriptBox[
      StyleBox["g", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["X", "TI"], ",", 
       StyleBox["P",
        FontSlant->"Plain"]}]]}]], ","}], TraditionalForm]], "DisplayFormula",\

 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"f42dc1b1-4b18-4186-b9e3-6e98e7933536"],

Cell[TextData[{
 "with the eigenvalue ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Lambda]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["P",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7c781b1b-ea45-46a9-ae2b-ed9e9aee9691"],
 " of Section III.T.4: the applied block ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7ba91957-5d12-4caa-bed2-0b1d0294b08c"],
 " produces the field ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[CapitalPhi]", "3"], "\[LongEqual]", 
    SubsuperscriptBox["\[Lambda]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["P",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8c89ee86-1415-4cc8-ad33-1b700d27e4ef"],
 ", and the formula for ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalF]",
     FontSlant->"Plain"], 
    RowBox[{"2", ",", 
     StyleBox["SF",
      FontSlant->"Plain"]}], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "af775116-7748-45ee-8bfd-69b330199576"],
 " gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      SubsuperscriptBox["\[Lambda]", 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["P",
        FontSlant->"Plain"]]}], ")"}], "\[CenterDot]", "2", 
    SubsuperscriptBox["\[Lambda]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["P",
      FontSlant->"Plain"]], "/", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["P",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "58bc1ff5-a26f-43b2-ba2c-9eb916ece017"],
 ". Hence the slope in closed form, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["GL",
       FontSlant->"Plain"]}]], "\[LongEqual]", 
    RowBox[{"-", 
     SubsuperscriptBox[
      StyleBox["T", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["X", "TI"], ",", 
       StyleBox["c",
        FontSlant->"Plain"]}]]}], "\[ThinSpace]", 
    SubscriptBox["\[PartialD]", 
     StyleBox["T", "TI"]], 
    SubsuperscriptBox["\[Lambda]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["P",
      FontSlant->"Plain"]], "/", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[Lambda]", 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["P",
        FontSlant->"Plain"]], ")"}], "2"], 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["P",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3332e79e-71d0-4e00-95e5-948e224c6b90"],
 " at ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "747961dd-737b-41a8-9762-df58e6d04faf"],
 ". ",
 StyleBox["The engine.",
  FontWeight->"Bold"],
 " The next cell defines the static pair response on any set of momenta with \
weights, the quadratic free energy of the field, the normal self-energy at ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "590f812f-e8a2-4900-a536-4e268f7e360e"],
 ", and the coefficient for a twist ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["q", "TI"], "\[ThinSpace]", 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], "3"], "\[CircleTimes]", 
    StyleBox["t",
     FontFamily->"Helvetica",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ba28cdcd-4cf7-4669-a976-43edbf936a30"],
 " with an isospin matrix ",
 Cell[BoxData[
  FormBox[
   StyleBox["t",
    FontFamily->"Helvetica",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ec1b2823-cac1-4409-a7ab-96c0aff7dc81"],
 ": ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["t",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b55056db-e535-4270-8a23-26e7e288a84d"],
 " moves the pair (fermion number 2) with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["pair",
      FontSlant->"Plain"]], "\[LongEqual]", "2", 
    StyleBox["q", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "75fcbc12-20e4-4113-ada7-37802e2278f9"],
 "; ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["t",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "\[LongEqual]", 
    FractionBox["1", "2"], 
    SubscriptBox["\[Tau]", "1"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a31988dd-4142-4ab9-876d-ebff54c8b050"],
 " turns the isospin direction of the field (its components of charge ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7af886bd-7e79-4a81-b0d6-7721b400d525"],
 " of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "1"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0d77161f-ad38-4e8f-9083-569883ea6ebc"],
 " get the momenta ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    StyleBox["q", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1cd6f7dd-3de9-4bd8-b2e4-f38760aae242"],
 "), and must give the same coefficient by the isospin invariance of the form."
}], "Text",ExpressionUUID->"528eb174-6985-47a0-9497-564d0dee95d6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"--", " ", "the"}]}], " ", "static", " ", "pair", " ", 
    "response", " ", "and", " ", "the", " ", "quadratic", " ", "free", " ", 
    "energy", " ", "of", " ", "a", " ", "field", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"Section", " ", 
        RowBox[{"III", ".", "G"}], ".2"}], ")"}], " ", "--"}], "--"}]}], " ", 
   "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"gzPairs", ":", " ", 
     RowBox[{"the", " ", "28", " ", "index", " ", "pairs", " ", 
      RowBox[{"{", 
       RowBox[{"a", ",", " ", "b"}], "}"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"a", " ", "<", " ", "b"}], ";", " ", 
     RowBox[{"gzBasis", ":", " ", 
      RowBox[{
       RowBox[{
       "the", " ", "antisymmetric", " ", "basis", " ", "matrices", " ", 
        "E_ab"}], " ", "-", " ", "E_ba"}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"gzPairs", " ", "=", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"a", ",", " ", "b"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"a", ",", " ", "8"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"b", ",", " ", 
           RowBox[{"a", " ", "+", " ", "1"}], ",", " ", "8"}], "}"}]}], "]"}],
        ",", " ", "1"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gzBasis", " ", "=", " ", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{"pr", ",", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Which", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{"i", ",", " ", "j"}], "}"}], " ", "==", " ", "pr"}], ",",
              " ", "1.", ",", " ", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"j", ",", " ", "i"}], "}"}], " ", "==", " ", "pr"}], ",",
              " ", 
             RowBox[{"-", "1."}], ",", " ", "True", ",", " ", "0."}], "]"}], ",",
            " ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "8"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"j", ",", " ", "8"}], "}"}]}], "]"}]}], "]"}], ",", " ", 
       "gzPairs"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"gzCoeffs", "[", "p", "]"}], ":", " ", 
      RowBox[{
      "the", " ", "coefficients", " ", "of", " ", "an", " ", "antisymmetric", 
       " ", "matrix", " ", "in", " ", "this", " ", "basis", " ", 
       RowBox[{"(", 
        RowBox[{
        "its", " ", "entries", " ", "above", " ", "the", " ", "diagonal"}], 
        ")"}]}]}], ";", "\n", "   ", 
     RowBox[{
      RowBox[{"gzFromCoeffs", "[", "v", "]"}], ":", " ", 
      RowBox[{
      "the", " ", "antisymmetric", " ", "matrix", " ", "of", " ", "the", " ", 
       "coefficients", " ", "v"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"gzCoeffs", "[", "p_", "]"}], " ", ":=", " ", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"p", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}], " ", "&"}], ",", 
