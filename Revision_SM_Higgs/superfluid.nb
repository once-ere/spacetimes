unit coupling squared: zeugon W^3 0.03573178317, B -0.1429271327 = Rust\"\>", 
   "\[InvisibleSpace]", "\<\"   [the same check: Rust \"\>", 
   "\[InvisibleSpace]", "\<\"P2-8c, P2-8d\"\>", 
   "\[InvisibleSpace]", "\<\", Python \"\>", 
   "\[InvisibleSpace]", "\<\"YP2-8c\"\>", "\[InvisibleSpace]", "\<\"]\"\>"}],
  SequenceForm[
  "PASS ", "WP2-8c", "  deviation ", "5.919e-12", " (tolerance ", "1.000e-9", 
   "): ", "the Thouless eigenvalues of the exchange per unit coupling \
squared: zeugon W^3 0.03573178317, B -0.1429271327 = Rust", 
   "   [the same check: Rust ", "P2-8c, P2-8d", ", Python ", "YP2-8c", "]"],
  Editable->False]], "Print",
 CellChangeTimes->{4.004330800932778*^9},
 CellLabel->
  "During evaluation of \
In[267]:=",ExpressionUUID->"cb8b9a63-f2da-4c80-84aa-4ae8461a23e9"]
}, Open  ]],

Cell[TextData[{
 "The zeugon attracts the condensed pair (positive eigenvalue) and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b3f16b36-b892-4db8-be54-608eb8dc5e10"],
 " repels it four times as strongly. ",
 StyleBox["CJT with the exchange.",
  FontWeight->"Bold"],
 " The last cell of Part II makes the CJT state of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "2", ")"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2ef3dff6-bb6f-4259-ab3a-7bdc8cef4503"],
 " self-consistent with the exchange of all four gauge bosons added to the \
contact terms: the self-energies now depend on the momentum, and the matrix \
of Bogoliubov and de Gennes at the momentum ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["q", "TI"], "\[RightVector]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1426a930-4e92-454e-a2f0-c80336807055"],
 " contains the exchange self-energies at ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["q", "TI"], "\[RightVector]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c36a89d4-f7b9-426e-a0d4-fa9f70fc5eee"],
 " (and at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    OverscriptBox[
     StyleBox["q", "TI"], "\[RightVector]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a75b0896-cb14-4ffc-bd32-df2cf936038a"],
 " in its lower block). The boson masses are those of the Rust program, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["M", "TI"], 
    StyleBox["W", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f33b4923-f0f1-4439-9311-57afa698ad55"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["M", "TI"], 
    StyleBox["Z", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f4f6c03f-5db9-4292-9d89-d8978ac5451b"],
 " of this state and a massless zeugon; the iteration mixes one half of the \
new self-energies until they change by less than ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "11"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ea5421e2-d8a6-4750-bb41-a96ac151f582"],
 ". The superfluid survives, and the energy agrees with the Rust value."
}], "Text",ExpressionUUID->"af401791-1bfb-426d-8262-074f1566197f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
     "CJT", " ", "with", " ", "the", " ", "exchange", " ", "of", " ", "the", " ",
       "four", " ", "gauge", " ", "bosons", " ", "at", " ", "g_v"}], " ", "=",
      " ", "0.7"}], ",", " ", 
    RowBox[{"g_F", " ", "=", " ", "0.45"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "mo", ",", " ", "s", ",", " ", "bos", ",", " ", "nc", ",", " ", "pc", ",",
        " ", "nex", ",", " ", "pex", ",", " ", 
       RowBox[{"it", " ", "=", " ", "0"}], ",", " ", 
       RowBox[{"res", " ", "=", " ", "1."}], ",", " ", "cn", ",", " ", "cp", ",",
        " ", "ev", ",", " ", "rho", ",", " ", "kap", ",", " ", "ek", ",", " ",
        "ei", ",", " ", "n2", ",", " ", "p2", ",", " ", "n3", ",", " ", "p3", 
       ",", " ", "eex", ",", " ", "masses"}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"mo", ",", " ", "s"}], "}"}], " ", "=", " ", 
       RowBox[{"groundSF", "[", "\"\<V2_CJT\>\"", "]"}]}], ";", "\n", "  ", 
      RowBox[{"masses", " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"rustPart2", "[", "\"\<p2_cjtex_M_W\>\"", "]"}], ",", " ", 
         RowBox[{"rustPart2", "[", "\"\<p2_cjtex_M_W\>\"", "]"}], ",", " ", 
         "0.", ",", " ", 
         RowBox[{"rustPart2", "[", "\"\<p2_cjtex_M_Z\>\"", "]"}]}], "}"}]}], ";",
       "\n", "  ", 
      RowBox[{"bos", " ", "=", " ", 
       RowBox[{"makeBosons", "[", 
        RowBox[{
         RowBox[{"mo", "[", "\"\<g\>\"", "]"}], ",", " ", "gvLL", ",", " ", 
         "gfLL", ",", " ", "masses"}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"nc", " ", "=", " ", 
       RowBox[{"s", "[", "\"\<n\>\"", "]"}]}], ";", " ", 
      RowBox[{"pc", " ", "=", " ", 
       RowBox[{"s", "[", "\"\<p\>\"", "]"}]}], ";", "\n", "  ", 
      RowBox[{"nex", " ", "=", " ", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"zero8", ",", " ", 
         RowBox[{
          RowBox[{"mo", "[", "\"\<g\>\"", "]"}], "[", "\"\<n\>\"", "]"}]}], 
        "]"}]}], ";", " ", 
      RowBox[{"pex", " ", "=", " ", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"zero8", ",", " ", 
         RowBox[{
          RowBox[{"mo", "[", "\"\<g\>\"", "]"}], "[", "\"\<n\>\"", "]"}]}], 
        "]"}]}], ";", "\n", "  ", 
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"res", " ", ">=", " ", 
          RowBox[{"10", "^", 
           RowBox[{"-", "11"}]}]}], " ", "&&", " ", 
         RowBox[{"it", " ", "<", " ", "20000"}]}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"cn", ",", " ", "cp", ",", " ", "ev"}], "}"}], " ", "=", 
          " ", 
          RowBox[{"states", "[", 
           RowBox[{"bdg", "[", 
            RowBox[{
            "mo", ",", " ", "nc", ",", " ", "pc", ",", " ", "nex", ",", " ", 
             "pex"}], "]"}], "]"}]}], ";", "\n", "   ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"rho", ",", " ", "kap", ",", " ", "ek"}], "}"}], " ", "=", 
          " ", 
          RowBox[{"localDens", "[", 
           RowBox[{"mo", ",", " ", "cn", ",", " ", "cp"}], "]"}]}], ";", "\n",
          "   ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ei", ",", " ", "n2", ",", " ", "p2"}], "}"}], " ", "=", 
          " ", 
          RowBox[{"interaction", "[", 
           RowBox[{
            RowBox[{"mo", "[", "\"\<ts\>\"", "]"}], ",", " ", "rho", ",", " ",
             "kap"}], "]"}]}], ";", "\n", "   ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"n3", ",", " ", "p3", ",", " ", "eex"}], "}"}], " ", "=", 
          " ", 
          RowBox[{"exchangeSF", "[", 
           RowBox[{
            RowBox[{"mo", "[", "\"\<g\>\"", "]"}], ",", " ", "bos", ",", " ", 
            
            RowBox[{"cn", " ", "-", " ", 
             RowBox[{"mo", "[", "\"\<vac\>\"", "]"}]}], ",", " ", "cp"}], 
           "]"}]}], ";", "\n", "   ", 
         RowBox[{"res", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"n2", " ", "-", " ", "nc"}], "]"}], ",", " ", 
            RowBox[{"Abs", "[", 
             RowBox[{"p2", " ", "-", " ", "pc"}], "]"}], ",", " ", 
            RowBox[{"Abs", "[", 
             RowBox[{"n3", " ", "-", " ", "nex"}], "]"}], ",", " ", 
            RowBox[{"Abs", "[", 
             RowBox[{"p3", " ", "-", " ", "pex"}], "]"}]}], "]"}]}], ";", 
         "\n", "   ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"res", " ", ">=", " ", 
            RowBox[{"10", "^", 
             RowBox[{"-", "11"}]}]}], ",", "\n", "    ", 
           RowBox[{
            RowBox[{"nc", " ", "=", " ", 
             RowBox[{
              RowBox[{"0.5", " ", "n2"}], " ", "+", " ", 
              RowBox[{"0.5", " ", "nc"}]}]}], ";", " ", 
            RowBox[{"pc", " ", "=", " ", 
             RowBox[{
              RowBox[{"0.5", " ", "p2"}], " ", "+", " ", 
              RowBox[{"0.5", " ", "pc"}]}]}], ";", "\n", "    ", 
            RowBox[{"nex", " ", "=", " ", 
             RowBox[{
              RowBox[{"0.5", " ", "n3"}], " ", "+", " ", 
              RowBox[{"0.5", " ", "nex"}]}]}], ";", " ", 
            RowBox[{"pex", " ", "=", " ", 
             RowBox[{
              RowBox[{"0.5", " ", "p3"}], " ", "+", " ", 
              RowBox[{"0.5", " ", "pex"}]}]}], ";", "\n", "    ", 
            RowBox[{"it", "++"}]}]}], "]"}]}]}], "]"}], ";", "\n", "  ", 
      RowBox[{"cjtExchange", " ", "=", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<energy\>\"", " ", "->", " ", 
          RowBox[{"ek", " ", "+", " ", "ei", " ", "+", " ", "eex"}]}], ",", 
         " ", 
         RowBox[{"\"\<exchange\>\"", " ", "->", " ", "eex"}], ",", " ", 
         RowBox[{"\"\<iterations\>\"", " ", "->", " ", "it"}]}], "|>"}]}], ";",
       "\n", "  ", 
      RowBox[{"check", "[", 
       RowBox[{"\"\<WP2-8d\>\"", ",", " ", 
        RowBox[{"\"\<CJT with the exchange at g_v = 0.7, g_F = 0.45: energy \
\>\"", " ", "<>", " ", 
         RowBox[{"sci", "[", 
          RowBox[{"ek", " ", "+", " ", "ei", " ", "+", " ", "eex"}], "]"}], 
         " ", "<>", " ", "\"\< = Rust (relative; \>\"", " ", "<>", " ", 
         RowBox[{"ToString", "[", "it", "]"}], " ", "<>", 
         " ", "\"\< iterations; exchange energy \>\"", " ", "<>", " ", 
         RowBox[{"sci", "[", "eex", "]"}], " ", "<>", " ", "\"\<)\>\""}], ",",
         "\n", "   ", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"ek", " ", "+", " ", "ei", " ", "+", " ", "eex"}], ")"}], 
           " ", "-", " ", 
           RowBox[{"rustPart2", "[", "\"\<p2_cjtex_energy\>\"", "]"}]}], 
          "]"}], "/", 
         RowBox[{"Abs", "[", 
          RowBox[{"rustPart2", "[", "\"\<p2_cjtex_energy\>\"", "]"}], "]"}]}],
         ",", " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "7"}]}], ",", " ", "\"\<P2-8f\>\"", ",", 
        " ", "\"\<YP2-8d\>\""}], "]"}]}]}], "]"}], ";"}]}]], "Input",
 CellLabel->
  "In[269]:=",ExpressionUUID->"dd6ae27b-27f1-4208-a8e3-a2971edf94e5"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"PASS \"\>", "\[InvisibleSpace]", "\<\"WP2-8d\"\>", 
   "\[InvisibleSpace]", "\<\"  deviation \"\>", 
   "\[InvisibleSpace]", "\<\"1.492e-8\"\>", 
