      SubscriptBox[
       OverscriptBox[
        StyleBox["q", "TI"], "\[RightVector]"], 
       StyleBox["LL",
        FontSlant->"Plain"]], ")"}], "-", 
     SubsuperscriptBox[
      StyleBox["C",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["vac",
       FontSlant->"Plain"]], 
     RowBox[{"(", 
      SubscriptBox[
       OverscriptBox[
        StyleBox["q", "TI"], "\[RightVector]"], 
       StyleBox["LL",
        FontSlant->"Plain"]], ")"}]}], "]"}], ",", "      ", 
   SuperscriptBox[
    StyleBox["C",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["p",
     FontSlant->"Plain"]], "\[LongEqual]", "\[Integral]", 
   FractionBox[
    RowBox[{
     SuperscriptBox[
      StyleBox["d", "TI"], "3"], 
     StyleBox["q", "TI"]}], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"2", "\[Pi]"}], ")"}], "3"]], "\[ThinSpace]", 
   SubsuperscriptBox[
    StyleBox["C",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p",
     FontSlant->"Plain"]], 
   RowBox[{"(", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["q", "TI"], "\[RightVector]"], 
     StyleBox["LL",
      FontSlant->"Plain"]], ")"}], ","}], TraditionalForm]], "DisplayFormula",\

 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"f7d2db54-a45a-443d-b75e-4c9851a86178"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftBracketingBar]", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["q", "TI"], "\[RightVector]"], 
      StyleBox["LL",
       FontSlant->"Plain"]], "\[RightBracketingBar]"}], "<", 
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ba3ef04d-5f23-427e-9e19-09b7e614aa78"],
 ". The energy per volume is the kinetic part plus the contractions of the \
contact terms: a bilinear term ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Nu]", ":", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["\[CapitalPsi]", "\[Dagger]"], 
       SubscriptBox[
        StyleBox["X",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["SF",
         FontSlant->"Plain"]], "\[CapitalPsi]"}], ")"}], "2"], ":"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6e9e97c1-79d5-46d3-acb4-e3f68bc11f2f"],
 " gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Nu]", 
    RowBox[{"[", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["w", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["H",
        FontSlant->"Plain"]], "\[ThinSpace]", 
      StyleBox["tr",
       FontSlant->"Plain"], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         StyleBox["X",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], "\[Delta]", 
         SuperscriptBox[
          StyleBox["C",
           FontFamily->"Helvetica",
           FontSlant->"Plain"], 
          StyleBox["n",
           FontSlant->"Plain"]]}], ")"}], "2"], "-", 
      SubsuperscriptBox[
       StyleBox["w", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["F",
        FontSlant->"Plain"]], "\[ThinSpace]", 
      StyleBox["tr",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       RowBox[{
        StyleBox["X",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        OverscriptBox[
         StyleBox["C",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], "~"], 
        StyleBox["X",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        OverscriptBox[
         StyleBox["C",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], "~"]}], ")"}], "-", 
      SubsuperscriptBox[
       StyleBox["w", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["P",
        FontSlant->"Plain"]], "\[ThinSpace]", 
      StyleBox["tr",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          SuperscriptBox[
           StyleBox["C",
            FontFamily->"Helvetica",
            FontSlant->"Plain"], 
           StyleBox["p",
            FontSlant->"Plain"]], ")"}], "*"], 
        StyleBox["X",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        SuperscriptBox[
         StyleBox["C",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], 
         StyleBox["p",
          FontSlant->"Plain"]], 
        SuperscriptBox[
         StyleBox["X",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], 
         StyleBox["T", "TI"]]}], ")"}]}], "]"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4439150b-dd51-48f3-a48c-a0a4f89c9880"],
 ", and a pairing term ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", "4"]}], 
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], ":", 
    SuperscriptBox[
     RowBox[{"(", 
      SuperscriptBox["\[CapitalPi]", "\[Iota]"], ")"}], "\[Dagger]"], 
    SuperscriptBox["\[CapitalPi]", "\[Iota]"], ":"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2b45a87c-97e5-4c20-824f-4dfd1b6c62ec"],
 " gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", "4"]}], 
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"[", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["w", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["P",
        FontSlant->"Plain"]], 
      SuperscriptBox[
       RowBox[{"\[LeftBracketingBar]", 
        RowBox[{
         StyleBox["tr",
          FontSlant->"Plain"], 
         RowBox[{"(", 
          RowBox[{
           SubsuperscriptBox[
            StyleBox["K",
             FontFamily->"Helvetica",
             FontSlant->"Plain"], 
            StyleBox["LL",
             FontSlant->"Plain"], "\[Iota]"], 
           SuperscriptBox[
            RowBox[{"(", 
             SuperscriptBox[
              StyleBox["C",
               FontFamily->"Helvetica",
               FontSlant->"Plain"], 
              StyleBox["p",
               FontSlant->"Plain"]], ")"}], 
            StyleBox["T", "TI"]]}], ")"}]}], "\[RightBracketingBar]"}], "2"], 
      "+", "2", 
      SubsuperscriptBox[
       StyleBox["w", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["F",
        FontSlant->"Plain"]], "\[ThinSpace]", 
      StyleBox["tr",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          SubsuperscriptBox[
           StyleBox["K",
            FontFamily->"Helvetica",
            FontSlant->"Plain"], 
           StyleBox["LL",
            FontSlant->"Plain"], "\[Iota]"], ")"}], "\[Dagger]"], 
        SuperscriptBox[
         OverscriptBox[
          StyleBox["C",
           FontFamily->"Helvetica",
           FontSlant->"Plain"], "~"], 
         StyleBox["T", "TI"]], 
        SubsuperscriptBox[
         StyleBox["K",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], 
         StyleBox["LL",
          FontSlant->"Plain"], "\[Iota]"], 
        OverscriptBox[
         StyleBox["C",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], "~"]}], ")"}]}], "]"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7064ddbe-3cb7-417f-84bc-f3f36880fb1b"],
 ", where the weights ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["w", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["H",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4e93e70c-20a8-4ab3-9920-206eca3de9a7"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["w", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["F",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1faeb7d6-874d-4104-afe0-44dc7cf77f72"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["w", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["P",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1eb50c21-0b8c-482a-93b7-7af9dbb11372"],
 " of the direct (Hartree), exchange (Fock) and pair (Bogoliubov) \
contractions define the method, and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     StyleBox["C",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "~"], "\[LongEqual]", "\[Delta]", 
    SuperscriptBox[
     StyleBox["C",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["n",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5bac0a07-d79f-40b0-91a9-253ef5b574db"],
 " except in KS, where it is the projection ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalP]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["KS",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     RowBox[{"\[Delta]", 
      SuperscriptBox[
       StyleBox["C",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["n",
        FontSlant->"Plain"]]}], ")"}], "\[LongEqual]", 
    FractionBox["1", "8"], 
    StyleBox["tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{"\[Delta]", 
      SuperscriptBox[
       StyleBox["C",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["n",
        FontSlant->"Plain"]]}], ")"}], 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "8"], "+", 
    FractionBox["1", "8"], 
    StyleBox["tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[Beta]", 
         StyleBox["LL",
          FontSlant->"Plain"]], "\[CircleTimes]", 
        SubscriptBox[
         StyleBox["1",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], "2"]}], ")"}], "\[Delta]", 
      SuperscriptBox[
       StyleBox["C",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["n",
        FontSlant->"Plain"]]}], ")"}], 
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[CircleTimes]", 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "20a461c3-d03f-42e4-b329-6710e8c01343"],
 " onto the two Kohn-Sham densities. ",
 StyleBox["HS",
  FontWeight->"Bold"],
 " decouples the shares ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["s", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["HS",
      FontSlant->"Plain"], ",", 
     StyleBox["S",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2eb15e81-ab68-4094-9253-ef50f36c1860"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["s", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["HS",
      FontSlant->"Plain"], ",", 
     StyleBox["V",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "eb00c1ac-9872-45bb-82a6-453ed768242e"],
 " of the scalar and the vector term in the density channels and the rest in \
the pair channels: weights ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["s", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["HS",
        FontSlant->"Plain"], ",", 
       StyleBox["S",
        FontSlant->"Plain"]}]], ",", "0", ",", "1", "-", 
     SubsuperscriptBox[
      StyleBox["s", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["HS",
        FontSlant->"Plain"], ",", 
       StyleBox["S",
        FontSlant->"Plain"]}]]}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9005749b-7877-45d2-90a8-e39cbcd60586"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["s", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["HS",
        FontSlant->"Plain"], ",", 
       StyleBox["V",
        FontSlant->"Plain"]}]], ",", "0", ",", "1", "-", 
     SubsuperscriptBox[
      StyleBox["s", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["HS",
        FontSlant->"Plain"], ",", 
       StyleBox["V",
        FontSlant->"Plain"]}]]}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7720e0b3-cb24-43fc-9413-e1632bec27db"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "0", ",", "1"}], ")"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1d73c72b-f3e7-4254-be91-58d50cff2a31"],
 " for the pairing term; three parameter sets are computed, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"1", ",", "1"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "48fa36a7-6b94-40d4-a8ef-937b330086d3"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "1"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "caf763ef-72af-4ebe-b4f4-68cfe0a287da"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "0"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "57c98f05-dfeb-4f84-8228-3fd794f0eca1"],
 ". ",
 StyleBox["KS",
  FontWeight->"Bold"],
 " and ",
 StyleBox["CJT",
  FontWeight->"Bold"],
 " keep all three contractions with weight 1; KS with the projection. The \
self-energies are the derivatives of the energy,"
}], "Text",ExpressionUUID->"e71a6239-d5f7-404f-b997-b8923057e0e6"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["N",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
