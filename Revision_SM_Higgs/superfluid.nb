Cell[CellGroupData[{

Cell["III.G.4 The coefficient at zero pair momentum and the slope", "Section",ExpressionUUID->"4f00f25f-b367-4804-bfa2-c92f9c3fb90f"],

Cell[TextData[{
 "The next cell computes, for every method with its own critical temperature \
(Section III.T.4), the coefficient at zero pair momentum from the static pair \
response and checks it four ways: at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.9", "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "229a4b7c-bbd2-4792-bab4-abdde3c2324c"],
 " it is the Taylor coefficient of the nonlinear free energy of the Rust \
table (Section III.T); at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "/", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]], "\[LongEqual]", "0.9"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b175baf1-f105-496a-85b3-6b99c68ada2a"],
 ", ",
 Cell[BoxData[
  FormBox["0.998", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0fc11b4e-613c-4e13-8243-bbb58735029c"],
 ", ",
 Cell[BoxData[
  FormBox["1.002", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "45b5a2c4-8b87-458e-829a-431e6e63f954"],
 " it is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "-", 
      SubsuperscriptBox["\[Lambda]", 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["P",
        FontSlant->"Plain"]]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["\[Lambda]", 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["P",
        FontSlant->"Plain"]], 
      SubsuperscriptBox[
       StyleBox["g", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["P",
         FontSlant->"Plain"]}]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "896133a9-b248-4fe6-9126-cd1531d67981"],
 " with the eigenvalue of Section III.T.4; at ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "702b292d-8117-4faf-84fa-badc05477717"],
 " it vanishes; and no other pair channel is induced. The slope ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Alpha]", 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["GL",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "823c076f-afb6-4c5f-a25e-1c7024c0b43b"],
 " is computed twice: from central differences of the coefficient at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     RowBox[{"1", "\[PlusMinus]", "0.002"}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "080fa417-be86-48db-9d00-e8a7cdcbb8e9"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     RowBox[{"1", "\[PlusMinus]", "0.004"}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ea68f4cb-cab9-455f-b47c-cf1b16e70251"],
 " with the Richardson extrapolation, and in closed form with the derivatives \
of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["I", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "1", ")"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "44f35550-0702-4ce6-9d9f-494126469412"],
 " on the radial nodes,"
}], "Text",ExpressionUUID->"311d0a87-94c8-445b-a8fc-c604345eff55"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[PartialD]", 
    StyleBox["T", "TI"]], 
   SubsuperscriptBox[
    StyleBox["I", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "1", ")"}]], "\[LongEqual]", 
   RowBox[{"-", 
    FractionBox["1", 
     RowBox[{"2", 
      SuperscriptBox[
       StyleBox["T", "TI"], "2"]}]]}], "\[ThinSpace]", 
   SubsuperscriptBox["\[Integral]", "0", 
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]], "\[ThinSpace]", 
   FractionBox[
    RowBox[{
     SuperscriptBox[
      StyleBox["q", "TI"], "2"], "\[ThinSpace]", 
     StyleBox["dq", "TI"]}], 
    RowBox[{
     SuperscriptBox[
      StyleBox["cosh",
       FontSlant->"Plain"], "2"], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["E", "TI"], 
        StyleBox["M", "TI"]], "/", "2", 
       StyleBox["T", "TI"]}], ")"}]}]], ",", "      ", 
   SubscriptBox["\[PartialD]", 
    StyleBox["M", "TI"]], 
   SubsuperscriptBox[
    StyleBox["I", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "1", ")"}]], "\[LongEqual]", 
   SubsuperscriptBox["\[Integral]", "0", 
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["q", "TI"], "2"], 
   FractionBox[
    StyleBox["M", "TI"], 
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["M", "TI"]]], 
   RowBox[{"[", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"2", 
       StyleBox["T", "TI"], 
       SubscriptBox[
        StyleBox["E", "TI"], 
        StyleBox["M", "TI"]], "\[ThinSpace]", 
       SuperscriptBox[
        StyleBox["cosh",
         FontSlant->"Plain"], "2"], 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox[
          StyleBox["E", "TI"], 
          StyleBox["M", "TI"]], "/", "2", 
         StyleBox["T", "TI"]}], ")"}]}]], "-", 
     FractionBox[
      RowBox[{
       StyleBox["tanh",
        FontSlant->"Plain"], 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox[
          StyleBox["E", "TI"], 
          StyleBox["M", "TI"]], "/", "2", 
         StyleBox["T", "TI"]}], ")"}]}], 
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["M", "TI"], "2"]]}], "]"}], 
   StyleBox["dq", "TI"], ","}], TraditionalForm]], "DisplayFormula",
