Cell[CellGroupData[{

Cell["R.1.2 The algebra of the global group (check WQN-1)", "Subsection",ExpressionUUID->"c1ed39b6-ccd4-4b91-aea4-2f2afa619571"],

Cell[TextData[{
 "The generators must close into the algebra of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["L", "TI"]], "\[Times]", 
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["R",
      FontSlant->"Plain"]], "\[Times]", 
    StyleBox["U", "TI"], 
    SubscriptBox[
     RowBox[{"(", "1", ")"}], 
     StyleBox["R",
      FontSlant->"Plain"]], "\[Times]", 
    StyleBox["U", "TI"], 
    SubscriptBox[
     RowBox[{"(", "1", ")"}], 
     StyleBox["F",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d02fa2f7-0cf2-45ca-91fd-74255630f193"],
 ": ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"[", 
     RowBox[{
      SuperscriptBox[
       StyleBox["T", "TI"], 
       RowBox[{
        StyleBox["a", "TI"], ",", 
        StyleBox["SM",
         FontSlant->"Plain"]}]], ",", 
      SuperscriptBox[
       StyleBox["T", "TI"], 
       RowBox[{
        StyleBox["b", "TI"], ",", 
        StyleBox["SM",
         FontSlant->"Plain"]}]]}], "]"}], "\[LongEqual]", 
    StyleBox["i", "TI"], 
    SubscriptBox["\[Epsilon]", 
     StyleBox["abc", "TI"]], 
    SuperscriptBox[
     StyleBox["T", "TI"], 
     RowBox[{
      StyleBox["c", "TI"], ",", 
      StyleBox["SM",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "840ae9b2-84e4-482f-895a-e43232061d2a"],
 ", the same for ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["a", "TI"], ",", 
     StyleBox["R",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d71cc017-0679-49c0-82e3-c9023cb03326"],
 ", the two sets commuting with each other, and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["Y", "TI"], 
    StyleBox["SM",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "648ea9fe-3302-46ea-8421-eb6477e965c9"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["F", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"], 
    StyleBox["tot",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f88e9b9f-7299-41f1-9980-97bd4913b79f"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8a016320-0f9b-4e9a-acd6-91439fa1498c"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"], 
    RowBox[{"3", ",", 
     StyleBox["R",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5c8713ab-16a2-482c-9e47-9e96e387688e"],
 " commuting with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["L", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b208c3f0-85b2-489a-bbce-bdc5609041c7"],
 " and with each other. They must be Hermitian (a unitary representation), \
and the hypercharge must be the combination ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["Y", "TI"], 
     StyleBox["SM",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     RowBox[{"3", ",", 
      StyleBox["R",
       FontSlant->"Plain"]}]], "+", 
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]], "/", "4"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "47808374-843b-4296-8172-8e6558516b03"],
 ", so that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["Q", "TI"], 
     StyleBox["SM",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["T", "TI"], 
     RowBox[{"3", ",", 
      StyleBox["SM",
       FontSlant->"Plain"]}]], "+", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     RowBox[{"3", ",", 
      StyleBox["R",
       FontSlant->"Plain"]}]], "+", 
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]], "/", "4"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fa042d4c-787c-4d5c-ac46-74b22910400e"],
 ". ",
 StyleBox["What it means.",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["Y", "TI"], 
    StyleBox["SM",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "36665d5f-36e3-4f79-8f11-96ed17186168"],
 " does not commute with ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"], 
    RowBox[{"1", ",", 
     StyleBox["R",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "57c375b5-89d6-4946-a0b2-5d2618fae796"],
 ": the gauge field ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["B", "TI"], "\[Mu]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2cd9e197-1ced-47aa-98a8-d8d62e78d3e2"],
 ", which couples to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["Y", "TI"], 
    StyleBox["SM",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "549f6ce1-fd8a-45d0-85ea-6c52e0ba67b5"],
 ", breaks the custodial group ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["R",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "76c316ea-cf33-42a2-87c1-0f4545e4b80e"],
 " explicitly. The custodial symmetry of the superfluid is therefore exact \
only for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["g", "TI"], "\[Prime]"], "\[LongEqual]", "0"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cafff6d4-6cc2-457d-90f3-1d50091e95e9"],
 ", as in the Standard Model."
}], "Text",ExpressionUUID->"7548c732-ff6f-41c6-9b2e-266c4b766d56"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"WQN", "-", "1"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"ok1", " ", "=", " ", 
     RowBox[{
      RowBox[{"And", " ", "@@", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"comm", "[", 
            RowBox[{
             RowBox[{"T", "[", "a", "]"}], ",", " ", 
             RowBox[{"T", "[", "b", "]"}]}], "]"}], " ", "==", " ", 
           RowBox[{"I", " ", 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"lev", "[", 
                RowBox[{"a", ",", " ", "b", ",", " ", "c"}], "]"}], " ", 
               RowBox[{"T", "[", "c", "]"}]}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"c", ",", " ", "3"}], "}"}]}], "]"}]}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"a", ",", " ", "3"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"b", ",", " ", "3"}], "}"}]}], "]"}], "]"}]}], " ", "&&", 
      "\n", "  ", 
      RowBox[{"And", " ", "@@", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"comm", "[", 
            RowBox[{
             RowBox[{"TR", "[", "a", "]"}], ",", " ", 
             RowBox[{"TR", "[", "b", "]"}]}], "]"}], " ", "==", " ", 
           RowBox[{"I", " ", 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"lev", "[", 
                RowBox[{"a", ",", " ", "b", ",", " ", "c"}], "]"}], " ", 
               RowBox[{"TR", "[", "c", "]"}]}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"c", ",", " ", "3"}], "}"}]}], "]"}]}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"a", ",", " ", "3"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"b", ",", " ", "3"}], "}"}]}], "]"}], "]"}]}], " ", "&&", 
      "\n", "  ", 
      RowBox[{"And", " ", "@@", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"comm", "[", 
            RowBox[{
             RowBox[{"T", "[", "a", "]"}], ",", " ", 
             RowBox[{"TR", "[", "b", "]"}]}], "]"}], " ", "==", " ", "z16"}], 
          ",", " ", 
          RowBox[{"{", 
           RowBox[{"a", ",", " ", "3"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"b", ",", " ", "3"}], "}"}]}], "]"}], "]"}]}], " ", "&&", 
      "\n", "  ", 
      RowBox[{"And", " ", "@@", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"comm", "[", 
            RowBox[{"x", ",", " ", "z"}], "]"}], " ", "==", " ", "z16"}], ",",
           " ", 
          RowBox[{"{", 
           RowBox[{"x", ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"T", "[", "1", "]"}], ",", " ", 
              RowBox[{"T", "[", "2", "]"}], ",", " ", 
              RowBox[{"T", "[", "3", "]"}], ",", " ", "YY", ",", " ", "FF", ",",
               " ", "RR", ",", " ", 
              RowBox[{"TR", "[", "3", "]"}]}], "}"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"z", ",", " ", 
            RowBox[{"{", 
             RowBox[{"YY", ",", " ", "FF", ",", " ", "RR", ",", " ", 
              RowBox[{"TR", "[", "3", "]"}]}], "}"}]}], "}"}]}], "]"}], 
        "]"}]}], " ", "&&", "\n", "  ", 
      RowBox[{"And", " ", "@@", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"comm", "[", 
            RowBox[{
             RowBox[{"TR", "[", "a", "]"}], ",", " ", "x"}], "]"}], " ", "==",
            " ", "z16"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"a", ",", " ", "3"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"x", ",", " ", 
            RowBox[{"{", 
             RowBox[{"FF", ",", " ", "RR"}], "}"}]}], "}"}]}], "]"}], "]"}]}],
       " ", "&&", "\n", "  ", 
      RowBox[{"And", " ", "@@", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"#", " ", "==", " ", 
           RowBox[{"ConjugateTranspose", "[", "#", "]"}]}], " ", "&"}], " ", "/@",
          " ", "gensAll"}], ")"}]}], " ", "&&", "\n", "  ", 
      RowBox[{"YY", " ", "==", " ", 
       RowBox[{
        RowBox[{"TR", "[", "3", "]"}], " ", "+", " ", 
        RowBox[{"RR", "/", "4"}]}]}], " ", "&&", " ", 
      RowBox[{"QQ", " ", "==", " ", 
       RowBox[{
        RowBox[{"T", "[", "3", "]"}], " ", "+", " ", 
        RowBox[{"TR", "[", "3", "]"}], " ", "+", " ", 
        RowBox[{"RR", "/", "4"}]}]}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"comm", "[", 
        RowBox[{"YY", ",", " ", 
         RowBox[{"TR", "[", "1", "]"}]}], "]"}], " ", "=!=", " ", "z16"}]}]}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"rvCheck", "[", 
     RowBox[{"\"\<WQN-1\>\"", ",", 
      " ", "\"\<the algebra of SU(2)_L x SU(2)_R x U(1)_R x U(1)_F_tot, \
Hermitian generators, Y = T^3_R + R/4 \\\n(4.3), Q = T^3 + T^3_R + R/4, and \
[Y, T^1_R] != 0\>\"", ",", " ", "ok1", ",", 
      " ", "\"\<identities of exact matrices\>\""}], "]"}], 
    ";"}]}]}]], "Input",
 CellLabel->
  "In[441]:=",ExpressionUUID->"15e761b2-13c3-40d6-8451-07e5ef34fa6d"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"PASS \"\>", "\[InvisibleSpace]", "\<\"WQN-1\"\>", 
   "\[InvisibleSpace]", "\<\"  \"\>", 
   "\[InvisibleSpace]", "\<\"the algebra of SU(2)_L x SU(2)_R x U(1)_R x \
U(1)_F_tot, Hermitian generators, Y = T^3_R + R/4 (4.3), Q = T^3 + T^3_R + \
R/4, and [Y, T^1_R] != 0\"\>", "\[InvisibleSpace]", "\<\" [\"\>", 
   "\[InvisibleSpace]", "\<\"identities of exact matrices\"\>", 
   "\[InvisibleSpace]", "\<\"]   [the same check: Rust \"\>", 
   "\[InvisibleSpace]", "\<\"QN-1a to QN-1e\"\>", 
   "\[InvisibleSpace]", "\<\", Python \"\>", 
