Cell[CellGroupData[{

Cell["R.1.3 The Lorentz generators (check WQN-2)", "Subsection",ExpressionUUID->"cd62ca1d-d7fe-42c7-adc2-79d5347b5c7a"],

Cell[TextData[{
 "The six real generators of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SL", "TI"], 
    RowBox[{"(", 
     RowBox[{"2", ",", 
      StyleBox["\[DoubleStruckCapitalC]",
       FontSlant->"Plain"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "19597154-56a4-421c-92b1-0bc7a1fd2028"],
 " are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["u", "TI"], "\[LongEqual]", 
    RowBox[{"-", 
     StyleBox["i", "TI"]}], 
    SuperscriptBox["\[Sigma]", 
     StyleBox["j", "TI"]], "/", "2"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0345ecfb-adf0-4fd6-8643-00b03042a256"],
 " (rotations) and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["u", "TI"], "\[LongEqual]", 
    SuperscriptBox["\[Sigma]", 
     StyleBox["j", "TI"]], "/", "2"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "98922739-4d1f-45ca-9d70-6717b33df929"],
 " (boosts); on a Dirac field they act as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["S", "TI"], 
    RowBox[{"(", 
     StyleBox["u", "TI"], ")"}], "\[LongEqual]", 
    StyleBox["diag",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox[
        StyleBox["u", "TI"], "\[Dagger]"]}], ",", 
      StyleBox["u", "TI"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "56b51425-0eb5-4bc7-a22a-0c9fd90a73b8"],
 ". The map ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["u", "TI"], "\[RightTeeArrow]", 
    StyleBox["S", "TI"], 
    RowBox[{"(", 
     StyleBox["u", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5c0d22f9-0375-4d53-bffd-aa2d79793308"],
 " must respect the commutators, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["S", "TI"], 
    RowBox[{"(", 
     RowBox[{"[", 
      RowBox[{
       StyleBox["u", "TI"], ",", 
       SuperscriptBox[
        StyleBox["u", "TI"], "\[Prime]"]}], "]"}], ")"}], "\[LongEqual]", 
    RowBox[{"[", 
     RowBox[{
      StyleBox["S", "TI"], 
      RowBox[{"(", 
       StyleBox["u", "TI"], ")"}], ",", 
      StyleBox["S", "TI"], 
      RowBox[{"(", 
       SuperscriptBox[
        StyleBox["u", "TI"], "\[Prime]"], ")"}]}], "]"}]}], TraditionalForm]],
   "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2aca4d98-c2b3-4d39-9eaf-0470f90a19d1"],
 "; the six images must be independent over the real numbers; and every image \
must commute with the ten internal generators, so that the space-time and the \
internal symmetries are independent and the charges of a field do not depend \
on the frame."
}], "Text",ExpressionUUID->"da518eb4-acb4-47ce-a9e0-dd33722f4554"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", 
          RowBox[{"--", 
           RowBox[{"--", 
            RowBox[{"--", 
             RowBox[{"--", 
              RowBox[{"--", 
               RowBox[{"--", 
                RowBox[{"--", 
                 RowBox[{"--", 
                  RowBox[{"--", 
                   RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{
                    "--", " ", 
                    "the"}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}\
]}]}]}]}]}]}], " ", "Lorentz", " ", "generators"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"lb", " ", "=", " ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "I"}], " ", 
          RowBox[{
           RowBox[{"sig", "[", "j", "]"}], "/", "2"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"sig", "[", "j", "]"}], "/", "2"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}], "]"}]}], ";"}], 
   "   ", 
   RowBox[{"(*", " ", 
    RowBox[{"rotations", ",", " ", "boosts"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"sGen", "[", "mu_", "]"}], " ", ":=", " ", 
     RowBox[{"blk", "[", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"ConjugateTranspose", "[", "mu", "]"}]}], ",", " ", "mu"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"l16", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"dirac16", "[", 
        RowBox[{"sGen", "[", "#", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
      "lb"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ok2", " ", "=", " ", 
     RowBox[{
      RowBox[{"And", " ", "@@", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"dirac16", "[", 
            RowBox[{"sGen", "[", 
             RowBox[{"comm", "[", 
              RowBox[{
               RowBox[{"lb", "[", 
                RowBox[{"[", "k", "]"}], "]"}], ",", " ", 
               RowBox[{"lb", "[", 
                RowBox[{"[", "l", "]"}], "]"}]}], "]"}], "]"}], "]"}], " ", "==",
            " ", 
           RowBox[{"comm", "[", 
            RowBox[{
             RowBox[{"l16", "[", 
              RowBox[{"[", "k", "]"}], "]"}], ",", " ", 
             RowBox[{"l16", "[", 
              RowBox[{"[", "l", "]"}], "]"}]}], "]"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"k", ",", " ", "6"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"l", ",", " ", "6"}], "}"}]}], "]"}], "]"}]}], " ", "&&", 
      "\n", "  ", 
      RowBox[{"And", " ", "@@", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"comm", "[", 
            RowBox[{"s", ",", " ", "x"}], "]"}], " ", "==", " ", "z16"}], ",",
           " ", 
          RowBox[{"{", 
           RowBox[{"s", ",", " ", "l16"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "gensAll"}], "}"}]}], "]"}], "]"}]}], " ", "&&",
       "\n", "  ", 
      RowBox[{
       RowBox[{"MatrixRank", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"Re", "[", 
             RowBox[{"Flatten", "[", "#", "]"}], "]"}], ",", " ", 
            RowBox[{"Im", "[", 
             RowBox[{"Flatten", "[", "#", "]"}], "]"}]}], "]"}], " ", "&"}], 
         " ", "/@", " ", "l16"}], "]"}], " ", "==", " ", "6"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rvCheck", "[", 
     RowBox[{"\"\<WQN-2\>\"", ",", 
      " ", "\"\<the six real Lorentz generators: S([u, u']) = [S(u), S(u')], \
independent over the reals, commuting with \\\nthe ten internal \
generators\>\"", ",", " ", "ok2", ",", 
      " ", "\"\<identities of exact matrices; real rank 6\>\""}], "]"}], 
    ";"}]}]}]], "Input",
 CellLabel->
  "In[443]:=",ExpressionUUID->"1338885b-df51-41be-a9fe-abe95b0b1053"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"PASS \"\>", "\[InvisibleSpace]", "\<\"WQN-2\"\>", 
   "\[InvisibleSpace]", "\<\"  \"\>", 
