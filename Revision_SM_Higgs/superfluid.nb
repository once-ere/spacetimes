Cell["\<\
R.3.2 The amplitude mode of the effective Lagrangian (check WH-2)\
\>", "Subsection",ExpressionUUID->"dc8b8e8c-cafd-4816-8a28-4c154defe6b8"],

Cell[TextData[{
 "If the two pair fields of the second version, ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalPhi]", 
    StyleBox["SH",
     FontSlant->"Plain"], 
    StyleBox["d",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "132ef607-6542-4fc5-86a9-bda68a8ea43f"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["T", "TI"], 
     RowBox[{"3", ",", 
      StyleBox["SM",
       FontSlant->"Plain"]}]], "\[LongEqual]", 
    RowBox[{"-", 
     FractionBox["1", "2"]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "23ae3b5e-9981-4164-be4c-0152b23c3fd5"],
 ") and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalPhi]", 
    StyleBox["SH",
     FontSlant->"Plain"], 
    RowBox[{"\[Prime]", 
     StyleBox["u",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a491b619-6f69-4b93-b78d-59d67238a8bb"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", 
    FractionBox["1", "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "08b3e640-1194-4487-88c5-71e71e63df7e"],
 "), move together with the common length ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CurlyPhi]", 
     StyleBox["SH",
      FontSlant->"Plain"], "0"], "+", "\[Eta]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "817ab998-f8b9-4b4a-af7e-1cb0ac8c5a66"],
 ", the Lagrangian ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["Z", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"\[LeftBracketingBar]", 
        RowBox[{"\[PartialD]", 
         SuperscriptBox["\[CapitalPhi]", 
          StyleBox["d",
           FontSlant->"Plain"]]}], "\[RightBracketingBar]"}], "2"], "+", 
      SuperscriptBox[
       RowBox[{"\[LeftBracketingBar]", 
        RowBox[{"\[PartialD]", 
         SuperscriptBox["\[CapitalPhi]", 
          RowBox[{"\[Prime]", 
           StyleBox["u",
            FontSlant->"Plain"]}]]}], "\[RightBracketingBar]"}], "2"]}], 
     ")"}], "-", 
    SubsuperscriptBox[
     StyleBox["V", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["eff",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f35ce18d-b7cb-4797-8765-c6db9e7dfdb4"],
 " gives ",
 Cell[BoxData[
  FormBox["\[Eta]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bd0d7a73-2973-4018-ab82-eda4d778f4ce"],
 " the kinetic term ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    SubscriptBox[
     StyleBox["Z", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     OverscriptBox["\[Eta]", "."], "2"]}], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "45a3c191-ce72-4251-b88a-dfb7405c050d"],
 " and the potential ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], 
    SuperscriptBox[
     StyleBox["V", "TI"], "\[Prime]\[Prime]"], 
    SuperscriptBox["\[Eta]", "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5cc35db2-c7c7-412f-ac22-d2a3bedbad21"],
 ", hence ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Omega]", "2"], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["V", "TI"], "\[Prime]\[Prime]"], "/", 
    RowBox[{"(", 
     RowBox[{"4", 
      SubscriptBox[
       StyleBox["Z", "TI"], 
