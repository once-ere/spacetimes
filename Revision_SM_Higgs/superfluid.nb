                 RowBox[{"[", 
                  RowBox[{"col", "[", 
                   RowBox[{"r9h", ",", " ", "\"\<gap\>\""}], "]"}], "]"}], 
                 "]"}], "]"}], ",", " ", "8"}], "]"}], ",", "\n", "      ", 
             RowBox[{"NumberForm", "[", 
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{"num", "[", 
                 RowBox[{"r", "[", 
                  RowBox[{"[", 
                   RowBox[{"col", "[", 
                    RowBox[{"r9h", ",", " ", "\"\<M_up\>\""}], "]"}], "]"}], 
                  "]"}], "]"}], "]"}], ",", " ", "8"}], "]"}]}], "}"}], ",", 
           " ", 
