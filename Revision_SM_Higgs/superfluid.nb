Cell[CellGroupData[{

Cell["R.1.5 The anomalies (check WQN-5)", "Subsection",ExpressionUUID->"ecd3b009-df2f-47ca-9e1b-7851c48fc06b"],

Cell[TextData[{
 "A gauge theory is consistent only if the triangle anomalies of its gauged \
currents cancel. For Dirac fields the anomaly traces are traces with the \
chirality, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["\[Gamma]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["ch",
        FontSlant->"Plain"]], 
      SuperscriptBox[
       StyleBox["Y", "TI"], "3"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "23be44b2-7255-4b12-8ae1-2a3164547118"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["\[Gamma]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["ch",
        FontSlant->"Plain"]], 
      StyleBox["Y", "TI"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "915b1458-c421-4107-b6d1-d298464973ea"],
 " (the mixed anomaly with gravity), ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["\[Gamma]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["ch",
        FontSlant->"Plain"]], 
      RowBox[{"{", 
       RowBox[{
        SuperscriptBox[
         StyleBox["T", "TI"], 
         StyleBox["a", "TI"]], ",", 
        SuperscriptBox[
         StyleBox["T", "TI"], 
         StyleBox["b", "TI"]]}], "}"}], 
      StyleBox["Y", "TI"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "73e475ba-56cd-425d-966e-d7a0018f4f88"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["\[Gamma]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["ch",
        FontSlant->"Plain"]], 
      SuperscriptBox[
       StyleBox["Y", "TI"], "2"], 
      SuperscriptBox[
       StyleBox["T", "TI"], 
       StyleBox["a", "TI"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a366b315-7f16-43af-a226-b9674dd2c281"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["\[Gamma]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["ch",
        FontSlant->"Plain"]], 
      SuperscriptBox[
       StyleBox["T", "TI"], 
       StyleBox["a", "TI"]], 
      RowBox[{"{", 
       RowBox[{
        SuperscriptBox[
         StyleBox["T", "TI"], 
         StyleBox["b", "TI"]], ",", 
        SuperscriptBox[
         StyleBox["T", "TI"], 
         StyleBox["c", "TI"]]}], "}"}]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0ad30b20-2f3e-4903-ac0c-47d59f3b8cfd"],
 ", with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["a", "TI"]], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["T", "TI"], 
     RowBox[{
      StyleBox["a", "TI"], ",", 
      StyleBox["SM",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8dd4b33d-821d-4fd6-a7fa-4d6dd45fedcf"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Y", "TI"], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["Y", "TI"], 
     StyleBox["SM",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dce1e0a1-58e0-472e-89aa-900cfef46725"],
 ". The fields of the hypotheses are vector-like: ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], "0"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2a36f80c-e2c8-47c9-a63f-72add4364445"],
 ", which exchanges the two chiralities, commutes with every internal \
generator, so both chiralities carry the same charges and every trace \
vanishes. The global anomaly of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    RowBox[{"(", "2", ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "72f45dbf-2f7c-49d2-939b-1902e4310caf"],
 " (Witten's) requires an even number of Weyl doublets of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["L", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f0acac72-3951-4172-bbfd-5c86cfa9ccfc"],
 "; the isodoublet ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0f4c50a6-8785-4d0a-9fcd-8c851cd0646a"],
 " gives two (one of each chirality)."
}], "Text",ExpressionUUID->"237d1d1d-3b41-4b83-9e79-77e253f12ed7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", 
          RowBox[{"--", 
           RowBox[{"--", 
            RowBox[{"--", 
             RowBox[{"--", 
              RowBox[{"--", 
               RowBox[{"--", 
