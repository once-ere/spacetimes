      RowBox[{"(", 
       RowBox[{
       "the", " ", "importer", " ", "would", " ", "read", " ", "a", " ", 
        "lone", " ", "\"\<-\>\"", " ", "as", " ", "a", " ", "missing", " ", 
        "value"}], ")"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"parityOf", "[", "x_", "]"}], " ", ":=", " ", 
