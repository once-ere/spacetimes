Cell[CellGroupData[{

Cell["\<\
II.1 The pair channels and the gauge bosons that mediate the pairing\
\>", "Section",ExpressionUUID->"4b4cb132-44de-471e-b672-aa98867dedc8"],

Cell[TextData[{
 "The spin-zero pairs are the six antisymmetric unitary matrices ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "966f20fb-fb81-44c8-98c9-81322b3e7e16"],
 " (scalar, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["0", "+"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a0f921e4-c2a2-47f3-9b66-81ed22b030bc"],
 ") and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     RowBox[{"\[Prime]", "\[Iota]"}]], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[CircleTimes]", 
    SubscriptBox[
     StyleBox["E",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Tau]", "\[Iota]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "161e4350-2349-4f0c-9425-69b8715039f1"],
 " (pseudoscalar, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["0", "-"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "81299d87-e2a1-4d34-843e-a28d7709b515"],
 "). The state of two spinor charges at one point in the channel ",
 Cell[BoxData[
  FormBox[
   StyleBox["K",
    FontFamily->"Helvetica",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "370b32f2-fb25-487e-9565-e06d7db6fd4f"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftBracketingBar]", 
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "\[RightAngleBracket]", "\[Proportional]", 
    FractionBox["1", "2"], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["c", "TI"], 
      SuperscriptBox[
       StyleBox["c", "TI"], "\[Prime]"]}],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["c", "TI"], 
      SuperscriptBox[
       StyleBox["c", "TI"], "\[Prime]"]}], "*"], 
    SubsuperscriptBox["\[CapitalPsi]", 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["c", "TI"]}], "\[Dagger]"], 
    SubsuperscriptBox["\[CapitalPsi]", 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      SuperscriptBox[
       StyleBox["c", "TI"], "\[Prime]"]}], "\[Dagger]"], "\[LeftBracketingBar]",
     "0", "\[RightAngleBracket]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "449fa92a-09cd-4bef-a1f3-347f5ef19603"],
 ", normalized, and the pair energy of a contact operator ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[ScriptCapitalO]",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "37681699-d4a2-40d1-84d8-bc9a7597a6ec"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["pair",
      FontSlant->"Plain"]], 
    RowBox[{"[", 
     RowBox[{
      StyleBox["\[ScriptCapitalO]",
       FontSlant->"Plain"], ";", 
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"]}], "]"}], "\[LongEqual]", 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "\[RightBracketingBar]", 
      StyleBox["\[ScriptCapitalO]",
       FontSlant->"Plain"], "\[LeftBracketingBar]", 
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"]}], "\[RightAngleBracket]"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1b1203d6-52e3-4cb1-a395-1fd3e210f9a1"],
 ", per unit coupling; negative means attraction. The operators are the three \
terms of the potentials and the contact limit of the exchange of the four \
gauge bosons of GEE, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", 
     StyleBox["p", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox["\[Eta]", 
     StyleBox["pp", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], ":", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["\[CapitalPsi]", "\[Dagger]"], 
       SubsuperscriptBox[
        StyleBox["A",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["SF",
          FontSlant->"Plain"], ",", 
         StyleBox["p", "TI"]}], 
        StyleBox["b",
         FontSlant->"Plain"]], "\[CapitalPsi]"}], ")"}], "2"], ":"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "41562787-4627-40b4-bb0b-773af2914702"],
 " with the vertex matrices ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["A",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], 
     StyleBox["b",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["\[Gamma]", 
       StyleBox["LL",
        FontSlant->"Plain"], "0"], 
      SubsuperscriptBox["\[Gamma]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["p", "TI"]]}], ")"}], "\[CircleTimes]", 
    SubsuperscriptBox[
     StyleBox["t",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["b",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b3bc9a54-28ce-4d20-ada9-673fce1819ff"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["t",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["b",
      FontSlant->"Plain"]], "\[LongEqual]", 
    FractionBox["1", "2"], 
    SubsuperscriptBox["\[Tau]", "\[Iota]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9da8314c-7fbd-4565-83a4-05b3cefa29bf"],
 " for ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "db72a889-5554-44b2-9779-ef845e20228e"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["1",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9f3f62f3-9250-4fa3-adbb-da7df452bf4f"],
 " for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "468ad013-424d-4550-9b4f-52c82f88bc18"],
 "). The result: the scalar term has ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "019b9617-a4d7-43b4-8300-aded0304616b"],
 " in the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["0", "+"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3f86c79f-6373-4988-b3ac-02182edb1b67"],
 " channels and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "207622d0-a220-43dc-b730-bf2eeedd9181"],
 " in the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["0", "-"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c9762f8a-e50a-4515-8805-d9deb0b51c37"],
 " channels, the vector term ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", "4"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "51bbf16f-7ad9-44a8-b551-bf5a8282475c"],
 " everywhere, the pairing term ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "4"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0bda3994-9bea-40ab-9c93-6c570df2a963"],
 " in the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["0", "+"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c4ae6302-6269-43a9-bb16-516f4e3856df"],
 " channels, each ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bfc2d15d-343b-425b-b077-8384ed14f34a"],
 " attracts (",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "060d7d51-4cb0-4e8e-87c3-b11bf37096dd"],
 ") in the two channels with the same index and repels (",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c38f3111-9f9e-4fc8-86ff-164cd0de2342"],
 ") in the other four, and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "76cb021c-80a8-49c9-8755-791372d31bca"],
 " repels (",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", "4"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "abe676fb-e624-491b-a000-1fd8b0958989"],
 ") everywhere. In every channel"
}], "Text",ExpressionUUID->"5c5104e5-7230-4389-8058-558e9bac9f63"],

Cell[BoxData[
 FormBox[
  RowBox[{
   UnderoverscriptBox["\[Sum]", 
    RowBox[{"\[Iota]", "\[LongEqual]", "1"}], "3",
    LimitsPositioning->True], "\[ThinSpace]", 
   SubsuperscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["pair",
     FontSlant->"Plain"]], 
   RowBox[{"[", 
    RowBox[{
     SuperscriptBox[
      StyleBox["W", "TI"], "\[Iota]"], ";", 
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"]}], "]"}], "\[LongEqual]", 
   FractionBox["1", "4"], 
   SubsuperscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["pair",
     FontSlant->"Plain"]], 
   RowBox[{"[", 
    RowBox[{
     StyleBox["B", "TI"], ";", 
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"]}], "]"}], "\[LongEqual]", 
   RowBox[{"+", "1"}], ","}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"5dea2416-0efb-4aae-8a78-7ded9457c264"],

Cell[TextData[{
 "the isospin Casimir of a triplet pair (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["T", "TI"], "\[RightVector]"], "1"], "\[CenterDot]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["T", "TI"], "\[RightVector]"], "2"], "\[LongEqual]", 
    RowBox[{"+", 
     FractionBox["1", "4"]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "be889702-75dc-4245-8c35-35497662fe2b"],
 "): no gauge boson attracts a spin-zero pair in the symmetric vacuum. After \
the breaking of the symmetry in the channel ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "af5d484f-5ea9-4ea7-bf97-4b619ec85a3e"],
 ", the gauge field ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0d5adc3a-0a51-4814-a827-81401f70cd85"],
 " of the unbroken generator stays massless (the zeugon, the massless gauge \
boson of the superfluid; not the photon, since the DiracLike spinor has \
electric charge 0) and attracts the two charges of the condensed pair, which \
carry the opposite charges ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["T", "TI"], "3"], "\[LongEqual]", 
    RowBox[{"\[PlusMinus]", 
     FractionBox["1", "2"]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "248d35ec-dccd-47dc-98e5-7a929d060763"],
 ". The next cell computes the 42 pair energies exactly on the 256 states of \
one point (with the operators of Section I.5) and compares them with the \
table of the Rust program."
}], "Text",ExpressionUUID->"d3df66f4-f127-4797-9bf7-8c50192a56eb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"kPs", "[", "iota", "]"}], ":", " ", 
     RowBox[{"the", " ", "matrices", " ", 
      RowBox[{
       RowBox[{"K", "'"}], "^", "iota_LL"}]}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{"C_LL", " ", 
      RowBox[{"(", "x", ")"}], " ", "E_LL", " ", "tau_iota", " ", "of", " ", 
      "the", " ", "pseudoscalar", " ", "spin"}], "-", 
     RowBox[{"zero", " ", "pairs"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"kPs", "[", "iota_Integer", "]"}], " ", ":=", " ", 
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{"cLL", ",", " ", 
       RowBox[{"eLL", " ", ".", " ", 
        RowBox[{"sig", "[", 
         RowBox[{"[", 
          RowBox[{"iota", " ", "+", " ", "1"}], "]"}], "]"}]}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"pairState", "[", "k", "]"}], ":", " ", 
      RowBox[{
      "the", " ", "normalized", " ", "state", " ", "of", " ", "two", " ", 
       "charges", " ", "at", " ", "one", " ", "point", " ", "in", " ", "the", 
       " ", "channel", " ", "k"}], ":", " ", 
      RowBox[{
       RowBox[{"sum_ab", " ", "conj", 
        RowBox[{"(", "k_ab", ")"}], " ", 
        RowBox[{"c_a", "^", "dag"}], " ", 
        RowBox[{"c_b", "^", "dag"}]}], " ", "|", 
       RowBox[{"0", ">"}]}]}], ";", "\n", "   ", 
     RowBox[{
      RowBox[{"the", " ", "empty", " ", "state"}], " ", "|", 
      RowBox[{"0", ">", " ", 
       RowBox[{
       "is", " ", "the", " ", "first", " ", "basis", " ", "state"}]}]}]}], 
    " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"pairState", "[", "k_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"op", ",", " ", "w"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"op", " ", "=", " ", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"k", "[", 
               RowBox[{"[", 
                RowBox[{"a", ",", " ", "b"}], "]"}], "]"}], " ", "=!=", " ", 
              "0"}], ",", " ", 
             RowBox[{
              RowBox[{"Conjugate", "[", 
               RowBox[{"k", "[", 
                RowBox[{"[", 
                 RowBox[{"a", ",", " ", "b"}], "]"}], "]"}], "]"}], " ", 
              RowBox[{
               RowBox[{"cdOps", "[", 
                RowBox[{"[", "a", "]"}], "]"}], " ", ".", " ", 
               RowBox[{"cdOps", "[", 
                RowBox[{"[", "b", "]"}], "]"}]}]}], ",", " ", "0"}], "]"}], ",",
            " ", 
           RowBox[{"{", 
            RowBox[{"a", ",", " ", "8"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"b", ",", " ", "8"}], "}"}]}], "]"}]}], ";", "\n", "   ", 
        
        RowBox[{"w", " ", "=", " ", 
         RowBox[{"op", " ", ".", " ", 
          RowBox[{"UnitVector", "[", 
           RowBox[{"256", ",", " ", "1"}], "]"}]}]}], ";", "\n", "   ", 
        RowBox[{"w", "/", 
         RowBox[{"Norm", "[", "w", "]"}]}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"the", " ", "seven", " ", "contact", " ", 
     RowBox[{"operators", ":", " ", 
      RowBox[{
      "the", " ", "three", " ", "terms", " ", "of", " ", "the", " ", 
       "potentials", " ", "and", " ", "the", " ", "contact", " ", "limit", " ",
        "of", " ", "the", " ", "four", " ", "gauge", " ", "bosons"}]}]}], " ",
     "*)"}], "\n", 
   RowBox[{
    RowBox[{"channelOps", " ", "=", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<scalar\>\"", " ", "->", " ", 
        RowBox[{
         RowBox[{"1", "/", "2"}], " ", 
         RowBox[{"quartic", "[", 
