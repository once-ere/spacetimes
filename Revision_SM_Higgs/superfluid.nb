Cell[CellGroupData[{

Cell["\<\
II.4 The first excited states: the linear response of the superfluid\
\>", "Section",ExpressionUUID->"8a7a05c3-8e9f-4d4c-9027-4f536b1509a3"],

Cell[TextData[{
 "A small change of the self-energies with the time dependence ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     RowBox[{"-", 
      StyleBox["i", "TI"]}], "\[Omega]", 
     StyleBox["t", "TI"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c1cf1616-a4f1-4c42-ae3f-902905d578b6"],
 " is described by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["V",
      FontSlant->"Plain"]], "\[LongEqual]", "120"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "90ffa7f4-b6b5-42da-8c13-c01b7ebfbf6a"],
 " complex amplitudes: the 64 entries of a change ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", 
    StyleBox["N",
     FontFamily->"Helvetica",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6c4c43df-d7c7-46f1-bc99-59063f90658f"],
 " of the normal self-energy and the 28 independent entries of each of two \
antisymmetric changes of the pair self-energy (",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", 
    StyleBox["P",
     FontFamily->"Helvetica",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "af8c1734-29c9-48b1-9c9b-800a4ac5d9d6"],
 " and the change of its adjoint). The change of the state in answer to a \
change of the self-energies is the response ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Chi]", 
    RowBox[{"(", "\[Omega]", ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4e125ba0-650c-4e30-a984-6bc3d5c119a1"],
 ", a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"120", "\[Times]", "120"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f890f36d-079e-423d-af18-f138b59ffb2d"],
 " matrix,"
}], "Text",ExpressionUUID->"e46c7465-f18a-469e-816c-43633d0774c6"],

Cell[BoxData[
 FormBox[
  RowBox[{"\[Chi]", 
   RowBox[{"(", "\[Omega]", ")"}], "\[LongEqual]", 
   UnderscriptBox["\[Sum]", 
    StyleBox["n", "TI"],
    LimitsPositioning->True], 
   RowBox[{"(", 
    RowBox[{
     FractionBox[
      SubscriptBox[
       StyleBox["A",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["n", "TI"]], 
      RowBox[{"\[Omega]", "-", 
       SubscriptBox["\[CapitalOmega]", 
        StyleBox["n", "TI"]]}]], "-", 
     FractionBox[
      SubscriptBox[
       StyleBox["B",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["n", "TI"]], 
      RowBox[{"\[Omega]", "+", 
       SubscriptBox["\[CapitalOmega]", 
        StyleBox["n", "TI"]]}]]}], ")"}], ","}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"da351c1e-d906-413c-b636-745df2d3238a"],

Cell[TextData[{
 "a sum over the momenta ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4e31d884-38ef-4f33-9655-76b05b56dbce"],
 " of the grid, where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalOmega]", 
     StyleBox["n", "TI"]], "\[LongEqual]", "2", 
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["n", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b6ecc146-0a1b-411b-894f-d6a2955b9d7f"],
 " is the energy of a pair of quasi-particles at the momentum ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8e94c77a-399b-4176-b103-db139868f2dc"],
 " (for these states every eigenvalue of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["H",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "84c17474-884c-488b-8dc3-5634b014ec1e"],
 " at a momentum is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["n", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "aa28d07a-d8ff-4abb-9847-665cbc8bad41"],
 ", which the cell checks) and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["A",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "907ffb9b-04da-44b5-8081-56d93d529705"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["B",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "356dddc8-bc3f-4f3f-bf68-6c2f07b1b123"],
 " are built from the eigenvectors (the creation of two quasi-particles and \
its reverse). The self-energies change by ",
 Cell[BoxData[
  FormBox[
   StyleBox["F",
    FontFamily->"Helvetica",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6f18d86e-6bc8-4cce-a840-c216f6a2fb26"],
 " times the change of the state, where ",
 Cell[BoxData[
  FormBox[
   StyleBox["F",
    FontFamily->"Helvetica",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2c29a14a-7dbe-49df-a7eb-cbea46ed419d"],
 " is the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"120", "\[Times]", "120"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "95c8e4af-c1f4-4893-9343-b615fd31b814"],
 " matrix of the self-energy maps of the contact terms (",
 StyleBox["respKernel",
  FontFamily->"Source Code Pro"],
 "). A collective mode of frequency ",
 Cell[BoxData[
  FormBox["\[Omega]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b34c0959-18d7-4d2c-a46a-aed4f5ca1505"],
 " is a solution of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", "\[LongEqual]", "\[Chi]", 
    RowBox[{"(", "\[Omega]", ")"}], 
    StyleBox["F",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "\[Delta]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bcb61841-3378-4de0-8416-6ee2ef86f9ac"],
 ": the matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["M",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{"(", "\[Omega]", ")"}], "\[LongEqual]", "\[Chi]", 
    RowBox[{"(", "\[Omega]", ")"}], 
    StyleBox["F",
     FontFamily->"Helvetica",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1e7942d3-9350-4df3-a20b-b2057acf1e27"],
 " has the eigenvalue 1. At ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Omega]", "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "09721aee-ee47-43b1-8e7e-0d130d808580"],
 " the three broken generators give three Goldstone modes: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["M",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{"(", "0", ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3527415d-b6d8-49a2-b216-9a15b605f544"],
 " has the eigenvalue 1 three times. Below the threshold ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["min",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{"2", 
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["gap",
         FontSlant->"Plain"]}]], ",", 
      UnderscriptBox[
       StyleBox["min",
        FontSlant->"Plain"], 
       StyleBox["n", "TI"],
       LimitsPositioning->True], "\[ThinSpace]", 
      SubscriptBox["\[CapitalOmega]", 
       StyleBox["n", "TI"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5f1eb220-fc9b-4e18-b7b2-bf707e61462a"],
 " the modes are found where the number of real eigenvalues of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["M",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{"(", "\[Omega]", ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "392ae25d-ae12-43d0-a0db-00c84727ee93"],
 " above 1 changes: a scan of 300 frequencies, then 45 bisections for each \
change. The cell does this for HS ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"1", ",", "1"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "51c066b8-caef-4326-9b39-89e7a132773f"],
 ", KS and CJT with ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "2", ")"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ff9ff277-7324-49c5-a784-d2831ae99ad1"],
 ", and compares the modes with the Rust program."
}], "Text",ExpressionUUID->"0f32ef9b-b7f4-44f8-a80e-65baefb21d23"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", "28", " ", "pairs", " ", 
     RowBox[{"(", 
      RowBox[{"i", ",", " ", "j"}], ")"}]}], ",", " ", 
    RowBox[{"i", " ", "<", " ", "j"}], ",", " ", 
    RowBox[{"of", " ", "the", " ", "antisymmetric", " ", "matrices"}], ",", 
    " ", 
    RowBox[{
    "in", " ", "the", " ", "order", " ", "of", " ", "the", " ", "rows"}]}], 
   " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"pairsSF", " ", "=", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
