Cell[CellGroupData[{

Cell["\<\
R.3.4 The scale in GeV and the comparison with the Standard Model (check WH-4)\
\>", "Subsection",ExpressionUUID->"4672e8d1-5bbd-4184-b580-e4b6f8fbf6f5"],

Cell[TextData[{
 "The model has the unit ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0a767b40-52b4-4195-951c-2f65145ec33e"],
 ". Setting ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["v", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3e6669d4-59e0-4665-8df7-5a3f05349008"],
 " equal to the scale ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["v", "TI"], "\[LongEqual]", "246.22"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "48e834fb-6490-4e79-acaa-81bd4d84df5e"],
 " GeV of the Standard Model fixes the cutoff, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    StyleBox["v", "TI"], "/", 
    SubscriptBox[
     StyleBox["v", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6c87abf5-edf0-4d8f-bd88-3a0f7d1c2bb3"],
 " in GeV, and converts the frequency of the amplitude mode into the mass ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["H",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubsuperscriptBox["\[Omega]", 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["H",
      FontSlant->"Plain"]], 
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a29f441a-45e8-4811-aa29-4a01be77f1e3"],
 ", with the ratio ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["H",
      FontSlant->"Plain"]], "/", 
    StyleBox["v", "TI"], "\[LongEqual]", 
    SubsuperscriptBox["\[Omega]", 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["H",
      FontSlant->"Plain"]], "/", 
    SubscriptBox[
     StyleBox["v", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7f91dc48-9ca8-4fb0-9c76-d31c5ab808af"],
 " independent of the conversion. The Standard Model has ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["H", "TI"]], "/", 
    StyleBox["v", "TI"], "\[LongEqual]", "125.13", "/", "246.22"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "51c1f10c-927d-475b-8770-082608895c96"],
 ". The cell checks every row of the table of masses of the Rust program in \
exact rational arithmetic on its numbers and prints the range of the ratios."
}], "Text",ExpressionUUID->"1c86db9f-4e31-4797-a269-8dd84a209f9d"],

