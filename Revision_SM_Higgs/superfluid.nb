Cell[CellGroupData[{

Cell["\<\
III.T.6 The size of the order parameter, Landau's theory, and the answer\
\>", "Section",ExpressionUUID->"1f3b42f3-0541-42b6-b888-748ba896d20b"],

Cell[TextData[{
 StyleBox["The radius of convergence.",
  FontWeight->"Bold"],
 " The free energy is built from integrals over the momenta of functions of \
the quasi-particle energies ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["E", "TI"], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        StyleBox["q", "TI"], "2"], "+", 
       SuperscriptBox[
        StyleBox["M", "TI"], "2"], "+", 
       SubsuperscriptBox["\[CapitalPhi]", 
        StyleBox["a",
         FontSlant->"Plain"], "2"]}], ")"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6cfd5cd3-e6f2-4815-8df4-e2c5eae5b2f7"],
 " and of their Fermi functions: the terms ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     StyleBox["T", "TI"]}], "\[ThinSpace]", 
    StyleBox["ln",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{"2", "\[ThinSpace]", 
      StyleBox["cosh",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       RowBox[{
        StyleBox["E", "TI"], "/", "2", 
        StyleBox["T", "TI"]}], ")"}]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "846b3a6a-2625-419b-925a-184a685db1fc"],
 ", one for each pair of eigenvalues ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    StyleBox["E", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4518d1de-f064-4ffe-95fc-0aac69ee2a7a"],
 " (at the Fermi occupation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["f", "TI"], "\[LongEqual]", 
    StyleBox["f", "TI"], 
    RowBox[{"(", 
     StyleBox["E", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e1ffe676-9083-4a0a-956f-4d23878e5467"],
 " the energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["E", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["f", "TI"], "-", 
      FractionBox["1", "2"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e6eafb97-4e15-4eca-bc4d-2c14a9763019"],
 " of the pair and its term ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], 
    RowBox[{"[", 
     RowBox[{
      StyleBox["f", "TI"], "\[ThinSpace]", 
      StyleBox["ln",
       FontSlant->"Plain"], "\[ThinSpace]", 
      StyleBox["f", "TI"], "+", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        StyleBox["f", "TI"]}], ")"}], "\[ThinSpace]", 
      StyleBox["ln",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        StyleBox["f", "TI"]}], ")"}]}], "]"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "eb2eb7bc-d357-4fa8-8131-2338adc1db1a"],
 " in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     StyleBox["T", "TI"]}], 
    SubscriptBox[
     StyleBox["\[ScriptCapitalS]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5e141498-ae95-4e13-b86d-6f212b2157d6"],
 " add up to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     StyleBox["T", "TI"]}], "\[ThinSpace]", 
    StyleBox["ln",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{"2", "\[ThinSpace]", 
      StyleBox["cosh",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       RowBox[{
        StyleBox["E", "TI"], "/", "2", 
        StyleBox["T", "TI"]}], ")"}]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a9417eaa-dddb-4a51-8b71-597bde99798f"],
 "), and the densities with the factor ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["tanh",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["E", "TI"], "/", "2", 
      StyleBox["T", "TI"]}], ")"}], "/", 
    StyleBox["E", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "648dd152-be42-4ddf-8b1b-e3a326855aca"],
 ". With the Matsubara frequencies ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Omega]", 
     StyleBox["n", "TI"]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{"2", 
      StyleBox["n", "TI"], "+", "1"}], ")"}], "\[Pi]", 
    StyleBox["T", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f2955ea0-fbab-44b1-9b3d-c6f37899edaa"],
 " they become sums over ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "0", ",", "1", ",", "2", ",", 
    "\[Ellipsis]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ef3f7f80-77b3-44a1-b0f6-3e531774a3fc"],
 ","
}], "Text",ExpressionUUID->"52d970c3-e17a-4950-84ca-7cef93eb2281"],

Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox["ln",
    FontSlant->"Plain"], 
   RowBox[{"(", 
    RowBox[{"2", "\[ThinSpace]", 
     StyleBox["cosh",
      FontSlant->"Plain"], 
     RowBox[{"(", 
      RowBox[{
       StyleBox["E", "TI"], "/", "2", 
       StyleBox["T", "TI"]}], ")"}]}], ")"}], "\[LongEqual]", 
   StyleBox["ln",
    FontSlant->"Plain"], "\[ThinSpace]", "2", "+", 
   UnderoverscriptBox["\[Sum]", 
    RowBox[{
     StyleBox["n", "TI"], "\[LongEqual]", "0"}], "\[Infinity]",
    LimitsPositioning->True], "\[ThinSpace]", 
   StyleBox["ln",
    FontSlant->"Plain"], 
   RowBox[{"(", 
    RowBox[{"1", "+", 
     FractionBox[
      SuperscriptBox[
       StyleBox["E", "TI"], "2"], 
      SubsuperscriptBox["\[Omega]", 
       StyleBox["n", "TI"], "2"]]}], ")"}], ",", "      ", 
   FractionBox[
    RowBox[{
     StyleBox["tanh",
      FontSlant->"Plain"], 
     RowBox[{"(", 
      RowBox[{
       StyleBox["E", "TI"], "/", "2", 
       StyleBox["T", "TI"]}], ")"}]}], 
    StyleBox["E", "TI"]], "\[LongEqual]", "4", 
   StyleBox["T", "TI"], "\[ThinSpace]", 
   UnderoverscriptBox["\[Sum]", 
    RowBox[{
     StyleBox["n", "TI"], "\[LongEqual]", "0"}], "\[Infinity]",
    LimitsPositioning->True], "\[ThinSpace]", 
   FractionBox["1", 
    RowBox[{
     SubsuperscriptBox["\[Omega]", 
      StyleBox["n", "TI"], "2"], "+", 
     SuperscriptBox[
      StyleBox["E", "TI"], "2"]}]], ","}], TraditionalForm]], "DisplayFormula",\

 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"e925a56b-12de-4a53-b423-38b44fe4afb4"],

Cell[TextData[{
 "of functions of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Omega]", 
     StyleBox["n", "TI"], "2"], "+", 
    SuperscriptBox[
     StyleBox["q", "TI"], "2"], "+", 
    SuperscriptBox[
     StyleBox["M", "TI"], "2"], "+", 
    SubsuperscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d7ba1b38-ebb9-40ed-81f2-8b2aa15264a5"],
 ". Integrated over the momenta, each is singular where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Omega]", 
     StyleBox["n", "TI"], "2"], "+", 
    SuperscriptBox[
     StyleBox["M", "TI"], "2"], "+", 
    SubsuperscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"], "2"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c33f4e2a-f854-4632-820f-d27f44362a3f"],
 " (at the end ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["q", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8650f2a2-948b-46f2-b023-c90ce3d536e2"],
 " of the integral); the nearest of these points to the origin, for the Dirac \
mass of the normal state held fixed, is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"], "2"], "\[LongEqual]", 
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["M", "TI"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["X", "TI"], ",", 
         StyleBox["n",
          FontSlant->"Plain"]}]], 
       SuperscriptBox[
        RowBox[{"(", 
         StyleBox["T", "TI"], ")"}], "2"], "+", 
       SuperscriptBox["\[Pi]", "2"], 
       SuperscriptBox[
        StyleBox["T", "TI"], "2"]}], ")"}]}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "30bda12b-8278-4afe-98e4-b12f92534631"],
 ", and at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9fb859ad-b70c-470a-8c52-f324be226ca3"],
 " it is the point ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"], "2"], "\[LongEqual]", 
    RowBox[{"-", 
     SubsuperscriptBox[
      StyleBox["m", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], "2"]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f787a191-237c-485a-91a9-bdf225ff45fe"],
 " of Section III.L.5. The series of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalF]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "eb3f8b91-e058-4d74-903a-855aecc9abbc"],
 " in powers of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0415aad9-ca2f-4164-ab0b-9b3b8adc4b48"],
 " about the normal state therefore converges within a radius of the order \
of"
}], "Text",ExpressionUUID->"c73dc622-726c-4f3a-b976-b8c483ed5c96"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], 
   RowBox[{"(", 
    StyleBox["T", "TI"], ")"}], "\[LongEqual]", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["n",
         FontSlant->"Plain"]}]], 
      SuperscriptBox[
       RowBox[{"(", 
        StyleBox["T", "TI"], ")"}], "2"], "+", 
      SuperscriptBox["\[Pi]", "2"], 
      SuperscriptBox[
       StyleBox["T", "TI"], "2"]}], ")"}], 
    RowBox[{"1", "/", "2"}]], ","}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"b0b5aeaf-de87-46fa-aaf4-be398de9b814"],

Cell[TextData[{
 "not exactly equal to it (the Dirac mass changes with the applied field \
where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["S",
       FontSlant->"Plain"]}]], "\[NotEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "886fb643-7f27-4203-92dc-c2dee4f8aa93"],
 ", and the field of the states is not the applied field). Because ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "286841a9-48a1-4722-acce-938a379eb4d9"],
 " is an estimate, the answer rests also on two direct measures that do not \
use it. ",
 StyleBox["Landau's theory",
  FontWeight->"Bold"],
 " expands the free energy at the symmetric state, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalF]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["Tay",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}], 
    SuperscriptBox["\[CapitalPhi]", "2"], "+", 
    SubsuperscriptBox[
     StyleBox["b", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["Tay",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}], 
    SuperscriptBox["\[CapitalPhi]", "4"], "+", "\[Ellipsis]"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b3e25240-43c4-4c39-9b0e-c46570e71a14"],
 " along the polar fields, and predicts the order parameter ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       StyleBox["a", "TI"]}], "/", "2", 
      StyleBox["b", "TI"]}], ")"}], 
    RowBox[{"1", "/", "2"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fb03e99e-0c86-4c22-ac94-5b754ea2136f"],
 ", with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["Tay",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "360b6f3e-6dca-4473-bfab-c7c21648c7dc"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["b", "TI"], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["b", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["Tay",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "02b576c4-020d-4fdd-b92c-0f56d0a7042b"],
 ". The next cell computes them for CJT at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.9", "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["CJT",
       FontSlant->"Plain"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1c858989-fa28-47de-ab31-fcf4dc7d0e9b"],
 " from the thermal states of four small applied fields, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"]], "\[LongEqual]", "0.01"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3ae4f1fb-24ae-4826-95b9-185d920e1114"],
 " to ",
 Cell[BoxData[
  FormBox["0.04", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e398d151-9e77-47f8-9520-225f10a32712"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalF]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], "/", 
    SuperscriptBox["\[CapitalPhi]", "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9c6b0fe6-b103-4e18-9d9f-a02cc357a1a2"],
 " interpolated exactly by a cubic polynomial in ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CapitalPhi]", "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "661d4bc6-a0eb-42d3-9c04-cdac36b0cd44"],
 ", whose value and slope at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[CapitalPhi]", "2"], "\[LongEqual]", "0"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "14f87e66-74f0-43a2-8b7e-30877997b60f"],
 " are ",
 Cell[BoxData[
  FormBox[
   StyleBox["a", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2c92400a-5913-469d-8744-b046fd2f56ad"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["b", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "95e5c401-0997-409b-a599-c6dfd5352a61"],
 "). The cell after it fits the ",
 StyleBox["Landau form",
  FontWeight->"Bold"],
 " of Section III.L (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], 
    SuperscriptBox["\[CapitalPhi]", "2"], "+", 
    StyleBox["b", "TI"], 
    SuperscriptBox["\[CapitalPhi]", "4"], "+", 
    StyleBox["c", "TI"], 
    SuperscriptBox["\[CapitalPhi]", "6"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8801f7a0-a350-400d-af1b-6ab056915b91"],
 ") and the quartic form (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], 
    SuperscriptBox["\[CapitalPhi]", "2"], "+", 
    StyleBox["b", "TI"], 
    SuperscriptBox["\[CapitalPhi]", "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4f7040d3-a368-4eeb-8a23-19b54f7bda01"],
 ") to the free-energy curves of the Rust program at six temperatures, with \
the least squares of Section III.L.4."
}], "Text",ExpressionUUID->"597cf929-1ab7-403e-be08-cc262a80eff4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", "Taylor", " ", "coefficients", " ", "a"}], ",", " ", 
    RowBox[{
    "b", " ", "of", " ", "the", " ", "free", " ", "energy", " ", "of", " ", 
     "CJT", " ", "at", " ", "0.9", " ", "T_c", " ", "at", " ", "the", " ", 
     "origin"}], ",", " ", 
    RowBox[{"and", " ", "the", " ", "order", " ", "parameter", " ", "of", " ", 
     RowBox[{"Landau", "'"}], "s", " ", "theory"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"mo", " ", "=", " ", 
        RowBox[{"thModel", "[", "\"\<CJT\>\"", "]"}]}], ",", " ", 
       RowBox[{"temp", " ", "=", " ", 
        RowBox[{"thGet", "[", 
         RowBox[{"\"\<CJT\>\"", ",", " ", "0.9", ",", " ", "\"\<T\>\""}], 
         "]"}]}], ",", " ", 
       RowBox[{"nn", " ", "=", " ", 
        RowBox[{
         RowBox[{"thSF", "[", "0.9", "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", "n0", ",", " ", 
       RowBox[{"xs", " ", "=", " ", 
        RowBox[{"{", "}"}]}], ",", " ", 
       RowBox[{"ys", " ", "=", " ", 
        RowBox[{"{", "}"}]}], ",", " ", "c", ",", " ", "a", ",", " ", "b", ",",
        " ", "err", ",", " ", "errRust"}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"n0", " ", "=", " ", 
       RowBox[{"nn", "[", "\"\<n\>\"", "]"}]}], ";", "\n", "  ", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"res", " ", "=", " ", 
            RowBox[{"fixedPairT", "[", 
             RowBox[{"mo", ",", " ", 
              RowBox[{"fa", " ", 
               RowBox[{"ConjugateTranspose", "[", 
                RowBox[{"k8", "[", "3", "]"}], "]"}]}], ",", " ", "n0", ",", 
              " ", "temp"}], "]"}]}], "}"}], ",", "\n", "     ", 
          RowBox[{
           RowBox[{"n0", " ", "=", " ", 
            RowBox[{"res", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", "     ", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"xs", ",", " ", 
             RowBox[{
              RowBox[{"res", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "^", "2"}]}], "]"}], ";", " ", 
           
           RowBox[{"AppendTo", "[", 
            RowBox[{"ys", ",", " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"res", "[", 
                 RowBox[{"[", "3", "]"}], "]"}], " ", "-", " ", 
                RowBox[{"nn", "[", "\"\<free\>\"", "]"}]}], ")"}], "/", 
              RowBox[{
               RowBox[{"res", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "^", "2"}]}]}], "]"}]}]}], 
         "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"fa", ",", " ", 
          RowBox[{"{", 
           RowBox[{
           "0.01", ",", " ", "0.02", ",", " ", "0.03", ",", " ", "0.04"}], 
           "}"}]}], "}"}]}], "]"}], ";", "\n", "  ", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
        "the", " ", "cubic", " ", "polynomial", " ", "in", " ", "the", " ", 
         "scaled", " ", "variable", " ", 
         RowBox[{"x", "/", "xmax"}]}], ",", " ", 
        RowBox[{
         RowBox[{
         "whose", " ", "matrix", " ", "is", " ", "well", " ", "conditioned"}],
          ";", " ", 
         RowBox[{"then", " ", "back", " ", "to", " ", "a"}]}], ",", " ", 
        "b"}], " ", "*)"}], "\n", "  ", 
      RowBox[{"c", " ", "=", " ", 
       RowBox[{"LinearSolve", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"x", "/", 
              RowBox[{"Max", "[", "xs", "]"}]}], ")"}], "^", "k"}], ",", " ", 
           
           RowBox[{"{", 
            RowBox[{"x", ",", " ", "xs"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"k", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}], ",", 
         " ", "ys"}], "]"}]}], ";", "\n", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "b"}], "}"}], " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"c", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
         RowBox[{
          RowBox[{"c", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "/", 
          RowBox[{"Max", "[", "xs", "]"}]}]}], "}"}]}], ";", "\n", "  ", 
      RowBox[{"err", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{"-", "a"}], "/", 
           RowBox[{"(", 
            RowBox[{"2", " ", "b"}], ")"}]}], "]"}], "/", 
         RowBox[{"thGet", "[", 
          RowBox[{"\"\<CJT\>\"", ",", " ", "0.9", ",", " ", "\"\<Phi0\>\""}], 
          "]"}]}], " ", "-", " ", "1"}]}], ";", "\n", "  ", 
      RowBox[{"errRust", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"thGet", "[", 
          RowBox[{"\"\<CJT\>\"", ",", " ", "0.9", ",", " ", "\"\<phiL\>\""}], 
          "]"}], "/", 
         RowBox[{"thGet", "[", 
          RowBox[{"\"\<CJT\>\"", ",", " ", "0.9", ",", " ", "\"\<Phi0\>\""}], 
          "]"}]}], " ", "-", " ", "1"}]}], ";", "\n", "  ", 
      RowBox[{"check", "[", 
       RowBox[{"\"\<WP3-T5 CJT\>\"", ",", " ", 
        RowBox[{"\"\<CJT at 0.9 T_c: the Taylor coefficients a = \>\"", " ", "<>",
          " ", 
         RowBox[{"ToString", "[", 
          RowBox[{"NumberForm", "[", 
           RowBox[{"a", ",", " ", "8"}], "]"}], "]"}], " ", "<>", 
         " ", "\"\<, b = \>\"", " ", "<>", " ", 
         RowBox[{"ToString", "[", 
          RowBox[{"NumberForm", "[", 
           RowBox[{"b", ",", " ", "8"}], "]"}], "]"}], " ", "<>", 
         " ", "\"\< of the free energy at the origin and the error \>\"", " ",
          "<>", " ", 
         RowBox[{"sci", "[", "err", "]"}], " ", "<>", 
         " ", "\"\< of the order parameter (-a/2b)^(1/2) of Landau's theory (\
\>\"", " ", "<>", " ", 
         RowBox[{"ToString", "[", 
          RowBox[{"NumberForm", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", "err", "]"}], "/", "0.1"}], ",", " ", "3"}], 
           "]"}], "]"}], " ", "<>", 
         " ", "\"\< times 1 - T/T_c) = Rust (largest relative difference of a \
and b, difference of the error)\>\""}], ",", "\n", "   ", 
        RowBox[{"Max", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"a", " ", "-", " ", 
             RowBox[{"thGet", "[", 
              RowBox[{"\"\<CJT\>\"", ",", " ", "0.9", ",", " ", "\"\<a\>\""}],
               "]"}]}], "]"}], "/", 
           RowBox[{"Abs", "[", 
            RowBox[{"thGet", "[", 
             RowBox[{"\"\<CJT\>\"", ",", " ", "0.9", ",", " ", "\"\<a\>\""}], 
             "]"}], "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"b", " ", "-", " ", 
             RowBox[{"thGet", "[", 
              RowBox[{"\"\<CJT\>\"", ",", " ", "0.9", ",", " ", "\"\<b\>\""}],
               "]"}]}], "]"}], "/", 
           RowBox[{"Abs", "[", 
            RowBox[{"thGet", "[", 
             RowBox[{"\"\<CJT\>\"", ",", " ", "0.9", ",", " ", "\"\<b\>\""}], 
             "]"}], "]"}]}], ",", " ", 
          RowBox[{"Abs", "[", 
           RowBox[{"err", " ", "-", " ", "errRust"}], "]"}]}], "]"}], ",", 
        " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "5"}]}], ",", " ", "\"\<P3-T5 CJT\>\"", ",", 
        " ", "\"\<YP3-T5 CJT\>\""}], "]"}]}]}], "]"}], ";"}]}]], "Input",
 CellLabel->
  "In[348]:=",ExpressionUUID->"1c6d5735-76fc-40cf-84a3-d46dfaa0618e"],

