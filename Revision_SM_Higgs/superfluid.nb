Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"gzI1D", "[", 
     RowBox[{"mo", ",", " ", "m", ",", " ", "temp"}], "]"}], ":", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"I1", ",", " ", 
       RowBox[{"dI1", "/", "dT"}], ",", " ", 
       RowBox[{"dI1", "/", "dM"}]}], "}"}], " ", "on", " ", "the", " ", 
     "radial", " ", "nodes", " ", "of", " ", "the", " ", "grid", " ", "of", " ",
      "the", " ", "model", " ", "mo", " ", 
     RowBox[{"(", 
      RowBox[{"temp", " ", ">", " ", "0"}], ")"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"gzI1D", "[", 
      RowBox[{"mo_", ",", " ", "m_", ",", " ", "temp_"}], "]"}], " ", ":=", 
     " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"kr", " ", "=", " ", 
          RowBox[{
           RowBox[{"mo", "[", "\"\<g\>\"", "]"}], "[", "\"\<kr\>\"", "]"}]}], 
         ",", " ", 
         RowBox[{"wr", " ", "=", " ", 
          RowBox[{
           RowBox[{"mo", "[", "\"\<g\>\"", "]"}], "[", "\"\<wr\>\"", "]"}]}], 
         ",", " ", "e", ",", " ", "x"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"e", " ", "=", " ", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{"kr", "^", "2"}], " ", "+", " ", 
           RowBox[{"m", "^", "2"}]}], "]"}]}], ";", " ", 
        RowBox[{"x", " ", "=", " ", 
         RowBox[{"e", "/", 
          RowBox[{"(", 
           RowBox[{"2", " ", "temp"}], ")"}]}]}], ";", "\n", "   ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Total", "[", 
           RowBox[{"wr", " ", 
            RowBox[{"kr", "^", "2"}], " ", 
            RowBox[{
             RowBox[{"Tanh", "[", "x", "]"}], "/", "e"}]}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"Total", "[", 
             RowBox[{"wr", " ", 
              RowBox[{"kr", "^", "2"}], " ", 
              RowBox[{
               RowBox[{"Sech", "[", "x", "]"}], "^", "2"}]}], "]"}]}], "/", 
           RowBox[{"(", 
            RowBox[{"2", " ", 
             RowBox[{"temp", "^", "2"}]}], ")"}]}], ",", " ", 
          RowBox[{"Total", "[", 
           RowBox[{"wr", " ", 
            RowBox[{"kr", "^", "2"}], " ", 
            RowBox[{"(", 
             RowBox[{"m", "/", "e"}], ")"}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"Sech", "[", "x", "]"}], "^", "2"}], "/", 
               RowBox[{"(", 
                RowBox[{"2", " ", "temp", " ", "e"}], ")"}]}], " ", "-", " ", 
              
              RowBox[{
               RowBox[{"Tanh", "[", "x", "]"}], "/", 
               RowBox[{"e", "^", "2"}]}]}], ")"}]}], "]"}]}], "}"}]}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"gzAlphaClosed", "[", "t", "]"}], ":", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"alpha", ",", " ", 
        RowBox[{
         RowBox[{"lambda", "^", "P"}], 
         RowBox[{"(", "T_c", ")"}]}], ",", " ", 
        RowBox[{"M_n", 
         RowBox[{"(", "T_c", ")"}]}]}], "}"}], " ", "in", " ", "closed", " ", 
      "form", " ", "at", " ", "the", " ", "critical", " ", "temperature", " ",
       "of", " ", "the", " ", "notebook"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"gzAlphaClosed", "[", "t_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"mo", " ", "=", " ", 
          RowBox[{"thModel", "[", "t", "]"}]}], ",", " ", 
         RowBox[{"tc", " ", "=", " ", 
          RowBox[{"thTc", "[", "t", "]"}]}], ",", " ", "gs", ",", " ", "gp", ",",
          " ", "mn", ",", " ", "i1", ",", " ", "i1t", ",", " ", "i1m", ",", 
         " ", "i10", ",", " ", "dnt", ",", " ", "dnm", ",", " ", "dmt", ",", 
         " ", "lam", ",", " ", "dlam"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"gs", ",", " ", "gp"}], "}"}], " ", "=", " ", 
         RowBox[{"thCoup", "[", "t", "]"}]}], ";", "\n", "   ", 
        RowBox[{"mn", " ", "=", " ", 
         RowBox[{"thMassN", "[", 
          RowBox[{"t", ",", " ", "tc"}], "]"}]}], ";", "\n", "   ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"i1", ",", " ", "i1t", ",", " ", "i1m"}], "}"}], " ", "=", 
         " ", 
         RowBox[{"gzI1D", "[", 
          RowBox[{"mo", ",", " ", "mn", ",", " ", "tc"}], "]"}]}], ";", "\n", 
        "   ", 
        RowBox[{"dnt", " ", "=", " ", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{"2", "/", 
             RowBox[{"Pi", "^", "2"}]}], ")"}]}], " ", "mn", " ", "i1t"}]}], ";",
         " ", 
        RowBox[{"dnm", " ", "=", " ", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{"2", "/", 
             RowBox[{"Pi", "^", "2"}]}], ")"}]}], " ", 
          RowBox[{"(", 
           RowBox[{"i1", " ", "+", " ", 
            RowBox[{"mn", " ", "i1m"}]}], ")"}]}]}], ";", "\n", "   ", 
        RowBox[{"dmt", " ", "=", " ", 
         RowBox[{"gs", " ", 
          RowBox[{"dnt", "/", 
           RowBox[{"(", 
            RowBox[{"1", " ", "-", " ", 
             RowBox[{"gs", " ", "dnm"}]}], ")"}]}]}]}], ";", "\n", "   ", 
        RowBox[{"lam", " ", "=", " ", 
         RowBox[{"gp", " ", 
          RowBox[{"i1", "/", 
           RowBox[{"Pi", "^", "2"}]}]}]}], ";", " ", 
        RowBox[{"dlam", " ", "=", " ", 
         RowBox[{"gp", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"i1t", " ", "+", " ", 
             RowBox[{"i1m", " ", "dmt"}]}], ")"}], "/", 
           RowBox[{"Pi", "^", "2"}]}]}]}], ";", "\n", "   ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "tc"}], " ", 
           RowBox[{"dlam", "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"lam", "^", "2"}], " ", "gp"}], ")"}]}]}], ",", " ", 
          "lam", ",", " ", "mn"}], "}"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"gzResults", "[", "t", "]"}], ":", " ", 
      RowBox[{
      "the", " ", "results", " ", "of", " ", "the", " ", "method", " ", "t", " ", 
       RowBox[{"(", "association", ")"}]}]}], ",", " ", 
     RowBox[{
     "filled", " ", "by", " ", "the", " ", "cells", " ", "of", " ", "this", " ",
       "section", " ", "and", " ", "the", " ", "next"}]}], " ", "*)"}], "\n", 
   
   RowBox[{
    RowBox[{"gzResults", " ", "=", " ", 
     RowBox[{"<|", "|>"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"tc", " ", "=", " ", 
           RowBox[{"thTc", "[", "t", "]"}]}], ",", " ", 
          RowBox[{"gp", " ", "=", " ", 
           RowBox[{
            RowBox[{"thCoup", "[", "t", "]"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", 
          RowBox[{"t09", " ", "=", " ", 
           RowBox[{"thGet", "[", 
            RowBox[{"t", ",", " ", "0.9", ",", " ", "\"\<T\>\""}], "]"}]}], ",",
           " ", "a09", ",", " ", "at", ",", " ", 
          RowBox[{"worst", " ", "=", " ", "0."}], ",", " ", "ac", ",", " ", 
          "perp0", ",", " ", "d1", ",", " ", "d2", ",", " ", "alFD", ",", " ",
           "alCl", ",", " ", "lamC", ",", " ", "mnC"}], "}"}], ",", "\n", 
        "   ", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{"at", " ", "0.9", " ", "T_c"}], ",", " ", 
          RowBox[{
          "against", " ", "the", " ", "Taylor", " ", "coefficient", " ", "of",
            " ", "the", " ", "nonlinear", " ", "free", " ", "energy", " ", 
           "of", " ", "the", " ", "Rust", " ", "table"}]}], " ", "*)"}], "\n",
         "   ", 
        RowBox[{
         RowBox[{"a09", " ", "=", " ", 
          RowBox[{
           RowBox[{"gzA", "[", 
            RowBox[{"t", ",", " ", "t09", ",", " ", "0.", ",", " ", 
             RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ";", " ", 
         RowBox[{"at", " ", "=", " ", 
          RowBox[{"thGet", "[", 
           RowBox[{"t", ",", " ", "0.9", ",", " ", "\"\<a\>\""}], "]"}]}], ";",
          "\n", "   ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{"\"\<WP3-G1 \>\"", " ", "<>", " ", "t"}], ",", " ", 
           RowBox[{
            RowBox[{"thName", "[", "t", "]"}], " ", "<>", 
            " ", "\"\<: at 0.9 T_c the coefficient a(0) of |Phi|^2 from the \
static pair response (\>\"", " ", "<>", " ", 
            RowBox[{"sci", "[", "a09", "]"}], " ", "<>", 
            " ", "\"\<) equals the Taylor coefficient a^Tay of the nonlinear \
free energy of Section III.T (\>\"", " ", "<>", " ", 
            RowBox[{"sci", "[", "at", "]"}], " ", "<>", 
            " ", "\"\<) (relative difference)\>\""}], ",", "\n", "    ", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"a09", " ", "-", " ", "at"}], "]"}], "/", 
            RowBox[{"Abs", "[", "at", "]"}]}], ",", " ", 
           RowBox[{"10", "^", 
            RowBox[{"-", "7"}]}], ",", " ", 
           RowBox[{"\"\<P3-G1 \>\"", " ", "<>", " ", "t"}], ",", " ", 
           RowBox[{"\"\<YP3-G1 \>\"", " ", "<>", " ", "t"}]}], "]"}], ";", 
         "\n", "   ", 
         RowBox[{"(*", " ", 
          RowBox[{
          "the", " ", "closed", " ", "form", " ", "at", " ", "three", " ", 
           "temperatures"}], " ", "*)"}], "\n", "   ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"temp", " ", "=", " ", 
                RowBox[{"tau", " ", "tc"}]}], ",", " ", "a", ",", " ", 
               "lam"}], "}"}], ",", "\n", "      ", 
             RowBox[{
              RowBox[{"a", " ", "=", " ", 
               RowBox[{
                RowBox[{"gzA", "[", 
                 RowBox[{"t", ",", " ", "temp", ",", " ", "0.", ",", " ", 
                  RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}], "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], ";", " ", 
              RowBox[{"lam", " ", "=", " ", 
               RowBox[{"thLam", "[", 
                RowBox[{"t", ",", " ", "temp"}], "]"}]}], ";", "\n", "      ", 
              RowBox[{"worst", " ", "=", " ", 
               RowBox[{"Max", "[", 
                RowBox[{"worst", ",", " ", 
                 RowBox[{
                  RowBox[{"Abs", "[", 
                   RowBox[{"a", " ", "-", " ", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"1", " ", "-", " ", "lam"}], ")"}], "/", 
                    RowBox[{"(", 
                    RowBox[{"lam", " ", "gp"}], ")"}]}]}], "]"}], "/", 
                  RowBox[{"Abs", "[", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"1", " ", "-", " ", "lam"}], ")"}], "/", 
                    RowBox[{"(", 
                    RowBox[{"lam", " ", "gp"}], ")"}]}], "]"}]}]}], 
                "]"}]}]}]}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"tau", ",", " ", 
             RowBox[{"{", 
              RowBox[{"0.9", ",", " ", "0.998", ",", " ", "1.002"}], "}"}]}], 
            "}"}]}], "]"}], ";", "\n", "   ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{"\"\<WP3-G2 \>\"", " ", "<>", " ", "t"}], ",", " ", 
           RowBox[{
            RowBox[{"thName", "[", "t", "]"}], " ", "<>", 
            " ", "\"\<: a(0, T) = (1 - lambda^P(T))/(lambda^P(T) g^P) at \
T/T_c = 0.9, 0.998, 1.002, with lambda^P(T) of Section III.T.4 (largest \
relative difference)\>\""}], ",", "\n", "    ", "worst", ",", " ", 
           RowBox[{"10", "^", 
            RowBox[{"-", "9"}]}], ",", " ", 
           RowBox[{"\"\<P3-G2 \>\"", " ", "<>", " ", "t"}], ",", " ", 
           RowBox[{"\"\<YP3-G2 \>\"", " ", "<>", " ", "t"}]}], "]"}], ";", 
         "\n", "   ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{"the", " ", 
            RowBox[{"slope", ":", " ", 
             RowBox[{
             "central", " ", "differences", " ", "with", " ", "the", " ", 
              "Richardson", " ", "extrapolation"}]}]}], ",", " ", 
           RowBox[{"and", " ", "the", " ", "closed", " ", "form"}]}], " ", 
          "*)"}], "\n", "   ", 
         RowBox[{"d1", " ", "=", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"gzA", "[", 
               RowBox[{"t", ",", " ", 
                RowBox[{"1.002", " ", "tc"}], ",", " ", "0.", ",", " ", 
                RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", 
             RowBox[{
              RowBox[{"gzA", "[", 
               RowBox[{"t", ",", " ", 
                RowBox[{"0.998", " ", "tc"}], ",", " ", "0.", ",", " ", 
                RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"2", " ", "0.002", " ", "tc"}], ")"}]}]}], ";", "\n", 
         "   ", 
         RowBox[{"d2", " ", "=", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"gzA", "[", 
               RowBox[{"t", ",", " ", 
                RowBox[{"1.004", " ", "tc"}], ",", " ", "0.", ",", " ", 
                RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", 
             RowBox[{
              RowBox[{"gzA", "[", 
               RowBox[{"t", ",", " ", 
                RowBox[{"0.996", " ", "tc"}], ",", " ", "0.", ",", " ", 
                RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"2", " ", "0.004", " ", "tc"}], ")"}]}]}], ";", "\n", 
         "   ", 
         RowBox[{"alFD", " ", "=", " ", 
          RowBox[{"tc", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"4", " ", "d1"}], " ", "-", " ", "d2"}], ")"}], "/", 
            "3"}]}]}], ";", "\n", "   ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"alCl", ",", " ", "lamC", ",", " ", "mnC"}], "}"}], " ", "=",
           " ", 
          RowBox[{"gzAlphaClosed", "[", "t", "]"}]}], ";", "\n", "   ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{"\"\<WP3-G10 \>\"", " ", "<>", " ", "t"}], ",", " ", 
           RowBox[{
            RowBox[{"thName", "[", "t", "]"}], " ", "<>", 
            " ", "\"\<: alpha = T_c da/dT = \>\"", " ", "<>", " ", 
            RowBox[{"ToString", "[", 
             RowBox[{"NumberForm", "[", 
              RowBox[{"alFD", ",", " ", "10"}], "]"}], "]"}], " ", "<>", 
            " ", "\"\< from central differences of the static pair response \
(Richardson) = \>\"", " ", "<>", " ", 
            RowBox[{"ToString", "[", 
             RowBox[{"NumberForm", "[", 
              RowBox[{"alCl", ",", " ", "10"}], "]"}], "]"}], " ", "<>", 
            " ", "\"\< in closed form (lambda^P(T_c) = \>\"", " ", "<>", " ", 
            
            RowBox[{"ToString", "[", 
             RowBox[{"NumberForm", "[", 
              RowBox[{"lamC", ",", " ", "12"}], "]"}], "]"}], " ", "<>", 
            " ", "\"\<, M_n = \>\"", " ", "<>", " ", 
            RowBox[{"ToString", "[", 
             RowBox[{"NumberForm", "[", 
              RowBox[{"mnC", ",", " ", "10"}], "]"}], "]"}], " ", "<>", 
            " ", "\"\<) = Rust (largest relative difference)\>\""}], ",", 
           "\n", "    ", 
           RowBox[{"Max", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{"alFD", " ", "-", " ", "alCl"}], "]"}], "/", "alCl"}], 
             ",", " ", 
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{"alCl", " ", "-", " ", 
                RowBox[{"gzRust", "[", 
                 RowBox[{"t", ",", " ", "\"\<alpha\>\""}], "]"}]}], "]"}], "/", 
              RowBox[{"gzRust", "[", 
               RowBox[{"t", ",", " ", "\"\<alpha\>\""}], "]"}]}]}], "]"}], ",",
            " ", 
           RowBox[{"10", "^", 
            RowBox[{"-", "8"}]}], ",", " ", 
           RowBox[{"\"\<P3-G10 \>\"", " ", "<>", " ", "t"}], ",", " ", 
           RowBox[{"\"\<YP3-G10 \>\"", " ", "<>", " ", "t"}]}], "]"}], ";", 
         "\n", "   ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{"at", " ", "the", " ", "critical", " ", 
            RowBox[{"temperature", ":", " ", 
             RowBox[{"a", " ", "vanishes"}]}]}], ",", " ", 
           RowBox[{
           "and", " ", "no", " ", "other", " ", "pair", " ", "channel", " ", 
            "is", " ", "induced"}]}], " ", "*)"}], "\n", "   ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ac", ",", " ", "perp0"}], "}"}], " ", "=", " ", 
          RowBox[{"gzA", "[", 
           RowBox[{"t", ",", " ", "tc", ",", " ", "0.", ",", " ", 
            RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}]}], ";", "\n", 
         "   ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{"\"\<WP3-G3 \>\"", " ", "<>", " ", "t"}], ",", " ", 
           RowBox[{
            RowBox[{"thName", "[", "t", "]"}], " ", "<>", 
            " ", "\"\<: a(0, T_c) vanishes to the accuracy of T_c (|a(0, \
T_c)| / alpha)\>\""}], ",", " ", 
           RowBox[{
            RowBox[{"Abs", "[", "ac", "]"}], "/", "alCl"}], ",", " ", 
           RowBox[{"10", "^", 
            RowBox[{"-", "9"}]}], ",", " ", 
           RowBox[{"\"\<P3-G3 \>\"", " ", "<>", " ", "t"}], ",", " ", 
           RowBox[{"\"\<YP3-G3 \>\"", " ", "<>", " ", "t"}]}], "]"}], ";", 
         "\n", "   ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{"\"\<WP3-G4 \>\"", " ", "<>", " ", "t"}], ",", " ", 
           RowBox[{
            RowBox[{"thName", "[", "t", "]"}], " ", "<>", 
            " ", "\"\<: at zero pair momentum no other pair channel is \
induced (norm of the self-consistent components of P^a other than \
(K^iota)^dag)\>\""}], ",", " ", "perp0", ",", " ", 
