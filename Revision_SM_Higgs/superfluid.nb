        "]"}], " ", "&"}], " ", "/@", " ", "cchannels"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"every", " ", "field", " ", "as", " ", "a", " ", 
     RowBox[{"string", ":", " ", 
