                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"dpoly", " ", "/.", " ", 
                    RowBox[{"xx", " ", "->", " ", "#"}]}], ")"}], "^", 
                  "2"}]}], ")"}]}], " ", "&"}], ",", " ", "roots"}], "]"}], 
           "]"}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"gridSF", "[", "nr", "]"}], ":", " ", 
