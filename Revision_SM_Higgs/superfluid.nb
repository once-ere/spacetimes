Cell[CellGroupData[{

Cell["II.5 The gauge bosons in the superfluid", "Section",ExpressionUUID->"70eaf9b3-f4a9-49fd-9627-84f56a83e833"],

Cell[TextData[{
 StyleBox["The masses from the susceptibilities.",
  FontWeight->"Bold"],
 " A constant gauge field ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["A", "TI"], "0", 
    StyleBox["a", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "247a7451-f624-4510-b8c0-9b56d8367c5f"],
 " along the generator ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["Q",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["a", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e5ba7e8f-570a-46fa-bbff-6c2a5ce44654"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], "\[LongEqual]", "1", ",", "2", ",", "3"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e544bff2-d2e8-474c-a438-bcf6f0ba3883"],
 ": ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9ca01b51-7332-4feb-a0fd-956e9773319f"],
 "; ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], "\[LongEqual]", "4"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e998c24e-eb79-4af2-ab41-1c4e14704ba4"],
 ": the fermion number ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["1",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "8"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e78940b7-afda-4905-92f7-06b773e8cd30"],
 ") enters like a chemical potential ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Mu]", 
    StyleBox["a", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dee7a5ae-99b3-42de-b897-f3d9a34032bd"],
 " of that charge. The static susceptibility ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Chi]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["ab", "TI"]], "\[LongEqual]", "\[PartialD]", 
    RowBox[{"\[LeftAngleBracket]", 
     SubscriptBox[
      StyleBox["Q",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["a", "TI"]], "\[RightAngleBracket]"}], "/", "\[PartialD]", 
    SuperscriptBox["\[Mu]", 
     StyleBox["b", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2debe4b7-c342-46a5-9afa-06d2a58769e7"],
 " of the superfluid gives the mass matrix of the gauge bosons, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"(", 
      SuperscriptBox[
       StyleBox["M", "TI"], "2"], ")"}], 
     StyleBox["ab", "TI"]], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["a", "TI"]], 
    SubscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["b", "TI"]], 
    SubsuperscriptBox["\[Chi]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["ab", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "afb62471-ebae-4003-a2ce-35caad727ff4"],
 " (the Higgs mechanism of the condensate), with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["a", "TI"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0303690c-4b47-4c6b-9938-f02deb9010ab"],
 " for the three ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4633301c-ec74-4a6a-b40b-d8c0f2642f44"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["F",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c3b869b7-4569-4e72-ba10-2d429d86f539"],
 " for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "81af076b-11a7-492f-b8ed-6e5a301d0af0"],
 ". The next cell computes ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Chi]", 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["ab", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b655aa33-b076-42b2-8bd4-145a791de981"],
 " by central differences of the self-consistent states with the external \
self-energies ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[MinusPlus]", 
     StyleBox["h", "TI"]}], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["Q",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["b", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "48ffa663-b528-4517-a85d-6eeca5bae01e"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["h", "TI"], "\[LongEqual]", "2", "\[Times]", 
    SuperscriptBox["10", 
     RowBox[{"-", "3"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9bc536ce-f3b4-412e-8dcd-3e5a0a978884"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    StyleBox["h", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "94f5390c-f0db-45dd-997e-787c13ad4f51"],
 ", and the Richardson extrapolation. The generator ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2dc3f9e4-b862-47c1-bf7a-a3b625d66aab"],
 " leaves the condensate in the channel ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1eca1589-c497-4f2c-8441-e85c5fdc106a"],
 " unchanged, so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Chi]", 
     StyleBox["SF",
      FontSlant->"Plain"], "33"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e6ed1894-9e5c-4631-be45-02ef6d9fb31c"],
 ": ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d611eea9-aaea-42f0-a3ac-9aa03bd557a0"],
 " stays massless (the zeugon), and there is no mixing."
}], "Text",ExpressionUUID->"f036ba37-d833-4970-8bb1-776e567acd79"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", "four", " ", 
     RowBox[{"charges", ":", " ", 
      RowBox[{"T", "^", "1"}]}]}], ",", " ", 
    RowBox[{"T", "^", "2"}], ",", " ", 
    RowBox[{
     RowBox[{"T", "^", "3"}], " ", 
     RowBox[{"(", 
      RowBox[{"1", "_", "4", " ", 
       RowBox[{"(", "x", ")"}], " ", 
       RowBox[{"tau", "/", "2"}]}], ")"}], " ", "and", " ", "the", " ", 
     "fermion", " ", "number", " ", "1", "_", "8"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"chargesSF", " ", "=", " ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"N", "[", 
          RowBox[{"i8", "[", 
           RowBox[{
            RowBox[{"sig", "[", 
             RowBox[{"[", 
              RowBox[{"k", " ", "+", " ", "1"}], "]"}], "]"}], "/", "2"}], 
           "]"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"{", "id8", "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"susceptibilitySF", "[", 
      RowBox[{"mo", ",", " ", "s"}], "]"}], ":", " ", 
     RowBox[{
     "the", " ", "4", " ", "x", " ", "4", " ", "static", " ", 
      "susceptibilities", " ", "by", " ", "central", " ", "differences", " ", 
      "and", " ", "Richardson"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"susceptibilitySF", "[", 
      RowBox[{"mo_", ",", " ", "s_", ",", " ", 
       RowBox[{"h_", " ", ":", " ", 
        RowBox[{"2.", " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "3"}]}]}]}]}], "]"}], " ", ":=", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", "dn", "}"}], ",", "\n", "     ", 
          RowBox[{
           RowBox[{"dn", " ", "=", " ", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"Module", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"r", " ", "=", " ", 
                  RowBox[{"Table", "[", 
                   RowBox[{
                    RowBox[{"Module", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"ext", " ", "=", " ", 
                    RowBox[{
                    RowBox[{"-", "sg"}], " ", "step", " ", 
                    RowBox[{"chargesSF", "[", 
                    RowBox[{"[", "bb", "]"}], "]"}]}]}], "}"}], ",", "\n", 
                    "            ", 
                    RowBox[{
                    RowBox[{"solveSF", "[", 
                    RowBox[{"mo", ",", " ", 
                    RowBox[{
                    RowBox[{"s", "[", "\"\<n\>\"", "]"}], " ", "+", " ", 
                    "ext"}], ",", " ", 
                    RowBox[{"s", "[", "\"\<p\>\"", "]"}], ",", " ", "0.6", ",",
                     " ", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", "14"}]}], ",", " ", "40000", ",", " ", 
                    "ext"}], "]"}], "[", "\"\<rho\>\"", "]"}]}], "]"}], ",", 
                    " ", 
                    RowBox[{"{", 
                    RowBox[{"sg", ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"1", ",", " ", 
                    RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], "]"}]}], "}"}], ",",
                 "\n", "        ", 
                RowBox[{"Table", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Re", "[", 
                    RowBox[{
                    RowBox[{"Tr", "[", 
                    RowBox[{
                    RowBox[{"chargesSF", "[", 
                    RowBox[{"[", "a", "]"}], "]"}], " ", ".", " ", 
                    RowBox[{"r", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "]"}], " ", "-", " ", 
                    RowBox[{"Tr", "[", 
                    RowBox[{
                    RowBox[{"chargesSF", "[", 
                    RowBox[{"[", "a", "]"}], "]"}], " ", ".", " ", 
                    RowBox[{"r", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], "]"}], "/", 
                   RowBox[{"(", 
                    RowBox[{"2", " ", "step"}], ")"}]}], ",", " ", 
                  RowBox[{"{", 
                   RowBox[{"a", ",", " ", "4"}], "}"}]}], "]"}]}], "]"}], ",",
               " ", 
              RowBox[{"{", 
               RowBox[{"step", ",", " ", 
                RowBox[{"{", 
                 RowBox[{"h", ",", " ", 
                  RowBox[{"2", " ", "h"}]}], "}"}]}], "}"}]}], "]"}]}], ";", 
           "\n", "     ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"4", " ", 
               RowBox[{"dn", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], " ", "-", " ", 
              RowBox[{"dn", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "/", "3"}]}]}], "]"}],
         ",", " ", 
        RowBox[{"{", 
         RowBox[{"bb", ",", " ", "4"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
   
   RowBox[{
    RowBox[{"chiRows", " ", "=", " ", 
     RowBox[{"{", "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"key", " ", "=", " ", 
           RowBox[{"shortName", "[", "m", "]"}]}], ",", " ", "mo", ",", " ", 
          "s", ",", " ", "chi", ",", " ", "off"}], "}"}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"mo", ",", " ", "s"}], "}"}], " ", "=", " ", 
          RowBox[{"groundSF", "[", 
           RowBox[{"\"\<V2_\>\"", " ", "<>", " ", "key"}], "]"}]}], ";", "\n",
          "   ", 
         RowBox[{"chi", " ", "=", " ", 
          RowBox[{"susceptibilitySF", "[", 
           RowBox[{"mo", ",", " ", "s"}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"off", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{"chi", " ", "-", " ", 
             RowBox[{"DiagonalMatrix", "[", 
              RowBox[{"Diagonal", "[", "chi", "]"}], "]"}]}], "]"}], "]"}]}], 
         ";", "\n", "   ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{"\"\<WP2-8a \>\"", " ", "<>", " ", "key"}], ",", " ", 
           RowBox[{
           "key", " ", "<>", " ", "\"\<: chi_11 = \>\"", " ", "<>", " ", 
            RowBox[{"ToString", "[", 
             RowBox[{"NumberForm", "[", 
              RowBox[{
               RowBox[{"chi", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], ",", " ", "10"}],
               "]"}], "]"}], " ", "<>", " ", "\"\<, chi_FF = \>\"", " ", "<>",
             " ", 
            RowBox[{"ToString", "[", 
             RowBox[{"NumberForm", "[", 
              RowBox[{
               RowBox[{"chi", "[", 
                RowBox[{"[", 
                 RowBox[{"4", ",", " ", "4"}], "]"}], "]"}], ",", " ", "10"}],
               "]"}], "]"}], " ", "<>", " ", "\"\< = Rust; chi_33 = \>\"", 
            " ", "<>", " ", 
            RowBox[{"sci", "[", 
             RowBox[{"chi", "[", 
              RowBox[{"[", 
               RowBox[{"3", ",", " ", "3"}], "]"}], "]"}], "]"}], " ", "<>", 
            " ", "\"\< (massless zeugon), no mixing\>\""}], ",", "\n", "    ", 
           RowBox[{"Max", "[", 
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{"chi", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], " ", "-", " ", 
               RowBox[{"rustPart2", "[", 
                RowBox[{"\"\<p2_chi11_\>\"", " ", "<>", " ", "key"}], "]"}]}],
               "]"}], ",", " ", 
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{"chi", "[", 
                RowBox[{"[", 
                 RowBox[{"4", ",", " ", "4"}], "]"}], "]"}], " ", "-", " ", 
               RowBox[{"rustPart2", "[", 
                RowBox[{"\"\<p2_chiFF_\>\"", " ", "<>", " ", "key"}], "]"}]}],
               "]"}], ",", " ", 
             RowBox[{"Abs", "[", 
              RowBox[{"chi", "[", 
               RowBox[{"[", 
                RowBox[{"3", ",", " ", "3"}], "]"}], "]"}], "]"}], ",", " ", 
             "off"}], "]"}], ",", " ", 
           RowBox[{"10", "^", 
            RowBox[{"-", "8"}]}], ",", "\n", "    ", 
           
           RowBox[{"\"\<P2-8a \>\"", " ", "<>", " ", "key", " ", "<>", 
            " ", "\"\<, P2-8b \>\"", " ", "<>", " ", "key"}], ",", " ", 
           RowBox[{"\"\<YP2-8a \>\"", " ", "<>", " ", "key"}]}], "]"}], ";", 
         "\n", "   ", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"chiRows", ",", " ", 
           RowBox[{"{", 
            RowBox[{"key", ",", " ", 
             RowBox[{"chi", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
             RowBox[{"chi", "[", 
              RowBox[{"[", 
               RowBox[{"3", ",", " ", "3"}], "]"}], "]"}], ",", " ", 
             RowBox[{"chi", "[", 
              RowBox[{"[", 
               RowBox[{"4", ",", " ", "4"}], "]"}], "]"}], ",", " ", 
             RowBox[{"gvLL", " ", 
              RowBox[{"Sqrt", "[", 
               RowBox[{"chi", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], "]"}]}], ",", 
             " ", 
             RowBox[{"gfLL", " ", 
              RowBox[{"Sqrt", "[", 
               RowBox[{"chi", "[", 
                RowBox[{"[", 
                 RowBox[{"4", ",", " ", "4"}], "]"}], "]"}], "]"}]}]}], 
            "}"}]}], "]"}]}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"m", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\"\<HS\>\"", ",", " ", "1.", ",", " ", "1."}], "}"}], ",",
           " ", 
          RowBox[{"{", "\"\<KS\>\"", "}"}], ",", " ", 
          RowBox[{"{", "\"\<CJT\>\"", "}"}]}], "}"}]}], "}"}]}], "]"}], ";"}],
    "\n", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
            RowBox[{"NumberForm", "[", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", " ", "8"}], "]"}], ",", 
            " ", 
