Cell[CellGroupData[{

Cell["III.G.3 The values of the Rust program", "Section",ExpressionUUID->"c8c3878a-e8f3-498f-9221-b2a0f7e60dfe"],

Cell[TextData[{
 "The closed cell holds the results of the modules ",
 StyleBox["ginzburg",
  FontFamily->"Source Code Pro"],
 " and ",
 StyleBox["higgs",
  FontFamily->"Source Code Pro"],
 " of the Rust program: ",
 StyleBox["rustGinzburg",
  FontFamily->"Source Code Pro"],
 " (per method: the critical temperature, the Dirac mass of the normal state \
at it, the coefficients ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Alpha]", 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["GL",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0737965e-cae3-4139-83cd-d139af0e3653"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["b", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["Tay",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a1af4594-49a1-400f-8aac-6d11a0e18ea7"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["c",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ad03fc13-60f6-4255-930f-64b86b0fc474"],
 ", the gradient coefficient of the isospin twist, of the fixed channels, of \
the twist of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fd87ddb8-11cc-41a4-98bf-9dd9f7526bfd"],
 " and of the twisted states, the two values of the extrapolation, the norms \
of the other channels, ",
 Cell[BoxData[
  FormBox[
   StyleBox["a", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "322dfc6c-ae05-4b3e-b230-32d0d2abcf30"],
 " at ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "29b9e0fa-35d7-488c-a11f-97649d61c8cd"],
 ", the Ginzburg number, the width, ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Xi]", 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["GL",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4e07c676-b079-4d00-804a-3b3be9b62346"],
 " and the field at the edge of the critical region), ",
 StyleBox["rustGinzburgRegions",
  FontFamily->"Source Code Pro"],
 " (the two regularizations of Section III.G.5) and ",
 StyleBox["rustHiggs",
  FontFamily->"Source Code Pro"],
 " (the numbers of Section III.G.8, one row per method)."
}], "Text",ExpressionUUID->"a4b2dc08-08ee-42fc-bc1e-3b48be44413e"],

