Cell[CellGroupData[{

Cell["R.1.4 The charges (check WQN-4)", "Subsection",ExpressionUUID->"7913107f-c20a-4007-a0ea-34eef9885811"],

Cell[TextData[{
 "The diagonal of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["Q", "TI"], 
    StyleBox["SM",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3c2aa2e9-0430-4acd-82ad-1ca5e5a7a3e6"],
 " gives the electric charges of the sixteen components: ",
 Cell[BoxData[
  FormBox[
   FractionBox["3", "4"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4c863baa-445f-45ac-81a5-34527d3a668e"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    FractionBox["1", "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "edbbc2e2-d4f4-4179-a72a-599b66d10213"],
 " alternating on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b64db35d-8bc0-4f5c-a535-f7beec4c1959"],
 " (up and down), ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "4"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e8b0557c-2d8b-4396-91f0-abc8a75b4400"],
 " on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Chi]", 
    StyleBox["SH",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ce87277f-99a7-4360-b2d5-639c8965259d"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    FractionBox["3", "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "26a4d3ad-ca07-440a-bc2b-6cee65de4173"],
 " on ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Chi]", 
    StyleBox["SH",
     FontSlant->"Plain"], "\[Prime]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1c130007-050f-4cd0-8d7d-6e003f10c4ae"],
 ". The first version made the fermion number the hypercharge, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["Y", "TI"], 
     StyleBox["SM",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["F", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "/", "4"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cb42ca55-c3fc-4d71-b40a-357fd92a1871"],
 "; with ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Chi]", 
    StyleBox["SH",
     FontSlant->"Plain"], "\[Prime]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f403c93e-a2c6-45d8-ac59-a28a68fbfe49"],
 " that holds on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cdcfee50-d37a-4e16-8ee6-29100252a20c"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Chi]", 
    StyleBox["SH",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2d304859-26db-4e86-a1e4-496a4f154914"],
 " but not on ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Chi]", 
    StyleBox["SH",
     FontSlant->"Plain"], "\[Prime]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cda5fbb0-f32f-4917-a0a3-976364c45ed3"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"4", 
    SuperscriptBox[
     StyleBox["Y", "TI"], 
     StyleBox["SM",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"-", "3"}], 
    SubsuperscriptBox[
     StyleBox["F", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["tot",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b3416165-8286-4a22-83d2-651be81360e8"],
 ". The quadratic Casimir operators show the multiplets: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["a", "TI"],
     LimitsPositioning->True], 
    SuperscriptBox[
     RowBox[{"(", 
      SuperscriptBox[
       StyleBox["T", "TI"], 
       RowBox[{
        StyleBox["a", "TI"], ",", 
        StyleBox["SM",
         FontSlant->"Plain"]}]], ")"}], "2"], "\[LongEqual]", 
    FractionBox["3", "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8de5b975-efa4-488c-8b87-046fe72e51da"],
 " on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fcea551f-0676-4fb8-8fe0-ff39a2606e96"],
 " (a doublet of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["L", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8188bece-76f3-4141-9aef-986f0d278c35"],
 ") and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["a", "TI"],
     LimitsPositioning->True], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["T", "TI"], 
       StyleBox["SH",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["a", "TI"], ",", 
        StyleBox["R",
         FontSlant->"Plain"]}]], ")"}], "2"], "\[LongEqual]", 
    FractionBox["3", "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "10d54a73-6287-4119-96bc-3bd3df8fb837"],
 " on the singlets (a doublet of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["R",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "08960210-b660-4bfc-b992-093d15824dcb"],
 ")."
}], "Text",ExpressionUUID->"cde8add1-ba9b-4bb3-94e5-5abe06b3915f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", 
