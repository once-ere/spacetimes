Cell[CellGroupData[{

Cell["\<\
III.T.6 The size of the order parameter, Landau's theory, and the answer\
\>", "Section",ExpressionUUID->"adf9b9b9-1ee2-4552-9380-d323824878f7"],

Cell[TextData[{
 StyleBox["The radius of convergence.",
  FontWeight->"Bold"],
 " The free energy is built from integrals over the momenta of functions of \
the quasi-particle energies ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["E", "TI"], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        StyleBox["q", "TI"], "2"], "+", 
       SuperscriptBox[
        StyleBox["M", "TI"], "2"], "+", 
       SubsuperscriptBox["\[CapitalPhi]", 
        StyleBox["a",
         FontSlant->"Plain"], "2"]}], ")"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "23636fde-d0dc-46c9-ac56-b0eb1f9d404c"],
 " and of their Fermi functions: the terms ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     StyleBox["T", "TI"]}], "\[ThinSpace]", 
    StyleBox["ln",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{"2", "\[ThinSpace]", 
      StyleBox["cosh",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       RowBox[{
        StyleBox["E", "TI"], "/", "2", 
        StyleBox["T", "TI"]}], ")"}]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a5dfa7dc-f428-4373-b7f5-83c13128b058"],
 ", one for each pair of eigenvalues ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    StyleBox["E", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "224b4347-ed1e-4402-bd86-aed6b8e036b3"],
 " (at the Fermi occupation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["f", "TI"], "\[LongEqual]", 
    StyleBox["f", "TI"], 
    RowBox[{"(", 
     StyleBox["E", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fd0424be-c6e9-4d28-b607-c5043ac70861"],
 " the energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["E", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["f", "TI"], "-", 
      FractionBox["1", "2"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f8c5fb9b-ebbc-4495-ae7d-d47f65d3b5ad"],
 " of the pair and its term ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], 
    RowBox[{"[", 
     RowBox[{
      StyleBox["f", "TI"], "\[ThinSpace]", 
      StyleBox["ln",
       FontSlant->"Plain"], "\[ThinSpace]", 
      StyleBox["f", "TI"], "+", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        StyleBox["f", "TI"]}], ")"}], "\[ThinSpace]", 
      StyleBox["ln",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        StyleBox["f", "TI"]}], ")"}]}], "]"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a83d8abd-6958-401d-bed8-98451ccc48b9"],
 " in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     StyleBox["T", "TI"]}], 
    SubscriptBox[
     StyleBox["\[ScriptCapitalS]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "785f9f45-c68f-4fed-932f-8e42278441e6"],
 " add up to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     StyleBox["T", "TI"]}], "\[ThinSpace]", 
    StyleBox["ln",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{"2", "\[ThinSpace]", 
      StyleBox["cosh",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       RowBox[{
        StyleBox["E", "TI"], "/", "2", 
        StyleBox["T", "TI"]}], ")"}]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cf5a1b4e-b79d-4323-b073-c47f712f1302"],
 "), and the densities with the factor ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["tanh",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["E", "TI"], "/", "2", 
      StyleBox["T", "TI"]}], ")"}], "/", 
    StyleBox["E", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7241eb62-8bd7-457a-b9d2-bc05dec0a75c"],
 ". With the Matsubara frequencies ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Omega]", 
     StyleBox["n", "TI"]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{"2", 
      StyleBox["n", "TI"], "+", "1"}], ")"}], "\[Pi]", 
    StyleBox["T", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "00df9c9b-ae16-4e8a-aec1-2abcc0dfe1b1"],
 " they become sums over ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "0", ",", "1", ",", "2", ",", 
    "\[Ellipsis]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1ead9405-7901-4979-9b89-7cd11a0bceba"],
 ","
}], "Text",ExpressionUUID->"43dd13c1-3a3c-42e5-a090-1101577ac544"],

Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox["ln",
    FontSlant->"Plain"], 
   RowBox[{"(", 
    RowBox[{"2", "\[ThinSpace]", 
     StyleBox["cosh",
      FontSlant->"Plain"], 
     RowBox[{"(", 
      RowBox[{
       StyleBox["E", "TI"], "/", "2", 
       StyleBox["T", "TI"]}], ")"}]}], ")"}], "\[LongEqual]", 
   StyleBox["ln",
    FontSlant->"Plain"], "\[ThinSpace]", "2", "+", 
   UnderoverscriptBox["\[Sum]", 
    RowBox[{
     StyleBox["n", "TI"], "\[LongEqual]", "0"}], "\[Infinity]",
    LimitsPositioning->True], "\[ThinSpace]", 
   StyleBox["ln",
    FontSlant->"Plain"], 
   RowBox[{"(", 
    RowBox[{"1", "+", 
     FractionBox[
      SuperscriptBox[
       StyleBox["E", "TI"], "2"], 
      SubsuperscriptBox["\[Omega]", 
       StyleBox["n", "TI"], "2"]]}], ")"}], ",", "      ", 
   FractionBox[
    RowBox[{
     StyleBox["tanh",
      FontSlant->"Plain"], 
     RowBox[{"(", 
      RowBox[{
       StyleBox["E", "TI"], "/", "2", 
       StyleBox["T", "TI"]}], ")"}]}], 
    StyleBox["E", "TI"]], "\[LongEqual]", "4", 
   StyleBox["T", "TI"], "\[ThinSpace]", 
   UnderoverscriptBox["\[Sum]", 
    RowBox[{
     StyleBox["n", "TI"], "\[LongEqual]", "0"}], "\[Infinity]",
    LimitsPositioning->True], "\[ThinSpace]", 
   FractionBox["1", 
    RowBox[{
     SubsuperscriptBox["\[Omega]", 
      StyleBox["n", "TI"], "2"], "+", 
     SuperscriptBox[
      StyleBox["E", "TI"], "2"]}]], ","}], TraditionalForm]], "DisplayFormula",\

 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"cecee330-8d5e-4638-8f85-03e6389b3d75"],

Cell[TextData[{
 "of functions of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Omega]", 
     StyleBox["n", "TI"], "2"], "+", 
    SuperscriptBox[
     StyleBox["q", "TI"], "2"], "+", 
    SuperscriptBox[
     StyleBox["M", "TI"], "2"], "+", 
    SubsuperscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7c43c24f-39a3-4a88-b10c-14d8cf9792bf"],
 ". Integrated over the momenta, each is singular where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Omega]", 
     StyleBox["n", "TI"], "2"], "+", 
    SuperscriptBox[
     StyleBox["M", "TI"], "2"], "+", 
    SubsuperscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"], "2"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "89b7fe89-4bbd-44a3-ae64-cf11061b56f9"],
 " (at the end ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["q", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "83bfd22a-2bd7-4623-a61f-39c569b22fd2"],
 " of the integral); the nearest of these points to the origin, for the Dirac \
mass of the normal state held fixed, is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"], "2"], "\[LongEqual]", 
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["M", "TI"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["X", "TI"], ",", 
         StyleBox["n",
          FontSlant->"Plain"]}]], 
       SuperscriptBox[
        RowBox[{"(", 
         StyleBox["T", "TI"], ")"}], "2"], "+", 
       SuperscriptBox["\[Pi]", "2"], 
       SuperscriptBox[
        StyleBox["T", "TI"], "2"]}], ")"}]}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f589c345-ecb3-45fc-aaf6-41f1a9479b27"],
 ", and at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f79295cb-6b37-4e40-b4dc-24018790bafc"],
 " it is the point ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"], "2"], "\[LongEqual]", 
    RowBox[{"-", 
     SubsuperscriptBox[
      StyleBox["m", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], "2"]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "795de0f3-4ceb-4d1d-8856-8b9e9d92c88b"],
 " of Section III.L.5. The series of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalF]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0a5cb991-ad10-4fb3-9275-3f08db938597"],
 " in powers of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "716b467b-5152-4ee5-9615-48dd34275bde"],
 " about the normal state therefore converges within a radius of the order \
of"
}], "Text",ExpressionUUID->"80f8bada-d129-45a3-8298-510c777fb7f1"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], 
   RowBox[{"(", 
    StyleBox["T", "TI"], ")"}], "\[LongEqual]", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["n",
         FontSlant->"Plain"]}]], 
      SuperscriptBox[
       RowBox[{"(", 
        StyleBox["T", "TI"], ")"}], "2"], "+", 
      SuperscriptBox["\[Pi]", "2"], 
      SuperscriptBox[
       StyleBox["T", "TI"], "2"]}], ")"}], 
    RowBox[{"1", "/", "2"}]], ","}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"d2f81571-8d61-44ae-b9b5-9c2778faeba7"],

Cell[TextData[{
 "not exactly equal to it (the Dirac mass changes with the applied field \
where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["S",
       FontSlant->"Plain"]}]], "\[NotEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cddf260c-5622-4129-9c12-8b85fea33bed"],
 ", and the field of the states is not the applied field). Because ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1bd8d513-888f-4dc8-831b-7ebc08c45f5c"],
 " is an estimate, the answer rests also on two direct measures that do not \
use it. ",
 StyleBox["Landau's theory",
  FontWeight->"Bold"],
 " expands the free energy at the symmetric state, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalF]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["Tay",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}], 
    SuperscriptBox["\[CapitalPhi]", "2"], "+", 
    SubsuperscriptBox[
     StyleBox["b", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["Tay",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}], 
    SuperscriptBox["\[CapitalPhi]", "4"], "+", "\[Ellipsis]"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6fa5ec98-297d-445f-80c5-79bbabc51832"],
 " along the polar fields, and predicts the order parameter ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       StyleBox["a", "TI"]}], "/", "2", 
      StyleBox["b", "TI"]}], ")"}], 
    RowBox[{"1", "/", "2"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bb60cd97-b1e4-42d2-8e17-b5fc9125d8eb"],
 ", with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["Tay",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a1acc85c-9c1a-4f49-8c68-240b316dd78d"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["b", "TI"], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["b", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["Tay",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c9d290cd-7701-4a66-bf39-4dd1de3ff37a"],
 ". The next cell computes them for CJT at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.9", "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["CJT",
       FontSlant->"Plain"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "38a9b156-644d-4bd7-8512-20319b727ae9"],
 " from the thermal states of four small applied fields, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"]], "\[LongEqual]", "0.01"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d7d611b0-cd05-4b28-a895-15afc02a91f5"],
 " to ",
 Cell[BoxData[
  FormBox["0.04", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9094b18c-76f6-4caf-8f50-cb4d9546e369"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalF]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], "/", 
    SuperscriptBox["\[CapitalPhi]", "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7bdc0e09-aa5d-495c-974a-33d589f35884"],
 " interpolated exactly by a cubic polynomial in ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CapitalPhi]", "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fbfa4ecf-89ac-4587-a8f8-13948f8a98a4"],
 ", whose value and slope at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[CapitalPhi]", "2"], "\[LongEqual]", "0"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "80c3c642-3ed5-468b-966e-3a61b88ec02b"],
 " are ",
 Cell[BoxData[
  FormBox[
   StyleBox["a", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "52a0cf25-c71e-4774-8a4e-d4e483801444"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["b", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cc24848a-91e1-49f3-a1a0-746995f38834"],
 "). The cell after it fits the ",
 StyleBox["Landau form",
  FontWeight->"Bold"],
 " of Section III.L (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], 
    SuperscriptBox["\[CapitalPhi]", "2"], "+", 
    StyleBox["b", "TI"], 
    SuperscriptBox["\[CapitalPhi]", "4"], "+", 
    StyleBox["c", "TI"], 
    SuperscriptBox["\[CapitalPhi]", "6"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "379e5d34-86c6-4813-bb6f-dd20642cc922"],
 ") and the quartic form (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], 
    SuperscriptBox["\[CapitalPhi]", "2"], "+", 
    StyleBox["b", "TI"], 
    SuperscriptBox["\[CapitalPhi]", "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "65c09d2d-6ed3-4569-bd66-a27bd6f915ff"],
 ") to the free-energy curves of the Rust program at six temperatures, with \
the least squares of Section III.L.4."
}], "Text",ExpressionUUID->"7311130e-8161-4f5b-be1e-89f72f4aaa1c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", "Taylor", " ", "coefficients", " ", "a"}], ",", " ", 
    RowBox[{
    "b", " ", "of", " ", "the", " ", "free", " ", "energy", " ", "of", " ", 
     "CJT", " ", "at", " ", "0.9", " ", "T_c", " ", "at", " ", "the", " ", 
     "origin"}], ",", " ", 
    RowBox[{"and", " ", "the", " ", "order", " ", "parameter", " ", "of", " ", 
     RowBox[{"Landau", "'"}], "s", " ", "theory"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"mo", " ", "=", " ", 
        RowBox[{"thModel", "[", "\"\<CJT\>\"", "]"}]}], ",", " ", 
       RowBox[{"temp", " ", "=", " ", 
        RowBox[{"thGet", "[", 
         RowBox[{"\"\<CJT\>\"", ",", " ", "0.9", ",", " ", "\"\<T\>\""}], 
         "]"}]}], ",", " ", 
       RowBox[{"nn", " ", "=", " ", 
        RowBox[{
         RowBox[{"thSF", "[", "0.9", "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", "n0", ",", " ", 
       RowBox[{"xs", " ", "=", " ", 
        RowBox[{"{", "}"}]}], ",", " ", 
       RowBox[{"ys", " ", "=", " ", 
        RowBox[{"{", "}"}]}], ",", " ", "c", ",", " ", "a", ",", " ", "b", ",",
        " ", "err", ",", " ", "errRust"}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"n0", " ", "=", " ", 
       RowBox[{"nn", "[", "\"\<n\>\"", "]"}]}], ";", "\n", "  ", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"res", " ", "=", " ", 
            RowBox[{"fixedPairT", "[", 
             RowBox[{"mo", ",", " ", 
              RowBox[{"fa", " ", 
               RowBox[{"ConjugateTranspose", "[", 
                RowBox[{"k8", "[", "3", "]"}], "]"}]}], ",", " ", "n0", ",", 
              " ", "temp"}], "]"}]}], "}"}], ",", "\n", "     ", 
          RowBox[{
           RowBox[{"n0", " ", "=", " ", 
            RowBox[{"res", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", "     ", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"xs", ",", " ", 
             RowBox[{
              RowBox[{"res", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "^", "2"}]}], "]"}], ";", " ", 
           
           RowBox[{"AppendTo", "[", 
            RowBox[{"ys", ",", " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"res", "[", 
                 RowBox[{"[", "3", "]"}], "]"}], " ", "-", " ", 
                RowBox[{"nn", "[", "\"\<free\>\"", "]"}]}], ")"}], "/", 
              RowBox[{
               RowBox[{"res", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "^", "2"}]}]}], "]"}]}]}], 
         "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"fa", ",", " ", 
          RowBox[{"{", 
           RowBox[{
           "0.01", ",", " ", "0.02", ",", " ", "0.03", ",", " ", "0.04"}], 
           "}"}]}], "}"}]}], "]"}], ";", "\n", "  ", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
        "the", " ", "cubic", " ", "polynomial", " ", "in", " ", "the", " ", 
         "scaled", " ", "variable", " ", 
         RowBox[{"x", "/", "xmax"}]}], ",", " ", 
        RowBox[{
         RowBox[{
         "whose", " ", "matrix", " ", "is", " ", "well", " ", "conditioned"}],
          ";", " ", 
         RowBox[{"then", " ", "back", " ", "to", " ", "a"}]}], ",", " ", 
        "b"}], " ", "*)"}], "\n", "  ", 
      RowBox[{"c", " ", "=", " ", 
       RowBox[{"LinearSolve", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"x", "/", 
              RowBox[{"Max", "[", "xs", "]"}]}], ")"}], "^", "k"}], ",", " ", 
           
           RowBox[{"{", 
            RowBox[{"x", ",", " ", "xs"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"k", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}], ",", 
         " ", "ys"}], "]"}]}], ";", "\n", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "b"}], "}"}], " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"c", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
         RowBox[{
          RowBox[{"c", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "/", 
          RowBox[{"Max", "[", "xs", "]"}]}]}], "}"}]}], ";", "\n", "  ", 
      RowBox[{"err", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{"-", "a"}], "/", 
           RowBox[{"(", 
            RowBox[{"2", " ", "b"}], ")"}]}], "]"}], "/", 
         RowBox[{"thGet", "[", 
          RowBox[{"\"\<CJT\>\"", ",", " ", "0.9", ",", " ", "\"\<Phi0\>\""}], 
          "]"}]}], " ", "-", " ", "1"}]}], ";", "\n", "  ", 
      RowBox[{"errRust", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"thGet", "[", 
          RowBox[{"\"\<CJT\>\"", ",", " ", "0.9", ",", " ", "\"\<phiL\>\""}], 
          "]"}], "/", 
         RowBox[{"thGet", "[", 
          RowBox[{"\"\<CJT\>\"", ",", " ", "0.9", ",", " ", "\"\<Phi0\>\""}], 
          "]"}]}], " ", "-", " ", "1"}]}], ";", "\n", "  ", 
      RowBox[{"check", "[", 
       RowBox[{"\"\<WP3-T5 CJT\>\"", ",", " ", 
        RowBox[{"\"\<CJT at 0.9 T_c: the Taylor coefficients a = \>\"", " ", "<>",
          " ", 
         RowBox[{"ToString", "[", 
          RowBox[{"NumberForm", "[", 
           RowBox[{"a", ",", " ", "8"}], "]"}], "]"}], " ", "<>", 
         " ", "\"\<, b = \>\"", " ", "<>", " ", 
         RowBox[{"ToString", "[", 
          RowBox[{"NumberForm", "[", 
           RowBox[{"b", ",", " ", "8"}], "]"}], "]"}], " ", "<>", 
         " ", "\"\< of the free energy at the origin and the error \>\"", " ",
          "<>", " ", 
         RowBox[{"sci", "[", "err", "]"}], " ", "<>", 
         " ", "\"\< of the order parameter (-a/2b)^(1/2) of Landau's theory (\
\>\"", " ", "<>", " ", 
         RowBox[{"ToString", "[", 
          RowBox[{"NumberForm", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", "err", "]"}], "/", "0.1"}], ",", " ", "3"}], 
           "]"}], "]"}], " ", "<>", 
         " ", "\"\< times 1 - T/T_c) = Rust (largest relative difference of a \
and b, difference of the error)\>\""}], ",", "\n", "   ", 
        RowBox[{"Max", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"a", " ", "-", " ", 
             RowBox[{"thGet", "[", 
              RowBox[{"\"\<CJT\>\"", ",", " ", "0.9", ",", " ", "\"\<a\>\""}],
               "]"}]}], "]"}], "/", 
           RowBox[{"Abs", "[", 
            RowBox[{"thGet", "[", 
             RowBox[{"\"\<CJT\>\"", ",", " ", "0.9", ",", " ", "\"\<a\>\""}], 
             "]"}], "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"b", " ", "-", " ", 
             RowBox[{"thGet", "[", 
              RowBox[{"\"\<CJT\>\"", ",", " ", "0.9", ",", " ", "\"\<b\>\""}],
               "]"}]}], "]"}], "/", 
           RowBox[{"Abs", "[", 
            RowBox[{"thGet", "[", 
             RowBox[{"\"\<CJT\>\"", ",", " ", "0.9", ",", " ", "\"\<b\>\""}], 
             "]"}], "]"}]}], ",", " ", 
          RowBox[{"Abs", "[", 
           RowBox[{"err", " ", "-", " ", "errRust"}], "]"}]}], "]"}], ",", 
        " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "5"}]}], ",", " ", "\"\<P3-T5 CJT\>\"", ",", 
        " ", "\"\<YP3-T5 CJT\>\""}], "]"}]}]}], "]"}], ";"}]}]], "Input",
 CellLabel->
  "In[348]:=",ExpressionUUID->"ad400b23-39e7-42a7-ac00-5e72fca81ce3"],

