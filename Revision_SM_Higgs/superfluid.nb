         RowBox[{
          RowBox[{"c1", " ", "=", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"a40", "[", "0.005", "]"}], " ", "-", " ", "a0"}], 
             ")"}], "/", 
            RowBox[{"0.01", "^", "2"}]}]}], ";", " ", 
          RowBox[{"c2", " ", "=", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"a40", "[", "0.01", "]"}], " ", "-", " ", "a0"}], ")"}],
             "/", 
            RowBox[{"0.02", "^", "2"}]}]}], ";", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"4", " ", "c1"}], " ", "-", " ", "c2"}], ")"}], "/", 
