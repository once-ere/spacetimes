Cell[CellGroupData[{

Cell["III.L.6 Why it matters", "Section",ExpressionUUID->"ee2fbfb0-5c0e-4301-b9ad-76b39ddb5462"],

Cell[TextData[{
 StyleBox["It enters no other result.",
  FontWeight->"Bold"],
 " The effective Lagrangians of the solution contain the computed function ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalV]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b6418239-4032-4ae4-9901-7ccd44e63a8b"],
 ", not the Landau form, and no other result uses ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "53492a96-2d39-4786-aa26-fb531c908a0d"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["b", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "737344c6-01a3-440e-a8f3-d1c13886d321"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4dabe9be-4607-4ca9-82bb-0aa7f2bdaebd"],
 ": the mass of the amplitude mode uses the curvature ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalV]",
     FontSlant->"Plain"], 
    StyleBox["amp",
     FontSlant->"Plain"], "\[Prime]\[Prime]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1f8dfa4e-d024-42aa-8496-154ec4d43fbe"],
 " of the computed curve, ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["u", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1b685d8d-97c3-4036-8713-5670fdc23595"],
 " and the mass of the non-unitary modes use the computed curvature in the \
non-unitary direction, and the masses of the gauge bosons and the dynamics \
use ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalPhi]", 
    RowBox[{"0", ",", 
     StyleBox["SF",
      FontSlant->"Plain"]}], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "49539b3e-77c0-49ae-8a5a-d3ecf973bd34"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["Z", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "80621585-d9a3-4b7a-a7a9-505c7dc8e0eb"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["Y", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "baae1f0a-8d52-49d6-a162-8c1479fdea74"],
 " and the susceptibilities."
}], "ItemNumbered",ExpressionUUID->"ddf86d1c-943f-478b-bc29-ccd637760ea0"],

Cell[TextData[{
 StyleBox["It matters to whoever replaces $\\mathcal V^X_{\\rm SF}$ by the \
Landau form",
  FontWeight->"Bold"],
 ", as in a model of the type of Ginzburg and Landau or of Higgs: the minimum \
of the polynomial is 0.04 to 0.11 per cent too small, its depth 0.12 to 0.31 \
per cent too large, its curvature at its minimum 0.86 to 2.3 per cent too \
large, and the mass of the amplitude mode 0.43 to 1.1 per cent too large (the \
table above). A derivative enlarges the relative error of the function. \
Beyond the fitted interval the error grows: fitted on the whole computed \
curve, the form misses by 1.2 to 1.7 per cent of the depth."
}], "ItemNumbered",ExpressionUUID->"36ed4162-2e74-4328-8de8-51c86f3a3673"],

Cell[TextData[{
 StyleBox["The coefficients are not constants of the theory.",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e4cdc5d6-bba2-4fe5-a626-26ad3b184552"],
 " differs from the Taylor coefficient at the origin, and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["b", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "12a301ba-51bc-46af-bb8b-e305bf091e6a"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f43ca3e3-013c-4003-8b80-516cd16b44e9"],
 " change with the fitted interval and with the number of powers (the last \
four rows of the table). No physical meaning may be given to ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["b", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "526963c7-e87f-4e1a-a065-83f55ee8776d"],
 " or ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d2992c73-968a-4873-960e-5e15da196ca6"],
 " alone. The physical quantities are those that the computed function \
defines: ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalPhi]", 
    RowBox[{"0", ",", 
     StyleBox["SF",
      FontSlant->"Plain"]}], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5d815100-1308-4a40-823e-b661089164d9"],
 ", the depth, the curvatures at the minimum, and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["Tay",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fdbe4cc2-860b-4041-b1d3-7841183f2cbf"],
 "."
}], "ItemNumbered",ExpressionUUID->"b08ba452-c9c5-4238-b384-61c49afcd94a"],

Cell[TextData[{
 StyleBox["The qualitative results do not depend on the fit.",
  FontWeight->"Bold"],
 " That ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalV]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8da1b7e1-8fef-45f8-8358-89379cfddbc1"],
 " vanishes at the origin, is negative near it, has its minimum at ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalPhi]", 
    RowBox[{"0", ",", 
     StyleBox["SF",
      FontSlant->"Plain"]}], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8d9c62b9-a7a6-43d5-af5d-b837e5bccf07"],
 ", depends only on the two invariants, and has a stable polar minimum (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["u", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], ">", "0"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "77587dd3-b937-441a-a0df-f43211cce888"],
 ") are properties of the computed function, checked on it directly; the sign \
of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c51da078-ddaa-4510-a1c8-c8025b949db6"],
 " is that of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["Tay",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d015de59-e143-4109-bd75-36e2cdeca5a4"],
 " (negative: the normal vacuum is unstable)."
}], "ItemNumbered",ExpressionUUID->"a7279812-d6ae-4cca-96cc-fb6f45507366"],

Cell[TextData[{
 StyleBox["The comparison with the Standard Model.",
  FontWeight->"Bold"],
 " The field has a Mexican hat with the symmetry structure of the Higgs \
sector and of the polar phase of a condensate of spin 1, but its potential is \
not the quartic potential of the Standard Model: the quartic form misses ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalV]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "55dab709-6e35-480a-acb5-a4b91bf7eb23"],
 " by 2.8 to 5.9 per cent of the depth, about ten times more than the Landau \
form with the sixth power."
}], "ItemNumbered",ExpressionUUID->"31c19582-2523-4510-8cc1-5ae45ba4c75f"],

Cell[TextData[{
 StyleBox["Corrections of the first answers.",
  FontWeight->"Bold"],
 " The first answers to the author contained five statements that were not \
exact; the numbers of this chapter are the corrected ones. (1) The residual \
changes its sign three times, not five. (2) The fit called a fit on ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"0", ",", "2", 
     SubscriptBox["\[CapitalPhi]", "0"]}], "]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "284b9967-5842-407b-a679-7e3bc8a0f6d4"],
 " used all 61 points of the curve, whose fields reach 1.52 to 1.64 times ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalPhi]", 
    RowBox[{"0", ",", 
     StyleBox["SF",
      FontSlant->"Plain"]}], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ef01a69c-d941-434a-acf0-fc48db8b81ad"],
 "; the applied field, not the field of the states, reaches ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    SubsuperscriptBox["\[CapitalPhi]", 
     RowBox[{"0", ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c20a1965-8327-4132-b959-01926036d630"],
 ". (3) The range of the end of the curve is 1.52 to 1.64 (HS ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "0"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1d29bca4-0a95-4ede-a223-cbf95eeabd8f"],
 "), not 1.52 to 1.61. (4) The singularity lies at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"], "2"], "\[LongEqual]", 
    RowBox[{"-", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["M", "TI"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["X", "TI"], ",", 
         StyleBox["D",
          FontSlant->"Plain"]}]], ")"}], "2"]}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "93bbe56c-94b7-479a-8f49-f79d09d67c7c"],
 " in the applied field; in the field of the states the radius of convergence \
is of the order of the Dirac mass, not equal to it. (5) The errors of the \
curvature quoted first, 1.1 to 2.7 per cent, are those of the polynomial at \
the minimum of the computed curve; at the polynomial's own minimum, where a \
user evaluates it, they are 0.86 to 2.3 per cent, as the table shows."
}], "Text",ExpressionUUID->"ce51e087-e9d2-455b-8f67-9b92c8dac41f"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Part III, second section. The free energy at finite temperature: the critical \
temperatures and the size of the order parameter\
\>", "Chapter",ExpressionUUID->"1616cb15-1209-4be9-8afa-a6c7fc647a84"],

Cell[TextData[{
 "On 21 November 2026 the author asked to add to the analysis and the \
solution the effective potential and the free energy of each of the five \
computed methods ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4fa11ead-619b-4699-8556-c8205112c544"],
 " (HS ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"1", ",", "1"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "744e9649-e174-4fc2-9339-46a47d07d84f"],
 ", HS ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "1"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "52a4d4a6-2cfd-45d9-8a6e-cb380f43439f"],
 ", HS ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "0"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4e7fb5e1-01e3-4943-bb06-f39295e68c0f"],
 ", KS and CJT), to determine whether the order parameter is then smaller and \
more physically reasonable, and to document this addendum with its \
provenance. The effective potential of each method is the subject of Section \
III.L. This chapter computes the free energy at the temperature ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "716df9d4-667c-414f-bd85-08509c2a8842"],
 " with the engine of Part II, shows that its value at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "25a7b78f-bbd2-42b5-8939-252521d817ba"],
 " is the effective potential, finds the critical temperatures, and answers \
the question (Section III.T.6). The Rust program ",
 StyleBox["sf_part3",
  FontFamily->"Source Code Pro"],
 " (module ",
 StyleBox["thermal",
  FontFamily->"Source Code Pro"],
 ") and the Python program ",
 StyleBox["sf_part3.py",
  FontFamily->"Source Code Pro"],
 " compute the same things; the closed cell of Section III.T.2 holds their \
values for the comparison."
}], "Text",ExpressionUUID->"f2501964-89c2-410c-89aa-59971333bd58"],

Cell[CellGroupData[{

Cell["III.T.1 The free energy of a state at the temperature T", "Section",ExpressionUUID->"96c37e5e-ba2f-445b-92fa-0e048a47ba51"],

Cell[TextData[{
 StyleBox["Units and conditions.",
  FontWeight->"Bold"],
 " The temperature ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "75a44a99-a4e9-4f2a-91d4-ea1ed30174a9"],
 " is measured in units of energy (Boltzmann's constant ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["k", "TI"], 
     StyleBox["B",
      FontSlant->"Plain"]], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dceb4d20-ef92-48bd-8fc0-65d3a33d2637"],
 "), in the units of the project (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4ca98d65-29d2-4c6b-86ba-750855318865"],
 "). The chemical potential ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Mu]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "936d5695-0efd-4d91-b0bc-6e1dd731eef0"],
 " of the fermion number is zero, as everywhere in the solution: the states \
hold as many particles as antiparticles. ",
 StyleBox["The thermal states.",
  FontWeight->"Bold"],
 " At the temperature ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "47653ef6-5684-4ac5-b276-3921722e14e9"],
 " a uniform quasi-free state is the thermal state of its matrix of \
Bogoliubov and de Gennes ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["H",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0ec7c47c-0f0c-46e3-846b-0863b8f3bf69"],
 " (Section II.2): at every momentum its generalized density, the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"16", "\[Times]", "16"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d47dcadf-b375-4537-a265-7e29a19f3416"],
 " matrix of the normal and the pair correlations, is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["f", "TI"], 
    RowBox[{"(", 
     SubscriptBox[
      StyleBox["H",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["SF",
       FontSlant->"Plain"]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ff599bf2-2b06-4cfd-8886-2c70d30ac644"],
 ", the Fermi function ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["f", "TI"], 
    RowBox[{"(", "\[CurlyEpsilon]", ")"}], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        StyleBox["e", "TI"], 
        RowBox[{"\[CurlyEpsilon]", "/", 
         StyleBox["T", "TI"]}]], "+", "1"}], ")"}], 
     RowBox[{"-", "1"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c80d0e01-07e6-473d-ac30-540f1d09cbf3"],
 " applied to the eigenvalues ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CurlyEpsilon]", 
    StyleBox["k", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "638b041e-8c8b-4229-a45e-812810cbb622"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["k", "TI"], "\[LongEqual]", "1", ",", "\[Ellipsis]", ",", "16"}],
    TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9b3614ba-0b1f-485b-b90f-98b380116247"],
 ") of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["H",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "886120b2-7081-4c6b-abcb-b9364bfce283"],
 ", with the occupations ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["f", "TI"], 
     StyleBox["k", "TI"]], "\[LongEqual]", 
    StyleBox["f", "TI"], 
    RowBox[{"(", 
     SubscriptBox["\[CurlyEpsilon]", 
      StyleBox["k", "TI"]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "079f2e46-d834-45ae-bfe5-5b326cd7fb70"],
 ". At ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "53cf3af5-9f94-451a-a1dd-e05c37340408"],
 " the Fermi function is 1 for the negative and 0 for the positive \
eigenvalues, and the thermal state is the ground state of Part II. ",
 StyleBox["The free energy",
  FontWeight->"Bold"],
 " per volume of method ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d282f949-d475-4aef-a483-40f3c1e5b1b4"],
 " is"
}], "Text",ExpressionUUID->"4cae9b43-83e2-4062-92fa-72c93dc7ff84"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalE]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], "-", 
   StyleBox["T", "TI"], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["\[ScriptCapitalS]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"]], ",", "      ", 
   SubscriptBox[
    StyleBox["\[ScriptCapitalS]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"]], "\[LongEqual]", 
   RowBox[{"-", 
    FractionBox["1", "2"]}], "\[ThinSpace]", "\[Integral]", 
   FractionBox[
    RowBox[{
     SuperscriptBox[
      StyleBox["d", "TI"], "3"], 
     StyleBox["q", "TI"]}], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"2", "\[Pi]"}], ")"}], "3"]], "\[ThinSpace]", 
   UnderoverscriptBox["\[Sum]", 
    RowBox[{
     StyleBox["k", "TI"], "\[LongEqual]", "1"}], "16",
    LimitsPositioning->True], 
   RowBox[{"[", 
    RowBox[{
     SubscriptBox[
      StyleBox["f", "TI"], 
      StyleBox["k", "TI"]], "\[ThinSpace]", 
     StyleBox["ln",
      FontSlant->"Plain"], "\[ThinSpace]", 
     SubscriptBox[
      StyleBox["f", "TI"], 
      StyleBox["k", "TI"]], "+", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       SubscriptBox[
        StyleBox["f", "TI"], 
        StyleBox["k", "TI"]]}], ")"}], "\[ThinSpace]", 
     StyleBox["ln",
      FontSlant->"Plain"], 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       SubscriptBox[
        StyleBox["f", "TI"], 
        StyleBox["k", "TI"]]}], ")"}]}], "]"}], ","}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"6edadec7-cd6a-4b20-bb77-60fe49c9cc70"],

Cell[TextData[{
 "with the energy per volume ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalE]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "87fbdead-fef4-49eb-b7ab-25bfb81f4208"],
 " of method ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "43faa457-3e8b-45b7-bac5-2a3f181af0ee"],
 " (unchanged, Section II.2) and the entropy per volume ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["\[ScriptCapitalS]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9f9c41f2-15e5-4a5b-9256-e0a53c459917"],
 " of the quasi-free state. Every mode of the doubled space of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["H",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3418bf21-e8c3-4ca3-8bea-8c9b17011bd3"],
 " appears twice, at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", "\[CurlyEpsilon]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b331fc98-da14-4457-93a0-6a5829140247"],
 " with the occupations ",
 Cell[BoxData[
  FormBox[
   StyleBox["f", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0cbd328d-fc6d-4ad8-9d53-046616f46fac"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "-", 
    StyleBox["f", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "28dc00f0-b007-4037-9bd3-7d91be34d592"],
 ", hence the factor ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "efd8623f-5f5d-4593-aa09-04b12990961b"],
 ". The self-energies are the derivatives of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalE]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f96285ea-fbab-4ac0-8ee4-5c3853efed12"],
 " as at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1798da0e-8f5b-4ebf-b93e-a1b820ee94a8"],
 ", and the stationary points of the free energy are the self-consistent \
thermal states. In HS this is the free energy of the saddle point of the \
auxiliary fields; in CJT the effective action at the temperature ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fa43a37a-af12-4639-9f5f-0e1527c80c89"],
 " with the truncation of the method at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fc3e28c2-3fb2-4d1c-a18f-afbe0f70a528"],
 "; in KS the functional of N. D. Mermin (the theory of Hohenberg, Kohn and \
Sham at finite temperature) with the entropy of the quasi-free state of Kohn \
and Sham and the exchange-correlation energy of the method at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "99f04b3c-285f-4b76-8144-4f7fe3c7c0ec"],
 " (in the exact theory of Mermin the exchange-correlation free energy \
depends on the temperature; here only the states do, an approximation of the \
method). ",
 StyleBox["The free energy of the field",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[CapitalPhi]", "\[RightVector]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6908243a-75c8-499c-8233-510a1b0f45f2"],
 " is the smallest free energy among the thermal states with this field, \
measured from the normal state at the same temperature:"
}], "Text",ExpressionUUID->"884bf9ce-5286-456d-a783-2daf8df6dd6f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalF]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], 
   RowBox[{"(", 
    RowBox[{
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], ";", 
     StyleBox["T", "TI"]}], ")"}], "\[LongEqual]", 
   StyleBox["min",
    FontSlant->"Plain"], 
   RowBox[{"{", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["\[ScriptCapitalE]",
       FontSlant->"Plain"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      StyleBox["X", "TI"]], "-", 
     StyleBox["T", "TI"], 
     SubscriptBox[
      StyleBox["\[ScriptCapitalS]",
       FontSlant->"Plain"], 
      StyleBox["SF",
       FontSlant->"Plain"]], ":", " ", 
     SubsuperscriptBox[
      OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      StyleBox["X", "TI"]], "\[LongEqual]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"]}], "}"}], "-", 
   SubscriptBox[
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["\[ScriptCapitalE]",
        FontSlant->"Plain"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["X", "TI"]], "-", 
      StyleBox["T", "TI"], 
      SubscriptBox[
       StyleBox["\[ScriptCapitalS]",
        FontSlant->"Plain"], 
       StyleBox["SF",
        FontSlant->"Plain"]]}], ")"}], 
    StyleBox["normal",
     FontSlant->"Plain"]], "."}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"22829e12-40c2-4867-97d3-0f098d13dc23"],

Cell[TextData[{
 "It is computed point by point as the effective potential of Section III.L: \
a fixed pair self-energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPhi]", 
     StyleBox["a",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ad71a1d4-36f4-4bb8-97fd-a00d6740b854"],
 " (the applied field) is put into ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["H",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7c8ce376-636f-43d7-92ad-9bfba21ae496"],
 ", the normal self-energy is made self-consistent at the temperature ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a9841e2e-1734-4ce7-acf9-bf87a07a4310"],
 ", and the thermal state gives one point, its own field ",
 Cell[BoxData[
  FormBox["\[CapitalPhi]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "50b852db-d008-44a2-a14d-cc2314e1cbfc"],
 " and its free energy. Its minimum lies at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}], "\[LongEqual]", 
    SubsuperscriptBox["\[CapitalPhi]", 
     RowBox[{"0", ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d5f30a4d-c47f-4323-9f01-c0c7c9ad106e"],
 ", the ",
 StyleBox["order parameter at the temperature $T$",
  FontWeight->"Bold"],
 ": the modulus of the field of the self-consistent superfluid at ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "575f9227-8782-4a2f-9e07-69995a81e5dc"],
 ". At ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "463cc58d-57ba-42d1-bc55-f9b2c1076d30"],
 " the entropy vanishes and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalF]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], 
    RowBox[{"(", 
     RowBox[{
      OverscriptBox["\[CapitalPhi]", "\[RightVector]"], ";", "0"}], ")"}], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalV]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], 
    RowBox[{"(", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], ")"}]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9a38d931-57c1-4946-8cfe-64dadb50f9b4"],
 ": ",
 StyleBox["the effective potential is the free energy at zero temperature",
  FontWeight->"Bold"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalPhi]", 
     RowBox[{"0", ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]], 
    RowBox[{"(", "0", ")"}], "\[LongEqual]", 
    SubsuperscriptBox["\[CapitalPhi]", 
     RowBox[{"0", ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d53ae804-2c34-46c6-b792-dedf11525996"],
 ". The next cell defines the thermal states of the engine of Part II: ",
 StyleBox["thermalNode",
  FontFamily->"Source Code Pro"],
 " makes ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["f", "TI"], 
    RowBox[{"(", 
     SubscriptBox[
      StyleBox["H",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["SF",
       FontSlant->"Plain"]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2678bf8c-725d-43ed-9cf6-752397bc4e18"],
 " and the entropy of one node of the grid, ",
 StyleBox["solveSFT",
  FontFamily->"Source Code Pro"],
 " the self-consistent thermal state, and ",
 StyleBox["fixedPairT",
  FontFamily->"Source Code Pro"],
 " the thermal state of an applied pair field."
}], "Text",ExpressionUUID->"5f55a144-01bd-4ea1-b713-c24b885d56d3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"fermiSF", "[", 
     RowBox[{"e", ",", " ", "t"}], "]"}], ":", " ", 
    RowBox[{"the", " ", "Fermi", " ", "function", " ", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"e", "^", 
         RowBox[{"(", 
          RowBox[{"e", "/", "t"}], ")"}]}], " ", "+", " ", "1"}], ")"}]}], " ",
      "of", " ", "the", " ", "energy", " ", "e", " ", "at", " ", "the", " ", 
     "temperature", " ", "t", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"the", " ", "step", " ", "function", " ", "at", " ", "t"}], 
       " ", "=", " ", "0"}], ")"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"fermiSF", "[", 
      RowBox[{
       RowBox[{"e_", "?", "NumericQ"}], ",", " ", 
       RowBox[{"t_", "?", "NumericQ"}]}], "]"}], " ", ":=", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"t", " ", "<=", " ", "0"}], ",", " ", 
       RowBox[{"Which", "[", 
        RowBox[{
         RowBox[{"e", " ", "<", " ", "0"}], ",", " ", "1.", ",", " ", 
         RowBox[{"e", " ", ">", " ", "0"}], ",", " ", "0.", ",", " ", "True", 
         ",", " ", "0.5"}], "]"}], ",", " ", 
       RowBox[{"1.", "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{"Clip", "[", 
            RowBox[{
             RowBox[{"e", "/", "t"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "700."}], ",", " ", "700."}], "}"}]}], "]"}], 
           "]"}], " ", "+", " ", "1."}], ")"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"binEntropy", "[", "f", "]"}], ":", " ", 
     RowBox[{
      RowBox[{"the", " ", "entropy"}], " ", "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"f", " ", "ln", " ", "f"}], " ", "+", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", " ", "-", " ", "f"}], ")"}], " ", "ln", 
          RowBox[{"(", 
           RowBox[{"1", " ", "-", " ", "f"}], ")"}]}]}], ")"}], " ", "of", " ",
        "a", " ", "mode", " ", "with", " ", "the", " ", "occupation", " ", 
       "f", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"zero", " ", "at", " ", "f"}], " ", "=", " ", 
         RowBox[{
          RowBox[{"0", " ", "and", " ", "f"}], " ", "=", " ", "1"}]}], 
        ")"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"binEntropy", "[", "f_", "]"}], " ", ":=", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"0", " ", "<", " ", "f", " ", "<", " ", "1"}], ",", " ", 
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"f", " ", 
           RowBox[{"Log", "[", "f", "]"}]}], " ", "+", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", " ", "-", " ", "f"}], ")"}], " ", 
           RowBox[{"Log", "[", 
            RowBox[{"1", " ", "-", " ", "f"}], "]"}]}]}], ")"}]}], ",", " ", 
       "0."}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"thermalNode", "[", 
      RowBox[{"h", ",", " ", "t"}], "]"}], ":", " ", 
     RowBox[{"the", " ", "thermal", " ", "state", " ", "f", 
      RowBox[{"(", "H", ")"}], " ", "of", " ", "one", " ", "BdG", " ", 
      "matrix", " ", "h", " ", "at", " ", "the", " ", "temperature", " ", 
      "t"}], ":", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"C", "^", "n"}], ",", " ", 
       RowBox[{"C", "^", "p"}], ",", " ", 
       RowBox[{"the", " ", "sorted", " ", "eigenvalues"}], ",", " ", 
       RowBox[{
       "the", " ", "sum", " ", "of", " ", "the", " ", "entropies", " ", "of", 
        " ", "the", " ", "16", " ", "modes"}]}], "}"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"thermalNode", "[", 
      RowBox[{"h_", ",", " ", "t_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ev", ",", " ", "vec", ",", " ", "f", ",", " ", "r"}], "}"}], 
       ",", "\n", "   ", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"ev", ",", " ", "vec"}], "}"}], " ", "=", " ", 
         RowBox[{"Eigensystem", "[", 
          RowBox[{"0.5", " ", 
           RowBox[{"(", 
            RowBox[{"h", " ", "+", " ", 
             RowBox[{"ConjugateTranspose", "[", "h", "]"}]}], ")"}]}], 
          "]"}]}], ";", " ", 
        RowBox[{"ev", " ", "=", " ", 
         RowBox[{"Re", "[", "ev", "]"}]}], ";", "\n", "   ", 
        RowBox[{"f", " ", "=", " ", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"fermiSF", "[", 
             RowBox[{"#", ",", " ", "t"}], "]"}], " ", "&"}], ",", " ", 
           "ev"}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"r", " ", "=", " ", 
         RowBox[{
          RowBox[{"Transpose", "[", "vec", "]"}], " ", ".", " ", 
          RowBox[{"DiagonalMatrix", "[", "f", "]"}], " ", ".", " ", 
          RowBox[{"Conjugate", "[", "vec", "]"}]}]}], ";", "   ", 
        RowBox[{"(*", " ", 
         RowBox[{"R", " ", "=", " ", 
          RowBox[{"sum_k", " ", "f_k", " ", "v_k", " ", 
           RowBox[{"v_k", "^", "dag"}]}]}], " ", "*)"}], "\n", "   ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"r", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"1", " ", ";;", " ", "8"}], ",", " ", 
             RowBox[{"1", " ", ";;", " ", "8"}]}], "]"}], "]"}], ",", " ", 
          RowBox[{"-", 
           RowBox[{"r", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"1", " ", ";;", " ", "8"}], ",", " ", 
              RowBox[{"9", " ", ";;", " ", "16"}]}], "]"}], "]"}]}], ",", " ", 
          RowBox[{"Sort", "[", "ev", "]"}], ",", " ", 
          RowBox[{"Total", "[", 
           RowBox[{"Map", "[", 
            RowBox[{"binEntropy", ",", " ", "f"}], "]"}], "]"}]}], "}"}]}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"solveSFT", "[", 
       RowBox[{
       "mo", ",", " ", "N0", ",", " ", "P0", ",", " ", "t", ",", " ", "mix", ",",
         " ", "tol", ",", " ", "maxit"}], "]"}], ":", " ", 
      RowBox[{
       RowBox[{"the", " ", "self"}], "-", 
       RowBox[{
       "consistent", " ", "thermal", " ", "state", " ", "at", " ", "the", " ",
         "temperature", " ", "t", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
          "the", " ", "stationary", "\n", "   ", "point", " ", "of", " ", 
           "E"}], " ", "-", " ", 
          RowBox[{"t", " ", "S"}]}], ")"}], " ", "from", " ", "the", " ", 
        "initial", " ", "self"}], "-", 
       RowBox[{"energies", " ", "N0"}]}]}], ",", " ", 
     RowBox[{"P0", ":", " ", 
      RowBox[{
       RowBox[{"the", " ", "self"}], "-", "energies"}]}], ",", " ", 
     RowBox[{"the", " ", "energy", " ", "per", " ", "volume", " ", 
      RowBox[{"(", 
       RowBox[{"from", " ", "the", " ", "normal", "\n", "   ", "vacuum"}], 
       ")"}]}], ",", " ", 
     RowBox[{"the", " ", "entropy", " ", "per", " ", "volume"}], ",", " ", 
     RowBox[{
     "the", " ", "free", " ", "energy", " ", "per", " ", "volume", " ", "and",
       " ", "the", " ", "number", " ", "of", " ", "iterations"}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"solveSFT", "[", 
      RowBox[{
      "mo_", ",", " ", "n0_", ",", " ", "p0_", ",", " ", "t_", ",", " ", 
       RowBox[{"mix_", " ", ":", " ", "0.6"}], ",", " ", 
       RowBox[{"tol_", " ", ":", " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "13"}]}]}], ",", " ", 
       RowBox[{"maxit_", " ", ":", " ", "400000"}]}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", "\n", "   ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ns", " ", "=", " ", "n0"}], ",", " ", 
         RowBox[{"ps", " ", "=", " ", "p0"}], ",", " ", "res", ",", " ", "cn",
          ",", " ", "cp", ",", " ", "ent", ",", " ", "rho", ",", " ", "kap", ",",
          " ", "ek", ",", " ", "ei", ",", " ", "n2", ",", " ", "p2", ",", " ",
          "r", ",", " ", 
         RowBox[{"it", " ", "=", " ", "0"}], ",", " ", 
         RowBox[{"out", " ", "=", " ", "None"}]}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{"out", " ", "===", " ", "None"}], ",", "\n", "     ", 
          RowBox[{
           RowBox[{"res", " ", "=", " ", 
            RowBox[{"Map", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"thermalNode", "[", 
                RowBox[{"#", ",", " ", "t"}], "]"}], " ", "&"}], ",", " ", 
              RowBox[{"bdg", "[", 
               RowBox[{"mo", ",", " ", "ns", ",", " ", "ps"}], "]"}]}], 
             "]"}]}], ";", "\n", "     ", 
           RowBox[{"cn", " ", "=", " ", 
            RowBox[{"res", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], ";", " ", 
           RowBox[{"cp", " ", "=", " ", 
            RowBox[{"res", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], ";", "\n", 
           "     ", 
           RowBox[{"ent", " ", "=", " ", 
            RowBox[{"0.5", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"mo", "[", "\"\<g\>\"", "]"}], "[", "\"\<w\>\"", "]"}],
               " ", ".", " ", 
              RowBox[{"res", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", " ", "4"}], "]"}], "]"}]}]}]}], ";", "\n",
            "     ", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"rho", ",", " ", "kap", ",", " ", "ek"}], "}"}], " ", "=",
             " ", 
            RowBox[{"localDens", "[", 
             RowBox[{"mo", ",", " ", "cn", ",", " ", "cp"}], "]"}]}], ";", 
           "\n", "     ", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"ei", ",", " ", "n2", ",", " ", "p2"}], "}"}], " ", "=", 
            " ", 
            RowBox[{"interaction", "[", 
             RowBox[{
              RowBox[{"mo", "[", "\"\<ts\>\"", "]"}], ",", " ", "rho", ",", 
              " ", "kap"}], "]"}]}], ";", "\n", "     ", 
           RowBox[{"r", " ", "=", " ", 
            RowBox[{"Max", "[", 
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{"n2", " ", "-", " ", "ns"}], "]"}], ",", " ", 
              RowBox[{"Abs", "[", 
               RowBox[{"p2", " ", "-", " ", "ps"}], "]"}]}], "]"}]}], ";", 
           "\n", "     ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"r", " ", "<", " ", "tol"}], " ", "||", " ", 
              RowBox[{"it", " ", ">=", " ", "maxit"}]}], ",", "\n", "       ", 
             RowBox[{"out", " ", "=", " ", 
              RowBox[{"<|", 
               RowBox[{
                RowBox[{"\"\<n\>\"", " ", "->", " ", "n2"}], ",", " ", 
                RowBox[{"\"\<p\>\"", " ", "->", " ", "p2"}], ",", " ", 
                RowBox[{"\"\<e\>\"", " ", "->", " ", 
                 RowBox[{"ek", " ", "+", " ", "ei"}]}], ",", " ", 
                RowBox[{"\"\<s\>\"", " ", "->", " ", "ent"}], ",", " ", 
                RowBox[{"\"\<free\>\"", " ", "->", " ", 
                 RowBox[{"ek", " ", "+", " ", "ei", " ", "-", " ", 
                  RowBox[{"t", " ", "ent"}]}]}], ",", " ", 
                RowBox[{"\"\<it\>\"", " ", "->", " ", "it"}], ",", " ", 
                RowBox[{"\"\<res\>\"", " ", "->", " ", "r"}]}], "|>"}]}], ",",
              "\n", "       ", 
             RowBox[{
              RowBox[{"ns", " ", "=", " ", 
               RowBox[{
                RowBox[{"mix", " ", "n2"}], " ", "+", " ", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", " ", "-", " ", "mix"}], ")"}], " ", "ns"}]}]}],
               ";", " ", 
              RowBox[{"ps", " ", "=", " ", 
               RowBox[{
                RowBox[{"mix", " ", "p2"}], " ", "+", " ", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", " ", "-", " ", "mix"}], ")"}], " ", "ps"}]}]}],
               ";", "\n", "       ", 
              RowBox[{"ns", " ", "=", " ", 
               RowBox[{"0.5", " ", 
                RowBox[{"(", 
                 RowBox[{"ns", " ", "+", " ", 
                  RowBox[{"ConjugateTranspose", "[", "ns", "]"}]}], ")"}]}]}],
               ";", " ", 
              RowBox[{"ps", " ", "=", " ", 
               RowBox[{"0.5", " ", 
                RowBox[{"(", 
                 RowBox[{"ps", " ", "-", " ", 
                  RowBox[{"Transpose", "[", "ps", "]"}]}], ")"}]}]}], ";", 
              "\n", "       ", 
              RowBox[{"it", "++"}]}]}], "]"}]}]}], "]"}], ";", "\n", "   ", 
        "out"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"fixedPairT", "[", 
       RowBox[{"mo", ",", " ", "pfix", ",", " ", "N0", ",", " ", "t"}], "]"}],
       ":", " ", 
      RowBox[{
       RowBox[{
       "the", " ", "thermal", " ", "state", " ", "of", " ", "the", " ", 
        "applied", " ", "pair", " ", "self"}], "-", 
       RowBox[{
       "energy", " ", "pfix", " ", "at", " ", "the", " ", "temperature", " ", 
        "t"}]}]}], ",", " ", 
     RowBox[{
      RowBox[{"with", " ", "the", "\n", "   ", "normal", " ", "self"}], "-", 
      RowBox[{"energy", " ", "made", " ", "self"}], "-", 
      RowBox[{"consistent", ":", " ", 
       RowBox[{"{", 
        RowBox[{"N", ",", " ", 
         RowBox[{
         "the", " ", "field", " ", "Phi", " ", "of", " ", "the", " ", "state",
           " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
            "the", " ", "modulus", " ", "of", " ", "the", " ", "amplitude", " ",
              "of", " ", "its", " ", "own", "\n", "   ", "pair", " ", 
             "self"}], "-", 
            RowBox[{"energy", " ", "in", " ", "the", " ", "channel", " ", 
             RowBox[{"K", "^", "3"}]}]}], ")"}]}], ",", " ", 
         RowBox[{
         "its", " ", "free", " ", "energy", " ", "per", " ", "volume"}]}], 
        "}"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"fixedPairT", "[", 
      RowBox[{
      "mo_", ",", " ", "pfix_", ",", " ", "n0_", ",", " ", "t_", ",", " ", 
       RowBox[{"tol_", " ", ":", " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "14"}]}]}]}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ns", " ", "=", " ", "n0"}], ",", " ", "res", ",", " ", "cn",
          ",", " ", "cp", ",", " ", "ent", ",", " ", "rho", ",", " ", "kap", ",",
          " ", "ek", ",", " ", "ei", ",", " ", "n2", ",", " ", "p2", ",", " ", 
         RowBox[{"done", " ", "=", " ", "False"}], ",", " ", 
         RowBox[{"it", " ", "=", " ", "0"}]}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{"!", " ", "done"}], ",", "\n", "     ", 
          RowBox[{
           RowBox[{"res", " ", "=", " ", 
            RowBox[{"Map", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"thermalNode", "[", 
                RowBox[{"#", ",", " ", "t"}], "]"}], " ", "&"}], ",", " ", 
              RowBox[{"bdg", "[", 
               RowBox[{"mo", ",", " ", "ns", ",", " ", "pfix"}], "]"}]}], 
             "]"}]}], ";", "\n", "     ", 
           RowBox[{"cn", " ", "=", " ", 
            RowBox[{"res", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], ";", " ", 
           RowBox[{"cp", " ", "=", " ", 
            RowBox[{"res", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], ";", "\n", 
           "     ", 
           RowBox[{"ent", " ", "=", " ", 
            RowBox[{"0.5", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"mo", "[", "\"\<g\>\"", "]"}], "[", "\"\<w\>\"", "]"}],
               " ", ".", " ", 
              RowBox[{"res", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", " ", "4"}], "]"}], "]"}]}]}]}], ";", "\n",
            "     ", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"rho", ",", " ", "kap", ",", " ", "ek"}], "}"}], " ", "=",
             " ", 
            RowBox[{"localDens", "[", 
             RowBox[{"mo", ",", " ", "cn", ",", " ", "cp"}], "]"}]}], ";", 
           "\n", "     ", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"ei", ",", " ", "n2", ",", " ", "p2"}], "}"}], " ", "=", 
            " ", 
            RowBox[{"interaction", "[", 
             RowBox[{
              RowBox[{"mo", "[", "\"\<ts\>\"", "]"}], ",", " ", "rho", ",", 
              " ", "kap"}], "]"}]}], ";", "\n", "     ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Max", "[", 
                RowBox[{"Abs", "[", 
                 RowBox[{"n2", " ", "-", " ", "ns"}], "]"}], "]"}], " ", "<", 
               " ", "tol"}], " ", "||", " ", 
              RowBox[{"it", " ", ">=", " ", "200000"}]}], ",", " ", 
             RowBox[{"done", " ", "=", " ", "True"}], ",", "\n", "       ", 
             RowBox[{
              RowBox[{"ns", " ", "=", " ", 
               RowBox[{
                RowBox[{"0.7", " ", "n2"}], " ", "+", " ", 
                RowBox[{"0.3", " ", "ns"}]}]}], ";", " ", 
              RowBox[{"ns", " ", "=", " ", 
               RowBox[{"0.5", " ", 
                RowBox[{"(", 
                 RowBox[{"ns", " ", "+", " ", 
                  RowBox[{"ConjugateTranspose", "[", "ns", "]"}]}], ")"}]}]}],
               ";", " ", 
              RowBox[{"it", "++"}]}]}], "]"}]}]}], "]"}], ";", "\n", "   ", 
        RowBox[{"{", 
         RowBox[{"n2", ",", " ", 
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"Tr", "[", 
             RowBox[{
              RowBox[{"k8", "[", "3", "]"}], " ", ".", " ", "p2"}], "]"}], "/",
             "8"}], "]"}], ",", " ", 
          RowBox[{"ek", " ", "+", " ", "ei", " ", "-", " ", 
           RowBox[{"t", " ", "ent"}]}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"phiOf", "[", "sol", "]"}], ":", " ", 
      RowBox[{
       RowBox[{
       "the", " ", "order", " ", "parameter", " ", "of", " ", "a", " ", 
        "self"}], "-", 
       RowBox[{"consistent", " ", "state"}]}]}], ",", " ", 
     RowBox[{
      RowBox[{
      "the", " ", "modulus", " ", "of", " ", "the", " ", "amplitude", " ", 
       "of", " ", "its", " ", "pair", " ", "self"}], "-", "energy"}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"phiOf", "[", "sol_", "]"}], " ", ":=", " ", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"Tr", "[", 
        RowBox[{
         RowBox[{"k8", "[", "3", "]"}], " ", ".", " ", 
         RowBox[{"sol", "[", "\"\<p\>\"", "]"}]}], "]"}], "/", "8"}], "]"}]}],
     ";"}], "\n", 
