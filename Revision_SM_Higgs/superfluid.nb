}]}]}]}]}]}], "-", "3"}], ":", " ", 
    RowBox[{
    "the", " ", "amplitude", " ", "mode", " ", "at", " ", "d_", "0"}]}], " ", 
   "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"i1", "[", "mm_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{"1", " ", "+", " ", 
          RowBox[{"mm", "^", "2"}]}], "]"}], " ", "-", " ", 
        RowBox[{
         RowBox[{"mm", "^", "2"}], " ", 
         RowBox[{"ArcSinh", "[", 
          RowBox[{"1", "/", "mm"}], "]"}]}]}], ")"}], "/", "2"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"mLL", " ", "=", " ", 
     RowBox[{"1", "/", "5"}]}], ";", " ", 
    RowBox[{"gSH", " ", "=", " ", 
     RowBox[{"504", "/", "5"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"mEff", " ", "=", " ", 
     RowBox[{"mm", " ", "/.", " ", 
      RowBox[{"FindRoot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"gSH", " ", 
          RowBox[{
           RowBox[{"i1", "[", "mm", "]"}], "/", 
           RowBox[{"(", 
            RowBox[{"4", " ", 
             RowBox[{"Pi", "^", "2"}]}], ")"}]}]}], " ", "==", " ", "1"}], ",",
         " ", 
        RowBox[{"{", 
         RowBox[{"mm", ",", " ", 
          RowBox[{"9", "/", "20"}]}], "}"}], ",", " ", 
        RowBox[{"WorkingPrecision", " ", "->", " ", "40"}]}], "]"}]}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"d0", " ", "=", " ", 
     RowBox[{"2", " ", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"mEff", "^", "2"}], " ", "-", " ", 
        RowBox[{"mLL", "^", "2"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rhdr", ",", " ", "rrows"}], "}"}], " ", "=", " ", 
     RowBox[{"readTable", "[", "runsFile", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sel", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{"rrows", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", 
            RowBox[{"col", "[", 
             RowBox[{"rhdr", ",", " ", "\"\<kind\>\""}], "]"}], "]"}], "]"}], 
          " ", "==", " ", "\"\<amplitude\>\""}], " ", "&&", " ", 
         RowBox[{"MemberQ", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\"\<HS (0, 1)\>\"", ",", " ", "\"\<HS (0, 0)\>\""}], 
            "}"}], ",", " ", 
           RowBox[{"#", "[", 
            RowBox[{"[", 
             RowBox[{"col", "[", 
              RowBox[{"rhdr", ",", " ", "\"\<method\>\""}], "]"}], "]"}], 
            "]"}]}], "]"}]}], " ", "&"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dev3", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"num", "[", 
            RowBox[{"#", "[", 
             RowBox[{"[", 
              RowBox[{"col", "[", 
               RowBox[{"rhdr", ",", " ", "\"\<omega_peak\>\""}], "]"}], "]"}],
              "]"}], "]"}], " ", "-", " ", "d0"}], "]"}], "/", "d0"}], " ", 
        "&"}], " ", "/@", " ", "sel"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rvCheck", "[", 
     RowBox[{"\"\<WD-3\>\"", ",", " ", 
      RowBox[{"\"\<the peaks of the amplitude runs of HS (0, 1) and HS (0, 0) \
of the Rust program (both versions) lie at d_0 = \>\"", " ", "<>", "\n", "  ", 
       RowBox[{"ToString", "[", 
        RowBox[{"NumberForm", "[", 
         RowBox[{
          RowBox[{"N", "[", 
           RowBox[{"d0", ",", " ", "20"}], "]"}], ",", " ", "20"}], "]"}], 
        "]"}], " ", "<>", " ", "\"\< of the gap equation (relative)\>\""}], ",",
       " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "sel", "]"}], " ", "==", " ", "4"}], " ", "&&",
        " ", 
       RowBox[{"dev3", " ", "<", " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "4"}]}]}]}], ",", " ", 
      RowBox[{"\"\<deviation \>\"", " ", "<>", " ", 
       RowBox[{"sci", "[", "dev3", "]"}]}]}], "]"}], ";"}]}]}]], "Input",
 CellLabel->
  "In[740]:=",ExpressionUUID->"79f18bf1-11e8-4542-af21-0c75c9783aac"],

