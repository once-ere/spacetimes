]}]}]}]}]}]}], "-", "4"}], ":", " ", 
    RowBox[{"the", " ", "charges"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"qd", " ", "=", " ", 
     RowBox[{"Diagonal", "[", "QQ", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ok4", " ", "=", " ", 
     RowBox[{
      RowBox[{"qd", " ", "==", " ", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"3", "/", "4"}], ",", " ", 
              RowBox[{
               RowBox[{"-", "1"}], "/", "4"}]}], "}"}], ",", " ", "4"}], 
           "]"}], "]"}], ",", " ", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{
           RowBox[{"1", "/", "4"}], ",", " ", "4"}], "]"}], ",", " ", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "3"}], "/", "4"}], ",", " ", "4"}], "]"}]}], "]"}]}],
       " ", "&&", "\n", "  ", 
      RowBox[{
       RowBox[{"Diagonal", "[", 
        RowBox[{"4", " ", "YY"}], "]"}], " ", "==", " ", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"ConstantArray", "[", 
          RowBox[{"1", ",", " ", "12"}], "]"}], ",", " ", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{
           RowBox[{"-", "3"}], ",", " ", "4"}], "]"}]}], "]"}]}], " ", "&&", 
      "\n", "  ", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"T", "[", "a", "]"}], ".", 
          RowBox[{"T", "[", "a", "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"a", ",", " ", "3"}], "}"}]}], "]"}], " ", "==", " ", 
       RowBox[{"blk", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"3", "/", "4"}], " ", 
          RowBox[{"IdentityMatrix", "[", "8", "]"}]}], ",", " ", "z8"}], 
        "]"}]}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"TR", "[", "a", "]"}], ".", 
          RowBox[{"TR", "[", "a", "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"a", ",", " ", "3"}], "}"}]}], "]"}], " ", "==", " ", 
       RowBox[{"blk", "[", 
        RowBox[{"z8", ",", " ", 
         RowBox[{
          RowBox[{"3", "/", "4"}], " ", 
          RowBox[{"IdentityMatrix", "[", "8", "]"}]}]}], "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rvCheck", "[", 
     RowBox[{"\"\<WQN-4\>\"", ",", 
      " ", "\"\<Q = 3/4 (up), -1/4 (down) on Psi_LL, 1/4 on chi_SH, -3/4 on \
chi'_SH; 4 Y = F_tot on Psi_LL and chi_SH, \\\n-3 F_tot on chi'_SH; the \
Casimir operators 3/4 of SU(2)_L on Psi_LL and of SU(2)_R on the singlets\>\"",
       ",", " ", "ok4", ",", "\n", "  ", 
      RowBox[{"\"\<Q on the components 0..15: \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"qd", ",", " ", "InputForm"}], "]"}]}]}], "]"}], 
    ";"}]}]}]], "Input",
