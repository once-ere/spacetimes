        FontSlant->"Plain"], "0"], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "eb0ad997-23b1-49df-a5d0-20e475f20f01"],
 ". In the first version one pair field gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Omega]", "2"], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["V", "TI"], "\[Prime]\[Prime]"], "/", 
    RowBox[{"(", 
     RowBox[{"2", 
      SubscriptBox[
       StyleBox["Z", "TI"], 
       StyleBox["SH",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "39bd296b-e5bd-402b-ae8d-03ed8c80e9f8"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Chi]", 
     StyleBox["SH",
      FontSlant->"Plain"], "33"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["Z", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[CurlyPhi]", 
       StyleBox["SH",
        FontSlant->"Plain"], "0"], ")"}], "2"], "/", "2"}], TraditionalForm]],
   "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "72dbacca-854a-4dfc-92b3-306596011606"],
 ". In both versions"
}], "Text",ExpressionUUID->"c56cbc60-08b8-4b70-97b0-d8f3bc57474e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["M", "TI"], 
      StyleBox["SH",
       FontSlant->"Plain"], 
      StyleBox["EFT",
       FontSlant->"Plain"]], ")"}], "2"], "\[LongEqual]", 
   FractionBox[
    RowBox[{
     SubsuperscriptBox[
      StyleBox["V", "TI"], 
      StyleBox["SH",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["eff",
        FontSlant->"Plain"], "\[ThinSpace]", "\[Prime]", "\[Prime]"}]], 
     RowBox[{"(", 
      SubsuperscriptBox["\[CurlyPhi]", 
       StyleBox["SH",
        FontSlant->"Plain"], "0"], ")"}], "\[ThinSpace]", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox["\[CurlyPhi]", 
        StyleBox["SH",
         FontSlant->"Plain"], "0"], ")"}], "2"]}], 
    RowBox[{"4", 
     SubsuperscriptBox["\[Chi]", 
      StyleBox["SH",
       FontSlant->"Plain"], "33"]}]], ","}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"75e6ba45-8f4e-4e26-9a4d-a8a981560aef"],

Cell["\<\
the formula with which the Rust program computes the mass of the effective \
Lagrangian from its potential and its susceptibility.\
\>", "Text",ExpressionUUID->"a431ad75-8f6d-4c83-846f-6f8e2285b299"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", 
          RowBox[{"--", 
           RowBox[{"--", 
            RowBox[{"--", 
             RowBox[{"--", 
              RowBox[{"--", 
               RowBox[{"--", 
                RowBox[{"--", 
                 RowBox[{"--", 
                  RowBox[{"--", 
                   RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{
                    "--", " ", 
                    "WH"}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]\
}]}]}]}]}]}], "-", "2"}], ":", " ", 
    RowBox[{
    "the", " ", "amplitude", " ", "mode", " ", "of", " ", "the", " ", 
     "effective", " ", "Lagrangian"}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"second", " ", 
      RowBox[{"version", ":", " ", "L"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"Z", " ", 
       RowBox[{"(", 
        RowBox[{"|", 
         RowBox[{"d", " ", 
          RowBox[{"Phi", "^", "d"}]}], "|", 
         RowBox[{
          RowBox[{"^", "2"}], " ", "+"}], " ", "|", 
         RowBox[{"d", " ", 
          RowBox[{
           RowBox[{"Phi", "'"}], "^", "u"}]}], "|", 
         RowBox[{"^", "2"}]}], ")"}]}], " ", "-", " ", 
      RowBox[{"V", 
       RowBox[{"(", "phi", ")"}]}]}]}], ",", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"both", " ", "lengths", " ", "phi0"}], " ", "+", " ", "eta"}], ";",
      " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"chi", "^", 
         RowBox[{"{", "33", "}"}]}], " ", "from", " ", "a", " ", "chemical", "\n",
         "   ", "potential", " ", "of", " ", 
        RowBox[{"T", "^", "3"}], " ", 
        RowBox[{"(", 
         RowBox[{"charges", " ", "-", 
          RowBox[{
           RowBox[{"1", "/", "2"}], " ", "and"}], " ", "+", 
          RowBox[{"1", "/", "2"}]}], ")"}]}], ":", " ", 
       RowBox[{"E", 
        RowBox[{"(", "mu", ")"}]}]}], " ", "=", " ", 
      RowBox[{"V", " ", "-", " ", 
       RowBox[{"Z", " ", 
        RowBox[{"mu", "^", "2"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"1", "/", "4"}], " ", "+", " ", 
          RowBox[{"1", "/", "4"}]}], ")"}], " ", 
        RowBox[{"phi0", "^", "2"}]}]}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"chi33v2", " ", "=", " ", 
     RowBox[{"-", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "zz"}], " ", 
         RowBox[{"mu3", "^", "2"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"1", "/", "4"}], " ", "+", " ", 
           RowBox[{"1", "/", "4"}]}], ")"}], " ", 
         RowBox[{"phi0", "^", "2"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"mu3", ",", " ", "2"}], "}"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", 
      RowBox[{"amplitude", ":", " ", 
       RowBox[{"kinetic", " ", "term", " ", "2", " ", "Z", " ", 
        RowBox[{
         RowBox[{"eta", "'"}], "^", "2"}]}]}]}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"potential", " ", 
        RowBox[{"V", "''"}], " ", 
        RowBox[{
         RowBox[{"eta", "^", "2"}], " ", "/", " ", "2"}]}], ":", " ", 
       RowBox[{"omega", "^", "2"}]}], " ", "=", " ", 
      RowBox[{
       RowBox[{"V", "''"}], " ", "/", " ", 
       RowBox[{"(", 
        RowBox[{"4", " ", "Z"}], ")"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"om2v2", " ", "=", " ", 
     RowBox[{"vpp", "/", 
      RowBox[{"(", 
       RowBox[{"4", " ", "zz"}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"okV2", " ", "=", " ", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{"om2v2", " ", "-", " ", 
        RowBox[{"vpp", " ", 
         RowBox[{
          RowBox[{"phi0", "^", "2"}], "/", 
          RowBox[{"(", 
           RowBox[{"4", " ", "chi33v2"}], ")"}]}]}]}], "]"}], " ", "==", " ", 
      "0"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"first", " ", 
       RowBox[{"version", ":", " ", "L"}]}], " ", "=", " ", 
      RowBox[{"Z", " ", "|", 
       RowBox[{"d", " ", 
        RowBox[{"Phi", "^", "d"}]}], "|", 
       RowBox[{
        RowBox[{"^", "2"}], " ", "-", " ", 
        RowBox[{"V", 
         RowBox[{"(", "phi", ")"}]}]}]}]}], ";", " ", 
     RowBox[{
      RowBox[{"chi", "^", 
       RowBox[{"{", "33", "}"}]}], " ", "=", " ", 
      RowBox[{"2", " ", "Z", " ", 
       RowBox[{"(", 
        RowBox[{"1", "/", "4"}], ")"}], " ", 
       RowBox[{"phi0", "^", "2"}]}]}], ";", " ", 
     RowBox[{"amplitude", ":", " ", 
      RowBox[{
       RowBox[{"Z", " ", 
        RowBox[{
         RowBox[{"eta", "'"}], "^", "2"}]}], " ", "-", " ", 
       RowBox[{
        RowBox[{"V", "''"}], " ", 
        RowBox[{
         RowBox[{"eta", "^", "2"}], "/", "2"}]}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"chi33v1", " ", "=", " ", 
     RowBox[{"-", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "zz"}], " ", 
         RowBox[{"mu3", "^", "2"}], " ", 
         RowBox[{"(", 
          RowBox[{"1", "/", "4"}], ")"}], " ", 
         RowBox[{"phi0", "^", "2"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"mu3", ",", " ", "2"}], "}"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"om2v1", " ", "=", " ", 
     RowBox[{"vpp", "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", "zz"}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"okV1", " ", "=", " ", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{"om2v1", " ", "-", " ", 
        RowBox[{"vpp", " ", 
         RowBox[{
          RowBox[{"phi0", "^", "2"}], "/", 
          RowBox[{"(", 
           RowBox[{"4", " ", "chi33v1"}], ")"}]}]}]}], "]"}], " ", "==", " ", 
      "0"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rvCheck", "[", 
     RowBox[{"\"\<WH-2\>\"", ",", " ", 
      RowBox[{"\"\<the effective Lagrangian of the pair fields gives the mass \
of the amplitude mode M^2 = V'' phi_0^2 / (4 \\\nchi^{33}) in both versions: \
second version chi^{33} = \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"chi33v2", ",", " ", "InputForm"}], "]"}], " ", "<>", 
       " ", "\"\<, M^2 = V''/(4 Z); first \\\nversion chi^{33} = \>\"", " ", "<>",
        " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"chi33v1", ",", " ", "InputForm"}], "]"}], " ", "<>", 
       " ", "\"\<, M^2 = V''/(2 Z) (symbolic)\>\""}], ",", " ", 
      RowBox[{"okV2", " ", "&&", " ", "okV1"}], ",", 
      " ", "\"\<identities\>\""}], "]"}], ";"}]}]}]], "Input",
 CellLabel->
  "In[659]:=",ExpressionUUID->"b90184a3-0d0f-4dc7-abb9-c87fd6fd4e6e"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"PASS \"\>", "\[InvisibleSpace]", "\<\"WH-2\"\>", 
   "\[InvisibleSpace]", "\<\"  \"\>", 
   "\[InvisibleSpace]", "\<\"the effective Lagrangian of the pair fields \
gives the mass of the amplitude mode M^2 = V'' phi_0^2 / (4 chi^{33}) in both \
versions: second version chi^{33} = phi0^2*zz, M^2 = V''/(4 Z); first version \
chi^{33} = (phi0^2*zz)/2, M^2 = V''/(2 Z) (symbolic)\"\>", 
   "\[InvisibleSpace]", "\<\" [\"\>", 
   "\[InvisibleSpace]", "\<\"identities\"\>", 
   "\[InvisibleSpace]", "\<\"]   [the same check: Rust \"\>", 
   "\[InvisibleSpace]", "\<\"none (the column M_EFT)\"\>", 
   "\[InvisibleSpace]", "\<\", Python \"\>", 
   "\[InvisibleSpace]", "\<\"YH-5\"\>", "\[InvisibleSpace]", "\<\"]\"\>"}],
  SequenceForm[
  "PASS ", "WH-2", "  ", 
   "the effective Lagrangian of the pair fields gives the mass of the \
amplitude mode M^2 = V'' phi_0^2 / (4 chi^{33}) in both versions: second \
version chi^{33} = phi0^2*zz, M^2 = V''/(4 Z); first version chi^{33} = \
(phi0^2*zz)/2, M^2 = V''/(2 Z) (symbolic)", " [", "identities", 
   "]   [the same check: Rust ", "none (the column M_EFT)", ", Python ", 
   "YH-5", "]"],
  Editable->False]], "Print",
 CellChangeTimes->{4.004331601257745*^9},
