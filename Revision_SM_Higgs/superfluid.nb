  "In[560]:=",ExpressionUUID->"382675f2-5068-47d0-b916-d57a1af64568"],

Cell[CellGroupData[{

Cell["\<\
R.2.1 The pair matrices and the critical coupling (checks WSF-2a and WSF-2b)\
\>", "Subsection",ExpressionUUID->"645280d3-5e22-456e-a36f-76eb86ee0e38"],

Cell[TextData[{
 "On the whole field ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["SH",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4290b2fa-2213-439a-b19c-ecb9f513a26c"],
 " of sixteen components a pair reads ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalPsi]", 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["T", "TI"]], 
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["SH",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1f4ae260-65e6-4d3e-93fa-a543405ed95e"],
 " with an antisymmetric matrix ",
 Cell[BoxData[
  FormBox[
   StyleBox["K",
    FontFamily->"Helvetica",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9fbda3cf-f46b-45b6-8f85-26d9d1fcf05e"],
 ". The triplet matrix ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b6bdead3-bc78-4432-9af5-0ee4c7894155"],
 " of Parts II and III, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["ch",
      FontSlant->"Plain"]], "\[CircleTimes]", "\[Epsilon]", 
    SuperscriptBox["\[Tau]", "3"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9c687807-194b-4c3f-943e-e8a5fc50f58f"],
 " on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "51c41653-5692-4b61-ab9e-b3a92953e9c2"],
 ", couples the up and the down components through the blocks ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     SubscriptBox[
      StyleBox["C", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"]]}], 
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["ch",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1880ca35-aca3-4e1f-939f-c9c220fb90a2"],
 ", so that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[CapitalPsi]", 
     StyleBox["T", "TI"]], 
    SuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "3"], "\[CapitalPsi]", "\[LongEqual]", 
    RowBox[{"-", "2"}], 
    SubsuperscriptBox["\[CapitalPsi]", 
     StyleBox["u",
      FontSlant->"Plain"], 
     StyleBox["T", "TI"]], 
    SubscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["ch",
      FontSlant->"Plain"]], 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["d",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6792c89b-f450-493b-ae9f-0a33fa768785"],
 ". The pair matrices of the revision, ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SH",
     FontSlant->"Plain"], 
    StyleBox["d",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "26b1ba77-99ee-420f-9847-fa92fa1d0936"],
 " (the down components with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Chi]", 
    StyleBox["SH",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6bc11c32-e923-4254-b6b5-c409f7042694"],
 ") and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SH",
     FontSlant->"Plain"], 
    RowBox[{"\[Prime]", 
     StyleBox["u",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ffec2609-cb03-4822-8e59-752d9d4350ac"],
 " (the up components with ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Chi]", 
    StyleBox["SH",
     FontSlant->"Plain"], "\[Prime]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7b4d92e1-8176-4798-b108-01f29a82ed1a"],
 "), have the blocks ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["ch",
      FontSlant->"Plain"]], "/", "2"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1d4dbff6-e159-4749-af2c-bd61c2c59f9b"],
 ": the same Lorentz channel between two Dirac fields of equal mass, with \
half the coefficient. A pairing term ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{
       StyleBox["G", "TI"], "/", "4"}], ")"}]}], 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      RowBox[{
       SuperscriptBox["\[CapitalPsi]", 
        StyleBox["T", "TI"]], 
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], "\[CapitalPsi]"}], "\[RightBracketingBar]"}], 
     "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2dd5de15-a8da-4c63-aca6-776144c986d3"],
 " therefore needs four times the coupling of the triplet channel to reach \
the same strength: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["crit",
      FontSlant->"Plain"]], "\[LongEqual]", "4", 
    SubsuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["crit",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e83ad0b0-3944-4342-98b7-a4a4eba30c6b"],
 ", with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["crit",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox["\[Pi]", "2"], "/", 
    SubsuperscriptBox[
     StyleBox["I", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{"(", "1", ")"}]], 
    RowBox[{"(", 
     SubscriptBox[
      StyleBox["m", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7a6a4dcc-4df8-4927-8b69-16078346b9cf"],
 ". ",
 StyleBox["WSF-2b.",
  FontWeight->"Bold"],
 " The integral has the closed form"
}], "Text",ExpressionUUID->"a1f20d4b-9b64-408d-8980-797ad6056ba6"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["I", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "1", ")"}]], 
   RowBox[{"(", 
    StyleBox["m", "TI"], ")"}], "\[LongEqual]", 
   SubsuperscriptBox["\[Integral]", "0", "1"], "\[ThinSpace]", 
   FractionBox[
    RowBox[{
     SuperscriptBox[
      StyleBox["q", "TI"], "2"], "\[ThinSpace]", 
     StyleBox["dq", "TI"]}], 
    SqrtBox[
     RowBox[{
      SuperscriptBox[
       StyleBox["q", "TI"], "2"], "+", 
      SuperscriptBox[
       StyleBox["m", "TI"], "2"]}]]], "\[LongEqual]", 
   FractionBox["1", "2"], 
   RowBox[{"(", 
    RowBox[{
     SqrtBox[
      RowBox[{"1", "+", 
       SuperscriptBox[
        StyleBox["m", "TI"], "2"]}]], "-", 
     SuperscriptBox[
      StyleBox["m", "TI"], "2"], "\[ThinSpace]", 
     StyleBox["arsinh",
      FontSlant->"Plain"], 
     FractionBox["1", 
      StyleBox["m", "TI"]]}], ")"}], ","}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"ff2e59ad-e926-4f10-b52b-fe6a1358fc58"],

Cell[TextData[{
 "checked against the exact integral at ten masses with 40 digits, which \
gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["crit",
      FontSlant->"Plain"]], "\[LongEqual]", "4", 
    SuperscriptBox["\[Pi]", "2"], "/", 
    SubsuperscriptBox[
     StyleBox["I", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{"(", "1", ")"}]], 
    RowBox[{"(", 
     FractionBox["1", "5"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e5fa0034-1c3a-424c-bd65-91e3023bb5ed"],
 " and the ratio ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]], "/", 
    SubsuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["crit",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f828e62f-849a-4963-92c8-9dfc3271a9bc"],
 " (with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]], "\[LongEqual]", "504", "/", "5"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7eb7a376-ef4a-483f-80ec-56291b459df0"],
 " exactly), to be compared with the eigenvalue ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Lambda]", 
    StyleBox["SH",
     FontSlant->"Plain"], 
    StyleBox["H",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d2838f42-09cd-4775-afc3-579497edc840"],
 " of the Rust program in both versions."
}], "Text",ExpressionUUID->"93d50a4d-5240-4f3c-9e23-580f6e9cb14e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"WSF", "-", 
    RowBox[{"2", 
     RowBox[{"a", ":", " ", 
      RowBox[{
      "the", " ", "blocks", " ", "of", " ", "the", " ", "pair", " ", 
       "matrices"}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"blockOf", "[", 
      RowBox[{"m_", ",", " ", "r_", ",", " ", "c_"}], "]"}], " ", ":=", " ", 
     RowBox[{"m", "[", 
      RowBox[{"[", 
       RowBox[{"r", ",", " ", "c"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ok2a", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"blockOf", "[", 
        RowBox[{"k3", ",", " ", "upIdx", ",", " ", "dnIdx"}], "]"}], " ", "==",
        " ", 
       RowBox[{"-", "aa"}]}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"blockOf", "[", 
        RowBox[{"k3", ",", " ", "dnIdx", ",", " ", "upIdx"}], "]"}], " ", "==",
        " ", 
       RowBox[{"-", "aa"}]}], " ", "&&", "\n", "  ", 
      RowBox[{
       RowBox[{"blockOf", "[", 
        RowBox[{"k3", ",", " ", "upIdx", ",", " ", "upIdx"}], "]"}], " ", "==",
        " ", "z44"}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"blockOf", "[", 
        RowBox[{"k3", ",", " ", "dnIdx", ",", " ", "dnIdx"}], "]"}], " ", "==",
        " ", "z44"}], " ", "&&", "\n", "  ", 
      RowBox[{
       RowBox[{"blockOf", "[", 
        RowBox[{
         RowBox[{"kP", "[", 
          RowBox[{"0", ",", " ", "1"}], "]"}], ",", " ", "dnIdx", ",", " ", 
         "chiIdx"}], "]"}], " ", "==", " ", 
       RowBox[{"aa", "/", "2"}]}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"blockOf", "[", 
        RowBox[{
         RowBox[{"kP", "[", 
          RowBox[{"0", ",", " ", "1"}], "]"}], ",", " ", "chiIdx", ",", " ", 
         "dnIdx"}], "]"}], " ", "==", " ", 
       RowBox[{"aa", "/", "2"}]}], " ", "&&", "\n", "  ", 
      RowBox[{
       RowBox[{"blockOf", "[", 
        RowBox[{
         RowBox[{"kP", "[", 
          RowBox[{"0", ",", " ", "1"}], "]"}], ",", " ", "upIdx", ",", " ", 
         "chiIdx"}], "]"}], " ", "==", " ", "z44"}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"blockOf", "[", 
        RowBox[{
         RowBox[{"kP", "[", 
          RowBox[{"0", ",", " ", "1"}], "]"}], ",", " ", "dnIdx", ",", " ", 
         "chi2Idx"}], "]"}], " ", "==", " ", "z44"}], " ", "&&", "\n", "  ", 
      RowBox[{
       RowBox[{"blockOf", "[", 
        RowBox[{
         RowBox[{"kP", "[", 
          RowBox[{"1", ",", " ", "0"}], "]"}], ",", " ", "upIdx", ",", " ", 
         "chi2Idx"}], "]"}], " ", "==", " ", 
       RowBox[{"aa", "/", "2"}]}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"blockOf", "[", 
        RowBox[{
         RowBox[{"kP", "[", 
          RowBox[{"1", ",", " ", "0"}], "]"}], ",", " ", "chi2Idx", ",", " ", 
         "upIdx"}], "]"}], " ", "==", " ", 
       RowBox[{"aa", "/", "2"}]}], " ", "&&", "\n", "  ", 
      RowBox[{
       RowBox[{"blockOf", "[", 
        RowBox[{
         RowBox[{"kP", "[", 
          RowBox[{"1", ",", " ", "0"}], "]"}], ",", " ", "dnIdx", ",", " ", 
         "chi2Idx"}], "]"}], " ", "==", " ", "z44"}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"blockOf", "[", 
        RowBox[{
         RowBox[{"kP", "[", 
          RowBox[{"1", ",", " ", "0"}], "]"}], ",", " ", "upIdx", ",", " ", 
         "chiIdx"}], "]"}], " ", "==", " ", "z44"}], " ", "&&", "\n", "  ", 
      RowBox[{
       RowBox[{"Transpose", "[", "aa", "]"}], " ", "==", " ", 
       RowBox[{"-", "aa"}]}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"kP", "[", 
         RowBox[{"0", ",", " ", "1"}], "]"}], "]"}], " ", "==", " ", 
       RowBox[{"-", 
        RowBox[{"kP", "[", 
         RowBox[{"0", ",", " ", "1"}], "]"}]}]}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"kP", "[", 
         RowBox[{"1", ",", " ", "0"}], "]"}], "]"}], " ", "==", " ", 
       RowBox[{"-", 
        RowBox[{"kP", "[", 
         RowBox[{"1", ",", " ", "0"}], "]"}]}]}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"Transpose", "[", "k3", "]"}], " ", "==", " ", 
       RowBox[{"-", "k3"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rvCheck", "[", 
     RowBox[{"\"\<WSF-2a\>\"", ",", 
      " ", "\"\<the triplet matrix K^3 couples the up and down components of \
Psi_LL by -C gamma^ch in both blocks \\\n(Psi^T K^3 Psi = -2 Psi_u^T C \
gamma^ch Psi_d); K_d couples the down components and chi_SH, K'_u the up \
components and \\\nchi'_SH, by C gamma^ch / 2 in both blocks: the same \
channel with half the coefficient, so the pairing term \\\n-(G/4) |Psi^T K \
Psi|^2 has the critical coupling G^crit_SH = 4 G^crit_LL\>\"", ",", " ", 
      "ok2a", ",", " ", "\"\<identities of exact matrices\>\""}], "]"}], 
    ";"}]}]}]], "Input",
 CellLabel->
  "In[577]:=",ExpressionUUID->"044b7bfa-90ec-4866-8a18-358745293fc9"],

