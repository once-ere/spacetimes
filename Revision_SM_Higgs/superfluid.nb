Cell[CellGroupData[{

Cell["\<\
R.3.3 The closed forms of the pairing-only method HS (0, 0) (check WH-3)\
\>", "Subsection",ExpressionUUID->"0c6ac16e-a695-4253-8e59-1965d539dbdd"],

Cell[TextData[{
 "In HS (0, 0) the states with a fixed pair self-energy ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["d", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "534f5d7f-b20b-47be-b5da-cbd4011185fc"],
 " along the vacuum direction have the quasi-particle energies ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       StyleBox["q", "TI"], "2"], "+", 
      SuperscriptBox[
       StyleBox["M", "TI"], "2"]}], ")"}], 
    RowBox[{"1", "/", "2"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "be4be6de-94a9-4710-be9a-a1c95e421ca8"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["M", "TI"], "2"], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "2"], "+", 
    SubsuperscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], "2"], "/", "4"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3b9e61a3-cd78-43fd-b38d-17acbd587213"],
 ", and the effective potential has closed forms. The gap equation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["G", "TI"], 
       StyleBox["SH",
        FontSlant->"Plain"]], "/", "4", 
      SuperscriptBox["\[Pi]", "2"]}], ")"}], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["I", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{"(", "1", ")"}]], 
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["M", "TI"], 
      StyleBox["SH",
       FontSlant->"Plain"], 
      StyleBox["eff",
       FontSlant->"Plain"]], ")"}], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "67a227f1-df13-42db-9d1c-723323a9044b"],
 " gives ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["d", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"], "0"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "039ad278-0c14-4a72-84a3-42441fabb081"],
 "; the pair amplitude of the ground state is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CurlyPhi]", 
     StyleBox["SH",
      FontSlant->"Plain"], "0"], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], "0"], 
    SubsuperscriptBox[
     StyleBox["I", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{"(", "1", ")"}]], 
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["M", "TI"], 
      StyleBox["SH",
       FontSlant->"Plain"], 
      StyleBox["eff",
       FontSlant->"Plain"]], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"4", 
      SuperscriptBox["\[Pi]", "2"]}], ")"}], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], "0"], "/", 
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b2493d7f-5cdb-4be1-a6f2-dd2b8b34a93a"],
 ". With ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], 
    SubsuperscriptBox[
     StyleBox["I", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{"(", "1", ")"}]], "/", 
    StyleBox["dM", "TI"], "\[LongEqual]", 
    RowBox[{"-", 
     StyleBox["M", "TI"]}], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["J", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     RowBox[{"(", "3", ")"}]], 
    RowBox[{"(", 
     StyleBox["M", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "05a53f4f-c69b-44e6-991f-fb958b21e1d5"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["J", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     RowBox[{"(", "3", ")"}]], 
    RowBox[{"(", 
     StyleBox["M", "TI"], ")"}], "\[LongEqual]", 
    SubsuperscriptBox["\[Integral]", "0", "1"], "\[ThinSpace]", 
    SuperscriptBox[
     StyleBox["q", "TI"], "2"], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        StyleBox["q", "TI"], "2"], "+", 
       SuperscriptBox[
        StyleBox["M", "TI"], "2"]}], ")"}], 
     RowBox[{
      RowBox[{"-", "3"}], "/", "2"}]], 
    StyleBox["dq", "TI"], "\[LongEqual]", 
    StyleBox["arsinh",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{"1", "/", 
      StyleBox["M", "TI"]}], ")"}], "-", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "+", 
       SuperscriptBox[
        StyleBox["M", "TI"], "2"]}], ")"}], 
     RowBox[{
      RowBox[{"-", "1"}], "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "af866a71-bc07-4c1d-921e-6df2d57d7b80"],
 ", the curvature of the potential of one pair at its minimum is"
}], "Text",ExpressionUUID->"7b865414-6b2e-48f5-94d6-9ce134deb6ed"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["eff",
      FontSlant->"Plain"], "\[ThinSpace]", "\[Prime]", "\[Prime]"}]], 
   RowBox[{"(", 
    SubsuperscriptBox["\[CurlyPhi]", 
     StyleBox["SH",
      FontSlant->"Plain"], "0"], ")"}], "\[LongEqual]", 
   FractionBox[
    RowBox[{"2", 
     SuperscriptBox["\[Pi]", "2"], 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["d", "TI"], 
        StyleBox["SH",
         FontSlant->"Plain"], "0"], ")"}], "2"], 
     SubsuperscriptBox[
      StyleBox["J", "TI"], 
      StyleBox["SH",
       FontSlant->"Plain"], 
      RowBox[{"(", "3", ")"}]]}], 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["I", "TI"], 
