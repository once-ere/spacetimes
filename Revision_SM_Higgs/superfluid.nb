      RowBox[{"{", 
       RowBox[{
        RowBox[{"sigbar", "[", "p", "]"}], ",", " ", "z2"}], "}"}]}], "}"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"gch", " ", "=", " ", 
