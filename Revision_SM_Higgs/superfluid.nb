Cell[TextData[{
 StyleBox["The answer to question (a) for each method",
  FontWeight->"Bold"],
 ", judged by the properties that make a field the Higgs field of a gauge \
group and its amplitude mode a Higgs particle."
}], "Text",ExpressionUUID->"ea79011d-3061-41fe-872d-89ac5def9567"],

Cell[TextData[{
 StyleBox["The Higgs mechanism.",
  FontWeight->"Bold"],
 " In every method the condensate gives the masses ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     RowBox[{
      StyleBox["W", "TI"], ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["f", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["I",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6a8eb45a-7099-4a74-a7d6-ba0f5af83629"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     RowBox[{
      StyleBox["Z", "TI"], ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]], "\[LongEqual]", "2", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["f", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["F",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5491cc0f-0c31-4db7-9b0a-11a8fb8b2915"],
 " to the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["W", "TI"], "\[PlusMinus]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "541481bc-41b6-4989-8410-1eaa8677a6bf"],
 " and the ",
 Cell[BoxData[
  FormBox[
   StyleBox["Z", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f22a9920-46ef-4f0f-ac56-fa627a2ece00"],
 " of the superfluid, leaves exactly one gauge boson, the zeugon ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["W", "TI"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8cbd6f10-a5f0-461f-a5d8-930bcfb294aa"],
 " (not the photon), massless, and turns the three Goldstone fields into the \
longitudinal parts of the massive bosons: the superfluid does for the new \
group what a Higgs field does."
}], "ItemNumbered",ExpressionUUID->"161516e9-4e25-44b5-9db0-895bd25aaaa7"],

Cell[TextData[{
 StyleBox["A scalar of charge 0 below the threshold.",
  FontWeight->"Bold"],
 " In every method the amplitude mode (charge ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["Q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bb4871d4-b9ae-491a-b01a-0032128d1ff4"],
 ") lies below the threshold of two quasi-particles, at 0.82 to 0.90 of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    SubsuperscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["gap",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1fe9773e-117d-4628-858b-c9cab12f4536"],
 ": a bound state of the mean-field dynamics."
}], "ItemNumbered",ExpressionUUID->"e8eb4a74-539e-4059-a667-a136e4548943"],

Cell[TextData[{
 StyleBox["Its mass against the scale of the breaking.",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["H",
       FontSlant->"Plain"]}]], "/", 
    SubsuperscriptBox[
     StyleBox["v", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4ce2c4a2-56ed-42ae-8f6c-acd0c156ff76"],
 " is 4.46 to 5.69 and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Lambda]", 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["H",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fd0858b7-a7b0-4d23-8bcd-2a5dedb10649"],
 " is 9.9 to 16.2: the amplitude mode is heavier than the scale of the \
breaking. Whether a quartic coupling of this size is compatible with the \
perturbative unitarity of the scattering of the longitudinal gauge bosons of \
this group is not decided here: the bound depends on the scalar fields and \
the channels of the theory, and it was not computed for this one."
}], "ItemNumbered",ExpressionUUID->"6024dd55-8004-45db-9d27-019ad4a32bab"],

Cell[TextData[{
 StyleBox["Its width.",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalGamma]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["H",
       FontSlant->"Plain"]}]], "/", 
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["H",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "752cde92-dda1-4107-8e5b-b9fe2760209e"],
 " is 2.1 to 3.9: once the decays into Goldstone fields are allowed, the \
width exceeds the mass, and the amplitude mode is a broad resonance, not a \
particle."
}], "ItemNumbered",ExpressionUUID->"535dca68-8497-4f82-a5ad-5723c1733f20"],

Cell[TextData[{
 StyleBox["Further scalars.",
  FontWeight->"Bold"],
 " Every method has the non-unitary doublet, two scalars of the charges ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["Q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"\[PlusMinus]", "1"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "68d6dbfa-7e8c-4283-ab62-811ebbb3dab0"],
 " at 0.99 to 1.09 times ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["M", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["H",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ed0f7765-9b10-492a-8c84-2f7b60a0b7f1"],
 "."
}], "ItemNumbered",ExpressionUUID->"d184d5cf-8ebb-4446-bcf9-20989ec405ee"],

Cell[TextData[{
 StyleBox["The quantum numbers.",
  FontWeight->"Bold"],
 " The condensate is an isospin vector of fermion number 2 of the vector-like \
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["v",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5209672b-feb3-40bc-bec4-65c72dc03eed"],
 ", a group of the DiracLike spinor that is not part of the electroweak \
theory. The zeugon is ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["W", "TI"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "40a46c38-9761-491b-98f9-999e96bdf1b3"],
 " (no mixing angle), the ",
 Cell[BoxData[
  FormBox[
   StyleBox["Z", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "98153da1-9592-4411-9577-b420ea484f95"],
 " is the gauge boson of the fermion number, and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     RowBox[{
      StyleBox["W", "TI"], ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]], "/", 
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     RowBox[{
      StyleBox["Z", "TI"], ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ed4dfa44-90a6-4f7f-aa27-f03117570b2c"],
 " depends on two independent couplings. The mass of the DiracLike spinor \
does not come from the condensate as a Yukawa mass: the condensate adds a \
pairing gap to a Dirac mass that the vector-like theory allows without it."
}], "ItemNumbered",ExpressionUUID->"faede1f8-886c-4865-a803-913508f5e2dc"],

Cell[TextData[{
 StyleBox["The thermal history.",
  FontWeight->"Bold"],
 " The transition of the superfluid lies deep in its own critical region \
(Section III.G.7); its mean-field temperature, 1.6 to 1.8 times ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["v", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "358c6a07-5d55-4c0e-beaa-d0405a675e5e"],
 ", is not reliable."
}], "ItemNumbered",ExpressionUUID->"1b7a3e24-a867-4c81-a445-aa1cbdade516"],

Cell[TextData[{
 StyleBox["The verdict.",
  FontWeight->"Bold"],
 " (a) In every method the superfluid is the Higgs field of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["v",
      FontSlant->"Plain"]], "\[Times]", 
    StyleBox["U", "TI"], 
    SubsuperscriptBox[
     RowBox[{"(", "1", ")"}], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f33f6338-69f7-4c37-a4e4-0939e5afbff6"],
 ": it breaks the group to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["U", "TI"], 
    SubsuperscriptBox[
     RowBox[{"(", "1", ")"}], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["Q",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e31069b3-9b90-457d-8678-d1beaf754da0"],
 ", gives masses to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["W", "TI"], "\[PlusMinus]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fe06102e-e6b7-41be-89b3-11aefba54806"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["Z", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f7144fd2-11e0-4d6e-a9f4-e6f696b91710"],
 ", leaves the massless zeugon, and has a Higgs-like scalar of charge 0 below \
the threshold of two quasi-particles. That scalar is a Higgs particle only in \
the mean-field dynamics: once it can decay into the longitudinal gauge bosons \
it is a resonance broader than its mass, accompanied by the two non-unitary \
scalars of the charges ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6d5b5b96-e9f8-4740-a284-bfaff1d40e60"],
 " of about the same mass. The methods differ in degree, not in kind: CJT and \
KS have the lightest and narrowest amplitude mode, HS ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"1", ",", "1"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fdf8a3bf-7a52-4712-a69e-50bcf0e39cae"],
 " the heaviest and broadest. (b) In no method is the superfluid the Higgs \
field of the Standard Model, for the reason of structure stated at the \
beginning of this section. ",
 StyleBox["Is the Higgs a composite particle?",
  FontWeight->"Bold"],
 " In this model, yes, in every method, for the Higgs particle of the new \
group: the field ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[CapitalPhi]", "\[RightVector]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "51d2d32e-87ac-497f-9004-cbf7086bf4cc"],
 " is not a field of the Lagrangian, whose only matter field is the DiracLike \
spinor. It is the amplitude of the pair self-energy, a composite of two \
spinor charges; its kinetic part has no term of its own and is generated \
entirely by the spinor field (",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["Z", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e52f4dd7-539d-47e9-b6a9-4bf699fde5f3"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["Y", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cc171f83-f1bb-4db1-906b-078b85e490da"],
 " are susceptibilities of the spinor field); and its amplitude mode is a \
bound state of two quasi-particles below their threshold. This is the \
compositeness condition of W. A. Bardeen, C. T. Hill and M. Lindner (1990): \
the normalization of the composite field vanishes at the cutoff, where only \
the spinor field exists. The same structure explains why the composite is \
heavy against the scale of the breaking: in the dynamics of Y. Nambu and G. \
Jona-Lasinio (1961) the mass of the bound state is tied to the gap of the \
spinor charges, while the scale of the breaking comes from a loop of the \
spinor field and is small against the gap. A light composite needs a large \
ratio of the cutoff to the gap, or a different mechanism, for example a \
scalar that is itself a pseudo-Goldstone boson of a larger broken symmetry \
(D. B. Kaplan and H. Georgi 1984). Whether the Higgs boson of nature is \
composite is not decided here, because the Higgs particle of this model is \
not that boson (answer (b)); the measured couplings of the Higgs boson of \
nature agree with those of an elementary Higgs field at the level of several \
per cent, which constrains, but does not exclude, its compositeness at a \
higher scale."
}], "Text",ExpressionUUID->"ac476683-8060-4651-8197-487b2f447208"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["The list of all checks", "Chapter",ExpressionUUID->"7b62a78b-13ef-41b7-848c-fd7134c8ce6d"],

Cell["\<\
The last cell lists every check of this notebook with its result and its \
counterparts in the Rust and the Python programs, and counts the checks that \
passed.\
\>", "Text",ExpressionUUID->"8b0a9d0c-ceda-4bd7-a1f7-d7609e491398"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", "table", " ", "of", " ", "all", " ", 
     RowBox[{"checks", ":", " ", "identifier"}]}], ",", " ", "result", ",", 
    " ", "deviation", ",", " ", "tolerance", ",", " ", "counterparts"}], " ", 
   "*)"}], "\n", 
  RowBox[{"Grid", "[", 
   RowBox[{
    RowBox[{"Prepend", "[", 
     RowBox[{
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"#", "[", "\"\<id\>\"", "]"}], ",", " ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"#", "[", "\"\<pass\>\"", "]"}], ",", " ", "\"\<PASS\>\"",
              ",", " ", "\"\<FAIL\>\""}], "]"}], ",", " ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"NumericQ", "[", 
              RowBox[{"#", "[", "\"\<deviation\>\"", "]"}], "]"}], ",", " ", 
             RowBox[{"sci", "[", 
              RowBox[{"#", "[", "\"\<deviation\>\"", "]"}], "]"}], ",", 
             " ", "\"\<--\>\""}], "]"}], ",", "\n", "      ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"NumericQ", "[", 
              RowBox[{"#", "[", "\"\<tolerance\>\"", "]"}], "]"}], ",", " ", 
             RowBox[{"sci", "[", 
              RowBox[{"#", "[", "\"\<tolerance\>\"", "]"}], "]"}], ",", 
             " ", "\"\<--\>\""}], "]"}], ",", " ", 
           RowBox[{"#", "[", "\"\<rust\>\"", "]"}], ",", " ", 
           RowBox[{"#", "[", "\"\<python\>\"", "]"}]}], "}"}], " ", "&"}], ",",
         " ", "SFNB`Test`$Results"}], "]"}], ",", "\n", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"#", ",", " ", "Bold"}], "]"}], " ", "&"}], " ", "/@", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<check\>\"", ",", " ", "\"\<result\>\"", ",", 
         " ", "\"\<deviation\>\"", ",", " ", "\"\<tolerance\>\"", ",", 
         " ", "\"\<Rust\>\"", ",", " ", "\"\<Python\>\""}], "}"}]}]}], "]"}], 
    ",", "\n", "  ", 
    RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
    RowBox[{"Alignment", " ", "->", " ", "Left"}], ",", " ", 
    RowBox[{"BaseStyle", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"FontSize", " ", "->", " ", "9"}], "}"}]}]}], "]"}]}]], "Input",\

 CellLabel->
  "In[407]:=",ExpressionUUID->"06312be4-1be4-4b2e-abc8-5f612eed6948"],

