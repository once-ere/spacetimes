Cell[CellGroupData[{

Cell["R.1.2 The algebra of the global group (check WQN-1)", "Subsection",ExpressionUUID->"79098cf2-20f8-452d-ad09-9078169ebea2"],

Cell[TextData[{
 "The generators must close into the algebra of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["L", "TI"]], "\[Times]", 
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["R",
      FontSlant->"Plain"]], "\[Times]", 
    StyleBox["U", "TI"], 
    SubscriptBox[
     RowBox[{"(", "1", ")"}], 
     StyleBox["R",
      FontSlant->"Plain"]], "\[Times]", 
    StyleBox["U", "TI"], 
    SubscriptBox[
     RowBox[{"(", "1", ")"}], 
     StyleBox["F",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1b82b216-df1b-499c-9c15-7f7078d86fa4"],
 ": ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"[", 
     RowBox[{
      SuperscriptBox[
       StyleBox["T", "TI"], 
       RowBox[{
        StyleBox["a", "TI"], ",", 
        StyleBox["SM",
         FontSlant->"Plain"]}]], ",", 
      SuperscriptBox[
       StyleBox["T", "TI"], 
       RowBox[{
        StyleBox["b", "TI"], ",", 
        StyleBox["SM",
         FontSlant->"Plain"]}]]}], "]"}], "\[LongEqual]", 
    StyleBox["i", "TI"], 
    SubscriptBox["\[Epsilon]", 
     StyleBox["abc", "TI"]], 
    SuperscriptBox[
     StyleBox["T", "TI"], 
     RowBox[{
      StyleBox["c", "TI"], ",", 
      StyleBox["SM",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "10f45fa3-b8ea-4902-807a-194f833c097c"],
 ", the same for ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["a", "TI"], ",", 
     StyleBox["R",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7871488e-6008-45a1-bc48-e9fa264aaff5"],
 ", the two sets commuting with each other, and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["Y", "TI"], 
    StyleBox["SM",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b6ccfe7b-1ed5-4430-a219-adbfa2f5aff0"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["F", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"], 
    StyleBox["tot",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bfb2da9f-bd4e-47ba-8e6b-a76f77dcc1bf"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fbc0f01b-5e7c-435a-95df-6931eb40495e"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"], 
    RowBox[{"3", ",", 
     StyleBox["R",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b0415426-0ad4-4810-b5f5-6d6cf5a44160"],
 " commuting with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["L", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4e3c6ab0-38d8-45a0-8ff2-d80aa3d44261"],
 " and with each other. They must be Hermitian (a unitary representation), \
and the hypercharge must be the combination ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["Y", "TI"], 
     StyleBox["SM",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     RowBox[{"3", ",", 
      StyleBox["R",
       FontSlant->"Plain"]}]], "+", 
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]], "/", "4"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c46abadf-3401-44ca-be64-d400b1418dea"],
 ", so that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["Q", "TI"], 
     StyleBox["SM",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["T", "TI"], 
     RowBox[{"3", ",", 
      StyleBox["SM",
       FontSlant->"Plain"]}]], "+", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     RowBox[{"3", ",", 
      StyleBox["R",
       FontSlant->"Plain"]}]], "+", 
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]], "/", "4"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c83452c4-446a-4846-a402-9033fd84fa7f"],
 ". ",
 StyleBox["What it means.",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["Y", "TI"], 
    StyleBox["SM",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "691ff266-713f-49e6-a4ec-ec4e4e235858"],
 " does not commute with ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"], 
    RowBox[{"1", ",", 
     StyleBox["R",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c3755aad-8233-408e-a483-7c7ba77bbb9a"],
 ": the gauge field ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["B", "TI"], "\[Mu]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "905353b5-da25-47ad-8e00-880c49733a8f"],
 ", which couples to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["Y", "TI"], 
    StyleBox["SM",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e5f9ce9c-a462-4dba-8af1-44b7a4f76802"],
 ", breaks the custodial group ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["R",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "868e1b5e-51a5-42d0-a126-7df4298e1e70"],
 " explicitly. The custodial symmetry of the superfluid is therefore exact \
only for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["g", "TI"], "\[Prime]"], "\[LongEqual]", "0"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "37988abd-5e89-4f2d-8a0a-a9eb6410f52c"],
 ", as in the Standard Model."
}], "Text",ExpressionUUID->"7b23e453-b45a-461e-b1e7-210bd5bc8a3c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"WQN", "-", "1"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"ok1", " ", "=", " ", 
     RowBox[{
      RowBox[{"And", " ", "@@", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"comm", "[", 
            RowBox[{
             RowBox[{"T", "[", "a", "]"}], ",", " ", 
             RowBox[{"T", "[", "b", "]"}]}], "]"}], " ", "==", " ", 
           RowBox[{"I", " ", 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"lev", "[", 
                RowBox[{"a", ",", " ", "b", ",", " ", "c"}], "]"}], " ", 
               RowBox[{"T", "[", "c", "]"}]}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"c", ",", " ", "3"}], "}"}]}], "]"}]}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"a", ",", " ", "3"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"b", ",", " ", "3"}], "}"}]}], "]"}], "]"}]}], " ", "&&", 
      "\n", "  ", 
      RowBox[{"And", " ", "@@", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"comm", "[", 
            RowBox[{
             RowBox[{"TR", "[", "a", "]"}], ",", " ", 
             RowBox[{"TR", "[", "b", "]"}]}], "]"}], " ", "==", " ", 
           RowBox[{"I", " ", 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"lev", "[", 
                RowBox[{"a", ",", " ", "b", ",", " ", "c"}], "]"}], " ", 
               RowBox[{"TR", "[", "c", "]"}]}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"c", ",", " ", "3"}], "}"}]}], "]"}]}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"a", ",", " ", "3"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"b", ",", " ", "3"}], "}"}]}], "]"}], "]"}]}], " ", "&&", 
      "\n", "  ", 
      RowBox[{"And", " ", "@@", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"comm", "[", 
            RowBox[{
             RowBox[{"T", "[", "a", "]"}], ",", " ", 
             RowBox[{"TR", "[", "b", "]"}]}], "]"}], " ", "==", " ", "z16"}], 
          ",", " ", 
          RowBox[{"{", 
           RowBox[{"a", ",", " ", "3"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"b", ",", " ", "3"}], "}"}]}], "]"}], "]"}]}], " ", "&&", 
      "\n", "  ", 
      RowBox[{"And", " ", "@@", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"comm", "[", 
            RowBox[{"x", ",", " ", "z"}], "]"}], " ", "==", " ", "z16"}], ",",
           " ", 
          RowBox[{"{", 
           RowBox[{"x", ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"T", "[", "1", "]"}], ",", " ", 
              RowBox[{"T", "[", "2", "]"}], ",", " ", 
              RowBox[{"T", "[", "3", "]"}], ",", " ", "YY", ",", " ", "FF", ",",
               " ", "RR", ",", " ", 
              RowBox[{"TR", "[", "3", "]"}]}], "}"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"z", ",", " ", 
            RowBox[{"{", 
             RowBox[{"YY", ",", " ", "FF", ",", " ", "RR", ",", " ", 
              RowBox[{"TR", "[", "3", "]"}]}], "}"}]}], "}"}]}], "]"}], 
        "]"}]}], " ", "&&", "\n", "  ", 
      RowBox[{"And", " ", "@@", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"comm", "[", 
            RowBox[{
             RowBox[{"TR", "[", "a", "]"}], ",", " ", "x"}], "]"}], " ", "==",
            " ", "z16"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"a", ",", " ", "3"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"x", ",", " ", 
            RowBox[{"{", 
             RowBox[{"FF", ",", " ", "RR"}], "}"}]}], "}"}]}], "]"}], "]"}]}],
       " ", "&&", "\n", "  ", 
      RowBox[{"And", " ", "@@", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"#", " ", "==", " ", 
           RowBox[{"ConjugateTranspose", "[", "#", "]"}]}], " ", "&"}], " ", "/@",
          " ", "gensAll"}], ")"}]}], " ", "&&", "\n", "  ", 
      RowBox[{"YY", " ", "==", " ", 
       RowBox[{
        RowBox[{"TR", "[", "3", "]"}], " ", "+", " ", 
        RowBox[{"RR", "/", "4"}]}]}], " ", "&&", " ", 
      RowBox[{"QQ", " ", "==", " ", 
       RowBox[{
        RowBox[{"T", "[", "3", "]"}], " ", "+", " ", 
        RowBox[{"TR", "[", "3", "]"}], " ", "+", " ", 
        RowBox[{"RR", "/", "4"}]}]}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"comm", "[", 
        RowBox[{"YY", ",", " ", 
         RowBox[{"TR", "[", "1", "]"}]}], "]"}], " ", "=!=", " ", "z16"}]}]}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"rvCheck", "[", 
     RowBox[{"\"\<WQN-1\>\"", ",", 
      " ", "\"\<the algebra of SU(2)_L x SU(2)_R x U(1)_R x U(1)_F_tot, \
Hermitian generators, Y = T^3_R + R/4 \\\n(4.3), Q = T^3 + T^3_R + R/4, and \
[Y, T^1_R] != 0\>\"", ",", " ", "ok1", ",", 
      " ", "\"\<identities of exact matrices\>\""}], "]"}], 
    ";"}]}]}]], "Input",
 CellLabel->
  "In[441]:=",ExpressionUUID->"77ef50b1-8b04-4986-b278-faf4137e0dcb"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"PASS \"\>", "\[InvisibleSpace]", "\<\"WQN-1\"\>", 
