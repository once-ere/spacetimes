        RowBox[{"144", " ", "directions"}], ",", " ", 
        RowBox[{"24", " ", "radial", " ", "nodes"}]}], ")"}]}]}], ",", " ", 
    RowBox[{"against", " ", "the", " ", "six", " ", "directions"}]}], " ", 
   "*)"}], "\n", 
  RowBox[{
   RowBox[{"Module", "[", 
