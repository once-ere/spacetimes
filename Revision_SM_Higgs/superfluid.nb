            RowBox[{"ConjugateTranspose", "[", "bt", "]"}], ".", "bt"}], 
           "]"}], ".", 
          RowBox[{"ConjugateTranspose", "[", "bt", "]"}], ".", "op", ".", 
          "bt"}]}], ";", "\n", "  ", 
        RowBox[{"{", 
         RowBox[{"c", ",", " ", 
          RowBox[{"Simplify", "[", 
           RowBox[{
            RowBox[{"op", ".", "bt"}], " ", "-", " ", 
            RowBox[{"bt", ".", "c"}]}], "]"}]}], "}"}]}]}], "]"}]}], 
    ";"}]}]}]], "Input",
