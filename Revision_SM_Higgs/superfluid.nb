         RowBox[{"d", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"R", "^", "2"}], " ", "-", " ", "R"}], ")"}], "/", 
           "dt"}]}]}]}], " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"dR", " ", "R"}], " ", "+", " ", 
         RowBox[{"R", " ", "dR"}], " ", "-", " ", 
         RowBox[{"dR", " ", "vanishes", " ", "at", " ", 
          RowBox[{"R", "^", "2"}]}]}], " ", "=", " ", "R"}]}]}], ";", " ", 
     RowBox[{
      RowBox[{"with", " ", "R"}], " ", "=", " ", 
      RowBox[{
      "P", " ", "a", " ", "projector", " ", "of", " ", "rank", " ", "1"}]}]}],
     " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"pv", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"p1", ",", " ", "p2", ",", " ", "p3"}], "}"}]}], ";", " ", 
    RowBox[{"proj", " ", "=", " ", 
     RowBox[{"Outer", "[", 
      RowBox[{"Times", ",", " ", "pv", ",", " ", 
       RowBox[{"Conjugate", "[", "pv", "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dP", " ", "=", " ", 
     RowBox[{
      RowBox[{"-", "I"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"hh", " ", ".", " ", "proj"}], " ", "-", " ", 
        RowBox[{"proj", " ", ".", " ", "hh"}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"projOK2", " ", "=", " ", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{"ComplexExpand", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"dP", " ", ".", " ", "proj"}], " ", "+", " ", 
           RowBox[{"proj", " ", ".", " ", "dP"}], " ", "-", " ", "dP"}], 
          ")"}], " ", "/.", " ", 
         RowBox[{"Thread", "[", 
          RowBox[{"pv", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "0", ",", " ", "0"}], "}"}]}], "]"}]}], 
        "]"}], "]"}], " ", "===", " ", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "3"}], "}"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"hermOK", " ", "=", " ", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{
        RowBox[{"ComplexExpand", "[", 
         RowBox[{
          RowBox[{"ConjugateTranspose", "[", "dR", "]"}], " ", "-", " ", 
