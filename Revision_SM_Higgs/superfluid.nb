Cell[CellGroupData[{

Cell["\<\
I.3 The spinor field and the DiracLike field (item 2); theorem D1\
\>", "Section",ExpressionUUID->"451176d4-a260-451d-99be-2fab5bd5c07f"],

Cell[TextData[{
 "A two-component spinor transforms under the unit bi-quaternion ",
 Cell[BoxData[
  FormBox[
   StyleBox["g",
    FontWeight->"Bold",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d2019c6d-1b57-4639-ab65-9243aaf12602"],
 " as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Chi]", "\[RightTeeArrow]", 
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[Chi]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3f00a963-f18d-41c2-a824-312c990e0585"],
 " (or, for the other kind, with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     OverscriptBox[
      StyleBox["g",
       FontWeight->"Bold",
       FontSlant->"Plain"], "~"], ")"}], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["M", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"]], 
       SuperscriptBox[
        RowBox[{"(", 
         StyleBox["g",
          FontWeight->"Bold",
          FontSlant->"Plain"], ")"}], "\[Dagger]"]}], ")"}], 
     RowBox[{"-", "1"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3000ce81-aa36-4d6e-bac7-856bd344a508"],
 "). The Dirac matrices of a frame ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    StyleBox["p", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5d128024-ba06-4587-9375-fe922bafe4f3"],
 " are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p", "TI"]], 
    RowBox[{"[", 
     StyleBox["f",
      FontWeight->"Bold",
      FontSlant->"Plain"], "]"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "337b1b91-e531-424e-9c24-e7164a8cc9d4"],
 " with the blocks ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubscriptBox[
      StyleBox["f",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      StyleBox["p", "TI"]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c078a396-47e3-451b-ad3f-41ae3c1adea3"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["f",
        FontWeight->"Bold",
        FontSlant->"Plain"], "_"], 
      StyleBox["p", "TI"]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fdb1cdb7-2244-40eb-a576-b23d6bfa6fe0"],
 " off the diagonal; the spinor matrix is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["S",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[LongEqual]", 
    StyleBox["diag",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      RowBox[{"(", 
       OverscriptBox[
        StyleBox["g",
         FontWeight->"Bold",
         FontSlant->"Plain"], "~"], ")"}], ",", 
      SubscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      RowBox[{"(", 
       StyleBox["g",
        FontWeight->"Bold",
        FontSlant->"Plain"], ")"}]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "214f63f0-43b2-4d71-9160-145fb35625be"],
 ", and"
}], "Text",ExpressionUUID->"8a40079f-9ff9-4c55-898e-5fe8cf8ada3c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["S",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   SuperscriptBox[
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    RowBox[{"-", "1"}]], 
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p", "TI"]], 
   SubscriptBox[
    StyleBox["S",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   RowBox[{"(", 
    StyleBox["g",
     FontWeight->"Bold",
     FontSlant->"Plain"], ")"}], "\[LongEqual]", 
   UnderscriptBox["\[Sum]", 
    SuperscriptBox[
     StyleBox["p", "TI"], "\[Prime]"],
    LimitsPositioning->True], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["L",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["p", "TI"], 
     SuperscriptBox[
      StyleBox["p", "TI"], "\[Prime]"]}]], 
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    SuperscriptBox[
     StyleBox["p", "TI"], "\[Prime]"]], ",", "      ", 
   SubscriptBox[
    StyleBox["S",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   SuperscriptBox[
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[Dagger]"], 
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], "0"], 
   SubscriptBox[
    StyleBox["S",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   RowBox[{"(", 
    StyleBox["g",
     FontWeight->"Bold",
     FontSlant->"Plain"], ")"}], "\[LongEqual]", 
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], "0"], ",", "      ", 
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p", "TI"]], 
   RowBox[{"[", 
    SuperscriptBox[
     StyleBox["f",
      FontWeight->"Bold",
      FontSlant->"Plain"], "\[Prime]"], "]"}], "\[LongEqual]", 
   SubscriptBox[
    StyleBox["S",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   RowBox[{"(", 
    StyleBox["g",
     FontWeight->"Bold",
     FontSlant->"Plain"], ")"}], "\[ThinSpace]", 
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p", "TI"]], 
   RowBox[{"[", 
    StyleBox["f",
     FontWeight->"Bold",
     FontSlant->"Plain"], "]"}], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["S",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   SuperscriptBox[
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    RowBox[{"-", "1"}]]}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"36f077ec-9aa6-42ff-927b-c0eb4e95d5c4"],

Cell[TextData[{
 "for the transformed frame ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["f",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["p", "TI"], "\[Prime]"], "\[LongEqual]", 
    OverscriptBox[
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], "~"], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["f",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["p", "TI"]], "\[ThinSpace]", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["g",
       FontWeight->"Bold",
       FontSlant->"Plain"], "~"], "\[Dagger]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9a9055fe-5c3e-472e-916d-fb6e2c569e2b"],
 " (equations (3.8) and (3.9) of the manuscript). The spinor field ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1c6e6261-7c1c-4d32-b432-005cc9c6a962"],
 " is the DiracLike isodoublet: eight anticommuting components, made of two \
spinor charges of the super-loop; it transforms as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[RightTeeArrow]", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["S",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      RowBox[{"(", 
       StyleBox["g",
        FontWeight->"Bold",
        FontSlant->"Plain"], ")"}], "\[CircleTimes]", 
      SubscriptBox[
       StyleBox["1",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], "2"]}], ")"}], 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0a0c82b1-6926-4724-9f48-76c1cec6dcbb"],
 ", its isospin generators are ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "655082b0-072a-4615-8795-23bd1b0c3719"],
 ", its fermion number is 1, and its mass term ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubscriptBox[
     OverscriptBox["\[CapitalPsi]", "_"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ea5de806-1c46-41ae-901d-28b741a9e588"],
 " is invariant under all of GEE."
}], "Text",ExpressionUUID->"90c5f80b-df11-4b78-b1c8-cf26772fb533"],

Cell[TextData[{
 StyleBox["Theorem D1.",
  FontWeight->"Bold"],
 " A single DiracLike field with four components, on which ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["v",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d2901959-cf11-488d-b2a9-863376553aef"],
 " acts by a non-trivial linear representation that commutes with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SL", "TI"], 
    RowBox[{"(", 
     RowBox[{"2", ",", 
      StyleBox["\[DoubleStruckCapitalC]",
       FontSlant->"Plain"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3fe926ef-fb7c-47a9-a259-ed6e6f6eec11"],
 " and keeps the kinetic term, has no Lorentz-invariant bilinear without \
derivatives (no Dirac, pseudoscalar or Majorana mass) that is invariant under \
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["v",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e0883e2c-921c-4515-a897-d1d8eba6d9f2"],
 ". The reason: the two left-handed Weyl spinors ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Psi]", "-"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6762d653-f62f-4378-885a-9b7c934c3d8e"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["E",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SuperscriptBox["\[Psi]", "+"], ")"}], "*"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "64b24a24-abe0-4586-8379-0e918d4643e1"],
 " of the DiracLike field form an isospin doublet (the group of Pauli and G\
\[CapitalATilde]\.bcrsey), and the Lorentz-invariant bilinears ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Xi]", 
     StyleBox["f", "TI"], 
     StyleBox["T", "TI"]], 
    SubscriptBox[
     StyleBox["E",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubscriptBox["\[Xi]", 
     SuperscriptBox[
      StyleBox["f", "TI"], "\[Prime]"]]}], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cfdefd67-df4d-4202-ab4b-d6a34e4f62e0"],
 " are symmetric in the doublet indices, an isospin triplet, which contains \
no invariant. This is why the spinor field of the solution is an isodoublet \
of DiracLike fields. The next cell repeats the finite part of the proof as a \
computation: on the eight operators ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["\[Psi]", "1"], ",", "\[Ellipsis]", ",", 
     SubscriptBox["\[Psi]", "4"], ",", 
     SubsuperscriptBox["\[Psi]", "1", "\[Dagger]"], ",", "\[Ellipsis]", ",", 
     SubsuperscriptBox["\[Psi]", "4", "\[Dagger]"]}], ")"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f96165a9-f1c8-4805-b4e2-10839e9585ce"],
 " of one point, a bilinear ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["\[GothicN]",
      FontSlant->"Plain"], 
     StyleBox["T", "TI"]], 
    StyleBox["\[GothicCapitalQ]",
     FontSlant->"Plain"], 
    StyleBox["\[GothicN]",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "65412c5d-1f2d-4f2d-b869-355aa27b4a27"],
 " with an antisymmetric ",
 Cell[BoxData[
  FormBox[
   RowBox[{"8", "\[Times]", "8"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "316ec0b7-4dd0-4021-9e62-f90db9a4f1cc"],
 " matrix ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[GothicCapitalQ]",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "78a94804-e1ed-4928-836e-5a64f0e5c62d"],
 " is invariant under a group exactly when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["\[GothicCapitalX]",
      FontSlant->"Plain"], 
     StyleBox["T", "TI"]], 
    StyleBox["\[GothicCapitalQ]",
     FontSlant->"Plain"], "+", 
    StyleBox["\[GothicCapitalQ]",
     FontSlant->"Plain"], 
    StyleBox["\[GothicCapitalX]",
     FontSlant->"Plain"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "17fa26f9-64b1-4f6a-8bf9-b57c13f508d4"],
 " for every generator ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[GothicCapitalX]",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "544be80a-ba13-43b0-96bb-3c4b58f8737e"],
 "; the dimension of the space of such ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[GothicCapitalQ]",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c75ee3b9-6ca6-4649-92aa-b27e12c76b13"],
 " is ",
 Cell[BoxData[
  FormBox["28", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c9bb753f-2082-4ca3-8f5c-8ef2fc73dd90"],
 " minus the rank of these linear conditions. With exact arithmetic: \
dimension 6 for the Lorentz group, 0 for the Lorentz group together with the \
Pauli-G\[CapitalATilde]\.bcrsey ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    RowBox[{"(", "2", ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1e10e015-67d9-4fc2-a5c2-dfdf693f8271"],
 "."
}], "Text",ExpressionUUID->"17400c44-5cbc-406b-8ad6-5d8db10e145f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"F", "-", "2"}], ":", " ", 
      RowBox[{"the", " ", "Clifford", " ", "algebra", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"gamma", "^", "p"}], ",", " ", 
         RowBox[{"gamma", "^", "q"}]}], "}"}]}]}], " ", "=", " ", 
     RowBox[{"2", " ", 
      RowBox[{"eta", "^", "pq"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"C", " ", 
      RowBox[{"gamma", "^", "p"}], " ", 
      RowBox[{"C", "^", "dag"}]}], " ", "=", " ", 
     RowBox[{"-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"gamma", "^", "p"}], ")"}], "^", "T"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"gamma", "^", "ch"}], " ", "=", " ", 
     RowBox[{"diag", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "1"}], ",", "1", ",", "1"}], ")"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"C", "^", "T"}], " ", "=", " ", 
     RowBox[{
      RowBox[{"-", "C"}], " ", 
      RowBox[{"(", "exact", ")"}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"dF2", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Flatten", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"gam", "[", "p", "]"}], " ", ".", " ", 
              RowBox[{"gam", "[", "q", "]"}]}], " ", "+", " ", 
             RowBox[{
              RowBox[{"gam", "[", "q", "]"}], " ", ".", " ", 
              RowBox[{"gam", "[", "p", "]"}]}], " ", "-", " ", 
             RowBox[{"2", " ", 
              RowBox[{"etaLL", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"p", " ", "+", " ", "1"}], ",", " ", 
                 RowBox[{"q", " ", "+", " ", "1"}]}], "]"}], "]"}], " ", 
              RowBox[{"IdentityMatrix", "[", "4", "]"}]}]}], "]"}], ",", " ", 
           
           RowBox[{"{", 
            RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"q", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}], ",", 
         "\n", "     ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"cLL", " ", ".", " ", 
              RowBox[{"gam", "[", "p", "]"}], " ", ".", " ", 
              RowBox[{"ConjugateTranspose", "[", "cLL", "]"}]}], " ", "+", 
             " ", 
             RowBox[{"Transpose", "[", 
              RowBox[{"gam", "[", "p", "]"}], "]"}]}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}], ",", 
         "\n", "     ", 
         RowBox[{"Abs", "[", 
          RowBox[{"gch", " ", "-", " ", 
           RowBox[{"DiagonalMatrix", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", " ", 
              RowBox[{"-", "1"}], ",", " ", "1", ",", " ", "1"}], "}"}], 
            "]"}]}], "]"}], ",", " ", 
         RowBox[{"Abs", "[", 
          RowBox[{"cLL", " ", "+", " ", 
           RowBox[{"Transpose", "[", "cLL", "]"}]}], "]"}]}], "}"}], "]"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<WF-2\>\"", ",", 
      " ", "\"\<Clifford algebra, chirality, charge conjugation (exact)\>\"", 
