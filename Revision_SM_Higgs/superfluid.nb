Cell[CellGroupData[{

Cell["\<\
R.2.4 The ground state of the pairing-only methods (check WSF-5)\
\>", "Subsection",ExpressionUUID->"df594255-d8ca-4eca-ae58-b4037bab7b83"],

Cell[TextData[{
 "In HS (0, 1) and HS (0, 0) the ground state has no normal self-energy, and \
only the pairing terms act. Its pair self-energy is ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["D", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"], 
    StyleBox["d",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "063398a0-4466-467e-a904-3b95cdbbbdcc"],
 " times the pair matrix of the down components with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Chi]", 
    StyleBox["SH",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5b839b28-a032-4a85-84b8-f1606beafd16"],
 ", and in the second version also ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["D", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"], 
    RowBox[{"\[Prime]", 
     StyleBox["u",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ce6cf605-c02c-42ee-81c9-816d12cf51cd"],
 " times that of the up components with ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Chi]", 
    StyleBox["SH",
     FontSlant->"Plain"], "\[Prime]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "240059fc-d605-4e46-a0cc-620230276e9e"],
 ", with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftBracketingBar]", 
     SubsuperscriptBox[
      StyleBox["D", "TI"], 
      StyleBox["SH",
       FontSlant->"Plain"], 
      RowBox[{"\[Prime]", 
       StyleBox["u",
        FontSlant->"Plain"]}]], "\[RightBracketingBar]"}], "\[LongEqual]", 
    RowBox[{"\[LeftBracketingBar]", 
     SubsuperscriptBox[
      StyleBox["D", "TI"], 
      StyleBox["SH",
       FontSlant->"Plain"], 
      StyleBox["d",
       FontSlant->"Plain"]], "\[RightBracketingBar]"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1be35376-1254-4d75-a9c4-787a53db18c1"],
 ": the two channels are decoupled and equal. Every paired quasi-particle has \
the energy ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       StyleBox["q", "TI"], "2"], "+", 
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox[
         StyleBox["M", "TI"], 
         StyleBox["SH",
          FontSlant->"Plain"], 
         StyleBox["eff",
          FontSlant->"Plain"]], ")"}], "2"]}], ")"}], 
    RowBox[{"1", "/", "2"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "699a1225-b0d7-43a2-81ea-03de91c6d1e9"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["eff",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["m", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], "2"], "+", 
       SuperscriptBox[
        RowBox[{"\[LeftBracketingBar]", 
         SubsuperscriptBox[
          StyleBox["D", "TI"], 
          StyleBox["SH",
           FontSlant->"Plain"], 
          StyleBox["d",
           FontSlant->"Plain"]], "\[RightBracketingBar]"}], "2"], "/", "4"}], 
      ")"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0f1b1d06-e0cb-4d63-aea9-616c83293689"],
 ", and the condition of self-consistency is the gap equation"
}], "Text",ExpressionUUID->"1f23ce4d-e603-4c63-b4dc-5327cbe39485"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]], 
    RowBox[{"4", 
     SuperscriptBox["\[Pi]", "2"]}]], "\[ThinSpace]", 
   SubsuperscriptBox[
    StyleBox["I", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "1", ")"}]], 
   RowBox[{"(", 
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["eff",
      FontSlant->"Plain"]], ")"}], "\[LongEqual]", "1", "."}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"4e883094-e3f2-43a8-ab70-fef8bc1578cc"],

Cell[TextData[{
 "The cell solves it with 40 digits and compares ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftBracketingBar]", 
    SubsuperscriptBox[
     StyleBox["D", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["d",
      FontSlant->"Plain"]], "\[RightBracketingBar]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a2c844dd-d899-4015-9a82-2637cf8fa835"],
 " with the singular values of the bidoublet of the Rust program: both equal ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftBracketingBar]", 
    SubsuperscriptBox[
     StyleBox["D", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["d",
      FontSlant->"Plain"]], "\[RightBracketingBar]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "72e4c4fd-ab79-4ab4-a86e-96f1d62a7e09"],
 " in the second version, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftBracketingBar]", 
    SubsuperscriptBox[
     StyleBox["D", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["d",
      FontSlant->"Plain"]], "\[RightBracketingBar]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fa150be5-c221-48d4-ac40-83fac1c86c63"],
 " and 0 in the first."
}], "Text",ExpressionUUID->"4d497721-8fc2-4f6c-a4bf-4b33ae87c171"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"WSF", "-", "5"}], ":", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "gap", " ", "equation", " ", "of", " ", "the", " ", 
      "pairing"}], "-", 
     RowBox[{"only", " ", "ground", " ", "states"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"mEff", " ", "=", " ", 
     RowBox[{"mm", " ", "/.", " ", 
      RowBox[{"FindRoot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"gSH", " ", 
          RowBox[{
           RowBox[{"i1closed", "[", "mm", "]"}], "/", 
           RowBox[{"(", 
            RowBox[{"4", " ", 
             RowBox[{"Pi", "^", "2"}]}], ")"}]}]}], " ", "==", " ", "1"}], ",",
         " ", 
        RowBox[{"{", 
         RowBox[{"mm", ",", " ", 
          RowBox[{"9", "/", "20"}]}], "}"}], ",", " ", 
        RowBox[{"WorkingPrecision", " ", "->", " ", "40"}]}], "]"}]}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"dAbs", " ", "=", " ", 
     RowBox[{"2", " ", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"mEff", "^", "2"}], " ", "-", " ", 
        RowBox[{"mLL", "^", "2"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dev5", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"r", " ", "=", " ", 
              RowBox[{"grOf", "[", 
               RowBox[{"ver", ",", " ", "meth"}], "]"}]}], ",", " ", "s1", ",",
              " ", "s2"}], "}"}], ",", "\n", "      ", 
           RowBox[{
            RowBox[{"s1", " ", "=", " ", 
             RowBox[{"num", "[", 
              RowBox[{"r", "[", 
               RowBox[{"[", 
                RowBox[{"col", "[", 
                 RowBox[{"ghdr", ",", " ", "\"\<sing1\>\""}], "]"}], "]"}], 
               "]"}], "]"}]}], ";", " ", 
            RowBox[{"s2", " ", "=", " ", 
             RowBox[{"num", "[", 
              RowBox[{"r", "[", 
               RowBox[{"[", 
                RowBox[{"col", "[", 
                 RowBox[{"ghdr", ",", " ", "\"\<sing2\>\""}], "]"}], "]"}], 
               "]"}], "]"}]}], ";", "\n", "      ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{"s1", " ", "-", " ", "dAbs"}], "]"}], ",", " ", 
              RowBox[{"Abs", "[", 
               RowBox[{"s2", " ", "-", " ", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"ver", " ", "==", " ", "\"\<second\>\""}], ",", " ",
                   "dAbs", ",", " ", "0"}], "]"}]}], "]"}]}], "}"}]}]}], 
          "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"ver", ",", " ", 
           RowBox[{"{", 
            RowBox[{"\"\<second\>\"", ",", " ", "\"\<first\>\""}], "}"}]}], 
          "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"meth", ",", " ", 
           RowBox[{"{", 
            RowBox[{"\"\<HS (0, 1)\>\"", ",", " ", "\"\<HS (0, 0)\>\""}], 
            "}"}]}], "}"}]}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rvCheck", "[", 
     RowBox[{"\"\<WSF-5\>\"", ",", " ", 
      RowBox[{"\"\<HS (0, 1) and HS (0, 0), where only the pairing terms act: \
the gap equation G_SH I1(M_eff) / (4 pi^2) = 1 \\\ngives M_eff = \>\"", " ", "<>",
        " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"NumberForm", "[", 
         RowBox[{
          RowBox[{"N", "[", 
           RowBox[{"mEff", ",", " ", "16"}], "]"}], ",", " ", "16"}], "]"}], 
        "]"}], " ", "<>", " ", "\"\< and |D| = 2 (M_eff^2 - m^2)^(1/2) = \>\"",
        " ", "<>", "\n", "  ", 
       RowBox[{"ToString", "[", 
        RowBox[{"NumberForm", "[", 
         RowBox[{
          RowBox[{"N", "[", 
           RowBox[{"dAbs", ",", " ", "16"}], "]"}], ",", " ", "16"}], "]"}], 
        "]"}], " ", "<>", 
       " ", "\"\< (30 digits); the singular values of the bidoublet of the \
Rust program are |D| \\\nand |D| in the second version and |D| and 0 in the \
first\>\""}], ",", " ", 
      RowBox[{"dev5", " ", "<", " ", 
       RowBox[{"10", "^", 
        RowBox[{"-", "9"}]}]}], ",", " ", 
      RowBox[{"\"\<deviation \>\"", " ", "<>", " ", 
       RowBox[{"sci", "[", "dev5", "]"}]}]}], "]"}], ";"}]}]}]], "Input",
 CellLabel->
  "In[618]:=",ExpressionUUID->"7f88dfe2-e9c1-488d-95ab-71753f304f33"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"PASS \"\>", "\[InvisibleSpace]", "\<\"WSF-5\"\>", 
   "\[InvisibleSpace]", "\<\"  \"\>", 
   "\[InvisibleSpace]", "\<\"HS (0, 1) and HS (0, 0), where only the pairing \
terms act: the gap equation G_SH I1(M_eff) / (4 pi^2) = 1 gives M_eff = \
0.4529674056079986 and |D| = 2 (M_eff^2 - m^2)^(1/2) = 0.8128455463204339 (30 \
digits); the singular values of the bidoublet of the Rust program are |D| and \
|D| in the second version and |D| and 0 in the first\"\>", 
   "\[InvisibleSpace]", "\<\" [\"\>", 
   "\[InvisibleSpace]", "\<\"deviation 4.841e-12\"\>", 
   "\[InvisibleSpace]", "\<\"]   [the same check: Rust \"\>", 
   "\[InvisibleSpace]", "\<\"SF-6a, SF-6b\"\>", 
   "\[InvisibleSpace]", "\<\", Python \"\>", 
   "\[InvisibleSpace]", "\<\"YSF-6, YSF-12\"\>", 
   "\[InvisibleSpace]", "\<\"]\"\>"}],
  SequenceForm[
  "PASS ", "WSF-5", "  ", 
   "HS (0, 1) and HS (0, 0), where only the pairing terms act: the gap \
equation G_SH I1(M_eff) / (4 pi^2) = 1 gives M_eff = 0.4529674056079986 and \
|D| = 2 (M_eff^2 - m^2)^(1/2) = 0.8128455463204339 (30 digits); the singular \
values of the bidoublet of the Rust program are |D| and |D| in the second \
version and |D| and 0 in the first", " [", "deviation 4.841e-12", 
   "]   [the same check: Rust ", "SF-6a, SF-6b", ", Python ", "YSF-6, YSF-12",
    "]"],
  Editable->False]], "Print",
 CellChangeTimes->{4.004330940122101*^9},
 CellLabel->
  "During evaluation of \
In[618]:=",ExpressionUUID->"bd0cc924-1c7f-490c-8586-03f7c18f2ee2"]
