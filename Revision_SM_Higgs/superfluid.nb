Cell["R.1.7 The parity of the pair matrices (check WQN-7)", "Subsection",ExpressionUUID->"761ba015-bd97-42dd-a183-3829282aa647"],

Cell[TextData[{
 "Under parity, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Phi]", "\[RightArrow]", 
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], "0"], "\[Phi]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0a53e4fb-1a91-4ef5-9a2e-016a33f309ba"],
 " with the intrinsic parity ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "677dca33-59f0-46f5-8c1d-f07732037938"],
 " for every field, a pair matrix goes over into ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], "0"], 
    StyleBox["M",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], "0"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "24f7b52a-1ed7-4241-a60a-464a2d35c8c8"],
 ". The pairs of the hypotheses, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["ch",
      FontSlant->"Plain"]], "\[CircleTimes]", 
    SubsuperscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["s", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cfcc257d-4767-4ea3-becf-8d85d0c5dfc4"],
 ", are even (a scalar), and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[CircleTimes]", 
    SubsuperscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["s", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7b3043ba-bd89-487e-a571-5f1149c21d7e"],
 " is odd (a pseudoscalar), with either singlet."
}], "Text",ExpressionUUID->"8773a6e1-3956-4d0e-9c1f-316700e83f56"],

