Cell[TextData[{
 "The next cell prints the numbers in the form of a table (in per cent where \
marked): what the polynomial gets wrong at its own minimum (the position, the \
depth, the curvature and the resulting mass of the amplitude mode), the \
largest residuals of the fits with more or fewer powers, the sign changes, \
and the coefficient ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e8b9016c-5b1d-4df2-84b4-06b528f0abc0"],
 " fitted on the three intervals. The figure after it shows the residuals \
(top) and the decrease of the largest residual with the number of powers \
(bottom)."
}], "Text",ExpressionUUID->"55b59978-d4b3-4841-8df5-bc61e9771de4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "the", " ", "table", " ", "of", " ", "the", " ", "accuracy", " ", "of", " ",
      "the", " ", "Landau", " ", "form"}], ";", " ", 
    RowBox[{
     RowBox[{"pct", "[", "x", "]"}], ":", " ", 
     RowBox[{
     "x", " ", "in", " ", "per", " ", "cent", " ", "with", " ", "three", " ", 
      "significant", " ", "digits"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"pct", "[", "x_", "]"}], " ", ":=", " ", 
     RowBox[{"NumberForm", "[", 
      RowBox[{
       RowBox[{"100.", " ", "x"}], ",", " ", "3"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"lfRows", " ", "=", " ", 
     RowBox[{"{", "\n", "   ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<minimum of the polynomial: Phi_L/Phi0 - 1 (per cent)\>\"",
          ",", " ", 
         RowBox[{
          RowBox[{"pct", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"lfResults", "[", "#", "]"}], "[", "\"\<phifit\>\"", 
              "]"}], "/", 
             RowBox[{"lfPhi0", "[", "#", "]"}]}], " ", "-", " ", "1"}], "]"}],
           " ", "&"}]}], "}"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<depth of the polynomial / depth - 1 (per cent)\>\"", ",",
          " ", 
         RowBox[{
          RowBox[{"pct", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"lfResults", "[", "#", "]"}], "[", "\"\<depthfit\>\"", 
              "]"}], "/", 
             RowBox[{"lfE0", "[", "#", "]"}]}], " ", "-", " ", "1"}], "]"}], 
          " ", "&"}]}], "}"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<curvature at its minimum / V''amp - 1 (per cent)\>\"", ",",
          " ", 
         RowBox[{
          RowBox[{"pct", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"lfResults", "[", "#", "]"}], "[", "\"\<curvfit\>\"", 
              "]"}], "/", 
             RowBox[{"rustPart3", "[", 
              RowBox[{"\"\<p3_V2amp_\>\"", " ", "<>", " ", "#"}], "]"}]}], 
            " ", "-", " ", "1"}], "]"}], " ", "&"}]}], "}"}], ",", "\n", 
       "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<resulting M^H / M^H - 1 (per cent)\>\"", ",", " ", 
         RowBox[{
          RowBox[{"pct", "[", 
           RowBox[{
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"lfResults", "[", "#", "]"}], "[", "\"\<curvfit\>\"", 
               "]"}], "/", 
              RowBox[{"rustPart3", "[", 
               RowBox[{"\"\<p3_V2amp_\>\"", " ", "<>", " ", "#"}], "]"}]}], 
             "]"}], " ", "-", " ", "1"}], "]"}], " ", "&"}]}], "}"}], ",", 
       "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<largest residual / depth, powers to Phi^4 (per cent)\>\"",
          ",", " ", 
         RowBox[{
          RowBox[{"pct", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"lfResults", "[", "#", "]"}], "[", "\"\<resK2\>\"", 
             "]"}], "/", 
            RowBox[{"Abs", "[", 
             RowBox[{"lfE0", "[", "#", "]"}], "]"}]}], "]"}], " ", "&"}]}], 
        "}"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<the same, powers to Phi^6: the Landau form (per \
cent)\>\"", ",", " ", 
         RowBox[{
          RowBox[{"pct", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"lfResults", "[", "#", "]"}], "[", "\"\<resK3\>\"", 
             "]"}], "/", 
            RowBox[{"Abs", "[", 
             RowBox[{"lfE0", "[", "#", "]"}], "]"}]}], "]"}], " ", "&"}]}], 
        "}"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<the same, powers to Phi^8 (per cent)\>\"", ",", " ", 
         RowBox[{
          RowBox[{"pct", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"lfResults", "[", "#", "]"}], "[", "\"\<resK4\>\"", 
             "]"}], "/", 
            RowBox[{"Abs", "[", 
             RowBox[{"lfE0", "[", "#", "]"}], "]"}]}], "]"}], " ", "&"}]}], 
        "}"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"\"\<the same, powers to Phi^10 (per cent)\>\"", ",", " ", 
         RowBox[{
          RowBox[{"pct", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"lfResults", "[", "#", "]"}], "[", "\"\<resK5\>\"", 
