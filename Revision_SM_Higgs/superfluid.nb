Cell[CellGroupData[{

Cell["\<\
R.1.9 The invariance of the pairing terms and the determinant (check WQN-9)\
\>", "Subsection",ExpressionUUID->"8ea528f9-1ac5-4f90-9851-6bc4459724be"],

Cell[TextData[{
 "The pairing terms are ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d151cd1f-c7b7-4f3b-bccc-163547920b91"],
 " times the sum of the squared lengths of the two pair operators, that is, \
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     SubscriptBox[
      StyleBox["G", "TI"], 
      StyleBox["SH",
       FontSlant->"Plain"]]}], "\[ThinSpace]", 
    StyleBox["tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       StyleBox["\[ScriptCapitalM]",
        FontSlant->"Plain"], "\[Dagger]"], 
      StyleBox["\[ScriptCapitalM]",
       FontSlant->"Plain"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "24f6b29d-0504-43fb-b100-0f2cf53e4696"],
 " on the bidoublet; they are invariant under every transformation that acts \
on the components of the pair fields by a unitary matrix, which is the case \
when the generators ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7dcacd42-e694-4f29-94f7-1009959bb58d"],
 " are Hermitian. The finite transformations of the Rust check QN-9 are here \
replaced by this infinitesimal statement: the groups are connected, so every \
element is a product of exponentials of generators. The determinant ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["det",
     FontSlant->"Plain"], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["\[ScriptCapitalM]",
      FontSlant->"Plain"], 
     StyleBox["SH",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubscriptBox["\[Epsilon]", 
     StyleBox["st", "TI"]], 
    SubsuperscriptBox["\[CapitalPi]", 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["s", "TI"]], 
    SubsuperscriptBox["\[CapitalPi]", 
     StyleBox["SH",
      FontSlant->"Plain"], 
     RowBox[{"\[Prime]", 
      StyleBox["t", "TI"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d10e343f-d800-4eb3-9a55-64a934a80aac"],
 " changes under ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["\[ScriptCapitalM]",
     FontSlant->"Plain"], "\[RightArrow]", 
    StyleBox["\[ScriptCapitalM]",
     FontSlant->"Plain"], "+", 
    StyleBox["i", "TI"], "\[Epsilon]", 
    StyleBox["G", "TI"], 
    StyleBox["\[ScriptCapitalM]",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "631c89f3-93fc-4c51-bc11-94a686b6fe4e"],
 " by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["i", "TI"], "\[Epsilon]", 
    StyleBox["q", "TI"], "\[ThinSpace]", 
    StyleBox["det",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["\[ScriptCapitalM]",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2d2d4d7b-a8c3-4cbf-982f-c28a41834355"],
 " with the charge ",
 Cell[BoxData[
  FormBox[
   StyleBox["q", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "94d607a8-5f90-4c34-8a4e-170103f0f67e"],
 "; it has ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["q", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a0181607-9086-4d67-b459-561e4307b098"],
 " under ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["T", "TI"], 
    RowBox[{
     StyleBox["a", "TI"], ",", 
     StyleBox["SM",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f8777a9d-a899-4b29-999e-c36da0bfa4a3"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["a", "TI"], ",", 
     StyleBox["R",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "eef718ed-c80c-4959-b93b-49232ba315ba"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "85b716ce-d198-4317-a76d-91b3cfcb804d"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["Y", "TI"], 
    StyleBox["SM",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "be6c8203-370f-48d2-a856-55d1e5154d8d"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["q", "TI"], "\[LongEqual]", "4"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "05f7ecde-70b8-43e0-ae98-5b8b5b52473d"],
 " under ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["F", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"], 
    StyleBox["tot",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "804dad8a-ddd7-4cfa-bb51-446f167d03d0"],
 ". ",
 StyleBox["Why it matters.",
  FontWeight->"Bold"],
 " The superfluid of the second version breaks ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["F", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"], 
    StyleBox["tot",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0ec189d3-74ea-4bbf-ad29-b064e9e8368f"],
 " and has one Goldstone boson more than the Standard Model (decision D32 of \
the task record, pending the author's choice). A term ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["det",
     FontSlant->"Plain"], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["\[ScriptCapitalM]",
      FontSlant->"Plain"], 
     StyleBox["SH",
      FontSlant->"Plain"]], "+", 
    RowBox[{
     StyleBox["h",
      FontSlant->"Plain"], ".", 
     StyleBox["c",
      FontSlant->"Plain"], "."}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5d0f327a-e498-45ec-b861-649a40443e35"],
 " in the Hamiltonian, one of the three choices of D32, would break ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["U", "TI"], 
    SubscriptBox[
     RowBox[{"(", "1", ")"}], 
     StyleBox["F",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "62f15b8f-c237-4a40-b990-07f9299b537f"],
 " alone and give that boson a mass, without breaking any other symmetry."
}], "Text",ExpressionUUID->"6b039c61-9571-4960-931e-071d4d917723"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", 
          RowBox[{"--", 
           RowBox[{"--", 
            RowBox[{"--", 
             RowBox[{"--", 
              RowBox[{"--", 
               RowBox[{"--", 
                RowBox[{"--", 
                 RowBox[{"--", 
                  RowBox[{"--", 
                   RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
