Cell[CellGroupData[{

Cell["III.G.5 The gradient coefficient and the regularization", "Section",ExpressionUUID->"39f275bc-12fc-4562-b49a-2956bc4f8d47"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["c",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4c54ea3d-c613-462d-b9ee-df213a6bd16a"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"[", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["a", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["Tay",
         FontSlant->"Plain"]}]], 
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox[
         StyleBox["q", "TI"], 
         StyleBox["SF",
          FontSlant->"Plain"], 
         StyleBox["pair",
          FontSlant->"Plain"]], ";", 
        SubsuperscriptBox[
         StyleBox["T", "TI"], 
         StyleBox["SF",
          FontSlant->"Plain"], 
         RowBox[{
          StyleBox["X", "TI"], ",", 
          StyleBox["c",
           FontSlant->"Plain"]}]]}], ")"}], "-", 
      SubsuperscriptBox[
       StyleBox["a", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["Tay",
         FontSlant->"Plain"]}]], 
      RowBox[{"(", 
       RowBox[{"0", ";", 
        SubsuperscriptBox[
         StyleBox["T", "TI"], 
         StyleBox["SF",
          FontSlant->"Plain"], 
         RowBox[{
          StyleBox["X", "TI"], ",", 
          StyleBox["c",
           FontSlant->"Plain"]}]]}], ")"}]}], "]"}], "/", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["pair",
        FontSlant->"Plain"]], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0cd75279-b76f-4ad3-917b-6e8df7140855"],
 " at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["pair",
      FontSlant->"Plain"]], "\[LongEqual]", "0.01"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f691409f-81f1-4f86-ad43-08f2520aff71"],
 " and ",
 Cell[BoxData[
  FormBox["0.02", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4bcc83e9-d49d-43ac-95d7-10c0f7053b1c"],
 " with the Richardson extrapolation. The six directions of the grid are \
exact at second order in the twist (the term of second order is a quadratic \
polynomial in the direction). ",
 StyleBox["The regularization (a remark: what it means and why it matters).",
  FontWeight->"Bold"],
 " The model has the cutoff ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox[
      StyleBox["q", "TI"], "\[RightVector]"], "\[RightBracketingBar]"}], "<", 
    
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bf2c064b-f597-436d-bfe2-0987ff74f50d"],
 " on the momenta of the uniform states, and for a moving pair it must be put \
on one of two momenta. With the cutoff on the momenta of the two charges of \
the pair, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftBracketingBar]", 
     RowBox[{
      OverscriptBox[
       StyleBox["q", "TI"], "\[RightVector]"], "\[PlusMinus]", 
      FractionBox["1", "2"], 
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["pair",
        FontSlant->"Plain"]], 
      SubscriptBox[
       OverscriptBox[
        StyleBox["e", "TI"], "\[RightVector]"], "3"]}], 
     "\[RightBracketingBar]"}], "<", 
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "915327a8-8e52-4bf0-8413-613d055a5fa1"],
 " (a lens of two spheres), a moving pair loses the pairs in a shell at the \
cutoff whose thickness is of order ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftBracketingBar]", 
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["pair",
      FontSlant->"Plain"]], "\[RightBracketingBar]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f274f30f-a477-4a0b-836f-389e288de848"],
 ", so that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], 
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["q", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      StyleBox["pair",
       FontSlant->"Plain"]], ")"}], "-", 
    StyleBox["a", "TI"], 
    RowBox[{"(", "0", ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2a6abd31-d2ab-456b-a76a-9337756d98ee"],
 " is linear in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftBracketingBar]", 
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["pair",
      FontSlant->"Plain"]], "\[RightBracketingBar]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "11504817-4800-4595-92f0-8a3c6c14bd19"],
 " and a gradient expansion does not exist. With the cutoff on the relative \
momentum, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox[
      StyleBox["q", "TI"], "\[RightVector]"], "\[RightBracketingBar]"}], "<", 
    
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8c3201c7-d564-45dc-84c6-4354de673072"],
 ", the change is quadratic; this routing is used here (it is the routing of \
the twisted states of the coefficients of the kinetic part at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3c3f54fd-e7de-4102-8922-471e42ff9b77"],
 ", where the uniform twist shifts the momenta inside the fixed sphere). The \
remaining error of the regularization is measured by the twist ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["q", "TI"], "\[ThinSpace]", 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], "3"], "\[CircleTimes]", 
    FractionBox["1", "2"], 
    SubscriptBox["\[Tau]", "3"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0460f70e-229a-43fb-b0c9-ab22c834776c"],
 " of the unbroken generator ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8bbefa03-8ccb-42d0-a4a1-2651c7acc843"],
 ", which does not change the field along ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox[
     StyleBox["e", "TI"], "\[RightVector]"], "3"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8247a2b8-147c-45e9-b5b8-2006aa5b9474"],
 " and would cost nothing in a gauge-invariant theory; with the cutoff it \
costs the spurious coefficient ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["c",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     RowBox[{
      StyleBox["T",
       FontSlant->"Plain"], "\[InvisibleSpace]", "3"}]}]], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0a9949b3-4463-43c5-b78f-d4db85e2e7ca"],
 ", about a fifth of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["c",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "497e7e05-97f1-4ff8-8145-b803d57b2963"],
 " (the Rust table). This matters for the size of the Ginzburg number, which \
is proportional to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SuperscriptBox[
     StyleBox["c",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "3"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "69604edb-7c00-4cc4-8546-071fd4563450"],
 ": changing ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["c",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "00ceb8d5-fb08-4733-991d-92ca1e54a95f"],
 " by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    SubsuperscriptBox[
     StyleBox["c",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      RowBox[{
       StyleBox["T",
        FontSlant->"Plain"], "\[InvisibleSpace]", "3"}]}]]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ff908a2a-2249-4ddc-8f63-7ca181bb2145"],
 " changes it by a factor of about 2 either way (Section III.G.7), not enough \
to change the conclusion. The next cells compute the gradient coefficient \
from the phase twist and from the isospin twist, check that it does not \
depend on the quadrature (for CJT: 40 radial nodes, and a product rule of 144 \
directions), and compare the two regularizations on a product rule: 24 \
Gauss-Legendre nodes in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["cos",
     FontSlant->"Plain"], "\[ThinSpace]", "\[Theta]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e54da56c-581b-43a5-9cf5-d2bb88e888c6"],
 " (12 on each half), 6 angles ",
 Cell[BoxData[
  FormBox["\[CurlyPhi]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8c79e1c3-de15-49a9-ad58-1bf6bec8357c"],
 " and 24 radial nodes on ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"0", ",", 
     StyleBox["r", "TI"], 
     RowBox[{"(", 
      OverscriptBox[
       StyleBox["n", "TI"], "\[RightVector]"], ")"}]}], "]"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0202e810-316b-4cba-9934-64b1ffdbb77e"],
 " in the direction ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["n", "TI"], "\[RightVector]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cd5a3678-888b-4976-b20d-f205716a3af3"],
 ", with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r", "TI"], "\[LongEqual]", 
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "08a95e51-5023-4910-99ea-79712d066d9a"],
 " for the sphere and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r", "TI"], 
    RowBox[{"(", 
     OverscriptBox[
      StyleBox["n", "TI"], "\[RightVector]"], ")"}], "\[LongEqual]", 
    RowBox[{"-", 
     FractionBox["1", "2"]}], 
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["pair",
      FontSlant->"Plain"]], 
    RowBox[{"\[LeftBracketingBar]", 
     SubscriptBox[
      StyleBox["n", "TI"], "3"], "\[RightBracketingBar]"}], "+", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox["\[CapitalLambda]", 
        StyleBox["LL",
         FontSlant->"Plain"], "2"], "-", 
       FractionBox["1", "4"], 
       SuperscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox[
          StyleBox["q", "TI"], 
          StyleBox["SF",
           FontSlant->"Plain"], 
          StyleBox["pair",
           FontSlant->"Plain"]], ")"}], "2"], 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         SubsuperscriptBox[
          StyleBox["n", "TI"], "3", "2"]}], ")"}]}], ")"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a6df74e6-ed6d-4553-9305-940dfe647f50"],
 " for the lens."
}], "Text",ExpressionUUID->"c26f5d32-9a08-4576-b318-8d294d154a4b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"gzGrad", "[", 
      RowBox[{
      "t", ",", " ", "t2", ",", " ", "s", ",", " ", "relax", ",", " ", 
       "nodes"}], "]"}], ":", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"c", ",", " ", 
        RowBox[{"c", 
         RowBox[{"(", "0.01", ")"}]}], ",", " ", 
        RowBox[{"c", 
         RowBox[{"(", "0.02", ")"}]}]}], "}"}], " ", "at", " ", "T_c", " ", 
      "from", " ", "the", " ", "twist", " ", "of", " ", "the", " ", "isospin",
       " ", "matrix", " ", "t2"}]}], ",", " ", 
    RowBox[{
     RowBox[{"twist", " ", "strength", "\n", "   ", "q"}], " ", "=", " ", 
     RowBox[{
      RowBox[{"k", "/", "s"}], " ", "for", " ", "the", " ", "pair", " ", 
      "momentum", " ", "k", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"s", " ", "=", " ", 
         RowBox[{"2", " ", "for", " ", "the", " ", "phase", " ", "twist"}]}], 
        ",", " ", 
        RowBox[{"s", " ", "=", " ", 
         RowBox[{
         "1", " ", "for", " ", "the", " ", "isospin", " ", "twists"}]}]}], 
       ")"}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"gzGrad", "[", 
      RowBox[{"t_", ",", " ", "t2_", ",", " ", "s_", ",", " ", 
       RowBox[{"relax_", " ", ":", " ", "True"}], ",", " ", 
       RowBox[{"nodes_", " ", ":", " ", "Automatic"}]}], "]"}], " ", ":=", 
     " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"tc", " ", "=", " ", 
          RowBox[{"thTc", "[", "t", "]"}]}], ",", " ", "a0", ",", " ", "c1", ",",
          " ", "c2"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"a0", " ", "=", " ", 
         RowBox[{
          RowBox[{"gzA", "[", 
           RowBox[{
           "t", ",", " ", "tc", ",", " ", "0.", ",", " ", "t2", ",", " ", 
            "relax", ",", " ", "nodes"}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"c1", " ", "=", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"gzA", "[", 
              RowBox[{"t", ",", " ", "tc", ",", " ", 
               RowBox[{"0.01", "/", "s"}], ",", " ", "t2", ",", " ", "relax", 
               ",", " ", "nodes"}], "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", "a0"}], ")"}], "/", 
          RowBox[{"0.01", "^", "2"}]}]}], ";", "\n", "   ", 
        RowBox[{"c2", " ", "=", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"gzA", "[", 
              RowBox[{"t", ",", " ", "tc", ",", " ", 
               RowBox[{"0.02", "/", "s"}], ",", " ", "t2", ",", " ", "relax", 
               ",", " ", "nodes"}], "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", "a0"}], ")"}], "/", 
          RowBox[{"0.02", "^", "2"}]}]}], ";", "\n", "   ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"4", " ", "c1"}], " ", "-", " ", "c2"}], ")"}], "/", 
           "3"}], ",", " ", "c1", ",", " ", "c2"}], "}"}]}]}], "]"}]}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"c", ",", " ", "c1", ",", " ", "c2", ",", " ", "cIso"}], 
         "}"}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"c", ",", " ", "c1", ",", " ", "c2"}], "}"}], " ", "=", 
          " ", 
          RowBox[{"gzGrad", "[", 
           RowBox[{"t", ",", " ", 
            RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", " ", "2."}], 
           "]"}]}], ";", "\n", "   ", 
         RowBox[{"cIso", " ", "=", " ", 
          RowBox[{
           RowBox[{"gzGrad", "[", 
            RowBox[{"t", ",", " ", 
             RowBox[{
              RowBox[{"PauliMatrix", "[", "1", "]"}], "/", "2"}], ",", " ", 
             "1."}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{"\"\<WP3-G5 \>\"", " ", "<>", " ", "t"}], ",", " ", 
           RowBox[{
            RowBox[{"thName", "[", "t", "]"}], " ", "<>", 
            " ", "\"\<: the isospin twist gives the gradient coefficient of \
the phase twist, c = \>\"", " ", "<>", " ", 
            RowBox[{"ToString", "[", 
             RowBox[{"NumberForm", "[", 
              RowBox[{"c", ",", " ", "10"}], "]"}], "]"}], " ", "<>", 
            " ", "\"\< (isospin invariance; relative difference)\>\""}], ",", 
           "\n", "    ", 
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"cIso", "/", "c"}], " ", "-", " ", "1"}], "]"}], ",", 
           " ", 
           RowBox[{"10", "^", 
            RowBox[{"-", "8"}]}], ",", " ", 
           RowBox[{"\"\<P3-G5 \>\"", " ", "<>", " ", "t"}], ",", " ", 
           RowBox[{"\"\<YP3-G5 \>\"", " ", "<>", " ", "t"}]}], "]"}], ";", 
         "\n", "   ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{"\"\<WP3-G6 \>\"", " ", "<>", " ", "t"}], ",", " ", 
           RowBox[{
            RowBox[{"thName", "[", "t", "]"}], " ", "<>", 
            " ", "\"\<: c > 0 and the extrapolation in k converges: c(0.01) = \
\>\"", " ", "<>", " ", 
            RowBox[{"ToString", "[", 
             RowBox[{"NumberForm", "[", 
              RowBox[{"c1", ",", " ", "10"}], "]"}], "]"}], " ", "<>", 
            " ", "\"\<, c(0.02) = \>\"", " ", "<>", " ", 
            RowBox[{"ToString", "[", 
             RowBox[{"NumberForm", "[", 
              RowBox[{"c2", ",", " ", "10"}], "]"}], "]"}], " ", "<>", 
            " ", "\"\<, extrapolated \>\"", " ", "<>", " ", 
            RowBox[{"ToString", "[", 
             RowBox[{"NumberForm", "[", 
              RowBox[{"c", ",", " ", "10"}], "]"}], "]"}], " ", "<>", 
            " ", "\"\< = Rust (relative difference; 1 is added if c <= 0 or \
the two values differ by more than 1e-3 of c)\>\""}], ",", "\n", "    ", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"c", " ", "-", " ", 
               RowBox[{"gzRust", "[", 
                RowBox[{"t", ",", " ", "\"\<c\>\""}], "]"}]}], "]"}], "/", 
             RowBox[{"gzRust", "[", 
              RowBox[{"t", ",", " ", "\"\<c\>\""}], "]"}]}], " ", "+", " ", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"c", " ", ">", " ", "0"}], " ", "&&", " ", 
               RowBox[{
                RowBox[{
                 RowBox[{"Abs", "[", 
                  RowBox[{"c2", " ", "-", " ", "c1"}], "]"}], "/", "c"}], " ",
                 "<", " ", 
                RowBox[{"10", "^", 
                 RowBox[{"-", "3"}]}]}]}], ",", " ", "0", ",", " ", "1"}], 
             "]"}]}], ",", " ", 
           RowBox[{"10", "^", 
            RowBox[{"-", "8"}]}], ",", " ", 
           RowBox[{"\"\<P3-G6 \>\"", " ", "<>", " ", "t"}], ",", " ", 
           RowBox[{"\"\<YP3-G6 \>\"", " ", "<>", " ", "t"}]}], "]"}], ";", 
         "\n", "   ", 
         RowBox[{
          RowBox[{"gzResults", "[", "t", "]"}], " ", "=", " ", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"gzResults", "[", "t", "]"}], ",", " ", 
            RowBox[{"<|", 
             RowBox[{"\"\<c\>\"", " ", "->", " ", "c"}], "|>"}]}], 
           "]"}]}]}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"t", ",", " ", "thTags"}], "}"}]}], "]"}], ";"}]}]}]], "Input",\

 CellLabel->
  "In[387]:=",ExpressionUUID->"3d6c7743-96f9-48a2-ad5c-0654f9ba84e2"],

