  "9f73bde8-8591-41e9-a215-1d8529d5476f"],
 " the kinetic term ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    SubscriptBox[
     StyleBox["Z", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     OverscriptBox["\[Eta]", "."], "2"]}], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "395ce231-7eb8-41c1-908e-bbb4fb48b702"],
 " and the potential ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], 
    SuperscriptBox[
     StyleBox["V", "TI"], "\[Prime]\[Prime]"], 
    SuperscriptBox["\[Eta]", "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dcbfb60f-d10f-4870-8f47-45ed74775f6a"],
 ", hence ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Omega]", "2"], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["V", "TI"], "\[Prime]\[Prime]"], "/", 
    RowBox[{"(", 
     RowBox[{"4", 
      SubscriptBox[
       StyleBox["Z", "TI"], 
       StyleBox["SH",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "aac85072-5f6b-48d2-b4f0-db0cddd7581e"],
 "; the chemical potential of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["T", "TI"], 
    RowBox[{"3", ",", 
     StyleBox["SM",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "80b4f1c4-7072-4fb0-ab74-011607b52d3a"],
 " gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Chi]", 
     StyleBox["SH",
      FontSlant->"Plain"], "33"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["Z", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[CurlyPhi]", 
       StyleBox["SH",
        FontSlant->"Plain"], "0"], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "851ce802-f9d0-4b94-9a62-8775d52f6923"],
 ". In the first version one pair field gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Omega]", "2"], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["V", "TI"], "\[Prime]\[Prime]"], "/", 
    RowBox[{"(", 
     RowBox[{"2", 
      SubscriptBox[
       StyleBox["Z", "TI"], 
       StyleBox["SH",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5dfc5d97-d0c2-4127-ac24-aa213b2138b0"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Chi]", 
     StyleBox["SH",
      FontSlant->"Plain"], "33"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["Z", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[CurlyPhi]", 
       StyleBox["SH",
        FontSlant->"Plain"], "0"], ")"}], "2"], "/", "2"}], TraditionalForm]],
   "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4698da73-2cf9-40db-9558-6c34af4fee66"],
 ". In both versions"
}], "Text",ExpressionUUID->"dd2b399e-bd6a-45a7-a1e6-f33fdb4ed284"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["M", "TI"], 
      StyleBox["SH",
       FontSlant->"Plain"], 
      StyleBox["EFT",
       FontSlant->"Plain"]], ")"}], "2"], "\[LongEqual]", 
   FractionBox[
    RowBox[{
     SubsuperscriptBox[
      StyleBox["V", "TI"], 
      StyleBox["SH",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["eff",
        FontSlant->"Plain"], "\[ThinSpace]", "\[Prime]", "\[Prime]"}]], 
     RowBox[{"(", 
      SubsuperscriptBox["\[CurlyPhi]", 
       StyleBox["SH",
        FontSlant->"Plain"], "0"], ")"}], "\[ThinSpace]", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox["\[CurlyPhi]", 
        StyleBox["SH",
         FontSlant->"Plain"], "0"], ")"}], "2"]}], 
    RowBox[{"4", 
     SubsuperscriptBox["\[Chi]", 
      StyleBox["SH",
       FontSlant->"Plain"], "33"]}]], ","}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"5d8747b3-0ff2-4608-8432-0e1f4e22e38f"],

Cell["\<\
the formula with which the Rust program computes the mass of the effective \
Lagrangian from its potential and its susceptibility.\
\>", "Text",ExpressionUUID->"c3cc6272-6401-42b1-9838-9b3832a49a38"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", 
          RowBox[{"--", 
           RowBox[{"--", 
            RowBox[{"--", 
             RowBox[{"--", 
              RowBox[{"--", 
               RowBox[{"--", 
                RowBox[{"--", 
                 RowBox[{"--", 
                  RowBox[{"--", 
                   RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{
                    "--", " ", 
                    "WH"}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]\
}]}]}]}]}]}], "-", "2"}], ":", " ", 
    RowBox[{
    "the", " ", "amplitude", " ", "mode", " ", "of", " ", "the", " ", 
     "effective", " ", "Lagrangian"}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"second", " ", 
      RowBox[{"version", ":", " ", "L"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"Z", " ", 
       RowBox[{"(", 
        RowBox[{"|", 
         RowBox[{"d", " ", 
          RowBox[{"Phi", "^", "d"}]}], "|", 
         RowBox[{
          RowBox[{"^", "2"}], " ", "+"}], " ", "|", 
         RowBox[{"d", " ", 
          RowBox[{
           RowBox[{"Phi", "'"}], "^", "u"}]}], "|", 
         RowBox[{"^", "2"}]}], ")"}]}], " ", "-", " ", 
      RowBox[{"V", 
       RowBox[{"(", "phi", ")"}]}]}]}], ",", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"both", " ", "lengths", " ", "phi0"}], " ", "+", " ", "eta"}], ";",
      " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"chi", "^", 
         RowBox[{"{", "33", "}"}]}], " ", "from", " ", "a", " ", "chemical", "\n",
         "   ", "potential", " ", "of", " ", 
        RowBox[{"T", "^", "3"}], " ", 
        RowBox[{"(", 
         RowBox[{"charges", " ", "-", 
          RowBox[{
           RowBox[{"1", "/", "2"}], " ", "and"}], " ", "+", 
          RowBox[{"1", "/", "2"}]}], ")"}]}], ":", " ", 
       RowBox[{"E", 
        RowBox[{"(", "mu", ")"}]}]}], " ", "=", " ", 
      RowBox[{"V", " ", "-", " ", 
       RowBox[{"Z", " ", 
        RowBox[{"mu", "^", "2"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"1", "/", "4"}], " ", "+", " ", 
          RowBox[{"1", "/", "4"}]}], ")"}], " ", 
        RowBox[{"phi0", "^", "2"}]}]}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"chi33v2", " ", "=", " ", 
     RowBox[{"-", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "zz"}], " ", 
         RowBox[{"mu3", "^", "2"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"1", "/", "4"}], " ", "+", " ", 
           RowBox[{"1", "/", "4"}]}], ")"}], " ", 
         RowBox[{"phi0", "^", "2"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"mu3", ",", " ", "2"}], "}"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", 
      RowBox[{"amplitude", ":", " ", 
       RowBox[{"kinetic", " ", "term", " ", "2", " ", "Z", " ", 
        RowBox[{
         RowBox[{"eta", "'"}], "^", "2"}]}]}]}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"potential", " ", 
        RowBox[{"V", "''"}], " ", 
        RowBox[{
         RowBox[{"eta", "^", "2"}], " ", "/", " ", "2"}]}], ":", " ", 
       RowBox[{"omega", "^", "2"}]}], " ", "=", " ", 
      RowBox[{
       RowBox[{"V", "''"}], " ", "/", " ", 
       RowBox[{"(", 
        RowBox[{"4", " ", "Z"}], ")"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"om2v2", " ", "=", " ", 
     RowBox[{"vpp", "/", 
      RowBox[{"(", 
       RowBox[{"4", " ", "zz"}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"okV2", " ", "=", " ", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{"om2v2", " ", "-", " ", 
        RowBox[{"vpp", " ", 
         RowBox[{
          RowBox[{"phi0", "^", "2"}], "/", 
          RowBox[{"(", 
           RowBox[{"4", " ", "chi33v2"}], ")"}]}]}]}], "]"}], " ", "==", " ", 
      "0"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"first", " ", 
       RowBox[{"version", ":", " ", "L"}]}], " ", "=", " ", 
      RowBox[{"Z", " ", "|", 
       RowBox[{"d", " ", 
        RowBox[{"Phi", "^", "d"}]}], "|", 
       RowBox[{
        RowBox[{"^", "2"}], " ", "-", " ", 
        RowBox[{"V", 
         RowBox[{"(", "phi", ")"}]}]}]}]}], ";", " ", 
     RowBox[{
      RowBox[{"chi", "^", 
       RowBox[{"{", "33", "}"}]}], " ", "=", " ", 
      RowBox[{"2", " ", "Z", " ", 
       RowBox[{"(", 
        RowBox[{"1", "/", "4"}], ")"}], " ", 
       RowBox[{"phi0", "^", "2"}]}]}], ";", " ", 
     RowBox[{"amplitude", ":", " ", 
      RowBox[{
       RowBox[{"Z", " ", 
        RowBox[{
         RowBox[{"eta", "'"}], "^", "2"}]}], " ", "-", " ", 
       RowBox[{
        RowBox[{"V", "''"}], " ", 
        RowBox[{
         RowBox[{"eta", "^", "2"}], "/", "2"}]}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"chi33v1", " ", "=", " ", 
     RowBox[{"-", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "zz"}], " ", 
         RowBox[{"mu3", "^", "2"}], " ", 
         RowBox[{"(", 
          RowBox[{"1", "/", "4"}], ")"}], " ", 
         RowBox[{"phi0", "^", "2"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"mu3", ",", " ", "2"}], "}"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"om2v1", " ", "=", " ", 
     RowBox[{"vpp", "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", "zz"}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"okV1", " ", "=", " ", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{"om2v1", " ", "-", " ", 
        RowBox[{"vpp", " ", 
         RowBox[{
          RowBox[{"phi0", "^", "2"}], "/", 
          RowBox[{"(", 
           RowBox[{"4", " ", "chi33v1"}], ")"}]}]}]}], "]"}], " ", "==", " ", 
      "0"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rvCheck", "[", 
     RowBox[{"\"\<WH-2\>\"", ",", " ", 
      RowBox[{"\"\<the effective Lagrangian of the pair fields gives the mass \
of the amplitude mode M^2 = V'' phi_0^2 / (4 \\\nchi^{33}) in both versions: \
second version chi^{33} = \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"chi33v2", ",", " ", "InputForm"}], "]"}], " ", "<>", 
       " ", "\"\<, M^2 = V''/(4 Z); first \\\nversion chi^{33} = \>\"", " ", "<>",
        " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"chi33v1", ",", " ", "InputForm"}], "]"}], " ", "<>", 
       " ", "\"\<, M^2 = V''/(2 Z) (symbolic)\>\""}], ",", " ", 
      RowBox[{"okV2", " ", "&&", " ", "okV1"}], ",", 
      " ", "\"\<identities\>\""}], "]"}], ";"}]}]}]], "Input",
 CellLabel->
  "In[659]:=",ExpressionUUID->"7fe3ca74-4a51-4416-aafc-310a5f1b6e25"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"PASS \"\>", "\[InvisibleSpace]", "\<\"WH-2\"\>", 
   "\[InvisibleSpace]", "\<\"  \"\>", 
   "\[InvisibleSpace]", "\<\"the effective Lagrangian of the pair fields \
gives the mass of the amplitude mode M^2 = V'' phi_0^2 / (4 chi^{33}) in both \
versions: second version chi^{33} = phi0^2*zz, M^2 = V''/(4 Z); first version \
chi^{33} = (phi0^2*zz)/2, M^2 = V''/(2 Z) (symbolic)\"\>", 
   "\[InvisibleSpace]", "\<\" [\"\>", 
   "\[InvisibleSpace]", "\<\"identities\"\>", 
   "\[InvisibleSpace]", "\<\"]   [the same check: Rust \"\>", 
   "\[InvisibleSpace]", "\<\"none (the column M_EFT)\"\>", 
   "\[InvisibleSpace]", "\<\", Python \"\>", 
   "\[InvisibleSpace]", "\<\"YH-5\"\>", "\[InvisibleSpace]", "\<\"]\"\>"}],
  SequenceForm[
  "PASS ", "WH-2", "  ", 
   "the effective Lagrangian of the pair fields gives the mass of the \
amplitude mode M^2 = V'' phi_0^2 / (4 chi^{33}) in both versions: second \
version chi^{33} = phi0^2*zz, M^2 = V''/(4 Z); first version chi^{33} = \
(phi0^2*zz)/2, M^2 = V''/(2 Z) (symbolic)", " [", "identities", 
   "]   [the same check: Rust ", "none (the column M_EFT)", ", Python ", 
   "YH-5", "]"],
  Editable->False]], "Print",
 CellChangeTimes->{4.004330940273562*^9},
