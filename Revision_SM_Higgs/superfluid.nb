Cell[CellGroupData[{

Cell["II.2 The three methods and their numerical engine", "Section",ExpressionUUID->"d802b366-eca9-4db9-9f09-b6aa2fda34d8"],

Cell[TextData[{
 "All three methods approximate the state of the spinor field by a uniform \
quasi-free state: at every momentum ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox[
     StyleBox["q", "TI"], "\[RightVector]"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d15137cd-bfb4-4942-a504-53a41e05e74b"],
 " the correlation matrices ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["C",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["n",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["q", "TI"], "\[RightVector]"], 
      StyleBox["LL",
       FontSlant->"Plain"]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5d5ce242-1cb8-4fde-92a2-04fc3d6d6cc2"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["C",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["q", "TI"], "\[RightVector]"], 
      StyleBox["LL",
       FontSlant->"Plain"]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5a8ab12a-b802-4bce-ae4a-81e1fa6fa7c4"],
 ", and their integrals over the momenta measured from the normal vacuum,"
}], "Text",ExpressionUUID->"f8ac48cc-e1ab-4c6c-a329-c9711fa923ee"],

Cell[BoxData[
 FormBox[
  RowBox[{"\[Delta]", 
   SuperscriptBox[
    StyleBox["C",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
