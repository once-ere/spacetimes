      RowBox[{
       RowBox[{"kind", " ", "==", " ", "\"\<pair\>\""}], ",", " ", 
       RowBox[{"Transpose", "[", "a", "]"}], ",", " ", 
       RowBox[{"ConjugateTranspose", "[", "a", "]"}]}], "]"}]}], ";"}], "\n", 
   
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", "matrix", " ", "on", " ", "vec", 
      RowBox[{"(", "M", ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"row", " ", "by", " ", "row"}], ")"}], " ", "of", " ", "M"}], 
     " ", "->", " ", 
     RowBox[{
      RowBox[{"left", 
       RowBox[{"(", "A1", ")"}], " ", "M"}], " ", "+", " ", 
      RowBox[{"M", " ", "A2"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"vecOp", "[", 
      RowBox[{"kind_", ",", " ", "a1_", ",", " ", "a2_"}], "]"}], " ", ":=", 
     " ", 
     RowBox[{
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{
        RowBox[{"leftOp", "[", 
         RowBox[{"kind", ",", " ", "a1"}], "]"}], ",", " ", 
        RowBox[{"IdentityMatrix", "[", 
         RowBox[{"Length", "[", "a2", "]"}], "]"}]}], "]"}], " ", "+", "\n", 
      "  ", 
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{
        RowBox[{"IdentityMatrix", "[", 
         RowBox[{"Length", "[", "a1", "]"}], "]"}], ",", " ", 
        RowBox[{"Transpose", "[", "a2", "]"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"transpOp", "[", "n_", "]"}], " ", ":=", " ", 
