Cell[CellGroupData[{

Cell["II.5 The gauge bosons in the superfluid", "Section",ExpressionUUID->"18a42842-0dde-4542-a544-2bc6eb3496c1"],

Cell[TextData[{
 StyleBox["The masses from the susceptibilities.",
  FontWeight->"Bold"],
 " A constant gauge field ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["A", "TI"], "0", 
    StyleBox["a", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0a795066-3a76-4c2d-9638-97414cd91b8b"],
 " along the generator ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["Q",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["a", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c309632e-393a-4ecf-94fe-e5cb667a2900"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], "\[LongEqual]", "1", ",", "2", ",", "3"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "03c5fedd-08be-4966-94e0-bdc00ec5dff6"],
 ": ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ee637e81-2dc6-459a-95f6-0688f23ccba0"],
 "; ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], "\[LongEqual]", "4"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6c9b22d6-219c-4052-9aa2-d38499ec4f41"],
 ": the fermion number ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["1",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "8"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b3cfb880-2ae6-4f00-bea1-ff3415a7e89b"],
 ") enters like a chemical potential ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Mu]", 
    StyleBox["a", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "eb6e72ce-c76c-4033-9353-a391783fb3b5"],
 " of that charge. The static susceptibility ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Chi]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["ab", "TI"]], "\[LongEqual]", "\[PartialD]", 
    RowBox[{"\[LeftAngleBracket]", 
     SubscriptBox[
      StyleBox["Q",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["a", "TI"]], "\[RightAngleBracket]"}], "/", "\[PartialD]", 
    SuperscriptBox["\[Mu]", 
     StyleBox["b", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9e4234dc-5d2c-4eef-99fb-dfac7540553d"],
 " of the superfluid gives the mass matrix of the gauge bosons, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"(", 
      SuperscriptBox[
       StyleBox["M", "TI"], "2"], ")"}], 
     StyleBox["ab", "TI"]], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["a", "TI"]], 
    SubscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["b", "TI"]], 
    SubsuperscriptBox["\[Chi]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["ab", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6a3a3035-be5a-44d5-a829-d4df0ef4c7c7"],
 " (the Higgs mechanism of the condensate), with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["a", "TI"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b02f311b-5e26-44c4-bea8-a756434bb71f"],
 " for the three ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "36ab4eee-7c5b-4af9-b879-3559a438b73b"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["F",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1e5248f9-8fdd-46fd-8cf8-42a48dcca0b7"],
 " for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a31900b2-4c21-4b14-bfab-00d88dc049bd"],
 ". The next cell computes ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Chi]", 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["ab", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4cf0a061-da2a-4b21-b9af-e192f6ab7055"],
 " by central differences of the self-consistent states with the external \
self-energies ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[MinusPlus]", 
     StyleBox["h", "TI"]}], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["Q",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["b", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "941e9a1f-a4e6-4aa8-911b-f593b8cfd266"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["h", "TI"], "\[LongEqual]", "2", "\[Times]", 
    SuperscriptBox["10", 
     RowBox[{"-", "3"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "be8444e7-9d5f-42d3-b1ee-17d24a026ea6"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    StyleBox["h", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8f80a5c2-67a0-4f9a-bc3f-34e6e40de9d3"],
 ", and the Richardson extrapolation. The generator ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9a13ba4f-87fc-4fea-8d70-a087a3206907"],
 " leaves the condensate in the channel ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "538225ca-7159-4410-8740-fdc809d3ddaf"],
 " unchanged, so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Chi]", 
     StyleBox["SF",
      FontSlant->"Plain"], "33"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e1ab69b0-f1e3-43a0-a2de-44101e02abc1"],
 ": ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "182832f4-b985-487a-ae37-16e43eca6b1e"],
 " stays massless (the zeugon), and there is no mixing."
}], "Text",ExpressionUUID->"071f93d7-7697-42cc-a8e3-67435c37a9d9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", "four", " ", 
     RowBox[{"charges", ":", " ", 
      RowBox[{"T", "^", "1"}]}]}], ",", " ", 
    RowBox[{"T", "^", "2"}], ",", " ", 
    RowBox[{
     RowBox[{"T", "^", "3"}], " ", 
     RowBox[{"(", 
      RowBox[{"1", "_", "4", " ", 
       RowBox[{"(", "x", ")"}], " ", 
       RowBox[{"tau", "/", "2"}]}], ")"}], " ", "and", " ", "the", " ", 
     "fermion", " ", "number", " ", "1", "_", "8"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"chargesSF", " ", "=", " ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"N", "[", 
          RowBox[{"i8", "[", 
           RowBox[{
            RowBox[{"sig", "[", 
             RowBox[{"[", 
              RowBox[{"k", " ", "+", " ", "1"}], "]"}], "]"}], "/", "2"}], 
           "]"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"{", "id8", "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"susceptibilitySF", "[", 
      RowBox[{"mo", ",", " ", "s"}], "]"}], ":", " ", 
     RowBox[{
     "the", " ", "4", " ", "x", " ", "4", " ", "static", " ", 
      "susceptibilities", " ", "by", " ", "central", " ", "differences", " ", 
      "and", " ", "Richardson"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"susceptibilitySF", "[", 
      RowBox[{"mo_", ",", " ", "s_", ",", " ", 
       RowBox[{"h_", " ", ":", " ", 
        RowBox[{"2.", " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "3"}]}]}]}]}], "]"}], " ", ":=", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", "dn", "}"}], ",", "\n", "     ", 
          RowBox[{
           RowBox[{"dn", " ", "=", " ", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"Module", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"r", " ", "=", " ", 
                  RowBox[{"Table", "[", 
                   RowBox[{
                    RowBox[{"Module", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"ext", " ", "=", " ", 
                    RowBox[{
                    RowBox[{"-", "sg"}], " ", "step", " ", 
                    RowBox[{"chargesSF", "[", 
                    RowBox[{"[", "bb", "]"}], "]"}]}]}], "}"}], ",", "\n", 
                    "            ", 
                    RowBox[{
                    RowBox[{"solveSF", "[", 
                    RowBox[{"mo", ",", " ", 
                    RowBox[{
                    RowBox[{"s", "[", "\"\<n\>\"", "]"}], " ", "+", " ", 
                    "ext"}], ",", " ", 
                    RowBox[{"s", "[", "\"\<p\>\"", "]"}], ",", " ", "0.6", ",",
                     " ", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", "14"}]}], ",", " ", "40000", ",", " ", 
                    "ext"}], "]"}], "[", "\"\<rho\>\"", "]"}]}], "]"}], ",", 
                    " ", 
                    RowBox[{"{", 
                    RowBox[{"sg", ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"1", ",", " ", 
                    RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], "]"}]}], "}"}], ",",
                 "\n", "        ", 
                RowBox[{"Table", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Re", "[", 
                    RowBox[{
                    RowBox[{"Tr", "[", 
                    RowBox[{
                    RowBox[{"chargesSF", "[", 
                    RowBox[{"[", "a", "]"}], "]"}], " ", ".", " ", 
                    RowBox[{"r", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "]"}], " ", "-", " ", 
                    RowBox[{"Tr", "[", 
                    RowBox[{
                    RowBox[{"chargesSF", "[", 
                    RowBox[{"[", "a", "]"}], "]"}], " ", ".", " ", 
                    RowBox[{"r", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], "]"}], "/", 
                   RowBox[{"(", 
                    RowBox[{"2", " ", "step"}], ")"}]}], ",", " ", 
                  RowBox[{"{", 
                   RowBox[{"a", ",", " ", "4"}], "}"}]}], "]"}]}], "]"}], ",",
               " ", 
              RowBox[{"{", 
               RowBox[{"step", ",", " ", 
                RowBox[{"{", 
                 RowBox[{"h", ",", " ", 
                  RowBox[{"2", " ", "h"}]}], "}"}]}], "}"}]}], "]"}]}], ";", 
           "\n", "     ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"4", " ", 
               RowBox[{"dn", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], " ", "-", " ", 
              RowBox[{"dn", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "/", "3"}]}]}], "]"}],
         ",", " ", 
        RowBox[{"{", 
         RowBox[{"bb", ",", " ", "4"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
   
   RowBox[{
    RowBox[{"chiRows", " ", "=", " ", 
     RowBox[{"{", "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"key", " ", "=", " ", 
           RowBox[{"shortName", "[", "m", "]"}]}], ",", " ", "mo", ",", " ", 
          "s", ",", " ", "chi", ",", " ", "off"}], "}"}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"mo", ",", " ", "s"}], "}"}], " ", "=", " ", 
          RowBox[{"groundSF", "[", 
           RowBox[{"\"\<V2_\>\"", " ", "<>", " ", "key"}], "]"}]}], ";", "\n",
          "   ", 
         RowBox[{"chi", " ", "=", " ", 
          RowBox[{"susceptibilitySF", "[", 
           RowBox[{"mo", ",", " ", "s"}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"off", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{"chi", " ", "-", " ", 
             RowBox[{"DiagonalMatrix", "[", 
              RowBox[{"Diagonal", "[", "chi", "]"}], "]"}]}], "]"}], "]"}]}], 
         ";", "\n", "   ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{"\"\<WP2-8a \>\"", " ", "<>", " ", "key"}], ",", " ", 
           RowBox[{
           "key", " ", "<>", " ", "\"\<: chi_11 = \>\"", " ", "<>", " ", 
            RowBox[{"ToString", "[", 
             RowBox[{"NumberForm", "[", 
              RowBox[{
               RowBox[{"chi", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], ",", " ", "10"}],
               "]"}], "]"}], " ", "<>", " ", "\"\<, chi_FF = \>\"", " ", "<>",
             " ", 
            RowBox[{"ToString", "[", 
             RowBox[{"NumberForm", "[", 
              RowBox[{
               RowBox[{"chi", "[", 
                RowBox[{"[", 
                 RowBox[{"4", ",", " ", "4"}], "]"}], "]"}], ",", " ", "10"}],
               "]"}], "]"}], " ", "<>", " ", "\"\< = Rust; chi_33 = \>\"", 
            " ", "<>", " ", 
            RowBox[{"sci", "[", 
             RowBox[{"chi", "[", 
              RowBox[{"[", 
               RowBox[{"3", ",", " ", "3"}], "]"}], "]"}], "]"}], " ", "<>", 
            " ", "\"\< (massless zeugon), no mixing\>\""}], ",", "\n", "    ", 
           RowBox[{"Max", "[", 
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{"chi", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], " ", "-", " ", 
               RowBox[{"rustPart2", "[", 
                RowBox[{"\"\<p2_chi11_\>\"", " ", "<>", " ", "key"}], "]"}]}],
               "]"}], ",", " ", 
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{"chi", "[", 
                RowBox[{"[", 
                 RowBox[{"4", ",", " ", "4"}], "]"}], "]"}], " ", "-", " ", 
               RowBox[{"rustPart2", "[", 
                RowBox[{"\"\<p2_chiFF_\>\"", " ", "<>", " ", "key"}], "]"}]}],
               "]"}], ",", " ", 
             RowBox[{"Abs", "[", 
              RowBox[{"chi", "[", 
               RowBox[{"[", 
                RowBox[{"3", ",", " ", "3"}], "]"}], "]"}], "]"}], ",", " ", 
             "off"}], "]"}], ",", " ", 
           RowBox[{"10", "^", 
            RowBox[{"-", "8"}]}], ",", "\n", "    ", 
           
           RowBox[{"\"\<P2-8a \>\"", " ", "<>", " ", "key", " ", "<>", 
            " ", "\"\<, P2-8b \>\"", " ", "<>", " ", "key"}], ",", " ", 
           RowBox[{"\"\<YP2-8a \>\"", " ", "<>", " ", "key"}]}], "]"}], ";", 
         "\n", "   ", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"chiRows", ",", " ", 
           RowBox[{"{", 
            RowBox[{"key", ",", " ", 
             RowBox[{"chi", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
             RowBox[{"chi", "[", 
              RowBox[{"[", 
               RowBox[{"3", ",", " ", "3"}], "]"}], "]"}], ",", " ", 
             RowBox[{"chi", "[", 
              RowBox[{"[", 
               RowBox[{"4", ",", " ", "4"}], "]"}], "]"}], ",", " ", 
             RowBox[{"gvLL", " ", 
              RowBox[{"Sqrt", "[", 
               RowBox[{"chi", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], "]"}]}], ",", 
             " ", 
             RowBox[{"gfLL", " ", 
              RowBox[{"Sqrt", "[", 
               RowBox[{"chi", "[", 
                RowBox[{"[", 
                 RowBox[{"4", ",", " ", "4"}], "]"}], "]"}], "]"}]}]}], 
            "}"}]}], "]"}]}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"m", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\"\<HS\>\"", ",", " ", "1.", ",", " ", "1."}], "}"}], ",",
           " ", 
          RowBox[{"{", "\"\<KS\>\"", "}"}], ",", " ", 
          RowBox[{"{", "\"\<CJT\>\"", "}"}]}], "}"}]}], "}"}]}], "]"}], ";"}],
    "\n", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
            RowBox[{"NumberForm", "[", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", " ", "8"}], "]"}], ",", 
            " ", 
            RowBox[{"sci", "[", 
             RowBox[{"#", "[", 
              RowBox[{"[", "3", "]"}], "]"}], "]"}], ",", " ", 
