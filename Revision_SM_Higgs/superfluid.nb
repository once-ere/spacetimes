       RowBox[{"mhOverV", " ", "-", " ", 
        RowBox[{
         RowBox[{"12513", "/", "100"}], "/", "vGeV"}]}], "]"}], " ", "<", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "12"}]}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "rows", " ", "of", " ", "the", " ", "methods", " ", 
      "without", " ", "a", " ", "computation", " ", "of", " ", "the", " ", 
      "linear", " ", "response", " ", "carry", " ", "NaN", " ", "in", " ", 
      "its", " ", "columns"}], ";", " ", 
     RowBox[{
     "the", " ", "CSV", " ", "import", "\n", "   ", "turns", " ", "the", " ", 
      "field", " ", "NaN", " ", "into", " ", 
      RowBox[{"Missing", "[", "\"\<NotAvailable\>\"", "]"}]}]}], " ", "*)"}], 
   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"noRpa", "[", "r_", "]"}], " ", ":=", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", " ", "=", " ", 
         RowBox[{"r", "[", 
          RowBox[{"[", 
           RowBox[{"col", "[", 
            RowBox[{"shdr", ",", " ", "\"\<M_H_RPA\>\""}], "]"}], "]"}], 
          "]"}]}], "}"}], ",", " ", 
       RowBox[{
        RowBox[{"MissingQ", "[", "x", "]"}], " ", "||", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"StringQ", "[", "x", "]"}], " ", "&&", " ", 
          RowBox[{"StringContainsQ", "[", 
           RowBox[{"x", ",", " ", "\"\<NaN\>\""}], "]"}]}], ")"}]}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dev4", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"vsh", " ", "=", " ", 
             RowBox[{"num", "[", 
              RowBox[{"r", "[", 
               RowBox[{"[", 
                RowBox[{"col", "[", 
                 RowBox[{"shdr", ",", " ", "\"\<v_SH\>\""}], "]"}], "]"}], 
               "]"}], "]"}]}], ",", " ", 
            RowBox[{"lam", " ", "=", " ", 
             RowBox[{"num", "[", 
              RowBox[{"r", "[", 
               RowBox[{"[", 
                RowBox[{"col", "[", 
                 RowBox[{"shdr", ",", " ", "\"\<Lambda_GeV\>\""}], "]"}], 
                "]"}], "]"}], "]"}]}], ",", " ", 
            RowBox[{"mr", " ", "=", " ", 
             RowBox[{"r", "[", 
              RowBox[{"[", 
               RowBox[{"col", "[", 
                RowBox[{"shdr", ",", " ", "\"\<M_H_RPA\>\""}], "]"}], "]"}], 
              "]"}]}], ",", "\n", "      ", 
            RowBox[{"mrg", " ", "=", " ", 
             RowBox[{"r", "[", 
              RowBox[{"[", 
               RowBox[{"col", "[", 
                RowBox[{"shdr", ",", " ", "\"\<M_H_RPA_GeV\>\""}], "]"}], 
               "]"}], "]"}]}], ",", " ", 
            RowBox[{"mrv", " ", "=", " ", 
             RowBox[{"r", "[", 
              RowBox[{"[", 
               RowBox[{"col", "[", 
                RowBox[{"shdr", ",", " ", "\"\<M_H_RPA_over_v_SH\>\""}], 
                "]"}], "]"}], "]"}]}]}], "}"}], ",", "\n", "     ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"noRpa", "[", "r", "]"}], ",", " ", 
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"lam", " ", "-", " ", 
               RowBox[{"vGeV", "/", "vsh"}]}], "]"}], "/", "lam"}], ",", "\n",
             "      ", 
            RowBox[{"Max", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{"lam", " ", "-", " ", 
                 RowBox[{"vGeV", "/", "vsh"}]}], "]"}], "/", "lam"}], ",", 
              " ", 
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{
                 RowBox[{"num", "[", "mrg", "]"}], " ", "-", " ", 
                 RowBox[{
                  RowBox[{"num", "[", "mr", "]"}], " ", "lam"}]}], "]"}], "/", 
               RowBox[{"num", "[", "mrg", "]"}]}], ",", " ", 
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{
                 RowBox[{"num", "[", "mrv", "]"}], " ", "-", " ", 
                 RowBox[{
                  RowBox[{"num", "[", "mr", "]"}], "/", "vsh"}]}], "]"}], "/", 
               RowBox[{"num", "[", "mrv", "]"}]}]}], "]"}]}], "]"}]}], "]"}], 
        ",", " ", 
        RowBox[{"{", 
         RowBox[{"r", ",", " ", "srows"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ratios", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"num", "[", 
        RowBox[{"r", "[", 
         RowBox[{"[", 
          RowBox[{"col", "[", 
           RowBox[{"shdr", ",", " ", "\"\<M_H_RPA_over_v_SH\>\""}], "]"}], 
          "]"}], "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", 
         RowBox[{"Select", "[", 
          RowBox[{"srows", ",", " ", 
           RowBox[{
            RowBox[{"!", " ", 
             RowBox[{"noRpa", "[", "#", "]"}]}], " ", "&"}]}], "]"}]}], 
        "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rvCheck", "[", 
     RowBox[{"\"\<WH-4\>\"", ",", " ", 
      RowBox[{"\"\<m_H / v = 125.13 / v = \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"NumberForm", "[", 
         RowBox[{
          RowBox[{"N", "[", 
           RowBox[{"mhOverV", ",", " ", "10"}], "]"}], ",", " ", "10"}], 
         "]"}], "]"}], " ", "<>", 
       " ", "\"\< (the inputs of stage 2); for every \\\nrow of the masses, \
Lambda_LL = v / v_SH, M_H = omega_H Lambda_LL and M_H / v = omega_H / v_SH \
(relative); the amplitude modes of \\\nthe linear response give M_H / v from \
\>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"NumberForm", "[", 
         RowBox[{
          RowBox[{"Min", "[", "ratios", "]"}], ",", " ", "6"}], "]"}], "]"}], 
       " ", "<>", " ", "\"\< to \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"NumberForm", "[", 
         RowBox[{
          RowBox[{"Max", "[", "ratios", "]"}], ",", " ", "6"}], "]"}], "]"}], 
       " ", "<>", "\n", "  ", "\"\<, \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"NumberForm", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Min", "[", "ratios", "]"}], "/", "mhOverV"}], ",", " ", 
          "4"}], "]"}], "]"}], " ", "<>", " ", "\"\< to \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"NumberForm", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Max", "[", "ratios", "]"}], "/", "mhOverV"}], ",", " ", 
          "4"}], "]"}], "]"}], " ", "<>", "\n", 
       "  ", "\"\< times the value of the Standard Model\>\""}], ",", " ", 
      RowBox[{"okSM", " ", "&&", " ", 
       RowBox[{"dev4", " ", "<", " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "9"}]}]}]}], ",", " ", 
      RowBox[{"\"\<deviation \>\"", " ", "<>", " ", 
       RowBox[{"sci", "[", "dev4", "]"}]}]}], "]"}], ";"}]}]}]], "Input",
 CellLabel->
  "In[679]:=",ExpressionUUID->"28414e6e-c5d2-450a-ac87-42e0711648e0"],

