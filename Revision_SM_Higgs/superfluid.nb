Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"PASS \"\>", "\[InvisibleSpace]", "\<\"WP3-G6 HS_0_1\"\>", 
   "\[InvisibleSpace]", "\<\"  deviation \"\>", 
