Cell[CellGroupData[{

Cell["I.5 The Lagrangian and the field equations (item 4)", "Section",ExpressionUUID->"8c2341c4-e473-4f34-a9e3-4ff541d85901"],

Cell[TextData[{
 "The Lagrangian density of the solution is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["\[ScriptCapitalL]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalL]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], "\[CapitalPsi]"], "+", 
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalL]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["self",
      FontSlant->"Plain"]], "+", 
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalL]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["YM",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "85313014-500c-45e1-b652-ed86549767df"],
 ", with the Dirac part ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalL]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], "\[CapitalPsi]"], "\[LongEqual]", 
    SubscriptBox[
     OverscriptBox["\[CapitalPsi]", "_"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["i", "TI"], "\[ThinSpace]", 
      UnderscriptBox["\[Sum]", 
       StyleBox["p", "TI"],
       LimitsPositioning->True], "\[ThinSpace]", 
      SubsuperscriptBox["\[Gamma]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["p", "TI"]], 
      SubsuperscriptBox["\[Del]", 
       StyleBox["p", "TI"], 
       StyleBox["GEE",
        FontSlant->"Plain"]], "-", 
      SubscriptBox[
       StyleBox["m", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}], 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1a5097ad-5fc1-4230-bd63-d98e693a5fb6"],
 ", the Yang-Mills part ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalL]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["YM",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"-", 
     FractionBox["1", "4"]}], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", "\[Iota]",
     LimitsPositioning->True], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["W", "TI"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}], "\[Iota]"], 
    SubsuperscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{"\[Iota]", ",", 
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], "-", 
    FractionBox["1", "4"], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["B", "TI"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], 
    SubsuperscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "002528a5-62c3-46cd-abf2-f79bbf55c5ca"],
 ", and the self-interaction ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalL]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["self",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"-", 
     SubsuperscriptBox[
      StyleBox["V", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       StyleBox["n", "TI"], ")"}]]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "eeecb54b-8431-4ab1-9cc8-ac1a062d672c"],
 ", a normal-ordered GEE-invariant contact interaction. Its first two steps \
are"
}], "Text",ExpressionUUID->"dbe0014c-fe23-47a2-b020-1a46a3d8fa2b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "0", ")"}]], "\[LongEqual]", 
   FractionBox["1", "2"], 
   SubsuperscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["S",
     FontSlant->"Plain"]], ":", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       OverscriptBox["\[CapitalPsi]", "_"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      SubscriptBox["\[CapitalPsi]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}], "2"], ":", 
   RowBox[{"+", 
    FractionBox["1", "2"]}], 
   SubsuperscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["V",
     FontSlant->"Plain"]], "\[ThinSpace]", 
   UnderscriptBox["\[Sum]", 
    StyleBox["p", "TI"],
    LimitsPositioning->True], "\[ThinSpace]", 
   SubsuperscriptBox["\[Eta]", 
    StyleBox["pp", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], ":", 
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["j", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["F",
        FontSlant->"Plain"], ",", 
       StyleBox["p", "TI"]}]], ")"}], "2"], ":", ",", "      ", 
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "1", ")"}]], "\[LongEqual]", 
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "0", ")"}]], "-", 
   FractionBox["1", "4"], 
   SubscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], "\[ThinSpace]", 
   UnderscriptBox["\[Sum]", "\[Iota]",
    LimitsPositioning->True], ":", 
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox["\[CapitalPi]", 
      StyleBox["LL",
       FontSlant->"Plain"], "\[Iota]"], ")"}], "\[Dagger]"], 
   SubsuperscriptBox["\[CapitalPi]", 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Iota]"], ":", ","}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"90efdf6f-c761-42a1-a563-8a34b9db5950"],

Cell[TextData[{
 "with the fermion-number current ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["j", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["F",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}]], "\[LongEqual]", 
    SubscriptBox[
     OverscriptBox["\[CapitalPsi]", "_"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p", "TI"]], 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e1fdcf87-a7bd-4cb1-aa4d-4f277e96d659"],
 " and the pair operators ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalPi]", 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Iota]"], "\[LongEqual]", 
    SubsuperscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["T", "TI"]], 
    SubsuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Iota]"], 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "465e8350-e19b-4874-b713-88746d7390c8"],
 " of one point. ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "0", ")"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ae911723-cbc9-4928-9418-8530ea4605df"],
 " is formed after the author's Kohn-Sham ansatz, whose interaction energy \
density of uniform matter is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], 
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["V", "TI"]], 
    SuperscriptBox[
     StyleBox["n", "TI"], "2"], "+", 
    FractionBox["1", "2"], 
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["S", "TI"]], 
    SubsuperscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["S", "TI"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6f64d986-0ac4-4f83-a567-f4bdfb5ca1cf"],
 "; ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "1", ")"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f4da6c03-3da7-4935-84b9-ed8f707b7a11"],
 " adds the attraction in the spin-zero pair channel. Varying the action with \
respect to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox["\[CapitalPsi]", "_"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9269535b-4092-448d-a7ae-8e4b6f17d382"],
 " gives the field equation of the spinor field,"
}], "Text",ExpressionUUID->"36e1e6a5-ea1b-4a86-8d40-516614f0aae4"],

Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox["i", "TI"], "\[ThinSpace]", 
   UnderscriptBox["\[Sum]", 
    StyleBox["p", "TI"],
    LimitsPositioning->True], "\[ThinSpace]", 
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p", "TI"]], 
   SubsuperscriptBox["\[Del]", 
    StyleBox["p", "TI"], 
    StyleBox["GEE",
     FontSlant->"Plain"]], 
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], "-", 
   SubscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], "\[LongEqual]", 
   SubsuperscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["S",
     FontSlant->"Plain"]], 
   RowBox[{"(", 
    RowBox[{
     SubscriptBox[
      OverscriptBox["\[CapitalPsi]", "_"], 
      StyleBox["LL",
       FontSlant->"Plain"]], 
     SubscriptBox["\[CapitalPsi]", 
      StyleBox["LL",
       FontSlant->"Plain"]]}], ")"}], 
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], "+", 
   SubsuperscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["V",
     FontSlant->"Plain"]], "\[ThinSpace]", 
   UnderscriptBox["\[Sum]", 
    StyleBox["p", "TI"],
    LimitsPositioning->True], "\[ThinSpace]", 
   SubsuperscriptBox[
    StyleBox["j", "TI"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}], 
    StyleBox["F",
     FontSlant->"Plain"]], 
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p", "TI"]], 
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], "-", 
   FractionBox["1", "2"], 
   SubscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], "\[ThinSpace]", 
   UnderscriptBox["\[Sum]", "\[Iota]",
    LimitsPositioning->True], "\[ThinSpace]", 
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], "0"], 
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], "\[Iota]"], ")"}], "\[Dagger]"], 
   SubsuperscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"], "*"], "\[ThinSpace]", 
   SubsuperscriptBox["\[CapitalPi]", 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Iota]"], ","}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"cbe823f5-2c42-40c2-9847-893559a2f743"],

Cell[TextData[{
 "and varying with respect to the gauge fields gives the Yang-Mills equations \
with the currents of the spinor field as sources, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["p", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubscriptBox["\[PartialD]", 
     StyleBox["p", "TI"]], 
    SubsuperscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{"\[Iota]", ",", 
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], "-", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      SuperscriptBox["\[Iota]", "\[Prime]"], 
      SuperscriptBox["\[Iota]", "\[Prime]\[Prime]"]}],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox["\[Epsilon]", 
     RowBox[{"\[Iota]", 
      SuperscriptBox["\[Iota]", "\[Prime]"], 
      SuperscriptBox["\[Iota]", "\[Prime]\[Prime]"]}], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", 
     StyleBox["p", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["W", "TI"], 
     RowBox[{
      StyleBox["SF",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], 
     SuperscriptBox["\[Iota]", "\[Prime]"]], 
    SubsuperscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      SuperscriptBox["\[Iota]", "\[Prime]\[Prime]"], ",", 
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["j", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{"\[Iota]", ",", 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "34713d10-a1d3-423a-8b55-352c778a1321"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["p", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubscriptBox["\[PartialD]", 
     StyleBox["p", "TI"]], 
    SubsuperscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["j", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["F",
       FontSlant->"Plain"], ",", 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "329208f1-1f1c-4a73-82c8-2df03e2f55d4"],
 "."
}], "Text",ExpressionUUID->"2271f1bf-53a7-4805-9008-e981ef4d34bd"],

Cell[TextData[{
 "The right side of the field equation of the spinor field is the commutator \
of the field with the Hamiltonian of the contact terms. The next cell checks \
this exactly, as an identity of operators on the Fock space of the eight \
components of one point (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["2", "8"], "\[LongEqual]", "256"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "297447f7-85c9-47fb-810c-cffc6be6541f"],
 " states), for each contact term: with the Hamiltonians ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["S",
      FontSlant->"Plain"]], "\[LongEqual]", 
    FractionBox["1", "2"], 
    SuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["S",
      FontSlant->"Plain"]], ":", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["\[CapitalPsi]", "\[Dagger]"], "\[Beta]", 
       "\[CapitalPsi]"}], ")"}], "2"], ":"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "eb983a41-1592-421c-8adf-bf630697fc12"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["V",
      FontSlant->"Plain"]], "\[LongEqual]", 
    FractionBox["1", "2"], 
    SuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["V",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     RowBox[{":", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["\[CapitalPsi]", "\[Dagger]"], "\[CapitalPsi]"}], 
        ")"}], "2"], ":", 
      RowBox[{"-", 
       UnderscriptBox["\[Sum]", 
        StyleBox["j", "TI"],
        LimitsPositioning->True]}], ":", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["\[CapitalPsi]", "\[Dagger]"], 
         SuperscriptBox["\[Alpha]", 
          StyleBox["j", "TI"]], "\[CapitalPsi]"}], ")"}], "2"], ":"}], 
     ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4d96453d-698d-4cc6-9865-34ebd370b800"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["P",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"-", 
     FractionBox["1", "4"]}], 
    StyleBox["G", "TI"], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", "\[Iota]",
     LimitsPositioning->True], "\[ThinSpace]", 
    SuperscriptBox["\[CapitalPi]", 
     RowBox[{"\[Iota]", "\[Dagger]"}]], 
    SuperscriptBox["\[CapitalPi]", "\[Iota]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6210cfbb-644a-47c9-9534-5252e60f45a1"],
 ", the commutators ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{
     SubscriptBox["\[CapitalPsi]", 
      StyleBox["e", "TI"]], ",", 
     StyleBox["H", "TI"]}], "]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cf9f88f0-e0b1-4fd3-b97c-c028ccffbad3"],
 " equal ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["S",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     RowBox[{
      OverscriptBox["\[CapitalPsi]", "_"], "\[CapitalPsi]"}], ")"}], 
    SubscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["\[Gamma]", "0"], "\[CapitalPsi]"}], ")"}], 
     StyleBox["e", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8a89b49f-aee3-476e-9356-3d019e724656"],
 ", the vector term, and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", "2"]}], 
    StyleBox["G", "TI"], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", "\[Iota]",
     LimitsPositioning->True], 
    SubscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        StyleBox["K",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        RowBox[{"\[Iota]", "\[Dagger]"}]], 
       SuperscriptBox["\[CapitalPsi]", "*"]}], ")"}], 
     StyleBox["e", "TI"]], 
    SuperscriptBox["\[CapitalPi]", "\[Iota]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5642878f-e04a-492c-a962-8d7763670635"],
 ". The couplings of the test are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["S",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"-", "8"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "44495958-2d72-42bb-b764-5eb5bb70693f"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["V",
      FontSlant->"Plain"]], "\[LongEqual]", "4", "/", "5"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5d763c9f-266e-4d80-aa6b-63cb44dd89f9"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["G", "TI"], "\[LongEqual]", "45", "/", "2"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c97492d4-8fe8-48ad-bf86-fad8acba1c0c"],
 ", exact numbers, so every deviation must be exactly 0. The last check of \
the cell derives the Yang-Mills equations with a source symbolically, with \
the function ",
 StyleBox["EulerEquations",
  FontFamily->"Source Code Pro"],
 " of the package ",
 StyleBox["VariationalMethods",
  FontFamily->"Source Code Pro"],
 " of the Wolfram Language, and compares all twelve equations with the form \
above."
}], "Text",ExpressionUUID->"b9f25822-b35d-4d93-89df-c0df6dc3abb4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", "annihilation", " ", "operators", " ", "c_e", " ", 
     RowBox[{"(", 
      RowBox[{"e", " ", "=", " ", 
       RowBox[{
        RowBox[{"1", ".."}], "8"}]}], ")"}], " ", "of", " ", "the", " ", 
     "eight", " ", "components", " ", "and", " ", "their", " ", "adjoints"}], 
    ",", " ", 
    RowBox[{"256", " ", "x", " ", "256", " ", "sparse", " ", "matrices"}]}], 
   " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"cOps", " ", "=", " ", 
     RowBox[{"fockOps", "[", "8", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"cdOps", " ", "=", " ", 
     RowBox[{"ConjugateTranspose", " ", "/@", " ", "cOps"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"bilinear", "[", "a", "]"}], ":", " ", 
     RowBox[{"sum_ij", " ", "a_ij", " ", 
      RowBox[{"c_i", "^", "dag"}], " ", "c_j"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"bilinear", "[", "a_", "]"}], " ", ":=", " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"a", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", " ", "j"}], "]"}], "]"}], " ", "=!=", " ", 
          "0"}], ",", " ", 
         RowBox[{
          RowBox[{"a", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", " ", "j"}], "]"}], "]"}], " ", 
          RowBox[{
           RowBox[{"cdOps", "[", 
            RowBox[{"[", "i", "]"}], "]"}], " ", ".", " ", 
           RowBox[{"cOps", "[", 
            RowBox[{"[", "j", "]"}], "]"}]}]}], ",", " ", "0"}], "]"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "8"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "8"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"quartic", "[", 
      RowBox[{"a", ",", " ", "b"}], "]"}], ":", " ", 
     RowBox[{
      RowBox[{"the", " ", "normal"}], "-", 
      RowBox[{
      "ordered", " ", "product", " ", "sum_ijkl", " ", "a_ij", " ", "b_kl", " ", 
       RowBox[{"c_i", "^", "dag"}], " ", 
       RowBox[{"c_k", "^", "dag"}], " ", "c_l", " ", "c_j"}]}]}], " ", "*)"}],
    "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"quartic", "[", 
      RowBox[{"a_", ",", " ", "b_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"a", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", " ", "j"}], "]"}], "]"}], " ", "=!=", " ", 
           "0"}], " ", "&&", " ", 
          RowBox[{
           RowBox[{"b", "[", 
            RowBox[{"[", 
             RowBox[{"k", ",", " ", "l"}], "]"}], "]"}], " ", "=!=", " ", 
           "0"}]}], ",", " ", 
         RowBox[{
          RowBox[{"a", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", " ", "j"}], "]"}], "]"}], " ", 
          RowBox[{"b", "[", 
           RowBox[{"[", 
            RowBox[{"k", ",", " ", "l"}], "]"}], "]"}], " ", 
          RowBox[{
           RowBox[{"cdOps", "[", 
            RowBox[{"[", "i", "]"}], "]"}], " ", ".", " ", 
           RowBox[{"cdOps", "[", 
            RowBox[{"[", "k", "]"}], "]"}], " ", ".", " ", 
           RowBox[{"cOps", "[", 
            RowBox[{"[", "l", "]"}], "]"}], " ", ".", " ", 
           RowBox[{"cOps", "[", 
            RowBox[{"[", "j", "]"}], "]"}]}]}], ",", " ", "0"}], "]"}], ",", 
       "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "8"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "8"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", "8"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"l", ",", " ", "8"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"gScal", ",", " ", "gVec", ",", " ", 
     RowBox[{"gPair", ":", " ", 
      RowBox[{
      "the", " ", "exact", " ", "couplings", " ", "of", " ", "the", " ", 
       "test"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"gScal", ",", " ", "gVec", ",", " ", "gPair"}], "}"}], " ", "=",
      " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "8"}], ",", " ", 
       RowBox[{"4", "/", "5"}], ",", " ", 
       RowBox[{"45", "/", "2"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"beta8", " ", "=", " ", 
     RowBox[{"d8", "[", "betaLL", "]"}]}], ";", " ", 
    RowBox[{"alpha8", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"d8", "[", 
        RowBox[{"alphaLL", "[", "j", "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"hS", " ", "=", " ", 
     RowBox[{
      RowBox[{"gScal", "/", "2"}], " ", 
      RowBox[{"quartic", "[", 
       RowBox[{"beta8", ",", " ", "beta8"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"hV", " ", "=", " ", 
     RowBox[{
      RowBox[{"gVec", "/", "2"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"quartic", "[", 
         RowBox[{
          RowBox[{"IdentityMatrix", "[", "8", "]"}], ",", " ", 
          RowBox[{"IdentityMatrix", "[", "8", "]"}]}], "]"}], " ", "-", " ", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{"quartic", "[", 
           RowBox[{
            RowBox[{"alpha8", "[", 
             RowBox[{"[", "j", "]"}], "]"}], ",", " ", 
            RowBox[{"alpha8", "[", 
             RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}], ")"}]}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", "pair", " ", "operators", " ", 
      RowBox[{"Pi", "^", "iota"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{
      "sum_ij", " ", "K_ij", " ", "c_i", " ", "c_j", " ", "and", " ", "the", " ",
        "pairing", " ", "Hamiltonian"}], " ", "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"G", "/", "4"}], ")"}], " ", "sum", " ", 
       RowBox[{"Pi", "^", "dag"}], " ", "Pi"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"piOps", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"k", " ", "=", " ", 
           RowBox[{"kLL", "[", "iota", "]"}]}], "}"}], ",", " ", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"k", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", " ", "j"}], "]"}], "]"}], " ", "=!=", " ", 
              "0"}], ",", " ", 
             RowBox[{
              RowBox[{"k", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", " ", "j"}], "]"}], "]"}], " ", 
              RowBox[{
               RowBox[{"cOps", "[", 
                RowBox[{"[", "i", "]"}], "]"}], " ", ".", " ", 
               RowBox[{"cOps", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}]}], ",", " ", "0"}], "]"}], ",",
            " ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "8"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"j", ",", " ", "8"}], "}"}]}], "]"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"iota", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"hP", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "gPair"}], "/", "4"}], " ", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ConjugateTranspose", "[", 
          RowBox[{"piOps", "[", 
           RowBox[{"[", "k", "]"}], "]"}], "]"}], " ", ".", " ", 
         RowBox[{"piOps", "[", 
          RowBox[{"[", "k", "]"}], "]"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nBeta", " ", "=", " ", 
     RowBox[{"bilinear", "[", "beta8", "]"}]}], ";", " ", 
    RowBox[{"nOne", " ", "=", " ", 
     RowBox[{"bilinear", "[", 
      RowBox[{"IdentityMatrix", "[", "8", "]"}], "]"}]}], ";", " ", 
    RowBox[{"nAlpha", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"bilinear", "[", 
        RowBox[{"alpha8", "[", 
         RowBox[{"[", "j", "]"}], "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"lin", "[", "v", "]"}], " ", "=", " ", 
     RowBox[{"sum_b", " ", "v_b", " ", "c_b"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"lin", "[", "v_", "]"}], " ", ":=", " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"v", "[", 
         RowBox[{"[", "b", "]"}], "]"}], " ", 
        RowBox[{"cOps", "[", 
         RowBox[{"[", "b", "]"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"b", ",", " ", "8"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dE2", ",", " ", "dE3", ",", " ", "dE4"}], "}"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", "\n", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"dE2", " ", "=", " ", 
        RowBox[{"Max", "[", 
         RowBox[{"dE2", ",", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{"Normal", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"cOps", "[", 
                RowBox[{"[", "e", "]"}], "]"}], " ", ".", " ", "hS"}], " ", "-",
               " ", 
              RowBox[{"hS", " ", ".", " ", 
               RowBox[{"cOps", "[", 
                RowBox[{"[", "e", "]"}], "]"}]}], " ", "-", " ", 
              RowBox[{"gScal", " ", 
               RowBox[{"nBeta", " ", ".", " ", 
                RowBox[{"lin", "[", 
                 RowBox[{"beta8", "[", 
                  RowBox[{"[", "e", "]"}], "]"}], "]"}]}]}]}], "]"}], "]"}], 
           "]"}]}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"dE3", " ", "=", " ", 
        RowBox[{"Max", "[", 
         RowBox[{"dE3", ",", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{"Normal", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"cOps", "[", 
                RowBox[{"[", "e", "]"}], "]"}], " ", ".", " ", "hV"}], " ", "-",
               " ", 
              RowBox[{"hV", " ", ".", " ", 
               RowBox[{"cOps", "[", 
                RowBox[{"[", "e", "]"}], "]"}]}], " ", "-", " ", 
              RowBox[{"gVec", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"nOne", " ", ".", " ", 
                  RowBox[{"cOps", "[", 
                   RowBox[{"[", "e", "]"}], "]"}]}], " ", "-", " ", 
                 RowBox[{"Sum", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"nAlpha", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], " ", ".", " ", 
                    RowBox[{"lin", "[", 
                    RowBox[{"alpha8", "[", 
