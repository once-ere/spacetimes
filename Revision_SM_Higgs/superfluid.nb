  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9472005b-2af0-407b-9f1c-dfff59c974a5"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["Y", "TI"]], "\[LongEqual]", 
    FractionBox["1", "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
