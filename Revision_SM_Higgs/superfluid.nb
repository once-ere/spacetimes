      RowBox[{"1", "/", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"1", " ", "+", " ", 
         RowBox[{"mm", "^", "2"}]}], "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"okJ", " ", "=", " ", 
