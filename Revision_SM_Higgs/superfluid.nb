Cell[CellGroupData[{

Cell["II.2 The three methods and their numerical engine", "Section",ExpressionUUID->"383ab328-ee23-4996-b760-2f67ab8012c5"],

Cell[TextData[{
 "All three methods approximate the state of the spinor field by a uniform \
quasi-free state: at every momentum ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox[
     StyleBox["q", "TI"], "\[RightVector]"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "00a93157-db8e-44dd-9961-de07592e6409"],
 " the correlation matrices ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["C",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["n",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["q", "TI"], "\[RightVector]"], 
      StyleBox["LL",
       FontSlant->"Plain"]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7701de5d-a360-460d-8aea-3cbb0ff14c0c"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["C",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["q", "TI"], "\[RightVector]"], 
      StyleBox["LL",
       FontSlant->"Plain"]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1252d59f-2e80-4d65-8b4d-7059085f8d2f"],
 ", and their integrals over the momenta measured from the normal vacuum,"
}], "Text",ExpressionUUID->"2e653f03-2a41-4cc2-ac3f-ace56a54f544"],

Cell[BoxData[
 FormBox[
  RowBox[{"\[Delta]", 
   SuperscriptBox[
    StyleBox["C",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["n",
     FontSlant->"Plain"]], "\[LongEqual]", "\[Integral]", 
   FractionBox[
    RowBox[{
     SuperscriptBox[
      StyleBox["d", "TI"], "3"], 
     StyleBox["q", "TI"]}], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"2", "\[Pi]"}], ")"}], "3"]], 
   RowBox[{"[", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["C",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["n",
       FontSlant->"Plain"]], 
     RowBox[{"(", 
      SubscriptBox[
       OverscriptBox[
        StyleBox["q", "TI"], "\[RightVector]"], 
       StyleBox["LL",
        FontSlant->"Plain"]], ")"}], "-", 
     SubsuperscriptBox[
      StyleBox["C",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["vac",
       FontSlant->"Plain"]], 
     RowBox[{"(", 
      SubscriptBox[
       OverscriptBox[
        StyleBox["q", "TI"], "\[RightVector]"], 
       StyleBox["LL",
        FontSlant->"Plain"]], ")"}]}], "]"}], ",", "      ", 
   SuperscriptBox[
    StyleBox["C",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["p",
     FontSlant->"Plain"]], "\[LongEqual]", "\[Integral]", 
   FractionBox[
    RowBox[{
     SuperscriptBox[
      StyleBox["d", "TI"], "3"], 
     StyleBox["q", "TI"]}], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"2", "\[Pi]"}], ")"}], "3"]], "\[ThinSpace]", 
   SubsuperscriptBox[
    StyleBox["C",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p",
     FontSlant->"Plain"]], 
   RowBox[{"(", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["q", "TI"], "\[RightVector]"], 
     StyleBox["LL",
      FontSlant->"Plain"]], ")"}], ","}], TraditionalForm]], "DisplayFormula",\

 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"b2529794-44a4-45f3-ac84-b146f483e07f"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftBracketingBar]", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["q", "TI"], "\[RightVector]"], 
      StyleBox["LL",
       FontSlant->"Plain"]], "\[RightBracketingBar]"}], "<", 
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "71e73c7f-149c-4adc-9ad1-77c7bc22c209"],
 ". The energy per volume is the kinetic part plus the contractions of the \
contact terms: a bilinear term ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Nu]", ":", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["\[CapitalPsi]", "\[Dagger]"], 
       SubscriptBox[
        StyleBox["X",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["SF",
         FontSlant->"Plain"]], "\[CapitalPsi]"}], ")"}], "2"], ":"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "634aa582-b80e-4450-8467-b64d9f89e21c"],
 " gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Nu]", 
    RowBox[{"[", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["w", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["H",
        FontSlant->"Plain"]], "\[ThinSpace]", 
      StyleBox["tr",
       FontSlant->"Plain"], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         StyleBox["X",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], "\[Delta]", 
         SuperscriptBox[
          StyleBox["C",
           FontFamily->"Helvetica",
           FontSlant->"Plain"], 
          StyleBox["n",
           FontSlant->"Plain"]]}], ")"}], "2"], "-", 
      SubsuperscriptBox[
       StyleBox["w", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["F",
        FontSlant->"Plain"]], "\[ThinSpace]", 
      StyleBox["tr",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       RowBox[{
        StyleBox["X",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        OverscriptBox[
         StyleBox["C",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], "~"], 
        StyleBox["X",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        OverscriptBox[
         StyleBox["C",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], "~"]}], ")"}], "-", 
      SubsuperscriptBox[
       StyleBox["w", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["P",
        FontSlant->"Plain"]], "\[ThinSpace]", 
      StyleBox["tr",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          SuperscriptBox[
           StyleBox["C",
            FontFamily->"Helvetica",
            FontSlant->"Plain"], 
           StyleBox["p",
            FontSlant->"Plain"]], ")"}], "*"], 
        StyleBox["X",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        SuperscriptBox[
         StyleBox["C",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], 
         StyleBox["p",
          FontSlant->"Plain"]], 
        SuperscriptBox[
         StyleBox["X",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], 
         StyleBox["T", "TI"]]}], ")"}]}], "]"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cf26a41c-d135-46f1-9680-855ea6a65dfd"],
 ", and a pairing term ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", "4"]}], 
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], ":", 
    SuperscriptBox[
     RowBox[{"(", 
      SuperscriptBox["\[CapitalPi]", "\[Iota]"], ")"}], "\[Dagger]"], 
    SuperscriptBox["\[CapitalPi]", "\[Iota]"], ":"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "aa74384f-a3d1-4e30-863f-fa01f27c783e"],
 " gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", "4"]}], 
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"[", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["w", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["P",
        FontSlant->"Plain"]], 
      SuperscriptBox[
       RowBox[{"\[LeftBracketingBar]", 
        RowBox[{
         StyleBox["tr",
          FontSlant->"Plain"], 
         RowBox[{"(", 
          RowBox[{
           SubsuperscriptBox[
            StyleBox["K",
             FontFamily->"Helvetica",
             FontSlant->"Plain"], 
            StyleBox["LL",
             FontSlant->"Plain"], "\[Iota]"], 
           SuperscriptBox[
            RowBox[{"(", 
             SuperscriptBox[
              StyleBox["C",
               FontFamily->"Helvetica",
               FontSlant->"Plain"], 
              StyleBox["p",
               FontSlant->"Plain"]], ")"}], 
            StyleBox["T", "TI"]]}], ")"}]}], "\[RightBracketingBar]"}], "2"], 
      "+", "2", 
      SubsuperscriptBox[
       StyleBox["w", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["F",
        FontSlant->"Plain"]], "\[ThinSpace]", 
      StyleBox["tr",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          SubsuperscriptBox[
           StyleBox["K",
            FontFamily->"Helvetica",
            FontSlant->"Plain"], 
           StyleBox["LL",
            FontSlant->"Plain"], "\[Iota]"], ")"}], "\[Dagger]"], 
        SuperscriptBox[
         OverscriptBox[
          StyleBox["C",
           FontFamily->"Helvetica",
           FontSlant->"Plain"], "~"], 
         StyleBox["T", "TI"]], 
        SubsuperscriptBox[
         StyleBox["K",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], 
         StyleBox["LL",
          FontSlant->"Plain"], "\[Iota]"], 
        OverscriptBox[
         StyleBox["C",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], "~"]}], ")"}]}], "]"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "540c79e3-b1ba-49c7-935c-ec7033e1b24a"],
 ", where the weights ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["w", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["H",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f6ab6484-d95c-4385-af79-7ce4dd9e84f2"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["w", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["F",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a9b0e98c-83ab-4611-b61a-9f701cecc74d"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["w", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["P",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f46ef074-8bf5-45f8-a3d9-ff1e1300c895"],
 " of the direct (Hartree), exchange (Fock) and pair (Bogoliubov) \
contractions define the method, and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     StyleBox["C",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "~"], "\[LongEqual]", "\[Delta]", 
    SuperscriptBox[
     StyleBox["C",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["n",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b436e58f-4f63-4963-aca1-d7d605af695f"],
 " except in KS, where it is the projection ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalP]",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["KS",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     RowBox[{"\[Delta]", 
      SuperscriptBox[
       StyleBox["C",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["n",
        FontSlant->"Plain"]]}], ")"}], "\[LongEqual]", 
    FractionBox["1", "8"], 
    StyleBox["tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{"\[Delta]", 
      SuperscriptBox[
       StyleBox["C",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["n",
        FontSlant->"Plain"]]}], ")"}], 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "8"], "+", 
    FractionBox["1", "8"], 
    StyleBox["tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[Beta]", 
         StyleBox["LL",
          FontSlant->"Plain"]], "\[CircleTimes]", 
        SubscriptBox[
         StyleBox["1",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], "2"]}], ")"}], "\[Delta]", 
      SuperscriptBox[
       StyleBox["C",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["n",
        FontSlant->"Plain"]]}], ")"}], 
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[CircleTimes]", 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "974391f1-42c1-4dba-9245-b2e33b864fbc"],
 " onto the two Kohn-Sham densities. ",
 StyleBox["HS",
  FontWeight->"Bold"],
 " decouples the shares ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["s", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["HS",
      FontSlant->"Plain"], ",", 
     StyleBox["S",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "457ea847-2ef7-4bd6-8ff2-8c5ed11a37a9"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["s", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["HS",
      FontSlant->"Plain"], ",", 
     StyleBox["V",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "43cbed8d-262b-470d-9672-1f54ebbddbec"],
 " of the scalar and the vector term in the density channels and the rest in \
the pair channels: weights ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["s", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["HS",
        FontSlant->"Plain"], ",", 
       StyleBox["S",
        FontSlant->"Plain"]}]], ",", "0", ",", "1", "-", 
     SubsuperscriptBox[
      StyleBox["s", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["HS",
        FontSlant->"Plain"], ",", 
       StyleBox["S",
        FontSlant->"Plain"]}]]}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7dc8fdff-d401-49fd-8d4c-97e12eaa86a1"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["s", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["HS",
        FontSlant->"Plain"], ",", 
       StyleBox["V",
        FontSlant->"Plain"]}]], ",", "0", ",", "1", "-", 
     SubsuperscriptBox[
      StyleBox["s", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["HS",
        FontSlant->"Plain"], ",", 
       StyleBox["V",
        FontSlant->"Plain"]}]]}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "624fd705-084e-4d73-847a-8f95651520fd"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "0", ",", "1"}], ")"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f996270a-6a9f-4b82-94a4-bee2d13a9a41"],
 " for the pairing term; three parameter sets are computed, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"1", ",", "1"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ef8f71e7-5398-45d4-ad55-55b069522341"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "1"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5d8e99f1-c1ee-47cf-8bfa-dce6ed335a6c"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "0"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e3d99290-eb27-41bf-84ea-e66e8cb30fad"],
 ". ",
 StyleBox["KS",
  FontWeight->"Bold"],
 " and ",
 StyleBox["CJT",
  FontWeight->"Bold"],
 " keep all three contractions with weight 1; KS with the projection. The \
self-energies are the derivatives of the energy,"
}], "Text",ExpressionUUID->"e833fc11-05cd-49a6-b332-64337eabbd45"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["N",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"]], "\[LongEqual]", "\[Nu]", 
   RowBox[{"[", 
