  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubsuperscriptBox["\[CapitalPi]", 
      StyleBox["SH",
       FontSlant->"Plain"], 
      StyleBox["u",
       FontSlant->"Plain"]], ",", 
     SubsuperscriptBox["\[CapitalPi]", 
