                    RowBox[{"--", 
                    RowBox[{
                    "--", " ", 
                    "WQN"}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}\
]}]}]}]}]}]}], "-", "5"}], ":", " ", "anomalies"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"ch16", " ", "=", " ", 
     RowBox[{"dirac16", "[", "gch", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"traces", " ", "=", " ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Tr", "[", 
          RowBox[{"ch16", ".", "YY", ".", "YY", ".", "YY"}], "]"}], ",", " ", 
         
         RowBox[{"Tr", "[", 
          RowBox[{"ch16", ".", "YY"}], "]"}]}], "}"}], ",", "\n", "  ", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Tr", "[", 
             RowBox[{"ch16", ".", 
              RowBox[{"acomm", "[", 
               RowBox[{
                RowBox[{"T", "[", "a", "]"}], ",", " ", 
                RowBox[{"T", "[", "b", "]"}]}], "]"}], ".", "YY"}], "]"}], ",",
             " ", 
            RowBox[{"Tr", "[", 
             RowBox[{"ch16", ".", "YY", ".", "YY", ".", 
              RowBox[{"T", "[", "a", "]"}]}], "]"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"a", ",", " ", "3"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"b", ",", " ", "3"}], "}"}]}], "]"}], "]"}], ",", "\n", 
       "  ", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Tr", "[", 
           RowBox[{"ch16", ".", 
            RowBox[{"T", "[", "a", "]"}], ".", 
            RowBox[{"acomm", "[", 
             RowBox[{
              RowBox[{"T", "[", "b", "]"}], ",", " ", 
              RowBox[{"T", "[", "c", "]"}]}], "]"}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"a", ",", " ", "3"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"b", ",", " ", "3"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"c", ",", " ", "3"}], "}"}]}], "]"}], "]"}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"par16", " ", "=", " ", 
     RowBox[{"dirac16", "[", 
      RowBox[{"gam", "[", "0", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nDoub", " ", "=", " ", 
     RowBox[{"Count", "[", 
      RowBox[{
       RowBox[{"Diagonal", "[", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"T", "[", "a", "]"}], ".", 
           RowBox[{"T", "[", "a", "]"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"a", ",", " ", "3"}], "}"}]}], "]"}], "]"}], ",", " ", 
       RowBox[{"3", "/", "4"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ok5", " ", "=", " ", 
     RowBox[{
      RowBox[{"AllTrue", "[", 
       RowBox[{"traces", ",", " ", 
        RowBox[{
         RowBox[{"#", " ", "==", " ", "0"}], " ", "&"}]}], "]"}], " ", "&&", 
      " ", 
      RowBox[{"And", " ", "@@", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"comm", "[", 
            RowBox[{"par16", ",", " ", "#"}], "]"}], " ", "==", " ", "z16"}], 
          " ", "&"}], " ", "/@", " ", "gensAll"}], ")"}]}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"Mod", "[", 
        RowBox[{"nDoub", ",", " ", "4"}], "]"}], " ", "==", " ", "0"}], " ", "&&",
       " ", 
      RowBox[{"EvenQ", "[", 
       RowBox[{"nDoub", "/", "4"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rvCheck", "[", 
     RowBox[{"\"\<WQN-5\>\"", ",", " ", 
      RowBox[{"\"\<no anomaly (\>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"Length", "[", "traces", "]"}], "]"}], " ", "<>", 
       " ", "\"\< traces exactly 0), vector-like fields, an even number of \\\
\nWeyl doublets\>\""}], ",", " ", "ok5", ",", " ", 
      RowBox[{
       RowBox[{"ToString", "[", 
        RowBox[{"nDoub", "/", "4"}], "]"}], " ", "<>", 
       " ", "\"\< Weyl doublets\>\""}]}], "]"}], ";"}]}]}]], "Input",
 CellLabel->
  "In[451]:=",ExpressionUUID->"c393e484-321f-440f-97f2-b20fc681f522"],

