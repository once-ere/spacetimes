Cell[CellGroupData[{

Cell["III.G.4 The coefficient at zero pair momentum and the slope", "Section",ExpressionUUID->"e961ee65-9a5f-44c0-9212-cea3695c463e"],

Cell[TextData[{
 "The next cell computes, for every method with its own critical temperature \
(Section III.T.4), the coefficient at zero pair momentum from the static pair \
response and checks it four ways: at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.9", "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9d4a8524-730e-43c9-a82d-46a86edf94f8"],
 " it is the Taylor coefficient of the nonlinear free energy of the Rust \
table (Section III.T); at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "/", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]], "\[LongEqual]", "0.9"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9e2f027e-8c49-4fb0-8b45-43f4296bca56"],
 ", ",
 Cell[BoxData[
  FormBox["0.998", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "984fc370-63c7-41d9-908a-502b932eb999"],
 ", ",
 Cell[BoxData[
  FormBox["1.002", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9a074d92-a5e8-478d-8115-51d72efa0cd5"],
 " it is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "-", 
      SubsuperscriptBox["\[Lambda]", 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["P",
        FontSlant->"Plain"]]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["\[Lambda]", 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["P",
        FontSlant->"Plain"]], 
      SubsuperscriptBox[
       StyleBox["g", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["P",
         FontSlant->"Plain"]}]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6fa3d99b-5938-41ef-8240-06e2eab05e2e"],
 " with the eigenvalue of Section III.T.4; at ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b203eebf-aed2-4c82-a2b3-f7a48056669d"],
 " it vanishes; and no other pair channel is induced. The slope ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Alpha]", 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["GL",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a916ccac-e904-4f74-8eaa-f6aa5ad43c82"],
 " is computed twice: from central differences of the coefficient at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     RowBox[{"1", "\[PlusMinus]", "0.002"}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cb362a75-70dd-41d1-bddb-9dd54d886f72"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     RowBox[{"1", "\[PlusMinus]", "0.004"}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "195f0ed0-c45f-4346-acee-540a97d3e8ca"],
 " with the Richardson extrapolation, and in closed form with the derivatives \
of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["I", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "1", ")"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "25cfd260-572b-492b-8744-a6bb6b70af73"],
 " on the radial nodes,"
}], "Text",ExpressionUUID->"c6ec84be-dabc-4712-bf49-d591c689fe4f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[PartialD]", 
    StyleBox["T", "TI"]], 
   SubsuperscriptBox[
    StyleBox["I", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "1", ")"}]], "\[LongEqual]", 
   RowBox[{"-", 
    FractionBox["1", 
     RowBox[{"2", 
      SuperscriptBox[
       StyleBox["T", "TI"], "2"]}]]}], "\[ThinSpace]", 
   SubsuperscriptBox["\[Integral]", "0", 
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]], "\[ThinSpace]", 
   FractionBox[
    RowBox[{
     SuperscriptBox[
      StyleBox["q", "TI"], "2"], "\[ThinSpace]", 
     StyleBox["dq", "TI"]}], 
    RowBox[{
     SuperscriptBox[
      StyleBox["cosh",
       FontSlant->"Plain"], "2"], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["E", "TI"], 
        StyleBox["M", "TI"]], "/", "2", 
       StyleBox["T", "TI"]}], ")"}]}]], ",", "      ", 
   SubscriptBox["\[PartialD]", 
    StyleBox["M", "TI"]], 
   SubsuperscriptBox[
    StyleBox["I", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "1", ")"}]], "\[LongEqual]", 
   SubsuperscriptBox["\[Integral]", "0", 
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["q", "TI"], "2"], 
   FractionBox[
    StyleBox["M", "TI"], 
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["M", "TI"]]], 
   RowBox[{"[", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"2", 
       StyleBox["T", "TI"], 
       SubscriptBox[
        StyleBox["E", "TI"], 
        StyleBox["M", "TI"]], "\[ThinSpace]", 
       SuperscriptBox[
        StyleBox["cosh",
         FontSlant->"Plain"], "2"], 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox[
          StyleBox["E", "TI"], 
          StyleBox["M", "TI"]], "/", "2", 
         StyleBox["T", "TI"]}], ")"}]}]], "-", 
     FractionBox[
      RowBox[{
       StyleBox["tanh",
        FontSlant->"Plain"], 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox[
          StyleBox["E", "TI"], 
          StyleBox["M", "TI"]], "/", "2", 
         StyleBox["T", "TI"]}], ")"}]}], 
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["M", "TI"], "2"]]}], "]"}], 
   StyleBox["dq", "TI"], ","}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"b6d5aef8-5b50-41d7-a489-3c737f0c565b"],

Cell[TextData[{
 "and the derivative of the Dirac mass of the normal state from the implicit \
function theorem applied to its scalar self-consistency ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["M", "TI"], "-", 
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["S",
       FontSlant->"Plain"]}]], 
    SubsuperscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["S",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["M", "TI"], ",", 
      StyleBox["T", "TI"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7abccb86-ccda-4eed-bbcc-a48a6714e45f"],
 " (Section III.T.4): ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", 
     StyleBox["T", "TI"]], 
    StyleBox["M", "TI"], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
