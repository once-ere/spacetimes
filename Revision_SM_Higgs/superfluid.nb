Cell[CellGroupData[{

Cell["R.4.2 The Josephson relation (check WD-2)", "Subsection",ExpressionUUID->"7f9c52f2-d92a-4a56-8847-36df90d5f8b6"],

Cell[TextData[{
 "A chemical potential ",
 Cell[BoxData[
  FormBox["\[Mu]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "31b37116-b8ec-47d1-991e-9a323e237679"],
 " of the particle number adds ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "\[Mu]"}], 
    SubsuperscriptBox[
     StyleBox["F", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["tot",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "495dc06e-487a-46d0-8d05-7524b3b6ab67"],
 " to the Hamiltonian; on the space of particles and holes (the Nambu space) \
the number acts as ",
 Cell[BoxData[
  FormBox[
   StyleBox["1",
    FontFamily->"Helvetica",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3381ec24-1181-438d-aca1-0811dea58ded"],
 " on the particle block and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    StyleBox["1",
     FontFamily->"Helvetica",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "24046322-a0ca-4661-85b0-2c70685bd9e7"],
 " on the hole block. If ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["\[ScriptCapitalR]",
     FontSlant->"Plain"], "0"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "05f2beab-1f2e-4016-9edd-5045e70fb16b"],
 " is stationary, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"[", 
     RowBox[{
      SubscriptBox[
       StyleBox["H",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], "0"], ",", 
      SubscriptBox[
       StyleBox["\[ScriptCapitalR]",
        FontSlant->"Plain"], "0"]}], "]"}], "\[LongEqual]", "0"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b20868b9-879a-4f71-9a00-ce1954da9832"],
 ", then ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      StyleBox["i", "TI"], "\[Mu]", 
      StyleBox["Ft", "TI"]}]], 
    SubscriptBox[
     StyleBox["\[ScriptCapitalR]",
      FontSlant->"Plain"], "0"], 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      RowBox[{"-", 
       StyleBox["i", "TI"]}], "\[Mu]", 
      StyleBox["Ft", "TI"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "49ee7836-8754-4ea2-b1af-2a005723eacd"],
 " solves the equation with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["H",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "-", "\[Mu]", 
    StyleBox["F", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5136ff23-ef1d-4305-8a5a-785586678a6c"],
 ", and its pair block, which connects particles with holes, carries the \
factor ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"2", 
     StyleBox["i", "TI"], "\[Mu]", 
     StyleBox["t", "TI"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d14267ae-42fc-44f2-bd44-15665479ae0a"],
 " because each pair carries the particle number 2. The phase of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["t", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1e340bca-5452-449a-8760-a8b8a0b6e942"],
 " therefore turns at the rate ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Mu]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c3ca2fdb-aec3-4794-93eb-95d8854337b6"],
 " while its modulus stays ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["d", "TI"], 
    StyleBox["SH",
     FontSlant->"Plain"], "0"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d94421d1-b2e2-4496-bf96-c4554103e095"],
 ": the relation of Josephson between the chemical potential and the \
frequency of the phase of a condensate of pairs. The cell proves it \
symbolically on one Nambu block and fits a straight line, in exact arithmetic \
on the numbers of the data cell, to the unwrapped phase of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["t", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f1c1a1d0-3c37-4872-a572-347b4d3e9582"],
 " of the two Josephson runs of the Rust program (HS (0, 0) and CJT)."
}], "Text",ExpressionUUID->"03cb48d0-e8be-4dc2-9db3-adaa86830d2c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", 
          RowBox[{"--", 
           RowBox[{"--", 
