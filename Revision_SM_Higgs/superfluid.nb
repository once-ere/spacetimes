Cell[CellGroupData[{

Cell["R.1.6 The Lorentz-invariant bilinears (check WQN-6)", "Subsection",ExpressionUUID->"5379d84d-55fe-42da-8c52-119fb2d81bb8"],

Cell[TextData[{
 "A pair of two fields ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Phi]", "1"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e81f39c4-9976-42ed-9181-67868d901381"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Phi]", "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "df0ed70e-f64f-4d2e-b2f3-84e2ff4685c2"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPi]", 
    RowBox[{"[", 
     StyleBox["M",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "]"}], "\[LongEqual]", 
    SubsuperscriptBox["\[Phi]", "1", 
     StyleBox["T", "TI"]], 
    StyleBox["M",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    SubscriptBox["\[Phi]", "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8d3c50a6-c582-4cb3-970d-efdfa7e21127"],
 ", and a particle-antiparticle bilinear is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Phi]", "1", "\[Dagger]"], 
    StyleBox["M",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    SubscriptBox["\[Phi]", "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "568779cc-db04-4f30-bae2-c442a22710d0"],
 ". Under ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Phi]", "\[RightArrow]", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      StyleBox["i", "TI"], "\[Epsilon]", 
      StyleBox["X", "TI"]}]], "\[Phi]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f93a1cf4-dcd0-4e23-b066-69a4ba7eac53"],
 " the matrix ",
 Cell[BoxData[
  FormBox[
   StyleBox["M",
    FontFamily->"Helvetica",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9367b66d-e54f-467d-9600-64989ebae4f6"],
 " changes, to first order, by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["i", "TI"], "\[Epsilon]", 
    SubscriptBox[
     StyleBox["L", "TI"], 
     StyleBox["X", "TI"]], 
    RowBox[{"(", 
     StyleBox["M",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3dbbbae5-79f3-472a-85f5-0db0ec8153a1"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["L", "TI"], 
     StyleBox["X", "TI"]], 
    RowBox[{"(", 
     StyleBox["M",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], ")"}], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["X", "TI"], "1", 
     StyleBox["T", "TI"]], 
    StyleBox["M",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "+", 
    StyleBox["M",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    SubscriptBox[
     StyleBox["X", "TI"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "542ac637-1b60-43d4-a8eb-3777122ca4d9"],
 " for a pair and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     SubscriptBox[
      StyleBox["X", "TI"], "1"]}], 
    StyleBox["M",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "+", 
    StyleBox["M",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    SubscriptBox[
     StyleBox["X", "TI"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8635fb08-9e14-426a-8b1b-e48be93f2c18"],
 " for a particle-antiparticle bilinear, where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["X", "TI"], "1"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "89f44098-8d0e-4510-9aaa-7378d7e4c578"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["X", "TI"], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c429fc55-ed0d-4c53-9536-fcf02d9f15b6"],
 " are the blocks of ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3f06557d-feeb-46f0-9a70-628fd5495e2b"],
 " on the two fields. A bilinear is Lorentz invariant when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["L", "TI"], 
     RowBox[{
      StyleBox["S", "TI"], 
      RowBox[{"(", 
       StyleBox["u", "TI"], ")"}]}]], 
    RowBox[{"(", 
     StyleBox["M",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], ")"}], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8a35d094-904a-4302-9de3-3a610a7f6438"],
 " for the six generators; the invariant matrices are the null space of these \
linear conditions, computed exactly on the vector of the entries of ",
 Cell[BoxData[
  FormBox[
   StyleBox["M",
    FontFamily->"Helvetica",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7e499df5-440b-4bc6-abe0-4ebad99ca36d"],
 " (taken row by row). For a pair of two particles of one field, Fermi \
statistics keeps only the antisymmetric part of ",
 Cell[BoxData[
  FormBox[
   StyleBox["M",
    FontFamily->"Helvetica",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8d18c544-cfbc-407b-a18f-e98d5d34d536"],
 ", so the condition ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["M",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "\[LongEqual]", 
    RowBox[{"-", 
     SuperscriptBox[
      StyleBox["M",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["T", "TI"]]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7da0c6de-001e-4ab5-88ae-18231cedafcb"],
 " is added. The twelve sectors are the six pairs ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPsi]", "\[CapitalPsi]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a6694732-f5e9-4184-b5d0-493560481d7b"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPsi]", "\[Chi]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "50cc0f81-a7ad-4e36-89e6-f25090808fad"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPsi]", 
    SuperscriptBox["\[Chi]", "\[Prime]"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bfba5634-40b8-4b76-ad5d-32f715670b56"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Chi]", "\[Chi]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "866837df-09fe-48fb-b5a2-1958909e2671"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Chi]", 
    SuperscriptBox["\[Chi]", "\[Prime]"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "199f3d5c-99f2-4467-bc29-6f825b07ab29"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Chi]", "\[Prime]"], 
    SuperscriptBox["\[Chi]", "\[Prime]"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c941546a-8cc2-4a41-a58a-6663a34b7323"],
 " and the six particle-antiparticle bilinears; the four sectors in which the \
pair of singlets is taken as one field, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"\[Chi]", ",", 
     SuperscriptBox["\[Chi]", "\[Prime]"]}], ")"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9864af28-5597-4ae7-b75e-2108a1cfed9d"],
 ", show the custodial multiplets. The pair matrices ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["ch",
      FontSlant->"Plain"]], "\[CircleTimes]", 
    SubsuperscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["s", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e8d38308-b812-423f-baf5-00f56f5ace2c"],
 " (spin zero, positive parity) and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[CircleTimes]", 
    SubsuperscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["s", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5a173c14-3067-4f27-8a91-08083f347ef4"],
 " (spin zero, negative parity) must lie in the invariant spaces of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPsi]", "\[Chi]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4509a72a-5c77-4d3e-b1b2-32ca2e5eb5ac"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPsi]", 
    SuperscriptBox["\[Chi]", "\[Prime]"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5a07c890-4054-48d7-8f60-880618832f5c"],
 " and span them."
}], "Text",ExpressionUUID->"44a6d624-37d3-44f9-8a52-a0661bb22e61"],

