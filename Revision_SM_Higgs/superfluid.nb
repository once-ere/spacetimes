Cell[TextData[{
 StyleBox["Is the order parameter smaller and more physically reasonable?",
  FontWeight->"Bold"],
 " Yes, near the critical temperature, and only there, for the mean-field \
free energy of the methods (Section III.G shows that these temperatures lie \
inside the critical region of the transition, where the fluctuations that the \
methods omit dominate)."
}], "Text",ExpressionUUID->"f1fc6d9d-b951-4db5-a39d-585cc4b3d6bb"],

Cell[TextData[{
 StyleBox["It is smaller.",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalPhi]", 
     RowBox[{"0", ",", 
      StyleBox["SF",
       FontSlant->"Plain"]}], 
     StyleBox["X", "TI"]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0b5668d0-9300-4200-9e0e-570c1c6dd69e"],
 " keeps its value of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6b83e7d5-5735-407d-b2a8-4b630668c2fc"],
 " up to about ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.3", "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e729009f-efe0-401d-a48c-8c3c79e3a4da"],
 " (the gap is much larger than these temperatures, and thermal \
quasi-particles are exponentially rare), then falls and vanishes continuously \
at ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b138c50a-dc6b-4647-a462-1f7d0a9b2bc4"],
 ", like ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "-", 
      StyleBox["T", "TI"], "/", 
      SubsuperscriptBox[
       StyleBox["T", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["c",
         FontSlant->"Plain"]}]]}], ")"}], 
    RowBox[{"1", "/", "2"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ab5ea57a-298a-4ddd-8c52-314d0ab56a74"],
 " (the table and the figure above)."
}], "ItemNumbered",ExpressionUUID->"7aa81bc5-d551-4ffa-9730-a1313d80dc31"],

Cell[TextData[{
 StyleBox["It lies inside the radius of convergence.",
  FontWeight->"Bold"],
 " At ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "92d7a28d-384a-4dc5-aac8-62d54325bfac"],
 " the order parameter is 1.5 to 2 times the radius, which is then the mass \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bd2b5184-3c5d-427a-bde4-33f316974f9e"],
 "; above the reduced temperature of the table (0.35 to 0.42) it is smaller \
than the radius, and near ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e76a3817-eda8-4ea1-8011-e09ef6486051"],
 " much smaller. There the series of the free energy in powers of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1f27af95-878b-4700-a968-8a366a1fcceb"],
 " converges at the minimum, and the Landau coefficients are the Taylor \
coefficients of the free energy: the regime of Landau's theory, which Section \
III.L found absent at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "399f6224-52da-4282-a1ff-bda301221d75"],
 "."
}], "ItemNumbered",ExpressionUUID->"51925e74-1ea6-457d-ab7b-f474fa30456f"],

Cell[TextData[{
 StyleBox["The Landau form becomes exact.",
  FontWeight->"Bold"],
 " The residual of the Landau form falls from a few tenths of a per cent of \
the depth at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "99abf906-1e49-4f08-affe-eae211e90acb"],
 " to about ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "3"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2b73dd55-ce03-4f1b-a9a1-0d193feff47f"],
 " per cent at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.98", "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8fe3bdcb-9df1-4986-b5f0-39ac10fea125"],
 ", and that of the quartic form (the form of the Higgs potential of the \
Standard Model and of the theory of Ginzburg and Landau) from 3 to 6 per cent \
to about 0.3 per cent; near ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "15402d06-a486-45a0-8da3-9cbb6f2ea13f"],
 " it falls in proportion to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "-", 
    StyleBox["T", "TI"], "/", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "86ceb1e7-70db-4567-958c-2c91f831f63b"],
 "."
}], "ItemNumbered",ExpressionUUID->"9664a50a-162d-429d-ba31-1adad834ab1c"],

Cell[TextData[{
 StyleBox["Landau's theory predicts the order parameter.",
  FontWeight->"Bold"],
 " Near ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "436a17fa-0adf-477d-a11d-f1862f8558fa"],
 " the error of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       StyleBox["a", "TI"]}], "/", "2", 
      StyleBox["b", "TI"]}], ")"}], 
    RowBox[{"1", "/", "2"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3e6599aa-b46b-4a1d-abf0-b89737e6389f"],
 " is a fraction (0.19 to 0.28 in the Rust table) of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "-", 
    StyleBox["T", "TI"], "/", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8a6b7039-5cd5-4c2b-aeca-c72bbccfbb02"],
 ", as Landau's theory requires; the cell above computes it for CJT at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.9", "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["CJT",
       FontSlant->"Plain"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "60d1e5b3-176e-43b4-affa-560010df8366"],
 "."
}], "ItemNumbered",ExpressionUUID->"7f53773d-12be-41aa-a59c-ebb7d9691404"],

Cell[TextData[{
 StyleBox["The scales.",
  FontWeight->"Bold"],
 " Near ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "71a2d2d5-63a2-41a9-9428-2e8b43ed13e1"],
 " the order parameter is small also against the Dirac mass and the cutoff. \
The critical temperatures themselves are about a fifth to a quarter of the \
cutoff (the table above), and the states at the cutoff are occupied by 0.8 to \
1.8 per cent at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.98", "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2b100c77-b87c-4e61-8119-2bcdc92cec8e"],
 ", so the thermal physics reaches the cutoff only weakly. The ratio of the \
gap at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d3b0a8d7-1d60-44e0-8d05-7ebf26c23ed2"],
 " to ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0171fad2-1dad-4531-8981-e3aa1c1fa794"],
 " is 1.65 to 1.74; the theory of Bardeen, Cooper and Schrieffer gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Pi]", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      SubscriptBox["\[Gamma]", 
       StyleBox["E",
        FontSlant->"Plain"]]}]], "\[LongEqual]", "1.764"}], TraditionalForm]],
   "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8bbc0a88-c7f5-4899-a3a9-1637de2eb749"],
 " (with Euler's constant ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", 
     StyleBox["E",
      FontSlant->"Plain"]], "\[LongEqual]", "0.5772"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8fdb0aa6-c2a2-486c-a989-ec307d608d3f"],
 ") for weak pairing at a Fermi surface. The ratios are of the same size but \
not equal: here there is no Fermi surface (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Mu]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1e923e4c-8613-4f45-939e-7e376e12a55f"],
 "), the pairing needs a coupling above a critical one, and the gap contains \
the Dirac mass."
}], "ItemNumbered",ExpressionUUID->"adbefb2d-4d25-4aba-85c3-ec223ceeff95"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
III.T.7 What the free energy of these methods does not contain, and why it \
matters\
\>", "Section",ExpressionUUID->"3eff3d2f-f65d-430f-9433-79691c9998d5"],

Cell[TextData[{
 StyleBox["The remark.",
  FontWeight->"Bold"],
 " All three methods give mean-field free energies: the thermal state is \
quasi-free, so the free energy contains the thermal quasi-particles of the \
spinor field, but neither the thermal fluctuations of the order parameter \
about its mean value (its amplitude, Goldstone and non-unitary modes) nor \
thermal gauge fields. ",
 StyleBox["Why it holds.",
  FontWeight->"Bold"],
 " A quasi-free state is a state whose correlations of four and more fields \
are fixed by its correlations of two fields (Wick's theorem); the three \
methods choose the best such state, and a fluctuation of the order parameter \
is a correlation of two pairs beyond the product of the pair densities. In HS \
the integral over the auxiliary fields is replaced by its saddle point, in \
CJT the effective action is truncated at the contractions of the contact \
terms in pairs, and in KS the exchange-correlation energy has no thermal part."
}], "Text",ExpressionUUID->"3124d21b-01fd-4a69-9c95-371fb9c1117b"],

Cell[TextData[{
 StyleBox["Why it matters.",
  FontWeight->"Bold"],
 " Near a continuous transition the fluctuations of the order parameter grow \
without bound. Their size relative to the order parameter is measured by the \
Ginzburg number of the transition (A. P. Levanyuk 1959, V. L. Ginzburg 1960): \
the mean-field free energy is accurate where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "-", 
    StyleBox["T", "TI"], "/", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3db1bb8a-3284-4e15-9d19-3c46c9b2455b"],
 " is much larger than the Ginzburg number, and it fails within the critical \
region, where it is smaller. For a free energy of the form of Ginzburg and \
Landau in three dimensions, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", 
     StyleBox["GL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      RowBox[{"\[Del]", 
       SubscriptBox["\[Psi]", 
        StyleBox["GL",
         FontSlant->"Plain"]]}], "\[RightBracketingBar]"}], "2"], "+", 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["GL",
      FontSlant->"Plain"], "\[Prime]"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["T", "TI"], "/", 
      SubscriptBox[
       StyleBox["T", "TI"], 
       StyleBox["c",
        FontSlant->"Plain"]], "-", "1"}], ")"}], 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      SubscriptBox["\[Psi]", 
       StyleBox["GL",
        FontSlant->"Plain"]], "\[RightBracketingBar]"}], "2"], "+", 
    FractionBox["1", "2"], 
    SubscriptBox["\[Beta]", 
     StyleBox["GL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      SubscriptBox["\[Psi]", 
       StyleBox["GL",
        FontSlant->"Plain"]], "\[RightBracketingBar]"}], "4"]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "67892e96-f866-48ea-b7ee-65c76af587f4"],
 " (the example of Section III.L.2 with the gradient coefficient ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", 
    StyleBox["GL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f22deba5-ad91-4f09-b4bf-4cf7f5cc4305"],
 ", the slope ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Alpha]", 
    StyleBox["GL",
     FontSlant->"Plain"], "\[Prime]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "49fe4385-6386-43ab-b129-ad7ce488c527"],
 " and the critical temperature ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["c",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "023731c8-5269-4a29-9a16-8a1b4a8f3b87"],
 "), the Ginzburg number is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["c",
      FontSlant->"Plain"], "2"], 
    SubsuperscriptBox["\[Beta]", 
     StyleBox["GL",
      FontSlant->"Plain"], "2"], "/", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["\[Alpha]", 
       StyleBox["GL",
        FontSlant->"Plain"], "\[Prime]"], 
      SubsuperscriptBox["\[Gamma]", 
       StyleBox["GL",
        FontSlant->"Plain"], "3"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cd0c558a-c0dc-4c8a-b9a1-d7b2bd54fba2"],
 " up to a numerical factor that depends on the conventions. Within the \
critical region the order parameter vanishes with an exponent different from ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "027eba3a-ffc9-44de-9538-57a2313d137e"],
 " (in three dimensions near 0.33 to 0.37 for the Ising, XY and Heisenberg \
universality classes), the critical temperature is in general lower than the \
mean-field one, and for an order parameter with two quartic invariants, as \
here, the fluctuations can also make the transition discontinuous (the \
renormalization-group theory of such fields is reviewed by A. Pelissetto and \
E. Vicari, 2002). A gauge field coupled to the order parameter can do the \
same: its fluctuations make the transition of a superconductor weakly first \
order (B. I. Halperin, T. C. Lubensky and S.-k. Ma, 1974), and the thermal \
transition of the Higgs field of the electroweak theory, of first order for \
small Higgs masses, ends at a critical Higgs mass, above which there is no \
transition but a smooth crossover (lattice simulations of K. Kajantie, M. \
Laine, K. Rummukainen and M. Shaposhnikov, 1996). The answer of Section \
III.T.6 therefore describes the superfluid near ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "169baa73-bc27-4aff-8eee-d9030f53b5e0"],
 " only outside the critical region, and whether the transition of the full \
theory is continuous is not decided here. The size of the critical region \
needs the gradient coefficient of the field at ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f1c989e2-01b3-48bf-85a3-8b98beb9298c"],
 ", which Section III.G computes: the Ginzburg number is 7.6 to 11.4, so that \
the whole range of temperatures of Section III.T.6 where the free energy \
behaves as Landau's theory lies inside the critical region. At ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4916b875-2be7-4890-9bd1-63ce7ef7d5d5"],
 " the methods omit the quantum fluctuations of the order parameter as well; \
that is a property of the methods, not the subject of this remark."
}], "Text",ExpressionUUID->"123f4c2f-4dce-4f9b-9583-c737faac2ede"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Part III, third section. The width of the critical region, and the superfluid \
as a Higgs sector\
\>", "Chapter",ExpressionUUID->"ca3244be-23a4-47d9-bcf9-acd1e510d611"],

Cell[TextData[{
 "On 21 November 2026 the author asked to find how wide the region of the \
fluctuations near the critical temperature is, which needs one more \
calculation, the gradient coefficient of the field at the critical \
temperature; then to determine for each of the five methods ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "966c5793-b1fb-4493-9b01-26e50307b9f9"],
 " (HS ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"1", ",", "1"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "73fcac65-df8c-4cc6-9130-ca8f0fb38d85"],
 ", HS ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "1"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8c01f151-f022-4585-bc03-504675d2b2a0"],
 ", HS ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "0"}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9c984cc0-b608-49a6-b4c2-2e68ce8898c0"],
 ", KS and CJT) whether the superfluid can play the role of the Higgs \
particle, and whether the Higgs is really a composite particle. This chapter \
does both with the engines of Part II and of Section III.T, and repeats the \
checks of the Rust program ",
 StyleBox["sf_part3",
  FontFamily->"Source Code Pro"],
 " (modules ",
 StyleBox["ginzburg",
  FontFamily->"Source Code Pro"],
 " and ",
 StyleBox["higgs",
  FontFamily->"Source Code Pro"],
 ") and of the Python program ",
 StyleBox["sf_part3.py",
  FontFamily->"Source Code Pro"],
 ". ",
 StyleBox["The answers.",
  FontWeight->"Bold"],
 " The Ginzburg number is 7.6 to 11.4 (Section III.G.7): the critical region \
is wider than the critical temperature itself, so the mean-field description \
of the five methods holds nowhere near the transition. Every method realizes \
the Higgs mechanism and has a composite neutral scalar below the threshold of \
two quasi-particles, but in no method can it be the Higgs boson that is \
observed (Section III.G.8). Within this model the Higgs field is composite by \
construction."
}], "Text",ExpressionUUID->"4c87e958-3c08-4a33-9892-2290f0f45192"],

Cell[CellGroupData[{

Cell["\<\
III.G.1 The free energy of Ginzburg and Landau and the Ginzburg number\
\>", "Section",ExpressionUUID->"a6956515-0777-4a4a-a9e0-ccb99b178d83"],

Cell[TextData[{
 StyleBox["Units.",
  FontWeight->"Bold"],
 " As in Section III.T: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["k", "TI"], 
     StyleBox["B",
      FontSlant->"Plain"]], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "42001f77-ea63-4482-8792-8eda4dccd733"],
 ", the cutoff ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7f36c20c-1754-447a-a1a4-d0b518cc56b6"],
 ", the chemical potential zero. ",
 StyleBox["The field.",
  FontWeight->"Bold"],
 " The field of the superfluid is the complex isospin vector ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["\[CapitalPhi]", "1"], ",", 
      SuperscriptBox["\[CapitalPhi]", "2"], ",", 
      SuperscriptBox["\[CapitalPhi]", "3"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "58b0177d-b83f-4691-b7bc-c5187699d34a"],
 " of the components of the pair self-energy along ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], "\[Iota]"], ")"}], "\[Dagger]"], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0a167898-f286-45e8-8725-372bddb4cd5c"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[CapitalPhi]", "\[Iota]"], "\[LongEqual]", 
    StyleBox["tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "\[Iota]"], 
      SubscriptBox[
       StyleBox["P",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["SF",
        FontSlant->"Plain"]]}], ")"}], "/", "8"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e026aa6d-0b0e-42c2-8175-f88ad3109a07"],
 "; it has ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], "\[CapitalPhi]"], "\[LongEqual]", "6"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "960c6079-9b6b-487c-b5a4-841669a4be94"],
 " real components, and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
      "\[RightBracketingBar]"}], "2"], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", "\[Iota]",
     LimitsPositioning->True], 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      SuperscriptBox["\[CapitalPhi]", "\[Iota]"], "\[RightBracketingBar]"}], 
     "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "395f95f7-3e1b-4b80-a47f-33c0b341858b"],
 ". ",
 StyleBox["The form of Ginzburg and Landau.",
  FontWeight->"Bold"],
 " Near the critical temperature ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6b21c830-1c09-410f-9736-a274c1e7a707"],
 " the field is small. For a static field that varies slowly in space, the \
free energy of method ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "213fa4a9-d511-4fe5-b242-064622216386"],
 " to second order in the field and in its derivatives and to fourth order in \
the field is"
}], "Text",ExpressionUUID->"06455281-6a50-4a19-a393-73c282696301"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalF]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["GL",
      FontSlant->"Plain"]}]], 
   RowBox[{"[", 
    OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "]"}], "\[LongEqual]", "\[Integral]",
    "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["d", "TI"], "3"], 
   StyleBox["x", "TI"], 
   RowBox[{"[", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["c",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      StyleBox["X", "TI"]], "\[ThinSpace]", 
     UnderoverscriptBox["\[Sum]", 
      RowBox[{
       StyleBox["j", "TI"], "\[LongEqual]", "1"}], "3",
      LimitsPositioning->True], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[PartialD]", 
         StyleBox["j", "TI"]], 
        OverscriptBox["\[CapitalPhi]", "\[RightVector]"]}], ")"}], 
      "\[Dagger]"], "\[CenterDot]", 
     SubscriptBox["\[PartialD]", 
      StyleBox["j", "TI"]], 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "+", 
     SubsuperscriptBox[
      StyleBox["a", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["X", "TI"], ",", 
       StyleBox["Tay",
        FontSlant->"Plain"]}]], 
     RowBox[{"(", 
      StyleBox["T", "TI"], ")"}], "\[ThinSpace]", 
     SuperscriptBox[
      RowBox[{"\[LeftBracketingBar]", 
       OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
       "\[RightBracketingBar]"}], "2"], "+", 
     SubsuperscriptBox[
      StyleBox["b", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["X", "TI"], ",", 
       StyleBox["Tay",
        FontSlant->"Plain"]}]], 
     RowBox[{"(", 
      StyleBox["T", "TI"], ")"}], "\[ThinSpace]", 
     SuperscriptBox[
      RowBox[{"\[LeftBracketingBar]", 
       OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
       "\[RightBracketingBar]"}], "4"]}], "]"}], ","}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"4ca5d6c0-d997-4b5a-b80d-c71ba59d4e8d"],

Cell[TextData[{
 "with the Taylor coefficients ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["Tay",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "29fb5f3e-6ef2-49ba-b6c4-bf6e285e0a08"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["b", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["Tay",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ec27c8ec-d0ec-4bd3-9a6b-e60656facd12"],
 " of the free energy at the origin (Section III.T.6), ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["Tay",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}], "\[TildeTilde]", 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["GL",
       FontSlant->"Plain"]}]], 
    SubsuperscriptBox[
     StyleBox["t", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["red",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7343d2ed-d615-4002-998c-fe587b32cea2"],
 " near ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b0094809-b70f-4ac8-902f-a6e15bff5ded"],
 ", the reduced temperature ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["t", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["red",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["T", "TI"], "-", 
      SubsuperscriptBox[
       StyleBox["T", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["c",
         FontSlant->"Plain"]}]]}], ")"}], "/", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7def2ecd-1695-4b17-a487-b99fb7cae573"],
 ", the slope ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["GL",
       FontSlant->"Plain"]}]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]], "\[ThinSpace]", 
    SubscriptBox["\[PartialD]", 
     StyleBox["T", "TI"]], 
    SubsuperscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["Tay",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d114a20d-4ce0-4dd6-a5a4-1caafbad1c56"],
 " at ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a0803250-fd60-4f66-8932-0c6dfa0eec64"],
 ", and the ",
 StyleBox["gradient coefficient",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["c",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "361858a9-78e7-49a7-9091-f836bb00cd41"],
 " at ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "39034ecb-f805-4218-b8b9-3973f25debb0"],
 ". The rotations and the isospin rotations allow no other term of second \
order, and a term with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "\[CenterDot]", 
    OverscriptBox["\[CapitalPhi]", "\[RightVector]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "29e49dfa-0a90-4802-9788-45b605725446"],
 " has the fermion number 4 and is not invariant under ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["U", "TI"], 
    SubsuperscriptBox[
     RowBox[{"(", "1", ")"}], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7b935aa5-6744-46b2-ab8c-abc3d9d20ce7"],
 ". Of the two quartic invariants ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}], "4"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "960cad63-8fa2-4ec0-b1fc-da9bf367db6b"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     RowBox[{
      OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "\[CenterDot]", 
      OverscriptBox["\[CapitalPhi]", "\[RightVector]"]}], 
     "\[RightBracketingBar]"}], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "16e36e1a-5fc2-4cf4-bee8-2f2fa7188c54"],
 ", which are equal on the polar fields of the minimum, the form keeps the \
coefficient along these fields. ",
 StyleBox["The Ginzburg number.",
  FontWeight->"Bold"],
 " Above ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e0926de4-14ae-4e70-a6aa-e02b5f9b5af6"],
 " the field fluctuates about zero with the probability density proportional \
to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["exp",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       SubsuperscriptBox[
        StyleBox["\[ScriptCapitalF]",
         FontSlant->"Plain"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["X", "TI"], ",", 
         StyleBox["GL",
          FontSlant->"Plain"]}]]}], "/", 
      StyleBox["T", "TI"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "99b3d03e-c00f-494a-938b-4c4a3de196dd"],
 ". To second order the fluctuations are Gaussian, and their free energy per \
volume is, up to terms analytic in ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bdacbe03-fcd4-4fdc-9c68-e8a70e1bb1a9"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], 
    SubsuperscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], "\[CapitalPhi]"], 
    StyleBox["T", "TI"], "\[ThinSpace]", "\[Integral]", "\[ThinSpace]", 
    FractionBox[
     RowBox[{
      SuperscriptBox[
       StyleBox["d", "TI"], "3"], 
      StyleBox["k", "TI"]}], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"2", "\[Pi]"}], ")"}], "3"]], "\[ThinSpace]", 
    StyleBox["ln",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["c",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["X", "TI"]], 
      SuperscriptBox[
       StyleBox["k", "TI"], "2"], "+", 
      SubsuperscriptBox[
       StyleBox["a", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["Tay",
         FontSlant->"Plain"]}]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2290ef81-9772-4acc-95e4-2a0937ae2d70"],
 ". With ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Integral]", "\[ThinSpace]", 
    FractionBox[
     RowBox[{
      SuperscriptBox[
       StyleBox["d", "TI"], "3"], 
      StyleBox["k", "TI"]}], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"2", "\[Pi]"}], ")"}], "3"]], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       StyleBox["c",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       SuperscriptBox[
        StyleBox["k", "TI"], "2"], "+", 
       StyleBox["a", "TI"]}], ")"}], 
     RowBox[{"-", "2"}]], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"8", "\[Pi]", 
       SuperscriptBox[
        StyleBox["c",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        RowBox[{"3", "/", "2"}]], 
       SuperscriptBox[
        StyleBox["a", "TI"], 
        RowBox[{"1", "/", "2"}]]}], ")"}], 
     RowBox[{"-", "1"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c99d2cda-c80e-4b9b-a396-81fb39ae8790"],
 " its specific heat per volume, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["C", "TI"], "\[LongEqual]", 
    RowBox[{"-", 
     StyleBox["T", "TI"]}], 
    SubsuperscriptBox["\[PartialD]", 
     StyleBox["T", "TI"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "163382ad-2ddc-451c-9856-4925e349018a"],
 " of the free energy, is near ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d56ff6c9-6bcf-4e89-beed-0ff3863502c7"]
}], "Text",ExpressionUUID->"dac67672-6d92-46c6-ac5b-d2451d61f735"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["C", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["fl",
      FontSlant->"Plain"]}]], "\[LongEqual]", 
   FractionBox[
    RowBox[{
     SubsuperscriptBox[
      StyleBox["n", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], "\[CapitalPhi]"], "\[ThinSpace]", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox["\[Alpha]", 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["X", "TI"], ",", 
         StyleBox["GL",
          FontSlant->"Plain"]}]], ")"}], 
      RowBox[{"3", "/", "2"}]]}], 
    RowBox[{"16", "\[Pi]", "\[ThinSpace]", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["c",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        StyleBox["X", "TI"]], ")"}], 
      RowBox[{"3", "/", "2"}]], "\[ThinSpace]", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["t", "TI"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        StyleBox["red",
         FontSlant->"Plain"]], ")"}], 
      RowBox[{"1", "/", "2"}]]}]], ",", "      ", "\[CapitalDelta]", 
   SubsuperscriptBox[
    StyleBox["C", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], "\[LongEqual]", 
   FractionBox[
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[Alpha]", 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["GL",
         FontSlant->"Plain"]}]], ")"}], "2"], 
    RowBox[{"2", "\[ThinSpace]", 
     SubsuperscriptBox[
      StyleBox["b", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["X", "TI"], ",", 
       StyleBox["Tay",
        FontSlant->"Plain"]}]], "\[ThinSpace]", 
     SubsuperscriptBox[
      StyleBox["T", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["X", "TI"], ",", 
       StyleBox["c",
        FontSlant->"Plain"]}]]}]], ","}], TraditionalForm]], "DisplayFormula",\

 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"bdcc26e0-8521-4712-8381-8c387a3162a6"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", 
    SubsuperscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9ef0893b-bceb-4a80-a237-a69e9b641d05"],
 " is the jump of the specific heat of mean-field theory at ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "68bb6ae7-4769-4603-8c38-3e39f5f51614"],
 " (below it the minimum of the form is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
      "\[RightBracketingBar]"}], "2"], "\[LongEqual]", 
    RowBox[{"-", 
     StyleBox["a", "TI"]}], "/", 
    RowBox[{"(", 
     RowBox[{"2", 
      StyleBox["b", "TI"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4405bb6a-c70b-4f44-8a40-7da60e5110ea"],
 " with the free energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     SuperscriptBox[
      StyleBox["a", "TI"], "2"]}], "/", 
    RowBox[{"(", 
     RowBox[{"4", 
      StyleBox["b", "TI"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "eab008e8-eefd-4223-8d0b-8e24c22026b1"],
 " per volume). Mean-field theory holds where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["fl",
       FontSlant->"Plain"]}]], "\[LessLess]", "\[CapitalDelta]", 
    SubsuperscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cbbfe9f3-0483-49f8-8e8a-9178305fcfae"],
 ". The two are equal at the ",
 StyleBox["Ginzburg number",
  FontWeight->"Bold"],
 " (A. P. Levanyuk 1959, V. L. Ginzburg 1960)"
}], "Text",ExpressionUUID->"65f5ea58-76d1-4d57-bc2e-f30446d76399"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["Gi",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"]], "\[LongEqual]", 
   FractionBox[
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["n", "TI"], 
        StyleBox["SF",
         FontSlant->"Plain"], "\[CapitalPhi]"], ")"}], "2"], "\[ThinSpace]", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["b", "TI"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["X", "TI"], ",", 
         StyleBox["Tay",
          FontSlant->"Plain"]}]], ")"}], "2"], "\[ThinSpace]", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["T", "TI"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["X", "TI"], ",", 
         StyleBox["c",
          FontSlant->"Plain"]}]], ")"}], "2"]}], 
    RowBox[{"64", 
     SuperscriptBox["\[Pi]", "2"], "\[ThinSpace]", 
     SubsuperscriptBox["\[Alpha]", 
      StyleBox["SF",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["X", "TI"], ",", 
       StyleBox["GL",
        FontSlant->"Plain"]}]], "\[ThinSpace]", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["c",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        StyleBox["X", "TI"]], ")"}], "3"]}]], "\[LongEqual]", 
   FractionBox[
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["n", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], "\[CapitalPhi]"], ")"}], "2"], 
    RowBox[{"256", 
     SuperscriptBox["\[Pi]", "2"], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"\[CapitalDelta]", 
        SubsuperscriptBox[
         StyleBox["C", "TI"], 
         StyleBox["SF",
          FontSlant->"Plain"], 
         StyleBox["X", "TI"]], 
        SuperscriptBox[
         RowBox[{"(", 
          SubsuperscriptBox["\[Xi]", 
           StyleBox["SF",
            FontSlant->"Plain"], 
           RowBox[{
            StyleBox["X", "TI"], ",", 
            StyleBox["GL",
             FontSlant->"Plain"]}]], ")"}], "3"]}], ")"}], "2"]}]], ",", 
   "      ", 
   SubsuperscriptBox["\[Xi]", 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["GL",
      FontSlant->"Plain"]}]], "\[LongEqual]", 
   SuperscriptBox[
    RowBox[{"(", 
     FractionBox[
      SubsuperscriptBox[
       StyleBox["c",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["X", "TI"]], 
      SubsuperscriptBox["\[Alpha]", 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["GL",
         FontSlant->"Plain"]}]]], ")"}], 
    RowBox[{"1", "/", "2"}]], "."}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"65c1fa64-8f9d-4518-be56-02e28eaa41d7"],

Cell[TextData[{
 "Mean-field theory holds for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftBracketingBar]", 
     SubsuperscriptBox[
      StyleBox["t", "TI"], 
      StyleBox["SF",
       FontSlant->"Plain"], 
      StyleBox["red",
       FontSlant->"Plain"]], "\[RightBracketingBar]"}], "\[GreaterGreater]", 
    SubsuperscriptBox[
     StyleBox["Gi",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "74a94c82-dbf6-4b00-8ecf-0a482b1e22b9"],
 ", and the critical region, where it fails, has the width of about ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["Gi",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["c",
       FontSlant->"Plain"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f2e86a9d-878c-4cca-8391-234a550fe7c0"],
 " on both sides of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["c",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a349af36-d81e-4ab0-89f1-015c9f73bd35"],
 ". The second form shows the meaning: the correlation length of mean-field \
theory is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Xi]", 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["GL",
       FontSlant->"Plain"]}]], 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      SubsuperscriptBox[
       StyleBox["t", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["red",
        FontSlant->"Plain"]], "\[RightBracketingBar]"}], 
     RowBox[{
      RowBox[{"-", "1"}], "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6b0546e0-0b6e-4075-8858-4fdc64e02bd0"],
 ", and mean-field theory needs many degrees of freedom in a correlation \
volume, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", 
    SubsuperscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[Xi]", 
       StyleBox["SF",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["GL",
         FontSlant->"Plain"]}]], ")"}], "3"], "\[GreaterGreater]", "1"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7cb3bb2e-e491-4015-bf1a-9bf4a4e205c2"],
 ". ",
 StyleBox["A remark on the factors (what it means and why it matters).",
  FontWeight->"Bold"],
 " Other forms of the criterion (the mean square fluctuation of the field in \
a correlation volume against the square of its mean value, or the first \
correction to ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["b", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["Tay",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3b883f56-e236-477e-8964-129399935f70"],
 " against ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["b", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["Tay",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3f24987a-a093-4763-9c73-ac63aa61123d"],
 ") give the same combination of ",
 Cell[BoxData[
  FormBox["\[Alpha]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e617fd26-fa01-4813-a6b1-c35c9763dd0a"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["b", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7681a48f-4d78-4762-8f8c-2a59abdd18e4"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["c",
    FontFamily->"Helvetica",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "de876018-48e1-4e4e-a3ac-379ed3aa1ff8"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["c",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3a041f45-f9cc-44d2-9bf1-8f6e55efd178"],
 " with other numerical factors of order one, and books on the subject differ \
by such factors. The formula above is the definition used here. It matters \
only when the number is near 1; the numbers found below are far above 1, so a \
factor of order one does not change the conclusion."
}], "Text",ExpressionUUID->"d3055ccc-8bbc-4822-a76f-0b39a58607e2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
III.G.2 The coefficient of the field of a moving pair: the static pair \
response\
\>", "Section",ExpressionUUID->"e5e87c55-b8de-4b60-9ba4-d826b84bfbe6"],

Cell[TextData[{
 "A pair field with the momentum ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["q", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["pair",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0b6fd3d5-b02f-4793-b648-47b9541f523c"],
 " along ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox[
     StyleBox["e", "TI"], "\[RightVector]"], "3"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "199ed01f-9bf9-4b94-a8e4-5bc3caf07201"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
    RowBox[{"(", 
     OverscriptBox[
      StyleBox["x", "TI"], "\[RightVector]"], ")"}], "\[LongEqual]", 
    OverscriptBox["\[CapitalPhi]", "\[RightVector]"], "\[ThinSpace]", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      StyleBox["i", "TI"], 
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["pair",
        FontSlant->"Plain"]], 
      SuperscriptBox[
       StyleBox["x", "TI"], "3"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "627ad814-6922-42ee-8580-6596bbd00d7e"],
 ", has the gradient term ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["c",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["pair",
        FontSlant->"Plain"]], ")"}], "2"], 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
      "\[RightBracketingBar]"}], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e98339f2-f9c8-423e-882d-6b1fe06fd6eb"],
 ", so its coefficient of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["\[CapitalPhi]", "\[RightVector]"], 
     "\[RightBracketingBar]"}], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7c402d9f-ed7d-4470-9ca2-1789c6d6379f"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["Tay",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["pair",
        FontSlant->"Plain"]], ";", 
      StyleBox["T", "TI"]}], ")"}], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["Tay",
       FontSlant->"Plain"]}]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}], "+", 
    SubsuperscriptBox[
     StyleBox["c",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["X", "TI"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["pair",
        FontSlant->"Plain"]], ")"}], "2"], "+", 
    StyleBox["O", "TI"], 
    RowBox[{"(", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["q", "TI"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        StyleBox["pair",
         FontSlant->"Plain"]], ")"}], "4"], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dba4bcc7-e73f-4c8c-a1ae-fdf11fd1cacc"],
 ". The state of a moving pair pairs the momenta ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     StyleBox["q", "TI"], "\[RightVector]"], "+", 
    FractionBox["1", "2"], 
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["pair",
      FontSlant->"Plain"]], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["e", "TI"], "\[RightVector]"], "3"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "580863ec-29d1-4ef1-820d-08c636f62ca4"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     OverscriptBox[
      StyleBox["q", "TI"], "\[RightVector]"]}], "+", 
    FractionBox["1", "2"], 
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["pair",
      FontSlant->"Plain"]], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["e", "TI"], "\[RightVector]"], "3"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2fd7900f-86b5-4c02-817d-8240f13b2e18"],
 " (relative momentum ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["q", "TI"], "\[RightVector]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "061291d4-c61d-4c36-8a13-247978efd24d"],
 "). After the gauge transformation ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPsi]", "\[RightArrow]", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      StyleBox["i", "TI"], 
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["SF",
        FontSlant->"Plain"], 
       StyleBox["pair",
        FontSlant->"Plain"]], 
      SuperscriptBox[
       StyleBox["x", "TI"], "3"], "/", "2"}]], "\[CapitalPsi]"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1807391f-c54c-4059-9d3a-458d3f8658e8"],
 ", which makes the pair field uniform, it is the thermal state of the matrix \
of Bogoliubov and de Gennes (Section II.2) with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["h",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     RowBox[{"\[PlusMinus]", 
      OverscriptBox[
       StyleBox["q", "TI"], "\[RightVector]"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d6920d75-6b9d-497a-bf86-800b2d5fbed6"],
 " replaced by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["h",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     RowBox[{"\[PlusMinus]", 
      OverscriptBox[
       StyleBox["q", "TI"], "\[RightVector]"]}], ")"}], "+", 
    SubsuperscriptBox[
     StyleBox["T",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["tw",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b8b8eddd-43b4-4feb-be0b-9cbc67441dee"],
 ", the ",
 StyleBox["twist",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["T",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["tw",
      FontSlant->"Plain"]], "\[LongEqual]", 
    FractionBox["1", "2"], 
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["pair",
      FontSlant->"Plain"]], "\[ThinSpace]", 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], "3"], "\[CircleTimes]", 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "04d99c25-1a35-474a-8074-9316bea7f675"],
 ", with the normal self-energy ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["N",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["n",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d755c52d-90f9-42e6-a30a-01b5b7921d56"],
 " of the normal state at ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0ff25de0-8b18-48fe-a6f1-afac9c9f07bc"],
 " (a change of the normal self-energy changes the free energy only at fourth \
order in the field, because the free energy is stationary in it) and with a \
small antisymmetric pair block ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["P",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["a",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a182b969-17e6-4b3e-8051-4ab4f1179b91"],
 ". To first order in ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["P",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["a",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "47ca6b8f-a5d4-4166-80b1-de7fff2412dc"],
 " the pair matrix summed over the momenta, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["C",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["p",
       FontSlant->"Plain"], ",", 
      StyleBox["tot",
       FontSlant->"Plain"]}]], "\[LongEqual]", "\[Integral]", "\[ThinSpace]", 
    
    FractionBox[
     RowBox[{
      SuperscriptBox[
       StyleBox["d", "TI"], "3"], 
      StyleBox["q", "TI"]}], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"2", "\[Pi]"}], ")"}], "3"]], 
    SubsuperscriptBox[
     StyleBox["C",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     OverscriptBox[
      StyleBox["q", "TI"], "\[RightVector]"], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "39c108ab-5ad1-4f0d-ae82-397290dbb804"],
 ", is the ",
 StyleBox["static pair response",
  FontWeight->"Bold"]
}], "Text",ExpressionUUID->"a7961d61-7aa0-4a0b-8211-df5532671ad9"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["C",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["p",
      FontSlant->"Plain"], ",", 
     StyleBox["tot",
      FontSlant->"Plain"]}]], "\[LongEqual]", 
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalX]",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["P",
     FontSlant->"Plain"]], 
   RowBox[{"[", 
    SubsuperscriptBox[
     StyleBox["P",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["a",
      FontSlant->"Plain"]], "]"}], "\[LongEqual]", 
   RowBox[{"-", "\[Integral]"}], "\[ThinSpace]", 
   FractionBox[
    RowBox[{
     SuperscriptBox[
      StyleBox["d", "TI"], "3"], 
     StyleBox["q", "TI"]}], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"2", "\[Pi]"}], ")"}], "3"]], "\[ThinSpace]", 
   UnderoverscriptBox["\[Sum]", 
    RowBox[{
     StyleBox["a", "TI"], ",", 
     StyleBox["b", "TI"], "\[LongEqual]", "1"}], "8",
    LimitsPositioning->True], "\[ThinSpace]", 
   FractionBox[
    RowBox[{
     StyleBox["f", "TI"], 
     RowBox[{"(", 
      SubsuperscriptBox["\[CurlyEpsilon]", 
       RowBox[{
        StyleBox["SF",
         FontSlant->"Plain"], ",", 
        StyleBox["a", "TI"]}], 
       StyleBox["A",
        FontSlant->"Plain"]], ")"}], "-", 
     StyleBox["f", "TI"], 
     RowBox[{"(", 
      SubsuperscriptBox["\[CurlyEpsilon]", 
       RowBox[{
        StyleBox["SF",
         FontSlant->"Plain"], ",", 
        StyleBox["b", "TI"]}], 
       StyleBox["D",
        FontSlant->"Plain"]], ")"}]}], 
    RowBox[{
     SubsuperscriptBox["\[CurlyEpsilon]", 
      RowBox[{
       StyleBox["SF",
        FontSlant->"Plain"], ",", 
       StyleBox["a", "TI"]}], 
      StyleBox["A",
       FontSlant->"Plain"]], "-", 
     SubsuperscriptBox["\[CurlyEpsilon]", 
      RowBox[{
       StyleBox["SF",
        FontSlant->"Plain"], ",", 
       StyleBox["b", "TI"]}], 
      StyleBox["D",
       FontSlant->"Plain"]]}]], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["u",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["a", "TI"]}]], 
   SubsuperscriptBox[
    StyleBox["u",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["a", "TI"]}], "\[Dagger]"], "\[ThinSpace]", 
   SubsuperscriptBox[
    StyleBox["P",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    StyleBox["a",
     FontSlant->"Plain"]], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["w",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["b", "TI"]}]], 
   SubsuperscriptBox[
    StyleBox["w",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["b", "TI"]}], "\[Dagger]"], ","}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"187f872d-a0aa-4015-b884-818c4e6f3cc5"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CurlyEpsilon]", 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["a", "TI"]}], 
    StyleBox["A",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2d374141-842a-41df-b3b4-9dc0d6b85994"],
 " and the normalized eigenvectors ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["u",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["a", "TI"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0f4697eb-b4bd-45ab-9697-5d4e3985a4bc"],
 " are those of the particle block ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["h",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     OverscriptBox[
      StyleBox["q", "TI"], "\[RightVector]"], ")"}], "+", 
    SubsuperscriptBox[
     StyleBox["N",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["n",
      FontSlant->"Plain"]], "+", 
    SubsuperscriptBox[
     StyleBox["T",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["tw",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7f66db47-3442-4a67-8a65-8b3681645d40"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CurlyEpsilon]", 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["b", "TI"]}], 
    StyleBox["D",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "619ae573-65bf-4fb9-8943-a844df8d05f3"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["w",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["SF",
      FontSlant->"Plain"], ",", 
     StyleBox["b", "TI"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e6a06ccc-6d3f-4251-b2f5-0c059dc75845"],
 " those of the hole block ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["h",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["LL",
         FontSlant->"Plain"]], 
       RowBox[{"(", 
        RowBox[{"-", 
         OverscriptBox[
          StyleBox["q", "TI"], "\[RightVector]"]}], ")"}], "+", 
       SubsuperscriptBox[
        StyleBox["N",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        StyleBox["n",
         FontSlant->"Plain"]], "+", 
       SubsuperscriptBox[
        StyleBox["T",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["SF",
         FontSlant->"Plain"], 
        StyleBox["tw",
         FontSlant->"Plain"]]}], ")"}], 
     StyleBox["T", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d8a3da29-b750-418c-85bb-cb3d1dfca717"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["f", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "aebd3d62-fd19-4b0d-a613-2abff7ef7293"],
 " is the Fermi function, and the quotient is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["f", "TI"], "\[Prime]"], 
    RowBox[{"(", "\[CurlyEpsilon]", ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8f42e818-d20a-4a76-a1ca-bec88df527a0"],
 " where the two energies coincide (the first-order term of the function ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["f", "TI"], 
    RowBox[{"(", 
     SubscriptBox[
      StyleBox["H",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["SF",
       FontSlant->"Plain"]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "969db640-61a4-4a78-bdb3-e7502d520b90"],
 " of a Hermitian matrix in its off-diagonal block). The free energy of the \
state, measured from the normal state at ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "129a815c-25be-4294-ad76-e6a2d581af22"],
 ", is to second order"
}], "Text",ExpressionUUID->"d0358f68-db16-4abe-8de3-81b1ca75640b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalF]",
     FontSlant->"Plain"], 
    RowBox[{"2", ",", 
     StyleBox["SF",
      FontSlant->"Plain"]}], 
    StyleBox["X", "TI"]], "\[LongEqual]", 
   FractionBox["1", "2"], "\[ThinSpace]", 
   StyleBox["Re",
