Cell[CellGroupData[{

Cell["\<\
R.2.3 The triplet pairs of the earlier superfluid (check WSF-4)\
\>", "Subsection",ExpressionUUID->"422972b9-2b19-49c4-8ea9-441bdf150aeb"],

Cell[TextData[{
 "In KS and CJT the contact terms of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "04c1713d-e267-4ed9-912d-d7c34104b0da"],
 " give the scalar triplet pairs of Parts II and III the coupling ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", "4"]}], 
    SubsuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["S",
      FontSlant->"Plain"]], "-", 
    SubsuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     StyleBox["V",
      FontSlant->"Plain"]], "\[LongEqual]", 
    FractionBox["6", "5"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4b864740-c877-4a13-a28b-8bec4502c39c"],
 ", and in the normal vacuum the eigenvalue ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Lambda]", 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["T",
      FontSlant->"Plain"]], "\[LongEqual]", 
    FractionBox["6", "5"], "/", 
    SubsuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["crit",
      FontSlant->"Plain"]], "\[LongEqual]", 
    FractionBox["6", "5"], 
    SubsuperscriptBox[
     StyleBox["I", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{"(", "1", ")"}]], 
    RowBox[{"(", 
     FractionBox["1", "5"], ")"}], "/", 
    SuperscriptBox["\[Pi]", "2"], "\[TildeTilde]", "0.056"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "44c4ce34-9558-461e-a599-1fa54152c7d7"],
 ", far below 1: the superfluid of the earlier hypotheses does not form under \
the revised ones, which change only the fields and the pairing."
}], "Text",ExpressionUUID->"76b59214-9184-46f1-944b-f1489ae2be02"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"WSF", "-", "4"}], ":", " ", 
    RowBox[{"the", " ", "triplet", " ", "pair", " ", "coupling"}]}], " ", 
   "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"gTrip", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", "1"}], "/", "4"}], " ", 
       RowBox[{"(", 
        RowBox[{"-", "8"}], ")"}]}], " ", "-", " ", 
      RowBox[{"4", "/", "5"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"lamTrip", " ", "=", " ", 
     RowBox[{"gTrip", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Pi", "^", "2"}], "/", 
        RowBox[{"i1closed", "[", "mLL", "]"}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"lamTripRust", " ", "=", " ", 
     RowBox[{"num", "[", 
      RowBox[{
       RowBox[{"rowOf", "[", 
        RowBox[{"\"\<V1_SH\>\"", ",", " ", "\"\<CJT\>\""}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"col", "[", 
         RowBox[{"hdr", ",", " ", "\"\<lam_triplet\>\""}], "]"}], "]"}], 
       "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dev4", " ", "=", " ", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"N", "[", 
        RowBox[{"lamTrip", ",", " ", "30"}], "]"}], " ", "-", " ", 
       "lamTripRust"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rvCheck", "[", 
     RowBox[{"\"\<WSF-4\>\"", ",", " ", 
      RowBox[{"\"\<the scalar triplet pair coupling of KS and CJT, -(1/4) G^S \
- G^V = \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"gTrip", ",", " ", "InputForm"}], "]"}], " ", "<>", "\n", 
       "  ", "\"\<, and its eigenvalue in the normal vacuum, (6/5) I1(1/5) / \
pi^2 = \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"NumberForm", "[", 
         RowBox[{
          RowBox[{"N", "[", 
           RowBox[{"lamTrip", ",", " ", "16"}], "]"}], ",", " ", "16"}], 
         "]"}], "]"}], " ", "<>", "\n", 
       "  ", "\"\<, against the Rust value\>\""}], ",", " ", 
      RowBox[{
       RowBox[{"gTrip", " ", "==", " ", 
        RowBox[{"6", "/", "5"}]}], " ", "&&", " ", 
       RowBox[{"dev4", " ", "<", " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "9"}]}]}]}], ",", " ", 
      RowBox[{"\"\<deviation \>\"", " ", "<>", " ", 
       RowBox[{"sci", "[", "dev4", "]"}]}]}], "]"}], ";"}]}]}]], "Input",
 CellLabel->
  "In[613]:=",ExpressionUUID->"a475a0de-5b2a-4b00-af76-d66d14716033"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"PASS \"\>", "\[InvisibleSpace]", "\<\"WSF-4\"\>", 
   "\[InvisibleSpace]", "\<\"  \"\>", 
   "\[InvisibleSpace]", "\<\"the scalar triplet pair coupling of KS and CJT, \
-(1/4) G^S - G^V = 6/5, and its eigenvalue in the normal vacuum, (6/5) \
I1(1/5) / pi^2 = 0.05637346734780750, against the Rust value\"\>", 
   "\[InvisibleSpace]", "\<\" [\"\>", 
   "\[InvisibleSpace]", "\<\"deviation 8.097e-12\"\>", 
   "\[InvisibleSpace]", "\<\"]   [the same check: Rust \"\>", 
