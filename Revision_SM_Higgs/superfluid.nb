Cell[CellGroupData[{

Cell["R.2 The ground state of the superfluid (stage 3)", "Section",ExpressionUUID->"644c74e5-8ddb-4f44-b89a-8e2ad28ee47f"],

Cell[TextData[{
 "Stage 3 computed the ground state of the three fields by the five methods, \
in the normal vacuum and with the pairing terms switched on. ",
 StyleBox["The normal vacuum.",
  FontWeight->"Bold"],
 " Without a condensate the ground state is the vacuum of the free Dirac \
fields; it is unstable towards a condensate in a channel when the largest \
eigenvalue of its static response in that channel exceeds 1, and the pairing \
terms give the doublet-singlet pairs the eigenvalue ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]], "/", 
    SubsuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["crit",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e3acdb11-8584-4bb6-85e8-93c00e203c67"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["crit",
      FontSlant->"Plain"]], "\[LongEqual]", "4", 
    SuperscriptBox["\[Pi]", "2"], "/", 
    SubsuperscriptBox[
     StyleBox["I", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{"(", "1", ")"}]], 
    RowBox[{"(", 
     SubscriptBox[
      StyleBox["m", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a9873cf6-dcff-4afa-b2d6-263804561dd8"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["I", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{"(", "1", ")"}]], 
    RowBox[{"(", 
     StyleBox["M", "TI"], ")"}], "\[LongEqual]", 
    SubsuperscriptBox["\[Integral]", "0", 
     SubscriptBox["\[CapitalLambda]", 
      StyleBox["LL",
       FontSlant->"Plain"]]], "\[ThinSpace]", 
    SuperscriptBox[
     StyleBox["q", "TI"], "2"], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        StyleBox["q", "TI"], "2"], "+", 
       SuperscriptBox[
        StyleBox["M", "TI"], "2"]}], ")"}], 
     RowBox[{
      RowBox[{"-", "1"}], "/", "2"}]], 
    StyleBox["dq", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "95e053a4-9c29-428d-ae19-bd902798732b"],
 ". With ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]], "\[LongEqual]", "100.8"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "154677ab-3ca6-4a94-9800-97c92a1188a8"],
 " this eigenvalue is about 1.18, eightfold in the second version (two \
doublets, each component with its real and its imaginary part), and the \
normal vacuum is unstable towards the pairs. ",
 StyleBox["The ground state.",
  FontWeight->"Bold"],
 " In every method it is the custodial condensate: the down component of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5b64d8f0-31c0-4c3e-9744-00835660b638"],
 " is paired with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Chi]", 
    StyleBox["SH",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a9b6f56a-9ab3-4cea-9174-5b5aac37193c"],
 " and the up component with ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Chi]", 
    StyleBox["SH",
     FontSlant->"Plain"], "\[Prime]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "55cd0927-beb6-4139-8081-ff70f877a83f"],
 ", with equal singular values ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[FinalSigma]", 
     StyleBox["SH",
      FontSlant->"Plain"], 
     RowBox[{"(", "1", ")"}]], "\[LongEqual]", 
    SubsuperscriptBox["\[FinalSigma]", 
     StyleBox["SH",
      FontSlant->"Plain"], 
     RowBox[{"(", "2", ")"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8611e164-aa71-42d0-96d3-a0c4aec5eed0"],
 " of the bidoublet of the coefficients of the pair self-energy; it breaks ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["L", "TI"]], "\[Times]", 
    StyleBox["U", "TI"], 
    SubscriptBox[
     RowBox[{"(", "1", ")"}], 
     StyleBox["Y", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "05cf883b-7ffc-4184-a7fe-928adbf9a6ba"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["U", "TI"], 
    SubscriptBox[
     RowBox[{"(", "1", ")"}], 
     StyleBox["Q", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e1360e2a-254f-4c89-88f5-1769d11ce372"],
 " and keeps ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU", "TI"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["V",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5e9dc323-ec7a-4655-9d4f-f454315cdf5f"],
 " (Section R.1.11). The checks of this section derive in exact arithmetic \
the formulas with which the Rust program compares its static responses and \
its ground states. The section starts from a clean slate."
}], "Text",ExpressionUUID->"b8c79804-4a4e-4065-ac15-4d96dac1c833"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"--", " ", "Section"}]}], " ", "R", ".2", " ", "starts", " ", 
    "from", " ", "a", " ", "clean", " ", 
    RowBox[{
     RowBox[{"slate", " ", "--"}], "--"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"rvClean", "[", "]"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "the", " ", "names", " ", "of", " ", "the", " ", "two", " ", "tables", " ",
      "of", " ", "the", " ", "Rust", " ", "program", " ", "sh_superfluid", " ",
      "that", " ", "this", " ", "section", " ", "reads", " ", 
     RowBox[{"(", 
      RowBox[{"rows", " ", "of", " ", "the", " ", "data", " ", "cell"}], 
      ")"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"nvFile", ",", " ", "grFile"}], "}"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<sh_sf_normal_vacuum.csv\>\"", ",", 
       " ", "\"\<sh_sf_ground.csv\>\""}], "}"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"--", 
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", 
          RowBox[{"--", 
           RowBox[{"--", 
            RowBox[{"--", 
             RowBox[{"--", 
              RowBox[{"--", 
               RowBox[{"--", 
                RowBox[{"--", 
                 RowBox[{"--", 
                  RowBox[{"--", 
                   RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{
                    "--", " ", 
                    "matrices"}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]\
}]}]}]}]}]}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"sig", "[", "0", "]"}], " ", "=", " ", 
     RowBox[{"IdentityMatrix", "[", "2", "]"}]}], ";", " ", 
    RowBox[{
     RowBox[{"sig", "[", "1", "]"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}]}], "}"}]}], ";", " ", 
    RowBox[{
     RowBox[{"sig", "[", "2", "]"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", 
         RowBox[{"-", "I"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"I", ",", " ", "0"}], "}"}]}], "}"}]}], ";", " ", 
    RowBox[{
     RowBox[{"sig", "[", "3", "]"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", 
         RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"sigbar", "[", "0", "]"}], " ", "=", " ", 
     RowBox[{"sig", "[", "0", "]"}]}], ";", " ", 
    RowBox[{
     RowBox[{"sigbar", "[", "j_", "]"}], " ", ":=", " ", 
     RowBox[{"-", 
      RowBox[{"sig", "[", "j", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"z2", " ", "=", " ", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"gam", "[", "p_", "]"}], " ", ":=", " ", 
     RowBox[{"ArrayFlatten", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"z2", ",", " ", 
          RowBox[{"sig", "[", "p", "]"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"sigbar", "[", "p", "]"}], ",", " ", "z2"}], "}"}]}], "}"}],
       "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gch", " ", "=", " ", 
     RowBox[{"I", " ", 
      RowBox[{
       RowBox[{"gam", "[", "0", "]"}], ".", 
       RowBox[{"gam", "[", "1", "]"}], ".", 
       RowBox[{"gam", "[", "2", "]"}], ".", 
       RowBox[{"gam", "[", "3", "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"cC", " ", "=", " ", 
     RowBox[{"I", " ", 
      RowBox[{
       RowBox[{"gam", "[", "2", "]"}], ".", 
       RowBox[{"gam", "[", "0", "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"bet", " ", "=", " ", 
     RowBox[{"gam", "[", "0", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"eps2", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "0"}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"aa", " ", "=", " ", 
     RowBox[{"cC", ".", "gch"}]}], ";"}], 
   "                                     ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "Lorentz", " ", "scalar", " ", "pair", " ", "matrix", " ", 
      "C", " ", 
      RowBox[{"gamma", "^", "ch"}]}], ",", " ", 
     RowBox[{"4", " ", "x", " ", "4"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"eIso", "[", "s_", "]"}], " ", ":=", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"s", " ", "==", " ", "0"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", "1", "}"}], ",", " ", 
         RowBox[{"{", "0", "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", "0", "}"}], ",", " ", 
         RowBox[{"{", "1", "}"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"upIdx", " ", "=", " ", 
     RowBox[{"Range", "[", 
      RowBox[{"1", ",", " ", "8", ",", " ", "2"}], "]"}]}], ";", " ", 
    RowBox[{"dnIdx", " ", "=", " ", 
     RowBox[{"Range", "[", 
      RowBox[{"2", ",", " ", "8", ",", " ", "2"}], "]"}]}], ";", " ", 
    RowBox[{"chiIdx", " ", "=", " ", 
     RowBox[{"Range", "[", 
      RowBox[{"9", ",", " ", "12"}], "]"}]}], ";", " ", 
    RowBox[{"chi2Idx", " ", "=", " ", 
     RowBox[{"Range", "[", 
      RowBox[{"13", ",", " ", "16"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"z44", " ", "=", " ", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", " ", 
       RowBox[{"{", 
        RowBox[{"4", ",", " ", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"k3", " ", "=", " ", 
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{"aa", ",", " ", 
       RowBox[{"eps2", ".", 
        RowBox[{"sig", "[", "3", "]"}]}]}], "]"}]}], ";"}], "        ", 
   RowBox[{"(*", " ", 
    RowBox[{
    "the", " ", "old", " ", "triplet", " ", "matrix", " ", "on", " ", "the", " ",
      "eight", " ", "components"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"vS", "[", "s_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{"aa", ",", " ", 
        RowBox[{"eIso", "[", "s", "]"}]}], "]"}], "/", "2"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "the", " ", "pair", " ", "matrix", " ", "of", " ", "Psi_LL", " ", "with", 
     " ", "the", " ", "singlet", " ", "a", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"0", ":", " ", "chi_SH"}], ",", " ", 
       RowBox[{"1", ":", " ", 
        RowBox[{
         RowBox[{"chi", "'"}], "_SH"}]}]}], ")"}], " ", "and", " ", "the", " ",
      "isospin", " ", "component", " ", "s"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"kP", "[", 
      RowBox[{"a_", ",", " ", "s_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"k", " ", "=", " ", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0", ",", " ", 
            RowBox[{"{", 
             RowBox[{"16", ",", " ", "16"}], "}"}]}], "]"}]}], ",", " ", 
         RowBox[{"o", " ", "=", " ", 
          RowBox[{"8", " ", "+", " ", 
           RowBox[{"4", " ", "a"}]}]}]}], "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{
         RowBox[{"k", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"1", " ", ";;", " ", "8"}], ",", " ", 
            RowBox[{
             RowBox[{"o", " ", "+", " ", "1"}], " ", ";;", " ", 
             RowBox[{"o", " ", "+", " ", "4"}]}]}], "]"}], "]"}], " ", "=", 
         " ", 
         RowBox[{"vS", "[", "s", "]"}]}], ";", " ", 
        RowBox[{
         RowBox[{"k", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{
             RowBox[{"o", " ", "+", " ", "1"}], " ", ";;", " ", 
             RowBox[{"o", " ", "+", " ", "4"}]}], ",", " ", 
            RowBox[{"1", " ", ";;", " ", "8"}]}], "]"}], "]"}], " ", "=", " ", 
         RowBox[{"-", 
          RowBox[{"Transpose", "[", 
           RowBox[{"vS", "[", "s", "]"}], "]"}]}]}], ";", " ", "k"}]}], 
      "]"}]}], ";"}]}]}]], "Input",
 CellLabel->
  "In[560]:=",ExpressionUUID->"142990d8-8d7b-4602-af11-4cbff5273d39"],

Cell[CellGroupData[{

Cell["\<\
R.2.1 The pair matrices and the critical coupling (checks WSF-2a and WSF-2b)\
\>", "Subsection",ExpressionUUID->"b75496e0-c4a8-4ba9-a806-6c9999b7da88"],

Cell[TextData[{
 "On the whole field ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["SH",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "148b745e-d697-47b7-a94c-9883e350a237"],
 " of sixteen components a pair reads ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalPsi]", 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["T", "TI"]], 
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["SH",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "79242f64-1dbd-45d3-b077-f82833bc74e1"],
 " with an antisymmetric matrix ",
 Cell[BoxData[
  FormBox[
   StyleBox["K",
    FontFamily->"Helvetica",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dfae1801-87df-4710-8311-db661e589952"],
 ". The triplet matrix ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "80287926-eee1-4f4b-bce8-598ed2a20fa9"],
 " of Parts II and III, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["ch",
      FontSlant->"Plain"]], "\[CircleTimes]", "\[Epsilon]", 
    SuperscriptBox["\[Tau]", "3"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "883e8be0-8f4a-4034-9e5f-1c18d07f6c92"],
 " on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "08862a4a-555b-459b-9851-40bcb7f03460"],
 ", couples the up and the down components through the blocks ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     SubscriptBox[
      StyleBox["C", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"]]}], 
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["ch",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5aea1fe4-d7c3-4d22-a39c-3390501525ba"],
 ", so that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[CapitalPsi]", 
     StyleBox["T", "TI"]], 
    SuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "3"], "\[CapitalPsi]", "\[LongEqual]", 
    RowBox[{"-", "2"}], 
    SubsuperscriptBox["\[CapitalPsi]", 
     StyleBox["u",
      FontSlant->"Plain"], 
     StyleBox["T", "TI"]], 
    SubscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["ch",
      FontSlant->"Plain"]], 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["d",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f01bcaf4-2eab-43af-8cc6-115e479cdd7c"],
 ". The pair matrices of the revision, ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SH",
     FontSlant->"Plain"], 
    StyleBox["d",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8670e076-ee26-49d7-b728-8db87cc4a26d"],
 " (the down components with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Chi]", 
    StyleBox["SH",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f5b55ce4-2852-497b-a442-ec7ce87c9ede"],
 ") and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["SH",
     FontSlant->"Plain"], 
    RowBox[{"\[Prime]", 
     StyleBox["u",
      FontSlant->"Plain"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "978065ed-1a6c-48eb-907e-05248a2468ab"],
 " (the up components with ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Chi]", 
    StyleBox["SH",
     FontSlant->"Plain"], "\[Prime]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "573b4a47-85dd-4bac-af5c-6d6577644c5d"],
 "), have the blocks ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["ch",
      FontSlant->"Plain"]], "/", "2"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c912757f-bf6e-46ee-b4db-f8b3c494c8c1"],
 ": the same Lorentz channel between two Dirac fields of equal mass, with \
half the coefficient. A pairing term ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{
       StyleBox["G", "TI"], "/", "4"}], ")"}]}], 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      RowBox[{
       SuperscriptBox["\[CapitalPsi]", 
        StyleBox["T", "TI"]], 
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], "\[CapitalPsi]"}], "\[RightBracketingBar]"}], 
     "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7b329101-9461-4d65-8cfb-c2268642d89a"],
 " therefore needs four times the coupling of the triplet channel to reach \
the same strength: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["crit",
      FontSlant->"Plain"]], "\[LongEqual]", "4", 
    SubsuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["crit",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0eabbdd8-3ae4-4617-a05e-937a9f3b912b"],
 ", with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["crit",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox["\[Pi]", "2"], "/", 
    SubsuperscriptBox[
     StyleBox["I", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{"(", "1", ")"}]], 
    RowBox[{"(", 
     SubscriptBox[
      StyleBox["m", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2865faa1-f3ac-4fa5-bd56-633586327bb1"],
 ". ",
 StyleBox["WSF-2b.",
  FontWeight->"Bold"],
 " The integral has the closed form"
}], "Text",ExpressionUUID->"c32ba422-23fb-4671-b2d1-5b284df9375f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["I", "TI"], 
    StyleBox["SF",
     FontSlant->"Plain"], 
    RowBox[{"(", "1", ")"}]], 
   RowBox[{"(", 
    StyleBox["m", "TI"], ")"}], "\[LongEqual]", 
   SubsuperscriptBox["\[Integral]", "0", "1"], "\[ThinSpace]", 
   FractionBox[
    RowBox[{
     SuperscriptBox[
      StyleBox["q", "TI"], "2"], "\[ThinSpace]", 
     StyleBox["dq", "TI"]}], 
    SqrtBox[
     RowBox[{
      SuperscriptBox[
       StyleBox["q", "TI"], "2"], "+", 
      SuperscriptBox[
       StyleBox["m", "TI"], "2"]}]]], "\[LongEqual]", 
   FractionBox["1", "2"], 
   RowBox[{"(", 
    RowBox[{
     SqrtBox[
      RowBox[{"1", "+", 
       SuperscriptBox[
        StyleBox["m", "TI"], "2"]}]], "-", 
     SuperscriptBox[
      StyleBox["m", "TI"], "2"], "\[ThinSpace]", 
     StyleBox["arsinh",
      FontSlant->"Plain"], 
     FractionBox["1", 
      StyleBox["m", "TI"]]}], ")"}], ","}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"ac96cbf7-18e5-47ca-8fe3-bcd01fead97b"],

Cell[TextData[{
 "checked against the exact integral at ten masses with 40 digits, which \
gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["crit",
      FontSlant->"Plain"]], "\[LongEqual]", "4", 
    SuperscriptBox["\[Pi]", "2"], "/", 
    SubsuperscriptBox[
     StyleBox["I", "TI"], 
     StyleBox["SF",
      FontSlant->"Plain"], 
     RowBox[{"(", "1", ")"}]], 
    RowBox[{"(", 
     FractionBox["1", "5"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "01c31f81-5394-4749-bb25-96b5ca608fdd"],
 " and the ratio ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]], "/", 
    SubsuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"], 
     StyleBox["crit",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b9f4c9e9-8108-44a1-88bc-56e7e25342cb"],
 " (with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["SH",
      FontSlant->"Plain"]], "\[LongEqual]", "504", "/", "5"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7a073bd3-94d2-44ab-a02e-6bff49f9ff7f"],
 " exactly), to be compared with the eigenvalue ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Lambda]", 
    StyleBox["SH",
     FontSlant->"Plain"], 
    StyleBox["H",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a80c9573-95ab-4ae7-9193-a95704a37f2c"],
 " of the Rust program in both versions."
}], "Text",ExpressionUUID->"bb081ce3-719d-4ea8-af0f-2e1cb6aab0e5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"WSF", "-", 
    RowBox[{"2", 
     RowBox[{"a", ":", " ", 
      RowBox[{
      "the", " ", "blocks", " ", "of", " ", "the", " ", "pair", " ", 
       "matrices"}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"blockOf", "[", 
      RowBox[{"m_", ",", " ", "r_", ",", " ", "c_"}], "]"}], " ", ":=", " ", 
     RowBox[{"m", "[", 
      RowBox[{"[", 
       RowBox[{"r", ",", " ", "c"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ok2a", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"blockOf", "[", 
        RowBox[{"k3", ",", " ", "upIdx", ",", " ", "dnIdx"}], "]"}], " ", "==",
        " ", 
       RowBox[{"-", "aa"}]}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"blockOf", "[", 
        RowBox[{"k3", ",", " ", "dnIdx", ",", " ", "upIdx"}], "]"}], " ", "==",
        " ", 
       RowBox[{"-", "aa"}]}], " ", "&&", "\n", "  ", 
      RowBox[{
       RowBox[{"blockOf", "[", 
        RowBox[{"k3", ",", " ", "upIdx", ",", " ", "upIdx"}], "]"}], " ", "==",
        " ", "z44"}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"blockOf", "[", 
        RowBox[{"k3", ",", " ", "dnIdx", ",", " ", "dnIdx"}], "]"}], " ", "==",
        " ", "z44"}], " ", "&&", "\n", "  ", 
      RowBox[{
       RowBox[{"blockOf", "[", 
        RowBox[{
         RowBox[{"kP", "[", 
          RowBox[{"0", ",", " ", "1"}], "]"}], ",", " ", "dnIdx", ",", " ", 
         "chiIdx"}], "]"}], " ", "==", " ", 
       RowBox[{"aa", "/", "2"}]}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"blockOf", "[", 
        RowBox[{
         RowBox[{"kP", "[", 
          RowBox[{"0", ",", " ", "1"}], "]"}], ",", " ", "chiIdx", ",", " ", 
         "dnIdx"}], "]"}], " ", "==", " ", 
       RowBox[{"aa", "/", "2"}]}], " ", "&&", "\n", "  ", 
      RowBox[{
       RowBox[{"blockOf", "[", 
        RowBox[{
         RowBox[{"kP", "[", 
          RowBox[{"0", ",", " ", "1"}], "]"}], ",", " ", "upIdx", ",", " ", 
         "chiIdx"}], "]"}], " ", "==", " ", "z44"}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"blockOf", "[", 
        RowBox[{
         RowBox[{"kP", "[", 
          RowBox[{"0", ",", " ", "1"}], "]"}], ",", " ", "dnIdx", ",", " ", 
         "chi2Idx"}], "]"}], " ", "==", " ", "z44"}], " ", "&&", "\n", "  ", 
      RowBox[{
       RowBox[{"blockOf", "[", 
        RowBox[{
         RowBox[{"kP", "[", 
          RowBox[{"1", ",", " ", "0"}], "]"}], ",", " ", "upIdx", ",", " ", 
         "chi2Idx"}], "]"}], " ", "==", " ", 
       RowBox[{"aa", "/", "2"}]}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"blockOf", "[", 
        RowBox[{
         RowBox[{"kP", "[", 
          RowBox[{"1", ",", " ", "0"}], "]"}], ",", " ", "chi2Idx", ",", " ", 
         "upIdx"}], "]"}], " ", "==", " ", 
       RowBox[{"aa", "/", "2"}]}], " ", "&&", "\n", "  ", 
      RowBox[{
       RowBox[{"blockOf", "[", 
        RowBox[{
         RowBox[{"kP", "[", 
          RowBox[{"1", ",", " ", "0"}], "]"}], ",", " ", "dnIdx", ",", " ", 
         "chi2Idx"}], "]"}], " ", "==", " ", "z44"}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"blockOf", "[", 
        RowBox[{
         RowBox[{"kP", "[", 
          RowBox[{"1", ",", " ", "0"}], "]"}], ",", " ", "upIdx", ",", " ", 
         "chiIdx"}], "]"}], " ", "==", " ", "z44"}], " ", "&&", "\n", "  ", 
      RowBox[{
       RowBox[{"Transpose", "[", "aa", "]"}], " ", "==", " ", 
       RowBox[{"-", "aa"}]}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"kP", "[", 
         RowBox[{"0", ",", " ", "1"}], "]"}], "]"}], " ", "==", " ", 
       RowBox[{"-", 
        RowBox[{"kP", "[", 
         RowBox[{"0", ",", " ", "1"}], "]"}]}]}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"kP", "[", 
         RowBox[{"1", ",", " ", "0"}], "]"}], "]"}], " ", "==", " ", 
       RowBox[{"-", 
        RowBox[{"kP", "[", 
         RowBox[{"1", ",", " ", "0"}], "]"}]}]}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"Transpose", "[", "k3", "]"}], " ", "==", " ", 
       RowBox[{"-", "k3"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rvCheck", "[", 
     RowBox[{"\"\<WSF-2a\>\"", ",", 
      " ", "\"\<the triplet matrix K^3 couples the up and down components of \
Psi_LL by -C gamma^ch in both blocks \\\n(Psi^T K^3 Psi = -2 Psi_u^T C \
gamma^ch Psi_d); K_d couples the down components and chi_SH, K'_u the up \
components and \\\nchi'_SH, by C gamma^ch / 2 in both blocks: the same \
channel with half the coefficient, so the pairing term \\\n-(G/4) |Psi^T K \
Psi|^2 has the critical coupling G^crit_SH = 4 G^crit_LL\>\"", ",", " ", 
      "ok2a", ",", " ", "\"\<identities of exact matrices\>\""}], "]"}], 
    ";"}]}]}]], "Input",
 CellLabel->
  "In[577]:=",ExpressionUUID->"b3f084fc-5d12-4c70-82fe-0e252c49423c"],

