rvRust = <|"WQN-1" -> "QN-1a to QN-1e", "WQN-2" -> "QN-2a, QN-2b", "WQN-4" -> "QN-4a to QN-4c",
   "WQN-5" -> "QN-5a to QN-5c", "WQN-6" -> "QN-6a to QN-6e", "WQN-7" -> "QN-7", "WQN-8" -> "QN-8a to QN-8g",
   "WQN-9" -> "QN-9a to QN-9d", "WQN-10" -> "QN-10a to QN-10c, QN-10g", "WQN-10e" -> "QN-10e, QN-10f",
   "WQN-11" -> "QN-11b, QN-11d, QN-11e", "WQN-11f" -> "QN-11f, QN-11g", "WQN-12" -> "QN-12b, QN-12d, QN-12f",
   "WSF-2a" -> "SF-2a", "WSF-2b" -> "SF-2a", "WSF-3" -> "SF-3a, SF-3b", "WSF-4" -> "SF-4a", "WSF-5" -> "SF-6a, SF-6b",
   "WH-1" -> "H-4f, H-4g, H-5a, H-5b, H-6b", "WH-2" -> "none (the column M_EFT)", "WH-3" -> "H-2b, H-2c, H-8a",
   "WH-4" -> "none (the columns in GeV)", "WH-5" -> "H-7d, H-8d",
