   "WQN-7" -> "YQN-7", "WQN-8" -> "YQN-8", "WQN-9" -> "YQN-9a, YQN-9b", "WQN-10" -> "YQN-10", "WQN-10e" -> "YQN-10",
   "WQN-11" -> "YQN-11", "WQN-11f" -> "YQN-11", "WQN-12" -> "YQN-12",
   "WSF-2a" -> "YSF-2", "WSF-2b" -> "YSF-2", "WSF-3" -> "YSF-3", "WSF-4" -> "none", "WSF-5" -> "YSF-6, YSF-12",
   "WH-1" -> "YH-2", "WH-2" -> "YH-5", "WH-3" -> "YH-1, YH-3", "WH-4" -> "YH-5", "WH-5" -> "YH-7",
   "WD-1" -> "YD-2a, YD-2b", "WD-2" -> "YD-5", "WD-3" -> "YD-3", "WD-4" -> "none", "WD-5" -> "YD-6"|>;
