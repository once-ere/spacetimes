       RowBox[{"r", "[", "\"\<pass\>\"", "]"}]}]}], "]"}]}]}], "}"}]], "Input",\
ExpressionUUID->"e1a5750d-9f38-46bb-bca7-ac9dbdcd35e6"],

Cell["Part II. The encyclopedia of the programs of Test 2", "Chapter",ExpressionUUID->"da7a0641-8963-4f25-b9e0-f2183fa3fc85"],

Cell[TextData[{
 "Part II rewrites, in the Wolfram Language, every program of Test 2 of the \
super-loop revision, with every check of the original programs. Test 2 asks \
eleven questions (items [1] to [11]): the field equations of a \
self-interacting spinor field on the ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{"3", "+", "1"}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"893fae8d-aa4d-45ea-af25-d65913c2537d"]], "InlineFormula",
  ExpressionUUID->"2e294e22-afbd-462c-9948-c8db001ddf62"],
 " manifold of the super-loop (item [1]), their analysis and analytic \
solutions (item [2]), a solver of the field equations and a plotter of its \
solutions (items [3] to [6], written in Python and in Rust), and the \
construction and the physics of the superfluid boson singlet state, SFBS \
(items [7] to [11]). The original programs are a library and six programs in \
Rust (the library t2core and the programs t2_fields, t2_analytic, t2_solve, \
t2_plot and t2_sfbs) and five programs in Python. Every chapter of Part II \
names the original files that it rewrites, and every check keeps the name \
that it has in the original report (GS-1 to GS-16, AS-1 to AS-10, EX-1 to \
EX-8, SB-1 to SB-17, and the self-tests)."
}], "Text",ExpressionUUID->"b4cc190e-a987-4a5c-8cd2-9bf11d7a15ca"],

Cell[TextData[{
 "Names. The functions of Part II begin with t2 (for Test 2) and keep the \
names of the original functions, written in the style of the Wolfram Language \
(for example the Rust function ",
 StyleBox["model::gamma_ch",
  FontFamily->"Source Code Pro"],
 " is ",
 StyleBox["t2gammaCh",
  FontFamily->"Source Code Pro"],
 "). Indices keep the values of the physics: the space-time index ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "b7bb1ccc-519c-4f91-a588-9f86e9e11817"]], "InlineFormula",ExpressionUUID->
  "af3a025f-3c2a-4af0-bd12-05ffcc299432"],
 " runs over 0, 1, 2, 3, the space index ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    StyleBox["j", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "a9db45ad-9faa-408f-b8fb-66be369a5728"]], "InlineFormula",ExpressionUUID->
  "ceccf7c4-d451-4bd8-a7b7-ef4ea146b31f"],
 " and the isospin index ",
 Cell[BoxData[Cell[BoxData[
   FormBox["\[Iota]", TraditionalForm]], "InlineFormula",ExpressionUUID->
   "37b5775c-9eab-4e2d-8916-f8b635b55383"]], "InlineFormula",ExpressionUUID->
  "219120b5-3f22-42d6-8995-e8ceb57b2050"],
 " over 1, 2, 3. Wherever a result is shown, it is labelled with the \
registered symbol of Part I."
}], "Text",ExpressionUUID->"6a221736-c53e-4a2a-8b81-66b5645ae4ce"],

Cell[TextData[{
 "Components of families. A component of a registered family, for example ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[Gamma]", "LL", "0"], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"f4150fa0-00b0-48b0-98e3-eb8b2e7747f3"]], 
  "InlineFormula",ExpressionUUID->"00f04901-2773-4d59-8ba7-04f4aaf01f87"],
 " of the family ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[Gamma]", "LL", 
     StyleBox["p", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "679342e9-a293-4527-afc3-5c8bbd4e17af"]], "InlineFormula",ExpressionUUID->
  "dd3ce2ef-131f-4c99-b8a7-a9f9d074db29"],
 ", is a symbol of its own, made from the box of the family with the index \
replaced by its value (function ",
 StyleBox["SL31Instance",
  FontFamily->"Source Code Pro"],
 " of Part I). It has to exist before a cell in which it is typed is \
evaluated: the front end sends the whole cell to the kernel, which reads all \
of it before it evaluates the first line, and a component box that is not yet \
symbolized is read as an ordinary expression (for example ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[Gamma]", "LL", "0"], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"3305a143-c9b3-4036-8da1-9be0c03fb466"]], 
  "InlineFormula",ExpressionUUID->"0010b97a-e82e-4e3d-bcb9-8797e189e4dd"],
 " as the power 0 of ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubscriptBox["\[Gamma]", "LL"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"c52075a4-2a69-498e-a181-8e225b5f0726"]], "InlineFormula",
  ExpressionUUID->"3f60e93d-8602-48da-9498-173f179ec605"],
 ", which is 1). The builder of the notebook collects every component that is \
typed anywhere in the notebook, and the next cell makes those that Part I has \
not made already; the check T2-SYM verifies that every one of them is read as \
one atomic symbol."
}], "Text",ExpressionUUID->"6fb3604e-81f6-450f-a616-d9cc75c8e2a7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "the", " ", "components", " ", "typed", " ", "in", " ", "the", " ", 
     "notebook"}], ",", " ", 
    RowBox[{
     RowBox[{"as", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"TeX", " ", "of", " ", "the", " ", "family"}], ",", " ", 
        RowBox[{"index", " ", "->", " ", "value"}], ",", " ", "..."}], 
       "}"}]}], ";", " ", 
     RowBox[{
     "the", " ", "list", " ", "is", " ", "written", " ", "here", " ", "by", "\n",
       "   ", "the", " ", "builder"}]}], ",", " ", 
    RowBox[{
    "which", " ", "collects", " ", "it", " ", "from", " ", "the", " ", 
     "source", " ", "of", " ", "the", " ", "notebook"}]}], " ", "*)"}], "\n", 
  
  RowBox[{
   RowBox[{
    RowBox[{"t2componentSpecs", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<\\\\sigma^{\\\\rm LL}_j\>\"", ",", " ", 
         RowBox[{"\"\<j\>\"", " ", "->", " ", "\"\<1\>\""}]}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"\"\<\\\\sigma^{\\\\rm LL}_j\>\"", ",", " ", 
         RowBox[{"\"\<j\>\"", " ", "->", " ", "\"\<2\>\""}]}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"\"\<\\\\sigma^{\\\\rm LL}_j\>\"", ",", " ", 
         RowBox[{"\"\<j\>\"", " ", "->", " ", "\"\<3\>\""}]}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"\"\<\\\\sigma^{\\\\rm LL}_j\>\"", ",", " ", 
         RowBox[{"\"\<j\>\"", " ", "->", " ", "\"\<0\>\""}]}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"\"\<\\\\gamma^p_{\\\\rm LL}\>\"", ",", " ", 
         RowBox[{"\"\<p\>\"", " ", "->", " ", "\"\<0\>\""}]}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"\"\<\\\\gamma^p_{\\\\rm LL}\>\"", ",", " ", 
         RowBox[{"\"\<p\>\"", " ", "->", " ", "\"\<1\>\""}]}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"\"\<\\\\gamma^p_{\\\\rm LL}\>\"", ",", " ", 
         RowBox[{"\"\<p\>\"", " ", "->", " ", "\"\<2\>\""}]}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"\"\<\\\\gamma^p_{\\\\rm LL}\>\"", ",", " ", 
         RowBox[{"\"\<p\>\"", " ", "->", " ", "\"\<3\>\""}]}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"\"\<\\\\mathsf A_{{\\\\rm LL},p}\>\"", ",", " ", 
         RowBox[{"\"\<p\>\"", " ", "->", " ", "\"\<j\>\""}]}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"\"\<q^j_{\\\\rm LL}\>\"", ",", " ", 
         RowBox[{"\"\<j\>\"", " ", "->", " ", "\"\<1\>\""}]}], "}"}]}], 
      "}"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"their", " ", "boxes"}], ",", " ", 
     RowBox[{
     "made", " ", "exactly", " ", "as", " ", "the", " ", "builder", " ", 
      "made", " ", "the", " ", "boxes", " ", "in", " ", "the", " ", "input", " ",
       "cells"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"t2componentBoxes", " ", "=", " ", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Apply", "[", 
         RowBox[{"SL31`Build`symbolBoxes", ",", " ", "#"}], "]"}], " ", "&"}],
        ",", " ", "t2componentSpecs"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "a", " ", "component", " ", "that", " ", "is", " ", "already", " ", "a", " ",
      "symbol", " ", 
     RowBox[{"(", 
      RowBox[{"made", " ", "in", " ", "Part", " ", "I"}], ")"}], " ", "is", " ",
      "not", " ", "symbolized", " ", "again"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"t2componentNew", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{"t2componentBoxes", ",", " ", 
       RowBox[{
        RowBox[{"!", " ", 
         RowBox[{"MatchQ", "[", 
          RowBox[{
           RowBox[{"SL31SymbolOf", "[", "#", "]"}], ",", " ", 
           RowBox[{"HoldComplete", "[", "_Symbol", "]"}]}], "]"}]}], " ", 
        "&"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Scan", "[", 
     RowBox[{"SL31Symbolize", ",", " ", "t2componentNew"}], "]"}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "like", " ", "the", " ", "symbols", " ", "of", " ", "Part", " ", "I", " ", 
      RowBox[{"(", 
       RowBox[{"section", " ", "I", ".6"}], ")"}]}], ",", " ", 
     RowBox[{
     "every", " ", "component", " ", "prints", " ", "in", " ", 
      "TraditionalForm", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
        "the", " ", "form", " ", "of", " ", "the", " ", "labels", " ", "of", "\n",
          "   ", "graphics"}], ",", " ", 
        RowBox[{
        "from", " ", "which", " ", "TeXForm", " ", "is", " ", "made"}]}], 
       ")"}], " ", "as", " ", "its", " ", "box"}], ",", " ", 
     RowBox[{
      RowBox[{"not", " ", "as", " ", "its", " ", "internal", " ", "name"}], ";",
       " ", 
      RowBox[{
      "a", " ", "component", " ", "without", " ", "a", " ", "usage", "\n", 
       "   ", "message", " ", "receives", " ", "one", " ", "that", " ", 
       "names", " ", "its", " ", "family", " ", "and", " ", "its", " ", 
       "index", " ", "values"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"Scan", "[", 
     RowBox[{
      RowBox[{"Function", "[", 
       RowBox[{"spec", ",", " ", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"b", " ", "=", " ", 
            RowBox[{"Apply", "[", 
             RowBox[{"SL31`Build`symbolBoxes", ",", " ", "spec"}], "]"}]}], 
           "}"}], ",", "\n", "     ", 
          RowBox[{"Replace", "[", 
           RowBox[{
            RowBox[{"SL31SymbolOf", "[", "b", "]"}], ",", " ", 
            RowBox[{
             RowBox[{"HoldComplete", "[", "s_Symbol", "]"}], " ", ":>", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"MakeBoxes", "[", 
                 RowBox[{"s", ",", " ", "TraditionalForm"}], "]"}], " ", "=", 
                " ", "b"}], ";", "\n", "        ", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"!", " ", 
                  RowBox[{"StringQ", "[", 
                   RowBox[{"MessageName", "[", 
                    RowBox[{"s", ",", " ", "\"\<usage\>\""}], "]"}], "]"}]}], 
                 ",", " ", 
                 RowBox[{
                  RowBox[{"MessageName", "[", 
                   RowBox[{"s", ",", " ", "\"\<usage\>\""}], "]"}], " ", "=", 
                  " ", 
                  
                  RowBox[{"\"\<the component \>\"", " ", "<>", "\n", 
                   "           ", 
                   RowBox[{"StringRiffle", "[", 
                    RowBox[{
                    RowBox[{"Map", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], " ", "<>", 
                    " ", "\"\< = \>\"", " ", "<>", " ", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], " ", "&"}], ",", " ", 
                    RowBox[{"Rest", "[", "spec", "]"}]}], "]"}], ",", 
                    " ", "\"\<, \>\""}], "]"}], " ", "<>", 
                   " ", "\"\< of the registered family \>\"", " ", "<>", " ", 
                   
                   RowBox[{"First", "[", "spec", "]"}]}]}]}], "]"}]}], 
              ")"}]}]}], "]"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
      "t2componentSpecs"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"t2componentTeX", " ", "=", " ", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Replace", "[", 
         RowBox[{
          RowBox[{"SL31SymbolOf", "[", "#", "]"}], ",", " ", 
          RowBox[{
           RowBox[{"HoldComplete", "[", "s_", "]"}], " ", ":>", " ", 
           RowBox[{"ToString", "[", 
            RowBox[{"TeXForm", "[", 
             RowBox[{"Unevaluated", "[", "s", "]"}], "]"}], "]"}]}]}], "]"}], 
        " ", "&"}], ",", " ", "t2componentBoxes"}], "]"}]}], ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<T2-SYM\>\"", ",", 
     " ", "\"\<every component of a registered family that is typed in an \
input cell of the notebook (collected from the source by the builder) is read \
as one atomic symbol, and its TeX is written from its printed form, without \
the internal name\>\"", ",", "\n", "  ", 
     RowBox[{
      RowBox[{"AllTrue", "[", 
       RowBox[{"t2componentBoxes", ",", " ", 
        RowBox[{
         RowBox[{"MatchQ", "[", 
          RowBox[{
           RowBox[{"SL31SymbolOf", "[", "#", "]"}], ",", " ", 
           RowBox[{"HoldComplete", "[", "_Symbol", "]"}]}], "]"}], " ", 
         "&"}]}], "]"}], " ", "&&", "\n", "   ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{"t2componentTeX", ",", " ", 
        RowBox[{
         RowBox[{"!", " ", 
          RowBox[{"StringContainsQ", "[", 
           RowBox[{"#", ",", " ", 
            
            RowBox[{"\"\<UnderBracket\>\"", " ", "|", 
             " ", "\"\<\[UnderBracket]\>\""}]}], "]"}]}], " ", "&"}]}], 
       "]"}]}], ",", "\n", "  ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Length", "[", "t2componentBoxes", "]"}], ",", 
        " ", "\"\< components, \>\"", ",", " ", 
        RowBox[{"Length", "[", "t2componentNew", "]"}], ",", 
        " ", "\"\< of them made here; their TeX: \>\"", ",", " ", 
        RowBox[{"StringRiffle", "[", 
         RowBox[{"t2componentTeX", ",", " ", "\"\<, \>\""}], "]"}]}], "}"}], 
      "]"}]}], "]"}]}]}]], "Input",ExpressionUUID->"b3c41bee-07ef-4a4e-b8ab-\
12c5ffbc3937"],

Cell["\<\
Numbers. The original programs compute in double precision with random \
numbers from a generator with a fixed seed. Part II uses the same generator \
with the same seeds, and draws the random numbers in the same order, so that \
every random matrix, field and momentum is the same number as in the original \
program. Exact quantities (the Dirac matrices, the generators) are computed \
exactly; results that depend on rounding (the largest deviation of a check) \
are reported next to the value of the original report.\
\>", "Text",ExpressionUUID->"95b96cea-8add-43d9-a12d-8ac09ac2e6a3"],

Cell["\<\
II.1 The core library t2core: random numbers, matrices, the super-loop \
operators, the lattice\
\>", "Section",ExpressionUUID->"71b29789-71f7-43ac-8690-ef3b59de0570"],

Cell["II.1.1 Random numbers (t2core/src/rng.rs)", "Subsection",ExpressionUUID->"b73e8da3-70c4-4138-8b77-6235c2f0fc7c"],

Cell[TextData[{
 "The generator SplitMix64 keeps one unsigned 64-bit integer as its state. \
Every call adds the constant 9E3779B97F4A7C15 (hexadecimal) to the state and \
mixes the result with shifts, exclusive-or operations (",
 StyleBox["BitXor",
  FontFamily->"Source Code Pro"],
 ") and multiplications; all arithmetic is modulo ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SuperscriptBox["2", "64"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"327f0319-7be2-4049-ac29-2b1ec29e0cbf"]], "InlineFormula",
  ExpressionUUID->"53128861-5334-4cf6-95e1-97bddc35a616"],
 ", as in Rust. A uniform number in ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{"[", 
     RowBox[{
      RowBox[{"-", "1"}], ",", "1"}], ")"}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"93f8a6c6-a9b3-48f9-834b-987426dfb613"]], 
  "InlineFormula",ExpressionUUID->"b13985b5-560d-4d7c-a483-66ce3655cd90"],
 " is made from the upper 53 bits. The conversion is exact in both languages, \
so the Wolfram Language reproduces every random number of the original \
programs bit for bit. The test compares the first three integers and the \
first four uniform numbers for the seed 2026111707 (the seed of the program \
t2_fields) with the values of the same algorithm computed independently in \
Python 3."
}], "Text",ExpressionUUID->"9097e10e-a7b7-4e2d-a4e6-e641939cf96a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", "state", " ", "of", " ", "the", " ", "generator"}], ";",
     " ", 
    RowBox[{
     RowBox[{"t2Seed", "[", "s", "]"}], " ", "starts", " ", "a", " ", "new", " ",
      "sequence"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"t2Seed", "[", "s_Integer", "]"}], " ", ":=", " ", 
     RowBox[{"(", 
      RowBox[{"t2rngState", " ", "=", " ", 
       RowBox[{"Mod", "[", 
        RowBox[{"s", ",", " ", 
         RowBox[{"2", "^", "64"}]}], "]"}]}], ")"}]}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{" ", 
     RowBox[{"one", " ", "step", " ", "of", " ", 
      RowBox[{"SplitMix64", ":", " ", 
       RowBox[{"returns", " ", "an", " ", "integer", " ", 
        RowBox[{"in", " ", "[", 
         RowBox[{"0", ",", " ", 
          RowBox[{"2", "^", "64"}]}]}]}]}]}], ")"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2NextU64", "[", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "z", "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"t2rngState", " ", "=", " ", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"t2rngState", " ", "+", " ", "16^^9E3779B97F4A7C15"}], ",",
            " ", 
           RowBox[{"2", "^", "64"}]}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"z", " ", "=", " ", "t2rngState"}], ";", "\n", "   ", 
        RowBox[{"z", " ", "=", " ", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"BitXor", "[", 
             RowBox[{"z", ",", " ", 
              RowBox[{"BitShiftRight", "[", 
               RowBox[{"z", ",", " ", "30"}], "]"}]}], "]"}], " ", 
            "16^^BF58476D1CE4E5B9"}], ",", " ", 
           RowBox[{"2", "^", "64"}]}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"z", " ", "=", " ", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"BitXor", "[", 
             RowBox[{"z", ",", " ", 
              RowBox[{"BitShiftRight", "[", 
               RowBox[{"z", ",", " ", "27"}], "]"}]}], "]"}], " ", 
            "16^^94D049BB133111EB"}], ",", " ", 
           RowBox[{"2", "^", "64"}]}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"BitXor", "[", 
         RowBox[{"z", ",", " ", 
          RowBox[{"BitShiftRight", "[", 
           RowBox[{"z", ",", " ", "31"}], "]"}]}], "]"}]}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{" ", 
       RowBox[{"a", " ", "uniform", " ", "number", " ", 
        RowBox[{"in", " ", "[", 
         RowBox[{
          RowBox[{"-", "1"}], ",", " ", "1"}]}]}], ")"}], ":", " ", 
      RowBox[{"the", " ", "upper", " ", "53", " ", "bits"}]}], ",", " ", 
     RowBox[{"as", " ", "an", " ", "exact", " ", "rational"}], ",", " ", 
     RowBox[{"converted", " ", "to", " ", "a", " ", "double"}]}], " ", "*)"}],
    "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2Unit", "[", "]"}], " ", ":=", " ", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{"2", " ", 
        RowBox[{
         RowBox[{"BitShiftRight", "[", 
          RowBox[{
           RowBox[{"t2NextU64", "[", "]"}], ",", " ", "11"}], "]"}], "/", 
         RowBox[{"2", "^", "53"}]}]}], " ", "-", " ", "1"}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{" ", 
      RowBox[{
       RowBox[{"a", " ", "random", " ", "complex", " ", "number", " ", "re"}],
        " ", "+", " ", 
       RowBox[{
       "i", " ", "im", " ", "with", " ", "re", " ", "and", " ", "im", " ", 
        "uniform", " ", 
        RowBox[{"in", " ", "[", 
         RowBox[{
          RowBox[{"-", "1"}], ",", " ", "1"}]}]}]}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{"re", " ", "is", " ", "drawn", " ", "first"}], ")"}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2UnitC", "[", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"re", " ", "=", " ", 
         RowBox[{"t2Unit", "[", "]"}]}], "}"}], ",", " ", 
       RowBox[{"re", " ", "+", " ", 
        RowBox[{"I", " ", 
         RowBox[{"t2Unit", "[", "]"}]}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "a", " ", "list", " ", "of", " ", "n", " ", "random", " ", "complex", " ",
      "numbers"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2RndVec", "[", "n_Integer", "]"}], " ", ":=", " ", 
