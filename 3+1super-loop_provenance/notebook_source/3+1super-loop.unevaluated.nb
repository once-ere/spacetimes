       RowBox[{"\"\<largest deviation \>\"", ",", " ", "worstGap", ",", 
        " ", "\"\< (original: 1.7e-15)\>\""}], "}"}], "]"}]}], 
    "]"}]}]}]], "Input",ExpressionUUID->"1cf39bdd-c705-4b8d-89e3-\
