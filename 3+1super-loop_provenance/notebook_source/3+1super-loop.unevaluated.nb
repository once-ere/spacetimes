Cell["I.5 The single symbols and their kinds", "Section",ExpressionUUID->"7871e61a-85db-47da-bf7d-1c246109a053"],

Cell[TextData[{
 "An entry may list several symbols, for example \"",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubscriptBox[
     StyleBox["m", "TI"], "LL"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"98b08df3-94df-4496-a94a-b8f4b0081e58"]], "InlineFormula",
  ExpressionUUID->"b5c1232c-894c-4a9d-8a13-94b90031c299"],
 ", ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubscriptBox["\[Mu]", "LL"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"8b8b91d1-dd6a-43a7-b74c-9cbc1f6369ca"]], "InlineFormula",
  ExpressionUUID->"e77df95e-4112-477d-a6ca-f0e649d73770"],
 ", ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubscriptBox["\[CapitalLambda]", "LL"], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"6c66f4f9-499e-4f30-b000-d3a92138e7df"]], 
  "InlineFormula",ExpressionUUID->"5fbcda94-94ef-49e7-ae0e-1fc59699eb21"],
 "\" (the mass of the spinor charges, the chemical potential and the momentum \
cutoff). The next cell takes every TeX segment between dollar signs, splits \
it into single items, converts each into boxes, and classifies it. The kinds \
are: symbol (one fixed object, such as ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"8cd093bd-5d5c-4d5a-be4c-789e400d5df5"]], 
  "InlineFormula",ExpressionUUID->"b7e29b8d-e345-435b-8331-ff61c1c558df"],
 "); family (a symbol with a running index, such as ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[Tau]", "\[Iota]", "LL"], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"4aaa8151-7801-4a3f-b208-089e2ad5d86d"]], 
  "InlineFormula",ExpressionUUID->"1267cbe0-6835-4dfe-8a0e-34ad6e8088c8"],
 " with ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{"\[Iota]", "\[LongEqual]", "1", ",", "2", ",", "3"}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "822b43f0-84cf-4816-9c3f-7cd689c2f3f1"]], "InlineFormula",ExpressionUUID->
  "57921811-1a5e-4fb4-9c56-e3704c03789c"],
 "); function and function family (a symbol followed by its argument, such as \
",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["W", "TI"], "LL"], "(", 
     StyleBox["u",
      FontSlant->"Bold"], ")"}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"2d1a34dc-b96d-454b-8788-670556dc6546"]], "InlineFormula",
  ExpressionUUID->"1ea12f31-efb7-4039-a237-cb8ce853ab63"],
 "); letter (a single letter such as ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    StyleBox["D", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "5fc9950f-7f6b-4782-be0d-3b7ebef0eb12"]], "InlineFormula",ExpressionUUID->
  "bed82f22-56ef-4cba-a71f-c2e62c03213c"],
 ", the number of space dimensions); index and primed index (",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "0c44fbe2-e275-4a5d-9c76-1e75db1df730"]], "InlineFormula",ExpressionUUID->
  "d9974eb6-f265-43ef-bdba-e9974f45fde8"],
 ", ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SuperscriptBox[
     StyleBox["p", "TI"], "\[Prime]"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"240f8578-69f7-4771-a471-27ae7cd13861"]], "InlineFormula",
  ExpressionUUID->"467601a0-b568-46f8-8269-99e9beaddd6a"],
 ", ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    StyleBox["j", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "36b9faf0-c060-46d3-a809-bd4ffe692f88"]], "InlineFormula",ExpressionUUID->
  "6ddabca1-8374-4382-96fc-785f9c591768"],
 ", ",
 Cell[BoxData[Cell[BoxData[
   FormBox["\[Iota]", TraditionalForm]], "InlineFormula",ExpressionUUID->
   "f4937de1-6d5b-44f1-9e31-d45e479c902e"]], "InlineFormula",ExpressionUUID->
  "d1ab8fd6-b338-4614-9123-395d5767d0e5"],
 ", ...); set (",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    StyleBox["R",
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "ffb19596-15e1-4ff4-825b-3db1c52c2ff2"]], "InlineFormula",ExpressionUUID->
  "4e0d54c4-32f5-4b0d-b43b-eb37b0bbb818"],
 ", ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    StyleBox["C",
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "8e20a351-91e5-4a2f-a05a-635e30dd7eb2"]], "InlineFormula",ExpressionUUID->
  "d0407be2-73c7-42b7-bf74-968463ae67df"],
 ", ...); group (",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{"SL", "(", 
     RowBox[{"2", ",", 
      StyleBox["C",
       FontSlant->"Plain"]}], ")"}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"3323171d-fa5b-4406-8c1f-de6f7e81ad43"]], "InlineFormula",
  ExpressionUUID->"5ada0675-c441-4e6a-8ed4-101bc82e425d"],
 ", ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{"SU", 
     SubscriptBox[
      RowBox[{"(", "2", ")"}], "v"]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"7669a0bb-e718-4205-afb9-78e0d808c0c6"]], "InlineFormula",
  ExpressionUUID->"3d6913fd-60e1-48ae-967f-66cf82b7f031"],
 ", ...); ket; operator (tr, det, the transpose, the tensor product, ...); \
expression (a combination such as ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SuperscriptBox[
     RowBox[{"(", 
      SubscriptBox[
       StyleBox["T", "TI"], "LL"], ")"}], "2"], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"f69283ad-4c93-49a0-88bd-adbcf05a1de1"]], 
  "InlineFormula",ExpressionUUID->"8de41f67-edfb-4174-bc9b-30596380b09d"],
 "); imaginary unit. Entries that are not written in TeX at all are the \
labels of the machine checks and of the hypotheses of the no-go theorems; \
they are names, not symbols, and are kept as text."
}], "Text",ExpressionUUID->"d6d3ee0c-25cc-4ea5-9a47-b4320d214183"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "every", " ", "TeX", " ", "segment", " ", "of", " ", "every", " ", 
    RowBox[{"entry", ":", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"entry", " ", "number"}], ",", " ", "segment"}], "}"}]}]}], 
   " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"segments", " ", "=", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{"e", ",", " ", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"e", "[", "\"\<entry\>\"", "]"}], ",", " ", "#"}], 
               "}"}], " ", "&"}], ",", " ", 
             RowBox[{"StringCases", "[", 
              RowBox[{
               RowBox[{"e", "[", "\"\<symbol\>\"", "]"}], ",", " ", 
               RowBox[{
                RowBox[{"\"\<$\>\"", " ", "~~", " ", 
                 RowBox[{"Shortest", "[", "x__", "]"}], " ", "~~", 
                 " ", "\"\<$\>\""}], " ", ":>", " ", "x"}]}], "]"}]}], 
            "]"}]}], "]"}], ",", " ", "SL31Registry"}], "]"}], ",", " ", 
       "1"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"the", " ", "entries", " ", "without", " ", "any", " ", 
     RowBox[{"TeX", ":", " ", "labels"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"labelEntries", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{"SL31Registry", ",", " ", 
       RowBox[{
        RowBox[{"!", " ", 
         RowBox[{"StringContainsQ", "[", 
          RowBox[{
           RowBox[{"#", "[", "\"\<symbol\>\"", "]"}], ",", " ", "\"\<$\>\""}],
           "]"}]}], " ", "&"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "split", " ", "every", " ", "segment", " ", "into", " ", "single", " ", 
     "items", " ", "and", " ", "convert", " ", "each", " ", "item"}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"items", " ", "=", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{"s", ",", " ", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"<|", 
               RowBox[{
                RowBox[{"\"\<entry\>\"", " ", "->", " ", 
                 RowBox[{"s", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
                RowBox[{"\"\<tex\>\"", " ", "->", " ", "#"}], ",", " ", 
                RowBox[{"\"\<boxes\>\"", " ", "->", " ", 
                 RowBox[{"SL31TeXToBoxes", "[", "#", "]"}]}]}], "|>"}], " ", 
              "&"}], ",", " ", 
             RowBox[{"SL31SplitTeX", "[", 
              RowBox[{"s", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "]"}]}], "]"}], ",", 
         " ", "segments"}], "]"}], ",", " ", "1"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"items", " ", "=", " ", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Append", "[", 
         RowBox[{"#", ",", " ", 
          RowBox[{"\"\<kind\>\"", " ", "->", " ", 
           RowBox[{"SL31Classify", "[", 
            RowBox[{
             RowBox[{"#", "[", "\"\<tex\>\"", "]"}], ",", " ", 
             RowBox[{"#", "[", "\"\<boxes\>\"", "]"}]}], "]"}]}]}], "]"}], 
        " ", "&"}], ",", " ", "items"}], "]"}]}], ";"}], "\n", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", "[", "segments", "]"}], ",", " ", 
     RowBox[{"Length", "[", "items", "]"}], ",", " ", 
     RowBox[{"Length", "[", "labelEntries", "]"}]}], "}"}]}]}]], "Input",Expre\
ssionUUID->"408e6078-1f2e-455d-a7f4-a8bfdc051a0c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "how", " ", "many", " ", "items", " ", "of", " ", "each", " ", "kind"}], 
   " ", "*)"}], "\n", 
  RowBox[{"ReverseSort", "[", 
   RowBox[{"Counts", "[", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"#", "[", "\"\<kind\>\"", "]"}], " ", "&"}], ",", " ", 
      "items"}], "]"}], "]"}], "]"}]}]], "Input",ExpressionUUID->"ea4a7151-\
e8a5-47a8-a010-c97c75b0aa5a"],

Cell["I.6 Symbolizing every symbol", "Section",ExpressionUUID->"cec58fcf-f8c4-4723-8b81-f0d37d67f7bb"],

Cell[TextData[{
 "Now every item of the kinds symbol, family, function, function family, \
letter, primed index, group, ket and expression is symbolized: ",
 StyleBox["SL31Symbolize",
  FontFamily->"Source Code Pro"],
 " calls ",
 StyleBox["Symbolize",
  FontFamily->"Source Code Pro"],
 " with the explicit working form and with a readable name built from the \
letters, the scripts and the alphabet, and returns the new symbol, held. \
Items whose boxes coincide are ONE symbol and are symbolized once: a function \
symbol written with different arguments, such as ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["N", "TI"], "LL"], "(", 
     StyleBox["x",
      FontSlant->"Bold"], ")"}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"e18385ba-71cd-427f-b774-b1b5d93e2927"]], "InlineFormula",
  ExpressionUUID->"3b01b599-1188-4680-b177-dec67ee8c3ce"],
 " and ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["N", "TI"], "LL"], "(", 
     RowBox[{
      StyleBox["x",
       FontSlant->"Bold"], ",", 
      StyleBox["y",
       FontSlant->"Bold"]}], ")"}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"660bd880-4cea-40e8-bdab-024743181b0f"]], "InlineFormula",
  ExpressionUUID->"0ec55cd9-268d-405b-b6b2-9f95937efc54"],
 ", has the one head ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubscriptBox[
     StyleBox["N", "TI"], "LL"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"6b3707fe-b670-409c-93bb-b1c05164216a"]], "InlineFormula",
  ExpressionUUID->"41f01dc3-adb0-4bbb-ab26-16f1b73add43"],
 " (symbolizing the same box twice would only replace the first \
symbolization, with a warning of the Notation package). For every new symbol \
the cell also stores its meaning as the usage message (so that ",
 StyleBox["?symbol",
  FontFamily->"Source Code Pro"],
 " prints it), and a formatting rule for ",
 StyleBox["TraditionalForm",
  FontFamily->"Source Code Pro"],
 ": ",
 StyleBox["TeXForm",
  FontFamily->"Source Code Pro"],
 " writes TeX from the ",
 StyleBox["TraditionalForm",
  FontFamily->"Source Code Pro"],
 " boxes of an expression, so with this rule the symbol is written in TeX \
with its printed form and not with its internal name."
}], "Text",ExpressionUUID->"0a258aef-719b-4045-8bc3-6aa0b7541deb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", "items", " ", "that", " ", "are", " ", "symbolized"}],
     ",", " ", 
    RowBox[{"each", " ", "TeX", " ", "item", " ", "once"}]}], " ", "*)"}], 
  "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"toSymbolize", " ", "=", " ", 
     RowBox[{"DeleteDuplicatesBy", "[", 
      RowBox[{
       RowBox[{"Select", "[", 
        RowBox[{"items", ",", " ", 
         RowBox[{
          RowBox[{"MemberQ", "[", 
           RowBox[{"SL31Symbolized", ",", " ", 
            RowBox[{"#", "[", "\"\<kind\>\"", "]"}]}], "]"}], " ", "&"}]}], 
        "]"}], ",", " ", 
       RowBox[{
        RowBox[{"#", "[", "\"\<tex\>\"", "]"}], " ", "&"}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "items", " ", "with", " ", "the", " ", "same", " ", "boxes", " ", "are", " ",
      "one", " ", 
     RowBox[{"symbol", ":", " ", 
      RowBox[{
      "they", " ", "are", " ", "gathered", " ", "into", " ", "groups"}]}]}], 
    " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"byBoxes", " ", "=", " ", 
     RowBox[{"GatherBy", "[", 
      RowBox[{"toSymbolize", ",", " ", 
       RowBox[{
        RowBox[{"SL31SymbolBoxes", "[", 
         RowBox[{"#", "[", "\"\<tex\>\"", "]"}], "]"}], " ", "&"}]}], "]"}]}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"meaningOf", " ", "=", " ", 
     RowBox[{"Association", "[", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", "\"\<entry\>\"", "]"}], " ", "->", " ", 
          RowBox[{"#", "[", "\"\<meaning\>\"", "]"}]}], " ", "&"}], ",", " ", 
        "SL31Registry"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"symbolize", " ", "every", " ", "group"}], ";", " ", 
      RowBox[{"record", " ", "the", " ", "TeX", " ", "items"}]}], ",", " ", 
     RowBox[{"the", " ", "entries"}], ",", " ", 
     RowBox[{"the", " ", "kind"}], ",", " ", 
     RowBox[{
     "the", " ", "boxes", " ", "and", " ", "the", " ", "held", " ", 
      "symbol"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"symbolTable", " ", "=", " ", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{"group", ",", " ", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"b", " ", "=", " ", 
              RowBox[{"SL31SymbolBoxes", "[", 
               RowBox[{
                RowBox[{"First", "[", "group", "]"}], "[", "\"\<tex\>\"", 
                "]"}], "]"}]}], ",", " ", "h", ",", " ", "texs", ",", " ", 
             "entries"}], "}"}], ",", "\n", "      ", 
           RowBox[{
            RowBox[{"texs", " ", "=", " ", 
             RowBox[{"Map", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"#", "[", "\"\<tex\>\"", "]"}], " ", "&"}], ",", " ", 
               "group"}], "]"}]}], ";", "\n", "      ", 
            RowBox[{"entries", " ", "=", " ", 
             RowBox[{"DeleteDuplicates", "[", 
              RowBox[{"Map", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"#", "[", "\"\<entry\>\"", "]"}], " ", "&"}], ",", 
                " ", "group"}], "]"}], "]"}]}], ";", "\n", "      ", 
            RowBox[{"h", " ", "=", " ", 
             RowBox[{"SL31Symbolize", "[", "b", "]"}]}], ";", "\n", "      ", 
            
            RowBox[{"(*", " ", 
             RowBox[{"the", " ", "usage", " ", 
              RowBox[{"message", ":", " ", 
               RowBox[{
               "the", " ", "TeX", " ", "items", " ", "of", " ", "the", " ", 
                "symbol", " ", "and", " ", "the", " ", "meanings", " ", "of", 
                " ", "their", " ", "entries"}]}]}], " ", "*)"}], "\n", 
            "      ", 
            RowBox[{"Replace", "[", 
             RowBox[{"h", ",", " ", 
              RowBox[{
               RowBox[{"HoldComplete", "[", "s_Symbol", "]"}], " ", ":>", 
               "\n", "        ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"MessageName", "[", 
                  RowBox[{"s", ",", " ", "\"\<usage\>\""}], "]"}], " ", "=", 
                 " ", 
                 RowBox[{
                  RowBox[{"StringRiffle", "[", 
                   RowBox[{"texs", ",", " ", "\"\<, \>\""}], "]"}], " ", "<>",
                   " ", "\"\<: \>\"", " ", "<>", " ", 
                  RowBox[{"StringRiffle", "[", 
                   RowBox[{
                    RowBox[{"Map", "[", 
                    RowBox[{"meaningOf", ",", " ", "entries"}], "]"}], ",", 
                    " ", "\"\< | \>\""}], "]"}]}]}], ")"}]}]}], "]"}], ";", 
            "\n", "      ", 
            RowBox[{"(*", " ", 
             RowBox[{
              RowBox[{"TraditionalForm", " ", 
               RowBox[{"(", 
                RowBox[{"and", " ", "therefore", " ", "TeXForm"}], ")"}], " ",
                "shows", " ", "the", " ", "printed", " ", "form"}], ",", " ", 
              
              RowBox[{"not", " ", "the", " ", "internal", " ", "name"}]}], 
             " ", "*)"}], "\n", "      ", 
            RowBox[{"Replace", "[", 
             RowBox[{"h", ",", " ", 
              RowBox[{
               RowBox[{"HoldComplete", "[", "s_Symbol", "]"}], " ", ":>", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"MakeBoxes", "[", 
                  RowBox[{"s", ",", " ", "TraditionalForm"}], "]"}], " ", "=",
                  " ", "b"}], ")"}]}]}], "]"}], ";", "\n", "      ", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<entries\>\"", " ", "->", " ", "entries"}], ",", 
              " ", 
              RowBox[{"\"\<tex\>\"", " ", "->", " ", 
               RowBox[{"First", "[", "texs", "]"}]}], ",", " ", 
              RowBox[{"\"\<texAll\>\"", " ", "->", " ", "texs"}], ",", " ", 
              RowBox[{"\"\<kind\>\"", " ", "->", " ", 
               RowBox[{
                RowBox[{"First", "[", "group", "]"}], "[", "\"\<kind\>\"", 
                "]"}]}], ",", "\n", "        ", 
              RowBox[{"\"\<boxes\>\"", " ", "->", " ", "b"}], ",", " ", 
              RowBox[{"\"\<symbol\>\"", " ", "->", " ", "h"}]}], "|>"}]}]}], 
          "]"}]}], "]"}], ",", "\n", "   ", "byBoxes"}], "]"}]}], ";"}], "\n", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", "[", "toSymbolize", "]"}], ",", " ", 
     RowBox[{"Length", "[", "symbolTable", "]"}]}], "}"}]}]}]], "Input",Expres\
sionUUID->"b71fdbf6-2986-4343-95cc-551ea27acc3e"],

Cell["The TeX items that share one symbol, with their entries:", "Text",ExpressionUUID->"93020cf0-a10a-4bf1-b11c-0ca8a04b9c98"],

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"RawBoxes", "[", 
           RowBox[{"#", "[", "\"\<boxes\>\"", "]"}], "]"}], ",", " ", 
          RowBox[{"Column", "[", 
           RowBox[{"#", "[", "\"\<texAll\>\"", "]"}], "]"}], ",", " ", 
          RowBox[{"#", "[", "\"\<entries\>\"", "]"}]}], "}"}], " ", "&"}], ",",
        " ", 
       RowBox[{"Select", "[", 
        RowBox[{"symbolTable", ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", 
            RowBox[{"#", "[", "\"\<texAll\>\"", "]"}], "]"}], " ", ">", " ", 
           "1"}], " ", "&"}]}], "]"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"#", ",", " ", "Bold"}], "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<symbol\>\"", ",", " ", "\"\<TeX items\>\"", ",", 
        " ", "\"\<entries\>\""}], "}"}]}]}], "]"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}]], "Input",Expression\
UUID->"c959261b-e173-45c7-87c2-4bca4c713840"],

Cell["\<\
Twelve symbols chosen from the nine groups, as the notebook now prints them, \
with their internal names:\
\>", "Text",ExpressionUUID->"6cbd87fd-5eea-490f-b8b5-45ca211c9e43"],

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"RawBoxes", "[", 
           RowBox[{"#", "[", "\"\<boxes\>\"", "]"}], "]"}], ",", " ", 
          RowBox[{"#", "[", "\"\<kind\>\"", "]"}], ",", " ", 
          RowBox[{"Replace", "[", 
           RowBox[{
            RowBox[{"#", "[", "\"\<symbol\>\"", "]"}], ",", " ", 
            RowBox[{
             RowBox[{"HoldComplete", "[", "s_", "]"}], " ", ":>", " ", 
             RowBox[{"SymbolName", "[", 
              RowBox[{"Unevaluated", "[", "s", "]"}], "]"}]}]}], "]"}]}], 
         "}"}], " ", "&"}], ",", "\n", "    ", 
       RowBox[{"symbolTable", "[", 
        RowBox[{"[", 
         RowBox[{"Round", "[", 
          RowBox[{"Range", "[", 
           RowBox[{"1", ",", " ", 
            RowBox[{"Length", "[", "symbolTable", "]"}], ",", " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Length", "[", "symbolTable", "]"}], " ", "-", " ", 
               "1"}], ")"}], "/", "11"}]}], "]"}], "]"}], "]"}], "]"}]}], 
      "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"#", ",", " ", "Bold"}], "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<symbol\>\"", ",", " ", "\"\<kind\>\"", ",", 
        " ", "\"\<internal name\>\""}], "}"}]}]}], "]"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}]], "Input",Expression\
UUID->"8fb11689-50f6-4988-9bc1-a6456734d4c3"],

Cell["I.7 Verification tests of the symbols", "Section",ExpressionUUID->"d4028c2e-0498-4507-bda3-8b080688b04d"],

Cell[TextData[{
 "Every test below has a name (S-1, S-2, ...), states in words what it \
checks, computes it, and records PASS or FAIL with the numbers that decide it \
in the list ",
 StyleBox["SL31`Test`$Results",
  FontFamily->"Source Code Pro"],
 ". The function ",
 StyleBox["SL31Check[name, statement, condition, details]",
  FontFamily->"Source Code Pro"],
 " does the recording and prints one line."
}], "Text",ExpressionUUID->"4ec67d33-b096-4569-bf27-0c7e4ba33ef5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SL31`Test`$Results", " ", "=", " ", 
   RowBox[{"{", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"SL31Check", "[", 
    RowBox[{
    "name_String", ",", " ", "statement_String", ",", " ", "ok_", ",", " ", 
     RowBox[{"details_", " ", ":", " ", "\"\<\>\""}]}], "]"}], " ", ":=", " ", 
   RowBox[{"(", "\n", "   ", 
    RowBox[{
     RowBox[{"AppendTo", "[", 
      RowBox[{"SL31`Test`$Results", ",", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<name\>\"", " ", "->", " ", "name"}], ",", " ", 
         RowBox[{"\"\<pass\>\"", " ", "->", " ", 
          RowBox[{"TrueQ", "[", "ok", "]"}]}], ",", " ", 
         RowBox[{"\"\<statement\>\"", " ", "->", " ", "statement"}], ",", " ", 
         RowBox[{"\"\<details\>\"", " ", "->", " ", "details"}]}], "|>"}]}], 
      "]"}], ";", "\n", "   ", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "the", " ", "details", " ", "are", " ", "printed", " ", "as", " ", 
        "an", " ", "expression"}], ",", " ", 
       RowBox[{
       "so", " ", "that", " ", "the", " ", "symbols", " ", "appear", " ", 
        "in", " ", "their", " ", "printed", " ", "form"}]}], " ", "*)"}], 
     "\n", "   ", 
     RowBox[{"Print", "[", 
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"TrueQ", "[", "ok", "]"}], ",", " ", "\"\<PASS  \>\"", ",",
            " ", "\"\<FAIL  \>\""}], "]"}], ",", " ", "Bold", ",", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"TrueQ", "[", "ok", "]"}], ",", " ", 
           RowBox[{"Darker", "[", "Green", "]"}], ",", " ", "Red"}], "]"}]}], 
        "]"}], ",", " ", "name", ",", " ", "\"\<: \>\"", ",", " ", 
       "statement", ",", "\n", "     ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"details", " ", "===", " ", "\"\<\>\""}], ",", 
         " ", "\"\<\>\"", ",", " ", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<  -- \>\"", ",", " ", "details"}], "}"}], "]"}]}], 
        "]"}]}], "]"}]}], ")"}]}], ";"}]}], "Input",ExpressionUUID->"0242ad2c-\
4beb-4097-a0d0-91471db38a10"],

Cell["\<\
S-1 and S-2: every TeX item was converted into boxes (no item failed), and \
every symbolized box is now read as one atomic symbol.\
\>", "Text",ExpressionUUID->"989cc670-d1ed-4430-9e99-1cd471d25cbd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-1\>\"", ",", 
    " ", "\"\<every one of the TeX items of the registry is converted into a \
box structure\>\"", ",", "\n", "  ", 
    RowBox[{"AllTrue", "[", 
     RowBox[{"items", ",", " ", 
      RowBox[{
       RowBox[{"FreeQ", "[", 
        RowBox[{
         RowBox[{"#", "[", "\"\<boxes\>\"", "]"}], ",", " ", 
         RowBox[{"$Failed", " ", "|", " ", "Null"}]}], "]"}], " ", "&"}]}], 
     "]"}], ",", " ", 
    RowBox[{"Length", "[", "items", "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-2\>\"", ",", 
    " ", "\"\<every symbolized box is read as one atomic symbol (head Symbol)\
\>\"", ",", "\n", "  ", 
    RowBox[{"AllTrue", "[", 
     RowBox[{"symbolTable", ",", " ", 
      RowBox[{
       RowBox[{"MatchQ", "[", 
        RowBox[{
         RowBox[{"#", "[", "\"\<symbol\>\"", "]"}], ",", " ", 
         RowBox[{"HoldComplete", "[", "_Symbol", "]"}]}], "]"}], " ", "&"}]}],
      "]"}], ",", "\n", "  ", 
    RowBox[{"Count", "[", 
     RowBox[{"symbolTable", ",", " ", 
      RowBox[{"r_", " ", "/;", " ", 
       RowBox[{"MatchQ", "[", 
        RowBox[{
         RowBox[{"r", "[", "\"\<symbol\>\"", "]"}], ",", " ", 
         RowBox[{"HoldComplete", "[", "_Symbol", "]"}]}], "]"}]}]}], "]"}]}], 
   "]"}], ";"}]}], "Input",ExpressionUUID->"7235de79-fe84-491d-a0e9-\
19e038d2f5b1"],

Cell[TextData[{
 "S-0, the strings as the front end reads them. Every string inside every \
symbolized box (the letters, names and numbers of the scripts) must be ONE \
token when the front end reads it as typed text; otherwise the front end \
would cut it before it sends a typed symbol to the kernel, and the symbol \
would not be recognized (section I.2). The test asks the front end itself. \
The command ",
 StyleBox["FrontEndExecute[FrontEnd`UndocumentedTestFEParserPacket[string, \
True]]",
  FontFamily->"Source Code Pro"],
 " is an internal command of the front end: it reads a string exactly as \
typed input is read when a cell is evaluated, and returns the boxes; for a \
single token it returns the string unchanged. (The tags of ",
 StyleBox["TagBox",
  FontFamily->"Source Code Pro"],
 " and the options of ",
 StyleBox["StyleBox",
  FontFamily->"Source Code Pro"],
 " are not input text and are not tested.)"
}], "Text",ExpressionUUID->"80c97d85-43c9-41f0-aadd-437b93eafeb6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"the", " ", "strings", " ", "inside", " ", "a", " ", 
    RowBox[{"box", ":", " ", 
     RowBox[{
     "TagBox", " ", "and", " ", "StyleBox", " ", "wrappers", " ", "are", " ", 
      "opened", " ", "first"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"boxStrings", "[", "b_", "]"}], " ", ":=", " ", 
     RowBox[{"Cases", "[", 
      RowBox[{
       RowBox[{"b", " ", "//.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"TagBox", "[", 
            RowBox[{"x_", ",", " ", "_String", ",", " ", "___"}], "]"}], " ", 
           ":>", " ", "x"}], ",", " ", 
          RowBox[{
           RowBox[{"StyleBox", "[", 
            RowBox[{"x_", ",", " ", "___"}], "]"}], " ", ":>", " ", "x"}]}], 
         "}"}]}], ",", " ", "_String", ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "Infinity"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"allStrings", " ", "=", " ", 
     RowBox[{"Union", "[", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"boxStrings", "[", 
           RowBox[{"#", "[", "\"\<boxes\>\"", "]"}], "]"}], " ", "&"}], ",", 
         " ", "symbolTable"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "how", " ", "the", " ", "front", " ", "end", " ", "reads", " ", "every", " ",
      "one", " ", "of", " ", "them"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"feReading", " ", "=", " ", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"#", " ", "->", " ", 
         RowBox[{"First", "[", 
          RowBox[{"FrontEndExecute", "[", 
           RowBox[{"FrontEnd`UndocumentedTestFEParserPacket", "[", 
            RowBox[{"#", ",", " ", "True"}], "]"}], "]"}], "]"}]}], " ", 
        "&"}], ",", " ", "allStrings"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"cut", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{"feReading", ",", " ", 
       RowBox[{
        RowBox[{"!", " ", 
         RowBox[{"MatchQ", "[", 
          RowBox[{"#", ",", " ", 
           RowBox[{"(", 
            RowBox[{"s_", " ", "->", " ", 
             RowBox[{"BoxData", "[", "s_", "]"}]}], ")"}]}], "]"}]}], " ", 
        "&"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"SL31Check", "[", 
     RowBox[{"\"\<S-0\>\"", ",", 
      " ", "\"\<every string inside the symbolized boxes is one token for the \
front end, so that typed symbols reach the kernel unchanged\>\"", ",", "\n", 
      "  ", 
      RowBox[{"cut", " ", "===", " ", 
       RowBox[{"{", "}"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Length", "[", "allStrings", "]"}], ",", " ", "cut"}], 
       "}"}]}], "]"}], ";"}]}]}]], "Input",ExpressionUUID->"c86c8313-8624-\
4e49-934e-2d5fbced876d"],

Cell[TextData[{
 "S-14, the typed symbols. The next cell contains every symbolized symbol of \
the registry, each written in its printed form, exactly as a reader of this \
notebook would type it. When the cell is evaluated, the front end sends these \
boxes to the kernel and the Notation package reads them. Every one must be \
one atomic symbol, and it must be the very symbol that section I.6 created \
from its registry TeX (the list has the order of the table ",
 StyleBox["symbolTable",
  FontFamily->"Source Code Pro"],
 ")."
}], "Text",ExpressionUUID->"2969b0ee-231d-45c2-b326-7f1e12a573b3"],

