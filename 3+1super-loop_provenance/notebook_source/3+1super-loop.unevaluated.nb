                 RowBox[{"t2Unit", "[", "]"}]}], ",", " ", 
                RowBox[{"I", " ", 
                 RowBox[{"t2Unit", "[", "]"}]}]}], "}"}]}], "]"}], ",", " ", 
            RowBox[{"{", "4", "}"}]}], "]"}]}], "]"}]}], ";", "\n", "   ", 
       RowBox[{"gfr", " ", "=", " ", 
