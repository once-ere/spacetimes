Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"GS", "-", "9"}], ":", " ", 
     RowBox[{
      RowBox[{"the", " ", "mode"}], "-", 
      RowBox[{
      "sum", " ", "form", " ", "of", " ", "the", " ", "gap", " ", 
       "equation"}]}], ":", " ", 
     RowBox[{
     "sum", " ", "over", " ", "the", " ", "positive", " ", "modes", " ", "of",
       " ", 
      RowBox[{"psi_p", "^", "T"}], " ", "Kch_", "3", " ", "conj", 
      RowBox[{"(", "psi_h", ")"}]}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{"-", "2"}], " ", "Delta", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"1", "/", 
        RowBox[{"E", "^", 
         RowBox[{"+", " ", 
          RowBox[{"+", " ", "1"}]}]}]}], "/", 
       RowBox[{"E", "^", "-"}]}], ")"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"k3", " ", "=", " ", 
     RowBox[{"t2kpair", "[", "3", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"worstGap", " ", "=", " ", "0."}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"q", " ", "=", " ", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"2", " ", 
              RowBox[{"t2Unit", "[", "]"}]}], ",", " ", 
             RowBox[{"{", "3", "}"}]}], "]"}]}], ",", " ", "delta", ",", " ", 
          "hm", ",", " ", "ev", ",", " ", "vecs", ",", " ", "s", ",", " ", 
          "epsq", ",", " ", "ep", ",", " ", "em"}], "}"}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{"delta", " ", "=", " ", 
          RowBox[{"0.25", " ", "+", " ", 
           RowBox[{"0.2", " ", 
            RowBox[{"t2Unit", "[", "]"}]}]}]}], ";", "\n", "   ", 
         RowBox[{"hm", " ", "=", " ", 
          RowBox[{"hq", "[", 
           RowBox[{"q", ",", " ", "zero3", ",", " ", 
            RowBox[{"ConstantArray", "[", 
             RowBox[{"0", ",", " ", 
              RowBox[{"{", 
               RowBox[{"8", ",", " ", "8"}], "}"}]}], "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "0", ",", " ", "delta"}], "}"}], ",", " ",
             "mu"}], "]"}]}], ";", "\n", "   ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ev", ",", " ", "vecs"}], "}"}], " ", "=", " ", 
          RowBox[{"t2eigh", "[", "hm", "]"}]}], ";", "\n", "   ", 
         RowBox[{"s", " ", "=", " ", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"ev", "[", 
                RowBox[{"[", "col", "]"}], "]"}], " ", ">", " ", "0"}], ",", 
              " ", 
              RowBox[{
               RowBox[{"vecs", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"1", " ", ";;", " ", "8"}], ",", " ", "col"}], 
                 "]"}], "]"}], " ", ".", " ", "k3", " ", ".", " ", 
               RowBox[{"Conjugate", "[", 
                RowBox[{"vecs", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{"9", " ", ";;", " ", "16"}], ",", " ", "col"}], 
                  "]"}], "]"}], "]"}]}], ",", " ", "0"}], "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"col", ",", " ", "16"}], "}"}]}], "]"}]}], ";", "\n", 
         "   ", 
         RowBox[{"epsq", " ", "=", " ", 
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{"q", " ", ".", " ", "q"}], " ", "+", " ", 
            RowBox[{"mass", "^", "2"}]}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"ep", " ", "=", " ", 
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"epsq", " ", "+", " ", "mu"}], ")"}], "^", "2"}], " ", "+",
             " ", 
            RowBox[{"delta", "^", "2"}]}], "]"}]}], ";", " ", 
         RowBox[{"em", " ", "=", " ", 
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"epsq", " ", "-", " ", "mu"}], ")"}], "^", "2"}], " ", "+",
             " ", 
            RowBox[{"delta", "^", "2"}]}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"worstGap", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"worstGap", ",", " ", 
            RowBox[{"Abs", "[", 
             RowBox[{"s", " ", "+", " ", 
              RowBox[{"2", " ", "delta", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"1", "/", "ep"}], " ", "+", " ", 
                 RowBox[{"1", "/", "em"}]}], ")"}]}]}], "]"}]}], "]"}]}]}]}], 
       "]"}], ",", "\n", "  ", 
      RowBox[{"{", "30", "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<GS-9\>\"", ",", 
     " ", "\"\<the self-consistency of the mean field: for the polar order \
parameter the sum over the eight positive-energy eigenvectors of psi_p^T \
Kch_3 conj(psi_h) equals -2 Delta (1/E^+ + 1/E^-), so that the mode-sum form \
of the mean-field equations gives the gap equation 1/G = int d^3q/(2 pi)^3 \
(1/E^+ + 1/E^-) (30 random momenta; tolerance 1e-10)\>\"", ",", "\n", "  ", 
     RowBox[{"worstGap", " ", "<", " ", "1*^-10"}], ",", " ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<largest deviation \>\"", ",", " ", "worstGap", ",", 
        " ", "\"\< (original: 1.7e-15)\>\""}], "}"}], "]"}]}], 
    "]"}]}]}]], "Input",ExpressionUUID->"bf215249-6694-4eb1-bb1e-\
2eb70d4addb5"],

