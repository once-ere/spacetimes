                    RowBox[{"x", ",", " ", "p", ",", " ", "h15"}], "]"}], ",",
                     " ", "q"}], "]"}], " ", "-", " ", 
                    RowBox[{"gam15", "[", 
                    RowBox[{
                    RowBox[{"shift", "[", 
                    RowBox[{"x", ",", " ", "p", ",", " ", 
                    RowBox[{"-", "h15"}]}], "]"}], ",", " ", "q"}], "]"}]}], 
                    ")"}], " ", 
                    RowBox[{"(", 
                    RowBox[{"0.5", "/", "h15"}], ")"}]}], " ", "+", " ", 
                    RowBox[{"comm", "[", 
                    RowBox[{
                    RowBox[{"gp", "[", 
                    RowBox[{"[", 
                    RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}], ",", " ", 
                    RowBox[{"gam15", "[", 
                    RowBox[{"x", ",", " ", "q"}], "]"}]}], "]"}]}], "]"}]}], 
                  "]"}]}], ";", "\n", "       ", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"q", " ", "!=", " ", "p"}], ",", "\n", "        ", 
                  RowBox[{"dev15curv", " ", "=", " ", 
                   RowBox[{"Max", "[", 
                    RowBox[{"dev15curv", ",", " ", 
                    RowBox[{"fro", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"conn15", "[", 
                    RowBox[{
                    RowBox[{"shift", "[", 
                    RowBox[{"x", ",", " ", "p", ",", " ", "h15"}], "]"}], ",",
                     " ", "q"}], "]"}], " ", "-", " ", 
                    RowBox[{"conn15", "[", 
                    RowBox[{
                    RowBox[{"shift", "[", 
                    RowBox[{"x", ",", " ", "p", ",", " ", 
                    RowBox[{"-", "h15"}]}], "]"}], ",", " ", "q"}], "]"}]}], 
                    ")"}], " ", 
                    RowBox[{"(", 
                    RowBox[{"0.5", "/", "h15"}], ")"}]}], " ", "-", "\n", 
                    "            ", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"conn15", "[", 
                    RowBox[{
                    RowBox[{"shift", "[", 
                    RowBox[{"x", ",", " ", "q", ",", " ", "h15"}], "]"}], ",",
                     " ", "p"}], "]"}], " ", "-", " ", 
                    RowBox[{"conn15", "[", 
                    RowBox[{
                    RowBox[{"shift", "[", 
                    RowBox[{"x", ",", " ", "q", ",", " ", 
                    RowBox[{"-", "h15"}]}], "]"}], ",", " ", "p"}], "]"}]}], 
                    ")"}], " ", 
                    RowBox[{"(", 
                    RowBox[{"0.5", "/", "h15"}], ")"}]}], " ", "+", " ", 
                    RowBox[{"comm", "[", 
                    RowBox[{
                    RowBox[{"gp", "[", 
                    RowBox[{"[", 
                    RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}], ",", " ", 
                    RowBox[{"gp", "[", 
                    RowBox[{"[", 
                    RowBox[{"q", " ", "+", " ", "1"}], "]"}], "]"}]}], 
                    "]"}]}], "]"}]}], "]"}]}]}], "]"}]}], ",", "\n", 
               "       ", 
               RowBox[{"{", 
                RowBox[{"q", ",", " ", "0", ",", " ", "3"}], "}"}]}], 
              "]"}]}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}]}], 
      "]"}], ",", " ", 
     RowBox[{"{", "20", "}"}]}], "]"}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"uniqueness", ":", " ", 
     RowBox[{
      RowBox[{"the", " ", "real"}], "-", 
      RowBox[{"linear", " ", "map", " ", "u"}]}]}], " ", "->", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{"sgen", 
         RowBox[{"(", "u", ")"}]}], ",", " ", 
        RowBox[{"gamma", "^", "q"}]}], "]"}], ")"}], "_q", " ", "has", " ", 
     "the", " ", "rank", " ", "6", " ", "on", " ", "the", " ", "six", " ", 
     "generators"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"cols15", " ", "=", " ", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{"gen", ",", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Flatten", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Re", "[", "#", "]"}], ",", " ", 
               RowBox[{"Im", "[", "#", "]"}]}], "}"}], " ", "&"}], " ", "/@", 
            " ", 
            RowBox[{"Flatten", "[", 
             RowBox[{"comm", "[", 
              RowBox[{"gen", ",", " ", 
               RowBox[{"t2gamma", "[", "q", "]"}]}], "]"}], "]"}]}], "]"}], ",",
           " ", 
          RowBox[{"{", 
           RowBox[{"q", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}], 
        "]"}]}], "]"}], ",", " ", 
     RowBox[{"Join", "[", 
      RowBox[{"sj", ",", " ", "sk"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gram15", " ", "=", " ", 
   RowBox[{"N", "[", 
    RowBox[{"cols15", " ", ".", " ", 
     RowBox[{"Transpose", "[", "cols15", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gev15", " ", "=", " ", 
   RowBox[{"First", "[", 
    RowBox[{"t2eigh", "[", "gram15", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"SL31Check", "[", 
  RowBox[{"\"\<GS-15\>\"", ",", 
   " ", "\"\<the Lorentz connection is fixed by the frame: for an x-dependent \
Lorentz transformation the connection -(d_p Sspin) Sspin^-1 has the form \
sgen(u), the Dirac matrices of the transformed frame are covariantly constant \
and the curvature vanishes (20 random points; tolerance 1e-6); the 24 \
commutators [sgen(J^j), gamma^q], [sgen(K^j), gamma^q] have the rank 6 \
(smallest Gram eigenvalue > 1e-6)\>\"", ",", "\n", "  ", 
   RowBox[{
    RowBox[{"dev15form", " ", "<", " ", "1*^-6"}], " ", "&&", " ", 
    RowBox[{"dev15const", " ", "<", " ", "1*^-6"}], " ", "&&", " ", 
    RowBox[{"dev15curv", " ", "<", " ", "1*^-6"}], " ", "&&", " ", 
    RowBox[{
     RowBox[{"gev15", "[", 
      RowBox[{"[", "1", "]"}], "]"}], " ", ">", " ", "1*^-6"}]}], ",", "\n", 
   "  ", 
   RowBox[{"Row", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<largest deviations \>\"", ",", " ", "dev15form", ",", 
      " ", "\"\<, \>\"", ",", " ", "dev15const", ",", " ", "\"\<, \>\"", ",", 
      " ", "dev15curv", ",", " ", "\"\<; smallest Gram eigenvalue \>\"", ",", 
      " ", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{"gev15", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"5", ",", " ", "3"}], "}"}]}], "]"}], ",", 
      " ", "\"\< (original: 1.0e-9, 3.6e-8, 8.0e-9; 8.000)\>\""}], "}"}], 
    "]"}]}], "]"}]}], "Input",ExpressionUUID->"6844803c-4138-4897-a468-\
e1fb0e8f3fbc"],

Cell["GS-16 and the figures of item [1]", "Subsection",ExpressionUUID->"b87727bb-5eaf-4b53-9bb3-49e7e229d34d"],

Cell[TextData[{
 "On a periodic chain of 24 sites along ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["x", "TI"], "LL", "1"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"f81b77af-e047-4e1d-8f63-d491c5a846f1"]], "InlineFormula",
  ExpressionUUID->"8ed42891-782f-4b33-a529-69b5e86efdaf"],
 " (",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubsuperscriptBox["\[ScriptL]", "LL", "x"], "\[LongEqual]", "0.5"}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "d0f4e515-93ef-4316-996b-f14eba8ba369"]], "InlineFormula",ExpressionUUID->
  "bf3a8ef6-93ea-426c-82d6-0fc9b07306b5"],
 ", ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["m", "TI"], "LL"], "\[LongEqual]", "0.4"}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"de606b05-91cd-4804-8387-2097817ce606"]], 
  "InlineFormula",ExpressionUUID->"0d23e1dc-be7d-4d12-8ec1-bb0726381cf6"],
 ", ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox["\[Mu]", "LL"], "\[LongEqual]", "0"}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"cc9ca6bb-8522-4835-8c95-3a240e0f25f4"]], 
  "InlineFormula",ExpressionUUID->"5aeb80be-89da-492b-95a0-e4545ea24f13"],
 ", no gauge fields, no pairing) the lattice operator ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalH]",
      FontSlant->"Plain"], "LL", "lat"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"abba51da-fcce-4a6e-b6d9-ca3083d79b95"]], "InlineFormula",
  ExpressionUUID->"23d8e2c4-1759-49fd-b5ad-1e052a5da24e"],
 " of the solvers maps a plane wave, ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{"exp", "(", 
     RowBox[{
      StyleBox["i", "TI"], 
      SubsuperscriptBox[
       StyleBox["q", "TI"], "LL", "1"], 
      SubsuperscriptBox[
       StyleBox["x", "TI"], "LL", "1"]}], ")"}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"9391454e-eb07-4bcd-861f-e4af60c21054"]], 
  "InlineFormula",ExpressionUUID->"8eb10778-e57c-411d-9d08-b00213645459"],
 " times one of the 16 unit vectors of a site, to a plane wave of the same \
momentum, and the ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{"16", "\[Cross]", "16"}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"d322ccf2-71a9-469f-965e-dec2b473771c"]], "InlineFormula",
  ExpressionUUID->"ee561d68-0326-4ba5-affb-1f24405c3daa"],
 " matrix of these images has the eigenvalues ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{"-", 
     SubsuperscriptBox["\[CurlyEpsilon]", "LL", "lat"]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"16a466ab-695b-4f1a-a5ab-3de198ed2ef0"]], 
  "InlineFormula",ExpressionUUID->"c608a415-2ad7-45e5-822c-6b6c75a07956"],
 " and ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{"+", 
     SubsuperscriptBox["\[CurlyEpsilon]", "LL", "lat"]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"1b99b0eb-5e2f-4357-89b4-b71aa936ec1b"]], 
  "InlineFormula",ExpressionUUID->"172f2b91-19c5-4c88-8772-f7ffd2f85fd1"],
 ", each eight times, at all 24 allowed momenta ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubsuperscriptBox[
      StyleBox["q", "TI"], "LL", "1"], "\[LongEqual]", "2", "\[Pi]\[Kappa]", "/", 
     RowBox[{"(", 
      RowBox[{"24", 
       SubsuperscriptBox["\[ScriptL]", "LL", "x"]}], ")"}]}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "e7a69059-1933-44f5-83fd-4fbcbac58f27"]], "InlineFormula",ExpressionUUID->
  "39daebc0-c7b0-4158-9d03-99dd63a745bd"],
 " (integers ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{"\[Kappa]", "\[LongEqual]", 
     RowBox[{"-", "11"}], ",", "\[Ellipsis]", ",", "12"}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"5af0c6ff-24f6-43bf-a838-b4c5f8125f5a"]], 
  "InlineFormula",ExpressionUUID->"624ac8e8-e40c-45a7-af5e-10b9d4286be9"],
 "), for the Wilson coefficients ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubsuperscriptBox[
      StyleBox["r", "TI"], "LL", "W"], "\[LongEqual]", "0"}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "ae6a4474-7d5c-4f8d-9f61-de2c7d3eb514"]], "InlineFormula",ExpressionUUID->
  "f4d491aa-2fc2-4c99-a71f-ff5a7be7ef70"],
 " and ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubsuperscriptBox[
      StyleBox["r", "TI"], "LL", "W"], "\[LongEqual]", "1"}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "dcf70cdb-47b5-4c5c-9e87-f8d245b3924e"]], "InlineFormula",ExpressionUUID->
  "a0e953f7-5052-492a-8ef8-323369709cd8"],
 ". The energy of a free particle on the lattice is ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubsuperscriptBox["\[CurlyEpsilon]", "LL", "lat"], 
     RowBox[{"(", 
      SubscriptBox[
       OverscriptBox[
        StyleBox["q", "TI"], "\[RightVector]"], "LL"], ")"}], "\[LongEqual]", 
     
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        UnderscriptBox["\[Sum]", 
         StyleBox["j", "TI"],
         LimitsPositioning->True], 
        SuperscriptBox["sin", "2"], 
        RowBox[{"(", 
         RowBox[{
          SubsuperscriptBox[
           StyleBox["q", "TI"], "LL", 
           StyleBox["j", "TI"]], 
          SubsuperscriptBox["\[ScriptL]", "LL", "x"]}], ")"}], "/", 
        SuperscriptBox[
         RowBox[{"(", 
          SubsuperscriptBox["\[ScriptL]", "LL", "x"], ")"}], "2"], "+", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SubscriptBox[
            StyleBox["m", "TI"], "LL"], "+", 
           RowBox[{"(", 
            RowBox[{
             SubsuperscriptBox[
              StyleBox["r", "TI"], "LL", "W"], "/", 
             SubsuperscriptBox["\[ScriptL]", "LL", "x"]}], ")"}], 
           UnderscriptBox["\[Sum]", 
            StyleBox["j", "TI"],
            LimitsPositioning->True], 
           RowBox[{"(", 
            RowBox[{"1", "-", "cos", 
             RowBox[{"(", 
              RowBox[{
               SubsuperscriptBox[
                StyleBox["q", "TI"], "LL", 
                StyleBox["j", "TI"]], 
               SubsuperscriptBox["\[ScriptL]", "LL", "x"]}], ")"}]}], ")"}]}],
           ")"}], "2"]}], ")"}], 
      RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"e49974b5-07d1-4126-a7db-2586555b210d"]], "InlineFormula",
  ExpressionUUID->"8db42b81-41c9-4c2a-87cf-32c57f7b3868"],
 ", the sums running over the directions with more than one site. At ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubsuperscriptBox[
      StyleBox["q", "TI"], "LL", "1"], 
     SubsuperscriptBox["\[ScriptL]", "LL", "x"], "\[LongEqual]", 
     RowBox[{"\[PlusMinus]", "\[Pi]"}]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"95b0406a-0ae2-42cf-a629-36fbc37a0be8"]], "InlineFormula",
  ExpressionUUID->"18c709ab-3d33-4119-b417-4894bd47c99e"],
 " the sine vanishes again: without the Wilson term (",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubsuperscriptBox[
      StyleBox["r", "TI"], "LL", "W"], "\[LongEqual]", "0"}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "b1cdd6e1-904f-45c7-83f8-af5bef2f7362"]], "InlineFormula",ExpressionUUID->
  "5211a68f-3e98-46eb-af96-594d03b5dca6"],
 ") the energy returns to ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubscriptBox[
     StyleBox["m", "TI"], "LL"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"d3602178-2255-46db-8986-d5c8a9e44e7c"]], "InlineFormula",
  ExpressionUUID->"4579cfd2-6e93-4a2b-8bf8-8fc6c96cda88"],
 " there (a second, spurious particle, the doubler); with ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubsuperscriptBox[
      StyleBox["r", "TI"], "LL", "W"], "\[LongEqual]", "1"}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "dfc95807-0635-463d-8bdf-d170635e8f47"]], "InlineFormula",ExpressionUUID->
  "64a74988-77b0-44e2-bf12-73b42e57fc11"],
 " it is lifted to ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["m", "TI"], "LL"], "+", "2", 
     SubsuperscriptBox[
      StyleBox["r", "TI"], "LL", "W"], "/", 
     SubsuperscriptBox["\[ScriptL]", "LL", "x"], "\[LongEqual]", "4.4"}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "ab35365b-d958-4bcc-853a-2d1a89d49da2"]], "InlineFormula",ExpressionUUID->
  "0d3be80e-069a-4790-aaca-89eb30c97abb"],
 ". Figure 1 shows these eigenvalues with the formula and with the continuum \
energy ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox["\[CurlyEpsilon]", "LL"], "\[LongEqual]", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox[
         StyleBox["q", "TI"], "LL", "2"], "+", 
        SubsuperscriptBox[
         StyleBox["m", "TI"], "LL", "2"]}], ")"}], 
      RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"66729b27-fb5e-48e2-bfd1-24c72cbe05fe"]], "InlineFormula",
  ExpressionUUID->"7339f863-7380-41c8-80f0-af1575cb3209"],
 "; Figure 2 shows the modulus of the RK4 factor of GS-13."
}], "Text",ExpressionUUID->"692719dc-11cb-4cba-9d36-55f15c635dbd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"mFig", ",", " ", "dxFig", ",", " ", "nFig"}], "}"}], " ", "=", 
    " ", 
    RowBox[{"{", 
     RowBox[{"0.4", ",", " ", "0.5", ",", " ", "24"}], "}"}]}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", "1", ")"}], " ", "the", " ", 
     RowBox[{"curves", ":", " ", 
      RowBox[{
      "the", " ", "continuum", " ", "energy", " ", "and", " ", "eps_lat", " ",
        "for", " ", "r_W"}]}]}], " ", "=", " ", 
    RowBox[{
    "0", " ", "and", " ", "1", " ", "on", " ", "401", " ", "momenta"}]}], " ",
    "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"curves", " ", "=", " ", 
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"q", " ", "=", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "Pi"}], "/", "dxFig"}], " ", "+", " ", 
             RowBox[{"2", " ", 
              RowBox[{"Pi", "/", "dxFig"}], " ", 
              RowBox[{"i", "/", "400."}]}]}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"rw", ",", " ", "q", ",", " ", 
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{"q", "^", "2"}], " ", "+", " ", 
              RowBox[{"mFig", "^", "2"}]}], "]"}], ",", " ", 
            RowBox[{"t2epsLat", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"q", ",", " ", "0.", ",", " ", "0."}], "}"}], ",", " ",
               "dxFig", ",", " ", "mFig", ",", " ", "rw", ",", " ", 
              RowBox[{"{", 
               RowBox[{"True", ",", " ", "False", ",", " ", "False"}], 
               "}"}]}], "]"}]}], "}"}]}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"rw", ",", " ", 
          RowBox[{"{", 
           RowBox[{"0.", ",", " ", "1."}], "}"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", "0", ",", " ", "400"}], "}"}]}], "]"}], ",", 
      " ", "1"}], "]"}]}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"(", "2", ")"}], " ", "the", " ", 
    RowBox[{"points", ":", " ", 
     RowBox[{
     "the", " ", "largest", " ", "eigenvalue", " ", "of", " ", "the", " ", 
      "operator", " ", "on", " ", "the", " ", "plane", " ", "waves", " ", 
      "of", " ", "the", " ", "24", " ", "allowed", " ", "momenta"}]}]}], " ", 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"dispDev", " ", "=", " ", "0."}], ";"}], "\n", 
 RowBox[{
  RowBox[{"points", " ", "=", " ", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"lat1", " ", "=", " ", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<n\>\"", " ", "->", " ", 
               RowBox[{"{", 
                RowBox[{"nFig", ",", " ", "1", ",", " ", "1"}], "}"}]}], ",", 
              " ", 
              RowBox[{"\"\<ell\>\"", " ", "->", " ", "dxFig"}], ",", " ", 
              RowBox[{"\"\<periodic\>\"", " ", "->", " ", 
               RowBox[{"{", 
                RowBox[{"True", ",", " ", "False", ",", " ", "False"}], 
                "}"}]}], ",", " ", 
              RowBox[{"\"\<wilson\>\"", " ", "->", " ", "rw"}], ",", " ", 
              RowBox[{"\"\<mass\>\"", " ", "->", " ", "mFig"}], ",", " ", 
              RowBox[{"\"\<mu\>\"", " ", "->", " ", "0."}]}], "|>"}]}], ",", 
           "\n", "      ", "kk", ",", " ", "q", ",", " ", "w", ",", " ", 
           "out", ",", " ", "m16", ",", " ", "ev", ",", " ", "el"}], "}"}], ",",
          "\n", "     ", 
         RowBox[{
          RowBox[{"kk", " ", "=", " ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"kq", " ", "<=", " ", 
              RowBox[{"nFig", "/", "2"}]}], ",", " ", "kq", ",", " ", 
             RowBox[{"kq", " ", "-", " ", "nFig"}]}], "]"}]}], ";", "\n", 
          "     ", 
          RowBox[{"q", " ", "=", " ", 
           RowBox[{"2", " ", "Pi", " ", 
            RowBox[{"kk", "/", 
             RowBox[{"(", 
              RowBox[{"nFig", " ", "dxFig"}], ")"}]}]}]}], ";", "\n", "     ", 
          RowBox[{"(*", " ", 
