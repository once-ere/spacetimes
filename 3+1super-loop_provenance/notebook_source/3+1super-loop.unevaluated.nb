}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"BeginPackage", "[", 
     RowBox[{"\"\<SL31`\>\"", ",", " ", 
      RowBox[{"{", "\"\<Notation`\>\"", "}"}]}], "]"}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"SL31TeXTokens", "::", "usage"}], " ", "=", 
     " ", "\"\<SL31TeXTokens[tex] splits the TeX string tex into tokens: \
commands such as \\\\Delta, braces, the scripts ^ and _, primes, and single \
characters.\>\""}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"SL31TeXToBoxes", "::", "usage"}], " ", "=", 
     " ", "\"\<SL31TeXToBoxes[tex] converts the TeX of one registered symbol \
into the two-dimensional Wolfram boxes used in this notebook (the style of \
every letter is kept: double-struck, script, Gothic, sans-serif and bold \
letters stay different).\>\""}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"SL31SplitTeX", "::", "usage"}], " ", "=", 
     " ", "\"\<SL31SplitTeX[tex] splits a TeX segment that lists several \
symbols, separated by commas outside braces, parentheses and brackets, into \
the single symbols; a list a, \\\\dots, b of numbered symbols is \
expanded.\>\""}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"SL31Classify", "::", "usage"}], " ", "=", 
     " ", "\"\<SL31Classify[tex, boxes] returns the kind of a registered \
item: \\\"symbol\\\", \\\"family\\\", \\\"function\\\", \\\"letter\\\", \
\\\"index\\\", \\\"set\\\", \\\"group\\\", \\\"operator\\\", \\\"ket\\\", \
\\\"expression\\\".\>\""}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"SL31Head", "::", "usage"}], " ", "=", 
     " ", "\"\<SL31Head[boxes] returns the boxes of the symbol part of a \
function symbol such as W(u): the boxes before the argument in parentheses.\>\
\""}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"SL31IndexLetters", "::", "usage"}], " ", "=", 
     " ", "\"\<SL31IndexLetters lists the boxes that are running indices of a \
family of symbols: p, j, iota, k, n and their primed forms.\>\""}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"SL31NameOf", "::", "usage"}], " ", "=", 
     " ", "\"\<SL31NameOf[boxes] is the name given to the symbol of boxes: \
built from the letters, the scripts and the styles, with every character that \
may not stand in a symbol name replaced by its character name between the \
separators \[UnderBracket].\>\""}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"SL31Symbolize", "::", "usage"}], " ", "=", 
     " ", "\"\<SL31Symbolize[boxes] symbolizes boxes with the Notation \
package in StandardForm (WorkingForm -> StandardForm given explicitly) and \
returns the new symbol, held: HoldComplete[symbol].\>\""}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"SL31SymbolOf", "::", "usage"}], " ", "=", 
     " ", "\"\<SL31SymbolOf[boxes] returns HoldComplete[s], where s is the \
expression that the boxes parse to in StandardForm (for a symbolized box: the \
atomic symbol).\>\""}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"SL31SymbolBoxes", "::", "usage"}], " ", "=", 
     " ", "\"\<SL31SymbolBoxes[tex] returns the boxes that are symbolized for \
the registered TeX item tex (see the comments of its definition for the \
wrapping by kind).\>\""}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"SL31Symbolized", "::", "usage"}], " ", "=", 
     " ", "\"\<SL31Symbolized lists the kinds of registered items that are \
symbolized.\>\""}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"SL31Instance", "::", "usage"}], " ", "=", 
     " ", "\"\<SL31Instance[boxes, {index -> value, ...}] replaces running \
indices in the scripts of boxes by values (strings), symbolizes the resulting \
component box and returns it, held.\>\""}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"LL", "::", "usage"}], " ", "=", 
     " ", "\"\<LL[tex] returns the symbolized symbol of the registered TeX \
symbol tex; LL[tex, index -> value, ...] returns the symbolized component \
with the given index values.\>\""}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"SL31`Build`symbolBoxes", "::", "usage"}], " ", "=", 
     " ", "\"\<SL31`Build`symbolBoxes[tex, index -> value, ...] returns the \
boxes of the registered symbol tex or of its component; used by the notebook \
builder.\>\""}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"Begin", "[", "\"\<`Private`\>\"", "]"}], ";"}], "\n", "\n", 
