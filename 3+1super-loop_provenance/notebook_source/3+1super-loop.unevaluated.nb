          FontSlant->"Plain"]], ")"}], 
       SubsuperscriptBox["\[Psi]", 
        StyleBox["LL",
         FontSlant->"Plain"], 
        StyleBox["p",
         FontSlant->"Plain"]], 
       RowBox[{"(", 
