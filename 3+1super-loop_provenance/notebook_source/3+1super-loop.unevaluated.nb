Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"rbq", "[", "]"}], " ", ":=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"t2UnitC", "[", "]"}], ",", " ", 
     RowBox[{"{", "4", "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"zero4", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"0", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"bqDev", "[", 
    RowBox[{"x_", ",", " ", "y_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Max", "[", 
