            RowBox[{"\"\<\[PartialD]\>\"", ",", " ", "0"}], "]"}]}], ",", " ", 
          RowBox[{"psiS", "[", "1", "]"}], ",", " ", "\"\< = \>\"", ",", " ", 
          
          RowBox[{"exactEq", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "}"}], "]"}], ",", " ", 
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{
          SubscriptBox["M", "LL"], ",", " ", "\"\<(\>\"", ",", " ", 
          SubscriptBox[
           TagBox[
            StyleBox["D",
             FontWeight->"Bold",
             FontSlant->"Plain"],
            "SL31Bold"], "LL"], ",", " ", "\"\<) = \>\"", ",", " ", 
          RowBox[{"MatrixForm", "[", "mdSym", "]"}], ",", " ", "\"\<,   \>\"",
           ",", " ", 
          SubscriptBox["M", "LL"], ",", " ", "\"\<(\>\"", ",", " ", 
          RowBox[{"OverBar", "[", 
           SubscriptBox[
            TagBox[
             StyleBox["D",
              FontWeight->"Bold",
              FontSlant->"Plain"],
             "SL31Bold"], "LL"], "]"}], ",", " ", "\"\<) = \>\"", ",", " ", 
          RowBox[{"MatrixForm", "[", "mdbSym", "]"}]}], "}"}], "]"}]}], "}"}],
      ",", " ", 
     RowBox[{"Spacings", " ", "->", " ", "1"}]}], "]"}]}]}]], "Input",Expressi\
onUUID->"ccb25b05-9a6e-43e9-ac3b-8728b45656c7"],

Cell[BoxData[
 RowBox[{"SL31Check", "[", 
  RowBox[{"\"\<GS-12\>\"", ",", 
   " ", "\"\<the printed formulas agree with the matrices that they describe: \
the entries of Ppair (symbolic d), of the blocks of sgen(u_p) and of Gamma_p, \
the expansions of the covariant derivatives, the sixteen equations of the \
Dirac-Bogoliubov-de Gennes system, the pair operators Pi and the eight exact \
equations, each evaluated for numbers assigned to its symbols and compared \
with the matrix computation (tolerance 1e-12)\>\"", ",", "\n", "  ", 
   RowBox[{
    RowBox[{"pdev", " ", "<", " ", "1*^-12"}], " ", "&&", " ", 
    RowBox[{"eqdev", " ", "<", " ", "1*^-12"}], " ", "&&", " ", 
    RowBox[{"eqdev2", " ", "<", " ", "1*^-12"}], " ", "&&", " ", 
    RowBox[{"pidev", " ", "<", " ", "1*^-12"}], " ", "&&", " ", 
    RowBox[{"eqdev3", " ", "<", " ", "1*^-12"}]}], ",", "\n", "  ", 
   RowBox[{"Row", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<largest deviations \>\"", ",", " ", "pdev", ",", 
      " ", "\"\<, \>\"", ",", " ", "eqdev", ",", " ", "\"\<, \>\"", ",", " ", 
      "eqdev2", ",", " ", "\"\<, \>\"", ",", " ", "pidev", ",", 
      " ", "\"\<, \>\"", ",", " ", "eqdev3", ",", 
      " ", "\"\< (original: 0.0e0, 4.0e-16, 3.4e-16, 0.0e0, 5.0e-16)\>\""}], 
     "}"}], "]"}]}], "]"}]], "Input",ExpressionUUID->"90b0e4e0-347d-4c3a-9a6a-\
1f758ddd339b"],

Cell["\<\
GS-13: the time integration by IDA, compared with the exact solution\
\>", "Subsection",ExpressionUUID->"859673ad-2c5f-40ec-b697-fee82e9a9819"],

Cell[TextData[{
 "The original program checks its time integration on the lattice of GS-10 \
(",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", "\[Times]", "2", "\[Times]", "4"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "06eec27a-24da-43f9-8446-f0ade877aeac"],
 " sites with random links, potentials and pair fields; ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["cpx",
      FontSlant->"Plain"]], "\[LongEqual]", "384"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "91b58a2c-1cdf-46b4-a4bd-420101daad3a"],
 "). From a random initial state ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["w", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["lat",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e204136f-6bcc-4799-8669-1c63941cfece"],
 " of the norm 1, drawn from a generator of its own (seed 2026111713, so that \
the random numbers of the later checks are not shifted), it integrates the \
lattice equations with CVODE up to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "0"], "\[LongEqual]", "20"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7b94f51a-9232-4620-805b-467071108b70"],
 ", with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["tol",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox["10", 
     RowBox[{"-", "8"}]], ",", 
    SuperscriptBox["10", 
     RowBox[{"-", "10"}]], ",", 
    SuperscriptBox["10", 
     RowBox[{"-", "12"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "aee80233-7c57-4361-876a-45f53a324cba"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["tol",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["tol",
      FontSlant->"Plain"]], "/", "100"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fc8899ac-2fce-47fc-8a51-fcb633698889"],
 ", and compares the states at the 41 output times ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "0"], "\[LongEqual]", "0", ",", "0.5", ",", 
    "\[Ellipsis]", ",", "20"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d61cc5eb-7bbd-43da-82eb-de36949c1465"],
 " with the exact solution ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["w", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["ex",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "200b55ea-b7fb-427d-9d5e-f4be8f9a5265"],
 ": the sum over the eigenvectors of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalH]",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["lat",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f9ff5f3a-c509-488d-9d50-9aca66e3f658"],
 " of the eigenvector times its scalar product with the initial state times \
the phase factor of the angle ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     SubsuperscriptBox[
      StyleBox["E", "TI"], 
      RowBox[{
       StyleBox["LL",
        FontSlant->"Plain"], ",", 
       StyleBox["n", "TI"]}], 
      StyleBox["qp",
       FontSlant->"Plain"]]}], 
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "0"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bb564220-6ab5-421c-baa4-4d0fb95e2bf2"],
 " (eigensolver ",
 StyleBox["t2eigh",
  FontFamily->"Source Code Pro"],
 "). The quantity compared is the relative deviation ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Delta]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["rel",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7fbe4af7-fcf8-4959-902f-fc8bd6c704c3"],
 ", the norm of the difference between the computed and the exact state \
divided by the norm of the exact state. The notebook repeats the check with \
IDA in place of CVODE (functions ",
 StyleBox["t2evolveIDA",
  FontFamily->"Source Code Pro"],
 " and ",
 StyleBox["t2localErrorsIDA",
  FontFamily->"Source Code Pro"],
 " of chapter II.1.5): the same lattice, the same initial state, the same \
tolerances, the same output times."
}], "Text",ExpressionUUID->"7e76e01e-313d-4b5e-a7b7-824be798c79f"],

Cell[TextData[{
 "The check has four parts, for each of the three tolerances. (1) The exact \
local error ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Delta]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["loc",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "56169642-2dd3-432d-8150-a841ec0a7ea7"],
 " of every internal step is at most ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["loc",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["tol",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dfb90fa9-8232-45ee-b8a6-ab15c64bb5eb"],
 " times the norm of the state plus ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["tol",
      FontSlant->"Plain"]], 
    SqrtBox[
     RowBox[{"2", 
      SubsuperscriptBox[
       StyleBox["n", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["cpx",
        FontSlant->"Plain"]]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "eef98bd5-393e-44d5-90fe-2131b97ac11e"],
 ". Because the evolution is unitary, the deviation at the end of every \
internal step is then at most ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["err",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["st",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["loc",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7d624a6b-aadc-401e-9b21-bb23256b7ae0"],
 " (chapter II.1.5). (2) The states of ",
 StyleBox["NDSolve",
  FontFamily->"Source Code Pro"],
 " at the output times are the cubic Hermite polynomials of the stored values \
and derivatives (tolerance ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "12"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "59ddd55c-c006-4d38-a854-f127c4f21f52"],
 "), so that the bound ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["out",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1016904c-7a87-4196-9338-08cc37036124"],
 " of chapter II.1.5 holds for them, and the largest ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Delta]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["rel",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a683e717-7583-4f58-8ec2-372c38324e25"],
 " is at most ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["out",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "72b513c9-1dae-4347-9752-15b9f455badc"],
 " (the exact state has the norm 1, so the relative deviation is the \
deviation). (3) The largest deviation decreases from ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["tol",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox["10", 
     RowBox[{"-", "8"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7f4f1522-0936-455c-9ce7-28048eb243c2"],
 " to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "10"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d727fa4a-1c70-45fe-b9bb-93cfb469c53c"],
 " to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "12"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a515f4c1-3ed7-403d-9fe2-dc136d394e20"],
 ". (4) The two requirements of the original check for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["tol",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox["10", 
     RowBox[{"-", "12"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "134d76c1-5987-423d-8cd1-562181583963"],
 ": the largest deviation stays below ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "9"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4f738496-3714-4807-9e6b-bbdb3e410829"],
 ", and the norm of the state, which the exact evolution conserves, changes \
by less than ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "10"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "70f2ca11-f753-4894-907b-ba9db776674c"],
 ". The printed line also gives the numbers of internal steps ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["N", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["st",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1b698c16-172b-415f-9982-3df6265c769f"],
 " and of evaluations ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["N", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["ev",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2d961a52-5cb6-425f-8149-65325510107a"],
 " of the right side, the largest internal steps, and the results of CVODE \
from the report of the original program."
}], "Text",ExpressionUUID->"41a12c46-a6f7-4bf5-8df4-bb0712834345"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"GS", "-", "13"}], ":", " ", 
     RowBox[{
     "the", " ", "initial", " ", "state", " ", "from", " ", "a", " ", 
      "generator", " ", "of", " ", "its", " ", "own", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"seed", " ", "2026111713"}], ")"}], ".", "  ", "The"}], " ", 
      "state", " ", "of", " ", "the", " ", "main", " ", "generator", " ", 
      "is", " ", "kept", "\n", "   ", "and", " ", "restored"}]}], ",", " ", 
    RowBox[{
    "so", " ", "that", " ", "the", " ", "random", " ", "numbers", " ", "of", " ",
      "the", " ", "later", " ", "checks", " ", "are", " ", "those", " ", "of",
      " ", "the", " ", "original", " ", "program"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"rngKept13", " ", "=", " ", "t2rngState"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"t2Seed", "[", "2026111713", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"w0IDA13", " ", "=", " ", 
     RowBox[{"t2RndVec", "[", 
      RowBox[{"t2dim", "[", "lat", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"t2rngState", " ", "=", " ", "rngKept13"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"w0IDA13", " ", "=", " ", 
     RowBox[{"w0IDA13", "/", 
      RowBox[{"Norm", "[", "w0IDA13", "]"}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"the", " ", "exact", " ", 
     RowBox[{"solution", ":", " ", 
      RowBox[{
      "the", " ", "eigenvalues", " ", "and", " ", "eigenvectors", " ", "of", " ",
        "H_lat", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"t2eigh", ":", " ", 
          RowBox[{"ascending", " ", "eigenvalues"}]}], ",", " ", 
         RowBox[{
         "the", " ", "eigenvectors", " ", "in", " ", "the", "\n", "   ", 
          "columns"}]}], ")"}], " ", "and", " ", "the", " ", "spectral", " ", 
       "sum"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"e13", ",", " ", "v13"}], "}"}], " ", "=", " ", 
     RowBox[{"t2eigh", "[", "hl", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"eMax13", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", "e13", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"coef13", " ", "=", " ", 
     RowBox[{
      RowBox[{"ConjugateTranspose", "[", "v13", "]"}], " ", ".", " ", 
      "w0IDA13"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"wExact13", "[", 
      RowBox[{"x0_", "?", "NumericQ"}], "]"}], " ", ":=", " ", 
     RowBox[{"v13", " ", ".", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "I"}], " ", "e13", " ", "x0"}], "]"}], " ", "coef13"}],
        ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"touts13", " ", "=", " ", 
     RowBox[{"Range", "[", 
      RowBox[{"0.", ",", " ", "20.", ",", " ", "0.5"}], "]"}]}], ";"}], "\n", 
   
   RowBox[{
    RowBox[{"exact13", " ", "=", " ", 
     RowBox[{"wExact13", " ", "/@", " ", "touts13"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rtols13", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"1.*^-8", ",", " ", "1.*^-10", ",", " ", "1.*^-12"}], "}"}]}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "three", " ", "integrations", " ", "by", " ", "IDA"}], ",", 
     " ", 
     RowBox[{"atol", " ", "=", " ", 
      RowBox[{"rtol", "/", "100"}]}], ",", " ", 
     RowBox[{
     "each", " ", "with", " ", "the", " ", "measurement", " ", "of", " ", 
      "the", " ", "local", " ", "errors", " ", "of", " ", "all", " ", "its", " ",
       "steps"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"time13", ",", " ", "runs13"}], "}"}], " ", "=", " ", 
     RowBox[{"AbsoluteTiming", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"t2evolveIDA", "[", 
         RowBox[{
         "hl", ",", " ", "w0IDA13", ",", " ", "touts13", ",", " ", "rt", ",", 
          " ", 
          RowBox[{"rt", "/", "100"}], ",", " ", 
          RowBox[{"t2localErrorsIDA", "[", 
           RowBox[{"e13", ",", " ", "v13", ",", " ", "rt", ",", " ", 
            RowBox[{"rt", "/", "100"}]}], "]"}]}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"rt", ",", " ", "rtols13"}], "}"}]}], "]"}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"dev13", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Norm", "[", 
            RowBox[{"#1", " ", "-", " ", "#2"}], "]"}], "/", 
           RowBox[{"Norm", "[", "#2", "]"}]}], " ", "&"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"runs13", "[", 
            RowBox[{"[", 
             RowBox[{"kt", ",", " ", "\"\<states\>\""}], "]"}], "]"}], ",", 
           " ", "exact13"}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"kt", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"maxdev13", " ", "=", " ", 
     RowBox[{"Max", " ", "/@", " ", "dev13"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"normChange13", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Max", "[", 
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"Norm", " ", "/@", " ", 
           RowBox[{"runs13", "[", 
            RowBox[{"[", 
             RowBox[{"kt", ",", " ", "\"\<states\>\""}], "]"}], "]"}]}], " ", 
          "-", " ", "1"}], "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"kt", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"steps13", " ", "=", " ", 
     RowBox[{"runs13", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", " ", "\"\<steps\>\""}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"evals13", " ", "=", " ", 
     RowBox[{"runs13", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", " ", "\"\<evaluations\>\""}], "]"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"hmax13", " ", "=", " ", 
     RowBox[{"runs13", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", " ", "\"\<hmax\>\""}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ratio13", " ", "=", " ", 
     RowBox[{"runs13", "[", 
      RowBox[{"[", 
       RowBox[{
       "All", ",", " ", "\"\<analysis\>\"", ",", 
        " ", "\"\<largestRatio\>\""}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"norm13", " ", "=", " ", 
     RowBox[{"runs13", "[", 
      RowBox[{"[", 
       RowBox[{
       "All", ",", " ", "\"\<analysis\>\"", ",", " ", "\"\<largestNorm\>\""}],
        "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"resid13", " ", "=", " ", 
     RowBox[{"Max", " ", "/@", " ", 
      RowBox[{"runs13", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", " ", "\"\<residualAt\>\""}], "]"}], "]"}]}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"hermite13", " ", "=", " ", 
     RowBox[{"Max", " ", "/@", " ", 
      RowBox[{"runs13", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", " ", "\"\<hermiteAt\>\""}], "]"}], "]"}]}]}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"B", "^", "loc"}], " ", "=", " ", 
      RowBox[{
       RowBox[{"rtol", " ", 
        RowBox[{"(", 
         RowBox[{"largest", " ", "norm", " ", "of", " ", "a", " ", "state"}], 
         ")"}]}], " ", "+", " ", 
       RowBox[{"atol", " ", "sqrt", 
        RowBox[{"(", 
         RowBox[{"2", " ", 
          RowBox[{"n", "^", "cpx"}]}], ")"}]}]}]}], ";", " ", 
     RowBox[{
      RowBox[{"B", "^", "err"}], " ", "=", " ", 
      RowBox[{
       RowBox[{"N", "^", "st"}], " ", 
       RowBox[{"B", "^", "loc"}]}]}], ";", " ", 
     RowBox[{
      RowBox[{"B", "^", "out"}], " ", "as", " ", "in", " ", "chapter", " ", 
      "II", ".1", ".5"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"bloc13", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"rtols13", "[", 
          RowBox[{"[", "kt", "]"}], "]"}], " ", 
         RowBox[{"norm13", "[", 
          RowBox[{"[", "kt", "]"}], "]"}]}], " ", "+", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"rtols13", "[", 
           RowBox[{"[", "kt", "]"}], "]"}], "/", "100"}], " ", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"2.", " ", 
           RowBox[{"t2dim", "[", "lat", "]"}]}], "]"}]}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"kt", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"berr13", " ", "=", " ", 
     RowBox[{"steps13", " ", "bloc13"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"bout13", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", " ", "+", " ", 
           RowBox[{
            RowBox[{"hmax13", "[", 
             RowBox[{"[", "kt", "]"}], "]"}], " ", 
            RowBox[{"eMax13", "/", "4"}]}]}], ")"}], " ", 
         RowBox[{"berr13", "[", 
          RowBox[{"[", "kt", "]"}], "]"}]}], " ", "+", " ", 
        RowBox[{
         RowBox[{"hmax13", "[", 
          RowBox[{"[", "kt", "]"}], "]"}], " ", 
         RowBox[{
          RowBox[{"resid13", "[", 
           RowBox[{"[", "kt", "]"}], "]"}], "/", "4"}]}], " ", "+", " ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"hmax13", "[", 
              RowBox[{"[", "kt", "]"}], "]"}], " ", "eMax13"}], ")"}], "^", 
           "4"}], "/", "384"}], " ", 
         RowBox[{"norm13", "[", 
          RowBox[{"[", "kt", "]"}], "]"}]}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"kt", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"sci13", "[", "l_List", "]"}], " ", ":=", " ", 
     RowBox[{"Row", "[", 
      RowBox[{"Riffle", "[", 
       RowBox[{
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"ScientificForm", "[", 
            RowBox[{"#", ",", " ", "2"}], "]"}], " ", "&"}], ",", " ", "l"}], 
         "]"}], ",", " ", "\"\<, \>\""}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "numbers", " ", "of", " ", "internal", " ", "steps", " ", 
      "of", " ", "CVODE", " ", "for", " ", "the", " ", "three", " ", 
      "tolerances"}], ",", " ", 
     RowBox[{
     "from", " ", "the", " ", "report", " ", "of", " ", "the", " ", 
      "original", " ", "program"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"cvSteps13", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"1528", ",", " ", "3661", ",", " ", "3804"}], "}"}]}], ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<GS-13\>\"", ",", 
     " ", "\"\<time integration: the lattice equations (i times the \
derivative of the Nambu mode w_lat with respect to the time x_LL^0 equals \
H_lat w_lat) are integrated by IDA (SUNDIALS, through NDSolve with Method -> \
\\\"IDA\\\": backward differentiation formulas of the orders 1 to 5 with \
local error control and Newton's method; the tolerance of every real unknown \
is rtol times its modulus plus atol) in place of CVODE of the original \
program; on the 3 x 2 x 4 lattice of GS-10 (384 complex components), from the \
random initial state of the norm 1 of the original program, for each of rtol \
= 1e-8, 1e-10, 1e-12 (atol = rtol/100): (1) the exact local error local_error \
of every internal step is at most budget_step = rtol (norm of the state) + \
atol sqrt(768); (2) the states at the 41 output times x_LL^0 = 0, 0.5, ..., \
20 are the cubic Hermite polynomials of the stored values and derivatives \
(tolerance 1e-12), and their largest relative deviation from the exact \
spectral solution w_exact is at most budget_out = (1 + h_IDA E_max/4) budget \
+ h_IDA deriv_residual/4 + (h_IDA E_max)^4/384 with budget = N_steps \
budget_step; (3) the largest deviation decreases from rtol = 1e-8 to 1e-10 to \
1e-12; (4) for rtol = 1e-12 it stays below 1e-9, and the norm of the state \
changes by less than 1e-10\>\"", ",", "\n", "  ", 
     RowBox[{
      RowBox[{"And", " ", "@@", " ", 
       RowBox[{"Thread", "[", 
        RowBox[{"ratio13", " ", "<=", " ", "1"}], "]"}]}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"Max", "[", "hermite13", "]"}], " ", "<", " ", "1*^-12"}], " ",
       "&&", " ", 
      RowBox[{"And", " ", "@@", " ", 
       RowBox[{"Thread", "[", 
        RowBox[{"maxdev13", " ", "<=", " ", "bout13"}], "]"}]}], " ", "&&", 
      " ", 
      RowBox[{
       RowBox[{"maxdev13", "[", 
        RowBox[{"[", "1", "]"}], "]"}], " ", ">", " ", 
       RowBox[{"maxdev13", "[", 
        RowBox[{"[", "2", "]"}], "]"}], " ", ">", " ", 
       RowBox[{"maxdev13", "[", 
        RowBox[{"[", "3", "]"}], "]"}]}], " ", "&&", "\n", "   ", 
      RowBox[{
       RowBox[{"maxdev13", "[", 
        RowBox[{"[", "3", "]"}], "]"}], " ", "<", " ", "1*^-9"}], " ", "&&", 
      " ", 
      RowBox[{
       RowBox[{"normChange13", "[", 
        RowBox[{"[", "3", "]"}], "]"}], " ", "<", " ", "1*^-10"}]}], ",", 
     "\n", "  ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<for rtol = 1e-8, 1e-10, 1e-12: largest \
local_error/budget_step \>\"", ",", " ", 
        RowBox[{"sci13", "[", "ratio13", "]"}], ",", 
        " ", "\"\<; largest relative deviations \>\"", ",", " ", 
        RowBox[{"sci13", "[", "maxdev13", "]"}], ",", 
        " ", "\"\< <= budget_out \>\"", ",", " ", 
        RowBox[{"sci13", "[", "bout13", "]"}], ",", "\n", 
        "    ", "\"\< (budget \>\"", ",", " ", 
        RowBox[{"sci13", "[", "berr13", "]"}], ",", 
        " ", "\"\<); largest norm changes \>\"", ",", " ", 
        RowBox[{"sci13", "[", "normChange13", "]"}], ",", 
        " ", "\"\<; N_steps \>\"", ",", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"steps13", ",", " ", "\"\<, \>\""}], "]"}], ",", 
        " ", "\"\<; N_evals \>\"", ",", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"evals13", ",", " ", "\"\<, \>\""}], "]"}], ",", 
        " ", "\"\<; largest h_IDA \>\"", ",", " ", 
        RowBox[{"sci13", "[", "hmax13", "]"}], ",", "\n", 
        "    ", "\"\<; largest deriv_residual \>\"", ",", " ", 
        RowBox[{"sci13", "[", "resid13", "]"}], ",", 
        " ", "\"\<; Hermite polynomials within \>\"", ",", " ", 
        RowBox[{"sci13", "[", "hermite13", "]"}], ",", " ", "\"\<; E_max \>\"",
         ",", " ", 
        RowBox[{"NumberForm", "[", 
         RowBox[{"eMax13", ",", " ", 
          RowBox[{"{", 
           RowBox[{"6", ",", " ", "4"}], "}"}]}], "]"}], ",", 
        " ", "\"\<; computing time \>\"", ",", " ", 
        RowBox[{"Round", "[", 
         RowBox[{"time13", ",", " ", "0.1"}], "]"}], ",", "\n", 
        "    ", "\"\< s (original program, CVODE: largest relative deviations \
1.2e-6, 1.7e-7, 1.7e-10, budgets 2.6e-5, 6.2e-7, 6.4e-9, norm changes 5.2e-7, \
9.8e-8, 5.9e-11, steps 1528, 3661, 3804)\>\""}], "}"}], "]"}]}], 
    "]"}]}]}]], "Input",ExpressionUUID->"519b16f0-d045-4861-95d0-\
b3931d137977"],

Cell["GS-14: the super-loop form of the field equations", "Subsection",ExpressionUUID->"dff3712f-a561-4bbf-a370-413a0b9be68d"],

Cell[TextData[{
 "The Weyl isodoublet of a spinor charge ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["y",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d29e6ced-a1a1-4522-b918-f33c98019963"],
 " (with a bi-quaternion ",
 Cell[BoxData[
  FormBox[
   StyleBox["y",
    FontWeight->"Bold",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c7cadaa4-1fa5-4ead-8063-a1c926a0c7e1"],
 ") is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Psi]", 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Prime]"], 
    RowBox[{"(", 
     StyleBox["y",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["E",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     RowBox[{"-", "1"}]], 
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      StyleBox["y",
       FontWeight->"Bold",
       FontSlant->"Plain"], ")"}], 
     StyleBox["T", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c39413c7-a9b8-4930-8e87-8117fd28873e"],
 ", and the Dirac isodoublet ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"[", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["b",
        FontWeight->"Bold",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "-"], ",", 
      SubsuperscriptBox[
       StyleBox["b",
        FontWeight->"Bold",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "+"]}], "]"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "71a674c6-f655-4020-b00b-f768238119e3"],
 " of the two spinor charges ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[PlusMinus]"], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e67d2d22-0bc3-42ec-807d-b373cd789d8b"],
 " has the upper block ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Psi]", 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Prime]"], 
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["b",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], "-"], ")"}]}], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b9e7d22d-cef0-4335-ba21-1109ded876ee"],
 " (components 1 to 4) and the lower block ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Psi]", 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Prime]"], 
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["b",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], "+"], ")"}]}], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "173b6875-5def-4835-8918-93a4cd54ecc3"],
 " (components 5 to 8). The check shows, with random bi-quaternions: (a) a \
frame matrix acting on a Weyl isodoublet is a right multiplication of the \
spinor charge, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["x",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    SubsuperscriptBox["\[Psi]", 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Prime]"], 
    RowBox[{"(", 
     StyleBox["y",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[LongEqual]", 
    SubsuperscriptBox["\[Psi]", 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Prime]"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["y",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      OverscriptBox[
       StyleBox["x",
        FontWeight->"Bold",
        FontSlant->"Plain"], "_"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "16ce2ef5-5e83-445b-863f-564b73fdb4fc"],
 ", in agreement with the Cayley-Dickson product ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      StyleBox["a",
       FontWeight->"Bold",
       FontSlant->"Plain"], "+", 
      StyleBox["b",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      SubscriptBox[
       StyleBox["e",
        FontWeight->"Bold",
        FontSlant->"Plain"], "4"]}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["c",
       FontWeight->"Bold",
       FontSlant->"Plain"], "+", 
      StyleBox["d",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      SubscriptBox[
       StyleBox["e",
        FontWeight->"Bold",
        FontSlant->"Plain"], "4"]}], ")"}], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["a",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      StyleBox["c",
       FontWeight->"Bold",
       FontSlant->"Plain"], "-", 
      OverscriptBox[
       StyleBox["d",
        FontWeight->"Bold",
        FontSlant->"Plain"], "_"], 
      StyleBox["b",
       FontWeight->"Bold",
       FontSlant->"Plain"]}], ")"}], "+", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["d",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      StyleBox["a",
       FontWeight->"Bold",
       FontSlant->"Plain"], "+", 
      StyleBox["b",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      OverscriptBox[
       StyleBox["c",
        FontWeight->"Bold",
        FontSlant->"Plain"], "_"]}], ")"}], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "794e1771-e4cb-4549-b537-1bdb1c51c582"],
 ", which gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      StyleBox["y",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      SubscriptBox[
       StyleBox["e",
        FontWeight->"Bold",
        FontSlant->"Plain"], "4"]}], ")"}], 
    StyleBox["x",
     FontWeight->"Bold",
     FontSlant->"Plain"], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["y",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      OverscriptBox[
       StyleBox["x",
        FontWeight->"Bold",
        FontSlant->"Plain"], "_"]}], ")"}], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ee0d641a-5f41-4890-8010-2b73a494beef"],
 "; (b) the Dirac matrices exchange the two spinor charges and multiply them \
by the frame, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p", "TI"]], 
    RowBox[{"[", 
     StyleBox["f",
      FontWeight->"Bold",
      FontSlant->"Plain"], "]"}], 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"[", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["b",
        FontWeight->"Bold",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "-"], ",", 
      SubsuperscriptBox[
       StyleBox["b",
        FontWeight->"Bold",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "+"]}], "]"}], "\[LongEqual]", 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"[", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["b",
        FontWeight->"Bold",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "+"], 
      SubscriptBox[
       OverscriptBox[
        StyleBox["f",
         FontWeight->"Bold",
         FontSlant->"Plain"], "_"], 
       StyleBox["p", "TI"]], ",", 
      SubsuperscriptBox[
       StyleBox["b",
        FontWeight->"Bold",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "-"], 
      SubscriptBox[
       StyleBox["f",
        FontWeight->"Bold",
        FontSlant->"Plain"], 
       StyleBox["p", "TI"]]}], "]"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "df7f6c17-1a13-4006-838c-aaccbe597209"],
 "; (c) the gauge group acts by the automorphisms of the super-loop: ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["\[ScriptCapitalU]",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a6b34193-0603-46dd-91b9-ad4492d56828"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["U",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["v",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "490f48d5-f193-46ac-9917-c148567a34ed"],
 " replaces ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["b",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "+"], TraditionalForm]], "InlineFormula",
