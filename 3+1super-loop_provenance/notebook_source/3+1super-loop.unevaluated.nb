       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<LL,\>\"", ",", " ", "idx"}], "}"}], "]"}], ",", 
       " ", "\"\<F\>\""}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Format", "[", 
      RowBox[{"avS", "[", 
       RowBox[{"i_", ",", " ", "idx_"}], "]"}], "]"}], " ", ":=", " ", 
