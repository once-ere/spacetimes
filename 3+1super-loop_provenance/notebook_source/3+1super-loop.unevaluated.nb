         RowBox[{"Re", "[", 
          RowBox[{"Eigenvalues", "[", "t2testH", "]"}], "]"}], "]"}]}], "]"}],
       "]"}], ",", " ", 
     RowBox[{"Norm", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"t2expm", "[", "t2testM", "]"}], " ", "-", " ", 
        RowBox[{"MatrixExp", "[", "t2testM", "]"}]}], ",", 
       " ", "\"\<Frobenius\>\""}], "]"}]}], "}"}]}], "]"}]}], "Input",Expressi\
onUUID->"70e9a55f-7079-499e-8daf-d89b06960620"],

Cell["\<\
II.1.3 The super-loop operators as matrices (t2core/src/model.rs)\
\>", "Subsection",ExpressionUUID->"58b56040-a173-4f9a-a209-844d62597aef"],

Cell[TextData[{
 "Every matrix of the field equations is built from the matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d6ad9646-5f1d-4b80-9a41-7384fd515f88"],
 " of a bi-quaternion. A bi-quaternion ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["b",
     FontWeight->"Bold",
     FontSlant->"Plain"], "\[LongEqual]", 
    UnderoverscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["p", "TI"], "\[LongEqual]", "0"}], "3",
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox["\[Xi]", 
     StyleBox["p", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["p", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c1517009-c506-4752-b63f-37d9b91c1462"],
 " (four complex coefficients ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Xi]", 
     StyleBox["p", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8d01b5f4-ec1a-4017-be09-915968e08a62"],
 ") has the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Times]", "2"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b7572c7c-15ac-4e17-81f9-78d026647012"],
 " matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[LongEqual]", 
    SubsuperscriptBox["\[Xi]", "0", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    SubsuperscriptBox["\[Sigma]", "0", 
     StyleBox["LL",
      FontSlant->"Plain"]], "-", 
    StyleBox["i", "TI"], "\[ThinSpace]", 
    UnderoverscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["j", "TI"], "\[LongEqual]", "1"}], "3",
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox["\[Xi]", 
     StyleBox["j", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    SubsuperscriptBox["\[Sigma]", 
     StyleBox["j", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b101262a-f0f1-4b56-b7b3-d7adaee5de43"],
 ", so that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubscriptBox[
      StyleBox["e",
       FontWeight->"Bold",
       FontSlant->"Plain"], "0"], ")"}], "\[LongEqual]", 
    SubsuperscriptBox["\[Sigma]", "0", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5724612c-f827-474a-8ded-d39ff5184dff"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubscriptBox[
      StyleBox["e",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      StyleBox["j", "TI"]], ")"}], "\[LongEqual]", 
    RowBox[{"-", 
     StyleBox["i", "TI"]}], 
    SubsuperscriptBox["\[Sigma]", 
     StyleBox["j", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "08d13f21-9431-4be9-b18c-bff74c22a3ea"],
 ". The canonical frame of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[DoubleStruckCapitalR]",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    RowBox[{"1", ",", "3"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dbeec260-9f29-4bff-b302-14f8152fb65a"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["f",
      FontWeight->"Bold",
      FontSlant->"Plain"], "0"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "0"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7d28ff9b-ddca-4881-ae1c-509b7da5225d"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["f",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]], "\[LongEqual]", 
    StyleBox["i", "TI"], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8acb7af8-c1bb-4b01-8286-c2d80e3c14d9"],
 ", with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubscriptBox[
      StyleBox["f",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      StyleBox["p", "TI"]], ")"}], "\[LongEqual]", 
    SubsuperscriptBox["\[Sigma]", 
     StyleBox["p", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b8e8c283-ce9d-4954-89c0-5c56c9804bbe"],
 ". The Dirac matrices of a frame are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p", "TI"]], 
    RowBox[{"[", 
     StyleBox["f",
      FontWeight->"Bold",
      FontSlant->"Plain"], "]"}], "\[LongEqual]", 
    RowBox[{"(", "\[NoBreak]", GridBox[{
       {"0", 
        RowBox[{
         SubscriptBox[
          StyleBox["M", "TI"], 
          StyleBox["LL",
           FontSlant->"Plain"]], 
         RowBox[{"(", 
          SubscriptBox[
           StyleBox["f",
            FontWeight->"Bold",
            FontSlant->"Plain"], 
           StyleBox["p", "TI"]], ")"}]}]},
       {
        RowBox[{
         SubscriptBox[
          StyleBox["M", "TI"], 
          StyleBox["LL",
           FontSlant->"Plain"]], 
         RowBox[{"(", 
          SubscriptBox[
           OverscriptBox[
            StyleBox["f",
             FontWeight->"Bold",
             FontSlant->"Plain"], "_"], 
           StyleBox["p", "TI"]], ")"}]}], "0"}
      },
      GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
      GridBoxSpacings->{"Columns" -> {
          Offset[0.27999999999999997`], {
           Offset[0.7]}, 
          Offset[0.27999999999999997`]}, "Rows" -> {
          Offset[0.2], {
           Offset[0.4]}, 
          Offset[0.2]}}], "\[NoBreak]", ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "82a35b7e-3e5e-439e-a18e-9b904c2dee41"],
 " (the chiral basis; ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["b",
     FontWeight->"Bold",
     FontSlant->"Plain"], "_"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "85e2d1b3-5de8-445f-8724-5eb8d9375d7f"],
 " is the conjugate bi-quaternion, in which the signs of the coefficients of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "1"], ",", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "2"], ",", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "3"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cbcb7a76-0b55-497a-b456-6babd1a825ef"],
 " change); for the canonical frame they are ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "340e6e7a-1210-40a9-b7dc-2bcac6b94fb8"],
 ". The spinor field ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cb9b0bd0-bc70-4f01-b0b0-c2ce39aa02a9"],
 " has the 8 components ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPsi]", 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", "1"}]], ",", "\[Ellipsis]", ",", 
    SubscriptBox["\[CapitalPsi]", 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", "8"}]]}], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3c4eb20a-1090-4216-b6e3-9911d1e66af5"],
 ": components 1 and 2 are the first Dirac component with isospin up and \
down, 3 and 4 the second, 5 and 6 the third, 7 and 8 the fourth. A ",
 Cell[BoxData[
  FormBox[
   RowBox[{"4", "\[Times]", "4"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5e4b04be-52ae-47fa-ab66-054e412aa43b"],
 " matrix of the Dirac index therefore acts on the eight components as its \
Kronecker product with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["1",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "accad4d9-c656-4c4b-b8f0-462a834bab4a"],
 ", and a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Times]", "2"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "15699167-7ab1-4b84-9bdf-697a6431885d"],
 " matrix of the isospin index as the Kronecker product of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["1",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "4"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e6a82bb5-8bd6-409a-a29b-2038537d5c1a"],
 " with it. The cell defines every function of model.rs, in the same order; \
the comment of each function states the formula."
}], "Text",ExpressionUUID->"2a60d4a4-97b0-4fab-9879-97b4ccca214b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", "Pauli", " ", "matrices", " ", "sigma_", "0", " ", 
     RowBox[{"(", "unit", ")"}]}], ",", " ", 
    RowBox[{"sigma_", "1"}], ",", " ", 
    RowBox[{"sigma_", "2"}], ",", " ", 
    RowBox[{"sigma_", "3"}], ",", " ", 
    RowBox[{
     RowBox[{"and", " ", "eps2"}], " ", "=", " ", 
     RowBox[{"i", " ", "sigma_", "2"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"t2sigma", "[", "0", "]"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1"}], "}"}]}], "}"}]}], ";", " ", 
    RowBox[{
     RowBox[{"t2sigma", "[", "1", "]"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2sigma", "[", "2", "]"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", 
         RowBox[{"-", "I"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"I", ",", " ", "0"}], "}"}]}], "}"}]}], ";", " ", 
    RowBox[{
     RowBox[{"t2sigma", "[", "3", "]"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", 
         RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"t2eps2", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "0"}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"M_LL", 
        RowBox[{"(", "b", ")"}], " ", "of", " ", "the", " ", "bi"}], "-", 
       RowBox[{"quaternion", " ", "b"}]}], " ", "=", " ", 
      RowBox[{"sum_p", " ", "xi_p", " ", "e_p"}]}], ",", " ", 
     RowBox[{"xi", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"xi_", "0"}], ",", " ", 
        RowBox[{"xi_", "1"}], ",", " ", 
        RowBox[{"xi_", "2"}], ",", " ", 
        RowBox[{"xi_", "3"}]}], "}"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2mq", "[", "xi_List", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"xi", "[", 
        RowBox[{"[", "1", "]"}], "]"}], " ", 
       RowBox[{"t2sigma", "[", "0", "]"}]}], " ", "-", " ", 
      RowBox[{"I", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"xi", "[", 
           RowBox[{"[", "2", "]"}], "]"}], " ", 
          RowBox[{"t2sigma", "[", "1", "]"}]}], " ", "+", " ", 
         RowBox[{
          RowBox[{"xi", "[", 
           RowBox[{"[", "3", "]"}], "]"}], " ", 
          RowBox[{"t2sigma", "[", "2", "]"}]}], " ", "+", " ", 
         RowBox[{
          RowBox[{"xi", "[", 
           RowBox[{"[", "4", "]"}], "]"}], " ", 
          RowBox[{"t2sigma", "[", "3", "]"}]}]}], ")"}]}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"the", " ", "conjugate", " ", "bi"}], "-", 
      RowBox[{"quaternion", ":", " ", 
       RowBox[{
       "the", " ", "signs", " ", "of", " ", "the", " ", "coefficients", " ", 
        "of", " ", "e1"}]}]}], ",", " ", "e2", ",", " ", 
     RowBox[{"e3", " ", "change"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2bqConj", "[", "xi_List", "]"}], " ", ":=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"xi", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
       RowBox[{"-", 
        RowBox[{"xi", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", 
       RowBox[{"-", 
        RowBox[{"xi", "[", 
         RowBox[{"[", "3", "]"}], "]"}]}], ",", " ", 
       RowBox[{"-", 
        RowBox[{"xi", "[", 
         RowBox[{"[", "4", "]"}], "]"}]}]}], "}"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"the", " ", "canonical", " ", "frame", " ", "of", " ", 
       RowBox[{"R", "^", 
        RowBox[{"(", 
         RowBox[{"1", ",", "3"}], ")"}]}], 
       RowBox[{"_LL", ":", " ", 
        RowBox[{"f_", "0"}]}]}], " ", "=", " ", "e0"}], ",", " ", 
     RowBox[{"f_j", " ", "=", " ", 
      RowBox[{"i", " ", "e_j", " ", 
       RowBox[{"(", 
        RowBox[{"one", " ", "row", " ", "per", " ", "p"}], ")"}]}]}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"t2canonicalFrame", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], "}"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "I", ",", " ", "0", ",", " ", "0"}], "}"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0", ",", " ", "I", ",", " ", "0"}], "}"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0", ",", " ", "0", ",", " ", "I"}], "}"}]}], 
      "}"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
      "the", " ", "Dirac", " ", "matrices", " ", "of", " ", "a", " ", "frame",
        " ", "f", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"a", " ", "list", " ", "of", " ", "four", " ", "bi"}], "-", 
         "quaternions"}], ")"}]}], ":", " ", 
      RowBox[{"gamma", "^", 
       RowBox[{"p", "[", "f", "]"}]}]}], " ", "=", " ", 
     RowBox[{"[", 
      RowBox[{
       RowBox[{"[", 
        RowBox[{"0", ",", " ", 
         RowBox[{"M", 
          RowBox[{"(", "f_p", ")"}]}]}], "]"}], ",", " ", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{"M", 
          RowBox[{"(", 
           RowBox[{"conj", " ", "f_p"}], ")"}]}], ",", " ", "0"}], "]"}]}], 
      "]"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2gammasFromFrame", "[", "f_", "]"}], " ", ":=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"ArrayFlatten", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", " ", 
            RowBox[{"t2mq", "[", 
             RowBox[{"f", "[", 
              RowBox[{"[", 
               RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}], "]"}]}], 
           "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"t2mq", "[", 
             RowBox[{"t2bqConj", "[", 
              RowBox[{"f", "[", 
               RowBox[{"[", 
                RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}], "]"}], "]"}],
             ",", " ", "0"}], "}"}]}], "}"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"gamma_LL", "^", "p"}], " ", "of", " ", "the", " ", "canonical", 
     " ", "frame", " ", 
     RowBox[{"(", 
      RowBox[{"p", " ", "=", " ", 
       RowBox[{
        RowBox[{"0", ".."}], "3"}]}], ")"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"t2gammaList", " ", "=", " ", 
     RowBox[{"t2gammasFromFrame", "[", "t2canonicalFrame", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2gamma", "[", "p_Integer", "]"}], " ", ":=", " ", 
     RowBox[{"t2gammaList", "[", 
      RowBox[{"[", 
       RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"the", " ", "chirality", " ", "matrix", " ", "gamma_ch"}], " ", 
      "=", " ", 
      RowBox[{"i", " ", 
       RowBox[{"gamma", "^", "0"}], " ", 
       RowBox[{"gamma", "^", "1"}], " ", 
       RowBox[{"gamma", "^", "2"}], " ", 
       RowBox[{"gamma", "^", "3"}]}]}], ";", " ", 
