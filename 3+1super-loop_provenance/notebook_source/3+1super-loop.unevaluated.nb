      RowBox[{"0.1", " ", "a"}], " ", "+", " ", 
      RowBox[{"I", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"0.07", " ", 
          RowBox[{"(", 
           RowBox[{"b", " ", "-", " ", "1"}], ")"}]}], " ", "-", " ", "0.2"}],
         ")"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"piSym", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"k", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", " ", "a", ",", " ", "b"}], "]"}], "]"}], " ", 
            "-", " ", 
            RowBox[{"k", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", " ", "b", ",", " ", "a"}], "]"}], "]"}]}], 
           ")"}], " ", 
          RowBox[{"psiS", "[", "a", "]"}], " ", 
          RowBox[{"psiS", "[", "b", "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"a", ",", " ", "8"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"b", ",", " ", 
           RowBox[{"a", " ", "+", " ", "1"}], ",", " ", "8"}], "}"}]}], "]"}],
        ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"pidev", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"piSym", "[", 
             RowBox[{"[", "i", "]"}], "]"}], " ", "/.", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"psiS", "[", "a_", "]"}], " ", 
              RowBox[{"psiS", "[", "b_", "]"}]}], " ", ":>", " ", 
             RowBox[{"prodVal", "[", 
              RowBox[{"a", ",", " ", "b"}], "]"}]}]}], ")"}], " ", "-", " ", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"k", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", " ", "a", ",", " ", "b"}], "]"}], "]"}], 
               " ", "-", " ", 
               RowBox[{"k", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", " ", "b", ",", " ", "a"}], "]"}], "]"}]}], 
              ")"}], " ", 
             RowBox[{"prodVal", "[", 
              RowBox[{"a", ",", " ", "b"}], "]"}]}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"a", ",", " ", "8"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"b", ",", " ", 
              RowBox[{"a", " ", "+", " ", "1"}], ",", " ", "8"}], "}"}]}], 
           "]"}]}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", "3"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{"Column", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"piS", "[", "i", "]"}], ",", " ", "\"\< = \>\"", ",", " ", 
          RowBox[{"piSym", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], "}"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Spacings", " ", "->", " ", "1"}]}], "]"}]}]}]], "Input",Expressi\
onUUID->"d79a82ad-22dd-4ee8-8fb4-dae2c3447163"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "the", " ", "eight", " ", "component", " ", "equations", " ", "of", " ", 
     "the", " ", "exact", " ", "operator", " ", "equation"}], ",", " ", 
    RowBox[{
    "with", " ", "independent", " ", "random", " ", "values", " ", "for", " ",
      "the", " ", "symbols"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"nabPsiVal", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"t2RndVec", "[", "8", "]"}], ",", " ", 
       RowBox[{"{", "3", "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"psiVal", " ", "=", " ", 
     RowBox[{"t2RndVec", "[", "8", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"psiStarVal", " ", "=", " ", 
     RowBox[{"t2RndVec", "[", "8", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"piVal", " ", "=", " ", 
     RowBox[{"t2RndVec", "[", "3", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gVal", " ", "=", " ", "1.3"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"psiV", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"psiS", "[", "l", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"l", ",", " ", "8"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"refExact", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"mass", " ", 
          RowBox[{"t2lift4", "[", "t2beta", "]"}]}], " ", "-", " ", 
         RowBox[{"I", " ", 
          RowBox[{"gamNum", "[", "0", "]"}]}], " ", "-", " ", 
         RowBox[{"acalNum", "[", "0", "]"}], " ", "-", " ", 
         RowBox[{"mu", " ", 
          RowBox[{"IdentityMatrix", "[", "8", "]"}]}]}], ")"}], " ", ".", " ",
        "psiVal"}], " ", "+", "\n", "   ", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "I"}], " ", 
           RowBox[{"t2lift4", "[", 
            RowBox[{"t2alpha", "[", "j", "]"}], "]"}]}], ")"}], " ", ".", " ", 
         RowBox[{"nabPsiVal", "[", 
          RowBox[{"[", "j", "]"}], "]"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}], " ", "-", " ", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"ConjugateTranspose", "[", 
            RowBox[{"k", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "]"}], " ", ".", " ", 
           "psiStarVal"}], ")"}], " ", 
         RowBox[{"piVal", "[", 
          RowBox[{"[", "i", "]"}], "]"}], " ", "0.5", " ", "gVal"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", "3"}], "}"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"exactEq", " ", "=", " ", 
     RowBox[{
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "I"}], " ", 
           RowBox[{"t2lift4", "[", 
            RowBox[{"t2alpha", "[", "j", "]"}], "]"}]}], ")"}], " ", ".", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"nabPsiS", "[", 
            RowBox[{"j", ",", " ", "kk"}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"kk", ",", " ", "8"}], "}"}]}], "]"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}], " ", "+", " ", 
      RowBox[{"mS", " ", 
       RowBox[{
        RowBox[{"t2lift4", "[", "t2beta", "]"}], " ", ".", " ", "psiV"}]}], 
      " ", "-", " ", 
      RowBox[{
       RowBox[{"acalSym", "[", "\"\<0\>\"", "]"}], " ", ".", " ", "psiV"}], 
      " ", "-", "\n", "   ", 
      RowBox[{"I", " ", 
       RowBox[{
        RowBox[{"gamSym", "[", "\"\<0\>\"", "]"}], " ", ".", " ", "psiV"}]}], 
      " ", "-", " ", 
      RowBox[{"muS", " ", "psiV"}], " ", "-", " ", 
      RowBox[{
       RowBox[{"bigGS", "/", "2"}], " ", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"ConjugateTranspose", "[", 
             RowBox[{"k", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "]"}], " ", ".", " ", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"psiStarS", "[", "l", "]"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"l", ",", " ", "8"}], "}"}]}], "]"}]}], ")"}], " ", 
          RowBox[{"piS", "[", "i", "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "3"}], "}"}]}], "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"valsExact", " ", "=", " ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"valsAt", "[", 
        RowBox[{"\"\<0\>\"", ",", " ", "0"}], "]"}], ",", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"psiS", "[", "l", "]"}], " ", "->", " ", 
          RowBox[{"psiVal", "[", 
           RowBox[{"[", "l", "]"}], "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"l", ",", " ", "8"}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"psiStarS", "[", "l", "]"}], " ", "->", " ", 
          RowBox[{"psiStarVal", "[", 
           RowBox[{"[", "l", "]"}], "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"l", ",", " ", "8"}], "}"}]}], "]"}], ",", "\n", "   ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"piS", "[", "i", "]"}], " ", "->", " ", 
          RowBox[{"piVal", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"nabPsiS", "[", 
            RowBox[{"j", ",", " ", "kk"}], "]"}], " ", "->", " ", 
           RowBox[{"nabPsiVal", "[", 
            RowBox[{"[", 
             RowBox[{"j", ",", " ", "kk"}], "]"}], "]"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"j", ",", " ", "3"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"kk", ",", " ", "8"}], "}"}]}], "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"mS", " ", "->", " ", "mass"}], ",", " ", 
         RowBox[{"muS", " ", "->", " ", "mu"}], ",", " ", 
         RowBox[{"bigGS", " ", "->", " ", "gVal"}]}], "}"}]}], "]"}]}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"eqdev3", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"exactEq", " ", "/.", " ", "valsExact"}], ")"}], " ", "-", 
        " ", "refExact"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", "super"}], "-", 
     RowBox[{"loop", " ", "Weyl", " ", "blocks", " ", "M_LL", 
      RowBox[{"(", "D", ")"}], " ", "and", " ", "M_LL", 
      RowBox[{"(", 
       RowBox[{"conj", " ", "D"}], ")"}], " ", "as", " ", "2", " ", "x", " ", 
      "2", " ", "operator", " ", "matrices"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"mdSym", " ", "=", " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"t2mq", "[", 
         RowBox[{"t2canonicalFrame", "[", 
          RowBox[{"[", 
           RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}], "]"}], " ", 
        RowBox[{"nablaS", "[", "p", "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"mdbSym", " ", "=", " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"t2mq", "[", 
         RowBox[{"t2bqConj", "[", 
          RowBox[{"t2canonicalFrame", "[", 
           RowBox[{"[", 
            RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}], "]"}], "]"}], " ", 
        RowBox[{"nablaS", "[", "p", "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"Column", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"I", " ", 
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<\[PartialD]\>\"", ",", " ", "0"}], "]"}]}], ",", " ", 
          RowBox[{"psiS", "[", "1", "]"}], ",", " ", "\"\< = \>\"", ",", " ", 
          
          RowBox[{"exactEq", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "}"}], "]"}], ",", " ", 
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{
          SubscriptBox["M", "LL"], ",", " ", "\"\<(\>\"", ",", " ", 
          SubscriptBox[
           TagBox[
            StyleBox["D",
             FontWeight->"Bold",
             FontSlant->"Plain"],
            "SL31Bold"], "LL"], ",", " ", "\"\<) = \>\"", ",", " ", 
          RowBox[{"MatrixForm", "[", "mdSym", "]"}], ",", " ", "\"\<,   \>\"",
           ",", " ", 
          SubscriptBox["M", "LL"], ",", " ", "\"\<(\>\"", ",", " ", 
          RowBox[{"OverBar", "[", 
           SubscriptBox[
            TagBox[
             StyleBox["D",
              FontWeight->"Bold",
              FontSlant->"Plain"],
             "SL31Bold"], "LL"], "]"}], ",", " ", "\"\<) = \>\"", ",", " ", 
          RowBox[{"MatrixForm", "[", "mdbSym", "]"}]}], "}"}], "]"}]}], "}"}],
      ",", " ", 
     RowBox[{"Spacings", " ", "->", " ", "1"}]}], "]"}]}]}]], "Input",Expressi\
onUUID->"f00f7507-7aec-4b28-8d83-d8a1f2d512fd"],

Cell[BoxData[
 RowBox[{"SL31Check", "[", 
  RowBox[{"\"\<GS-12\>\"", ",", 
   " ", "\"\<the printed formulas agree with the matrices that they describe: \
the entries of Ppair (symbolic d), of the blocks of sgen(u_p) and of Gamma_p, \
the expansions of the covariant derivatives, the sixteen equations of the \
Dirac-Bogoliubov-de Gennes system, the pair operators Pi and the eight exact \
equations, each evaluated for numbers assigned to its symbols and compared \
with the matrix computation (tolerance 1e-12)\>\"", ",", "\n", "  ", 
   RowBox[{
    RowBox[{"pdev", " ", "<", " ", "1*^-12"}], " ", "&&", " ", 
    RowBox[{"eqdev", " ", "<", " ", "1*^-12"}], " ", "&&", " ", 
    RowBox[{"eqdev2", " ", "<", " ", "1*^-12"}], " ", "&&", " ", 
    RowBox[{"pidev", " ", "<", " ", "1*^-12"}], " ", "&&", " ", 
    RowBox[{"eqdev3", " ", "<", " ", "1*^-12"}]}], ",", "\n", "  ", 
   RowBox[{"Row", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<largest deviations \>\"", ",", " ", "pdev", ",", 
      " ", "\"\<, \>\"", ",", " ", "eqdev", ",", " ", "\"\<, \>\"", ",", " ", 
      "eqdev2", ",", " ", "\"\<, \>\"", ",", " ", "pidev", ",", 
      " ", "\"\<, \>\"", ",", " ", "eqdev3", ",", 
      " ", "\"\< (original: 0.0e0, 4.0e-16, 3.4e-16, 0.0e0, 5.0e-16)\>\""}], 
     "}"}], "]"}]}], "]"}]], "Input",ExpressionUUID->"a8425932-6a3d-4938-82aa-\
be39dbabb92c"],

Cell["\<\
GS-13: the time integration by IDA, compared with the exact solution\
\>", "Subsection",ExpressionUUID->"c0cedcd9-c032-40b7-ae9f-ecd3a6d12966"],

Cell[TextData[{
 "The original program checks its time integration on the lattice of GS-10 \
(",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", "\[Times]", "2", "\[Times]", "4"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b0b05513-1c89-4ded-bd36-1e3e68203f40"],
 " sites with random links, potentials and pair fields; ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["cpx",
      FontSlant->"Plain"]], "\[LongEqual]", "384"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "60a0e185-c6d8-4b33-b734-e6ad6d4b8fa2"],
 "). From a random initial state ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["w", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["lat",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2925ab8a-fe79-4763-94de-b732f6793a02"],
 " of the norm 1, drawn from a generator of its own (seed 2026111713, so that \
the random numbers of the later checks are not shifted), it integrates the \
lattice equations with CVODE up to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "0"], "\[LongEqual]", "20"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7ac81100-c802-44a4-b6f4-1eb509d4a2c0"],
 ", with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["tol",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox["10", 
     RowBox[{"-", "8"}]], ",", 
    SuperscriptBox["10", 
     RowBox[{"-", "10"}]], ",", 
    SuperscriptBox["10", 
     RowBox[{"-", "12"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3f212ee7-15f8-4785-87e1-1dc46b694bc5"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["tol",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["tol",
      FontSlant->"Plain"]], "/", "100"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "544a40c5-265e-4d89-9e1d-d43888b68355"],
 ", and compares the states at the 41 output times ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "0"], "\[LongEqual]", "0", ",", "0.5", ",", 
    "\[Ellipsis]", ",", "20"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ad5e86a1-25b2-480f-8c65-46b679be9a97"],
 " with the exact solution ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["w", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["ex",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0195f559-7c36-48db-bba2-05c161bb69eb"],
 ": the sum over the eigenvectors of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalH]",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["lat",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f17ff1ac-d55f-4dcc-b9c5-d298c7ca939c"],
 " of the eigenvector times its scalar product with the initial state times \
the phase factor of the angle ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     SubsuperscriptBox[
      StyleBox["E", "TI"], 
      RowBox[{
       StyleBox["LL",
        FontSlant->"Plain"], ",", 
       StyleBox["n", "TI"]}], 
      StyleBox["qp",
       FontSlant->"Plain"]]}], 
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "0"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6bb8e234-5bf4-49ef-86c9-55c6d2f0eb1a"],
 " (eigensolver ",
 StyleBox["t2eigh",
  FontFamily->"Source Code Pro"],
 "). The quantity compared is the relative deviation ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Delta]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["rel",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "eca6f899-50ea-464a-8a6e-0361b6048599"],
 ", the norm of the difference between the computed and the exact state \
divided by the norm of the exact state. The notebook repeats the check with \
IDA in place of CVODE (functions ",
 StyleBox["t2evolveIDA",
  FontFamily->"Source Code Pro"],
 " and ",
 StyleBox["t2localErrorsIDA",
  FontFamily->"Source Code Pro"],
 " of chapter II.1.5): the same lattice, the same initial state, the same \
tolerances, the same output times."
}], "Text",ExpressionUUID->"aca42f32-b871-4e0c-baef-066a7bbe0aff"],

Cell[TextData[{
 "The check has four parts, for each of the three tolerances. (1) The exact \
local error ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Delta]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["loc",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9b21df1b-4476-48e0-976a-b7145f1de4ee"],
 " of every internal step is at most ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["loc",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["tol",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e4cdb7ea-0fa0-4a61-9622-b3114352de78"],
 " times the norm of the state plus ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["tol",
      FontSlant->"Plain"]], 
    SqrtBox[
     RowBox[{"2", 
      SubsuperscriptBox[
       StyleBox["n", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["cpx",
        FontSlant->"Plain"]]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "61e1fa38-e7b7-4790-8232-2117e9bf5bce"],
 ". Because the evolution is unitary, the deviation at the end of every \
internal step is then at most ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["err",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["st",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["loc",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4cacbcda-2af5-440a-a6c1-c26a8f47ba55"],
 " (chapter II.1.5). (2) The states of ",
 StyleBox["NDSolve",
  FontFamily->"Source Code Pro"],
 " at the output times are the cubic Hermite polynomials of the stored values \
and derivatives (tolerance ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "12"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a42e7a18-9153-4563-8254-7d9d1bea530a"],
 "), so that the bound ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["out",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b2950797-173c-4d2b-926f-459c6c07b663"],
 " of chapter II.1.5 holds for them, and the largest ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Delta]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["rel",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "65f08505-096d-473b-a2b9-f55da4afd0ab"],
 " is at most ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["out",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0257425e-7dae-429e-80bb-63c70a10a004"],
 " (the exact state has the norm 1, so the relative deviation is the \
deviation). (3) The largest deviation decreases from ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["tol",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox["10", 
     RowBox[{"-", "8"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b2f820e5-f607-448d-992a-632f47ec872c"],
 " to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "10"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9aebdfae-c8bd-487c-aa9b-1e9e851954f0"],
 " to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "12"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1509b836-0e7b-48ca-9770-73d979d79214"],
 ". (4) The two requirements of the original check for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["tol",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox["10", 
     RowBox[{"-", "12"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ceb7ac8b-ce5f-4186-906c-d5628b1053db"],
 ": the largest deviation stays below ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "9"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "857730ef-616d-4080-b50f-56b7e52b04bb"],
 ", and the norm of the state, which the exact evolution conserves, changes \
by less than ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "10"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2fd1a6f3-951c-44c0-b714-2b19991f9ae8"],
 ". The printed line also gives the numbers of internal steps ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["N", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["st",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4c9bd1c9-7d67-4946-9919-8c64d432370a"],
 " and of evaluations ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["N", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["ev",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c4aa41c4-e44d-477c-b7a9-7ac455ab4011"],
 " of the right side, the largest internal steps, and the results of CVODE \
from the report of the original program."
}], "Text",ExpressionUUID->"1898892b-e01c-4606-9f83-c5920df105e3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"GS", "-", "13"}], ":", " ", 
     RowBox[{
     "the", " ", "initial", " ", "state", " ", "from", " ", "a", " ", 
      "generator", " ", "of", " ", "its", " ", "own", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"seed", " ", "2026111713"}], ")"}], ".", "  ", "The"}], " ", 
      "state", " ", "of", " ", "the", " ", "main", " ", "generator", " ", 
      "is", " ", "kept", "\n", "   ", "and", " ", "restored"}]}], ",", " ", 
    RowBox[{
    "so", " ", "that", " ", "the", " ", "random", " ", "numbers", " ", "of", " ",
      "the", " ", "later", " ", "checks", " ", "are", " ", "those", " ", "of",
      " ", "the", " ", "original", " ", "program"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"rngKept13", " ", "=", " ", "t2rngState"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"t2Seed", "[", "2026111713", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"w0IDA13", " ", "=", " ", 
     RowBox[{"t2RndVec", "[", 
      RowBox[{"t2dim", "[", "lat", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"t2rngState", " ", "=", " ", "rngKept13"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"w0IDA13", " ", "=", " ", 
     RowBox[{"w0IDA13", "/", 
      RowBox[{"Norm", "[", "w0IDA13", "]"}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"the", " ", "exact", " ", 
     RowBox[{"solution", ":", " ", 
      RowBox[{
      "the", " ", "eigenvalues", " ", "and", " ", "eigenvectors", " ", "of", " ",
        "H_lat", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"t2eigh", ":", " ", 
          RowBox[{"ascending", " ", "eigenvalues"}]}], ",", " ", 
         RowBox[{
         "the", " ", "eigenvectors", " ", "in", " ", "the", "\n", "   ", 
          "columns"}]}], ")"}], " ", "and", " ", "the", " ", "spectral", " ", 
       "sum"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"e13", ",", " ", "v13"}], "}"}], " ", "=", " ", 
     RowBox[{"t2eigh", "[", "hl", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"eMax13", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", "e13", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"coef13", " ", "=", " ", 
     RowBox[{
      RowBox[{"ConjugateTranspose", "[", "v13", "]"}], " ", ".", " ", 
      "w0IDA13"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"wExact13", "[", 
      RowBox[{"x0_", "?", "NumericQ"}], "]"}], " ", ":=", " ", 
     RowBox[{"v13", " ", ".", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "I"}], " ", "e13", " ", "x0"}], "]"}], " ", "coef13"}],
        ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"touts13", " ", "=", " ", 
     RowBox[{"Range", "[", 
      RowBox[{"0.", ",", " ", "20.", ",", " ", "0.5"}], "]"}]}], ";"}], "\n", 
   
   RowBox[{
    RowBox[{"exact13", " ", "=", " ", 
     RowBox[{"wExact13", " ", "/@", " ", "touts13"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rtols13", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"1.*^-8", ",", " ", "1.*^-10", ",", " ", "1.*^-12"}], "}"}]}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "three", " ", "integrations", " ", "by", " ", "IDA"}], ",", 
     " ", 
     RowBox[{"atol", " ", "=", " ", 
      RowBox[{"rtol", "/", "100"}]}], ",", " ", 
     RowBox[{
     "each", " ", "with", " ", "the", " ", "measurement", " ", "of", " ", 
      "the", " ", "local", " ", "errors", " ", "of", " ", "all", " ", "its", " ",
       "steps"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"time13", ",", " ", "runs13"}], "}"}], " ", "=", " ", 
     RowBox[{"AbsoluteTiming", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"t2evolveIDA", "[", 
         RowBox[{
         "hl", ",", " ", "w0IDA13", ",", " ", "touts13", ",", " ", "rt", ",", 
          " ", 
          RowBox[{"rt", "/", "100"}], ",", " ", 
          RowBox[{"t2localErrorsIDA", "[", 
           RowBox[{"e13", ",", " ", "v13", ",", " ", "rt", ",", " ", 
            RowBox[{"rt", "/", "100"}]}], "]"}]}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"rt", ",", " ", "rtols13"}], "}"}]}], "]"}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"dev13", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Norm", "[", 
            RowBox[{"#1", " ", "-", " ", "#2"}], "]"}], "/", 
           RowBox[{"Norm", "[", "#2", "]"}]}], " ", "&"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"runs13", "[", 
            RowBox[{"[", 
             RowBox[{"k", ",", " ", "\"\<states\>\""}], "]"}], "]"}], ",", 
           " ", "exact13"}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"maxdev13", " ", "=", " ", 
     RowBox[{"Max", " ", "/@", " ", "dev13"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"normChange13", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Max", "[", 
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"Norm", " ", "/@", " ", 
           RowBox[{"runs13", "[", 
            RowBox[{"[", 
             RowBox[{"k", ",", " ", "\"\<states\>\""}], "]"}], "]"}]}], " ", "-",
           " ", "1"}], "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"steps13", " ", "=", " ", 
     RowBox[{"runs13", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", " ", "\"\<steps\>\""}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"evals13", " ", "=", " ", 
     RowBox[{"runs13", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", " ", "\"\<evaluations\>\""}], "]"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"hmax13", " ", "=", " ", 
     RowBox[{"runs13", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", " ", "\"\<hmax\>\""}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ratio13", " ", "=", " ", 
     RowBox[{"runs13", "[", 
      RowBox[{"[", 
       RowBox[{
       "All", ",", " ", "\"\<analysis\>\"", ",", 
        " ", "\"\<largestRatio\>\""}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"norm13", " ", "=", " ", 
     RowBox[{"runs13", "[", 
      RowBox[{"[", 
       RowBox[{
       "All", ",", " ", "\"\<analysis\>\"", ",", " ", "\"\<largestNorm\>\""}],
        "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"resid13", " ", "=", " ", 
     RowBox[{"Max", " ", "/@", " ", 
      RowBox[{"runs13", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", " ", "\"\<residualAt\>\""}], "]"}], "]"}]}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"hermite13", " ", "=", " ", 
     RowBox[{"Max", " ", "/@", " ", 
      RowBox[{"runs13", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", " ", "\"\<hermiteAt\>\""}], "]"}], "]"}]}]}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"B", "^", "loc"}], " ", "=", " ", 
      RowBox[{
       RowBox[{"rtol", " ", 
        RowBox[{"(", 
         RowBox[{"largest", " ", "norm", " ", "of", " ", "a", " ", "state"}], 
         ")"}]}], " ", "+", " ", 
       RowBox[{"atol", " ", "sqrt", 
        RowBox[{"(", 
         RowBox[{"2", " ", 
          RowBox[{"n", "^", "cpx"}]}], ")"}]}]}]}], ";", " ", 
     RowBox[{
      RowBox[{"B", "^", "err"}], " ", "=", " ", 
      RowBox[{
       RowBox[{"N", "^", "st"}], " ", 
       RowBox[{"B", "^", "loc"}]}]}], ";", " ", 
     RowBox[{
      RowBox[{"B", "^", "out"}], " ", "as", " ", "in", " ", "chapter", " ", 
      "II", ".1", ".5"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"bloc13", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"rtols13", "[", 
          RowBox[{"[", "k", "]"}], "]"}], " ", 
         RowBox[{"norm13", "[", 
          RowBox[{"[", "k", "]"}], "]"}]}], " ", "+", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"rtols13", "[", 
           RowBox[{"[", "k", "]"}], "]"}], "/", "100"}], " ", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"2.", " ", 
           RowBox[{"t2dim", "[", "lat", "]"}]}], "]"}]}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"berr13", " ", "=", " ", 
     RowBox[{"steps13", " ", "bloc13"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"bout13", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", " ", "+", " ", 
           RowBox[{
            RowBox[{"hmax13", "[", 
             RowBox[{"[", "k", "]"}], "]"}], " ", 
            RowBox[{"eMax13", "/", "4"}]}]}], ")"}], " ", 
         RowBox[{"berr13", "[", 
          RowBox[{"[", "k", "]"}], "]"}]}], " ", "+", " ", 
        RowBox[{
         RowBox[{"hmax13", "[", 
          RowBox[{"[", "k", "]"}], "]"}], " ", 
         RowBox[{
          RowBox[{"resid13", "[", 
           RowBox[{"[", "k", "]"}], "]"}], "/", "4"}]}], " ", "+", " ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"hmax13", "[", 
              RowBox[{"[", "k", "]"}], "]"}], " ", "eMax13"}], ")"}], "^", 
           "4"}], "/", "384"}], " ", 
         RowBox[{"norm13", "[", 
          RowBox[{"[", "k", "]"}], "]"}]}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"sci13", "[", "l_List", "]"}], " ", ":=", " ", 
     RowBox[{"Row", "[", 
      RowBox[{"Riffle", "[", 
       RowBox[{
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"ScientificForm", "[", 
            RowBox[{"#", ",", " ", "2"}], "]"}], " ", "&"}], ",", " ", "l"}], 
         "]"}], ",", " ", "\"\<, \>\""}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "numbers", " ", "of", " ", "internal", " ", "steps", " ", 
      "of", " ", "CVODE", " ", "for", " ", "the", " ", "three", " ", 
      "tolerances"}], ",", " ", 
     RowBox[{
     "from", " ", "the", " ", "report", " ", "of", " ", "the", " ", 
      "original", " ", "program"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"cvSteps13", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"1528", ",", " ", "3661", ",", " ", "3804"}], "}"}]}], ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<GS-13\>\"", ",", 
     " ", "\"\<time integration: the lattice equations (i times the \
derivative of the Nambu mode w_lat with respect to the time x_LL^0 equals \
H_lat w_lat) are integrated by IDA (SUNDIALS, through NDSolve with Method -> \
\\\"IDA\\\": backward differentiation formulas of the orders 1 to 5 with \
local error control and Newton's method; the tolerance of every real unknown \
is rtol times its modulus plus atol) in place of CVODE of the original \
program; on the 3 x 2 x 4 lattice of GS-10 (384 complex components), from the \
random initial state of the norm 1 of the original program, for each of rtol \
= 1e-8, 1e-10, 1e-12 (atol = rtol/100): (1) the exact local error local_error \
of every internal step is at most budget_step = rtol (norm of the state) + \
atol sqrt(768); (2) the states at the 41 output times x_LL^0 = 0, 0.5, ..., \
20 are the cubic Hermite polynomials of the stored values and derivatives \
(tolerance 1e-12), and their largest relative deviation from the exact \
spectral solution w_exact is at most budget_out = (1 + h_IDA E_max/4) budget \
+ h_IDA deriv_residual/4 + (h_IDA E_max)^4/384 with budget = N_steps \
budget_step; (3) the largest deviation decreases from rtol = 1e-8 to 1e-10 to \
1e-12; (4) for rtol = 1e-12 it stays below 1e-9, and the norm of the state \
changes by less than 1e-10\>\"", ",", "\n", "  ", 
     RowBox[{
      RowBox[{"And", " ", "@@", " ", 
       RowBox[{"Thread", "[", 
        RowBox[{"ratio13", " ", "<=", " ", "1"}], "]"}]}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"Max", "[", "hermite13", "]"}], " ", "<", " ", "1*^-12"}], " ",
       "&&", " ", 
      RowBox[{"And", " ", "@@", " ", 
       RowBox[{"Thread", "[", 
        RowBox[{"maxdev13", " ", "<=", " ", "bout13"}], "]"}]}], " ", "&&", 
      " ", 
      RowBox[{
       RowBox[{"maxdev13", "[", 
        RowBox[{"[", "1", "]"}], "]"}], " ", ">", " ", 
       RowBox[{"maxdev13", "[", 
        RowBox[{"[", "2", "]"}], "]"}], " ", ">", " ", 
       RowBox[{"maxdev13", "[", 
        RowBox[{"[", "3", "]"}], "]"}]}], " ", "&&", "\n", "   ", 
      RowBox[{
       RowBox[{"maxdev13", "[", 
        RowBox[{"[", "3", "]"}], "]"}], " ", "<", " ", "1*^-9"}], " ", "&&", 
      " ", 
      RowBox[{
       RowBox[{"normChange13", "[", 
        RowBox[{"[", "3", "]"}], "]"}], " ", "<", " ", "1*^-10"}]}], ",", 
     "\n", "  ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<for rtol = 1e-8, 1e-10, 1e-12: largest \
local_error/budget_step \>\"", ",", " ", 
        RowBox[{"sci13", "[", "ratio13", "]"}], ",", 
        " ", "\"\<; largest relative deviations \>\"", ",", " ", 
        RowBox[{"sci13", "[", "maxdev13", "]"}], ",", 
        " ", "\"\< <= budget_out \>\"", ",", " ", 
        RowBox[{"sci13", "[", "bout13", "]"}], ",", "\n", 
        "    ", "\"\< (budget \>\"", ",", " ", 
        RowBox[{"sci13", "[", "berr13", "]"}], ",", 
        " ", "\"\<); largest norm changes \>\"", ",", " ", 
        RowBox[{"sci13", "[", "normChange13", "]"}], ",", 
        " ", "\"\<; N_steps \>\"", ",", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"steps13", ",", " ", "\"\<, \>\""}], "]"}], ",", 
        " ", "\"\<; N_evals \>\"", ",", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"evals13", ",", " ", "\"\<, \>\""}], "]"}], ",", 
        " ", "\"\<; largest h_IDA \>\"", ",", " ", 
        RowBox[{"sci13", "[", "hmax13", "]"}], ",", "\n", 
        "    ", "\"\<; largest deriv_residual \>\"", ",", " ", 
        RowBox[{"sci13", "[", "resid13", "]"}], ",", 
        " ", "\"\<; Hermite polynomials within \>\"", ",", " ", 
        RowBox[{"sci13", "[", "hermite13", "]"}], ",", " ", "\"\<; E_max \>\"",
         ",", " ", 
        RowBox[{"NumberForm", "[", 
         RowBox[{"eMax13", ",", " ", 
          RowBox[{"{", 
           RowBox[{"6", ",", " ", "4"}], "}"}]}], "]"}], ",", 
        " ", "\"\<; computing time \>\"", ",", " ", 
        RowBox[{"Round", "[", 
         RowBox[{"time13", ",", " ", "0.1"}], "]"}], ",", "\n", 
        "    ", "\"\< s (original program, CVODE: largest relative deviations \
1.2e-6, 1.7e-7, 1.7e-10, budgets 2.6e-5, 6.2e-7, 6.4e-9, norm changes 5.2e-7, \
9.8e-8, 5.9e-11, steps 1528, 3661, 3804)\>\""}], "}"}], "]"}]}], 
    "]"}]}]}]], "Input",ExpressionUUID->"6a38480a-bf93-44b6-9019-\
ae7918238f5a"],

Cell["GS-14: the super-loop form of the field equations", "Subsection",ExpressionUUID->"2139de2b-c0f1-4ee0-bf75-3a78c16e8180"],

Cell[TextData[{
 "The Weyl isodoublet of a spinor charge ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["y",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dd98b169-e871-4ed0-bb81-3c9c1f254754"],
 " (with a bi-quaternion ",
 Cell[BoxData[
  FormBox[
   StyleBox["y",
    FontWeight->"Bold",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b809f83b-69da-44f3-bb52-b92aa1a838c4"],
 ") is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Psi]", 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Prime]"], 
    RowBox[{"(", 
     StyleBox["y",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["E",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     RowBox[{"-", "1"}]], 
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      StyleBox["y",
       FontWeight->"Bold",
       FontSlant->"Plain"], ")"}], 
     StyleBox["T", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "96fb8f3b-471b-479f-9c80-4246d7a3589d"],
 ", and the Dirac isodoublet ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"[", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["b",
        FontWeight->"Bold",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "-"], ",", 
      SubsuperscriptBox[
       StyleBox["b",
        FontWeight->"Bold",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "+"]}], "]"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6fdcfff6-1778-4b7b-82d3-5d4882d13903"],
 " of the two spinor charges ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[PlusMinus]"], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "373be9c0-ab7b-4702-8cdd-c58f61e16f2c"],
 " has the upper block ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Psi]", 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Prime]"], 
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["b",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], "-"], ")"}]}], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bd2db25d-cf0c-401f-b9f5-9347272fd2f7"],
 " (components 1 to 4) and the lower block ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Psi]", 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Prime]"], 
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["b",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], "+"], ")"}]}], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "94bf3ba4-8a59-42b1-af8b-c9e8d9b691aa"],
 " (components 5 to 8). The check shows, with random bi-quaternions: (a) a \
frame matrix acting on a Weyl isodoublet is a right multiplication of the \
spinor charge, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["x",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    SubsuperscriptBox["\[Psi]", 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Prime]"], 
    RowBox[{"(", 
     StyleBox["y",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[LongEqual]", 
    SubsuperscriptBox["\[Psi]", 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Prime]"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["y",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      OverscriptBox[
       StyleBox["x",
        FontWeight->"Bold",
        FontSlant->"Plain"], "_"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "339c0be4-821e-4a15-a25b-5909e53325d7"],
 ", in agreement with the Cayley-Dickson product ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      StyleBox["a",
       FontWeight->"Bold",
       FontSlant->"Plain"], "+", 
      StyleBox["b",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      SubscriptBox[
       StyleBox["e",
        FontWeight->"Bold",
        FontSlant->"Plain"], "4"]}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["c",
       FontWeight->"Bold",
       FontSlant->"Plain"], "+", 
      StyleBox["d",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      SubscriptBox[
       StyleBox["e",
        FontWeight->"Bold",
        FontSlant->"Plain"], "4"]}], ")"}], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["a",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      StyleBox["c",
       FontWeight->"Bold",
       FontSlant->"Plain"], "-", 
      OverscriptBox[
       StyleBox["d",
        FontWeight->"Bold",
        FontSlant->"Plain"], "_"], 
      StyleBox["b",
       FontWeight->"Bold",
       FontSlant->"Plain"]}], ")"}], "+", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["d",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      StyleBox["a",
       FontWeight->"Bold",
       FontSlant->"Plain"], "+", 
      StyleBox["b",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      OverscriptBox[
       StyleBox["c",
        FontWeight->"Bold",
        FontSlant->"Plain"], "_"]}], ")"}], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c0d3e3ca-1ce9-4af0-9cbe-ba1acfe232a0"],
 ", which gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      StyleBox["y",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      SubscriptBox[
       StyleBox["e",
        FontWeight->"Bold",
        FontSlant->"Plain"], "4"]}], ")"}], 
    StyleBox["x",
     FontWeight->"Bold",
     FontSlant->"Plain"], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["y",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      OverscriptBox[
       StyleBox["x",
        FontWeight->"Bold",
        FontSlant->"Plain"], "_"]}], ")"}], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7001bd3d-e1a9-48b3-880a-eb7e46917618"],
 "; (b) the Dirac matrices exchange the two spinor charges and multiply them \
by the frame, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p", "TI"]], 
    RowBox[{"[", 
     StyleBox["f",
      FontWeight->"Bold",
      FontSlant->"Plain"], "]"}], 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"[", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["b",
        FontWeight->"Bold",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "-"], ",", 
      SubsuperscriptBox[
       StyleBox["b",
        FontWeight->"Bold",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "+"]}], "]"}], "\[LongEqual]", 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"[", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["b",
        FontWeight->"Bold",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "+"], 
      SubscriptBox[
       OverscriptBox[
        StyleBox["f",
         FontWeight->"Bold",
         FontSlant->"Plain"], "_"], 
       StyleBox["p", "TI"]], ",", 
      SubsuperscriptBox[
       StyleBox["b",
        FontWeight->"Bold",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "-"], 
      SubscriptBox[
       StyleBox["f",
        FontWeight->"Bold",
        FontSlant->"Plain"], 
       StyleBox["p", "TI"]]}], "]"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "af08ec1d-6136-4115-a320-86f7e145bc4d"],
 "; (c) the gauge group acts by the automorphisms of the super-loop: ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["\[ScriptCapitalU]",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1e5575c1-0dcc-4ea0-9063-4f3cc6010091"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["U",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["v",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3043b2d1-caa7-4329-8258-2f9a526be1de"],
 " replaces ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["b",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "+"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "32ccd3d1-289b-4303-bef0-3ff83618315c"],
 " by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      StyleBox["i", "TI"], 
      SubsuperscriptBox["\[Theta]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["F",
        FontSlant->"Plain"]]}]], 
    StyleBox["v",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    SubsuperscriptBox[
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "+"], 
    OverscriptBox[
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], "_"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3bec2df2-b5a4-4012-b2d0-1270c9c6f717"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["b",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "-"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c85ba47f-62ec-4571-831d-a14411c6273d"],
 " by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      StyleBox["i", "TI"], 
      SubsuperscriptBox["\[Theta]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["F",
        FontSlant->"Plain"]]}]], 
    StyleBox["v",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    SubsuperscriptBox[
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "-"], 
    SuperscriptBox[
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], "\[Dagger]"]}], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "eff6cadd-41d1-4200-a384-5fb492d1b5cf"],
 " (and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], "~"], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], "*"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "68811a60-a2e8-4aaf-ab91-35395db5668f"],
 "); (d) the covariant derivative acts through the derivations of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["\[DoubleStruckCapitalB]",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9b1eb7ee-38df-4801-8917-572beeba8b68"],
 ": on ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["b",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "+"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7ea5d4d6-d67f-4500-ad54-5439802dbf76"],
 " it is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", 
     StyleBox["p", "TI"]], 
    SubsuperscriptBox[
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "+"], "-", 
    SubsuperscriptBox[
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "+"], 
    SubsuperscriptBox[
     StyleBox["u",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], "\[Omega]"], "+", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["t",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], 
     StyleBox["A",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "+"], "-", 
    StyleBox["i", "TI"], 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], 
     StyleBox["F",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "+"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ca5f4de2-4154-44e3-afa6-004a581a565f"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["t",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], 
     StyleBox["A",
      FontSlant->"Plain"]], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", "\[Iota]",
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], "\[Iota]"], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "\[Iota]"], "/", "2"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "276dcdda-c34e-41fa-9aa8-e308c236c182"],
 ", and on ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["b",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "-"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c1c445e3-5839-4d88-9180-b3c3b4159411"],
 " the same with ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["u",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}], 
    RowBox[{"\[Omega]", "*"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "108ca810-b440-46c5-96d8-c5891b7f76aa"],
 " in place of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["u",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}], "\[Omega]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "88d21301-4030-4259-b5fe-6c2fd282a2ad"],
 "; (e) the Dirac operator is the right multiplication by the frame, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["p", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p", "TI"]], 
    SubsuperscriptBox["\[Del]", 
     StyleBox["p", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"[", 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       StyleBox["p", "TI"],
       LimitsPositioning->True], 
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox["\[Del]", 
         StyleBox["p", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"]], 
        SubsuperscriptBox[
         StyleBox["b",
          FontWeight->"Bold",
          FontSlant->"Plain"], 
         StyleBox["LL",
          FontSlant->"Plain"], "+"]}], ")"}], 
      SubscriptBox[
       OverscriptBox[
        StyleBox["f",
         FontWeight->"Bold",
         FontSlant->"Plain"], "_"], 
       StyleBox["p", "TI"]], ",", 
      UnderscriptBox["\[Sum]", 
       StyleBox["p", "TI"],
       LimitsPositioning->True], 
      RowBox[{"(", 
       RowBox[{
