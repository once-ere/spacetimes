          RowBox[{"th", " ", "=", " ", 
           RowBox[{"3", " ", 
            RowBox[{"t2Unit", "[", "]"}]}]}], ",", " ", "u2", ",", " ", "gm", 
          ",", " ", "r", ",", " ", "dn", ",", " ", "g8"}], "}"}], ",", "\n", 
        "   ", 
        RowBox[{
         RowBox[{"u2", " ", "=", " ", 
          RowBox[{"t2su2", "[", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"3", " ", 
              RowBox[{"t2Unit", "[", "]"}]}], ",", " ", 
             RowBox[{"{", "3", "}"}]}], "]"}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"gm", " ", "=", " ", 
          RowBox[{
           RowBox[{"Exp", "[", 
            RowBox[{"I", " ", "th"}], "]"}], " ", "u2"}]}], ";", "\n", "   ", 
         
         RowBox[{"AppendTo", "[", 
          RowBox[{"gs", ",", " ", "gm"}], "]"}], ";", "\n", "   ", 
         RowBox[{"r", " ", "=", " ", 
          RowBox[{"t2adjoint", "[", "u2", "]"}]}], ";", "\n", "   ", 
         RowBox[{"dn", " ", "=", " ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Sum", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"fl", "[", 
                 RowBox[{"[", 
                  RowBox[{"\"\<d\>\"", ",", " ", 
                   RowBox[{"s", " ", "+", " ", "1"}], ",", " ", "b"}], "]"}], 
                 "]"}], " ", 
                RowBox[{"r", "[", 
                 RowBox[{"[", 
                  RowBox[{"a", ",", " ", "b"}], "]"}], "]"}]}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"b", ",", " ", "3"}], "}"}]}], "]"}], " ", 
             RowBox[{"Exp", "[", 
              RowBox[{"2", " ", "I", " ", "th"}], "]"}]}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"a", ",", " ", "3"}], "}"}]}], "]"}]}], ";", "\n", "   ", 
         RowBox[{
          RowBox[{"fl2", "[", 
           RowBox[{"[", 
            RowBox[{"\"\<d\>\"", ",", " ", 
             RowBox[{"s", " ", "+", " ", "1"}]}], "]"}], "]"}], " ", "=", " ",
           "dn"}], ";", "\n", "   ", 
         RowBox[{"g8", " ", "=", " ", 
          RowBox[{"t2lift2", "[", "gm", "]"}]}], ";", "\n", "   ", 
         RowBox[{
          RowBox[{"gbig", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"16", " ", "s"}], " ", "+", " ", "1"}], " ", ";;", " ", 
              RowBox[{
               RowBox[{"16", " ", "s"}], " ", "+", " ", "8"}]}], ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"16", " ", "s"}], " ", "+", " ", "1"}], " ", ";;", " ", 
              RowBox[{
               RowBox[{"16", " ", "s"}], " ", "+", " ", "8"}]}]}], "]"}], 
           "]"}], " ", "=", " ", "g8"}], ";", "\n", "   ", 
         RowBox[{
          RowBox[{"gbig", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"16", " ", "s"}], " ", "+", " ", "9"}], " ", ";;", " ", 
              RowBox[{
               RowBox[{"16", " ", "s"}], " ", "+", " ", "16"}]}], ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"16", " ", "s"}], " ", "+", " ", "9"}], " ", ";;", " ", 
              RowBox[{
               RowBox[{"16", " ", "s"}], " ", "+", " ", "16"}]}]}], "]"}], 
           "]"}], " ", "=", " ", 
          RowBox[{"Conjugate", "[", "g8", "]"}]}]}]}], "]"}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"s", ",", " ", "0", ",", " ", 
        RowBox[{"ns", " ", "-", " ", "1"}]}], "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", "\n", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"fl2", "[", 
         RowBox[{"[", 
          RowBox[{"\"\<v0\>\"", ",", " ", 
           RowBox[{"s", " ", "+", " ", "1"}]}], "]"}], "]"}], " ", "=", " ", 
        RowBox[{
         RowBox[{"gs", "[", 
          RowBox[{"[", 
           RowBox[{"s", " ", "+", " ", "1"}], "]"}], "]"}], " ", ".", " ", 
         RowBox[{"fl", "[", 
          RowBox[{"[", 
           RowBox[{"\"\<v0\>\"", ",", " ", 
            RowBox[{"s", " ", "+", " ", "1"}]}], "]"}], "]"}], " ", ".", " ", 
         
         RowBox[{"ConjugateTranspose", "[", 
          RowBox[{"gs", "[", 
           RowBox[{"[", 
            RowBox[{"s", " ", "+", " ", "1"}], "]"}], "]"}], "]"}]}]}], ";", 
       "\n", "  ", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"sp", " ", "=", " ", 
             RowBox[{"t2neighbour", "[", 
              RowBox[{"lat", ",", " ", "s", ",", " ", "j", ",", " ", "True"}],
               "]"}]}], "}"}], ",", "\n", "    ", 
           RowBox[{
            RowBox[{"fl2", "[", 
             RowBox[{"[", 
              RowBox[{"\"\<links\>\"", ",", " ", 
               RowBox[{"s", " ", "+", " ", "1"}], ",", " ", 
               RowBox[{"j", " ", "+", " ", "1"}]}], "]"}], "]"}], " ", "=", 
            " ", 
            RowBox[{
             RowBox[{"gs", "[", 
              RowBox[{"[", 
               RowBox[{"s", " ", "+", " ", "1"}], "]"}], "]"}], " ", ".", " ", 
             RowBox[{"fl", "[", 
              RowBox[{"[", 
               RowBox[{"\"\<links\>\"", ",", " ", 
                RowBox[{"s", " ", "+", " ", "1"}], ",", " ", 
                RowBox[{"j", " ", "+", " ", "1"}]}], "]"}], "]"}], " ", ".", 
             " ", 
             RowBox[{"ConjugateTranspose", "[", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"sp", " ", "===", " ", "None"}], ",", " ", 
                RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", " ", 
                RowBox[{"gs", "[", 
                 RowBox[{"[", 
                  RowBox[{"sp", " ", "+", " ", "1"}], "]"}], "]"}]}], "]"}], 
              "]"}]}]}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"j", ",", " ", "0", ",", " ", "2"}], "}"}]}], "]"}]}], ",", 
      "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"s", ",", " ", "0", ",", " ", 
        RowBox[{"ns", " ", "-", " ", "1"}]}], "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"hl2", " ", "=", " ", 
     RowBox[{"t2dense", "[", 
      RowBox[{"lat", ",", " ", "fl2"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gcov", " ", "=", " ", 
     RowBox[{"fro", "[", 
      RowBox[{"hl2", " ", "-", " ", 
       RowBox[{"gbig", " ", ".", " ", "hl", " ", ".", " ", 
        RowBox[{"ConjugateTranspose", "[", "gbig", "]"}]}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"the", " ", "free", " ", "one"}], "-", 
      RowBox[{"dimensional", " ", 
       RowBox[{"lattice", ":", " ", 
        RowBox[{
         RowBox[{"the", " ", "spectrum"}], " ", "+", 
         RowBox[{"-", "eps_lat"}]}]}]}]}], ",", " ", 
     RowBox[{
      RowBox[{"each", " ", "eight", " ", "times"}], ";", " ", 
      RowBox[{"the", " ", "doubler"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"lat1", " ", "=", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<n\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1", ",", " ", "12"}], "}"}]}], ",", " ", 
       RowBox[{"\"\<ell\>\"", " ", "->", " ", "0.5"}], ",", " ", 
       RowBox[{"\"\<periodic\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"True", ",", " ", "True", ",", " ", "True"}], "}"}]}], ",", 
       " ", 
       RowBox[{"\"\<wilson\>\"", " ", "->", " ", "1.0"}], ",", " ", 
       RowBox[{"\"\<mass\>\"", " ", "->", " ", "mass"}], ",", " ", 
       RowBox[{"\"\<mu\>\"", " ", "->", " ", "0."}]}], "|>"}]}], ";"}], "\n", 
   
   RowBox[{
    RowBox[{"ev1", " ", "=", " ", 
     RowBox[{"First", "[", 
      RowBox[{"t2eigh", "[", 
       RowBox[{"t2dense", "[", 
        RowBox[{"lat1", ",", " ", 
         RowBox[{"t2trivialFields", "[", "12", "]"}]}], "]"}], "]"}], "]"}]}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"expect1", " ", "=", " ", 
     RowBox[{"Sort", "[", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"e", " ", "=", " ", 
             RowBox[{"t2epsLat", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"0.", ",", " ", "0.", ",", " ", 
                 RowBox[{"2", " ", "Pi", " ", 
                  RowBox[{"kk", "/", 
                   RowBox[{"(", 
                    RowBox[{"12", " ", "0.5"}], ")"}]}]}]}], "}"}], ",", " ", 
               "0.5", ",", " ", "mass", ",", " ", "1.0", ",", " ", 
               RowBox[{"{", 
                RowBox[{"False", ",", " ", "False", ",", " ", "True"}], 
                "}"}]}], "]"}]}], "}"}], ",", " ", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"e", ",", " ", 
               RowBox[{"-", "e"}]}], "}"}], ",", " ", 
             RowBox[{"{", "8", "}"}]}], "]"}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"kk", ",", " ", "0", ",", " ", "11"}], "}"}]}], "]"}], 
       "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"disp", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{"ev1", " ", "-", " ", "expect1"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"doublerOk", " ", "=", " ", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"t2epsLat", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0.", ",", " ", "0.", ",", " ", 
            RowBox[{"Pi", "/", "0.5"}]}], "}"}], ",", " ", "0.5", ",", " ", 
          "mass", ",", " ", "1.0", ",", " ", 
          RowBox[{"{", 
           RowBox[{"False", ",", " ", "False", ",", " ", "True"}], "}"}]}], 
         "]"}], " ", "-", " ", 
        RowBox[{"(", 
         RowBox[{"mass", " ", "+", " ", 
          RowBox[{"2", "/", "0.5"}]}], ")"}]}], "]"}], " ", "<", " ", 
      "1*^-12"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "the", " ", "spectral", " ", "radius", " ", "and", " ", "the", " ", 
     "bound", " ", "used", " ", "for", " ", "the", " ", "time", " ", "step"}],
     " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"rho", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{"First", "[", 
        RowBox[{"t2eigh", "[", "hl", "]"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"bound", " ", "=", " ", 
     RowBox[{"t2normBound", "[", 
      RowBox[{"lat", ",", " ", "fl"}], "]"}]}], ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<GS-10\>\"", ",", 
     " ", "\"\<the lattice operator H_lat on a 3 x 2 x 4 lattice (dx = 0.7, \
r_W = 1, periodic in x and z) with random links, potentials and order \
parameters is Hermitian, particle-hole symmetric and exactly gauge covariant; \
on a free periodic chain of 12 sites its spectrum is +-eps_lat, each eight \
times; the Wilson term lifts the doubler to m + 2 r_W/dx; the spectral radius \
stays below the bound Hbound (tolerance 1e-10)\>\"", ",", "\n", "  ", 
     RowBox[{
      RowBox[{"herm", " ", "<", " ", "1*^-10"}], " ", "&&", " ", 
      RowBox[{"ph", " ", "<", " ", "1*^-10"}], " ", "&&", " ", 
      RowBox[{"gcov", " ", "<", " ", "1*^-10"}], " ", "&&", " ", 
      RowBox[{"disp", " ", "<", " ", "1*^-10"}], " ", "&&", " ", "doublerOk", 
      " ", "&&", " ", 
      RowBox[{"rho", " ", "<=", " ", "bound"}]}], ",", "\n", "  ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<Hermiticity \>\"", ",", " ", "herm", ",", 
        " ", "\"\<, particle-hole \>\"", ",", " ", "ph", ",", 
        " ", "\"\<, gauge covariance \>\"", ",", " ", "gcov", ",", 
        " ", "\"\<, dispersion \>\"", ",", " ", "disp", ",", 
        " ", "\"\<; spectral radius \>\"", ",", " ", 
        RowBox[{"NumberForm", "[", 
         RowBox[{"rho", ",", " ", 
          RowBox[{"{", 
           RowBox[{"6", ",", " ", "4"}], "}"}]}], "]"}], ",", 
        " ", "\"\< <= bound \>\"", ",", " ", 
        RowBox[{"NumberForm", "[", 
         RowBox[{"bound", ",", " ", 
          RowBox[{"{", 
           RowBox[{"6", ",", " ", "4"}], "}"}]}], "]"}], ",", "\n", 
        "    ", "\"\< (original: 0.0e0, 0.0e0, 1.8e-13, 1.4e-14; 8.4349 <= \
17.5474)\>\""}], "}"}], "]"}]}], "]"}]}]}]], "Input",ExpressionUUID->\
"834d6b8c-f38d-474b-b6f6-5adb505ee514"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"GS", "-", "11"}], ":", " ", 
     RowBox[{
     "the", " ", "rewritten", " ", "eigensolver", " ", "on", " ", "random", " ",
       "Hermitian", " ", "matrices", " ", "of", " ", "the", " ", "dimensions",
       " ", "7"}]}], ",", " ", 
    RowBox[{"64", " ", "and", " ", "200"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"worst11", " ", "=", " ", "0."}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"a", " ", "=", " ", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{
             RowBox[{"0.", " ", "I"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"nn", ",", " ", "nn"}], "}"}]}], "]"}]}], ",", " ", 
          "ev", ",", " ", "v"}], "}"}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"z", " ", "=", " ", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"i", " ", "==", " ", "j"}], ",", " ", 
                 RowBox[{
                  RowBox[{"t2Unit", "[", "]"}], " ", "+", " ", 
                  RowBox[{"0.", " ", "I"}]}], ",", " ", 
                 RowBox[{"t2UnitC", "[", "]"}]}], "]"}]}], "}"}], ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"a", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", " ", "j"}], "]"}], "]"}], " ", "=", " ", 
               "z"}], ";", " ", 
              RowBox[{
               RowBox[{"a", "[", 
                RowBox[{"[", 
                 RowBox[{"j", ",", " ", "i"}], "]"}], "]"}], " ", "=", " ", 
               RowBox[{"Conjugate", "[", "z", "]"}]}]}]}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "nn"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"j", ",", " ", "i"}], "}"}]}], "]"}], ";", "\n", "   ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ev", ",", " ", "v"}], "}"}], " ", "=", " ", 
          RowBox[{"t2eigh", "[", "a", "]"}]}], ";", "\n", "   ", 
         RowBox[{"worst11", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"worst11", ",", " ", 
            RowBox[{
             RowBox[{"fro", "[", 
              RowBox[{
               RowBox[{"v", " ", ".", " ", 
                RowBox[{"DiagonalMatrix", "[", "ev", "]"}], " ", ".", " ", 
                RowBox[{"ConjugateTranspose", "[", "v", "]"}]}], " ", "-", 
               " ", "a"}], "]"}], "/", 
             RowBox[{"fro", "[", "a", "]"}]}], ",", " ", 
            RowBox[{"fro", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"ConjugateTranspose", "[", "v", "]"}], " ", ".", " ", 
               "v"}], " ", "-", " ", 
              RowBox[{"IdentityMatrix", "[", "nn", "]"}]}], "]"}]}], 
           "]"}]}]}]}], "]"}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"nn", ",", " ", 
        RowBox[{"{", 
         RowBox[{"7", ",", " ", "64", ",", " ", "200"}], "}"}]}], "}"}]}], 
     "]"}], ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<GS-11\>\"", ",", 
     " ", "\"\<the Hermitian eigensolver of t2core (Householder reduction and \
implicit QL), rewritten above: for random Hermitian matrices of the \
dimensions 7, 64 and 200 the eigenvectors are orthonormal and reproduce the \
matrix (relative tolerance 1e-11)\>\"", ",", "\n", "  ", 
     RowBox[{"worst11", " ", "<", " ", "1*^-11"}], ",", " ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<largest relative residual \>\"", ",", " ", "worst11", ",",
         " ", "\"\< (original: 6.0e-14)\>\""}], "}"}], "]"}]}], 
    "]"}]}]}]], "Input",ExpressionUUID->"dcc54d10-6b6a-4038-a237-\
92ef6ceff85e"],

Cell["GS-12: the explicit matrices and the component equations", "Subsection",ExpressionUUID->"c6445d17-169f-42ec-858b-bdecdf85ae26"],

Cell[TextData[{
 "The original program prints every matrix and every component equation of \
the field equations in TeX, with its small symbolic algebra, and evaluates \
each printed expression for numbers assigned to its symbols, comparing it \
with the ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{"8", "\[Cross]", "8"}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"f94678d1-b8b5-494e-ae06-0244435d004a"]], "InlineFormula",
  ExpressionUUID->"1756ed30-a6b0-4c0f-951e-ad5867ca2b90"],
 " and ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{"16", "\[Cross]", "16"}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"23d37a06-9e44-460a-9ae9-9319cd9a2b13"]], "InlineFormula",
  ExpressionUUID->"22f19d58-dfc1-4b71-ae2c-c242b3755e84"],
 " matrix computation (check GS-12). Here the same expressions are built from \
symbols of the Wolfram Language, shown, and evaluated in the same way. The \
symbols: ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["d", "TI"], "LL", "\[Iota]"], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"81423ba6-f579-4686-ac4d-0114b97b7108"]], 
  "InlineFormula",ExpressionUUID->"89ff4c25-1a97-4200-8055-1b3c1e452074"],
 " (the order parameter), ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[Omega]", 
     RowBox[{"LL", ",", 
      StyleBox["p", "TI"]}], 
     StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "012520a5-6d98-40a2-83d9-ca3aa952e0d9"]], "InlineFormula",ExpressionUUID->
  "3e530b0b-779f-419a-8c1e-482821bbdf4b"],
 " and ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[CurlyPi]", 
     RowBox[{"LL", ",", 
      StyleBox["p", "TI"]}], 
     StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "e55dcae9-42cd-432a-ba0b-d640b17cd886"]], "InlineFormula",ExpressionUUID->
  "815e17d5-f843-4613-a2fd-bca097ff6af1"],
 " (the rotation and boost parts of the Lorentz connection in the direction \
",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "635c0c91-7143-4aa0-a10c-8b9564dbe80a"]], "InlineFormula",ExpressionUUID->
  "aa97270d-72f4-4d38-8e90-0dcd2634a2bf"],
 "), ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{"LL", ",", 
      StyleBox["p", "TI"]}], "\[Iota]"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"1c10ebb2-1eff-4d1b-958f-228ada30ed06"]], "InlineFormula",
  ExpressionUUID->"9a804629-773c-4477-a717-afd2ed0d9cb5"],
 " and ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{"LL", ",", 
      StyleBox["p", "TI"]}], "F"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"fac510f8-8d2c-402c-9ca6-4ac046d7b136"]], "InlineFormula",
  ExpressionUUID->"73aaad1f-46ad-4b8c-8437-b63eedd5344d"],
 " (the gauge potentials), ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["g", "TI"], "LL", "v"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"b7a2389a-bd92-421f-a9c8-90df91623041"]], "InlineFormula",
  ExpressionUUID->"8a90ae9c-2805-4709-a0bf-f68682e5bf51"],
 ", ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["g", "TI"], "LL", "F"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"5e3d4fab-034b-4ddd-adab-679743db81a8"]], "InlineFormula",
  ExpressionUUID->"fd8d81ee-ea3e-49dd-aed3-469291a4918f"],
 " (the couplings), ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[Psi]", 
     RowBox[{"LL", ",", 
      StyleBox["k", "TI"]}], "p"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"7cf1f3a7-7cb5-4f9e-928e-f5f686d7af3b"]], "InlineFormula",
  ExpressionUUID->"45f0d8ba-4b25-4665-95cd-43a8c7179735"],
 ", ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[Psi]", 
