      RowBox[{"\"\<A\>\"", ",", " ", 
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<LL,\>\"", ",", " ", "idx"}], "}"}], "]"}], ",", " ", 
       "i"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Format", "[", "gvS", "]"}], " ", ":=", " ", 
     RowBox[{"Subsuperscript", "[", 
      RowBox[{"\"\<g\>\"", ",", " ", "\"\<LL\>\"", ",", " ", "\"\<v\>\""}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Format", "[", "gfS", "]"}], " ", ":=", " ", 
     RowBox[{"Subsuperscript", "[", 
      RowBox[{"\"\<g\>\"", ",", " ", "\"\<LL\>\"", ",", " ", "\"\<F\>\""}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Format", "[", 
      RowBox[{"psP", "[", "k_", "]"}], "]"}], " ", ":=", " ", 
     RowBox[{"Subsuperscript", "[", 
      RowBox[{"\"\<\[Psi]\>\"", ",", " ", 
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<LL,\>\"", ",", " ", "k"}], "}"}], "]"}], ",", 
       " ", "\"\<p\>\""}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Format", "[", 
      RowBox[{"psH", "[", "k_", "]"}], "]"}], " ", ":=", " ", 
     RowBox[{"Subsuperscript", "[", 
      RowBox[{"\"\<\[Psi]\>\"", ",", " ", 
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<LL,\>\"", ",", " ", "k"}], "}"}], "]"}], ",", 
       " ", "\"\<h\>\""}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Format", "[", 
      RowBox[{"psiS", "[", "k_", "]"}], "]"}], " ", ":=", " ", 
     RowBox[{"Subscript", "[", 
      RowBox[{"\"\<\[CapitalPsi]\>\"", ",", " ", 
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<LL,\>\"", ",", " ", "k"}], "}"}], "]"}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Format", "[", 
      RowBox[{"psiStarS", "[", "k_", "]"}], "]"}], " ", ":=", " ", 
     RowBox[{"Subsuperscript", "[", 
      RowBox[{"\"\<\[CapitalPsi]\>\"", ",", " ", 
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<LL,\>\"", ",", " ", "k"}], "}"}], "]"}], ",", 
       " ", "\"\<*\>\""}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Format", "[", 
      RowBox[{"piS", "[", "i_", "]"}], "]"}], " ", ":=", " ", 
     RowBox[{"Subsuperscript", "[", 
      RowBox[{"\"\<\[CapitalPi]\>\"", ",", " ", "\"\<LL\>\"", ",", " ", "i"}],
       "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Format", "[", "mS", "]"}], " ", ":=", " ", 
     RowBox[{"Subscript", "[", 
      RowBox[{"\"\<m\>\"", ",", " ", "\"\<LL\>\""}], "]"}]}], ";", " ", 
    RowBox[{
     RowBox[{"Format", "[", "muS", "]"}], " ", ":=", " ", 
     RowBox[{"Subscript", "[", 
      RowBox[{"\"\<\[Mu]\>\"", ",", " ", "\"\<LL\>\""}], "]"}]}], ";", " ", 
    RowBox[{
     RowBox[{"Format", "[", "bigGS", "]"}], " ", ":=", " ", 
     RowBox[{"Subscript", "[", 
      RowBox[{"\"\<G\>\"", ",", " ", "\"\<LL\>\""}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Format", "[", 
      RowBox[{"djS", "[", "x_", "]"}], "]"}], " ", ":=", " ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Subscript", "[", 
         RowBox[{"\"\<\[PartialD]\>\"", ",", " ", "\"\<j\>\""}], "]"}], ",", 
        " ", "x"}], "}"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Format", "[", 
      RowBox[{"nabPS", "[", 
       RowBox[{"j_", ",", " ", "k_"}], "]"}], "]"}], " ", ":=", " ", 
     RowBox[{"Subscript", "[", 
      RowBox[{
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<(\>\"", ",", " ", 
          RowBox[{"Subsuperscript", "[", 
           RowBox[{"\"\<\[Del]\>\"", ",", " ", "j", ",", " ", "\"\<LL\>\""}], 
           "]"}], ",", " ", 
          RowBox[{"Subsuperscript", "[", 
           
           RowBox[{"\"\<\[Psi]\>\"", ",", " ", "\"\<LL\>\"", ",", 
            " ", "\"\<p\>\""}], "]"}], ",", " ", "\"\<)\>\""}], "}"}], "]"}], 
       ",", " ", "k"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Format", "[", 
      RowBox[{"nabHS", "[", 
       RowBox[{"j_", ",", " ", "k_"}], "]"}], "]"}], " ", ":=", " ", 
     RowBox[{"Subscript", "[", 
      RowBox[{
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<(\>\"", ",", " ", 
          RowBox[{"Subsuperscript", "[", 
           RowBox[{"\"\<\[Del]\>\"", ",", " ", "j", ",", " ", "\"\<LL*\>\""}],
            "]"}], ",", " ", 
          RowBox[{"Subsuperscript", "[", 
           
           RowBox[{"\"\<\[Psi]\>\"", ",", " ", "\"\<LL\>\"", ",", 
            " ", "\"\<h\>\""}], "]"}], ",", " ", "\"\<)\>\""}], "}"}], "]"}], 
       ",", " ", "k"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Format", "[", 
      RowBox[{"nabPsiS", "[", 
       RowBox[{"j_", ",", " ", "k_"}], "]"}], "]"}], " ", ":=", " ", 
     RowBox[{"Subscript", "[", 
      RowBox[{
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<(\>\"", ",", " ", 
          RowBox[{"Subsuperscript", "[", 
           RowBox[{"\"\<\[Del]\>\"", ",", " ", "j", ",", " ", "\"\<LL\>\""}], 
           "]"}], ",", " ", 
          RowBox[{"Subscript", "[", 
           RowBox[{"\"\<\[CapitalPsi]\>\"", ",", " ", "\"\<LL\>\""}], "]"}], ",",
           " ", "\"\<)\>\""}], "}"}], "]"}], ",", " ", "k"}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Format", "[", 
      RowBox[{"nablaS", "[", "p_", "]"}], "]"}], " ", ":=", " ", 
     RowBox[{"Subsuperscript", "[", 
      RowBox[{"\"\<\[Del]\>\"", ",", " ", "p", ",", " ", "\"\<LL\>\""}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "the", " ", "complex", " ", "conjugate", " ", "of", " ", "the", " ", 
     "explicit", " ", "numbers", " ", "of", " ", "an", " ", "expression", " ", 
     RowBox[{"(", 
      RowBox[{"the", " ", "symbols", " ", "are", " ", "real"}], ")"}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"conjC", "[", "e_", "]"}], " ", ":=", " ", 
     RowBox[{"e", " ", "/.", " ", 
      RowBox[{
       RowBox[{"Complex", "[", 
        RowBox[{"x_", ",", " ", "y_"}], "]"}], " ", ":>", " ", 
       RowBox[{"Complex", "[", 
        RowBox[{"x", ",", " ", 
         RowBox[{"-", "y"}]}], "]"}]}]}]}], ";"}]}]}]], "Input",ExpressionUUID\
->"9df8cc42-761a-4918-a642-1a7c1b879f67"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "the", " ", "pair", " ", "potential", " ", "P_LL", " ", "with", " ", 
    "symbolic", " ", 
    RowBox[{"d", "^", 
     RowBox[{"iota", ":", " ", 
      RowBox[{
      "it", " ", "is", " ", "block", " ", "diagonal", " ", "with", " ", "two",
        " ", "equal", " ", "4", " ", "x", " ", "4", " ", "blocks"}]}]}]}], 
   " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"dval", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"0.31", " ", "-", " ", 
        RowBox[{"0.2", " ", "I"}]}], ",", " ", 
       RowBox[{
        RowBox[{"-", "0.17"}], " ", "+", " ", 
        RowBox[{"0.4", " ", "I"}]}], ",", " ", 
       RowBox[{"0.52", " ", "+", " ", 
        RowBox[{"0.11", " ", "I"}]}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"pSym", " ", "=", " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"dS", "[", "i", "]"}], " ", 
        RowBox[{"ConjugateTranspose", "[", 
         RowBox[{"t2kpair", "[", "i", "]"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"pdev", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"pSym", " ", "/.", " ", 
          RowBox[{
           RowBox[{"dS", "[", "i_", "]"}], " ", ":>", " ", 
           RowBox[{"dval", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}]}], ")"}], " ", "-", " ", 
        RowBox[{"t2pairPotential", "[", "dval", "]"}]}], "]"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"pdev", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"pdev", ",", " ", 
       RowBox[{"Max", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
