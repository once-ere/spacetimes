         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"h", "^", "IDA"}], " ", 
            RowBox[{"E", "^", "max"}]}], ")"}], "^", "4"}], "/", "384"}], " ", 
        RowBox[{"(", 
         RowBox[{"largest", " ", "norm"}], ")"}]}]}]}], ",", " ", 
     RowBox[{
     "the", " ", "bound", "\n", "                 ", "of", " ", "the", " ", 
      "norm", " ", "of", " ", "the", " ", "deviation", " ", "of", " ", "a", " ",
       "state", " ", "at", " ", "an", " ", "output", " ", "time", " ", 
      RowBox[{"(", 
       RowBox[{
       "for", " ", "a", " ", "state", " ", "of", " ", "any", " ", "norm"}], 
       ")"}]}], ",", " ", 
     RowBox[{
     "which", " ", "holds", " ", "if", "\n", "                 ", "every", " ", 
      RowBox[{"delta", "^", "loc"}], " ", "is", " ", "at", " ", "most", " ", 
      RowBox[{"B", "^", "loc"}], " ", 
      RowBox[{"(", 
       RowBox[{"\"\<ratio\>\"", " ", "at", " ", "most", " ", "1"}], ")"}], "\n",
       "     ", "\"\<sumloc\>\"", "    ", "the", " ", "sum", " ", "of", " ", 
      "the", " ", "measured", " ", "exact", " ", "local", " ", "errors", " ", 
      
      RowBox[{"delta", "^", "loc"}], " ", "of", " ", "all", " ", "internal", " ", 
      RowBox[{"steps", ":", " ", 
       RowBox[{
       "because", " ", "the", " ", "evolution", " ", "is", "\n", 
        "                 ", "unitary"}]}]}], ",", " ", 
     RowBox[{
     "the", " ", "deviation", " ", "at", " ", "the", " ", "end", " ", "of", " ",
       "every", " ", "internal", " ", "step", " ", "is", " ", "at", " ", 
      "most", " ", "this", " ", "sum"}], ",", " ", 
     RowBox[{
     "whatever", " ", "the", " ", "ratio", " ", "is", "\n", 
      "     ", "\"\<bsum\>\"", "      ", "the", " ", "same", " ", "bound", " ",
       "as", " ", "\"\<bout\>\"", " ", "with", " ", "\"\<sumloc\>\"", " ", 
      "in", " ", "place", " ", "of", " ", 
      RowBox[{"B", "^", 
       RowBox[{"err", ":", " ", 
        RowBox[{
        "it", " ", "holds", " ", "without", " ", "any", " ", 
         "condition"}]}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2evolveIDAChecked", "[", 
      RowBox[{
       RowBox[{"hm_", "?", "MatrixQ"}], ",", " ", 
       RowBox[{"w0_", "?", "VectorQ"}], ",", " ", "touts_List", ",", " ", 
       RowBox[{"rtol_", "?", "NumericQ"}], ",", " ", 
       RowBox[{"atol_", "?", "NumericQ"}]}], "]"}], " ", ":=", "\n", "  ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "evC", ",", " ", "vvC", ",", " ", "runC", ",", " ", "normC", ",", " ",
          "hmaxC", ",", " ", "emaxC", ",", " ", "blocC", ",", " ", "berrC", ",",
          " ", "residC", ",", " ", "sumC"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"evC", ",", " ", "vvC"}], "}"}], " ", "=", " ", 
         RowBox[{"t2eigh", "[", "hm", "]"}]}], ";", "\n", "   ", 
        RowBox[{"emaxC", " ", "=", " ", 
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", "evC", "]"}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"runC", " ", "=", " ", 
         RowBox[{"t2evolveIDA", "[", 
          RowBox[{
          "hm", ",", " ", "w0", ",", " ", "touts", ",", " ", "rtol", ",", " ",
            "atol", ",", " ", 
           RowBox[{"t2localErrorsIDA", "[", 
            RowBox[{
            "evC", ",", " ", "vvC", ",", " ", "rtol", ",", " ", "atol"}], 
            "]"}]}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"runC", " ", "===", " ", "$Failed"}], ",", " ", 
          RowBox[{"Return", "[", 
           RowBox[{"$Failed", ",", " ", "Module"}], "]"}]}], "]"}], ";", "\n",
         "   ", 
        RowBox[{"normC", " ", "=", " ", 
         RowBox[{"runC", "[", 
          RowBox[{"[", 
           RowBox[{"\"\<analysis\>\"", ",", " ", "\"\<largestNorm\>\""}], 
           "]"}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"hmaxC", " ", "=", " ", 
         RowBox[{"runC", "[", "\"\<hmax\>\"", "]"}]}], ";", "\n", "   ", 
        RowBox[{"residC", " ", "=", " ", 
         RowBox[{"Max", "[", 
          RowBox[{"runC", "[", "\"\<residualAt\>\"", "]"}], "]"}]}], ";", 
        "\n", "   ", 
        RowBox[{"blocC", " ", "=", " ", 
         RowBox[{
          RowBox[{"rtol", " ", "normC"}], " ", "+", " ", 
          RowBox[{"atol", " ", 
           RowBox[{"Sqrt", "[", 
            RowBox[{"2.", " ", 
             RowBox[{"Length", "[", "w0", "]"}]}], "]"}]}]}]}], ";", "\n", 
        "   ", 
        RowBox[{"berrC", " ", "=", " ", 
         RowBox[{
          RowBox[{"runC", "[", "\"\<steps\>\"", "]"}], " ", "blocC"}]}], ";", 
        "\n", "   ", 
        RowBox[{"sumC", " ", "=", " ", 
         RowBox[{"runC", "[", 
          RowBox[{"[", 
           RowBox[{"\"\<analysis\>\"", ",", " ", "\"\<sumLocalErrors\>\""}], 
           "]"}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"Join", "[", 
         RowBox[{"runC", ",", " ", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<emax\>\"", " ", "->", " ", "emaxC"}], ",", " ", 
            RowBox[{"\"\<ratio\>\"", " ", "->", " ", 
             RowBox[{"runC", "[", 
              RowBox[{"[", 
               RowBox[{"\"\<analysis\>\"", ",", " ", "\"\<largestRatio\>\""}],
                "]"}], "]"}]}], ",", " ", 
            RowBox[{"\"\<norm\>\"", " ", "->", " ", "normC"}], ",", " ", 
            RowBox[{"\"\<bloc\>\"", " ", "->", " ", "blocC"}], ",", " ", 
            RowBox[{"\"\<berr\>\"", " ", "->", " ", "berrC"}], ",", "\n", 
            "     ", 
            RowBox[{"\"\<residual\>\"", " ", "->", " ", "residC"}], ",", " ", 
            
            RowBox[{"\"\<hermite\>\"", " ", "->", " ", 
             RowBox[{"Max", "[", 
              RowBox[{"runC", "[", "\"\<hermiteAt\>\"", "]"}], "]"}]}], ",", 
            "\n", "     ", 
            RowBox[{"\"\<bout\>\"", " ", "->", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", " ", "+", " ", 
                 RowBox[{"hmaxC", " ", 
                  RowBox[{"emaxC", "/", "4"}]}]}], ")"}], " ", "berrC"}], " ",
               "+", " ", 
              RowBox[{"hmaxC", " ", 
               RowBox[{"residC", "/", "4"}]}], " ", "+", " ", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"hmaxC", " ", "emaxC"}], ")"}], "^", "4"}], "/", 
                "384"}], " ", "normC"}]}]}], ",", "\n", "     ", 
            RowBox[{"\"\<sumloc\>\"", " ", "->", " ", "sumC"}], ",", " ", 
            RowBox[{"\"\<bsum\>\"", " ", "->", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", " ", "+", " ", 
                 RowBox[{"hmaxC", " ", 
                  RowBox[{"emaxC", "/", "4"}]}]}], ")"}], " ", "sumC"}], " ", 
              "+", " ", 
              RowBox[{"hmaxC", " ", 
               RowBox[{"residC", "/", "4"}]}], " ", "+", " ", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"hmaxC", " ", "emaxC"}], ")"}], "^", "4"}], "/", 
                "384"}], " ", "normC"}]}]}]}], "|>"}]}], "]"}]}]}], "]"}]}], 
    ";"}]}]}]], "Input",ExpressionUUID->"08cb751a-99c6-433e-8856-\
3a5f05615e7b"],

Cell[TextData[{
 "Check T2-IDA has three parts. Part (a) shows what the two tolerances mean, \
on the equation whose solution is the decaying exponential function ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["exp",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{"-", 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "0"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8c7c9f35-5054-4ad9-9a1e-e20576b1b63d"],
 " (the derivative of the unknown is minus the unknown, the initial value is \
1), integrated from 0 to 25 with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["tol",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox["10", 
     RowBox[{"-", "8"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0ec795a7-a75e-4265-b5a2-6287e5ae95ec"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["tol",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox["10", 
     RowBox[{"-", "10"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7f67dfa6-7529-42d5-8ceb-0b8b6ee6410c"],
 ". The solution falls from 1 to about ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "11"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a7b0f3ca-5cdf-4185-af5d-28d36fc31e8e"],
 ". While it is much larger than ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["tol",
      FontSlant->"Plain"]], "/", 
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["tol",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox["10", 
     RowBox[{"-", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6f71a517-b397-4623-ba46-9ae3055de539"],
 ", the tolerance of a step is ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["tol",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "59c7ffd2-9693-4d4a-89af-378de940bba0"],
 " times the modulus of the solution; when it is much smaller, the tolerance \
is ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["tol",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a8245a67-5073-4397-8087-8ebbb75c68ec"],
 ". The check requires that the exact local error of every internal step is \
at most the tolerance of the step, and that in each of the two regimes the \
largest ratio of the local error to the tolerance exceeds 1/128. The second \
requirement shows that the tolerances are the stated ones and not smaller \
ones: by its rule for the doubling of a step, IDA at the order 5 doubles the \
step as soon as its estimate falls below 1/128 of the tolerance. Part (b) \
tests ",
 StyleBox["t2evolveIDA",
  FontFamily->"Source Code Pro"],
 " and ",
 StyleBox["t2localErrorsIDA",
  FontFamily->"Source Code Pro"],
 " on a Hermitian ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Times]", "2"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9179b678-b607-4b00-8992-8785fcf7b6e9"],
 " matrix, integrated from 0 to 10 with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["tol",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox["10", 
     RowBox[{"-", "10"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f9423427-785a-4262-a205-0e4cb6ec51f4"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["tol",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox["10", 
     RowBox[{"-", "12"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6f2f5e54-ce2a-4daf-be67-6372150b3eca"],
 " and compared at 21 output times with the solution by the matrix \
exponential (",
 StyleBox["MatrixExp",
  FontFamily->"Source Code Pro"],
 "): every ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Delta]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["loc",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a5e953a5-f5f5-4128-97bd-ce35f4ddbfd2"],
 " is at most ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["loc",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f5f8efa7-1472-4768-b9ba-984cabc55bc4"],
 ", the largest deviation at the output times is at most ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["out",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e894b909-d3d8-4d0f-bbc3-5131f91051ba"],
 ", and the states of ",
 StyleBox["NDSolve",
  FontFamily->"Source Code Pro"],
 " are the cubic Hermite polynomials of the stored values and derivatives \
(tolerance ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "12"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "01db0c2d-be8d-4335-acda-5dd95406d29b"],
 "). Part (c): the function ",
 StyleBox["t2evolveIDAChecked",
  FontFamily->"Source Code Pro"],
 " puts the integration and these measurements together for the checks of the \
later chapters. It computes the eigenvalues and the eigenvectors of the \
matrix itself, and returns the bounds ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["loc",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dff1f2f6-620d-4770-9e93-b33e9f0f58af"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["err",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4a540e25-e695-4d78-98bf-610f832dda86"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["out",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ba99adec-f54f-4697-966b-dc7109fcb4a1"],
 " for a state of any norm, the sum of the measured local errors, and the \
bound of the deviation at the output times that is made with this sum in \
place of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["err",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ef68cfd4-4ea5-49ce-84c9-6e51adceb37e"],
 ". Applied to the problem of part (b) it must give the same states and the \
same bounds; the sum of the local errors must be at most ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["err",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e1a95878-cee7-4fe0-a674-623d417afd71"],
 " (every one of them is at most ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["loc",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "caa55d41-d026-4a62-9853-d34f261c30ef"],
 "), and the largest deviation must be at most the bound made with the sum."
}], "Text",ExpressionUUID->"178c9780-bf54-4d00-a2a5-5dae999e8234"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"T2", "-", 
      RowBox[{"IDA", " ", 
       RowBox[{"(", "a", ")"}]}]}], ":", " ", 
     RowBox[{
     "the", " ", "local", " ", "errors", " ", "that", " ", "IDA", " ", 
      "accepts", " ", "on", " ", "the", " ", "decaying", " ", 
      "exponential"}]}], ",", " ", 
    RowBox[{"rtol", " ", "=", " ", 
     RowBox[{
      RowBox[{"1", "e"}], "-", "8"}]}], ",", " ", 
    RowBox[{"atol", " ", "=", " ", 
     RowBox[{
      RowBox[{"1", "e"}], "-", "10"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rtolDecay", ",", " ", "atolDecay"}], "}"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"1.*^-8", ",", " ", "1.*^-10"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"solDecay", " ", "=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"yD", ",", " ", "tD"}], "}"}], ",", " ", 
       RowBox[{"NDSolveValue", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"yD", "'"}], "[", "tD", "]"}], " ", "==", " ", 
            RowBox[{"-", 
             RowBox[{"yD", "[", "tD", "]"}]}]}], ",", " ", 
           RowBox[{
            RowBox[{"yD", "[", "0", "]"}], " ", "==", " ", "1."}]}], "}"}], ",",
          " ", "yD", ",", " ", 
         RowBox[{"{", 
          RowBox[{"tD", ",", " ", "0", ",", " ", "25"}], "}"}], ",", " ", 
         RowBox[{"Method", " ", "->", " ", "\"\<IDA\>\""}], ",", "\n", 
         "     ", 
         RowBox[{"PrecisionGoal", " ", "->", " ", 
          RowBox[{"-", 
           RowBox[{"Log10", "[", "rtolDecay", "]"}]}]}], ",", " ", 
         RowBox[{"AccuracyGoal", " ", "->", " ", 
          RowBox[{"-", 
           RowBox[{"Log10", "[", "atolDecay", "]"}]}]}]}], "]"}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"gridDecay", " ", "=", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{"solDecay", "[", "\"\<Grid\>\"", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"valsDecay", " ", "=", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{"solDecay", "[", "\"\<ValuesOnGrid\>\"", "]"}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "exact", " ", "local", " ", "error", " ", "of", " ", "every",
       " ", 
      RowBox[{"step", ":", " ", 
       RowBox[{
       "the", " ", "computed", " ", "value", " ", "at", " ", "its", " ", 
        "end", " ", "minus", " ", "the", " ", "exact", " ", "solution", " ", 
        "from", " ", "the", " ", "computed", " ", "value", "\n", "   ", "at", 
        " ", "its", " ", "beginning"}]}]}], ";", " ", 
     RowBox[{
      RowBox[{
      "and", " ", "its", " ", "ratio", " ", "to", " ", "the", " ", 
       "tolerance", " ", "rtol"}], " ", "|", "value", "|", " ", 
      RowBox[{
       RowBox[{"+", " ", "atol"}], " ", "of", " ", "the", " ", "step"}]}]}], 
    " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"localDecay", " ", "=", " ", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"Rest", "[", "valsDecay", "]"}], " ", "-", " ", 
       RowBox[{
        RowBox[{"Most", "[", "valsDecay", "]"}], " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"-", 
          RowBox[{"Differences", "[", "gridDecay", "]"}]}], "]"}]}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ratioDecay", " ", "=", " ", 
     RowBox[{"localDecay", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"rtolDecay", " ", 
         RowBox[{"Abs", "[", 
          RowBox[{"Most", "[", "valsDecay", "]"}], "]"}]}], " ", "+", " ", 
        "atolDecay"}], ")"}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"the", " ", "two", " ", 
       RowBox[{"regimes", ":", " ", 
        RowBox[{"the", " ", "solution", " ", "above", " ", "100", " ", 
         RowBox[{"atol", "/", "rtol"}]}]}]}], " ", "=", " ", 
      RowBox[{
      "1", " ", "never", " ", "holds", " ", "after", " ", "the", " ", "start",
        " ", 
       RowBox[{"(", 
        RowBox[{
        "the", " ", "solution", " ", "is", " ", "at", " ", "most", " ", "1"}],
         ")"}]}]}], ",", " ", 
     RowBox[{
      RowBox[{
      "so", " ", "the", "\n", "   ", "relative", " ", "regime", " ", "is", " ",
        "taken", " ", "as", " ", "the", " ", "solution", " ", "above", " ", 
       "10", " ", 
       RowBox[{"atol", "/", "rtol"}]}], " ", "=", " ", "0.1"}], ",", " ", 
     RowBox[{
      RowBox[{
      "the", " ", "absolute", " ", "regime", " ", "as", " ", "the", " ", 
       "solution", " ", "below", "\n", "   ", 
       RowBox[{"atol", "/", 
        RowBox[{"(", 
         RowBox[{"10", " ", "rtol"}], ")"}]}]}], " ", "=", " ", "0.001"}]}], 
    " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"relDecay", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Pick", "[", 
       RowBox[{"ratioDecay", ",", " ", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#", " ", ">", " ", 
            RowBox[{"10", " ", 
             RowBox[{"atolDecay", "/", "rtolDecay"}]}]}], " ", "&"}], ",", 
          " ", 
          RowBox[{"Abs", "[", 
           RowBox[{"Most", "[", "valsDecay", "]"}], "]"}]}], "]"}]}], "]"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"absDecay", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Pick", "[", 
       RowBox[{"ratioDecay", ",", " ", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#", " ", "<", " ", 
            RowBox[{"atolDecay", "/", 
             RowBox[{"(", 
              RowBox[{"10", " ", "rtolDecay"}], ")"}]}]}], " ", "&"}], ",", 
          " ", 
          RowBox[{"Abs", "[", 
           RowBox[{"Most", "[", "valsDecay", "]"}], "]"}]}], "]"}]}], "]"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"T2", "-", 
      RowBox[{"IDA", " ", 
       RowBox[{"(", "b", ")"}]}]}], ":", " ", 
     RowBox[{
     "t2evolveIDA", " ", "on", " ", "a", " ", "Hermitian", " ", "2", " ", "x",
       " ", "2", " ", "matrix", " ", "against", " ", "the", " ", "matrix", " ",
       "exponential"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"hmTwo", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0.3", ",", " ", 
         RowBox[{"0.5", " ", "-", " ", 
          RowBox[{"0.2", " ", "I"}]}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"0.5", " ", "+", " ", 
          RowBox[{"0.2", " ", "I"}]}], ",", " ", 
         RowBox[{"-", "0.7"}]}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"w0Two", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"0.6", ",", " ", 
       RowBox[{"0.8", " ", "I"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"toutsTwo", " ", "=", " ", 
     RowBox[{"Range", "[", 
      RowBox[{"0.", ",", " ", "10.", ",", " ", "0.5"}], "]"}]}], ";"}], "\n", 
   
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"evTwo", ",", " ", "vvTwo"}], "}"}], " ", "=", " ", 
     RowBox[{"t2eigh", "[", "hmTwo", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rtolTwo", ",", " ", "atolTwo"}], "}"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"1.*^-10", ",", " ", "1.*^-12"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"runTwo", " ", "=", " ", 
     RowBox[{"t2evolveIDA", "[", 
      RowBox[{
      "hmTwo", ",", " ", "w0Two", ",", " ", "toutsTwo", ",", " ", "rtolTwo", ",",
        " ", "atolTwo", ",", " ", 
       RowBox[{"t2localErrorsIDA", "[", 
        RowBox[{
        "evTwo", ",", " ", "vvTwo", ",", " ", "rtolTwo", ",", " ", 
         "atolTwo"}], "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"devTwo", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Norm", "[", 
          RowBox[{"#1", " ", "-", " ", 
           RowBox[{
            RowBox[{"MatrixExp", "[", 
             RowBox[{
              RowBox[{"-", "I"}], " ", "hmTwo", " ", "#2"}], "]"}], " ", ".", 
            " ", "w0Two"}]}], "]"}], " ", "&"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"runTwo", "[", "\"\<states\>\"", "]"}], ",", " ", 
          "toutsTwo"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"blocTwo", " ", "=", " ", 
     RowBox[{
      RowBox[{"rtolTwo", " ", 
       RowBox[{"runTwo", "[", 
        RowBox[{"[", 
         RowBox[{"\"\<analysis\>\"", ",", " ", "\"\<largestNorm\>\""}], "]"}],
         "]"}]}], " ", "+", " ", 
      RowBox[{"atolTwo", " ", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"2.", " ", "2"}], "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"berrTwo", " ", "=", " ", 
     RowBox[{
      RowBox[{"runTwo", "[", "\"\<steps\>\"", "]"}], " ", "blocTwo"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"boutTwo", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", " ", "+", " ", 
         RowBox[{
          RowBox[{"runTwo", "[", "\"\<hmax\>\"", "]"}], " ", 
          RowBox[{
           RowBox[{"Max", "[", 
            RowBox[{"Abs", "[", "evTwo", "]"}], "]"}], "/", "4"}]}]}], ")"}], 
       " ", "berrTwo"}], " ", "+", " ", 
      RowBox[{
       RowBox[{"runTwo", "[", "\"\<hmax\>\"", "]"}], " ", 
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"runTwo", "[", "\"\<residualAt\>\"", "]"}], "]"}], "/", 
        "4"}]}], " ", "+", "\n", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"runTwo", "[", "\"\<hmax\>\"", "]"}], " ", 
           RowBox[{"Max", "[", 
            RowBox[{"Abs", "[", "evTwo", "]"}], "]"}]}], ")"}], "^", "4"}], "/",
         "384"}], " ", 
       RowBox[{"runTwo", "[", 
        RowBox[{"[", 
         RowBox[{"\"\<analysis\>\"", ",", " ", "\"\<largestNorm\>\""}], "]"}],
         "]"}]}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"T2", "-", 
      RowBox[{"IDA", " ", 
       RowBox[{"(", "c", ")"}]}]}], ":", " ", 
     RowBox[{
     "the", " ", "function", " ", "t2evolveIDAChecked", " ", "repeats", " ", 
      "the", " ", "integration", " ", "of", " ", 
      RowBox[{"(", "b", ")"}], " ", "and", " ", "must", " ", "give", " ", 
      "the", " ", "same", " ", "states", " ", "and", " ", "bounds"}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"checkedTwo", " ", "=", " ", 
     RowBox[{"t2evolveIDAChecked", "[", 
      RowBox[{
      "hmTwo", ",", " ", "w0Two", ",", " ", "toutsTwo", ",", " ", "rtolTwo", ",",
        " ", "atolTwo"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sameTwo", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"checkedTwo", "[", "\"\<states\>\"", "]"}], " ", "==", " ", 
       RowBox[{"runTwo", "[", "\"\<states\>\"", "]"}]}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"checkedTwo", "[", "\"\<steps\>\"", "]"}], " ", "==", " ", 
       RowBox[{"runTwo", "[", "\"\<steps\>\"", "]"}]}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"checkedTwo", "[", "\"\<bloc\>\"", "]"}], " ", "==", " ", 
       "blocTwo"}], " ", "&&", "\n", "   ", 
      RowBox[{
       RowBox[{"checkedTwo", "[", "\"\<berr\>\"", "]"}], " ", "==", " ", 
       "berrTwo"}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"checkedTwo", "[", "\"\<bout\>\"", "]"}], " ", "==", " ", 
       "boutTwo"}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"checkedTwo", "[", "\"\<ratio\>\"", "]"}], " ", "==", " ", 
       RowBox[{"runTwo", "[", 
        RowBox[{"[", 
         RowBox[{"\"\<analysis\>\"", ",", " ", "\"\<largestRatio\>\""}], 
         "]"}], "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sumTwo", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"checkedTwo", "[", "\"\<sumloc\>\"", "]"}], " ", "<=", " ", 
       "berrTwo"}], " ", "&&", " ", 
      RowBox[{"devTwo", " ", "<=", " ", 
       RowBox[{"checkedTwo", "[", "\"\<bsum\>\"", "]"}], " ", "<=", " ", 
       "boutTwo"}]}]}], ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<T2-IDA\>\"", ",", 
     " ", "\"\<the integrator IDA of SUNDIALS, used through NDSolve with \
Method -> \\\"IDA\\\": (a) on the decaying exponential (rtol = 1e-8, atol = \
1e-10, x_LL^0 from 0 to 25) the exact local error of every internal step is \
at most the tolerance rtol |value| + atol of the step, and the largest ratio \
of the local error to this tolerance exceeds 1/128 both while the solution is \
above 10 atol/rtol and after it has fallen below atol/(10 rtol): the \
tolerances of IDA are 10^-PrecisionGoal and 10^-AccuracyGoal; (b) on a \
Hermitian 2 x 2 matrix (rtol = 1e-10, atol = 1e-12, 21 output times up to 10) \
every local error is at most budget_step = rtol (norm of the state) + atol \
sqrt(4), the largest deviation from the solution by MatrixExp is at most \
budget_out, and the states of NDSolve are the cubic Hermite polynomials of \
the stored values and derivatives (tolerance 1e-12); (c) the function \
t2evolveIDAChecked, which makes these measurements for the checks of the \
later chapters, gives the same states and the same bounds as (b); the sum of \
its measured local errors is at most budget, and the largest deviation is at \
most the bound made with this sum in place of budget, which is at most \
budget_out\>\"", ",", "\n", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"Max", "[", "ratioDecay", "]"}], " ", "<=", " ", "1"}], " ", "&&",
       " ", 
      RowBox[{"relDecay", " ", ">", " ", 
       RowBox[{"1", "/", "128"}]}], " ", "&&", " ", 
      RowBox[{"absDecay", " ", ">", " ", 
       RowBox[{"1", "/", "128"}]}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"runTwo", "[", 
        RowBox[{"[", 
         RowBox[{"\"\<analysis\>\"", ",", " ", "\"\<largestRatio\>\""}], 
         "]"}], "]"}], " ", "<=", " ", "1"}], " ", "&&", " ", 
      RowBox[{"devTwo", " ", "<=", " ", "boutTwo"}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"Max", "[", 
        RowBox[{"runTwo", "[", "\"\<hermiteAt\>\"", "]"}], "]"}], " ", "<", 
       " ", "1*^-12"}], " ", "&&", " ", "sameTwo", " ", "&&", " ", "sumTwo"}],
      ",", "\n", "  ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<(a) \>\"", ",", " ", 
        RowBox[{"Length", "[", "localDecay", "]"}], ",", 
        " ", "\"\< steps, largest ratio of a local error to its tolerance \
\>\"", ",", " ", 
        RowBox[{"NumberForm", "[", 
         RowBox[{
          RowBox[{"Max", "[", "ratioDecay", "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"4", ",", " ", "3"}], "}"}]}], "]"}], ",", 
        " ", "\"\< (relative regime \>\"", ",", " ", 
        RowBox[{"NumberForm", "[", 
         RowBox[{"relDecay", ",", " ", 
          RowBox[{"{", 
           RowBox[{"4", ",", " ", "3"}], "}"}]}], "]"}], ",", "\n", 
        "    ", "\"\<, absolute regime \>\"", ",", " ", 
        RowBox[{"NumberForm", "[", 
         RowBox[{"absDecay", ",", " ", 
          RowBox[{"{", 
           RowBox[{"4", ",", " ", "3"}], "}"}]}], "]"}], ",", 
        " ", "\"\<); (b) \>\"", ",", " ", 
        RowBox[{"runTwo", "[", "\"\<steps\>\"", "]"}], ",", 
        " ", "\"\< steps, \>\"", ",", " ", 
        RowBox[{"runTwo", "[", "\"\<evaluations\>\"", "]"}], ",", 
        " ", "\"\< evaluations, largest local_error/budget_step \>\"", ",", 
        "\n", "    ", 
        RowBox[{"NumberForm", "[", 
         RowBox[{
          RowBox[{"runTwo", "[", 
           RowBox[{"[", 
            RowBox[{"\"\<analysis\>\"", ",", " ", "\"\<largestRatio\>\""}], 
            "]"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"4", ",", " ", "3"}], "}"}]}], "]"}], ",", 
        " ", "\"\<, largest deviation \>\"", ",", " ", 
        RowBox[{"ScientificForm", "[", 
         RowBox[{"devTwo", ",", " ", "2"}], "]"}], ",", 
        " ", "\"\< <= budget_out \>\"", ",", " ", 
        RowBox[{"ScientificForm", "[", 
         RowBox[{"boutTwo", ",", " ", "2"}], "]"}], ",", "\n", 
        "    ", "\"\<, Hermite polynomials within \>\"", ",", " ", 
        RowBox[{"ScientificForm", "[", 
         RowBox[{
          RowBox[{"Max", "[", 
           RowBox[{"runTwo", "[", "\"\<hermiteAt\>\"", "]"}], "]"}], ",", " ",
           "2"}], "]"}], ",", 
        " ", "\"\<; (c) the same states and bounds: \>\"", ",", " ", 
        "sameTwo", ",", " ", "\"\<; sum of the local errors \>\"", ",", " ", 
        RowBox[{"ScientificForm", "[", 
         RowBox[{
          RowBox[{"checkedTwo", "[", "\"\<sumloc\>\"", "]"}], ",", " ", "2"}],
          "]"}], ",", " ", "\"\< <= budget \>\"", ",", " ", 
        RowBox[{"ScientificForm", "[", 
         RowBox[{"berrTwo", ",", " ", "2"}], "]"}], ",", "\n", 
        "    ", "\"\<, largest deviation \>\"", ",", " ", 
        RowBox[{"ScientificForm", "[", 
         RowBox[{"devTwo", ",", " ", "2"}], "]"}], ",", 
        " ", "\"\< <= bound with the sum \>\"", ",", " ", 
        RowBox[{"ScientificForm", "[", 
         RowBox[{
          RowBox[{"checkedTwo", "[", "\"\<bsum\>\"", "]"}], ",", " ", "2"}], 
         "]"}]}], "}"}], "]"}]}], "]"}]}]}]], "Input",ExpressionUUID->\
"31c73a18-71df-4657-9980-cae63921b59e"],

Cell["\<\
II.2 Item [1]: the field equations on the 3+1 manifold, and the checks GS-1 \
to GS-16 (program t2_fields)\
\>", "Section",ExpressionUUID->"751be14f-e594-47cc-8d1b-9bdf4d407776"],

Cell[TextData[{
 "The program t2_fields (t2fields/src/main.rs) builds every matrix of the \
field equations of the self-interacting spinor field ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "862722c1-1c7b-450a-a7cc-db2726c63c01"],
 " on ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[DoubleStruckCapitalR]",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    RowBox[{"1", ",", "3"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4d61f0aa-6a98-494b-bcb7-8cb290b3ffdf"],
 " and checks every statement made about them: checks GS-1 to GS-16. The \
rewriting below keeps the order of the original program, because the random \
numbers are drawn in that order from one generator with the seed 2026111707. \
Every check prints one line with PASS or FAIL; the statement is that of the \
original report, and the numbers in the details are the Wolfram Language \
results, followed (where the original report gives them) by the values of the \
original report."
}], "Text",ExpressionUUID->"37dcf05c-d209-47a1-998a-7bc35b61f3a4"],

Cell[TextData[{
 "The physics in brief. The covariant derivative is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Del]", 
     StyleBox["p", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubscriptBox["\[PartialD]", 
     StyleBox["p", "TI"]], "+", 
    SubsuperscriptBox["\[CapitalGamma]", 
     StyleBox["p", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "-", 
    StyleBox["i", "TI"], 
    SubscriptBox[
     StyleBox["A",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e0b5b970-d171-44c6-b58a-2cc5fea60334"],
 ", with the spin connection ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalGamma]", 
     StyleBox["p", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["s",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["u",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["LL",
        FontSlant->"Plain"], ",", 
       StyleBox["p", "TI"]}], "\[Omega]"], ")"}], "\[CircleTimes]", 
    SubsuperscriptBox["\[Sigma]", "0", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3ec50cbf-7d1d-4a48-a508-ec6792aafbe3"],
 " (the Lorentz connection ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["u",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], "\[Omega]"], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", 
     StyleBox["j", "TI"],
     LimitsPositioning->True], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["\[Omega]", 
       RowBox[{
        StyleBox["LL",
         FontSlant->"Plain"], ",", 
        StyleBox["p", "TI"]}], 
       StyleBox["j", "TI"]], 
      SubsuperscriptBox[
       StyleBox["J", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["j", "TI"]], "+", 
      SubsuperscriptBox["\[CurlyPi]", 
       RowBox[{
        StyleBox["LL",
         FontSlant->"Plain"], ",", 
        StyleBox["p", "TI"]}], 
       StyleBox["j", "TI"]], 
      SubsuperscriptBox[
       StyleBox["K", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["j", "TI"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "674a2d08-a7b9-48d2-b366-cbf8b03b1adc"],
 ", an element of the Lorentz algebra of the super-loop, acting on the Dirac \
index) and the gauge matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["A",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", "\[Iota]",
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], "\[Iota]"], 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Iota]"], "+", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], 
     StyleBox["F",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "8"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5afcaada-7acf-42db-a8b8-00592be9925a"],
 " of the isospin group and of the fermion number. The mean-field \
(Dirac-Bogoliubov-de Gennes) equations couple the particle part ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Psi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c1433f4f-6e19-4803-ab78-b5aba3da0255"],
 " and the hole part ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Psi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["h",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "687f1761-3c27-495b-9597-a464e4b4d8ab"],
 " of a mode through the pairing block ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["P",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", "\[Iota]",
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Iota]"], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "\[Iota]"], ")"}], "\[Dagger]"]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "58681c64-0b39-43ff-bf18-450fd2226dda"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["d", "TI"], "\[RightVector]"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["d", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "1"], ",", 
      SubsuperscriptBox[
       StyleBox["d", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "2"], ",", 
      SubsuperscriptBox[
       StyleBox["d", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "258e604b-15ba-46b8-be9b-89cb8529e3cc"],
 " is the order parameter."
}], "Text",ExpressionUUID->"6e8433d7-c1a3-4210-beb4-57d9d483f746"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "the", " ", "seed", " ", "of", " ", "the", " ", "program", " ", 
    "t2_fields", " ", "and", " ", "the", " ", "tolerance", " ", "of", " ", 
    "the", " ", "exact", " ", "relations"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"t2Seed", "[", "2026111707", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"tol", " ", "=", " ", "1*^-12"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", "Frobenius", " ", "norm"}], ",", " ", 
     RowBox[{
     "the", " ", "name", " ", "used", " ", "in", " ", "the", " ", "Rust", " ",
       "code"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"fro", "[", "m_", "]"}], " ", ":=", " ", 
     RowBox[{"Norm", "[", 
      RowBox[{"m", ",", " ", "\"\<Frobenius\>\""}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "the", " ", "four", " ", "Dirac", " ", "matrices", " ", "of", " ", "the", 
     " ", "canonical", " ", "frame"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"t2gamma", "[", "p", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], 
    ";"}]}]}]], "Input",ExpressionUUID->"157c1eed-0a06-44ff-bf5f-\
20c69735e182"],

Cell["GS-1 and GS-2: the Dirac matrices and the Lorentz generators", \
"Subsection",ExpressionUUID->"bf0d02df-b72d-4a30-aa4d-e61eb17b6160"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"GS", "-", "1"}], ":", " ", 
      RowBox[{"Clifford", " ", "relations", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"gamma", "^", "p"}], ",", " ", 
         RowBox[{"gamma", "^", "q"}]}], "}"}]}]}], " ", "=", " ", 
     RowBox[{"2", " ", 
      RowBox[{"eta", "^", "pq"}], " ", "1", "_", "4"}]}], ",", " ", 
    RowBox[{"and", " ", "the", " ", "forms", " ", "of", " ", "gamma_ch"}], ",",
     " ", "C", ",", " ", 
    RowBox[{"alpha", "^", "j"}], ",", " ", 
    RowBox[{"the", " ", "frame", " ", "and", " ", "eps2"}]}], " ", "*)"}], 
  "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"cliff", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"fro", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"g", "[", 
            RowBox[{"[", 
             RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}], " ", ".", " ", 
           RowBox[{"g", "[", 
            RowBox[{"[", 
             RowBox[{"q", " ", "+", " ", "1"}], "]"}], "]"}]}], " ", "+", " ", 
          RowBox[{
           RowBox[{"g", "[", 
            RowBox[{"[", 
             RowBox[{"q", " ", "+", " ", "1"}], "]"}], "]"}], " ", ".", " ", 
           RowBox[{"g", "[", 
            RowBox[{"[", 
             RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}]}], " ", "-", " ", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"p", " ", "==", " ", "q"}], ",", " ", 
             RowBox[{"2", " ", 
              RowBox[{"t2eta", "[", "p", "]"}]}], ",", " ", "0"}], "]"}], " ", 
           RowBox[{"IdentityMatrix", "[", "4", "]"}]}]}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"q", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}], "]"}]}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"gchOk", " ", "=", " ", 
     RowBox[{
      RowBox[{"fro", "[", 
       RowBox[{"t2gammaCh", " ", "-", " ", 
        RowBox[{"DiagonalMatrix", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", " ", 
           RowBox[{"-", "1"}], ",", " ", "1", ",", " ", "1"}], "}"}], "]"}]}],
        "]"}], " ", "<", " ", "tol"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"cOk", " ", "=", " ", 
     RowBox[{
      RowBox[{"fro", "[", 
       RowBox[{"t2cconj", " ", "-", " ", 
        RowBox[{"ArrayFlatten", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"t2eps2", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", 
             RowBox[{"-", "t2eps2"}]}], "}"}]}], "}"}], "]"}]}], "]"}], " ", "<",
       " ", "tol"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"alOk", " ", "=", " ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"Range", "[", "3", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"fro", "[", 
          RowBox[{
           RowBox[{"t2alpha", "[", "#", "]"}], " ", "-", " ", 
           RowBox[{"ArrayFlatten", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", 
                 RowBox[{"t2sigma", "[", "#", "]"}]}], ",", " ", "0"}], "}"}],
               ",", " ", 
              RowBox[{"{", 
               RowBox[{"0", ",", " ", 
                RowBox[{"t2sigma", "[", "#", "]"}]}], "}"}]}], "}"}], "]"}]}],
           "]"}], " ", "<", " ", "tol"}], " ", "&"}]}], "]"}]}], ";"}], "\n", 
   
   RowBox[{
    RowBox[{"frameOk", " ", "=", " ", 
     RowBox[{
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", " ", "3"}], "]"}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"fro", "[", 
            RowBox[{
             RowBox[{"t2mq", "[", 
              RowBox[{"t2canonicalFrame", "[", 
               RowBox[{"[", 
                RowBox[{"#", " ", "+", " ", "1"}], "]"}], "]"}], "]"}], " ", "-",
              " ", 
             RowBox[{"t2sigma", "[", "#", "]"}]}], "]"}], " ", "<", " ", 
           "tol"}], " ", "&&", "\n", "      ", 
          RowBox[{
           RowBox[{"fro", "[", 
            RowBox[{
             RowBox[{"t2mq", "[", 
              RowBox[{"t2bqConj", "[", 
               RowBox[{"t2canonicalFrame", "[", 
                RowBox[{"[", 
                 RowBox[{"#", " ", "+", " ", "1"}], "]"}], "]"}], "]"}], 
              "]"}], " ", "-", " ", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"#", " ", "==", " ", "0"}], ",", " ", "1", ",", " ", 
                RowBox[{"-", "1"}]}], "]"}], " ", 
              RowBox[{"t2sigma", "[", "#", "]"}]}]}], "]"}], " ", "<", " ", 
           "tol"}]}], " ", "&"}]}], "]"}], " ", "&&", "\n", "   ", 
      RowBox[{
       RowBox[{"fro", "[", 
        RowBox[{
         RowBox[{"t2mq", "[", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "0", ",", " ", 
            RowBox[{"-", "1"}], ",", " ", "0"}], "}"}], "]"}], " ", "-", " ", 
         "t2eps2"}], "]"}], " ", "<", " ", "tol"}]}]}], ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<GS-1\>\"", ",", 
     " ", "\"\<the Dirac matrices are built from the frame of R^(1,3)_LL; \
Clifford relations; gamma_ch = diag(-1,-1,1,1), C_LL = diag(eps2, -eps2), \
alpha^j = diag(-sigma_j, sigma_j), eps2 = M_LL(-e2)\>\"", ",", "\n", "  ", 
     RowBox[{
      RowBox[{"cliff", " ", "<", " ", "tol"}], " ", "&&", " ", "gchOk", " ", "&&",
       " ", "cOk", " ", "&&", " ", "alOk", " ", "&&", " ", "frameOk"}], ",", 
     " ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<largest deviation of the Clifford relations \>\"", ",", 
        " ", "cliff", ",", " ", "\"\< (original: 0.0e0)\>\""}], "}"}], 
      "]"}]}], "]"}]}]}]], "Input",ExpressionUUID->"32f845bd-fea0-42ec-aca0-\
adb229cdb63f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"GS", "-", "2"}], ":", " ", 
     RowBox[{"the", " ", "Lorentz", " ", "generators", " ", "sgen", 
      RowBox[{"(", 
       RowBox[{"J", "^", "j"}], ")"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"sgen", 
      RowBox[{"(", 
       RowBox[{"K", "^", "j"}], ")"}]}], ";", " ", 
     RowBox[{"the", " ", "27", " ", "relations", " ", "of", " ", "so", 
      RowBox[{"(", 
       RowBox[{"3", ",", "1"}], ")"}]}], ";", " ", 
     RowBox[{"the", " ", "24", " ", "intertwining", " ", "relations"}]}]}], 
   " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"sj", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"t2spinGen", "[", 
        RowBox[{"t2jgen", "[", "j", "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sk", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"t2spinGen", "[", 
        RowBox[{"t2kgen", "[", "j", "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"comm", "[", 
      RowBox[{"a_", ",", " ", "b_"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"a", " ", ".", " ", "b"}], " ", "-", " ", 
      RowBox[{"b", " ", ".", " ", "a"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"genOk", " ", "=", " ", 
     RowBox[{"And", " ", "@@", " ", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"jb", " ", "=", " ", 
              RowBox[{
               RowBox[{"Mod", "[", 
                RowBox[{"j", ",", " ", "3"}], "]"}], " ", "+", " ", "1"}]}], ",",
              " ", 
             RowBox[{"jc", " ", "=", " ", 
              RowBox[{
               RowBox[{"Mod", "[", 
                RowBox[{
                 RowBox[{"j", " ", "+", " ", "1"}], ",", " ", "3"}], "]"}], 
               " ", "+", " ", "1"}]}]}], "}"}], ",", "\n", "      ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"fro", "[", 
               RowBox[{
                RowBox[{"sj", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], " ", "-", " ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"g", "[", 
                   RowBox[{"[", 
                    RowBox[{"jb", " ", "+", " ", "1"}], "]"}], "]"}], " ", ".",
                   " ", 
                  RowBox[{"g", "[", 
                   RowBox[{"[", 
                    RowBox[{"jc", " ", "+", " ", "1"}], "]"}], "]"}]}], "/", 
                 "2"}]}], "]"}], " ", "<", " ", "tol"}], ",", " ", 
             RowBox[{
              RowBox[{"fro", "[", 
               RowBox[{
                RowBox[{"sk", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], " ", "-", " ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"g", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], " ", ".", " ", 
                  RowBox[{"g", "[", 
                   RowBox[{"[", 
                    RowBox[{"j", " ", "+", " ", "1"}], "]"}], "]"}]}], "/", 
                 "2"}]}], "]"}], " ", "<", " ", "tol"}], ",", "\n", "       ", 
             RowBox[{
              RowBox[{"fro", "[", 
               RowBox[{
                RowBox[{"sj", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], " ", "-", " ", 
                RowBox[{"ArrayFlatten", "[", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"-", "I"}], "/", "2"}], " ", 
                    RowBox[{"t2sigma", "[", "j", "]"}]}], ",", " ", "0"}], 
                    "}"}], ",", " ", 
                   RowBox[{"{", 
                    RowBox[{"0", ",", " ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"-", "I"}], "/", "2"}], " ", 
                    RowBox[{"t2sigma", "[", "j", "]"}]}]}], "}"}]}], "}"}], 
                 "]"}]}], "]"}], " ", "<", " ", "tol"}], ",", "\n", "       ", 
             RowBox[{
              RowBox[{"fro", "[", 
               RowBox[{
                RowBox[{"sk", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], " ", "-", " ", 
                RowBox[{"ArrayFlatten", "[", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"-", "1"}], "/", "2"}], " ", 
                    RowBox[{"t2sigma", "[", "j", "]"}]}], ",", " ", "0"}], 
                    "}"}], ",", " ", 
                   RowBox[{"{", 
                    RowBox[{"0", ",", " ", 
                    RowBox[{
                    RowBox[{"1", "/", "2"}], " ", 
                    RowBox[{"t2sigma", "[", "j", "]"}]}]}], "}"}]}], "}"}], 
                 "]"}]}], "]"}], " ", "<", " ", "tol"}]}], "}"}]}], "]"}], ",",
          " ", 
         RowBox[{"{", 
          RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rel", " ", "=", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"lj", " ", "=", " ", 
             RowBox[{"Sum", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"t2eps3", "[", 
                 RowBox[{"a", ",", " ", "b", ",", " ", "c"}], "]"}], " ", 
                RowBox[{"sj", "[", 
                 RowBox[{"[", "c", "]"}], "]"}]}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"c", ",", " ", "3"}], "}"}]}], "]"}]}], ",", " ", 
            RowBox[{"lk", " ", "=", " ", 
             RowBox[{"Sum", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"t2eps3", "[", 
                 RowBox[{"a", ",", " ", "b", ",", " ", "c"}], "]"}], " ", 
                RowBox[{"sk", "[", 
                 RowBox[{"[", "c", "]"}], "]"}]}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"c", ",", " ", "3"}], "}"}]}], "]"}]}]}], "}"}], ",", 
          "\n", "      ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"fro", "[", 
              RowBox[{
               RowBox[{"comm", "[", 
                RowBox[{
                 RowBox[{"sj", "[", 
                  RowBox[{"[", "a", "]"}], "]"}], ",", " ", 
                 RowBox[{"sj", "[", 
                  RowBox[{"[", "b", "]"}], "]"}]}], "]"}], " ", "-", " ", 
               "lj"}], "]"}], " ", "<", " ", "tol"}], ",", " ", 
            RowBox[{
             RowBox[{"fro", "[", 
              RowBox[{
               RowBox[{"comm", "[", 
                RowBox[{
                 RowBox[{"sj", "[", 
                  RowBox[{"[", "a", "]"}], "]"}], ",", " ", 
                 RowBox[{"sk", "[", 
                  RowBox[{"[", "b", "]"}], "]"}]}], "]"}], " ", "-", " ", 
               "lk"}], "]"}], " ", "<", " ", "tol"}], ",", " ", 
            RowBox[{
             RowBox[{"fro", "[", 
              RowBox[{
               RowBox[{"comm", "[", 
                RowBox[{
                 RowBox[{"sk", "[", 
                  RowBox[{"[", "a", "]"}], "]"}], ",", " ", 
                 RowBox[{"sk", "[", 
                  RowBox[{"[", "b", "]"}], "]"}]}], "]"}], " ", "+", " ", 
               "lj"}], "]"}], " ", "<", " ", "tol"}]}], "}"}]}], "]"}], ",", 
        " ", 
        RowBox[{"{", 
         RowBox[{"a", ",", " ", "3"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"b", ",", " ", "3"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"intertw", " ", "=", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"s", " ", "=", " ", 
             RowBox[{"t2spinGen", "[", "u", "]"}]}], ",", " ", 
            RowBox[{"v", " ", "=", " ", 
             RowBox[{"t2vecAction", "[", "u", "]"}]}]}], "}"}], ",", "\n", 
          "      ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"fro", "[", 
              RowBox[{
               RowBox[{"comm", "[", 
                RowBox[{
                 RowBox[{"g", "[", 
                  RowBox[{"[", 
                   RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}], ",", " ", 
                 "s"}], "]"}], " ", "-", " ", 
               RowBox[{"Sum", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"v", "[", 
                   RowBox[{"[", 
                    RowBox[{
                    RowBox[{"p", " ", "+", " ", "1"}], ",", " ", 
                    RowBox[{"q", " ", "+", " ", "1"}]}], "]"}], "]"}], " ", 
                  RowBox[{"g", "[", 
                   RowBox[{"[", 
                    RowBox[{"q", " ", "+", " ", "1"}], "]"}], "]"}]}], ",", 
                 " ", 
                 RowBox[{"{", 
                  RowBox[{"q", ",", " ", "0", ",", " ", "3"}], "}"}]}], 
                "]"}]}], "]"}], " ", "<", " ", "tol"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], 
         "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"j", ",", " ", "3"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"u", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"t2jgen", "[", "j", "]"}], ",", " ", 
            RowBox[{"t2kgen", "[", "j", "]"}]}], "}"}]}], "}"}]}], "]"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<GS-2\>\"", ",", 
     " ", "\"\<the Lorentz generators of the super-loop on the Dirac spinor, \
sgen(J^j) = diag(-i sigma_j/2, -i sigma_j/2) = gamma^j' gamma^j''/2, \
sgen(K^j) = diag(-sigma_j/2, sigma_j/2) = gamma^0 gamma^j/2; the 27 relations \
of so(3,1); 24 intertwining relations [gamma^p, sgen(u)] = sum V(u)[p][q] \
gamma^q\>\"", ",", "\n", "  ", 
     RowBox[{"genOk", " ", "&&", " ", 
      RowBox[{"(", 
       RowBox[{"And", " ", "@@", " ", "rel"}], ")"}], " ", "&&", " ", 
      RowBox[{"(", 
       RowBox[{"And", " ", "@@", " ", "intertw"}], ")"}]}], ",", " ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Length", "[", "rel", "]"}], ",", 
        " ", "\"\< commutation relations, \>\"", ",", " ", 
        RowBox[{"Length", "[", "intertw", "]"}], ",", 
        " ", "\"\< intertwining relations (original: 27 and 24)\>\""}], "}"}],
       "]"}]}], "]"}]}]}]], "Input",ExpressionUUID->"1edd5ba2-9420-4699-aa6c-\
7a64cf0b9ef4"],

Cell["\<\
GS-3 and GS-4: finite transformations, isospin and the pair matrices\
\>", "Subsection",ExpressionUUID->"a15b4622-61ad-4bce-b0bd-4241fc133468"],

Cell[TextData[{
 "GS-3 is the change of representation of the gauge group ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SL", "TI"], 
    RowBox[{"(", 
     RowBox[{"2", ",", 
      StyleBox["\[DoubleStruckCapitalC]",
       FontSlant->"Plain"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1a278e63-534e-4701-8572-191e7000d930"],
 ": for a unit bi-quaternion ",
 Cell[BoxData[
  FormBox[
   StyleBox["g",
    FontWeight->"Bold",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "64020e80-2bf9-4696-a242-07e56a839a67"],
 " the spinor matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["S",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[LongEqual]", 
    StyleBox["diag",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      RowBox[{"(", 
       OverscriptBox[
        StyleBox["g",
         FontWeight->"Bold",
         FontSlant->"Plain"], "~"], ")"}], ",", 
      SubscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      RowBox[{"(", 
       StyleBox["g",
        FontWeight->"Bold",
        FontSlant->"Plain"], ")"}]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
