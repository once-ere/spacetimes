          StyleBox["LL",
           FontSlant->"Plain"], 
          StyleBox["j", "TI"]]}], ")"}]}], ")"}], "-", 
     FractionBox[
      SubsuperscriptBox[
       StyleBox["r", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["W",
        FontSlant->"Plain"]], 
      RowBox[{"2", 
       SubsuperscriptBox["\[ScriptL]", 
        StyleBox["LL",
         FontSlant->"Plain"], 
        StyleBox["x",
         FontSlant->"Plain"]]}]], 
