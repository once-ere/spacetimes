                  RowBox[{"aAt", "[", 
                   RowBox[{"y", ",", " ", "q"}], "]"}], ",", " ", 
                  RowBox[{"afAt", "[", 
                   RowBox[{"y", ",", " ", "q"}], "]"}]}], "]"}]}], ";", "\n", 
               "     ", 
               RowBox[{
                RowBox[{"np", "[", "y_", "]"}], " ", ":=", " ", 
                RowBox[{"nabla", "[", 
                 RowBox[{
                  RowBox[{"psiAt", "[", "y", "]"}], ",", " ", 
                  RowBox[{"dpsiAt", "[", 
                   RowBox[{"y", ",", " ", "p"}], "]"}], ",", " ", 
                  RowBox[{"gammaAt", "[", 
                   RowBox[{"y", ",", " ", "p"}], "]"}], ",", " ", 
                  RowBox[{"aAt", "[", 
                   RowBox[{"y", ",", " ", "p"}], "]"}], ",", " ", 
                  RowBox[{"afAt", "[", 
