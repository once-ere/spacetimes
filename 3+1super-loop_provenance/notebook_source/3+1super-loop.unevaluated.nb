        RowBox[{
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"z", " ", "=", " ", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"i", " ", "==", " ", "j"}], ",", " ", 
                 RowBox[{
                  RowBox[{"t2Unit", "[", "]"}], " ", "+", " ", 
                  RowBox[{"0.", " ", "I"}]}], ",", " ", 
                 RowBox[{"t2UnitC", "[", "]"}]}], "]"}]}], "}"}], ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"a", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", " ", "j"}], "]"}], "]"}], " ", "=", " ", 
               "z"}], ";", " ", 
              RowBox[{
               RowBox[{"a", "[", 
                RowBox[{"[", 
                 RowBox[{"j", ",", " ", "i"}], "]"}], "]"}], " ", "=", " ", 
               RowBox[{"Conjugate", "[", "z", "]"}]}]}]}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "nn"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"j", ",", " ", "i"}], "}"}]}], "]"}], ";", "\n", "   ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ev", ",", " ", "v"}], "}"}], " ", "=", " ", 
          RowBox[{"t2eigh", "[", "a", "]"}]}], ";", "\n", "   ", 
         RowBox[{"worst11", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"worst11", ",", " ", 
            RowBox[{
             RowBox[{"fro", "[", 
              RowBox[{
               RowBox[{"v", " ", ".", " ", 
                RowBox[{"DiagonalMatrix", "[", "ev", "]"}], " ", ".", " ", 
                RowBox[{"ConjugateTranspose", "[", "v", "]"}]}], " ", "-", 
               " ", "a"}], "]"}], "/", 
             RowBox[{"fro", "[", "a", "]"}]}], ",", " ", 
            RowBox[{"fro", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"ConjugateTranspose", "[", "v", "]"}], " ", ".", " ", 
               "v"}], " ", "-", " ", 
              RowBox[{"IdentityMatrix", "[", "nn", "]"}]}], "]"}]}], 
           "]"}]}]}]}], "]"}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"nn", ",", " ", 
        RowBox[{"{", 
         RowBox[{"7", ",", " ", "64", ",", " ", "200"}], "}"}]}], "}"}]}], 
     "]"}], ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<GS-11\>\"", ",", 
     " ", "\"\<the Hermitian eigensolver of t2core (Householder reduction and \
implicit QL), rewritten above: for random Hermitian matrices of the \
dimensions 7, 64 and 200 the eigenvectors are orthonormal and reproduce the \
matrix (relative tolerance 1e-11)\>\"", ",", "\n", "  ", 
     RowBox[{"worst11", " ", "<", " ", "1*^-11"}], ",", " ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<largest relative residual \>\"", ",", " ", "worst11", ",",
         " ", "\"\< (original: 6.0e-14)\>\""}], "}"}], "]"}]}], 
    "]"}]}]}]], "Input",ExpressionUUID->"fa27d357-97d0-4b81-a91f-\
96ecc867880c"],

Cell["GS-12: the explicit matrices and the component equations", "Subsection",ExpressionUUID->"60a84241-f8f1-4350-8735-786d4851f4eb"],

Cell[TextData[{
 "The original program prints every matrix and every component equation of \
the field equations in TeX, with its small symbolic algebra, and evaluates \
each printed expression for numbers assigned to its symbols, comparing it \
with the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"8", "\[Times]", "8"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9c1abd55-a9b5-4863-83d8-c2cdccd443b3"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"16", "\[Times]", "16"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fe15d058-fde0-470a-b8c1-f9c27916d02c"],
 " matrix computation (check GS-12). Here the same expressions are built from \
symbols of the Wolfram Language, shown, and evaluated in the same way. The \
symbols: ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["d", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6069fc63-1d7f-4117-b42e-9609d1c0212f"],
 " (the order parameter), ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Omega]", 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}], 
    StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dca1f4e6-2998-46fb-beba-11b6fb3af60e"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CurlyPi]", 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}], 
    StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "44a21eeb-17f4-46ff-a530-a34f757e9869"],
 " (the rotation and boost parts of the Lorentz connection in the direction \
",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "eaaea6a4-7e6c-405f-b9ff-18afb68de42a"],
 "), ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["A", "TI"], 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}], "\[Iota]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e0e6fd76-4e3f-4c03-8c38-295d24c97dab"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["A", "TI"], 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}], 
    StyleBox["F",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d05da686-9358-4df5-aee6-1136b850e62b"],
 " (the gauge potentials), ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["v",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "82b7192f-2a8f-4118-8da4-94ca0cdc05ee"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["F",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "572a5677-8894-4bca-b78a-cfe48b41f4f6"],
 " (the couplings), ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Psi]", 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["k", "TI"]}], 
    StyleBox["p",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c328b749-156f-436a-9781-d73634583e2e"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Psi]", 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["k", "TI"]}], 
    StyleBox["h",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e7bd1b92-764e-409e-a4a8-9167da2ea66d"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPsi]", 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["k", "TI"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1071e0be-5b87-4f97-ae5a-a64efd964524"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["k", "TI"], "\[LongEqual]", "1", ",", "\[Ellipsis]", ",", "8"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "86ad1175-9985-4b24-97cb-fda2236de4f5"],
 ", the components), ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f053e2ca-a5aa-480c-84aa-544b08be1489"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Mu]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5f03355d-4de8-41b4-b9c3-f699d7601fc7"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bdf25fc8-6c5c-4ba5-ba36-61d02d97b721"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalPi]", 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9c1a18cd-1835-453a-874a-d623f99df430"],
 " (the pair operators). They are ordinary symbols with formatting rules, so \
that they print as in the documents."
}], "Text",ExpressionUUID->"aee23fae-3fad-4d07-8662-aef355386fd0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "the", " ", "symbols", " ", "of", " ", "the", " ", "formulas", " ", "and", 
    " ", "the", " ", "way", " ", "they", " ", "print"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Format", "[", 
      RowBox[{"dS", "[", "i_", "]"}], "]"}], " ", ":=", " ", 
     RowBox[{"Subsuperscript", "[", 
      RowBox[{"\"\<d\>\"", ",", " ", "\"\<LL\>\"", ",", " ", "i"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Format", "[", 
      RowBox[{"dStarS", "[", "i_", "]"}], "]"}], " ", ":=", " ", 
     RowBox[{"Superscript", "[", 
      RowBox[{
       RowBox[{"Subsuperscript", "[", 
        RowBox[{"\"\<d\>\"", ",", " ", "\"\<LL\>\"", ",", " ", "i"}], "]"}], ",",
        " ", "\"\<*\>\""}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Format", "[", 
      RowBox[{"omS", "[", 
       RowBox[{"j_", ",", " ", "idx_"}], "]"}], "]"}], " ", ":=", " ", 
     RowBox[{"Subsuperscript", "[", 
      RowBox[{"\"\<\[Omega]\>\"", ",", " ", 
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<LL,\>\"", ",", " ", "idx"}], "}"}], "]"}], ",", " ", 
       "j"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Format", "[", 
      RowBox[{"vpS", "[", 
       RowBox[{"j_", ",", " ", "idx_"}], "]"}], "]"}], " ", ":=", " ", 
     RowBox[{"Subsuperscript", "[", 
      RowBox[{"\"\<\[CurlyPi]\>\"", ",", " ", 
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<LL,\>\"", ",", " ", "idx"}], "}"}], "]"}], ",", " ", 
       "j"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Format", "[", 
      RowBox[{"afS", "[", "idx_", "]"}], "]"}], " ", ":=", " ", 
