        RowBox[{
         RowBox[{"a", " ", "list", " ", "of", " ", "four", " ", "bi"}], "-", 
         "quaternions"}], ")"}]}], ":", " ", 
      RowBox[{"gamma", "^", 
       RowBox[{"p", "[", "f", "]"}]}]}], " ", "=", " ", 
     RowBox[{"[", 
      RowBox[{
       RowBox[{"[", 
        RowBox[{"0", ",", " ", 
         RowBox[{"M", 
          RowBox[{"(", "f_p", ")"}]}]}], "]"}], ",", " ", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{"M", 
          RowBox[{"(", 
           RowBox[{"conj", " ", "f_p"}], ")"}]}], ",", " ", "0"}], "]"}]}], 
      "]"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2gammasFromFrame", "[", "f_", "]"}], " ", ":=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"ArrayFlatten", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", " ", 
            RowBox[{"t2mq", "[", 
             RowBox[{"f", "[", 
              RowBox[{"[", 
               RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}], "]"}]}], 
           "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"t2mq", "[", 
             RowBox[{"t2bqConj", "[", 
              RowBox[{"f", "[", 
               RowBox[{"[", 
                RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}], "]"}], "]"}],
             ",", " ", "0"}], "}"}]}], "}"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"gamma_LL", "^", "p"}], " ", "of", " ", "the", " ", "canonical", 
     " ", "frame", " ", 
     RowBox[{"(", 
      RowBox[{"p", " ", "=", " ", 
       RowBox[{
        RowBox[{"0", ".."}], "3"}]}], ")"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"t2gammaList", " ", "=", " ", 
     RowBox[{"t2gammasFromFrame", "[", "t2canonicalFrame", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2gamma", "[", "p_Integer", "]"}], " ", ":=", " ", 
     RowBox[{"t2gammaList", "[", 
      RowBox[{"[", 
       RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"the", " ", "chirality", " ", "matrix", " ", "gamma_ch"}], " ", 
