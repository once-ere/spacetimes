Cell["\<\
A first look at the reader of formulas: the TeX of seven formulas, the \
reading of the boxes on one line, and the formula as it is displayed.\
\>", "Text",ExpressionUUID->"e40a15f3-f59c-4855-aa94-7a74ab9d2638"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"formulaExamples", " ", "=", " ", 
