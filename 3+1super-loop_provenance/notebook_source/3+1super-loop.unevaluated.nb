            FontSlant->"Plain"], 
           StyleBox["j", "TI"]]}], ")"}], "\[Dagger]"], 
       SubsuperscriptBox["\[Psi]", 
        StyleBox["LL",
         FontSlant->"Plain"], 
        StyleBox["p",
         FontSlant->"Plain"]], 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox[
          OverscriptBox[
           StyleBox["s", "TI"], "\[RightVector]"], 
          StyleBox["LL",
           FontSlant->"Plain"]], "-", 
         SubsuperscriptBox[
          OverscriptBox["\[Delta]", "\[RightVector]"], 
          StyleBox["LL",
           FontSlant->"Plain"], 
          StyleBox["j", "TI"]]}], ")"}], "-", "2", 
