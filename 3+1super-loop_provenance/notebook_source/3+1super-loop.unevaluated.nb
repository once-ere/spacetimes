                   RowBox[{"q", " ", "+", " ", "1"}], "]"}], "]"}]}], 
                "]"}]}]}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"q", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}]}],
          ";", "\n", "   ", 
         RowBox[{"worst7", " ", "=", " ", 
