         FontSlant->"Plain"], 
        StyleBox["p",
         FontSlant->"Plain"]], 
       RowBox[{"(", 
        SubscriptBox[
         OverscriptBox[
          StyleBox["s", "TI"], "\[RightVector]"], 
         StyleBox["LL",
          FontSlant->"Plain"]], ")"}]}], ")"}]}], "]"}], "+", 
   SubscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
