        "on", " ", "plane", " ", "waves", " ", "as", " ", "N_p"}]}]}], " ", "=",
     " ", 
    RowBox[{
     RowBox[{"i", " ", "k_p"}], " ", "-", " ", 
     RowBox[{"i", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"gv", " ", 
         RowBox[{"A_p", ".", "T"}]}], " ", "+", " ", 
        RowBox[{"gF", " ", "AF_p"}]}], ")"}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"worst7", " ", "=", " ", "0."}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"Module", "[", 
