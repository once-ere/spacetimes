   RowBox[{
    RowBox[{"Do", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"q", " ", "=", " ", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"2", " ", 
              RowBox[{"t2Unit", "[", "]"}]}], ",", " ", 
             RowBox[{"{", "3", "}"}]}], "]"}]}], ",", " ", "delta", ",", " ", 
          "hm", ",", " ", "ev", ",", " ", "epsq", ",", " ", "ep", ",", " ", 
          "em", ",", " ", "expect"}], "}"}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{"delta", " ", "=", " ", 
          RowBox[{"0.25", " ", "+", " ", 
           RowBox[{"0.2", " ", 
            RowBox[{"t2Unit", "[", "]"}]}]}]}], ";", "\n", "   ", 
         RowBox[{"hm", " ", "=", " ", 
          RowBox[{"hq", "[", 
           RowBox[{"q", ",", " ", "zero3", ",", " ", 
            RowBox[{"ConstantArray", "[", 
             RowBox[{"0", ",", " ", 
              RowBox[{"{", 
               RowBox[{"8", ",", " ", "8"}], "}"}]}], "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "0", ",", " ", "delta"}], "}"}], ",", " ",
             "mu"}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"ev", " ", "=", " ", 
          RowBox[{"First", "[", 
           RowBox[{"t2eigh", "[", "hm", "]"}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"epsq", " ", "=", " ", 
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{"q", " ", ".", " ", "q"}], " ", "+", " ", 
            RowBox[{"mass", "^", "2"}]}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"ep", " ", "=", " ", 
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"epsq", " ", "+", " ", "mu"}], ")"}], "^", "2"}], " ", "+",
             " ", 
            RowBox[{"delta", "^", "2"}]}], "]"}]}], ";", " ", 
         RowBox[{"em", " ", "=", " ", 
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"epsq", " ", "-", " ", "mu"}], ")"}], "^", "2"}], " ", "+",
             " ", 
            RowBox[{"delta", "^", "2"}]}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"expect", " ", "=", " ", 
          RowBox[{"Sort", "[", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"ConstantArray", "[", 
              RowBox[{
               RowBox[{"-", "ep"}], ",", " ", "4"}], "]"}], ",", " ", 
             RowBox[{"ConstantArray", "[", 
              RowBox[{
               RowBox[{"-", "em"}], ",", " ", "4"}], "]"}], ",", " ", 
             RowBox[{"ConstantArray", "[", 
              RowBox[{"em", ",", " ", "4"}], "]"}], ",", " ", 
             RowBox[{"ConstantArray", "[", 
              RowBox[{"ep", ",", " ", "4"}], "]"}]}], "]"}], "]"}]}], ";", 
         "\n", "   ", 
         RowBox[{"worst9s", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"worst9s", ",", " ", 
            RowBox[{"Max", "[", 
             RowBox[{"Abs", "[", 
              RowBox[{"ev", " ", "-", " ", "expect"}], "]"}], "]"}]}], 
           "]"}]}]}]}], "]"}], ",", "\n", "  ", 
      RowBox[{"{", "30", "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<GS-8\>\"", ",", 
     " ", "\"\<the Dirac-Bogoliubov-de Gennes operator H_DB(q) with constant \
gauge fields is Hermitian and particle-hole symmetric (50 random momenta, \
fields and order parameters); for the polar order parameter (0, 0, Delta) its \
spectrum is +-E^(+-), each four times (30 random momenta; m = 0.4, mu = 0.3; \
tolerance 1e-10)\>\"", ",", "\n", "  ", 
     RowBox[{
      RowBox[{"worst9", " ", "<", " ", "1*^-10"}], " ", "&&", " ", 
      RowBox[{"worst9s", " ", "<", " ", "1*^-10"}]}], ",", " ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<largest deviations \>\"", ",", " ", "worst9", ",", 
        " ", "\"\< and \>\"", ",", " ", "worst9s", ",", 
        " ", "\"\< (original: 0.0e0 and 6.7e-15)\>\""}], "}"}], "]"}]}], 
    "]"}]}]}]], "Input",ExpressionUUID->"e3de4581-9a0e-45c0-a9f5-\
