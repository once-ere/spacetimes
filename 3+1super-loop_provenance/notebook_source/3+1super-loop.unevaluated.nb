    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"om", " ", "=", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"t2Unit", "[", "]"}], ",", " ", 
           RowBox[{"{", "3", "}"}]}], "]"}]}], "}"}], ",", " ", 
       RowBox[{"lorentzElem", "[", 
        RowBox[{"om", ",", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"t2Unit", "[", "]"}], ",", " ", 
           RowBox[{"{", "3", "}"}]}], "]"}]}], "]"}]}], "]"}], ",", " ", 
     RowBox[{"{", "5", "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"mg15", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{"t2expm", "[", 
    RowBox[{
     RowBox[{"t2mq", "[", 
      RowBox[{"ulist", "[", 
       RowBox[{"[", "5", "]"}], "]"}], "]"}], " ", "+", " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"x", "[", 
         RowBox[{"[", "p", "]"}], "]"}], " ", 
        RowBox[{"t2mq", "[", 
         RowBox[{"ulist", "[", 
          RowBox[{"[", "p", "]"}], "]"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"p", ",", " ", "4"}], "}"}]}], "]"}]}], "]"}]}], ";"}], "\n", 

 RowBox[{
  RowBox[{
   RowBox[{"h15", " ", "=", " ", "1*^-4"}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"the", " ", "connection"}], " ", "-", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"d_p", " ", "Sspin"}], ")"}], " ", 
      RowBox[{"Sspin", "^", 
       RowBox[{"-", "1"}]}]}]}], ";", " ", 
    RowBox[{
    "the", " ", "scalar", " ", "factor", " ", "is", " ", "applied", " ", 
     "before", " ", "the", " ", "matrix", " ", "product", "\n", "   ", 
     RowBox[{"(", 
      RowBox[{
      "Dot", " ", "binds", " ", "more", " ", "strongly", " ", "than", " ", 
       "the", " ", "product", " ", "with", " ", "a", " ", "number"}], 
      ")"}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"conn15", "[", 
    RowBox[{"x_", ",", " ", "p_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{"0.5", "/", "h15"}], ")"}]}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"t2spinRep", "[", 
         RowBox[{"mg15", "[", 
          RowBox[{"shift", "[", 
           RowBox[{"x", ",", " ", "p", ",", " ", "h15"}], "]"}], "]"}], "]"}],
         " ", "-", " ", 
        RowBox[{"t2spinRep", "[", 
         RowBox[{"mg15", "[", 
          RowBox[{"shift", "[", 
           RowBox[{"x", ",", " ", "p", ",", " ", 
            RowBox[{"-", "h15"}]}], "]"}], "]"}], "]"}]}], ")"}]}], ")"}], 
    " ", ".", " ", 
    RowBox[{"t2spinRep", "[", 
     RowBox[{"t2inv2", "[", 
      RowBox[{"mg15", "[", "x", "]"}], "]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"gam15", "[", 
    RowBox[{"x_", ",", " ", "q_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"mg", " ", "=", " ", 
       RowBox[{"mg15", "[", "x", "]"}]}], "}"}], ",", " ", 
     RowBox[{
      RowBox[{"t2spinRep", "[", "mg", "]"}], " ", ".", " ", 
      RowBox[{"t2gamma", "[", "q", "]"}], " ", ".", " ", 
      RowBox[{"t2spinRep", "[", 
       RowBox[{"t2inv2", "[", "mg", "]"}], "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dev15form", " ", "=", " ", "0."}], ";", " ", 
  RowBox[{"dev15const", " ", "=", " ", "0."}], ";", " ", 
  RowBox[{"dev15curv", " ", "=", " ", "0."}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", " ", "=", " ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"t2Unit", "[", "]"}], ",", " ", 
            RowBox[{"{", "4", "}"}]}], "]"}]}], ",", " ", "gp"}], "}"}], ",", 
       "\n", "   ", 
       RowBox[{
        RowBox[{"gp", " ", "=", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"conn15", "[", 
            RowBox[{"x", ",", " ", "p"}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], ";",
         "\n", "   ", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"up", " ", "=", " ", 
               RowBox[{"gp", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"p", " ", "+", " ", "1"}], ",", " ", 
                  RowBox[{"1", " ", ";;", " ", "2"}], ",", " ", 
                  RowBox[{"1", " ", ";;", " ", "2"}]}], "]"}], "]"}]}], ",", 
              " ", 
              RowBox[{"lo", " ", "=", " ", 
               RowBox[{"gp", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"p", " ", "+", " ", "1"}], ",", " ", 
                  RowBox[{"3", " ", ";;", " ", "4"}], ",", " ", 
                  RowBox[{"3", " ", ";;", " ", "4"}]}], "]"}], "]"}]}], ",", 
              " ", "off"}], "}"}], ",", "\n", "      ", 
            RowBox[{
             RowBox[{"off", " ", "=", " ", 
              RowBox[{
               RowBox[{"fro", "[", 
                RowBox[{"gp", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{"p", " ", "+", " ", "1"}], ",", " ", 
                   RowBox[{"1", " ", ";;", " ", "2"}], ",", " ", 
                   RowBox[{"3", " ", ";;", " ", "4"}]}], "]"}], "]"}], "]"}], 
               " ", "+", " ", 
               RowBox[{"fro", "[", 
                RowBox[{"gp", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{"p", " ", "+", " ", "1"}], ",", " ", 
                   RowBox[{"3", " ", ";;", " ", "4"}], ",", " ", 
                   RowBox[{"1", " ", ";;", " ", "2"}]}], "]"}], "]"}], 
                "]"}]}]}], ";", "\n", "      ", 
             RowBox[{"dev15form", " ", "=", " ", 
              RowBox[{"Max", "[", 
               RowBox[{"dev15form", ",", " ", "off", ",", " ", 
                RowBox[{"fro", "[", 
                 RowBox[{"up", " ", "+", " ", 
                  RowBox[{"ConjugateTranspose", "[", "lo", "]"}]}], "]"}], ",",
                 " ", 
                RowBox[{"Abs", "[", 
                 RowBox[{"Tr", "[", "lo", "]"}], "]"}]}], "]"}]}], ";", "\n", 
             "      ", 
             RowBox[{"Do", "[", "\n", "       ", 
              RowBox[{
               RowBox[{
                RowBox[{"dev15const", " ", "=", " ", 
                 RowBox[{"Max", "[", 
                  RowBox[{"dev15const", ",", " ", 
                   RowBox[{"fro", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"gam15", "[", 
                    RowBox[{
                    RowBox[{"shift", "[", 
                    RowBox[{"x", ",", " ", "p", ",", " ", "h15"}], "]"}], ",",
                     " ", "q"}], "]"}], " ", "-", " ", 
                    RowBox[{"gam15", "[", 
                    RowBox[{
                    RowBox[{"shift", "[", 
                    RowBox[{"x", ",", " ", "p", ",", " ", 
                    RowBox[{"-", "h15"}]}], "]"}], ",", " ", "q"}], "]"}]}], 
                    ")"}], " ", 
                    RowBox[{"(", 
                    RowBox[{"0.5", "/", "h15"}], ")"}]}], " ", "+", " ", 
                    RowBox[{"comm", "[", 
                    RowBox[{
                    RowBox[{"gp", "[", 
                    RowBox[{"[", 
                    RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}], ",", " ", 
                    RowBox[{"gam15", "[", 
                    RowBox[{"x", ",", " ", "q"}], "]"}]}], "]"}]}], "]"}]}], 
                  "]"}]}], ";", "\n", "       ", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"q", " ", "!=", " ", "p"}], ",", "\n", "        ", 
                  RowBox[{"dev15curv", " ", "=", " ", 
                   RowBox[{"Max", "[", 
                    RowBox[{"dev15curv", ",", " ", 
                    RowBox[{"fro", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"conn15", "[", 
                    RowBox[{
                    RowBox[{"shift", "[", 
                    RowBox[{"x", ",", " ", "p", ",", " ", "h15"}], "]"}], ",",
                     " ", "q"}], "]"}], " ", "-", " ", 
                    RowBox[{"conn15", "[", 
                    RowBox[{
                    RowBox[{"shift", "[", 
                    RowBox[{"x", ",", " ", "p", ",", " ", 
                    RowBox[{"-", "h15"}]}], "]"}], ",", " ", "q"}], "]"}]}], 
                    ")"}], " ", 
                    RowBox[{"(", 
                    RowBox[{"0.5", "/", "h15"}], ")"}]}], " ", "-", "\n", 
                    "            ", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"conn15", "[", 
                    RowBox[{
                    RowBox[{"shift", "[", 
                    RowBox[{"x", ",", " ", "q", ",", " ", "h15"}], "]"}], ",",
                     " ", "p"}], "]"}], " ", "-", " ", 
                    RowBox[{"conn15", "[", 
                    RowBox[{
                    RowBox[{"shift", "[", 
                    RowBox[{"x", ",", " ", "q", ",", " ", 
                    RowBox[{"-", "h15"}]}], "]"}], ",", " ", "p"}], "]"}]}], 
                    ")"}], " ", 
                    RowBox[{"(", 
                    RowBox[{"0.5", "/", "h15"}], ")"}]}], " ", "+", " ", 
                    RowBox[{"comm", "[", 
                    RowBox[{
                    RowBox[{"gp", "[", 
                    RowBox[{"[", 
                    RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}], ",", " ", 
                    RowBox[{"gp", "[", 
                    RowBox[{"[", 
                    RowBox[{"q", " ", "+", " ", "1"}], "]"}], "]"}]}], 
                    "]"}]}], "]"}]}], "]"}]}]}], "]"}]}], ",", "\n", 
               "       ", 
               RowBox[{"{", 
                RowBox[{"q", ",", " ", "0", ",", " ", "3"}], "}"}]}], 
              "]"}]}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}]}], 
      "]"}], ",", " ", 
     RowBox[{"{", "20", "}"}]}], "]"}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"uniqueness", ":", " ", 
     RowBox[{
      RowBox[{"the", " ", "real"}], "-", 
      RowBox[{"linear", " ", "map", " ", "u"}]}]}], " ", "->", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{"sgen", 
         RowBox[{"(", "u", ")"}]}], ",", " ", 
        RowBox[{"gamma", "^", "q"}]}], "]"}], ")"}], "_q", " ", "has", " ", 
     "the", " ", "rank", " ", "6", " ", "on", " ", "the", " ", "six", " ", 
     "generators"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"cols15", " ", "=", " ", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{"gen", ",", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Flatten", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Re", "[", "#", "]"}], ",", " ", 
               RowBox[{"Im", "[", "#", "]"}]}], "}"}], " ", "&"}], " ", "/@", 
            " ", 
            RowBox[{"Flatten", "[", 
             RowBox[{"comm", "[", 
              RowBox[{"gen", ",", " ", 
               RowBox[{"t2gamma", "[", "q", "]"}]}], "]"}], "]"}]}], "]"}], ",",
           " ", 
          RowBox[{"{", 
           RowBox[{"q", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}], 
        "]"}]}], "]"}], ",", " ", 
     RowBox[{"Join", "[", 
      RowBox[{"sj", ",", " ", "sk"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gram15", " ", "=", " ", 
   RowBox[{"N", "[", 
    RowBox[{"cols15", " ", ".", " ", 
     RowBox[{"Transpose", "[", "cols15", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gev15", " ", "=", " ", 
   RowBox[{"First", "[", 
    RowBox[{"t2eigh", "[", "gram15", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"SL31Check", "[", 
  RowBox[{"\"\<GS-15\>\"", ",", 
   " ", "\"\<the Lorentz connection is fixed by the frame: for an x-dependent \
Lorentz transformation the connection -(d_p Sspin) Sspin^-1 has the form \
sgen(u), the Dirac matrices of the transformed frame are covariantly constant \
and the curvature vanishes (20 random points; tolerance 1e-6); the 24 \
commutators [sgen(J^j), gamma^q], [sgen(K^j), gamma^q] have the rank 6 \
(smallest Gram eigenvalue > 1e-6)\>\"", ",", "\n", "  ", 
   RowBox[{
    RowBox[{"dev15form", " ", "<", " ", "1*^-6"}], " ", "&&", " ", 
    RowBox[{"dev15const", " ", "<", " ", "1*^-6"}], " ", "&&", " ", 
    RowBox[{"dev15curv", " ", "<", " ", "1*^-6"}], " ", "&&", " ", 
    RowBox[{
     RowBox[{"gev15", "[", 
      RowBox[{"[", "1", "]"}], "]"}], " ", ">", " ", "1*^-6"}]}], ",", "\n", 
   "  ", 
   RowBox[{"Row", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<largest deviations \>\"", ",", " ", "dev15form", ",", 
      " ", "\"\<, \>\"", ",", " ", "dev15const", ",", " ", "\"\<, \>\"", ",", 
      " ", "dev15curv", ",", " ", "\"\<; smallest Gram eigenvalue \>\"", ",", 
      " ", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{"gev15", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"5", ",", " ", "3"}], "}"}]}], "]"}], ",", 
      " ", "\"\< (original: 1.0e-9, 3.6e-8, 8.0e-9; 8.000)\>\""}], "}"}], 
    "]"}]}], "]"}]}], "Input",ExpressionUUID->"f14de099-2efb-4efb-9d3f-\
3eccbbbad341"],

Cell["GS-16: the lattice operator on plane waves", "Subsection",ExpressionUUID->"9c377397-835e-4491-bd0a-d83e67645de3"],

Cell[TextData[{
 "On a periodic chain of 24 sites along ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "1"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a9caac35-6f64-4a8d-a668-43d829f5be48"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[ScriptL]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["x",
      FontSlant->"Plain"]], "\[LongEqual]", "0.5"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cd704e68-b58b-4657-81d2-8556c3750062"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0.4"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "48e544a1-2b33-4686-81fb-f41a4d78b8b5"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Mu]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b802596f-e087-4fd8-baf3-c31afa421abc"],
 ", no gauge fields, no pairing) the lattice operator ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalH]",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["lat",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "61951849-c9fa-48cd-862b-4b17093576dc"],
 " of the solvers maps a plane wave, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["exp",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["i", "TI"], 
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "1"], 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "1"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b9f8f474-20c8-483b-a631-25d0125b04c7"],
 " times one of the 16 unit vectors of a site, to a plane wave of the same \
momentum, and the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"16", "\[Times]", "16"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "91a509b2-4033-44ca-8a28-87b3e1824a9a"],
 " matrix of these images has the eigenvalues ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SubsuperscriptBox["\[CurlyEpsilon]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["lat",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c0a3ddd6-4aa9-44a1-a52b-ea84538d8db0"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", 
    SubsuperscriptBox["\[CurlyEpsilon]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["lat",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9abef8c0-7dac-4486-a7b0-88b281be3c49"],
 ", each eight times, at all 24 allowed momenta ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], "\[LongEqual]", "2", "\[Pi]", "\[Kappa]", "/", 
    RowBox[{"(", 
     RowBox[{"24", 
      SubsuperscriptBox["\[ScriptL]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["x",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7e1089c1-4c63-4f84-aad4-8b0131d130c9"],
 " (integers ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Kappa]", "\[LongEqual]", 
    RowBox[{"-", "11"}], ",", "\[Ellipsis]", ",", "12"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7e999253-b6e8-4100-9fff-62205cbe8b8e"],
 "), for the Wilson coefficients ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["W",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4fe2895b-4444-4c1e-8df1-845f752ec6ec"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["W",
      FontSlant->"Plain"]], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4468c4df-8ebb-41e5-911b-af71daf420a7"],
 ". The energy of a free particle on the lattice is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CurlyEpsilon]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["lat",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["q", "TI"], "\[RightVector]"], 
      StyleBox["LL",
       FontSlant->"Plain"]], ")"}], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       UnderscriptBox["\[Sum]", 
        StyleBox["j", "TI"],
        LimitsPositioning->True], "\[ThinSpace]", 
       SuperscriptBox[
        StyleBox["sin",
         FontSlant->"Plain"], "2"], 
       RowBox[{"(", 
        RowBox[{
         SubsuperscriptBox[
          StyleBox["q", "TI"], 
          StyleBox["LL",
           FontSlant->"Plain"], 
          StyleBox["j", "TI"]], 
         SubsuperscriptBox["\[ScriptL]", 
          StyleBox["LL",
           FontSlant->"Plain"], 
          StyleBox["x",
           FontSlant->"Plain"]]}], ")"}], "/", 
       SuperscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox["\[ScriptL]", 
          StyleBox["LL",
           FontSlant->"Plain"], 
          StyleBox["x",
           FontSlant->"Plain"]], ")"}], "2"], "+", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubscriptBox[
           StyleBox["m", "TI"], 
           StyleBox["LL",
            FontSlant->"Plain"]], "+", 
          RowBox[{"(", 
           RowBox[{
            SubsuperscriptBox[
             StyleBox["r", "TI"], 
             StyleBox["LL",
              FontSlant->"Plain"], 
             StyleBox["W",
              FontSlant->"Plain"]], "/", 
            SubsuperscriptBox["\[ScriptL]", 
             StyleBox["LL",
              FontSlant->"Plain"], 
             StyleBox["x",
              FontSlant->"Plain"]]}], ")"}], "\[ThinSpace]", 
          UnderscriptBox["\[Sum]", 
           StyleBox["j", "TI"],
           LimitsPositioning->True], 
          RowBox[{"(", 
           RowBox[{"1", "-", 
            StyleBox["cos",
             FontSlant->"Plain"], 
            RowBox[{"(", 
             RowBox[{
              SubsuperscriptBox[
               StyleBox["q", "TI"], 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["j", "TI"]], 
              SubsuperscriptBox["\[ScriptL]", 
               StyleBox["LL",
                FontSlant->"Plain"], 
               StyleBox["x",
                FontSlant->"Plain"]]}], ")"}]}], ")"}]}], ")"}], "2"]}], 
      ")"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "35028901-d876-49a3-a4cb-3ad7b08a3965"],
 ", the sums running over the directions with more than one site. At ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], 
    SubsuperscriptBox["\[ScriptL]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["x",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"\[PlusMinus]", "\[Pi]"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0b1b524c-d1b7-4dfe-8b53-eaa6a11a19b6"],
 " the sine vanishes again: without the Wilson term (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["W",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3e49d91e-5cd7-4321-a076-b3cd77f9da19"],
 ") the energy returns to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "226fa2ab-8e71-4ec9-b9a4-a07e57aa9774"],
 " there (a second, spurious particle, the doubler); with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["W",
      FontSlant->"Plain"]], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6dad8820-b9e5-434d-911d-074fd7ff27d5"],
 " it is lifted to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "+", "2", 
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["W",
      FontSlant->"Plain"]], "/", 
    SubsuperscriptBox["\[ScriptL]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["x",
      FontSlant->"Plain"]], "\[LongEqual]", "4.4"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1ed1adbb-2322-4642-8715-a46480f17640"],
 ". Figure 1 shows these eigenvalues with the formula and with the continuum \
energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CurlyEpsilon]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["q", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], "2"], "+", 
       SubsuperscriptBox[
        StyleBox["m", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], "2"]}], ")"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bcd4676f-d311-4b7c-8c3f-e42c02565cf7"],
 " (the figures stand in the subsection after the data files of the original \
program)."
}], "Text",ExpressionUUID->"cb98957a-8be3-49aa-9cbb-1f2acf756ec9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"mFig", ",", " ", "dxFig", ",", " ", "nFig"}], "}"}], " ", "=", 
    " ", 
    RowBox[{"{", 
     RowBox[{"0.4", ",", " ", "0.5", ",", " ", "24"}], "}"}]}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", "1", ")"}], " ", "the", " ", 
     RowBox[{"curves", ":", " ", 
      RowBox[{
      "the", " ", "continuum", " ", "energy", " ", "and", " ", "eps_lat", " ",
        "for", " ", "r_W"}]}]}], " ", "=", " ", 
    RowBox[{
    "0", " ", "and", " ", "1", " ", "on", " ", "401", " ", "momenta"}]}], " ",
    "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"curves", " ", "=", " ", 
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"q", " ", "=", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "Pi"}], "/", "dxFig"}], " ", "+", " ", 
             RowBox[{"2", " ", 
              RowBox[{"Pi", "/", "dxFig"}], " ", 
              RowBox[{"i", "/", "400."}]}]}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"rw", ",", " ", "q", ",", " ", 
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{"q", "^", "2"}], " ", "+", " ", 
              RowBox[{"mFig", "^", "2"}]}], "]"}], ",", " ", 
            RowBox[{"t2epsLat", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"q", ",", " ", "0.", ",", " ", "0."}], "}"}], ",", " ",
               "dxFig", ",", " ", "mFig", ",", " ", "rw", ",", " ", 
              RowBox[{"{", 
               RowBox[{"True", ",", " ", "False", ",", " ", "False"}], 
               "}"}]}], "]"}]}], "}"}]}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"rw", ",", " ", 
          RowBox[{"{", 
           RowBox[{"0.", ",", " ", "1."}], "}"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", "0", ",", " ", "400"}], "}"}]}], "]"}], ",", 
      " ", "1"}], "]"}]}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"(", "2", ")"}], " ", "the", " ", 
    RowBox[{"points", ":", " ", 
     RowBox[{
     "the", " ", "largest", " ", "eigenvalue", " ", "of", " ", "the", " ", 
      "operator", " ", "on", " ", "the", " ", "plane", " ", "waves", " ", 
      "of", " ", "the", " ", "24", " ", "allowed", " ", "momenta"}]}]}], " ", 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"dispDev", " ", "=", " ", "0."}], ";"}], "\n", 
 RowBox[{
  RowBox[{"points", " ", "=", " ", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"lat1", " ", "=", " ", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<n\>\"", " ", "->", " ", 
               RowBox[{"{", 
                RowBox[{"nFig", ",", " ", "1", ",", " ", "1"}], "}"}]}], ",", 
              " ", 
              RowBox[{"\"\<ell\>\"", " ", "->", " ", "dxFig"}], ",", " ", 
              RowBox[{"\"\<periodic\>\"", " ", "->", " ", 
               RowBox[{"{", 
                RowBox[{"True", ",", " ", "False", ",", " ", "False"}], 
                "}"}]}], ",", " ", 
              RowBox[{"\"\<wilson\>\"", " ", "->", " ", "rw"}], ",", " ", 
              RowBox[{"\"\<mass\>\"", " ", "->", " ", "mFig"}], ",", " ", 
              RowBox[{"\"\<mu\>\"", " ", "->", " ", "0."}]}], "|>"}]}], ",", 
           "\n", "      ", "kk", ",", " ", "q", ",", " ", "w", ",", " ", 
           "out", ",", " ", "m16", ",", " ", "ev", ",", " ", "el"}], "}"}], ",",
          "\n", "     ", 
         RowBox[{
          RowBox[{"kk", " ", "=", " ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"kq", " ", "<=", " ", 
              RowBox[{"nFig", "/", "2"}]}], ",", " ", "kq", ",", " ", 
             RowBox[{"kq", " ", "-", " ", "nFig"}]}], "]"}]}], ";", "\n", 
          "     ", 
          RowBox[{"q", " ", "=", " ", 
           RowBox[{"2", " ", "Pi", " ", 
            RowBox[{"kk", "/", 
             RowBox[{"(", 
              RowBox[{"nFig", " ", "dxFig"}], ")"}]}]}]}], ";", "\n", "     ", 
          RowBox[{"(*", " ", 
           RowBox[{
            RowBox[{"the", " ", "16", " ", "plane", " ", "waves"}], ",", " ", 
            
            RowBox[{"one", " ", "per", " ", "unit", " ", "vector", " ", "b"}],
             ",", " ", 
            RowBox[{
            "as", " ", "the", " ", "columns", " ", "of", " ", "a", " ", 
             "matrix"}]}], " ", "*)"}], "\n", "     ", 
          RowBox[{"w", " ", "=", " ", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"Mod", "[", 
                  RowBox[{
                   RowBox[{"r", " ", "-", " ", "1"}], ",", " ", "16"}], "]"}],
                  " ", "+", " ", "1"}], " ", "==", " ", "b"}], ",", " ", 
               RowBox[{"Exp", "[", 
                RowBox[{"I", " ", "q", " ", "dxFig", " ", 
                 RowBox[{"Quotient", "[", 
                  RowBox[{
                   RowBox[{"r", " ", "-", " ", "1"}], ",", " ", "16"}], 
                  "]"}]}], "]"}], ",", " ", 
               RowBox[{"0.", " ", "I"}]}], "]"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"r", ",", " ", 
               RowBox[{"16", " ", "nFig"}]}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"b", ",", " ", "16"}], "}"}]}], "]"}]}], ";", "\n", 
          "     ", 
          RowBox[{"out", " ", "=", " ", 
           RowBox[{"t2apply", "[", 
            RowBox[{"lat1", ",", " ", 
             RowBox[{"t2trivialFields", "[", "nFig", "]"}], ",", " ", "w"}], 
            "]"}]}], ";", "\n", "     ", 
          RowBox[{"m16", " ", "=", " ", 
           RowBox[{"out", "[", 
            RowBox[{"[", 
             RowBox[{"1", " ", ";;", " ", "16"}], "]"}], "]"}]}], ";", "\n", 
          "     ", 
          RowBox[{"dispDev", " ", "=", " ", 
           RowBox[{"Max", "[", 
            RowBox[{"dispDev", ",", " ", 
             RowBox[{"Max", "[", 
              RowBox[{"Abs", "[", 
               RowBox[{
                RowBox[{"out", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"16", " ", 
                    RowBox[{"(", 
                    RowBox[{"nFig", " ", "-", " ", "1"}], ")"}]}], " ", "+", 
                    " ", "1"}], " ", ";;", " ", 
                   RowBox[{"16", " ", "nFig"}]}], "]"}], "]"}], " ", "-", " ", 
                RowBox[{"m16", " ", 
                 RowBox[{"Exp", "[", 
                  RowBox[{"I", " ", "q", " ", "dxFig", " ", 
                   RowBox[{"(", 
                    RowBox[{"nFig", " ", "-", " ", "1"}], ")"}]}], "]"}]}]}], 
               "]"}], "]"}]}], "]"}]}], ";", "\n", "     ", 
          RowBox[{"ev", " ", "=", " ", 
           RowBox[{"First", "[", 
            RowBox[{"t2eigh", "[", "m16", "]"}], "]"}]}], ";", "\n", "     ", 
          
          RowBox[{"el", " ", "=", " ", 
           RowBox[{"t2epsLat", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"q", ",", " ", "0.", ",", " ", "0."}], "}"}], ",", " ", 
             "dxFig", ",", " ", "mFig", ",", " ", "rw", ",", " ", 
             RowBox[{"{", 
              RowBox[{"True", ",", " ", "False", ",", " ", "False"}], "}"}]}],
             "]"}]}], ";", "\n", "     ", 
          RowBox[{"dispDev", " ", "=", " ", 
           RowBox[{"Max", "[", 
            RowBox[{"dispDev", ",", " ", 
             RowBox[{"Max", "[", 
              RowBox[{"Abs", "[", 
               RowBox[{"ev", " ", "-", " ", 
                RowBox[{"Join", "[", 
                 RowBox[{
                  RowBox[{"ConstantArray", "[", 
                   RowBox[{
                    RowBox[{"-", "el"}], ",", " ", "8"}], "]"}], ",", " ", 
                  RowBox[{"ConstantArray", "[", 
                   RowBox[{"el", ",", " ", "8"}], "]"}]}], "]"}]}], "]"}], 
              "]"}]}], "]"}]}], ";", "\n", "     ", 
          RowBox[{"{", 
           RowBox[{"rw", ",", " ", "q", ",", " ", 
            RowBox[{"ev", "[", 
             RowBox[{"[", "16", "]"}], "]"}]}], "}"}]}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"{", 
        RowBox[{"rw", ",", " ", 
         RowBox[{"{", 
          RowBox[{"0.", ",", " ", "1."}], "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"kq", ",", " ", "0", ",", " ", 
         RowBox[{"nFig", " ", "-", " ", "1"}]}], "}"}]}], "]"}], ",", " ", 
     "1"}], "]"}]}], ";"}], "\n", 
 RowBox[{"SL31Check", "[", 
  RowBox[{"\"\<GS-16\>\"", ",", 
   " ", "\"\<the lattice operator of the solvers on plane waves: on a \
periodic chain of 24 sites (dx = 0.5, m = 0.4) the image of a plane wave is a \
plane wave of the same momentum, and the 16 x 16 matrix of the images has the \
eigenvalues -eps_lat (eightfold) and +eps_lat (eightfold) at all 24 momenta, \
for r_W = 0 and 1 (tolerance 1e-12)\>\"", ",", "\n", "  ", 
   RowBox[{"dispDev", " ", "<", " ", "1*^-12"}], ",", " ", 
   RowBox[{"Row", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<largest deviation \>\"", ",", " ", "dispDev", ",", 
      " ", "\"\< (original: 1.4e-14)\>\""}], "}"}], "]"}]}], "]"}]}], "Input",\
ExpressionUUID->"58d00b56-fcc9-48ee-b7fa-e94d3c0de819"],

Cell["The data files of the original program", "Subsection",ExpressionUUID->"7113fa0a-51a4-482f-aa3c-526d6dd37487"],

Cell[TextData[{
 "The original program t2_fields wrote the numbers of its two figures into \
three data files: t2_dispersion_lattice.csv (the 48 points of Figure 1: for \
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["W",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5facb066-271d-4cf2-9fc1-32a714eedb3c"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["W",
      FontSlant->"Plain"]], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cf95637c-7a61-4085-8046-e623f2a2358e"],
 " and each of the 24 momenta, the largest eigenvalue of the lattice \
operator), t2_dispersion_curves.csv (the 802 points of the curves of Figure \
1: for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["W",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a02cf748-a5e7-4fef-8789-33379a8d4799"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["W",
      FontSlant->"Plain"]], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e9ae2e97-5970-45ae-bc6f-01b14dab6d8e"],
 " and each of 401 momenta, the continuum energy ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CurlyEpsilon]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7861b7bd-86a5-4ce1-a4f0-cef56cff8d38"],
 " and the formula of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CurlyEpsilon]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["lat",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "314ee0c9-04cf-4a89-b3b9-92688a0c97e1"],
 ") and t2_cvode_accuracy.csv (the 41 rows of its integrations of GS-13 by \
CVODE: the output time ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "0"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dd2e5d00-0fe9-4889-b4c8-3e114099d53d"],
 "; the relative deviations ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Delta]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["rel",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cd3235bc-d5f4-46aa-9549-3bfd467d8442"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["tol",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox["10", 
     RowBox[{"-", "8"}]], ",", 
    SuperscriptBox["10", 
     RowBox[{"-", "10"}]], ",", 
    SuperscriptBox["10", 
     RowBox[{"-", "12"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "97fdc02b-1908-4a17-8a41-c8a89c3df372"],
 "; and, for the same three tolerances, the length ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["h", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["CV",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9496cf6a-d47e-4b78-992f-28d124344aab"],
 " and the order ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["q", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["CV",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dc357f19-04bc-4d12-b064-5c360a4da9bb"],
 " of the last internal step of CVODE before the output time, 0 in the first \
row). The first two files print their numbers with 10 decimals, the third \
with 7 significant digits (its times with 4 decimals). The next cell contains \
every number of the three files, copied without change, so that the notebook \
stays complete. The check after it compares the numbers of Figure 1 with the \
lists ",
 StyleBox["points",
  FontFamily->"Source Code Pro"],
 " and ",
 StyleBox["curves",
  FontFamily->"Source Code Pro"],
 " computed above, row by row and column by column; because the files are \
rounded, deviations up to half a unit of the last printed decimal, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"5", "\[Times]", 
    SuperscriptBox["10", 
     RowBox[{"-", "11"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "77d239b6-af1e-4cce-bd35-d31cb4d79570"],
 ", are expected, and larger deviations would mean that the rewritten \
programs compute different numbers. The integrations by CVODE cannot be \
repeated in the Wolfram Language; for them the check confirms that the file \
has the output times of GS-13 and that its numbers show what the original \
check GS-13 states: the deviations are rounding errors in the first row, stay \
below ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "9"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6f02e79e-024f-4f52-a8cb-829add0f20bb"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["tol",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox["10", 
     RowBox[{"-", "12"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b82556ae-2f67-49f4-b6cf-7d8b73146905"],
 ", and their largest values decrease from ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["tol",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox["10", 
     RowBox[{"-", "8"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bb6e34d6-a904-4316-8c3a-9aefb6c85a54"],
 " to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "10"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e521a320-f107-4138-ac8d-eb2858d5c284"],
 " to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "12"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d64d8774-b636-4fff-af25-7a13b81cb005"],
 ". Figure 2 shows them together with the deviations of IDA computed in GS-13."
}], "Text",ExpressionUUID->"f8b46ac8-c48d-444a-a0ab-927d6aa46f28"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"file", " ", "t2_dispersion", 
     RowBox[{"_lattice", ".", "csv"}]}], ",", " ", 
    RowBox[{
     RowBox[{"48", " ", "rows", " ", 
      RowBox[{"{", 
