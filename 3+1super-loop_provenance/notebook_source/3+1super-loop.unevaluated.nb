                    RowBox[{"j", ",", " ", 
                    RowBox[{"q", " ", "+", " ", "1"}], ",", " ", 
                    RowBox[{"p", " ", "+", " ", "1"}]}], "]"}], "]"}], ",", 
                    " ", 
                    RowBox[{"{", 
                    RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", 
                  RowBox[{"Table", "[", 
                   RowBox[{
                    RowBox[{"w1", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"3", " ", "+", " ", "j"}], ",", " ", 
                    RowBox[{"q", " ", "+", " ", "1"}], ",", " ", 
                    RowBox[{"p", " ", "+", " ", "1"}]}], "]"}], "]"}], ",", 
                    " ", 
                    RowBox[{"{", 
                    RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}], "}"}]}], ";",
                "\n", "     ", 
               RowBox[{"dgp", " ", "=", " ", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"Table", "[", 
                   RowBox[{
                    RowBox[{"w1", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", ",", " ", 
                    RowBox[{"p", " ", "+", " ", "1"}], ",", " ", 
                    RowBox[{"q", " ", "+", " ", "1"}]}], "]"}], "]"}], ",", 
                    " ", 
                    RowBox[{"{", 
                    RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", 
                  RowBox[{"Table", "[", 
                   RowBox[{
                    RowBox[{"w1", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"3", " ", "+", " ", "j"}], ",", " ", 
                    RowBox[{"p", " ", "+", " ", "1"}], ",", " ", 
                    RowBox[{"q", " ", "+", " ", "1"}]}], "]"}], "]"}], ",", 
                    " ", 
                    RowBox[{"{", 
                    RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}], "}"}]}], ";",
                "\n", "     ", 
               RowBox[{"rr", " ", "=", " ", 
                RowBox[{
