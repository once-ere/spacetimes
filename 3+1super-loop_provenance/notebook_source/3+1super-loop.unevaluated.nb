                   RowBox[{
                    RowBox[{"q", " ", "+", " ", "1"}], ",", " ", 
                    RowBox[{"p", " ", "+", " ", "1"}]}], "]"}], "]"}], " ", "-",
                  " ", 
                 RowBox[{"f1", "[", 
                  RowBox[{"[", 
                   RowBox[{
                    RowBox[{"p", " ", "+", " ", "1"}], ",", " ", 
                    RowBox[{"q", " ", "+", " ", "1"}]}], "]"}], "]"}]}]}], ";",
                "\n", "     ", 
