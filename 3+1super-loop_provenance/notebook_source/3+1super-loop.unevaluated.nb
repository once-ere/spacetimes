Cell[BoxData[
 RowBox[{"Column", "[", 
  RowBox[{
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{"#", ",", " ", "Bold", ",", " ", "12"}], "]"}], ",", " ", 
         RowBox[{"groupTable", "[", "#", "]"}]}], "}"}], "]"}], " ", "&"}], ",",
      " ", 
     RowBox[{"groups", "[", 
      RowBox[{"[", 
       RowBox[{"4", " ", ";;", " ", "8"}], "]"}], "]"}]}], "]"}], ",", " ", 
   RowBox[{"Spacings", " ", "->", " ", "2"}]}], "]"}]], "Input",ExpressionUUID\
->"e383fce1-5e73-49e1-bef9-f1d066bf84cf"],

Cell[BoxData[
 RowBox[{"Column", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Style", "[", 
     RowBox[{
      RowBox[{"groups", "[", 
       RowBox[{"[", "9", "]"}], "]"}], ",", " ", "Bold", ",", " ", "12"}], 
     "]"}], ",", " ", 
    RowBox[{"groupTable", "[", 
     RowBox[{"groups", "[", 
      RowBox[{"[", "9", "]"}], "]"}], "]"}]}], "}"}], "]"}]], "Input",Expressi\
onUUID->"c0daa19c-abe9-4896-aa20-919528ac547f"],

Cell["I.9 Summary of the tests of Part I", "Section",ExpressionUUID->"1036070f-e4ba-4728-be54-f0e0eaf09494"],

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"#", "[", "\"\<name\>\"", "]"}], ",", " ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"#", "[", "\"\<pass\>\"", "]"}], ",", " ", "\"\<PASS\>\"",
             ",", " ", "\"\<FAIL\>\""}], "]"}], ",", " ", 
          RowBox[{"#", "[", "\"\<statement\>\"", "]"}]}], "}"}], " ", "&"}], ",",
        " ", "SL31`Test`$Results"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"#", ",", " ", "Bold"}], "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<test\>\"", ",", " ", "\"\<result\>\"", ",", 
        " ", "\"\<statement\>\""}], "}"}]}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}]], "Input",Expression\
UUID->"d174e427-6e2d-4a70-9289-86aa20b370c2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\"\<tests\>\"", " ", "->", " ", 
    RowBox[{"Length", "[", "SL31`Test`$Results", "]"}]}], ",", " ", 
   RowBox[{"\"\<passed\>\"", " ", "->", " ", 
    RowBox[{"Count", "[", 
     RowBox[{"SL31`Test`$Results", ",", " ", 
      RowBox[{"r_", " ", "/;", " ", 
       RowBox[{"r", "[", "\"\<pass\>\"", "]"}]}]}], "]"}]}]}], "}"}]], "Input",\
ExpressionUUID->"5816a3a5-2b1c-49f4-8569-21b276a271ca"],

Cell["Part II. The encyclopedia of the programs of Test 2", "Chapter",ExpressionUUID->"d5fe1d20-28a2-4cca-8814-a0c7100f68a4"],

Cell[TextData[{
 "Part II rewrites, in the Wolfram Language, every program of Test 2 of the \
super-loop revision, with every check of the original programs. Test 2 asks \
eleven questions (items [1] to [11]): the field equations of a \
self-interacting spinor field on the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", "+", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "890a247b-ea25-4a1d-b481-71a940e7b22d"],
 " manifold of the super-loop (item [1]), their analysis and analytic \
solutions (item [2]), a solver of the field equations and a plotter of its \
solutions (items [3] to [6], written in Python and in Rust), and the \
construction and the physics of the superfluid boson singlet state, SFBS \
(items [7] to [11]). The original programs are a library and six programs in \
Rust (the library t2core and the programs t2_fields, t2_analytic, t2_solve, \
t2_plot and t2_sfbs) and five programs in Python. Every chapter of Part II \
names the original files that it rewrites, and every check keeps the name \
that it has in the original report (GS-1 to GS-16, AS-1 to AS-10, EX-1 to \
EX-8, SB-1 to SB-17, and the self-tests)."
}], "Text",ExpressionUUID->"7fa32836-0956-4262-b57e-301f178cb7f6"],

Cell[TextData[{
 "Names. The functions of Part II begin with t2 (for Test 2) and keep the \
names of the original functions, written in the style of the Wolfram Language \
(for example the Rust function ",
 StyleBox["model::gamma_ch",
  FontFamily->"Source Code Pro"],
 " is ",
 StyleBox["t2gammaCh",
  FontFamily->"Source Code Pro"],
 "). Indices keep the values of the physics: the space-time index ",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cc0899d4-5eee-40e1-8e4a-291efa586747"],
 " runs over 0, 1, 2, 3, the space index ",
 Cell[BoxData[
  FormBox[
   StyleBox["j", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "88fa7fc0-2ded-4044-b676-b47753ca6eb6"],
 " and the isospin index ",
 Cell[BoxData[
  FormBox["\[Iota]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9f305e27-d148-4770-bcb4-ef2cb2f1221d"],
 " over 1, 2, 3. Wherever a result is shown, it is labelled with the \
registered symbol of Part I."
}], "Text",ExpressionUUID->"1b86c2da-8816-4c25-babb-e316fa3eff52"],

Cell[TextData[{
 "Components of families. A component of a registered family, for example ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], "0"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6604ff4c-661a-43a4-b91f-f249e93a6f3b"],
 " of the family ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d6714cf3-4074-4c02-8aba-40d552f7ca8f"],
 ", is a symbol of its own, made from the box of the family with the index \
replaced by its value (function ",
 StyleBox["SL31Instance",
  FontFamily->"Source Code Pro"],
 " of Part I). It has to exist before a cell in which it is typed is \
evaluated: the front end sends the whole cell to the kernel, which reads all \
of it before it evaluates the first line, and a component box that is not yet \
symbolized is read as an ordinary expression (for example ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], "0"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "aa7bfcf9-fdb2-4275-aa00-afa091762716"],
 " as the power 0 of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "072e696d-ede5-4f35-b5ad-63f777e9fda2"],
 ", which is 1). The builder of the notebook collects every component that is \
typed anywhere in the notebook, and the next cell makes those that Part I has \
not made already; the check T2-SYM verifies that every one of them is read as \
one atomic symbol."
}], "Text",ExpressionUUID->"5adf7fcd-f087-4e3f-9167-79f889e0803d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "the", " ", "components", " ", "typed", " ", "in", " ", "the", " ", 
     "notebook"}], ",", " ", 
    RowBox[{
     RowBox[{"as", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"TeX", " ", "of", " ", "the", " ", "family"}], ",", " ", 
        RowBox[{"index", " ", "->", " ", "value"}], ",", " ", "..."}], 
       "}"}]}], ";", " ", 
     RowBox[{
     "the", " ", "list", " ", "is", " ", "written", " ", "here", " ", "by", "\n",
       "   ", "the", " ", "builder"}]}], ",", " ", 
    RowBox[{
    "which", " ", "collects", " ", "it", " ", "from", " ", "the", " ", 
     "source", " ", "of", " ", "the", " ", "notebook"}]}], " ", "*)"}], "\n", 
  
  RowBox[{
   RowBox[{
    RowBox[{"t2componentSpecs", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<\\\\sigma^{\\\\rm LL}_j\>\"", ",", " ", 
         RowBox[{"\"\<j\>\"", " ", "->", " ", "\"\<1\>\""}]}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"\"\<\\\\sigma^{\\\\rm LL}_j\>\"", ",", " ", 
         RowBox[{"\"\<j\>\"", " ", "->", " ", "\"\<2\>\""}]}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"\"\<\\\\sigma^{\\\\rm LL}_j\>\"", ",", " ", 
         RowBox[{"\"\<j\>\"", " ", "->", " ", "\"\<3\>\""}]}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"\"\<\\\\sigma^{\\\\rm LL}_j\>\"", ",", " ", 
         RowBox[{"\"\<j\>\"", " ", "->", " ", "\"\<0\>\""}]}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"\"\<\\\\gamma^p_{\\\\rm LL}\>\"", ",", " ", 
         RowBox[{"\"\<p\>\"", " ", "->", " ", "\"\<0\>\""}]}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"\"\<\\\\gamma^p_{\\\\rm LL}\>\"", ",", " ", 
         RowBox[{"\"\<p\>\"", " ", "->", " ", "\"\<1\>\""}]}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"\"\<\\\\gamma^p_{\\\\rm LL}\>\"", ",", " ", 
         RowBox[{"\"\<p\>\"", " ", "->", " ", "\"\<2\>\""}]}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"\"\<\\\\gamma^p_{\\\\rm LL}\>\"", ",", " ", 
         RowBox[{"\"\<p\>\"", " ", "->", " ", "\"\<3\>\""}]}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"\"\<\\\\mathsf A_{{\\\\rm LL},p}\>\"", ",", " ", 
         RowBox[{"\"\<p\>\"", " ", "->", " ", "\"\<j\>\""}]}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"\"\<q^j_{\\\\rm LL}\>\"", ",", " ", 
         RowBox[{"\"\<j\>\"", " ", "->", " ", "\"\<1\>\""}]}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"\"\<x^p_{\\\\rm LL}\>\"", ",", " ", 
         RowBox[{"\"\<p\>\"", " ", "->", " ", "\"\<0\>\""}]}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"\"\<\\\\mathsf A^\\\\uparrow_{{\\\\rm LL},p}\>\"", ",", " ", 
         
         RowBox[{"\"\<p\>\"", " ", "->", " ", "\"\<1\>\""}]}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"\"\<\\\\mathsf A^\\\\downarrow_{{\\\\rm LL},p}\>\"", ",", 
         " ", 
         RowBox[{"\"\<p\>\"", " ", "->", " ", "\"\<1\>\""}]}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"\"\<A^\\\\iota_{{\\\\rm LL},p}\>\"", ",", " ", 
         RowBox[{"\"\<\\\\iota\>\"", " ", "->", " ", "\"\<1\>\""}], ",", " ", 
         
         RowBox[{"\"\<p\>\"", " ", "->", " ", "\"\<0\>\""}]}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"\"\<E^\\\\pm_{\\\\rm LL}\>\"", ",", " ", 
         RowBox[{"\"\<\\\\pm\>\"", " ", "->", " ", "\"\<-\>\""}]}], "}"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"\"\<E^\\\\pm_{\\\\rm LL}\>\"", ",", " ", 
         RowBox[{"\"\<\\\\pm\>\"", " ", "->", " ", "\"\<+\>\""}]}], "}"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"\"\<x^p_{\\\\rm LL}\>\"", ",", " ", 
         RowBox[{"\"\<p\>\"", " ", "->", " ", "\"\<1\>\""}]}], "}"}]}], 
      "}"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"their", " ", "boxes"}], ",", " ", 
     RowBox[{
     "made", " ", "exactly", " ", "as", " ", "the", " ", "builder", " ", 
      "made", " ", "the", " ", "boxes", " ", "in", " ", "the", " ", "input", " ",
       "cells"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"t2componentBoxes", " ", "=", " ", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Apply", "[", 
         RowBox[{"SL31`Build`symbolBoxes", ",", " ", "#"}], "]"}], " ", "&"}],
        ",", " ", "t2componentSpecs"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "a", " ", "component", " ", "that", " ", "is", " ", "already", " ", "a", " ",
      "symbol", " ", 
     RowBox[{"(", 
      RowBox[{"made", " ", "in", " ", "Part", " ", "I"}], ")"}], " ", "is", " ",
      "not", " ", "symbolized", " ", "again"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"t2componentNew", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{"t2componentBoxes", ",", " ", 
       RowBox[{
        RowBox[{"!", " ", 
         RowBox[{"MatchQ", "[", 
          RowBox[{
           RowBox[{"SL31SymbolOf", "[", "#", "]"}], ",", " ", 
           RowBox[{"HoldComplete", "[", "_Symbol", "]"}]}], "]"}]}], " ", 
        "&"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Scan", "[", 
     RowBox[{"SL31Symbolize", ",", " ", "t2componentNew"}], "]"}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "like", " ", "the", " ", "symbols", " ", "of", " ", "Part", " ", "I", " ", 
      RowBox[{"(", 
       RowBox[{"section", " ", "I", ".6"}], ")"}]}], ",", " ", 
     RowBox[{
     "every", " ", "component", " ", "prints", " ", "in", " ", 
      "TraditionalForm", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
        "the", " ", "form", " ", "of", " ", "the", " ", "labels", " ", "of", "\n",
          "   ", "graphics"}], ",", " ", 
        RowBox[{
        "from", " ", "which", " ", "TeXForm", " ", "is", " ", "made"}]}], 
       ")"}], " ", "as", " ", "its", " ", "box"}], ",", " ", 
     RowBox[{
      RowBox[{"not", " ", "as", " ", "its", " ", "internal", " ", "name"}], ";",
       " ", 
      RowBox[{
      "a", " ", "component", " ", "without", " ", "a", " ", "usage", "\n", 
       "   ", "message", " ", "receives", " ", "one", " ", "that", " ", 
       "names", " ", "its", " ", "family", " ", "and", " ", "its", " ", 
       "index", " ", "values"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"Scan", "[", 
     RowBox[{
      RowBox[{"Function", "[", 
       RowBox[{"spec", ",", " ", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"b", " ", "=", " ", 
            RowBox[{"Apply", "[", 
             RowBox[{"SL31`Build`symbolBoxes", ",", " ", "spec"}], "]"}]}], 
           "}"}], ",", "\n", "     ", 
          RowBox[{"Replace", "[", 
           RowBox[{
            RowBox[{"SL31SymbolOf", "[", "b", "]"}], ",", " ", 
            RowBox[{
             RowBox[{"HoldComplete", "[", "s_Symbol", "]"}], " ", ":>", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"MakeBoxes", "[", 
                 RowBox[{"s", ",", " ", "TraditionalForm"}], "]"}], " ", "=", 
                " ", "b"}], ";", "\n", "        ", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"!", " ", 
                  RowBox[{"StringQ", "[", 
                   RowBox[{"MessageName", "[", 
                    RowBox[{"s", ",", " ", "\"\<usage\>\""}], "]"}], "]"}]}], 
                 ",", " ", 
                 RowBox[{
                  RowBox[{"MessageName", "[", 
                   RowBox[{"s", ",", " ", "\"\<usage\>\""}], "]"}], " ", "=", 
                  " ", 
                  
                  RowBox[{"\"\<the component \>\"", " ", "<>", "\n", 
                   "           ", 
                   RowBox[{"StringRiffle", "[", 
                    RowBox[{
                    RowBox[{"Map", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], " ", "<>", 
                    " ", "\"\< = \>\"", " ", "<>", " ", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], " ", "&"}], ",", " ", 
                    RowBox[{"Rest", "[", "spec", "]"}]}], "]"}], ",", 
                    " ", "\"\<, \>\""}], "]"}], " ", "<>", 
                   " ", "\"\< of the registered family \>\"", " ", "<>", " ", 
                   
                   RowBox[{"First", "[", "spec", "]"}]}]}]}], "]"}]}], 
              ")"}]}]}], "]"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
      "t2componentSpecs"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"t2componentTeX", " ", "=", " ", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Replace", "[", 
         RowBox[{
          RowBox[{"SL31SymbolOf", "[", "#", "]"}], ",", " ", 
          RowBox[{
           RowBox[{"HoldComplete", "[", "s_", "]"}], " ", ":>", " ", 
           RowBox[{"ToString", "[", 
            RowBox[{"TeXForm", "[", 
             RowBox[{"Unevaluated", "[", "s", "]"}], "]"}], "]"}]}]}], "]"}], 
        " ", "&"}], ",", " ", "t2componentBoxes"}], "]"}]}], ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<T2-SYM\>\"", ",", 
     " ", "\"\<every component of a registered family that is typed in an \
input cell of the notebook (collected from the source by the builder) is read \
as one atomic symbol, and its TeX is written from its printed form, without \
the internal name\>\"", ",", "\n", "  ", 
     RowBox[{
      RowBox[{"AllTrue", "[", 
       RowBox[{"t2componentBoxes", ",", " ", 
        RowBox[{
         RowBox[{"MatchQ", "[", 
          RowBox[{
           RowBox[{"SL31SymbolOf", "[", "#", "]"}], ",", " ", 
           RowBox[{"HoldComplete", "[", "_Symbol", "]"}]}], "]"}], " ", 
         "&"}]}], "]"}], " ", "&&", "\n", "   ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{"t2componentTeX", ",", " ", 
        RowBox[{
         RowBox[{"!", " ", 
          RowBox[{"StringContainsQ", "[", 
           RowBox[{"#", ",", " ", 
            
            RowBox[{"\"\<UnderBracket\>\"", " ", "|", 
             " ", "\"\<\[UnderBracket]\>\""}]}], "]"}]}], " ", "&"}]}], 
       "]"}]}], ",", "\n", "  ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Length", "[", "t2componentBoxes", "]"}], ",", 
        " ", "\"\< components, \>\"", ",", " ", 
        RowBox[{"Length", "[", "t2componentNew", "]"}], ",", 
        " ", "\"\< of them made here; their TeX: \>\"", ",", " ", 
        RowBox[{"StringRiffle", "[", 
         RowBox[{"t2componentTeX", ",", " ", "\"\<, \>\""}], "]"}]}], "}"}], 
      "]"}]}], "]"}]}]}]], "Input",ExpressionUUID->"7194fa7f-11d7-47a8-a5c8-\
217bf5c0ce8a"],

Cell["\<\
Numbers. The original programs compute in double precision with random \
numbers from a generator with a fixed seed. Part II uses the same generator \
with the same seeds, and draws the random numbers in the same order, so that \
every random matrix, field and momentum is the same number as in the original \
program. Exact quantities (the Dirac matrices, the generators) are computed \
exactly; results that depend on rounding (the largest deviation of a check) \
are reported next to the value of the original report.\
\>", "Text",ExpressionUUID->"820b3f47-4c6f-46d7-b979-4ffdb59381a7"],

Cell["\<\
II.1 The core library t2core: random numbers, matrices, the super-loop \
operators, the lattice\
\>", "Section",ExpressionUUID->"eaa4d8b9-9884-4de2-823c-6c5d4a21ca83"],

Cell["II.1.1 Random numbers (t2core/src/rng.rs)", "Subsection",ExpressionUUID->"0e467d25-715f-4af7-b967-0c24cc6464b0"],

Cell[TextData[{
 "The generator SplitMix64 keeps one unsigned 64-bit integer as its state. \
Every call adds the constant 9E3779B97F4A7C15 (hexadecimal) to the state and \
mixes the result with shifts, exclusive-or operations (",
 StyleBox["BitXor",
  FontFamily->"Source Code Pro"],
 ") and multiplications; all arithmetic is modulo ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", "64"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "92c4faac-ffad-45f1-bb12-7f3bfc593087"],
 ", as in Rust. A uniform number in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"-", "1"}], ",", "1", ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "259cf2a5-e0fa-41f3-b1fa-ed51f7c60ab9"],
 " is made from the upper 53 bits. The conversion is exact in both languages, \
so the Wolfram Language reproduces every random number of the original \
programs bit for bit. The test compares the first three integers and the \
first four uniform numbers for the seed 2026111707 (the seed of the program \
t2_fields) with the values of the same algorithm computed independently in \
Python 3."
}], "Text",ExpressionUUID->"8e60fb52-2944-418a-87f3-3783266f17d9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", "state", " ", "of", " ", "the", " ", "generator"}], ";",
     " ", 
    RowBox[{
     RowBox[{"t2Seed", "[", "s", "]"}], " ", "starts", " ", "a", " ", "new", " ",
      "sequence"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"t2Seed", "[", "s_Integer", "]"}], " ", ":=", " ", 
     RowBox[{"(", 
      RowBox[{"t2rngState", " ", "=", " ", 
       RowBox[{"Mod", "[", 
        RowBox[{"s", ",", " ", 
         RowBox[{"2", "^", "64"}]}], "]"}]}], ")"}]}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{" ", 
     RowBox[{"one", " ", "step", " ", "of", " ", 
      RowBox[{"SplitMix64", ":", " ", 
       RowBox[{"returns", " ", "an", " ", "integer", " ", 
        RowBox[{"in", " ", "[", 
         RowBox[{"0", ",", " ", 
          RowBox[{"2", "^", "64"}]}]}]}]}]}], ")"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
