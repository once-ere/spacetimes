      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", 
         RowBox[{"-", "I"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"I", ",", " ", "0"}], "}"}]}], "}"}]}], ";", " ", 
    RowBox[{
     RowBox[{"t2sigma", "[", "3", "]"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", 
         RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"t2eps2", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "0"}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"M_LL", 
        RowBox[{"(", "b", ")"}], " ", "of", " ", "the", " ", "bi"}], "-", 
       RowBox[{"quaternion", " ", "b"}]}], " ", "=", " ", 
      RowBox[{"sum_p", " ", "xi_p", " ", "e_p"}]}], ",", " ", 
     RowBox[{"xi", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"xi_", "0"}], ",", " ", 
        RowBox[{"xi_", "1"}], ",", " ", 
        RowBox[{"xi_", "2"}], ",", " ", 
        RowBox[{"xi_", "3"}]}], "}"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2mq", "[", "xi_List", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"xi", "[", 
        RowBox[{"[", "1", "]"}], "]"}], " ", 
       RowBox[{"t2sigma", "[", "0", "]"}]}], " ", "-", " ", 
      RowBox[{"I", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"xi", "[", 
           RowBox[{"[", "2", "]"}], "]"}], " ", 
          RowBox[{"t2sigma", "[", "1", "]"}]}], " ", "+", " ", 
         RowBox[{
          RowBox[{"xi", "[", 
           RowBox[{"[", "3", "]"}], "]"}], " ", 
          RowBox[{"t2sigma", "[", "2", "]"}]}], " ", "+", " ", 
         RowBox[{
          RowBox[{"xi", "[", 
           RowBox[{"[", "4", "]"}], "]"}], " ", 
          RowBox[{"t2sigma", "[", "3", "]"}]}]}], ")"}]}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"the", " ", "conjugate", " ", "bi"}], "-", 
      RowBox[{"quaternion", ":", " ", 
       RowBox[{
       "the", " ", "signs", " ", "of", " ", "the", " ", "coefficients", " ", 
