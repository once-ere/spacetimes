       SubsuperscriptBox[
        OverscriptBox["d", "\[RightVector]"], "LL", "tr"], ",", "\n", "  ", 
       SubsuperscriptBox["H", "LL", "vac"], ",", " ", 
       TagBox[
        RowBox[{"U", 
         SubsuperscriptBox[
          RowBox[{"(", "1", ")"}], "LL", "Q"]}],
        "SL31Name",
        SyntaxForm->"symbol"], ",", " ", 
       TagBox[
        RowBox[{"S", "O", "(", "3", ")"}],
        "SL31Name",
        SyntaxForm->"symbol"], ",", " ", 
       TagBox[
        RowBox[{"O", "(", "2", ")"}],
        "SL31Name",
        SyntaxForm->"symbol"], ",", " ", 
       SubsuperscriptBox["\[CurlyTheta]", 
        RowBox[{"LL", ",", "0"}], "G"], ",", " ", 
       SubsuperscriptBox["\[CurlyTheta]", 
        RowBox[{"LL", ",", "1"}], "G"], ",", "\n", "  ", 
       SubsuperscriptBox["\[CurlyTheta]", 
        RowBox[{"LL", ",", "2"}], "G"], ",", " ", 
       SubsuperscriptBox["\[CurlyTheta]", "LL", "G"], ",", " ", 
       SubsuperscriptBox["\[CurlyPhi]", "LL", "G"], ",", " ", 
       SubsuperscriptBox[
        TagBox[
         StyleBox["U",
          FontFamily->"Helvetica",
          FontSlant->"Plain"],
         "SL31SansSerif"], "LL", "G"], ",", " ", 
       SubsuperscriptBox["h", "LL", "a"], ",", " ", 
       SubsuperscriptBox["c", 
        RowBox[{"LL", ",", "1"}], "n"], ",", "\n", "  ", 
       SubsuperscriptBox["c", 
        RowBox[{"LL", ",", "2"}], "n"], ",", " ", 
       SubsuperscriptBox["\[CurlyRho]", "LL", "n"], ",", " ", 
       SubsuperscriptBox["\[CapitalOmega]", "LL", "H"], ",", " ", 
       SubsuperscriptBox["\[Lambda]", "LL", "H"], ",", " ", 
       SubsuperscriptBox["\[ScriptCapitalL]", "LL", "kin"], ",", " ", 
       SubsuperscriptBox[
        TagBox[
         StyleBox["N",
          FontFamily->"Helvetica",
          FontSlant->"Plain"],
         "SL31SansSerif"], "LL", "g"], ",", "\n", "  ", 
       SubsuperscriptBox[
        TagBox[
         StyleBox["N",
          FontFamily->"Helvetica",
          FontSlant->"Plain"],
         "SL31SansSerif"], "LL", "v"], ",", " ", 
       SubsuperscriptBox[
        OverscriptBox["w", "\[RightVector]"], "LL", "n"], ",", " ", 
       SubsuperscriptBox["E", "LL", "c"], ",", " ", 
       SubsuperscriptBox[
        OverscriptBox["a", "\[RightVector]"], "LL", "F"], ",", " ", 
       SubsuperscriptBox[
        OverscriptBox["u", "\[RightVector]"], "LL", "f"], ",", " ", 
       SubsuperscriptBox[
        OverscriptBox["u", "\[RightVector]"], "LL", 
        RowBox[{"f", "\[Prime]"}]], ",", "\n", "  ", 
       SubsuperscriptBox["\[Delta]", "LL", "f"], ",", " ", 
       SubsuperscriptBox[
        TagBox[
         StyleBox["H",
          FontFamily->"Helvetica",
          FontSlant->"Plain"],
         "SL31SansSerif"], "LL", "f"], ",", " ", 
       SubsuperscriptBox[
        TagBox[
         StyleBox["H",
          FontFamily->"Helvetica",
          FontSlant->"Plain"],
         "SL31SansSerif"], "LL", 
        RowBox[{"f", "\[Prime]"}]], ",", " ", 
       SubsuperscriptBox["\[Chi]", "LL", "f"], ",", " ", 
       SubsuperscriptBox["\[CapitalGamma]", "LL", "f"], ",", " ", 
       SubsuperscriptBox["\[CapitalGamma]", "LL", "G"], ",", "\n", "  ", 
       SubsuperscriptBox["\[CapitalGamma]", "LL", "m"], ",", " ", 
       SubscriptBox["\[CapitalUpsilon]", "LL"], ",", " ", 
       SubsuperscriptBox["\[CapitalUpsilon]", "LL", 
        RowBox[{"(", "1", ")"}]], ",", " ", 
       SubsuperscriptBox["c", "LL", "w"], ",", " ", 
       SubsuperscriptBox[
        OverscriptBox["d", "\[RightVector]"], "LL", "u"], ",", " ", 
       SubsuperscriptBox["V", 
        RowBox[{"LL", ",", "p"}], "F"], ",", "\n", "  ", 
       SubsuperscriptBox["V", 
        RowBox[{"LL", ",", "p"}], "\[Iota]"], ",", " ", 
       SubsuperscriptBox["W", 
        RowBox[{"LL", ",", "p"}], "\[PlusMinus]"], ",", " ", 
       SubsuperscriptBox[
        TagBox[
         StyleBox["M",
          FontFamily->"Helvetica",
          FontSlant->"Plain"],
         "SL31SansSerif"], "LL", "t"], ",", " ", 
       SubsuperscriptBox[
        TagBox[
         StyleBox["M",
          FontFamily->"Helvetica",
          FontSlant->"Plain"],
         "SL31SansSerif"], "LL", "s"], ",", " ", 
       SubsuperscriptBox["M", "LL", "W"], ",", " ", 
       SubsuperscriptBox["M", "LL", "F"], ",", "\n", "  ", 
       SubsuperscriptBox["\[Theta]", "LL", "mix"], ",", " ", 
       SubsuperscriptBox["\[ScriptCapitalL]", "LL", 
        RowBox[{"(", "2", ")"}]]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"SL31Check", "[", 
     RowBox[{"\"\<S-14\>\"", ",", 
      " ", "\"\<every symbol typed in its printed form is read as one atomic \
symbol, the one created from its registry TeX\>\"", ",", "\n", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "typed", "]"}], " ", "==", " ", 
        RowBox[{"Length", "[", "symbolTable", "]"}]}], " ", "&&", " ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{"typed", ",", " ", "AtomQ"}], "]"}], " ", "&&", " ", 
       RowBox[{"typed", " ", "===", " ", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"ReleaseHold", "[", 
            RowBox[{"#", "[", "\"\<symbol\>\"", "]"}], "]"}], " ", "&"}], ",",
           " ", "symbolTable"}], "]"}]}]}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Length", "[", "typed", "]"}], ",", " ", 
        RowBox[{"Count", "[", 
         RowBox[{"typed", ",", " ", 
          RowBox[{"_", "?", "AtomQ"}]}], "]"}], ",", " ", 
        RowBox[{"Length", "[", "symbolTable", "]"}]}], "}"}]}], "]"}], 
    ";"}]}]}]], "Input",ExpressionUUID->"685bc5c2-eb83-4ba9-ac59-\
a8955d616877"],

Cell["\<\
S-3, uniqueness: different printed forms give different symbols. If two \
different boxes had received the same name, two printed symbols would have \
become one Wolfram symbol. The test compares the number of different boxes \
with the number of different symbols, and also checks the comparison that the \
Notation package itself makes: it removes style boxes (StyleBox, \
AdjustmentBox, FrameBox) before it compares input with a symbolized box, so \
the boxes must still be different after this removal. (TeX items with the \
same boxes, listed in section I.6, are one symbol by construction.)\
\>", "Text",ExpressionUUID->"2d897c92-2a63-41f6-bcfe-a96262fccfe3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"strip", "[", "b_", "]"}], " ", ":=", " ", 
   RowBox[{"b", " ", "//.", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"StyleBox", "[", 
        RowBox[{"x_", ",", " ", "___"}], "]"}], " ", ":>", " ", "x"}], ",", 
      " ", 
      RowBox[{
       RowBox[{"AdjustmentBox", "[", 
        RowBox[{"x_", ",", " ", "___"}], "]"}], " ", ":>", " ", "x"}], ",", 
      " ", 
      RowBox[{
       RowBox[{"FrameBox", "[", 
        RowBox[{"x_", ",", " ", "___"}], "]"}], " ", ":>", " ", "x"}]}], 
     "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"syms", " ", "=", " ", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"#", "[", "\"\<symbol\>\"", "]"}], " ", "&"}], ",", " ", 
     "symbolTable"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-3\>\"", ",", 
    " ", "\"\<different boxes give different symbols, and the boxes stay \
different after the removal of style boxes\>\"", ",", "\n", "  ", 
    RowBox[{
     RowBox[{"Length", "[", 
      RowBox[{"DeleteDuplicates", "[", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", "\"\<boxes\>\"", "]"}], " ", "&"}], ",", " ", 
         "symbolTable"}], "]"}], "]"}], "]"}], " ", "==", " ", 
     RowBox[{"Length", "[", 
      RowBox[{"DeleteDuplicates", "[", "syms", "]"}], "]"}], " ", "==", "\n", 
     "   ", 
     RowBox[{"Length", "[", 
      RowBox[{"DeleteDuplicates", "[", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"strip", "[", 
           RowBox[{"#", "[", "\"\<boxes\>\"", "]"}], "]"}], " ", "&"}], ",", 
         " ", "symbolTable"}], "]"}], "]"}], "]"}], " ", "==", " ", 
     RowBox[{"Length", "[", "symbolTable", "]"}]}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Length", "[", "symbolTable", "]"}], ",", " ", 
      RowBox[{"Length", "[", 
       RowBox[{"DeleteDuplicates", "[", "syms", "]"}], "]"}], ",", " ", 
      RowBox[{"Length", "[", 
       RowBox[{"DeleteDuplicates", "[", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"strip", "[", 
            RowBox[{"#", "[", "\"\<boxes\>\"", "]"}], "]"}], " ", "&"}], ",", 
          " ", "symbolTable"}], "]"}], "]"}], "]"}]}], "}"}]}], "]"}], 
  ";"}]}], "Input",ExpressionUUID->"ac394530-ff82-4be5-aa25-4b2d815edaa7"],

Cell[TextData[{
 "S-4, the round trip: a symbol, printed again, gives exactly the box it was \
made from (",
 StyleBox["ToBoxes[symbol, StandardForm]",
  FontFamily->"Source Code Pro"],
 "). This is the other half of the symbolization: input box to symbol (S-2) \
and symbol to output box (S-4)."
}], "Text",ExpressionUUID->"aece1686-daa9-4f9c-a10e-9fe6439afe07"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"roundTrip", " ", "=", " ", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{"r", ",", " ", 
       RowBox[{"Replace", "[", 
        RowBox[{
         RowBox[{"r", "[", "\"\<symbol\>\"", "]"}], ",", " ", 
         RowBox[{
          RowBox[{"HoldComplete", "[", "s_", "]"}], " ", ":>", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"ToBoxes", "[", 
             RowBox[{
              RowBox[{"Unevaluated", "[", "s", "]"}], ",", " ", 
              "StandardForm"}], "]"}], " ", "===", " ", 
            RowBox[{"r", "[", "\"\<boxes\>\"", "]"}]}], ")"}]}]}], "]"}]}], 
      "]"}], ",", " ", "symbolTable"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-4\>\"", ",", 
    " ", "\"\<every symbol prints as the box it was made from\>\"", ",", " ", 
    
    RowBox[{"And", " ", "@@", " ", "roundTrip"}], ",", " ", 
    RowBox[{"Count", "[", 
     RowBox[{"roundTrip", ",", " ", "True"}], "]"}]}], "]"}], ";"}]}], "Input",\
ExpressionUUID->"21e8a4fe-d35e-4009-9a96-d4092f26d7f2"],

Cell[TextData[{
 "S-5, TeX: with its ",
 StyleBox["TraditionalForm",
  FontFamily->"Source Code Pro"],
 " rule, every symbol is written in TeX from its displayed boxes; the \
internal name, with its separator character, does not appear."
}], "Text",ExpressionUUID->"971a233c-21e9-4186-946c-e9c24c7f9db3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"texOut", " ", "=", " ", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{"r", ",", " ", 
       RowBox[{"Replace", "[", 
        RowBox[{
         RowBox[{"r", "[", "\"\<symbol\>\"", "]"}], ",", " ", 
         RowBox[{
          RowBox[{"HoldComplete", "[", "s_", "]"}], " ", ":>", " ", 
          RowBox[{"ToString", "[", 
           RowBox[{"TeXForm", "[", 
            RowBox[{"Unevaluated", "[", "s", "]"}], "]"}], "]"}]}]}], "]"}]}],
       "]"}], ",", " ", "symbolTable"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-5\>\"", ",", 
    " ", "\"\<the TeX of every symbol is written from its printed form, \
without the internal name\>\"", ",", "\n", "  ", 
    RowBox[{"AllTrue", "[", 
     RowBox[{"texOut", ",", " ", 
      RowBox[{
       RowBox[{"!", " ", 
        RowBox[{"StringContainsQ", "[", 
         RowBox[{"#", ",", " ", 
          
          RowBox[{"\"\<UnderBracket\>\"", " ", "|", 
           " ", "\"\<\[UnderBracket]\>\""}]}], "]"}]}], " ", "&"}]}], "]"}], ",",
     " ", 
    RowBox[{"Count", "[", 
     RowBox[{"texOut", ",", " ", 
      RowBox[{"x_", " ", "/;", " ", 
       RowBox[{"!", " ", 
        RowBox[{"StringContainsQ", "[", 
         RowBox[{"x", ",", " ", "\"\<UnderBracket\>\""}], "]"}]}]}]}], 
     "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{"TableForm", "[", 
  RowBox[{
   RowBox[{"Take", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", "\"\<tex\>\"", "]"}], " ", "&"}], ",", " ", 
          "symbolTable"}], "]"}], ",", " ", "texOut"}], "}"}], "]"}], ",", 
     " ", "8"}], "]"}], ",", " ", 
   RowBox[{"TableHeadings", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"None", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<registry TeX\>\"", ",", 
        " ", "\"\<TeXForm of the symbol\>\""}], "}"}]}], "}"}]}]}], 
  "]"}]}], "Input",ExpressionUUID->"abab106e-a598-4d93-acf3-e11a30a4405f"],

Cell[TextData[{
 "S-6, arithmetic with symbols and values: the coupling ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubscriptBox[
     StyleBox["G", "TI"], "LL"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"41a7be9f-51e6-462d-821f-734dfc4621a9"]], "InlineFormula",
  ExpressionUUID->"934eacdb-22b0-4c95-98bd-60edb684a3e1"],
 ", the mass ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubscriptBox[
     StyleBox["m", "TI"], "LL"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"8087bdb7-1c9d-4031-810e-56ad40ba093b"]], "InlineFormula",
  ExpressionUUID->"1bc25c57-f9f5-4370-8e94-ef2229c3f9de"],
 " and the cutoff ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubscriptBox["\[CapitalLambda]", "LL"], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"13f782a7-430f-4d44-850c-d064c7503d3d"]], 
  "InlineFormula",ExpressionUUID->"6e070c98-02c7-4f8d-9f25-29c58055d83a"],
 " of the spinor charges receive the values used throughout Test 2 (",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["m", "TI"], "LL"], "\[LongEqual]", "0.2"}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"8662e450-5c4b-4015-ac5d-07f8826bb764"]], 
  "InlineFormula",ExpressionUUID->"86a8f877-d9da-4d4c-bd55-0651769df7f6"],
 ", ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox["\[CapitalLambda]", "LL"], "\[LongEqual]", "1"}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "93218e7e-b730-48d6-bc20-d4ec35fee62b"]], "InlineFormula",ExpressionUUID->
  "62caf25b-3d00-416b-9ae9-690eebc67f26"],
 ", ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["G", "TI"], "LL"], "\[LongEqual]", "22.5"}], TraditionalForm]],
    "InlineFormula",ExpressionUUID->"aa9926b8-93a8-414a-b85c-9c62078c4033"]], 
  "InlineFormula",ExpressionUUID->"58c25be3-3894-4e6c-9db4-fb67cea5ac64"],
 ", units in which the cutoff is 1). The gap of the condensed vacuum at zero \
chemical potential solves the gap equation ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{"1", "/", 
     SubscriptBox[
      StyleBox["G", "TI"], "LL"], "\[LongEqual]", 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[CapitalLambda]", "LL"], 
       SubscriptBox[
        StyleBox["E", "TI"], "\[CapitalLambda]"], "-", 
       SuperscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox[
          StyleBox["M", "TI"], "LL", "q"], ")"}], "2"], " ", "arsinh", 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["\[CapitalLambda]", "LL"], "/", 
         SubsuperscriptBox[
          StyleBox["M", "TI"], "LL", "q"]}], ")"}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"2", 
       SuperscriptBox["\[Pi]", "2"]}], ")"}]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"1dbc3ea5-ac7d-46d6-80b3-a65fa1870722"]], 
  "InlineFormula",ExpressionUUID->"84084186-8912-4ef1-8d11-9d46c0d998cd"],
 " with ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["M", "TI"], "LL", "q"], ")"}], "2"], "\[LongEqual]", 
     SubsuperscriptBox[
      StyleBox["m", "TI"], "LL", "2"], "+", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], ")"}], "2"]}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "8a71f23b-dd45-4975-bdb0-c2f8d2cb92a2"]], "InlineFormula",ExpressionUUID->
  "f479c56f-4015-4b67-9406-3db858e6bbf1"],
 " and ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["E", "TI"], "\[CapitalLambda]"], "\[LongEqual]", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox["\[CapitalLambda]", "LL", "2"], "+", 
        SuperscriptBox[
         RowBox[{"(", 
          SubsuperscriptBox[
           StyleBox["M", "TI"], "LL", "q"], ")"}], "2"]}], ")"}], 
      RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"0c36c08f-5e89-4205-babd-2deea617eb35"]], "InlineFormula",
  ExpressionUUID->"4ff8fe8a-736e-4778-8822-5f96c18a776b"],
 ". The cell writes this equation with the symbolized symbols, gives them \
values only inside ",
 StyleBox["Block",
  FontFamily->"Source Code Pro"],
 " (so that they stay free symbols outside), solves for the gap with ",
 StyleBox["FindRoot",
  FontFamily->"Source Code Pro"],
 ", and compares with the value 0.2094933033 found by the Rust program of \
Test 2. It also checks the derived masses ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{"2", 
     SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"a84fe050-6913-46e1-b9f5-f3681cafcf01"]], 
  "InlineFormula",ExpressionUUID->"65870dcf-885e-4622-810e-df75554177be"],
 " and ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{"2", 
     SubsuperscriptBox[
      StyleBox["M", "TI"], "LL", "q"]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"894df14e-549e-4289-b90c-205f3b00be12"]], "InlineFormula",
  ExpressionUUID->"9be1e964-b274-40fa-be08-3d7151f92bf4"],
 "."
}], "Text",ExpressionUUID->"97a61426-baac-4a56-a543-193523b9bd07"],

Cell[BoxData[
 RowBox[{"gapEquation", " ", "=", " ", 
  RowBox[{
   RowBox[{"1", "/", 
    SubscriptBox["G", "LL"]}], " ", "==", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[CapitalLambda]", "LL"], " ", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{
          SubscriptBox["\[CapitalLambda]", "LL"], "^", "2"}], " ", "+", " ", 
         RowBox[{
          SubscriptBox["m", "LL"], "^", "2"}], " ", "+", " ", 
         RowBox[{
          SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], "^", "2"}]}], 
        "]"}]}], " ", "-", "\n", "     ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SubscriptBox["m", "LL"], "^", "2"}], " ", "+", " ", 
         RowBox[{
          SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], "^", "2"}]}], 
        ")"}], " ", 
       RowBox[{"ArcSinh", "[", 
        RowBox[{
         SubscriptBox["\[CapitalLambda]", "LL"], "/", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{
            SubscriptBox["m", "LL"], "^", "2"}], " ", "+", " ", 
           RowBox[{
            SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], "^", "2"}]}], 
          "]"}]}], "]"}]}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"2", " ", 
      RowBox[{"Pi", "^", "2"}]}], ")"}]}]}]}]], "Input",ExpressionUUID->\
"ae843447-0b8f-4b51-9db8-67d2109c4aa4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"exact", " ", "values", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"45", "/", "2"}], ",", " ", 
       RowBox[{"1", "/", "5"}], ",", " ", "1"}], ")"}]}], ",", " ", 
    RowBox[{
    "so", " ", "that", " ", "FindRoot", " ", "can", " ", "work", " ", "with", 
     " ", "30", " ", "digits"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"gapValue", " ", "=", " ", 
     RowBox[{"Block", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          SubscriptBox["G", "LL"], " ", "=", " ", 
          RowBox[{"45", "/", "2"}]}], ",", " ", 
         RowBox[{
          SubscriptBox["m", "LL"], " ", "=", " ", 
          RowBox[{"1", "/", "5"}]}], ",", " ", 
         RowBox[{
          SubscriptBox["\[CapitalLambda]", "LL"], " ", "=", " ", "1"}]}], 
        "}"}], ",", "\n", "   ", 
       RowBox[{
        SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], " ", "/.", " ", 
        RowBox[{"FindRoot", "[", 
         RowBox[{"gapEquation", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], ",", " ", 
            "0.2"}], "}"}], ",", " ", 
          RowBox[{"WorkingPrecision", " ", "->", " ", "30"}], ",", " ", 
          RowBox[{"AccuracyGoal", " ", "->", " ", "20"}]}], "]"}]}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"SL31Check", "[", 
     RowBox[{"\"\<S-6\>\"", ",", 
      " ", "\"\<the gap equation written with the symbols gives the gap of \
the condensed vacuum 0.2094933033 at G = 22.5, m = 0.2, cutoff 1; 2 Delta_vac \
= 0.4189866 and 2 M_q = 0.5792666\>\"", ",", "\n", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"gapValue", " ", "-", " ", "0.2094933033"}], "]"}], " ", "<",
         " ", "1*^-10"}], " ", "&&", " ", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"2", " ", "gapValue"}], " ", "-", " ", "0.4189866"}], "]"}],
         " ", "<", " ", "1*^-7"}], " ", "&&", " ", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"2", " ", 
           RowBox[{"Sqrt", "[", 
            RowBox[{"0.04", " ", "+", " ", 
             RowBox[{"gapValue", "^", "2"}]}], "]"}]}], " ", "-", " ", 
          "0.5792666"}], "]"}], " ", "<", " ", "1*^-7"}]}], ",", "\n", "  ", 
      RowBox[{"N", "[", 
       RowBox[{"gapValue", ",", " ", "12"}], "]"}]}], "]"}], 
    ";"}]}]}]], "Input",ExpressionUUID->"e6262408-956b-4b33-a690-\
31ddd1ea34eb"],

Cell[TextData[{
 "S-7, sums over a family of symbols: the Pauli matrices. The registry symbol \
",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[Sigma]", 
     StyleBox["j", "TI"], "LL"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"89b8c772-2d37-4906-9f9e-10fb33290d79"]], "InlineFormula",
  ExpressionUUID->"fd9ef381-c411-4436-93f7-943180c573ef"],
 " is a family with the running index ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     StyleBox["j", "TI"], "\[LongEqual]", "1", ",", "2", ",", "3"}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "04f22832-2809-4fba-9069-9a435dc0a7d2"]], "InlineFormula",ExpressionUUID->
  "e583577c-7953-45c3-85af-714b8f9aec7c"],
 ". A symbolized symbol is indivisible, so the index letter inside it cannot \
be replaced by a number in a sum. The components are therefore separate \
symbols: ",
 StyleBox["LL[tex, \"j\" -> \"1\"]",
  FontFamily->"Source Code Pro"],
 " (written in the input cells as the printed component ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[Sigma]", "1", "LL"], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"a221074f-5147-4859-a265-dafda3e41231"]], 
  "InlineFormula",ExpressionUUID->"cedf4181-0311-481b-b9d8-7e3a32810755"],
 ") symbolizes and returns the component with ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     StyleBox["j", "TI"], "\[LongEqual]", "1"}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"3401aa38-dcbe-4dca-8474-8ceebb63ae51"]], 
  "InlineFormula",ExpressionUUID->"9825af77-07a7-4ef0-b5e7-81771c5eecff"],
 ". The cell gives the three components the Pauli matrices as values, \
together with the identity ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubscriptBox[
     StyleBox["1",
      FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"d6ddd7b2-3c0c-4b32-aa8d-c1352f2a3ec4"]], "InlineFormula",
  ExpressionUUID->"c840bd8c-096c-473c-b91d-f94bc39f10b8"],
 ", and checks two identities that involve sums over the index: ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     UnderscriptBox["\[Sum]", 
      StyleBox["j", "TI"],
      LimitsPositioning->True], 
     SubsuperscriptBox["\[Sigma]", 
      StyleBox["j", "TI"], "LL"], 
     SubsuperscriptBox["\[Sigma]", 
      StyleBox["j", "TI"], "LL"], "\[LongEqual]", 
     RowBox[{"3", " "}], 
     SubscriptBox[
      StyleBox["1",
       FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"f5397a68-1618-4a4b-b717-3d48bdde5b9b"]], "InlineFormula",
  ExpressionUUID->"3d59e411-4db4-473d-b726-e029a2fe5045"],
 ", and the product rule ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubsuperscriptBox["\[Sigma]", 
      StyleBox["j", "TI"], "LL"], 
     SubsuperscriptBox["\[Sigma]", 
      SuperscriptBox[
       StyleBox["j", "TI"], "\[Prime]"], "LL"], "\[LongEqual]", 
     SubscriptBox["\[Delta]", 
      RowBox[{
       StyleBox["j", "TI"], 
       SuperscriptBox[
        StyleBox["j", "TI"], "\[Prime]"]}]], 
     SubscriptBox[
      StyleBox["1",
       FontSlant->"Plain"], "2"], "+", 
     StyleBox["i", "TI"], 
     UnderscriptBox["\[Sum]", 
      SuperscriptBox[
       StyleBox["j", "TI"], "\[Prime]\[Prime]"],
      LimitsPositioning->True], 
     SubsuperscriptBox["\[Epsilon]", 
      RowBox[{
       StyleBox["j", "TI"], 
       SuperscriptBox[
        StyleBox["j", "TI"], "\[Prime]"], 
       SuperscriptBox[
        StyleBox["j", "TI"], "\[Prime]\[Prime]"]}], "LL"], 
     SubsuperscriptBox["\[Sigma]", 
      SuperscriptBox[
       StyleBox["j", "TI"], "\[Prime]\[Prime]"], "LL"]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"77e6479a-58d8-4bdd-8241-48c25f3d77f7"]], 
  "InlineFormula",ExpressionUUID->"80cd8751-f426-4df4-a9cf-6fad65c0d1d1"],
 ", in which the 27 components of the symbol ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[Epsilon]", 
     RowBox[{
      StyleBox["j", "TI"], 
      SuperscriptBox[
       StyleBox["j", "TI"], "\[Prime]"], 
      SuperscriptBox[
       StyleBox["j", "TI"], "\[Prime]\[Prime]"]}], "LL"], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"f6a4fae6-609c-4215-ad58-ab80487b350b"]], 
  "InlineFormula",ExpressionUUID->"1ebcf22f-99f2-41b6-84e3-555f1d263e17"],
 " (the totally antisymmetric symbol with ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubsuperscriptBox["\[Epsilon]", "123", "LL"], "\[LongEqual]", "1"}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "06e64a81-5e49-461a-836c-8c2b5f08f63a"]], "InlineFormula",ExpressionUUID->
  "91618cf7-6129-419a-b83d-ec46827bb76b"],
 ") are symbolized and given their values."
}], "Text",ExpressionUUID->"c534113c-0da8-43f1-9a17-53ade7d3d1dc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"symbolize", " ", "the", " ", "components", " ", 
     RowBox[{"sigma", "^", "LL_"}], "1"}], ",", " ", 
    RowBox[{
     RowBox[{"sigma", "^", "LL_"}], "2"}], ",", " ", 
    RowBox[{
     RowBox[{"sigma", "^", "LL_"}], "3", " ", "and", " ", 
     RowBox[{"epsilon", "^", "LL_"}], 
     RowBox[{"{", 
      RowBox[{"j", " ", 
       RowBox[{"j", "'"}], " ", 
       RowBox[{"j", "''"}]}], "}"}], " ", 
     RowBox[{"(", 
      RowBox[{"j", ",", " ", 
       RowBox[{"j", "'"}], ",", " ", 
       RowBox[{
        RowBox[{"j", "''"}], " ", "=", " ", "1"}], ",", " ", "2", ",", " ", 
       "3"}], ")"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"sigma", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"ReleaseHold", "[", 
        RowBox[{"SL31Instance", "[", 
         RowBox[{
          RowBox[{
          "SL31SymbolBoxes", "[", "\"\<\\\\sigma^{\\\\rm LL}_j\>\"", "]"}], ",",
           " ", 
          RowBox[{"{", 
           RowBox[{"\"\<j\>\"", " ", "->", " ", 
            RowBox[{"ToString", "[", "k", "]"}]}], "}"}]}], "]"}], "]"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"eps", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"ReleaseHold", "[", 
        RowBox[{"SL31Instance", "[", 
         RowBox[{
          RowBox[{
          "SL31SymbolBoxes", "[", "\"\<\\\\epsilon^{\\\\rm LL}_{jj'j''}\>\"", 
           "]"}], ",", "\n", "      ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\"\<j\>\"", " ", "->", " ", 
             RowBox[{"ToString", "[", "a", "]"}]}], ",", " ", 
            RowBox[{
             RowBox[{"SuperscriptBox", "[", 
              RowBox[{"\"\<j\>\"", ",", " ", "\"\<\[Prime]\>\""}], "]"}], " ",
              "->", " ", 
             RowBox[{"ToString", "[", "b", "]"}]}], ",", " ", 
            RowBox[{
             RowBox[{"SuperscriptBox", "[", 
              RowBox[{"\"\<j\>\"", ",", " ", "\"\<\[Prime]\[Prime]\>\""}], 
              "]"}], " ", "->", " ", 
             RowBox[{"ToString", "[", "c", "]"}]}]}], "}"}]}], "]"}], "]"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"b", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"c", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"{", 
    RowBox[{"sigma", ",", " ", 
     RowBox[{"eps", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "]"}], "]"}], ",", " ", 
     RowBox[{"eps", "[", 
      RowBox[{"[", 
       RowBox[{"2", ",", " ", "1", ",", " ", "3"}], "]"}], "]"}]}], 
    "}"}]}]}]], "Input",ExpressionUUID->"4138d5ac-0703-4a6e-af6a-\
62eed9a1d7d6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", 
     RowBox[{"values", ":", " ", 
      RowBox[{"inside", " ", "Block", " ", "only"}]}]}], ",", " ", 
    RowBox[{
    "so", " ", "that", " ", "the", " ", "symbols", " ", "stay", " ", "free", " ",
      "elsewhere"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"pauliValues", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "0"}], "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", 
           RowBox[{"-", "I"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"I", ",", " ", "0"}], "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", 
           RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check7", " ", "=", " ", 
     RowBox[{"Block", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          SubsuperscriptBox["\[Sigma]", "1", "LL"], " ", "=", " ", 
          RowBox[{"pauliValues", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
         RowBox[{
          SubsuperscriptBox["\[Sigma]", "2", "LL"], " ", "=", " ", 
          RowBox[{"pauliValues", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ",", "\n", "     ", 
         RowBox[{
          SubsuperscriptBox["\[Sigma]", "3", "LL"], " ", "=", " ", 
          RowBox[{"pauliValues", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], ",", " ", 
         RowBox[{
          SubscriptBox[
           TagBox[
            StyleBox["1",
             FontFamily->"Helvetica",
             FontSlant->"Plain"],
            "SL31SansSerif"], "2"], " ", "=", " ", 
          RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], "}"}], ",", "\n", 
       "   ", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"sum", ",", " ", "rule"}], "}"}], ",", "\n", "     ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{"the", " ", "sum", " ", "over", " ", "j", " ", "of", " ", 
            RowBox[{"sigma_j", " ", ".", " ", "sigma_j"}]}], ",", " ", 
           RowBox[{
           "written", " ", "with", " ", "the", " ", "three", " ", 
            "components"}]}], " ", "*)"}], "\n", "     ", 
         RowBox[{
          RowBox[{"sum", " ", "=", " ", 
           RowBox[{
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"sigma", "[", 
                RowBox[{"[", "j", "]"}], "]"}], " ", ".", " ", 
               RowBox[{"sigma", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}], " ", "-", " ", 
            RowBox[{"3", " ", 
             SubscriptBox[
              TagBox[
               StyleBox["1",
                FontFamily->"Helvetica",
                FontSlant->"Plain"],
               "SL31SansSerif"], "2"]}]}]}], ";", "\n", "     ", 
          RowBox[{"(*", " ", 
           RowBox[{
            RowBox[{
            "the", " ", "product", " ", "rule", " ", "for", " ", "all", " ", 
             "nine", " ", "pairs", " ", 
             RowBox[{"(", 
              RowBox[{"j", ",", " ", 
               RowBox[{"j", "'"}]}], ")"}]}], ",", " ", 
            RowBox[{
            "with", " ", "the", " ", "27", " ", "symbolized", " ", 
             "components", " ", "of", " ", "epsilon"}]}], " ", "*)"}], "\n", 
          "     ", 
          RowBox[{"rule", " ", "=", " ", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"sigma", "[", 
                RowBox[{"[", "j", "]"}], "]"}], " ", ".", " ", 
               RowBox[{"sigma", "[", 
                RowBox[{"[", "jp", "]"}], "]"}]}], " ", "-", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"KroneckerDelta", "[", 
                  RowBox[{"j", ",", " ", "jp"}], "]"}], " ", 
                 SubscriptBox[
                  TagBox[
                   StyleBox["1",
                    FontFamily->"Helvetica",
                    FontSlant->"Plain"],
                   "SL31SansSerif"], "2"]}], " ", "+", "\n", "           ", 
                RowBox[{"I", " ", 
                 RowBox[{"Sum", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"eps", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", ",", " ", "jp", ",", " ", "jpp"}], "]"}], 
                    "]"}], " ", "/.", " ", 
                    RowBox[{"Thread", "[", 
                    RowBox[{
                    RowBox[{"Flatten", "[", "eps", "]"}], " ", "->", " ", 
                    RowBox[{"Flatten", "[", 
                    RowBox[{"Normal", "[", 
                    RowBox[{"LeviCivitaTensor", "[", "3", "]"}], "]"}], 
                    "]"}]}], "]"}]}], ")"}], " ", 
                    RowBox[{"sigma", "[", 
                    RowBox[{"[", "jpp", "]"}], "]"}]}], ",", " ", 
                   RowBox[{"{", 
                    RowBox[{"jpp", ",", " ", "3"}], "}"}]}], "]"}]}]}], 
               ")"}]}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"j", ",", " ", "3"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"jp", ",", " ", "3"}], "}"}]}], "]"}]}], ";", "\n", 
          "     ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Max", "[", 
             RowBox[{"Abs", "[", "sum", "]"}], "]"}], ",", " ", 
            RowBox[{"Max", "[", 
             RowBox[{"Abs", "[", 
              RowBox[{"Flatten", "[", "rule", "]"}], "]"}], "]"}]}], 
           "}"}]}]}], "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"SL31Check", "[", 
     RowBox[{"\"\<S-7\>\"", ",", 
      " ", "\"\<sum over j of sigma^LL_j sigma^LL_j = 3 times the unit \
matrix, and sigma_j sigma_j' = delta_jj' + i sum_j'' epsilon_jj'j'' sigma_j'' \
for all nine pairs (components as symbolized symbols)\>\"", ",", "\n", "  ", 
      RowBox[{"check7", " ", "===", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0"}], "}"}]}], ",", " ", "check7"}], "]"}], 
    ";"}]}]}]], "Input",ExpressionUUID->"f0e54221-ebde-410e-939c-\
93808aec590d"],

Cell[TextData[{
 "S-8, a double sum with a metric: the Minkowski square. The family ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["x", "TI"], "LL", 
     StyleBox["p", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "ed412466-0924-41d3-a26b-36548788e1fb"]], "InlineFormula",ExpressionUUID->
  "b4ccf4da-5b9b-4098-9be0-628fc245a85d"],
 " (the coordinates of space-time, ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     StyleBox["p", "TI"], "\[LongEqual]", "0", ",", "1", ",", "2", ",", "3"}],
     TraditionalForm]], "InlineFormula",ExpressionUUID->
   "c9d79d58-b09d-4144-aa73-b7f5ee479a5b"]], "InlineFormula",ExpressionUUID->
  "35999ae8-e618-453b-9dde-5dab2319e6ba"],
 ") and the metric ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[Eta]", 
     RowBox[{
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}], "LL"], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"b03301ae-d533-4fb3-bea6-310ae618a5e5"]], 
  "InlineFormula",ExpressionUUID->"0c4c29a1-d535-4bde-a2b2-50930f190afd"],
 " (",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{"+", "1"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "8b68f52d-e4d3-4608-b151-53bc7a3463be"]], "InlineFormula",ExpressionUUID->
  "9cfa8a19-e9cb-4b8b-9c1f-d89702d0cfef"],
 " for ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     StyleBox["p", "TI"], "\[LongEqual]", 
     SuperscriptBox[
      StyleBox["p", "TI"], "\[Prime]"], "\[LongEqual]", "0"}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "fe2c2e9e-cedd-4e65-a0d4-8ea7838ca7bb"]], "InlineFormula",ExpressionUUID->
  "8c710100-df9e-40d5-9366-bfde7106c642"],
 ", ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "8ce6e6eb-0a44-4628-88c4-a3ca6be9ed3c"]], "InlineFormula",ExpressionUUID->
  "62a3c5c3-f8f1-47b6-92cb-048580e673ba"],
 " for ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     StyleBox["p", "TI"], "\[LongEqual]", 
     SuperscriptBox[
      StyleBox["p", "TI"], "\[Prime]"], "\[LongEqual]", "1", ",", "2", ",", 
     "3"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "aee3954e-924f-45d5-8c48-8bd260f11590"]], "InlineFormula",ExpressionUUID->
  "8027949c-4ce6-4da4-86ae-d8421f01716a"],
 ", zero otherwise) are symbolized component by component; the double sum ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{
       StyleBox["p", "TI"], ",", 
       SuperscriptBox[
        StyleBox["p", "TI"], "\[Prime]"]}],
      LimitsPositioning->True], 
     SubsuperscriptBox["\[Eta]", 
      RowBox[{
       StyleBox["p", "TI"], 
       SuperscriptBox[
        StyleBox["p", "TI"], "\[Prime]"]}], "LL"], 
     SubsuperscriptBox[
      StyleBox["x", "TI"], "LL", 
      StyleBox["p", "TI"]], 
     SubsuperscriptBox[
      StyleBox["x", "TI"], "LL", 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"3429d9ab-1eb2-49f9-8f5e-d0fb577589c0"]], 
  "InlineFormula",ExpressionUUID->"9d084641-9882-48c0-b37a-24b706f256d6"],
 " is formed with the 16 components of the metric as free symbols, then the \
metric receives its values and the sum must become ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["x", "TI"], "LL", "0"], ")"}], "2"], "-", 
     UnderscriptBox["\[Sum]", 
      StyleBox["j", "TI"],
      LimitsPositioning->True], 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["x", "TI"], "LL", 
        StyleBox["j", "TI"]], ")"}], "2"]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"300215f3-bb5f-4ef7-9d1d-379c4dc6f60d"]], 
  "InlineFormula",ExpressionUUID->"190b8418-47c0-4fbe-a83f-797377aa299c"],
 ", with the coordinate components remaining free symbols. The test is \
algebraic: ",
 StyleBox["Expand",
  FontFamily->"Source Code Pro"],
 " and a comparison of polynomials in the four coordinate symbols."
}], "Text",ExpressionUUID->"3e8e7e9d-f7c4-41f3-a206-65df4261f28d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"xs", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ReleaseHold", "[", 
      RowBox[{"SL31Instance", "[", 
       RowBox[{
        RowBox[{"SL31SymbolBoxes", "[", "\"\<x^p_{\\\\rm LL}\>\"", "]"}], ",",
         " ", 
        RowBox[{"{", 
         RowBox[{"\"\<p\>\"", " ", "->", " ", 
          RowBox[{"ToString", "[", "k", "]"}]}], "}"}]}], "]"}], "]"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"etas", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ReleaseHold", "[", 
      RowBox[{"SL31Instance", "[", 
       RowBox[{
        RowBox[{
        "SL31SymbolBoxes", "[", "\"\<\\\\eta^{\\\\rm LL}_{pp'}\>\"", "]"}], ",",
         " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\"\<p\>\"", " ", "->", " ", 
           RowBox[{"ToString", "[", "a", "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{"SuperscriptBox", "[", 
            RowBox[{"\"\<p\>\"", ",", " ", "\"\<\[Prime]\>\""}], "]"}], " ", "->",
            " ", 
           RowBox[{"ToString", "[", "b", "]"}]}]}], "}"}]}], "]"}], "]"}], ",",
      " ", 
     RowBox[{"{", 
      RowBox[{"a", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"b", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"quadratic", " ", "=", " ", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"etas", "[", 
       RowBox[{"[", 
        RowBox[{"a", ",", " ", "b"}], "]"}], "]"}], " ", 
      RowBox[{"xs", "[", 
       RowBox[{"[", "a", "]"}], "]"}], " ", 
      RowBox[{"xs", "[", 
       RowBox[{"[", "b", "]"}], "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"a", ",", " ", "4"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"b", ",", " ", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"minkowski", " ", "=", " ", 
   RowBox[{"Expand", "[", 
    RowBox[{"quadratic", " ", "/.", " ", 
     RowBox[{"Thread", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", "etas", "]"}], " ", "->", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{"DiagonalMatrix", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", 
           RowBox[{"-", "1"}], ",", " ", 
           RowBox[{"-", "1"}], ",", " ", 
           RowBox[{"-", "1"}]}], "}"}], "]"}], "]"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Length", "[", "quadratic", "]"}], ",", " ", "minkowski"}], 
  "}"}]}], "Input",ExpressionUUID->"96c10614-1b4f-4bfe-865e-539dd0ae9f80"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-8\>\"", ",", 
    " ", "\"\<the double sum of eta^LL_pp' x^p x^p' over p, p' = 0..3 (16 + 4 \
symbolized components) is (x^0)^2 - (x^1)^2 - (x^2)^2 - (x^3)^2\>\"", ",", 
    "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"Expand", "[", 
       RowBox[{"minkowski", " ", "-", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"xs", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "^", "2"}], " ", "-", " ", 
          RowBox[{
           RowBox[{"xs", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "^", "2"}], " ", "-", " ", 
          RowBox[{
           RowBox[{"xs", "[", 
            RowBox[{"[", "3", "]"}], "]"}], "^", "2"}], " ", "-", " ", 
          RowBox[{
           RowBox[{"xs", "[", 
            RowBox[{"[", "4", "]"}], "]"}], "^", "2"}]}], ")"}]}], "]"}], " ",
       "===", " ", "0"}], " ", "&&", " ", 
     RowBox[{
      RowBox[{"Length", "[", "quadratic", "]"}], " ", "==", " ", "16"}]}], ",",
     " ", "minkowski"}], "]"}], ";"}]], "Input",ExpressionUUID->"f9a9a6c3-\
e7d6-43a8-a2f6-8019d06a4d2e"],

Cell[TextData[{
 "S-9, algebra with the symbols of the Higgs mechanism of the superfluid \
boson singlet state. The rest masses of the two charged vector bosons and of \
the vector boson of the fermion number are ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["M", "TI"], "LL", "W"], ")"}], "2"], "\[LongEqual]", "2", 
     SubsuperscriptBox[
      StyleBox["Z", "TI"], "LL", "s"], 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["g", "TI"], "LL", "v"], ")"}], "2"], 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], ")"}], "2"]}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "8ffd20dc-886a-4d36-993c-48acd0d034e9"]], "InlineFormula",ExpressionUUID->
  "656d883f-ecf8-4120-ad68-5fd3178ba77e"],
 " and ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["M", "TI"], "LL", "F"], ")"}], "2"], "\[LongEqual]", "8", 
     SubsuperscriptBox[
      StyleBox["Z", "TI"], "LL", "s"], 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["g", "TI"], "LL", "F"], ")"}], "2"], 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], ")"}], "2"]}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "fe24b2b6-dea2-4893-8aeb-423ade2d5d03"]], "InlineFormula",ExpressionUUID->
  "060a640e-99c0-453e-a74e-97aa7b75c24b"],
 ", where ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["Z", "TI"], "LL", "s"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"340c362d-89e9-411e-868c-06d7d0c20b48"]], "InlineFormula",
  ExpressionUUID->"3edefeb9-575b-487a-be29-973cea1be7eb"],
 " is the stiffness of the space derivatives and ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["g", "TI"], "LL", "v"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"1d203dae-942a-42a9-9b70-82e1fc8ef12f"]], "InlineFormula",
  ExpressionUUID->"059b6e69-fd7d-4f89-8092-0fde89fce1f3"],
 ", ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["g", "TI"], "LL", "F"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"bb472761-99c3-4855-bea3-353d3815d3c7"]], "InlineFormula",
  ExpressionUUID->"d5e0509c-43fe-489a-9b97-e46a3a37c1cb"],
 " are the gauge couplings. The cell checks with ",
 StyleBox["Simplify",
  FontFamily->"Source Code Pro"],
 " that the ratio of the squared masses is ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{"4", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox[
         StyleBox["g", "TI"], "LL", "F"], "/", 
        SubsuperscriptBox[
         StyleBox["g", "TI"], "LL", "v"]}], ")"}], "2"]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"013fffc4-b2f0-4d97-b256-4cabc63c2982"]], 
  "InlineFormula",ExpressionUUID->"60dbf6d7-41e5-4457-9971-fc132588b264"],
 ", independent of the stiffness and of the gap, and with ",
 StyleBox["Solve",
  FontFamily->"Source Code Pro"],
 " that the gap can be recovered from ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["M", "TI"], "LL", "W"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"2d06df2d-66e9-42db-b4c7-1109125dc437"]], "InlineFormula",
  ExpressionUUID->"82fd3678-df76-4d73-8af6-a7f8fe3e6e86"],
 "."
}], "Text",ExpressionUUID->"13092c18-fc97-4741-ab62-675cda34de34"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"massRules", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      SubsuperscriptBox["M", "LL", "W"], " ", "->", " ", 
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{"2", " ", 
         SubsuperscriptBox["Z", "LL", "s"]}], "]"}], " ", 
       SubsuperscriptBox["g", "LL", "v"], " ", 
       SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"]}]}], ",", "\n", 
     "   ", 
     RowBox[{
      SubsuperscriptBox["M", "LL", "F"], " ", "->", " ", 
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{"8", " ", 
         SubsuperscriptBox["Z", "LL", "s"]}], "]"}], " ", 
       SubsuperscriptBox["g", "LL", "F"], " ", 
       SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"]}]}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{"ratio", " ", "=", " ", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox["M", "LL", "F"], "/", 
       SubsuperscriptBox["M", "LL", "W"]}], ")"}], "^", "2"}], " ", "/.", " ",
     "massRules"}], "]"}]}]}], "Input",ExpressionUUID->"fd50529e-e714-4775-\
9aae-b575fb0b2fed"],

Cell[BoxData[
 RowBox[{"gapFromMass", " ", "=", " ", 
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      SubsuperscriptBox["M", "LL", "W"], "^", "2"}], " ", "==", " ", 
     RowBox[{"2", " ", 
      SubsuperscriptBox["Z", "LL", "s"], " ", 
      RowBox[{
       SubsuperscriptBox["g", "LL", "v"], "^", "2"}], " ", 
      RowBox[{
       SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], "^", "2"}]}]}], ",",
     " ", 
    SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"]}], "]"}]}]], "Input",Exp\
ressionUUID->"e0a47a0f-7db0-4331-a715-0ac13dbced6d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-9\>\"", ",", 
    " ", "\"\<(M^F_LL / M^W_LL)^2 = 4 (g^F_LL / g^v_LL)^2 and the gap follows \
from M^W_LL (algebra with symbolized symbols)\>\"", ",", "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{"ratio", " ", "-", " ", 
        RowBox[{"4", " ", 
         RowBox[{
          RowBox[{
           SubsuperscriptBox["g", "LL", "F"], "^", "2"}], "/", 
          RowBox[{
           SubsuperscriptBox["g", "LL", "v"], "^", "2"}]}]}]}], "]"}], " ", "===",
       " ", "0"}], " ", "&&", " ", 
     RowBox[{
      RowBox[{"Length", "[", "gapFromMass", "]"}], " ", "==", " ", "2"}]}], ",",
     " ", "ratio"}], "]"}], ";"}]], "Input",ExpressionUUID->"ede7d2b8-df79-\
4e0e-a646-7cae76f57a9c"],

Cell[TextData[{
 "S-10, the longitudinal vector boson. For a plane wave of wave number ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["k", "TI"], "LL", "B"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"5058d9a5-2d84-47c4-b102-86977fe7b578"]], "InlineFormula",
  ExpressionUUID->"dd05ce38-207d-4470-82b6-a2cb8b6753df"],
 " and frequency ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[Omega]", "LL", "B"], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"52a7cbb2-1a30-436d-af47-f747f08f2d6c"]], 
  "InlineFormula",ExpressionUUID->"ff57e231-fced-472f-b501-832e1243a677"],
 " the time component and the longitudinal component of a massive vector \
field obey two linear equations; their determinant is ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox[
          StyleBox["k", "TI"], "LL", "B"], ")"}], "2"], "+", 
       RowBox[{"(", 
        RowBox[{
         SubsuperscriptBox[
          StyleBox["Z", "TI"], "LL", "t"], "/", 
         SubsuperscriptBox[
          StyleBox["Z", "TI"], "LL", "s"]}], ")"}], 
       SuperscriptBox[
        StyleBox["M", "TI"], "2"]}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox["\[Omega]", "LL", "B"], ")"}], "2"], "-", 
       SuperscriptBox[
        StyleBox["M", "TI"], "2"]}], ")"}], "-", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox[
         StyleBox["k", "TI"], "LL", "B"], 
        SubsuperscriptBox["\[Omega]", "LL", "B"]}], ")"}], "2"]}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "8f40ade0-b0b4-4914-86cf-a243f902e0cf"]], "InlineFormula",ExpressionUUID->
  "b200cdc8-7527-4dbc-ac20-c9963f8a70a4"],
 " with ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     StyleBox["M", "TI"], "\[LongEqual]", 
     SubsuperscriptBox[
      StyleBox["M", "TI"], "LL", "W"]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"63ee5a70-cc83-42b0-b73a-a45abb846d73"]], "InlineFormula",
  ExpressionUUID->"e1078615-b88e-429c-8e0a-4107210ac8e6"],
 ". The cell checks with ",
 StyleBox["Factor",
  FontFamily->"Source Code Pro"],
 " and ",
 StyleBox["Solve",
  FontFamily->"Source Code Pro"],
 " that it vanishes exactly for ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox["\[Omega]", "LL", "B"], ")"}], "2"], "\[LongEqual]", 
     
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["M", "TI"], "LL", "W"], ")"}], "2"], "+", 
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["Z", "TI"], "LL", "s"], "/", 
       SubsuperscriptBox[
        StyleBox["Z", "TI"], "LL", "t"]}], ")"}], 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["k", "TI"], "LL", "B"], ")"}], "2"]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"92513597-0f49-4271-b1b3-23aabc9a7646"]], 
  "InlineFormula",ExpressionUUID->"211dd2f6-c4e1-47a0-a007-49bde72134bf"],
 ": the absorbed Goldstone boson moves with the velocity ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["Z", "TI"], "LL", "s"], "/", 
       SubsuperscriptBox[
        StyleBox["Z", "TI"], "LL", "t"]}], ")"}], 
     RowBox[{"1", "/", "2"}]], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"ff671284-689b-4b23-af8e-c30a281acd2d"]], "InlineFormula",
  ExpressionUUID->"d64ad021-0e15-4a5d-9c75-6894f739bdf0"],
 "."
}], "Text",ExpressionUUID->"00df2cc0-2be8-48c7-b381-10e75239e15f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"det", " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SubsuperscriptBox["k", "LL", "B"], "^", "2"}], " ", "+", " ", 
        RowBox[{
         RowBox[{
          SubsuperscriptBox["Z", "LL", "t"], "/", 
          SubsuperscriptBox["Z", "LL", "s"]}], " ", 
         RowBox[{
          SubsuperscriptBox["M", "LL", "W"], "^", "2"}]}]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SubsuperscriptBox["\[Omega]", "LL", "B"], "^", "2"}], " ", "-", " ", 
        
        RowBox[{
         SubsuperscriptBox["M", "LL", "W"], "^", "2"}]}], ")"}]}], " ", "-", 
     "\n", "   ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox["k", "LL", "B"], " ", 
        SubsuperscriptBox["\[Omega]", "LL", "B"]}], ")"}], "^", "2"}]}]}], 
   ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Solve", " ", "needs", " ", "a", " ", "symbol", " ", "as", " ", 
    RowBox[{"unknown", ":", " ", 
     RowBox[{
     "the", " ", "square", " ", "of", " ", "the", " ", "frequency", " ", "is",
       " ", "called", " ", "w"}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{"root", " ", "=", " ", 
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"det", " ", "/.", " ", 
       RowBox[{
        SubsuperscriptBox["\[Omega]", "LL", "B"], " ", "->", " ", 
        RowBox[{"Sqrt", "[", "w", "]"}]}]}], ")"}], " ", "==", " ", "0"}], ",",
     " ", "w"}], "]"}]}]}], "Input",ExpressionUUID->"7ac4dc07-b9f4-48c2-9a88-\
96cf7d1df42a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-10\>\"", ",", 
    " ", "\"\<the determinant of the time and longitudinal equations vanishes \
exactly at omega_B^2 = M_W^2 + (Z_s/Z_t) k_B^2\>\"", ",", "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", "root", "]"}], " ", "==", " ", "1"}], " ", "&&", 
     " ", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"w", " ", "/.", " ", 
          RowBox[{"First", "[", "root", "]"}]}], ")"}], " ", "-", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           SubsuperscriptBox["M", "LL", "W"], "^", "2"}], " ", "+", " ", 
          RowBox[{
           RowBox[{
            SubsuperscriptBox["Z", "LL", "s"], "/", 
            SubsuperscriptBox["Z", "LL", "t"]}], " ", 
           RowBox[{
            SubsuperscriptBox["k", "LL", "B"], "^", "2"}]}]}], ")"}]}], "]"}],
       " ", "===", " ", "0"}]}], ",", "\n", "  ", 
    RowBox[{"Factor", "[", "det", "]"}]}], "]"}], ";"}]], "Input",ExpressionUU\
ID->"56e30c8f-686e-43f1-a371-b468e532c57b"],

Cell[TextData[{
 "S-11, the sum over the isospin index with the generators ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubsuperscriptBox[
      StyleBox["T", "TI"], "LL", "\[Iota]"], "\[LongEqual]", 
     SubsuperscriptBox["\[Tau]", "\[Iota]", "LL"], "/", "2"}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "c6b9440e-d4ed-4919-a993-e6be12db1dbd"]], "InlineFormula",ExpressionUUID->
  "74714fd5-4e4b-48fb-b5e0-686e89f4fc39"],
 ": the Casimir ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       SubscriptBox[
        StyleBox["T", "TI"], "LL"], ")"}], "2"], "\[LongEqual]", 
     UnderscriptBox["\[Sum]", "\[Iota]",
      LimitsPositioning->True], 
     SubsuperscriptBox[
      StyleBox["T", "TI"], "LL", "\[Iota]"], 
     SubsuperscriptBox[
      StyleBox["T", "TI"], "LL", "\[Iota]"]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"ba278340-90ae-4dac-a666-9711718ddb09"]], 
  "InlineFormula",ExpressionUUID->"cceb8ebe-b815-4569-9a9b-7b165d501e24"],
 " of the isospin one-half is ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    FractionBox["3", "4"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "9179ca83-37b6-4cb9-8e2a-c4e9678d6c92"]], "InlineFormula",ExpressionUUID->
  "d392daf9-6bc1-4a8b-a4b1-2b11d508533a"],
 " times the unit matrix. The components ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubsuperscriptBox["\[Tau]", "1", "LL"], ",", 
     SubsuperscriptBox["\[Tau]", "2", "LL"], ",", 
     SubsuperscriptBox["\[Tau]", "3", "LL"]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"d405181b-7a8f-4fc1-b332-ec05111d0432"]], 
  "InlineFormula",ExpressionUUID->"91179a31-da09-4271-9d19-4078977c08ca"],
 " and ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubsuperscriptBox[
      StyleBox["T", "TI"], "LL", "1"], ",", 
     SubsuperscriptBox[
      StyleBox["T", "TI"], "LL", "2"], ",", 
     SubsuperscriptBox[
      StyleBox["T", "TI"], "LL", "3"]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"6f54f1e3-522d-4ead-8317-9ad623af7066"]], "InlineFormula",
  ExpressionUUID->"1ea6aa72-bd60-4ee2-a3ac-4016ce0a040e"],
 " are symbolized; the generators are defined from the Pauli matrices by \
rules."
}], "Text",ExpressionUUID->"49750420-aadb-468f-9186-1ad01d066c3a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"taus", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ReleaseHold", "[", 
      RowBox[{"SL31Instance", "[", 
       RowBox[{
        RowBox[{
        "SL31SymbolBoxes", "[", "\"\<\\\\tau^{\\\\rm LL}_\\\\iota\>\"", "]"}],
         ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<\[Iota]\>\"", " ", "->", " ", 
          RowBox[{"ToString", "[", "k", "]"}]}], "}"}]}], "]"}], "]"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Ts", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ReleaseHold", "[", 
      RowBox[{"SL31Instance", "[", 
       RowBox[{
        RowBox[{
        "SL31SymbolBoxes", "[", "\"\<T^\\\\iota_{\\\\rm LL}\>\"", "]"}], ",", 
        " ", 
        RowBox[{"{", 
         RowBox[{"\"\<\[Iota]\>\"", " ", "->", " ", 
          RowBox[{"ToString", "[", "k", "]"}]}], "}"}]}], "]"}], "]"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"casimir", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Ts", "[", 
         RowBox[{"[", "k", "]"}], "]"}], " ", ".", " ", 
        RowBox[{"Ts", "[", 
         RowBox[{"[", "k", "]"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}], " ", "/.", " ", 
     RowBox[{"Thread", "[", 
      RowBox[{"Ts", " ", "->", " ", 
       RowBox[{"taus", "/", "2"}]}], "]"}]}], " ", "/.", " ", 
    RowBox[{"Thread", "[", 
     RowBox[{"taus", " ", "->", " ", "pauliValues"}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-11\>\"", ",", 
    " ", "\"\<the sum over iota of T^iota_LL T^iota_LL (with T = tau/2 for \
the symbolized components) is 3/4 times the unit matrix\>\"", ",", "\n", "  ", 
    RowBox[{"casimir", " ", "===", " ", 
     RowBox[{
      RowBox[{"3", "/", "4"}], " ", 
      RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], ",", " ", "casimir"}], 
   "]"}], ";"}]}], "Input",ExpressionUUID->"488d0548-569d-4f2b-8bee-\
95638d651e36"],

Cell["\<\
S-12, uniqueness of the plain-text names: no plain-text name of the registry \
belongs to two different entries (the programs and data files can therefore \
always be read back without ambiguity), and every name maps to one entry.\
\>", "Text",ExpressionUUID->"1a55ad85-e074-44f0-8c55-5bab3b035898"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"nameToEntries", " ", "=", " ", 
   RowBox[{"GroupBy", "[", 
    RowBox[{
     RowBox[{"Flatten", "[", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{"e", ",", " ", 
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"#", " ", "->", " ", 
              RowBox[{"e", "[", "\"\<entry\>\"", "]"}]}], " ", "&"}], ",", 
            " ", 
            RowBox[{"e", "[", "\"\<names\>\"", "]"}]}], "]"}]}], "]"}], ",", 
        " ", "SL31Registry"}], "]"}], "]"}], ",", " ", 
     RowBox[{"First", " ", "->", " ", "Last"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"shared", " ", "=", " ", 
   RowBox[{"Select", "[", 
    RowBox[{"nameToEntries", ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", 
        RowBox[{"DeleteDuplicates", "[", "#", "]"}], "]"}], " ", ">", " ", 
       "1"}], " ", "&"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-12\>\"", ",", 
    " ", "\"\<no plain-text name is registered for two different entries\>\"",
     ",", "\n", "  ", 
    RowBox[{"shared", " ", "===", " ", 
     RowBox[{"<|", "|>"}]}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Length", "[", "nameToEntries", "]"}], ",", " ", 
      RowBox[{"Normal", "[", "shared", "]"}]}], "}"}]}], "]"}], 
  ";"}]}], "Input",ExpressionUUID->"1cfe7898-3de7-4119-abb5-203115980e33"],

Cell[TextData[{
 "S-13, the kinds that are not symbolized. The imaginary unit ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    StyleBox["i", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "344718ce-f3b0-41a1-ae86-6cf59af4a0a3"]], "InlineFormula",ExpressionUUID->
  "d6fbf4c4-e16f-48d5-a5c5-6ed002df7fb3"],
 " is the Wolfram symbol ",
 StyleBox["I",
  FontFamily->"Source Code Pro"],
 "; the number sets ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    StyleBox["R",
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "3d096bc6-036b-4762-96a4-c91baf43eb0f"]], "InlineFormula",ExpressionUUID->
  "054886f8-0db5-4d0d-b0fe-71b6e8087858"],
 " and ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    StyleBox["C",
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "827af9d8-d4b1-4906-a295-ba7a7d49bb23"]], "InlineFormula",ExpressionUUID->
  "23ff55f7-2cae-4a49-9be9-08b901b8b956"],
 " are the Wolfram domains ",
 StyleBox["Reals",
  FontFamily->"Source Code Pro"],
 " and ",
 StyleBox["Complexes",
  FontFamily->"Source Code Pro"],
 " (which the Wolfram Language prints as double-struck letters); the \
operators correspond to Wolfram functions: tr is ",
 StyleBox["Tr",
  FontFamily->"Source Code Pro"],
 ", det is ",
 StyleBox["Det",
  FontFamily->"Source Code Pro"],
 ", diag is ",
 StyleBox["DiagonalMatrix",
  FontFamily->"Source Code Pro"],
 ", Re and Im are ",
 StyleBox["Re",
  FontFamily->"Source Code Pro"],
 " and ",
 StyleBox["Im",
  FontFamily->"Source Code Pro"],
 ", the tensor product ",
 Cell[BoxData[Cell[BoxData[
   FormBox["\[CircleTimes]", TraditionalForm]], "InlineFormula",
   ExpressionUUID->"2a2ce654-ad07-4606-b12e-1ac03c330c72"]], "InlineFormula",
  ExpressionUUID->"71ee72ce-30f3-4191-ab4e-64875201d418"],
 " is ",
 StyleBox["KroneckerProduct",
  FontFamily->"Source Code Pro"],
 ", the transpose ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SuperscriptBox["\[Null]", 
     StyleBox["T", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "f2d1ca5d-2978-49a9-976e-f8c8650a44ab"]], "InlineFormula",ExpressionUUID->
  "713c1809-d1b3-4b77-920a-d364d6c5d52e"],
 " is ",
 StyleBox["Transpose",
  FontFamily->"Source Code Pro"],
 ". The test checks each correspondence on the Pauli matrices."
}], "Text",ExpressionUUID->"b50467d0-0dbf-44e1-9b64-575ea4b7bb1c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"p1", " ", "=", " ", 
   RowBox[{"pauliValues", "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";", " ", 
  RowBox[{"p2", " ", "=", " ", 
   RowBox[{"pauliValues", "[", 
    RowBox[{"[", "2", "]"}], "]"}]}], ";", " ", 
  RowBox[{"p3", " ", "=", " ", 
   RowBox[{"pauliValues", "[", 
    RowBox[{"[", "3", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"correspondences", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"I", "^", "2"}], " ", "==", " ", 
      RowBox[{"-", "1"}]}], ",", " ", 
     RowBox[{"Element", "[", 
      RowBox[{
       RowBox[{"Sqrt", "[", "2", "]"}], ",", " ", "Reals"}], "]"}], ",", " ", 
     
     RowBox[{"Element", "[", 
      RowBox[{"I", ",", " ", "Complexes"}], "]"}], ",", " ", 
     RowBox[{"!", " ", 
      RowBox[{"Element", "[", 
       RowBox[{"I", ",", " ", "Reals"}], "]"}]}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"Tr", "[", "p3", "]"}], " ", "==", " ", "0"}], ",", " ", 
     RowBox[{
      RowBox[{"Det", "[", "p1", "]"}], " ", "==", " ", 
      RowBox[{"-", "1"}]}], ",", " ", 
     RowBox[{
      RowBox[{"DiagonalMatrix", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", 
         RowBox[{"-", "1"}]}], "}"}], "]"}], " ", "==", " ", "p3"}], ",", " ", 
     RowBox[{
      RowBox[{"Re", "[", "p2", "]"}], " ", "==", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}]}], ",", " ", 
     RowBox[{
      RowBox[{"Im", "[", "p2", "]"}], " ", "==", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", 
          RowBox[{"-", "1"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "0"}], "}"}]}], "}"}]}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"p1", ",", " ", "p3"}], "]"}], " ", ".", " ", 
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"p1", ",", " ", "p3"}], "]"}]}], " ", "==", " ", 
      RowBox[{"IdentityMatrix", "[", "4", "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{"Transpose", "[", "p2", "]"}], " ", "==", " ", 
      RowBox[{"-", "p2"}]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-13\>\"", ",", 
    " ", "\"\<the imaginary unit, the number sets and the operators \
correspond to I, Reals, Complexes, Tr, Det, DiagonalMatrix, Re, Im, \
KroneckerProduct, Transpose\>\"", ",", "\n", "  ", 
    RowBox[{"And", " ", "@@", " ", "correspondences"}], ",", " ", 
    "correspondences"}], "]"}], ";"}]}], "Input",ExpressionUUID->"6759208e-\
010a-4517-b9ba-7c3834b88456"],

Cell["I.8 The complete table of the symbols", "Section",ExpressionUUID->"59aef7b9-7320-42ed-aff0-974ba391933f"],

Cell["\<\
The table below shows every entry of the registry, group by group: the \
printed symbols (as the notebook now displays them), the plain-text names and \
the meaning. In the meanings the TeX between dollar signs is shown in its \
printed form.\
\>", "Text",ExpressionUUID->"8d9acfcb-63a8-4fda-afd2-7a3923a76ef7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"the", " ", "meaning", " ", "as", " ", "text", " ", "with", " ", 
    RowBox[{"formulas", ":", " ", 
     RowBox[{
     "TeX", " ", "between", " ", "dollar", " ", "signs", " ", "is", " ", 
      "converted", " ", "by", " ", "the", " ", "Wolfram", " ", "TeX", " ", 
      "importer"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"textWithMath", "[", "t_String", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "r", "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"r", " ", "=", " ", 
         RowBox[{"StringReplace", "[", 
          RowBox[{
           RowBox[{"StringReplace", "[", 
            RowBox[{"t", ",", " ", 
             RowBox[{"\"\<\\\\_\>\"", " ", "->", " ", "\"\<_\>\""}]}], "]"}], 
           ",", " ", 
           RowBox[{
            RowBox[{"\"\<$\>\"", " ", "~~", " ", 
             RowBox[{"Shortest", "[", "m__", "]"}], " ", "~~", 
             " ", "\"\<$\>\""}], " ", ":>", " ", 
            RowBox[{"With", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"c", " ", "=", " ", 
                RowBox[{"Cases", "[", 
                 RowBox[{
                  RowBox[{"Quiet", "[", 
                   RowBox[{"ImportString", "[", 
                    RowBox[{
                    
                    RowBox[{"\"\<$\>\"", " ", "<>", " ", "m", " ", "<>", 
                    " ", "\"\<$\>\""}], ",", " ", "\"\<TeX\>\""}], "]"}], 
                   "]"}], ",", " ", 
                  RowBox[{
                   RowBox[{"Cell", "[", 
                    RowBox[{
                    RowBox[{"BoxData", "[", "f_FormBox", "]"}], ",", 
                    " ", "\"\<InlineFormula\>\"", ",", " ", "___"}], "]"}], 
                   " ", ":>", " ", "f"}], ",", " ", "Infinity"}], "]"}]}], 
               "}"}], ",", "\n", "        ", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"c", " ", "===", " ", 
                 RowBox[{"{", "}"}]}], ",", " ", 
                
                RowBox[{"\"\<$\>\"", " ", "<>", " ", "m", " ", "<>", 
                 " ", "\"\<$\>\""}], ",", " ", 
                RowBox[{"RawBoxes", "[", 
                 RowBox[{"First", "[", "c", "]"}], "]"}]}], "]"}]}], 
             "]"}]}]}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Head", "[", "r", "]"}], " ", "===", " ", 
           "StringExpression"}], ",", " ", 
          RowBox[{"Row", "[", 
           RowBox[{"List", " ", "@@", " ", "r"}], "]"}], ",", " ", "r"}], 
         "]"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"one", " ", "row", " ", "of", " ", "the", " ", 
      RowBox[{"table", ":", " ", 
       RowBox[{"the", " ", "printed", " ", "symbols", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"a", " ", "Pane", " ", "of", " ", "fixed", " ", "width"}], ",",
           " ", 
          RowBox[{
          "in", " ", "which", " ", "the", " ", "list", " ", "of", " ", 
           "symbols", "\n", "   ", "may", " ", "break", " ", "after", " ", 
           "a", " ", "comma"}]}], ")"}]}]}]}], ",", " ", 
     RowBox[{
      RowBox[{"the", " ", "plain"}], "-", 
      RowBox[{"text", " ", "names"}]}], ",", " ", 
     RowBox[{
      RowBox[{
      "and", " ", "the", " ", "meaning", " ", "in", " ", "the", " ", "text", " ",
        "font"}], ";", " ", 
      RowBox[{"the", " ", "three", "\n", "   ", "widths", " ", 
       RowBox[{"(", 
        RowBox[{"125", " ", "+", " ", "95", " ", "+", " ", 
         RowBox[{"290", " ", 
          RowBox[{"printer", "'"}], "s", " ", "points"}]}], ")"}], " ", "let",
        " ", "the", " ", "table", " ", "fit", " ", "the", " ", "width", " ", 
       "of", " ", "a", " ", "printed", " ", "page"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"symbolRow", "[", "e_", "]"}], " ", ":=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Pane", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"StringContainsQ", "[", 
            RowBox[{
             RowBox[{"e", "[", "\"\<symbol\>\"", "]"}], ",", 
             " ", "\"\<$\>\""}], "]"}], ",", "\n", "      ", 
           RowBox[{"Row", "[", 
            RowBox[{"Riffle", "[", 
             RowBox[{
              RowBox[{"Map", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"RawBoxes", "[", 
                  RowBox[{"SL31TeXToBoxes", "[", "#", "]"}], "]"}], " ", 
                 "&"}], ",", "\n", "        ", 
                RowBox[{"Flatten", "[", 
                 RowBox[{"Map", "[", 
                  RowBox[{"SL31SplitTeX", ",", " ", 
                   RowBox[{"StringCases", "[", 
                    RowBox[{
                    RowBox[{"e", "[", "\"\<symbol\>\"", "]"}], ",", " ", 
                    RowBox[{
                    RowBox[{"\"\<$\>\"", " ", "~~", " ", 
                    RowBox[{"Shortest", "[", "x__", "]"}], " ", "~~", 
                    " ", "\"\<$\>\""}], " ", ":>", " ", "x"}]}], "]"}]}], 
                  "]"}], "]"}]}], "]"}], ",", " ", "\"\<, \>\""}], "]"}], 
            "]"}], ",", "\n", "      ", 
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"e", "[", "\"\<symbol\>\"", "]"}], ",", " ", "9"}], 
            "]"}]}], "]"}], ",", " ", "125"}], "]"}], ",", "\n", "   ", 
       RowBox[{"Pane", "[", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"StringRiffle", "[", 
            RowBox[{
             RowBox[{"e", "[", "\"\<names\>\"", "]"}], ",", 
             " ", "\"\< \>\""}], "]"}], ",", " ", 
           RowBox[{"FontFamily", " ", "->", " ", "\"\<Source Code Pro\>\""}], 
           ",", " ", "8"}], "]"}], ",", " ", "95"}], "]"}], ",", "\n", "   ", 
       
       RowBox[{"Pane", "[", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"textWithMath", "[", 
            RowBox[{"e", "[", "\"\<meaning\>\"", "]"}], "]"}], ",", " ", 
           "9.5", ",", " ", 
           RowBox[{
           "FontFamily", " ", "->", " ", "\"\<Source Sans Pro\>\""}]}], "]"}],
          ",", " ", "290"}], "]"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"groupTable", "[", "g_", "]"}], " ", ":=", " ", 
     RowBox[{"Grid", "[", 
      RowBox[{
       RowBox[{"Prepend", "[", 
        RowBox[{
         RowBox[{"Map", "[", 
          RowBox[{"symbolRow", ",", " ", 
           RowBox[{"Select", "[", 
            RowBox[{"SL31Registry", ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"#", "[", "\"\<group\>\"", "]"}], " ", "===", " ", 
               "g"}], " ", "&"}]}], "]"}]}], "]"}], ",", "\n", "    ", 
         RowBox[{
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{"#", ",", " ", "Bold", ",", " ", 
             RowBox[{
             "FontFamily", " ", "->", " ", "\"\<Source Sans Pro\>\""}]}], 
            "]"}], " ", "&"}], " ", "/@", " ", 
          RowBox[{"{", 
           
           RowBox[{"\"\<symbol\>\"", ",", " ", "\"\<plain-text names\>\"", ",",
             " ", "\"\<meaning\>\""}], "}"}]}]}], "]"}], ",", "\n", "   ", 
       RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
       RowBox[{"Alignment", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"Left", ",", " ", "Top"}], "}"}]}], ",", " ", 
       RowBox[{"Background", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"None", ",", " ", 
          RowBox[{"{", "LightGray", "}"}]}], "}"}]}], ",", " ", 
       RowBox[{"Spacings", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "0.6"}], "}"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"groups", " ", "=", " ", 
     RowBox[{"DeleteDuplicates", "[", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", "\"\<group\>\"", "]"}], " ", "&"}], ",", " ", 
        "SL31Registry"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{"Length", "[", "groups", "]"}]}]}]], "Input",ExpressionUUID->\
"d81f43d5-fa83-45ed-956f-71e0b35b2ef0"],

