                   RowBox[{"gammaAt", "[", 
                    RowBox[{"x", ",", " ", "q"}], "]"}]}], "]"}]}]}], ";", 
               "\n", "     ", 
               RowBox[{"ap", " ", "=", " ", 
                RowBox[{"aAt", "[", 
                 RowBox[{"x", ",", " ", "p"}], "]"}]}], ";", " ", 
               RowBox[{"aq", " ", "=", " ", 
                RowBox[{"aAt", "[", 
                 RowBox[{"x", ",", " ", "q"}], "]"}]}], ";", "\n", "     ", 
               RowBox[{"fv", " ", "=", " ", 
                RowBox[{"Table", "[", 
                 RowBox[{
