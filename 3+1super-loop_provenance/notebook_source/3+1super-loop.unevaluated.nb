               RowBox[{"g", "^", "2"}], " ", "+", " ", "1."}], "]"}]}], ";", 
            "\n", "     ", 
            RowBox[{"g", " ", "=", " ", 
             RowBox[{
              RowBox[{"d", "[", 
               RowBox[{"[", "mm", "]"}], "]"}], " ", "-", " ", 
              RowBox[{"d", "[", 
               RowBox[{"[", "l", "]"}], "]"}], " ", "+", " ", 
              RowBox[{
               RowBox[{"e", "[", 
                RowBox[{"[", "l", "]"}], "]"}], "/", 
               RowBox[{"(", 
                RowBox[{"g", " ", "+", " ", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"g", " ", ">=", " ", "0"}], ",", " ", 
                   RowBox[{"Abs", "[", "r", "]"}], ",", " ", 
                   RowBox[{"-", 
                    RowBox[{"Abs", "[", "r", "]"}]}]}], "]"}]}], ")"}]}]}]}], 
            ";", "\n", "     ", 
            RowBox[{"sr", " ", "=", " ", "1."}], ";", " ", 
            RowBox[{"cr", " ", "=", " ", "1."}], ";", " ", 
            RowBox[{"pp", " ", "=", " ", "0."}], ";", "\n", "     ", 
            RowBox[{"i", " ", "=", " ", 
             RowBox[{"mm", " ", "-", " ", "1"}]}], ";", " ", 
            RowBox[{"underflow", " ", "=", " ", "False"}], ";", "\n", "     ", 
            RowBox[{"While", "[", 
             RowBox[{
              RowBox[{"i", " ", ">=", " ", "l"}], ",", "\n", "      ", 
              RowBox[{
               RowBox[{"f", " ", "=", " ", 
                RowBox[{"sr", " ", 
                 RowBox[{"e", "[", 
                  RowBox[{"[", "i", "]"}], "]"}]}]}], ";", " ", 
               RowBox[{"b", " ", "=", " ", 
                RowBox[{"cr", " ", 
                 RowBox[{"e", "[", 
                  RowBox[{"[", "i", "]"}], "]"}]}]}], ";", "\n", "      ", 
               RowBox[{"r", " ", "=", " ", 
                RowBox[{"Sqrt", "[", 
                 RowBox[{
                  RowBox[{"f", "^", "2"}], " ", "+", " ", 
                  RowBox[{"g", "^", "2"}]}], "]"}]}], ";", "\n", "      ", 
               RowBox[{
                RowBox[{"e", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}], " ", "=", 
                " ", "r"}], ";", "\n", "      ", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"r", " ", "==", " ", "0."}], ",", " ", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"d", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}], " ", "-=",
                    " ", "pp"}], ";", " ", 
                  RowBox[{
                   RowBox[{"e", "[", 
                    RowBox[{"[", "mm", "]"}], "]"}], " ", "=", " ", "0."}], ";",
                   " ", 
                  RowBox[{"underflow", " ", "=", " ", "True"}], ";", " ", 
                  RowBox[{"Break", "[", "]"}]}]}], "]"}], ";", "\n", "      ", 
               RowBox[{"sr", " ", "=", " ", 
                RowBox[{"f", "/", "r"}]}], ";", " ", 
               RowBox[{"cr", " ", "=", " ", 
                RowBox[{"g", "/", "r"}]}], ";", "\n", "      ", 
               RowBox[{"g", " ", "=", " ", 
                RowBox[{
                 RowBox[{"d", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}], " ", "-", 
                 " ", "pp"}]}], ";", "\n", "      ", 
               RowBox[{"r", " ", "=", " ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"d", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], " ", "-", " ", "g"}], 
                   ")"}], " ", "sr"}], " ", "+", " ", 
                 RowBox[{"2", " ", "cr", " ", "b"}]}]}], ";", "\n", "      ", 
               
               RowBox[{"pp", " ", "=", " ", 
                RowBox[{"sr", " ", "r"}]}], ";", "\n", "      ", 
               RowBox[{
                RowBox[{"d", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}], " ", "=", 
                " ", 
                RowBox[{"g", " ", "+", " ", "pp"}]}], ";", "\n", "      ", 
               RowBox[{"g", " ", "=", " ", 
                RowBox[{
                 RowBox[{"cr", " ", "r"}], " ", "-", " ", "b"}]}], ";", "\n", 
               "      ", 
               RowBox[{"(*", " ", 
                RowBox[{
                 RowBox[{
                 "rotate", " ", "the", " ", "rows", " ", "i", " ", "and", " ",
                   "i"}], " ", "+", " ", 
                 RowBox[{"1", " ", "of", " ", "zt"}]}], " ", "*)"}], "\n", 
               "      ", 
               RowBox[{"z0", " ", "=", " ", 
                RowBox[{"zt", "[", 
                 RowBox[{"[", "i", "]"}], "]"}]}], ";", " ", 
               RowBox[{"z1", " ", "=", " ", 
                RowBox[{"zt", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}]}], ";", 
               "\n", "      ", 
               RowBox[{
                RowBox[{"zt", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}], " ", "=", 
                " ", 
                RowBox[{
                 RowBox[{"z0", " ", "sr"}], " ", "+", " ", 
                 RowBox[{"z1", " ", "cr"}]}]}], ";", "\n", "      ", 
               RowBox[{
                RowBox[{"zt", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], " ", "=", " ", 
                RowBox[{
                 RowBox[{"z0", " ", "cr"}], " ", "-", " ", 
                 RowBox[{"z1", " ", "sr"}]}]}], ";", "\n", "      ", 
               RowBox[{"i", "--"}]}]}], "]"}], ";", "\n", "     ", 
            RowBox[{"If", "[", 
             RowBox[{"underflow", ",", " ", 
              RowBox[{"Continue", "[", "]"}]}], "]"}], ";", "\n", "     ", 
            RowBox[{
             RowBox[{"d", "[", 
              RowBox[{"[", "l", "]"}], "]"}], " ", "-=", " ", "pp"}], ";", 
            " ", 
            RowBox[{
             RowBox[{"e", "[", 
              RowBox[{"[", "l", "]"}], "]"}], " ", "=", " ", "g"}], ";", " ", 
            
            RowBox[{
             RowBox[{"e", "[", 
              RowBox[{"[", "mm", "]"}], "]"}], " ", "=", " ", "0."}]}]}], 
          "]"}]}], ",", "\n", "    ", 
        RowBox[{"{", 
         RowBox[{"l", ",", " ", "1", ",", " ", "n"}], "}"}]}], "]"}], ";", 
      "\n", "   ", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"sort", " ", "the", " ", "eigenvalues", " ", "ascending"}], ";",
         " ", 
        RowBox[{
        "the", " ", "eigenvectors", " ", "are", " ", "the", " ", "columns", " ",
          "of", " ", 
         RowBox[{"q", " ", ".", " ", 
          RowBox[{"Transpose", "[", "zt", "]"}]}]}]}], " ", "*)"}], "\n", 
      "   ", 
      RowBox[{"idx", " ", "=", " ", 
       RowBox[{"Ordering", "[", "d", "]"}]}], ";", "\n", "   ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"d", "[", 
         RowBox[{"[", "idx", "]"}], "]"}], ",", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"q", " ", ".", " ", 
           RowBox[{"Transpose", "[", "zt", "]"}]}], ")"}], "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "idx"}], "]"}], "]"}]}], "}"}]}]}], 
    "]"}]}], ";"}]], "Input",ExpressionUUID->"fc40754a-8913-4faf-af27-\
49d09f630a62"],

Cell[TextData[{
 "A first test of the rewritten routines on a random ",
 Cell[BoxData[
  FormBox[
   RowBox[{"9", "\[Times]", "9"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "904d4a66-3f70-4c0b-8758-61db971262bc"],
 " Hermitian matrix and a random ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", "\[Times]", "3"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8399f1ed-8126-4e56-86aa-b73d00d6bff5"],
 " matrix, against the built-in functions ",
 StyleBox["Eigenvalues",
  FontFamily->"Source Code Pro"],
 " and ",
 StyleBox["MatrixExp",
  FontFamily->"Source Code Pro"],
 " (the full tests of the eigensolver are the check GS-11 below)."
}], "Text",ExpressionUUID->"d3ff8160-4f44-46ce-8401-56f357b5373b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"t2Seed", "[", "12345", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"t2testH", " ", "=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"z", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"t2UnitC", "[", "]"}], ",", " ", 
         RowBox[{"{", "9", "}"}], ",", " ", 
         RowBox[{"{", "9", "}"}]}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"z", " ", "+", " ", 
      RowBox[{"ConjugateTranspose", "[", "z", "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"t2testM", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"t2UnitC", "[", "]"}], ",", " ", 
     RowBox[{"{", "3", "}"}], ",", " ", 
     RowBox[{"{", "3", "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"t2testVals", ",", " ", "t2testVecs"}], "}"}], " ", "=", " ", 
   RowBox[{"t2eigh", "[", "t2testH", "]"}]}], ";"}], "\n", 
 RowBox[{"SL31Check", "[", 
  RowBox[{"\"\<T2-LINALG\>\"", ",", 
   " ", "\"\<the rewritten eigensolver and matrix exponential of cmat.rs \
agree with Eigenvalues and MatrixExp of the Wolfram Language\>\"", ",", "\n", 
   "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{"t2testVals", " ", "-", " ", 
        RowBox[{"Sort", "[", 
         RowBox[{"Re", "[", 
          RowBox[{"Eigenvalues", "[", "t2testH", "]"}], "]"}], "]"}]}], "]"}],
       "]"}], " ", "<", " ", "1*^-12"}], " ", "&&", "\n", "   ", 
    RowBox[{
     RowBox[{"Norm", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"t2testVecs", " ", ".", " ", 
         RowBox[{"DiagonalMatrix", "[", "t2testVals", "]"}], " ", ".", " ", 
         RowBox[{"ConjugateTranspose", "[", "t2testVecs", "]"}]}], " ", "-", 
        " ", "t2testH"}], ",", " ", "\"\<Frobenius\>\""}], "]"}], " ", "<", 
     " ", "1*^-12"}], " ", "&&", "\n", "   ", 
    RowBox[{
     RowBox[{"Norm", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"t2expm", "[", "t2testM", "]"}], " ", "-", " ", 
        RowBox[{"MatrixExp", "[", "t2testM", "]"}]}], ",", 
       " ", "\"\<Frobenius\>\""}], "]"}], " ", "<", " ", "1*^-13"}]}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{"t2testVals", " ", "-", " ", 
        RowBox[{"Sort", "[", 
         RowBox[{"Re", "[", 
          RowBox[{"Eigenvalues", "[", "t2testH", "]"}], "]"}], "]"}]}], "]"}],
       "]"}], ",", " ", 
     RowBox[{"Norm", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"t2expm", "[", "t2testM", "]"}], " ", "-", " ", 
        RowBox[{"MatrixExp", "[", "t2testM", "]"}]}], ",", 
       " ", "\"\<Frobenius\>\""}], "]"}]}], "}"}]}], "]"}]}], "Input",Expressi\
onUUID->"8c07facd-eb1a-41bb-9102-376d9c022bc1"],

Cell["\<\
II.1.3 The super-loop operators as matrices (t2core/src/model.rs)\
\>", "Subsection",ExpressionUUID->"cfdf594b-c5d1-4328-b898-cb2e40e89e93"],

Cell[TextData[{
 "Every matrix of the field equations is built from the matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "262771cd-779f-4b07-be46-630514d99f56"],
 " of a bi-quaternion. A bi-quaternion ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["b",
     FontWeight->"Bold",
     FontSlant->"Plain"], "\[LongEqual]", 
    UnderoverscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["p", "TI"], "\[LongEqual]", "0"}], "3",
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox["\[Xi]", 
     StyleBox["p", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["p", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2af17317-acd9-4d48-83fa-417a030b1355"],
 " (four complex coefficients ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Xi]", 
     StyleBox["p", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4af0d086-8bc9-43c3-ab7d-d65ae937a510"],
 ") has the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Times]", "2"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d8f81872-c1e2-4887-b324-a02cf3c0de8a"],
 " matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[LongEqual]", 
    SubsuperscriptBox["\[Xi]", "0", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    SubsuperscriptBox["\[Sigma]", "0", 
     StyleBox["LL",
      FontSlant->"Plain"]], "-", 
    StyleBox["i", "TI"], "\[ThinSpace]", 
    UnderoverscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["j", "TI"], "\[LongEqual]", "1"}], "3",
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox["\[Xi]", 
     StyleBox["j", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    SubsuperscriptBox["\[Sigma]", 
     StyleBox["j", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a552af38-cecb-45f8-a5f8-dffccb1bded9"],
 ", so that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubscriptBox[
      StyleBox["e",
       FontWeight->"Bold",
       FontSlant->"Plain"], "0"], ")"}], "\[LongEqual]", 
    SubsuperscriptBox["\[Sigma]", "0", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b460cf3e-99cc-4053-99d5-8e1c0b942d39"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubscriptBox[
      StyleBox["e",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      StyleBox["j", "TI"]], ")"}], "\[LongEqual]", 
    RowBox[{"-", 
     StyleBox["i", "TI"]}], 
    SubsuperscriptBox["\[Sigma]", 
     StyleBox["j", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "44874482-aaea-4595-afb0-582beb6fcf78"],
 ". The canonical frame of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[DoubleStruckCapitalR]",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    RowBox[{"1", ",", "3"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e818801e-e36c-4a3f-8241-380970d26b5b"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["f",
      FontWeight->"Bold",
      FontSlant->"Plain"], "0"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "0"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3b5f940b-ef9a-4503-8b68-7d618dbf0f97"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["f",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]], "\[LongEqual]", 
    StyleBox["i", "TI"], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "44ee5743-1d29-46d4-8e1e-c5823716e669"],
 ", with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubscriptBox[
      StyleBox["f",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      StyleBox["p", "TI"]], ")"}], "\[LongEqual]", 
    SubsuperscriptBox["\[Sigma]", 
     StyleBox["p", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "53637fc1-ba8f-43e7-a6d0-cf26fb61837f"],
 ". The Dirac matrices of a frame are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p", "TI"]], 
    RowBox[{"[", 
     StyleBox["f",
      FontWeight->"Bold",
      FontSlant->"Plain"], "]"}], "\[LongEqual]", 
    RowBox[{"(", "\[NoBreak]", GridBox[{
       {"0", 
        RowBox[{
         SubscriptBox[
          StyleBox["M", "TI"], 
          StyleBox["LL",
           FontSlant->"Plain"]], 
         RowBox[{"(", 
          SubscriptBox[
           StyleBox["f",
            FontWeight->"Bold",
            FontSlant->"Plain"], 
           StyleBox["p", "TI"]], ")"}]}]},
       {
        RowBox[{
         SubscriptBox[
          StyleBox["M", "TI"], 
          StyleBox["LL",
           FontSlant->"Plain"]], 
         RowBox[{"(", 
          SubscriptBox[
           OverscriptBox[
            StyleBox["f",
             FontWeight->"Bold",
             FontSlant->"Plain"], "_"], 
           StyleBox["p", "TI"]], ")"}]}], "0"}
      },
      GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
      GridBoxSpacings->{"Columns" -> {
          Offset[0.27999999999999997`], {
           Offset[0.7]}, 
          Offset[0.27999999999999997`]}, "Rows" -> {
          Offset[0.2], {
           Offset[0.4]}, 
          Offset[0.2]}}], "\[NoBreak]", ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e4f55333-7fcd-4e54-8275-973d05165d36"],
 " (the chiral basis; ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["b",
     FontWeight->"Bold",
     FontSlant->"Plain"], "_"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1dd4631a-0a61-430f-926b-f51279800927"],
 " is the conjugate bi-quaternion, in which the signs of the coefficients of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "1"], ",", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "2"], ",", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold",
      FontSlant->"Plain"], "3"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "beab1b8d-1ba8-4c94-9082-b64de4735128"],
 " change); for the canonical frame they are ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Gamma]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "faefbf92-744b-49b0-9c5f-aafb82390671"],
 ". The spinor field ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e3a70f5a-779a-47c8-b7c9-eaff611cdd84"],
 " has the 8 components ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPsi]", 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", "1"}]], ",", "\[Ellipsis]", ",", 
    SubscriptBox["\[CapitalPsi]", 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", "8"}]]}], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f48810af-f343-4b23-abf3-e19e9b178747"],
 ": components 1 and 2 are the first Dirac component with isospin up and \
down, 3 and 4 the second, 5 and 6 the third, 7 and 8 the fourth. A ",
 Cell[BoxData[
  FormBox[
   RowBox[{"4", "\[Times]", "4"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a5d375c4-0159-4255-a538-dfd63a460cb9"],
 " matrix of the Dirac index therefore acts on the eight components as its \
Kronecker product with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["1",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "346a88a4-cbab-4f2f-a726-88e6a8b0b67b"],
 ", and a ",
 Cell[BoxData[
  FormBox[
