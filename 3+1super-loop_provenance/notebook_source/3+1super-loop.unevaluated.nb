       RowBox[{"GridLinesStyle", " ", "->", " ", 
        RowBox[{"Directive", "[", 
         RowBox[{"GrayLevel", "[", "0.9", "]"}], "]"}]}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "470"}], ",", "\n", "   ", 
       RowBox[{"Epilog", " ", "->", " ", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Text", "[", 
             RowBox[{
              RowBox[{"tolShort", "[", "kt", "]"}], ",", " ", 
              RowBox[{"Log", "[", 
               RowBox[{"idaWork", "[", 
                RowBox[{"[", "kt", "]"}], "]"}], "]"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "1.6"}], ",", " ", "0"}], "}"}]}], "]"}], ",", 
            " ", 
            RowBox[{"{", 
             RowBox[{"kt", ",", " ", "3"}], "}"}]}], "]"}], ",", "\n", 
          "     ", 
          RowBox[{"MapThread", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Text", "[", 
              RowBox[{
               RowBox[{"tolShort", "[", "#1", "]"}], ",", " ", 
               RowBox[{"Log", "[", 
                RowBox[{"cvWork", "[", 
                 RowBox[{"[", "#1", "]"}], "]"}], "]"}], ",", " ", "#2"}], 
              "]"}], " ", "&"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"1.6", ",", " ", "0"}], "}"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"1.3", ",", " ", "1.8"}], "}"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"1.6", ",", " ", "0"}], "}"}]}], "}"}]}], "}"}]}], 
           "]"}]}], "]"}]}], ",", "\n", "   ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"upright", "[", 
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             
             RowBox[{"\"\<(b) accuracy against work; the labels are \>\"", ",",
               " ", "rtolSym"}], "}"}], "]"}], "]"}], ",", " ", "12"}], 
         "]"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"legend2", " ", "=", " ", 
     RowBox[{"LineLegend", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"idaStyle", ",", " ", "cvStyle"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<IDA (this notebook)\>\"", ",", 
         " ", "\"\<CVODE (original program t2_fields)\>\""}], "}"}], ",", " ", 
       RowBox[{"LegendLayout", " ", "->", " ", "\"\<Row\>\""}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{"Labeled", "[", 
    RowBox[{
     RowBox[{"Column", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Row", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"fig2a", ",", " ", "fig2b"}], "}"}], ",", 
           " ", "\"\<  \>\""}], "]"}], ",", " ", "legend2"}], "}"}], ",", " ",
        "Center"}], "]"}], ",", "\n", "  ", 
     RowBox[{"Style", "[", 
      RowBox[{"\"\<Figure 2. The time integration of the lattice equations \
(item [1], check GS-13): IDA in this notebook and CVODE in the original \
program.\>\"", ",", " ", "11"}], "]"}], ",", " ", "Top"}], "]"}]}]}]], "Input",\
ExpressionUUID->"eeee3972-f8cb-48e4-adcd-a0fc3dc720fc"],

Cell["Summary of item [1]", "Subsection",ExpressionUUID->"abf4dd62-ea50-4d5f-8d67-082e9bfa7ef1"],

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"#", "[", "\"\<name\>\"", "]"}], ",", " ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"#", "[", "\"\<pass\>\"", "]"}], ",", " ", 
            RowBox[{"Style", "[", 
             RowBox[{"\"\<PASS\>\"", ",", " ", 
              RowBox[{"Darker", "[", "Green", "]"}]}], "]"}], ",", " ", 
            RowBox[{"Style", "[", 
             RowBox[{"\"\<FAIL\>\"", ",", " ", "Red"}], "]"}]}], "]"}], ",", 
          " ", 
          RowBox[{"#", "[", "\"\<statement\>\"", "]"}]}], "}"}], " ", "&"}], ",",
        "\n", "    ", 
       RowBox[{"Select", "[", 
        RowBox[{"SL31`Test`$Results", ",", " ", 
         RowBox[{
          RowBox[{"StringStartsQ", "[", 
           RowBox[{
            RowBox[{"#", "[", "\"\<name\>\"", "]"}], ",", " ", 
            RowBox[{"\"\<GS-\>\"", " ", "|", " ", "\"\<T2-\>\""}]}], "]"}], 
          " ", "&"}]}], "]"}]}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"#", ",", " ", "Bold"}], "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<check\>\"", ",", " ", "\"\<result\>\"", ",", 
        " ", "\"\<statement\>\""}], "}"}]}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"(*", " ", 
    RowBox[{"no", " ", "fixed", " ", "column", " ", 
     RowBox[{"widths", ":", " ", 
      RowBox[{
      "the", " ", "front", " ", "end", " ", "wraps", " ", "the", " ", 
       "statements", " ", "at", " ", "the", " ", "width", " ", "of", " ", 
       "the", " ", "window", " ", "or", " ", "of", " ", "the", " ", "printed",
        " ", "page"}]}]}], " ", "*)"}], "\n", "  ", 
   RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Alignment", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"Left", ",", " ", "Top"}], "}"}]}]}], "]"}]], "Input",ExpressionU\
UID->"0a5b06f8-d202-4dba-955b-80550bd05c6b"],

Cell["\<\
II.3 Item [2]: analytic solutions of the field equations, and the checks AS-1 \
to AS-10 (program t2_analytic)\
\>", "Section",ExpressionUUID->"4ca86928-70ca-40cf-9e2d-f3098a9a6fbb"],

Cell[TextData[{
 "The program t2_analytic (t2analytic/src/main.rs) answers item [2] of Test \
2, which asks for an analysis of the field equations and for analytic \
solutions of simple cases. It solves the mean-field (Dirac-Bogoliubov-de \
Gennes) equations exactly in four cases and checks every solution twice: \
against the continuum equations, and against the lattice operator ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalH]",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["lat",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bb790ed0-37a6-420c-99bc-c2f7ecb7491b"],
 " of chapter II.1.4, the operator that the solvers of the items [3] and [5] \
integrate. The solutions are therefore also test problems with known answers \
for those solvers. The cases are: A, free spinor charges in constant gauge \
potentials (checks AS-1 and AS-2); B, the uniform polar superfluid (AS-3 to \
AS-6); C, a domain wall of the pair field (AS-7 to AS-9); D, constant \
magnetic fields (AS-10). The rewriting below keeps the order of the original \
program, because its random numbers are drawn in that order from one \
generator with the seed 2026111708; the checks AS-3, AS-7 and AS-8 draw \
random numbers, the others draw none. Every check prints one line with PASS \
or FAIL. The statement is that of the original report (in the two checks with \
a time integration, AS-2 and AS-4, it names IDA in place of CVODE and states \
what is required of IDA); the numbers in the details are the results of the \
Wolfram Language, followed by the values of the original report."
}], "Text",ExpressionUUID->"a6c4266f-62a7-4dcd-a0a2-f0b59152a9be"],

Cell[TextData[{
 StyleBox["The equations.",
  FontWeight->"Bold"],
 " All four cases are computed in the canonical gauge, in which the spin \
connection vanishes (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalGamma]", 
     StyleBox["p", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7fe33fcb-0511-4e06-8749-2ac52c0e5d71"],
 "); a gauge transformation carries every solution into any other gauge. A \
mode has the particle part ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Psi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1c4a2078-b34a-4132-a746-0181a8262b05"],
 " and the hole part ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Psi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["h",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0c2a29a7-6bd1-4c8f-aa4d-0ce8dfa28a1d"],
 ", each with the eight components of chapter II.1.3 (the components 1, 3, 5, \
7 have isospin up, the components 2, 4, 6, 8 isospin down). The mean-field \
equations are"
}], "Text",ExpressionUUID->"e34d0a20-b261-411c-8bcc-4c24fbc7f8f8"],

Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox["i", "TI"], 
   SubscriptBox["\[PartialD]", "0"], 
   SubsuperscriptBox["\[Psi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p",
     FontSlant->"Plain"]], "\[LongEqual]", 
   RowBox[{"(", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["h", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], "\[Del]"], "-", 
     SubscriptBox[
      StyleBox["A",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["LL",
        FontSlant->"Plain"], ",", "0"}]], "-", 
     SubscriptBox["\[Mu]", 
      StyleBox["LL",
       FontSlant->"Plain"]]}], ")"}], 
   SubsuperscriptBox["\[Psi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p",
     FontSlant->"Plain"]], "+", 
   SubscriptBox[
    StyleBox["P",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   SubsuperscriptBox["\[Psi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["h",
     FontSlant->"Plain"]]}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"9714cc99-585b-4d5f-a8ed-b885b80cd255"],

Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox["i", "TI"], 
   SubscriptBox["\[PartialD]", "0"], 
   SubsuperscriptBox["\[Psi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["h",
     FontSlant->"Plain"]], "\[LongEqual]", 
   SubsuperscriptBox[
    StyleBox["P",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Dagger]"], 
   SubsuperscriptBox["\[Psi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p",
     FontSlant->"Plain"]], "-", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["h", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "\[Del]"], "-", 
      SubscriptBox[
       StyleBox["A",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["LL",
         FontSlant->"Plain"], ",", "0"}]], "-", 
      SubscriptBox["\[Mu]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}], "*"], 
   SubsuperscriptBox["\[Psi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["h",
     FontSlant->"Plain"]]}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"4f0f7f7b-8020-4c39-9c97-e8e4517cd43d"],

Cell[TextData[{
 "with the covariant Dirac Hamiltonian ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["h", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Del]"], "\[LongEqual]", 
    RowBox[{"-", 
     StyleBox["i", "TI"]}], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", 
     StyleBox["j", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]], 
    SubsuperscriptBox["\[Del]", 
     StyleBox["j", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "+", 
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3d072296-92c9-4716-8ec7-a6ae1fe1133e"],
 ", the covariant derivative ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Del]", 
     StyleBox["j", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubscriptBox["\[PartialD]", 
     StyleBox["j", "TI"]], "-", 
    StyleBox["i", "TI"], 
    SubscriptBox[
     StyleBox["A",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["j", "TI"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "34c48ff0-266c-4a0f-a98c-d03c3177afc9"],
 ", the gauge matrices ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["A",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", "\[Iota]",
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], "\[Iota]"], 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Iota]"], "+", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], 
     StyleBox["F",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "8"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "596d9ebc-306c-4f69-9a7d-de9548fcd208"],
 " of the potentials, the chemical potential ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Mu]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "49e24f1f-bf9c-4c64-ba9d-8925ec7f7976"],
 ", and the pairing block ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["P",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", "\[Iota]",
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Iota]"], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "\[Iota]"], ")"}], "\[Dagger]"]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fed7ba13-042d-456a-9995-8d73e8bad3a7"],
 " of the order parameter ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["d", "TI"], "\[RightVector]"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["d", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "1"], ",", 
      SubsuperscriptBox[
       StyleBox["d", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "2"], ",", 
      SubsuperscriptBox[
       StyleBox["d", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a6203b78-517f-4102-98c4-bcfafee9b80c"],
 ". The matrices ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]], "\[LongEqual]", 
    StyleBox["diag",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       SubsuperscriptBox["\[Sigma]", 
        StyleBox["j", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"]]}], ",", 
      SubsuperscriptBox["\[Sigma]", 
       StyleBox["j", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f722c4c1-821d-46c9-b31d-b2992ab28e59"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], "0"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5ec2320b-e962-43cf-a9ad-92a9d5e9db62"],
 " act on the Dirac index, the potentials on the isospin index. The operator \
on the right side is the Dirac-Bogoliubov-de Gennes operator ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalH]",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["DB",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "eab5077b-a92c-4b79-b0b4-431be966a964"],
 "; a stationary mode depends on the time through the factor ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["exp",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       StyleBox["i", "TI"]}], 
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       RowBox[{
        StyleBox["LL",
         FontSlant->"Plain"], ",", 
        StyleBox["n", "TI"]}], 
       StyleBox["qp",
        FontSlant->"Plain"]], 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "0"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "270ab173-d0ea-4de8-aa64-4e4d4d2ab02f"],
 ", and its energy ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["E", "TI"], 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["n", "TI"]}], 
    StyleBox["qp",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f78c7220-8251-47a0-b930-c5f4483d5aa8"],
 " is an eigenvalue of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalH]",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["DB",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3a3f7e8f-ad69-4b7a-b598-3803a6ad4d3a"],
 ". If all fields are constant in space, the modes are plane waves, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["exp",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["i", "TI"], "\[ThinSpace]", 
      UnderscriptBox["\[Sum]", 
       StyleBox["j", "TI"],
       LimitsPositioning->True], "\[ThinSpace]", 
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["j", "TI"]], 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["j", "TI"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d27e883a-d160-4ec1-adb1-0c7d1385eedb"],
 " times a constant vector of 16 components, and the field equations are the \
eigenvalue problem of a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"16", "\[Times]", "16"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3a5b4f82-1f30-44f6-9d04-96521626a530"],
 " matrix."
}], "Text",ExpressionUUID->"97af060b-26bc-4a7c-b911-15d9816535b6"],

Cell[TextData[{
 StyleBox["The lattice of the checks.",
  FontWeight->"Bold"],
 " Every lattice of this chapter is a periodic chain (a ring) of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["x",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9ecbc6e9-8ab1-47d9-909e-0044a1bb85d2"],
 " sites along ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "1"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "50c7ab4b-af77-4d6f-a149-f851344b3aac"],
 ", with the spacing ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[ScriptL]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["x",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fc4dd037-4342-43fd-a6f4-c9f0a25805cd"],
 " and the Wilson coefficient ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["W",
      FontSlant->"Plain"]], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1542ac77-56c1-49db-ab30-e143bbf56914"],
 ". Its allowed momenta ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["q", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "1"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7d58b956-c354-4ad6-94a9-b23f5fe30d38"],
 " are the integer multiples of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Pi]", "/", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["n", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["x",
        FontSlant->"Plain"]], 
      SubsuperscriptBox["\[ScriptL]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["x",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ca28e344-5696-46ee-a0b7-dcafa6d857af"],
 "; the function ",
 StyleBox["t2chainMomentum",
  FontFamily->"Source Code Pro"],
 " returns the allowed momentum with a given number (counted from 0) in the \
interval from ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "\[Pi]"}], "/", 
    SubsuperscriptBox["\[ScriptL]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["x",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "53f4a865-f39b-4806-b391-da1ac58e0bc6"],
 " (excluded) to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Pi]", "/", 
    SubsuperscriptBox["\[ScriptL]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["x",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7327d7ee-099c-4b30-b35f-82b3bd8f753b"],
 " (included). If the fields are the same on every site, the lattice operator \
maps a plane wave to a plane wave of the same momentum, as in check GS-16; \
the function ",
 StyleBox["t2planeMatrix",
  FontFamily->"Source Code Pro"],
 " applies the operator to the 16 plane waves of one momentum (one for each \
component of a site) and returns the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"16", "\[Times]", "16"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fd8b3396-06e5-41ce-83b5-60e778780e1f"],
 " matrix of their images at the first site. The function ",
 StyleBox["t2h8",
  FontFamily->"Source Code Pro"],
 " returns the matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["h",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["q", "TI"], "\[RightVector]"], 
      StyleBox["LL",
       FontSlant->"Plain"]], ")"}], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", 
     StyleBox["j", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]], 
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]], "+", 
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "650eba53-8e54-4277-8587-28a335adfcd1"],
 " of a plane wave of the continuum, as an ",
 Cell[BoxData[
  FormBox[
   RowBox[{"8", "\[Times]", "8"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "697905c2-66e5-41cb-b658-b4f02704e925"],
 " matrix (it acts as the unit matrix on the isospin index). The cell also \
sets the seed and the matrices that several checks use; they are exact (their \
entries are the integers 0, 1, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c1289f20-671b-423b-8930-cc103364cd52"],
 " and the imaginary unit)."
}], "Text",ExpressionUUID->"cce8d6e3-7378-4616-9b0f-e9bc560aaaf1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "the", " ", "seed", " ", "of", " ", "the", " ", "program", " ", 
    "t2_analytic"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"t2Seed", "[", "2026111708", "]"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", "couplings", " ", 
      RowBox[{"g", "^", "v"}]}], ",", " ", 
     RowBox[{
      RowBox[{"g", "^", "F"}], " ", "and", " ", "the", " ", "mass", " ", 
      RowBox[{"m", ":", " ", 
       RowBox[{
       "the", " ", "same", " ", "numbers", " ", "as", " ", "in", " ", 
        "chapter", " ", "II", ".2", " ", 
        RowBox[{"(", 
         RowBox[{
         "the", " ", "original", " ", "program", " ", "sets", " ", "them", " ",
           "again"}], ")"}]}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"gv", " ", "=", " ", "0.7"}], ";", " ", 
    RowBox[{"gf", " ", "=", " ", "0.45"}], ";", " ", 
    RowBox[{"mass", " ", "=", " ", "0.4"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "a", " ", "chain", " ", "has", " ", "more", " ", "than", " ", "one", " ",
       "site", " ", "only", " ", "in", " ", "the", " ", "direction", " ", 
      RowBox[{"x", "^", "1"}]}], ":", " ", 
     RowBox[{
     "the", " ", "argument", " ", "of", " ", "t2epsLat", " ", "and", " ", 
      "t2hLatPlane", " ", "that", " ", "says", " ", "so"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"asChainActive", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"True", ",", " ", "False", ",", " ", "False"}], "}"}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", "places", " ", "of", " ", "the", " ", "isospin"}], "-", 
     RowBox[{"up", " ", "and", " ", "of", " ", "the", " ", "isospin"}], "-", 
     RowBox[{
     "down", " ", "components", " ", "among", " ", "the", " ", "eight", " ", 
      "components", " ", "of", " ", "a", " ", "site"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"asUpIndex", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "3", ",", " ", "5", ",", " ", "7"}], "}"}]}], ";",
     " ", 
    RowBox[{"asDownIndex", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "4", ",", " ", "6", ",", " ", "8"}], "}"}]}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "matrices", " ", "that", " ", "several", " ", "checks", " ", 
      
      RowBox[{"use", ":", " ", 
       RowBox[{"the", " ", "pair", " ", "matrix", " ", 
        RowBox[{"K", "^", "3"}], " ", "of", " ", "the", " ", "third", " ", 
        "isospin", " ", "direction", " ", "and", " ", "its", " ", "Hermitian",
         "\n", "   ", "conjugate"}]}]}], ",", " ", 
     RowBox[{"the", " ", "matrices", " ", 
      RowBox[{"alpha", "^", "1"}]}], ",", " ", 
     RowBox[{"alpha", "^", "2"}], ",", " ", 
     RowBox[{
      RowBox[{"alpha", "^", "3"}], " ", "and", " ", "beta", " ", "on", " ", 
      "the", " ", "eight", " ", "components", " ", 
      RowBox[{"(", 
       RowBox[{"Dirac", " ", 
        RowBox[{"(", "x", ")"}], " ", "isospin"}], ")"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"asK3", " ", "=", " ", 
     RowBox[{"t2kpair", "[", "3", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"asK3dag", " ", "=", " ", 
     RowBox[{"ConjugateTranspose", "[", "asK3", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"asAlpha", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"t2lift4", "[", 
        RowBox[{"t2alpha", "[", "j", "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"asBeta", " ", "=", " ", 
     RowBox[{"t2lift4", "[", "t2beta", "]"}]}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{" ", 
     RowBox[{
      RowBox[{
      "the", " ", "allowed", " ", "momentum", " ", "number", " ", "kq", " ", 
       RowBox[{"(", 
        RowBox[{"0", ",", " ", "1", ",", " ", "...", ",", " ", 
         RowBox[{"nsites", " ", "-", " ", "1"}]}], ")"}], " ", "of", " ", "a",
        " ", "periodic", " ", "chain", " ", "of", " ", "nsites", " ", "sites",
        " ", "with", " ", "the", " ", "spacing", " ", "ell"}], ",", "\n", 
      "   ", 
      RowBox[{"in", " ", "the", " ", "interval", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "pi"}], "/", "ell"}], ",", " ", 
         RowBox[{"pi", "/", "ell"}]}]}]}]}], "]"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2chainMomentum", "[", 
      RowBox[{"kq_Integer", ",", " ", "nsites_Integer", ",", " ", "ell_"}], 
      "]"}], " ", ":=", " ", 
     RowBox[{"2.", " ", "Pi", " ", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"kq", " ", "<=", " ", 
          RowBox[{"Quotient", "[", 
           RowBox[{"nsites", ",", " ", "2"}], "]"}]}], ",", " ", "kq", ",", 
         " ", 
         RowBox[{"kq", " ", "-", " ", "nsites"}]}], "]"}], "/", 
       RowBox[{"(", 
        RowBox[{"nsites", " ", "ell"}], ")"}]}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
      "the", " ", "16", " ", "x", " ", "16", " ", "matrix", " ", "of", " ", 
       "the", " ", "lattice", " ", "operator", " ", "on", " ", "the", " ", 
       "plane", " ", "waves", " ", "exp", 
       RowBox[{"(", 
        RowBox[{"i", " ", "q", " ", 
         RowBox[{"x", "^", "1"}]}], ")"}], " ", "e_b", " ", "of", " ", "a", " ",
        "periodic", " ", "chain", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"b", " ", "=", " ", 
          RowBox[{
           RowBox[{"1", ".."}], "16"}]}], ",", " ", 
         RowBox[{
         "the", "\n", "   ", "components", " ", "of", " ", "a", " ", 
          "site"}]}], ")"}]}], ":", " ", 
      RowBox[{
      "with", " ", "fields", " ", "that", " ", "are", " ", "the", " ", "same",
        " ", "on", " ", "every", " ", "site"}]}], ",", " ", 
     RowBox[{
      RowBox[{
      "the", " ", "image", " ", "of", " ", "a", " ", "plane", " ", "wave", " ",
        "is", " ", "a", " ", "plane", " ", "wave", " ", "of", "\n", "   ", 
       "the", " ", "same", " ", "momentum"}], ";", " ", 
      RowBox[{
      "its", " ", "16", " ", "components", " ", "at", " ", "the", " ", 
       "first", " ", "site", " ", "are", " ", "the", " ", "column", " ", 
       RowBox[{"b", ".", "  ", "The"}], " ", "16", " ", "plane", " ", "waves",
        " ", "are", " ", "the", " ", "columns", " ", "of", "\n", "   ", "the",
        " ", "matrix", " ", "planeWaves"}]}], ",", " ", 
     RowBox[{
     "to", " ", "which", " ", "t2apply", " ", "applies", " ", "the", " ", 
      "operator", " ", "column", " ", "by", " ", "column"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2planeMatrix", "[", 
      RowBox[{"lattice_", ",", " ", "fields_", ",", " ", "q_"}], "]"}], " ", ":=",
      " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"nsites", " ", "=", " ", 
          RowBox[{"t2nsites", "[", "lattice", "]"}]}], ",", " ", 
         "planeWaves"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"planeWaves", " ", "=", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Mod", "[", 
                RowBox[{
                 RowBox[{"row", " ", "-", " ", "1"}], ",", " ", "16"}], "]"}],
                " ", "+", " ", "1"}], " ", "==", " ", "b"}], ",", " ", 
             RowBox[{"Exp", "[", 
              RowBox[{"I", " ", "q", " ", 
               RowBox[{"lattice", "[", "\"\<ell\>\"", "]"}], " ", 
               RowBox[{"Quotient", "[", 
                RowBox[{
                 RowBox[{"row", " ", "-", " ", "1"}], ",", " ", "16"}], 
                "]"}]}], "]"}], ",", " ", 
             RowBox[{"0.", " ", "I"}]}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"row", ",", " ", 
             RowBox[{"16", " ", "nsites"}]}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"b", ",", " ", "16"}], "}"}]}], "]"}]}], ";", "\n", "   ", 
        RowBox[{
         RowBox[{"t2apply", "[", 
          RowBox[{"lattice", ",", " ", "fields", ",", " ", "planeWaves"}], 
          "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"1", " ", ";;", " ", "16"}], "]"}], "]"}]}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"h", 
       RowBox[{"(", "q", ")"}]}], " ", "=", " ", 
      RowBox[{
       RowBox[{"sum_j", " ", 
        RowBox[{"alpha", "^", "j"}], " ", "q_j"}], " ", "+", " ", 
       RowBox[{"beta", " ", "m", " ", "on", " ", "Dirac", " ", 
        RowBox[{"(", "x", ")"}], " ", "isospin", " ", 
        RowBox[{"(", 
         RowBox[{"8", " ", "x", " ", "8"}], ")"}]}]}]}], ",", " ", 
     RowBox[{
      RowBox[{"the", " ", "plane"}], "-", 
      RowBox[{
      "wave", " ", "Hamiltonian", " ", "of", " ", "the", " ", 
       "continuum"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2h8", "[", 
      RowBox[{"q_List", ",", " ", "m_"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"m", " ", "asBeta"}], " ", "+", " ", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"q", "[", 
          RowBox[{"[", "j", "]"}], "]"}], " ", 
         RowBox[{"asAlpha", "[", 
          RowBox[{"[", "j", "]"}], "]"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "numbers", " ", "in", " ", "the", " ", "details", " ", "of", " ", "the", 
      " ", 
      RowBox[{"checks", ":", " ", 
       RowBox[{
       "two", " ", "significant", " ", "digits", " ", "with", " ", "a", " ", 
        "power", " ", "of", " ", "ten"}]}]}], ";", " ", 
     RowBox[{"a", " ", "fixed", " ", "number", " ", "of", " ", "decimals"}]}],
     " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"asSci", "[", 
      RowBox[{"x_", "?", "NumericQ"}], "]"}], " ", ":=", " ", 
     RowBox[{"ScientificForm", "[", 
      RowBox[{"x", ",", " ", "2"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"asSci", "[", "l_List", "]"}], " ", ":=", " ", 
     RowBox[{"Row", "[", 
      RowBox[{"Riffle", "[", 
       RowBox[{
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"ScientificForm", "[", 
            RowBox[{"#", ",", " ", "2"}], "]"}], " ", "&"}], ",", " ", "l"}], 
         "]"}], ",", " ", "\"\<, \>\""}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"asFix", "[", 
      RowBox[{
       RowBox[{"x_", "?", "NumericQ"}], ",", " ", "decimals_Integer"}], "]"}],
      " ", ":=", " ", 
     RowBox[{"NumberForm", "[", 
      RowBox[{"x", ",", " ", 
       RowBox[{"{", 
        RowBox[{"20", ",", " ", "decimals"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "largest", " ", "deviation", " ", "of", " ", "the", " ", 
      "columns", " ", "cols", " ", "of", " ", "two", " ", "lists", " ", "of", 
      " ", "rows"}], ";", " ", 
     RowBox[{
     "Infinity", " ", "if", " ", "the", " ", "lists", " ", "have", " ", 
      "different", " ", "dimensions"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2rowsDeviation", "[", 
      RowBox[{"rowsHere_", ",", " ", "rowsOriginal_", ",", " ", "cols_"}], 
      "]"}], " ", ":=", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Dimensions", "[", "rowsHere", "]"}], " ", "===", " ", 
        RowBox[{"Dimensions", "[", "rowsOriginal", "]"}]}], ",", "\n", "   ", 
       
       RowBox[{"Max", "[", 
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"rowsHere", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "cols"}], "]"}], "]"}], " ", "-", " ", 
          RowBox[{"rowsOriginal", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "cols"}], "]"}], "]"}]}], "]"}], "]"}], ",",
        " ", "Infinity"}], "]"}]}], ";"}]}]}]], "Input",ExpressionUUID->\
"3564ca69-19e6-4020-b1c4-423156cbf049"],

Cell["\<\
Case A: free spinor charges in constant gauge potentials (checks AS-1 and \
AS-2)\
\>", "Subsection",ExpressionUUID->"cc7d8059-4d11-4e30-89a5-6b8c0fdca17e"],

Cell[TextData[{
 StyleBox["The fields.",
  FontWeight->"Bold"],
 " No pair field (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["d", "TI"], "\[RightVector]"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b10945fa-89af-4a22-94d0-e3e78b08ab54"],
 "), and constant potentials of the fermion number and of the third isospin \
direction, ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["A", "TI"], 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}], 
    StyleBox["F",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f7ed3d56-8ed3-4202-a89e-3d1557e99d7e"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["A", "TI"], 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a896d4a4-4c75-47d2-b33c-cf1358d14bb6"],
 ", with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], "1"], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], "2"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "144bc38c-424b-49f2-b01d-0afe9422dece"],
 ". The generator ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7504528a-2cc3-4dc3-90fc-c18ddd3f3e0f"],
 " is diagonal, so the gauge matrix ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["A",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8a9ece1c-0ee8-4d97-9638-673956a0a5a4"],
 " is diagonal in the isospin index: it has the eigenvalue ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["A",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], "\[UpArrow]"], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], 
     StyleBox["F",
      FontSlant->"Plain"]], "+", 
    FractionBox["1", "2"], 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], "3"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ff0ed340-44cc-42cb-9191-1a75afdeb014"],
 " on the isospin-up components (the charge ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["Q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "3"], "\[LongEqual]", 
    RowBox[{"+", 
     FractionBox["1", "2"]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dd7c00b8-674e-4bd2-aeba-9aa0a13fea47"],
 ") and the eigenvalue ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["A",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], "\[DownArrow]"], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], 
     StyleBox["F",
      FontSlant->"Plain"]], "-", 
    FractionBox["1", "2"], 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], "3"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "21322d61-c3fb-4b68-8db2-67767040767c"],
 " on the isospin-down components (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["Q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"-", 
     FractionBox["1", "2"]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fa66a02c-c19f-4ca1-81ab-329869332ea6"],
 "). The field strengths vanish."
}], "Text",ExpressionUUID->"cb6fa3dc-9cb8-4b36-a422-d9729facb199"],

Cell[TextData[{
 StyleBox["The solution.",
  FontWeight->"Bold"],
 " Take a particle of isospin up, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Psi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p",
      FontSlant->"Plain"]], "\[LongEqual]", 
    StyleBox["exp",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["i", "TI"], "\[ThinSpace]", 
      UnderscriptBox["\[Sum]", 
       StyleBox["j", "TI"],
       LimitsPositioning->True], "\[ThinSpace]", 
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["j", "TI"]], 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["j", "TI"]], "-", 
      StyleBox["i", "TI"], 
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       RowBox[{
        StyleBox["LL",
         FontSlant->"Plain"], ",", 
        StyleBox["n", "TI"]}], 
       StyleBox["qp",
        FontSlant->"Plain"]], 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "0"]}], ")"}], 
    SubsuperscriptBox["\[Chi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["pw",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a277160c-2610-46d7-9eea-f66396d9db61"],
 " with a constant spinor ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Chi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["pw",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0ad13b97-365b-4719-9887-40dd599ab530"],
 " (a Dirac spinor times the isospin vector ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", ",", "0"}], ")"}], 
    StyleBox["T", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f951e2d6-4445-445d-82af-8ae26dba5173"],
 "), and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Psi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["h",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "06b9f93d-5d66-4ebe-b10d-a377d2310fda"],
 ". The covariant derivative gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Del]", 
     StyleBox["j", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Psi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p",
      FontSlant->"Plain"]], "\[LongEqual]", 
    StyleBox["i", "TI"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["j", "TI"]], "-", 
      SubsuperscriptBox[
       StyleBox["A",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["LL",
         FontSlant->"Plain"], ",", 
        StyleBox["j", "TI"]}], "\[UpArrow]"]}], ")"}], 
    SubsuperscriptBox["\[Psi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f1a4250f-97ef-4199-8148-dde8aed5db34"],
 ", and the field equations become the eigenvalue problem ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["E", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["n", "TI"]}], 
     StyleBox["qp",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Chi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["pw",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       StyleBox["j", "TI"],
       LimitsPositioning->True], "\[ThinSpace]", 
      SubsuperscriptBox["\[Alpha]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["j", "TI"]], 
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox[
         StyleBox["q", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], 
         StyleBox["j", "TI"]], "-", 
        SubsuperscriptBox[
         StyleBox["A",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], 
         RowBox[{
          StyleBox["LL",
           FontSlant->"Plain"], ",", 
          StyleBox["j", "TI"]}], "\[UpArrow]"]}], ")"}], "+", 
      SubscriptBox["\[Beta]", 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      SubscriptBox[
       StyleBox["m", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]], "-", 
      SubsuperscriptBox[
       StyleBox["A",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["LL",
         FontSlant->"Plain"], ",", "0"}], "\[UpArrow]"], "-", 
      SubscriptBox["\[Mu]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}], 
    SubsuperscriptBox["\[Chi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["pw",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4253aefe-849d-4e35-bed8-a95ab8d0890a"],
 ". The Dirac matrices obey ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[Alpha]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["j", "TI"]], ")"}], "2"], "\[LongEqual]", 
    SubsuperscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"], "2"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "4"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "22c334af-e982-446c-8a9f-862928d02821"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]], 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     SuperscriptBox[
      StyleBox["j", "TI"], "\[Prime]"]], "+", 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     SuperscriptBox[
      StyleBox["j", "TI"], "\[Prime]"]], 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "42e78662-93b8-45ac-91b3-ea16c50d7a2a"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["j", "TI"], "\[NotEqual]", 
    SuperscriptBox[
     StyleBox["j", "TI"], "\[Prime]"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3a1b4f43-5f5d-44a4-bd6f-e91a8f5e73fc"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]], 
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "+", 
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cc7d2c41-ff94-4d9c-b9e0-cddaaf39fc4f"],
 " (check GS-1). The matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["j", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["j", "TI"]], "-", 
      SubsuperscriptBox[
       StyleBox["A",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["LL",
         FontSlant->"Plain"], ",", 
        StyleBox["j", "TI"]}], "\[UpArrow]"]}], ")"}], "+", 
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c95d88af-da12-4c2a-96a1-c019ff767626"],
 " therefore squares to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["j", "TI"],
     LimitsPositioning->True], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["q", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], 
        StyleBox["j", "TI"]], "-", 
       SubsuperscriptBox[
        StyleBox["A",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["LL",
          FontSlant->"Plain"], ",", 
         StyleBox["j", "TI"]}], "\[UpArrow]"]}], ")"}], "2"], "+", 
    SubsuperscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7c0c7600-22c1-4d29-b3c2-87a5eb13d181"],
 " times the unit matrix, and its eigenvalues are the two square roots of \
this number, each twice. A hole (with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Psi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7c915a6a-9d29-406b-8773-f88081685748"],
 ") obeys the second field equation, whose operator ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["h", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], "\[Del]"], "-", 
       SubscriptBox[
        StyleBox["A",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["LL",
          FontSlant->"Plain"], ",", "0"}]], "-", 
       SubscriptBox["\[Mu]", 
        StyleBox["LL",
         FontSlant->"Plain"]]}], ")"}], "*"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0ffcb0f8-7032-4235-8654-41821c5bd57f"],
 " contains the charges with the opposite sign. The energies of the \
isospin-up components are, each twice,"
}], "Text",ExpressionUUID->"0be7367d-bd7c-451b-a4db-024454fbb352"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["E", "TI"], 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["n", "TI"]}], 
    StyleBox["qp",
     FontSlant->"Plain"]], "\[LongEqual]", 
   RowBox[{"\[PlusMinus]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       UnderscriptBox["\[Sum]", 
        StyleBox["j", "TI"],
        LimitsPositioning->True], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubsuperscriptBox[
           StyleBox["q", "TI"], 
           StyleBox["LL",
            FontSlant->"Plain"], 
           StyleBox["j", "TI"]], "-", 
          SubsuperscriptBox[
           StyleBox["A",
            FontFamily->"Helvetica",
            FontSlant->"Plain"], 
           RowBox[{
            StyleBox["LL",
             FontSlant->"Plain"], ",", 
            StyleBox["j", "TI"]}], "\[UpArrow]"]}], ")"}], "2"], "+", 
       SubsuperscriptBox[
        StyleBox["m", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], "2"]}], ")"}], 
     RowBox[{"1", "/", "2"}]]}], "-", 
   SubsuperscriptBox[
    StyleBox["A",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", "0"}], "\[UpArrow]"], "-", 
   SubscriptBox["\[Mu]", 
    StyleBox["LL",
     FontSlant->"Plain"]], "   ", 
   StyleBox[
    RowBox[{"(", "particles", ")"}],
    FontSlant->"Plain"], ",", "      ", 
   SubsuperscriptBox[
    StyleBox["E", "TI"], 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["n", "TI"]}], 
    StyleBox["qp",
     FontSlant->"Plain"]], "\[LongEqual]", 
   RowBox[{"\[MinusPlus]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       UnderscriptBox["\[Sum]", 
        StyleBox["j", "TI"],
        LimitsPositioning->True], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubsuperscriptBox[
           StyleBox["q", "TI"], 
           StyleBox["LL",
            FontSlant->"Plain"], 
           StyleBox["j", "TI"]], "+", 
          SubsuperscriptBox[
           StyleBox["A",
            FontFamily->"Helvetica",
            FontSlant->"Plain"], 
           RowBox[{
            StyleBox["LL",
             FontSlant->"Plain"], ",", 
            StyleBox["j", "TI"]}], "\[UpArrow]"]}], ")"}], "2"], "+", 
       SubsuperscriptBox[
        StyleBox["m", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], "2"]}], ")"}], 
     RowBox[{"1", "/", "2"}]]}], "+", 
   SubsuperscriptBox[
    StyleBox["A",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", "0"}], "\[UpArrow]"], "+", 
   SubscriptBox["\[Mu]", 
    StyleBox["LL",
     FontSlant->"Plain"]], "   ", 
   StyleBox[
    RowBox[{"(", "holes", ")"}],
    FontSlant->"Plain"]}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"5d214984-4229-4baa-9efa-b92175deff42"],

Cell[TextData[{
 "and those of the isospin-down components are the same with ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["A",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}], "\[DownArrow]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5d1e3185-e97f-4df0-bba8-c291a2155946"],
 " in place of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["A",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}], "\[UpArrow]"], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "408ebc1c-6dc2-4eb8-b8ce-cbaaba43f345"],
 ". On the lattice the square roots are replaced by the lattice energy ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CurlyEpsilon]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["lat",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8810de39-81b1-4321-8c6b-ce2fe0d7d3be"],
 " of check GS-16 at the shifted momenta. This is exact: the link matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["U",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", "1"}], 
     StyleBox["link",
      FontSlant->"Plain"]], "\[LongEqual]", 
    StyleBox["exp",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       StyleBox["i", "TI"]}], 
      SubsuperscriptBox["\[ScriptL]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["x",
        FontSlant->"Plain"]], 
      SubscriptBox[
       StyleBox["A",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["LL",
         FontSlant->"Plain"], ",", "1"}]]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d3beb748-8783-4b47-a199-b629b4e89e0a"],
 " multiplies the plane wave at the next site by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["exp",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       StyleBox["i", "TI"]}], 
      SubsuperscriptBox["\[ScriptL]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["x",
        FontSlant->"Plain"]], 
      SubsuperscriptBox[
       StyleBox["A",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["LL",
         FontSlant->"Plain"], ",", "1"}], "\[UpArrow]"]}], ")"}]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "df6dce8b-6eef-494f-95fa-3ec2ed4f537e"],
 ", which shifts the momentum in the differences of the lattice operator by \
exactly ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["A",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", "1"}], "\[UpArrow]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8c61c2f4-15ac-489a-a448-7654cd40caf1"],
 "."
}], "Text",ExpressionUUID->"e9d16d14-2c18-4ac0-98e3-43d7cfc1a7a0"],

Cell[TextData[{
 StyleBox["What it shows.",
  FontWeight->"Bold"],
 " The space components of a potential shift the momentum (minimal coupling): \
the plane wave with the label ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["q", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "1"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0b5976b0-f017-4c40-8101-d6e45412710f"],
 " has its lowest energy at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["A",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", "1"}], "\[UpArrow]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f3a06c35-8d27-46b0-afa1-7874cceeaff3"],
 ". The time component shifts the energy, exactly as a change of the chemical \
potential would. In infinite space a gauge transformation removes both \
shifts. On a ring the gauge function would have to be periodic, and it is \
periodic only if ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["exp",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["i", "TI"], 
      SubscriptBox[
       StyleBox["A",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["LL",
         FontSlant->"Plain"], ",", "1"}]], 
      SubsuperscriptBox[
       StyleBox["n", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["x",
        FontSlant->"Plain"]], 
      SubsuperscriptBox["\[ScriptL]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["x",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "03a54e3e-cc59-4dbe-afab-67e726ada629"],
 " is the unit matrix. This matrix is the product of the link matrices around \
the ring (a Wilson loop), which no gauge transformation changes; if it is not \
the unit matrix, the ring encloses a flux, and the energies at the allowed \
momenta are truly shifted (the Aharonov-Bohm effect). Check AS-1 uses a ring \
of 32 sites (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[ScriptL]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["x",
      FontSlant->"Plain"]], "\[LongEqual]", "0.5"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7c0c0077-f3e2-4cd4-81bb-c1f5139736e7"],
 ", circumference 16, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0.4"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "29ceb72e-1405-4c27-82f9-ff97480ba186"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Mu]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0.2"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "10e86c00-54cd-4ee0-9294-42b548ca381d"],
 ") with the potentials ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", "1"}], "3"], "\[LongEqual]", "0.8"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c290e551-e8fe-4c9e-9cca-e8ef65e7c11c"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", "1"}], 
     StyleBox["F",
      FontSlant->"Plain"]], "\[LongEqual]", "0.6"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b6b0cede-9601-4fb3-aefc-c99e4fddaf77"],
 " in the links and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", "0"}], "3"], "\[LongEqual]", "0.5"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "06173c62-742b-47e1-bf54-44328bee5a09"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", "0"}], 
     StyleBox["F",
      FontSlant->"Plain"]], "\[LongEqual]", "0.3"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f6b0f7ba-b4a2-420a-b31d-6a9976944bbd"],
 " in the potential matrix, so that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["A",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", "1"}], "\[UpArrow]"], "\[LongEqual]", 
    "0.55"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6f952a58-7f27-41ca-b43f-05ba9ddb0dd1"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["A",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", "1"}], "\[DownArrow]"], "\[LongEqual]", 
    RowBox[{"-", "0.01"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c3b8ff55-4a90-49e1-9d3c-0d8436dfd1c6"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["A",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", "0"}], "\[UpArrow]"], "\[LongEqual]", 
    "0.31"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7061db21-8767-4cb5-bfbb-52a7e958bd1b"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["A",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", "0"}], "\[DownArrow]"], "\[LongEqual]", 
    RowBox[{"-", "0.04"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3b7a4aa3-a15e-4a8e-9a04-6e4d3c9481fa"],
 ". For every allowed momentum it compares the 16 eigenvalues of ",
 StyleBox["t2planeMatrix",
  FontFamily->"Source Code Pro"],
 " with the formula, restricts the particle block (the rows and columns 1 to \
8) to each isospin component and compares its four eigenvalues with the \
formula, and checks that the particle block does not connect the two isospin \
components. Figure 3(a) shows the energies of the particle block."
}], "Text",ExpressionUUID->"9e45f018-26a7-4698-8243-dbbc49b532cc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"AS", "-", "1"}], ":", " ", 
     RowBox[{"the", " ", "potentials", " ", 
      RowBox[{"Av", "^", "3"}], "_", "1"}]}], ",", " ", 
    RowBox[{"AF_", "1", " ", 
     RowBox[{"(", 
      RowBox[{"in", " ", "the", " ", "links"}], ")"}]}], ",", " ", 
    RowBox[{
     RowBox[{"Av", "^", "3"}], "_", "0"}], ",", " ", 
    RowBox[{"AF_", "0", " ", 
     RowBox[{"(", 
      RowBox[{"in", " ", "the", " ", "potential", " ", "matrix"}], ")"}]}], ",",
     " ", 
    RowBox[{
     RowBox[{"the", " ", "chemical", " ", "potential"}], ";", "\n", "   ", 
     RowBox[{
     "a", " ", "chain", " ", "of", " ", "32", " ", "sites", " ", "with", " ", 
      "the", " ", "spacing", " ", "0.5"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "as1Av31", ",", " ", "as1AF1", ",", " ", "as1Av30", ",", " ", "as1AF0", 
       ",", " ", "as1Mu"}], "}"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
      "0.8", ",", " ", "0.6", ",", " ", "0.5", ",", " ", "0.3", ",", " ", 
       "0.2"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"as1N", ",", " ", "as1Ell"}], "}"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"32", ",", " ", "0.5"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as1Lat", " ", "=", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<n\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"as1N", ",", " ", "1", ",", " ", "1"}], "}"}]}], ",", " ", 
       RowBox[{"\"\<ell\>\"", " ", "->", " ", "as1Ell"}], ",", " ", 
       RowBox[{"\"\<periodic\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"True", ",", " ", "False", ",", " ", "False"}], "}"}]}], ",",
        " ", 
       RowBox[{"\"\<wilson\>\"", " ", "->", " ", "1.0"}], ",", " ", 
       RowBox[{"\"\<mass\>\"", " ", "->", " ", "mass"}], ",", " ", 
       RowBox[{"\"\<mu\>\"", " ", "->", " ", "as1Mu"}]}], "|>"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as1Fields", " ", "=", " ", 
     RowBox[{"t2trivialFields", "[", "as1N", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"as1Fields", "[", 
         RowBox[{"[", 
          RowBox[{"\"\<links\>\"", ",", " ", "site", ",", " ", "1"}], "]"}], 
         "]"}], " ", "=", " ", 
        RowBox[{"t2link", "[", 
         RowBox[{"gv", ",", " ", "gf", ",", " ", 
          RowBox[{"{", 
           RowBox[{"0.", ",", " ", "0.", ",", " ", "as1Av31"}], "}"}], ",", 
          " ", "as1AF1", ",", " ", "as1Ell"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{
        RowBox[{"as1Fields", "[", 
         RowBox[{"[", 
          RowBox[{"\"\<v0\>\"", ",", " ", "site"}], "]"}], "]"}], " ", "=", 
        " ", 
        RowBox[{"t2potential", "[", 
         RowBox[{"gv", ",", " ", "gf", ",", " ", 
          RowBox[{"{", 
           RowBox[{"0.", ",", " ", "0.", ",", " ", "as1Av30"}], "}"}], ",", 
          " ", "as1AF0"}], "]"}]}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"site", ",", " ", "as1N"}], "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "Acal_p", " ", "of", " ", "the", " ", "isospin", " ", "component", " ", 
      "with", " ", "the", " ", "charge", " ", "qq"}], " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"+", "1"}], "/", "2"}], " ", 
         RowBox[{"(", "up", ")"}], " ", "or"}], " ", "-", 
        RowBox[{
         RowBox[{"1", "/", "2"}], " ", 
         RowBox[{"(", "down", ")"}]}]}], ":", " ", "p"}], " ", "=", " ", 
      RowBox[{
       RowBox[{"1", " ", "and", " ", "p"}], " ", "=", " ", "0"}]}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"as1Acal1", "[", "qq_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"gf", " ", "as1AF1"}], " ", "+", " ", 
      RowBox[{"qq", " ", "gv", " ", "as1Av31"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"as1Acal0", "[", "qq_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"gf", " ", "as1AF0"}], " ", "+", " ", 
      RowBox[{"qq", " ", "gv", " ", "as1Av30"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as1Dev", " ", "=", " ", "0."}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", "rows", " ", 
      RowBox[{"{", 
       RowBox[{"q", ",", " ", "Q_LL", ",", " ", "E_qp"}], "}"}], " ", "of", " ",
       "the", " ", "points", " ", "of", " ", "Figure", " ", "3", 
      RowBox[{"(", "a", ")"}]}], ",", " ", 
     RowBox[{
     "in", " ", "the", " ", "order", " ", "of", " ", "the", " ", "original", " ",
       "data", " ", "file"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"as1LatticeRows", " ", "=", " ", 
     RowBox[{"{", "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"q", " ", "=", " ", 
           RowBox[{"t2chainMomentum", "[", 
            RowBox[{"kq", ",", " ", "as1N", ",", " ", "as1Ell"}], "]"}]}], ",",
           " ", "m16", ",", " ", "ev", ",", " ", "expect", ",", " ", 
          "pblock"}], "}"}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{"m16", " ", "=", " ", 
          RowBox[{"t2planeMatrix", "[", 
           RowBox[{"as1Lat", ",", " ", "as1Fields", ",", " ", "q"}], "]"}]}], 
         ";", "\n", "   ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{"all", " ", "16", " ", 
            RowBox[{"eigenvalues", ":", " ", 
             RowBox[{"particles", " ", "+", 
              RowBox[{
               RowBox[{"-", "eps_lat"}], 
               RowBox[{"(", 
                RowBox[{"q", " ", "-", " ", 
                 RowBox[{"Acal_", "1"}]}], ")"}]}], " ", "-", " ", 
              RowBox[{"Acal_", "0"}], " ", "-", " ", "mu"}]}]}], ",", " ", 
           RowBox[{"holes", " ", "-", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"+", 
                RowBox[{"-", "eps_lat"}]}], 
               RowBox[{"(", 
                RowBox[{"q", " ", "+", " ", 
                 RowBox[{"Acal_", "1"}]}], ")"}]}], " ", "-", " ", 
              RowBox[{"Acal_", "0"}], " ", "-", " ", "mu"}], ")"}]}], ",", 
           " ", 
           RowBox[{"each", " ", "twice"}]}], " ", "*)"}], "\n", "   ", 
         RowBox[{"ev", " ", "=", " ", 
          RowBox[{"First", "[", 
           RowBox[{"t2eigh", "[", "m16", "]"}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"expect", " ", "=", " ", 
          RowBox[{"Sort", "[", 
           RowBox[{"Flatten", "[", 
            RowBox[{"Table", "[", "\n", "       ", 
             RowBox[{
              RowBox[{"With", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"ep", " ", "=", " ", 
                   RowBox[{"t2epsLat", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"q", " ", "-", " ", 
                    RowBox[{"as1Acal1", "[", "qq", "]"}]}], ",", " ", "0.", ",",
                     " ", "0."}], "}"}], ",", " ", "as1Ell", ",", " ", "mass",
                     ",", " ", "1.0", ",", " ", "asChainActive"}], "]"}]}], ",",
                   "\n", "         ", 
                  RowBox[{"eh", " ", "=", " ", 
                   RowBox[{"t2epsLat", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"q", " ", "+", " ", 
                    RowBox[{"as1Acal1", "[", "qq", "]"}]}], ",", " ", "0.", ",",
                     " ", "0."}], "}"}], ",", " ", "as1Ell", ",", " ", "mass",
                     ",", " ", "1.0", ",", " ", "asChainActive"}], "]"}]}]}], 
                 "}"}], ",", "\n", "        ", 
                RowBox[{"Table", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"ep", " ", "-", " ", 
                    RowBox[{"as1Acal0", "[", "qq", "]"}], " ", "-", " ", 
                    "as1Mu"}], ",", " ", 
                    RowBox[{
                    RowBox[{"-", "ep"}], " ", "-", " ", 
                    RowBox[{"as1Acal0", "[", "qq", "]"}], " ", "-", " ", 
                    "as1Mu"}], ",", " ", 
                    RowBox[{"eh", " ", "+", " ", 
                    RowBox[{"as1Acal0", "[", "qq", "]"}], " ", "+", " ", 
                    "as1Mu"}], ",", " ", 
                    RowBox[{
                    RowBox[{"-", "eh"}], " ", "+", " ", 
                    RowBox[{"as1Acal0", "[", "qq", "]"}], " ", "+", " ", 
                    "as1Mu"}]}], "}"}], ",", " ", 
                  RowBox[{"{", "2", "}"}]}], "]"}]}], "]"}], ",", "\n", 
              "       ", 
              RowBox[{"{", 
               RowBox[{"qq", ",", " ", 
                RowBox[{"{", 
                 RowBox[{"0.5", ",", " ", 
                  RowBox[{"-", "0.5"}]}], "}"}]}], "}"}]}], "]"}], "]"}], 
           "]"}]}], ";", "\n", "   ", 
         RowBox[{"as1Dev", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"as1Dev", ",", " ", 
            RowBox[{"Max", "[", 
             RowBox[{"Abs", "[", 
              RowBox[{"ev", " ", "-", " ", "expect"}], "]"}], "]"}]}], 
           "]"}]}], ";", "\n", "   ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{"the", " ", "particle", " ", "block", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"rows", " ", "and", " ", "columns", " ", "1"}], ".."}],
               "8"}], ")"}]}], ",", " ", 
           RowBox[{
           "restricted", " ", "to", " ", "each", " ", "isospin", " ", 
            "component"}]}], " ", "*)"}], "\n", "   ", 
         RowBox[{"pblock", " ", "=", " ", 
          RowBox[{"m16", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"1", " ", ";;", " ", "8"}], ",", " ", 
             RowBox[{"1", " ", ";;", " ", "8"}]}], "]"}], "]"}]}], ";", "\n", 
         "   ", 
         RowBox[{"Do", "[", "\n", "    ", 
          RowBox[{
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"idx", " ", "=", " ", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"qq", " ", ">", " ", "0"}], ",", " ", "asUpIndex", ",",
                   " ", "asDownIndex"}], "]"}]}], ",", " ", "evq", ",", " ", 
               "ep", ",", " ", "ex"}], "}"}], ",", "\n", "     ", 
             RowBox[{
              RowBox[{"evq", " ", "=", " ", 
               RowBox[{"First", "[", 
                RowBox[{"t2eigh", "[", 
                 RowBox[{"pblock", "[", 
                  RowBox[{"[", 
                   RowBox[{"idx", ",", " ", "idx"}], "]"}], "]"}], "]"}], 
                "]"}]}], ";", "\n", "     ", 
              RowBox[{"ep", " ", "=", " ", 
               RowBox[{"t2epsLat", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"q", " ", "-", " ", 
                    RowBox[{"as1Acal1", "[", "qq", "]"}]}], ",", " ", "0.", ",",
                    " ", "0."}], "}"}], ",", " ", "as1Ell", ",", " ", "mass", 
                 ",", " ", "1.0", ",", " ", "asChainActive"}], "]"}]}], ";", 
              "\n", "     ", 
              RowBox[{"ex", " ", "=", " ", 
               RowBox[{"Sort", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"-", "ep"}], " ", "-", " ", 
                   RowBox[{"as1Acal0", "[", "qq", "]"}], " ", "-", " ", 
                   "as1Mu"}], ",", " ", 
                  RowBox[{
                   RowBox[{"-", "ep"}], " ", "-", " ", 
                   RowBox[{"as1Acal0", "[", "qq", "]"}], " ", "-", " ", 
                   "as1Mu"}], ",", " ", 
                  RowBox[{"ep", " ", "-", " ", 
                   RowBox[{"as1Acal0", "[", "qq", "]"}], " ", "-", " ", 
                   "as1Mu"}], ",", " ", 
                  RowBox[{"ep", " ", "-", " ", 
                   RowBox[{"as1Acal0", "[", "qq", "]"}], " ", "-", " ", 
                   "as1Mu"}]}], "}"}], "]"}]}], ";", "\n", "     ", 
              RowBox[{"as1Dev", " ", "=", " ", 
               RowBox[{"Max", "[", 
                RowBox[{"as1Dev", ",", " ", 
                 RowBox[{"Max", "[", 
                  RowBox[{"Abs", "[", 
                   RowBox[{"evq", " ", "-", " ", "ex"}], "]"}], "]"}]}], 
                "]"}]}], ";", "\n", "     ", 
              RowBox[{"Do", "[", 
               RowBox[{
                RowBox[{"AppendTo", "[", 
                 RowBox[{"as1LatticeRows", ",", " ", 
                  RowBox[{"{", 
                   RowBox[{"q", ",", " ", "qq", ",", " ", 
                    RowBox[{"evq", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], "}"}]}], "]"}], ",", 
                " ", 
                RowBox[{"{", 
                 RowBox[{"i", ",", " ", "4"}], "}"}]}], "]"}]}]}], "]"}], ",",
            "\n", "    ", 
           RowBox[{"{", 
            RowBox[{"qq", ",", " ", 
             RowBox[{"{", 
              RowBox[{"0.5", ",", " ", 
               RowBox[{"-", "0.5"}]}], "}"}]}], "}"}]}], "]"}], ";", "\n", 
         "   ", 
         RowBox[{"(*", " ", 
          RowBox[{
          "the", " ", "particle", " ", "block", " ", "does", " ", "not", " ", 
           "mix", " ", "the", " ", "two", " ", "isospin", " ", "components", " ", 
           RowBox[{"(", 
            RowBox[{
            "the", " ", "potentials", " ", "point", " ", "along", " ", "tau_",
              "3"}], ")"}]}], " ", "*)"}], "\n", "   ", 
         RowBox[{"as1Dev", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"as1Dev", ",", " ", 
            RowBox[{"Max", "[", 
             RowBox[{"Abs", "[", 
              RowBox[{"pblock", "[", 
               RowBox[{"[", 
                RowBox[{"asUpIndex", ",", " ", "asDownIndex"}], "]"}], "]"}], 
              "]"}], "]"}]}], "]"}]}]}]}], "]"}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"kq", ",", " ", "0", ",", " ", 
        RowBox[{"as1N", " ", "-", " ", "1"}]}], "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"the", " ", "rows", " ", 
        RowBox[{"{", 
         RowBox[{
         "q", ",", " ", "Q_LL", ",", " ", "branch", ",", " ", "E_qp"}], "}"}],
         " ", "of", " ", "the", " ", "curves", " ", "of", " ", "Figure", " ", 
        "3", 
        RowBox[{"(", "a", ")"}]}], ":", " ", 
       RowBox[{
       "the", " ", "formula", " ", "on", " ", "401", " ", "momenta"}]}], ";", 
      " ", 
      RowBox[{
       RowBox[{"branch", " ", "1"}], ":", " ", 
       RowBox[{
       "the", " ", "positive", "\n", "   ", "square", " ", "root"}]}]}], ",", 
     " ", 
     RowBox[{
      RowBox[{"-", "1"}], ":", " ", 
      RowBox[{"the", " ", "negative", " ", "one"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"as1CurveRows", " ", "=", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", "\n", "    ", 
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"q", " ", "=", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "Pi"}], "/", "as1Ell"}], " ", "+", " ", 
              RowBox[{"2", " ", 
               RowBox[{"Pi", "/", "as1Ell"}], " ", 
               RowBox[{"i", "/", "400."}]}]}]}], "}"}], ",", "\n", "     ", 
           RowBox[{"Flatten", "[", 
            RowBox[{
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"With", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"ep", " ", "=", " ", 
                   RowBox[{"t2epsLat", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"q", " ", "-", " ", 
                    RowBox[{"as1Acal1", "[", "qq", "]"}]}], ",", " ", "0.", ",",
                     " ", "0."}], "}"}], ",", " ", "as1Ell", ",", " ", "mass",
                     ",", " ", "1.0", ",", " ", "asChainActive"}], "]"}]}], 
                  "}"}], ",", "\n", "        ", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"q", ",", " ", "qq", ",", " ", "1", ",", " ", 
                    RowBox[{"ep", " ", "-", " ", 
                    RowBox[{"as1Acal0", "[", "qq", "]"}], " ", "-", " ", 
                    "as1Mu"}]}], "}"}], ",", " ", 
                   RowBox[{"{", 
                    RowBox[{"q", ",", " ", "qq", ",", " ", 
                    RowBox[{"-", "1"}], ",", " ", 
                    RowBox[{
                    RowBox[{"-", "ep"}], " ", "-", " ", 
                    RowBox[{"as1Acal0", "[", "qq", "]"}], " ", "-", " ", 
                    "as1Mu"}]}], "}"}]}], "}"}]}], "]"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"qq", ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"0.5", ",", " ", 
                   RowBox[{"-", "0.5"}]}], "}"}]}], "}"}]}], "]"}], ",", " ", 
             "1"}], "]"}]}], "]"}], ",", "\n", "    ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "0", ",", " ", "400"}], "}"}]}], "]"}], ",", 
       " ", "1"}], "]"}]}], ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<AS-1\>\"", ",", 
     " ", "\"\<free spinor charges in constant gauge potentials (case A): on \
a periodic chain of 32 sites along x_LL^1 (dx = 0.5, r_W = 1, m = 0.4, mu = \
0.2, g_v = 0.7, g_F = 0.45) with the constant potentials Av_LL^3_1 = 0.8 and \
AF_LL_1 = 0.6 (in the links) and Av_LL^3_0 = 0.5 and AF_LL_0 = 0.3 (in the \
potential matrix), and no pair field, the 16 eigenvalues of the lattice \
operator on the plane wave of each allowed momentum q are, for each isospin \
component (Q_LL = +1/2 with Acal_up_p = g_F AF_LL_p + g_v Av_LL^3_p/2, Q_LL = \
-1/2 with Acal_down_p = g_F AF_LL_p - g_v Av_LL^3_p/2), +-eps_lat(q - Acal_1) \
- Acal_0 - mu (particles) and -(+-eps_lat(q + Acal_1) - Acal_0 - mu) (holes), \
each twice: the potential of the space direction shifts the momentum (minimal \
coupling q -> q - Acal_1) and the potential of the time direction shifts the \
energy; the particle block does not mix the two isospin components, and its \
restriction to each component has the eigenvalues +-eps_lat(q - Acal_1) - \
Acal_0 - mu (tolerance 1e-12)\>\"", ",", "\n", "  ", 
     RowBox[{"as1Dev", " ", "<", " ", "1*^-12"}], ",", "\n", "  ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<largest deviation \>\"", ",", " ", 
        RowBox[{"asSci", "[", "as1Dev", "]"}], ",", 
        " ", "\"\<; Acal_up_1 = \>\"", ",", " ", 
        RowBox[{"asFix", "[", 
         RowBox[{
          RowBox[{"as1Acal1", "[", "0.5", "]"}], ",", " ", "4"}], "]"}], ",", 
        " ", "\"\<, Acal_down_1 = \>\"", ",", " ", 
        RowBox[{"asFix", "[", 
         RowBox[{
          RowBox[{"as1Acal1", "[", 
           RowBox[{"-", "0.5"}], "]"}], ",", " ", "4"}], "]"}], ",", 
        " ", "\"\<, Acal_up_0 = \>\"", ",", " ", 
        RowBox[{"asFix", "[", 
         RowBox[{
          RowBox[{"as1Acal0", "[", "0.5", "]"}], ",", " ", "4"}], "]"}], ",", 
        "\n", "    ", "\"\<, Acal_down_0 = \>\"", ",", " ", 
        RowBox[{"asFix", "[", 
         RowBox[{
          RowBox[{"as1Acal0", "[", 
           RowBox[{"-", "0.5"}], "]"}], ",", " ", "4"}], "]"}], ",", 
        " ", "\"\< (original: 9.8e-15; 0.5500, -0.0100, 0.3100, \
-0.0400)\>\""}], "}"}], "]"}]}], "]"}]}]}]], "Input",ExpressionUUID->\
"5fdedab2-c2fa-44e3-bd40-399cd964e873"],

Cell[TextData[{
 StyleBox["The isospin turns in a constant isospin potential (check AS-2).",
  FontWeight->"Bold"],
 " Now only ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["A", "TI"], 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", "0"}], "1"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c77b3208-6e93-411d-bcbb-ae5644970e19"],
 " differs from zero, and it is constant: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["A",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", "0"}]], "\[LongEqual]", 
    FractionBox["1", "2"], 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", "0"}], "1"], 
    SubsuperscriptBox["\[Tau]", "1", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "37db9134-54d2-4970-bb43-ffd6eb183acf"],
 ". This matrix acts on the isospin index and commutes with ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["h", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Del]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "046c2ef7-5ec7-4937-b448-3afe06c76501"],
 ", so the evolution of the particle part is a product, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["exp",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       StyleBox["i", "TI"]}], 
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox[
         StyleBox["h", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], "\[Del]"], "-", 
        SubscriptBox[
         StyleBox["A",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], 
         RowBox[{
          StyleBox["LL",
           FontSlant->"Plain"], ",", "0"}]], "-", 
        SubscriptBox["\[Mu]", 
         StyleBox["LL",
          FontSlant->"Plain"]]}], ")"}], 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "0"]}], ")"}], "\[LongEqual]", 
    StyleBox["exp",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       StyleBox["i", "TI"]}], 
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox[
         StyleBox["h", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], "\[Del]"], "-", 
        SubscriptBox["\[Mu]", 
         StyleBox["LL",
          FontSlant->"Plain"]]}], ")"}], 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "0"]}], ")"}], "\[ThinSpace]", 
    StyleBox["exp",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["i", "TI"], 
      SubscriptBox[
       StyleBox["A",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["LL",
         FontSlant->"Plain"], ",", "0"}]], 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "0"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fc347772-318c-4a5a-a430-cea27d42d621"],
 ". Because ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[Tau]", "1", 
       StyleBox["LL",
        FontSlant->"Plain"]], ")"}], "2"], "\[LongEqual]", 
    SubsuperscriptBox["\[Sigma]", "0", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7b76bea2-dd2d-449a-9ff8-8808450cec4b"],
 ", the second factor is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["exp",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["i", "TI"], 
      SubscriptBox[
       StyleBox["A",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["LL",
         FontSlant->"Plain"], ",", "0"}]], 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "0"]}], ")"}], "\[LongEqual]", 
    StyleBox["cos",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      FractionBox["1", "2"], 
      SubsuperscriptBox["\[Omega]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["pr",
        FontSlant->"Plain"]], 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "0"]}], ")"}], "\[ThinSpace]", 
    SubsuperscriptBox["\[Sigma]", "0", 
     StyleBox["LL",
      FontSlant->"Plain"]], "+", 
    StyleBox["i", "TI"], "\[ThinSpace]", 
    StyleBox["sin",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      FractionBox["1", "2"], 
      SubsuperscriptBox["\[Omega]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["pr",
        FontSlant->"Plain"]], 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "0"]}], ")"}], "\[ThinSpace]", 
    SubsuperscriptBox["\[Tau]", "1", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "edf1dbb6-f9e2-4631-9c76-25ca55ea2a22"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Omega]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["pr",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", "0"}], "1"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9677804d-3ec2-4195-877c-437c46b14a6f"],
 ". A particle that starts as a plane wave of positive energy with isospin \
up, ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Chi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["pw",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9235f3a1-1ab1-4171-a679-e17d1552d519"],
 " times the isospin vector ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", ",", "0"}], ")"}], 
    StyleBox["T", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bf90b52f-41ca-4b76-8d21-45feab31d307"],
 ", therefore has at the time ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "0"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f5295ece-4598-4fa9-b906-88030db34e7f"],
 " the phase factor ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["exp",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       StyleBox["i", "TI"]}], 
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox["\[CurlyEpsilon]", 
         StyleBox["LL",
          FontSlant->"Plain"], 
         StyleBox["lat",
          FontSlant->"Plain"]], "-", 
        SubscriptBox["\[Mu]", 
         StyleBox["LL",
          FontSlant->"Plain"]]}], ")"}], 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "0"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "33abded1-9edf-448c-b0b4-3948a54429e6"],
 " and the isospin vector ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      StyleBox["cos",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       RowBox[{
        FractionBox["1", "2"], 
        SubsuperscriptBox["\[Omega]", 
         StyleBox["LL",
          FontSlant->"Plain"], 
         StyleBox["pr",
          FontSlant->"Plain"]], 
        SubsuperscriptBox[
         StyleBox["x", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], "0"]}], ")"}], ",", "\[ThinSpace]", 
      StyleBox["i", "TI"], "\[ThinSpace]", 
      StyleBox["sin",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       RowBox[{
        FractionBox["1", "2"], 
        SubsuperscriptBox["\[Omega]", 
         StyleBox["LL",
          FontSlant->"Plain"], 
         StyleBox["pr",
          FontSlant->"Plain"]], 
        SubsuperscriptBox[
         StyleBox["x", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], "0"]}], ")"}]}], ")"}], 
    StyleBox["T", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5aa9fd6d-f766-4b97-aabc-3ced51712018"],
 ", and its probability of isospin up is"
}], "Text",ExpressionUUID->"9f0d9e22-6134-4f20-beac-1376c5ce552c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["P", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "\[UpArrow]"], 
   RowBox[{"(", 
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "0"], ")"}], "\[LongEqual]", 
   SuperscriptBox[
    StyleBox["cos",
     FontSlant->"Plain"], "2"], 
   RowBox[{"(", 
    RowBox[{
     FractionBox["1", "2"], 
     SubsuperscriptBox["\[Omega]", 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["pr",
       FontSlant->"Plain"]], 
     SubsuperscriptBox[
      StyleBox["x", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], "0"]}], ")"}], ",", "      ", 
   SubsuperscriptBox["\[Omega]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["pr",
     FontSlant->"Plain"]], "\[LongEqual]", 
   SubsuperscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["v",
     FontSlant->"Plain"]], 
   SubsuperscriptBox[
    StyleBox["A", "TI"], 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", "0"}], "1"]}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"4c118bca-f72d-4a7c-85b5-6543711e38f1"],

Cell[TextData[{
 "The isospin turns about the direction of the potential with the angular \
frequency ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Omega]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["pr",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7461916a-d2e9-4e34-93cc-0306d87e03ee"],
 ". The potential has zero field strength, and the rotation is exactly the \
gauge transformation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["U",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    StyleBox["exp",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["i", "TI"], 
      SubscriptBox[
       StyleBox["A",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["LL",
         FontSlant->"Plain"], ",", "0"}]], 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "0"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2c724872-67c9-4420-9190-72899f6bfff7"],
 " that removes it: in the gauge without the potential the isospin of the \
same particle stays up. The isospin direction of a single mode is therefore \
not gauge invariant; only its direction relative to other objects that carry \
isospin is. For the solvers this solution is a sharp test of the isospin \
structure of the potential term. Check AS-2 takes a ring of 16 sites (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[ScriptL]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["x",
      FontSlant->"Plain"]], "\[LongEqual]", "0.5"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "46fbb2de-d4f0-49fc-a8be-f2fbd0c573b1"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Mu]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0.2"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e3f66248-0756-408d-9a01-47bd30685e3c"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", "0"}], "1"], "\[LongEqual]", "1.5"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "70e6df75-aaa6-4ba3-9fee-efa776bdeb77"],
 ", so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Omega]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["pr",
      FontSlant->"Plain"]], "\[LongEqual]", "1.05"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e5d7b311-b5d5-45db-bc90-ed2cecd2e1de"],
 ") and the plane wave of the allowed momentum number 2 with isospin up, \
integrates the lattice equations to the 101 output times ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "0"], "\[LongEqual]", "0", ",", "0.16", ",", 
    "\[Ellipsis]", ",", "16"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8a59dba8-c9c4-47db-bf35-a269db7e7816"],
 " (the interval between the output times is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[ScriptL]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["t",
      FontSlant->"Plain"]], "\[LongEqual]", "0.16"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a78a3ef9-5d84-405e-afb0-24690c1f8446"],
 "), and compares the whole state with the exact solution. The original \
program integrates with CVODE (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["tol",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox["10", 
     RowBox[{"-", "12"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2d81a850-9941-4c79-8e2d-de580e98ad71"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["tol",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox["10", 
     RowBox[{"-", "14"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "330f5e35-0ae2-4c38-958c-7352bb25d8bf"],
 ") and requires a relative deviation ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Delta]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["rel",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9caf3200-b8ef-4c58-8f34-8e1e78604e97"],
 " below ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "9"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5fce3506-a573-4b06-b475-7a77dfbe77a1"],
 ". The notebook integrates with IDA and the same tolerances (function ",
 StyleBox["t2evolveIDAChecked",
  FontFamily->"Source Code Pro"],
 " of chapter II.1.5) and keeps this requirement. It requires in addition \
that the states at the output times are the cubic Hermite polynomials of the \
stored values and derivatives, and that the largest deviation is at most the \
bound that follows from the measured local errors: the sum of the exact local \
errors ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Delta]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["loc",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ebb7f027-178b-407c-97bb-d273e1a094fa"],
 " of all internal steps bounds the deviation at the end of every step (the \
evolution is unitary), and chapter II.1.5 carries such a bound to the output \
times, with this sum in place of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["err",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a9753053-e593-4228-99b2-fa7b1588f2e3"],
 ". The largest ratio of a local error to ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["loc",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "54d9bcab-5ab5-4076-abc6-970b4fe49a6c"],
 " is printed for information; it is not required to stay below 1, because \
IDA tests its own estimate of the error, in a weighted norm that averages \
over all real unknowns, and half of the real unknowns of this state (the hole \
components) are exactly zero at all times. Figure 3(b) shows the probability \
of isospin up."
}], "Text",ExpressionUUID->"913b91f3-6f4b-4be8-b146-0be6466cbaad"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"AS", "-", "2"}], ":", " ", 
     RowBox[{"a", " ", "chain", " ", "of", " ", "16", " ", "sites"}]}], ";", 
    " ", 
    RowBox[{
     RowBox[{"the", " ", "constant", " ", "isospin", " ", "potential", " ", 
      RowBox[{"Av", "^", "1"}], "_", "0"}], " ", "=", " ", 
     RowBox[{
     "1.5", " ", "along", " ", "tau_", "1", " ", "in", " ", "the", " ", 
      "potential", " ", "matrix"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "as2N", ",", " ", "as2Ell", ",", " ", "as2Mu", ",", " ", "as2Av10"}], 
      "}"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"16", ",", " ", "0.5", ",", " ", "0.2", ",", " ", "1.5"}], 
      "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as2Lat", " ", "=", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<n\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"as2N", ",", " ", "1", ",", " ", "1"}], "}"}]}], ",", " ", 
       RowBox[{"\"\<ell\>\"", " ", "->", " ", "as2Ell"}], ",", " ", 
       RowBox[{"\"\<periodic\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"True", ",", " ", "False", ",", " ", "False"}], "}"}]}], ",",
        " ", 
       RowBox[{"\"\<wilson\>\"", " ", "->", " ", "1.0"}], ",", " ", 
       RowBox[{"\"\<mass\>\"", " ", "->", " ", "mass"}], ",", " ", 
       RowBox[{"\"\<mu\>\"", " ", "->", " ", "as2Mu"}]}], "|>"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as2Fields", " ", "=", " ", 
     RowBox[{"t2trivialFields", "[", "as2N", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"as2Fields", "[", 
        RowBox[{"[", 
         RowBox[{"\"\<v0\>\"", ",", " ", "site"}], "]"}], "]"}], " ", "=", 
       " ", 
       RowBox[{"t2potential", "[", 
        RowBox[{"gv", ",", " ", "gf", ",", " ", 
         RowBox[{"{", 
          RowBox[{"as2Av10", ",", " ", "0.", ",", " ", "0."}], "}"}], ",", 
         " ", "0."}], "]"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"site", ",", " ", "as2N"}], "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "allowed", " ", "momentum", " ", "number", " ", "2"}], ",", 
     " ", 
     RowBox[{
     "and", " ", "the", " ", "eigenvector", " ", "of", " ", "the", " ", 
      "largest", " ", "eigenvalue", " ", "eps_lat", " ", "of", " ", "the", " ",
       "4", " ", "x", " ", "4", " ", "matrix", " ", "of", " ", "the", "\n", 
      "   ", "free", " ", "lattice", " ", "operator", " ", "on", " ", "its", " ",
       "plane", " ", 
      RowBox[{"wave", ":", " ", 
       RowBox[{
       "the", " ", "Dirac", " ", "spinor", " ", "of", " ", "chi_pw"}]}]}]}], 
    " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"as2Q", " ", "=", " ", 
     RowBox[{"t2chainMomentum", "[", 
      RowBox[{"2", ",", " ", "as2N", ",", " ", "as2Ell"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"as2E4", ",", " ", "as2V4"}], "}"}], " ", "=", " ", 
     RowBox[{"t2eigh", "[", 
      RowBox[{"t2hLatPlane", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"as2Q", ",", " ", "0.", ",", " ", "0."}], "}"}], ",", " ", 
        "as2Ell", ",", " ", "mass", ",", " ", "1.0", ",", " ", 
        "asChainActive"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as2Eps", " ", "=", " ", 
     RowBox[{"as2E4", "[", 
      RowBox[{"[", "4", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as2Chi4", " ", "=", " ", 
     RowBox[{"as2V4", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", " ", "4"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as2OmegaPr", " ", "=", " ", 
     RowBox[{"gv", " ", "as2Av10"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "exact", " ", "solution", " ", "at", " ", "the", " ", "time",
       " ", 
      RowBox[{"x0", ":", " ", 
       RowBox[{
       "on", " ", "every", " ", "site", " ", "the", " ", "eight", " ", 
        "particle", " ", "components", " ", "chi_pw", " ", 
        RowBox[{"(", "x", ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"cos", ",", " ", 
          RowBox[{"i", " ", "sin"}]}], ")"}], " ", "times", " ", "the", "\n", 
        "   ", "phase", " ", "factors", " ", "of", " ", "the", " ", "time", " ",
         "and", " ", "of", " ", "the", " ", "plane", " ", "wave"}]}]}], ";", 
     " ", 
     RowBox[{
     "the", " ", "hole", " ", "components", " ", "are", " ", "zero"}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"as2Exact", "[", 
      RowBox[{"x0_", "?", "NumericQ"}], "]"}], " ", ":=", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Table", "[", "\n", "    ", 
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"phaseSite", " ", "=", " ", 
            RowBox[{
             RowBox[{"Exp", "[", 
              RowBox[{
               RowBox[{"-", "I"}], " ", 
               RowBox[{"(", 
                RowBox[{"as2Eps", " ", "-", " ", "as2Mu"}], ")"}], " ", 
               "x0"}], "]"}], " ", 
             RowBox[{"Exp", "[", 
              RowBox[{"I", " ", "as2Q", " ", "as2Ell", " ", "site"}], 
              "]"}]}]}], "}"}], ",", "\n", "     ", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"Flatten", "[", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{
                  RowBox[{"as2Chi4", "[", 
                   RowBox[{"[", "a", "]"}], "]"}], " ", "phaseSite", " ", 
                  RowBox[{"Cos", "[", 
                   RowBox[{"0.5", " ", "as2OmegaPr", " ", "x0"}], "]"}]}], ",",
                  " ", 
                 RowBox[{
                  RowBox[{"as2Chi4", "[", 
                   RowBox[{"[", "a", "]"}], "]"}], " ", "phaseSite", " ", "I",
                   " ", 
                  RowBox[{"Sin", "[", 
                   RowBox[{"0.5", " ", "as2OmegaPr", " ", "x0"}], "]"}]}]}], 
                "}"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"a", ",", " ", "4"}], "}"}]}], "]"}], "]"}], ",", " ", 
            RowBox[{"ConstantArray", "[", 
             RowBox[{
              RowBox[{"0.", " ", "I"}], ",", " ", "8"}], "]"}]}], "]"}]}], 
         "]"}], ",", "\n", "    ", 
        RowBox[{"{", 
         RowBox[{"site", ",", " ", "0", ",", " ", 
          RowBox[{"as2N", " ", "-", " ", "1"}]}], "}"}]}], "]"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", "101", " ", "output", " ", "times", " ", "0"}], ",", 
     " ", "0.16", ",", " ", "...", ",", " ", 
     RowBox[{"16", ";", " ", 
      RowBox[{
      "the", " ", "integration", " ", "by", " ", "IDA", " ", "with", " ", 
       "the", " ", "tolerances", " ", "of", " ", "the", " ", "original", " ", 
       "program"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"as2Touts", " ", "=", " ", 
     RowBox[{"0.16", " ", 
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", " ", "100"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"as2Rtol", ",", " ", "as2Atol"}], "}"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"1.*^-12", ",", " ", "1.*^-14"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as2H", " ", "=", " ", 
     RowBox[{"t2dense", "[", 
      RowBox[{"as2Lat", ",", " ", "as2Fields"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as2Run", " ", "=", " ", 
     RowBox[{"t2evolveIDAChecked", "[", 
      RowBox[{"as2H", ",", " ", 
       RowBox[{"as2Exact", "[", "0.", "]"}], ",", " ", "as2Touts", ",", " ", 
       "as2Rtol", ",", " ", "as2Atol"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as2ExactStates", " ", "=", " ", 
     RowBox[{"Map", "[", 
      RowBox[{"as2Exact", ",", " ", "as2Touts"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "norms", " ", "of", " ", "the", " ", "deviations", " ", "of",
       " ", "the", " ", "states", " ", "from", " ", "the", " ", "exact", " ", 
      "states"}], ",", " ", 
     RowBox[{
     "and", " ", "the", " ", "largest", " ", "relative", " ", "deviation"}]}],
     " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"as2Deviations", " ", "=", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"AssociationQ", "[", "as2Run", "]"}], ",", " ", 
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Norm", "[", 
           RowBox[{"#1", " ", "-", " ", "#2"}], "]"}], " ", "&"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"as2Run", "[", "\"\<states\>\"", "]"}], ",", " ", 
           "as2ExactStates"}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"{", "Infinity", "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as2Norm", " ", "=", " ", 
     RowBox[{"Norm", "[", 
      RowBox[{"as2Exact", "[", "0.", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as2Dev", " ", "=", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"AssociationQ", "[", "as2Run", "]"}], ",", " ", 
       RowBox[{"Max", "[", 
        RowBox[{"as2Deviations", "/", 
         RowBox[{"Map", "[", 
          RowBox[{"Norm", ",", " ", "as2ExactStates"}], "]"}]}], "]"}], ",", 
       " ", "Infinity"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "probability", " ", "of", " ", "isospin", " ", "up", " ", 
      "of", " ", "a", " ", 
      RowBox[{"state", ":", " ", 
       RowBox[{
       "the", " ", "part", " ", "of", " ", "its", " ", "squared", " ", "norm",
         " ", "in", " ", "the", " ", "particle", " ", "components", " ", 
        "1"}]}]}], ",", " ", "3", ",", " ", "5", ",", " ", "7"}], " ", "*)"}],
    "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"as2Pup", "[", "w_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{"Partition", "[", 
            RowBox[{"w", ",", " ", "16"}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "asUpIndex"}], "]"}], "]"}], "]"}], 
         "]"}], "^", "2"}], "]"}], "/", 
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{"Abs", "[", "w", "]"}], "^", "2"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"the", " ", "rows", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x", "^", "0"}], ",", " ", 
       RowBox[{"P_up", " ", "of", " ", "the", " ", "integration"}], ",", " ", 
       
       RowBox[{"P_up", " ", "exact"}]}], "}"}], " ", "of", " ", "Figure", " ",
      "3", 
     RowBox[{"(", "b", ")"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"as2PrecessionRows", " ", "=", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"AssociationQ", "[", "as2Run", "]"}], ",", "\n", "   ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"as2Touts", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
           RowBox[{"as2Pup", "[", 
            RowBox[{"as2Run", "[", 
             RowBox[{"[", 
              RowBox[{"\"\<states\>\"", ",", " ", "i"}], "]"}], "]"}], "]"}], 
           ",", " ", 
           RowBox[{
            RowBox[{"Cos", "[", 
             RowBox[{"0.5", " ", "as2OmegaPr", " ", 
              RowBox[{"as2Touts", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "^", "2"}]}], "}"}], ",",
          " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", 
           RowBox[{"Length", "[", "as2Touts", "]"}]}], "}"}]}], "]"}], ",", 
       " ", 
       RowBox[{"{", "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<AS-2\>\"", ",", 
     " ", "\"\<isospin precession in a constant isospin potential (case A): \
in the potential Av_LL^1_0 = 1.5 (along tau_1, no other field) the \
positive-energy lattice plane wave chi_pw (x) (isospin up) evolves as exp(-i \
(eps_lat - mu) x_LL^0) chi_pw (x) (cos(omega_pr x_LL^0/2), i sin(omega_pr \
x_LL^0/2)) with omega_pr = g_v Av_LL^1_0, so that P_up = cos^2(omega_pr \
x_LL^0/2); the integration of the lattice equations by IDA (SUNDIALS, through \
NDSolve with Method -> \\\"IDA\\\", in place of CVODE of the original \
program; rtol = 1e-12, atol = 1e-14; periodic chain of 16 sites, dx = 0.5, \
r_W = 1, m = 0.4, mu = 0.2, momentum 2 pi 2/(16 dx)) agrees with this exact \
solution at the 101 output times x_LL^0 = 0, 0.16, ..., 16: (1) the relative \
deviation of the whole state stays below 1e-9, the tolerance of the original \
check; (2) the states at the output times are the cubic Hermite polynomials \
of the stored values and derivatives (tolerance 1e-12), and the largest \
deviation is at most the bound that follows from the measured exact local \
errors of the internal steps, (1 + h_IDA E_max/4) (sum of local_error) + \
h_IDA deriv_residual/4 + (h_IDA E_max)^4/384 (norm of the state); the numbers \
of steps and of evaluations of IDA and the largest ratio \
local_error/budget_step, with budget_step = rtol (norm of the state) + atol \
sqrt(512), are stated\>\"", ",", "\n", "  ", 
     RowBox[{
      RowBox[{"AssociationQ", "[", "as2Run", "]"}], " ", "&&", " ", 
      RowBox[{"as2Dev", " ", "<", " ", "1*^-9"}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"as2Run", "[", "\"\<hermite\>\"", "]"}], " ", "<", " ", 
       "1*^-12"}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"Max", "[", "as2Deviations", "]"}], " ", "<=", " ", 
       RowBox[{"as2Run", "[", "\"\<bsum\>\"", "]"}]}]}], ",", "\n", "  ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"AssociationQ", "[", "as2Run", "]"}], ",", "\n", "   ", 
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<largest relative deviation \>\"", ",", " ", 
          RowBox[{"asSci", "[", "as2Dev", "]"}], ",", 
          " ", "\"\< <= bound/(norm of the state) \>\"", ",", " ", 
          RowBox[{"asSci", "[", 
           RowBox[{
            RowBox[{"as2Run", "[", "\"\<bsum\>\"", "]"}], "/", "as2Norm"}], 
           "]"}], ",", 
          " ", "\"\<; (sum of local_error)/(norm of the state) \>\"", ",", 
          " ", 
          RowBox[{"asSci", "[", 
           RowBox[{
            RowBox[{"as2Run", "[", "\"\<sumloc\>\"", "]"}], "/", "as2Norm"}], 
           "]"}], ",", "\n", 
          "     ", "\"\<; largest local_error/budget_step \>\"", ",", " ", 
          RowBox[{"asSci", "[", 
           RowBox[{"as2Run", "[", "\"\<ratio\>\"", "]"}], "]"}], ",", "\n", 
          "     ", "\"\<; IDA: N_steps \>\"", ",", " ", 
          RowBox[{"as2Run", "[", "\"\<steps\>\"", "]"}], ",", 
          " ", "\"\<, N_evals \>\"", ",", " ", 
          RowBox[{"as2Run", "[", "\"\<evaluations\>\"", "]"}], ",", 
          " ", "\"\<, largest h_IDA \>\"", ",", " ", 
          RowBox[{"asSci", "[", 
           RowBox[{"as2Run", "[", "\"\<hmax\>\"", "]"}], "]"}], ",", 
          " ", "\"\<, largest deriv_residual \>\"", ",", " ", 
          RowBox[{"asSci", "[", 
           RowBox[{"as2Run", "[", "\"\<residual\>\"", "]"}], "]"}], ",", "\n",
           "     ", "\"\<, Hermite polynomials within \>\"", ",", " ", 
          RowBox[{"asSci", "[", 
           RowBox[{"as2Run", "[", "\"\<hermite\>\"", "]"}], "]"}], ",", 
          " ", "\"\<, E_max \>\"", ",", " ", 
          RowBox[{"asFix", "[", 
           RowBox[{
            RowBox[{"as2Run", "[", "\"\<emax\>\"", "]"}], ",", " ", "4"}], 
           "]"}], ",", " ", "\"\<; omega_pr = \>\"", ",", " ", 
          RowBox[{"asFix", "[", 
           RowBox[{"as2OmegaPr", ",", " ", "4"}], "]"}], ",", 
          " ", "\"\<, eps_lat = \>\"", ",", " ", 
          RowBox[{"asFix", "[", 
           RowBox[{"as2Eps", ",", " ", "6"}], "]"}], ",", "\n", 
          "     ", "\"\< (original program, CVODE: largest relative deviation \
1.3e-11, 1013 steps, 1494 evaluations of the right side; omega_pr = 1.0500, \
eps_lat = 1.723884)\>\""}], "}"}], "]"}], ",", "\n", 
       "   ", "\"\<the integration by IDA failed\>\""}], "]"}]}], 
    "]"}]}]}]], "Input",ExpressionUUID->"a2ff292a-dd90-4bc4-a467-\
d72c22b25d41"],

Cell["Case B: the uniform polar superfluid (checks AS-3 to AS-6)", \
"Subsection",ExpressionUUID->"d217168f-7a26-4606-ad64-f41998889a21"],

Cell[TextData[{
 StyleBox["The fields.",
  FontWeight->"Bold"],
 " No gauge fields, and a uniform pair field along the third isospin \
direction, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["d", "TI"], "\[RightVector]"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{"0", ",", "0", ",", 
      SubscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4bf220fd-f4f8-41f9-82b6-336503b2c595"],
 " with a real ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], ">", "0"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9c2f364e-136d-4d90-baa3-0e16b137ef91"],
 " (the polar state). Then ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["P",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cf98d9c3-0fe2-42f0-a2d3-164316d1a8ee"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["P",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Dagger]"], "\[LongEqual]", 
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "3"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4aa6b8f5-0e5a-4a23-a635-35dc2ee535a8"],
 ". The pair matrix is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "3"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["ch",
      FontSlant->"Plain"]], "\[CircleTimes]", 
    SubscriptBox[
     StyleBox["E",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Tau]", "3", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "610efa70-9f0f-4e29-ab0a-95759bbbb126"],
 ". With ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["ch",
      FontSlant->"Plain"]], "\[LongEqual]", 
    StyleBox["diag",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       SubscriptBox[
        StyleBox["E",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["LL",
         FontSlant->"Plain"]]}], ",", 
      RowBox[{"-", 
       SubscriptBox[
        StyleBox["E",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["LL",
         FontSlant->"Plain"]]}]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c720e15b-a298-46a1-9923-82e277500cb9"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["E",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Tau]", "3", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"-", 
     SubsuperscriptBox["\[Tau]", "1", 
      StyleBox["LL",
       FontSlant->"Plain"]]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "28c41f48-3176-4540-9894-b9bf3f5f4862"],
 " it is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "3"], "\[LongEqual]", 
    StyleBox["diag",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["E",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"]], ",", 
      SubscriptBox[
       StyleBox["E",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}], "\[CircleTimes]", 
    SubsuperscriptBox["\[Tau]", "1", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ce2b196b-15f7-43c6-baac-04c6642e2084"],
 ": a real matrix with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], 
     StyleBox["T", "TI"]], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"], "\[LongEqual]", 
    RowBox[{"-", 
     SubsuperscriptBox[
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], "3"]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fbcd6226-9194-4750-9fab-f91b1ce75b44"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], "2"], "\[LongEqual]", 
    RowBox[{"-", 
     SubscriptBox[
      StyleBox["1",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "8"]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "acfdc25c-559f-4c0c-a423-9f5f76750c23"],
 "."
}], "Text",ExpressionUUID->"620ec833-e978-45ef-9176-ce00741a1235"],

Cell[TextData[{
 StyleBox["The key identity.",
  FontWeight->"Bold"],
 " For the matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["h",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["q", "TI"], "\[RightVector]"], 
      StyleBox["LL",
       FontSlant->"Plain"]], ")"}], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", 
     StyleBox["j", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]], 
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]], "+", 
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c8a9ace3-962a-4e23-bb71-dc404c2862c9"],
 " of a plane wave,"
}], "Text",ExpressionUUID->"ef0dc9de-7b3d-4bfb-8feb-2a4c0ef11b3a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["h",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   RowBox[{"(", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["q", "TI"], "\[RightVector]"], 
     StyleBox["LL",
      FontSlant->"Plain"]], ")"}], "\[LongEqual]", 
   SubscriptBox[
    StyleBox["h",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", 
      SubscriptBox[
       OverscriptBox[
        StyleBox["q", "TI"], "\[RightVector]"], 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}], "*"], "\[ThinSpace]", 
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"]}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"69172f9d-3bcf-430c-bb2e-7656c9b0f023"],

Cell[TextData[{
 "Proof: with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]], "\[LongEqual]", 
    StyleBox["diag",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       SubsuperscriptBox["\[Sigma]", 
        StyleBox["j", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"]]}], ",", 
      SubsuperscriptBox["\[Sigma]", 
       StyleBox["j", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "90b43955-342b-4e5d-b23b-bfffdc7d6738"],
 ", the Dirac factor ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["diag",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["E",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"]], ",", 
      SubscriptBox[
       StyleBox["E",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1c7fea80-dc72-4fa7-b261-489dd2c6b079"],
 " of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b1d7b016-ec53-4b08-82ec-0f4b99cb894b"],
 ", and the relation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["E",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Sigma]", 
     StyleBox["j", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"-", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox["\[Sigma]", 
        StyleBox["j", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"]], ")"}], "*"]}], 
    SubscriptBox[
     StyleBox["E",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "590fd8cb-2d7f-4df4-b98a-1b86d6b03327"],
 " (for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["j", "TI"], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b37d70eb-1fd0-48ff-ba42-b291c41a3697"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["j", "TI"], "\[LongEqual]", "3"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "47e93879-2e74-47bf-be8b-2fff49c46c22"],
 " the Pauli matrix is real and anticommutes with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["E",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    StyleBox["i", "TI"], 
    SubsuperscriptBox["\[Sigma]", "2", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e02ac2d1-c614-4ab6-89a3-be4f89776358"],
 "; for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["j", "TI"], "\[LongEqual]", "2"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8c0b6f95-f553-43ff-928a-1c9bd0bad486"],
 " it is imaginary and commutes with it), one finds ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "3"], 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]], "\[LongEqual]", 
    RowBox[{"-", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox["\[Alpha]", 
        StyleBox["LL",
         FontSlant->"Plain"], 
        StyleBox["j", "TI"]], ")"}], "*"]}], 
    SubsuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "3"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b639597a-1b65-4687-a2e5-c7cf8fd7129a"],
 ". The matrix ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Beta]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ecbbfae4-58de-432a-b834-37c4bf73c9fe"],
 " is real and exchanges the two Weyl blocks, whose Dirac factors in ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ece680fb-7f34-44c5-b213-96b0f911b131"],
 " are equal, so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "3"], 
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "3"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ceaa7562-7fe1-4e1a-ad63-c09138d07ea3"],
 ". Inserted in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["h",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d095ae52-c577-4c4e-8df8-855dd3ceccb4"],
 ", the two relations give the identity. It holds on the lattice as well, \
where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["sin",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["j", "TI"]], 
      SubsuperscriptBox["\[ScriptL]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["x",
        FontSlant->"Plain"]]}], ")"}], "/", 
    SubsuperscriptBox["\[ScriptL]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["x",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "29b4dd8c-cf7f-45ad-9d3c-dd7422f354d7"],
 " (an odd function of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["q", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "145f6af5-e688-45a3-bb0d-c5222c4ba1d0"],
 ") stands in place of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["q", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ef121a93-3b66-48b9-8748-f3f7540b34a7"],
 " and the Wilson term (an even function) is added to the mass."
}], "Text",ExpressionUUID->"8f4ec4fd-73cc-461e-91af-053580ad854a"],

Cell[TextData[{
 StyleBox["The Bogoliubov modes.",
  FontWeight->"Bold"],
 " On plane waves the operator ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalH]",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["DB",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b4ae2ff7-c8f6-463a-8393-a45f2e163053"],
 " is a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"16", "\[Times]", "16"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f9b132ce-3705-47ac-a028-574f24501f2b"],
 " matrix with the blocks ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["h",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["q", "TI"], "\[RightVector]"], 
      StyleBox["LL",
       FontSlant->"Plain"]], ")"}], "-", 
    SubscriptBox["\[Mu]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a392bf0c-862f-4a9b-84b1-305fa92ddeb8"],
 " (upper left), ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e086414c-01ab-40d1-91b6-4956dfe3a6cf"],
 " (upper right), ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "3"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e63f8d9a-23f5-446b-ad13-06f2d8db6c4f"],
 " (lower left) and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["h",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", 
         SubscriptBox[
          OverscriptBox[
           StyleBox["q", "TI"], "\[RightVector]"], 
          StyleBox["LL",
           FontSlant->"Plain"]]}], ")"}], "*"], "-", 
      SubscriptBox["\[Mu]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d86dcef2-0791-434c-b259-a6b1ccb0f32e"],
 " (lower right), as in check GS-8. Let ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Chi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["pw",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f800efed-ea5c-4deb-998f-f0d09aa006a7"],
 " be a normalized eigenvector of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["h",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["q", "TI"], "\[RightVector]"], 
      StyleBox["LL",
       FontSlant->"Plain"]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "56870fbe-174c-413e-a5c0-14f06281962a"],
 " with the eigenvalue ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", 
    SubscriptBox["\[CurlyEpsilon]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "470e5fa6-4b9a-4892-aea1-88e315df792e"],
 " or ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SubscriptBox["\[CurlyEpsilon]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4e86a539-360c-43fa-bca8-7ab98dcf4312"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CurlyEpsilon]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["q", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], "2"], "+", 
       SubsuperscriptBox[
        StyleBox["m", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], "2"]}], ")"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "eef23b37-e7cf-453a-aaed-4b2e69b75c15"],
 ". By the key identity, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "3"], 
    SubsuperscriptBox["\[Chi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["pw",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "11dde624-1566-43ae-b381-9edb048ce0e1"],
 " is an eigenvector of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["h",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", 
       SubscriptBox[
        OverscriptBox[
         StyleBox["q", "TI"], "\[RightVector]"], 
        StyleBox["LL",
         FontSlant->"Plain"]]}], ")"}], "*"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "09387d16-5979-4946-92ef-27628aefff9f"],
 " with the same eigenvalue; and because ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"], 
    SubsuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "3"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "8"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d7ac5a8a-ae7d-4290-a7d6-60d735d7bceb"],
 ", the operator maps the two vectors ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubsuperscriptBox["\[Chi]", 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["pw",
       FontSlant->"Plain"]], ",", "0"}], ")"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bebc3b56-7bf6-4f05-a07e-4a99f540c712"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", 
     SubsuperscriptBox[
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], "3"], 
     SubsuperscriptBox["\[Chi]", 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["pw",
       FontSlant->"Plain"]]}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cb8553a1-e37d-41fb-b2aa-42559ba4282e"],
 " to combinations of the same two vectors, with the matrix"
}], "Text",ExpressionUUID->"249520a9-2df9-4320-a213-431e1ef4c89a"],

Cell[BoxData[
 FormBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {
      RowBox[{
       RowBox[{"\[PlusMinus]", 
        SubscriptBox["\[CurlyEpsilon]", 
         StyleBox["LL",
          FontSlant->"Plain"]]}], "-", 
       SubscriptBox["\[Mu]", 
        StyleBox["LL",
         FontSlant->"Plain"]]}], 
      SubscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"]]},
     {
      SubscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[PlusMinus]", 
          SubscriptBox["\[CurlyEpsilon]", 
           StyleBox["LL",
            FontSlant->"Plain"]]}], "-", 
         SubscriptBox["\[Mu]", 
          StyleBox["LL",
           FontSlant->"Plain"]]}], ")"}]}]}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"e26574e8-f4a2-4daa-a15a-36d02cc02066"],

Cell[TextData[{
 "The square of this matrix is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{"\[PlusMinus]", 
        SubscriptBox["\[CurlyEpsilon]", 
         StyleBox["LL",
          FontSlant->"Plain"]]}], "-", 
       SubscriptBox["\[Mu]", 
        StyleBox["LL",
         FontSlant->"Plain"]]}], ")"}], "2"], "+", 
    SubsuperscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4578ba7a-a5a5-4db8-9d53-d6be8f411f2e"],
 " times the unit matrix. Its eigenvalues are therefore ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    SubsuperscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "-"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4cee6555-f6b1-434a-bec6-50caed32a04b"],
 " for the upper sign (from the eigenvalue ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", 
    SubscriptBox["\[CurlyEpsilon]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0c31155c-5189-4117-ae56-8b7e5229f1e4"],
 ") and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    SubsuperscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "+"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "10482fe4-d553-401c-877e-101fae1ba193"],
 " for the lower sign (from ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SubscriptBox["\[CurlyEpsilon]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d3162238-2547-44ac-9609-4acf10f89d06"],
 "), with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[PlusMinus]"], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["\[CurlyEpsilon]", 
           StyleBox["LL",
            FontSlant->"Plain"]], "\[PlusMinus]", 
          SubscriptBox["\[Mu]", 
           StyleBox["LL",
            FontSlant->"Plain"]]}], ")"}], "2"], "+", 
       SubsuperscriptBox["\[CapitalDelta]", 
        StyleBox["LL",
         FontSlant->"Plain"], "2"]}], ")"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "853b59e5-4edc-49ad-b071-b9219ddc16b0"],
 ", each four times (the eigenvalue ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", 
    SubscriptBox["\[CurlyEpsilon]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "42c15573-1668-4efe-938c-e843061dc711"],
 " of the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"8", "\[Times]", "8"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c2c1f174-0e54-4aec-aded-447e2b7e522e"],
 " matrix ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["h",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e80e081d-67dd-46aa-9ed6-3f842f5c8a0a"],
 " has four eigenvectors, and so has ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SubscriptBox["\[CurlyEpsilon]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "723a9e6b-fcb4-4af7-a908-dbd3854514c0"],
 "). The eigenvector of the positive eigenvalue is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["cos",
      FontSlant->"Plain"], "\[ThinSpace]", 
     SubsuperscriptBox["\[CurlyTheta]", 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["B",
       FontSlant->"Plain"]], "\[ThinSpace]", 
     SubsuperscriptBox["\[Chi]", 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["pw",
       FontSlant->"Plain"]], ",", " ", 
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", 
     SubsuperscriptBox["\[CurlyTheta]", 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["B",
       FontSlant->"Plain"]], "\[ThinSpace]", 
     SubsuperscriptBox[
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], "3"], 
     SubsuperscriptBox["\[Chi]", 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["pw",
       FontSlant->"Plain"]]}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3241cf57-160d-4535-a89d-2426937d0552"],
 " with the Bogoliubov angle ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CurlyTheta]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["B",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ef807fd0-9ead-4030-a48c-f0c1ae28b3bf"],
 " given by"
}], "Text",ExpressionUUID->"990bd259-b2de-469c-aaea-7d13c8e61e85"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox[
    StyleBox["cos",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   SubsuperscriptBox["\[CurlyTheta]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["B",
     FontSlant->"Plain"]], "\[LongEqual]", 
   FractionBox["1", "2"], 
   RowBox[{"(", 
    RowBox[{"1", "+", 
     FractionBox[
      RowBox[{
       RowBox[{"\[PlusMinus]", 
        SubscriptBox["\[CurlyEpsilon]", 
         StyleBox["LL",
          FontSlant->"Plain"]]}], "-", 
       SubscriptBox["\[Mu]", 
        StyleBox["LL",
         FontSlant->"Plain"]]}], 
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "\[MinusPlus]"]]}], ")"}], ",", "      ", 
   SuperscriptBox[
    StyleBox["sin",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   SubsuperscriptBox["\[CurlyTheta]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["B",
     FontSlant->"Plain"]], "\[LongEqual]", 
   FractionBox["1", "2"], 
   RowBox[{"(", 
    RowBox[{"1", "-", 
     FractionBox[
      RowBox[{
       RowBox[{"\[PlusMinus]", 
        SubscriptBox["\[CurlyEpsilon]", 
         StyleBox["LL",
          FontSlant->"Plain"]]}], "-", 
       SubscriptBox["\[Mu]", 
        StyleBox["LL",
         FontSlant->"Plain"]]}], 
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "\[MinusPlus]"]]}], ")"}]}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"c02e0e54-31ee-49c0-97d6-70756f574829"],

Cell[TextData[{
 "(inserted in the matrix, the first row gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["tan",
     FontSlant->"Plain"], "\[ThinSpace]", 
    SubsuperscriptBox["\[CurlyTheta]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["B",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "\[MinusPlus]"], "-", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[PlusMinus]", 
         SubscriptBox["\[CurlyEpsilon]", 
          StyleBox["LL",
           FontSlant->"Plain"]]}], "-", 
        SubscriptBox["\[Mu]", 
         StyleBox["LL",
          FontSlant->"Plain"]]}], ")"}]}], ")"}], "/", 
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ec0979a1-0f93-408f-81d7-766a76d66c0f"],
 " and the second ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["tan",
     FontSlant->"Plain"], "\[ThinSpace]", 
    SubsuperscriptBox["\[CurlyTheta]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["B",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "/", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "\[MinusPlus]"], "+", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[PlusMinus]", 
         SubscriptBox["\[CurlyEpsilon]", 
          StyleBox["LL",
           FontSlant->"Plain"]]}], "-", 
        SubscriptBox["\[Mu]", 
         StyleBox["LL",
          FontSlant->"Plain"]]}], ")"}]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "62147ba6-e593-4595-9ada-9dbc31c46300"],
 ", and the two agree because ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "\[MinusPlus]"], ")"}], "2"], "-", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{"\[PlusMinus]", 
        SubscriptBox["\[CurlyEpsilon]", 
         StyleBox["LL",
          FontSlant->"Plain"]]}], "-", 
       SubscriptBox["\[Mu]", 
        StyleBox["LL",
         FontSlant->"Plain"]]}], ")"}], "2"], "\[LongEqual]", 
    SubsuperscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "006f8144-44c6-491b-8b01-34656c66baec"],
 "). These modes are the quasi-particles of the superfluid: superpositions of \
a particle and a hole with the weights ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["cos",
      FontSlant->"Plain"], "2"], "\[ThinSpace]", 
    SubsuperscriptBox["\[CurlyTheta]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["B",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b99620a8-109c-471f-905c-bafb303432f4"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["sin",
      FontSlant->"Plain"], "2"], "\[ThinSpace]", 
    SubsuperscriptBox["\[CurlyTheta]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["B",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "23b0a2f2-bea6-4941-8bac-4a93c213c02d"],
 ". The branch ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "-"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3c5a9a6e-0e9e-4135-84dc-b8b0ff8e550c"],
 " has its minimum ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalDelta]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2792b48f-c4c1-44dc-be19-dd13d8b981f1"],
 " at the Fermi momentum ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["k", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["F",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d2de80e9-3c13-4521-8c97-335ddb1a7c70"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CurlyEpsilon]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubscriptBox["\[Mu]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4b6177f6-6db5-4509-a747-20e5686d688c"],
 ": ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalDelta]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6530d1c4-3fdd-4732-85b8-1e063ef818f9"],
 " is the energy gap of the superfluid. The branch ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "+"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9883c94a-3a47-468b-acf3-71e9cb36962f"],
 " belongs to the states of negative energy (the antiparticles). Check AS-3 \
verifies the key identity, the eigenvectors and their energies for 50 random \
momenta, chemical potentials and gaps, and then the 16 eigenvalues of the \
lattice operator on the plane wave of every allowed momentum of a ring of 32 \
sites (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[ScriptL]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["x",
      FontSlant->"Plain"]], "\[LongEqual]", "0.5"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3edf68fb-eff2-4653-93b1-ae7440a4e252"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0.4"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "08a064d6-68a9-410b-a049-dd7bce29cecc"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Mu]", 
     StyleBox["LL",
