       RowBox[{"gamma", "^", "0"}], " ", 
       RowBox[{"gamma", "^", "j"}]}]}], ";", " ", 
     RowBox[{"beta", " ", "=", " ", 
      RowBox[{"gamma", "^", "0"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2alpha", "[", "j_Integer", "]"}], " ", ":=", " ", 
