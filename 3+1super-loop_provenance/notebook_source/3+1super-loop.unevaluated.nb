              RowBox[{"md", " ", ".", " ", "mdb"}], " ", "+", " ", 
              RowBox[{"nk", " ", 
               RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], "]"}]}], 
           "]"}]}]}]}], "]"}], ",", "\n", "  ", 
      RowBox[{"{", "50", "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<GS-7\>\"", ",", 
     " ", "\"\<the super-loop form of the Dirac operator: gamma^p nabla_p has \
the Weyl blocks M_LL(D) and M_LL(conj D) and no diagonal blocks; \
(gamma.nabla)^2 = eta nabla nabla + (1/4)[gamma^p, gamma^q][nabla_p, \
nabla_q]; for a free plane wave M_LL(D) M_LL(conj D) = -N_LL(k) sigma_0 (50 \
random momenta and fields; tolerance 1e-12)\>\"", ",", "\n", "  ", 
     RowBox[{"worst7", " ", "<", " ", "1*^-12"}], ",", " ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
