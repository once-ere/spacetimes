Cell["\<\
II.1.2 Complex numbers and matrices (t2core/src/c64.rs and cmat.rs)\
\>", "Subsection",ExpressionUUID->"81754083-1e5f-453b-9b96-5e2676e3ac17"],

Cell[TextData[{
 "The Rust library defines its own complex numbers (c64.rs) and dense complex \
matrices (cmat.rs). The Wolfram Language has both built in: a complex number \
is ",
 StyleBox["a + I b",
  FontFamily->"Source Code Pro"],
 "; a matrix is a list of rows; ",
 StyleBox[".",
  FontFamily->"Source Code Pro"],
 " (Dot) is the matrix product, ",
 StyleBox["ConjugateTranspose",
  FontFamily->"Source Code Pro"],
 " the Hermitian conjugate, ",
 StyleBox["KroneckerProduct",
  FontFamily->"Source Code Pro"],
 " the Kronecker product with the same index convention as the library (every \
entry of the product is the product of one entry of the first matrix and one \
entry of the second; its row is the pair of their rows and its column the \
pair of their columns, the row or column of the first matrix being the slower \
of the two), ",
 StyleBox["Tr",
  FontFamily->"Source Code Pro"],
 " the trace and ",
 StyleBox["Norm[m, \"Frobenius\"]",
  FontFamily->"Source Code Pro"],
 " the Frobenius norm. Three routines of cmat.rs are rewritten here because \
the programs and their checks use them: the inverse of a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Times]", "2"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "654293dd-4258-410c-81e8-92741875ccb1"],
 " matrix by its explicit formula, the matrix exponential by scaling and \
squaring of the Taylor series, and the Hermitian eigensolver."
}], "Text",ExpressionUUID->"4dc61036-29a9-48f3-aef9-3ef5912c4727"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "the", " ", "determinant", " ", "and", " ", "the", " ", "inverse", " ", 
     "of", " ", "a", " ", "2", " ", "x", " ", "2", " ", "matrix"}], ",", " ", 
    
    RowBox[{"by", " ", "the", " ", "explicit", " ", "formulas", " ", "of", " ", 
     RowBox[{"cmat", ".", "rs"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"t2det2", "[", "m_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"m", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], " ", 
       RowBox[{"m", "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", " ", "2"}], "]"}], "]"}]}], " ", "-", " ", 
      RowBox[{
       RowBox[{"m", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", " ", "2"}], "]"}], "]"}], " ", 
       RowBox[{"m", "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", " ", "1"}], "]"}], "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2inv2", "[", "m_", "]"}], " ", ":=", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"d", " ", "=", " ", 
         RowBox[{"t2det2", "[", "m", "]"}]}], "}"}], ",", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"m", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", " ", "2"}], "]"}], "]"}], ",", " ", 
            RowBox[{"-", 
             RowBox[{"m", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", " ", "2"}], "]"}], "]"}]}]}], "}"}], ",", 
          " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"m", "[", 
              RowBox[{"[", 
               RowBox[{"2", ",", " ", "1"}], "]"}], "]"}]}], ",", " ", 
            RowBox[{"m", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", " ", "1"}], "]"}], "]"}]}], "}"}]}], "}"}], "/",
         "d"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "principal", " ", "square", " ", "root", " ", "of", " ", "a",
       " ", "complex", " ", "number"}], ",", " ", 
     RowBox[{"as", " ", "in", " ", 
      RowBox[{"c64", ".", 
       RowBox[{"rs", ":", " ", 
        RowBox[{"|", "z", "|", 
         RowBox[{
          RowBox[{"^", 
           RowBox[{"(", 
            RowBox[{"1", "/", "2"}], ")"}]}], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"cos", 
             RowBox[{"(", 
              RowBox[{"arg", " ", 
               RowBox[{"z", "/", "2"}]}], ")"}]}], " ", "+", " ", 
            RowBox[{"i", " ", "sin", 
             RowBox[{"(", 
              RowBox[{"arg", " ", 
               RowBox[{"z", "/", "2"}]}], ")"}]}]}], ")"}]}]}]}]}]}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2csqrt", "[", "z_", "]"}], " ", ":=", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"r", " ", "=", " ", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"Abs", "[", "z", "]"}], "]"}]}], ",", " ", 
         RowBox[{"th", " ", "=", " ", 
          RowBox[{
           RowBox[{"Arg", "[", "z", "]"}], "/", "2"}]}]}], "}"}], ",", " ", 
       RowBox[{
        RowBox[{"r", " ", 
         RowBox[{"Cos", "[", "th", "]"}]}], " ", "+", " ", 
        RowBox[{"I", " ", "r", " ", 
         RowBox[{"Sin", "[", "th", "]"}]}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", "matrix", " ", "exponential", " ", "of", " ", 
      RowBox[{"cmat", ".", 
       RowBox[{"rs", ":", " ", 
        RowBox[{
        "halve", " ", "the", " ", "matrix", " ", "until", " ", "its", " ", 
         "Frobenius", " ", "norm", " ", "is", " ", "at", " ", "most", " ", 
         RowBox[{"1", "/", "4"}]}]}]}]}], ",", " ", 
     RowBox[{"sum", "\n", "   ", "the", " ", "Taylor", " ", "series", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"at", " ", "most", " ", "29", " ", "terms"}], ",", " ", 
        RowBox[{
         RowBox[{
         "stopping", " ", "when", " ", "a", " ", "term", " ", "is", " ", 
          "smaller", " ", "than", " ", "1", "e"}], "-", "18"}]}], ")"}]}], ",",
      " ", 
     RowBox[{
     "then", " ", "square", " ", "the", "\n", "   ", "result", " ", "as", " ",
       "often", " ", "as", " ", "the", " ", "matrix", " ", "was", " ", 
      "halved"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2expm", "[", "m_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"n", " ", "=", " ", 
          RowBox[{"Length", "[", "m", "]"}]}], ",", " ", 
         RowBox[{"nrm", " ", "=", " ", 
          RowBox[{"Norm", "[", 
           RowBox[{"m", ",", " ", "\"\<Frobenius\>\""}], "]"}]}], ",", " ", 
         RowBox[{"s", " ", "=", " ", "0"}], ",", " ", 
         RowBox[{"scale", " ", "=", " ", "1."}], ",", " ", "x", ",", " ", 
         "term", ",", " ", "sum"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"nrm", " ", "scale"}], " ", ">", " ", "0.25"}], ",", " ", 
          RowBox[{
           RowBox[{"scale", " ", "*=", " ", "0.5"}], ";", " ", 
           RowBox[{"s", "++"}]}]}], "]"}], ";", "\n", "   ", 
        RowBox[{"x", " ", "=", " ", 
         RowBox[{"scale", " ", "m"}]}], ";", "\n", "   ", 
        RowBox[{"term", " ", "=", " ", 
         RowBox[{"IdentityMatrix", "[", "n", "]"}]}], ";", " ", 
        RowBox[{"sum", " ", "=", " ", 
         RowBox[{"IdentityMatrix", "[", "n", "]"}]}], ";", "\n", "   ", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"term", " ", "=", " ", 
            RowBox[{
             RowBox[{"term", " ", ".", " ", "x"}], "/", "k"}]}], ";", " ", 
           RowBox[{"sum", " ", "=", " ", 
            RowBox[{"sum", " ", "+", " ", "term"}]}], ";", " ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Norm", "[", 
               RowBox[{"term", ",", " ", "\"\<Frobenius\>\""}], "]"}], " ", "<",
               " ", "1*^-18"}], ",", " ", 
             RowBox[{"Break", "[", "]"}]}], "]"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"k", ",", " ", "1", ",", " ", "29"}], "}"}]}], "]"}], ";", 
        "\n", "   ", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"sum", " ", "=", " ", 
           RowBox[{"sum", " ", ".", " ", "sum"}]}], ",", " ", 
          RowBox[{"{", "s", "}"}]}], "]"}], ";", "\n", "   ", "sum"}]}], 
      "]"}]}], ";"}]}]}]], "Input",ExpressionUUID->"cd934b2f-2c96-4246-ad80-\
12b885b20c91"],

Cell[TextData[{
 "The Hermitian eigensolver ",
 StyleBox["eigh",
  FontFamily->"Source Code Pro"],
 " of cmat.rs finds all eigenvalues and eigenvectors of a complex Hermitian \
matrix (called ",
 StyleBox["a",
  FontFamily->"Source Code Pro"],
 " in the code) in two stages. (1) Householder reduction: for every column ",
 StyleBox["k",
  FontFamily->"Source Code Pro"],
 " a reflection (the unit matrix minus twice the projector on a complex unit \
vector ",
 StyleBox["vv",
  FontFamily->"Source Code Pro"],
 ") is chosen that sets to zero all entries of the column below the \
subdiagonal; applied from both sides it keeps the eigenvalues and turns ",
 StyleBox["a",
  FontFamily->"Source Code Pro"],
 " step by step into a tridiagonal matrix, and the product of the reflections \
is accumulated in the matrix ",
 StyleBox["q",
  FontFamily->"Source Code Pro"],
 ". The complex subdiagonal entries are then made real and non-negative by a \
diagonal unitary matrix of phases. (2) The implicit QL algorithm with \
Wilkinson shifts: plane rotations, applied to the real symmetric tridiagonal \
matrix, drive its off-diagonal entries to zero; the diagonal then holds the \
eigenvalues, and the accumulated rotations, multiplied by ",
 StyleBox["q",
  FontFamily->"Source Code Pro"],
 ", give the eigenvectors. The function below follows the Rust code step by \
step (the indices are shifted by one, because lists of the Wolfram Language \
begin at position 1); the vector operations of the Wolfram Language replace \
the inner loops."
}], "Text",ExpressionUUID->"1f454808-bd2a-41f6-a8b7-799136fa09fc"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"t2eigh", "[", "m_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"n", " ", "=", " ", 
        RowBox[{"Length", "[", "m", "]"}]}], ",", " ", "a", ",", " ", "q", ",",
        " ", "vv", ",", " ", "p", ",", " ", "w", ",", " ", "x", ",", " ", 
       "xnorm", ",", " ", "x0", ",", " ", "phase", ",", " ", "alpha", ",", 
       " ", "vn", ",", " ", "kk", ",", " ", "s", ",", " ", "d", ",", " ", "e",
        ",", " ", "ph", ",", " ", "sub", ",", " ", "r", ",", " ", "zt", ",", 
       "\n", "    ", "iter", ",", " ", "mm", ",", " ", "dd", ",", " ", "g", ",",
        " ", "sr", ",", " ", "cr", ",", " ", "pp", ",", " ", "i", ",", " ", 
       "f", ",", " ", "b", ",", " ", "underflow", ",", " ", "idx", ",", " ", 
       "z0", ",", " ", "z1"}], "}"}], ",", "\n", "   ", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"stage", " ", "1"}], ":", " ", 
       RowBox[{
       "the", " ", "Householder", " ", "reduction", " ", "of", " ", "the", " ",
         "Hermitian", " ", "part", " ", "of", " ", "m"}]}], " ", "*)"}], "\n",
      "   ", 
     RowBox[{
      RowBox[{"a", " ", "=", " ", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"m", " ", "+", " ", 
           RowBox[{"ConjugateTranspose", "[", "m", "]"}]}], ")"}], "/", "2"}],
         "]"}]}], ";", "\n", "   ", 
      RowBox[{"q", " ", "=", " ", 
       RowBox[{
        RowBox[{"N", "[", 
         RowBox[{"IdentityMatrix", "[", "n", "]"}], "]"}], " ", "+", " ", 
        RowBox[{"0.", " ", "I"}]}]}], ";", "\n", "   ", 
      RowBox[{"Do", "[", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"x", " ", "=", " ", 
          RowBox[{"a", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{
              RowBox[{"k", " ", "+", " ", "1"}], " ", ";;", " ", "n"}], ",", 
             " ", "k"}], "]"}], "]"}]}], ";", "\n", "    ", 
         RowBox[{"xnorm", " ", "=", " ", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"Total", "[", 
            RowBox[{
             RowBox[{"Abs", "[", "x", "]"}], "^", "2"}], "]"}], "]"}]}], ";", 
         "\n", "    ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"xnorm", " ", "<", " ", "1*^-300"}], ",", " ", 
           RowBox[{"Continue", "[", "]"}]}], "]"}], ";", "\n", "    ", 
         RowBox[{"x0", " ", "=", " ", 
          RowBox[{"a", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"k", " ", "+", " ", "1"}], ",", " ", "k"}], "]"}], 
           "]"}]}], ";", "\n", "    ", 
         RowBox[{"phase", " ", "=", " ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", "x0", "]"}], " ", ">", " ", "0"}], ",", " ", 
            
            RowBox[{"x0", "/", 
             RowBox[{"Abs", "[", "x0", "]"}]}], ",", " ", "1."}], "]"}]}], ";",
          "\n", "    ", 
         RowBox[{"alpha", " ", "=", " ", 
          RowBox[{
           RowBox[{"-", "phase"}], " ", "xnorm"}]}], ";", "\n", "    ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{"v", " ", "=", " ", 
            RowBox[{"x", " ", "-", " ", 
             RowBox[{"alpha", " ", "e1"}]}]}], ",", " ", 
           RowBox[{"normalized", ";", " ", 
            RowBox[{
             RowBox[{
              RowBox[{
              "v", " ", "vanishes", " ", "in", " ", "the", " ", "positions", " ",
                "1"}], ".."}], "k"}]}]}], " ", "*)"}], "\n", "    ", 
         RowBox[{"vv", " ", "=", " ", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{
            RowBox[{"0.", " ", "+", " ", 
             RowBox[{"0.", " ", "I"}]}], ",", " ", "n"}], "]"}]}], ";", "\n", 
         "    ", 
         RowBox[{
          RowBox[{"vv", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"k", " ", "+", " ", "1"}], " ", ";;", " ", "n"}], "]"}], 
           "]"}], " ", "=", " ", "x"}], ";", "\n", "    ", 
         RowBox[{
          RowBox[{"vv", "[", 
           RowBox[{"[", 
            RowBox[{"k", " ", "+", " ", "1"}], "]"}], "]"}], " ", "=", " ", 
          RowBox[{
           RowBox[{"vv", "[", 
            RowBox[{"[", 
             RowBox[{"k", " ", "+", " ", "1"}], "]"}], "]"}], " ", "-", " ", 
           "alpha"}]}], ";", "\n", "    ", 
         RowBox[{"vn", " ", "=", " ", 
          RowBox[{"Norm", "[", "vv", "]"}]}], ";", "\n", "    ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"vn", " ", "<", " ", "1*^-300"}], ",", " ", 
           RowBox[{"Continue", "[", "]"}]}], "]"}], ";", "\n", "    ", 
         RowBox[{
          RowBox[{"vv", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"k", " ", "+", " ", "1"}], " ", ";;", " ", "n"}], "]"}], 
           "]"}], " ", "=", " ", 
          RowBox[{
           RowBox[{"vv", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"k", " ", "+", " ", "1"}], " ", ";;", " ", "n"}], "]"}],
             "]"}], "/", "vn"}]}], ";", "\n", "    ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{
