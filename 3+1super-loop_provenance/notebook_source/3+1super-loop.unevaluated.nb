             RowBox[{"{", 
              RowBox[{"q", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}]}],
          ";", "\n", "   ", 
         RowBox[{"worst7", " ", "=", " ", 
          RowBox[{"Max", "[", 
