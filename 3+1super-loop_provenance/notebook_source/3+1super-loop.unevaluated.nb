            RowBox[{"{", 
             RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], ";",
          "\n", "   ", 
         RowBox[{"nk", " ", "=", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"kv", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "^", "2"}], " ", "-", " ", 
           RowBox[{
