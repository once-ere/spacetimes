              RowBox[{"chem", ",", " ", "ratioG", ",", " ", 
               RowBox[{"t2solveGap", "[", 
                RowBox[{
                 RowBox[{"ratioG", " ", "as5Gcrit"}], ",", " ", "as5Lam", ",",
                  " ", "chem"}], "]"}], ",", " ", "0"}], "}"}]}], "]"}]}], 
          "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "0", ",", " ", "280"}], "}"}]}], "]"}], ";", 
       "\n", "  ", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"gap", " ", "=", " ", 
             RowBox[{"t2solveGap", "[", 
              RowBox[{
               RowBox[{"ratioG", " ", "as5Gcrit"}], ",", " ", "as5Lam", ",", 
               " ", "chem"}], "]"}]}], "}"}], ",", "\n", "    ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"gap", " ", ">", " ", "0."}], ",", "\n", "     ", 
             RowBox[{
              RowBox[{"as5Roots", "++"}], ";", "\n", "     ", 
              RowBox[{"as5DevRoot", " ", "=", " ", 
               RowBox[{"Max", "[", 
                RowBox[{"as5DevRoot", ",", " ", 
                 RowBox[{"Abs", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"t2gapIntegralQuad", "[", 
                    RowBox[{
                    "as5Lam", ",", " ", "chem", ",", " ", "gap", ",", " ", 
                    "0.", ",", " ", "as5GL"}], "]"}], " ", "ratioG", " ", 
                    "as5Gcrit"}], " ", "-", " ", "1."}], "]"}]}], "]"}]}], ";",
               "\n", "     ", 
              RowBox[{"AppendTo", "[", 
               RowBox[{"as5GapRows", ",", " ", 
                RowBox[{"{", 
                 RowBox[{
                 "chem", ",", " ", "ratioG", ",", " ", "gap", ",", " ", "1"}],
                  "}"}]}], "]"}]}]}], "]"}]}], "]"}], ",", "\n", "   ", 
         RowBox[{"{", 
          RowBox[{"ratioG", ",", " ", 
           RowBox[{"{", 
            RowBox[{
            "0.6", ",", " ", "1.2", ",", " ", "1.8", ",", " ", "2.4"}], 
            "}"}]}], "}"}]}], "]"}]}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"chem", ",", " ", 
        RowBox[{"{", 
         RowBox[{"0.", ",", " ", "0.3", ",", " ", "0.6"}], "}"}]}], "}"}]}], 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as5GapAt15", " ", "=", " ", 
     RowBox[{"t2solveGap", "[", 
      RowBox[{
       RowBox[{"1.5", " ", "as5Gcrit"}], ",", " ", "as5Lam", ",", " ", "0."}],
       "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", "4", ")"}], " ", "the", " ", "weak"}], "-", 
       RowBox[{"coupling", " ", 
        RowBox[{"(", "BCS", ")"}], " ", "limit", " ", "at", " ", "mu"}]}], 
      " ", "=", " ", 
      RowBox[{
       RowBox[{"0.3", ":", " ", 
        RowBox[{"for", " ", 
         RowBox[{"G", "/", "G_crit"}]}]}], " ", "=", " ", "0.3"}]}], ",", " ",
      "0.4", ",", " ", 
     RowBox[{"0.5", " ", "the", " ", "list", " ", 
      RowBox[{"{", 
       RowBox[{"gap", ",", " ", 
        RowBox[{
        "relative", " ", "deviation", " ", "of", "\n", "   ", "the", " ", 
         "gap", " ", "from", " ", "the", " ", "BCS", " ", "form"}], ",", " ", 
        
        RowBox[{"size", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"gap", "^", "2"}], "/", 
           RowBox[{"(", 
            RowBox[{"2", " ", 
             RowBox[{"mu", "^", "2"}]}], ")"}]}], ")"}], " ", "ln", 
         RowBox[{"(", 
          RowBox[{"1", "/", "gap"}], ")"}], " ", "of", " ", "the", " ", 
         "leading", " ", "correction"}]}], "}"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"as5Bcs", " ", "=", " ", 
     RowBox[{"Table", "[", "\n", "   ", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"chem", " ", "=", " ", "0.3"}], ",", " ", 
           RowBox[{"coupling", " ", "=", " ", 
            RowBox[{"ratioG", " ", "as5Gcrit"}]}], ",", " ", "gap", ",", " ", 
           "bcs"}], "}"}], ",", "\n", "    ", 
         RowBox[{
          RowBox[{"gap", " ", "=", " ", 
           RowBox[{"t2solveGap", "[", 
            RowBox[{"coupling", ",", " ", "as5Lam", ",", " ", "chem"}], 
            "]"}]}], ";", "\n", "    ", 
          RowBox[{"bcs", " ", "=", " ", 
           RowBox[{"2.", " ", 
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{"as5Lam", " ", "as5Lam"}], " ", "-", " ", 
              RowBox[{"chem", " ", "chem"}]}], "]"}], " ", 
            RowBox[{"Exp", "[", 
             RowBox[{"-", "1.5"}], "]"}], " ", 
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", 
               RowBox[{"(", 
                RowBox[{"Pi", " ", 
                 RowBox[{"Pi", "/", 
                  RowBox[{"(", 
                   RowBox[{"chem", " ", "chem"}], ")"}]}]}], ")"}]}], " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"1.", "/", "coupling"}], " ", "-", " ", 
                RowBox[{"1.", "/", "as5Gcrit"}]}], ")"}]}], "]"}]}]}], ";", 
          "\n", "    ", 
          RowBox[{"{", 
           RowBox[{"gap", ",", " ", 
            RowBox[{
             RowBox[{"gap", "/", "bcs"}], " ", "-", " ", "1."}], ",", " ", 
            RowBox[{"gap", " ", 
             RowBox[{"gap", "/", 
              RowBox[{"(", 
               RowBox[{"2.", " ", "chem", " ", "chem"}], ")"}]}], " ", 
             RowBox[{"Log", "[", 
              RowBox[{"1.", "/", "gap"}], "]"}]}]}], "}"}]}]}], "]"}], ",", 
       "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"ratioG", ",", " ", 
         RowBox[{"{", 
          RowBox[{"0.3", ",", " ", "0.4", ",", " ", "0.5"}], "}"}]}], "}"}]}],
       "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as5BcsOk", " ", "=", " ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{"as5Bcs", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "]"}], " ", "<", " ", 
         RowBox[{"2.", " ", 
          RowBox[{"#", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}]}], " ", "&"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<AS-5\>\"", ",", 
     " ", "\"\<the gap equation in closed form for massless spinor charges \
(case B): int_(q<Lambda) d^3q/(2 pi)^3 (1/E^+ + 1/E^-) with E^(+-) = ((q +- \
mu)^2 + Delta^2)^(1/2) equals (1/(4 pi^2)) [(Lambda - 3 mu) E^+(Lambda) + \
(Lambda + 3 mu) E^-(Lambda) + (2 mu^2 - Delta^2) (asinh((Lambda + mu)/Delta) \
+ asinh((Lambda - mu)/Delta))] for six pairs (mu, Delta) (relative deviation \
from composite Gauss-Legendre quadrature with 32 nodes per panel, tolerance \
1e-10); its limit Delta -> 0 at mu = 0 is Lambda^2/(2 pi^2), so that G_crit = \
2 pi^2/Lambda^2 (tolerance 1e-8); the gaps Delta(G) found from the closed \
form by bisection satisfy G int(...) = 1 with the integral computed by \
quadrature (the 11 of the 12 cases mu = 0, 0.3, 0.6 with G/G_crit = 0.6, 1.2, \
1.8, 2.4 that have a gap, tolerance 1e-9); and for mu > 0 and weak coupling \
(G < G_crit) the gap approaches the BCS form Delta = 2 (Lambda^2 - \
mu^2)^(1/2) exp(-3/2) exp(-(pi^2/mu^2) (1/G - 1/G_crit)), the relative \
deviation being smaller than twice the size (Delta^2/(2 mu^2)) ln(1/Delta) of \
the leading correction (mu = 0.3, G/G_crit = 0.3, 0.4, 0.5); Lambda = 1\>\"", 
     ",", "\n", "  ", 
     RowBox[{
      RowBox[{"as5DevClosed", " ", "<", " ", "1*^-10"}], " ", "&&", " ", 
      RowBox[{"as5GcritDev", " ", "<", " ", "1*^-8"}], " ", "&&", " ", 
      RowBox[{"as5DevRoot", " ", "<", " ", "1*^-9"}], " ", "&&", " ", 
      RowBox[{"as5Roots", " ", "==", " ", "11"}], " ", "&&", " ", 
      "as5BcsOk"}], ",", "\n", "  ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<largest deviations \>\"", ",", " ", 
        RowBox[{"asSci", "[", "as5DevClosed", "]"}], ",", " ", "\"\<, \>\"", ",",
         " ", 
        RowBox[{"asSci", "[", "as5GcritDev", "]"}], ",", " ", "\"\<, \>\"", ",",
         " ", 
        RowBox[{"asSci", "[", "as5DevRoot", "]"}], ",", " ", "\"\< (\>\"", ",",
         " ", "as5Roots", ",", 
        " ", "\"\< gaps); Delta at G = 1.5 G_crit, mu = 0: \>\"", ",", " ", 
        RowBox[{"asFix", "[", 
         RowBox[{"as5GapAt15", ",", " ", "6"}], "]"}], ",", "\n", 
        "    ", "\"\<; weak coupling at mu = 0.3, G/G_crit = 0.3, 0.4, 0.5: \
Delta = \>\"", ",", "\n", "    ", 
        RowBox[{"Row", "[", 
         RowBox[{"Riffle", "[", 
          RowBox[{
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Row", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"ScientificForm", "[", 
                  RowBox[{
                   RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", " ", "4"}], "]"}], ",",
                  " ", "\"\< (\>\"", ",", " ", 
                 RowBox[{"asSci", "[", 
                  RowBox[{"#", "[", 
                   RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", 
                 " ", "\"\<, scale \>\"", ",", " ", 
                 RowBox[{"asSci", "[", 
                  RowBox[{"#", "[", 
                   RowBox[{"[", "3", "]"}], "]"}], "]"}], ",", 
                 " ", "\"\<)\>\""}], "}"}], "]"}], " ", "&"}], ",", " ", 
             "as5Bcs"}], "]"}], ",", " ", "\"\<, \>\""}], "]"}], "]"}], ",", 
        "\n", "    ", "\"\< (original: 1.8e-15, 0.0e0, 2.2e-15 (11 gaps); \
0.675339; 9.985e-7 (-7.6e-11, scale 7.7e-11), 1.023e-4 (-5.3e-7, scale \
5.3e-7), 1.646e-3 (-9.5e-5, scale 9.6e-5))\>\""}], "}"}], "]"}]}], 
    "]"}]}]}]], "Input",ExpressionUUID->"a8763d98-4aaa-460b-9ff1-\
2cc232790480"],

Cell[TextData[{
 StyleBox["The uniform state is an exact self-consistent solution on the \
lattice (check AS-6).",
  FontWeight->"Bold"],
 " The self-consistency condition of the mean field is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Iota]"], 
    RowBox[{"(", 
     SubscriptBox[
      StyleBox["x", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"]], ")"}], "\[LongEqual]", 
    RowBox[{"-", 
     FractionBox["1", "2"]}], 
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[ThinSpace]", "\[Sum]", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[Psi]", 
       RowBox[{
        StyleBox["LL",
         FontSlant->"Plain"], ",", 
        StyleBox["n", "TI"]}], 
       StyleBox["p",
        FontSlant->"Plain"]], ")"}], 
     StyleBox["T", "TI"]], 
    SubsuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Iota]"], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[Psi]", 
       RowBox[{
        StyleBox["LL",
         FontSlant->"Plain"], ",", 
        StyleBox["n", "TI"]}], 
       StyleBox["h",
        FontSlant->"Plain"]], ")"}], "*"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "38f0dccc-ad36-4066-8bf8-2e72d6ef2410"],
 ", where the sum runs over the modes with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["E", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["n", "TI"]}], 
     StyleBox["qp",
      FontSlant->"Plain"]], ">", "0"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9b465ef3-e2a6-42e6-83b2-9d2b79f4c6dc"],
 " and every mode is normalized so that the integral of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      SubsuperscriptBox["\[Psi]", 
       RowBox[{
        StyleBox["LL",
         FontSlant->"Plain"], ",", 
        StyleBox["n", "TI"]}], 
       StyleBox["p",
        FontSlant->"Plain"]], "\[RightBracketingBar]"}], "2"], "+", 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      SubsuperscriptBox["\[Psi]", 
       RowBox[{
        StyleBox["LL",
         FontSlant->"Plain"], ",", 
        StyleBox["n", "TI"]}], 
       StyleBox["h",
        FontSlant->"Plain"]], "\[RightBracketingBar]"}], "2"]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "46189d7a-c2e6-4631-8be1-92e00d762f71"],
 " over space is 1. On a chain the eigenvectors of the lattice operator are \
unit vectors, and the modes with this normalization are their components \
divided by ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox["\[ScriptL]", 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["x",
       FontSlant->"Plain"]], ")"}], 
    RowBox[{"1", "/", "2"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3ef3469e-efc5-4211-b46c-cc910044411d"],
 ". For the uniform polar state the eight positive-energy eigenvectors of one \
momentum contribute together ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "2"}], 
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     RowBox[{"1", "/", 
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "+"], "+", "1", "/", 
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "-"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2620fb11-89fb-413d-bc43-6b1417c0f912"],
 " to the sum of the third isospin direction (check GS-9), divided by ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["x",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c2485f54-dc9b-45f5-be3f-dfb35c0f35f9"],
 " because a unit vector spreads its norm over the sites of the chain, and \
nothing to the directions 1 and 2. The sum over the modes at every site is \
therefore ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "2"}], 
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["n", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["x",
        FontSlant->"Plain"]], ")"}], 
     RowBox[{"-", "1"}]], "\[ThinSpace]", "\[Sum]", 
    RowBox[{"(", 
     RowBox[{"1", "/", 
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "+"], "+", "1", "/", 
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "-"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0312c47f-1d6d-4067-83d5-3f804aed6ae1"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Iota]", "\[LongEqual]", "3"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fa29159d-6b06-4763-9f31-cfc87149924f"],
 ", the last sum running over the allowed momenta with ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CurlyEpsilon]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["lat",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d7a7fc93-ad22-47b0-8c28-6f06615fe4b0"],
 " in ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "\[PlusMinus]"], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "eb85d54f-0f4a-4b80-a399-165669371bed"],
 ", and 0 for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Iota]", "\[LongEqual]", "1", ",", "2"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "802545d7-0816-457f-87c6-c5bfa38bf3b8"],
 ". The self-consistency condition then returns the same pair field ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "0", ",", 
     SubscriptBox["\[CapitalDelta]", 
      StyleBox["LL",
       FontSlant->"Plain"]]}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "83b5584e-4981-475e-a810-ab2473817365"],
 " on every site exactly when"
}], "Text",ExpressionUUID->"2e7727fd-a433-408e-8af7-7a07187639d2"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox["1", 
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]]], "\[LongEqual]", 
   FractionBox["1", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["n", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["x",
       FontSlant->"Plain"]], 
     SubsuperscriptBox["\[ScriptL]", 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["x",
       FontSlant->"Plain"]]}]], "\[ThinSpace]", 
   UnderscriptBox["\[Sum]", 
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "1"],
    LimitsPositioning->True], 
   RowBox[{"(", 
    RowBox[{
     FractionBox["1", 
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "+"]], "+", 
     FractionBox["1", 
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "-"]]}], ")"}]}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"7ae72065-2e01-4ba7-a7e2-af64e17ea27a"],

Cell[TextData[{
 "the gap equation of the chain: the sum over the allowed momenta, divided by \
the circumference of the ring, stands in place of the integral over ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["q", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "1"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b3fd7baa-b11e-4209-9555-362363747543"],
 " divided by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Pi]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c747e89c-ea79-41f8-aa19-2da29fa6cb9e"],
 ". Check AS-6 computes the sum over the modes with the routine of the \
solvers (",
 StyleBox["t2anomalous",
  FontFamily->"Source Code Pro"],
 ") from the 128 positive-energy eigenvectors of the chain of 16 sites of \
check AS-4, compares it with the formula, and verifies that the \
self-consistency condition with the coupling of the displayed equation gives \
back ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalDelta]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "958ffd55-644b-4539-8267-41ecf96c9f2f"],
 " on every site: a fixed point that the self-consistent solvers of the items \
[3] and [5] must reproduce."
}], "Text",ExpressionUUID->"9799630e-2927-483a-899a-03b2fcf712c8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"AS", "-", "6"}], ":", " ", 
     RowBox[{
      RowBox[{
      "the", " ", "chain", " ", "and", " ", "the", " ", "pair", " ", "field", 
       " ", "of", " ", "AS"}], "-", 
      RowBox[{"4", " ", 
       RowBox[{"(", 
        RowBox[{
        "the", " ", "original", " ", "program", " ", "builds", " ", "the", " ",
          "same", " ", "chain", " ", "a", " ", "second", " ", "time"}], 
        ")"}]}]}]}], ";", " ", 
    RowBox[{
    "the", "\n", "   ", "eigenvectors", " ", "of", " ", "its", " ", 
     "positive", " ", "eigenvalues", " ", "are", " ", "the", " ", "modes"}]}],
    " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"as6Ev", ",", " ", "as6Vec"}], "}"}], " ", "=", " ", 
     RowBox[{"t2eigh", "[", "as4H", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as6Modes", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"as6Vec", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", "col"}], "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"col", ",", " ", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"Range", "[", 
            RowBox[{"Length", "[", "as6Ev", "]"}], "]"}], ",", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"as6Ev", "[", 
              RowBox[{"[", "#", "]"}], "]"}], " ", ">", " ", "0"}], " ", 
            "&"}]}], "]"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "sum", " ", "over", " ", "the", " ", "modes", " ", "of", " ", 
      RowBox[{"psi_p", "^", "T"}], " ", "Kch_iota", " ", "conj", 
      RowBox[{"(", "psi_h", ")"}], " ", "at", " ", "every", " ", "site"}], ",",
      " ", 
     RowBox[{
     "by", " ", "the", " ", "routine", " ", "of", " ", "the", " ", 
      "solvers"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"as6Pi", " ", "=", " ", 
     RowBox[{"t2anomalous", "[", 
      RowBox[{"as4N", ",", " ", "as6Modes"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "the", " ", "sum", " ", "over", " ", "the", " ", "16", " ", "allowed", " ",
      "momenta", " ", "of", " ", 
     RowBox[{
      RowBox[{"1", "/", 
       RowBox[{"E", "^", 
        RowBox[{"-", " ", 
         RowBox[{"+", " ", "1"}]}]}]}], "/", 
      RowBox[{"E", "^", 
       RowBox[{"+", " ", 
        RowBox[{"(", 
         RowBox[{"eps_lat", " ", "in", " ", "place", " ", "of", " ", "eps"}], 
         ")"}]}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"as6Sum", " ", "=", " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"el", " ", "=", " ", 
           RowBox[{"t2epsLat", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"t2chainMomentum", "[", 
                RowBox[{"kq", ",", " ", "as4N", ",", " ", "asBEll"}], "]"}], ",",
                " ", "0.", ",", " ", "0."}], "}"}], ",", " ", "asBEll", ",", 
             " ", "mass", ",", " ", "1.0", ",", " ", "asChainActive"}], 
            "]"}]}], "}"}], ",", "\n", "    ", 
         RowBox[{
          RowBox[{"1.", "/", 
           RowBox[{"Sqrt", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"el", " ", "-", " ", "asBMu"}], ")"}], "^", "2"}], " ",
              "+", " ", 
             RowBox[{"asBDelta", "^", "2"}]}], "]"}]}], " ", "+", " ", 
          RowBox[{"1.", "/", 
           RowBox[{"Sqrt", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"el", " ", "+", " ", "asBMu"}], ")"}], "^", "2"}], " ",
              "+", " ", 
             RowBox[{"asBDelta", "^", "2"}]}], "]"}]}]}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"kq", ",", " ", "0", ",", " ", 
         RowBox[{"as4N", " ", "-", " ", "1"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as6PiExpect", " ", "=", " ", 
     RowBox[{
      RowBox[{"-", "2."}], " ", "asBDelta", " ", 
      RowBox[{"as6Sum", "/", "as4N"}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "coupling", " ", "of", " ", "the", " ", "lattice", " ", 
      "gap", " ", "equation", " ", 
      RowBox[{"1", "/", "G"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"N", " ", "dx"}], ")"}]}], ")"}], " ", "sum_q", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"1", "/", 
         RowBox[{"E", "^", 
          RowBox[{"+", " ", 
           RowBox[{"+", " ", "1"}]}]}]}], "/", 
        RowBox[{"E", "^", "-"}]}], ")"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"as6G", " ", "=", " ", 
     RowBox[{"1.", "/", 
      RowBox[{"(", 
       RowBox[{"as6Sum", "/", 
        RowBox[{"(", 
         RowBox[{"as4N", " ", "asBEll"}], ")"}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as6DevSum", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"as6Pi", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], "]"}], ",", " ", 
       RowBox[{"Abs", "[", 
        RowBox[{"as6Pi", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}], ",", " ", 
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"as6Pi", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", " ", "3"}], "]"}], "]"}], " ", "-", " ", 
         "as6PiExpect"}], "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", "new", " ", "pair", " ", "field", " ", 
      RowBox[{"d", "^", "3"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{"G", "/", "2"}], ")"}]}], " ", 
       RowBox[{"Pi", "^", "3"}], " ", "with", " ", 
       RowBox[{"Pi", "^", "3"}]}], " ", "=", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"mode", " ", "sum"}], ")"}], "/", "dx"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"as6DevNew", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"as6Pi", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", " ", "3"}], "]"}], "]"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "0.5"}], " ", 
           RowBox[{"as6G", "/", "asBEll"}]}], ")"}]}], " ", "-", " ", 
        "asBDelta"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<AS-6\>\"", ",", 
     " ", "\"\<the uniform polar state is an exact self-consistent solution \
of the lattice mean-field equations (case B): on a periodic chain of 16 sites \
(dx = 0.5, r_W = 1, m = 0.4, mu = 0.6) with dvec = (0, 0, 0.3), the sum over \
the 128 positive-energy eigenvectors of the lattice operator (unit vectors, \
with the particle part psi_p and the hole part psi_h) of psi_p^T Kch_iota \
conj(psi_h), computed at every site by the routine of the solvers, is 0 for \
iota = 1, 2 and -2 Delta (1/16) sum_q (1/E^+ + 1/E^-) (eps_lat in place of \
eps, the 16 allowed momenta) for iota = 3 (tolerance 1e-12); with Pi_iota = \
dx^(-1) times this sum (the continuum normalization of a chain) and the \
coupling G given by the lattice gap equation 1/G = (1/(16 dx)) sum_q (1/E^+ + \
1/E^-), the self-consistency condition d_iota = -(G/2) Pi_iota gives back \
dvec = (0, 0, Delta) on every site (tolerance 1e-12): a fixed point that the \
self-consistent solvers must reproduce\>\"", ",", "\n", "  ", 
     RowBox[{
      RowBox[{"as6DevSum", " ", "<", " ", "1*^-12"}], " ", "&&", " ", 
      RowBox[{"as6DevNew", " ", "<", " ", "1*^-12"}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"Length", "[", "as6Modes", "]"}], " ", "==", " ", 
       RowBox[{"8", " ", "as4N"}]}]}], ",", "\n", "  ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Length", "[", "as6Modes", "]"}], ",", 
        " ", "\"\< positive modes; largest deviations \>\"", ",", " ", 
        RowBox[{"asSci", "[", "as6DevSum", "]"}], ",", 
        " ", "\"\< (mode sum), \>\"", ",", " ", 
        RowBox[{"asSci", "[", "as6DevNew", "]"}], ",", 
        " ", "\"\< (new dvec); G = \>\"", ",", " ", 
        RowBox[{"asFix", "[", 
         RowBox[{"as6G", ",", " ", "6"}], "]"}], ",", "\n", 
        "    ", "\"\< (original: 128 positive modes; 2.6e-15, 1.1e-15; G = \
0.432159)\>\""}], "}"}], "]"}]}], "]"}]}]}]], "Input",ExpressionUUID->\
"19e2a3db-f186-4a15-8540-28a7706a4611"],

Cell["\<\
Case C: a domain wall of the pair field (checks AS-7 to AS-9)\
\>", "Subsection",ExpressionUUID->"b5a4f345-7e03-4fe1-b3d9-b5bc7c94896b"],

Cell[TextData[{
 StyleBox["The fields.",
  FontWeight->"Bold"],
 " No gauge fields, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Mu]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "10f6e3a0-4d11-46f7-80ba-b06b7c963172"],
 ", and a real pair field along the third isospin direction that depends on \
",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "1"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a7f80fe5-3c43-44a7-b467-221ec59a2ee1"],
 " and changes its sign: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["d", "TI"], "\[RightVector]"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{"0", ",", "0", ",", 
      SubscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["x", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], "1"], ")"}]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0379b501-0e22-4af9-981c-82e6db986a88"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["x", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], "1"], ")"}], "\[LongEqual]", 
    SubsuperscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Infinity]"], "\[ThinSpace]", 
    StyleBox["tanh",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "1"], "/", 
      SubsuperscriptBox["\[ScriptL]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["K",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4fd5e87e-5318-4970-905d-43185df923fe"],
 ". Two superfluid domains with opposite signs of the order parameter meet at \
a wall of the width ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[ScriptL]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["K",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bb63d1fd-c037-4e81-87fc-0fb9a4d3079a"],
 " (a kink); ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalDelta]", 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Infinity]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "55bc9e73-af36-4ebd-ac7b-d62cb7b7721a"],
 " is the gap far from the wall. The fields do not depend on ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cdce497c-5f94-4975-b78e-b32a2925174b"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7b7dc8b0-f722-4157-8b72-800cbc2ccfba"],
 ", and the modes are plane waves ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["exp",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["i", "TI"], 
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox[
         StyleBox["q", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], "2"], 
        SubsuperscriptBox[
         StyleBox["x", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], "2"], "+", 
        SubsuperscriptBox[
         StyleBox["q", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], "3"], 
        SubsuperscriptBox[
         StyleBox["x", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], "3"]}], ")"}]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bf476ea6-f917-43c8-928b-b510c458f204"],
 " along the wall; first ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "2"], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "3"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fd1cdee8-b104-46f2-90e0-6692d8d935b6"],
 "."
}], "Text",ExpressionUUID->"ee89a501-a333-42a3-a18b-5b25d29744c8"],

Cell[TextData[{
 StyleBox["Four facts about the matrices.",
  FontWeight->"Bold"],
 " With ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "3"], "\[LongEqual]", 
    StyleBox["diag",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["E",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"]], ",", 
      SubscriptBox[
       StyleBox["E",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}], "\[CircleTimes]", 
    SubsuperscriptBox["\[Tau]", "1", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d61585b7-f015-484d-8bc6-84f908b007a2"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], "\[LongEqual]", 
    StyleBox["diag",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       SubsuperscriptBox["\[Sigma]", "1", 
        StyleBox["LL",
         FontSlant->"Plain"]]}], ",", 
      SubsuperscriptBox["\[Sigma]", "1", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "44882de4-0089-4887-936e-36f0536982ab"],
 ": (1) ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox[
         StyleBox["K",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], 
         StyleBox["LL",
          FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"], ")"}], "2"], "\[LongEqual]", 
    RowBox[{"-", 
     SubscriptBox[
      StyleBox["1",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "8"]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8379d65e-5b87-4633-9012-7c08cd84fffb"],
 "; (2) ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"], 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], "\[LongEqual]", 
    RowBox[{"-", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["K",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["LL",
         FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"]}]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "89548351-e0d5-449c-bba8-a6f345c237ed"],
 ", because ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Sigma]", "1", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["E",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Sigma]", "1", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"-", 
     SubscriptBox[
      StyleBox["E",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"]]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "29be098c-2442-4956-91d6-04cdc1ada58c"],
 "; (3) ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"], 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], "\[LongEqual]", 
    RowBox[{"-", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["K",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["LL",
         FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"]}], 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], 
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0fc1976a-7d08-4a3b-b53e-164922a8abee"],
 ", because ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Beta]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2992d653-cfc9-46a0-8cc1-1e2f81369519"],
 " commutes with ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6fd3825f-ac26-429c-a1fb-9bc524c013fe"],
 " and anticommutes with ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Alpha]", 
    StyleBox["LL",
     FontSlant->"Plain"], "1"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a434ae70-e555-4e97-bab9-e9e3ec0253ba"],
 "; (4) ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Alpha]", 
    StyleBox["LL",
     FontSlant->"Plain"], "1"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f0f21f2a-8882-4bf2-8cc4-47d2fbf75b7f"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Beta]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6cf51025-8aef-4162-a055-41c000216faf"],
 " are real."
}], "Text",ExpressionUUID->"fba31103-cb37-4ac2-98e0-aa4c6e1bee57"],

Cell[TextData[{
 StyleBox["The bound states.",
  FontWeight->"Bold"],
 " Let the profile ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CurlyPhi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["K",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3de7dca3-6850-4a76-8526-ce32dc28a48d"],
 " solve ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], 
    SubsuperscriptBox["\[CurlyPhi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]], "/", 
    StyleBox["d", "TI"], 
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], "\[LongEqual]", 
    RowBox[{"-", 
     SubscriptBox["\[CapitalDelta]", 
      StyleBox["LL",
       FontSlant->"Plain"]]}], 
    SubsuperscriptBox["\[CurlyPhi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c4f45db2-f634-43c3-b9b4-fbe54b1947ec"],
 "; for the kink this is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CurlyPhi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["x", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], "1"], ")"}], "\[LongEqual]", 
    StyleBox["cosh",
     FontSlant->"Plain"], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["x", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], "1"], "/", 
       SubsuperscriptBox["\[ScriptL]", 
        StyleBox["LL",
         FontSlant->"Plain"], 
        StyleBox["K",
         FontSlant->"Plain"]]}], ")"}], 
     RowBox[{
      RowBox[{"-", 
       SubsuperscriptBox["\[CapitalDelta]", 
        StyleBox["LL",
         FontSlant->"Plain"], "\[Infinity]"]}], 
      SubsuperscriptBox["\[ScriptL]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["K",
        FontSlant->"Plain"]]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c19eddef-9fee-4558-93d0-2006d844eb86"],
 ". Let ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Chi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["K",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c6846119-abaf-4920-9d13-b61be3dbc9a6"],
 " be a constant spinor of eight components with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Chi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"\[PlusMinus]", 
     SubsuperscriptBox["\[Chi]", 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["K",
       FontSlant->"Plain"]]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "195b60f3-eb10-4e59-9f82-eef76a870b05"],
 ". Then the mode"
}], "Text",ExpressionUUID->"6a5f2033-5652-4b06-b454-a59c80cd7a21"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["\[Psi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p",
     FontSlant->"Plain"]], "\[LongEqual]", 
   SubsuperscriptBox["\[CurlyPhi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["K",
     FontSlant->"Plain"]], 
   SubsuperscriptBox["\[Chi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["K",
     FontSlant->"Plain"]], ",", "      ", 
   SubsuperscriptBox["\[Psi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["h",
     FontSlant->"Plain"]], "\[LongEqual]", 
   StyleBox["i", "TI"], 
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"], 
   SubsuperscriptBox["\[Alpha]", 
    StyleBox["LL",
     FontSlant->"Plain"], "1"], 
   SubsuperscriptBox["\[CurlyPhi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["K",
     FontSlant->"Plain"]], 
   SubsuperscriptBox["\[Chi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["K",
     FontSlant->"Plain"]], ",", "      ", 
   SubsuperscriptBox[
    StyleBox["E", "TI"], 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["n", "TI"]}], 
    StyleBox["qp",
     FontSlant->"Plain"]], "\[LongEqual]", 
   RowBox[{"\[PlusMinus]", 
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}]}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"59abb68e-e489-4aa3-ac75-7475ece40778"],

Cell[TextData[{
 "is a stationary solution of the field equations. Proof. The particle row is \
the sum of three terms. Because ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], 
    SubsuperscriptBox["\[CurlyPhi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]], "/", 
    StyleBox["d", "TI"], 
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], "\[LongEqual]", 
    RowBox[{"-", 
     SubscriptBox["\[CapitalDelta]", 
      StyleBox["LL",
       FontSlant->"Plain"]]}], 
    SubsuperscriptBox["\[CurlyPhi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "77944e47-c13a-48fa-a8f2-8b247444de1b"],
 ", the first term is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     StyleBox["i", "TI"]}], 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], 
    SubscriptBox["\[PartialD]", "1"], 
    SubsuperscriptBox["\[Psi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p",
      FontSlant->"Plain"]], "\[LongEqual]", 
    StyleBox["i", "TI"], 
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[CurlyPhi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], 
    SubsuperscriptBox["\[Chi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f074a1f2-32ec-4ef1-8fc0-0d3b7dea4604"],
 ". The second is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Psi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"\[PlusMinus]", 
     SubscriptBox[
      StyleBox["m", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"]]}], 
    SubsuperscriptBox["\[Psi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "66843f97-6aa1-4b12-a246-0f232941071b"],
 ". The third is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"], 
    SubsuperscriptBox["\[Psi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["h",
      FontSlant->"Plain"]], "\[LongEqual]", 
    StyleBox["i", "TI"], 
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[CurlyPhi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox[
         StyleBox["K",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], 
         StyleBox["LL",
          FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"], ")"}], "2"], 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], 
    SubsuperscriptBox["\[Chi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d3746006-0ba8-43ce-b083-94d36bc9a126"],
 ", which by fact (1) is minus the first. The particle row is therefore ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[PlusMinus]", 
     SubscriptBox[
      StyleBox["m", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"]]}], 
    SubsuperscriptBox["\[Psi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6cfdc68e-5344-4fbc-9119-4687d0c76c3c"],
 ". The hole row, with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["P",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Dagger]"], "\[LongEqual]", 
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "3"], "\[LongEqual]", 
    RowBox[{"-", 
     SubscriptBox["\[CapitalDelta]", 
      StyleBox["LL",
       FontSlant->"Plain"]]}], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4475ddcf-5c5a-4524-bd2b-23ee6e20ed28"],
 " and the real matrices of fact (4), is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "3"], 
    SubsuperscriptBox["\[Psi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p",
      FontSlant->"Plain"]], "-", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["i", "TI"], 
      SubsuperscriptBox["\[Alpha]", 
       StyleBox["LL",
        FontSlant->"Plain"], "1"], 
      SubscriptBox["\[PartialD]", "1"], "+", 
      SubscriptBox["\[Beta]", 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      SubscriptBox[
       StyleBox["m", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}], 
    SubsuperscriptBox["\[Psi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["h",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "05c2d756-956f-4ead-8854-2929b24cffd4"],
 ", again three terms. The first is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "3"], 
    SubsuperscriptBox["\[Psi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"-", 
     SubscriptBox["\[CapitalDelta]", 
      StyleBox["LL",
       FontSlant->"Plain"]]}], 
    SubsuperscriptBox["\[CurlyPhi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"], 
    SubsuperscriptBox["\[Chi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "23f63e70-1867-469d-8d44-e042991c56b3"],
 ". The second is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     StyleBox["i", "TI"]}], 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], 
    SubscriptBox["\[PartialD]", "1"], 
    SubsuperscriptBox["\[Psi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["h",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"-", 
     SubscriptBox["\[CapitalDelta]", 
      StyleBox["LL",
       FontSlant->"Plain"]]}], 
    SubsuperscriptBox["\[CurlyPhi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"], 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], 
    SubsuperscriptBox["\[Chi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fe8a56c9-3ff2-4c02-8096-ff9fd8b471eb"],
 ", which by fact (2) is minus the first. The third is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     SubscriptBox["\[Beta]", 
      StyleBox["LL",
       FontSlant->"Plain"]]}], 
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Psi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["h",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"-", 
     StyleBox["i", "TI"]}], 
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[CurlyPhi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]], 
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"], 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], 
    SubsuperscriptBox["\[Chi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e02e2e83-e3c6-43fa-9c60-a65b0ac84865"],
 ", which by fact (3) is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["i", "TI"], 
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[CurlyPhi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"], 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], 
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Chi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"\[PlusMinus]", 
     SubscriptBox[
      StyleBox["m", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"]]}], 
    SubsuperscriptBox["\[Psi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["h",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c6ba519e-fa12-47a3-be18-b3d09cb43b6d"],
 ". The hole row is therefore ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[PlusMinus]", 
     SubscriptBox[
      StyleBox["m", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"]]}], 
    SubsuperscriptBox["\[Psi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["h",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ccc5f637-e987-4556-b520-7d80f96924e0"],
 ", and the proof is complete."
}], "Text",ExpressionUUID->"939c5f98-d0e6-4294-8481-f61f787fda7b"],

Cell[TextData[{
 "The profile falls off like ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["exp",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       SubsuperscriptBox["\[CapitalDelta]", 
        StyleBox["LL",
         FontSlant->"Plain"], "\[Infinity]"]}], 
      RowBox[{"\[LeftBracketingBar]", 
       SubsuperscriptBox[
        StyleBox["x", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], "1"], "\[RightBracketingBar]"}]}], ")"}]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9c912712-077b-43ce-a1ab-e1b444ea5cda"],
 " on both sides of the wall, because ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalDelta]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "21e83641-25a9-40f3-8bbc-f1750adab2a2"],
 " has opposite signs on the two sides: the state is bound to the wall. The \
spinors with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Chi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"+", 
     SubsuperscriptBox["\[Chi]", 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["K",
       FontSlant->"Plain"]]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "77098c8c-ea37-4c0e-98ee-ed3f034fb0fb"],
 " form a space of four dimensions, and so do those with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Chi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"-", 
     SubsuperscriptBox["\[Chi]", 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["K",
       FontSlant->"Plain"]]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "72b08c02-22ac-4dda-b1de-5e2ca7c123c5"],
 ": every wall carries four bound states of the energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", 
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "180c8685-1856-448c-963e-404cd213649c"],
 " and four of the energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ce4632e2-1236-4dca-9504-bc21c0aadcf1"],
 ". Their energy does not depend on the shape of the profile, only on its \
change of sign (the mechanism of Jackiw and Rebbi, here for the pair field of \
the spinor charges). For an antikink, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"-", 
     SubsuperscriptBox["\[CapitalDelta]", 
      StyleBox["LL",
       FontSlant->"Plain"], "\[Infinity]"]}], "\[ThinSpace]", 
    StyleBox["tanh",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "1"], "/", 
      SubsuperscriptBox["\[ScriptL]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["K",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5a01196c-7536-4d37-86c8-f87d6c2a2fa9"],
 ", the bound states have the same profile and the same energies, and the \
hole part has the opposite sign. Check AS-7 verifies the four facts, and the \
sixteen component equations of the mode at 50 random points with random \
spinors ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Chi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["K",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "27ef30a2-4c28-43ac-a237-79f8bf67e35a"],
 " (a random vector projected on the eigenspace of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Beta]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8998883e-a6c8-43b2-a779-d09ef35076e0"],
 " with the eigenvalue ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1f8a676c-ae9b-487e-9b42-8f60498da328"],
 " or ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8fb8eb12-6dd5-437b-9c0d-e7a54881e067"],
 "), for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Infinity]"], "\[LongEqual]", "1"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "43eec8fc-c14b-4251-953e-b2a0e9ee1488"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[ScriptL]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "08c7c6f5-60b2-4a11-be36-65c87db6e042"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0.4"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "553ab353-31de-414f-a1f7-551e175c0dbf"],
 "."
}], "Text",ExpressionUUID->"d400f60e-d82f-419f-9bc6-7cca30c981e9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"AS", "-", "7"}], ":", " ", 
    RowBox[{
    "the", " ", "identities", " ", "of", " ", "the", " ", "8", " ", "x", " ", 
     "8", " ", "matrices", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"asK3dag", " ", "is", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"K", "^", "3"}], ")"}], "^", "dag"}]}], ",", " ", 
       RowBox[{
        RowBox[{"asAlpha", "[", 
         RowBox[{"[", "1", "]"}], "]"}], " ", "is", " ", 
        RowBox[{"alpha", "^", "1"}]}], ",", " ", 
       RowBox[{"asBeta", " ", "is", " ", "beta"}]}], ")"}]}]}], " ", "*)"}], 
  "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"as7IdDev", " ", "=", " ", 
     RowBox[{
      RowBox[{"fro", "[", 
       RowBox[{
        RowBox[{"asK3dag", " ", ".", " ", "asK3dag"}], " ", "+", " ", 
        RowBox[{"IdentityMatrix", "[", "8", "]"}]}], "]"}], " ", "+", " ", 
      RowBox[{"fro", "[", 
       RowBox[{
        RowBox[{"ConjugateTranspose", "[", "asK3dag", "]"}], " ", "+", " ", 
        "asK3dag"}], "]"}], " ", "+", "\n", "   ", 
      RowBox[{"fro", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"asAlpha", "[", 
          RowBox[{"[", "1", "]"}], "]"}], " ", ".", " ", "asK3dag", " ", ".", 
         " ", 
         RowBox[{"asAlpha", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], " ", "+", " ", "asK3dag"}], "]"}],
       " ", "+", " ", 
      RowBox[{"fro", "[", 
       RowBox[{
        RowBox[{"asBeta", " ", ".", " ", "asK3dag", " ", ".", " ", 
         RowBox[{"asAlpha", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], " ", "+", " ", 
        RowBox[{"asK3dag", " ", ".", " ", 
         RowBox[{"asAlpha", "[", 
          RowBox[{"[", "1", "]"}], "]"}], " ", ".", " ", "asBeta"}]}], "]"}], 
      " ", "+", "\n", "   ", 
      RowBox[{"fro", "[", 
       RowBox[{
        RowBox[{"asAlpha", "[", 
         RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", 
        RowBox[{"Conjugate", "[", 
         RowBox[{"asAlpha", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "]"}], " ", "+", " ", 
      RowBox[{"fro", "[", 
       RowBox[{"asBeta", " ", "-", " ", 
        RowBox[{"Conjugate", "[", "asBeta", "]"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"the", " ", "kink", " ", "of", " ", "case", " ", 
     RowBox[{"C", ":", " ", 
      RowBox[{
      "the", " ", "gap", " ", "far", " ", "from", " ", "the", " ", "wall", " ",
        "and", " ", "the", " ", "width", " ", "of", " ", "the", " ", 
       "wall"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"asCDinf", ",", " ", "asCEllK"}], "}"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"1.0", ",", " ", "1.0"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as7Dev", " ", "=", " ", "0."}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"x", " ", "=", " ", 
           RowBox[{"4.", " ", 
            RowBox[{"t2Unit", "[", "]"}]}]}], ",", " ", "gap", ",", " ", 
          "phi", ",", " ", "dphi", ",", " ", "y", ",", " ", "sg", ",", " ", 
          "chi", ",", " ", "eta", ",", " ", "u", ",", " ", "du", ",", " ", 
          "v", ",", " ", "dv", ",", " ", "rowP", ",", " ", "rowH"}], "}"}], ",",
         "\n", "   ", 
        RowBox[{
         RowBox[{"gap", " ", "=", " ", 
          RowBox[{"asCDinf", " ", 
           RowBox[{"Tanh", "[", 
            RowBox[{"x", "/", "asCEllK"}], "]"}]}]}], ";", "\n", "   ", 
         RowBox[{"phi", " ", "=", " ", 
          RowBox[{
           RowBox[{"Cosh", "[", 
            RowBox[{"x", "/", "asCEllK"}], "]"}], "^", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "asCDinf"}], " ", "asCEllK"}], ")"}]}]}], ";", "\n",
          "   ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{"the", " ", "derivative", " ", "of", " ", "the", " ", 
            RowBox[{"profile", ":", " ", 
             RowBox[{"phi_K", "'"}]}]}], " ", "=", " ", 
           RowBox[{
            RowBox[{"-", "Delta"}], " ", "phi_K"}]}], " ", "*)"}], "\n", 
         "   ", 
         RowBox[{"dphi", " ", "=", " ", 
          RowBox[{
           RowBox[{"-", "gap"}], " ", "phi"}]}], ";", "\n", "   ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{"chi_K", ":", " ", 
            RowBox[{
            "a", " ", "random", " ", "vector", " ", "projected", " ", "on", " ",
              "the", " ", "eigenspace", " ", "beta"}]}], " ", "=", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"+", "1"}], " ", 
             RowBox[{"(", 
              RowBox[{"even", " ", "trials"}], ")"}], " ", "or"}], " ", "-", 
            RowBox[{"1", " ", 
             RowBox[{"(", 
              RowBox[{"odd", " ", "trials"}], ")"}]}]}]}], " ", "*)"}], "\n", 
         "   ", 
         RowBox[{"y", " ", "=", " ", 
          RowBox[{"t2RndVec", "[", "8", "]"}]}], ";", "\n", "   ", 
         RowBox[{"sg", " ", "=", " ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"EvenQ", "[", "trial", "]"}], ",", " ", "1.", ",", " ", 
            RowBox[{"-", "1."}]}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"chi", " ", "=", " ", 
          RowBox[{"0.5", " ", 
           RowBox[{"(", 
            RowBox[{"y", " ", "+", " ", 
             RowBox[{"sg", " ", 
              RowBox[{"asBeta", " ", ".", " ", "y"}]}]}], ")"}]}]}], ";", 
         "\n", "   ", 
         RowBox[{"(*", " ", 
          RowBox[{"i", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"K", "^", "3"}], ")"}], "^", "dag"}], " ", 
           RowBox[{"alpha", "^", "1"}], " ", "chi_K"}], " ", "*)"}], "\n", 
         "   ", 
         RowBox[{"eta", " ", "=", " ", 
          RowBox[{"I", " ", 
           RowBox[{"asK3dag", " ", ".", " ", 
            RowBox[{"asAlpha", "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", ".", " ", "chi"}]}]}], ";", 
         "\n", "   ", 
         RowBox[{"u", " ", "=", " ", 
          RowBox[{"phi", " ", "chi"}]}], ";", " ", 
         RowBox[{"du", " ", "=", " ", 
          RowBox[{"dphi", " ", "chi"}]}], ";", " ", 
         RowBox[{"v", " ", "=", " ", 
          RowBox[{"phi", " ", "eta"}]}], ";", " ", 
         RowBox[{"dv", " ", "=", " ", 
          RowBox[{"dphi", " ", "eta"}]}], ";", "\n", "   ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"the", " ", "particle", " ", "row"}], " ", "-", 
            RowBox[{"i", " ", 
             RowBox[{"alpha", "^", "1"}], " ", 
             RowBox[{"psi_p", "'"}]}], " ", "+", " ", 
            RowBox[{"m", " ", "beta", " ", "psi_p"}], " ", "+", " ", 
            RowBox[{"Delta", " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"K", "^", "3"}], ")"}], "^", "dag"}], " ", "psi_h"}]}],
            ",", " ", 
           RowBox[{
           "minus", " ", "the", " ", "energy", " ", "times", " ", "psi_p"}]}],
           " ", "*)"}], "\n", "   ", 
         RowBox[{"rowP", " ", "=", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "I"}], " ", 
            RowBox[{
             RowBox[{"asAlpha", "[", 
              RowBox[{"[", "1", "]"}], "]"}], " ", ".", " ", "du"}]}], " ", "+",
            " ", 
           RowBox[{"mass", " ", 
            RowBox[{"asBeta", " ", ".", " ", "u"}]}], " ", "+", " ", 
           RowBox[{"gap", " ", 
            RowBox[{"asK3dag", " ", ".", " ", "v"}]}], " ", "-", " ", 
           RowBox[{"sg", " ", "mass", " ", "u"}]}]}], ";", "\n", "   ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"the", " ", "hole", " ", "row", " ", "Delta", " ", 
             RowBox[{"K", "^", "3"}], " ", "psi_p"}], " ", "-", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"i", " ", "conj", 
               RowBox[{"(", 
                RowBox[{"alpha", "^", "1"}], ")"}], " ", 
               RowBox[{"psi_h", "'"}]}], " ", "+", " ", 
              RowBox[{"m", " ", "conj", 
               RowBox[{"(", "beta", ")"}], " ", "psi_h"}]}], ")"}]}], ",", 
           " ", 
           RowBox[{
           "minus", " ", "the", " ", "energy", " ", "times", " ", "psi_h"}]}],
           " ", "*)"}], "\n", "   ", 
         RowBox[{"rowH", " ", "=", " ", 
          RowBox[{
           RowBox[{"gap", " ", 
            RowBox[{
             RowBox[{"ConjugateTranspose", "[", "asK3dag", "]"}], " ", ".", 
             " ", "u"}]}], " ", "-", " ", 
           RowBox[{"I", " ", 
            RowBox[{
             RowBox[{"Conjugate", "[", 
              RowBox[{"asAlpha", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "]"}], " ", ".", " ", "dv"}]}],
            " ", "-", " ", 
           RowBox[{"mass", " ", 
            RowBox[{
             RowBox[{"Conjugate", "[", "asBeta", "]"}], " ", ".", " ", 
             "v"}]}], " ", "-", " ", 
           RowBox[{"sg", " ", "mass", " ", "v"}]}]}], ";", "\n", "   ", 
         RowBox[{"as7Dev", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"as7Dev", ",", " ", 
            RowBox[{"Max", "[", 
             RowBox[{"Abs", "[", "rowP", "]"}], "]"}], ",", " ", 
            RowBox[{"Max", "[", 
             RowBox[{"Abs", "[", "rowH", "]"}], "]"}]}], "]"}]}]}]}], "]"}], ",",
       "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"trial", ",", " ", "0", ",", " ", "49"}], "}"}]}], "]"}], 
    ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<AS-7\>\"", ",", 
     " ", "\"\<the bound states of a domain wall (kink) of the pair field \
(case C), in the continuum: the 8 x 8 matrices (Dirac (x) isospin) satisfy \
(Kch_3^dag)^2 = -1, (Kch_3^dag)^dag = -Kch_3^dag, alpha_LL^1 Kch_3^dag \
alpha_LL^1 = -Kch_3^dag and beta_LL Kch_3^dag alpha_LL^1 = -Kch_3^dag \
alpha_LL^1 beta_LL, and alpha_LL^1 and beta_LL are real (tolerance 1e-13); \
for the kink dvec = (0, 0, Delta(x_LL^1)) with Delta(x_LL^1) = Delta_inf \
tanh(x_LL^1/ell_K) (Delta_inf = 1, ell_K = 1) and mu = 0, the mode psi_p = \
phi_K chi_K, psi_h = i Kch_3^dag alpha_LL^1 phi_K chi_K with phi_K = \
cosh(x_LL^1/ell_K)^(-Delta_inf ell_K) (so that d phi_K/d x_LL^1 = -Delta \
phi_K) and a constant chi_K with beta_LL chi_K = +chi_K or -chi_K satisfies \
the sixteen component equations with the energy +m or -m at 50 random points \
(m = 0.4, random chi_K; tolerance 1e-12)\>\"", ",", "\n", "  ", 
     RowBox[{
      RowBox[{"as7IdDev", " ", "<", " ", "1*^-13"}], " ", "&&", " ", 
      RowBox[{"as7Dev", " ", "<", " ", "1*^-12"}]}], ",", "\n", "  ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<deviations of the identities \>\"", ",", " ", 
        RowBox[{"asSci", "[", "as7IdDev", "]"}], ",", 
        " ", "\"\<, of the equations \>\"", ",", " ", 
        RowBox[{"asSci", "[", "as7Dev", "]"}], ",", 
        " ", "\"\< (original: 0.0e0, 8.3e-17)\>\""}], "}"}], "]"}]}], 
    "]"}]}]}]], "Input",ExpressionUUID->"099df806-14d1-4846-8216-\
2bb1d7a5df92"],

Cell[TextData[{
 StyleBox["The square of the operator, and all bound states (check AS-8).",
  FontWeight->"Bold"],
 " With the plane wave ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["exp",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["i", "TI"], 
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox[
         StyleBox["q", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], "2"], 
        SubsuperscriptBox[
         StyleBox["x", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], "2"], "+", 
        SubsuperscriptBox[
         StyleBox["q", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], "3"], 
        SubsuperscriptBox[
         StyleBox["x", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], "3"]}], ")"}]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e3fc2bdf-da07-4601-aaa0-779b7eb2486a"],
 " along the wall, the particle block of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalH]",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["DB",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "712ad9eb-765b-455b-9e65-d920010ae312"],
 " is the operator ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     StyleBox["i", "TI"]}], 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], 
    SubscriptBox["\[PartialD]", "1"], "+", 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], "2"], 
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "2"], "+", 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], "3"], 
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "3"], "+", 
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8441fe95-ae75-48d1-b0c7-b629ea1f93eb"],
 ", and the hole block is minus the complex conjugate of the same operator \
with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "380258a6-3954-4fed-8e0e-954808cd312f"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "3"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "87c99089-72c2-40a6-a1bf-3904ea9bc216"],
 " in place of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["q", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0ef63006-a6d3-4d3b-9bf7-03b38bfa476b"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["q", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "82852f6d-ea1e-4e6e-8a45-f20ebfb60c7d"],
 ". By the relation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"], "\[LongEqual]", 
    RowBox[{"-", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["K",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["LL",
         FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"]}], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[Alpha]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["j", "TI"]], ")"}], "*"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "510c52a1-8b2c-49af-831f-779b70f5c812"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["j", "TI"], "\[LongEqual]", "1", ",", "2", ",", "3"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "435f97a0-b55c-4599-8183-8c3bff15bb60"],
 " (the key identity of case B in another form), the particle block times ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a2e96efe-35c7-493e-9911-bd8534fbf045"],
 " equals ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f1d81c98-a314-4c27-a64f-055ff389838d"],
 " times the hole block with the opposite sign. In the off-diagonal blocks of \
the square of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalH]",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["DB",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e34d7ef4-a8d0-40ed-b16f-4e9779e70ae6"],
 " everything therefore cancels except the derivative of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalDelta]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c45940c9-cd72-4601-b5c8-300825460f5c"],
 ", which arises when ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[PartialD]", "1"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cac2e4da-c17a-48a3-a71b-4cac5367c602"],
 " acts on the factor ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalDelta]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ec558577-a2ba-48be-a8a2-5135b886fa06"],
 "; the diagonal blocks are the squares of the particle block and of the hole \
block plus ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"], "2"], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"], 
    SubsuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "3"], "\[LongEqual]", 
    SubsuperscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"], "2"], 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "8"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0cc81769-884d-441e-a39d-8d89a7aa8562"],
 ". The result is"
}], "Text",ExpressionUUID->"3b67f8e7-e073-4726-9cbd-b036c76c9542"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["\[ScriptCapitalH]",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["DB",
       FontSlant->"Plain"]], ")"}], "2"], "\[LongEqual]", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       SuperscriptBox[
        StyleBox["d", "TI"], "2"], 
       RowBox[{
        StyleBox["d", "TI"], 
        SuperscriptBox[
         RowBox[{"(", 
          SubsuperscriptBox[
           StyleBox["x", "TI"], 
           StyleBox["LL",
            FontSlant->"Plain"], "1"], ")"}], "2"]}]]}], "+", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["q", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], "2"], ")"}], "2"], "+", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["q", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], "3"], ")"}], "2"], "+", 
     SubsuperscriptBox[
      StyleBox["m", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], "2"], "+", 
     SubsuperscriptBox["\[CapitalDelta]", 
      StyleBox["LL",
       FontSlant->"Plain"], "2"]}], ")"}], 
   SubscriptBox[
    StyleBox["1",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "16"], "+", 
   FractionBox[
    RowBox[{
     StyleBox["d", "TI"], 
     SubscriptBox["\[CapitalDelta]", 
      StyleBox["LL",
       FontSlant->"Plain"]]}], 
    RowBox[{
     StyleBox["d", "TI"], 
     SubsuperscriptBox[
      StyleBox["x", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], "1"]}]], "\[ThinSpace]", 
   SubsuperscriptBox[
    StyleBox["Q",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["K",
     FontSlant->"Plain"]]}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"723fbf8c-4fd5-4155-bcf3-114dfd5327bb"],

Cell["with the constant matrix", "Text",ExpressionUUID->"6dcd8ba3-cfdb-457f-bea0-a88bb97ed04b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["Q",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["K",
     FontSlant->"Plain"]], "\[LongEqual]", 
   RowBox[{"(", "\[NoBreak]", GridBox[{
      {"0", 
       RowBox[{
        RowBox[{"-", 
         StyleBox["i", "TI"]}], 
        SubsuperscriptBox["\[Alpha]", 
         StyleBox["LL",
          FontSlant->"Plain"], "1"], 
        SuperscriptBox[
         RowBox[{"(", 
          SubsuperscriptBox[
           StyleBox["K",
            FontFamily->"Helvetica",
            FontSlant->"Plain"], 
           StyleBox["LL",
            FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"]}]},
      {
       RowBox[{
        RowBox[{"-", 
         StyleBox["i", "TI"]}], 
        SubsuperscriptBox["\[Alpha]", 
         StyleBox["LL",
          FontSlant->"Plain"], "1"], 
        SubsuperscriptBox[
         StyleBox["K",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], 
         StyleBox["LL",
          FontSlant->"Plain"], "3"]}], "0"}
     },
     GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.7]}, 
         Offset[0.27999999999999997`]}, "Rows" -> {
         Offset[0.2], {
          Offset[0.4]}, 
         Offset[0.2]}}], "\[NoBreak]", ")"}]}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"e35e37d4-864a-4760-bbdd-784b8ff3b4c2"],

Cell[TextData[{
 "The constant matrix ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["Q",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["K",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b9da5220-e97c-46f2-8383-774b677a97f1"],
 " is Hermitian, its square is the unit matrix, and its trace is 0: it has \
the eigenvalue ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4bea4f00-2c9c-4cc3-8202-be7f0dea028c"],
 " on a subspace of eight dimensions and the eigenvalue ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d976ee3b-997c-48c7-9af6-0fac7d5eb884"],
 " on another. On these two subspaces the square of the operator is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "2"], "+", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "2"], ")"}], "2"], "+", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "09f8af04-85a0-42ea-a68c-4ef7bb31b12c"],
 " plus one of the two scalar operators ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     SuperscriptBox[
      StyleBox["d", "TI"], "2"]}], "/", 
    StyleBox["d", "TI"], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "1"], ")"}], "2"], "+", 
    SubsuperscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"], "2"], "-", 
    StyleBox["d", "TI"], 
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "/", 
    StyleBox["d", "TI"], 
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "1"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9f06c8a8-f914-4142-b041-92510245505b"],
 " (eigenvalue ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "61b2864e-fa21-44cb-872a-11d58de11b32"],
 ") and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     SuperscriptBox[
      StyleBox["d", "TI"], "2"]}], "/", 
    StyleBox["d", "TI"], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "1"], ")"}], "2"], "+", 
    SubsuperscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"], "2"], "+", 
    StyleBox["d", "TI"], 
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "/", 
    StyleBox["d", "TI"], 
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "1"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "60828cdd-d300-46ae-9900-a0309828ceba"],
 " (eigenvalue ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d8388da6-7395-4d4d-8bc8-b8fb70fdde1a"],
 "). The first is the product ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       StyleBox["d", "TI"]}], "/", 
      StyleBox["d", "TI"], 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "1"], "+", 
      SubscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["d", "TI"], "/", 
      StyleBox["d", "TI"], 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "1"], "+", 
      SubscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a3eb63af-1105-47ab-944e-1e24cc33b1b0"],
 ", and the second is the product of the same two first-order operators in \
the other order. Two such products have the same eigenvalues different from \
zero (if one of them maps a function to a multiple of itself, the first-order \
factor applied to that function gives an eigenfunction of the other product \
with the same eigenvalue). They differ only in the eigenvalue zero: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], "/", 
    StyleBox["d", "TI"], 
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], "+", 
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c0dacb3e-f64b-4336-82de-e6640b0399f6"],
 " maps the normalizable profile ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CurlyPhi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["K",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "877e4ce5-9ca9-47cc-afea-ca9d6fdbcb93"],
 " to zero, while the functions that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     StyleBox["d", "TI"]}], "/", 
    StyleBox["d", "TI"], 
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], "+", 
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "64f14b8e-9b96-4900-9ccf-b5911de9445e"],
 " maps to zero are the multiples of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SubsuperscriptBox["\[CurlyPhi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ed44e510-81e4-42ca-842c-70fca4f911d2"],
 ", which grow on both sides of the wall. The sector with the eigenvalue ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8f2b030c-fd80-4606-bdf7-89660bd9e85a"],
 " therefore has exactly one bound state more than the sector with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b4e72dc9-5f3f-41e3-b00e-9c0345173d95"],
 ": the state of the display before this one, with the squared energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "2"], "+", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "2"], ")"}], "2"], "+", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e80a4845-7f15-47e2-adc4-730b978f42ab"],
 ", the energy of a free particle of the mass ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f4872429-6298-4ac0-af24-c8618e3cacd1"],
 " that moves in the two dimensions of the wall."
}], "Text",ExpressionUUID->"a71fd2bc-5b1f-4cdf-ad6a-c94add2ff1be"],

Cell[TextData[{
 "For the kink, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"], "2"], "\[MinusPlus]", 
    StyleBox["d", "TI"], 
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "/", 
    StyleBox["d", "TI"], 
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"], "\[Infinity]"], ")"}], "2"], "-", 
    SubsuperscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Infinity]"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"], "\[Infinity]"], "\[PlusMinus]", "1", "/", 
      SubsuperscriptBox["\[ScriptL]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["K",
        FontSlant->"Plain"]]}], ")"}], "\[ThinSpace]", 
    StyleBox["cosh",
     FontSlant->"Plain"], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["x", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], "1"], "/", 
       SubsuperscriptBox["\[ScriptL]", 
        StyleBox["LL",
         FontSlant->"Plain"], 
        StyleBox["K",
         FontSlant->"Plain"]]}], ")"}], 
     RowBox[{"-", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d4b35d28-bd33-4a77-a84a-c7e5953e19ff"],
 ", because ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["tanh",
      FontSlant->"Plain"], "2"], "\[LongEqual]", "1", "-", 
    SuperscriptBox[
     StyleBox["cosh",
      FontSlant->"Plain"], 
     RowBox[{"-", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "25806f96-4585-46f6-9c83-d99984b35aff"],
 " and the derivative of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["tanh",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "1"], "/", 
      SubsuperscriptBox["\[ScriptL]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["K",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5d4244a1-d7be-466c-b152-f73812fb17f3"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["cosh",
     FontSlant->"Plain"], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["x", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], "1"], "/", 
       SubsuperscriptBox["\[ScriptL]", 
        StyleBox["LL",
         FontSlant->"Plain"], 
        StyleBox["K",
         FontSlant->"Plain"]]}], ")"}], 
     RowBox[{"-", "2"}]], "/", 
    SubsuperscriptBox["\[ScriptL]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "adc9e88b-29bf-4d39-8656-700deebe162d"],
 ". The operator of the sector ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a4c91d62-28dd-45e2-b050-343863be94d4"],
 " is therefore ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox["\[CapitalDelta]", 
      StyleBox["LL",
       FontSlant->"Plain"], "\[Infinity]"], ")"}], "2"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c4d07d84-a41c-4def-bd3a-d72c2866d1d0"],
 " plus the potential well ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     SuperscriptBox[
      StyleBox["d", "TI"], "2"]}], "/", 
    StyleBox["d", "TI"], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "1"], ")"}], "2"], "-", 
    SubsuperscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Infinity]"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"], "\[Infinity]"], "+", "1", "/", 
      SubsuperscriptBox["\[ScriptL]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["K",
        FontSlant->"Plain"]]}], ")"}], "\[ThinSpace]", 
    StyleBox["cosh",
     FontSlant->"Plain"], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["x", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], "1"], "/", 
       SubsuperscriptBox["\[ScriptL]", 
        StyleBox["LL",
         FontSlant->"Plain"], 
        StyleBox["K",
         FontSlant->"Plain"]]}], ")"}], 
     RowBox[{"-", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fcfa53c0-96f4-4c98-876a-2f3602ae9b9f"],
 ", a well of the form of Poeschl and Teller with the parameter ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalDelta]", 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Infinity]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "335ee33d-8d97-49f9-af7a-8de6b44c19ac"],
 "; and the operator of the sector ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "01e12e19-8d7c-4345-b9db-dea2fd92c823"],
 " is ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox["\[CapitalDelta]", 
      StyleBox["LL",
       FontSlant->"Plain"], "\[Infinity]"], ")"}], "2"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0785d78f-23c7-415a-b0e0-0a08f6396bf0"],
 " plus the well of the same form with the parameter ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Infinity]"], "-", "1", "/", 
    SubsuperscriptBox["\[ScriptL]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ea27bb94-f044-479e-ae52-62bc25a7a749"],
 ". By the argument of the two products, the well with the parameter ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalDelta]", 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Infinity]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7975f391-18c8-400b-853e-654d3c568bf6"],
 " has one bound state more than the well with the parameter ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Infinity]"], "-", "1", "/", 
    SubsuperscriptBox["\[ScriptL]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c2dd495d-d12b-4587-952a-65fa239c5864"],
 ", namely ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CurlyPhi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["K",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "204be7f2-cd52-4bcb-b884-2dd7b663aeef"],
 " with the eigenvalue ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"], "\[Infinity]"], ")"}], "2"]}], TraditionalForm]],
   "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7a7d3cfd-bb77-4f32-890e-d6bb1070dda7"],
 " of the well, and its other bound states are those of the well with the \
smaller parameter. Applied again and again, as long as the parameter stays \
positive, this gives the eigenvalues ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox["\[CapitalDelta]", 
        StyleBox["LL",
         FontSlant->"Plain"], "\[Infinity]"], "-", 
       SubsuperscriptBox[
        StyleBox["k", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], 
        StyleBox["K",
         FontSlant->"Plain"]], "/", 
       SubsuperscriptBox["\[ScriptL]", 
        StyleBox["LL",
         FontSlant->"Plain"], 
        StyleBox["K",
         FontSlant->"Plain"]]}], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4774e40d-c0d1-4abe-b2ae-f50ae88b6359"],
 " of the well with the parameter ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalDelta]", 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Infinity]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e16887f0-eef4-4b99-9999-4b9126a3d6db"],
 ", for the integers ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["k", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["K",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "47dee216-719b-45ce-be5d-540627d61ec3"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "\[LessEqual]", 
    SubsuperscriptBox[
     StyleBox["k", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]], "<", 
    SubsuperscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Infinity]"], 
    SubsuperscriptBox["\[ScriptL]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e2b92904-df51-4bf8-9964-cad68d9ac61c"],
 ", and those with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "\[LessEqual]", 
    SubsuperscriptBox[
     StyleBox["k", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]], "<", 
    SubsuperscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Infinity]"], 
    SubsuperscriptBox["\[ScriptL]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "effe52fa-a12c-4eca-9537-e3bb9ab3b55a"],
 " for the sector ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "91d631c9-d6eb-40ee-9fb9-9a16176ad620"],
 ". The bound states of the wall therefore have the energies"
}], "Text",ExpressionUUID->"9bf2253c-f598-4b90-855d-f2196944f52b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["E", "TI"], 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["n", "TI"]}], 
    StyleBox["qp",
     FontSlant->"Plain"]], "\[LongEqual]", 
   RowBox[{"\[PlusMinus]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["m", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], "2"], "+", 
       SuperscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox[
          StyleBox["q", "TI"], 
          StyleBox["LL",
           FontSlant->"Plain"], "2"], ")"}], "2"], "+", 
       SuperscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox[
          StyleBox["q", "TI"], 
          StyleBox["LL",
           FontSlant->"Plain"], "3"], ")"}], "2"], "+", 
       FractionBox[
        RowBox[{"2", 
         SubsuperscriptBox[
          StyleBox["k", "TI"], 
          StyleBox["LL",
           FontSlant->"Plain"], 
          StyleBox["K",
           FontSlant->"Plain"]], 
         SubsuperscriptBox["\[CapitalDelta]", 
          StyleBox["LL",
           FontSlant->"Plain"], "\[Infinity]"]}], 
        SubsuperscriptBox["\[ScriptL]", 
         StyleBox["LL",
          FontSlant->"Plain"], 
         StyleBox["K",
          FontSlant->"Plain"]]], "-", 
       FractionBox[
        SuperscriptBox[
         RowBox[{"(", 
          SubsuperscriptBox[
           StyleBox["k", "TI"], 
           StyleBox["LL",
            FontSlant->"Plain"], 
           StyleBox["K",
            FontSlant->"Plain"]], ")"}], "2"], 
        SuperscriptBox[
         RowBox[{"(", 
          SubsuperscriptBox["\[ScriptL]", 
           StyleBox["LL",
            FontSlant->"Plain"], 
           StyleBox["K",
            FontSlant->"Plain"]], ")"}], "2"]]}], ")"}], 
     RowBox[{"1", "/", "2"}]]}], ",", "      ", 
   SubsuperscriptBox[
    StyleBox["k", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["K",
     FontSlant->"Plain"]], "\[LongEqual]", "0", ",", "1", ",", "2", ",", 
   "\[Ellipsis]", ",", "   ", 
   SubsuperscriptBox[
    StyleBox["k", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["K",
     FontSlant->"Plain"]], "<", 
   SubsuperscriptBox["\[CapitalDelta]", 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Infinity]"], 
   SubsuperscriptBox["\[ScriptL]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["K",
     FontSlant->"Plain"]]}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"b27f20a0-5f40-46aa-9922-d141bdfdf316"],

Cell[TextData[{
 "four times each sign for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["k", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a1cecbb9-daba-41d0-ae6b-d0a8cf1da816"],
 " (the sector ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f10fff2b-3bd1-44af-9977-ab03360cb74b"],
 " only) and eight times each sign for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["k", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]], "\[GreaterEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "20821751-4e90-4f64-b1a9-8116169c74a6"],
 " (both sectors); the states that are not bound begin at ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["m", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "2"], "+", 
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox[
         StyleBox["q", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], "2"], ")"}], "2"], "+", 
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox[
         StyleBox["q", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], "3"], ")"}], "2"], "+", 
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox["\[CapitalDelta]", 
         StyleBox["LL",
          FontSlant->"Plain"], "\[Infinity]"], ")"}], "2"]}], ")"}], 
    RowBox[{"1", "/", "2"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3d999b23-7b13-4230-a6b0-7b5079528b67"],
 ". In particular, for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Infinity]"], 
    SubsuperscriptBox["\[ScriptL]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]], "\[LessEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "249425d7-f232-4782-a13a-e833dcd062da"],
 " the states with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["k", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e67a18f6-2232-4fee-bcaa-47d0362d7a94"],
 " are the only bound states. Check AS-8 verifies the properties of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["Q",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["K",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c4476901-5359-4a56-8f6f-3a0da00e3692"],
 " and the relation between ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Alpha]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "79e9873a-3811-4efd-b731-961cb58c3801"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], "3"], ")"}], "\[Dagger]"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "277dc80f-8827-4bbb-986d-a3b8828329fc"],
 "; the formula for the square, by applying the operator twice to a Gaussian \
function of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "1"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "22b50bd4-24fb-47ea-abb5-533645ae7f68"],
 " times a random vector of 16 components, with exact derivatives, for 50 \
random kinks, points and momenta; and the bound states of the two scalar \
operators for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Infinity]"], 
    SubsuperscriptBox["\[ScriptL]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["K",
      FontSlant->"Plain"]], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e9761536-6a49-4b8c-8d13-49f7182250ed"],
 " and ",
 Cell[BoxData[
  FormBox["2.5", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b95dab1b-ad1b-43da-9bbc-e30120052580"],
 " (one and none, and three and two bound states)."
}], "Text",ExpressionUUID->"be3b6d71-9551-451c-a144-21c2bf780065"],

Cell[TextData[{
 "The bound states of the scalar operators are computed by second-order \
finite differences on the interval from ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "20"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d96e6e6b-d8c2-46ae-8eb4-94c48dc54c46"],
 " to ",
 Cell[BoxData[
  FormBox["20", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1ead6369-e698-4099-8984-09919e4254f2"],
 " with 4000 and with 8001 inner points. The error of such differences is \
proportional to the square of the spacing, so four thirds of the finer result \
minus one third of the coarser one removes its leading part (Richardson \
extrapolation). The finite-difference operator is a symmetric tridiagonal \
matrix. The number of its eigenvalues below a given number is the number of \
negative pivots in the elimination of the matrix minus that number times the \
unit matrix (a Sturm sequence; function ",
 StyleBox["t2sturmCount",
  FontFamily->"Source Code Pro"],
 ", which is compiled with ",
 StyleBox["Compile",
  FontFamily->"Source Code Pro"],
 " because the check passes through some fourteen million matrix rows), and \
bisection on this count gives every eigenvalue below the threshold ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox["\[CapitalDelta]", 
      StyleBox["LL",
       FontSlant->"Plain"], "\[Infinity]"], ")"}], "2"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d8a184de-ed2d-41e2-933a-a8d1573d593c"],
 " (function ",
 StyleBox["t2sturmLowest",
  FontFamily->"Source Code Pro"],
 ")."
}], "Text",ExpressionUUID->"107ba9d9-f695-4625-857e-6985a91cbcc0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
     "the", " ", "number", " ", "of", " ", "eigenvalues", " ", "below", " ", 
      "the", " ", "number", " ", "below", " ", "of", " ", "the", " ", "real", 
      " ", "symmetric", " ", "tridiagonal", " ", "matrix", " ", "with", " ", 
      "the", " ", "diagonal", " ", "diag", " ", "and", "\n", "   ", "the", " ",
       "constant", " ", "off"}], "-", 
     RowBox[{"diagonal", " ", 
      RowBox[{"off", ":", " ", 
       RowBox[{
        RowBox[{
        "the", " ", "number", " ", "of", " ", "negative", " ", "pivots", " ", 
         "of", " ", "the", " ", "elimination", " ", "of", " ", "the", " ", 
         "matrix", " ", "minus", " ", "below", " ", "times", " ", "the", "\n",
          "   ", "unit", " ", "matrix", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"a", " ", "Sturm", " ", "sequence"}], ")"}], ".", "  ", 
          "A"}], " ", "pivot", " ", "that", " ", "is", " ", "exactly", " ", 
         "zero", " ", "is", " ", "replaced", " ", "by"}], " ", "-", 
        RowBox[{"1", "e"}], "-", "300"}]}]}]}], ",", " ", 
    RowBox[{"as", " ", "in", " ", "the", " ", "original", " ", "program"}]}], 
   " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"t2sturmCount", " ", "=", " ", 
     RowBox[{"Compile", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"diag", ",", " ", "_Real", ",", " ", "1"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"off", ",", " ", "_Real"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"below", ",", " ", "_Real"}], "}"}]}], "}"}], ",", "\n", 
       "   ", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"count", " ", "=", " ", "0"}], ",", " ", 
           RowBox[{"pivot", " ", "=", " ", "1."}]}], "}"}], ",", "\n", "    ", 
         RowBox[{
          RowBox[{"Do", "[", "\n", "     ", 
           RowBox[{
            RowBox[{
             RowBox[{"pivot", " ", "=", " ", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"diag", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], " ", "-", " ", "below"}], 
                ")"}], " ", "-", " ", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"i", " ", "==", " ", "1"}], ",", " ", "0.", ",", " ", 
                 RowBox[{"off", " ", 
                  RowBox[{"off", "/", "pivot"}]}]}], "]"}]}]}], ";", "\n", 
             "     ", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"pivot", " ", "==", " ", "0."}], ",", " ", 
               RowBox[{"pivot", " ", "=", " ", 
                RowBox[{"-", "1.*^-300"}]}]}], "]"}], ";", "\n", "     ", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"pivot", " ", "<", " ", "0."}], ",", " ", 
               RowBox[{"count", "++"}]}], "]"}]}], ",", "\n", "     ", 
            RowBox[{"{", 
             RowBox[{"i", ",", " ", 
              RowBox[{"Length", "[", "diag", "]"}]}], "}"}]}], "]"}], ";", 
          "\n", "    ", "count"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", "eigenvalues", " ", "number", " ", "0"}], ",", " ", 
     "1", ",", " ", 
     RowBox[{"...", " ", 
      RowBox[{"(", "ascending", ")"}], " ", "below", " ", "upper", " ", "of", 
      " ", "the", " ", "tridiagonal", " ", "matrix"}], ",", " ", 
     RowBox[{
     "each", " ", "by", " ", "200", " ", "steps", " ", "of", " ", "bisection",
       "\n", "   ", "between", " ", "lower", " ", "and", " ", "upper"}]}], 
    " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2sturmLowest", "[", 
      RowBox[{
      "diag_", ",", " ", "off_", ",", " ", "lower_", ",", " ", "upper_"}], 
      "]"}], " ", ":=", " ", 
     RowBox[{"Table", "[", "\n", "   ", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"lo", " ", "=", " ", "lower"}], ",", " ", 
           RowBox[{"hi", " ", "=", " ", "upper"}], ",", " ", "mid"}], "}"}], ",",
          "\n", "    ", 
         RowBox[{
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"mid", " ", "=", " ", 
              RowBox[{"0.5", " ", 
               RowBox[{"(", 
                RowBox[{"lo", " ", "+", " ", "hi"}], ")"}]}]}], ";", " ", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"t2sturmCount", "[", 
                 RowBox[{"diag", ",", " ", "off", ",", " ", "mid"}], "]"}], 
                " ", ">", " ", "number"}], ",", " ", 
               RowBox[{"hi", " ", "=", " ", "mid"}], ",", " ", 
               RowBox[{"lo", " ", "=", " ", "mid"}]}], "]"}]}], ",", " ", 
            RowBox[{"{", "200", "}"}]}], "]"}], ";", "\n", "    ", 
          RowBox[{"0.5", " ", 
           RowBox[{"(", 
            RowBox[{"lo", " ", "+", " ", "hi"}], ")"}]}]}]}], "]"}], ",", 
       "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"number", ",", " ", "0", ",", " ", 
         RowBox[{
          RowBox[{"t2sturmCount", "[", 
           RowBox[{"diag", ",", " ", "off", ",", " ", "upper"}], "]"}], " ", "-",
           " ", "1"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"the", " ", "bound"}], "-", 
       RowBox[{"state", " ", "eigenvalues", " ", 
        RowBox[{"(", 
         RowBox[{"below", " ", "the", " ", "threshold", " ", 
          RowBox[{"dinf", "^", "2"}]}], ")"}], " ", "of", " ", "the", " ", 
        "scalar", " ", "operator"}], " ", "-", 
       RowBox[{
        RowBox[{"d", "^", "2"}], "/", 
        RowBox[{"dx", "^", "2"}]}], " ", "+", " ", 
       RowBox[{"Delta", "^", "2"}], " ", "+", " ", 
       RowBox[{"sgn", " ", 
        RowBox[{"Delta", "'"}], " ", "with", "\n", "   ", "Delta"}]}], " ", "=",
       " ", 
      RowBox[{"dinf", " ", "tanh", 
       RowBox[{"(", 
        RowBox[{"x", "/", "ellk"}], ")"}]}]}], ",", " ", 
     RowBox[{
      RowBox[{"by", " ", "second"}], "-", 
      RowBox[{"order", " ", "finite", " ", "differences", " ", "on", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "xmax"}], ",", " ", "xmax"}], ")"}], " ", "with", " ", 
       "Dirichlet", " ", "ends"}]}], ",", " ", 
     RowBox[{
      RowBox[{
      "extrapolated", " ", "from", "\n", "   ", "npts", " ", "and", " ", "2", 
       " ", "npts"}], " ", "+", " ", 
      RowBox[{"1", " ", "inner", " ", "points"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2ptBoundStates", "[", 
      RowBox[{
