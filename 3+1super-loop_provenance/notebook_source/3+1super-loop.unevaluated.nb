Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "the", " ", "same", " ", "rows", " ", "in", " ", "the", " ", "same", " ", 
     
     RowBox[{"order", ":", " ", 
      RowBox[{"the", " ", "momenta"}]}]}], ",", " ", 
    RowBox[{"the", " ", "energies", " ", "and", " ", "the", " ", "moduli"}], ",",
     " ", 
    RowBox[{"compared", " ", "entry", " ", "by", " ", "entry"}]}], " ", 
   "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"devPts", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{"points", " ", "-", " ", "t2origPoints"}], "]"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"devCurves", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{"curves", " ", "-", " ", "t2origCurves"}], "]"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"devRK4", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{"rkData", " ", "-", " ", "t2origRK4"}], "]"}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<T2-DATA-1\>\"", ",", 
     " ", "\"\<the numbers of Figures 1 and 2 agree with the data files \
written by the original program t2_fields: the 48 eigenvalues of the lattice \
operator, the 802 points of the curves and the 641 values of the RK4 factor \
(tolerances 5.1e-11, 5.1e-11 and 5.1e-13: half a unit of the last printed \
decimal)\>\"", ",", "\n", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"Dimensions", "[", "points", "]"}], " ", "==", " ", 
       RowBox[{"Dimensions", "[", "t2origPoints", "]"}]}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"Dimensions", "[", "curves", "]"}], " ", "==", " ", 
       RowBox[{"Dimensions", "[", "t2origCurves", "]"}]}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"Dimensions", "[", "rkData", "]"}], " ", "==", " ", 
       RowBox[{"Dimensions", "[", "t2origRK4", "]"}]}], " ", "&&", "\n", 
      "   ", 
      RowBox[{"devPts", " ", "<", " ", "5.1*^-11"}], " ", "&&", " ", 
      RowBox[{"devCurves", " ", "<", " ", "5.1*^-11"}], " ", "&&", " ", 
      RowBox[{"devRK4", " ", "<", " ", "5.1*^-13"}]}], ",", "\n", "  ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<largest deviations \>\"", ",", " ", "devPts", ",", 
        " ", "\"\<, \>\"", ",", " ", "devCurves", ",", " ", "\"\<, \>\"", ",",
         " ", "devRK4"}], "}"}], "]"}]}], "]"}]}]}]], "Input",ExpressionUUID->\
"b3549119-fe6f-4c6a-a6bd-733c7ad7304c"],

