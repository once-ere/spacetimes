                    RowBox[{"q", " ", "+", " ", "1"}], ",", " ", 
                    RowBox[{"p", " ", "+", " ", "1"}]}], "]"}], "]"}], " ", "-",
                    " ", 
                   RowBox[{"a1", "[", 
