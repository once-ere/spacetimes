          " ", "\"\<9 Test 2: the gauge-covariant field equations of the \
spinor field and their solutions\>\""}], ",", " ", 
         RowBox[{"\"\<symbol\>\"", " ", "->", 
          " ", "\"\<$\\\\psi^{\\\\rm p}_{\\\\rm LL}$, $\\\\psi^{\\\\rm h}_{\\\
\\rm LL}$\>\""}], ",", " ", 
         RowBox[{"\"\<names\>\"", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<psi_p\>\"", ",", " ", "\"\<psi_h\>\""}], "}"}]}], ",",
          " ", 
         RowBox[{"\"\<meaning\>\"", " ", "->", 
          " ", "\"\<the particle and the hole component (eight complex \
