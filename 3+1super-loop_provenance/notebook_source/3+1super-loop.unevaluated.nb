     RowBox[{"SL31TeXFormula", "[", "\"\<5x\>\"", "]"}], " ", "===", " ", 
     RowBox[{"RowBox", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<5\>\"", ",", " ", 
