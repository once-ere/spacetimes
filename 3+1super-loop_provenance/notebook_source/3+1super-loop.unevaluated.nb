                 RowBox[{"fl", "[", "\"\<links\>\"", "]"}], "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{"s", " ", "+", " ", "1"}], ",", " ", 
                   RowBox[{"j", " ", "+", " ", "1"}]}], "]"}], "]"}], ",", 
                " ", 
                RowBox[{"f", "[", "sp", "]"}]}], "]"}]}], "]"}]}], ";", "\n", 
           "    ", 
           RowBox[{"wb", " ", "=", " ", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"sm", " ", "===", " ", "None"}], ",", " ", 
              RowBox[{"0", " ", "ps"}], ",", " ", 
              RowBox[{"t2iso2", "[", 
               RowBox[{
                RowBox[{"ConjugateTranspose", "[", 
                 RowBox[{
                  RowBox[{"fl", "[", "\"\<links\>\"", "]"}], "[", 
                  RowBox[{"[", 
                   RowBox[{
                    RowBox[{"sm", " ", "+", " ", "1"}], ",", " ", 
                    RowBox[{"j", " ", "+", " ", "1"}]}], "]"}], "]"}], "]"}], 
                ",", " ", 
                RowBox[{"f", "[", "sm", "]"}]}], "]"}]}], "]"}]}], ";", "\n", 
           "    ", 
           RowBox[{"out", " ", "+=", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "I"}], " ", 
              RowBox[{
               RowBox[{"t2alpha8", "[", 
                RowBox[{"[", 
                 RowBox[{"j", " ", "+", " ", "1"}], "]"}], "]"}], " ", ".", 
               " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"wf", " ", "-", " ", "wb"}], ")"}], " ", "inv2l"}], 
                ")"}]}]}], " ", "-", " ", 
             RowBox[{"rw", " ", 
              RowBox[{"t2beta8", " ", ".", " ", 
               RowBox[{"(", 
                RowBox[{"wf", " ", "+", " ", "wb", " ", "-", " ", 
                 RowBox[{"2", " ", "ps"}]}], ")"}]}]}]}]}]}], ",", "\n", 
          "    ", 
          RowBox[{"{", 
           RowBox[{"j", ",", " ", "0", ",", " ", "2"}], "}"}]}], "]"}], ";", 
        "\n", "   ", 
        RowBox[{"out", " ", "-", " ", 
         RowBox[{"t2iso2", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"fl", "[", "\"\<v0\>\"", "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"s", " ", "+", " ", "1"}], "]"}], "]"}], ",", " ", 
           "ps"}], "]"}], " ", "-", " ", 
         RowBox[{
          RowBox[{"lat", "[", "\"\<mu\>\"", "]"}], " ", "ps"}]}]}]}], "]"}]}],
     ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"H_DB", " ", "applied", " ", "to", " ", 
      RowBox[{"w", ":", " ", 
       RowBox[{
       "a", " ", "vector", " ", "of", " ", "16", " ", "nsites", " ", 
        "components"}]}]}], ",", " ", 
     RowBox[{
     "or", " ", "a", " ", "matrix", " ", "whose", " ", "columns", " ", "are", 
      " ", "such", " ", "vectors"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2apply", "[", 
      RowBox[{"lat_", ",", " ", "fl_", ",", " ", "w_"}], "]"}], " ", ":=", 
     " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"part", ",", " ", "holeConj", ",", " ", "pmat"}], "}"}], ",", 
       "\n", "   ", 
       RowBox[{
        RowBox[{
         RowBox[{"part", "[", "s_", "]"}], " ", ":=", " ", 
         RowBox[{"w", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{
             RowBox[{"16", " ", "s"}], " ", "+", " ", "1"}], " ", ";;", " ", 
            RowBox[{
             RowBox[{"16", " ", "s"}], " ", "+", " ", "8"}]}], "]"}], "]"}]}],
         ";", "\n", "   ", 
        RowBox[{
         RowBox[{"holeConj", "[", "s_", "]"}], " ", ":=", " ", 
         RowBox[{"Conjugate", "[", 
          RowBox[{"w", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{
              RowBox[{"16", " ", "s"}], " ", "+", " ", "9"}], " ", ";;", " ", 
             
             RowBox[{
              RowBox[{"16", " ", "s"}], " ", "+", " ", "16"}]}], "]"}], "]"}],
           "]"}]}], ";", "\n", "   ", 
        RowBox[{"Join", " ", "@@", " ", 
         RowBox[{"Table", "[", "\n", "     ", 
          RowBox[{
           RowBox[{
            RowBox[{"pmat", " ", "=", " ", 
             RowBox[{"Sum", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"fl", "[", "\"\<d\>\"", "]"}], "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{"s", " ", "+", " ", "1"}], ",", " ", "i"}], "]"}], 
                 "]"}], " ", 
                RowBox[{"t2kdag8", "[", 
                 RowBox[{"[", "i", "]"}], "]"}]}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"i", ",", " ", "3"}], "}"}]}], "]"}]}], ";", "\n", 
            "     ", 
            RowBox[{"Join", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"t2hMinusV", "[", 
                RowBox[{
                "lat", ",", " ", "fl", ",", " ", "part", ",", " ", "s"}], 
                "]"}], " ", "+", " ", 
               RowBox[{"pmat", " ", ".", " ", 
                RowBox[{"w", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"16", " ", "s"}], " ", "+", " ", "9"}], " ", ";;",
                    " ", 
                   RowBox[{
                    RowBox[{"16", " ", "s"}], " ", "+", " ", "16"}]}], "]"}], 
                 "]"}]}]}], ",", "\n", "      ", 
              RowBox[{
               RowBox[{
                RowBox[{"ConjugateTranspose", "[", "pmat", "]"}], " ", ".", 
                " ", 
                RowBox[{"part", "[", "s", "]"}]}], " ", "-", " ", 
               RowBox[{"Conjugate", "[", 
                RowBox[{"t2hMinusV", "[", 
                 RowBox[{
                 "lat", ",", " ", "fl", ",", " ", "holeConj", ",", " ", "s"}],
                  "]"}], "]"}]}]}], "]"}]}], ",", "\n", "     ", 
           RowBox[{"{", 
            RowBox[{"s", ",", " ", "0", ",", " ", 
             RowBox[{
              RowBox[{"t2nsites", "[", "lat", "]"}], " ", "-", " ", "1"}]}], 
            "}"}]}], "]"}]}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"the", " ", "dense", " ", "matrix", " ", "of", " ", 
     RowBox[{"H_DB", ":", " ", 
      RowBox[{
      "the", " ", "operator", " ", "applied", " ", "to", " ", "the", " ", 
       "unit", " ", "matrix"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2dense", "[", 
      RowBox[{"lat_", ",", " ", "fl_"}], "]"}], " ", ":=", " ", 
     RowBox[{"t2apply", "[", 
      RowBox[{"lat", ",", " ", "fl", ",", " ", 
       RowBox[{
        RowBox[{"N", "[", 
         RowBox[{"IdentityMatrix", "[", 
          RowBox[{"t2dim", "[", "lat", "]"}], "]"}], "]"}], " ", "+", " ", 
        RowBox[{"0.", " ", "I"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", "bound", " ", 
      RowBox[{"B", "^", "H"}], " ", "of", " ", "the", " ", "spectral", " ", 
      "radius", " ", "of", " ", "H_lat", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"check", " ", "GS"}], "-", "10"}], ")"}]}], ";", " ", 
     RowBox[{
     "the", " ", "original", " ", "solvers", " ", "use", " ", "it", " ", "in",
       " ", "the", " ", "bounds", " ", "of", " ", "their", "\n", "   ", 
      "checks", " ", "of", " ", "the", " ", "energy"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2normBound", "[", 
      RowBox[{"lat_", ",", " ", "fl_"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Count", "[", 
        RowBox[{
         RowBox[{"lat", "[", "\"\<n\>\"", "]"}], ",", " ", 
         RowBox[{"n_", " ", "/;", " ", 
          RowBox[{"n", " ", ">", " ", "1"}]}]}], "]"}], " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", " ", "+", " ", 
          RowBox[{"2", " ", 
           RowBox[{"lat", "[", "\"\<wilson\>\"", "]"}]}]}], ")"}], "/", 
        RowBox[{"lat", "[", "\"\<ell\>\"", "]"}]}]}], " ", "+", " ", 
      RowBox[{"Abs", "[", 
       RowBox[{"lat", "[", "\"\<mass\>\"", "]"}], "]"}], " ", "+", " ", 
      RowBox[{"Abs", "[", 
       RowBox[{"lat", "[", "\"\<mu\>\"", "]"}], "]"}], " ", "+", "\n", "   ", 
      
      RowBox[{"Max", "[", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Norm", "[", 
           RowBox[{"#", ",", " ", "\"\<Frobenius\>\""}], "]"}], " ", "&"}], ",",
          " ", 
         RowBox[{"fl", "[", "\"\<v0\>\"", "]"}]}], "]"}], "]"}], " ", "+", 
      " ", 
      RowBox[{"Max", "[", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Total", "[", 
           RowBox[{"Abs", "[", "#", "]"}], "]"}], " ", "&"}], ",", " ", 
         RowBox[{"fl", "[", "\"\<d\>\"", "]"}]}], "]"}], "]"}]}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "free", " ", "lattice", " ", "dispersion", " ", "eps_lat", 
      RowBox[{
       RowBox[{"(", "q", ")"}], "^", "2"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"sum_j", " ", 
       RowBox[{"sin", "^", "2"}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"q_j", " ", "ell"}], ")"}], "/", 
        RowBox[{"ell", "^", "2"}]}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"m", " ", "+", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"r", "/", "ell"}], ")"}], " ", "sum_j", " ", 
          RowBox[{"(", 
           RowBox[{"1", " ", "-", " ", 
            RowBox[{"cos", " ", "q_j", " ", "ell"}]}], ")"}]}]}], ")"}], "^", 
       "2"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2epsLat", "[", 
      RowBox[{
      "q_List", ",", " ", "ell_", ",", " ", "m_", ",", " ", "r_", ",", " ", 
       "active_List"}], "]"}], " ", ":=", " ", 
     RowBox[{"Sqrt", "[", "\n", "   ", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"active", "[", 
            RowBox[{"[", "j", "]"}], "]"}], ",", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"Sin", "[", 
              RowBox[{
               RowBox[{"q", "[", 
                RowBox[{"[", "j", "]"}], "]"}], " ", "ell"}], "]"}], "^", 
             "2"}], "/", 
            RowBox[{"ell", "^", "2"}]}], ",", " ", "0"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}], " ", "+", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"m", " ", "+", " ", 
          RowBox[{
           RowBox[{"r", "/", "ell"}], " ", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"active", "[", 
                RowBox[{"[", "j", "]"}], "]"}], ",", " ", 
               RowBox[{"1", " ", "-", " ", 
                RowBox[{"Cos", "[", 
                 RowBox[{
                  RowBox[{"q", "[", 
                   RowBox[{"[", "j", "]"}], "]"}], " ", "ell"}], "]"}]}], ",",
                " ", "0"}], "]"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}]}], ")"}], "^", 
        "2"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "the", " ", "4", " ", "x", " ", "4", " ", "matrix", " ", "of", " ", "the",
      " ", "free", " ", "lattice", " ", "operator", " ", "on", " ", "the", " ",
      "plane", " ", "wave", " ", "exp", 
     RowBox[{"(", 
      RowBox[{"i", " ", 
       RowBox[{"q", ".", "x"}]}], ")"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2hLatPlane", "[", 
      RowBox[{
      "q_List", ",", " ", "ell_", ",", " ", "m_", ",", " ", "r_", ",", " ", 
       "active_List"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"active", "[", 
           RowBox[{"[", "j", "]"}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{"t2alpha", "[", "j", "]"}], " ", 
           RowBox[{
            RowBox[{"Sin", "[", 
             RowBox[{
              RowBox[{"q", "[", 
               RowBox[{"[", "j", "]"}], "]"}], " ", "ell"}], "]"}], "/", 
            "ell"}]}], ",", " ", "0"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}], " ", "+", "\n", "   ", 
      
      RowBox[{"t2beta", " ", 
       RowBox[{"(", 
        RowBox[{"m", " ", "+", " ", 
         RowBox[{
          RowBox[{"r", "/", "ell"}], " ", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"active", "[", 
               RowBox[{"[", "j", "]"}], "]"}], ",", " ", 
              RowBox[{"1", " ", "-", " ", 
               RowBox[{"Cos", "[", 
                RowBox[{
                 RowBox[{"q", "[", 
                  RowBox[{"[", "j", "]"}], "]"}], " ", "ell"}], "]"}]}], ",", 
              " ", "0"}], "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}]}], ")"}]}]}]}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"the", " ", "anomalous", " ", "density", " ", 
       RowBox[{"Pi", "^", "iota"}], 
       RowBox[{"(", "s", ")"}]}], " ", "=", " ", 
      RowBox[{"sum_n", " ", "psi_p"}]}], ",", 
     RowBox[{"n", 
      RowBox[{
       RowBox[{"(", "s", ")"}], "^", "T"}], " ", "Kch_iota", " ", "conj", 
      RowBox[{"(", 
       RowBox[{"psi_h", ",", 
        RowBox[{"n", 
         RowBox[{"(", "s", ")"}]}]}], ")"}], " ", "of", " ", "a", " ", "set", 
      " ", "of", " ", "mode", " ", "functions"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2anomalous", "[", 
      RowBox[{"ns_", ",", " ", "modes_List"}], "]"}], " ", ":=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"w", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{
              RowBox[{"16", " ", "s"}], " ", "+", " ", "1"}], " ", ";;", " ", 
             
             RowBox[{
              RowBox[{"16", " ", "s"}], " ", "+", " ", "8"}]}], "]"}], "]"}], 
          " ", ".", " ", 
          RowBox[{"N", "[", 
           RowBox[{"t2kpair", "[", "i", "]"}], "]"}], " ", ".", " ", 
          RowBox[{"Conjugate", "[", 
           RowBox[{"w", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{
               RowBox[{"16", " ", "s"}], " ", "+", " ", "9"}], " ", ";;", " ", 
              RowBox[{
               RowBox[{"16", " ", "s"}], " ", "+", " ", "16"}]}], "]"}], 
            "]"}], "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"w", ",", " ", "modes"}], "}"}]}], "]"}], ",", "\n", "   ", 
       
       RowBox[{"{", 
        RowBox[{"s", ",", " ", "0", ",", " ", 
         RowBox[{"ns", " ", "-", " ", "1"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}]}]}]], "Input",Ex\
pressionUUID->"d53f2688-ddc6-444e-94f2-a251ecc5affa"],

Cell[TextData[{
 "The library module sym.rs is a small symbolic algebra: linear combinations \
of monomials (TeX strings) with exact coefficients ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], "+", 
    StyleBox["bi", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e1f7f0e8-9b27-42c8-9f6e-35074d1db369"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], ",", 
    StyleBox["b", "TI"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "328da438-4726-4dc0-9348-542a515f186d"],
 " rational), used by the programs to print the matrices and the component \
equations in TeX and to evaluate every printed formula numerically. The \
Wolfram Language is itself a symbolic algebra with exact Gaussian rationals, \
so this module needs no rewriting: in check GS-12 below the same formulas are \
built from symbols and evaluated in the same way. For example, the TeX of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Sigma]", "2", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bc39d6d6-c3a3-4448-ab4a-d6ece136cc81"],
 " written by ",
 StyleBox["TeXForm",
  FontFamily->"Source Code Pro"],
 ":"
}], "Text",ExpressionUUID->"51bccae9-8241-47e7-b29d-30c77744929e"],

Cell[BoxData[
 RowBox[{"ToString", "[", 
  RowBox[{"TeXForm", "[", 
   RowBox[{"MatrixForm", "[", 
    RowBox[{"t2sigma", "[", "2", "]"}], "]"}], "]"}], "]"}]], "Input",Expressi\
onUUID->"db4de7c5-81ad-4746-be10-c5dde190a288"],

Cell["\<\
II.1.5 The time integration (t2core/src/cvode.rs): IDA of SUNDIALS through \
NDSolve\
\>", "Subsection",ExpressionUUID->"450e3098-706b-4b14-8df4-27a5360f8b81"],

Cell[TextData[{
 "The equations and the integrator. The lattice equations of a Nambu mode are \
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["i", "TI"], "\[ThinSpace]", 
    SubscriptBox["\[PartialD]", "0"], 
    SubsuperscriptBox[
     StyleBox["w", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["lat",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalH]",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["lat",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["w", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["lat",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7c63f71d-50c1-43af-8b94-bb0e219adfee"],
 ": the mode is written as one complex vector ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["w", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["lat",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "662ef08f-727b-4ab2-a670-02f0ab60582c"],
 " (the 16 components of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Psi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b7e220bf-dd7f-4142-9d64-a74579365fa2"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Psi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["h",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a52a562d-2491-42b8-90ee-dccaa77ec728"],
 " on every site, the sites one after the other) with ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["cpx",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "41d313f4-dc6b-4af8-b668-2b2456943e32"],
 " complex components ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["w", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["cmp",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1ac38a44-d042-448f-aebe-618b8a731b82"],
 ". The original programs integrate them in time with CVODE, the solver of \
ordinary differential equations of the suite SUNDIALS (SUite of Nonlinear and \
DIfferential/ALgebraic equation Solvers, Lawrence Livermore National \
Laboratory; version 7.8.0 rewritten in Rust and called through the module \
cvode.rs of t2core), with the Adams-Moulton formulas of the orders 1 to 12. \
The first version of the original programs, and of this notebook, used the \
classical Runge-Kutta method of the fourth order with a fixed step, written \
by hand; such a method is used nowhere in the project any more. A notebook \
cannot call the Rust program. The Wolfram Language contains another \
integrator of the same suite: IDA, the solver of differential-algebraic \
equations, which ",
 StyleBox["NDSolve",
  FontFamily->"Source Code Pro"],
 " uses with the option ",
 StyleBox["Method -> \"IDA\"",
  FontFamily->"Source Code Pro"],
 ". An ordinary differential equation is the special case without algebraic \
equations. Part II uses IDA for every time integration."
}], "Text",ExpressionUUID->"c9a224d9-fa11-4ae7-bf75-ac91ddfd204f"],

Cell[TextData[{
 "How IDA integrates, and what its tolerances mean. IDA advances the solution \
in internal steps with the backward differentiation formulas of the orders 1 \
to 5 (such a formula expresses the derivative at the end of a step by the \
values at the ends of this step and of the steps before it) and solves the \
equations of every step by Newton's method. It chooses the length ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["h", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["IDA",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "14aa3232-7ca4-4dba-a4bf-dc11ce72224a"],
 " and the order of every step itself, so that an estimate of the local \
error, the error made in this one step, passes a test: the weighted \
root-mean-square norm of the estimate must be at most 1. This norm is the \
square root of the mean, over all real unknowns, of the squares of the \
estimated errors, each divided by the tolerance of its unknown; the tolerance \
of a real unknown is ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["tol",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6661b1e2-ff07-4fe4-9eff-c8e30a5bdbe5"],
 " times the modulus of the unknown plus ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["tol",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a45fbd7c-6f61-4161-a2a0-f8d27d40a169"],
 ", with the relative tolerance ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["tol",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "59e1682b-12a3-4e8f-9ae3-c9fc32ba2b32"],
 " and the absolute tolerance ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["tol",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "502d9daf-3c0d-498c-a653-ea8bb201d926"],
 ". ",
 StyleBox["NDSolve",
  FontFamily->"Source Code Pro"],
 " takes the two tolerances from its options: the relative tolerance is 10 to \
the power minus the setting of ",
 StyleBox["PrecisionGoal",
  FontFamily->"Source Code Pro"],
 ", the absolute tolerance 10 to the power minus the setting of ",
 StyleBox["AccuracyGoal",
  FontFamily->"Source Code Pro"],
 "; ",
 StyleBox["t2evolveIDA",
  FontFamily->"Source Code Pro"],
 " therefore sets these options to the negative decimal logarithms of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["tol",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3a240f5e-cacd-4bc9-b7d5-6ba6e21b44a4"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["tol",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1708f784-f1f9-4260-9fb4-4997f02b9878"],
 ". After a successful step IDA doubles the length of the step if its \
estimate allows that; otherwise it keeps the length or shortens it. If the \
error of every real unknown equals its tolerance, the norm of the error of \
one step is the norm of the vector of the tolerances, which by the triangle \
inequality is at most ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["tol",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5ddb2849-6336-4c23-935a-a8628a6846bb"],
 " times the norm of the state plus ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["tol",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9ff3f751-dade-407e-a912-6621af3852db"],
 " times the square root of the number ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    SubsuperscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["cpx",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "60269dfa-ee20-4f15-8d64-6f9cc128ea48"],
 " of real unknowns. This number is called ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["loc",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "18e77c99-e17a-44a0-83ed-34bf9c4edc00"],
 ". The exact local error of a step, called ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Delta]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["loc",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2c094be8-fa83-46de-9d80-dbaccde90bb0"],
 ", is the norm of the difference between the computed state at the end of \
the step and the exact solution that starts from the computed state at its \
beginning. IDA tests its estimate, not ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Delta]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["loc",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a3ae558b-d765-4a6d-9ad0-d8e3328f83d1"],
 " itself, so the checks T2-IDA and GS-13 measure ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Delta]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["loc",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "46a7fc59-4fbb-4139-9b72-552425ccf965"],
 " for every internal step and compare it with ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["loc",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "69728419-acbd-4c84-a025-59115c407f77"],
 "."
}], "Text",ExpressionUUID->"3ca4a3fe-e8f9-4986-bbaa-fb9b632b2596"],

Cell[TextData[{
 "The real form. IDA computes with real numbers (",
 StyleBox["NDSolve",
  FontFamily->"Source Code Pro"],
 " answers a complex equation for this method with the message \
NDSolveValue::mconly and gives no solution). ",
 StyleBox["t2evolveIDA",
  FontFamily->"Source Code Pro"],
 " therefore writes the state as the real vector of the length ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    SubsuperscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["cpx",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b51770f2-2c0c-4671-b15d-912d19166c82"],
 " made of the real parts ",
 StyleBox["u",
  FontFamily->"Source Code Pro"],
 " and the imaginary parts ",
 StyleBox["v",
  FontFamily->"Source Code Pro"],
 " of its components, and the Hermitian matrix as ",
 StyleBox["hr",
  FontFamily->"Source Code Pro"],
 " + ",
 Cell[BoxData[
  FormBox[
   StyleBox["i", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "02711788-90b3-40b4-89f7-db75269e6b07"],
 " ",
 StyleBox["hi",
  FontFamily->"Source Code Pro"],
 " with the real symmetric matrix ",
 StyleBox["hr",
  FontFamily->"Source Code Pro"],
 " and the real antisymmetric matrix ",
 StyleBox["hi",
  FontFamily->"Source Code Pro"],
 ". Then ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     StyleBox["i", "TI"]}], 
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalH]",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["lat",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["w", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["lat",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7d48ef43-0f5b-455b-950e-a562a7c3bad6"],
 " has the real part ",
 StyleBox["hi.u + hr.v",
  FontFamily->"Source Code Pro"],
 " and the imaginary part ",
 StyleBox["-hr.u + hi.v",
  FontFamily->"Source Code Pro"],
 ", so the lattice equations are the real linear system with the matrix ",
 StyleBox["m = {{hi, hr}, {-hr, hi}}",
  FontFamily->"Source Code Pro"],
 " acting on the real vector (",
 StyleBox["u",
  FontFamily->"Source Code Pro"],
 ", ",
 StyleBox["v",
  FontFamily->"Source Code Pro"],
 "). The matrix ",
 StyleBox["m",
  FontFamily->"Source Code Pro"],
 " is antisymmetric, and the largest length that it gives to a vector of the \
length 1 is ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["max",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "344846f9-59a6-4765-bec1-192233434bc2"],
 ", the largest modulus of the eigenvalues ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["E", "TI"], 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["n", "TI"]}], 
    StyleBox["qp",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "18b0b844-b652-4473-9917-5910c07a95b5"],
 " of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalH]",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["lat",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "508313b5-4c1c-46a0-a4cc-e915f82c5652"],
 "."
}], "Text",ExpressionUUID->"57455456-4fa8-4b2a-abc3-36115c37f445"],

Cell[TextData[{
 "The states between the internal steps. ",
 StyleBox["NDSolve",
  FontFamily->"Source Code Pro"],
 " returns the solution as an ",
 StyleBox["InterpolatingFunction",
  FontFamily->"Source Code Pro"],
 ". Its grid is the list of the times at the ends of the internal steps; with \
every grid time it stores the value of the solution and the value of the \
derivative that IDA computed there, and between two neighbouring grid times \
it gives every real unknown by the polynomial of the third degree that has \
these values and derivatives at the two ends (cubic Hermite interpolation). \
An output time lies in general inside an internal step, so a state returned \
by ",
 StyleBox["t2evolveIDA",
  FontFamily->"Source Code Pro"],
 " is an interpolated one, and its deviation from the exact solution has \
three sources. (1) The deviations of the stored values at the two ends of the \
step from the exact solution. The polynomial weighs the two values with \
numbers between 0 and 1 whose sum is 1, and the two derivatives with numbers \
whose moduli add up to at most one quarter of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["h", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["IDA",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "36bc1100-77ad-4cf5-896e-a1dc8703c2f6"],
 "; the exact derivative is ",
 StyleBox["m",
  FontFamily->"Source Code Pro"],
 " applied to the exact value. If the larger deviation at the two ends is at \
most ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["err",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c9f495d9-92d9-4ba7-8c46-68a8611fbba1"],
 ", this source gives at most ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "+", 
      FractionBox["1", "4"], 
      SubsuperscriptBox[
       StyleBox["h", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["IDA",
        FontSlant->"Plain"]], 
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["max",
        FontSlant->"Plain"]]}], ")"}], 
    SubsuperscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["err",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e7dd4677-d675-4e46-8879-0d0045191014"],
 ". (2) The stored derivatives are not exactly ",
 StyleBox["m",
  FontFamily->"Source Code Pro"],
 " applied to the stored values, because Newton's method stops at a \
tolerance. The norm of the difference at a grid time is called ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["der",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "96b395c9-9dda-4a49-9ef8-b91da13bd914"],
 "; it gives at most ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "4"], 
    SubsuperscriptBox[
     StyleBox["h", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["IDA",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["der",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e871ff71-8cb9-4b7b-8333-21321ff4da58"],
 ". (3) The interpolation of the exact solution itself. The cubic Hermite \
polynomial of a function with a continuous fourth derivative deviates from \
the function, at a time inside the step, by an average of the fourth \
derivative over the step, taken with a weight that is nowhere negative and \
whose integral is the product of the squares of the distances of that time \
from the two ends, divided by 24. The product is at most ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["h", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["IDA",
        FontSlant->"Plain"]], ")"}], "4"], "/", "16"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f89e00cb-2729-4f06-9fbd-9bf0ee8fe7ff"],
 ", and the fourth derivative of the exact solution is the fourth power of ",
 StyleBox["m",
  FontFamily->"Source Code Pro"],
 " applied to it, a vector of at most ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["E", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["max",
       FontSlant->"Plain"]], ")"}], "4"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "07738230-565f-418a-b4ca-5a80245c8cf3"],
 " times the norm of the state. This source therefore gives at most ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["h", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], 
        StyleBox["IDA",
         FontSlant->"Plain"]], 
       SubsuperscriptBox[
        StyleBox["E", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], 
        StyleBox["max",
         FontSlant->"Plain"]]}], ")"}], "4"], "/", "384"}], TraditionalForm]],
   "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c8205e9c-db41-4887-a762-b5c2d58af620"],
 " times the norm of the state. The sum of the three is the bound ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["out",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f883dabf-6699-4e49-bdfa-9f1dffaf6276"],
 " of the deviation of a returned state, written here for a state of the norm \
1:"
}], "Text",ExpressionUUID->"7438aa81-0f3b-49e4-a777-8afbfabee5f2"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["out",
     FontSlant->"Plain"]], "\[LongEqual]", 
   RowBox[{"(", 
    RowBox[{"1", "+", 
     FractionBox["1", "4"], 
     SubsuperscriptBox[
      StyleBox["h", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["IDA",
       FontSlant->"Plain"]], 
     SubsuperscriptBox[
      StyleBox["E", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["max",
       FontSlant->"Plain"]]}], ")"}], 
   SubsuperscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["err",
     FontSlant->"Plain"]], "+", 
   FractionBox["1", "4"], 
   SubsuperscriptBox[
    StyleBox["h", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["IDA",
     FontSlant->"Plain"]], 
   SubsuperscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["der",
     FontSlant->"Plain"]], "+", 
   FractionBox[
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["h", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], 
        StyleBox["IDA",
         FontSlant->"Plain"]], 
       SubsuperscriptBox[
        StyleBox["E", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], 
        StyleBox["max",
         FontSlant->"Plain"]]}], ")"}], "4"], "384"]}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"03d98136-1956-4c02-992a-c33b646ab102"],

Cell[TextData[{
 "The deviation at the ends of the steps. The exact evolution is unitary: it \
changes the norm of no vector. The deviation at the end of a step is \
therefore the deviation at its beginning, carried along unchanged in size, \
plus the local error of the step, so that the deviation after ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["N", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["st",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "90e316ef-6964-409e-a993-9abcaa9bef10"],
 " steps is at most the sum of their local errors ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Delta]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["loc",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9d577901-8516-48be-aa54-6c791c8c0ea4"],
 ". If every local error is at most ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["loc",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1055ae75-992e-4292-8624-5a8414d7a338"],
 ", the deviation at the end of every step is at most ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["err",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["st",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["loc",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "78317efd-bc56-4bfc-a49b-d2f479edcf8a"],
 ", the accumulated local error that the tolerances allow. (The original \
programs use the same number with the tolerances of CVODE, which weighs the \
real and the imaginary part of a complex component with the modulus of the \
component: there ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["loc",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "436d9791-90b4-4d06-971d-819018f096b6"],
 " is the square root of 2 times the sum of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["tol",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cd97a900-5167-49f4-b506-476ae0ec2a00"],
 " times the norm of the state and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["tol",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7676dff9-c2aa-4045-8c7b-975f32021f69"],
