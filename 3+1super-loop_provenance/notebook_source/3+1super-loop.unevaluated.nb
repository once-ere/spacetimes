       "active_List"}], "]"}], " ", ":=", " ", 
     RowBox[{"Sqrt", "[", "\n", "   ", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"active", "[", 
            RowBox[{"[", "j", "]"}], "]"}], ",", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"Sin", "[", 
              RowBox[{
               RowBox[{"q", "[", 
                RowBox[{"[", "j", "]"}], "]"}], " ", "ell"}], "]"}], "^", 
             "2"}], "/", 
            RowBox[{"ell", "^", "2"}]}], ",", " ", "0"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}], " ", "+", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"m", " ", "+", " ", 
          RowBox[{
           RowBox[{"r", "/", "ell"}], " ", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"active", "[", 
                RowBox[{"[", "j", "]"}], "]"}], ",", " ", 
               RowBox[{"1", " ", "-", " ", 
                RowBox[{"Cos", "[", 
                 RowBox[{
                  RowBox[{"q", "[", 
                   RowBox[{"[", "j", "]"}], "]"}], " ", "ell"}], "]"}]}], ",",
                " ", "0"}], "]"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}]}], ")"}], "^", 
        "2"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "the", " ", "4", " ", "x", " ", "4", " ", "matrix", " ", "of", " ", "the",
      " ", "free", " ", "lattice", " ", "operator", " ", "on", " ", "the", " ",
      "plane", " ", "wave", " ", "exp", 
     RowBox[{"(", 
      RowBox[{"i", " ", 
       RowBox[{"q", ".", "x"}]}], ")"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2hLatPlane", "[", 
      RowBox[{
      "q_List", ",", " ", "ell_", ",", " ", "m_", ",", " ", "r_", ",", " ", 
       "active_List"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"active", "[", 
           RowBox[{"[", "j", "]"}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{"t2alpha", "[", "j", "]"}], " ", 
           RowBox[{
            RowBox[{"Sin", "[", 
             RowBox[{
              RowBox[{"q", "[", 
               RowBox[{"[", "j", "]"}], "]"}], " ", "ell"}], "]"}], "/", 
            "ell"}]}], ",", " ", "0"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}], " ", "+", "\n", "   ", 
      
      RowBox[{"t2beta", " ", 
       RowBox[{"(", 
        RowBox[{"m", " ", "+", " ", 
         RowBox[{
          RowBox[{"r", "/", "ell"}], " ", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"active", "[", 
               RowBox[{"[", "j", "]"}], "]"}], ",", " ", 
              RowBox[{"1", " ", "-", " ", 
               RowBox[{"Cos", "[", 
                RowBox[{
                 RowBox[{"q", "[", 
                  RowBox[{"[", "j", "]"}], "]"}], " ", "ell"}], "]"}]}], ",", 
              " ", "0"}], "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}]}], ")"}]}]}]}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"the", " ", "anomalous", " ", "density", " ", 
       RowBox[{"Pi", "^", "iota"}], 
       RowBox[{"(", "s", ")"}]}], " ", "=", " ", 
      RowBox[{"sum_n", " ", "psi_p"}]}], ",", 
     RowBox[{"n", 
      RowBox[{
       RowBox[{"(", "s", ")"}], "^", "T"}], " ", "Kch_iota", " ", "conj", 
      RowBox[{"(", 
       RowBox[{"psi_h", ",", 
        RowBox[{"n", 
         RowBox[{"(", "s", ")"}]}]}], ")"}], " ", "of", " ", "a", " ", "set", 
      " ", "of", " ", "mode", " ", "functions"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2anomalous", "[", 
      RowBox[{"ns_", ",", " ", "modes_List"}], "]"}], " ", ":=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"w", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{
              RowBox[{"16", " ", "s"}], " ", "+", " ", "1"}], " ", ";;", " ", 
             
             RowBox[{
              RowBox[{"16", " ", "s"}], " ", "+", " ", "8"}]}], "]"}], "]"}], 
          " ", ".", " ", 
          RowBox[{"N", "[", 
           RowBox[{"t2kpair", "[", "i", "]"}], "]"}], " ", ".", " ", 
          RowBox[{"Conjugate", "[", 
           RowBox[{"w", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{
               RowBox[{"16", " ", "s"}], " ", "+", " ", "9"}], " ", ";;", " ", 
              RowBox[{
               RowBox[{"16", " ", "s"}], " ", "+", " ", "16"}]}], "]"}], 
            "]"}], "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"w", ",", " ", "modes"}], "}"}]}], "]"}], ",", "\n", "   ", 
       
       RowBox[{"{", 
        RowBox[{"s", ",", " ", "0", ",", " ", 
         RowBox[{"ns", " ", "-", " ", "1"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}]}]}]], "Input",Ex\
pressionUUID->"71018a5d-d57a-4343-b761-7d46ab11f19b"],

Cell[TextData[{
 "The library module sym.rs is a small symbolic algebra: linear combinations \
of monomials (TeX strings) with exact complex coefficients (the real and the \
imaginary part of a coefficient are rational numbers), used by the programs \
to print the matrices and the component equations in TeX and to evaluate \
every printed formula numerically. The Wolfram Language is itself a symbolic \
algebra with exact Gaussian rationals, so this module needs no rewriting: in \
check GS-12 below the same formulas are built from symbols and evaluated in \
the same way. For example, the TeX of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Sigma]", "2", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "28ecf309-b18f-4487-b87d-d8fb4fb6d491"],
 " written by ",
 StyleBox["TeXForm",
  FontFamily->"Source Code Pro"],
 ":"
}], "Text",ExpressionUUID->"ad882505-ccfe-4439-a45c-3edcf6a2598d"],

Cell[BoxData[
 RowBox[{"ToString", "[", 
  RowBox[{"TeXForm", "[", 
   RowBox[{"MatrixForm", "[", 
    RowBox[{"t2sigma", "[", "2", "]"}], "]"}], "]"}], "]"}]], "Input",Expressi\
onUUID->"fd231216-41d0-4fb6-983c-68c1c85d5d32"],

Cell["\<\
II.1.5 The time integration (t2core/src/cvode.rs): IDA of SUNDIALS through \
NDSolve\
\>", "Subsection",ExpressionUUID->"63502052-59fc-4b9b-b278-639dd5f7b49a"],

Cell[TextData[{
 "The equations and the integrator. The lattice equations of a Nambu mode are \
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["i", "TI"], "\[ThinSpace]", 
    SubscriptBox["\[PartialD]", "0"], 
    SubsuperscriptBox[
     StyleBox["w", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["lat",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalH]",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["lat",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["w", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["lat",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6c0844b1-7c53-4ef9-919a-29760e89d9e3"],
 ": the mode is written as one complex vector ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["w", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["lat",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "60a4984d-1f20-42ad-b46d-3bea029705b0"],
 " (the 16 components of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Psi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "da8c0e8b-56c7-4856-b916-847f221d82f6"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Psi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["h",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e9d00089-0359-4c11-b95e-27bbf818d862"],
 " on every site, the sites one after the other) with ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["cpx",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cc4a0e65-e257-4197-971d-01525a6d38bb"],
 " complex components ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["w", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["cmp",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "49abce32-302c-49c2-ac7c-8e64b36875a6"],
 ". The original programs integrate them in time with CVODE, the solver of \
ordinary differential equations of the suite SUNDIALS (SUite of Nonlinear and \
DIfferential/ALgebraic equation Solvers, Lawrence Livermore National \
Laboratory; version 7.8.0 rewritten in Rust and called through the module \
cvode.rs of t2core), with the Adams-Moulton formulas of the orders 1 to 12. \
The first version of the original programs, and of this notebook, used the \
classical Runge-Kutta method of the fourth order with a fixed step, written \
by hand; such a method is used nowhere in the project any more. A notebook \
cannot call the Rust program. The Wolfram Language contains another \
integrator of the same suite: IDA, the solver of differential-algebraic \
equations, which ",
 StyleBox["NDSolve",
  FontFamily->"Source Code Pro"],
 " uses with the option ",
 StyleBox["Method -> \"IDA\"",
  FontFamily->"Source Code Pro"],
 ". An ordinary differential equation is the special case without algebraic \
equations. Part II uses IDA for every time integration."
}], "Text",ExpressionUUID->"85da982b-87d9-40ab-bdef-719e650a4e80"],

Cell[TextData[{
 "How IDA integrates, and what its tolerances mean. IDA advances the solution \
in internal steps with the backward differentiation formulas of the orders 1 \
to 5 (such a formula expresses the derivative at the end of a step by the \
values at the ends of this step and of the steps before it) and solves the \
equations of every step by Newton's method. It chooses the length ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["h", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["IDA",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5d73d436-ff6a-4508-9787-71363f8f750d"],
 " and the order of every step itself, so that an estimate of the local \
error, the error made in this one step, passes a test: the weighted \
root-mean-square norm of the estimate must be at most 1. This norm is the \
square root of the mean, over all real unknowns, of the squares of the \
estimated errors, each divided by the tolerance of its unknown; the tolerance \
of a real unknown is ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["tol",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b98f5983-94f3-46ab-884d-76c602fe363a"],
 " times the modulus of the unknown plus ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["tol",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6d64380c-3272-48f8-8c15-dc4912572516"],
 ", with the relative tolerance ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["tol",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c143611d-7713-4497-85b4-810253cad50f"],
 " and the absolute tolerance ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["tol",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2bf7796f-682f-4650-a1d4-f1be982851e2"],
 ". ",
 StyleBox["NDSolve",
  FontFamily->"Source Code Pro"],
 " takes the two tolerances from its options: the relative tolerance is 10 to \
the power minus the setting of ",
 StyleBox["PrecisionGoal",
  FontFamily->"Source Code Pro"],
 ", the absolute tolerance 10 to the power minus the setting of ",
 StyleBox["AccuracyGoal",
  FontFamily->"Source Code Pro"],
 "; ",
 StyleBox["t2evolveIDA",
  FontFamily->"Source Code Pro"],
 " therefore sets these options to the negative decimal logarithms of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["tol",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0fdec8b1-13fd-45e1-bd1c-6c7a357e769e"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["tol",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4e660904-10ae-4f44-b2a4-80e2bbbcf120"],
 ". After a successful step IDA doubles the length of the step if its \
estimate allows that; otherwise it keeps the length or shortens it. If the \
error of every real unknown equals its tolerance, the norm of the error of \
one step is the norm of the vector of the tolerances, which by the triangle \
inequality is at most ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["tol",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6cf5d0b7-e936-47e5-98a6-4c3239dd4374"],
 " times the norm of the state plus ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["tol",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1102e713-cec5-46b2-833c-726e6fa90c12"],
 " times the square root of the number ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    SubsuperscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["cpx",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "461aba43-ab71-4bbb-a9b1-0adf20051db1"],
 " of real unknowns. This number is called ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["loc",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "83dc4d3b-778c-4539-b910-4a0b85c98504"],
 ". The exact local error of a step, called ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Delta]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["loc",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cd82f5d7-33f7-4001-8cf6-dd5e62cedb95"],
 ", is the norm of the difference between the computed state at the end of \
the step and the exact solution that starts from the computed state at its \
beginning. IDA tests its estimate, not ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Delta]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["loc",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1ddd004f-c953-46e0-b129-02e6dca6c556"],
 " itself, so the checks T2-IDA and GS-13 measure ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Delta]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["loc",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3712765c-0e0c-4972-801a-2994075712f9"],
 " for every internal step and compare it with ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["loc",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ecc0338e-b6dd-43a3-b222-79b0e0daab7a"],
 "."
}], "Text",ExpressionUUID->"6b5f9faa-8b16-4176-8d18-c3c55d82f123"],

Cell[TextData[{
 "The real form. IDA computes with real numbers (",
 StyleBox["NDSolve",
  FontFamily->"Source Code Pro"],
 " answers a complex equation for this method with the message \
NDSolveValue::mconly and gives no solution). ",
 StyleBox["t2evolveIDA",
  FontFamily->"Source Code Pro"],
 " therefore writes the state as the real vector of the length ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    SubsuperscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["cpx",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "34e3deee-df65-4aa8-a3c2-ef5b3943a301"],
 " made of the real parts ",
 StyleBox["u",
  FontFamily->"Source Code Pro"],
 " and the imaginary parts ",
 StyleBox["v",
  FontFamily->"Source Code Pro"],
 " of its components, and the Hermitian matrix as ",
 StyleBox["hr",
  FontFamily->"Source Code Pro"],
 " + ",
 Cell[BoxData[
  FormBox[
   StyleBox["i", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4803bd44-bd73-44ac-a7b3-77072ddbd0b8"],
 " ",
 StyleBox["hi",
  FontFamily->"Source Code Pro"],
 " with the real symmetric matrix ",
 StyleBox["hr",
  FontFamily->"Source Code Pro"],
 " and the real antisymmetric matrix ",
 StyleBox["hi",
  FontFamily->"Source Code Pro"],
 ". Then ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     StyleBox["i", "TI"]}], 
    SubsuperscriptBox[
     StyleBox["\[ScriptCapitalH]",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["lat",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["w", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["lat",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4b561d6e-5a96-4027-b54d-28d70bdcd1d1"],
 " has the real part ",
 StyleBox["hi.u + hr.v",
  FontFamily->"Source Code Pro"],
 " and the imaginary part ",
 StyleBox["-hr.u + hi.v",
  FontFamily->"Source Code Pro"],
 ", so the lattice equations are the real linear system with the matrix ",
 StyleBox["m = {{hi, hr}, {-hr, hi}}",
  FontFamily->"Source Code Pro"],
 " acting on the real vector (",
 StyleBox["u",
  FontFamily->"Source Code Pro"],
 ", ",
 StyleBox["v",
  FontFamily->"Source Code Pro"],
 "). The matrix ",
 StyleBox["m",
  FontFamily->"Source Code Pro"],
 " is antisymmetric, and the largest length that it gives to a vector of the \
length 1 is ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["max",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6ec00249-e38b-4024-a0c1-203da04699d7"],
 ", the largest modulus of the eigenvalues ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["E", "TI"], 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["n", "TI"]}], 
    StyleBox["qp",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0629f910-d9d8-4676-afb0-799218f1c3fe"],
 " of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalH]",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["lat",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "86035f08-3985-4128-be72-753620896447"],
 "."
}], "Text",ExpressionUUID->"27968f35-0274-43f7-a9c9-2148b3d6446c"],

Cell[TextData[{
 "The states between the internal steps. ",
 StyleBox["NDSolve",
  FontFamily->"Source Code Pro"],
 " returns the solution as an ",
 StyleBox["InterpolatingFunction",
  FontFamily->"Source Code Pro"],
 ". Its grid is the list of the times at the ends of the internal steps; with \
every grid time it stores the value of the solution and the value of the \
derivative that IDA computed there, and between two neighbouring grid times \
it gives every real unknown by the polynomial of the third degree that has \
these values and derivatives at the two ends (cubic Hermite interpolation). \
An output time lies in general inside an internal step, so a state returned \
by ",
 StyleBox["t2evolveIDA",
  FontFamily->"Source Code Pro"],
 " is an interpolated one, and its deviation from the exact solution has \
three sources. (1) The deviations of the stored values at the two ends of the \
step from the exact solution. The polynomial weighs the two values with \
numbers between 0 and 1 whose sum is 1, and the two derivatives with numbers \
whose moduli add up to at most one quarter of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["h", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["IDA",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "832b2fee-b369-4870-a465-3308c4d03870"],
 "; the exact derivative is ",
 StyleBox["m",
  FontFamily->"Source Code Pro"],
 " applied to the exact value. If the larger deviation at the two ends is at \
most ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["err",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4067182e-372b-4164-98d9-771cbf9e7830"],
 ", this source gives at most ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "+", 
      FractionBox["1", "4"], 
      SubsuperscriptBox[
       StyleBox["h", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["IDA",
        FontSlant->"Plain"]], 
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["max",
        FontSlant->"Plain"]]}], ")"}], 
    SubsuperscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["err",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "47db0b2d-bd6f-44b8-b908-d68ed5ec267a"],
 ". (2) The stored derivatives are not exactly ",
 StyleBox["m",
  FontFamily->"Source Code Pro"],
 " applied to the stored values, because Newton's method stops at a \
tolerance. The norm of the difference at a grid time is called ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["der",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "749b6945-aed9-4294-a82e-a87fc297a2de"],
 "; it gives at most ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "4"], 
    SubsuperscriptBox[
     StyleBox["h", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["IDA",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["der",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fd16001f-3627-4acb-9997-8dff783a5d8c"],
 ". (3) The interpolation of the exact solution itself. The cubic Hermite \
polynomial of a function with a continuous fourth derivative deviates from \
the function, at a time inside the step, by an average of the fourth \
derivative over the step, taken with a weight that is nowhere negative and \
whose integral is the product of the squares of the distances of that time \
from the two ends, divided by 24. The product is at most ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["h", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["IDA",
        FontSlant->"Plain"]], ")"}], "4"], "/", "16"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cd1fcb06-834e-4639-831e-cb7cceead5f9"],
 ", and the fourth derivative of the exact solution is the fourth power of ",
 StyleBox["m",
  FontFamily->"Source Code Pro"],
 " applied to it, a vector of at most ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["E", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["max",
       FontSlant->"Plain"]], ")"}], "4"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6aea3f1c-57c0-4540-9ffa-f279f4e9c2c1"],
 " times the norm of the state. This source therefore gives at most ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["h", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], 
        StyleBox["IDA",
         FontSlant->"Plain"]], 
       SubsuperscriptBox[
        StyleBox["E", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], 
        StyleBox["max",
         FontSlant->"Plain"]]}], ")"}], "4"], "/", "384"}], TraditionalForm]],
   "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "651a05ad-dca7-4a41-ae41-cf047265db73"],
 " times the norm of the state. The sum of the three is the bound ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["out",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6ef13624-0aae-4f47-8e72-55520292945f"],
 " of the deviation of a returned state, written here for a state of the norm \
1:"
}], "Text",ExpressionUUID->"469497d7-9718-41ef-916f-ec6577ab2453"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["out",
     FontSlant->"Plain"]], "\[LongEqual]", 
   RowBox[{"(", 
    RowBox[{"1", "+", 
     FractionBox["1", "4"], 
     SubsuperscriptBox[
      StyleBox["h", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["IDA",
       FontSlant->"Plain"]], 
     SubsuperscriptBox[
      StyleBox["E", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["max",
       FontSlant->"Plain"]]}], ")"}], 
   SubsuperscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["err",
     FontSlant->"Plain"]], "+", 
   FractionBox["1", "4"], 
   SubsuperscriptBox[
    StyleBox["h", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["IDA",
     FontSlant->"Plain"]], 
   SubsuperscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["der",
     FontSlant->"Plain"]], "+", 
   FractionBox[
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["h", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], 
        StyleBox["IDA",
         FontSlant->"Plain"]], 
       SubsuperscriptBox[
        StyleBox["E", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], 
        StyleBox["max",
         FontSlant->"Plain"]]}], ")"}], "4"], "384"]}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"c0f11800-c9bf-416b-9f1d-df6fd6b92e96"],

Cell[TextData[{
 "The deviation at the ends of the steps. The exact evolution is unitary: it \
changes the norm of no vector. The deviation at the end of a step is \
therefore the deviation at its beginning, carried along unchanged in size, \
plus the local error of the step, so that the deviation after ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["N", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["st",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "11eb5583-b8b8-47bb-9b31-9864e52bbcde"],
 " steps is at most the sum of their local errors ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Delta]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["loc",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "96194726-a441-4fc9-8383-f47be2c6b3a0"],
 ". If every local error is at most ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["loc",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c1f0ba9f-9007-4e15-b356-5f741fdd4982"],
 ", the deviation at the end of every step is at most ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["err",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["st",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["loc",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "88507ba5-69e0-454b-a421-5a454c885a5e"],
 ", the accumulated local error that the tolerances allow. (The original \
programs use the same number with the tolerances of CVODE, which weighs the \
real and the imaginary part of a complex component with the modulus of the \
component: there ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["loc",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "41557f92-9da7-4270-9e64-845976f986ee"],
 " is the square root of 2 times the sum of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["tol",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1661a3fb-952b-4116-9671-f6924af249d1"],
 " times the norm of the state and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["tol",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "40a18f9e-4b1e-4768-b906-f04c6db8f193"],
 " times the square root of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["cpx",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "85f25889-f2d3-4591-afde-a3539c0e108e"],
 ".) The first statement needs no condition: the sum of the measured local \
errors is itself a bound of the deviation at the end of every step, whether \
or not the single errors stay below ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["loc",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6ad27caf-40b6-4f70-8cba-9eafab573722"],
 " (IDA tests its own estimate of the error, in its weighted norm, not ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Delta]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["loc",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "131202d9-eefc-453e-9851-ad2da2621428"],
 "). The checks of chapter II.3 use this sum. The function ",
 StyleBox["t2localErrorsIDA",
  FontFamily->"Source Code Pro"],
 " measures ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Delta]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["loc",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "55b12826-775f-407d-bbc9-61bca4a68a27"],
 " for every internal step, and their sum: with the eigenvalues ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["E", "TI"], 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["n", "TI"]}], 
    StyleBox["qp",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dd301dd3-61fe-41c9-8c00-567f3350c7d2"],
 " and the eigenvectors of the Hermitian matrix, the exact solution that \
starts from a computed state multiplies the coefficient of every eigenvector \
by the phase factor of the angle ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     SubsuperscriptBox[
      StyleBox["E", "TI"], 
      RowBox[{
       StyleBox["LL",
        FontSlant->"Plain"], ",", 
       StyleBox["n", "TI"]}], 
      StyleBox["qp",
       FontSlant->"Plain"]]}], 
    SubsuperscriptBox[
     StyleBox["h", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["IDA",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a5cc0c4e-6c6d-4665-aefb-00c0b1849c1f"],
 ", with the eigenvalue ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["E", "TI"], 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["n", "TI"]}], 
    StyleBox["qp",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6277d760-ccdf-442f-b937-6bd658a326b6"],
 " of this eigenvector."
}], "Text",ExpressionUUID->"fa51d4a3-b5a7-4517-aec1-e773e127978d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"The", " ", "time", " ", "integration", " ", "of", " ", "i", " ", 
       RowBox[{"dw", "/", "dx0"}]}], " ", "=", " ", 
      RowBox[{
       RowBox[{"hm", " ", ".", " ", "w"}], " ", "by", " ", "IDA", " ", "of", " ",
        "SUNDIALS", " ", "through", " ", 
       RowBox[{"NDSolve", ".", "\n", "   ", 
        RowBox[{"hm", ":", " ", 
         RowBox[{
         "a", " ", "Hermitian", " ", "matrix", " ", "that", " ", "does", " ", 
          "not", " ", "depend", " ", "on", " ", "the", " ", "time"}]}]}]}]}], 
     ";", " ", 
     RowBox[{
      RowBox[{"w0", ":", " ", 
       RowBox[{"the", " ", "state", " ", "at", " ", "x0"}]}], " ", "=", " ", 
      "0"}], ";", " ", 
     RowBox[{"touts", ":", " ", 
      RowBox[{
      "the", " ", "output", " ", "times", " ", "in", "\n", "   ", 
       "increasing", " ", "order"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"the", " ", "first", " ", "of", " ", "them", " ", "0"}], ";", 
     " ", "rtol"}], ",", " ", 
    RowBox[{
     RowBox[{"atol", ":", " ", 
      RowBox[{
      "the", " ", "tolerances", " ", "of", " ", "the", " ", "local", " ", 
       "error", " ", "test"}]}], ";", " ", 
     RowBox[{"analysis", ":", " ", 
      RowBox[{
      "optionally", " ", "a", "\n", "   ", "function", " ", "that", " ", "is",
        " ", "applied", " ", "to", " ", "the", " ", "InterpolatingFunction", " ",
        "of", " ", "the", " ", "real", " ", "form", " ", "before", " ", "it", 
       " ", "is", " ", 
       RowBox[{"discarded", ".", "\n", "   ", "The"}], " ", "result", " ", 
       "is", " ", "an", " ", "association", " ", "with", " ", "the", " ", 
       "keys", "\n", "     ", "\"\<states\>\"", "       ", "the", " ", 
       "complex", " ", "states", " ", "at", " ", "the", " ", "output", " ", 
       "times", "\n", "     ", "\"\<steps\>\"", "        ", "the", " ", 
       "number", " ", 
       RowBox[{"N", "^", "st"}], " ", "of", " ", "internal", " ", "steps", "\n",
        "     ", "\"\<evaluations\>\"", "  ", "the", " ", "number", " ", 
       RowBox[{"N", "^", "ev"}], " ", "of", " ", "evaluations", " ", "of", " ",
        "the", " ", "right", " ", "side", " ", 
       RowBox[{"m", " ", ".", " ", "y"}], " ", "that", " ", "NDSolve", " ", 
       "reports", " ", 
       RowBox[{"(", "EvaluationMonitor", ")"}], "\n", "     ", "\"\<hmax\>\"",
        "         ", "the", " ", "largest", " ", "internal", " ", "step", " ", 
       RowBox[{"h", "^", "IDA"}], "\n", "     ", "\"\<stepAt\>\"", "       ", 
       "for", " ", "every", " ", "output", " ", "time", " ", "after", " ", 
       "the", " ", "first"}], ":", " ", 
      RowBox[{
      "the", " ", "length", " ", "of", " ", "the", " ", "internal", " ", 
       "step", " ", "that", " ", "contains", " ", "it", "\n", 
       "     ", "\"\<residualAt\>\"", "   ", "for", " ", "the", " ", "same", " ",
        "output", " ", 
       RowBox[{"times", ":", " ", 
        RowBox[{
         RowBox[{"the", " ", "larger", " ", "norm", " ", 
          RowBox[{"r", "^", "der"}], " ", "of", " ", 
          RowBox[{"(", 
           RowBox[{"stored", " ", "derivative"}], ")"}]}], " ", "-", " ", 
         RowBox[{
          RowBox[{"m", " ", ".", " ", 
           RowBox[{"(", 
            RowBox[{"stored", " ", "value"}], ")"}]}], " ", "at", "\n", 
          "                    ", "the", " ", "two", " ", "ends", " ", "of", " ",
           "that", " ", "step", "\n", "     ", "\"\<hermiteAt\>\"", "    ", 
          "for", " ", "the", " ", "same", " ", "output", " ", "times"}]}], ":",
         " ", 
        RowBox[{
        "the", " ", "norm", " ", "of", " ", "the", " ", "difference", " ", 
         "between", " ", "the", " ", "state", " ", "given", " ", "by", " ", 
         "NDSolve", " ", "and", " ", "the", "\n", "                    ", 
         "cubic", " ", "Hermite", " ", "polynomial", " ", "built", " ", 
         "here", " ", "from", " ", "the", " ", "values", " ", "and", " ", 
         "the", " ", "derivatives", " ", "at", " ", "the", " ", "two", " ", 
         "ends", " ", "of", " ", "the", " ", "step", "\n", 
         "     ", "\"\<analysis\>\"", "     ", "the", " ", "result", " ", 
         "of", " ", "the", " ", "function", " ", "analysis"}]}]}]}]}], ",", 
    " ", 
    RowBox[{"or", " ", 
     RowBox[{"None", ".", "\n", "   ", "A"}], " ", "failed", " ", 
     "integration", " ", 
     RowBox[{"(", 
      RowBox[{
      "NDSolve", " ", "then", " ", "prints", " ", "a", " ", "message"}], 
      ")"}], " ", "gives", " ", 
     RowBox[{"$Failed", "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"t2evolveIDA", "[", 
      RowBox[{
       RowBox[{"hm_", "?", "MatrixQ"}], ",", " ", 
       RowBox[{"w0_", "?", "VectorQ"}], ",", " ", "touts_List", ",", " ", 
       RowBox[{"rtol_", "?", "NumericQ"}], ",", " ", 
       RowBox[{"atol_", "?", "NumericQ"}], ",", " ", 
       RowBox[{"analysis_", " ", ":", " ", "None"}]}], "]"}], " ", ":=", "\n",
      "  ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"nc", " ", "=", " ", 
          RowBox[{"Length", "[", "w0", "]"}]}], ",", " ", "m", ",", " ", 
         "yIDA", ",", " ", "tIDA", ",", " ", "sol", ",", " ", "dsol", ",", 
         " ", "grid", ",", " ", 
         RowBox[{"nev", " ", "=", " ", "0"}], ",", " ", "ends", ",", " ", 
         "toComplex", ",", " ", "hermite"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"m", " ", "=", " ", 
         RowBox[{"Developer`ToPackedArray", "[", 
          RowBox[{"N", "[", 
           RowBox[{"ArrayFlatten", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Im", "[", "hm", "]"}], ",", " ", 
                RowBox[{"Re", "[", "hm", "]"}]}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", 
                 RowBox[{"Re", "[", "hm", "]"}]}], ",", " ", 
                RowBox[{"Im", "[", "hm", "]"}]}], "}"}]}], "}"}], "]"}], 
           "]"}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"sol", " ", "=", " ", 
         RowBox[{"NDSolveValue", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"yIDA", "'"}], "[", "tIDA", "]"}], " ", "==", " ", 
              RowBox[{"m", " ", ".", " ", 
               RowBox[{"yIDA", "[", "tIDA", "]"}]}]}], ",", " ", 
             RowBox[{
              RowBox[{"yIDA", "[", "0", "]"}], " ", "==", " ", 
              RowBox[{"N", "[", 
               RowBox[{"Join", "[", 
                RowBox[{
