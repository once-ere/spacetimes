          RowBox[{"Last", "[", "as9Plus", "]"}], " ", "+", " ", "1"}], "]"}], 
        "]"}]}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Kato", " ", "and", " ", 
      RowBox[{"Temple", ":", " ", 
       RowBox[{
        RowBox[{"the", " ", "16", " ", "moduli", " ", "lie", " ", "within", " ", 
         RowBox[{
          RowBox[{"r", "^", "2"}], "/", "delta"}]}], " ", "+", " ", 
        RowBox[{"spread", " ", "of", " ", "E_R"}]}]}]}], ";", " ", 
     RowBox[{
     "spread", " ", "is", " ", "the", " ", "largest", " ", "minus", " ", 
      "the", " ", "smallest", " ", "modulus"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"as9Moduli", " ", "=", " ", 
     RowBox[{"Abs", "[", 
      RowBox[{"as9Ev", "[", 
       RowBox[{"[", "as9Inside", "]"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as9Spread", " ", "=", " ", 
     RowBox[{
      RowBox[{"Max", "[", "as9Moduli", "]"}], " ", "-", " ", 
      RowBox[{"Min", "[", "as9Moduli", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as9WorstBound", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{"as9Moduli", " ", "-", " ", "as9ER"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as9TolE", " ", "=", " ", 
     RowBox[{
      RowBox[{"as9Residual", " ", 
       RowBox[{"as9Residual", "/", "as9Delta"}]}], " ", "+", " ", 
      "as9Spread"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Davis", " ", "and", " ", 
     RowBox[{"Kahan", ":", " ", 
      RowBox[{
      "the", " ", "part", " ", "of", " ", "the", " ", "analytic", " ", 
       "state", " ", "outside", " ", "the", " ", "eight", " ", "eigenvectors",
        " ", "has", " ", "at", " ", "most", " ", "the", " ", "norm", " ", 
       RowBox[{"r", "/", "delta"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"as9Outside", " ", "=", " ", 
     RowBox[{"as9Convergence", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", " ", "5"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as9TolOut", " ", "=", " ", 
     RowBox[{"as9Residual", "/", "as9Delta"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "the", " ", "requirement", " ", "for", " ", "the", " ", "densities"}], 
    " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"as9TolBC", " ", "=", " ", 
     RowBox[{"0.5", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"as9Residual", "/", "as9Delta"}], ")"}], "^", "2"}]}]}], 
    ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<AS-9\>\"", ",", 
     " ", "\"\<the bound states of the domain wall on the lattice (case C): \
on a ring of length 24 (60 sites, dx = 0.4, r_W = 1, m = 0.4, mu = 0) with \
the kink-antikink profile Delta(x_LL^1) = tanh(x_LL^1 - 6) tanh(18 - x_LL^1), \
the lattice operator has exactly 16 eigenvalues inside 0.8 times the \
continuum threshold (m^2 + Delta_inf^2)^(1/2), eight positive and eight \
negative (four per wall and sign); with the relative residual r of the \
analytic bound state at dx = 0.4 and the distance delta from its Rayleigh \
quotient E_R to the nearest eigenvalue outside the cluster of the eight \
positive bound states, which lies between the neighbours of the cluster: (1) \
the moduli of the 16 eigenvalues lie within r^2/delta + spread of E_R, where \
spread is the largest minus the smallest of the 16 moduli (the theorem of \
Kato and Temple: one eigenvalue of the cluster lies at most r^2/delta above \
E_R and one at most r^2/delta below); (2) the part of the normalized analytic \
state outside the space of the eight eigenvectors near +m has at most the \
norm r/delta (the theorem of Davis and Kahan); (3) the summed density of the \
eight states near +m agrees with the analytic density of the bound states of \
the two walls at second order in r, 1 - (Bhattacharyya coefficient of the two \
normalized densities) < (1/2) (r/delta)^2 (a requirement of the check on the \
scale of (2), not a theorem; the Bhattacharyya coefficient is the sum over \
the sites of the square root of the product of the two densities, each \
normalized to the sum 1); for the analytic bound state of the kink (chi_K \
with the components 1 and 5 equal to 1/sqrt 2 and the others zero, beta_LL \
chi_K = chi_K) on rings with dx = 0.4, 0.2, 0.1, 0.05 the Rayleigh quotient \
E_R equals the exact lattice formula m + (r_W/(2 dx)) sum (phi_K(s+1) - \
phi_K(s))^2 / sum phi_K(s)^2 (tolerance 1e-12), (E_R - m)/(r_W dx) tends to \
1/6 (within 1 per cent at dx = 0.05, the difference decreasing by a factor \
between 3.5 and 4.5 at each halving of dx: the Wilson term shifts the bound \
state at first order in dx, by r_W dx/6, with a correction of order dx^3), \
and the relative residual decreases at least by the factor 0.6 at each \
halving of dx\>\"", ",", "\n", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", "as9Inside", "]"}], " ", "==", " ", "16"}], " ",
       "&&", " ", 
      RowBox[{
       RowBox[{"Length", "[", "as9Plus", "]"}], " ", "==", " ", "8"}], " ", "&&",
       " ", "as9Between", " ", "&&", " ", 
      RowBox[{"as9WorstBound", " ", "<=", " ", "as9TolE"}], " ", "&&", " ", 
      RowBox[{"as9Outside", " ", "<=", " ", "as9TolOut"}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"1.", " ", "-", " ", "as9BC"}], " ", "<", " ", "as9TolBC"}], 
      " ", "&&", " ", 
      RowBox[{"as9DevFormula", " ", "<", " ", "1*^-12"}], " ", "&&", " ", 
      "as9FirstOrder", " ", "&&", " ", "as9ResidualFalls", " ", "&&", "\n", 
      "   ", 
      RowBox[{"as9BetaDev", " ", "<", " ", "1*^-15"}]}], ",", "\n", "  ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Length", "[", "as9Inside", "]"}], ",", 
        " ", "\"\< bound states (\>\"", ",", " ", 
        RowBox[{"Length", "[", "as9Plus", "]"}], ",", 
        " ", "\"\< positive); largest | |E| - E_R | = \>\"", ",", " ", 
        RowBox[{"asFix", "[", 
         RowBox[{"as9WorstBound", ",", " ", "5"}], "]"}], ",", 
        " ", "\"\< (bound r^2/delta + spread = \>\"", ",", " ", 
        RowBox[{"asFix", "[", 
         RowBox[{"as9TolE", ",", " ", "5"}], "]"}], ",", 
        " ", "\"\<, delta = \>\"", ",", "\n", "    ", 
        RowBox[{"asFix", "[", 
         RowBox[{"as9Delta", ",", " ", "4"}], "]"}], ",", 
        " ", "\"\<, spread = \>\"", ",", " ", 
        RowBox[{"asSci", "[", "as9Spread", "]"}], ",", 
        " ", "\"\<); part of the analytic state outside the eight \
eigenvectors \>\"", ",", " ", 
        RowBox[{"asFix", "[", 
         RowBox[{"as9Outside", ",", " ", "4"}], "]"}], ",", 
        " ", "\"\< (bound r/delta = \>\"", ",", "\n", "    ", 
        RowBox[{"asFix", "[", 
         RowBox[{"as9TolOut", ",", " ", "4"}], "]"}], ",", 
        " ", "\"\<); 1 - Bhattacharyya coefficient = \>\"", ",", " ", 
        RowBox[{"ScientificForm", "[", 
         RowBox[{
          RowBox[{"1.", " ", "-", " ", "as9BC"}], ",", " ", "3"}], "]"}], ",",
         " ", "\"\< (required below \>\"", ",", " ", 
        RowBox[{"ScientificForm", "[", 
         RowBox[{"as9TolBC", ",", " ", "3"}], "]"}], ",", 
        " ", "\"\<); E_R = \>\"", ",", "\n", "    ", 
        RowBox[{"Row", "[", 
         RowBox[{"Riffle", "[", 
          RowBox[{
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"asFix", "[", 
               RowBox[{"#", ",", " ", "6"}], "]"}], " ", "&"}], ",", " ", 
             RowBox[{"as9Convergence", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], "]"}], ",", 
           " ", "\"\<, \>\""}], "]"}], "]"}], ",", 
        " ", "\"\<; (E_R - m)/dx = \>\"", ",", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"Riffle", "[", 
          RowBox[{
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"asFix", "[", 
               RowBox[{"#", ",", " ", "5"}], "]"}], " ", "&"}], ",", " ", 
             "as9Ratios"}], "]"}], ",", " ", "\"\<, \>\""}], "]"}], "]"}], ",",
         " ", "\"\<; residuals \>\"", ",", "\n", "    ", 
        RowBox[{"Row", "[", 
         RowBox[{"Riffle", "[", 
          RowBox[{
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"ScientificForm", "[", 
               RowBox[{"#", ",", " ", "3"}], "]"}], " ", "&"}], ",", " ", 
             RowBox[{"as9Convergence", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", " ", "3"}], "]"}], "]"}]}], "]"}], ",", 
           " ", "\"\<, \>\""}], "]"}], "]"}], ",", 
        " ", "\"\<; deviation from the lattice formula \>\"", ",", " ", 
        RowBox[{"asSci", "[", "as9DevFormula", "]"}], ",", "\n", 
        "    ", "\"\< (original: 16 bound states (8 positive); 0.00312 (bound \
0.02260, delta = 0.6139, spread = 3.8e-14); 0.0841 (bound 0.1919); 1.12e-3 \
(required below 1.84e-2); E_R = 0.465443, 0.433178, 0.416647, 0.408331; (E_R \
- m)/dx = 0.16361, 0.16589, 0.16647, 0.16662; residuals 1.18e-1, 5.94e-2, \
2.98e-2, 1.49e-2; 3.8e-15)\>\""}], "}"}], "]"}]}], "]"}]}]}]], "Input",Express\
ionUUID->"f9bbe950-c477-4929-a558-4028ae42a776"],

Cell["\<\
Case D: Landau levels in constant magnetic fields (check AS-10)\
\>", "Subsection",ExpressionUUID->"8e69c585-31c9-4e0d-9288-2cbeb62a6319"],

Cell[TextData[{
 StyleBox["The fields.",
  FontWeight->"Bold"],
 " No pair field, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Mu]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "39b16eb2-412e-4f51-bf9b-68ca2101f96b"],
 ", and constant magnetic fields along ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "aa2dd3ba-2789-4bb0-b261-76461c587092"],
 " of the fermion number and of the third isospin direction: the field \
strengths ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["F",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", "12"}], 
    StyleBox["F",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d6f54e06-b060-4239-be01-0697e9aa2310"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["F",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", "12"}], "3"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "96038fcc-f311-4ab3-a4f7-7aabab3afe8c"],
 ", in the Landau gauge ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", "2"}], 
     StyleBox["F",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["F",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", "12"}], 
     StyleBox["F",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "1"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "aee97682-b5f3-4b26-ac73-67dccaef49fc"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", "2"}], "3"], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["F",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", "12"}], "3"], 
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "1"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a36e410c-a100-4c90-8a9a-ed848f10173c"],
 " (all other potentials are zero). On the isospin-up components the \
potential is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["A",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", "2"}], "\[UpArrow]"], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[UpArrow]"], 
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "1"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "94524688-84b3-46b3-b32c-d0f30cf52734"],
 " and on the isospin-down components ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["A",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", "2"}], "\[DownArrow]"], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[DownArrow]"], 
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "1"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bd5a8bd3-db13-42b6-aad2-4e1bfe59ecde"],
 ", with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[UpArrow]"], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["F",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", "12"}], 
     StyleBox["F",
      FontSlant->"Plain"]], "+", 
    FractionBox["1", "2"], 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["F",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", "12"}], "3"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "908470d7-a556-4bca-80bf-f3b3062140eb"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[DownArrow]"], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["F",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", "12"}], 
     StyleBox["F",
      FontSlant->"Plain"]], "-", 
    FractionBox["1", "2"], 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["F",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", "12"}], "3"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "86281310-7760-4eaf-b473-8f410b20509d"],
 ": the two isospin components feel different magnetic fields."
}], "Text",ExpressionUUID->"9c5a76e8-c6e1-43b5-9d14-f1010e5c0e59"],

Cell[TextData[{
 StyleBox["The solution.",
  FontWeight->"Bold"],
 " Square the covariant Dirac Hamiltonian ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["h", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Del]"], "\[LongEqual]", 
    RowBox[{"-", 
     StyleBox["i", "TI"]}], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", 
     StyleBox["j", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]], 
    SubsuperscriptBox["\[Del]", 
     StyleBox["j", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "+", 
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "71f09973-9a05-4a1b-a6e8-62b7ef3d4212"],
 ". The terms with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]], 
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c26e02ea-307e-4562-9885-1546c99c2c30"],
 " cancel, the terms with twice the same ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Alpha]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "899d221f-58d3-4d15-bdcc-860574835311"],
 " give ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["j", "TI"],
     LimitsPositioning->True], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", 
        StyleBox["i", "TI"]}], 
       SubsuperscriptBox["\[Del]", 
        StyleBox["j", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"]]}], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2e810385-1810-4b6f-b753-63651bf3aadc"],
 ", and the terms with two different matrices combine into commutators of \
covariant derivatives, which are the field strengths (check GS-6), multiplied \
by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]], 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     SuperscriptBox[
      StyleBox["j", "TI"], "\[Prime]"]], "\[LongEqual]", 
    RowBox[{"-", "2"}], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["s",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["J", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], 
      SuperscriptBox[
       StyleBox["j", "TI"], "\[Prime]\[Prime]"]], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fe23b1d9-4851-4a6b-8828-dfc3fb328fa4"],
 " for the cyclic triples ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["j", "TI"], ",", 
     SuperscriptBox[
      StyleBox["j", "TI"], "\[Prime]"], ",", 
     SuperscriptBox[
      StyleBox["j", "TI"], "\[Prime]\[Prime]"]}], ")"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4f724af0-97dc-45cc-b26a-ad8ef52ac195"],
 " (check GS-2). Here only the field strengths with the indices 12 differ \
from zero. On the isospin-up components, and on ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["exp",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["i", "TI"], 
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox[
         StyleBox["q", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], "2"], 
        SubsuperscriptBox[
         StyleBox["x", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], "2"], "+", 
        SubsuperscriptBox[
         StyleBox["q", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], "3"], 
        SubsuperscriptBox[
         StyleBox["x", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], "3"]}], ")"}]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "05c853b9-a9dc-44ef-a02a-ac48cdde2f81"],
 " times a function of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "1"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "be6e2858-341d-49b6-a20e-56695d3fb766"],
 ", the square is"
}], "Text",ExpressionUUID->"4f4d1cdf-8b1b-4e22-82ca-5c3be2343cf9"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["h", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], "\[Del]"], ")"}], "2"], "\[LongEqual]", 
   SubsuperscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "2"], "+", 
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["q", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], "3"], ")"}], "2"], "+", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       SuperscriptBox[
        StyleBox["d", "TI"], "2"], 
       RowBox[{
        StyleBox["d", "TI"], 
        SuperscriptBox[
         RowBox[{"(", 
          SubsuperscriptBox[
           StyleBox["x", "TI"], 
           StyleBox["LL",
            FontSlant->"Plain"], "1"], ")"}], "2"]}]]}], "+", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["B", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], "\[UpArrow]"], ")"}], "2"], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox[
         StyleBox["x", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], "1"], "-", 
        SubsuperscriptBox[
         StyleBox["q", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], "2"], "/", 
        SubsuperscriptBox[
         StyleBox["B", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], "\[UpArrow]"]}], ")"}], "2"]}], ")"}], "-", 
   "2", 
   SubsuperscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "\[UpArrow]"], "\[ThinSpace]", 
   StyleBox["i", "TI"], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["s",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"]], 
   RowBox[{"(", 
    SubsuperscriptBox[
     StyleBox["J", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "3"], ")"}]}], TraditionalForm]], "DisplayFormula",\

 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"bc971c08-6a49-4a81-89cf-b059968ad88a"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["i", "TI"], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["s",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["J", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], "3"], ")"}], "\[LongEqual]", 
    FractionBox["1", "2"], 
    StyleBox["diag",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["\[Sigma]", "3", 
       StyleBox["LL",
        FontSlant->"Plain"]], ",", 
      SubsuperscriptBox["\[Sigma]", "3", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0155727d-c48d-4887-abbf-098bc7a8d2df"],
 " is the spin of the spinor charge along ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "21880e57-fafe-4110-b515-616556a04e90"],
 ". The large bracket is a harmonic oscillator centred at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "2"], "/", 
    SubsuperscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[UpArrow]"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1dd5700a-25cc-4ee9-8e3d-bb4939ba4e36"],
 ", with the eigenvalues ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftBracketingBar]", 
    SubsuperscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[UpArrow]"], "\[RightBracketingBar]"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "411663d0-0aa9-4908-819b-3cf10d905be1"],
 " times ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", ",", "3", ",", "5", ",", "\[Ellipsis]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a67bc83b-d994-46b9-9f2f-8b5aa3cb2a6e"],
 "; the spin has the eigenvalues ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    FractionBox["1", "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cae746d4-df4f-495a-8769-69bf6c3eacdc"],
 " and commutes with the bracket. The sum of the oscillator eigenvalue and of \
the spin term ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[MinusPlus]", 
    SubsuperscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[UpArrow]"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6f5270a1-0ad8-4db1-b7c8-6451e3bf7c1b"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    SubsuperscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["L",
      FontSlant->"Plain"]], 
    RowBox[{"\[LeftBracketingBar]", 
     SubsuperscriptBox[
      StyleBox["B", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], "\[UpArrow]"], "\[RightBracketingBar]"}]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e322098a-6733-4883-bcb1-fb4ffbadac31"],
 " with the number ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["L",
      FontSlant->"Plain"]], "\[LongEqual]", "0", ",", "1", ",", "2", ",", 
    "\[Ellipsis]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2a981547-16fe-4026-878b-f97e53638f01"],
 " of the Landau level: the level 0 arises only from the lowest oscillator \
state with the spin parallel to the field, and every level ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["L",
      FontSlant->"Plain"]], "\[GreaterEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a76f1bef-bd4e-4421-86b7-78982bf7c397"],
 " from two combinations (the oscillator state with the number ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["L",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "80ef5ea4-86e3-4852-9b5e-eb3e293f989a"],
 " and the parallel spin, and the oscillator state with the number ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["L",
      FontSlant->"Plain"]], "-", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c66ec778-7da2-4d0e-b9e8-7e7211238c37"],
 " and the antiparallel spin). The energies are therefore"
}], "Text",ExpressionUUID->"afebb3ec-8ed5-4dcb-83f3-ee62c7bcc58c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["E", "TI"], 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["n", "TI"]}], 
    StyleBox["qp",
     FontSlant->"Plain"]], "\[LongEqual]", 
   RowBox[{"\[PlusMinus]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["m", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], "2"], "+", 
       SuperscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox[
          StyleBox["q", "TI"], 
          StyleBox["LL",
           FontSlant->"Plain"], "3"], ")"}], "2"], "+", "2", 
       SubsuperscriptBox[
        StyleBox["n", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], 
        StyleBox["L",
         FontSlant->"Plain"]], 
       RowBox[{"\[LeftBracketingBar]", 
        SubsuperscriptBox[
         StyleBox["B", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], "\[UpArrow]"], "\[RightBracketingBar]"}]}], 
      ")"}], 
     RowBox[{"1", "/", "2"}]]}], ",", "      ", 
   SubsuperscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["L",
     FontSlant->"Plain"]], "\[LongEqual]", "0", ",", "1", ",", "2", ",", 
   "\[Ellipsis]"}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"c26d5d03-a662-46f0-9a77-2a3e5b4fc7b6"],

Cell[TextData[{
 "for every ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["q", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cd377e6a-ffd9-4892-92f6-b9455dd640a7"],
 " (the position of the centre: the levels are degenerate), and the same with \
",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "\[DownArrow]"], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6e45be49-3e9f-470e-bf10-492cddb2c6a1"],
 " for isospin down. At ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "3"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "45db9314-53d3-4f24-914c-9e6be3f52105"],
 " the level 0 has the energies ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", 
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "af3b39b0-cc28-4e08-96bd-59a9914df284"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "accca66c-b3a7-4958-9560-2ddfe203a579"],
 " once each, and every level ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["L",
      FontSlant->"Plain"]], "\[GreaterEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "569708c6-7d59-4ba7-b868-760f09b588e1"],
 " has each of its two energies twice. The level 0 does not depend on the \
field: the energy of the spin cancels the zero-point energy of the oscillator \
exactly, because the magnetic moment of a Dirac particle has the gyromagnetic \
factor 2, for the charge of the fermion number and for the isospin charge \
alike. Check AS-10 diagonalizes ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["h", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Del]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "39265381-a62a-4a41-bace-879c35ccbd8f"],
 " at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "2"], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "3"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8a2fe75d-7774-4e67-8b92-6dd6f63a0e1b"],
 ", which for one isospin component is the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"4", "\[Times]", "4"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4c7925ac-3b3f-4b8a-bb48-bad3dd1f9df3"],
 " matrix operator ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       StyleBox["i", "TI"]}], "\[ThinSpace]", 
      StyleBox["d", "TI"], "/", 
      StyleBox["d", "TI"], 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "1"]}], ")"}], "-", 
    SubsuperscriptBox["\[Alpha]", 
     StyleBox["LL",
      FontSlant->"Plain"], "2"], 
    SubsuperscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[UpArrow]"], 
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], "+", 
    SubscriptBox["\[Beta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b7d601d5-dfbe-47e1-a680-f75b5aafdc6e"],
 " (and the same with ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "\[DownArrow]"], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "719b1799-9c01-40ea-8b56-983eaf03aae4"],
 "), in a basis of 120 oscillator states of the frequency ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftBracketingBar]", 
    SubsuperscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[UpArrow]"], "\[RightBracketingBar]"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "795c6b7a-b742-4d2a-b7c8-628290c6fcea"],
 " (or ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftBracketingBar]", 
    SubsuperscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[DownArrow]"], "\[RightBracketingBar]"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bc80c76a-b2d5-4136-8aba-467d66002284"],
 "). The fields are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["F",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", "12"}], 
     StyleBox["F",
      FontSlant->"Plain"]], "\[LongEqual]", "1.2"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "92fcb4cc-1564-46d8-b698-e15c4d9e2f1c"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["F",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", "12"}], "3"], "\[LongEqual]", "1.0"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "da4b078b-60a6-4690-8a92-57869cbd62da"],
 ", so that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[UpArrow]"], "\[LongEqual]", "0.89"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "66e54154-2aff-4ebd-bea6-a242022229cb"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[DownArrow]"], "\[LongEqual]", "0.19"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "85e0385b-db58-4eca-a24f-d32e092ef952"],
 ". In the oscillator basis the position and the momentum are matrices whose \
only entries stand next to the diagonal (the comments of the code state \
them). The exact eigenstates of the level ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["L",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1efaf8f3-4798-4b2a-894b-1d853a3d2d5a"],
 " contain only the oscillator states with the numbers ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["L",
      FontSlant->"Plain"]], "-", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "872cb3bc-0375-4397-bf5f-0079a91a05a3"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["L",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0795f19b-c560-46dc-84fd-8a13f08fb21e"],
 ", so the basis, whose states have the numbers 0 to 119, represents the \
levels 0 to 119 exactly (the level 0 contains only the oscillator state 0). \
It has no state with the number 120: the oscillator state 119 with the \
antiparallel spin has lost its partner, and the truncated matrix has, instead \
of the level 120, two states with the energies ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", 
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "71bf54e1-acfa-434b-8c10-87b224312b4e"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c7cd0a15-165f-4fc4-91a9-180c43ca8c0f"],
 " that live on the oscillator state 119. These two states are artefacts of \
the truncation. The check discards every eigenvector with a weight above ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "8"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "18250e68-89be-4b2e-a72b-ccea235c283f"],
 " on the ten highest oscillator states (the numbers 110 to 119): for each \
isospin component these are the two artefacts and the forty states of the \
levels 110 to 119, which the check does not need. It then compares the \
remaining energies with the formula for the levels 0 to 10, with their \
multiplicities, and requires that no other energy lies below the level 10. \
Figure 6 shows the levels."
}], "Text",ExpressionUUID->"ede896fb-5a52-4d06-a539-19b53489138f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"AS", "-", "10"}], ":", " ", 
     RowBox[{"the", " ", "field", " ", "strengths", " ", "FF_", "12", " ", 
      RowBox[{"(", 
       RowBox[{"fermion", " ", "number"}], ")"}], " ", "and", " ", 
      RowBox[{"Fv", "^", "3"}], "_", "12", " ", 
      RowBox[{"(", 
       RowBox[{"third", " ", "isospin", " ", "direction"}], ")"}]}]}], ";", 
    " ", 
    RowBox[{"120", " ", "oscillator", " ", "states"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"as10FF12", ",", " ", "as10Fv12"}], "}"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"1.2", ",", " ", "1.0"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as10Nosc", " ", "=", " ", "120"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as10Dev", " ", "=", " ", "0."}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as10CountOk", " ", "=", " ", "True"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", "numbers", " ", "of", " ", "discarded", " ", 
      RowBox[{"eigenvectors", ":", " ", "all"}]}], ";", " ", 
     RowBox[{
     "those", " ", "whose", " ", "energy", " ", "is", " ", "that", " ", "of", 
      " ", "a", " ", "Landau", " ", "level", " ", "110", " ", "to", " ", 
      "119"}], ";", " ", 
     RowBox[{
      RowBox[{"those", " ", "with", " ", "the", "\n", "   ", "energy"}], " ", 
      "+", 
      RowBox[{"m", " ", "or"}], " ", "-", 
      RowBox[{"m", " ", 
       RowBox[{"(", 
        RowBox[{
        "the", " ", "artefacts", " ", "of", " ", "the", " ", "truncation"}], 
        ")"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "as10Discarded", ",", " ", "as10DiscardedLevels", ",", " ", 
       "as10DiscardedAtMass"}], "}"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"the", " ", "rows", " ", 
       RowBox[{"{", 
        RowBox[{
        "Q_LL", ",", " ", "n_L", ",", " ", "E_qp", ",", " ", "source"}], 
        "}"}], " ", "of", " ", "Figure", " ", "6"}], ";", " ", 
      RowBox[{
       RowBox[{"source", " ", "1"}], ":", " ", 
       RowBox[{"the", " ", "diagonalization"}]}]}], ",", " ", 
     RowBox[{"0", ":", " ", 
      RowBox[{"the", " ", "formula"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"as10LandauRows", " ", "=", " ", 
     RowBox[{"{", "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"field", " ", "=", " ", 
           RowBox[{
            RowBox[{"gf", " ", "as10FF12"}], " ", "+", " ", 
            RowBox[{"qq", " ", "gv", " ", "as10Fv12"}]}]}], ",", " ", 
          "fieldAbs", ",", " ", "roots", ",", " ", "xmat", ",", " ", "pmat", ",",
           " ", "hLandau", ",", " ", "ev", ",", " ", "vecs", ",", " ", 
          "weightTop", ",", " ", "kept", ",", " ", "dropped"}], "}"}], ",", 
        "\n", "   ", 
        RowBox[{"(*", " ", 
         RowBox[{"the", " ", "magnetic", " ", "field", " ", "B_up", " ", 
          RowBox[{"(", 
           RowBox[{"qq", " ", "=", " ", 
            RowBox[{
             RowBox[{"+", "1"}], "/", "2"}]}], ")"}], " ", "or", " ", 
          "B_down", " ", 
          RowBox[{"(", 
           RowBox[{"qq", " ", "=", " ", 
            RowBox[{
             RowBox[{"-", "1"}], "/", "2"}]}], ")"}], " ", "that", " ", "the",
           " ", "isospin", " ", "component", " ", "feels"}], " ", "*)"}], 
        "\n", "   ", 
        RowBox[{
         RowBox[{"fieldAbs", " ", "=", " ", 
          RowBox[{"Abs", "[", "field", "]"}]}], ";", "\n", "   ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{
            RowBox[{
            "the", " ", "oscillator", " ", "basis", " ", "of", " ", "the", " ",
              "frequency"}], " ", "|", "B", "|"}], ",", " ", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"states", " ", "0"}], ".."}], "119"}], ":", " ", 
             RowBox[{
             "with", " ", "the", " ", "lowering", " ", "operator", " ", "a", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"entries", " ", "sqrt", 
                 RowBox[{"(", "1", ")"}]}], ",", " ", 
                RowBox[{"sqrt", 
                 RowBox[{"(", "2", ")"}]}], ",", "\n", "      ", "...", ",", 
                " ", 
                RowBox[{"sqrt", 
                 RowBox[{"(", "119", ")"}], " ", "above", " ", "the", " ", 
                 "diagonal"}]}], ")"}], " ", "the", " ", "position", " ", 
              "is", " ", 
              RowBox[{"x", "^", "1"}]}]}], " ", "=", " ", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"a", " ", "+", " ", 
                 RowBox[{"a", "^", "dag"}]}], ")"}], "/", "sqrt"}], 
              RowBox[{"(", 
               RowBox[{"2", "|", "B", "|"}], ")"}], " ", "and", " ", "the", " ",
               "momentum", " ", "is", "\n", "      ", "p_", "1"}], " ", "=", 
             " ", 
             RowBox[{"i", " ", "sqrt", 
              RowBox[{"(", 
               RowBox[{"|", "B", "|", 
                RowBox[{"/", "2"}]}], ")"}], " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"a", "^", "dag"}], " ", "-", " ", "a"}], 
               ")"}]}]}]}]}], " ", "*)"}], "\n", "   ", 
         RowBox[{"roots", " ", "=", " ", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"N", "[", 
            RowBox[{"Range", "[", 
             RowBox[{"as10Nosc", " ", "-", " ", "1"}], "]"}], "]"}], "]"}]}], 
         ";", "\n", "   ", 
         RowBox[{"xmat", " ", "=", " ", 
          RowBox[{
           RowBox[{"DiagonalMatrix", "[", 
            RowBox[{
             RowBox[{"roots", "/", 
              RowBox[{"Sqrt", "[", 
               RowBox[{"2.", " ", "fieldAbs"}], "]"}]}], ",", " ", "1"}], 
            "]"}], " ", "+", " ", 
           RowBox[{"DiagonalMatrix", "[", 
            RowBox[{
             RowBox[{"roots", "/", 
              RowBox[{"Sqrt", "[", 
               RowBox[{"2.", " ", "fieldAbs"}], "]"}]}], ",", " ", 
             RowBox[{"-", "1"}]}], "]"}]}]}], ";", "\n", "   ", 
         RowBox[{"pmat", " ", "=", " ", 
          RowBox[{
           RowBox[{"DiagonalMatrix", "[", 
            RowBox[{
             RowBox[{"I", " ", 
              RowBox[{"Sqrt", "[", 
               RowBox[{"fieldAbs", "/", "2."}], "]"}], " ", "roots"}], ",", 
             " ", 
             RowBox[{"-", "1"}]}], "]"}], " ", "+", " ", 
           RowBox[{"DiagonalMatrix", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "I"}], " ", 
              RowBox[{"Sqrt", "[", 
               RowBox[{"fieldAbs", "/", "2."}], "]"}], " ", "roots"}], ",", 
             " ", "1"}], "]"}]}]}], ";", "\n", "   ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{"h", " ", "=", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"alpha", "^", "1"}], " ", "p_", "1"}], " ", "+", " ", 
             RowBox[{
              RowBox[{"alpha", "^", "2"}], " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "B"}], " ", 
                RowBox[{"x", "^", "1"}]}], ")"}]}], " ", "+", " ", 
             RowBox[{"beta", " ", 
              RowBox[{"m", ":", " ", 
               RowBox[{
               "the", " ", "Dirac", " ", "index", " ", "is", " ", "the", " ", 
                "slower", " ", "one"}]}]}]}]}], ",", " ", 
           RowBox[{
           "the", " ", "oscillator", " ", "number", " ", "the", " ", 
            "faster"}]}], " ", "*)"}], "\n", "   ", 
         RowBox[{"hLandau", " ", "=", " ", 
          RowBox[{
           RowBox[{"KroneckerProduct", "[", 
            RowBox[{
             RowBox[{"t2alpha", "[", "1", "]"}], ",", " ", "pmat"}], "]"}], 
           " ", "+", " ", 
           RowBox[{"KroneckerProduct", "[", 
            RowBox[{
             RowBox[{"t2alpha", "[", "2", "]"}], ",", " ", 
             RowBox[{
              RowBox[{"-", "field"}], " ", "xmat"}]}], "]"}], " ", "+", " ", 
           RowBox[{"mass", " ", 
            RowBox[{"KroneckerProduct", "[", 
             RowBox[{"t2beta", ",", " ", 
              RowBox[{"IdentityMatrix", "[", "as10Nosc", "]"}]}], "]"}]}]}]}],
          ";", "\n", "   ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ev", ",", " ", "vecs"}], "}"}], " ", "=", " ", 
          RowBox[{"t2eigh", "[", "hLandau", "]"}]}], ";", "\n", "   ", 
         RowBox[{"(*", " ", 
          RowBox[{
          "the", " ", "weight", " ", "of", " ", "every", " ", "eigenvector", " ",
            "on", " ", "the", " ", "ten", " ", "highest", " ", "oscillator", " ",
            "states", " ", 
           RowBox[{"(", 
            RowBox[{
            "of", " ", "all", " ", "four", " ", "Dirac", " ", "components"}], 
            ")"}]}], " ", "*)"}], "\n", "   ", 
         RowBox[{"weightTop", " ", "=", " ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Total", "[", 
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{"Flatten", "[", 
                RowBox[{
                 RowBox[{"Partition", "[", 
                  RowBox[{
                   RowBox[{"vecs", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", " ", "col"}], "]"}], "]"}], ",", " ", 
                   "as10Nosc"}], "]"}], "[", 
                 RowBox[{"[", 
                  RowBox[{"All", ",", " ", 
                   RowBox[{
                    RowBox[{"as10Nosc", " ", "-", " ", "9"}], " ", ";;", " ", 
                    "as10Nosc"}]}], "]"}], "]"}], "]"}], "]"}], "^", "2"}], 
             "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"col", ",", " ", 
              RowBox[{"Length", "[", "ev", "]"}]}], "}"}]}], "]"}]}], ";", 
         "\n", "   ", 
         RowBox[{"kept", " ", "=", " ", 
          RowBox[{"Pick", "[", 
           RowBox[{"ev", ",", " ", 
            RowBox[{"Map", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"#", " ", "<", " ", "1.*^-8"}], " ", "&"}], ",", " ", 
              "weightTop"}], "]"}]}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"dropped", " ", "=", " ", 
          RowBox[{"Pick", "[", 
           RowBox[{"ev", ",", " ", 
            RowBox[{"Map", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"!", " ", 
                RowBox[{"(", 
                 RowBox[{"#", " ", "<", " ", "1.*^-8"}], ")"}]}], " ", "&"}], 
              ",", " ", "weightTop"}], "]"}]}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"as10Discarded", " ", "+=", " ", 
          RowBox[{"Length", "[", "dropped", "]"}]}], ";", "\n", "   ", 
         RowBox[{"as10DiscardedLevels", " ", "+=", " ", 
          RowBox[{"Count", "[", 
           RowBox[{"dropped", ",", " ", 
            RowBox[{"energy_", " ", "/;", " ", 
             RowBox[{
              RowBox[{"Min", "[", 
               RowBox[{"Abs", "[", 
                RowBox[{
                 RowBox[{"Abs", "[", "energy", "]"}], " ", "-", " ", 
                 RowBox[{"Table", "[", 
                  RowBox[{
                   RowBox[{"Sqrt", "[", 
                    RowBox[{
                    RowBox[{"mass", " ", "mass"}], " ", "+", " ", 
                    RowBox[{"2.", " ", "level", " ", "fieldAbs"}]}], "]"}], ",",
                    " ", 
                   RowBox[{"{", 
                    RowBox[{"level", ",", " ", 
                    RowBox[{"as10Nosc", " ", "-", " ", "10"}], ",", " ", 
                    RowBox[{"as10Nosc", " ", "-", " ", "1"}]}], "}"}]}], 
                  "]"}]}], "]"}], "]"}], " ", "<", " ", "1.*^-8"}]}]}], 
           "]"}]}], ";", "\n", "   ", 
         RowBox[{"as10DiscardedAtMass", " ", "+=", " ", 
          RowBox[{"Count", "[", 
           RowBox[{"dropped", ",", " ", 
            RowBox[{"energy_", " ", "/;", " ", 
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{
                RowBox[{"Abs", "[", "energy", "]"}], " ", "-", " ", "mass"}], 
               "]"}], " ", "<", " ", "1.*^-8"}]}]}], "]"}]}], ";", "\n", 
         "   ", 
         RowBox[{"Do", "[", "\n", "    ", 
          RowBox[{
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"mine", " ", "=", " ", 
                RowBox[{"Sort", "[", 
                 RowBox[{"Abs", "[", 
                  RowBox[{"Select", "[", 
                   RowBox[{"kept", ",", " ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"#", " ", "sg"}], " ", ">", " ", "0"}], " ", 
                    "&"}]}], "]"}], "]"}], "]"}]}], ",", " ", "expect"}], 
              "}"}], ",", "\n", "     ", 
             RowBox[{"(*", " ", 
              RowBox[{
               RowBox[{"the", " ", "level", " ", "0", " ", "once"}], ",", " ", 
               RowBox[{
               "the", " ", "levels", " ", "1", " ", "to", " ", "10", " ", 
                "twice"}]}], " ", "*)"}], "\n", "     ", 
             RowBox[{
              RowBox[{"expect", " ", "=", " ", 
               RowBox[{"Prepend", "[", 
                RowBox[{
                 RowBox[{"Flatten", "[", 
                  RowBox[{"Table", "[", 
                   RowBox[{
                    RowBox[{"ConstantArray", "[", 
                    RowBox[{
                    RowBox[{"Sqrt", "[", 
                    RowBox[{
                    RowBox[{"mass", " ", "mass"}], " ", "+", " ", 
                    RowBox[{"2.", " ", "level", " ", "fieldAbs"}]}], "]"}], ",",
                     " ", "2"}], "]"}], ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"level", ",", " ", "1", ",", " ", "10"}], "}"}]}],
                    "]"}], "]"}], ",", " ", "mass"}], "]"}]}], ";", "\n", 
              "     ", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Length", "[", "mine", "]"}], " ", "<=", " ", 
                 RowBox[{"Length", "[", "expect", "]"}]}], ",", "\n", 
                "      ", 
                RowBox[{"as10CountOk", " ", "=", " ", "False"}], ",", "\n", 
                "      ", 
                RowBox[{
                 RowBox[{"as10Dev", " ", "=", " ", 
                  RowBox[{"Max", "[", 
                   RowBox[{"as10Dev", ",", " ", 
                    RowBox[{"Max", "[", 
                    RowBox[{"Abs", "[", 
                    RowBox[{
                    RowBox[{"mine", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", " ", ";;", " ", 
                    RowBox[{"Length", "[", "expect", "]"}]}], "]"}], "]"}], 
                    " ", "-", " ", "expect"}], "]"}], "]"}]}], "]"}]}], ";", 
                 "\n", "      ", 
                 RowBox[{"(*", " ", 
                  RowBox[{
                  "the", " ", "next", " ", "kept", " ", "energy", " ", "lies",
                    " ", "above", " ", "the", " ", "level", " ", "10"}], " ", 
                  "*)"}], "\n", "      ", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"mine", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"Length", "[", "expect", "]"}], " ", "+", " ", 
                    "1"}], "]"}], "]"}], " ", "<", " ", 
                    RowBox[{
                    RowBox[{"Last", "[", "expect", "]"}], " ", "+", " ", 
                    "1.*^-9"}]}], ",", " ", 
                   RowBox[{"as10CountOk", " ", "=", " ", "False"}]}], "]"}], ";",
                  "\n", "      ", 
                 RowBox[{"Do", "[", 
                  RowBox[{
                   RowBox[{"AppendTo", "[", 
                    RowBox[{"as10LandauRows", ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"qq", ",", " ", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"i", " ", "==", " ", "1"}], ",", " ", "0", ",", 
                    " ", 
                    RowBox[{"Quotient", "[", 
                    RowBox[{"i", ",", " ", "2"}], "]"}]}], "]"}], ",", " ", 
                    RowBox[{"sg", " ", 
                    RowBox[{"mine", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], ",", " ", "1"}], 
                    "}"}]}], "]"}], ",", " ", 
                   RowBox[{"{", 
                    RowBox[{"i", ",", " ", 
                    RowBox[{"Length", "[", "expect", "]"}]}], "}"}]}], "]"}], 
                 ";", "\n", "      ", 
                 RowBox[{"Do", "[", 
                  RowBox[{
                   RowBox[{"AppendTo", "[", 
                    RowBox[{"as10LandauRows", ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"qq", ",", " ", "level", ",", " ", 
                    RowBox[{"sg", " ", 
                    RowBox[{"Sqrt", "[", 
                    RowBox[{
                    RowBox[{"mass", " ", "mass"}], " ", "+", " ", 
                    RowBox[{"2.", " ", "level", " ", "fieldAbs"}]}], "]"}]}], 
                    ",", " ", "0"}], "}"}]}], "]"}], ",", " ", 
                   RowBox[{"{", 
                    RowBox[{"level", ",", " ", "0", ",", " ", "10"}], "}"}]}],
                   "]"}]}]}], "]"}]}]}], "]"}], ",", "\n", "    ", 
           RowBox[{"{", 
            RowBox[{"sg", ",", " ", 
             RowBox[{"{", 
              RowBox[{"1.", ",", " ", 
               RowBox[{"-", "1."}]}], "}"}]}], "}"}]}], "]"}]}]}], "]"}], ",",
       "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"qq", ",", " ", 
        RowBox[{"{", 
         RowBox[{"0.5", ",", " ", 
          RowBox[{"-", "0.5"}]}], "}"}]}], "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"as10Bup", ",", " ", "as10Bdown"}], "}"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"gf", " ", "as10FF12"}], " ", "+", " ", 
        RowBox[{"0.5", " ", "gv", " ", "as10Fv12"}]}], ",", " ", 
       RowBox[{
        RowBox[{"gf", " ", "as10FF12"}], " ", "-", " ", 
        RowBox[{"0.5", " ", "gv", " ", "as10Fv12"}]}]}], "}"}]}], ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<AS-10\>\"", ",", 
     " ", "\"\<Landau levels (case D): for one isospin component (Q_LL = +1/2 \
or -1/2) in the constant magnetic fields FF_LL_12 = 1.2 of U(1)_F and \
Fv_LL^3_12 = 1.0 of the third isospin direction (Landau gauge AF_LL_2 = \
FF_LL_12 x_LL^1, Av_LL^3_2 = Fv_LL^3_12 x_LL^1; g_v = 0.7, g_F = 0.45), the \
component feels the magnetic field B_up = g_F FF_LL_12 + g_v Fv_LL^3_12/2 or \
B_down = g_F FF_LL_12 - g_v Fv_LL^3_12/2; the Dirac Hamiltonian alpha_LL^1 \
p_1 + alpha_LL^2 (p_2 - B_up x_LL^1) + beta_LL m at p_2 = p_3 = 0 (and the \
same with B_down), with the momentum operators p_j = -i d_j, diagonalized in \
a basis of 120 oscillator states of the frequency |B_up| (or |B_down|) (the \
states with a weight above 1e-8 on the ten highest oscillator states are \
discarded: for each isospin component they are the 40 states of the levels \
110 to 119, which the check does not use, and the two artefacts of the \
truncation, which have the energies +m and -m and live on the highest \
oscillator state), has the energies +m and -m once each and +-(m^2 + 2 n_L \
|B_up|)^(1/2) (or with |B_down|) twice each for n_L = 1 to 10, and no other \
energy below the level 10 (m = 0.4; tolerance 1e-10)\>\"", ",", "\n", "  ", 
     RowBox[{
      RowBox[{"as10Dev", " ", "<", " ", "1*^-10"}], " ", "&&", " ", 
      "as10CountOk", " ", "&&", " ", 
      RowBox[{"as10Discarded", " ", "==", " ", "84"}], " ", "&&", " ", 
      RowBox[{"as10DiscardedLevels", " ", "==", " ", "80"}], " ", "&&", " ", 
      RowBox[{"as10DiscardedAtMass", " ", "==", " ", "4"}]}], ",", "\n", "  ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<largest deviation \>\"", ",", " ", 
        RowBox[{"asSci", "[", "as10Dev", "]"}], ",", " ", "\"\<; B_up = \>\"",
         ",", " ", 
        RowBox[{"asFix", "[", 
         RowBox[{"as10Bup", ",", " ", "3"}], "]"}], ",", 
        " ", "\"\<, B_down = \>\"", ",", " ", 
        RowBox[{"asFix", "[", 
         RowBox[{"as10Bdown", ",", " ", "3"}], "]"}], ",", " ", "\"\<; \>\"", 
        ",", " ", "as10Discarded", ",", 
        " ", "\"\< discarded states, of them \>\"", ",", " ", 
        "as10DiscardedLevels", ",", "\n", 
        "    ", "\"\< at the levels 110 to 119 and \>\"", ",", " ", 
        "as10DiscardedAtMass", ",", 
        " ", "\"\< artefacts at +-m (original: 1.2e-14; B_up = 0.890, B_down \
= 0.190; 84 discarded states, of them 80 at the levels 110 to 119 and 4 \
artefacts at +-m)\>\""}], "}"}], "]"}]}], "]"}]}]}]], "Input",ExpressionUUID->\
"7e1457b0-fd1b-4eab-a09b-e0d20775642d"],

Cell["The data files of the original program", "Subsection",ExpressionUUID->"b6008781-7b3b-40fc-b52d-32249846b26f"],

Cell[TextData[{
 "The original program t2_analytic wrote the numbers of its figures into \
eleven data files. The next cell contains every number of these files, copied \
without change of a digit. It is a closed cell: the notebook evaluates it \
like every other cell, but shows only its thin cell bracket, and a printed \
copy of the notebook leaves it out, so that the notebook stays complete \
without many pages of numbers. To read the numbers, select the bracket of the \
cell and choose Cell > Cell Properties > Open. Its output, the next cell that \
is shown, is the list of the numbers of rows of the eleven lists. Two changes \
of form were made in the copy: a number with an exponent is written in the \
notation of the Wolfram Language, and a column of words is coded by numbers \
(the branch positive or negative of the curves of case A as ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4b5434d9-ad4c-4e04-8927-319fd937354c"],
 " or ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "af9ddae7-da56-4b60-9a66-336b4088930c"],
 "; the source of a value as 0 for a closed form or a formula and 1 for a \
quadrature or a numerical diagonalization)."
}], "Text",ExpressionUUID->"63f77e44-809a-40bb-9fbb-a02a6d1ce039"],

Cell[TextData[{
 "The eleven lists, with their files and columns: ",
 StyleBox["t2origACurves",
  FontFamily->"Source Code Pro"],
 " (t2_A_dispersion_curves.csv: momentum, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["Q", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c601f3f0-fe7c-4953-adc6-850b5472664f"],
 ", branch, energy; the curves of Figure 3(a)); ",
 StyleBox["t2origALattice",
  FontFamily->"Source Code Pro"],
 " (t2_A_dispersion_lattice.csv: momentum, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["Q", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
