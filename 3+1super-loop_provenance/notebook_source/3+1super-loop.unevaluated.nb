               RowBox[{"rhs", " ", "=", " ", 
                RowBox[{"curv", " ", ".", " ", "psi"}]}], ";", "\n", "     ", 
               
               RowBox[{"worst6", " ", "=", " ", 
                RowBox[{"Max", "[", 
                 RowBox[{"worst6", ",", " ", 
                  RowBox[{
                   RowBox[{"Norm", "[", 
                    RowBox[{"lhs", " ", "-", " ", "rhs"}], "]"}], "/", 
                   RowBox[{"(", 
                    RowBox[{"1", " ", "+", " ", 
                    RowBox[{"Norm", "[", "rhs", "]"}]}], ")"}]}]}], 
                 "]"}]}]}]}], "]"}]}], ",", "\n", "    ", 
           RowBox[{"{", 
            RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"q", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}]}], 
       "]"}], ",", "\n", "  ", 
      RowBox[{"{", "20", "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<GS-6\>\"", ",", 
     " ", "\"\<the commutator of two covariant derivatives is the curvature \
of the gauge group: [nabla_p, nabla_q] Psi = (Rc_pq - i g_v Fv^iota_pq T^iota \
- i g_F FF_pq) Psi (20 random points, all 12 ordered pairs; central \
differences with the step 1e-4; relative tolerance 1e-6)\>\"", ",", "\n", 
     "  ", 
     RowBox[{"worst6", " ", "<", " ", "1*^-6"}], ",", " ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<largest relative deviation \>\"", ",", " ", "worst6", ",",
         " ", "\"\< (original: 2.1e-9)\>\""}], "}"}], "]"}]}], 
    "]"}]}]}]], "Input",ExpressionUUID->"a26db62a-2a62-41a2-82c6-\
e244c3d8acb7"],

Cell["\<\
GS-7 to GS-9: the super-loop form of the Dirac operator and the \
Dirac-Bogoliubov-de Gennes equations\
\>", "Subsection",ExpressionUUID->"736ca60e-a5e3-4352-b711-cbbf81daeee8"],

