Cell[TextData[{
 "The library module sym.rs is a small symbolic algebra: linear combinations \
of monomials (TeX strings) with exact coefficients ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     StyleBox["a", "TI"], "+", 
     StyleBox["b", "TI"], 
     StyleBox["i", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "dcb35a2a-f7d9-4956-9e4f-291d26bb822a"]], "InlineFormula",ExpressionUUID->
  "e5c996f9-6152-4003-bd33-03d11468ad1d"],
 " (",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     StyleBox["a", "TI"], ",", 
     StyleBox["b", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "4bfc5407-7790-4b80-b4a2-8aa4c33c9418"]], "InlineFormula",ExpressionUUID->
  "ef8fd6de-9670-4468-80df-1e196484dbfc"],
 " rational), used by the programs to print the matrices and the component \
equations in TeX and to evaluate every printed formula numerically. The \
Wolfram Language is itself a symbolic algebra with exact Gaussian rationals, \
so this module needs no rewriting: in check GS-12 below the same formulas are \
built from symbols and evaluated in the same way. For example, the TeX of ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[Sigma]", "2", "LL"], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"fa004311-63f2-449a-9208-64b91c228b23"]], 
  "InlineFormula",ExpressionUUID->"bab5419b-9235-4d09-8c14-19962a963055"],
 " written by ",
 StyleBox["TeXForm",
  FontFamily->"Source Code Pro"],
 ":"
}], "Text",ExpressionUUID->"bdbc7e8c-3644-49a0-b094-e397e3f2ae8d"],

Cell[BoxData[
 RowBox[{"ToString", "[", 
  RowBox[{"TeXForm", "[", 
   RowBox[{"MatrixForm", "[", 
    RowBox[{"t2sigma", "[", "2", "]"}], "]"}], "]"}], "]"}]], "Input",Expressi\
onUUID->"c112a36b-0620-42d1-a855-4f786ee2b93d"],

Cell["\<\
II.2 Item [1]: the field equations on the 3+1 manifold, and the checks GS-1 \
to GS-16 (program t2_fields)\
\>", "Section",ExpressionUUID->"d72b1774-6679-47ab-bfc8-71502f03fe36"],

Cell[TextData[{
 "The program t2_fields (t2fields/src/main.rs) builds every matrix of the \
field equations of the self-interacting spinor field ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubscriptBox["\[CapitalPsi]", "LL"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"cac30c28-227f-4363-8935-0db97cab0136"]], "InlineFormula",
  ExpressionUUID->"0ee8dd1b-b0f3-4dde-801d-9e67e94d15ea"],
 " on ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["\[DoubleStruckCapitalR]",
      FontSlant->"Plain"], "LL", 
     RowBox[{"1", ",", "3"}]], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"b53e87c4-c5ae-471c-a2b6-85a89688e16c"]], "InlineFormula",
  ExpressionUUID->"6002c412-1633-481b-a053-44f82617ffe4"],
 " and checks every statement made about them: checks GS-1 to GS-16. The \
rewriting below keeps the order of the original program, because the random \
numbers are drawn in that order from one generator with the seed 2026111707. \
Every check prints one line with PASS or FAIL; the statement is that of the \
original report, and the numbers in the details are the Wolfram Language \
results, followed (where the original report gives them) by the values of the \
original report."
}], "Text",ExpressionUUID->"a8b7afc8-835b-4577-aae9-6a9461156469"],

Cell[TextData[{
 "The physics in brief. The covariant derivative is ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubsuperscriptBox["\[Del]", 
      StyleBox["p", "TI"], "LL"], "\[LongEqual]", 
     SubscriptBox["\[PartialD]", 
      StyleBox["p", "TI"]], "+", 
     SubsuperscriptBox["\[CapitalGamma]", 
      StyleBox["p", "TI"], "LL"], "-", 
     StyleBox["i", "TI"], 
     SubscriptBox[
      StyleBox["A",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      RowBox[{"LL", ",", 
       StyleBox["p", "TI"]}]]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"19fd1ab5-dc0b-4013-99e6-3de07c1cd5b6"]], "InlineFormula",
  ExpressionUUID->"35b8dfcd-e79e-4a2c-ac40-6c17f140e5c8"],
 ", with the spin connection ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubsuperscriptBox["\[CapitalGamma]", 
      StyleBox["p", "TI"], "LL"], "\[LongEqual]", 
     SubscriptBox[
      StyleBox["s",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "LL"], 
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["u",
        FontWeight->"Bold",
        FontSlant->"Plain"], 
       RowBox[{"LL", ",", 
        StyleBox["p", "TI"]}], "\[Omega]"], ")"}], "\[CircleTimes]", 
     SubsuperscriptBox["\[Sigma]", "0", "LL"]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"d811eb77-4f54-4130-9e40-322f567ab569"]], 
  "InlineFormula",ExpressionUUID->"c8f526a1-a603-4d6b-8de6-f34db03f9bdb"],
 " (the Lorentz connection ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubsuperscriptBox[
      StyleBox["u",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      RowBox[{"LL", ",", 
       StyleBox["p", "TI"]}], "\[Omega]"], "\[LongEqual]", 
     UnderscriptBox["\[Sum]", 
      StyleBox["j", "TI"],
      LimitsPositioning->True], 
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox["\[Omega]", 
        RowBox[{"LL", ",", 
         StyleBox["p", "TI"]}], 
        StyleBox["j", "TI"]], 
       SubsuperscriptBox[
        StyleBox["J", "TI"], "LL", 
        StyleBox["j", "TI"]], "+", 
       SubsuperscriptBox["\[CurlyPi]", 
        RowBox[{"LL", ",", 
         StyleBox["p", "TI"]}], 
        StyleBox["j", "TI"]], 
       SubsuperscriptBox[
        StyleBox["K", "TI"], "LL", 
        StyleBox["j", "TI"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"78290960-8b1a-4810-be11-c05d9a0d0fff"]], "InlineFormula",
  ExpressionUUID->"5167ad25-0dbd-426f-a852-ecb02cb070f3"],
 ", an element of the Lorentz algebra of the super-loop, acting on the Dirac \
index) and the gauge matrix ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["A",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      RowBox[{"LL", ",", 
       StyleBox["p", "TI"]}]], "\[LongEqual]", 
     SubsuperscriptBox[
      StyleBox["g", "TI"], "LL", "v"], 
     UnderscriptBox["\[Sum]", "\[Iota]",
      LimitsPositioning->True], 
     SubsuperscriptBox[
      StyleBox["A", "TI"], 
      RowBox[{"LL", ",", 
       StyleBox["p", "TI"]}], "\[Iota]"], 
     SubsuperscriptBox[
      StyleBox["T", "TI"], "LL", "\[Iota]"], "+", 
     SubsuperscriptBox[
      StyleBox["g", "TI"], "LL", "F"], 
     SubsuperscriptBox[
      StyleBox["A", "TI"], 
      RowBox[{"LL", ",", 
       StyleBox["p", "TI"]}], "F"], 
     SubscriptBox[
      StyleBox["1",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "8"]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"3a218bcc-673a-45d9-8ae9-42cd0499d04b"]], "InlineFormula",
  ExpressionUUID->"e765539c-3445-42f9-9453-e938bb403a55"],
 " of the isospin group and of the fermion number. The mean-field \
(Dirac-Bogoliubov-de Gennes) equations couple the particle part ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[Psi]", "LL", "p"], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"5b4881bf-f974-40b7-9f77-61204e023d91"]], 
  "InlineFormula",ExpressionUUID->"cb5a7933-92f6-45c8-8010-8ea102c12ba2"],
 " and the hole part ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[Psi]", "LL", "h"], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"7f90625c-81c8-4f53-847f-9ef0b9b87e1e"]], 
  "InlineFormula",ExpressionUUID->"6f2321bc-ea18-4cc6-a9e1-6cdf2d7fa999"],
 " of a mode through the pairing block ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["P",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "LL"], "\[LongEqual]", 
     UnderscriptBox["\[Sum]", "\[Iota]",
      LimitsPositioning->True], 
     SubsuperscriptBox[
      StyleBox["d", "TI"], "LL", "\[Iota]"], 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["K",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], "LL", "\[Iota]"], ")"}], "\[Dagger]"]}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "357137d3-aa35-4d50-ae51-297ee5185527"]], "InlineFormula",ExpressionUUID->
  "f5398a1e-de66-4bbd-b0f9-47a9c4089787"],
 ", where ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["d", "TI"], "\[RightVector]"], "LL"], "\[LongEqual]", 
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["d", "TI"], "LL", "1"], ",", 
       SubsuperscriptBox[
        StyleBox["d", "TI"], "LL", "2"], ",", 
       SubsuperscriptBox[
        StyleBox["d", "TI"], "LL", "3"]}], ")"}]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"61c34bbb-9b9a-4e6b-a4ec-d8614cb6e5c7"]], 
  "InlineFormula",ExpressionUUID->"f89afb4c-aa22-4c76-835d-aa19c5682c0e"],
 " is the order parameter."
}], "Text",ExpressionUUID->"6abfd897-1dd2-469c-ac0e-9f3bea71a5bd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "the", " ", "seed", " ", "of", " ", "the", " ", "program", " ", 
    "t2_fields", " ", "and", " ", "the", " ", "tolerance", " ", "of", " ", 
    "the", " ", "exact", " ", "relations"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"t2Seed", "[", "2026111707", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"tol", " ", "=", " ", "1*^-12"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", "Frobenius", " ", "norm"}], ",", " ", 
     RowBox[{
     "the", " ", "name", " ", "used", " ", "in", " ", "the", " ", "Rust", " ",
       "code"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"fro", "[", "m_", "]"}], " ", ":=", " ", 
     RowBox[{"Norm", "[", 
      RowBox[{"m", ",", " ", "\"\<Frobenius\>\""}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "the", " ", "four", " ", "Dirac", " ", "matrices", " ", "of", " ", "the", 
     " ", "canonical", " ", "frame"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"t2gamma", "[", "p", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], 
    ";"}]}]}]], "Input",ExpressionUUID->"c6ce3255-addb-4ba9-bc12-\
1239625143fe"],

Cell["GS-1 and GS-2: the Dirac matrices and the Lorentz generators", \
"Subsection",ExpressionUUID->"1edec04c-0614-456c-ba94-33b804022428"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"GS", "-", "1"}], ":", " ", 
      RowBox[{"Clifford", " ", "relations", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"gamma", "^", "p"}], ",", " ", 
         RowBox[{"gamma", "^", "q"}]}], "}"}]}]}], " ", "=", " ", 
     RowBox[{"2", " ", 
      RowBox[{"eta", "^", "pq"}], " ", "1", "_", "4"}]}], ",", " ", 
    RowBox[{"and", " ", "the", " ", "forms", " ", "of", " ", "gamma_ch"}], ",",
     " ", "C", ",", " ", 
    RowBox[{"alpha", "^", "j"}], ",", " ", 
    RowBox[{"the", " ", "frame", " ", "and", " ", "eps2"}]}], " ", "*)"}], 
  "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"cliff", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"fro", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"g", "[", 
            RowBox[{"[", 
             RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}], " ", ".", " ", 
           RowBox[{"g", "[", 
            RowBox[{"[", 
             RowBox[{"q", " ", "+", " ", "1"}], "]"}], "]"}]}], " ", "+", " ", 
          RowBox[{
           RowBox[{"g", "[", 
            RowBox[{"[", 
             RowBox[{"q", " ", "+", " ", "1"}], "]"}], "]"}], " ", ".", " ", 
           RowBox[{"g", "[", 
            RowBox[{"[", 
             RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}]}], " ", "-", " ", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"p", " ", "==", " ", "q"}], ",", " ", 
             RowBox[{"2", " ", 
              RowBox[{"t2eta", "[", "p", "]"}]}], ",", " ", "0"}], "]"}], " ", 
           RowBox[{"IdentityMatrix", "[", "4", "]"}]}]}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"q", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}], "]"}]}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"gchOk", " ", "=", " ", 
     RowBox[{
      RowBox[{"fro", "[", 
       RowBox[{"t2gammaCh", " ", "-", " ", 
        RowBox[{"DiagonalMatrix", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", " ", 
           RowBox[{"-", "1"}], ",", " ", "1", ",", " ", "1"}], "}"}], "]"}]}],
        "]"}], " ", "<", " ", "tol"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"cOk", " ", "=", " ", 
     RowBox[{
      RowBox[{"fro", "[", 
       RowBox[{"t2cconj", " ", "-", " ", 
        RowBox[{"ArrayFlatten", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"t2eps2", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", 
             RowBox[{"-", "t2eps2"}]}], "}"}]}], "}"}], "]"}]}], "]"}], " ", "<",
       " ", "tol"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"alOk", " ", "=", " ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"Range", "[", "3", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"fro", "[", 
          RowBox[{
           RowBox[{"t2alpha", "[", "#", "]"}], " ", "-", " ", 
           RowBox[{"ArrayFlatten", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", 
                 RowBox[{"t2sigma", "[", "#", "]"}]}], ",", " ", "0"}], "}"}],
               ",", " ", 
              RowBox[{"{", 
               RowBox[{"0", ",", " ", 
                RowBox[{"t2sigma", "[", "#", "]"}]}], "}"}]}], "}"}], "]"}]}],
           "]"}], " ", "<", " ", "tol"}], " ", "&"}]}], "]"}]}], ";"}], "\n", 
   
   RowBox[{
    RowBox[{"frameOk", " ", "=", " ", 
     RowBox[{
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", " ", "3"}], "]"}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"fro", "[", 
            RowBox[{
             RowBox[{"t2mq", "[", 
              RowBox[{"t2canonicalFrame", "[", 
               RowBox[{"[", 
                RowBox[{"#", " ", "+", " ", "1"}], "]"}], "]"}], "]"}], " ", "-",
              " ", 
             RowBox[{"t2sigma", "[", "#", "]"}]}], "]"}], " ", "<", " ", 
           "tol"}], " ", "&&", "\n", "      ", 
          RowBox[{
           RowBox[{"fro", "[", 
            RowBox[{
             RowBox[{"t2mq", "[", 
              RowBox[{"t2bqConj", "[", 
               RowBox[{"t2canonicalFrame", "[", 
                RowBox[{"[", 
                 RowBox[{"#", " ", "+", " ", "1"}], "]"}], "]"}], "]"}], 
              "]"}], " ", "-", " ", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"#", " ", "==", " ", "0"}], ",", " ", "1", ",", " ", 
                RowBox[{"-", "1"}]}], "]"}], " ", 
              RowBox[{"t2sigma", "[", "#", "]"}]}]}], "]"}], " ", "<", " ", 
           "tol"}]}], " ", "&"}]}], "]"}], " ", "&&", "\n", "   ", 
      RowBox[{
       RowBox[{"fro", "[", 
        RowBox[{
         RowBox[{"t2mq", "[", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "0", ",", " ", 
            RowBox[{"-", "1"}], ",", " ", "0"}], "}"}], "]"}], " ", "-", " ", 
         "t2eps2"}], "]"}], " ", "<", " ", "tol"}]}]}], ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<GS-1\>\"", ",", 
     " ", "\"\<the Dirac matrices are built from the frame of R^(1,3)_LL; \
Clifford relations; gamma_ch = diag(-1,-1,1,1), C_LL = diag(eps2, -eps2), \
alpha^j = diag(-sigma_j, sigma_j), eps2 = M_LL(-e2)\>\"", ",", "\n", "  ", 
     RowBox[{
      RowBox[{"cliff", " ", "<", " ", "tol"}], " ", "&&", " ", "gchOk", " ", "&&",
       " ", "cOk", " ", "&&", " ", "alOk", " ", "&&", " ", "frameOk"}], ",", 
     " ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<largest deviation of the Clifford relations \>\"", ",", 
        " ", "cliff", ",", " ", "\"\< (original: 0.0e0)\>\""}], "}"}], 
      "]"}]}], "]"}]}]}]], "Input",ExpressionUUID->"f85a7327-c782-4744-afbf-\
7db5b2e9f62e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"GS", "-", "2"}], ":", " ", 
     RowBox[{"the", " ", "Lorentz", " ", "generators", " ", "sgen", 
      RowBox[{"(", 
       RowBox[{"J", "^", "j"}], ")"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"sgen", 
      RowBox[{"(", 
       RowBox[{"K", "^", "j"}], ")"}]}], ";", " ", 
     RowBox[{"the", " ", "27", " ", "relations", " ", "of", " ", "so", 
      RowBox[{"(", 
       RowBox[{"3", ",", "1"}], ")"}]}], ";", " ", 
     RowBox[{"the", " ", "24", " ", "intertwining", " ", "relations"}]}]}], 
   " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"sj", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"t2spinGen", "[", 
        RowBox[{"t2jgen", "[", "j", "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sk", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"t2spinGen", "[", 
        RowBox[{"t2kgen", "[", "j", "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"comm", "[", 
      RowBox[{"a_", ",", " ", "b_"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"a", " ", ".", " ", "b"}], " ", "-", " ", 
      RowBox[{"b", " ", ".", " ", "a"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"genOk", " ", "=", " ", 
     RowBox[{"And", " ", "@@", " ", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"k", " ", "=", " ", 
              RowBox[{
               RowBox[{"Mod", "[", 
                RowBox[{"j", ",", " ", "3"}], "]"}], " ", "+", " ", "1"}]}], ",",
              " ", 
             RowBox[{"l", " ", "=", " ", 
              RowBox[{
               RowBox[{"Mod", "[", 
                RowBox[{
                 RowBox[{"j", " ", "+", " ", "1"}], ",", " ", "3"}], "]"}], 
               " ", "+", " ", "1"}]}]}], "}"}], ",", "\n", "      ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"fro", "[", 
               RowBox[{
                RowBox[{"sj", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], " ", "-", " ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"g", "[", 
                   RowBox[{"[", 
                    RowBox[{"k", " ", "+", " ", "1"}], "]"}], "]"}], " ", ".",
                   " ", 
                  RowBox[{"g", "[", 
                   RowBox[{"[", 
                    RowBox[{"l", " ", "+", " ", "1"}], "]"}], "]"}]}], "/", 
                 "2"}]}], "]"}], " ", "<", " ", "tol"}], ",", " ", 
             RowBox[{
              RowBox[{"fro", "[", 
               RowBox[{
                RowBox[{"sk", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], " ", "-", " ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"g", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], " ", ".", " ", 
                  RowBox[{"g", "[", 
                   RowBox[{"[", 
                    RowBox[{"j", " ", "+", " ", "1"}], "]"}], "]"}]}], "/", 
                 "2"}]}], "]"}], " ", "<", " ", "tol"}], ",", "\n", "       ", 
             RowBox[{
              RowBox[{"fro", "[", 
               RowBox[{
                RowBox[{"sj", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], " ", "-", " ", 
                RowBox[{"ArrayFlatten", "[", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"-", "I"}], "/", "2"}], " ", 
                    RowBox[{"t2sigma", "[", "j", "]"}]}], ",", " ", "0"}], 
                    "}"}], ",", " ", 
                   RowBox[{"{", 
                    RowBox[{"0", ",", " ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"-", "I"}], "/", "2"}], " ", 
                    RowBox[{"t2sigma", "[", "j", "]"}]}]}], "}"}]}], "}"}], 
                 "]"}]}], "]"}], " ", "<", " ", "tol"}], ",", "\n", "       ", 
             RowBox[{
              RowBox[{"fro", "[", 
               RowBox[{
                RowBox[{"sk", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], " ", "-", " ", 
                RowBox[{"ArrayFlatten", "[", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"-", "1"}], "/", "2"}], " ", 
                    RowBox[{"t2sigma", "[", "j", "]"}]}], ",", " ", "0"}], 
                    "}"}], ",", " ", 
                   RowBox[{"{", 
                    RowBox[{"0", ",", " ", 
                    RowBox[{
                    RowBox[{"1", "/", "2"}], " ", 
                    RowBox[{"t2sigma", "[", "j", "]"}]}]}], "}"}]}], "}"}], 
                 "]"}]}], "]"}], " ", "<", " ", "tol"}]}], "}"}]}], "]"}], ",",
          " ", 
         RowBox[{"{", 
          RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rel", " ", "=", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"lj", " ", "=", " ", 
             RowBox[{"Sum", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"t2eps3", "[", 
                 RowBox[{"a", ",", " ", "b", ",", " ", "c"}], "]"}], " ", 
                RowBox[{"sj", "[", 
                 RowBox[{"[", "c", "]"}], "]"}]}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"c", ",", " ", "3"}], "}"}]}], "]"}]}], ",", " ", 
            RowBox[{"lk", " ", "=", " ", 
             RowBox[{"Sum", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"t2eps3", "[", 
                 RowBox[{"a", ",", " ", "b", ",", " ", "c"}], "]"}], " ", 
                RowBox[{"sk", "[", 
                 RowBox[{"[", "c", "]"}], "]"}]}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"c", ",", " ", "3"}], "}"}]}], "]"}]}]}], "}"}], ",", 
          "\n", "      ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"fro", "[", 
              RowBox[{
               RowBox[{"comm", "[", 
                RowBox[{
                 RowBox[{"sj", "[", 
                  RowBox[{"[", "a", "]"}], "]"}], ",", " ", 
                 RowBox[{"sj", "[", 
                  RowBox[{"[", "b", "]"}], "]"}]}], "]"}], " ", "-", " ", 
               "lj"}], "]"}], " ", "<", " ", "tol"}], ",", " ", 
            RowBox[{
             RowBox[{"fro", "[", 
              RowBox[{
               RowBox[{"comm", "[", 
                RowBox[{
                 RowBox[{"sj", "[", 
                  RowBox[{"[", "a", "]"}], "]"}], ",", " ", 
                 RowBox[{"sk", "[", 
                  RowBox[{"[", "b", "]"}], "]"}]}], "]"}], " ", "-", " ", 
               "lk"}], "]"}], " ", "<", " ", "tol"}], ",", " ", 
            RowBox[{
             RowBox[{"fro", "[", 
              RowBox[{
               RowBox[{"comm", "[", 
                RowBox[{
                 RowBox[{"sk", "[", 
                  RowBox[{"[", "a", "]"}], "]"}], ",", " ", 
                 RowBox[{"sk", "[", 
                  RowBox[{"[", "b", "]"}], "]"}]}], "]"}], " ", "+", " ", 
               "lj"}], "]"}], " ", "<", " ", "tol"}]}], "}"}]}], "]"}], ",", 
        " ", 
        RowBox[{"{", 
         RowBox[{"a", ",", " ", "3"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"b", ",", " ", "3"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"intertw", " ", "=", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"s", " ", "=", " ", 
             RowBox[{"t2spinGen", "[", "u", "]"}]}], ",", " ", 
            RowBox[{"v", " ", "=", " ", 
             RowBox[{"t2vecAction", "[", "u", "]"}]}]}], "}"}], ",", "\n", 
          "      ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"fro", "[", 
              RowBox[{
               RowBox[{"comm", "[", 
                RowBox[{
                 RowBox[{"g", "[", 
                  RowBox[{"[", 
                   RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}], ",", " ", 
                 "s"}], "]"}], " ", "-", " ", 
               RowBox[{"Sum", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"v", "[", 
                   RowBox[{"[", 
                    RowBox[{
                    RowBox[{"p", " ", "+", " ", "1"}], ",", " ", 
                    RowBox[{"q", " ", "+", " ", "1"}]}], "]"}], "]"}], " ", 
                  RowBox[{"g", "[", 
                   RowBox[{"[", 
                    RowBox[{"q", " ", "+", " ", "1"}], "]"}], "]"}]}], ",", 
                 " ", 
                 RowBox[{"{", 
                  RowBox[{"q", ",", " ", "0", ",", " ", "3"}], "}"}]}], 
                "]"}]}], "]"}], " ", "<", " ", "tol"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], 
         "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"j", ",", " ", "3"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"u", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"t2jgen", "[", "j", "]"}], ",", " ", 
            RowBox[{"t2kgen", "[", "j", "]"}]}], "}"}]}], "}"}]}], "]"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<GS-2\>\"", ",", 
     " ", "\"\<the Lorentz generators of the super-loop on the Dirac spinor, \
sgen(J^j) = diag(-i sigma_j/2, -i sigma_j/2) = gamma^j' gamma^j''/2, \
sgen(K^j) = diag(-sigma_j/2, sigma_j/2) = gamma^0 gamma^j/2; the 27 relations \
of so(3,1); 24 intertwining relations [gamma^p, sgen(u)] = sum V(u)[p][q] \
gamma^q\>\"", ",", "\n", "  ", 
     RowBox[{"genOk", " ", "&&", " ", 
      RowBox[{"(", 
       RowBox[{"And", " ", "@@", " ", "rel"}], ")"}], " ", "&&", " ", 
      RowBox[{"(", 
       RowBox[{"And", " ", "@@", " ", "intertw"}], ")"}]}], ",", " ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Length", "[", "rel", "]"}], ",", 
        " ", "\"\< commutation relations, \>\"", ",", " ", 
        RowBox[{"Length", "[", "intertw", "]"}], ",", 
        " ", "\"\< intertwining relations (original: 27 and 24)\>\""}], "}"}],
       "]"}]}], "]"}]}]}]], "Input",ExpressionUUID->"30dd32d8-6da7-4987-a628-\
dd845d676f0e"],

Cell["\<\
GS-3 and GS-4: finite transformations, isospin and the pair matrices\
\>", "Subsection",ExpressionUUID->"db294f3d-bac7-478a-9fbb-740c1d73dc9b"],

Cell[TextData[{
 "GS-3 is the change of representation of the gauge group ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     StyleBox["S", "TI"], 
     StyleBox["L", "TI"], 
     RowBox[{"(", 
      RowBox[{"2", ",", 
       StyleBox["\[DoubleStruckCapitalC]",
        FontSlant->"Plain"]}], ")"}]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"07812e01-4f7c-4ed7-9209-52ed17b5cb61"]], "InlineFormula",
  ExpressionUUID->"9b974515-9e6f-45a0-b5c6-707b8c23733c"],
 ": for a unit bi-quaternion ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    StyleBox["g",
     FontWeight->"Bold",
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "7a331e05-433f-40a8-a62e-003a832a338c"]], "InlineFormula",ExpressionUUID->
  "fcb5ad60-2783-4722-ac26-a01159ed8322"],
 " the spinor matrix ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["S",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "LL"], 
     RowBox[{"(", 
      StyleBox["g",
       FontWeight->"Bold",
       FontSlant->"Plain"], ")"}], "\[LongEqual]", 
     StyleBox["diag",
      FontSlant->"Plain"], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["M", "TI"], "LL"], 
       RowBox[{"(", 
        OverscriptBox[
         StyleBox["g",
          FontWeight->"Bold",
          FontSlant->"Plain"], "~"], ")"}], ",", 
       SubscriptBox[
        StyleBox["M", "TI"], "LL"], 
       RowBox[{"(", 
        StyleBox["g",
         FontWeight->"Bold",
         FontSlant->"Plain"], ")"}]}], ")"}]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"31bf7a5b-17dd-4f01-8018-dd37ff8287e1"]], 
  "InlineFormula",ExpressionUUID->"b99c62c5-e442-448e-83d6-46f22ed2090f"],
 ", with ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     OverscriptBox[
      StyleBox["g",
       FontWeight->"Bold",
       FontSlant->"Plain"], "~"], "\[LongEqual]", 
     SuperscriptBox[
      RowBox[{"(", 
       SuperscriptBox[
        StyleBox["g",
         FontWeight->"Bold",
         FontSlant->"Plain"], "\[Dagger]"], ")"}], 
      RowBox[{"-", "1"}]]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"b3b9a6aa-60e1-4b1a-aeae-9734eb85b3f8"]], "InlineFormula",
  ExpressionUUID->"27fcb23f-5716-43bc-89ec-79a4d75e8149"],
 " and so ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["M", "TI"], "LL"], 
     RowBox[{"(", 
      OverscriptBox[
       StyleBox["g",
        FontWeight->"Bold",
        FontSlant->"Plain"], "~"], ")"}], "\[LongEqual]", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubscriptBox[
         StyleBox["M", "TI"], "LL"], 
        SuperscriptBox[
         RowBox[{"(", 
          StyleBox["g",
           FontWeight->"Bold",
           FontSlant->"Plain"], ")"}], "\[Dagger]"]}], ")"}], 
      RowBox[{"-", "1"}]]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"1b5a0d7b-8dbc-453c-bdff-b12951c23cce"]], "InlineFormula",
  ExpressionUUID->"1e14816a-b0ed-4ed9-8d1c-602629ab9283"],
 ", satisfies ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["S",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "LL"], 
     SuperscriptBox[
      RowBox[{"(", 
       StyleBox["g",
        FontWeight->"Bold",
        FontSlant->"Plain"], ")"}], 
      RowBox[{"-", "1"}]], 
     SubsuperscriptBox["\[Gamma]", "LL", 
      StyleBox["p", "TI"]], 
     SubscriptBox[
      StyleBox["S",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "LL"], 
     RowBox[{"(", 
      StyleBox["g",
       FontWeight->"Bold",
       FontSlant->"Plain"], ")"}], "\[LongEqual]", 
     UnderscriptBox["\[Sum]", 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"],
      LimitsPositioning->True], 
     SubscriptBox[
      RowBox[{"[", 
       RowBox[{
        SubscriptBox[
         StyleBox["L",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], "LL"], "(", 
        StyleBox["g",
         FontWeight->"Bold",
         FontSlant->"Plain"], ")"}], "]"}], 
      RowBox[{
       StyleBox["p", "TI"], 
       SuperscriptBox[
        StyleBox["p", "TI"], "\[Prime]"]}]], 
     SubsuperscriptBox["\[Gamma]", "LL", 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"7622903b-fdd7-4016-ac06-b3f0a1239f94"]], 
  "InlineFormula",ExpressionUUID->"cca19173-1279-4dd3-b9f0-e5fbf1218051"],
 " with the real Lorentz matrix ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    FractionBox[
     RowBox[{
      SubscriptBox[
       RowBox[{"[", 
        RowBox[{
         SubscriptBox[
          StyleBox["L",
           FontFamily->"Helvetica",
           FontSlant->"Plain"], "LL"], "(", 
         StyleBox["g",
          FontWeight->"Bold",
          FontSlant->"Plain"], ")"}], "]"}], 
       RowBox[{
        StyleBox["p", "TI"], 
        SuperscriptBox[
         StyleBox["p", "TI"], "\[Prime]"]}]], "\[LongEqual]", "1"}], 
     RowBox[{"2", "Re", " ", "tr", 
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox["\[Sigma]", 
         StyleBox["p", "TI"], "LL"], 
        SubscriptBox[
         StyleBox["M", "TI"], "LL"], 
        RowBox[{"(", 
         StyleBox["g",
          FontWeight->"Bold",
          FontSlant->"Plain"], ")"}], 
        SubsuperscriptBox["\[Sigma]", 
         SuperscriptBox[
          StyleBox["p", "TI"], "\[Prime]"], "LL"], 
        SubscriptBox[
         StyleBox["M", "TI"], "LL"], 
        SuperscriptBox[
         RowBox[{"(", 
          StyleBox["g",
           FontWeight->"Bold",
           FontSlant->"Plain"], ")"}], "\[Dagger]"]}], ")"}]}]], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "4824a8ec-628c-46da-8d00-0178dafc00fe"]], "InlineFormula",ExpressionUUID->
  "4c698d1e-8062-4bc1-ac42-ae2de927dc35"],
 ", and ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["S",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "LL"], 
     RowBox[{"(", 
      StyleBox["g",
       FontWeight->"Bold",
       FontSlant->"Plain"], ")"}], 
     SubsuperscriptBox["\[Gamma]", "LL", 
      StyleBox["p", "TI"]], 
     RowBox[{"[", 
      StyleBox["f",
       FontWeight->"Bold",
       FontSlant->"Plain"], "]"}], 
     SubscriptBox[
      StyleBox["S",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "LL"], 
     SuperscriptBox[
      RowBox[{"(", 
       StyleBox["g",
        FontWeight->"Bold",
        FontSlant->"Plain"], ")"}], 
      RowBox[{"-", "1"}]], "\[LongEqual]", 
     SubsuperscriptBox["\[Gamma]", "LL", 
      StyleBox["p", "TI"]], 
     RowBox[{"[", 
      RowBox[{
       OverscriptBox[
        StyleBox["g",
         FontWeight->"Bold",
         FontSlant->"Plain"], "~"], 
       StyleBox["f",
        FontWeight->"Bold",
        FontSlant->"Plain"], 
       SuperscriptBox[
        OverscriptBox[
         StyleBox["g",
          FontWeight->"Bold",
          FontSlant->"Plain"], "~"], "\[Dagger]"]}], "]"}]}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "e7d86e79-4b2a-4c6d-a939-b857760d7209"]], "InlineFormula",ExpressionUUID->
  "c136fd0b-ad34-422d-a601-f5b1e378d65f"],
 " for random Hermitian frames ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    StyleBox["f",
     FontWeight->"Bold",
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "55642c13-89f6-4a4e-b80c-f46b72bbde80"]], "InlineFormula",ExpressionUUID->
  "9433e029-204f-456b-be63-79be250acc0b"],
 ". GS-4 checks the isospin algebra, the antisymmetry and the invariance of \
the pair matrices ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "LL", "\[Iota]"], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"edb4ac55-10fb-485c-b7e5-29b4e554154b"]], 
  "InlineFormula",ExpressionUUID->"c14b6801-12c0-4322-8406-a03b9a70c903"],
 ", and that ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubsuperscriptBox["\[CapitalPsi]", "LL", 
      StyleBox["T", "TI"]], 
     SubsuperscriptBox[
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "LL", "\[Iota]"], 
     SubscriptBox["\[CapitalPsi]", "LL"], "\[LongEqual]", "0"}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "a7a37536-9793-4b29-a636-7372761ffb15"]], "InlineFormula",ExpressionUUID->
  "3f93aa4a-a2f2-4a31-93be-424429de7e88"],
 " for a commuting (c-number) spinor, for which the antisymmetric matrix \
gives zero."
}], "Text",ExpressionUUID->"c599aa99-df89-4513-bc21-15a25e36a25d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"GS", "-", "3"}], ":", " ", 
      RowBox[{
       RowBox[{"200", " ", "random", " ", "unit", " ", "bi"}], "-", 
       "quaternions"}]}], ";", " ", 
     RowBox[{"for", " ", "each"}]}], ",", " ", 
    RowBox[{"a", " ", "random", " ", "Hermitian", " ", "frame", " ", 
     RowBox[{"(", 
      RowBox[{
      "the", " ", "random", " ", "numbers", " ", "in", " ", "the", " ", 
       "order", " ", "of", " ", "t2_fields"}], ")"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"worst3", " ", "=", " ", "0."}], ";", " ", 
    RowBox[{"worst3b", " ", "=", " ", "0."}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "mg", ",", " ", "s4", ",", " ", "s4i", ",", " ", "l", ",", " ", "f", 
          ",", " ", "gf", ",", " ", "mgt", ",", " ", "f2", ",", " ", "gf2"}], 
         "}"}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{"mg", " ", "=", " ", 
          RowBox[{"t2randSL2C", "[", "]"}]}], ";", "\n", "   ", 
         RowBox[{"s4", " ", "=", " ", 
          RowBox[{"t2spinRep", "[", "mg", "]"}]}], ";", "\n", "   ", 
         RowBox[{"s4i", " ", "=", " ", 
          RowBox[{"ArrayFlatten", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"ConjugateTranspose", "[", "mg", "]"}], ",", " ", 
               "0"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"0", ",", " ", 
               RowBox[{"t2inv2", "[", "mg", "]"}]}], "}"}]}], "}"}], "]"}]}], 
         ";", "\n", "   ", 
         RowBox[{"worst3", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"worst3", ",", " ", 
            RowBox[{"fro", "[", 
             RowBox[{
              RowBox[{"s4", " ", ".", " ", "s4i"}], " ", "-", " ", 
              RowBox[{"IdentityMatrix", "[", "4", "]"}]}], "]"}]}], "]"}]}], ";",
          "\n", "   ", 
         RowBox[{"l", " ", "=", " ", 
          RowBox[{"t2lmat", "[", "mg", "]"}]}], ";", "\n", "   ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{"worst3", " ", "=", " ", 
            RowBox[{"Max", "[", 
             RowBox[{"worst3", ",", " ", 
              RowBox[{"fro", "[", 
               RowBox[{
                RowBox[{"s4i", " ", ".", " ", 
                 RowBox[{"g", "[", 
                  RowBox[{"[", 
                   RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}], " ", ".", 
                 " ", "s4"}], " ", "-", " ", 
                RowBox[{"Sum", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"l", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"p", " ", "+", " ", "1"}], ",", " ", 
                    RowBox[{"q", " ", "+", " ", "1"}]}], "]"}], "]"}], " ", 
                   RowBox[{"g", "[", 
                    RowBox[{"[", 
                    RowBox[{"q", " ", "+", " ", "1"}], "]"}], "]"}]}], ",", 
                  " ", 
                  RowBox[{"{", 
                   RowBox[{"q", ",", " ", "0", ",", " ", "3"}], "}"}]}], 
                 "]"}]}], "]"}]}], "]"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}], ";", 
         "\n", "   ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"the", " ", "frame", " ", "f_p"}], " ", "=", " ", 
            RowBox[{
             RowBox[{"x0", " ", "e0"}], " ", "+", " ", 
             RowBox[{"i", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"x1", " ", "e1"}], " ", "+", " ", 
                RowBox[{"x2", " ", "e2"}], " ", "+", " ", 
                RowBox[{"x3", " ", "e3"}]}], ")"}]}]}]}], ",", " ", 
           RowBox[{
           "real", " ", "x", " ", "drawn", " ", "p", " ", "by", " ", "p"}]}], 
          " ", "*)"}], "\n", "   ", 
         RowBox[{"f", " ", "=", " ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Module", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"x0", " ", "=", " ", 
                RowBox[{"t2Unit", "[", "]"}]}], "}"}], ",", " ", 
              RowBox[{"Prepend", "[", 
               RowBox[{
                RowBox[{"Table", "[", 
                 RowBox[{
                  RowBox[{"I", " ", 
                   RowBox[{"t2Unit", "[", "]"}]}], ",", " ", 
                  RowBox[{"{", "3", "}"}]}], "]"}], ",", " ", "x0"}], "]"}]}],
              "]"}], ",", " ", 
            RowBox[{"{", "4", "}"}]}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"gf", " ", "=", " ", 
          RowBox[{"t2gammasFromFrame", "[", "f", "]"}]}], ";", "\n", "   ", 
         RowBox[{"mgt", " ", "=", " ", 
          RowBox[{"t2inv2", "[", 
           RowBox[{"ConjugateTranspose", "[", "mg", "]"}], "]"}]}], ";", "\n",
          "   ", 
         RowBox[{"f2", " ", "=", " ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"With", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"x", " ", "=", " ", 
                RowBox[{"t2coords", "[", 
                 RowBox[{"mgt", " ", ".", " ", 
                  RowBox[{"t2mq", "[", 
                   RowBox[{"f", "[", 
                    RowBox[{"[", "p", "]"}], "]"}], "]"}], " ", ".", " ", 
                  RowBox[{"ConjugateTranspose", "[", "mgt", "]"}]}], "]"}]}], 
               "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"x", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
                RowBox[{"I", " ", 
                 RowBox[{"x", "[", 
                  RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", 
                RowBox[{"I", " ", 
                 RowBox[{"x", "[", 
                  RowBox[{"[", "3", "]"}], "]"}]}], ",", " ", 
                RowBox[{"I", " ", 
                 RowBox[{"x", "[", 
                  RowBox[{"[", "4", "]"}], "]"}]}]}], "}"}]}], "]"}], ",", 
            " ", 
            RowBox[{"{", 
             RowBox[{"p", ",", " ", "4"}], "}"}]}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"gf2", " ", "=", " ", 
          RowBox[{"t2gammasFromFrame", "[", "f2", "]"}]}], ";", "\n", "   ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{"worst3b", " ", "=", " ", 
            RowBox[{"Max", "[", 
             RowBox[{"worst3b", ",", " ", 
              RowBox[{"fro", "[", 
               RowBox[{
                RowBox[{"s4", " ", ".", " ", 
                 RowBox[{"gf", "[", 
                  RowBox[{"[", "p", "]"}], "]"}], " ", ".", " ", "s4i"}], " ",
                 "-", " ", 
                RowBox[{"gf2", "[", 
                 RowBox[{"[", "p", "]"}], "]"}]}], "]"}]}], "]"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"p", ",", " ", "4"}], "}"}]}], "]"}]}]}], "]"}], ",", 
      "\n", "  ", 
      RowBox[{"{", "200", "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<GS-3\>\"", ",", 
     " ", "\"\<the gauge group SL(2,C) as a change of representation: \
Sspin^-1 gamma^p Sspin = sum Lmat[p][q] gamma^q and Sspin gamma^p[f] Sspin^-1 \
= gamma^p[gLt f gLt^dag] for 200 random gL and random Hermitian frames \
(tolerance 1e-10)\>\"", ",", "\n", "  ", 
     RowBox[{
      RowBox[{"worst3", " ", "<", " ", "1*^-10"}], " ", "&&", " ", 
      RowBox[{"worst3b", " ", "<", " ", "1*^-10"}]}], ",", " ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<largest deviations \>\"", ",", " ", "worst3", ",", 
        " ", "\"\< and \>\"", ",", " ", "worst3b", ",", 
        " ", "\"\< (original: 5.8e-14 and 6.6e-14)\>\""}], "}"}], "]"}]}], 
    "]"}]}]}]], "Input",ExpressionUUID->"06ff5a3f-c6b6-4f98-9af9-\
21f017267009"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"GS", "-", "4"}], ":", " ", "isospin"}], ",", " ", 
    RowBox[{
    "Lorentz", " ", "invariance", " ", "and", " ", "isospin", " ", 
     "covariance", " ", "of", " ", "the", " ", "pair", " ", "matrices"}], ",",
     " ", 
    RowBox[{
     RowBox[{"the", " ", "c"}], "-", 
     RowBox[{"number", " ", "spinor"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"t", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"t2tiso", "[", "i", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"k", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"t2kpair", "[", "i", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"isoOk", " ", "=", " ", 
     RowBox[{
      RowBox[{"And", " ", "@@", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"fro", "[", 
            RowBox[{
             RowBox[{"comm", "[", 
              RowBox[{
               RowBox[{"t", "[", 
                RowBox[{"[", "a", "]"}], "]"}], ",", " ", 
               RowBox[{"t", "[", 
                RowBox[{"[", "b", "]"}], "]"}]}], "]"}], " ", "-", " ", 
             RowBox[{"Sum", "[", 
              RowBox[{
               RowBox[{"I", " ", 
                RowBox[{"t2eps3", "[", 
                 RowBox[{"a", ",", " ", "b", ",", " ", "c"}], "]"}], " ", 
                RowBox[{"t", "[", 
                 RowBox[{"[", "c", "]"}], "]"}]}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"c", ",", " ", "3"}], "}"}]}], "]"}]}], "]"}], " ", "<",
            " ", "tol"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"a", ",", " ", "3"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"b", ",", " ", "3"}], "}"}]}], "]"}], "]"}]}], " ", "&&", 
      "\n", "   ", 
      RowBox[{"And", " ", "@@", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"fro", "[", 
             RowBox[{"comm", "[", 
              RowBox[{
               RowBox[{"t", "[", 
                RowBox[{"[", "a", "]"}], "]"}], ",", " ", 
               RowBox[{"t2lift4", "[", 
                RowBox[{"sj", "[", 
                 RowBox[{"[", "u", "]"}], "]"}], "]"}]}], "]"}], "]"}], " ", "<",
             " ", "tol"}], " ", "&&", " ", 
           RowBox[{
            RowBox[{"fro", "[", 
             RowBox[{"comm", "[", 
              RowBox[{
               RowBox[{"t", "[", 
                RowBox[{"[", "a", "]"}], "]"}], ",", " ", 
               RowBox[{"t2lift4", "[", 
                RowBox[{"sk", "[", 
                 RowBox[{"[", "u", "]"}], "]"}], "]"}]}], "]"}], "]"}], " ", "<",
             " ", "tol"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"a", ",", " ", "3"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"u", ",", " ", "3"}], "}"}]}], "]"}], "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"kkOk", " ", "=", " ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{"k", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"fro", "[", 
          RowBox[{"#", " ", "+", " ", 
           RowBox[{"Transpose", "[", "#", "]"}]}], "]"}], " ", "<", " ", 
         "tol"}], " ", "&"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"worst4", " ", "=", " ", "0."}], ";", " ", 
    RowBox[{"cnum", " ", "=", " ", "0."}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "mg", ",", " ", "s8", ",", " ", "th", ",", " ", "u2", ",", " ", "u8",
           ",", " ", "r", ",", " ", "psi"}], "}"}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{"mg", " ", "=", " ", 
          RowBox[{"t2randSL2C", "[", "]"}]}], ";", "\n", "   ", 
         RowBox[{"s8", " ", "=", " ", 
          RowBox[{"t2lift4", "[", 
           RowBox[{"t2spinRep", "[", "mg", "]"}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"th", " ", "=", " ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"3", " ", 
             RowBox[{"t2Unit", "[", "]"}]}], ",", " ", 
            RowBox[{"{", "3", "}"}]}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"u2", " ", "=", " ", 
          RowBox[{"t2su2", "[", "th", "]"}]}], ";", " ", 
         RowBox[{"u8", " ", "=", " ", 
          RowBox[{"t2lift2", "[", "u2", "]"}]}], ";", " ", 
         RowBox[{"r", " ", "=", " ", 
          RowBox[{"t2adjoint", "[", "u2", "]"}]}], ";", "\n", "   ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{"worst4", " ", "=", " ", 
            RowBox[{"Max", "[", 
             RowBox[{"worst4", ",", " ", 
              RowBox[{"fro", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Transpose", "[", "s8", "]"}], " ", ".", " ", 
                 RowBox[{"k", "[", 
                  RowBox[{"[", "a", "]"}], "]"}], " ", ".", " ", "s8"}], " ", 
                "-", " ", 
                RowBox[{"k", "[", 
                 RowBox[{"[", "a", "]"}], "]"}]}], "]"}], ",", "\n", "      ", 
              RowBox[{"fro", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Transpose", "[", "u8", "]"}], " ", ".", " ", 
                 RowBox[{"k", "[", 
                  RowBox[{"[", "a", "]"}], "]"}], " ", ".", " ", "u8"}], " ", 
                "-", " ", 
                RowBox[{"Sum", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"r", "[", 
                    RowBox[{"[", 
                    RowBox[{"a", ",", " ", "b"}], "]"}], "]"}], " ", 
                   RowBox[{"k", "[", 
                    RowBox[{"[", "b", "]"}], "]"}]}], ",", " ", 
                  RowBox[{"{", 
                   RowBox[{"b", ",", " ", "3"}], "}"}]}], "]"}]}], "]"}]}], 
             "]"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"a", ",", " ", "3"}], "}"}]}], "]"}], ";", "\n", "   ", 
         RowBox[{"psi", " ", "=", " ", 
          RowBox[{"t2RndVec", "[", "8", "]"}]}], ";", "\n", "   ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{"cnum", " ", "=", " ", 
            RowBox[{"Max", "[", 
             RowBox[{"cnum", ",", " ", 
              RowBox[{"Abs", "[", 
               RowBox[{"psi", " ", ".", " ", 
                RowBox[{"k", "[", 
                 RowBox[{"[", "a", "]"}], "]"}], " ", ".", " ", "psi"}], 
               "]"}]}], "]"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"a", ",", " ", "3"}], "}"}]}], "]"}]}]}], "]"}], ",", 
      "\n", "  ", 
      RowBox[{"{", "100", "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<GS-4\>\"", ",", 
     " ", "\"\<isospin T^iota obeys [T^a, T^b] = i eps T^c and commutes with \
the Lorentz generators; the pair matrices Kch_iota are antisymmetric, Lorentz \
invariant and an isospin vector (100 random gL and U); Psi^T Kch Psi = 0 for \
a c-number spinor (tolerance 1e-10)\>\"", ",", "\n", "  ", 
     RowBox[{"isoOk", " ", "&&", " ", "kkOk", " ", "&&", " ", 
      RowBox[{"worst4", " ", "<", " ", "1*^-10"}], " ", "&&", " ", 
      RowBox[{"cnum", " ", "<", " ", "1*^-12"}]}], ",", " ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<largest deviation \>\"", ",", " ", "worst4", ",", 
        " ", "\"\<; largest |Psi^T Kch Psi| \>\"", ",", " ", "cnum", ",", 
        " ", "\"\< (original: 5.2e-15; 3.0e-16)\>\""}], "}"}], "]"}]}], 
    "]"}]}]}]], "Input",ExpressionUUID->"e017b05b-8bb7-4fa1-a26f-\
bd814f5b7549"],

Cell["\<\
GS-5 and GS-6: gauge covariance and curvature of the covariant derivative\
\>", "Subsection",ExpressionUUID->"c7e948fa-de1b-48f2-b39a-d30aa8b56bca"],

Cell[TextData[{
 "Fields linear in the coordinates ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["x", "TI"], "LL"], "\[LongEqual]", 
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["x", "TI"], "LL", "0"], ",", 
       SubsuperscriptBox[
        StyleBox["x", "TI"], "LL", "1"], ",", 
       SubsuperscriptBox[
        StyleBox["x", "TI"], "LL", "2"], ",", 
       SubsuperscriptBox[
        StyleBox["x", "TI"], "LL", "3"]}], ")"}]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"7a3d4832-73ae-45ad-adf2-0712b80d6db3"]], 
  "InlineFormula",ExpressionUUID->"0ba5c1c7-f5dd-4904-b07c-97d459021a87"],
 " are drawn at random: the isospin potentials ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{"LL", ",", 
      StyleBox["p", "TI"]}], "\[Iota]"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"465a5948-13cb-492a-91fd-2eb7b66e41f5"]], "InlineFormula",
  ExpressionUUID->"624c1aea-2232-47ae-b9f9-ed28b3c8e46c"],
 ", the fermion-number potentials ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{"LL", ",", 
      StyleBox["p", "TI"]}], "F"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"70ac95e1-d5d3-440d-90a0-967d532a641a"]], "InlineFormula",
  ExpressionUUID->"550d76c5-0b48-43aa-a8a6-6b68f53ccf3c"],
 " and the Lorentz connection with the rotation components ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[Omega]", 
     RowBox[{"LL", ",", 
      StyleBox["p", "TI"]}], 
     StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "683bcc50-8f83-4ee9-9598-7892436eaff1"]], "InlineFormula",ExpressionUUID->
  "931d8800-002b-440d-9dc3-028f1759fa7c"],
 " and the boost components ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[CurlyPi]", 
     RowBox[{"LL", ",", 
      StyleBox["p", "TI"]}], 
     StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "6db26671-eebf-41ec-85ca-dd85faeecafa"]], "InlineFormula",ExpressionUUID->
  "e27c09b0-4c44-46f7-a661-83846fd6d6ab"],
 "; the spinor field ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubscriptBox["\[CapitalPsi]", "LL"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"31e79368-a0f3-4dc9-b8ed-db6b2dbf930e"]], "InlineFormula",
  ExpressionUUID->"08c0f970-66a7-4ba9-9b4b-cba86dfb37c9"],
 " is a sum of three plane waves. A gauge transformation ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["\[ScriptCapitalU]",
       FontSlant->"Plain"], "LL"], "\[LongEqual]", "exp", 
     RowBox[{"(", 
      RowBox[{
       StyleBox["i", "TI"], 
       SubsuperscriptBox["\[Theta]", "LL", "F"]}], ")"}], " ", 
     SubscriptBox[
      StyleBox["S",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "LL"], 
     RowBox[{"(", 
      StyleBox["g",
       FontWeight->"Bold",
       FontSlant->"Plain"], ")"}], "\[CircleTimes]", 
     SubscriptBox[
      StyleBox["U",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "LL"]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"3cadc584-5deb-47f6-882d-85022162b913"]], "InlineFormula",
  ExpressionUUID->"3a360c6d-63bf-4474-9c69-6c3e144752d8"],
 " is applied, whose phase ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[Theta]", "LL", "F"], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"801fb8ac-dde2-4c80-82f3-e801468085fe"]], 
  "InlineFormula",ExpressionUUID->"5f7a0b82-b50f-40be-bd3a-6a7f9699a150"],
 ", isospin rotation ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["U",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "LL"], "\[LongEqual]", "exp", 
     RowBox[{"(", 
      RowBox[{
       StyleBox["i", "TI"], 
       UnderscriptBox["\[Sum]", "\[Iota]",
        LimitsPositioning->True], 
       SubsuperscriptBox["\[Theta]", "LL", "\[Iota]"], 
       SubsuperscriptBox["\[Tau]", "\[Iota]", "LL"], "/", "2"}], ")"}]}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "3a8b5d23-9fcd-4bf1-ac30-17eaefe159cd"]], "InlineFormula",ExpressionUUID->
  "bcec1a45-3192-4b20-abb7-ecc89d4445df"],
 " and unit bi-quaternion ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    StyleBox["g",
     FontWeight->"Bold",
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "52b9e524-fde3-46f6-b8cf-078b99ceb159"]], "InlineFormula",ExpressionUUID->
  "0946dddf-ee4f-4931-bf9f-4c07fd24c9bd"],
 " (with ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["M", "TI"], "LL"], 
     RowBox[{"(", 
      StyleBox["g",
       FontWeight->"Bold",
       FontSlant->"Plain"], ")"}], "\[LongEqual]", "exp", 
     SubscriptBox[
      StyleBox["M", "TI"], "LL"], 
     RowBox[{"(", 
      StyleBox["u",
       FontWeight->"Bold",
       FontSlant->"Plain"], ")"}]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"8c3294aa-d48c-4087-9aa2-a66d2ccfe03d"]], "InlineFormula",
  ExpressionUUID->"24b4ed23-635f-40b3-9a96-30f0653b13ef"],
 " for a Lorentz generator ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    StyleBox["u",
     FontWeight->"Bold",
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "11837564-bff4-462a-b725-a68d7aa1791b"]], "InlineFormula",ExpressionUUID->
  "c245b73a-9666-4942-8379-0f32572ae6d8"],
 ") depend on ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubscriptBox[
     StyleBox["x", "TI"], "LL"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"910fefe5-6f9c-46bd-b4ac-cad35613b535"]], "InlineFormula",
  ExpressionUUID->"fc9da2f7-1d1c-485c-9769-899886452e70"],
 " through ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[Theta]", "LL", "F"], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"3f36c31d-eb43-4acf-93f4-305791115784"]], 
  "InlineFormula",ExpressionUUID->"6aa24dd8-eb3b-4374-b1e6-ea97b7a058f4"],
 ", ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[Theta]", "LL", "\[Iota]"], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"47f8282d-d260-433e-9346-1a54718e979f"]], 
  "InlineFormula",ExpressionUUID->"01496201-e012-46e2-b75c-52608e4951f3"],
 " and ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    StyleBox["u",
     FontWeight->"Bold",
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "8c453036-6fc1-4eef-8424-5112f0bd394b"]], "InlineFormula",ExpressionUUID->
  "536f8ef8-124c-47de-a16d-032799c88d1f"],
 ", which are linear in ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubscriptBox[
     StyleBox["x", "TI"], "LL"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"a5ad818d-224b-4489-93a6-70e45aa49e14"]], "InlineFormula",
  ExpressionUUID->"f7b35acd-d7d2-4bbe-a90c-da96c9d212ce"],
 ". The transformed fields are ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubsuperscriptBox[
      StyleBox["A", "TI"], 
      RowBox[{"LL", ",", 
       StyleBox["p", "TI"]}], "F"], "+", 
     SubscriptBox["\[PartialD]", 
      StyleBox["p", "TI"]], 
     SubsuperscriptBox["\[Theta]", "LL", "F"], "/", 
     SubsuperscriptBox[
      StyleBox["g", "TI"], "LL", "F"]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"048baec9-3d6f-4f2d-8096-bcd2257ab424"]], "InlineFormula",
  ExpressionUUID->"73b71890-6045-41a5-9107-783fc7cf0ac0"],
 ", ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["U",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "LL"], 
     SubscriptBox[
      StyleBox["a",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      RowBox[{"LL", ",", 
       StyleBox["p", "TI"]}]], 
     SubsuperscriptBox[
      StyleBox["U",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "LL", 
      RowBox[{"-", "1"}]], "-", 
     RowBox[{"(", 
      RowBox[{
       StyleBox["i", "TI"], "/", 
       SubsuperscriptBox[
        StyleBox["g", "TI"], "LL", "v"]}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[PartialD]", 
        StyleBox["p", "TI"]], 
       SubscriptBox[
        StyleBox["U",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], "LL"]}], ")"}], 
     SubsuperscriptBox[
      StyleBox["U",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "LL", 
      RowBox[{"-", "1"}]]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"42843673-f9a4-4c52-b176-9dd007e54b3b"]], "InlineFormula",
  ExpressionUUID->"90424e3f-5b9a-40e3-b39d-ea742443ec45"],
 " in place of ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["a",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      RowBox[{"LL", ",", 
       StyleBox["p", "TI"]}]], "\[LongEqual]", 
     UnderscriptBox["\[Sum]", "\[Iota]",
      LimitsPositioning->True], 
     SubsuperscriptBox[
      StyleBox["A", "TI"], 
      RowBox[{"LL", ",", 
       StyleBox["p", "TI"]}], "\[Iota]"], 
     SubsuperscriptBox["\[Tau]", "\[Iota]", "LL"], "/", "2"}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "5ae79155-7c03-4e8e-ab4e-e42388035e2b"]], "InlineFormula",ExpressionUUID->
  "36d20a47-a5bb-41af-bfd6-cb07e00409cb"],
 ", and, on the Dirac index, ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["S",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "LL"], 
     RowBox[{"(", 
      StyleBox["g",
       FontWeight->"Bold",
       FontSlant->"Plain"], ")"}], 
     SubscriptBox[
      StyleBox["s",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "LL"], 
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["u",
        FontWeight->"Bold",
        FontSlant->"Plain"], 
       RowBox[{"LL", ",", 
        StyleBox["p", "TI"]}], "\[Omega]"], ")"}], 
     SubscriptBox[
      StyleBox["S",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "LL"], 
     SuperscriptBox[
      RowBox[{"(", 
       StyleBox["g",
        FontWeight->"Bold",
        FontSlant->"Plain"], ")"}], 
      RowBox[{"-", "1"}]], "-", 
     RowBox[{"(", 
