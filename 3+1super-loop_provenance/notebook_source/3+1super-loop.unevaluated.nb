            RowBox[{"dropped", " ", "later"}]}]}], " ", "*)"}], "\n", "    ", 
         
         RowBox[{"RegularExpression", "[", "\"\<.\>\"", "]"}]}], "}"}]}], 
      "]"}]}], ";"}], "                ", 
   RowBox[{"(*", " ", 
    RowBox[{"any", " ", "other", " ", "single", " ", "character"}], " ", 
    "*)"}], "\n", "\n", 
