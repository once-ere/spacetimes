    RowBox[{"SL31Check", "[", 
     RowBox[{"\"\<S-14\>\"", ",", 
      " ", "\"\<every symbol typed in its printed form is read as one atomic \
symbol, the one created from its registry TeX\>\"", ",", "\n", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "typed", "]"}], " ", "==", " ", 
        RowBox[{"Length", "[", "symbolTable", "]"}]}], " ", "&&", " ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{"typed", ",", " ", "AtomQ"}], "]"}], " ", "&&", " ", 
       RowBox[{"typed", " ", "===", " ", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"ReleaseHold", "[", 
            RowBox[{"#", "[", "\"\<symbol\>\"", "]"}], "]"}], " ", "&"}], ",",
           " ", "symbolTable"}], "]"}]}]}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Length", "[", "typed", "]"}], ",", " ", 
        RowBox[{"Count", "[", 
         RowBox[{"typed", ",", " ", 
          RowBox[{"_", "?", "AtomQ"}]}], "]"}], ",", " ", 
        RowBox[{"Length", "[", "symbolTable", "]"}]}], "}"}]}], "]"}], 
    ";"}]}]}]], "Input",ExpressionUUID->"ead0e9c2-7aab-4c53-897c-\
d08f02d3da78"],

Cell["\<\
S-3, uniqueness: different printed forms give different symbols. If two \
different boxes had received the same name, two printed symbols would have \
become one Wolfram symbol. The test compares the number of different boxes \
with the number of different symbols, and also checks the comparison that the \
Notation package itself makes: it removes style boxes (StyleBox, \
AdjustmentBox, FrameBox) before it compares input with a symbolized box, so \
the boxes must still be different after this removal. (TeX items with the \
same boxes, listed in section I.6, are one symbol by construction.)\
\>", "Text",ExpressionUUID->"4d0abc5d-cf8c-4963-ab5c-c6ee51d86eba"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"strip", "[", "b_", "]"}], " ", ":=", " ", 
   RowBox[{"b", " ", "//.", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"StyleBox", "[", 
        RowBox[{"x_", ",", " ", "___"}], "]"}], " ", ":>", " ", "x"}], ",", 
      " ", 
      RowBox[{
       RowBox[{"AdjustmentBox", "[", 
        RowBox[{"x_", ",", " ", "___"}], "]"}], " ", ":>", " ", "x"}], ",", 
      " ", 
      RowBox[{
       RowBox[{"FrameBox", "[", 
        RowBox[{"x_", ",", " ", "___"}], "]"}], " ", ":>", " ", "x"}]}], 
     "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"syms", " ", "=", " ", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"#", "[", "\"\<symbol\>\"", "]"}], " ", "&"}], ",", " ", 
     "symbolTable"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-3\>\"", ",", 
    " ", "\"\<different boxes give different symbols, and the boxes stay \
different after the removal of style boxes\>\"", ",", "\n", "  ", 
    RowBox[{
     RowBox[{"Length", "[", 
      RowBox[{"DeleteDuplicates", "[", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", "\"\<boxes\>\"", "]"}], " ", "&"}], ",", " ", 
         "symbolTable"}], "]"}], "]"}], "]"}], " ", "==", " ", 
     RowBox[{"Length", "[", 
      RowBox[{"DeleteDuplicates", "[", "syms", "]"}], "]"}], " ", "==", "\n", 
     "   ", 
     RowBox[{"Length", "[", 
      RowBox[{"DeleteDuplicates", "[", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"strip", "[", 
           RowBox[{"#", "[", "\"\<boxes\>\"", "]"}], "]"}], " ", "&"}], ",", 
         " ", "symbolTable"}], "]"}], "]"}], "]"}], " ", "==", " ", 
     RowBox[{"Length", "[", "symbolTable", "]"}]}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Length", "[", "symbolTable", "]"}], ",", " ", 
      RowBox[{"Length", "[", 
       RowBox[{"DeleteDuplicates", "[", "syms", "]"}], "]"}], ",", " ", 
      RowBox[{"Length", "[", 
       RowBox[{"DeleteDuplicates", "[", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"strip", "[", 
            RowBox[{"#", "[", "\"\<boxes\>\"", "]"}], "]"}], " ", "&"}], ",", 
          " ", "symbolTable"}], "]"}], "]"}], "]"}]}], "}"}]}], "]"}], 
  ";"}]}], "Input",ExpressionUUID->"c3a12a28-536f-4aff-90c9-05ae82608336"],

Cell[TextData[{
 "S-4, the round trip: a symbol, printed again, gives exactly the box it was \
made from (",
 StyleBox["ToBoxes[symbol, StandardForm]",
  FontFamily->"Source Code Pro"],
 "). This is the other half of the symbolization: input box to symbol (S-2) \
and symbol to output box (S-4)."
}], "Text",ExpressionUUID->"4cafb9ad-4d13-42d8-b2d8-4727e19370f1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"roundTrip", " ", "=", " ", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{"r", ",", " ", 
       RowBox[{"Replace", "[", 
        RowBox[{
         RowBox[{"r", "[", "\"\<symbol\>\"", "]"}], ",", " ", 
         RowBox[{
          RowBox[{"HoldComplete", "[", "s_", "]"}], " ", ":>", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"ToBoxes", "[", 
             RowBox[{
              RowBox[{"Unevaluated", "[", "s", "]"}], ",", " ", 
              "StandardForm"}], "]"}], " ", "===", " ", 
            RowBox[{"r", "[", "\"\<boxes\>\"", "]"}]}], ")"}]}]}], "]"}]}], 
      "]"}], ",", " ", "symbolTable"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-4\>\"", ",", 
    " ", "\"\<every symbol prints as the box it was made from\>\"", ",", " ", 
    
    RowBox[{"And", " ", "@@", " ", "roundTrip"}], ",", " ", 
    RowBox[{"Count", "[", 
     RowBox[{"roundTrip", ",", " ", "True"}], "]"}]}], "]"}], ";"}]}], "Input",\
ExpressionUUID->"2bbbd30a-a581-4ff5-9ce0-8c9a097ea072"],

Cell[TextData[{
 "S-5, TeX: with its ",
 StyleBox["TraditionalForm",
  FontFamily->"Source Code Pro"],
 " rule, every symbol is written in TeX from its displayed boxes; the \
internal name, with its separator character, does not appear."
}], "Text",ExpressionUUID->"29cb7b07-2570-4077-a6a5-337d0d75f9a1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"texOut", " ", "=", " ", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{"r", ",", " ", 
       RowBox[{"Replace", "[", 
        RowBox[{
         RowBox[{"r", "[", "\"\<symbol\>\"", "]"}], ",", " ", 
         RowBox[{
          RowBox[{"HoldComplete", "[", "s_", "]"}], " ", ":>", " ", 
          RowBox[{"ToString", "[", 
           RowBox[{"TeXForm", "[", 
            RowBox[{"Unevaluated", "[", "s", "]"}], "]"}], "]"}]}]}], "]"}]}],
       "]"}], ",", " ", "symbolTable"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-5\>\"", ",", 
    " ", "\"\<the TeX of every symbol is written from its printed form, \
without the internal name\>\"", ",", "\n", "  ", 
    RowBox[{"AllTrue", "[", 
     RowBox[{"texOut", ",", " ", 
      RowBox[{
       RowBox[{"!", " ", 
        RowBox[{"StringContainsQ", "[", 
         RowBox[{"#", ",", " ", 
          
          RowBox[{"\"\<UnderBracket\>\"", " ", "|", 
           " ", "\"\<\[UnderBracket]\>\""}]}], "]"}]}], " ", "&"}]}], "]"}], ",",
     " ", 
    RowBox[{"Count", "[", 
     RowBox[{"texOut", ",", " ", 
      RowBox[{"x_", " ", "/;", " ", 
       RowBox[{"!", " ", 
        RowBox[{"StringContainsQ", "[", 
         RowBox[{"x", ",", " ", "\"\<UnderBracket\>\""}], "]"}]}]}]}], 
     "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{"TableForm", "[", 
  RowBox[{
   RowBox[{"Take", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", "\"\<tex\>\"", "]"}], " ", "&"}], ",", " ", 
          "symbolTable"}], "]"}], ",", " ", "texOut"}], "}"}], "]"}], ",", 
     " ", "8"}], "]"}], ",", " ", 
   RowBox[{"TableHeadings", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"None", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<registry TeX\>\"", ",", 
        " ", "\"\<TeXForm of the symbol\>\""}], "}"}]}], "}"}]}]}], 
  "]"}]}], "Input",ExpressionUUID->"cbf86a69-a01c-47af-9e91-562c1abe63de"],

Cell[TextData[{
 "S-6, arithmetic with symbols and values: the coupling ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f0fd303a-ce27-4a85-96e6-2466318ccb2a"],
 ", the mass ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "35813c92-3249-4af2-8cf8-0694415d6c6b"],
 " and the cutoff ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalLambda]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "96f99b06-9a2a-4682-8b86-53d9ef9a9a7f"],
 " of the spinor charges receive the values used throughout Test 2 (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0.2"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7a7b65d4-ac1f-4621-8214-caa1ab8fe4ce"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "165b3ede-718a-4f35-aaf9-652b4b9f8213"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "22.5"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "17d82b4f-80b9-4add-81b2-f8e052007794"],
 ", units in which the cutoff is 1). The gap of the condensed vacuum at zero \
chemical potential solves the gap equation ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[CapitalLambda]", 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         SubsuperscriptBox["\[CapitalLambda]", 
          StyleBox["LL",
           FontSlant->"Plain"], "2"], "+", 
         SuperscriptBox[
          RowBox[{"(", 
           SubsuperscriptBox[
            StyleBox["M", "TI"], 
            StyleBox["LL",
             FontSlant->"Plain"], 
            StyleBox["q",
             FontSlant->"Plain"]], ")"}], "2"]}], ")"}], 
       RowBox[{"1", "/", "2"}]], "-", 
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox[
         StyleBox["M", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], 
         StyleBox["q",
          FontSlant->"Plain"]], ")"}], "2"], "\[ThinSpace]", 
      StyleBox["arsinh",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[CapitalLambda]", 
         StyleBox["LL",
          FontSlant->"Plain"]], "/", 
        SubsuperscriptBox[
         StyleBox["M", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], 
         StyleBox["q",
          FontSlant->"Plain"]]}], ")"}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"2", 
      SuperscriptBox["\[Pi]", "2"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ddeb7f4f-8b06-4aef-9c67-44dae2ecc725"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["q",
        FontSlant->"Plain"]], ")"}], "2"], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "2"], "+", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["vac",
        FontSlant->"Plain"]], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "535f1735-6b69-4ba9-9c03-1302027fa823"],
 ". The cell writes this equation with the symbolized symbols, gives them \
values only inside ",
 StyleBox["Block",
  FontFamily->"Source Code Pro"],
 " (so that they stay free symbols outside), solves for the gap with ",
 StyleBox["FindRoot",
  FontFamily->"Source Code Pro"],
 ", and compares with the value 0.2094933033 found by the Rust program of \
Test 2. It also checks the derived masses ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    SubsuperscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["vac",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3d189058-e509-472b-9a87-0a53af275bc3"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["q",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9a4f81c4-87f6-40ac-9e02-5e944a48d474"],
 "."
}], "Text",ExpressionUUID->"2b42e875-fdc0-41a3-b565-299833fef97f"],

Cell[BoxData[
 RowBox[{"gapEquation", " ", "=", " ", 
  RowBox[{
   RowBox[{"1", "/", 
    SubscriptBox["G", "LL"]}], " ", "==", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[CapitalLambda]", "LL"], " ", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{
          SubscriptBox["\[CapitalLambda]", "LL"], "^", "2"}], " ", "+", " ", 
         RowBox[{
          SubscriptBox["m", "LL"], "^", "2"}], " ", "+", " ", 
         RowBox[{
          SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], "^", "2"}]}], 
        "]"}]}], " ", "-", "\n", "     ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SubscriptBox["m", "LL"], "^", "2"}], " ", "+", " ", 
         RowBox[{
          SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], "^", "2"}]}], 
        ")"}], " ", 
       RowBox[{"ArcSinh", "[", 
        RowBox[{
         SubscriptBox["\[CapitalLambda]", "LL"], "/", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{
            SubscriptBox["m", "LL"], "^", "2"}], " ", "+", " ", 
           RowBox[{
            SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], "^", "2"}]}], 
          "]"}]}], "]"}]}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"2", " ", 
      RowBox[{"Pi", "^", "2"}]}], ")"}]}]}]}]], "Input",ExpressionUUID->\
"57f6ea3d-1fd3-443f-b991-1ade436d940a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"exact", " ", "values", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"45", "/", "2"}], ",", " ", 
       RowBox[{"1", "/", "5"}], ",", " ", "1"}], ")"}]}], ",", " ", 
    RowBox[{
    "so", " ", "that", " ", "FindRoot", " ", "can", " ", "work", " ", "with", 
     " ", "30", " ", "digits"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"gapValue", " ", "=", " ", 
     RowBox[{"Block", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          SubscriptBox["G", "LL"], " ", "=", " ", 
          RowBox[{"45", "/", "2"}]}], ",", " ", 
         RowBox[{
          SubscriptBox["m", "LL"], " ", "=", " ", 
          RowBox[{"1", "/", "5"}]}], ",", " ", 
         RowBox[{
          SubscriptBox["\[CapitalLambda]", "LL"], " ", "=", " ", "1"}]}], 
        "}"}], ",", "\n", "   ", 
       RowBox[{
        SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], " ", "/.", " ", 
        RowBox[{"FindRoot", "[", 
         RowBox[{"gapEquation", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], ",", " ", 
            "0.2"}], "}"}], ",", " ", 
          RowBox[{"WorkingPrecision", " ", "->", " ", "30"}], ",", " ", 
          RowBox[{"AccuracyGoal", " ", "->", " ", "20"}]}], "]"}]}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"SL31Check", "[", 
     RowBox[{"\"\<S-6\>\"", ",", 
      " ", "\"\<the gap equation written with the symbols gives the gap of \
the condensed vacuum 0.2094933033 at G = 22.5, m = 0.2, cutoff 1; 2 Delta_vac \
= 0.4189866 and 2 M_q = 0.5792666\>\"", ",", "\n", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"gapValue", " ", "-", " ", "0.2094933033"}], "]"}], " ", "<",
         " ", "1*^-10"}], " ", "&&", " ", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"2", " ", "gapValue"}], " ", "-", " ", "0.4189866"}], "]"}],
         " ", "<", " ", "1*^-7"}], " ", "&&", " ", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"2", " ", 
           RowBox[{"Sqrt", "[", 
            RowBox[{"0.04", " ", "+", " ", 
             RowBox[{"gapValue", "^", "2"}]}], "]"}]}], " ", "-", " ", 
          "0.5792666"}], "]"}], " ", "<", " ", "1*^-7"}]}], ",", "\n", "  ", 
      RowBox[{"N", "[", 
       RowBox[{"gapValue", ",", " ", "12"}], "]"}]}], "]"}], 
    ";"}]}]}]], "Input",ExpressionUUID->"ead9cf2a-c910-4475-854b-\
6cb57d53e85c"],

Cell[TextData[{
 "S-7, sums over a family of symbols: the Pauli matrices. The registry symbol \
",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Sigma]", 
    StyleBox["j", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "46221f82-9954-4fde-b991-f5b143a7c74c"],
 " is a family with the running index ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["j", "TI"], "\[LongEqual]", "1", ",", "2", ",", "3"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "30cffd91-ff8a-45d6-b678-6ff09a784842"],
 ". A symbolized symbol is indivisible, so the index letter inside it cannot \
be replaced by a number in a sum. The components are therefore separate \
symbols: ",
 StyleBox["LL[tex, \"j\" -> \"1\"]",
  FontFamily->"Source Code Pro"],
 " (written in the input cells as the printed component ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Sigma]", "1", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4b7bd166-dd0a-4c30-a9a0-83fbdb92067a"],
 ") symbolizes and returns the component with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["j", "TI"], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f86a630f-4df0-47ee-a1ab-b0b8679f1c81"],
 ". The cell gives the three components the Pauli matrices as values, \
together with the identity ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["1",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6e9e3d7a-4c1d-4643-b911-60e14321794d"],
 ", and checks two identities that involve sums over the index: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["j", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox["\[Sigma]", 
     StyleBox["j", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Sigma]", 
     StyleBox["j", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "3", "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0957ea1e-1967-48b8-b1d5-9dd049e77cc3"],
 ", and the product rule: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Sigma]", 
     StyleBox["j", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Sigma]", 
     SuperscriptBox[
      StyleBox["j", "TI"], "\[Prime]"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    StyleBox["i", "TI"], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", 
     SuperscriptBox[
      StyleBox["j", "TI"], "\[Prime]\[Prime]"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox["\[Epsilon]", 
     RowBox[{
      StyleBox["j", "TI"], 
      SuperscriptBox[
       StyleBox["j", "TI"], "\[Prime]"], 
      SuperscriptBox[
       StyleBox["j", "TI"], "\[Prime]\[Prime]"]}], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Sigma]", 
     SuperscriptBox[
      StyleBox["j", "TI"], "\[Prime]\[Prime]"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3c690674-5f1e-4a82-a1e6-08e26eae4a99"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["j", "TI"], "\[NotEqual]", 
    SuperscriptBox[
     StyleBox["j", "TI"], "\[Prime]"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9ba768b9-3252-4a61-91b5-45543ce5fd71"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Sigma]", 
     StyleBox["j", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Sigma]", 
     StyleBox["j", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7bd6e5c8-750e-4e12-a493-6282c6f9c6f6"],
 " (in the code the two cases are one formula, written with the function ",
 StyleBox["KroneckerDelta",
  FontFamily->"Source Code Pro"],
 ", which is 1 for equal and 0 for different arguments), in which the 27 \
components of the symbol ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Epsilon]", 
    RowBox[{
     StyleBox["j", "TI"], 
     SuperscriptBox[
      StyleBox["j", "TI"], "\[Prime]"], 
     SuperscriptBox[
      StyleBox["j", "TI"], "\[Prime]\[Prime]"]}], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d6a745fb-8793-4a31-a1fc-dea30becb451"],
 " (the totally antisymmetric symbol with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Epsilon]", "123", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a341c936-a443-4069-886b-1aab962d6c29"],
 ") are symbolized and given their values."
}], "Text",ExpressionUUID->"54fd9739-7f6d-457e-acfc-315652dcfbf9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"symbolize", " ", "the", " ", "components", " ", 
     RowBox[{"sigma", "^", "LL_"}], "1"}], ",", " ", 
    RowBox[{
     RowBox[{"sigma", "^", "LL_"}], "2"}], ",", " ", 
    RowBox[{
     RowBox[{"sigma", "^", "LL_"}], "3", " ", "and", " ", 
     RowBox[{"epsilon", "^", "LL_"}], 
     RowBox[{"{", 
      RowBox[{"j", " ", 
       RowBox[{"j", "'"}], " ", 
       RowBox[{"j", "''"}]}], "}"}], " ", 
     RowBox[{"(", 
      RowBox[{"j", ",", " ", 
       RowBox[{"j", "'"}], ",", " ", 
       RowBox[{
        RowBox[{"j", "''"}], " ", "=", " ", "1"}], ",", " ", "2", ",", " ", 
       "3"}], ")"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"sigma", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"ReleaseHold", "[", 
        RowBox[{"SL31Instance", "[", 
         RowBox[{
          RowBox[{
          "SL31SymbolBoxes", "[", "\"\<\\\\sigma^{\\\\rm LL}_j\>\"", "]"}], ",",
           " ", 
          RowBox[{"{", 
           RowBox[{"\"\<j\>\"", " ", "->", " ", 
            RowBox[{"ToString", "[", "k", "]"}]}], "}"}]}], "]"}], "]"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"eps", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"ReleaseHold", "[", 
        RowBox[{"SL31Instance", "[", 
         RowBox[{
          RowBox[{
          "SL31SymbolBoxes", "[", "\"\<\\\\epsilon^{\\\\rm LL}_{jj'j''}\>\"", 
           "]"}], ",", "\n", "      ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\"\<j\>\"", " ", "->", " ", 
             RowBox[{"ToString", "[", "a", "]"}]}], ",", " ", 
            RowBox[{
             RowBox[{"SuperscriptBox", "[", 
              RowBox[{"\"\<j\>\"", ",", " ", "\"\<\[Prime]\>\""}], "]"}], " ",
              "->", " ", 
             RowBox[{"ToString", "[", "b", "]"}]}], ",", " ", 
            RowBox[{
             RowBox[{"SuperscriptBox", "[", 
              RowBox[{"\"\<j\>\"", ",", " ", "\"\<\[Prime]\[Prime]\>\""}], 
              "]"}], " ", "->", " ", 
             RowBox[{"ToString", "[", "c", "]"}]}]}], "}"}]}], "]"}], "]"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"b", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"c", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"{", 
    RowBox[{"sigma", ",", " ", 
     RowBox[{"eps", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "]"}], "]"}], ",", " ", 
     RowBox[{"eps", "[", 
      RowBox[{"[", 
       RowBox[{"2", ",", " ", "1", ",", " ", "3"}], "]"}], "]"}]}], 
    "}"}]}]}]], "Input",ExpressionUUID->"99b98f22-5325-4721-9763-\
9703b72164e3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", 
     RowBox[{"values", ":", " ", 
      RowBox[{"inside", " ", "Block", " ", "only"}]}]}], ",", " ", 
    RowBox[{
    "so", " ", "that", " ", "the", " ", "symbols", " ", "stay", " ", "free", " ",
      "elsewhere"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"pauliValues", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "0"}], "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", 
           RowBox[{"-", "I"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"I", ",", " ", "0"}], "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", 
           RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check7", " ", "=", " ", 
     RowBox[{"Block", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          SubsuperscriptBox["\[Sigma]", "1", "LL"], " ", "=", " ", 
          RowBox[{"pauliValues", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
         RowBox[{
          SubsuperscriptBox["\[Sigma]", "2", "LL"], " ", "=", " ", 
          RowBox[{"pauliValues", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ",", "\n", "     ", 
         RowBox[{
          SubsuperscriptBox["\[Sigma]", "3", "LL"], " ", "=", " ", 
          RowBox[{"pauliValues", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], ",", " ", 
         RowBox[{
          SubscriptBox[
           TagBox[
            StyleBox["1",
             FontFamily->"Helvetica",
             FontSlant->"Plain"],
            "SL31SansSerif"], "2"], " ", "=", " ", 
          RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], "}"}], ",", "\n", 
       "   ", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"sum", ",", " ", "rule"}], "}"}], ",", "\n", "     ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{"the", " ", "sum", " ", "over", " ", "j", " ", "of", " ", 
            RowBox[{"sigma_j", " ", ".", " ", "sigma_j"}]}], ",", " ", 
           RowBox[{
           "written", " ", "with", " ", "the", " ", "three", " ", 
            "components"}]}], " ", "*)"}], "\n", "     ", 
         RowBox[{
          RowBox[{"sum", " ", "=", " ", 
           RowBox[{
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"sigma", "[", 
                RowBox[{"[", "j", "]"}], "]"}], " ", ".", " ", 
               RowBox[{"sigma", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}], " ", "-", " ", 
            RowBox[{"3", " ", 
             SubscriptBox[
              TagBox[
               StyleBox["1",
                FontFamily->"Helvetica",
                FontSlant->"Plain"],
               "SL31SansSerif"], "2"]}]}]}], ";", "\n", "     ", 
          RowBox[{"(*", " ", 
           RowBox[{
            RowBox[{
            "the", " ", "product", " ", "rule", " ", "for", " ", "all", " ", 
             "nine", " ", "pairs", " ", 
             RowBox[{"(", 
              RowBox[{"j", ",", " ", 
               RowBox[{"j", "'"}]}], ")"}]}], ",", " ", 
            RowBox[{
            "with", " ", "the", " ", "27", " ", "symbolized", " ", 
             "components", " ", "of", " ", "epsilon"}]}], " ", "*)"}], "\n", 
          "     ", 
          RowBox[{"rule", " ", "=", " ", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"sigma", "[", 
                RowBox[{"[", "j", "]"}], "]"}], " ", ".", " ", 
               RowBox[{"sigma", "[", 
                RowBox[{"[", "jp", "]"}], "]"}]}], " ", "-", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"KroneckerDelta", "[", 
                  RowBox[{"j", ",", " ", "jp"}], "]"}], " ", 
                 SubscriptBox[
                  TagBox[
                   StyleBox["1",
                    FontFamily->"Helvetica",
                    FontSlant->"Plain"],
                   "SL31SansSerif"], "2"]}], " ", "+", "\n", "           ", 
                RowBox[{"I", " ", 
                 RowBox[{"Sum", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"eps", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", ",", " ", "jp", ",", " ", "jpp"}], "]"}], 
                    "]"}], " ", "/.", " ", 
                    RowBox[{"Thread", "[", 
                    RowBox[{
                    RowBox[{"Flatten", "[", "eps", "]"}], " ", "->", " ", 
                    RowBox[{"Flatten", "[", 
                    RowBox[{"Normal", "[", 
                    RowBox[{"LeviCivitaTensor", "[", "3", "]"}], "]"}], 
                    "]"}]}], "]"}]}], ")"}], " ", 
                    RowBox[{"sigma", "[", 
                    RowBox[{"[", "jpp", "]"}], "]"}]}], ",", " ", 
                   RowBox[{"{", 
                    RowBox[{"jpp", ",", " ", "3"}], "}"}]}], "]"}]}]}], 
               ")"}]}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"j", ",", " ", "3"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"jp", ",", " ", "3"}], "}"}]}], "]"}]}], ";", "\n", 
          "     ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Max", "[", 
             RowBox[{"Abs", "[", "sum", "]"}], "]"}], ",", " ", 
            RowBox[{"Max", "[", 
             RowBox[{"Abs", "[", 
              RowBox[{"Flatten", "[", "rule", "]"}], "]"}], "]"}]}], 
           "}"}]}]}], "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"SL31Check", "[", 
     RowBox[{"\"\<S-7\>\"", ",", 
      " ", "\"\<sum over j of sigma^LL_j sigma^LL_j = 3 times the unit \
matrix, and sigma_j sigma_j' = delta_jj' + i sum_j'' epsilon_jj'j'' sigma_j'' \
for all nine pairs (components as symbolized symbols)\>\"", ",", "\n", "  ", 
      RowBox[{"check7", " ", "===", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0"}], "}"}]}], ",", " ", "check7"}], "]"}], 
    ";"}]}]}]], "Input",ExpressionUUID->"c93a4c97-ca8d-4fa4-b633-\
16f0796a3b5a"],

Cell[TextData[{
 "S-8, a double sum with a metric: the Minkowski square. The family ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "77e86e7a-b1da-4379-9eaa-a162227ee1dd"],
 " (the coordinates of space-time, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["p", "TI"], "\[LongEqual]", "0", ",", "1", ",", "2", ",", "3"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8cd439f0-933a-4a2b-aad4-63d4f898f5bd"],
 ") and the metric ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Eta]", 
    RowBox[{
     StyleBox["p", "TI"], 
     SuperscriptBox[
      StyleBox["p", "TI"], "\[Prime]"]}], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7fa302f3-93fe-4d3d-a4e5-3f6798be6f63"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5241ae58-1b62-4cc1-a85b-caa39b292f36"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["p", "TI"], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["p", "TI"], "\[Prime]"], "\[LongEqual]", "0"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "adf0f172-3021-4faa-a569-8605fdb68c54"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "528e90c2-9b63-4105-9073-f880fad8faa2"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["p", "TI"], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["p", "TI"], "\[Prime]"], "\[LongEqual]", "1", ",", "2", ",", 
    "3"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "62b71786-30b1-47cf-88f2-95b1897aba25"],
 ", zero otherwise) are symbolized component by component; the double sum ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["p", "TI"], ",", 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox["\[Eta]", 
     RowBox[{
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p", "TI"]], 
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     SuperscriptBox[
      StyleBox["p", "TI"], "\[Prime]"]]}], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9550fb79-bb53-438e-857e-3f91c8d1ea54"],
 " is formed with the 16 components of the metric as free symbols, then the \
metric receives its values and the sum must become ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "0"], ")"}], "2"], "-", 
    UnderscriptBox["\[Sum]", 
     StyleBox["j", "TI"],
     LimitsPositioning->True], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["j", "TI"]], ")"}], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ac3de6de-fb03-47bb-b2b8-4d142894e473"],
 ", with the coordinate components remaining free symbols. The test is \
algebraic: ",
 StyleBox["Expand",
  FontFamily->"Source Code Pro"],
 " and a comparison of polynomials in the four coordinate symbols."
}], "Text",ExpressionUUID->"c00a271b-3f64-4863-8960-dda6055bbbd4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"xs", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ReleaseHold", "[", 
      RowBox[{"SL31Instance", "[", 
       RowBox[{
        RowBox[{"SL31SymbolBoxes", "[", "\"\<x^p_{\\\\rm LL}\>\"", "]"}], ",",
         " ", 
        RowBox[{"{", 
         RowBox[{"\"\<p\>\"", " ", "->", " ", 
          RowBox[{"ToString", "[", "k", "]"}]}], "}"}]}], "]"}], "]"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"etas", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ReleaseHold", "[", 
      RowBox[{"SL31Instance", "[", 
       RowBox[{
        RowBox[{
        "SL31SymbolBoxes", "[", "\"\<\\\\eta^{\\\\rm LL}_{pp'}\>\"", "]"}], ",",
         " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\"\<p\>\"", " ", "->", " ", 
           RowBox[{"ToString", "[", "a", "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{"SuperscriptBox", "[", 
            RowBox[{"\"\<p\>\"", ",", " ", "\"\<\[Prime]\>\""}], "]"}], " ", "->",
            " ", 
           RowBox[{"ToString", "[", "b", "]"}]}]}], "}"}]}], "]"}], "]"}], ",",
      " ", 
     RowBox[{"{", 
      RowBox[{"a", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"b", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"quadratic", " ", "=", " ", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"etas", "[", 
       RowBox[{"[", 
        RowBox[{"a", ",", " ", "b"}], "]"}], "]"}], " ", 
      RowBox[{"xs", "[", 
       RowBox[{"[", "a", "]"}], "]"}], " ", 
      RowBox[{"xs", "[", 
       RowBox[{"[", "b", "]"}], "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"a", ",", " ", "4"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"b", ",", " ", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"minkowski", " ", "=", " ", 
   RowBox[{"Expand", "[", 
    RowBox[{"quadratic", " ", "/.", " ", 
     RowBox[{"Thread", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", "etas", "]"}], " ", "->", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{"DiagonalMatrix", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", 
           RowBox[{"-", "1"}], ",", " ", 
           RowBox[{"-", "1"}], ",", " ", 
           RowBox[{"-", "1"}]}], "}"}], "]"}], "]"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Length", "[", "quadratic", "]"}], ",", " ", "minkowski"}], 
  "}"}]}], "Input",ExpressionUUID->"cf24c4ef-ac10-4851-b3b9-6c1675500d3e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-8\>\"", ",", 
    " ", "\"\<the double sum of eta^LL_pp' x^p x^p' over p, p' = 0..3 (16 + 4 \
symbolized components) is (x^0)^2 - (x^1)^2 - (x^2)^2 - (x^3)^2\>\"", ",", 
    "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"Expand", "[", 
       RowBox[{"minkowski", " ", "-", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"xs", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "^", "2"}], " ", "-", " ", 
          RowBox[{
           RowBox[{"xs", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "^", "2"}], " ", "-", " ", 
          RowBox[{
           RowBox[{"xs", "[", 
            RowBox[{"[", "3", "]"}], "]"}], "^", "2"}], " ", "-", " ", 
          RowBox[{
           RowBox[{"xs", "[", 
            RowBox[{"[", "4", "]"}], "]"}], "^", "2"}]}], ")"}]}], "]"}], " ",
       "===", " ", "0"}], " ", "&&", " ", 
     RowBox[{
      RowBox[{"Length", "[", "quadratic", "]"}], " ", "==", " ", "16"}]}], ",",
     " ", "minkowski"}], "]"}], ";"}]], "Input",ExpressionUUID->"61f5e8e6-\
afed-4a70-a33f-d6d52227af4d"],

Cell[TextData[{
 "S-9, algebra with the symbols of the Higgs mechanism of the superfluid \
boson singlet state. The rest masses of the two charged vector bosons and of \
the vector boson of the fermion number are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["W",
        FontSlant->"Plain"]], ")"}], "2"], "\[LongEqual]", "2", 
    SubsuperscriptBox[
     StyleBox["Z", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["s",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["g", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["v",
        FontSlant->"Plain"]], ")"}], "2"], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["vac",
        FontSlant->"Plain"]], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8720c118-7ac1-432f-98e1-2aeb1d190eba"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["F",
        FontSlant->"Plain"]], ")"}], "2"], "\[LongEqual]", "8", 
    SubsuperscriptBox[
     StyleBox["Z", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["s",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["g", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["F",
        FontSlant->"Plain"]], ")"}], "2"], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["vac",
        FontSlant->"Plain"]], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bb786e90-cb0d-4fc0-8e16-17afa626e965"],
 ", where ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["Z", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["s",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "90c7062d-86df-491b-9409-d99dc3517c6d"],
 " is the stiffness of the space derivatives and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["v",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "beb5e150-a3ad-4eb4-a2d5-3d1788400a68"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["F",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "22e252f2-7645-4899-aa99-a5ba4ba79c60"],
 " are the gauge couplings. The cell checks with ",
 StyleBox["Simplify",
  FontFamily->"Source Code Pro"],
 " that the ratio of the squared masses is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"4", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["g", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], 
        StyleBox["F",
         FontSlant->"Plain"]], "/", 
       SubsuperscriptBox[
        StyleBox["g", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], 
        StyleBox["v",
         FontSlant->"Plain"]]}], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "66632dcd-9af6-4c08-8839-583682ed4d16"],
 ", independent of the stiffness and of the gap, and with ",
 StyleBox["Solve",
  FontFamily->"Source Code Pro"],
 " that the gap can be recovered from ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["M", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["W",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "af5d796b-7849-4e5a-b91d-ff25bd4cffb2"],
 "."
}], "Text",ExpressionUUID->"a0a4a0e4-d127-4372-825a-f6228036af45"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"massRules", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      SubsuperscriptBox["M", "LL", "W"], " ", "->", " ", 
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{"2", " ", 
         SubsuperscriptBox["Z", "LL", "s"]}], "]"}], " ", 
       SubsuperscriptBox["g", "LL", "v"], " ", 
       SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"]}]}], ",", "\n", 
     "   ", 
     RowBox[{
      SubsuperscriptBox["M", "LL", "F"], " ", "->", " ", 
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{"8", " ", 
         SubsuperscriptBox["Z", "LL", "s"]}], "]"}], " ", 
       SubsuperscriptBox["g", "LL", "F"], " ", 
       SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"]}]}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{"ratio", " ", "=", " ", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox["M", "LL", "F"], "/", 
       SubsuperscriptBox["M", "LL", "W"]}], ")"}], "^", "2"}], " ", "/.", " ",
     "massRules"}], "]"}]}]}], "Input",ExpressionUUID->"b1b0feb3-7e02-4c8d-\
b779-8b2e94ced982"],

Cell[BoxData[
 RowBox[{"gapFromMass", " ", "=", " ", 
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      SubsuperscriptBox["M", "LL", "W"], "^", "2"}], " ", "==", " ", 
     RowBox[{"2", " ", 
      SubsuperscriptBox["Z", "LL", "s"], " ", 
      RowBox[{
       SubsuperscriptBox["g", "LL", "v"], "^", "2"}], " ", 
      RowBox[{
       SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], "^", "2"}]}]}], ",",
     " ", 
    SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"]}], "]"}]}]], "Input",Exp\
ressionUUID->"e1aa02cb-7a5b-41de-a813-842555e05489"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-9\>\"", ",", 
    " ", "\"\<(M^F_LL / M^W_LL)^2 = 4 (g^F_LL / g^v_LL)^2 and the gap follows \
from M^W_LL (algebra with symbolized symbols)\>\"", ",", "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{"ratio", " ", "-", " ", 
        RowBox[{"4", " ", 
         RowBox[{
          RowBox[{
           SubsuperscriptBox["g", "LL", "F"], "^", "2"}], "/", 
          RowBox[{
           SubsuperscriptBox["g", "LL", "v"], "^", "2"}]}]}]}], "]"}], " ", "===",
       " ", "0"}], " ", "&&", " ", 
     RowBox[{
      RowBox[{"Length", "[", "gapFromMass", "]"}], " ", "==", " ", "2"}]}], ",",
     " ", "ratio"}], "]"}], ";"}]], "Input",ExpressionUUID->"3112008c-2b3d-\
4f49-b163-dadfa60f8515"],

Cell[TextData[{
 "S-10, the longitudinal vector boson. For a plane wave of wave number ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["k", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["B",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fd75193d-7ae3-4f08-9ca6-ba4dc2a656aa"],
 " and frequency ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Omega]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["B",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "800f6a59-8e16-44a4-b1d2-f21a0804134e"],
 " the time component and the longitudinal component of a massive vector \
field obey two linear equations; their determinant is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox[
         StyleBox["k", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], 
         StyleBox["B",
          FontSlant->"Plain"]], ")"}], "2"], "+", 
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox[
         StyleBox["Z", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], 
         StyleBox["t",
          FontSlant->"Plain"]], "/", 
        SubsuperscriptBox[
         StyleBox["Z", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], 
         StyleBox["s",
          FontSlant->"Plain"]]}], ")"}], 
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox[
         StyleBox["M", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], 
         StyleBox["W",
          FontSlant->"Plain"]], ")"}], "2"]}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox["\[Omega]", 
         StyleBox["LL",
          FontSlant->"Plain"], 
         StyleBox["B",
          FontSlant->"Plain"]], ")"}], "2"], "-", 
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox[
         StyleBox["M", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], 
         StyleBox["W",
          FontSlant->"Plain"]], ")"}], "2"]}], ")"}], "-", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["k", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], 
        StyleBox["B",
         FontSlant->"Plain"]], 
       SubsuperscriptBox["\[Omega]", 
        StyleBox["LL",
         FontSlant->"Plain"], 
        StyleBox["B",
         FontSlant->"Plain"]]}], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fa2d9e84-ad5c-4595-8e6b-e965a2777abb"],
 ", with the mass ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["M", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["W",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "aa24f8e0-f0bc-4d9b-a5df-280651d4a65a"],
 " of the vector boson. The cell checks with ",
 StyleBox["Factor",
  FontFamily->"Source Code Pro"],
 " and ",
 StyleBox["Solve",
  FontFamily->"Source Code Pro"],
 " that it vanishes exactly for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[Omega]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["B",
        FontSlant->"Plain"]], ")"}], "2"], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["W",
        FontSlant->"Plain"]], ")"}], "2"], "+", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["Z", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["s",
        FontSlant->"Plain"]], "/", 
      SubsuperscriptBox[
       StyleBox["Z", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["t",
        FontSlant->"Plain"]]}], ")"}], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["k", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["B",
        FontSlant->"Plain"]], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "67f2c409-7ade-4639-bd87-d53d584ff3d7"],
 ": the absorbed Goldstone boson moves with the velocity ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["Z", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["s",
        FontSlant->"Plain"]], "/", 
      SubsuperscriptBox[
       StyleBox["Z", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["t",
        FontSlant->"Plain"]]}], ")"}], 
    RowBox[{"1", "/", "2"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ecae75ae-42ae-49f2-bf8a-dd408a83aab8"],
 "."
}], "Text",ExpressionUUID->"a8fc1c5f-a0d2-44b7-ad31-ba922a747137"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"det", " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SubsuperscriptBox["k", "LL", "B"], "^", "2"}], " ", "+", " ", 
        RowBox[{
         RowBox[{
          SubsuperscriptBox["Z", "LL", "t"], "/", 
          SubsuperscriptBox["Z", "LL", "s"]}], " ", 
         RowBox[{
          SubsuperscriptBox["M", "LL", "W"], "^", "2"}]}]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SubsuperscriptBox["\[Omega]", "LL", "B"], "^", "2"}], " ", "-", " ", 
        
        RowBox[{
         SubsuperscriptBox["M", "LL", "W"], "^", "2"}]}], ")"}]}], " ", "-", 
     "\n", "   ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox["k", "LL", "B"], " ", 
        SubsuperscriptBox["\[Omega]", "LL", "B"]}], ")"}], "^", "2"}]}]}], 
   ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Solve", " ", "needs", " ", "a", " ", "symbol", " ", "as", " ", 
    RowBox[{"unknown", ":", " ", 
     RowBox[{
     "the", " ", "square", " ", "of", " ", "the", " ", "frequency", " ", "is",
       " ", "called", " ", "w"}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{"root", " ", "=", " ", 
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"det", " ", "/.", " ", 
       RowBox[{
        SubsuperscriptBox["\[Omega]", "LL", "B"], " ", "->", " ", 
        RowBox[{"Sqrt", "[", "w", "]"}]}]}], ")"}], " ", "==", " ", "0"}], ",",
     " ", "w"}], "]"}]}]}], "Input",ExpressionUUID->"b61438de-c58a-428f-a4a5-\
2e3079a9361d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-10\>\"", ",", 
    " ", "\"\<the determinant of the time and longitudinal equations vanishes \
exactly at omega_B^2 = M_W^2 + (Z_s/Z_t) k_B^2\>\"", ",", "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", "root", "]"}], " ", "==", " ", "1"}], " ", "&&", 
     " ", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"w", " ", "/.", " ", 
          RowBox[{"First", "[", "root", "]"}]}], ")"}], " ", "-", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           SubsuperscriptBox["M", "LL", "W"], "^", "2"}], " ", "+", " ", 
          RowBox[{
           RowBox[{
            SubsuperscriptBox["Z", "LL", "s"], "/", 
            SubsuperscriptBox["Z", "LL", "t"]}], " ", 
           RowBox[{
            SubsuperscriptBox["k", "LL", "B"], "^", "2"}]}]}], ")"}]}], "]"}],
       " ", "===", " ", "0"}]}], ",", "\n", "  ", 
    RowBox[{"Factor", "[", "det", "]"}]}], "]"}], ";"}]], "Input",ExpressionUU\
ID->"d8608a44-3cd6-4094-b341-0914a3d7dacc"],

Cell[TextData[{
 "S-11, the sum over the isospin index with the generators ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Iota]"], "\[LongEqual]", 
    SubsuperscriptBox["\[Tau]", "\[Iota]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "/", "2"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f03b60e9-69e1-4497-b369-90e6a3cad10b"],
 ": the Casimir ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SubscriptBox[
       StyleBox["T", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]], ")"}], "2"], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", "\[Iota]",
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Iota]"], 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Iota]"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c4fedbcc-5cf0-4006-b606-8b155788c528"],
 " of the isospin one-half is ",
 Cell[BoxData[
  FormBox[
   FractionBox["3", "4"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4edffabd-bce4-4ca2-86c5-2ba7068adba9"],
 " times the unit matrix. The components ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Tau]", "1", 
     StyleBox["LL",
      FontSlant->"Plain"]], ",", 
    SubsuperscriptBox["\[Tau]", "2", 
     StyleBox["LL",
      FontSlant->"Plain"]], ",", 
    SubsuperscriptBox["\[Tau]", "3", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ae07e3ac-1442-4893-80a6-dcafa5291d53"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], ",", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "2"], ",", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "3"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1482b39d-67ed-46a3-8f6b-226c7ea00a24"],
 " are symbolized; the generators are defined from the Pauli matrices by \
rules."
}], "Text",ExpressionUUID->"c7f07efd-ccae-4e66-b2a9-e1d7a1ba6446"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"taus", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ReleaseHold", "[", 
      RowBox[{"SL31Instance", "[", 
       RowBox[{
        RowBox[{
        "SL31SymbolBoxes", "[", "\"\<\\\\tau^{\\\\rm LL}_\\\\iota\>\"", "]"}],
         ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<\[Iota]\>\"", " ", "->", " ", 
          RowBox[{"ToString", "[", "k", "]"}]}], "}"}]}], "]"}], "]"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Ts", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ReleaseHold", "[", 
      RowBox[{"SL31Instance", "[", 
       RowBox[{
        RowBox[{
        "SL31SymbolBoxes", "[", "\"\<T^\\\\iota_{\\\\rm LL}\>\"", "]"}], ",", 
        " ", 
        RowBox[{"{", 
         RowBox[{"\"\<\[Iota]\>\"", " ", "->", " ", 
          RowBox[{"ToString", "[", "k", "]"}]}], "}"}]}], "]"}], "]"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"casimir", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Ts", "[", 
         RowBox[{"[", "k", "]"}], "]"}], " ", ".", " ", 
        RowBox[{"Ts", "[", 
         RowBox[{"[", "k", "]"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}], " ", "/.", " ", 
     RowBox[{"Thread", "[", 
      RowBox[{"Ts", " ", "->", " ", 
       RowBox[{"taus", "/", "2"}]}], "]"}]}], " ", "/.", " ", 
    RowBox[{"Thread", "[", 
     RowBox[{"taus", " ", "->", " ", "pauliValues"}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-11\>\"", ",", 
    " ", "\"\<the sum over iota of T^iota_LL T^iota_LL (with T = tau/2 for \
the symbolized components) is 3/4 times the unit matrix\>\"", ",", "\n", "  ", 
    RowBox[{"casimir", " ", "===", " ", 
     RowBox[{
      RowBox[{"3", "/", "4"}], " ", 
      RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], ",", " ", "casimir"}], 
   "]"}], ";"}]}], "Input",ExpressionUUID->"d8303623-aa48-4159-b2ed-\
db17bb34abf3"],

Cell["\<\
S-12, uniqueness of the plain-text names: no plain-text name of the registry \
belongs to two different entries (the programs and data files can therefore \
always be read back without ambiguity), and every name maps to one entry.\
\>", "Text",ExpressionUUID->"8e694c4c-30df-4536-bc5b-6a64aa79b41d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"nameToEntries", " ", "=", " ", 
   RowBox[{"GroupBy", "[", 
    RowBox[{
     RowBox[{"Flatten", "[", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{"e", ",", " ", 
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"#", " ", "->", " ", 
              RowBox[{"e", "[", "\"\<entry\>\"", "]"}]}], " ", "&"}], ",", 
            " ", 
            RowBox[{"e", "[", "\"\<names\>\"", "]"}]}], "]"}]}], "]"}], ",", 
        " ", "SL31Registry"}], "]"}], "]"}], ",", " ", 
     RowBox[{"First", " ", "->", " ", "Last"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"shared", " ", "=", " ", 
   RowBox[{"Select", "[", 
    RowBox[{"nameToEntries", ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", 
        RowBox[{"DeleteDuplicates", "[", "#", "]"}], "]"}], " ", ">", " ", 
       "1"}], " ", "&"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-12\>\"", ",", 
    " ", "\"\<no plain-text name is registered for two different entries\>\"",
     ",", "\n", "  ", 
    RowBox[{"shared", " ", "===", " ", 
     RowBox[{"<|", "|>"}]}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Length", "[", "nameToEntries", "]"}], ",", " ", 
      RowBox[{"Normal", "[", "shared", "]"}]}], "}"}]}], "]"}], 
  ";"}]}], "Input",ExpressionUUID->"36620298-4f3f-4064-9078-ea4bb4102331"],

Cell[TextData[{
 "S-13, the kinds that are not symbolized. The imaginary unit ",
 Cell[BoxData[
  FormBox[
   StyleBox["i", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ab67ced4-c6c9-4b65-a649-f5bb39b0b567"],
 " is the Wolfram symbol ",
 StyleBox["I",
  FontFamily->"Source Code Pro"],
 "; the number sets ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[DoubleStruckCapitalR]",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c9c8faaa-1fd1-48ca-8f72-2144b87fff07"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[DoubleStruckCapitalC]",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c3802825-40e7-4032-bf59-d5ed4b086448"],
 " are the Wolfram domains ",
 StyleBox["Reals",
  FontFamily->"Source Code Pro"],
 " and ",
 StyleBox["Complexes",
  FontFamily->"Source Code Pro"],
 " (which the Wolfram Language prints as double-struck letters); the \
operators correspond to Wolfram functions: tr is ",
 StyleBox["Tr",
  FontFamily->"Source Code Pro"],
 ", det is ",
 StyleBox["Det",
  FontFamily->"Source Code Pro"],
 ", diag is ",
 StyleBox["DiagonalMatrix",
  FontFamily->"Source Code Pro"],
 ", Re and Im are ",
 StyleBox["Re",
  FontFamily->"Source Code Pro"],
 " and ",
 StyleBox["Im",
  FontFamily->"Source Code Pro"],
 ", the tensor product ",
 Cell[BoxData[
  FormBox["\[CircleTimes]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5cbe9881-6ab4-4084-9c10-9f1371c1867e"],
 " is ",
 StyleBox["KroneckerProduct",
  FontFamily->"Source Code Pro"],
 ", the transpose ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["", 
    StyleBox["T", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "425bea3b-0c5f-4e20-8c7c-2c4273ac85ab"],
 " is ",
 StyleBox["Transpose",
  FontFamily->"Source Code Pro"],
 ". The test checks each correspondence on the Pauli matrices."
}], "Text",ExpressionUUID->"765b0646-e8e7-4121-8239-756ec533ecbf"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"p1", " ", "=", " ", 
   RowBox[{"pauliValues", "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";", " ", 
  RowBox[{"p2", " ", "=", " ", 
   RowBox[{"pauliValues", "[", 
    RowBox[{"[", "2", "]"}], "]"}]}], ";", " ", 
  RowBox[{"p3", " ", "=", " ", 
   RowBox[{"pauliValues", "[", 
    RowBox[{"[", "3", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"correspondences", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"I", "^", "2"}], " ", "==", " ", 
      RowBox[{"-", "1"}]}], ",", " ", 
     RowBox[{"Element", "[", 
      RowBox[{
       RowBox[{"Sqrt", "[", "2", "]"}], ",", " ", "Reals"}], "]"}], ",", " ", 
     
     RowBox[{"Element", "[", 
      RowBox[{"I", ",", " ", "Complexes"}], "]"}], ",", " ", 
     RowBox[{"!", " ", 
      RowBox[{"Element", "[", 
       RowBox[{"I", ",", " ", "Reals"}], "]"}]}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"Tr", "[", "p3", "]"}], " ", "==", " ", "0"}], ",", " ", 
     RowBox[{
      RowBox[{"Det", "[", "p1", "]"}], " ", "==", " ", 
      RowBox[{"-", "1"}]}], ",", " ", 
     RowBox[{
      RowBox[{"DiagonalMatrix", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", 
         RowBox[{"-", "1"}]}], "}"}], "]"}], " ", "==", " ", "p3"}], ",", " ", 
     RowBox[{
      RowBox[{"Re", "[", "p2", "]"}], " ", "==", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}]}], ",", " ", 
     RowBox[{
      RowBox[{"Im", "[", "p2", "]"}], " ", "==", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", 
          RowBox[{"-", "1"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "0"}], "}"}]}], "}"}]}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"p1", ",", " ", "p3"}], "]"}], " ", ".", " ", 
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"p1", ",", " ", "p3"}], "]"}]}], " ", "==", " ", 
      RowBox[{"IdentityMatrix", "[", "4", "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{"Transpose", "[", "p2", "]"}], " ", "==", " ", 
      RowBox[{"-", "p2"}]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-13\>\"", ",", 
    " ", "\"\<the imaginary unit, the number sets and the operators \
correspond to I, Reals, Complexes, Tr, Det, DiagonalMatrix, Re, Im, \
KroneckerProduct, Transpose\>\"", ",", "\n", "  ", 
    RowBox[{"And", " ", "@@", " ", "correspondences"}], ",", " ", 
    "correspondences"}], "]"}], ";"}]}], "Input",ExpressionUUID->"3009aa90-\
51cb-4edf-bb39-db908a2e0dab"],

Cell[TextData[{
 "S-15, the reader of formulas (section I.3). (a) Eighteen formulas whose \
reading is known are converted and their readings on one line are compared \
with the known readings; among them are the cases that the TeX importer of \
the Wolfram Language reads wrongly (a fraction with arguments without braces, \
and ",
 StyleBox["\\hbar",
  FontFamily->"Source Code Pro"],
 "). (b) Every formula in the meanings of the registry is converted: the \
reader must report no problem, the number of fraction boxes must equal the \
number of the commands ",
 StyleBox["\\frac",
  FontFamily->"Source Code Pro"],
 " and ",
 StyleBox["\\tfrac",
  FontFamily->"Source Code Pro"],
 " in the TeX, the number of root boxes must equal the number of the commands \
",
 StyleBox["\\sqrt",
  FontFamily->"Source Code Pro"],
 ", and no fraction box may have an empty numerator or denominator. (c) A \
name is not a product: the boxes of ",
 StyleBox["x5",
  FontFamily->"Source Code Pro"],
 " must be the letter, the character ",
 StyleBox["\\[InvisibleSpace]",
  FontFamily->"Source Code Pro"],
 " and the number, and the boxes of ",
 StyleBox["5x",
  FontFamily->"Source Code Pro"],
 " the number and the letter with nothing between them (a product, between \
whose factors the front end puts its thin space); the last number of the \
result counts the names of this kind in the meanings of the registry (the \
three coordinates ",
 StyleBox["x5",
  FontFamily->"Source Code Pro"],
 ", ",
 StyleBox["x6",
  FontFamily->"Source Code Pro"],
 ", ",
 StyleBox["x7",
  FontFamily->"Source Code Pro"],
 ")."
}], "Text",ExpressionUUID->"4ceec77c-5f5f-4c16-8a2b-73c2d6221787"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"cases15", " ", "=", " ", 
   RowBox[{"{", "\n", "   ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<\\\\tfrac12\\\\ell^{\\\\rm x}_{\\\\rm LL}g^{\\\\rm \
v}_{\\\\rm LL}\>\"", ",", 
       " ", "\"\<frac{1}{2}\[ScriptL]_{LL}^{x}g_{LL}^{v}\>\""}], "}"}], ",", 
     "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"\"\<Q_{\\\\rm LL}=-\\\\tfrac12\>\"", ",", 
       " ", "\"\<Q_{LL}=-frac{1}{2}\>\""}], "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"\"\<\\\\cos(\\\\tfrac12\\\\vartheta^{\\\\rm B}_{\\\\rm \
LL})\>\"", ",", " ", "\"\<cos(frac{1}{2}\[CurlyTheta]_{LL}^{B})\>\""}], "}"}],
      ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"\"\<-\\\\tfrac{15}8\\\\int_{q_{\\\\rm LL}<\\\\Lambda_{\\\\rm \
LL}}d^3q_{\\\\rm LL}\>\"", ",", 
       " ", "\"\<-frac{15}{8}\[Integral]_{q_{LL}<\[CapitalLambda]_{LL}}d^{3}q_\
{LL}\>\""}], "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"\"\<\\\\tfrac i2(y^+_{\\\\rm LL}-y^-_{\\\\rm LL})\>\"", ",", 
       " ", "\"\<frac{i}{2}(y_{LL}^{+}-y_{LL}^{-})\>\""}], "}"}], ",", "\n", 
     "   ", 
     RowBox[{"{", 
      RowBox[{"\"\<\\\\frac{r^{\\\\rm W}_{\\\\rm LL}}{2\\\\ell^{\\\\rm x}_{\\\
\\rm LL}}\\\\beta_{\\\\rm LL}\>\"", ",", 
       " ", "\"\<frac{r_{LL}^{W}}{2\[ScriptL]_{LL}^{x}}\[Beta]_{LL}\>\""}], 
      "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"\"\<\\\\sqrt2\\\\,\\\\ell^{\\\\rm x}_{\\\\rm LL}\>\"", ",", 
       " ", "\"\<sqrt{2}\[ScriptL]_{LL}^{x}\>\""}], "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"\"\<\\\\sqrt{2n^{\\\\rm cpx}_{\\\\rm LL}}\>\"", ",", 
       " ", "\"\<sqrt{2n_{LL}^{cpx}}\>\""}], "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"\"\<5\\\\times10^{-11}\>\"", ",", 
       " ", "\"\<5\[Times]10^{-11}\>\""}], "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"\"\<(q_{\\\\rm LL}^2+(M^{\\\\rm q}_{\\\\rm LL})^2)^{-7/2}\>\"",
        ",", " ", "\"\<(q_{LL}^{2}+(M_{LL}^{q})^{2})^{-7/2}\>\""}], "}"}], ",",
      "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"\"\<\\\\mathbf e_p\>\"", ",", " ", "\"\<<bf:e>_{p}\>\""}], 
      "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"\"\<\\\\mathsf K^3_{\\\\rm LL}\>\"", ",", 
       " ", "\"\<<sf:K>_{LL}^{3}\>\""}], "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"\"\<\\\\bar\\\\Psi_{\\\\rm LL}\>\"", ",", 
       " ", "\"\<over{\[CapitalPsi]}{_}_{LL}\>\""}], "}"}], ",", "\n", "   ", 
     
     RowBox[{"{", 
      RowBox[{"\"\<\\\\lvert\\\\vec d_{\\\\rm LL}\\\\rvert^2\>\"", ",", 
       " ", "\"\<|over{d}{\[RightVector]}_{LL}|^{2}\>\""}], "}"}], ",", "\n", 
     "   ", 
     RowBox[{"{", 
      RowBox[{"\"\<\\\\sum_{p=0}^3\\\\xi^{\\\\rm LL}_p(\\\\mathbf \
b)\\\\mathbf e_p\>\"", ",", 
       " ", "\"\<\[Sum]_{p=0}^{3}\[Xi]_{p}^{LL}(<bf:b>)<bf:e>_{p}\>\""}], 
      "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"\"\<\\\\begin{pmatrix}0&-i\\\\\\\\i&0\\\\end{pmatrix}\>\"", ",",
        " ", "\"\<(grid[0&-i;i&0])\>\""}], "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"\"\<\\\\hbar\>\"", ",", " ", "\"\<\[HBar]\>\""}], "}"}], ",", 
     "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"\"\<x5,x6,x7\>\"", ",", " ", "\"\<x5,x6,x7\>\""}], "}"}]}], 
    "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"readings15", " ", "=", " ", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"SL31FormulaReading", "[", 
        RowBox[{"SL31TeXFormula", "[", 
