                RowBox[{"5", " ", ";;", " ", "8"}]}], "]"}], "]"}]}], ",", 
            " ", 
            RowBox[{"{", 
             RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], ";",
          "\n", "   ", 
         RowBox[{"ll", " ", "=", " ", 
          RowBox[{"Sum", "[", 
