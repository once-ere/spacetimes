Cell["\<\
II.1.2 Complex numbers and matrices (t2core/src/c64.rs and cmat.rs)\
\>", "Subsection",ExpressionUUID->"b44b93b5-a390-44a0-982f-5559d30259f2"],

Cell[TextData[{
 "The Rust library defines its own complex numbers (c64.rs) and dense complex \
matrices (cmat.rs). The Wolfram Language has both built in: a complex number \
is ",
 StyleBox["a + I b",
  FontFamily->"Source Code Pro"],
 "; a matrix is a list of rows; ",
 StyleBox[".",
  FontFamily->"Source Code Pro"],
 " (Dot) is the matrix product, ",
 StyleBox["ConjugateTranspose",
  FontFamily->"Source Code Pro"],
 " the Hermitian conjugate, ",
 StyleBox["KroneckerProduct",
  FontFamily->"Source Code Pro"],
 " the Kronecker product with the same index convention as the library (every \
entry of the product is the product of one entry of the first matrix and one \
entry of the second; its row is the pair of their rows and its column the \
pair of their columns, the row or column of the first matrix being the slower \
of the two), ",
 StyleBox["Tr",
  FontFamily->"Source Code Pro"],
 " the trace and ",
 StyleBox["Norm[m, \"Frobenius\"]",
  FontFamily->"Source Code Pro"],
 " the Frobenius norm. Three routines of cmat.rs are rewritten here because \
the programs and their checks use them: the inverse of a ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{"2", "\[Cross]", "2"}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"2789ecbc-b97d-49aa-b556-ab8c503b4708"]], "InlineFormula",
  ExpressionUUID->"190e32f1-13f6-4f69-8844-fa057b9c5fed"],
 " matrix by its explicit formula, the matrix exponential by scaling and \
squaring of the Taylor series, and the Hermitian eigensolver."
}], "Text",ExpressionUUID->"252e4bc2-1e84-43f2-9324-8b7c435697e8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "the", " ", "determinant", " ", "and", " ", "the", " ", "inverse", " ", 
     "of", " ", "a", " ", "2", " ", "x", " ", "2", " ", "matrix"}], ",", " ", 
    
    RowBox[{"by", " ", "the", " ", "explicit", " ", "formulas", " ", "of", " ", 
     RowBox[{"cmat", ".", "rs"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"t2det2", "[", "m_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"m", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], " ", 
       RowBox[{"m", "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", " ", "2"}], "]"}], "]"}]}], " ", "-", " ", 
      RowBox[{
       RowBox[{"m", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", " ", "2"}], "]"}], "]"}], " ", 
       RowBox[{"m", "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", " ", "1"}], "]"}], "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2inv2", "[", "m_", "]"}], " ", ":=", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"d", " ", "=", " ", 
         RowBox[{"t2det2", "[", "m", "]"}]}], "}"}], ",", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"m", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", " ", "2"}], "]"}], "]"}], ",", " ", 
            RowBox[{"-", 
             RowBox[{"m", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", " ", "2"}], "]"}], "]"}]}]}], "}"}], ",", 
          " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"m", "[", 
              RowBox[{"[", 
               RowBox[{"2", ",", " ", "1"}], "]"}], "]"}]}], ",", " ", 
            RowBox[{"m", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", " ", "1"}], "]"}], "]"}]}], "}"}]}], "}"}], "/",
         "d"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "principal", " ", "square", " ", "root", " ", "of", " ", "a",
       " ", "complex", " ", "number"}], ",", " ", 
     RowBox[{"as", " ", "in", " ", 
      RowBox[{"c64", ".", 
       RowBox[{"rs", ":", " ", 
        RowBox[{"|", "z", "|", 
         RowBox[{
          RowBox[{"^", 
           RowBox[{"(", 
            RowBox[{"1", "/", "2"}], ")"}]}], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"cos", 
             RowBox[{"(", 
              RowBox[{"arg", " ", 
               RowBox[{"z", "/", "2"}]}], ")"}]}], " ", "+", " ", 
            RowBox[{"i", " ", "sin", 
             RowBox[{"(", 
              RowBox[{"arg", " ", 
               RowBox[{"z", "/", "2"}]}], ")"}]}]}], ")"}]}]}]}]}]}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2csqrt", "[", "z_", "]"}], " ", ":=", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"r", " ", "=", " ", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"Abs", "[", "z", "]"}], "]"}]}], ",", " ", 
         RowBox[{"th", " ", "=", " ", 
          RowBox[{
           RowBox[{"Arg", "[", "z", "]"}], "/", "2"}]}]}], "}"}], ",", " ", 
       RowBox[{
        RowBox[{"r", " ", 
         RowBox[{"Cos", "[", "th", "]"}]}], " ", "+", " ", 
        RowBox[{"I", " ", "r", " ", 
         RowBox[{"Sin", "[", "th", "]"}]}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", "matrix", " ", "exponential", " ", "of", " ", 
      RowBox[{"cmat", ".", 
       RowBox[{"rs", ":", " ", 
        RowBox[{
        "halve", " ", "the", " ", "matrix", " ", "until", " ", "its", " ", 
         "Frobenius", " ", "norm", " ", "is", " ", "at", " ", "most", " ", 
         RowBox[{"1", "/", "4"}]}]}]}]}], ",", " ", 
     RowBox[{"sum", "\n", "   ", "the", " ", "Taylor", " ", "series", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"at", " ", "most", " ", "29", " ", "terms"}], ",", " ", 
        RowBox[{
         RowBox[{
         "stopping", " ", "when", " ", "a", " ", "term", " ", "is", " ", 
          "smaller", " ", "than", " ", "1", "e"}], "-", "18"}]}], ")"}]}], ",",
      " ", 
     RowBox[{
     "then", " ", "square", " ", "the", "\n", "   ", "result", " ", "as", " ",
       "often", " ", "as", " ", "the", " ", "matrix", " ", "was", " ", 
      "halved"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2expm", "[", "m_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"n", " ", "=", " ", 
          RowBox[{"Length", "[", "m", "]"}]}], ",", " ", 
         RowBox[{"nrm", " ", "=", " ", 
          RowBox[{"Norm", "[", 
           RowBox[{"m", ",", " ", "\"\<Frobenius\>\""}], "]"}]}], ",", " ", 
         RowBox[{"s", " ", "=", " ", "0"}], ",", " ", 
         RowBox[{"scale", " ", "=", " ", "1."}], ",", " ", "x", ",", " ", 
         "term", ",", " ", "sum"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"nrm", " ", "scale"}], " ", ">", " ", "0.25"}], ",", " ", 
          RowBox[{
           RowBox[{"scale", " ", "*=", " ", "0.5"}], ";", " ", 
           RowBox[{"s", "++"}]}]}], "]"}], ";", "\n", "   ", 
        RowBox[{"x", " ", "=", " ", 
         RowBox[{"scale", " ", "m"}]}], ";", "\n", "   ", 
        RowBox[{"term", " ", "=", " ", 
         RowBox[{"IdentityMatrix", "[", "n", "]"}]}], ";", " ", 
        RowBox[{"sum", " ", "=", " ", 
         RowBox[{"IdentityMatrix", "[", "n", "]"}]}], ";", "\n", "   ", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"term", " ", "=", " ", 
            RowBox[{
             RowBox[{"term", " ", ".", " ", "x"}], "/", "k"}]}], ";", " ", 
           RowBox[{"sum", " ", "=", " ", 
            RowBox[{"sum", " ", "+", " ", "term"}]}], ";", " ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Norm", "[", 
               RowBox[{"term", ",", " ", "\"\<Frobenius\>\""}], "]"}], " ", "<",
               " ", "1*^-18"}], ",", " ", 
             RowBox[{"Break", "[", "]"}]}], "]"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"k", ",", " ", "1", ",", " ", "29"}], "}"}]}], "]"}], ";", 
        "\n", "   ", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"sum", " ", "=", " ", 
           RowBox[{"sum", " ", ".", " ", "sum"}]}], ",", " ", 
          RowBox[{"{", "s", "}"}]}], "]"}], ";", "\n", "   ", "sum"}]}], 
      "]"}]}], ";"}]}]}]], "Input",ExpressionUUID->"ed8d28aa-b0a3-4dac-88d7-\
4d14eee44e13"],

Cell[TextData[{
 "The Hermitian eigensolver ",
 StyleBox["eigh",
  FontFamily->"Source Code Pro"],
 " of cmat.rs finds all eigenvalues and eigenvectors of a complex Hermitian \
matrix (called ",
 StyleBox["a",
  FontFamily->"Source Code Pro"],
 " in the code) in two stages. (1) Householder reduction: for every column ",
 StyleBox["k",
  FontFamily->"Source Code Pro"],
 " a reflection (the unit matrix minus twice the projector on a complex unit \
vector ",
 StyleBox["vv",
  FontFamily->"Source Code Pro"],
 ") is chosen that sets to zero all entries of the column below the \
subdiagonal; applied from both sides it keeps the eigenvalues and turns ",
 StyleBox["a",
  FontFamily->"Source Code Pro"],
 " step by step into a tridiagonal matrix, and the product of the reflections \
is accumulated in the matrix ",
 StyleBox["q",
  FontFamily->"Source Code Pro"],
 ". The complex subdiagonal entries are then made real and non-negative by a \
diagonal unitary matrix of phases. (2) The implicit QL algorithm with \
Wilkinson shifts: plane rotations, applied to the real symmetric tridiagonal \
matrix, drive its off-diagonal entries to zero; the diagonal then holds the \
eigenvalues, and the accumulated rotations, multiplied by ",
 StyleBox["q",
  FontFamily->"Source Code Pro"],
 ", give the eigenvectors. The function below follows the Rust code step by \
step (the indices are shifted by one, because lists of the Wolfram Language \
begin at position 1); the vector operations of the Wolfram Language replace \
the inner loops."
}], "Text",ExpressionUUID->"30160ef5-3ac8-4de7-8cb0-435a64416551"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"t2eigh", "[", "m_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"n", " ", "=", " ", 
        RowBox[{"Length", "[", "m", "]"}]}], ",", " ", "a", ",", " ", "q", ",",
        " ", "vv", ",", " ", "p", ",", " ", "w", ",", " ", "x", ",", " ", 
       "xnorm", ",", " ", "x0", ",", " ", "phase", ",", " ", "alpha", ",", 
       " ", "vn", ",", " ", "kk", ",", " ", "s", ",", " ", "d", ",", " ", "e",
        ",", " ", "ph", ",", " ", "sub", ",", " ", "r", ",", " ", "zt", ",", 
       "\n", "    ", "iter", ",", " ", "mm", ",", " ", "dd", ",", " ", "g", ",",
        " ", "sr", ",", " ", "cr", ",", " ", "pp", ",", " ", "i", ",", " ", 
       "f", ",", " ", "b", ",", " ", "underflow", ",", " ", "idx", ",", " ", 
       "z0", ",", " ", "z1"}], "}"}], ",", "\n", "   ", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"stage", " ", "1"}], ":", " ", 
       RowBox[{
       "the", " ", "Householder", " ", "reduction", " ", "of", " ", "the", " ",
         "Hermitian", " ", "part", " ", "of", " ", "m"}]}], " ", "*)"}], "\n",
      "   ", 
     RowBox[{
      RowBox[{"a", " ", "=", " ", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"m", " ", "+", " ", 
           RowBox[{"ConjugateTranspose", "[", "m", "]"}]}], ")"}], "/", "2"}],
         "]"}]}], ";", "\n", "   ", 
      RowBox[{"q", " ", "=", " ", 
       RowBox[{
        RowBox[{"N", "[", 
         RowBox[{"IdentityMatrix", "[", "n", "]"}], "]"}], " ", "+", " ", 
        RowBox[{"0.", " ", "I"}]}]}], ";", "\n", "   ", 
      RowBox[{"Do", "[", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"x", " ", "=", " ", 
          RowBox[{"a", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{
              RowBox[{"k", " ", "+", " ", "1"}], " ", ";;", " ", "n"}], ",", 
             " ", "k"}], "]"}], "]"}]}], ";", "\n", "    ", 
         RowBox[{"xnorm", " ", "=", " ", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"Total", "[", 
            RowBox[{
             RowBox[{"Abs", "[", "x", "]"}], "^", "2"}], "]"}], "]"}]}], ";", 
         "\n", "    ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"xnorm", " ", "<", " ", "1*^-300"}], ",", " ", 
           RowBox[{"Continue", "[", "]"}]}], "]"}], ";", "\n", "    ", 
         RowBox[{"x0", " ", "=", " ", 
          RowBox[{"a", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"k", " ", "+", " ", "1"}], ",", " ", "k"}], "]"}], 
           "]"}]}], ";", "\n", "    ", 
         RowBox[{"phase", " ", "=", " ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", "x0", "]"}], " ", ">", " ", "0"}], ",", " ", 
            
            RowBox[{"x0", "/", 
             RowBox[{"Abs", "[", "x0", "]"}]}], ",", " ", "1."}], "]"}]}], ";",
          "\n", "    ", 
         RowBox[{"alpha", " ", "=", " ", 
          RowBox[{
           RowBox[{"-", "phase"}], " ", "xnorm"}]}], ";", "\n", "    ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{"v", " ", "=", " ", 
            RowBox[{"x", " ", "-", " ", 
             RowBox[{"alpha", " ", "e1"}]}]}], ",", " ", 
           RowBox[{"normalized", ";", " ", 
            RowBox[{
             RowBox[{
              RowBox[{
              "v", " ", "vanishes", " ", "in", " ", "the", " ", "positions", " ",
                "1"}], ".."}], "k"}]}]}], " ", "*)"}], "\n", "    ", 
         RowBox[{"vv", " ", "=", " ", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{
            RowBox[{"0.", " ", "+", " ", 
             RowBox[{"0.", " ", "I"}]}], ",", " ", "n"}], "]"}]}], ";", "\n", 
         "    ", 
         RowBox[{
          RowBox[{"vv", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"k", " ", "+", " ", "1"}], " ", ";;", " ", "n"}], "]"}], 
           "]"}], " ", "=", " ", "x"}], ";", "\n", "    ", 
         RowBox[{
          RowBox[{"vv", "[", 
           RowBox[{"[", 
            RowBox[{"k", " ", "+", " ", "1"}], "]"}], "]"}], " ", "=", " ", 
          RowBox[{
           RowBox[{"vv", "[", 
            RowBox[{"[", 
             RowBox[{"k", " ", "+", " ", "1"}], "]"}], "]"}], " ", "-", " ", 
           "alpha"}]}], ";", "\n", "    ", 
         RowBox[{"vn", " ", "=", " ", 
          RowBox[{"Norm", "[", "vv", "]"}]}], ";", "\n", "    ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"vn", " ", "<", " ", "1*^-300"}], ",", " ", 
           RowBox[{"Continue", "[", "]"}]}], "]"}], ";", "\n", "    ", 
         RowBox[{
          RowBox[{"vv", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"k", " ", "+", " ", "1"}], " ", ";;", " ", "n"}], "]"}], 
           "]"}], " ", "=", " ", 
          RowBox[{
           RowBox[{"vv", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"k", " ", "+", " ", "1"}], " ", ";;", " ", "n"}], "]"}],
             "]"}], "/", "vn"}]}], ";", "\n", "    ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"H", " ", "a", " ", "H"}], " ", "=", " ", 
            RowBox[{
             RowBox[{"a", " ", "-", " ", 
              RowBox[{"2", " ", "v", " ", 
               RowBox[{"w", "^", "dag"}]}], " ", "-", " ", 
              RowBox[{"2", " ", "w", " ", 
               RowBox[{"v", "^", "dag"}], " ", "with", " ", "p"}]}], " ", "=",
              " ", 
             RowBox[{"a", " ", "v"}]}]}], ",", " ", 
           RowBox[{"K", " ", "=", " ", 
            RowBox[{
             RowBox[{"v", "^", "dag"}], " ", "p"}]}], ",", " ", 
           RowBox[{"w", " ", "=", " ", 
            RowBox[{"p", " ", "-", " ", 
             RowBox[{"K", " ", "v"}]}]}]}], " ", "*)"}], "\n", "    ", 
         RowBox[{"p", " ", "=", " ", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{
            RowBox[{"0.", " ", "+", " ", 
             RowBox[{"0.", " ", "I"}]}], ",", " ", "n"}], "]"}]}], ";", "\n", 
         "    ", 
         RowBox[{
          RowBox[{"p", "[", 
           RowBox[{"[", 
            RowBox[{"k", " ", ";;", " ", "n"}], "]"}], "]"}], " ", "=", " ", 
          RowBox[{
           RowBox[{"a", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"k", " ", ";;", " ", "n"}], ",", " ", 
              RowBox[{
               RowBox[{"k", " ", "+", " ", "1"}], " ", ";;", " ", "n"}]}], 
             "]"}], "]"}], " ", ".", " ", 
           RowBox[{"vv", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"k", " ", "+", " ", "1"}], " ", ";;", " ", "n"}], "]"}],
             "]"}]}]}], ";", "\n", "    ", 
         RowBox[{"kk", " ", "=", " ", 
          RowBox[{
           RowBox[{"Conjugate", "[", 
            RowBox[{"vv", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"k", " ", "+", " ", "1"}], " ", ";;", " ", "n"}], 
              "]"}], "]"}], "]"}], " ", ".", " ", 
           RowBox[{"p", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"k", " ", "+", " ", "1"}], " ", ";;", " ", "n"}], "]"}],
             "]"}]}]}], ";", "\n", "    ", 
         RowBox[{"w", " ", "=", " ", 
          RowBox[{"p", " ", "-", " ", 
           RowBox[{"vv", " ", "kk"}]}]}], ";", "\n", "    ", 
         RowBox[{
          RowBox[{"a", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"k", " ", ";;", " ", "n"}], ",", " ", 
             RowBox[{"k", " ", ";;", " ", "n"}]}], "]"}], "]"}], " ", "=", 
          " ", 
          RowBox[{
           RowBox[{"a", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"k", " ", ";;", " ", "n"}], ",", " ", 
              RowBox[{"k", " ", ";;", " ", "n"}]}], "]"}], "]"}], " ", "-", 
           "\n", "      ", 
           RowBox[{"2", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Outer", "[", 
               RowBox[{"Times", ",", " ", 
                RowBox[{"vv", "[", 
                 RowBox[{"[", 
                  RowBox[{"k", " ", ";;", " ", "n"}], "]"}], "]"}], ",", " ", 
                
                RowBox[{"Conjugate", "[", 
                 RowBox[{"w", "[", 
                  RowBox[{"[", 
                   RowBox[{"k", " ", ";;", " ", "n"}], "]"}], "]"}], "]"}]}], 
               "]"}], " ", "+", " ", 
              RowBox[{"Outer", "[", 
               RowBox[{"Times", ",", " ", 
                RowBox[{"w", "[", 
                 RowBox[{"[", 
                  RowBox[{"k", " ", ";;", " ", "n"}], "]"}], "]"}], ",", " ", 
                
                RowBox[{"Conjugate", "[", 
                 RowBox[{"vv", "[", 
                  RowBox[{"[", 
                   RowBox[{"k", " ", ";;", " ", "n"}], "]"}], "]"}], "]"}]}], 
               "]"}]}], ")"}]}]}]}], ";", "\n", "    ", 
         RowBox[{"(*", " ", 
          RowBox[{"q", " ", "<", 
           RowBox[{
            RowBox[{"-", " ", "q"}], " ", "H"}]}], " ", "*)"}], "\n", "    ", 
         
         RowBox[{"s", " ", "=", " ", 
          RowBox[{
           RowBox[{"q", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", " ", 
              RowBox[{
               RowBox[{"k", " ", "+", " ", "1"}], " ", ";;", " ", "n"}]}], 
             "]"}], "]"}], " ", ".", " ", 
           RowBox[{"vv", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"k", " ", "+", " ", "1"}], " ", ";;", " ", "n"}], "]"}],
             "]"}]}]}], ";", "\n", "    ", 
         RowBox[{
          RowBox[{"q", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", 
             RowBox[{
              RowBox[{"k", " ", "+", " ", "1"}], " ", ";;", " ", "n"}]}], 
            "]"}], "]"}], " ", "=", " ", 
          RowBox[{
           RowBox[{"q", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", " ", 
              RowBox[{
               RowBox[{"k", " ", "+", " ", "1"}], " ", ";;", " ", "n"}]}], 
             "]"}], "]"}], " ", "-", " ", 
           RowBox[{"2", " ", 
            RowBox[{"Outer", "[", 
             RowBox[{"Times", ",", " ", "s", ",", " ", 
              RowBox[{"Conjugate", "[", 
               RowBox[{"vv", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"k", " ", "+", " ", "1"}], " ", ";;", " ", "n"}], 
                 "]"}], "]"}], "]"}]}], "]"}]}]}]}]}], ",", "\n", "    ", 
        RowBox[{"{", 
         RowBox[{"k", ",", " ", "1", ",", " ", 
          RowBox[{"n", " ", "-", " ", "2"}]}], "}"}]}], "]"}], ";", "\n", 
      "   ", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"the", " ", "tridiagonal", " ", 
         RowBox[{"matrix", ":", " ", 
          RowBox[{"real", " ", "diagonal", " ", "d"}]}]}], ",", " ", 
        RowBox[{
         RowBox[{"complex", " ", "subdiagonal"}], ";", " ", 
         RowBox[{
         "the", " ", "phases", " ", "ph", " ", "make", " ", "it", " ", 
          "real"}]}]}], " ", "*)"}], "\n", "   ", 
      RowBox[{"d", " ", "=", " ", 
       RowBox[{"Re", "[", 
        RowBox[{"Diagonal", "[", "a", "]"}], "]"}]}], ";", "\n", "   ", 
      RowBox[{"e", " ", "=", " ", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0.", ",", " ", "n"}], "]"}]}], ";", "\n", "   ", 
      RowBox[{"ph", " ", "=", " ", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{
         RowBox[{"1.", " ", "+", " ", 
          RowBox[{"0.", " ", "I"}]}], ",", " ", "n"}], "]"}]}], ";", "\n", 
      "   ", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"sub", " ", "=", " ", 
          RowBox[{"a", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", " ", 
             RowBox[{"i", " ", "-", " ", "1"}]}], "]"}], "]"}]}], ";", " ", 
         RowBox[{"r", " ", "=", " ", 
          RowBox[{"Abs", "[", "sub", "]"}]}], ";", "\n", "    ", 
         RowBox[{
          RowBox[{"ph", "[", 
           RowBox[{"[", "i", "]"}], "]"}], " ", "=", " ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"r", " ", ">", " ", "0"}], ",", " ", 
            RowBox[{"sub", " ", 
             RowBox[{
              RowBox[{"ph", "[", 
               RowBox[{"[", 
                RowBox[{"i", " ", "-", " ", "1"}], "]"}], "]"}], "/", "r"}]}],
             ",", " ", 
            RowBox[{"ph", "[", 
             RowBox[{"[", 
              RowBox[{"i", " ", "-", " ", "1"}], "]"}], "]"}]}], "]"}]}], ";",
          "\n", "    ", 
         RowBox[{
          RowBox[{"e", "[", 
           RowBox[{"[", "i", "]"}], "]"}], " ", "=", " ", "r"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", "2", ",", " ", "n"}], "}"}]}], "]"}], ";", 
      "\n", "   ", 
      RowBox[{"q", " ", "=", " ", 
       RowBox[{"q", " ", ".", " ", 
        RowBox[{"DiagonalMatrix", "[", "ph", "]"}]}]}], ";", "\n", "   ", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"stage", " ", "2"}], ":", " ", 
         RowBox[{"the", " ", "implicit", " ", "QL", " ", "algorithm", " ", 
          RowBox[{"(", "tqli", ")"}]}]}], ";", " ", 
        RowBox[{
        "zt", " ", "holds", " ", "the", " ", "transposed", " ", "rotation", " ",
          "matrix"}]}], " ", "*)"}], "\n", "   ", 
      RowBox[{"zt", " ", "=", " ", 
       RowBox[{"N", "[", 
        RowBox[{"IdentityMatrix", "[", "n", "]"}], "]"}]}], ";", "\n", "   ", 
      
      RowBox[{"e", " ", "=", " ", 
       RowBox[{"Append", "[", 
        RowBox[{
         RowBox[{"Rest", "[", "e", "]"}], ",", " ", "0."}], "]"}]}], ";", 
      "\n", "   ", 
      RowBox[{"Do", "[", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"iter", " ", "=", " ", "0"}], ";", "\n", "    ", 
         RowBox[{"While", "[", 
          RowBox[{"True", ",", "\n", "     ", 
           RowBox[{
            RowBox[{"mm", " ", "=", " ", "l"}], ";", "\n", "     ", 
            RowBox[{"While", "[", 
             RowBox[{
              RowBox[{"mm", " ", "<", " ", "n"}], ",", " ", 
              RowBox[{
               RowBox[{"dd", " ", "=", " ", 
                RowBox[{
                 RowBox[{"Abs", "[", 
                  RowBox[{"d", "[", 
                   RowBox[{"[", "mm", "]"}], "]"}], "]"}], " ", "+", " ", 
                 RowBox[{"Abs", "[", 
                  RowBox[{"d", "[", 
                   RowBox[{"[", 
                    RowBox[{"mm", " ", "+", " ", "1"}], "]"}], "]"}], 
                  "]"}]}]}], ";", " ", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Abs", "[", 
                   RowBox[{"e", "[", 
                    RowBox[{"[", "mm", "]"}], "]"}], "]"}], " ", "<=", " ", 
                  RowBox[{"$MachineEpsilon", " ", "dd"}]}], ",", " ", 
                 RowBox[{"Break", "[", "]"}]}], "]"}], ";", " ", 
               RowBox[{"mm", "++"}]}]}], "]"}], ";", "\n", "     ", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"mm", " ", "==", " ", "l"}], ",", " ", 
              RowBox[{"Break", "[", "]"}]}], "]"}], ";", "\n", "     ", 
            RowBox[{"iter", "++"}], ";", " ", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"iter", " ", ">", " ", "60"}], ",", " ", 
              RowBox[{"Break", "[", "]"}]}], "]"}], ";", "\n", "     ", 
            RowBox[{"g", " ", "=", " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"d", "[", 
                 RowBox[{"[", 
                  RowBox[{"l", " ", "+", " ", "1"}], "]"}], "]"}], " ", "-", 
                " ", 
                RowBox[{"d", "[", 
                 RowBox[{"[", "l", "]"}], "]"}]}], ")"}], "/", 
              RowBox[{"(", 
               RowBox[{"2", " ", 
                RowBox[{"e", "[", 
                 RowBox[{"[", "l", "]"}], "]"}]}], ")"}]}]}], ";", "\n", 
            "     ", 
            RowBox[{"r", " ", "=", " ", 
             RowBox[{"Sqrt", "[", 
              RowBox[{
               RowBox[{"g", "^", "2"}], " ", "+", " ", "1."}], "]"}]}], ";", 
            "\n", "     ", 
            RowBox[{"g", " ", "=", " ", 
             RowBox[{
              RowBox[{"d", "[", 
               RowBox[{"[", "mm", "]"}], "]"}], " ", "-", " ", 
              RowBox[{"d", "[", 
               RowBox[{"[", "l", "]"}], "]"}], " ", "+", " ", 
              RowBox[{
               RowBox[{"e", "[", 
                RowBox[{"[", "l", "]"}], "]"}], "/", 
               RowBox[{"(", 
                RowBox[{"g", " ", "+", " ", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"g", " ", ">=", " ", "0"}], ",", " ", 
                   RowBox[{"Abs", "[", "r", "]"}], ",", " ", 
                   RowBox[{"-", 
                    RowBox[{"Abs", "[", "r", "]"}]}]}], "]"}]}], ")"}]}]}]}], 
            ";", "\n", "     ", 
            RowBox[{"sr", " ", "=", " ", "1."}], ";", " ", 
            RowBox[{"cr", " ", "=", " ", "1."}], ";", " ", 
            RowBox[{"pp", " ", "=", " ", "0."}], ";", "\n", "     ", 
            RowBox[{"i", " ", "=", " ", 
             RowBox[{"mm", " ", "-", " ", "1"}]}], ";", " ", 
            RowBox[{"underflow", " ", "=", " ", "False"}], ";", "\n", "     ", 
            RowBox[{"While", "[", 
             RowBox[{
              RowBox[{"i", " ", ">=", " ", "l"}], ",", "\n", "      ", 
              RowBox[{
               RowBox[{"f", " ", "=", " ", 
                RowBox[{"sr", " ", 
                 RowBox[{"e", "[", 
                  RowBox[{"[", "i", "]"}], "]"}]}]}], ";", " ", 
               RowBox[{"b", " ", "=", " ", 
                RowBox[{"cr", " ", 
                 RowBox[{"e", "[", 
                  RowBox[{"[", "i", "]"}], "]"}]}]}], ";", "\n", "      ", 
               RowBox[{"r", " ", "=", " ", 
                RowBox[{"Sqrt", "[", 
                 RowBox[{
                  RowBox[{"f", "^", "2"}], " ", "+", " ", 
                  RowBox[{"g", "^", "2"}]}], "]"}]}], ";", "\n", "      ", 
               RowBox[{
                RowBox[{"e", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}], " ", "=", 
                " ", "r"}], ";", "\n", "      ", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"r", " ", "==", " ", "0."}], ",", " ", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"d", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}], " ", "-=",
                    " ", "pp"}], ";", " ", 
                  RowBox[{
                   RowBox[{"e", "[", 
                    RowBox[{"[", "mm", "]"}], "]"}], " ", "=", " ", "0."}], ";",
                   " ", 
                  RowBox[{"underflow", " ", "=", " ", "True"}], ";", " ", 
                  RowBox[{"Break", "[", "]"}]}]}], "]"}], ";", "\n", "      ", 
               RowBox[{"sr", " ", "=", " ", 
                RowBox[{"f", "/", "r"}]}], ";", " ", 
               RowBox[{"cr", " ", "=", " ", 
                RowBox[{"g", "/", "r"}]}], ";", "\n", "      ", 
               RowBox[{"g", " ", "=", " ", 
                RowBox[{
                 RowBox[{"d", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}], " ", "-", 
                 " ", "pp"}]}], ";", "\n", "      ", 
               RowBox[{"r", " ", "=", " ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"d", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], " ", "-", " ", "g"}], 
                   ")"}], " ", "sr"}], " ", "+", " ", 
                 RowBox[{"2", " ", "cr", " ", "b"}]}]}], ";", "\n", "      ", 
               
               RowBox[{"pp", " ", "=", " ", 
                RowBox[{"sr", " ", "r"}]}], ";", "\n", "      ", 
               RowBox[{
                RowBox[{"d", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}], " ", "=", 
                " ", 
                RowBox[{"g", " ", "+", " ", "pp"}]}], ";", "\n", "      ", 
               RowBox[{"g", " ", "=", " ", 
                RowBox[{
                 RowBox[{"cr", " ", "r"}], " ", "-", " ", "b"}]}], ";", "\n", 
               "      ", 
               RowBox[{"(*", " ", 
                RowBox[{
                 RowBox[{
                 "rotate", " ", "the", " ", "rows", " ", "i", " ", "and", " ",
                   "i"}], " ", "+", " ", 
                 RowBox[{"1", " ", "of", " ", "zt"}]}], " ", "*)"}], "\n", 
               "      ", 
               RowBox[{"z0", " ", "=", " ", 
                RowBox[{"zt", "[", 
                 RowBox[{"[", "i", "]"}], "]"}]}], ";", " ", 
               RowBox[{"z1", " ", "=", " ", 
                RowBox[{"zt", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}]}], ";", 
               "\n", "      ", 
               RowBox[{
                RowBox[{"zt", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}], " ", "=", 
                " ", 
                RowBox[{
                 RowBox[{"z0", " ", "sr"}], " ", "+", " ", 
                 RowBox[{"z1", " ", "cr"}]}]}], ";", "\n", "      ", 
               RowBox[{
                RowBox[{"zt", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], " ", "=", " ", 
                RowBox[{
                 RowBox[{"z0", " ", "cr"}], " ", "-", " ", 
                 RowBox[{"z1", " ", "sr"}]}]}], ";", "\n", "      ", 
               RowBox[{"i", "--"}]}]}], "]"}], ";", "\n", "     ", 
            RowBox[{"If", "[", 
             RowBox[{"underflow", ",", " ", 
              RowBox[{"Continue", "[", "]"}]}], "]"}], ";", "\n", "     ", 
            RowBox[{
             RowBox[{"d", "[", 
              RowBox[{"[", "l", "]"}], "]"}], " ", "-=", " ", "pp"}], ";", 
            " ", 
            RowBox[{
             RowBox[{"e", "[", 
              RowBox[{"[", "l", "]"}], "]"}], " ", "=", " ", "g"}], ";", " ", 
            
            RowBox[{
             RowBox[{"e", "[", 
              RowBox[{"[", "mm", "]"}], "]"}], " ", "=", " ", "0."}]}]}], 
          "]"}]}], ",", "\n", "    ", 
        RowBox[{"{", 
         RowBox[{"l", ",", " ", "1", ",", " ", "n"}], "}"}]}], "]"}], ";", 
      "\n", "   ", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"sort", " ", "the", " ", "eigenvalues", " ", "ascending"}], ";",
         " ", 
        RowBox[{
        "the", " ", "eigenvectors", " ", "are", " ", "the", " ", "columns", " ",
          "of", " ", 
         RowBox[{"q", " ", ".", " ", 
          RowBox[{"Transpose", "[", "zt", "]"}]}]}]}], " ", "*)"}], "\n", 
      "   ", 
      RowBox[{"idx", " ", "=", " ", 
       RowBox[{"Ordering", "[", "d", "]"}]}], ";", "\n", "   ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"d", "[", 
         RowBox[{"[", "idx", "]"}], "]"}], ",", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"q", " ", ".", " ", 
           RowBox[{"Transpose", "[", "zt", "]"}]}], ")"}], "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "idx"}], "]"}], "]"}]}], "}"}]}]}], 
    "]"}]}], ";"}]], "Input",ExpressionUUID->"fc8465b5-aaf4-47ad-9079-\
05f85aa25a68"],

Cell[TextData[{
 "A first test of the rewritten routines on a random ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{"9", "\[Cross]", "9"}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"cd6dcadd-9b0d-4417-a35f-3aacf6b8eea3"]], "InlineFormula",
  ExpressionUUID->"81a953e7-397f-41e5-8615-1ef262c7a3c8"],
 " Hermitian matrix and a random ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{"3", "\[Cross]", "3"}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"b74e74e7-ccea-4708-ae04-059d2c62296c"]], "InlineFormula",
  ExpressionUUID->"efa5c994-23ec-43a9-a5bc-131cb103eb72"],
 " matrix, against the built-in functions ",
 StyleBox["Eigenvalues",
  FontFamily->"Source Code Pro"],
 " and ",
 StyleBox["MatrixExp",
  FontFamily->"Source Code Pro"],
 " (the full tests of the eigensolver are the check GS-11 below)."
}], "Text",ExpressionUUID->"a65a3851-93a8-48d1-ab33-6644a0790a18"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"t2Seed", "[", "12345", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"t2testH", " ", "=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"z", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"t2UnitC", "[", "]"}], ",", " ", 
         RowBox[{"{", "9", "}"}], ",", " ", 
         RowBox[{"{", "9", "}"}]}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"z", " ", "+", " ", 
      RowBox[{"ConjugateTranspose", "[", "z", "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"t2testM", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"t2UnitC", "[", "]"}], ",", " ", 
     RowBox[{"{", "3", "}"}], ",", " ", 
     RowBox[{"{", "3", "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"t2testVals", ",", " ", "t2testVecs"}], "}"}], " ", "=", " ", 
   RowBox[{"t2eigh", "[", "t2testH", "]"}]}], ";"}], "\n", 
 RowBox[{"SL31Check", "[", 
  RowBox[{"\"\<T2-LINALG\>\"", ",", 
   " ", "\"\<the rewritten eigensolver and matrix exponential of cmat.rs \
agree with Eigenvalues and MatrixExp of the Wolfram Language\>\"", ",", "\n", 
   "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{"t2testVals", " ", "-", " ", 
        RowBox[{"Sort", "[", 
         RowBox[{"Re", "[", 
          RowBox[{"Eigenvalues", "[", "t2testH", "]"}], "]"}], "]"}]}], "]"}],
       "]"}], " ", "<", " ", "1*^-12"}], " ", "&&", "\n", "   ", 
    RowBox[{
     RowBox[{"Norm", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"t2testVecs", " ", ".", " ", 
         RowBox[{"DiagonalMatrix", "[", "t2testVals", "]"}], " ", ".", " ", 
         RowBox[{"ConjugateTranspose", "[", "t2testVecs", "]"}]}], " ", "-", 
        " ", "t2testH"}], ",", " ", "\"\<Frobenius\>\""}], "]"}], " ", "<", 
     " ", "1*^-12"}], " ", "&&", "\n", "   ", 
    RowBox[{
     RowBox[{"Norm", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"t2expm", "[", "t2testM", "]"}], " ", "-", " ", 
        RowBox[{"MatrixExp", "[", "t2testM", "]"}]}], ",", 
       " ", "\"\<Frobenius\>\""}], "]"}], " ", "<", " ", "1*^-13"}]}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{"t2testVals", " ", "-", " ", 
        RowBox[{"Sort", "[", 
         RowBox[{"Re", "[", 
          RowBox[{"Eigenvalues", "[", "t2testH", "]"}], "]"}], "]"}]}], "]"}],
       "]"}], ",", " ", 
     RowBox[{"Norm", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"t2expm", "[", "t2testM", "]"}], " ", "-", " ", 
        RowBox[{"MatrixExp", "[", "t2testM", "]"}]}], ",", 
       " ", "\"\<Frobenius\>\""}], "]"}]}], "}"}]}], "]"}]}], "Input",Expressi\
onUUID->"83a682f7-dc85-4de9-8afd-598a971b2126"],

Cell["\<\
II.1.3 The super-loop operators as matrices (t2core/src/model.rs)\
\>", "Subsection",ExpressionUUID->"f6d5b4c5-6fcc-46fa-8fd1-3587511378d5"],

Cell[TextData[{
 "Every matrix of the field equations is built from the matrix ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["M", "TI"], "LL"], "(", 
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"1a9059ed-8917-41d1-bf32-c19586f3166d"]], "InlineFormula",
  ExpressionUUID->"ae5233ea-df03-4963-9771-131f7c83711b"],
 " of a bi-quaternion. A bi-quaternion ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], "\[LongEqual]", 
     UnderoverscriptBox["\[Sum]", 
      RowBox[{
       StyleBox["p", "TI"], "\[LongEqual]", "0"}], "3",
      LimitsPositioning->True], 
     SubsuperscriptBox["\[Xi]", 
      StyleBox["p", "TI"], "LL"], 
     RowBox[{"(", 
      StyleBox["b",
       FontWeight->"Bold",
       FontSlant->"Plain"], ")"}], 
     SubscriptBox[
      StyleBox["e",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      StyleBox["p", "TI"]]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"091b7520-0982-4546-88ba-baf3f2bfc0e5"]], "InlineFormula",
  ExpressionUUID->"2b57bd49-258a-4243-b1cb-29a757ac9e81"],
 " (four complex coefficients ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubsuperscriptBox["\[Xi]", 
      StyleBox["p", "TI"], "LL"], "(", 
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"3ef3d2ca-cf97-4527-9cc6-b8c8d3ff4380"]], "InlineFormula",
  ExpressionUUID->"466ab6dd-f0e7-4bd8-83a3-52d39888455a"],
 ") has the ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{"2", "\[Cross]", "2"}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"5808c700-e205-48df-a80d-5f9afa1dc087"]], "InlineFormula",
  ExpressionUUID->"40c735ea-4c84-4cb4-9d96-a790c8419202"],
 " matrix ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["M", "TI"], "LL"], 
     RowBox[{"(", 
      StyleBox["b",
       FontWeight->"Bold",
       FontSlant->"Plain"], ")"}], "\[LongEqual]", 
     SubsuperscriptBox["\[Xi]", "0", "LL"], 
     RowBox[{"(", 
      StyleBox["b",
       FontWeight->"Bold",
       FontSlant->"Plain"], ")"}], 
     SubsuperscriptBox["\[Sigma]", "0", "LL"], "-", 
     StyleBox["i", "TI"], 
     UnderoverscriptBox["\[Sum]", 
      RowBox[{
       StyleBox["j", "TI"], "\[LongEqual]", "1"}], "3",
      LimitsPositioning->True], 
     SubsuperscriptBox["\[Xi]", 
      StyleBox["j", "TI"], "LL"], 
     RowBox[{"(", 
      StyleBox["b",
       FontWeight->"Bold",
       FontSlant->"Plain"], ")"}], 
     SubsuperscriptBox["\[Sigma]", 
      StyleBox["j", "TI"], "LL"]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"ec5063fe-ceea-476d-b495-4395faa0bc97"]], "InlineFormula",
  ExpressionUUID->"5743408c-96b4-4ff7-8e84-083ce428e8bc"],
 ", so that ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["M", "TI"], "LL"], 
     RowBox[{"(", 
      SubscriptBox[
       StyleBox["e",
        FontWeight->"Bold",
        FontSlant->"Plain"], "0"], ")"}], "\[LongEqual]", 
     SubsuperscriptBox["\[Sigma]", "0", "LL"]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"92d69a62-b2d8-43cf-9fd4-2d0d2bcade56"]], 
  "InlineFormula",ExpressionUUID->"c80065d6-6b49-4c67-8762-a62e159ed830"],
 " and ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["M", "TI"], "LL"], 
     RowBox[{"(", 
      SubscriptBox[
       StyleBox["e",
        FontWeight->"Bold",
        FontSlant->"Plain"], 
       StyleBox["j", "TI"]], ")"}], "\[LongEqual]", "-", 
     StyleBox["i", "TI"], 
     SubsuperscriptBox["\[Sigma]", 
      StyleBox["j", "TI"], "LL"]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"6629a4c7-d97f-4f39-940d-f62a238e49de"]], "InlineFormula",
  ExpressionUUID->"825ae4c5-3a45-4f91-9cf6-7077319bca9c"],
 ". The canonical frame of ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["\[DoubleStruckCapitalR]",
      FontSlant->"Plain"], "LL", 
     RowBox[{"1", ",", "3"}]], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"ef50d4e8-5826-49e9-933c-272ad117a822"]], "InlineFormula",
  ExpressionUUID->"0449c705-e34c-4db0-90ce-cbc267046dbb"],
 " is ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["f",
       FontWeight->"Bold",
       FontSlant->"Plain"], "0"], "\[LongEqual]", 
     SubscriptBox[
      StyleBox["e",
       FontWeight->"Bold",
       FontSlant->"Plain"], "0"]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"a0bb8abb-dd92-4a72-b8e3-4cfe6c2a6ecb"]], "InlineFormula",
  ExpressionUUID->"7d475e68-2b84-4e6b-b212-d30acc144ee3"],
 ", ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["f",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      StyleBox["j", "TI"]], "\[LongEqual]", 
     StyleBox["i", "TI"], 
     SubscriptBox[
      StyleBox["e",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      StyleBox["j", "TI"]]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"8588540d-a53e-4f5b-b76d-8db4f957df4a"]], "InlineFormula",
  ExpressionUUID->"29c05405-a615-4812-9453-2d49e7be8f0e"],
 ", with ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["M", "TI"], "LL"], 
     RowBox[{"(", 
      SubscriptBox[
       StyleBox["f",
        FontWeight->"Bold",
        FontSlant->"Plain"], 
       StyleBox["p", "TI"]], ")"}], "\[LongEqual]", 
     SubsuperscriptBox["\[Sigma]", 
      StyleBox["p", "TI"], "LL"]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"fba0c600-e016-49ef-9560-10773062f237"]], "InlineFormula",
  ExpressionUUID->"904e0b48-d4da-4099-9329-fb5f6cec2bb5"],
 ". The Dirac matrices of a frame are ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubsuperscriptBox["\[Gamma]", "LL", 
      StyleBox["p", "TI"]], 
     RowBox[{"[", 
      StyleBox["f",
       FontWeight->"Bold",
       FontSlant->"Plain"], "]"}], "\[LongEqual]", 
     RowBox[{"(", Cell[BoxData[
       FormBox[GridBox[{
          {Cell[TextData[{
            " ",
            Cell[
            "0", "InlineFormula",ExpressionUUID->
             "1fe5546a-4662-434a-8938-1bc9eb12deaa"],
            " "
           }],ExpressionUUID->"c4182a24-25e3-4beb-84d6-32d710ec87f3"], Cell[
           TextData[{
            " ",
            Cell[BoxData[
             RowBox[{
              SubscriptBox[
               StyleBox["M", "TI"], "LL"], "(", 
              SubscriptBox[
               StyleBox["f",
                FontWeight->"Bold",
                FontSlant->"Plain"], 
               StyleBox["p", "TI"]], ")"}]], "InlineFormula",ExpressionUUID->
             "c5cbfefb-f3d6-45dd-ac2e-2b88b3f3fd93"],
            " "
           }],ExpressionUUID->"a4824b45-4120-4873-ad9e-6ed60091c454"]},
          {Cell[TextData[{
            " ",
            Cell[BoxData[
             RowBox[{
              SubscriptBox[
               StyleBox["M", "TI"], "LL"], "(", 
              SubscriptBox[
               OverscriptBox[
                StyleBox["f",
                 FontWeight->"Bold",
                 FontSlant->"Plain"], "_"], 
               StyleBox["p", "TI"]], ")"}]], "InlineFormula",ExpressionUUID->
             "fbb6f1cb-ca23-496d-a8d0-9c7c9bf584c9"],
            " "
           }],ExpressionUUID->"4e8cab08-7aa6-4543-8cf3-fa4fe4984203"], Cell[
           TextData[{
            " ",
            Cell[
            "0", "InlineFormula",ExpressionUUID->
             "8f0e7c8d-cb69-42e0-9576-c1b2f2eed983"],
            " "
           }],ExpressionUUID->"3961bb52-ed80-4c3f-ba3c-592949800d9b"]}
         }], TraditionalForm]],ExpressionUUID->
       "faa63b82-1e72-4e84-a6e2-bd907c37a12b"], ")"}]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"a4f0c4b6-53a9-4f0d-86b5-d692510e550c"]], 
  "InlineFormula",ExpressionUUID->"c24df59d-dcef-4ca0-90fe-7646f3ad6c05"],
 " (the chiral basis; ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    OverscriptBox[
     StyleBox["b",
      FontWeight->"Bold",
      FontSlant->"Plain"], "_"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"2c5284dd-4707-4a45-8991-3c8003c6b251"]], "InlineFormula",
  ExpressionUUID->"ec17fb00-d3d9-463f-b625-ab4cfbc88e2e"],
 " is the conjugate bi-quaternion, in which the signs of the coefficients of ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["e",
       FontWeight->"Bold",
       FontSlant->"Plain"], "1"], ",", 
     SubscriptBox[
      StyleBox["e",
       FontWeight->"Bold",
       FontSlant->"Plain"], "2"], ",", 
     SubscriptBox[
      StyleBox["e",
       FontWeight->"Bold",
       FontSlant->"Plain"], "3"]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"b73b2dd0-e84a-45ba-bc70-aecb6c4b7b83"]], "InlineFormula",
  ExpressionUUID->"02095740-ac06-4aa0-8566-26610701b9dc"],
 " change); for the canonical frame they are ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[Gamma]", "LL", 
     StyleBox["p", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "e9151a0e-8339-4f2c-855a-d2b1b1ecdf69"]], "InlineFormula",ExpressionUUID->
  "b31ace75-c517-43d9-a73d-3b46ce90655c"],
 ". The spinor field ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubscriptBox["\[CapitalPsi]", "LL"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"fcbacb36-2584-47a6-982e-d3819a2a8e9b"]], "InlineFormula",
  ExpressionUUID->"b9a3c983-2390-4d5b-af89-eee2236fe179"],
 " has the 8 components ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox["\[CapitalPsi]", 
      RowBox[{"LL", ",", "1"}]], ",", "\[Ellipsis]", ",", 
     SubscriptBox["\[CapitalPsi]", 
      RowBox[{"LL", ",", "8"}]]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"85ae2704-08b6-4fe8-afc8-2885f77d59a3"]], "InlineFormula",
  ExpressionUUID->"5f6bec21-19f5-4c41-8a42-204a01ab3d62"],
 ": components 1 and 2 are the first Dirac component with isospin up and \
down, 3 and 4 the second, 5 and 6 the third, 7 and 8 the fourth. A ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{"4", "\[Cross]", "4"}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"408ddf6e-eb66-4ce6-915f-5ddb7ddebb22"]], "InlineFormula",
  ExpressionUUID->"76bb28ad-ff2a-4209-8eb0-53b2612708e1"],
 " matrix of the Dirac index therefore acts on the eight components as its \
Kronecker product with ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"7fbb58e6-335c-4692-a556-5a8797366a2c"]], "InlineFormula",
  ExpressionUUID->"45966f79-f742-4c14-9e11-7abebe584689"],
 ", and a ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{"2", "\[Cross]", "2"}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"a6152af9-9771-43a3-af8b-8cc5c3c61046"]], "InlineFormula",
  ExpressionUUID->"f34b342b-bab3-40cd-a904-95125be2a2fc"],
 " matrix of the isospin index as the Kronecker product of ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "4"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"f636d0a6-ec60-472e-b749-a9106b1429f0"]], "InlineFormula",
  ExpressionUUID->"cc17f08f-352c-4bb4-a65c-a50af2f82204"],
 " with it. The cell defines every function of model.rs, in the same order; \
the comment of each function states the formula."
}], "Text",ExpressionUUID->"691a8b45-e027-4676-a47b-890dd74cca8b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", "Pauli", " ", "matrices", " ", "sigma_", "0", " ", 
     RowBox[{"(", "unit", ")"}]}], ",", " ", 
