Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"GS", "-", "3"}], ":", " ", 
      RowBox[{
       RowBox[{"200", " ", "random", " ", "unit", " ", "bi"}], "-", 
       "quaternions"}]}], ";", " ", 
     RowBox[{"for", " ", "each"}]}], ",", " ", 
    RowBox[{"a", " ", "random", " ", "Hermitian", " ", "frame", " ", 
     RowBox[{"(", 
      RowBox[{
      "the", " ", "random", " ", "numbers", " ", "in", " ", "the", " ", 
       "order", " ", "of", " ", "t2_fields"}], ")"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"worst3", " ", "=", " ", "0."}], ";", " ", 
    RowBox[{"worst3b", " ", "=", " ", "0."}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "mg", ",", " ", "s4", ",", " ", "s4i", ",", " ", "l", ",", " ", "f", 
          ",", " ", "gf", ",", " ", "mgt", ",", " ", "f2", ",", " ", "gf2"}], 
         "}"}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{"mg", " ", "=", " ", 
          RowBox[{"t2randSL2C", "[", "]"}]}], ";", "\n", "   ", 
         RowBox[{"s4", " ", "=", " ", 
          RowBox[{"t2spinRep", "[", "mg", "]"}]}], ";", "\n", "   ", 
         RowBox[{"s4i", " ", "=", " ", 
          RowBox[{"ArrayFlatten", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"ConjugateTranspose", "[", "mg", "]"}], ",", " ", 
               "0"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"0", ",", " ", 
               RowBox[{"t2inv2", "[", "mg", "]"}]}], "}"}]}], "}"}], "]"}]}], 
         ";", "\n", "   ", 
         RowBox[{"worst3", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"worst3", ",", " ", 
            RowBox[{"fro", "[", 
             RowBox[{
              RowBox[{"s4", " ", ".", " ", "s4i"}], " ", "-", " ", 
              RowBox[{"IdentityMatrix", "[", "4", "]"}]}], "]"}]}], "]"}]}], ";",
          "\n", "   ", 
         RowBox[{"l", " ", "=", " ", 
          RowBox[{"t2lmat", "[", "mg", "]"}]}], ";", "\n", "   ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{"worst3", " ", "=", " ", 
            RowBox[{"Max", "[", 
             RowBox[{"worst3", ",", " ", 
              RowBox[{"fro", "[", 
               RowBox[{
                RowBox[{"s4i", " ", ".", " ", 
                 RowBox[{"g", "[", 
                  RowBox[{"[", 
                   RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}], " ", ".", 
                 " ", "s4"}], " ", "-", " ", 
                RowBox[{"Sum", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"l", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"p", " ", "+", " ", "1"}], ",", " ", 
                    RowBox[{"q", " ", "+", " ", "1"}]}], "]"}], "]"}], " ", 
                   RowBox[{"g", "[", 
                    RowBox[{"[", 
                    RowBox[{"q", " ", "+", " ", "1"}], "]"}], "]"}]}], ",", 
                  " ", 
                  RowBox[{"{", 
                   RowBox[{"q", ",", " ", "0", ",", " ", "3"}], "}"}]}], 
                 "]"}]}], "]"}]}], "]"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}], ";", 
         "\n", "   ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"the", " ", "frame", " ", "f_p"}], " ", "=", " ", 
            RowBox[{
             RowBox[{"x0", " ", "e0"}], " ", "+", " ", 
             RowBox[{"i", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"x1", " ", "e1"}], " ", "+", " ", 
                RowBox[{"x2", " ", "e2"}], " ", "+", " ", 
                RowBox[{"x3", " ", "e3"}]}], ")"}]}]}]}], ",", " ", 
           RowBox[{
           "real", " ", "x", " ", "drawn", " ", "p", " ", "by", " ", "p"}]}], 
          " ", "*)"}], "\n", "   ", 
         RowBox[{"f", " ", "=", " ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Module", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"x0", " ", "=", " ", 
                RowBox[{"t2Unit", "[", "]"}]}], "}"}], ",", " ", 
              RowBox[{"Prepend", "[", 
               RowBox[{
                RowBox[{"Table", "[", 
                 RowBox[{
                  RowBox[{"I", " ", 
                   RowBox[{"t2Unit", "[", "]"}]}], ",", " ", 
                  RowBox[{"{", "3", "}"}]}], "]"}], ",", " ", "x0"}], "]"}]}],
              "]"}], ",", " ", 
            RowBox[{"{", "4", "}"}]}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"gf", " ", "=", " ", 
          RowBox[{"t2gammasFromFrame", "[", "f", "]"}]}], ";", "\n", "   ", 
         RowBox[{"mgt", " ", "=", " ", 
          RowBox[{"t2inv2", "[", 
           RowBox[{"ConjugateTranspose", "[", "mg", "]"}], "]"}]}], ";", "\n",
          "   ", 
         RowBox[{"f2", " ", "=", " ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"With", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"x", " ", "=", " ", 
                RowBox[{"t2coords", "[", 
                 RowBox[{"mgt", " ", ".", " ", 
                  RowBox[{"t2mq", "[", 
                   RowBox[{"f", "[", 
                    RowBox[{"[", "p", "]"}], "]"}], "]"}], " ", ".", " ", 
                  RowBox[{"ConjugateTranspose", "[", "mgt", "]"}]}], "]"}]}], 
               "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"x", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
                RowBox[{"I", " ", 
                 RowBox[{"x", "[", 
                  RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", 
                RowBox[{"I", " ", 
                 RowBox[{"x", "[", 
                  RowBox[{"[", "3", "]"}], "]"}]}], ",", " ", 
                RowBox[{"I", " ", 
                 RowBox[{"x", "[", 
                  RowBox[{"[", "4", "]"}], "]"}]}]}], "}"}]}], "]"}], ",", 
            " ", 
            RowBox[{"{", 
             RowBox[{"p", ",", " ", "4"}], "}"}]}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"gf2", " ", "=", " ", 
          RowBox[{"t2gammasFromFrame", "[", "f2", "]"}]}], ";", "\n", "   ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{"worst3b", " ", "=", " ", 
            RowBox[{"Max", "[", 
             RowBox[{"worst3b", ",", " ", 
              RowBox[{"fro", "[", 
               RowBox[{
                RowBox[{"s4", " ", ".", " ", 
                 RowBox[{"gf", "[", 
                  RowBox[{"[", "p", "]"}], "]"}], " ", ".", " ", "s4i"}], " ",
                 "-", " ", 
                RowBox[{"gf2", "[", 
                 RowBox[{"[", "p", "]"}], "]"}]}], "]"}]}], "]"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"p", ",", " ", "4"}], "}"}]}], "]"}]}]}], "]"}], ",", 
      "\n", "  ", 
      RowBox[{"{", "200", "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<GS-3\>\"", ",", 
     " ", "\"\<the gauge group SL(2,C) as a change of representation: \
Sspin^-1 gamma^p Sspin = sum Lmat[p][q] gamma^q and Sspin gamma^p[f] Sspin^-1 \
= gamma^p[gLt f gLt^dag] for 200 random gL and random Hermitian frames \
(tolerance 1e-10)\>\"", ",", "\n", "  ", 
     RowBox[{
      RowBox[{"worst3", " ", "<", " ", "1*^-10"}], " ", "&&", " ", 
      RowBox[{"worst3b", " ", "<", " ", "1*^-10"}]}], ",", " ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<largest deviations \>\"", ",", " ", "worst3", ",", 
        " ", "\"\< and \>\"", ",", " ", "worst3b", ",", 
        " ", "\"\< (original: 5.8e-14 and 6.6e-14)\>\""}], "}"}], "]"}]}], 
    "]"}]}]}]], "Input",ExpressionUUID->"be47b756-ce89-4cd4-8c78-\
f9d9c0189f45"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"GS", "-", "4"}], ":", " ", "isospin"}], ",", " ", 
    RowBox[{
    "Lorentz", " ", "invariance", " ", "and", " ", "isospin", " ", 
     "covariance", " ", "of", " ", "the", " ", "pair", " ", "matrices"}], ",",
     " ", 
    RowBox[{
     RowBox[{"the", " ", "c"}], "-", 
     RowBox[{"number", " ", "spinor"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"t", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"t2tiso", "[", "i", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"k", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"t2kpair", "[", "i", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"isoOk", " ", "=", " ", 
     RowBox[{
      RowBox[{"And", " ", "@@", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"fro", "[", 
            RowBox[{
             RowBox[{"comm", "[", 
              RowBox[{
               RowBox[{"t", "[", 
                RowBox[{"[", "a", "]"}], "]"}], ",", " ", 
               RowBox[{"t", "[", 
                RowBox[{"[", "b", "]"}], "]"}]}], "]"}], " ", "-", " ", 
             RowBox[{"Sum", "[", 
              RowBox[{
               RowBox[{"I", " ", 
                RowBox[{"t2eps3", "[", 
                 RowBox[{"a", ",", " ", "b", ",", " ", "c"}], "]"}], " ", 
                RowBox[{"t", "[", 
                 RowBox[{"[", "c", "]"}], "]"}]}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"c", ",", " ", "3"}], "}"}]}], "]"}]}], "]"}], " ", "<",
            " ", "tol"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"a", ",", " ", "3"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"b", ",", " ", "3"}], "}"}]}], "]"}], "]"}]}], " ", "&&", 
      "\n", "   ", 
      RowBox[{"And", " ", "@@", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"fro", "[", 
             RowBox[{"comm", "[", 
              RowBox[{
               RowBox[{"t", "[", 
                RowBox[{"[", "a", "]"}], "]"}], ",", " ", 
               RowBox[{"t2lift4", "[", 
                RowBox[{"sj", "[", 
                 RowBox[{"[", "u", "]"}], "]"}], "]"}]}], "]"}], "]"}], " ", "<",
             " ", "tol"}], " ", "&&", " ", 
           RowBox[{
            RowBox[{"fro", "[", 
             RowBox[{"comm", "[", 
              RowBox[{
               RowBox[{"t", "[", 
                RowBox[{"[", "a", "]"}], "]"}], ",", " ", 
               RowBox[{"t2lift4", "[", 
                RowBox[{"sk", "[", 
                 RowBox[{"[", "u", "]"}], "]"}], "]"}]}], "]"}], "]"}], " ", "<",
             " ", "tol"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"a", ",", " ", "3"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"u", ",", " ", "3"}], "}"}]}], "]"}], "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"kkOk", " ", "=", " ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{"k", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"fro", "[", 
          RowBox[{"#", " ", "+", " ", 
           RowBox[{"Transpose", "[", "#", "]"}]}], "]"}], " ", "<", " ", 
         "tol"}], " ", "&"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"worst4", " ", "=", " ", "0."}], ";", " ", 
    RowBox[{"cnum", " ", "=", " ", "0."}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "mg", ",", " ", "s8", ",", " ", "th", ",", " ", "u2", ",", " ", "u8",
           ",", " ", "r", ",", " ", "psi"}], "}"}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{"mg", " ", "=", " ", 
          RowBox[{"t2randSL2C", "[", "]"}]}], ";", "\n", "   ", 
         RowBox[{"s8", " ", "=", " ", 
          RowBox[{"t2lift4", "[", 
           RowBox[{"t2spinRep", "[", "mg", "]"}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"th", " ", "=", " ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"3", " ", 
             RowBox[{"t2Unit", "[", "]"}]}], ",", " ", 
            RowBox[{"{", "3", "}"}]}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"u2", " ", "=", " ", 
          RowBox[{"t2su2", "[", "th", "]"}]}], ";", " ", 
         RowBox[{"u8", " ", "=", " ", 
          RowBox[{"t2lift2", "[", "u2", "]"}]}], ";", " ", 
         RowBox[{"r", " ", "=", " ", 
          RowBox[{"t2adjoint", "[", "u2", "]"}]}], ";", "\n", "   ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{"worst4", " ", "=", " ", 
            RowBox[{"Max", "[", 
             RowBox[{"worst4", ",", " ", 
              RowBox[{"fro", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Transpose", "[", "s8", "]"}], " ", ".", " ", 
                 RowBox[{"k", "[", 
                  RowBox[{"[", "a", "]"}], "]"}], " ", ".", " ", "s8"}], " ", 
                "-", " ", 
                RowBox[{"k", "[", 
                 RowBox[{"[", "a", "]"}], "]"}]}], "]"}], ",", "\n", "      ", 
              RowBox[{"fro", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Transpose", "[", "u8", "]"}], " ", ".", " ", 
                 RowBox[{"k", "[", 
                  RowBox[{"[", "a", "]"}], "]"}], " ", ".", " ", "u8"}], " ", 
                "-", " ", 
                RowBox[{"Sum", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"r", "[", 
                    RowBox[{"[", 
                    RowBox[{"a", ",", " ", "b"}], "]"}], "]"}], " ", 
                   RowBox[{"k", "[", 
                    RowBox[{"[", "b", "]"}], "]"}]}], ",", " ", 
                  RowBox[{"{", 
                   RowBox[{"b", ",", " ", "3"}], "}"}]}], "]"}]}], "]"}]}], 
             "]"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"a", ",", " ", "3"}], "}"}]}], "]"}], ";", "\n", "   ", 
         RowBox[{"psi", " ", "=", " ", 
          RowBox[{"t2RndVec", "[", "8", "]"}]}], ";", "\n", "   ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{"cnum", " ", "=", " ", 
            RowBox[{"Max", "[", 
             RowBox[{"cnum", ",", " ", 
              RowBox[{"Abs", "[", 
               RowBox[{"psi", " ", ".", " ", 
                RowBox[{"k", "[", 
                 RowBox[{"[", "a", "]"}], "]"}], " ", ".", " ", "psi"}], 
               "]"}]}], "]"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"a", ",", " ", "3"}], "}"}]}], "]"}]}]}], "]"}], ",", 
      "\n", "  ", 
      RowBox[{"{", "100", "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<GS-4\>\"", ",", 
     " ", "\"\<isospin T^iota obeys [T^a, T^b] = i eps T^c and commutes with \
the Lorentz generators; the pair matrices Kch_iota are antisymmetric, Lorentz \
invariant and an isospin vector (100 random gL and U); Psi^T Kch Psi = 0 for \
a c-number spinor (tolerance 1e-10)\>\"", ",", "\n", "  ", 
     RowBox[{"isoOk", " ", "&&", " ", "kkOk", " ", "&&", " ", 
      RowBox[{"worst4", " ", "<", " ", "1*^-10"}], " ", "&&", " ", 
      RowBox[{"cnum", " ", "<", " ", "1*^-12"}]}], ",", " ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<largest deviation \>\"", ",", " ", "worst4", ",", 
        " ", "\"\<; largest |Psi^T Kch Psi| \>\"", ",", " ", "cnum", ",", 
        " ", "\"\< (original: 5.2e-15; 3.0e-16)\>\""}], "}"}], "]"}]}], 
    "]"}]}]}]], "Input",ExpressionUUID->"2e05b31e-370b-45df-9125-\
16543e8f48d8"],

Cell["\<\
GS-5 and GS-6: gauge covariance and curvature of the covariant derivative\
\>", "Subsection",ExpressionUUID->"78b37b6b-6ace-41f3-8efa-2e58758b2a9c"],

Cell[TextData[{
 "Fields linear in the coordinates ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "0"], ",", 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "1"], ",", 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "2"], ",", 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "70b81af1-87e0-4d3a-ae45-f376245ac6b6"],
 " are drawn at random: the isospin potentials ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["A", "TI"], 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}], "\[Iota]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6a6c84d8-4663-4f1d-8ebb-12f97346483c"],
 ", the fermion-number potentials ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["A", "TI"], 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}], 
    StyleBox["F",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "88c6f011-ff88-440f-a250-85748d4fcfa5"],
 " and the Lorentz connection with the rotation components ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Omega]", 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}], 
    StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4385a72b-1f74-420e-b10d-c9d53377be0f"],
 " and the boost components ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CurlyPi]", 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}], 
    StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "25fe3a10-7d02-4bef-9f83-374db254d36c"],
 "; the spinor field ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7d15fe9a-eec8-454c-9231-c00600a72738"],
 " is a sum of three plane waves. A gauge transformation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["\[ScriptCapitalU]",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    StyleBox["exp",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["i", "TI"], 
      SubsuperscriptBox["\[Theta]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["F",
        FontSlant->"Plain"]]}], ")"}], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["S",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[CircleTimes]", 
    SubscriptBox[
     StyleBox["U",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "71070623-1c3d-418b-8443-703b009d3c05"],
 " is applied, whose phase ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Theta]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["F",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a8eaa949-7a89-4860-a5f6-51cf301f45a9"],
 ", isospin rotation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["U",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    StyleBox["exp",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["i", "TI"], "\[ThinSpace]", 
      UnderscriptBox["\[Sum]", "\[Iota]",
       LimitsPositioning->True], "\[ThinSpace]", 
      SubsuperscriptBox["\[Theta]", 
       StyleBox["LL",
        FontSlant->"Plain"], "\[Iota]"], 
      SubsuperscriptBox["\[Tau]", "\[Iota]", 
       StyleBox["LL",
        FontSlant->"Plain"]], "/", "2"}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "37840d69-7a68-469a-983e-9eff8fde48ec"],
 " and unit bi-quaternion ",
 Cell[BoxData[
  FormBox[
   StyleBox["g",
    FontWeight->"Bold",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7b020b51-4444-48b9-92c3-d2ac1b248a76"],
 " (with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[LongEqual]", 
    StyleBox["exp",
     FontSlant->"Plain"], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["u",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fa95fd7d-33f3-40a9-be24-2bc82045db43"],
 " for a Lorentz generator ",
 Cell[BoxData[
  FormBox[
   StyleBox["u",
    FontWeight->"Bold",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c9fceba4-0869-47c2-bd64-c8960ff804ac"],
 ") depend on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dd2ee6da-c330-4024-93d5-618bd2a71157"],
 " through ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Theta]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["F",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a167a2a9-73e9-4181-ba38-f553353eafc2"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Theta]", 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "847053b3-632d-493c-8c57-4e13d1a3e31e"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["u",
    FontWeight->"Bold",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "17237c24-07d9-4e37-8da7-f5c8aa471011"],
 ", which are linear in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e3de39e8-5ff0-4d03-926a-f8cd367a8dd8"],
 ". The transformed fields are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], 
     StyleBox["F",
      FontSlant->"Plain"]], "+", 
    SubscriptBox["\[PartialD]", 
     StyleBox["p", "TI"]], 
    SubsuperscriptBox["\[Theta]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]], "/", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a791080d-2aab-410a-b7a1-e5e060650ad1"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["U",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["a",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}]], 
    SubsuperscriptBox[
     StyleBox["U",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     RowBox[{"-", "1"}]], "-", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["i", "TI"], "/", 
      SubsuperscriptBox[
       StyleBox["g", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["v",
        FontSlant->"Plain"]]}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[PartialD]", 
       StyleBox["p", "TI"]], 
      SubscriptBox[
       StyleBox["U",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}], 
    SubsuperscriptBox[
     StyleBox["U",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     RowBox[{"-", "1"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "504a84eb-a0c5-4efb-a5a8-f94f2d46393c"],
 " in place of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["a",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}]], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", "\[Iota]",
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], "\[Iota]"], 
    SubsuperscriptBox["\[Tau]", "\[Iota]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "/", "2"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d6e14017-ca00-4b69-bda9-a30b2012df0c"],
 ", and, on the Dirac index, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["S",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    SubscriptBox[
     StyleBox["s",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["u",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["LL",
        FontSlant->"Plain"], ",", 
       StyleBox["p", "TI"]}], "\[Omega]"], ")"}], 
    SubscriptBox[
     StyleBox["S",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      StyleBox["g",
       FontWeight->"Bold",
       FontSlant->"Plain"], ")"}], 
     RowBox[{"-", "1"}]], "-", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[PartialD]", 
       StyleBox["p", "TI"]], 
      SubscriptBox[
       StyleBox["S",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      RowBox[{"(", 
       StyleBox["g",
        FontWeight->"Bold",
        FontSlant->"Plain"], ")"}]}], ")"}], 
    SubscriptBox[
     StyleBox["S",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      StyleBox["g",
       FontWeight->"Bold",
       FontSlant->"Plain"], ")"}], 
     RowBox[{"-", "1"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0e3d0014-c35a-4886-bc67-ac958bd9a982"],
 " in place of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["s",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["u",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["LL",
        FontSlant->"Plain"], ",", 
       StyleBox["p", "TI"]}], "\[Omega]"], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c7db3257-927c-4ff5-b3e2-bf1d6c31c595"],
 ". GS-5 checks that the covariant derivative made of the transformed fields, \
applied to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["\[ScriptCapitalU]",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8956886d-32f9-4fc5-9f94-7c334f7effb7"],
 ", equals ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["\[ScriptCapitalU]",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Del]", 
     StyleBox["p", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c25bc868-1c39-40f8-b54c-d50444504d8b"],
 " at 20 random points; the derivatives of the gauge functions are computed \
by central differences with the step ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "5"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2d36a653-5cda-4b6b-b9ce-88b0c4967961"],
 ". GS-6 checks that the commutator of two covariant derivatives is the \
curvature, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"[", 
     RowBox[{
      SubsuperscriptBox["\[Del]", 
       StyleBox["p", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]], ",", 
      SubsuperscriptBox["\[Del]", 
       SuperscriptBox[
        StyleBox["p", "TI"], "\[Prime]"], 
       StyleBox["LL",
        FontSlant->"Plain"]]}], "]"}], 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["R",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["p", "TI"], 
        SuperscriptBox[
         StyleBox["p", "TI"], "\[Prime]"]}], 
       StyleBox["LL",
        FontSlant->"Plain"]], "-", 
      StyleBox["i", "TI"], 
      SubsuperscriptBox[
       StyleBox["g", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["v",
        FontSlant->"Plain"]], "\[ThinSpace]", 
      UnderscriptBox["\[Sum]", "\[Iota]",
       LimitsPositioning->True], "\[ThinSpace]", 
      SubsuperscriptBox[
       StyleBox["F",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["LL",
         FontSlant->"Plain"], ",", 
        StyleBox["p", "TI"], 
        SuperscriptBox[
         StyleBox["p", "TI"], "\[Prime]"]}], "\[Iota]"], 
      SubsuperscriptBox[
       StyleBox["T", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "\[Iota]"], "-", 
      StyleBox["i", "TI"], 
      SubsuperscriptBox[
       StyleBox["g", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["F",
        FontSlant->"Plain"]], 
      SubsuperscriptBox[
       StyleBox["F",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["LL",
         FontSlant->"Plain"], ",", 
        StyleBox["p", "TI"], 
        SuperscriptBox[
         StyleBox["p", "TI"], "\[Prime]"]}], 
       StyleBox["F",
        FontSlant->"Plain"]]}], ")"}], 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1df19b4c-36b0-48ef-a9b8-1f3f1380c4bd"],
 ", with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["R",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubscriptBox["\[PartialD]", 
     StyleBox["p", "TI"]], 
    SubsuperscriptBox["\[CapitalGamma]", 
     SuperscriptBox[
      StyleBox["p", "TI"], "\[Prime]"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "-", 
    SubscriptBox["\[PartialD]", 
     SuperscriptBox[
      StyleBox["p", "TI"], "\[Prime]"]], 
    SubsuperscriptBox["\[CapitalGamma]", 
     StyleBox["p", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "+", 
    SubsuperscriptBox["\[CapitalGamma]", 
     StyleBox["p", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[CapitalGamma]", 
     SuperscriptBox[
      StyleBox["p", "TI"], "\[Prime]"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "-", 
    SubsuperscriptBox["\[CapitalGamma]", 
     SuperscriptBox[
