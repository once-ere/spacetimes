        RowBox[{"i", " ", "gF", " ", 
         RowBox[{"F", "^", "F_pq"}]}]}], ")"}], " ", "Psi"}]}], ",", " ", 
    RowBox[{
    "outer", " ", "derivative", " ", "by", " ", "central", " ", 
     "differences"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"h6", " ", "=", " ", "1*^-4"}], ";", " ", 
