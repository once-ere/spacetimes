            RowBox[{"fl2", "[", 
             RowBox[{"[", 
              RowBox[{"\"\<links\>\"", ",", " ", 
               RowBox[{"s", " ", "+", " ", "1"}], ",", " ", 
               RowBox[{"j", " ", "+", " ", "1"}]}], "]"}], "]"}], " ", "=", 
            " ", 
            RowBox[{
             RowBox[{"gs", "[", 
              RowBox[{"[", 
               RowBox[{"s", " ", "+", " ", "1"}], "]"}], "]"}], " ", ".", " ", 
             RowBox[{"fl", "[", 
              RowBox[{"[", 
               RowBox[{"\"\<links\>\"", ",", " ", 
                RowBox[{"s", " ", "+", " ", "1"}], ",", " ", 
                RowBox[{"j", " ", "+", " ", "1"}]}], "]"}], "]"}], " ", ".", 
             " ", 
             RowBox[{"ConjugateTranspose", "[", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"sp", " ", "===", " ", "None"}], ",", " ", 
                RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", " ", 
                RowBox[{"gs", "[", 
                 RowBox[{"[", 
                  RowBox[{"sp", " ", "+", " ", "1"}], "]"}], "]"}]}], "]"}], 
              "]"}]}]}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"j", ",", " ", "0", ",", " ", "2"}], "}"}]}], "]"}]}], ",", 
      "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"s", ",", " ", "0", ",", " ", 
        RowBox[{"ns", " ", "-", " ", "1"}]}], "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"hl2", " ", "=", " ", 
     RowBox[{"t2dense", "[", 
      RowBox[{"lat", ",", " ", "fl2"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gcov", " ", "=", " ", 
     RowBox[{"fro", "[", 
      RowBox[{"hl2", " ", "-", " ", 
       RowBox[{"gbig", " ", ".", " ", "hl", " ", ".", " ", 
        RowBox[{"ConjugateTranspose", "[", "gbig", "]"}]}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"the", " ", "free", " ", "one"}], "-", 
      RowBox[{"dimensional", " ", 
       RowBox[{"lattice", ":", " ", 
        RowBox[{
         RowBox[{"the", " ", "spectrum"}], " ", "+", 
         RowBox[{"-", "eps_lat"}]}]}]}]}], ",", " ", 
     RowBox[{
      RowBox[{"each", " ", "eight", " ", "times"}], ";", " ", 
      RowBox[{"the", " ", "doubler"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"lat1", " ", "=", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<n\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1", ",", " ", "12"}], "}"}]}], ",", " ", 
       RowBox[{"\"\<ell\>\"", " ", "->", " ", "0.5"}], ",", " ", 
       RowBox[{"\"\<periodic\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"True", ",", " ", "True", ",", " ", "True"}], "}"}]}], ",", 
       " ", 
       RowBox[{"\"\<wilson\>\"", " ", "->", " ", "1.0"}], ",", " ", 
       RowBox[{"\"\<mass\>\"", " ", "->", " ", "mass"}], ",", " ", 
       RowBox[{"\"\<mu\>\"", " ", "->", " ", "0."}]}], "|>"}]}], ";"}], "\n", 
   
   RowBox[{
    RowBox[{"ev1", " ", "=", " ", 
     RowBox[{"First", "[", 
      RowBox[{"t2eigh", "[", 
       RowBox[{"t2dense", "[", 
        RowBox[{"lat1", ",", " ", 
         RowBox[{"t2trivialFields", "[", "12", "]"}]}], "]"}], "]"}], "]"}]}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"expect1", " ", "=", " ", 
     RowBox[{"Sort", "[", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"e", " ", "=", " ", 
             RowBox[{"t2epsLat", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"0.", ",", " ", "0.", ",", " ", 
                 RowBox[{"2", " ", "Pi", " ", 
                  RowBox[{"kk", "/", 
                   RowBox[{"(", 
                    RowBox[{"12", " ", "0.5"}], ")"}]}]}]}], "}"}], ",", " ", 
               "0.5", ",", " ", "mass", ",", " ", "1.0", ",", " ", 
               RowBox[{"{", 
                RowBox[{"False", ",", " ", "False", ",", " ", "True"}], 
                "}"}]}], "]"}]}], "}"}], ",", " ", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"e", ",", " ", 
               RowBox[{"-", "e"}]}], "}"}], ",", " ", 
             RowBox[{"{", "8", "}"}]}], "]"}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"kk", ",", " ", "0", ",", " ", "11"}], "}"}]}], "]"}], 
       "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"disp", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{"ev1", " ", "-", " ", "expect1"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"doublerOk", " ", "=", " ", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"t2epsLat", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0.", ",", " ", "0.", ",", " ", 
            RowBox[{"Pi", "/", "0.5"}]}], "}"}], ",", " ", "0.5", ",", " ", 
          "mass", ",", " ", "1.0", ",", " ", 
          RowBox[{"{", 
           RowBox[{"False", ",", " ", "False", ",", " ", "True"}], "}"}]}], 
         "]"}], " ", "-", " ", 
        RowBox[{"(", 
         RowBox[{"mass", " ", "+", " ", 
          RowBox[{"2", "/", "0.5"}]}], ")"}]}], "]"}], " ", "<", " ", 
      "1*^-12"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "the", " ", "spectral", " ", "radius", " ", "of", " ", "H_lat", " ", 
     "and", " ", "its", " ", "bound", " ", 
     RowBox[{"B", "^", "H"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"rho", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{"First", "[", 
        RowBox[{"t2eigh", "[", "hl", "]"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"bound", " ", "=", " ", 
     RowBox[{"t2normBound", "[", 
      RowBox[{"lat", ",", " ", "fl"}], "]"}]}], ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<GS-10\>\"", ",", 
     " ", "\"\<the lattice operator H_lat on a 3 x 2 x 4 lattice (dx = 0.7, \
r_W = 1, periodic in x and z) with random links, potentials and order \
parameters is Hermitian, particle-hole symmetric and exactly gauge covariant; \
on a free periodic chain of 12 sites its spectrum is +-eps_lat, each eight \
times; the Wilson term lifts the doubler to m + 2 r_W/dx; the spectral radius \
stays below the bound Hbound (tolerance 1e-10)\>\"", ",", "\n", "  ", 
     RowBox[{
      RowBox[{"herm", " ", "<", " ", "1*^-10"}], " ", "&&", " ", 
      RowBox[{"ph", " ", "<", " ", "1*^-10"}], " ", "&&", " ", 
      RowBox[{"gcov", " ", "<", " ", "1*^-10"}], " ", "&&", " ", 
      RowBox[{"disp", " ", "<", " ", "1*^-10"}], " ", "&&", " ", "doublerOk", 
      " ", "&&", " ", 
      RowBox[{"rho", " ", "<=", " ", "bound"}]}], ",", "\n", "  ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<Hermiticity \>\"", ",", " ", "herm", ",", 
        " ", "\"\<, particle-hole \>\"", ",", " ", "ph", ",", 
        " ", "\"\<, gauge covariance \>\"", ",", " ", "gcov", ",", 
        " ", "\"\<, dispersion \>\"", ",", " ", "disp", ",", 
        " ", "\"\<; spectral radius \>\"", ",", " ", 
        RowBox[{"NumberForm", "[", 
         RowBox[{"rho", ",", " ", 
          RowBox[{"{", 
           RowBox[{"6", ",", " ", "4"}], "}"}]}], "]"}], ",", 
        " ", "\"\< <= bound \>\"", ",", " ", 
        RowBox[{"NumberForm", "[", 
         RowBox[{"bound", ",", " ", 
          RowBox[{"{", 
           RowBox[{"6", ",", " ", "4"}], "}"}]}], "]"}], ",", "\n", 
        "    ", "\"\< (original: 0.0e0, 0.0e0, 1.8e-13, 1.4e-14; 8.4349 <= \
17.5474)\>\""}], "}"}], "]"}]}], "]"}]}]}]], "Input",ExpressionUUID->\
"224a933e-60ff-46e0-a7b2-7f078d74a91c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"GS", "-", "11"}], ":", " ", 
     RowBox[{
     "the", " ", "rewritten", " ", "eigensolver", " ", "on", " ", "random", " ",
       "Hermitian", " ", "matrices", " ", "of", " ", "the", " ", "dimensions",
       " ", "7"}]}], ",", " ", 
    RowBox[{"64", " ", "and", " ", "200"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"worst11", " ", "=", " ", "0."}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"a", " ", "=", " ", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{
             RowBox[{"0.", " ", "I"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"nn", ",", " ", "nn"}], "}"}]}], "]"}]}], ",", " ", 
          "ev", ",", " ", "v"}], "}"}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"z", " ", "=", " ", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"i", " ", "==", " ", "j"}], ",", " ", 
                 RowBox[{
                  RowBox[{"t2Unit", "[", "]"}], " ", "+", " ", 
                  RowBox[{"0.", " ", "I"}]}], ",", " ", 
                 RowBox[{"t2UnitC", "[", "]"}]}], "]"}]}], "}"}], ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"a", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", " ", "j"}], "]"}], "]"}], " ", "=", " ", 
               "z"}], ";", " ", 
              RowBox[{
               RowBox[{"a", "[", 
                RowBox[{"[", 
                 RowBox[{"j", ",", " ", "i"}], "]"}], "]"}], " ", "=", " ", 
               RowBox[{"Conjugate", "[", "z", "]"}]}]}]}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "nn"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"j", ",", " ", "i"}], "}"}]}], "]"}], ";", "\n", "   ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ev", ",", " ", "v"}], "}"}], " ", "=", " ", 
          RowBox[{"t2eigh", "[", "a", "]"}]}], ";", "\n", "   ", 
         RowBox[{"worst11", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"worst11", ",", " ", 
            RowBox[{
             RowBox[{"fro", "[", 
              RowBox[{
               RowBox[{"v", " ", ".", " ", 
                RowBox[{"DiagonalMatrix", "[", "ev", "]"}], " ", ".", " ", 
                RowBox[{"ConjugateTranspose", "[", "v", "]"}]}], " ", "-", 
               " ", "a"}], "]"}], "/", 
             RowBox[{"fro", "[", "a", "]"}]}], ",", " ", 
            RowBox[{"fro", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"ConjugateTranspose", "[", "v", "]"}], " ", ".", " ", 
               "v"}], " ", "-", " ", 
              RowBox[{"IdentityMatrix", "[", "nn", "]"}]}], "]"}]}], 
           "]"}]}]}]}], "]"}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"nn", ",", " ", 
        RowBox[{"{", 
         RowBox[{"7", ",", " ", "64", ",", " ", "200"}], "}"}]}], "}"}]}], 
     "]"}], ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<GS-11\>\"", ",", 
     " ", "\"\<the Hermitian eigensolver of t2core (Householder reduction and \
implicit QL), rewritten above: for random Hermitian matrices of the \
dimensions 7, 64 and 200 the eigenvectors are orthonormal and reproduce the \
matrix (relative tolerance 1e-11)\>\"", ",", "\n", "  ", 
     RowBox[{"worst11", " ", "<", " ", "1*^-11"}], ",", " ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<largest relative residual \>\"", ",", " ", "worst11", ",",
         " ", "\"\< (original: 6.0e-14)\>\""}], "}"}], "]"}]}], 
    "]"}]}]}]], "Input",ExpressionUUID->"c26f313f-4272-4535-a598-\
d65637582330"],

Cell["GS-12: the explicit matrices and the component equations", "Subsection",ExpressionUUID->"12fff8c0-5b5f-444a-b7ee-919919236563"],

Cell[TextData[{
 "The original program prints every matrix and every component equation of \
the field equations in TeX, with its small symbolic algebra, and evaluates \
each printed expression for numbers assigned to its symbols, comparing it \
with the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"8", "\[Times]", "8"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6dee65fc-2175-4abb-a14c-79622dfeded4"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"16", "\[Times]", "16"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cd90c0b2-515a-448c-a0e9-45d95b0c6ff6"],
 " matrix computation (check GS-12). Here the same expressions are built from \
symbols of the Wolfram Language, shown, and evaluated in the same way. The \
symbols: ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["d", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b321647b-694c-495e-8bd3-a9f951edf8f5"],
 " (the order parameter), ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Omega]", 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}], 
    StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f3bc7223-2d97-4a08-a103-f7f5fe990912"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CurlyPi]", 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}], 
    StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "42ca5ec5-bb08-492b-969f-c6d97774dcec"],
 " (the rotation and boost parts of the Lorentz connection in the direction \
",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a900ded5-4091-4557-a66a-369b0a00cff5"],
 "), ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["A", "TI"], 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}], "\[Iota]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2c96e8cf-b3b0-4471-946c-ec9df40d2d74"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["A", "TI"], 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}], 
    StyleBox["F",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4b50c539-d69f-4f27-996d-1b2213902305"],
 " (the gauge potentials), ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["v",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "742677bd-e43b-4751-985e-d2fecb53b8ff"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["F",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e6d7cb5f-dab6-4062-9312-17f5937a357b"],
 " (the couplings), ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Psi]", 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["k", "TI"]}], 
    StyleBox["p",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c33279a4-b36e-43c0-a719-4e8229b06146"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Psi]", 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["k", "TI"]}], 
    StyleBox["h",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "eb6a60b5-1775-4823-ac78-b9e9f00456cb"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPsi]", 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["k", "TI"]}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d75dc1ff-bb17-4132-9f95-2a987d99406e"],
 " (the components; the number of a component, the last letter of the \
subscript, runs from 1 to 8), ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a2682706-f39d-40eb-849f-e992d66d6269"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Mu]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "db73601c-d548-4ebf-b11d-cd5ce519dc96"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "440b45b3-877c-4296-96eb-9e15be26b346"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalPi]", 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ec9af8a3-a1f2-4185-a65d-f5cef9846add"],
 " (the pair operators). They are ordinary symbols with formatting rules, so \
that they print as in the documents."
}], "Text",ExpressionUUID->"46405a14-4b54-4fc6-bba7-6a3ba992c6f5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "the", " ", "symbols", " ", "of", " ", "the", " ", "formulas", " ", "and", 
    " ", "the", " ", "way", " ", "they", " ", "print"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Format", "[", 
      RowBox[{"dS", "[", "i_", "]"}], "]"}], " ", ":=", " ", 
     RowBox[{"Subsuperscript", "[", 
      RowBox[{"\"\<d\>\"", ",", " ", "\"\<LL\>\"", ",", " ", "i"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Format", "[", 
      RowBox[{"dStarS", "[", "i_", "]"}], "]"}], " ", ":=", " ", 
     RowBox[{"Superscript", "[", 
      RowBox[{
       RowBox[{"Subsuperscript", "[", 
        RowBox[{"\"\<d\>\"", ",", " ", "\"\<LL\>\"", ",", " ", "i"}], "]"}], ",",
        " ", "\"\<*\>\""}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Format", "[", 
      RowBox[{"omS", "[", 
       RowBox[{"j_", ",", " ", "idx_"}], "]"}], "]"}], " ", ":=", " ", 
     RowBox[{"Subsuperscript", "[", 
      RowBox[{"\"\<\[Omega]\>\"", ",", " ", 
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<LL,\>\"", ",", " ", "idx"}], "}"}], "]"}], ",", " ", 
       "j"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Format", "[", 
      RowBox[{"vpS", "[", 
       RowBox[{"j_", ",", " ", "idx_"}], "]"}], "]"}], " ", ":=", " ", 
     RowBox[{"Subsuperscript", "[", 
      RowBox[{"\"\<\[CurlyPi]\>\"", ",", " ", 
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<LL,\>\"", ",", " ", "idx"}], "}"}], "]"}], ",", " ", 
       "j"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Format", "[", 
      RowBox[{"afS", "[", "idx_", "]"}], "]"}], " ", ":=", " ", 
     RowBox[{"Subsuperscript", "[", 
      RowBox[{"\"\<A\>\"", ",", " ", 
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<LL,\>\"", ",", " ", "idx"}], "}"}], "]"}], ",", 
       " ", "\"\<F\>\""}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Format", "[", 
      RowBox[{"avS", "[", 
       RowBox[{"i_", ",", " ", "idx_"}], "]"}], "]"}], " ", ":=", " ", 
     RowBox[{"Subsuperscript", "[", 
      RowBox[{"\"\<A\>\"", ",", " ", 
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<LL,\>\"", ",", " ", "idx"}], "}"}], "]"}], ",", " ", 
       "i"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
