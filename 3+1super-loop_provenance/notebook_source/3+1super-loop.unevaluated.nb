        RowBox[{"[", "1", "]"}], "]"}], " ", ">", " ", 
       RowBox[{"cvMax", "[", 
        RowBox[{"[", "2", "]"}], "]"}], " ", ">", " ", 
       RowBox[{"cvMax", "[", 
