         RowBox[{"\"\<x\>\"", ",", " ", "\"\<TI\>\""}], "]"}]}], "}"}], 
      "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-15\>\"", ",", 
    " ", "\"\<the reader of formulas reads 18 formulas of known reading \
correctly, converts every formula of the meanings of the registry without a \
problem, with one fraction box for every fraction command and one root box \
for every root command, and sets a number that directly follows a letter as \
part of a name (x5), not as a factor\>\"", ",", "\n", "  ", 
    RowBox[{
     RowBox[{"readings15", " ", "===", " ", 
      RowBox[{"cases15", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], " ", "&&", " ", 
     RowBox[{"problems15", " ", "===", " ", 
      RowBox[{"{", "}"}]}], " ", "&&", " ", 
     RowBox[{
      RowBox[{"counts15", "[", 
       RowBox[{"[", "1", "]"}], "]"}], " ", "==", " ", 
      RowBox[{"counts15", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], " ", "&&", " ", 
     RowBox[{
      RowBox[{"counts15", "[", 
       RowBox[{"[", "3", "]"}], "]"}], " ", "==", " ", 
      RowBox[{"counts15", "[", 
       RowBox[{"[", "4", "]"}], "]"}]}], " ", "&&", "\n", "   ", 
     RowBox[{"FreeQ", "[", 
      RowBox[{"fractions15", ",", " ", 
       RowBox[{
        RowBox[{"FractionBox", "[", 
         RowBox[{"\"\<\>\"", ",", " ", "_"}], "]"}], " ", "|", " ", 
        RowBox[{"FractionBox", "[", 
         RowBox[{"_", ",", " ", "\"\<\>\""}], "]"}]}]}], "]"}], " ", "&&", 
     " ", "names15"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Length", "[", "cases15", "]"}], ",", " ", 
      RowBox[{"Count", "[", 
       RowBox[{
        RowBox[{"MapThread", "[", 
         RowBox[{"SameQ", ",", " ", 
          RowBox[{"{", 
           RowBox[{"readings15", ",", " ", 
            RowBox[{"cases15", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], "}"}]}], "]"}], 
        ",", " ", "True"}], "]"}], ",", " ", 
      RowBox[{"Length", "[", "meaningFormulas", "]"}], ",", " ", 
      RowBox[{"Length", "[", "problems15", "]"}], ",", " ", "counts15", ",", 
      "\n", "   ", 
      RowBox[{"Count", "[", 
       RowBox[{
       "boxes15", ",", " ", "\"\<\[InvisibleSpace]\>\"", ",", " ", 
        "Infinity"}], "]"}]}], "}"}]}], "]"}], ";"}]}], "Input",ExpressionUUID\
->"9d222a15-5ebe-41d4-8d8a-cbb042464ec6"],

Cell["I.8 The complete table of the symbols", "Section",ExpressionUUID->"c96f603a-6985-426a-8653-81a026b7e090"],

Cell["\<\
The table below shows every entry of the registry, group by group: the \
printed symbols (as the notebook now displays them), the plain-text names and \
the meaning. In the meanings the formulas are shown in their printed form, \
converted by the reader of formulas of section I.3, and the names of programs \
and of functions are set in the code typeface.\
\>", "Text",ExpressionUUID->"b785115d-3fbb-41b5-a831-d566d3e8f589"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
