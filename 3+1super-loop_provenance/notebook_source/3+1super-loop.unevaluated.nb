       RowBox[{"t2gamma", "[", "2", "]"}], " ", ".", " ", 
       RowBox[{"t2gamma", "[", "0", "]"}]}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"alpha", "^", "j"}], " ", "=", " ", 
