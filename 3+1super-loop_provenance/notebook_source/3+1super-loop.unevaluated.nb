            RowBox[{"x_", ",", " ", "s_"}], "]"}], " ", ":>", " ", 
           RowBox[{"SuperscriptBox", "[", 
            RowBox[{"x", ",", " ", 
             RowBox[{"s", " ", "/.", " ", "r"}]}], "]"}]}], ",", "\n", 
          "        ", 
          RowBox[{
           RowBox[{"SubsuperscriptBox", "[", 
            RowBox[{"x_", ",", " ", "s1_", ",", " ", "s2_"}], "]"}], " ", ":>",
            " ", 
           RowBox[{"SubsuperscriptBox", "[", 
            RowBox[{"x", ",", " ", 
             RowBox[{"s1", " ", "/.", " ", "r"}], ",", " ", 
             RowBox[{"s2", " ", "/.", " ", "r"}]}], "]"}]}]}], "}"}]}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"SL31Instance", "[", 
      RowBox[{"b_", ",", " ", "rules_List"}], "]"}], " ", ":=", " ", 
     RowBox[{"SL31Symbolize", "[", 
      RowBox[{"replaceIndex", "[", 
       RowBox[{"b", ",", " ", "rules"}], "]"}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "boxes", " ", "that", " ", "are", " ", "symbolized", " ", 
      "for", " ", "a", " ", "registered", " ", "TeX", " ", "item"}], ",", " ", 
     RowBox[{"by", " ", 
      RowBox[{"kind", ":", "\n", "   ", 
       RowBox[{
        RowBox[{"-", " ", "a"}], " ", "single", " ", "letter", " ", 
        RowBox[{"(", 
         RowBox[{"D", ",", " ", 
          RowBox[{"the", " ", "dimension", " ", "count"}]}], ")"}], " ", "is",
         " ", "wrapped", " ", "in", " ", 
        RowBox[{"TagBox", "[", 
         RowBox[{"..", ",", " ", "\"\<SL31Plain\>\""}], "]"}]}]}]}], ",", " ", 
     RowBox[{
      RowBox[{
      "so", " ", "that", " ", "the", "\n", "     ", "ordinary", " ", "letter",
        " ", 
       RowBox[{"(", 
        RowBox[{
        "for", " ", "example", " ", "the", " ", "derivative", " ", "D", " ", 
         "of", " ", "the", " ", "Wolfram", " ", "Language"}], ")"}], " ", 
       "keeps", " ", "its", " ", "meaning"}], ";", "\n", "   ", 
      RowBox[{
       RowBox[{"-", " ", "a"}], " ", "group", " ", "name"}]}], ",", " ", 
     RowBox[{
     "a", " ", "ket", " ", "or", " ", "another", " ", "expression", " ", 
      "whose", " ", "boxes", " ", "begin", " ", "with", " ", "RowBox", " ", 
      "is", " ", "wrapped", " ", "in", "\n", "     ", 
      RowBox[{"TagBox", "[", 
       RowBox[{"..", ",", " ", "\"\<SL31Name\>\""}], "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{
      "because", " ", "the", " ", "Notation", " ", "package", " ", "cannot", " ",
        "symbolize", " ", "a", " ", "RowBox"}], ";", "\n", "   ", 
      RowBox[{
       RowBox[{"-", " ", "a"}], " ", "function", " ", "symbol", " ", "W", 
       RowBox[{"(", "u", ")"}], " ", "gives", " ", "the", " ", "boxes", " ", 
       "of", " ", "its", " ", "head", " ", "W"}], ";", "\n", "   ", 
      RowBox[{
       RowBox[{"-", " ", "every"}], " ", "other", " ", "kind", " ", "gives", " ",
        "its", " ", "boxes", " ", 
       RowBox[{"unchanged", "."}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"SL31Symbolized", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<symbol\>\"", ",", " ", "\"\<family\>\"", ",", 
       " ", "\"\<function\>\"", ",", " ", "\"\<function family\>\"", ",", 
       " ", "\"\<letter\>\"", ",", " ", "\"\<group\>\"", ",", 
       " ", "\"\<ket\>\"", ",", " ", "\"\<expression\>\"", ",", 
       " ", "\"\<primed index\>\""}], "}"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "the", " ", "innermost", " ", "base", " ", "of", " ", "a", " ", "box", " ",
      "with", " ", "scripts", " ", "or", " ", "an", " ", "accent"}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"baseOf", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
        "SubscriptBox", " ", "|", " ", "SuperscriptBox", " ", "|", " ", 
         "SubsuperscriptBox", " ", "|", " ", "OverscriptBox"}], ")"}], "[", 
       RowBox[{"x_", ",", " ", "__"}], "]"}], "]"}], " ", ":=", " ", 
     RowBox[{"baseOf", "[", "x", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"baseOf", "[", "x_", "]"}], " ", ":=", " ", "x"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "a", " ", "box", " ", "whose", " ", "base", " ", "is", " ", "an", " ", 
      "operator", " ", "sign"}], ",", " ", 
     RowBox[{
      RowBox[{"such", " ", "as", " ", "the", " ", "partial"}], "-", 
      RowBox[{"derivative", " ", "sign", " ", "or", " ", "nabla"}]}], ",", 
     " ", 
     RowBox[{
     "would", " ", "be", "\n", "   ", "read", " ", "by", " ", "the", " ", 
      "front", " ", "end", " ", "as", " ", "an", " ", "operator", " ", 
      "applied", " ", "to", " ", "what", " ", "follows", " ", "it"}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"operatorBaseQ", "[", "b_", "]"}], " ", ":=", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", " ", "=", " ", 
         RowBox[{"baseOf", "[", "b", "]"}]}], "}"}], ",", " ", 
       RowBox[{
        RowBox[{"StringQ", "[", "x", "]"}], " ", "&&", " ", 
        RowBox[{"x", " ", "=!=", " ", "\"\<\>\""}], " ", "&&", " ", 
        RowBox[{"!", " ", 
         RowBox[{"LetterQ", "[", 
          RowBox[{"StringTake", "[", 
           RowBox[{"x", ",", " ", "1"}], "]"}], "]"}]}], " ", "&&", " ", 
        RowBox[{"!", " ", 
         RowBox[{"DigitQ", "[", 
          RowBox[{"StringTake", "[", 
           RowBox[{"x", ",", " ", "1"}], "]"}], "]"}]}]}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"TagBox", "[", 
       RowBox[{"..", ",", " ", "\"\<SL31Name\>\"", ",", " ", 
        RowBox[{"SyntaxForm", " ", "->", " ", "\"\<symbol\>\""}]}], "]"}], " ",
       "makes", " ", "the", " ", "front", " ", "end", " ", "treat", " ", 
      "its", " ", "content", " ", "as", " ", "ONE", "\n", "   ", "operand"}], 
     ",", " ", 
     RowBox[{"like", " ", "a", " ", "symbol"}], ",", " ", 
     RowBox[{"wherever", " ", "it", " ", "stands"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"asName", "[", "b_", "]"}], " ", ":=", " ", 
     RowBox[{"TagBox", "[", 
      RowBox[{"b", ",", " ", "\"\<SL31Name\>\"", ",", " ", 
       RowBox[{"SyntaxForm", " ", "->", " ", "\"\<symbol\>\""}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"SL31SymbolBoxes", "[", "tex_String", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"b", " ", "=", " ", 
          RowBox[{"SL31TeXToBoxes", "[", "tex", "]"}]}], ",", " ", "k", ",", 
         " ", "r"}], "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"k", " ", "=", " ", 
         RowBox[{"SL31Classify", "[", 
          RowBox[{"tex", ",", " ", "b"}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"r", " ", "=", " ", 
         RowBox[{"Switch", "[", 
          RowBox[{"k", ",", "\n", "    ", "\"\<letter\>\"", ",", " ", 
           RowBox[{"TagBox", "[", 
            RowBox[{"b", ",", " ", "\"\<SL31Plain\>\""}], "]"}], ",", "\n", 
           "    ", "\"\<expression\>\"", ",", " ", 
           RowBox[{"asName", "[", "b", "]"}], ",", "\n", "    ", 
           RowBox[{"\"\<group\>\"", " ", "|", " ", "\"\<ket\>\""}], ",", " ", 
           
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Head", "[", "b", "]"}], " ", "===", " ", "RowBox"}], ",",
              " ", 
             RowBox[{"asName", "[", "b", "]"}], ",", " ", "b"}], "]"}], ",", 
           "\n", "    ", 
           
           RowBox[{"\"\<function\>\"", " ", "|", 
            " ", "\"\<function family\>\""}], ",", " ", 
           RowBox[{"SL31Head", "[", "b", "]"}], ",", "\n", "    ", "_", ",", 
           " ", "b"}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Head", "[", "r", "]"}], " ", "=!=", " ", "TagBox"}], " ",
            "&&", " ", 
           RowBox[{"operatorBaseQ", "[", "r", "]"}]}], ",", " ", 
          RowBox[{"asName", "[", "r", "]"}], ",", " ", "r"}], "]"}]}]}], 
      "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "boxes", " ", "of", " ", "a", " ", "registered", " ", "TeX", 
      " ", "symbol"}], ",", " ", 
     RowBox[{
     "with", " ", "optional", " ", "index", " ", "values", " ", "given", " ", 
      "as", " ", "TeX", " ", "strings"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"SL31`Build`symbolBoxes", "[", 
      RowBox[{"tex_String", ",", " ", "rules___Rule"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"b", " ", "=", " ", 
         RowBox[{"SL31SymbolBoxes", "[", "tex", "]"}]}], "}"}], ",", "\n", 
       "  ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", "rules", "}"}], " ", "===", " ", 
          RowBox[{"{", "}"}]}], ",", " ", "b", ",", " ", 
         RowBox[{"replaceIndex", "[", 
          RowBox[{"b", ",", " ", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"SL31TeXToBoxes", "[", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "]"}], " ", "->", " ", 
               RowBox[{"SL31TeXToBoxes", "[", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], "]"}]}], " ", "&"}], ",", 
             " ", 
             RowBox[{"{", "rules", "}"}]}], "]"}]}], "]"}]}], "]"}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"LL", "[", 
      RowBox[{"tex_String", ",", " ", "rules___Rule"}], "]"}], " ", ":=", " ", 
     RowBox[{"ReleaseHold", "[", 
      RowBox[{"SL31SymbolOf", "[", 
       RowBox[{"SL31`Build`symbolBoxes", "[", 
        RowBox[{"tex", ",", " ", "rules"}], "]"}], "]"}], "]"}]}], ";"}], 
   "\n", "\n", 
   RowBox[{
    RowBox[{"End", "[", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"EndPackage", "[", "]"}], ";"}]}]}]], "Input",ExpressionUUID->\
"f6c616e3-9c56-4188-99c8-877c67ea4312"],

Cell["\<\
A first look at the reader: the TeX of six registered symbols and the boxes \
that it builds, shown both as boxes and as they are displayed.\
\>", "Text",ExpressionUUID->"fe3a2b49-5d25-4066-9d0c-032235dcc065"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"examples", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<\\\\Delta^{\\\\rm vac}_{\\\\rm LL}\>\"", ",", 
     " ", "\"\<A^\\\\iota_{{\\\\rm LL},p}\>\"", ",", 
     " ", "\"\<\\\\mathsf N^{\\\\rm g}_{\\\\rm LL}(\\\\vec d_{\\\\rm LL})\>\"",
      ",", "\n", "   ", "\"\<\\\\vec d^{\\\\,*}_{\\\\rm LL}\>\"", ",", 
     " ", "\"\<\\\\mathfrak m_{\\\\rm LL}\>\"", ",", 
     " ", "\"\<\\\\lvert\\\\Phi^{\\\\rm SF}_{\\\\rm LL}\\\\rangle\>\""}], 
    "}"}]}], ";"}], "\n", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"#", ",", " ", 
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"ToString", "[", 
             RowBox[{
              RowBox[{"SL31TeXToBoxes", "[", "#", "]"}], ",", " ", 
              "InputForm"}], "]"}], ",", " ", 
            RowBox[{"FontFamily", " ", "->", " ", "\"\<Source Code Pro\>\""}],
             ",", " ", "9"}], "]"}], ",", " ", 
          RowBox[{"RawBoxes", "[", 
           RowBox[{"SL31TeXToBoxes", "[", "#", "]"}], "]"}]}], "}"}], " ", 
        "&"}], ",", " ", "examples"}], "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"#", ",", " ", "Bold"}], "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<TeX\>\"", ",", " ", "\"\<boxes\>\"", ",", 
        " ", "\"\<displayed\>\""}], "}"}]}]}], "]"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}]}], "Input",Expressio\
nUUID->"71c4237f-1642-401c-96d4-d51a2fc91c18"],

Cell[TextData[{
 StyleBox["Complete formulas.",
  FontWeight->"Bold"],
 " The texts of this notebook and the meanings of the registry (section I.8) \
contain complete formulas, written in TeX between dollar signs, for example \
",
 StyleBox["B^{\\rm out}_{\\rm LL}=\\big(1+\\tfrac14h^{\\rm IDA}_{\\rm \
LL}E^{\\rm max}_{\\rm LL}\\big)B^{\\rm err}_{\\rm LL}",
  FontFamily->"Source Code Pro"],
 ". A second reader, defined in the next cell, converts them into boxes. It \
is built like the reader of symbols (tokens, read from left to right), and it \
knows what a complete formula needs: fractions and roots, sums and integrals \
with their limits, accents, matrices, delimiters, the names of functions, and \
the spaces of TeX. Four properties matter for the correctness of what is \
shown."
}], "Text",ExpressionUUID->"833e2454-bd2b-48b8-b3eb-9cf133d37350"],

Cell[TextData[{
 StyleBox["The arguments of a command.",
  FontWeight->"Bold"],
 " In TeX an argument that is not written in braces is the single token that \
follows the command: ",
 StyleBox["\\tfrac12\\ell^{\\rm x}_{\\rm LL}",
  FontFamily->"Source Code Pro"],
 " is one half times ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[ScriptL]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["x",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5f6b6343-dd91-423e-a2b2-fd0709d37a87"],
 ", and ",
 StyleBox["\\sqrt2\\,\\ell^{\\rm x}_{\\rm LL}",
  FontFamily->"Source Code Pro"],
 " is the square root of 2, times ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[ScriptL]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["x",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "49831f13-7775-459a-a8b2-09e498a581e7"],
 ". The reader follows this rule. The TeX importer of the Wolfram Language \
(",
 StyleBox["ImportString",
  FontFamily->"Source Code Pro"],
 " with the format \"TeX\") does not: it takes everything up to the end of \
the group as the denominator and everything before the fraction as part of \
the numerator, so that it shows ",
 StyleBox["\\tfrac12\\ell^{\\rm x}_{\\rm LL}",
  FontFamily->"Source Code Pro"],
 " as the fraction with the numerator 1 and the denominator ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    SubsuperscriptBox["\[ScriptL]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["x",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bcfc5b0e-7d1f-45b0-8727-501ca9bd87bb"],
 ", and ",
 StyleBox["Q_{\\rm LL}=-\\tfrac12",
  FontFamily->"Source Code Pro"],
 " as the fraction with the numerator ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["Q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"-", "1"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e65b01e7-82de-4711-a973-35b4df43d1f5"],
 " and the denominator 2; it also shows ",
 StyleBox["\\hbar",
  FontFamily->"Source Code Pro"],
 " as nothing. The importer is therefore not used anywhere in this notebook."
}], "Item",ExpressionUUID->"c2e77d76-9e92-42de-99bb-4c95b0f908fb"],

Cell[TextData[{
 StyleBox["The alphabets.",
  FontWeight->"Bold"],
 " Every letter is given its alphabet by an explicit style: the letter of a \
variable is set in italics, text written with ",
 StyleBox["\\rm",
  FontFamily->"Source Code Pro"],
 " upright, ",
 StyleBox["\\mathbf",
  FontFamily->"Source Code Pro"],
 " bold and upright, ",
 StyleBox["\\mathsf",
  FontFamily->"Source Code Pro"],
 " sans-serif (in the typeface Helvetica), and the double-struck, script and \
Gothic letters are the characters of the Wolfram Language for them. A formula \
is set in the typeface Times, so that an upright roman letter (the label K of \
",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[ScriptL]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["K",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1cca79e4-b56c-4b65-81b1-b3c07488a55b"],
 ") differs visibly from a sans-serif letter (the matrix ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "81af94f1-31f9-4dbf-bd03-87afe31db3b3"],
 ") and from an italic letter (the generator ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["K", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bca0adc3-a26e-41d9-b0a0-dfef423bb366"],
 "); the text around a formula is set in the sans-serif typeface of the text \
cells."
}], "Item",ExpressionUUID->"9d103094-8a70-42b6-a9cd-565c66ee6713"],

Cell[TextData[{
 StyleBox["Names are not products.",
  FontWeight->"Bold"],
 " TeX sets neighbouring letters and numbers without a space. The front end \
of the Wolfram Language puts the thin space of a product between two \
neighbouring items of a row of boxes, and this notebook keeps that space \
between the factors of a product, as the Wolfram Language itself shows a \
product. Inside a name there must be no such space. The reader therefore \
joins neighbouring letters of one alphabet into one string (the letters ",
 StyleBox["SL",
  FontFamily->"Source Code Pro"],
 " and ",
 StyleBox["SU",
  FontFamily->"Source Code Pro"],
 " in the names of groups), and it puts the character ",
 StyleBox["\\[InvisibleSpace]",
  FontFamily->"Source Code Pro"],
 ", which has no width, between a letter and a number that directly follows \
it: the coordinates ",
 StyleBox["x5",
  FontFamily->"Source Code Pro"],
 ", ",
 StyleBox["x6",
  FontFamily->"Source Code Pro"],
 ", ",
 StyleBox["x7",
  FontFamily->"Source Code Pro"],
 " of the main project (they occur in the meaning of the number of space \
dimensions, section I.8) are names, not products of a letter and a number."
}], "Item",ExpressionUUID->"0b157f4f-3ee8-4cac-9cd7-82724293efd0"],

Cell[TextData[{
 StyleBox["Nothing is passed over in silence.",
  FontWeight->"Bold"],
 " A command that the reader does not know, a missing argument or an \
unmatched brace is recorded: ",
 StyleBox["SL31TeXFormulaProblems[tex]",
  FontFamily->"Source Code Pro"],
 " lists the problems of a formula, and the list must be empty. The program \
that builds this notebook stops with a warning for every problem in a text \
cell, and test S-15 (section I.7) checks every formula of the registry."
}], "Item",ExpressionUUID->"df0c9d28-8bcb-4091-9d1f-07f2daa4a393"],

Cell[TextData[{
 "The function ",
 StyleBox["SL31FormulaReading",
  FontFamily->"Source Code Pro"],
 " writes the boxes of a formula on one line (a fraction as ",
 StyleBox["frac{a}{b}",
  FontFamily->"Source Code Pro"],
 ", a root as ",
 StyleBox["sqrt{a}",
  FontFamily->"Source Code Pro"],
 ", scripts as ",
 StyleBox["_{..}",
  FontFamily->"Source Code Pro"],
 " and ",
 StyleBox["^{..}",
  FontFamily->"Source Code Pro"],
 ", a bold or sans-serif letter as ",
 StyleBox["<bf:b>",
  FontFamily->"Source Code Pro"],
 " or ",
 StyleBox["<sf:N>",
  FontFamily->"Source Code Pro"],
 "), without the spaces and without the italic and upright styles. Two \
conversions of a formula show the same formula exactly if their readings are \
equal; the tests use this."
}], "Text",ExpressionUUID->"6253e361-28b0-4e24-bd69-3389a2b90bc2"],

