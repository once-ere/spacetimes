       RowBox[{"gamma", "^", "0"}], " ", 
       RowBox[{"gamma", "^", "1"}], " ", 
       RowBox[{"gamma", "^", "2"}], " ", 
       RowBox[{"gamma", "^", "3"}]}]}], ";", " ", 
     RowBox[{"C_LL", " ", "=", " ", 
      RowBox[{"i", " ", 
       RowBox[{"gamma", "^", "2"}], " ", 
       RowBox[{"gamma", "^", "0"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"t2gammaCh", " ", "=", " ", 
     RowBox[{"I", " ", 
      RowBox[{
       RowBox[{"t2gamma", "[", "0", "]"}], " ", ".", " ", 
       RowBox[{"t2gamma", "[", "1", "]"}], " ", ".", " ", 
       RowBox[{"t2gamma", "[", "2", "]"}], " ", ".", " ", 
       RowBox[{"t2gamma", "[", "3", "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"t2cconj", " ", "=", " ", 
