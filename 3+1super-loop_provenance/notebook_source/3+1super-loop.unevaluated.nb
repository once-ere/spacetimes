           RowBox[{"\"\<V\>\"", ",", " ", "\"\<V^iota\>\"", ",", 
            " ", "\"\<VF\>\""}], "}"}]}], ",", " ", 
         RowBox[{"\"\<meaning\>\"", " ", "->", 
          " ", "\"\<the gauge potentials in the unitary gauge, the vector \
fields of definite mass: $V^{\\\\rm F}_{{\\\\rm LL},p}=A^{\\\\rm F}_{{\\\\rm \
LL},p}-\\\\partial_p\\\\vartheta^{\\\\rm G}_{{\\\\rm LL},0}/g^{\\\\rm \
F}_{\\\\rm LL}$ and $\\\\sum_\\\\iota V^\\\\iota_{{\\\\rm \
LL},p}\\\\tau^{\\\\rm LL}_\\\\iota/2=(\\\\mathsf U^{\\\\rm G}_{\\\\rm LL})^\\\
\\dagger\\\\mathsf a_{{\\\\rm LL},p}\\\\mathsf U^{\\\\rm G}_{\\\\rm \
LL}-(i/g^{\\\\rm v}_{\\\\rm LL})(\\\\partial_p(\\\\mathsf U^{\\\\rm \
G}_{\\\\rm LL})^\\\\dagger)\\\\mathsf U^{\\\\rm G}_{\\\\rm LL}$; to first \
order $V^\\\\iota_{{\\\\rm LL},p}=A^\\\\iota_{{\\\\rm \
LL},p}-\\\\partial_p\\\\vartheta^{\\\\rm G}_{{\\\\rm LL},\\\\iota}/g^{\\\\rm \
v}_{\\\\rm LL}$ ($\\\\iota=1,2$) and $V^3_{{\\\\rm LL},p}=A^3_{{\\\\rm \
LL},p}$, the photon\>\""}], ",", " ", 
         RowBox[{"\"\<meaningEdited\>\"", " ", "->", " ", "False"}], ",", " ", 
         RowBox[{"\"\<origin\>\"", " ", "->", 
          " ", "\"\<new (Revision_SuperLoop)\>\""}]}], "|>"}], ",", "\n", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<entry\>\"", " ", "->", " ", "195"}], ",", " ", 
         RowBox[{"\"\<group\>\"", " ", "->", 
          " ", "\"\<9 Test 2: the gauge-covariant field equations of the \
spinor field and their solutions\>\""}], ",", " ", 
         RowBox[{"\"\<symbol\>\"", " ", "->", 
          " ", "\"\<$W^\\\\pm_{{\\\\rm LL},p}$\>\""}], ",", " ", 
         RowBox[{"\"\<names\>\"", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<W_+\>\"", ",", " ", "\"\<W_-\>\""}], "}"}]}], ",", 
         " ", 
         RowBox[{"\"\<meaning\>\"", " ", "->", 
          " ", "\"\<the charged massive vector fields, $(V^1_{{\\\\rm \
LL},p}\\\\mp iV^2_{{\\\\rm LL},p})/\\\\sqrt2$, of the electric charges \
$\\\\pm1$\>\""}], ",", " ", 
         RowBox[{"\"\<meaningEdited\>\"", " ", "->", " ", "False"}], ",", " ", 
         RowBox[{"\"\<origin\>\"", " ", "->", 
          " ", "\"\<new (Revision_SuperLoop)\>\""}]}], "|>"}], ",", "\n", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<entry\>\"", " ", "->", " ", "196"}], ",", " ", 
         RowBox[{"\"\<group\>\"", " ", "->", 
          " ", "\"\<9 Test 2: the gauge-covariant field equations of the \
spinor field and their solutions\>\""}], ",", " ", 
         RowBox[{"\"\<symbol\>\"", " ", "->", 
          " ", "\"\<$\\\\mathsf M^{\\\\rm t}_{\\\\rm LL}$, $\\\\mathsf \
M^{\\\\rm s}_{\\\\rm LL}$\>\""}], ",", " ", 
         RowBox[{"\"\<names\>\"", " ", "->", " ", 
          RowBox[{"{", "}"}]}], ",", " ", 
         RowBox[{"\"\<meaning\>\"", " ", "->", 
          " ", "\"\<the mass matrices of the time and of the space components \
of the four vector fields $(V^{\\\\rm F}_{{\\\\rm LL},p},V^1_{{\\\\rm \
LL},p},V^2_{{\\\\rm LL},p},V^3_{{\\\\rm LL},p})$ in the vacuum: $2Z^{\\\\rm \
t}_{\\\\rm LL}$ and $2Z^{\\\\rm s}_{\\\\rm LL}$ times the contact matrix of \
the vacuum, ${\\\\rm diag}(4(g^{\\\\rm F}_{\\\\rm LL})^2,(g^{\\\\rm \
v}_{\\\\rm LL})^2,(g^{\\\\rm v}_{\\\\rm LL})^2,0)(\\\\Delta^{\\\\rm \
vac}_{\\\\rm LL})^2$; the quadratic Lagrangian contains one half of the first \
and minus one half of the second, each between the row and the column of the \
components\>\""}], ",", " ", 
         RowBox[{"\"\<meaningEdited\>\"", " ", "->", " ", "False"}], ",", " ", 
         RowBox[{"\"\<origin\>\"", " ", "->", 
          " ", "\"\<new (Revision_SuperLoop)\>\""}]}], "|>"}], ",", "\n", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<entry\>\"", " ", "->", " ", "197"}], ",", " ", 
         RowBox[{"\"\<group\>\"", " ", "->", 
          " ", "\"\<9 Test 2: the gauge-covariant field equations of the \
spinor field and their solutions\>\""}], ",", " ", 
         RowBox[{"\"\<symbol\>\"", " ", "->", 
          " ", "\"\<$M^{\\\\rm W}_{\\\\rm LL}$, $M^{\\\\rm F}_{\\\\rm \
LL}$\>\""}], ",", " ", 
         RowBox[{"\"\<names\>\"", " ", "->", " ", 
          RowBox[{"{", 
           
           RowBox[{"\"\<M_W\>\"", ",", " ", "\"\<M_F\>\"", ",", 
            " ", "\"\<M_W_time\>\"", ",", " ", "\"\<M_F_time\>\""}], "}"}]}], 
         ",", " ", 
         RowBox[{"\"\<meaning\>\"", " ", "->", 
          " ", "\"\<the rest masses of the charged vector fields $W^\\\\pm_{{\
\\\\rm LL},p}$ and of the fermion-number vector field $V^{\\\\rm F}_{{\\\\rm \
LL},p}$, $(M^{\\\\rm W}_{\\\\rm LL})^2=2Z^{\\\\rm s}_{\\\\rm LL}(g^{\\\\rm \
v}_{\\\\rm LL})^2(\\\\Delta^{\\\\rm vac}_{\\\\rm LL})^2$ and $(M^{\\\\rm F}_{\
\\\\rm LL})^2=8Z^{\\\\rm s}_{\\\\rm LL}(g^{\\\\rm F}_{\\\\rm \
LL})^2(\\\\Delta^{\\\\rm vac}_{\\\\rm LL})^2$ (plain text `M_W_time`, \
`M_F_time`: the masses of the time components, with $Z^{\\\\rm t}_{\\\\rm \
LL}$ in place of $Z^{\\\\rm s}_{\\\\rm LL}$)\>\""}], ",", " ", 
         RowBox[{"\"\<meaningEdited\>\"", " ", "->", " ", "False"}], ",", " ", 
         RowBox[{"\"\<origin\>\"", " ", "->", 
          " ", "\"\<new (Revision_SuperLoop)\>\""}]}], "|>"}], ",", "\n", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<entry\>\"", " ", "->", " ", "198"}], ",", " ", 
         RowBox[{"\"\<group\>\"", " ", "->", 
          " ", "\"\<9 Test 2: the gauge-covariant field equations of the \
spinor field and their solutions\>\""}], ",", " ", 
         RowBox[{"\"\<symbol\>\"", " ", "->", 
          " ", "\"\<$\\\\theta^{\\\\rm mix}_{\\\\rm LL}$\>\""}], ",", " ", 
         RowBox[{"\"\<names\>\"", " ", "->", " ", 
          RowBox[{"{", 
           
           RowBox[{"\"\<theta_mix\>\"", ",", " ", "\"\<theta_mix_vacuum\>\"", 
            ",", " ", "\"\<theta_mix_saddle\>\"", ",", 
            " ", "\"\<theta_mix_pred\>\""}], "}"}]}], ",", " ", 
         RowBox[{"\"\<meaning\>\"", " ", "->", 
          " ", "\"\<the mixing angle: the angle between the massless gauge \
field (the null vector of the mass matrix) and the axis of the potential \
$A^3_{{\\\\rm LL},p}$ in the plane of $A^{\\\\rm F}_{{\\\\rm LL},p}$ and \
$A^3_{{\\\\rm LL},p}$; zero in the vacuum, $\\\\arctan(g^{\\\\rm v}_{\\\\rm \
LL}/(2g^{\\\\rm F}_{\\\\rm LL}))$ at the non-unitary saddle point (plain \
text: the values found at the vacuum and at the saddle point, and the \
prediction)\>\""}], ",", " ", 
         RowBox[{"\"\<meaningEdited\>\"", " ", "->", " ", "False"}], ",", " ", 
         RowBox[{"\"\<origin\>\"", " ", "->", 
          " ", "\"\<new (Revision_SuperLoop)\>\""}]}], "|>"}], ",", "\n", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<entry\>\"", " ", "->", " ", "199"}], ",", " ", 
         RowBox[{"\"\<group\>\"", " ", "->", 
          " ", "\"\<9 Test 2: the gauge-covariant field equations of the \
spinor field and their solutions\>\""}], ",", " ", 
         RowBox[{"\"\<symbol\>\"", " ", "->", 
          " ", "\"\<$\\\\mathcal L^{(2)}_{\\\\rm LL}$\>\""}], ",", " ", 
         RowBox[{"\"\<names\>\"", " ", "->", " ", 
          RowBox[{"{", "}"}]}], ",", " ", 
         RowBox[{"\"\<meaning\>\"", " ", "->", 
          " ", "\"\<the part of the second order, in the fields of SFBSv and \
the gauge potentials, of the effective Lagrangian of the superfluid boson \
singlet state together with the Yang-Mills and Maxwell terms of the gauge \
fields\>\""}], ",", " ", 
         RowBox[{"\"\<meaningEdited\>\"", " ", "->", " ", "True"}], ",", " ", 
         
         RowBox[{"\"\<origin\>\"", " ", "->", 
          " ", "\"\<new (Revision_SuperLoop)\>\""}]}], "|>"}], ",", "\n", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<entry\>\"", " ", "->", " ", "200"}], ",", " ", 
         RowBox[{"\"\<group\>\"", " ", "->", 
          " ", "\"\<9 Test 2: the gauge-covariant field equations of the \
spinor field and their solutions\>\""}], ",", " ", 
         RowBox[{"\"\<symbol\>\"", " ", "->", 
          " ", "\"\<$w^{\\\\rm lat}_{\\\\rm LL}$, $w^{\\\\rm cmp}_{\\\\rm \
LL}$; $n^{\\\\rm cpx}_{\\\\rm LL}$\>\""}], ",", " ", 
         RowBox[{"\"\<names\>\"", " ", "->", " ", 
          RowBox[{"{", 
           
           RowBox[{"\"\<w_lat\>\"", ",", " ", "\"\<w_cmp\>\"", ",", 
            " ", "\"\<n_complex\>\""}], "}"}]}], ",", " ", 
         RowBox[{"\"\<meaning\>\"", " ", "->", 
          " ", "\"\<a Nambu mode on the lattice written as one complex \
vector, the 16 components of $\\\\psi^{\\\\rm p}_{\\\\rm LL}$ and \
$\\\\psi^{\\\\rm h}_{\\\\rm LL}$ on every site, the sites one after the \
other, so that the lattice equations read $i\\\\,\\\\partial_0w^{\\\\rm \
lat}_{\\\\rm LL}=\\\\mathcal H^{\\\\rm lat}_{\\\\rm LL}w^{\\\\rm lat}_{\\\\rm \
LL}$ (for the self-consistent evolution the columns of $\\\\mathsf W^{\\\\rm \
m}_{\\\\rm LL}$ one after the other); one complex component of it; and the \
number of its complex components, $16$ times the number of sites (times the \
number of modes)\>\""}], ",", " ", 
         RowBox[{"\"\<meaningEdited\>\"", " ", "->", " ", "False"}], ",", " ", 
         RowBox[{"\"\<origin\>\"", " ", "->", 
          " ", "\"\<new (Revision_SuperLoop)\>\""}]}], "|>"}], ",", "\n", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<entry\>\"", " ", "->", " ", "201"}], ",", " ", 
         RowBox[{"\"\<group\>\"", " ", "->", 
          " ", "\"\<9 Test 2: the gauge-covariant field equations of the \
spinor field and their solutions\>\""}], ",", " ", 
         RowBox[{"\"\<symbol\>\"", " ", "->", 
          " ", "\"\<$r^{\\\\rm tol}_{\\\\rm LL}$, $a^{\\\\rm tol}_{\\\\rm \
LL}$\>\""}], ",", " ", 
         RowBox[{"\"\<names\>\"", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<rtol\>\"", ",", " ", "\"\<atol\>\""}], "}"}]}], ",", 
         " ", 
         RowBox[{"\"\<meaning\>\"", " ", "->", 
          " ", "\"\<the relative and the absolute tolerance of a time \
integration by CVODE (the programs of Test 2) or by IDA (the notebook of Test \
2 in the Wolfram Language, which calls it through the function `NDSolve`), \
two integrators of the suite SUNDIALS: the estimated local error of every \
internal step is accepted only if its weighted root-mean-square norm is at \
most 1 (the square root of the mean, over the real unknowns, of the squares \
of the estimated errors, each multiplied by the weight of its unknown). The \
programs of Test 2 give CVODE the weight $1/(r^{\\\\rm tol}_{\\\\rm \
LL}\\\\lvert w^{\\\\rm cmp}_{\\\\rm LL}\\\\rvert+a^{\\\\rm tol}_{\\\\rm LL})$ \
for the real and for the imaginary part of every complex component $w^{\\\\rm \
cmp}_{\\\\rm LL}$ of the state; IDA has for every real unknown the weight 1 \
divided by the sum of $r^{\\\\rm tol}_{\\\\rm LL}$ times the modulus of this \
unknown and $a^{\\\\rm tol}_{\\\\rm LL}$\>\""}], ",", " ", 
         RowBox[{"\"\<meaningEdited\>\"", " ", "->", " ", "False"}], ",", " ", 
         RowBox[{"\"\<origin\>\"", " ", "->", 
          " ", "\"\<new (Revision_SuperLoop)\>\""}]}], "|>"}], ",", "\n", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<entry\>\"", " ", "->", " ", "202"}], ",", " ", 
         RowBox[{"\"\<group\>\"", " ", "->", 
          " ", "\"\<9 Test 2: the gauge-covariant field equations of the \
spinor field and their solutions\>\""}], ",", " ", 
         RowBox[{"\"\<symbol\>\"", " ", "->", 
          " ", "\"\<$h^{\\\\rm CV}_{\\\\rm LL}$, $q^{\\\\rm CV}_{\\\\rm LL}$; \
$h^{\\\\rm IDA}_{\\\\rm LL}$; $N^{\\\\rm st}_{\\\\rm LL}$, $N^{\\\\rm ev}_{\\\
\\rm LL}$\>\""}], ",", " ", 
         RowBox[{"\"\<names\>\"", " ", "->", " ", 
          RowBox[{"{", 
           
           RowBox[{"\"\<h_CV\>\"", ",", " ", "\"\<q_CV\>\"", ",", 
            " ", "\"\<h_IDA\>\"", ",", " ", "\"\<N_steps\>\"", ",", 
            " ", "\"\<N_evals\>\""}], "}"}]}], ",", " ", 
         RowBox[{"\"\<meaning\>\"", " ", "->", 
          " ", "\"\<the size and the order of an internal step of CVODE (both \
chosen by CVODE, the order from 1 to 12 for the Adams-Moulton formulas); the \
size of an internal step of IDA (chosen by IDA, which uses the backward \
differentiation formulas of the orders 1 to 5 and lengthens a step only by \
doubling it); the number of internal steps of an integration and the number \
of evaluations of its right side $-i\\\\mathcal H^{\\\\rm lat}_{\\\\rm LL}w^{\
\\\\rm lat}_{\\\\rm LL}$ (the cost; one step of the classical Runge-Kutta \
method of fourth order needs 4 evaluations)\>\""}], ",", " ", 
         RowBox[{"\"\<meaningEdited\>\"", " ", "->", " ", "False"}], ",", " ", 
         RowBox[{"\"\<origin\>\"", " ", "->", 
          " ", "\"\<new (Revision_SuperLoop)\>\""}]}], "|>"}], ",", "\n", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<entry\>\"", " ", "->", " ", "203"}], ",", " ", 
         RowBox[{"\"\<group\>\"", " ", "->", 
          " ", "\"\<9 Test 2: the gauge-covariant field equations of the \
spinor field and their solutions\>\""}], ",", " ", 
         RowBox[{"\"\<symbol\>\"", " ", "->", 
          " ", "\"\<$B^{\\\\rm err}_{\\\\rm LL}$; $\\\\delta^{\\\\rm rel}_{\\\
\\rm LL}$, $w^{\\\\rm ex}_{\\\\rm LL}$\>\""}], ",", " ", 
         RowBox[{"\"\<names\>\"", " ", "->", " ", 
          RowBox[{"{", 
           
           RowBox[{"\"\<budget\>\"", ",", " ", "\"\<max_deviation\>\"", ",", 
            " ", "\"\<w_exact\>\""}], "}"}]}], ",", " ", 
         RowBox[{"\"\<meaning\>\"", " ", "->", 
          
          " ", "\"\<the accumulated local error that the tolerances of an \
integration allow, $B^{\\\\rm err}_{\\\\rm LL}=N^{\\\\rm st}_{\\\\rm LL}B^{\\\
\\rm loc}_{\\\\rm LL}$, which is $N^{\\\\rm st}_{\\\\rm LL}\\\\sqrt2\\\\,(r^{\
\\\\rm tol}_{\\\\rm LL}\\\\lVert w^{\\\\rm lat}_{\\\\rm \
LL}\\\\rVert+a^{\\\\rm tol}_{\\\\rm LL}\\\\sqrt{n^{\\\\rm cpx}_{\\\\rm LL}})$ \
with the weights of CVODE for a state of the norm $\\\\lVert w^{\\\\rm lat}_{\
\\\\rm LL}\\\\rVert$, the expected size of the global error of a unitary \
evolution; and the relative deviation of a computed state from the exact \
solution, $\\\\lVert w^{\\\\rm lat}_{\\\\rm LL}-w^{\\\\rm ex}_{\\\\rm \
LL}\\\\rVert/\\\\lVert w^{\\\\rm ex}_{\\\\rm LL}\\\\rVert$, with the exact \
solution $w^{\\\\rm ex}_{\\\\rm LL}$ of the same equations\>\""}], ",", " ", 
         RowBox[{"\"\<meaningEdited\>\"", " ", "->", " ", "False"}], ",", " ", 
         RowBox[{"\"\<origin\>\"", " ", "->", 
          " ", "\"\<new (Revision_SuperLoop)\>\""}]}], "|>"}], ",", "\n", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<entry\>\"", " ", "->", " ", "204"}], ",", " ", 
         RowBox[{"\"\<group\>\"", " ", "->", 
          " ", "\"\<9 Test 2: the gauge-covariant field equations of the \
spinor field and their solutions\>\""}], ",", " ", 
         RowBox[{"\"\<symbol\>\"", " ", "->", 
          " ", "\"\<$B^{\\\\rm loc}_{\\\\rm LL}$, $\\\\delta^{\\\\rm loc}_{\\\
\\rm LL}$; $E^{\\\\rm max}_{\\\\rm LL}$, $r^{\\\\rm der}_{\\\\rm LL}$, $B^{\\\
\\rm out}_{\\\\rm LL}$\>\""}], ",", " ", 
         RowBox[{"\"\<names\>\"", " ", "->", " ", 
          RowBox[{"{", 
           
           RowBox[{"\"\<budget_step\>\"", ",", " ", "\"\<local_error\>\"", ",",
             " ", "\"\<E_max\>\"", ",", " ", "\"\<deriv_residual\>\"", ",", 
            " ", "\"\<budget_out\>\""}], "}"}]}], ",", " ", 
         RowBox[{"\"\<meaning\>\"", " ", "->", 
          " ", "\"\<the local error that the tolerances allow in one internal \
step: if the error of every real unknown equals its tolerance (the inverse of \
its weight), the norm of the error is the norm of the vector of the \
tolerances, which by the triangle inequality is at most $\\\\sqrt2\\\\,(r^{\\\
\\rm tol}_{\\\\rm LL}\\\\lVert w^{\\\\rm lat}_{\\\\rm LL}\\\\rVert+a^{\\\\rm \
tol}_{\\\\rm LL}\\\\sqrt{n^{\\\\rm cpx}_{\\\\rm LL}})$ with the weights of \
CVODE and at most $r^{\\\\rm tol}_{\\\\rm LL}\\\\lVert w^{\\\\rm lat}_{\\\\rm \
LL}\\\\rVert+a^{\\\\rm tol}_{\\\\rm LL}\\\\sqrt{2n^{\\\\rm cpx}_{\\\\rm LL}}$ \
with the weights of IDA, and these two numbers are $B^{\\\\rm loc}_{\\\\rm \
LL}$; the exact local error of an internal step, the norm of the difference \
between the computed state at the end of the step and the exact solution that \
starts from the computed state at its beginning (a unitary evolution changes \
the norm of no vector, so the deviation after $N^{\\\\rm st}_{\\\\rm LL}$ \
steps is at most the sum of the local errors of the steps, and at most $B^{\\\
\\rm err}_{\\\\rm LL}$ if no $\\\\delta^{\\\\rm loc}_{\\\\rm LL}$ exceeds \
$B^{\\\\rm loc}_{\\\\rm LL}$); the largest modulus of the eigenvalues \
$E^{\\\\rm qp}_{{\\\\rm LL},n}$ of $\\\\mathcal H^{\\\\rm lat}_{\\\\rm LL}$; \
the norm of the difference, at the end of an internal step of IDA, between \
the derivative that `NDSolve` stores and $-i\\\\mathcal H^{\\\\rm \
lat}_{\\\\rm LL}$ applied to the stored state (it is not zero, because the \
iteration that solves the equations of a step stops at a tolerance); and the \
bound of the deviation from the exact solution of a state of the norm 1 that \
`NDSolve` returns between the ends of an internal step of IDA, by the \
polynomial of the third degree with the stored values and derivatives at the \
two ends, $B^{\\\\rm out}_{\\\\rm LL}=(1+\\\\tfrac14h^{\\\\rm IDA}_{\\\\rm \
LL}E^{\\\\rm max}_{\\\\rm LL})B^{\\\\rm err}_{\\\\rm LL}+\\\\tfrac14h^{\\\\rm \
IDA}_{\\\\rm LL}r^{\\\\rm der}_{\\\\rm LL}+(h^{\\\\rm IDA}_{\\\\rm \
LL}E^{\\\\rm max}_{\\\\rm LL})^4/384$\>\""}], ",", " ", 
         RowBox[{"\"\<meaningEdited\>\"", " ", "->", " ", "False"}], ",", " ", 
         RowBox[{"\"\<origin\>\"", " ", "->", 
          " ", "\"\<new (Revision_SuperLoop)\>\""}]}], "|>"}]}], "\n", 
      "}"}]}], ";"}], "\n", "\n", 
   RowBox[{"Length", "[", "SL31Registry", "]"}]}]}]], "Input",ExpressionUUID->\
"06e51459-c091-4682-9fa4-0b9c3d398acf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "the", " ", "number", " ", "of", " ", "entries", " ", "in", " ", "each", " ",
     "of", " ", "the", " ", "nine", " ", "groups"}], " ", "*)"}], "\n", 
  RowBox[{"KeySort", "[", 
   RowBox[{"Counts", "[", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"#", "[", "\"\<group\>\"", "]"}], " ", "&"}], ",", " ", 
      "SL31Registry"}], "]"}], "]"}], "]"}]}]], "Input",ExpressionUUID->\
"768da3f5-6ce1-4680-89a3-e73aac7a6c13"],

Cell["I.5 The single symbols and their kinds", "Section",ExpressionUUID->"69e5ee19-5344-434b-a9e4-3a9c4cfa0176"],

Cell[TextData[{
 "An entry may list several symbols, for example \"",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7985c553-c81d-44ea-aa8f-0389367edbd1"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Mu]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6f03d5a0-f092-4f09-bda9-5c13433d5758"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalLambda]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e46356b0-fd0e-4529-80be-5da23b8173ba"],
 "\" (the mass of the spinor charges, the chemical potential and the momentum \
cutoff). The next cell takes every TeX segment between dollar signs, splits \
it into single items, converts each into boxes, and classifies it. The kinds \
are: symbol (one fixed object, such as ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalDelta]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["vac",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "da1685da-0de1-4f13-97e4-31d76b49bcef"],
 "); family (a symbol with a running index, such as ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Tau]", "\[Iota]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e2ea7f49-7c36-41ec-9052-b1a570a623d5"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Iota]", "\[LongEqual]", "1", ",", "2", ",", "3"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3829d0ef-7886-4db6-bd4b-a10651586ef5"],
 "); function and function family (a symbol followed by its argument, such as \
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["u",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6f6d364b-66e4-42e7-9c05-8a95c69a40df"],
 "); letter (a single letter such as ",
 Cell[BoxData[
  FormBox[
   StyleBox["D", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1b46287c-c5aa-4591-ae6d-3eb395c1b460"],
 ", the number of space dimensions); index and primed index (",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0c82f4a4-7d53-49d4-94c9-cc8011f11f8b"],
 ", ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["p", "TI"], "\[Prime]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "194c27db-e60e-407e-ace3-bcf693231ac2"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["j", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "887c0ff9-a368-4ebc-8c97-4629c7a47d90"],
 ", ",
 Cell[BoxData[
  FormBox["\[Iota]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d0afcf1f-922e-4ff0-93d8-e062448e1019"],
 ", ...); set (",
 Cell[BoxData[
  FormBox[
   StyleBox["\[DoubleStruckCapitalR]",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3a91d8bf-c4c0-4d09-b05f-36fdca704c86"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[DoubleStruckCapitalC]",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0756a710-98a1-40b4-8ac4-a3d058ccd287"],
 ", ...); group (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SL",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{"2", ",", 
      StyleBox["\[DoubleStruckCapitalC]",
       FontSlant->"Plain"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "52edf245-d035-43b3-9742-18b3ed0a3faa"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU",
     FontSlant->"Plain"], 
    SubscriptBox[
     RowBox[{"(", "2", ")"}], 
     StyleBox["v",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fde5bf6a-b3fc-4f44-99f9-a89ca177fbfc"],
 ", ...); ket; operator (tr, det, the transpose, the tensor product, ...); \
expression (a combination such as ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     SubscriptBox[
      StyleBox["T", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"]], ")"}], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ca4ffe2b-22ce-4cb3-9ce3-77c9e54ebbde"],
 "); imaginary unit. Entries that are not written in TeX at all are the \
labels of the machine checks and of the hypotheses of the no-go theorems; \
they are names, not symbols, and are kept as text."
}], "Text",ExpressionUUID->"c9cbc2c8-b846-4d61-968e-35464e2abe4d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "every", " ", "TeX", " ", "segment", " ", "of", " ", "every", " ", 
    RowBox[{"entry", ":", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"entry", " ", "number"}], ",", " ", "segment"}], "}"}]}]}], 
   " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"segments", " ", "=", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{"e", ",", " ", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"e", "[", "\"\<entry\>\"", "]"}], ",", " ", "#"}], 
               "}"}], " ", "&"}], ",", " ", 
             RowBox[{"StringCases", "[", 
              RowBox[{
               RowBox[{"e", "[", "\"\<symbol\>\"", "]"}], ",", " ", 
               RowBox[{
                RowBox[{"\"\<$\>\"", " ", "~~", " ", 
                 RowBox[{"Shortest", "[", "x__", "]"}], " ", "~~", 
                 " ", "\"\<$\>\""}], " ", ":>", " ", "x"}]}], "]"}]}], 
            "]"}]}], "]"}], ",", " ", "SL31Registry"}], "]"}], ",", " ", 
       "1"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"the", " ", "entries", " ", "without", " ", "any", " ", 
     RowBox[{"TeX", ":", " ", "labels"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"labelEntries", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{"SL31Registry", ",", " ", 
       RowBox[{
        RowBox[{"!", " ", 
         RowBox[{"StringContainsQ", "[", 
          RowBox[{
           RowBox[{"#", "[", "\"\<symbol\>\"", "]"}], ",", " ", "\"\<$\>\""}],
           "]"}]}], " ", "&"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "split", " ", "every", " ", "segment", " ", "into", " ", "single", " ", 
     "items", " ", "and", " ", "convert", " ", "each", " ", "item"}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"items", " ", "=", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{"s", ",", " ", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"<|", 
               RowBox[{
                RowBox[{"\"\<entry\>\"", " ", "->", " ", 
                 RowBox[{"s", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
                RowBox[{"\"\<tex\>\"", " ", "->", " ", "#"}], ",", " ", 
                RowBox[{"\"\<boxes\>\"", " ", "->", " ", 
                 RowBox[{"SL31TeXToBoxes", "[", "#", "]"}]}]}], "|>"}], " ", 
              "&"}], ",", " ", 
             RowBox[{"SL31SplitTeX", "[", 
              RowBox[{"s", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "]"}]}], "]"}], ",", 
         " ", "segments"}], "]"}], ",", " ", "1"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"items", " ", "=", " ", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Append", "[", 
         RowBox[{"#", ",", " ", 
          RowBox[{"\"\<kind\>\"", " ", "->", " ", 
           RowBox[{"SL31Classify", "[", 
            RowBox[{
             RowBox[{"#", "[", "\"\<tex\>\"", "]"}], ",", " ", 
             RowBox[{"#", "[", "\"\<boxes\>\"", "]"}]}], "]"}]}]}], "]"}], 
        " ", "&"}], ",", " ", "items"}], "]"}]}], ";"}], "\n", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", "[", "segments", "]"}], ",", " ", 
     RowBox[{"Length", "[", "items", "]"}], ",", " ", 
     RowBox[{"Length", "[", "labelEntries", "]"}]}], "}"}]}]}]], "Input",Expre\
ssionUUID->"66a5faf6-861c-466d-bb69-b11c827525f5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "how", " ", "many", " ", "items", " ", "of", " ", "each", " ", "kind"}], 
   " ", "*)"}], "\n", 
  RowBox[{"ReverseSort", "[", 
   RowBox[{"Counts", "[", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"#", "[", "\"\<kind\>\"", "]"}], " ", "&"}], ",", " ", 
      "items"}], "]"}], "]"}], "]"}]}]], "Input",ExpressionUUID->"cf480b35-\
ed06-4e59-8173-af99f3715260"],

Cell["I.6 Symbolizing every symbol", "Section",ExpressionUUID->"c929c0ac-b534-414b-b168-09ec1343c2e2"],

Cell[TextData[{
 "Now every item of the kinds symbol, family, function, function family, \
letter, primed index, group, ket and expression is symbolized: ",
 StyleBox["SL31Symbolize",
  FontFamily->"Source Code Pro"],
 " calls ",
 StyleBox["Symbolize",
  FontFamily->"Source Code Pro"],
 " with the explicit working form and with a readable name built from the \
letters, the scripts and the alphabet, and returns the new symbol, held. \
Items whose boxes coincide are ONE symbol and are symbolized once: a function \
symbol written with different arguments, such as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["x",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "deabe3bb-0095-4f80-a212-744b7b97b171"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["x",
       FontWeight->"Bold",
       FontSlant->"Plain"], ",", 
      StyleBox["y",
       FontWeight->"Bold",
       FontSlant->"Plain"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3a02979a-4c37-40a8-b624-60532dd2e38d"],
 ", has the one head ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["N", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4c13a82f-06bd-4b4c-ba9b-1dce00b3c1bf"],
 " (symbolizing the same box twice would only replace the first \
symbolization, with a warning of the Notation package). For every new symbol \
the cell also stores its meaning as the usage message (so that ",
 StyleBox["?symbol",
  FontFamily->"Source Code Pro"],
 " prints it), and a formatting rule for ",
 StyleBox["TraditionalForm",
  FontFamily->"Source Code Pro"],
 ": ",
 StyleBox["TeXForm",
  FontFamily->"Source Code Pro"],
 " writes TeX from the ",
 StyleBox["TraditionalForm",
  FontFamily->"Source Code Pro"],
 " boxes of an expression, so with this rule the symbol is written in TeX \
with its printed form and not with its internal name."
}], "Text",ExpressionUUID->"d3190c4c-43c5-418c-bc04-6909283b4734"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", "items", " ", "that", " ", "are", " ", "symbolized"}],
     ",", " ", 
    RowBox[{"each", " ", "TeX", " ", "item", " ", "once"}]}], " ", "*)"}], 
  "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"toSymbolize", " ", "=", " ", 
     RowBox[{"DeleteDuplicatesBy", "[", 
      RowBox[{
       RowBox[{"Select", "[", 
        RowBox[{"items", ",", " ", 
         RowBox[{
          RowBox[{"MemberQ", "[", 
           RowBox[{"SL31Symbolized", ",", " ", 
            RowBox[{"#", "[", "\"\<kind\>\"", "]"}]}], "]"}], " ", "&"}]}], 
        "]"}], ",", " ", 
       RowBox[{
        RowBox[{"#", "[", "\"\<tex\>\"", "]"}], " ", "&"}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "items", " ", "with", " ", "the", " ", "same", " ", "boxes", " ", "are", " ",
      "one", " ", 
     RowBox[{"symbol", ":", " ", 
      RowBox[{
      "they", " ", "are", " ", "gathered", " ", "into", " ", "groups"}]}]}], 
    " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"byBoxes", " ", "=", " ", 
     RowBox[{"GatherBy", "[", 
      RowBox[{"toSymbolize", ",", " ", 
       RowBox[{
        RowBox[{"SL31SymbolBoxes", "[", 
         RowBox[{"#", "[", "\"\<tex\>\"", "]"}], "]"}], " ", "&"}]}], "]"}]}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"meaningOf", " ", "=", " ", 
     RowBox[{"Association", "[", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", "\"\<entry\>\"", "]"}], " ", "->", " ", 
          RowBox[{"#", "[", "\"\<meaning\>\"", "]"}]}], " ", "&"}], ",", " ", 
        "SL31Registry"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"symbolize", " ", "every", " ", "group"}], ";", " ", 
      RowBox[{"record", " ", "the", " ", "TeX", " ", "items"}]}], ",", " ", 
     RowBox[{"the", " ", "entries"}], ",", " ", 
     RowBox[{"the", " ", "kind"}], ",", " ", 
     RowBox[{
     "the", " ", "boxes", " ", "and", " ", "the", " ", "held", " ", 
      "symbol"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"symbolTable", " ", "=", " ", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{"group", ",", " ", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"b", " ", "=", " ", 
              RowBox[{"SL31SymbolBoxes", "[", 
               RowBox[{
                RowBox[{"First", "[", "group", "]"}], "[", "\"\<tex\>\"", 
                "]"}], "]"}]}], ",", " ", "h", ",", " ", "texs", ",", " ", 
             "entries"}], "}"}], ",", "\n", "      ", 
           RowBox[{
            RowBox[{"texs", " ", "=", " ", 
             RowBox[{"Map", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"#", "[", "\"\<tex\>\"", "]"}], " ", "&"}], ",", " ", 
               "group"}], "]"}]}], ";", "\n", "      ", 
            RowBox[{"entries", " ", "=", " ", 
             RowBox[{"DeleteDuplicates", "[", 
              RowBox[{"Map", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"#", "[", "\"\<entry\>\"", "]"}], " ", "&"}], ",", 
                " ", "group"}], "]"}], "]"}]}], ";", "\n", "      ", 
            RowBox[{"h", " ", "=", " ", 
             RowBox[{"SL31Symbolize", "[", "b", "]"}]}], ";", "\n", "      ", 
            
            RowBox[{"(*", " ", 
             RowBox[{"the", " ", "usage", " ", 
              RowBox[{"message", ":", " ", 
               RowBox[{
               "the", " ", "TeX", " ", "items", " ", "of", " ", "the", " ", 
                "symbol", " ", "and", " ", "the", " ", "meanings", " ", "of", 
                " ", "their", " ", "entries"}]}]}], " ", "*)"}], "\n", 
            "      ", 
            RowBox[{"Replace", "[", 
             RowBox[{"h", ",", " ", 
              RowBox[{
               RowBox[{"HoldComplete", "[", "s_Symbol", "]"}], " ", ":>", 
               "\n", "        ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"MessageName", "[", 
                  RowBox[{"s", ",", " ", "\"\<usage\>\""}], "]"}], " ", "=", 
                 " ", 
                 RowBox[{
                  RowBox[{"StringRiffle", "[", 
                   RowBox[{"texs", ",", " ", "\"\<, \>\""}], "]"}], " ", "<>",
                   " ", "\"\<: \>\"", " ", "<>", " ", 
                  RowBox[{"StringRiffle", "[", 
                   RowBox[{
                    RowBox[{"Map", "[", 
                    RowBox[{"meaningOf", ",", " ", "entries"}], "]"}], ",", 
                    " ", "\"\< | \>\""}], "]"}]}]}], ")"}]}]}], "]"}], ";", 
            "\n", "      ", 
            RowBox[{"(*", " ", 
             RowBox[{
              RowBox[{"TraditionalForm", " ", 
               RowBox[{"(", 
                RowBox[{"and", " ", "therefore", " ", "TeXForm"}], ")"}], " ",
                "shows", " ", "the", " ", "printed", " ", "form"}], ",", " ", 
              
              RowBox[{"not", " ", "the", " ", "internal", " ", "name"}]}], 
             " ", "*)"}], "\n", "      ", 
            RowBox[{"Replace", "[", 
             RowBox[{"h", ",", " ", 
              RowBox[{
               RowBox[{"HoldComplete", "[", "s_Symbol", "]"}], " ", ":>", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"MakeBoxes", "[", 
                  RowBox[{"s", ",", " ", "TraditionalForm"}], "]"}], " ", "=",
                  " ", "b"}], ")"}]}]}], "]"}], ";", "\n", "      ", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<entries\>\"", " ", "->", " ", "entries"}], ",", 
              " ", 
              RowBox[{"\"\<tex\>\"", " ", "->", " ", 
               RowBox[{"First", "[", "texs", "]"}]}], ",", " ", 
              RowBox[{"\"\<texAll\>\"", " ", "->", " ", "texs"}], ",", " ", 
              RowBox[{"\"\<kind\>\"", " ", "->", " ", 
               RowBox[{
                RowBox[{"First", "[", "group", "]"}], "[", "\"\<kind\>\"", 
                "]"}]}], ",", "\n", "        ", 
              RowBox[{"\"\<boxes\>\"", " ", "->", " ", "b"}], ",", " ", 
              RowBox[{"\"\<symbol\>\"", " ", "->", " ", "h"}]}], "|>"}]}]}], 
          "]"}]}], "]"}], ",", "\n", "   ", "byBoxes"}], "]"}]}], ";"}], "\n", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", "[", "toSymbolize", "]"}], ",", " ", 
     RowBox[{"Length", "[", "symbolTable", "]"}]}], "}"}]}]}]], "Input",Expres\
sionUUID->"8e18d202-95ef-4205-875e-b1580156068a"],

Cell["The TeX items that share one symbol, with their entries:", "Text",ExpressionUUID->"a3a947bf-f57d-4040-a3db-18927239e288"],

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"RawBoxes", "[", 
           RowBox[{"#", "[", "\"\<boxes\>\"", "]"}], "]"}], ",", " ", 
          RowBox[{"Column", "[", 
           RowBox[{"#", "[", "\"\<texAll\>\"", "]"}], "]"}], ",", " ", 
          RowBox[{"#", "[", "\"\<entries\>\"", "]"}]}], "}"}], " ", "&"}], ",",
        " ", 
       RowBox[{"Select", "[", 
        RowBox[{"symbolTable", ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", 
            RowBox[{"#", "[", "\"\<texAll\>\"", "]"}], "]"}], " ", ">", " ", 
           "1"}], " ", "&"}]}], "]"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"#", ",", " ", "Bold"}], "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<symbol\>\"", ",", " ", "\"\<TeX items\>\"", ",", 
        " ", "\"\<entries\>\""}], "}"}]}]}], "]"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}]], "Input",Expression\
UUID->"37f45d25-5198-4941-818c-6fbbb21c2327"],

Cell["\<\
Twelve symbols chosen from the nine groups, as the notebook now prints them, \
with their internal names:\
\>", "Text",ExpressionUUID->"5efe9c29-9e84-4f72-876d-74a2924c8722"],

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"RawBoxes", "[", 
           RowBox[{"#", "[", "\"\<boxes\>\"", "]"}], "]"}], ",", " ", 
          RowBox[{"#", "[", "\"\<kind\>\"", "]"}], ",", " ", 
          RowBox[{"Replace", "[", 
           RowBox[{
            RowBox[{"#", "[", "\"\<symbol\>\"", "]"}], ",", " ", 
            RowBox[{
             RowBox[{"HoldComplete", "[", "s_", "]"}], " ", ":>", " ", 
             RowBox[{"SymbolName", "[", 
              RowBox[{"Unevaluated", "[", "s", "]"}], "]"}]}]}], "]"}]}], 
         "}"}], " ", "&"}], ",", "\n", "    ", 
       RowBox[{"symbolTable", "[", 
        RowBox[{"[", 
         RowBox[{"Round", "[", 
          RowBox[{"Range", "[", 
           RowBox[{"1", ",", " ", 
            RowBox[{"Length", "[", "symbolTable", "]"}], ",", " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Length", "[", "symbolTable", "]"}], " ", "-", " ", 
               "1"}], ")"}], "/", "11"}]}], "]"}], "]"}], "]"}], "]"}]}], 
      "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"#", ",", " ", "Bold"}], "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<symbol\>\"", ",", " ", "\"\<kind\>\"", ",", 
        " ", "\"\<internal name\>\""}], "}"}]}]}], "]"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}]], "Input",Expression\
UUID->"3d86345c-efb3-4562-b743-c66b72f7b9cb"],

Cell["I.7 Verification tests of the symbols", "Section",ExpressionUUID->"ea4ebec4-3c37-4ded-bf3c-c8cc50a0f054"],

Cell[TextData[{
 "Every test below has a name (S-1, S-2, ...), states in words what it \
checks, computes it, and records PASS or FAIL with the numbers that decide it \
in the list ",
 StyleBox["SL31`Test`$Results",
  FontFamily->"Source Code Pro"],
 ". The function ",
 StyleBox["SL31Check[name, statement, condition, details]",
  FontFamily->"Source Code Pro"],
 " does the recording and prints one line."
}], "Text",ExpressionUUID->"3a516ce8-f2f6-4f54-87e4-39e9203b684c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SL31`Test`$Results", " ", "=", " ", 
   RowBox[{"{", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"SL31Check", "[", 
    RowBox[{
    "name_String", ",", " ", "statement_String", ",", " ", "ok_", ",", " ", 
     RowBox[{"details_", " ", ":", " ", "\"\<\>\""}]}], "]"}], " ", ":=", " ", 
   RowBox[{"(", "\n", "   ", 
    RowBox[{
     RowBox[{"AppendTo", "[", 
      RowBox[{"SL31`Test`$Results", ",", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<name\>\"", " ", "->", " ", "name"}], ",", " ", 
         RowBox[{"\"\<pass\>\"", " ", "->", " ", 
          RowBox[{"TrueQ", "[", "ok", "]"}]}], ",", " ", 
         RowBox[{"\"\<statement\>\"", " ", "->", " ", "statement"}], ",", " ", 
         RowBox[{"\"\<details\>\"", " ", "->", " ", "details"}]}], "|>"}]}], 
      "]"}], ";", "\n", "   ", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "the", " ", "details", " ", "are", " ", "printed", " ", "as", " ", 
        "an", " ", "expression"}], ",", " ", 
       RowBox[{
       "so", " ", "that", " ", "the", " ", "symbols", " ", "appear", " ", 
        "in", " ", "their", " ", "printed", " ", "form"}]}], " ", "*)"}], 
     "\n", "   ", 
     RowBox[{"Print", "[", 
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"TrueQ", "[", "ok", "]"}], ",", " ", "\"\<PASS  \>\"", ",",
            " ", "\"\<FAIL  \>\""}], "]"}], ",", " ", "Bold", ",", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"TrueQ", "[", "ok", "]"}], ",", " ", 
           RowBox[{"Darker", "[", "Green", "]"}], ",", " ", "Red"}], "]"}]}], 
        "]"}], ",", " ", "name", ",", " ", "\"\<: \>\"", ",", " ", 
       "statement", ",", "\n", "     ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"details", " ", "===", " ", "\"\<\>\""}], ",", 
         " ", "\"\<\>\"", ",", " ", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<  -- \>\"", ",", " ", "details"}], "}"}], "]"}]}], 
        "]"}]}], "]"}]}], ")"}]}], ";"}]}], "Input",ExpressionUUID->"05041db6-\
44d6-480e-ab42-305996e8cd6f"],

Cell["\<\
S-1 and S-2: every TeX item was converted into boxes (no item failed), and \
every symbolized box is now read as one atomic symbol.\
\>", "Text",ExpressionUUID->"f896655a-cb5d-4f29-9cba-c8c65bb407c1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-1\>\"", ",", 
    " ", "\"\<every one of the TeX items of the registry is converted into a \
box structure\>\"", ",", "\n", "  ", 
    RowBox[{"AllTrue", "[", 
     RowBox[{"items", ",", " ", 
      RowBox[{
       RowBox[{"FreeQ", "[", 
        RowBox[{
         RowBox[{"#", "[", "\"\<boxes\>\"", "]"}], ",", " ", 
         RowBox[{"$Failed", " ", "|", " ", "Null"}]}], "]"}], " ", "&"}]}], 
     "]"}], ",", " ", 
    RowBox[{"Length", "[", "items", "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-2\>\"", ",", 
    " ", "\"\<every symbolized box is read as one atomic symbol (head Symbol)\
\>\"", ",", "\n", "  ", 
    RowBox[{"AllTrue", "[", 
     RowBox[{"symbolTable", ",", " ", 
      RowBox[{
       RowBox[{"MatchQ", "[", 
        RowBox[{
         RowBox[{"#", "[", "\"\<symbol\>\"", "]"}], ",", " ", 
         RowBox[{"HoldComplete", "[", "_Symbol", "]"}]}], "]"}], " ", "&"}]}],
      "]"}], ",", "\n", "  ", 
    RowBox[{"Count", "[", 
     RowBox[{"symbolTable", ",", " ", 
      RowBox[{"r_", " ", "/;", " ", 
       RowBox[{"MatchQ", "[", 
        RowBox[{
         RowBox[{"r", "[", "\"\<symbol\>\"", "]"}], ",", " ", 
         RowBox[{"HoldComplete", "[", "_Symbol", "]"}]}], "]"}]}]}], "]"}]}], 
   "]"}], ";"}]}], "Input",ExpressionUUID->"462e8bf7-4209-4521-a3e2-\
2f266c467178"],

Cell[TextData[{
 "S-0, the strings as the front end reads them. Every string inside every \
symbolized box (the letters, names and numbers of the scripts) must be ONE \
token when the front end reads it as typed text; otherwise the front end \
would cut it before it sends a typed symbol to the kernel, and the symbol \
would not be recognized (section I.2). The test asks the front end itself. \
The command ",
 StyleBox["FrontEndExecute[FrontEnd`UndocumentedTestFEParserPacket[string, \
True]]",
  FontFamily->"Source Code Pro"],
 " is an internal command of the front end: it reads a string exactly as \
typed input is read when a cell is evaluated, and returns the boxes; for a \
single token it returns the string unchanged. (The tags of ",
 StyleBox["TagBox",
  FontFamily->"Source Code Pro"],
 " and the options of ",
 StyleBox["StyleBox",
  FontFamily->"Source Code Pro"],
 " are not input text and are not tested.)"
}], "Text",ExpressionUUID->"40925a01-fce5-40b0-bddd-c18d5c0db87a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"the", " ", "strings", " ", "inside", " ", "a", " ", 
    RowBox[{"box", ":", " ", 
     RowBox[{
     "TagBox", " ", "and", " ", "StyleBox", " ", "wrappers", " ", "are", " ", 
      "opened", " ", "first"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"boxStrings", "[", "b_", "]"}], " ", ":=", " ", 
     RowBox[{"Cases", "[", 
      RowBox[{
       RowBox[{"b", " ", "//.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"TagBox", "[", 
            RowBox[{"x_", ",", " ", "_String", ",", " ", "___"}], "]"}], " ", 
           ":>", " ", "x"}], ",", " ", 
          RowBox[{
           RowBox[{"StyleBox", "[", 
            RowBox[{"x_", ",", " ", "___"}], "]"}], " ", ":>", " ", "x"}]}], 
         "}"}]}], ",", " ", "_String", ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "Infinity"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"allStrings", " ", "=", " ", 
     RowBox[{"Union", "[", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"boxStrings", "[", 
           RowBox[{"#", "[", "\"\<boxes\>\"", "]"}], "]"}], " ", "&"}], ",", 
         " ", "symbolTable"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "how", " ", "the", " ", "front", " ", "end", " ", "reads", " ", "every", " ",
      "one", " ", "of", " ", "them"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"feReading", " ", "=", " ", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"#", " ", "->", " ", 
         RowBox[{"First", "[", 
          RowBox[{"FrontEndExecute", "[", 
           RowBox[{"FrontEnd`UndocumentedTestFEParserPacket", "[", 
            RowBox[{"#", ",", " ", "True"}], "]"}], "]"}], "]"}]}], " ", 
        "&"}], ",", " ", "allStrings"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"cut", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{"feReading", ",", " ", 
       RowBox[{
        RowBox[{"!", " ", 
         RowBox[{"MatchQ", "[", 
          RowBox[{"#", ",", " ", 
           RowBox[{"(", 
            RowBox[{"s_", " ", "->", " ", 
             RowBox[{"BoxData", "[", "s_", "]"}]}], ")"}]}], "]"}]}], " ", 
        "&"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"SL31Check", "[", 
     RowBox[{"\"\<S-0\>\"", ",", 
      " ", "\"\<every string inside the symbolized boxes is one token for the \
front end, so that typed symbols reach the kernel unchanged\>\"", ",", "\n", 
      "  ", 
      RowBox[{"cut", " ", "===", " ", 
       RowBox[{"{", "}"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Length", "[", "allStrings", "]"}], ",", " ", "cut"}], 
       "}"}]}], "]"}], ";"}]}]}]], "Input",ExpressionUUID->"7a577876-e32d-\
4e91-b03e-bfb4f0a06832"],

Cell[TextData[{
 "S-14, the typed symbols. The next cell contains every symbolized symbol of \
the registry, each written in its printed form, exactly as a reader of this \
notebook would type it. When the cell is evaluated, the front end sends these \
boxes to the kernel and the Notation package reads them. Every one must be \
one atomic symbol, and it must be the very symbol that section I.6 created \
from its registry TeX (the list has the order of the table ",
 StyleBox["symbolTable",
  FontFamily->"Source Code Pro"],
 ")."
}], "Text",ExpressionUUID->"3e863681-1d82-4b4a-99b4-c3b2a28471b1"],

