Cell["I.5 The single symbols and their kinds", "Section",ExpressionUUID->"84d88dc3-c51e-4f80-8a2d-efcb3bcacb54"],

Cell[TextData[{
 "An entry may list several symbols, for example \"",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubscriptBox[
     StyleBox["m", "TI"], "LL"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"cd11138f-0cc0-4e6b-a273-8394a9d4cba1"]], "InlineFormula",
  ExpressionUUID->"020fa005-691b-47ad-b7fd-816f61137e09"],
 ", ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubscriptBox["\[Mu]", "LL"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"b21360d1-2c96-4924-8427-49b3789942bd"]], "InlineFormula",
  ExpressionUUID->"31851ba3-0260-4156-87c0-7d2a68ed65a7"],
 ", ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubscriptBox["\[CapitalLambda]", "LL"], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"37745682-7960-42d8-b2c2-cdd47e694925"]], 
  "InlineFormula",ExpressionUUID->"1f0f90cb-02ff-4c11-b98c-41b23f3f7c3f"],
 "\" (the mass of the spinor charges, the chemical potential and the momentum \
cutoff). The next cell takes every TeX segment between dollar signs, splits \
it into single items, converts each into boxes, and classifies it. The kinds \
are: symbol (one fixed object, such as ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"86782af1-dfa8-4cf9-a6e3-720e2d2838e8"]], 
  "InlineFormula",ExpressionUUID->"c6e2cb8e-5c2b-44cd-975c-a2d34cf7fc8b"],
 "); family (a symbol with a running index, such as ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[Tau]", "\[Iota]", "LL"], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"384770ae-ff9f-41ca-aaf9-4b9597cb35d6"]], 
  "InlineFormula",ExpressionUUID->"b68929c3-5f23-41d9-80d8-ea493c50a10d"],
 " with ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{"\[Iota]", "\[LongEqual]", "1", ",", "2", ",", "3"}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "5c227fbd-5cd2-4a03-b6d4-1eae284a3066"]], "InlineFormula",ExpressionUUID->
  "6deede6f-8187-4090-b816-d029af8a7ac0"],
 "); function and function family (a symbol followed by its argument, such as \
",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["W", "TI"], "LL"], "(", 
     StyleBox["u",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"e236ea70-e3c8-4889-825b-02282976277c"]], "InlineFormula",
  ExpressionUUID->"a9d94157-f6df-4370-a16a-24a01522cc94"],
 "); letter (a single letter such as ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    StyleBox["D", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "a41cb209-0268-4639-87ca-eb6de36aa5e0"]], "InlineFormula",ExpressionUUID->
  "4d9ac971-2fa7-465a-beb2-e5bb2b7396a7"],
 ", the number of space dimensions); index and primed index (",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "46def5ef-253c-4765-9cf3-31eda887100a"]], "InlineFormula",ExpressionUUID->
  "0b9af2ba-a737-4be4-8976-748a9cfe9aa8"],
 ", ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SuperscriptBox[
     StyleBox["p", "TI"], "\[Prime]"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"b1472a5d-3cc4-40ae-bb17-fdc196245a91"]], "InlineFormula",
  ExpressionUUID->"7fe913e5-305e-45f8-b606-5c87453ade3e"],
 ", ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    StyleBox["j", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "22b40797-d3c4-4ba9-87f1-537edcc84ec6"]], "InlineFormula",ExpressionUUID->
  "0c1ca981-5b9d-4c6d-8643-79ba7c151321"],
 ", ",
 Cell[BoxData[Cell[BoxData[
   FormBox["\[Iota]", TraditionalForm]], "InlineFormula",ExpressionUUID->
   "544ef8eb-446d-4a1f-a4f5-b7789c397977"]], "InlineFormula",ExpressionUUID->
  "a4254901-d92c-433b-9713-1d7c9cdb4f5d"],
 ", ...); set (",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    StyleBox["\[DoubleStruckCapitalR]",
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "3172667b-2712-454c-8bdf-7e2894ab3b48"]], "InlineFormula",ExpressionUUID->
  "e06e6179-0720-4e66-810d-10c62cf85048"],
 ", ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    StyleBox["\[DoubleStruckCapitalC]",
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "b22ddc30-fede-4239-b12b-2c0182d9f6d4"]], "InlineFormula",ExpressionUUID->
  "b222e1b2-6bfe-4f09-a66e-5f3909415812"],
 ", ...); group (",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{"SL", "(", 
     RowBox[{"2", ",", 
      StyleBox["\[DoubleStruckCapitalC]",
       FontSlant->"Plain"]}], ")"}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"53526deb-647b-40f1-ae3c-dd76dea4db0c"]], "InlineFormula",
  ExpressionUUID->"09327d7f-8596-4ffb-bfb8-25a6509bd13f"],
 ", ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{"SU", 
     SubscriptBox[
      RowBox[{"(", "2", ")"}], "v"]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"a2b1a928-eee1-4ac7-81ba-ea76a9bd0a88"]], "InlineFormula",
  ExpressionUUID->"4e61d3d8-f4e9-4806-bf6f-d7e121888727"],
 ", ...); ket; operator (tr, det, the transpose, the tensor product, ...); \
expression (a combination such as ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SuperscriptBox[
     RowBox[{"(", 
      SubscriptBox[
       StyleBox["T", "TI"], "LL"], ")"}], "2"], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"77d133ca-7d2f-44f7-89c9-7ecb3509e25f"]], 
  "InlineFormula",ExpressionUUID->"aaa7c5cf-4d2e-4485-bbfe-e3bd07d683af"],
 "); imaginary unit. Entries that are not written in TeX at all are the \
labels of the machine checks and of the hypotheses of the no-go theorems; \
they are names, not symbols, and are kept as text."
}], "Text",ExpressionUUID->"f86da453-3de1-4f8b-8aa5-110729c67487"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "every", " ", "TeX", " ", "segment", " ", "of", " ", "every", " ", 
    RowBox[{"entry", ":", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"entry", " ", "number"}], ",", " ", "segment"}], "}"}]}]}], 
   " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"segments", " ", "=", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{"e", ",", " ", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"e", "[", "\"\<entry\>\"", "]"}], ",", " ", "#"}], 
               "}"}], " ", "&"}], ",", " ", 
             RowBox[{"StringCases", "[", 
              RowBox[{
               RowBox[{"e", "[", "\"\<symbol\>\"", "]"}], ",", " ", 
               RowBox[{
                RowBox[{"\"\<$\>\"", " ", "~~", " ", 
                 RowBox[{"Shortest", "[", "x__", "]"}], " ", "~~", 
                 " ", "\"\<$\>\""}], " ", ":>", " ", "x"}]}], "]"}]}], 
            "]"}]}], "]"}], ",", " ", "SL31Registry"}], "]"}], ",", " ", 
       "1"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"the", " ", "entries", " ", "without", " ", "any", " ", 
     RowBox[{"TeX", ":", " ", "labels"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"labelEntries", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{"SL31Registry", ",", " ", 
       RowBox[{
        RowBox[{"!", " ", 
         RowBox[{"StringContainsQ", "[", 
          RowBox[{
           RowBox[{"#", "[", "\"\<symbol\>\"", "]"}], ",", " ", "\"\<$\>\""}],
           "]"}]}], " ", "&"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "split", " ", "every", " ", "segment", " ", "into", " ", "single", " ", 
     "items", " ", "and", " ", "convert", " ", "each", " ", "item"}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"items", " ", "=", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{"s", ",", " ", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"<|", 
               RowBox[{
                RowBox[{"\"\<entry\>\"", " ", "->", " ", 
                 RowBox[{"s", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
                RowBox[{"\"\<tex\>\"", " ", "->", " ", "#"}], ",", " ", 
                RowBox[{"\"\<boxes\>\"", " ", "->", " ", 
                 RowBox[{"SL31TeXToBoxes", "[", "#", "]"}]}]}], "|>"}], " ", 
              "&"}], ",", " ", 
             RowBox[{"SL31SplitTeX", "[", 
              RowBox[{"s", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "]"}]}], "]"}], ",", 
         " ", "segments"}], "]"}], ",", " ", "1"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"items", " ", "=", " ", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Append", "[", 
         RowBox[{"#", ",", " ", 
          RowBox[{"\"\<kind\>\"", " ", "->", " ", 
           RowBox[{"SL31Classify", "[", 
            RowBox[{
             RowBox[{"#", "[", "\"\<tex\>\"", "]"}], ",", " ", 
             RowBox[{"#", "[", "\"\<boxes\>\"", "]"}]}], "]"}]}]}], "]"}], 
        " ", "&"}], ",", " ", "items"}], "]"}]}], ";"}], "\n", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", "[", "segments", "]"}], ",", " ", 
     RowBox[{"Length", "[", "items", "]"}], ",", " ", 
     RowBox[{"Length", "[", "labelEntries", "]"}]}], "}"}]}]}]], "Input",Expre\
ssionUUID->"41def2e8-2109-4011-a666-80aa69adb897"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "how", " ", "many", " ", "items", " ", "of", " ", "each", " ", "kind"}], 
   " ", "*)"}], "\n", 
  RowBox[{"ReverseSort", "[", 
   RowBox[{"Counts", "[", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"#", "[", "\"\<kind\>\"", "]"}], " ", "&"}], ",", " ", 
      "items"}], "]"}], "]"}], "]"}]}]], "Input",ExpressionUUID->"125e4212-\
1c73-4936-b248-452a0d63ecd2"],

Cell["I.6 Symbolizing every symbol", "Section",ExpressionUUID->"2163113f-e887-4d64-8164-12a5ba82e626"],

Cell[TextData[{
 "Now every item of the kinds symbol, family, function, function family, \
letter, primed index, group, ket and expression is symbolized: ",
 StyleBox["SL31Symbolize",
  FontFamily->"Source Code Pro"],
 " calls ",
 StyleBox["Symbolize",
  FontFamily->"Source Code Pro"],
 " with the explicit working form and with a readable name built from the \
letters, the scripts and the alphabet, and returns the new symbol, held. \
Items whose boxes coincide are ONE symbol and are symbolized once: a function \
symbol written with different arguments, such as ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["N", "TI"], "LL"], "(", 
     StyleBox["x",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"f59e3f89-daa3-4272-aa43-a047a55e9b26"]], "InlineFormula",
  ExpressionUUID->"0414f7de-6369-4e7c-99a6-34524ddb77d3"],
 " and ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["N", "TI"], "LL"], "(", 
     RowBox[{
      StyleBox["x",
       FontWeight->"Bold",
       FontSlant->"Plain"], ",", 
      StyleBox["y",
       FontWeight->"Bold",
       FontSlant->"Plain"]}], ")"}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"1d15a9fe-a945-4dfd-bc58-dc3af2362cb0"]], "InlineFormula",
  ExpressionUUID->"44a18d78-a8e7-4569-8add-9303b5ced8da"],
 ", has the one head ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubscriptBox[
     StyleBox["N", "TI"], "LL"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"497cedcf-d6a7-48a9-bab8-8474ab0db8e1"]], "InlineFormula",
  ExpressionUUID->"2a920456-89a0-484f-afcc-66a490ca2e01"],
 " (symbolizing the same box twice would only replace the first \
symbolization, with a warning of the Notation package). For every new symbol \
the cell also stores its meaning as the usage message (so that ",
 StyleBox["?symbol",
  FontFamily->"Source Code Pro"],
 " prints it), and a formatting rule for ",
 StyleBox["TraditionalForm",
  FontFamily->"Source Code Pro"],
 ": ",
 StyleBox["TeXForm",
  FontFamily->"Source Code Pro"],
 " writes TeX from the ",
 StyleBox["TraditionalForm",
  FontFamily->"Source Code Pro"],
 " boxes of an expression, so with this rule the symbol is written in TeX \
with its printed form and not with its internal name."
}], "Text",ExpressionUUID->"703d65c6-26b6-4145-83f9-f0ff90dceb94"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", "items", " ", "that", " ", "are", " ", "symbolized"}],
     ",", " ", 
    RowBox[{"each", " ", "TeX", " ", "item", " ", "once"}]}], " ", "*)"}], 
  "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"toSymbolize", " ", "=", " ", 
     RowBox[{"DeleteDuplicatesBy", "[", 
      RowBox[{
       RowBox[{"Select", "[", 
        RowBox[{"items", ",", " ", 
         RowBox[{
          RowBox[{"MemberQ", "[", 
           RowBox[{"SL31Symbolized", ",", " ", 
            RowBox[{"#", "[", "\"\<kind\>\"", "]"}]}], "]"}], " ", "&"}]}], 
        "]"}], ",", " ", 
       RowBox[{
        RowBox[{"#", "[", "\"\<tex\>\"", "]"}], " ", "&"}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "items", " ", "with", " ", "the", " ", "same", " ", "boxes", " ", "are", " ",
      "one", " ", 
     RowBox[{"symbol", ":", " ", 
      RowBox[{
      "they", " ", "are", " ", "gathered", " ", "into", " ", "groups"}]}]}], 
    " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"byBoxes", " ", "=", " ", 
     RowBox[{"GatherBy", "[", 
      RowBox[{"toSymbolize", ",", " ", 
       RowBox[{
        RowBox[{"SL31SymbolBoxes", "[", 
         RowBox[{"#", "[", "\"\<tex\>\"", "]"}], "]"}], " ", "&"}]}], "]"}]}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"meaningOf", " ", "=", " ", 
     RowBox[{"Association", "[", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", "\"\<entry\>\"", "]"}], " ", "->", " ", 
          RowBox[{"#", "[", "\"\<meaning\>\"", "]"}]}], " ", "&"}], ",", " ", 
        "SL31Registry"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"symbolize", " ", "every", " ", "group"}], ";", " ", 
      RowBox[{"record", " ", "the", " ", "TeX", " ", "items"}]}], ",", " ", 
     RowBox[{"the", " ", "entries"}], ",", " ", 
     RowBox[{"the", " ", "kind"}], ",", " ", 
     RowBox[{
     "the", " ", "boxes", " ", "and", " ", "the", " ", "held", " ", 
      "symbol"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"symbolTable", " ", "=", " ", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{"group", ",", " ", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"b", " ", "=", " ", 
              RowBox[{"SL31SymbolBoxes", "[", 
               RowBox[{
                RowBox[{"First", "[", "group", "]"}], "[", "\"\<tex\>\"", 
                "]"}], "]"}]}], ",", " ", "h", ",", " ", "texs", ",", " ", 
             "entries"}], "}"}], ",", "\n", "      ", 
           RowBox[{
            RowBox[{"texs", " ", "=", " ", 
             RowBox[{"Map", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"#", "[", "\"\<tex\>\"", "]"}], " ", "&"}], ",", " ", 
               "group"}], "]"}]}], ";", "\n", "      ", 
            RowBox[{"entries", " ", "=", " ", 
             RowBox[{"DeleteDuplicates", "[", 
              RowBox[{"Map", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"#", "[", "\"\<entry\>\"", "]"}], " ", "&"}], ",", 
                " ", "group"}], "]"}], "]"}]}], ";", "\n", "      ", 
            RowBox[{"h", " ", "=", " ", 
             RowBox[{"SL31Symbolize", "[", "b", "]"}]}], ";", "\n", "      ", 
            
            RowBox[{"(*", " ", 
             RowBox[{"the", " ", "usage", " ", 
              RowBox[{"message", ":", " ", 
               RowBox[{
               "the", " ", "TeX", " ", "items", " ", "of", " ", "the", " ", 
                "symbol", " ", "and", " ", "the", " ", "meanings", " ", "of", 
                " ", "their", " ", "entries"}]}]}], " ", "*)"}], "\n", 
            "      ", 
            RowBox[{"Replace", "[", 
             RowBox[{"h", ",", " ", 
              RowBox[{
               RowBox[{"HoldComplete", "[", "s_Symbol", "]"}], " ", ":>", 
               "\n", "        ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"MessageName", "[", 
                  RowBox[{"s", ",", " ", "\"\<usage\>\""}], "]"}], " ", "=", 
                 " ", 
                 RowBox[{
                  RowBox[{"StringRiffle", "[", 
                   RowBox[{"texs", ",", " ", "\"\<, \>\""}], "]"}], " ", "<>",
                   " ", "\"\<: \>\"", " ", "<>", " ", 
                  RowBox[{"StringRiffle", "[", 
                   RowBox[{
                    RowBox[{"Map", "[", 
                    RowBox[{"meaningOf", ",", " ", "entries"}], "]"}], ",", 
                    " ", "\"\< | \>\""}], "]"}]}]}], ")"}]}]}], "]"}], ";", 
            "\n", "      ", 
            RowBox[{"(*", " ", 
             RowBox[{
              RowBox[{"TraditionalForm", " ", 
               RowBox[{"(", 
                RowBox[{"and", " ", "therefore", " ", "TeXForm"}], ")"}], " ",
                "shows", " ", "the", " ", "printed", " ", "form"}], ",", " ", 
              
              RowBox[{"not", " ", "the", " ", "internal", " ", "name"}]}], 
             " ", "*)"}], "\n", "      ", 
            RowBox[{"Replace", "[", 
             RowBox[{"h", ",", " ", 
              RowBox[{
               RowBox[{"HoldComplete", "[", "s_Symbol", "]"}], " ", ":>", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"MakeBoxes", "[", 
                  RowBox[{"s", ",", " ", "TraditionalForm"}], "]"}], " ", "=",
                  " ", "b"}], ")"}]}]}], "]"}], ";", "\n", "      ", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<entries\>\"", " ", "->", " ", "entries"}], ",", 
              " ", 
              RowBox[{"\"\<tex\>\"", " ", "->", " ", 
               RowBox[{"First", "[", "texs", "]"}]}], ",", " ", 
              RowBox[{"\"\<texAll\>\"", " ", "->", " ", "texs"}], ",", " ", 
              RowBox[{"\"\<kind\>\"", " ", "->", " ", 
               RowBox[{
                RowBox[{"First", "[", "group", "]"}], "[", "\"\<kind\>\"", 
                "]"}]}], ",", "\n", "        ", 
              RowBox[{"\"\<boxes\>\"", " ", "->", " ", "b"}], ",", " ", 
              RowBox[{"\"\<symbol\>\"", " ", "->", " ", "h"}]}], "|>"}]}]}], 
          "]"}]}], "]"}], ",", "\n", "   ", "byBoxes"}], "]"}]}], ";"}], "\n", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", "[", "toSymbolize", "]"}], ",", " ", 
     RowBox[{"Length", "[", "symbolTable", "]"}]}], "}"}]}]}]], "Input",Expres\
sionUUID->"350ff7b2-a7d5-480b-921f-a5c783583ba7"],

Cell["The TeX items that share one symbol, with their entries:", "Text",ExpressionUUID->"57fe5aeb-8a3a-4fee-af48-4890f1cb4719"],

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"RawBoxes", "[", 
           RowBox[{"#", "[", "\"\<boxes\>\"", "]"}], "]"}], ",", " ", 
          RowBox[{"Column", "[", 
           RowBox[{"#", "[", "\"\<texAll\>\"", "]"}], "]"}], ",", " ", 
          RowBox[{"#", "[", "\"\<entries\>\"", "]"}]}], "}"}], " ", "&"}], ",",
        " ", 
       RowBox[{"Select", "[", 
        RowBox[{"symbolTable", ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", 
            RowBox[{"#", "[", "\"\<texAll\>\"", "]"}], "]"}], " ", ">", " ", 
           "1"}], " ", "&"}]}], "]"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"#", ",", " ", "Bold"}], "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<symbol\>\"", ",", " ", "\"\<TeX items\>\"", ",", 
        " ", "\"\<entries\>\""}], "}"}]}]}], "]"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}]], "Input",Expression\
UUID->"a3a2020d-fd62-4cbf-8235-585bc5ad8a37"],

Cell["\<\
Twelve symbols chosen from the nine groups, as the notebook now prints them, \
with their internal names:\
\>", "Text",ExpressionUUID->"7165e23e-7239-4d84-8677-1295df54e583"],

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"RawBoxes", "[", 
           RowBox[{"#", "[", "\"\<boxes\>\"", "]"}], "]"}], ",", " ", 
          RowBox[{"#", "[", "\"\<kind\>\"", "]"}], ",", " ", 
          RowBox[{"Replace", "[", 
           RowBox[{
            RowBox[{"#", "[", "\"\<symbol\>\"", "]"}], ",", " ", 
            RowBox[{
             RowBox[{"HoldComplete", "[", "s_", "]"}], " ", ":>", " ", 
             RowBox[{"SymbolName", "[", 
              RowBox[{"Unevaluated", "[", "s", "]"}], "]"}]}]}], "]"}]}], 
         "}"}], " ", "&"}], ",", "\n", "    ", 
       RowBox[{"symbolTable", "[", 
        RowBox[{"[", 
         RowBox[{"Round", "[", 
          RowBox[{"Range", "[", 
           RowBox[{"1", ",", " ", 
            RowBox[{"Length", "[", "symbolTable", "]"}], ",", " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Length", "[", "symbolTable", "]"}], " ", "-", " ", 
               "1"}], ")"}], "/", "11"}]}], "]"}], "]"}], "]"}], "]"}]}], 
      "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"#", ",", " ", "Bold"}], "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<symbol\>\"", ",", " ", "\"\<kind\>\"", ",", 
        " ", "\"\<internal name\>\""}], "}"}]}]}], "]"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}]], "Input",Expression\
UUID->"6d3b088c-684d-438e-bc73-2e4c6a80b6ff"],

Cell["I.7 Verification tests of the symbols", "Section",ExpressionUUID->"fa8a76c5-5afc-4a25-ad58-aa0e1fb2eecd"],

Cell[TextData[{
 "Every test below has a name (S-1, S-2, ...), states in words what it \
checks, computes it, and records PASS or FAIL with the numbers that decide it \
in the list ",
 StyleBox["SL31`Test`$Results",
  FontFamily->"Source Code Pro"],
 ". The function ",
 StyleBox["SL31Check[name, statement, condition, details]",
  FontFamily->"Source Code Pro"],
 " does the recording and prints one line."
}], "Text",ExpressionUUID->"a11353a9-5be8-408a-a1a2-78cd7ac1def8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SL31`Test`$Results", " ", "=", " ", 
   RowBox[{"{", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"SL31Check", "[", 
    RowBox[{
    "name_String", ",", " ", "statement_String", ",", " ", "ok_", ",", " ", 
     RowBox[{"details_", " ", ":", " ", "\"\<\>\""}]}], "]"}], " ", ":=", " ", 
   RowBox[{"(", "\n", "   ", 
    RowBox[{
     RowBox[{"AppendTo", "[", 
      RowBox[{"SL31`Test`$Results", ",", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<name\>\"", " ", "->", " ", "name"}], ",", " ", 
         RowBox[{"\"\<pass\>\"", " ", "->", " ", 
          RowBox[{"TrueQ", "[", "ok", "]"}]}], ",", " ", 
         RowBox[{"\"\<statement\>\"", " ", "->", " ", "statement"}], ",", " ", 
         RowBox[{"\"\<details\>\"", " ", "->", " ", "details"}]}], "|>"}]}], 
      "]"}], ";", "\n", "   ", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "the", " ", "details", " ", "are", " ", "printed", " ", "as", " ", 
        "an", " ", "expression"}], ",", " ", 
       RowBox[{
       "so", " ", "that", " ", "the", " ", "symbols", " ", "appear", " ", 
        "in", " ", "their", " ", "printed", " ", "form"}]}], " ", "*)"}], 
     "\n", "   ", 
     RowBox[{"Print", "[", 
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"TrueQ", "[", "ok", "]"}], ",", " ", "\"\<PASS  \>\"", ",",
            " ", "\"\<FAIL  \>\""}], "]"}], ",", " ", "Bold", ",", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"TrueQ", "[", "ok", "]"}], ",", " ", 
           RowBox[{"Darker", "[", "Green", "]"}], ",", " ", "Red"}], "]"}]}], 
        "]"}], ",", " ", "name", ",", " ", "\"\<: \>\"", ",", " ", 
       "statement", ",", "\n", "     ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"details", " ", "===", " ", "\"\<\>\""}], ",", 
         " ", "\"\<\>\"", ",", " ", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<  -- \>\"", ",", " ", "details"}], "}"}], "]"}]}], 
        "]"}]}], "]"}]}], ")"}]}], ";"}]}], "Input",ExpressionUUID->"13bbba01-\
fe5a-4edf-b304-f5d06557a20f"],

Cell["\<\
S-1 and S-2: every TeX item was converted into boxes (no item failed), and \
every symbolized box is now read as one atomic symbol.\
\>", "Text",ExpressionUUID->"3aae2b0e-36ce-44cc-9007-11529072397b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-1\>\"", ",", 
    " ", "\"\<every one of the TeX items of the registry is converted into a \
box structure\>\"", ",", "\n", "  ", 
    RowBox[{"AllTrue", "[", 
     RowBox[{"items", ",", " ", 
      RowBox[{
       RowBox[{"FreeQ", "[", 
        RowBox[{
         RowBox[{"#", "[", "\"\<boxes\>\"", "]"}], ",", " ", 
         RowBox[{"$Failed", " ", "|", " ", "Null"}]}], "]"}], " ", "&"}]}], 
     "]"}], ",", " ", 
    RowBox[{"Length", "[", "items", "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-2\>\"", ",", 
    " ", "\"\<every symbolized box is read as one atomic symbol (head Symbol)\
\>\"", ",", "\n", "  ", 
    RowBox[{"AllTrue", "[", 
     RowBox[{"symbolTable", ",", " ", 
      RowBox[{
       RowBox[{"MatchQ", "[", 
        RowBox[{
         RowBox[{"#", "[", "\"\<symbol\>\"", "]"}], ",", " ", 
         RowBox[{"HoldComplete", "[", "_Symbol", "]"}]}], "]"}], " ", "&"}]}],
      "]"}], ",", "\n", "  ", 
    RowBox[{"Count", "[", 
     RowBox[{"symbolTable", ",", " ", 
      RowBox[{"r_", " ", "/;", " ", 
       RowBox[{"MatchQ", "[", 
        RowBox[{
         RowBox[{"r", "[", "\"\<symbol\>\"", "]"}], ",", " ", 
         RowBox[{"HoldComplete", "[", "_Symbol", "]"}]}], "]"}]}]}], "]"}]}], 
   "]"}], ";"}]}], "Input",ExpressionUUID->"75b307bf-de75-4b29-a86b-\
f770a567c848"],

Cell[TextData[{
 "S-0, the strings as the front end reads them. Every string inside every \
symbolized box (the letters, names and numbers of the scripts) must be ONE \
token when the front end reads it as typed text; otherwise the front end \
would cut it before it sends a typed symbol to the kernel, and the symbol \
would not be recognized (section I.2). The test asks the front end itself. \
The command ",
 StyleBox["FrontEndExecute[FrontEnd`UndocumentedTestFEParserPacket[string, \
True]]",
  FontFamily->"Source Code Pro"],
 " is an internal command of the front end: it reads a string exactly as \
typed input is read when a cell is evaluated, and returns the boxes; for a \
single token it returns the string unchanged. (The tags of ",
 StyleBox["TagBox",
  FontFamily->"Source Code Pro"],
 " and the options of ",
 StyleBox["StyleBox",
  FontFamily->"Source Code Pro"],
 " are not input text and are not tested.)"
}], "Text",ExpressionUUID->"35f323fd-ab17-4997-a1d9-447b72909529"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"the", " ", "strings", " ", "inside", " ", "a", " ", 
    RowBox[{"box", ":", " ", 
     RowBox[{
     "TagBox", " ", "and", " ", "StyleBox", " ", "wrappers", " ", "are", " ", 
      "opened", " ", "first"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"boxStrings", "[", "b_", "]"}], " ", ":=", " ", 
     RowBox[{"Cases", "[", 
      RowBox[{
       RowBox[{"b", " ", "//.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"TagBox", "[", 
            RowBox[{"x_", ",", " ", "_String", ",", " ", "___"}], "]"}], " ", 
           ":>", " ", "x"}], ",", " ", 
          RowBox[{
           RowBox[{"StyleBox", "[", 
            RowBox[{"x_", ",", " ", "___"}], "]"}], " ", ":>", " ", "x"}]}], 
         "}"}]}], ",", " ", "_String", ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "Infinity"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"allStrings", " ", "=", " ", 
     RowBox[{"Union", "[", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"boxStrings", "[", 
           RowBox[{"#", "[", "\"\<boxes\>\"", "]"}], "]"}], " ", "&"}], ",", 
         " ", "symbolTable"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "how", " ", "the", " ", "front", " ", "end", " ", "reads", " ", "every", " ",
      "one", " ", "of", " ", "them"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"feReading", " ", "=", " ", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"#", " ", "->", " ", 
         RowBox[{"First", "[", 
          RowBox[{"FrontEndExecute", "[", 
           RowBox[{"FrontEnd`UndocumentedTestFEParserPacket", "[", 
            RowBox[{"#", ",", " ", "True"}], "]"}], "]"}], "]"}]}], " ", 
        "&"}], ",", " ", "allStrings"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"cut", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{"feReading", ",", " ", 
       RowBox[{
        RowBox[{"!", " ", 
         RowBox[{"MatchQ", "[", 
          RowBox[{"#", ",", " ", 
           RowBox[{"(", 
            RowBox[{"s_", " ", "->", " ", 
             RowBox[{"BoxData", "[", "s_", "]"}]}], ")"}]}], "]"}]}], " ", 
        "&"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"SL31Check", "[", 
     RowBox[{"\"\<S-0\>\"", ",", 
      " ", "\"\<every string inside the symbolized boxes is one token for the \
front end, so that typed symbols reach the kernel unchanged\>\"", ",", "\n", 
      "  ", 
      RowBox[{"cut", " ", "===", " ", 
       RowBox[{"{", "}"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Length", "[", "allStrings", "]"}], ",", " ", "cut"}], 
       "}"}]}], "]"}], ";"}]}]}]], "Input",ExpressionUUID->"96fa6c9a-b45b-\
4cf7-8283-8df9f66af97e"],

Cell[TextData[{
 "S-14, the typed symbols. The next cell contains every symbolized symbol of \
the registry, each written in its printed form, exactly as a reader of this \
notebook would type it. When the cell is evaluated, the front end sends these \
boxes to the kernel and the Notation package reads them. Every one must be \
one atomic symbol, and it must be the very symbol that section I.6 created \
from its registry TeX (the list has the order of the table ",
 StyleBox["symbolTable",
  FontFamily->"Source Code Pro"],
 ")."
}], "Text",ExpressionUUID->"016b78af-d5fb-49a0-b0e6-a06dae6d64c2"],

