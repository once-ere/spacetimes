             " ", 
             RowBox[{"{", 
              RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}], 
           " ", "+", "\n", "     ", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{"0.25", " ", 
              RowBox[{
               RowBox[{"t2lift4", "[", 
                RowBox[{"comm", "[", 
                 RowBox[{
                  RowBox[{"g", "[", 
                   RowBox[{"[", 
                    RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}], ",", " ", 
                  RowBox[{"g", "[", 
