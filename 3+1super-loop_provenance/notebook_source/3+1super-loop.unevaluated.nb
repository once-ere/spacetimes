Cell["I.4 The registry of the symbols", "Section",ExpressionUUID->"bc380e05-2f33-4997-82d5-a7db8a689977"],

Cell["\<\
The next cell holds the complete registry of the symbols of the super-loop \
revision: 204 entries. Every entry is an association with the keys \"entry\" \
(its number), \"group\" (one of nine groups), \"symbol\" (the printed forms, \
in TeX, between dollar signs), \"names\" (the plain-text names used by \
programs and data files), \"meaning\", \"meaningEdited\" (True where the \
meaning was restated so that this notebook is complete in itself: the \
original wording pointed to equations, theorems or sections of other texts) \
and \"origin\".\
\>", "Text",ExpressionUUID->"b7739151-2f0e-446d-a2df-b6b4f4a1335d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "The", " ", "registry", " ", "of", " ", "the", " ", "symbols", " ", "of", 
     " ", "the", " ", "super"}], "-", 
    RowBox[{"loop", " ", 
     RowBox[{"revision", ":", " ", 
      RowBox[{"204", " ", "entries", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"group", ",", " ", 
          RowBox[{"TeX", " ", "of", " ", "the", " ", "symbols"}], ",", " ", 
          RowBox[{"plain", "-", 
           RowBox[{"text", " ", "names"}]}], ",", " ", "meaning", ",", " ", 
          "origin"}], ")"}], "."}]}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"SL31Registry", " ", "=", " ", 
     RowBox[{"{", "\n", 
      RowBox[{
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<entry\>\"", " ", "->", " ", "1"}], ",", " ", 
         RowBox[{"\"\<group\>\"", " ", "->", 
          " ", "\"\<1 Indices, conventions and number sets\>\""}], ",", " ", 
         RowBox[{"\"\<symbol\>\"", " ", "->", " ", "\"\<$i,j$\>\""}], ",", 
         " ", 
         RowBox[{"\"\<names\>\"", " ", "->", " ", 
          RowBox[{"{", 
           
           RowBox[{"\"\<j\>\"", ",", " ", "\"\<j'\>\"", ",", 
            " ", "\"\<j''\>\""}], "}"}]}], ",", " ", 
         RowBox[{"\"\<meaning\>\"", " ", "->", 
          " ", "\"\<index of space-like coordinates; values 1, 2, 3 (ordinary \
space) unless a sum is said to run over all space-like coordinates of the \
spacetime. In Revision\\\\_SuperLoop only $j$ is used as an index, with the \
values 1, 2, 3, and with primes ($j'$, $j''$) where two or three such indices \
are needed: it labels the three imaginary quaternion units $\\\\mathbf e_j$, \
which correspond to the three space directions of $\\\\mathbb R^{1,3}_{\\\\rm \
LL}$, the coordinates $x^j_{\\\\rm LL}$, the momentum components $q^j_{\\\\rm \
LL}$, the rotation and boost generators $J^j_{\\\\rm LL}$, $K^j_{\\\\rm LL}$, \
and the Pauli matrices $\\\\sigma^{\\\\rm LL}_j$ and Dirac matrices \
$\\\\alpha^j_{\\\\rm LL}$, $\\\\gamma^j_{\\\\rm LL}$. The letter $i$ is the \
imaginary unit (entry $i$); the isospin index is $\\\\iota$ (a different \
letter).\>\""}], ",", " ", 
         RowBox[{"\"\<meaningEdited\>\"", " ", "->", " ", "False"}], ",", " ", 
         RowBox[{"\"\<origin\>\"", " ", "->", 
          " ", "\"\<taken from the MASTER registry of the main \
project\>\""}]}], "|>"}], ",", "\n", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<entry\>\"", " ", "->", " ", "2"}], ",", " ", 
         RowBox[{"\"\<group\>\"", " ", "->", 
          " ", "\"\<1 Indices, conventions and number sets\>\""}], ",", " ", 
         RowBox[{"\"\<symbol\>\"", " ", "->", " ", "\"\<$D$\>\""}], ",", " ", 
         
         RowBox[{"\"\<names\>\"", " ", "->", " ", 
          RowBox[{"{", "\"\<D\>\"", "}"}]}], ",", " ", 
         RowBox[{"\"\<meaning\>\"", " ", "->", 
          " ", "\"\<the number of space dimensions in which the particles of \
matter have momentum: 7 (all space coordinates of 7+1), 4 (fields that do not \
depend on $x5,x6,x7$) or 3 (fields that depend on ordinary space only). $V_D=\
\\\\pi^{D/2}/\\\\Gamma_{\\\\rm E}(D/2+1)$ is the volume and $A_D=D\\\\,V_D$ \
the area of the unit ball in $D$ dimensions ($\\\\Gamma_{\\\\rm E}$: Euler's \
gamma function). In the super-loop revision $D=3$ for the four-dimensional \
world of the superfluid and $D=7$ for the eight-dimensional manifolds; the \
value 4, the coordinates $x5,x6,x7$ and the volume and the area of the unit \
ball do not occur. In the kinetic Lagrangian of the superfluid boson singlet \
state $D$ is also continued away from 3: in dimensional regularization the \
momentum integrals are taken in $D$ space dimensions.\>\""}], ",", " ", 
         RowBox[{"\"\<meaningEdited\>\"", " ", "->", " ", "True"}], ",", " ", 
         
         RowBox[{"\"\<origin\>\"", " ", "->", 
          " ", "\"\<taken from the MASTER registry of the revision on the \
deflating spacetimes\>\""}]}], "|>"}], ",", "\n", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<entry\>\"", " ", "->", " ", "3"}], ",", " ", 
         RowBox[{"\"\<group\>\"", " ", "->", 
          " ", "\"\<1 Indices, conventions and number sets\>\""}], ",", " ", 
         RowBox[{"\"\<symbol\>\"", " ", "->", " ", "\"\<$i$\>\""}], ",", " ", 
         
         RowBox[{"\"\<names\>\"", " ", "->", " ", 
          RowBox[{"{", "}"}]}], ",", " ", 
         RowBox[{"\"\<meaning\>\"", " ", "->", 
          " ", "\"\<the imaginary unit, $i^2=-1$; in $\\\\mathbb B_{\\\\rm \
LL}$ it is the imaginary unit of the complex coefficients: it commutes and \
associates with every bi-octonion and is not one of the units $\\\\mathbf \
e_1,\\\\dots,\\\\mathbf e_7$\>\""}], ",", " ", 
         RowBox[{"\"\<meaningEdited\>\"", " ", "->", " ", "False"}], ",", " ", 
         RowBox[{"\"\<origin\>\"", " ", "->", 
          " ", "\"\<new (Revision_SuperLoop)\>\""}]}], "|>"}], ",", "\n", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<entry\>\"", " ", "->", " ", "4"}], ",", " ", 
         RowBox[{"\"\<group\>\"", " ", "->", 
          " ", "\"\<1 Indices, conventions and number sets\>\""}], ",", " ", 
         RowBox[{"\"\<symbol\>\"", " ", "->", 
          " ", "\"\<$\\\\mathbb R$, $\\\\mathbb C$\>\""}], ",", " ", 
         RowBox[{"\"\<names\>\"", " ", "->", " ", 
          RowBox[{"{", 
           
           RowBox[{"\"\<R\>\"", ",", " ", "\"\<C\>\"", ",", " ", "\"\<R^8\>\"",
             ",", " ", "\"\<C^3\>\"", ",", " ", "\"\<C^8\>\""}], "}"}]}], ",",
          " ", 
         RowBox[{"\"\<meaning\>\"", " ", "->", 
          " ", "\"\<the real and the complex numbers (plain text: `R^8`, \
`C^3`, `C^8` are the real or complex vector spaces of that dimension)\>\""}], 
         ",", " ", 
         RowBox[{"\"\<meaningEdited\>\"", " ", "->", " ", "False"}], ",", " ", 
         RowBox[{"\"\<origin\>\"", " ", "->", 
          " ", "\"\<new (Revision_SuperLoop)\>\""}]}], "|>"}], ",", "\n", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<entry\>\"", " ", "->", " ", "5"}], ",", " ", 
         RowBox[{"\"\<group\>\"", " ", "->", 
          " ", "\"\<1 Indices, conventions and number sets\>\""}], ",", " ", 
         RowBox[{"\"\<symbol\>\"", " ", "->", " ", "\"\<$p$, $p'$\>\""}], ",",
          " ", 
         RowBox[{"\"\<names\>\"", " ", "->", " ", 
          RowBox[{"{", 
           
           RowBox[{"\"\<p\>\"", ",", " ", "\"\<p'\>\"", ",", " ", "\"\<p1\>\"",
             ",", " ", "\"\<p2\>\"", ",", " ", "\"\<p3\>\""}], "}"}]}], ",", 
         " ", 
         RowBox[{"\"\<meaning\>\"", " ", "->", 
          " ", "\"\<a summation index over the basis of an algebra (values \
$0,\\\\dots,7$, or $0,\\\\dots,3$ for the quaternions): in \
Revision\\\\_SuperLoop it labels the units $\\\\mathbf e_p$ of $\\\\mathbb \
B_{\\\\rm LL}$, the coefficients $\\\\xi^{\\\\rm LL}_p(\\\\mathbf x)$, the \
coordinates $x^p_{\\\\rm LL}$ of $\\\\mathbb R^{1,7}_{\\\\rm LL}$ and \
$\\\\mathbb R^{1,3}_{\\\\rm LL}$ and the Dirac matrices $\\\\gamma^p_{\\\\rm \
LL}$ ($p=0,1,2,3$); $p'$ is a second index of the same kind (plain text `p1`, \
`p2`, `p3`: three such indices)\>\""}], ",", " ", 
         RowBox[{"\"\<meaningEdited\>\"", " ", "->", " ", "False"}], ",", " ", 
         RowBox[{"\"\<origin\>\"", " ", "->", 
          " ", "\"\<new (Revision_SuperLoop)\>\""}]}], "|>"}], ",", "\n", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<entry\>\"", " ", "->", " ", "6"}], ",", " ", 
         RowBox[{"\"\<group\>\"", " ", "->", 
          " ", "\"\<1 Indices, conventions and number sets\>\""}], ",", " ", 
         RowBox[{"\"\<symbol\>\"", " ", "->", 
          " ", "\"\<$\\\\iota$, $\\\\iota'$, $\\\\iota''$\>\""}], ",", " ", 
         RowBox[{"\"\<names\>\"", " ", "->", " ", 
          RowBox[{"{", "\"\<iota\>\"", "}"}]}], ",", " ", 
         RowBox[{"\"\<meaning\>\"", " ", "->", 
          " ", "\"\<the isospin index, values 1, 2, 3: it labels the isospin \
generators $T^\\\\iota_{\\\\rm LL}$, the Pauli matrices $\\\\tau^{\\\\rm LL}_\
\\\\iota$ on the isospin index of a field, the pair channels $\\\\mathsf K^\\\
\\iota_{\\\\rm LL}$, $\\\\mathsf K'^\\\\iota_{\\\\rm LL}$, the pair operators \
$\\\\Pi^\\\\iota_{\\\\rm LL}$ and the components $d^\\\\iota_{\\\\rm LL}$ of \
the order parameter; it is an internal direction, not a direction in space \
(that is $j$)\>\""}], ",", " ", 
         RowBox[{"\"\<meaningEdited\>\"", " ", "->", " ", "False"}], ",", " ", 
         RowBox[{"\"\<origin\>\"", " ", "->", 
          " ", "\"\<new (Revision_SuperLoop)\>\""}]}], "|>"}], ",", "\n", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<entry\>\"", " ", "->", " ", "7"}], ",", " ", 
         RowBox[{"\"\<group\>\"", " ", "->", 
          " ", "\"\<1 Indices, conventions and number sets\>\""}], ",", " ", 
         RowBox[{"\"\<symbol\>\"", " ", "->", 
          " ", "\"\<$\\\\epsilon^{\\\\rm LL}_{jj'j''}$\>\""}], ",", " ", 
         RowBox[{"\"\<names\>\"", " ", "->", " ", 
          RowBox[{"{", "\"\<eps3\>\"", "}"}]}], ",", " ", 
         RowBox[{"\"\<meaning\>\"", " ", "->", 
          " ", "\"\<the Levi-Civita symbol: $+1$ if $(j,j',j'')$ is an even \
permutation of $(1,2,3)$, $-1$ if it is an odd one, $0$ otherwise; also with \
the isospin indices, $\\\\epsilon^{\\\\rm \
LL}_{\\\\iota\\\\iota'\\\\iota''}$\>\""}], ",", " ", 
         RowBox[{"\"\<meaningEdited\>\"", " ", "->", " ", "False"}], ",", " ", 
         RowBox[{"\"\<origin\>\"", " ", "->", 
          " ", "\"\<new (Revision_SuperLoop)\>\""}]}], "|>"}], ",", "\n", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<entry\>\"", " ", "->", " ", "8"}], ",", " ", 
         RowBox[{"\"\<group\>\"", " ", "->", 
          " ", "\"\<1 Indices, conventions and number sets\>\""}], ",", " ", 
         RowBox[{"\"\<symbol\>\"", " ", "->", 
          " ", "\"\<$\\\\sigma^{\\\\rm LL}_0$, $\\\\sigma^{\\\\rm \
LL}_j$\>\""}], ",", " ", 
         RowBox[{"\"\<names\>\"", " ", "->", " ", 
          RowBox[{"{", 
           
           RowBox[{"\"\<sigma_0\>\"", ",", " ", "\"\<sigma_j\>\"", ",", 
            " ", "\"\<sigma_1\>\"", ",", " ", "\"\<sigma_2\>\"", ",", 
            " ", "\"\<sigma_3\>\""}], "}"}]}], ",", " ", 
         RowBox[{"\"\<meaning\>\"", " ", "->", 
          " ", "\"\<the $2\\\\times2$ unit matrix $\\\\sigma^{\\\\rm LL}_0$ \
and the Pauli matrices $\\\\sigma^{\\\\rm \
LL}_1=\\\\begin{pmatrix}0&1\\\\\\\\1&0\\\\end{pmatrix}$, $\\\\sigma^{\\\\rm \
LL}_2=\\\\begin{pmatrix}0&-i\\\\\\\\i&0\\\\end{pmatrix}$, $\\\\sigma^{\\\\rm \
LL}_3=\\\\begin{pmatrix}1&0\\\\\\\\0&-1\\\\end{pmatrix}$, acting on the two \
components of a Weyl spinor or on the species index\>\""}], ",", " ", 
         RowBox[{"\"\<meaningEdited\>\"", " ", "->", " ", "False"}], ",", " ", 
         RowBox[{"\"\<origin\>\"", " ", "->", 
          " ", "\"\<new (Revision_SuperLoop)\>\""}]}], "|>"}], ",", "\n", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<entry\>\"", " ", "->", " ", "9"}], ",", " ", 
         RowBox[{"\"\<group\>\"", " ", "->", 
          " ", "\"\<1 Indices, conventions and number sets\>\""}], ",", " ", 
         RowBox[{"\"\<symbol\>\"", " ", "->", 
          " ", "\"\<$\\\\tau^{\\\\rm LL}_\\\\iota$\>\""}], ",", " ", 
         RowBox[{"\"\<names\>\"", " ", "->", " ", 
          RowBox[{"{", 
           
           RowBox[{"\"\<tau_iota\>\"", ",", " ", "\"\<tau_1\>\"", ",", 
            " ", "\"\<tau_2\>\"", ",", " ", "\"\<tau_3\>\""}], "}"}]}], ",", 
         " ", 
         RowBox[{"\"\<meaning\>\"", " ", "->", 
          " ", "\"\<the same three Pauli matrices acting on the isospin index \
of a field (the index of the two components up and down of an \
isodoublet)\>\""}], ",", " ", 
         RowBox[{"\"\<meaningEdited\>\"", " ", "->", " ", "False"}], ",", " ", 
         RowBox[{"\"\<origin\>\"", " ", "->", 
          " ", "\"\<new (Revision_SuperLoop)\>\""}]}], "|>"}], ",", "\n", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<entry\>\"", " ", "->", " ", "10"}], ",", " ", 
         RowBox[{"\"\<group\>\"", " ", "->", 
          " ", "\"\<1 Indices, conventions and number sets\>\""}], ",", " ", 
         RowBox[{"\"\<symbol\>\"", " ", "->", 
          " ", "\"\<$\\\\mathsf E_{\\\\rm LL}$\>\""}], ",", " ", 
         RowBox[{"\"\<names\>\"", " ", "->", " ", 
          RowBox[{"{", "\"\<eps2\>\"", "}"}]}], ",", " ", 
         RowBox[{"\"\<meaning\>\"", " ", "->", 
          " ", "\"\<the real antisymmetric $2\\\\times2$ matrix $i\\\\sigma^{\
\\\\rm LL}_2=\\\\begin{pmatrix}0&1\\\\\\\\-1&0\\\\end{pmatrix}$, with \
$\\\\mathsf E_{\\\\rm LL}^{-1}=\\\\mathsf E_{\\\\rm LL}^T=-\\\\mathsf \
E_{\\\\rm LL}$; it acts on a Weyl, isospin or species index, as stated at \
each place\>\""}], ",", " ", 
         RowBox[{"\"\<meaningEdited\>\"", " ", "->", " ", "False"}], ",", " ", 
         RowBox[{"\"\<origin\>\"", " ", "->", 
          " ", "\"\<new (Revision_SuperLoop)\>\""}]}], "|>"}], ",", "\n", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<entry\>\"", " ", "->", " ", "11"}], ",", " ", 
         RowBox[{"\"\<group\>\"", " ", "->", 
          " ", "\"\<1 Indices, conventions and number sets\>\""}], ",", " ", 
         RowBox[{"\"\<symbol\>\"", " ", "->", 
          " ", "\"\<$\\\\mathsf 1_2$, $\\\\mathsf 1_4$, $\\\\mathsf 1_8$, $\\\
\\mathsf 1_{16}$\>\""}], ",", " ", 
         RowBox[{"\"\<names\>\"", " ", "->", " ", 
          RowBox[{"{", "}"}]}], ",", " ", 
         RowBox[{"\"\<meaning\>\"", " ", "->", 
          " ", "\"\<the $2\\\\times2$, the $4\\\\times4$, the $8\\\\times8$ \
and the $16\\\\times16$ unit matrices\>\""}], ",", " ", 
         RowBox[{"\"\<meaningEdited\>\"", " ", "->", " ", "False"}], ",", " ", 
         RowBox[{"\"\<origin\>\"", " ", "->", 
          " ", "\"\<new (Revision_SuperLoop)\>\""}]}], "|>"}], ",", "\n", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<entry\>\"", " ", "->", " ", "12"}], ",", " ", 
         RowBox[{"\"\<group\>\"", " ", "->", 
          " ", "\"\<2 The bi-octonions and the super-loop\>\""}], ",", " ", 
         RowBox[{"\"\<symbol\>\"", " ", "->", 
          " ", "\"\<$\\\\mathbb H$, $\\\\mathbb O$\>\""}], ",", " ", 
         RowBox[{"\"\<names\>\"", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<H\>\"", ",", " ", "\"\<O\>\""}], "}"}]}], ",", " ", 
         RowBox[{"\"\<meaning\>\"", " ", "->", 
          " ", "\"\<the quaternions and the octonions: the real combinations \
of $\\\\mathbf e_0,\\\\dots,\\\\mathbf e_3$ and of $\\\\mathbf \
e_0,\\\\dots,\\\\mathbf e_7$; ${\\\\rm Im}\\\\,\\\\mathbb H$ and ${\\\\rm Im}\
\\\\,\\\\mathbb O$ are their imaginary parts, the real combinations of \
$\\\\mathbf e_1,\\\\mathbf e_2,\\\\mathbf e_3$ and of $\\\\mathbf \
e_1,\\\\dots,\\\\mathbf e_7$ (plain text `Im H`, `Im O`; `C (x) H` is \
$\\\\mathbb C\\\\otimes\\\\mathbb H$, the bi-quaternions)\>\""}], ",", " ", 
         RowBox[{"\"\<meaningEdited\>\"", " ", "->", " ", "False"}], ",", " ", 
         RowBox[{"\"\<origin\>\"", " ", "->", 
          " ", "\"\<new (Revision_SuperLoop)\>\""}]}], "|>"}], ",", "\n", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<entry\>\"", " ", "->", " ", "13"}], ",", " ", 
         RowBox[{"\"\<group\>\"", " ", "->", 
          " ", "\"\<2 The bi-octonions and the super-loop\>\""}], ",", " ", 
         RowBox[{"\"\<symbol\>\"", " ", "->", 
          " ", "\"\<$\\\\mathbb B_{\\\\rm LL}$\>\""}], ",", " ", 
         RowBox[{"\"\<names\>\"", " ", "->", " ", 
          RowBox[{"{", "\"\<B_LL\>\"", "}"}]}], ",", " ", 
         RowBox[{"\"\<meaning\>\"", " ", "->", 
          " ", "\"\<the bi-octonions $\\\\mathbb C\\\\otimes\\\\mathbb O$: \
the complex combinations $\\\\mathbf x=\\\\sum_{p=0}^7\\\\xi^{\\\\rm LL}_p(\\\
\\mathbf x)\\\\,\\\\mathbf e_p$ of the eight units, with the product of the \
units extended bilinearly; real dimension 16\>\""}], ",", " ", 
         RowBox[{"\"\<meaningEdited\>\"", " ", "->", " ", "False"}], ",", " ", 
         RowBox[{"\"\<origin\>\"", " ", "->", 
          " ", "\"\<new (Revision_SuperLoop)\>\""}]}], "|>"}], ",", "\n", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<entry\>\"", " ", "->", " ", "14"}], ",", " ", 
         RowBox[{"\"\<group\>\"", " ", "->", 
          " ", "\"\<2 The bi-octonions and the super-loop\>\""}], ",", " ", 
         RowBox[{"\"\<symbol\>\"", " ", "->", 
          " ", "\"\<$\\\\mathbf e_0,\\\\dots,\\\\mathbf e_7$; $\\\\mathbf \
e_p$, $\\\\mathbf e_j$, $\\\\mathbf e_\\\\iota$\>\""}], ",", " ", 
         RowBox[{"\"\<names\>\"", " ", "->", " ", 
          RowBox[{"{", 
           
           RowBox[{"\"\<e0\>\"", ",", " ", "\"\<e1\>\"", ",", 
