     RowBox[{"x", " ", "-", " ", "y"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"devA", " ", "=", " ", "0."}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"x", " ", "=", " ", 
         RowBox[{"rbq", "[", "]"}]}], ",", " ", "y", ",", " ", "lhs", ",", 
        " ", "ycx", ",", " ", "prod"}], "}"}], ",", "\n", "   ", 
      RowBox[{
       RowBox[{"y", " ", "=", " ", 
        RowBox[{"rbq", "[", "]"}]}], ";", "\n", "   ", 
       RowBox[{"lhs", " ", "=", " ", 
        RowBox[{
         RowBox[{"t2mq", "[", "x", "]"}], " ", ".", " ", 
         RowBox[{"t2psiPrime", "[", "y", "]"}]}]}], ";", "\n", "   ", 
       RowBox[{"ycx", " ", "=", " ", 
        RowBox[{"t2bqMul", "[", 
         RowBox[{"y", ",", " ", 
          RowBox[{"t2bqConj", "[", "x", "]"}]}], "]"}]}], ";", "\n", "   ", 
       RowBox[{"devA", " ", "=", " ", 
        RowBox[{"Max", "[", 
         RowBox[{"devA", ",", " ", 
          RowBox[{"fro", "[", 
           RowBox[{"lhs", " ", "-", " ", 
            RowBox[{"t2psiPrime", "[", "ycx", "]"}]}], "]"}]}], "]"}]}], ";", 
       "\n", "   ", 
       RowBox[{"prod", " ", "=", " ", 
        RowBox[{"t2bioctMul", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"zero4", ",", " ", "y"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "zero4"}], "}"}]}], "]"}]}], ";", "\n", 
       "   ", 
       RowBox[{"devA", " ", "=", " ", 
        RowBox[{"Max", "[", 
         RowBox[{"devA", ",", " ", 
          RowBox[{"bqDev", "[", 
           RowBox[{
            RowBox[{"prod", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", " ", "zero4"}], "]"}], ",", 
          " ", 
          RowBox[{"bqDev", "[", 
           RowBox[{
            RowBox[{"prod", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", " ", "ycx"}], "]"}]}], 
         "]"}]}]}]}], "]"}], ",", " ", 
    RowBox[{"{", "50", "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"devB", " ", "=", " ", "0."}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"Module", "[", 
