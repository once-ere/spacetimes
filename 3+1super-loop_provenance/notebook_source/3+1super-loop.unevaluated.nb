     RowBox[{
     "the", " ", "boxes", " ", "of", " ", "x5", " ", "and", " ", "of", " ", 
      "5", "x"}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"names15", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"SL31TeXFormula", "[", "\"\<x5\>\"", "]"}], " ", "===", " ", 
     RowBox[{"RowBox", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"StyleBox", "[", 
