Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Alpha]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "efcc74e4-5d26-4853-ac63-3c6ab69b5ad7"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Beta]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0469fee9-dadb-452a-91b9-bb9c617e5d27"],
 " act on the Dirac index and the link matrices on the isospin index (code: \
",
 StyleBox["t2hMinusV",
  FontFamily->"Source Code Pro"],
 " without the pair term, and ",
 StyleBox["t2apply",
  FontFamily->"Source Code Pro"],
 "). The hole row is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["P",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubscriptBox[
       OverscriptBox[
        StyleBox["s", "TI"], "\[RightVector]"], 
       StyleBox["LL",
        FontSlant->"Plain"]], ")"}], "\[Dagger]"], 
    SubsuperscriptBox["\[Psi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["s", "TI"], "\[RightVector]"], 
      StyleBox["LL",
       FontSlant->"Plain"]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "1fdead6e-7f9b-4a31-a861-ca40be64e8a7"],
 " minus the complex conjugate of the same expression without the pair term, \
applied to the complex conjugate of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Psi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["h",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5afd1d65-2b60-42bd-a101-410234113778"],
 ". Here ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["W",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "34857227-eea0-4470-9012-ac558b4a40d0"],
 " is the Wilson coefficient (the term in ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["W",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e535105e-6c1e-4573-b41d-0b4eda5a1624"],
 " removes the doubled fermions of the lattice), ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["A",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
