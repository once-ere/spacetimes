           "a", " ", "comma"}]}], ")"}]}]}]}], ",", " ", 
     RowBox[{
      RowBox[{"the", " ", "plain"}], "-", 
      RowBox[{"text", " ", "names"}]}], ",", " ", 
     RowBox[{
      RowBox[{
      "and", " ", "the", " ", "meaning", " ", "in", " ", "the", " ", "text", " ",
        "font"}], ";", " ", 
      RowBox[{"the", " ", "three", "\n", "   ", "widths", " ", 
       RowBox[{"(", 
        RowBox[{"125", " ", "+", " ", "95", " ", "+", " ", 
         RowBox[{"290", " ", 
          RowBox[{"printer", "'"}], "s", " ", "points"}]}], ")"}], " ", "let",
        " ", "the", " ", "table", " ", "fit", " ", "the", " ", "width", " ", 
       "of", " ", "a", " ", "printed", " ", "page"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"symbolRow", "[", "e_", "]"}], " ", ":=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Pane", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"StringContainsQ", "[", 
            RowBox[{
             RowBox[{"e", "[", "\"\<symbol\>\"", "]"}], ",", 
             " ", "\"\<$\>\""}], "]"}], ",", "\n", "      ", 
           RowBox[{"Row", "[", 
            RowBox[{"Riffle", "[", 
             RowBox[{
              RowBox[{"Map", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"RawBoxes", "[", 
                  RowBox[{"SL31TeXToBoxes", "[", "#", "]"}], "]"}], " ", 
                 "&"}], ",", "\n", "        ", 
                RowBox[{"Flatten", "[", 
                 RowBox[{"Map", "[", 
                  RowBox[{"SL31SplitTeX", ",", " ", 
                   RowBox[{"StringCases", "[", 
                    RowBox[{
                    RowBox[{"e", "[", "\"\<symbol\>\"", "]"}], ",", " ", 
                    RowBox[{
                    RowBox[{"\"\<$\>\"", " ", "~~", " ", 
