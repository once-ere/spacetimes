               "g"}], " ", "&"}]}], "]"}]}], "]"}], ",", "\n", "    ", 
         RowBox[{
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{"#", ",", " ", "Bold", ",", " ", 
             RowBox[{
             "FontFamily", " ", "->", " ", "\"\<Source Sans Pro\>\""}]}], 
            "]"}], " ", "&"}], " ", "/@", " ", 
          RowBox[{"{", 
           
           RowBox[{"\"\<symbol\>\"", ",", " ", "\"\<plain-text names\>\"", ",",
             " ", "\"\<meaning\>\""}], "}"}]}]}], "]"}], ",", "\n", "   ", 
