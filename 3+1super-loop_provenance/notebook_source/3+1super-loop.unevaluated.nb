Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Alpha]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "705531d9-5c74-4aa5-bd83-75456855597d"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Beta]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "203ae045-365e-4918-a172-7963ec9785c6"],
 " act on the Dirac index and the link matrices on the isospin index (code: \
",
 StyleBox["t2hMinusV",
  FontFamily->"Source Code Pro"],
 " without the pair term, and ",
 StyleBox["t2apply",
  FontFamily->"Source Code Pro"],
 "). The hole row is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["P",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubscriptBox[
       OverscriptBox[
        StyleBox["s", "TI"], "\[RightVector]"], 
       StyleBox["LL",
        FontSlant->"Plain"]], ")"}], "\[Dagger]"], 
    SubsuperscriptBox["\[Psi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["s", "TI"], "\[RightVector]"], 
      StyleBox["LL",
       FontSlant->"Plain"]], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3f95da28-2f4c-4c1f-acb9-4ad67d4f06ea"],
 " minus the complex conjugate of the same expression without the pair term, \
applied to the complex conjugate of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Psi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["h",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "38b3c4ea-79e7-43f8-b753-cb1908c96c7d"],
 ". Here ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["W",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0dc69fa9-da01-45a6-9034-6588fe4475fa"],
 " is the Wilson coefficient (the term in ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["W",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5643c6b6-16e7-44db-9cef-d5a2acae0e40"],
 " removes the doubled fermions of the lattice), ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["A",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", "0"}]], 
    RowBox[{"(", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["s", "TI"], "\[RightVector]"], 
      StyleBox["LL",
       FontSlant->"Plain"]], ")"}], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", "\[Iota]",
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", "0"}], "\[Iota]"], 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Iota]"], "+", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", "0"}], 
     StyleBox["F",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "8"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4c9833c3-93b9-40ca-9699-2e540907a129"],
 " is the potential of the time direction at the site and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["P",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["s", "TI"], "\[RightVector]"], 
      StyleBox["LL",
       FontSlant->"Plain"]], ")"}], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", "\[Iota]",
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Iota]"], 
    RowBox[{"(", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["s", "TI"], "\[RightVector]"], 
      StyleBox["LL",
       FontSlant->"Plain"]], ")"}], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "\[Iota]"], ")"}], "\[Dagger]"]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3ef06a4e-3e18-4742-9ec5-a130fa1ef790"],
 " the pairing block; a direction without a neighbour (a Dirichlet boundary) \
contributes zero. The function ",
 StyleBox["t2apply",
  FontFamily->"Source Code Pro"],
 " applies the operator to a vector, or, column by column, to a matrix whose \
columns are vectors; ",
 StyleBox["t2dense",
  FontFamily->"Source Code Pro"],
 " applies it to the unit matrix and so returns the whole matrix."
}], "Text",ExpressionUUID->"5d168634-3127-4cbf-8c28-aa2027b30602"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "the", " ", "closed", " ", "form", " ", "of", " ", "the", " ", "link", " ",
     "matrix", " ", "exp", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "i"}], " ", "ell", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"gv", " ", 
         RowBox[{
          RowBox[{"a", ".", "tau"}], "/", "2"}]}], " ", "+", " ", 
        RowBox[{"gf", " ", "b"}]}], ")"}]}], ")"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"t2link", "[", 
      RowBox[{
      "gv_", ",", " ", "gf_", ",", " ", "a_List", ",", " ", "b_", ",", " ", 
       "ell_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"na", " ", "=", " ", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"a", " ", ".", " ", "a"}], "]"}]}], ",", " ", "x", ",", 
         " ", "ph", ",", " ", "cx", ",", " ", "sx", ",", " ", "n1", ",", " ", 
         "n2", ",", " ", "n3"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"x", " ", "=", " ", 
         RowBox[{"0.5", " ", "ell", " ", "gv", " ", "na"}]}], ";", "\n", 
        "   ", 
        RowBox[{"ph", " ", "=", " ", 
         RowBox[{
          RowBox[{"Cos", "[", 
           RowBox[{
            RowBox[{"-", "ell"}], " ", "gf", " ", "b"}], "]"}], " ", "+", " ", 
          RowBox[{"I", " ", 
           RowBox[{"Sin", "[", 
            RowBox[{
             RowBox[{"-", "ell"}], " ", "gf", " ", "b"}], "]"}]}]}]}], ";", 
        "\n", "   ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"cx", ",", " ", "sx"}], "}"}], " ", "=", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Cos", "[", "x", "]"}], ",", " ", 
           RowBox[{"Sin", "[", "x", "]"}]}], "}"}]}], ";", "\n", "   ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"n1", ",", " ", "n2", ",", " ", "n3"}], "}"}], " ", "=", 
         " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"na", " ", ">", " ", "0"}], ",", " ", 
           RowBox[{"a", "/", "na"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"0.", ",", " ", "0.", ",", " ", "0."}], "}"}]}], "]"}]}], 
        ";", "\n", "   ", 
        RowBox[{"ph", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"cx", " ", "-", " ", 
              RowBox[{"I", " ", "sx", " ", "n3"}]}], ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "sx"}], " ", "n2"}], " ", "-", " ", 
              RowBox[{"I", " ", "sx", " ", "n1"}]}]}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"sx", " ", "n2"}], " ", "-", " ", 
              RowBox[{"I", " ", "sx", " ", "n1"}]}], ",", " ", 
             RowBox[{"cx", " ", "+", " ", 
              RowBox[{"I", " ", "sx", " ", "n3"}]}]}], "}"}]}], "}"}]}]}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "2", " ", "x", " ", "2", " ", "potential", " ", "matrix", " ",
       "gv", " ", 
      RowBox[{
       RowBox[{"A0", ".", "tau"}], "/", "2"}]}], " ", "+", " ", 
     RowBox[{"gf", " ", "A0F"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2potential", "[", 
      RowBox[{"gv_", ",", " ", "gf_", ",", " ", "a0_List", ",", " ", "a0f_"}],
       "]"}], " ", ":=", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"h", " ", "=", " ", 
         RowBox[{"0.5", " ", "gv"}]}], "}"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"gf", " ", "a0f"}], " ", "+", " ", 
            RowBox[{"h", " ", 
             RowBox[{"a0", "[", 
              RowBox[{"[", "3", "]"}], "]"}]}]}], ",", " ", 
           RowBox[{
            RowBox[{"h", " ", 
             RowBox[{"a0", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], " ", "-", " ", 
            RowBox[{"I", " ", "h", " ", 
             RowBox[{"a0", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}]}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"h", " ", 
             RowBox[{"a0", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], " ", "+", " ", 
            RowBox[{"I", " ", "h", " ", 
             RowBox[{"a0", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}]}], ",", " ", 
           RowBox[{
            RowBox[{"gf", " ", "a0f"}], " ", "-", " ", 
            RowBox[{"h", " ", 
             RowBox[{"a0", "[", 
              RowBox[{"[", "3", "]"}], "]"}]}]}]}], "}"}]}], "}"}]}], "]"}]}],
     ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"a", " ", 
      RowBox[{"lattice", ":", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<n\>\"", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"n1", ",", " ", "n2", ",", " ", "n3"}], "}"}]}], ",", " ", 
         
         RowBox[{"\"\<ell\>\"", " ", "->", " ", "spacing"}], ",", " ", 
         RowBox[{"\"\<periodic\>\"", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"True", "|", "False"}], ",", " ", ".."}], "}"}]}], ",", 
         " ", 
         RowBox[{"\"\<wilson\>\"", " ", "->", " ", "r_W"}], ",", "\n", "   ", 
         
         RowBox[{"\"\<mass\>\"", " ", "->", " ", "m"}], ",", " ", 
         RowBox[{"\"\<mu\>\"", " ", "->", " ", "mu"}]}], "|>"}]}]}], ";", " ", 
     RowBox[{"sites", " ", "are", " ", "numbered", " ", "from", " ", "0"}]}], 
    " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2nsites", "[", "lat_", "]"}], " ", ":=", " ", 
     RowBox[{"Times", " ", "@@", " ", 
      RowBox[{"lat", "[", "\"\<n\>\"", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2dim", "[", "lat_", "]"}], " ", ":=", " ", 
     RowBox[{"16", " ", 
      RowBox[{"t2nsites", "[", "lat", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2siteOf", "[", 
      RowBox[{"lat_", ",", " ", 
       RowBox[{"{", 
        RowBox[{"ix_", ",", " ", "iy_", ",", " ", "iz_"}], "}"}]}], "]"}], 
     " ", ":=", " ", 
     RowBox[{"ix", " ", "+", " ", 
      RowBox[{
