         RowBox[{"(", "3", ")"}]}]], ",", " ", 
       SubsuperscriptBox["\[CapitalOmega]", "LL", 
        RowBox[{"s", 
         RowBox[{"(", "4", ")"}]}]], ",", " ", 
       SubsuperscriptBox["\[CapitalOmega]", "LL", "min"], ",", " ", 
       SubsuperscriptBox["\[CapitalXi]", "LL", 
        RowBox[{"(", "4", ")"}]], ",", " ", 
       SubsuperscriptBox["y", "LL", "+"], ",", " ", 
       SubsuperscriptBox["y", "LL", "-"], ",", "\n", "  ", 
       SubsuperscriptBox[
        OverscriptBox["d", "\[RightVector]"], "LL", "nf"], ",", " ", 
       SubsuperscriptBox["t", "LL", "fl"], ",", " ", 
       SubsuperscriptBox["\[Kappa]", "LL", "st"], ",", " ", 
       SubsuperscriptBox["\[ScriptCapitalV]", "LL", "vac"], ",", " ", 
