       SubsuperscriptBox["\[CurlyTheta]", "LL", "G"], ",", " ", 
       SubsuperscriptBox["\[CurlyPhi]", "LL", "G"], ",", " ", 
       SubsuperscriptBox[
        TagBox[
         StyleBox["U",
          FontFamily->"Helvetica",
          FontSlant->"Plain"],
         "SL31SansSerif"], "LL", "G"], ",", " ", 
       SubsuperscriptBox["h", "LL", "a"], ",", " ", 
       SubsuperscriptBox["c", 
        RowBox[{"LL", ",", "1"}], "n"], ",", "\n", "  ", 
       SubsuperscriptBox["c", 
        RowBox[{"LL", ",", "2"}], "n"], ",", " ", 
       SubsuperscriptBox["\[CurlyRho]", "LL", "n"], ",", " ", 
       SubsuperscriptBox["\[CapitalOmega]", "LL", "H"], ",", " ", 
       SubsuperscriptBox["\[Lambda]", "LL", "H"], ",", " ", 
       SubsuperscriptBox["\[ScriptCapitalL]", "LL", "kin"], ",", " ", 
       SubsuperscriptBox[
        TagBox[
         StyleBox["N",
          FontFamily->"Helvetica",
          FontSlant->"Plain"],
         "SL31SansSerif"], "LL", "g"], ",", "\n", "  ", 
       SubsuperscriptBox[
        TagBox[
         StyleBox["N",
          FontFamily->"Helvetica",
          FontSlant->"Plain"],
         "SL31SansSerif"], "LL", "v"], ",", " ", 
       SubsuperscriptBox[
        OverscriptBox["w", "\[RightVector]"], "LL", "n"], ",", " ", 
       SubsuperscriptBox["E", "LL", "c"], ",", " ", 
       SubsuperscriptBox[
        OverscriptBox["a", "\[RightVector]"], "LL", "F"], ",", " ", 
       SubsuperscriptBox[
        OverscriptBox["u", "\[RightVector]"], "LL", "f"], ",", " ", 
       SubsuperscriptBox[
        OverscriptBox["u", "\[RightVector]"], "LL", 
        RowBox[{"f", "\[Prime]"}]], ",", "\n", "  ", 
       SubsuperscriptBox["\[Delta]", "LL", "f"], ",", " ", 
       SubsuperscriptBox[
        TagBox[
         StyleBox["H",
          FontFamily->"Helvetica",
          FontSlant->"Plain"],
         "SL31SansSerif"], "LL", "f"], ",", " ", 
       SubsuperscriptBox[
        TagBox[
         StyleBox["H",
          FontFamily->"Helvetica",
          FontSlant->"Plain"],
         "SL31SansSerif"], "LL", 
        RowBox[{"f", "\[Prime]"}]], ",", " ", 
       SubsuperscriptBox["\[Chi]", "LL", "f"], ",", " ", 
       SubsuperscriptBox["\[CapitalGamma]", "LL", "f"], ",", " ", 
       SubsuperscriptBox["\[CapitalGamma]", "LL", "G"], ",", "\n", "  ", 
       SubsuperscriptBox["\[CapitalGamma]", "LL", "m"], ",", " ", 
       SubscriptBox["\[CapitalUpsilon]", "LL"], ",", " ", 
       SubsuperscriptBox["\[CapitalUpsilon]", "LL", 
        RowBox[{"(", "1", ")"}]], ",", " ", 
       SubsuperscriptBox["c", "LL", "w"], ",", " ", 
       SubsuperscriptBox[
        OverscriptBox["d", "\[RightVector]"], "LL", "u"], ",", " ", 
       SubsuperscriptBox["V", 
        RowBox[{"LL", ",", "p"}], "F"], ",", "\n", "  ", 
       SubsuperscriptBox["V", 
        RowBox[{"LL", ",", "p"}], "\[Iota]"], ",", " ", 
       SubsuperscriptBox["W", 
        RowBox[{"LL", ",", "p"}], "\[PlusMinus]"], ",", " ", 
       SubsuperscriptBox[
        TagBox[
         StyleBox["M",
          FontFamily->"Helvetica",
          FontSlant->"Plain"],
         "SL31SansSerif"], "LL", "t"], ",", " ", 
       SubsuperscriptBox[
        TagBox[
         StyleBox["M",
          FontFamily->"Helvetica",
          FontSlant->"Plain"],
         "SL31SansSerif"], "LL", "s"], ",", " ", 
       SubsuperscriptBox["M", "LL", "W"], ",", " ", 
       SubsuperscriptBox["M", "LL", "F"], ",", "\n", "  ", 
       SubsuperscriptBox["\[Theta]", "LL", "mix"], ",", " ", 
       SubsuperscriptBox["\[ScriptCapitalL]", "LL", 
        RowBox[{"(", "2", ")"}]], ",", " ", 
       SubsuperscriptBox["w", "LL", "lat"], ",", " ", 
       SubsuperscriptBox["w", "LL", "cmp"], ",", " ", 
       SubsuperscriptBox["n", "LL", "cpx"], ",", " ", 
       SubsuperscriptBox["r", "LL", "tol"], ",", "\n", "  ", 
       SubsuperscriptBox["a", "LL", "tol"], ",", " ", 
       SubsuperscriptBox["h", "LL", "CV"], ",", " ", 
       SubsuperscriptBox["q", "LL", "CV"], ",", " ", 
       SubsuperscriptBox["h", "LL", "IDA"], ",", " ", 
       SubsuperscriptBox["N", "LL", "st"], ",", " ", 
       SubsuperscriptBox["N", "LL", "ev"], ",", "\n", "  ", 
       SubsuperscriptBox["B", "LL", "err"], ",", " ", 
       SubsuperscriptBox["\[Delta]", "LL", "rel"], ",", " ", 
       SubsuperscriptBox["w", "LL", "ex"], ",", " ", 
       SubsuperscriptBox["B", "LL", "loc"], ",", " ", 
       SubsuperscriptBox["\[Delta]", "LL", "loc"], ",", " ", 
       SubsuperscriptBox["E", "LL", "max"], ",", "\n", "  ", 
       SubsuperscriptBox["r", "LL", "der"], ",", " ", 
       SubsuperscriptBox["B", "LL", "out"]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"SL31Check", "[", 
     RowBox[{"\"\<S-14\>\"", ",", 
      " ", "\"\<every symbol typed in its printed form is read as one atomic \
symbol, the one created from its registry TeX\>\"", ",", "\n", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "typed", "]"}], " ", "==", " ", 
        RowBox[{"Length", "[", "symbolTable", "]"}]}], " ", "&&", " ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{"typed", ",", " ", "AtomQ"}], "]"}], " ", "&&", " ", 
       RowBox[{"typed", " ", "===", " ", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"ReleaseHold", "[", 
            RowBox[{"#", "[", "\"\<symbol\>\"", "]"}], "]"}], " ", "&"}], ",",
           " ", "symbolTable"}], "]"}]}]}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Length", "[", "typed", "]"}], ",", " ", 
        RowBox[{"Count", "[", 
         RowBox[{"typed", ",", " ", 
          RowBox[{"_", "?", "AtomQ"}]}], "]"}], ",", " ", 
        RowBox[{"Length", "[", "symbolTable", "]"}]}], "}"}]}], "]"}], 
    ";"}]}]}]], "Input",ExpressionUUID->"f1a10f84-e0ff-4dc3-a540-\
88aa76232bee"],

Cell["\<\
S-3, uniqueness: different printed forms give different symbols. If two \
different boxes had received the same name, two printed symbols would have \
become one Wolfram symbol. The test compares the number of different boxes \
with the number of different symbols, and also checks the comparison that the \
Notation package itself makes: it removes style boxes (StyleBox, \
AdjustmentBox, FrameBox) before it compares input with a symbolized box, so \
the boxes must still be different after this removal. (TeX items with the \
same boxes, listed in section I.6, are one symbol by construction.)\
\>", "Text",ExpressionUUID->"eafa5cda-8f5c-460a-ae7c-b86e19a034e6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"strip", "[", "b_", "]"}], " ", ":=", " ", 
   RowBox[{"b", " ", "//.", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"StyleBox", "[", 
        RowBox[{"x_", ",", " ", "___"}], "]"}], " ", ":>", " ", "x"}], ",", 
      " ", 
      RowBox[{
       RowBox[{"AdjustmentBox", "[", 
        RowBox[{"x_", ",", " ", "___"}], "]"}], " ", ":>", " ", "x"}], ",", 
      " ", 
      RowBox[{
       RowBox[{"FrameBox", "[", 
        RowBox[{"x_", ",", " ", "___"}], "]"}], " ", ":>", " ", "x"}]}], 
     "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"syms", " ", "=", " ", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"#", "[", "\"\<symbol\>\"", "]"}], " ", "&"}], ",", " ", 
     "symbolTable"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-3\>\"", ",", 
    " ", "\"\<different boxes give different symbols, and the boxes stay \
different after the removal of style boxes\>\"", ",", "\n", "  ", 
    RowBox[{
     RowBox[{"Length", "[", 
      RowBox[{"DeleteDuplicates", "[", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", "\"\<boxes\>\"", "]"}], " ", "&"}], ",", " ", 
         "symbolTable"}], "]"}], "]"}], "]"}], " ", "==", " ", 
     RowBox[{"Length", "[", 
      RowBox[{"DeleteDuplicates", "[", "syms", "]"}], "]"}], " ", "==", "\n", 
     "   ", 
     RowBox[{"Length", "[", 
      RowBox[{"DeleteDuplicates", "[", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"strip", "[", 
           RowBox[{"#", "[", "\"\<boxes\>\"", "]"}], "]"}], " ", "&"}], ",", 
         " ", "symbolTable"}], "]"}], "]"}], "]"}], " ", "==", " ", 
     RowBox[{"Length", "[", "symbolTable", "]"}]}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Length", "[", "symbolTable", "]"}], ",", " ", 
      RowBox[{"Length", "[", 
       RowBox[{"DeleteDuplicates", "[", "syms", "]"}], "]"}], ",", " ", 
      RowBox[{"Length", "[", 
       RowBox[{"DeleteDuplicates", "[", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"strip", "[", 
            RowBox[{"#", "[", "\"\<boxes\>\"", "]"}], "]"}], " ", "&"}], ",", 
          " ", "symbolTable"}], "]"}], "]"}], "]"}]}], "}"}]}], "]"}], 
  ";"}]}], "Input",ExpressionUUID->"7a87be92-48c2-4de3-b77d-bf0af3538d48"],

Cell[TextData[{
 "S-4, the round trip: a symbol, printed again, gives exactly the box it was \
made from (",
 StyleBox["ToBoxes[symbol, StandardForm]",
  FontFamily->"Source Code Pro"],
 "). This is the other half of the symbolization: input box to symbol (S-2) \
and symbol to output box (S-4)."
}], "Text",ExpressionUUID->"b1d6b2a6-7331-49b5-901f-a86947b8527a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"roundTrip", " ", "=", " ", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{"r", ",", " ", 
       RowBox[{"Replace", "[", 
        RowBox[{
         RowBox[{"r", "[", "\"\<symbol\>\"", "]"}], ",", " ", 
         RowBox[{
          RowBox[{"HoldComplete", "[", "s_", "]"}], " ", ":>", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"ToBoxes", "[", 
             RowBox[{
              RowBox[{"Unevaluated", "[", "s", "]"}], ",", " ", 
              "StandardForm"}], "]"}], " ", "===", " ", 
            RowBox[{"r", "[", "\"\<boxes\>\"", "]"}]}], ")"}]}]}], "]"}]}], 
      "]"}], ",", " ", "symbolTable"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-4\>\"", ",", 
    " ", "\"\<every symbol prints as the box it was made from\>\"", ",", " ", 
    
    RowBox[{"And", " ", "@@", " ", "roundTrip"}], ",", " ", 
    RowBox[{"Count", "[", 
     RowBox[{"roundTrip", ",", " ", "True"}], "]"}]}], "]"}], ";"}]}], "Input",\
ExpressionUUID->"19adf295-3743-4d7f-900d-287a3875f87b"],

Cell[TextData[{
 "S-5, TeX: with its ",
 StyleBox["TraditionalForm",
  FontFamily->"Source Code Pro"],
 " rule, every symbol is written in TeX from its displayed boxes; the \
internal name, with its separator character, does not appear."
}], "Text",ExpressionUUID->"57b80e7b-a67b-4dc0-9a75-fe5d6211db29"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"texOut", " ", "=", " ", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{"r", ",", " ", 
       RowBox[{"Replace", "[", 
        RowBox[{
         RowBox[{"r", "[", "\"\<symbol\>\"", "]"}], ",", " ", 
         RowBox[{
          RowBox[{"HoldComplete", "[", "s_", "]"}], " ", ":>", " ", 
          RowBox[{"ToString", "[", 
           RowBox[{"TeXForm", "[", 
            RowBox[{"Unevaluated", "[", "s", "]"}], "]"}], "]"}]}]}], "]"}]}],
       "]"}], ",", " ", "symbolTable"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-5\>\"", ",", 
    " ", "\"\<the TeX of every symbol is written from its printed form, \
without the internal name\>\"", ",", "\n", "  ", 
    RowBox[{"AllTrue", "[", 
     RowBox[{"texOut", ",", " ", 
      RowBox[{
       RowBox[{"!", " ", 
        RowBox[{"StringContainsQ", "[", 
         RowBox[{"#", ",", " ", 
          
          RowBox[{"\"\<UnderBracket\>\"", " ", "|", 
           " ", "\"\<\[UnderBracket]\>\""}]}], "]"}]}], " ", "&"}]}], "]"}], ",",
     " ", 
    RowBox[{"Count", "[", 
     RowBox[{"texOut", ",", " ", 
      RowBox[{"x_", " ", "/;", " ", 
       RowBox[{"!", " ", 
        RowBox[{"StringContainsQ", "[", 
         RowBox[{"x", ",", " ", "\"\<UnderBracket\>\""}], "]"}]}]}]}], 
     "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{"TableForm", "[", 
  RowBox[{
   RowBox[{"Take", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", "\"\<tex\>\"", "]"}], " ", "&"}], ",", " ", 
          "symbolTable"}], "]"}], ",", " ", "texOut"}], "}"}], "]"}], ",", 
     " ", "8"}], "]"}], ",", " ", 
   RowBox[{"TableHeadings", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"None", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<registry TeX\>\"", ",", 
        " ", "\"\<TeXForm of the symbol\>\""}], "}"}]}], "}"}]}]}], 
  "]"}]}], "Input",ExpressionUUID->"0afc7e5e-3687-495a-ba2a-a9155e916f23"],

Cell[TextData[{
 "S-6, arithmetic with symbols and values: the coupling ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "aaa69207-141c-43a8-a8de-30a049db456c"],
 ", the mass ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dc9ddedf-b566-4087-b8de-26924831de53"],
 " and the cutoff ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalLambda]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "84005ae6-5d35-44ea-ac3a-0972a4172868"],
 " of the spinor charges receive the values used throughout Test 2 (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0.2"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f11ab852-c531-4fdf-b578-90042664a854"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2340fc86-b1bf-4971-9bad-ad283447cb8e"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "22.5"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "79838e99-eb08-4cc9-9cfc-4ef79a8f6f15"],
 ", units in which the cutoff is 1). The gap of the condensed vacuum at zero \
chemical potential solves the gap equation ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[CapitalLambda]", 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      SubscriptBox[
       StyleBox["E", "TI"], "\[CapitalLambda]"], "-", 
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox[
         StyleBox["M", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], 
         StyleBox["q",
          FontSlant->"Plain"]], ")"}], "2"], "\[ThinSpace]", 
      StyleBox["arsinh",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[CapitalLambda]", 
         StyleBox["LL",
          FontSlant->"Plain"]], "/", 
        SubsuperscriptBox[
         StyleBox["M", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], 
         StyleBox["q",
          FontSlant->"Plain"]]}], ")"}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"2", 
      SuperscriptBox["\[Pi]", "2"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3e85aba6-bf84-469a-9215-ae06a76fc1a6"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["q",
        FontSlant->"Plain"]], ")"}], "2"], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "2"], "+", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["vac",
        FontSlant->"Plain"]], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "67f7b156-67d3-42a2-9fae-98d75bfb4664"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["E", "TI"], "\[CapitalLambda]"], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox["\[CapitalLambda]", 
        StyleBox["LL",
         FontSlant->"Plain"], "2"], "+", 
       SuperscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox[
          StyleBox["M", "TI"], 
          StyleBox["LL",
           FontSlant->"Plain"], 
          StyleBox["q",
           FontSlant->"Plain"]], ")"}], "2"]}], ")"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4daa2fd6-3e19-4f37-83f2-001c83809dc3"],
 ". The cell writes this equation with the symbolized symbols, gives them \
values only inside ",
 StyleBox["Block",
  FontFamily->"Source Code Pro"],
 " (so that they stay free symbols outside), solves for the gap with ",
 StyleBox["FindRoot",
  FontFamily->"Source Code Pro"],
 ", and compares with the value 0.2094933033 found by the Rust program of \
Test 2. It also checks the derived masses ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    SubsuperscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["vac",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e18630bc-f0bf-43e8-85ad-645bc56ad098"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["q",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2b8d4891-f487-490f-bf38-d5a787940916"],
 "."
}], "Text",ExpressionUUID->"6cc79581-0d35-43da-9296-bd728d70303d"],

Cell[BoxData[
 RowBox[{"gapEquation", " ", "=", " ", 
  RowBox[{
   RowBox[{"1", "/", 
    SubscriptBox["G", "LL"]}], " ", "==", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[CapitalLambda]", "LL"], " ", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{
          SubscriptBox["\[CapitalLambda]", "LL"], "^", "2"}], " ", "+", " ", 
         RowBox[{
          SubscriptBox["m", "LL"], "^", "2"}], " ", "+", " ", 
         RowBox[{
          SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], "^", "2"}]}], 
        "]"}]}], " ", "-", "\n", "     ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SubscriptBox["m", "LL"], "^", "2"}], " ", "+", " ", 
         RowBox[{
          SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], "^", "2"}]}], 
        ")"}], " ", 
       RowBox[{"ArcSinh", "[", 
        RowBox[{
         SubscriptBox["\[CapitalLambda]", "LL"], "/", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{
            SubscriptBox["m", "LL"], "^", "2"}], " ", "+", " ", 
           RowBox[{
            SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], "^", "2"}]}], 
          "]"}]}], "]"}]}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"2", " ", 
      RowBox[{"Pi", "^", "2"}]}], ")"}]}]}]}]], "Input",ExpressionUUID->\
"f93429de-910d-452b-98df-4ad10ea4fb80"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"exact", " ", "values", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"45", "/", "2"}], ",", " ", 
       RowBox[{"1", "/", "5"}], ",", " ", "1"}], ")"}]}], ",", " ", 
    RowBox[{
    "so", " ", "that", " ", "FindRoot", " ", "can", " ", "work", " ", "with", 
     " ", "30", " ", "digits"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"gapValue", " ", "=", " ", 
     RowBox[{"Block", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          SubscriptBox["G", "LL"], " ", "=", " ", 
          RowBox[{"45", "/", "2"}]}], ",", " ", 
         RowBox[{
          SubscriptBox["m", "LL"], " ", "=", " ", 
          RowBox[{"1", "/", "5"}]}], ",", " ", 
         RowBox[{
          SubscriptBox["\[CapitalLambda]", "LL"], " ", "=", " ", "1"}]}], 
        "}"}], ",", "\n", "   ", 
       RowBox[{
        SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], " ", "/.", " ", 
        RowBox[{"FindRoot", "[", 
         RowBox[{"gapEquation", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], ",", " ", 
            "0.2"}], "}"}], ",", " ", 
          RowBox[{"WorkingPrecision", " ", "->", " ", "30"}], ",", " ", 
          RowBox[{"AccuracyGoal", " ", "->", " ", "20"}]}], "]"}]}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"SL31Check", "[", 
     RowBox[{"\"\<S-6\>\"", ",", 
      " ", "\"\<the gap equation written with the symbols gives the gap of \
the condensed vacuum 0.2094933033 at G = 22.5, m = 0.2, cutoff 1; 2 Delta_vac \
= 0.4189866 and 2 M_q = 0.5792666\>\"", ",", "\n", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"gapValue", " ", "-", " ", "0.2094933033"}], "]"}], " ", "<",
         " ", "1*^-10"}], " ", "&&", " ", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"2", " ", "gapValue"}], " ", "-", " ", "0.4189866"}], "]"}],
         " ", "<", " ", "1*^-7"}], " ", "&&", " ", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"2", " ", 
           RowBox[{"Sqrt", "[", 
            RowBox[{"0.04", " ", "+", " ", 
             RowBox[{"gapValue", "^", "2"}]}], "]"}]}], " ", "-", " ", 
          "0.5792666"}], "]"}], " ", "<", " ", "1*^-7"}]}], ",", "\n", "  ", 
      RowBox[{"N", "[", 
       RowBox[{"gapValue", ",", " ", "12"}], "]"}]}], "]"}], 
    ";"}]}]}]], "Input",ExpressionUUID->"b51b4fdd-080f-401a-ad6c-\
14ac6f336da9"],

Cell[TextData[{
 "S-7, sums over a family of symbols: the Pauli matrices. The registry symbol \
",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Sigma]", 
    StyleBox["j", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2d158782-a271-451a-90c8-bd4c156bd766"],
 " is a family with the running index ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["j", "TI"], "\[LongEqual]", "1", ",", "2", ",", "3"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e4ce22d6-1365-4c23-bf39-ddd74e5a9e2a"],
 ". A symbolized symbol is indivisible, so the index letter inside it cannot \
be replaced by a number in a sum. The components are therefore separate \
symbols: ",
 StyleBox["LL[tex, \"j\" -> \"1\"]",
  FontFamily->"Source Code Pro"],
 " (written in the input cells as the printed component ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Sigma]", "1", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "43b5f7a6-d02c-4eaa-8957-e0869b320d9c"],
 ") symbolizes and returns the component with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["j", "TI"], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ffc7b727-39f6-45d3-bd90-b62cea75f97e"],
 ". The cell gives the three components the Pauli matrices as values, \
together with the identity ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["1",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c665a306-ca25-4e9c-b4df-4c93d19132e0"],
 ", and checks two identities that involve sums over the index: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["j", "TI"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox["\[Sigma]", 
     StyleBox["j", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Sigma]", 
     StyleBox["j", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "3", "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "faef2c9e-a058-4cf0-9c74-076e2d55a957"],
 ", and the product rule ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Sigma]", 
     StyleBox["j", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Sigma]", 
     SuperscriptBox[
      StyleBox["j", "TI"], "\[Prime]"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubscriptBox["\[Delta]", 
     RowBox[{
      StyleBox["j", "TI"], 
      SuperscriptBox[
       StyleBox["j", "TI"], "\[Prime]"]}]], 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "2"], "+", 
    StyleBox["i", "TI"], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", 
     SuperscriptBox[
      StyleBox["j", "TI"], "\[Prime]\[Prime]"],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox["\[Epsilon]", 
     RowBox[{
      StyleBox["j", "TI"], 
      SuperscriptBox[
       StyleBox["j", "TI"], "\[Prime]"], 
      SuperscriptBox[
       StyleBox["j", "TI"], "\[Prime]\[Prime]"]}], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox["\[Sigma]", 
     SuperscriptBox[
      StyleBox["j", "TI"], "\[Prime]\[Prime]"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "67296a78-38a4-491a-9ff4-942cf24e21a1"],
 ", in which the 27 components of the symbol ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Epsilon]", 
    RowBox[{
     StyleBox["j", "TI"], 
     SuperscriptBox[
      StyleBox["j", "TI"], "\[Prime]"], 
     SuperscriptBox[
      StyleBox["j", "TI"], "\[Prime]\[Prime]"]}], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a2f5c472-777b-47ab-aca4-ab8c0c99626a"],
 " (the totally antisymmetric symbol with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Epsilon]", "123", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "43c4f075-3868-442c-955d-fad93a2dda4b"],
 ") are symbolized and given their values."
}], "Text",ExpressionUUID->"724400fc-73ba-49c6-a84c-a27b18fccf29"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"symbolize", " ", "the", " ", "components", " ", 
     RowBox[{"sigma", "^", "LL_"}], "1"}], ",", " ", 
    RowBox[{
     RowBox[{"sigma", "^", "LL_"}], "2"}], ",", " ", 
    RowBox[{
     RowBox[{"sigma", "^", "LL_"}], "3", " ", "and", " ", 
     RowBox[{"epsilon", "^", "LL_"}], 
     RowBox[{"{", 
      RowBox[{"j", " ", 
       RowBox[{"j", "'"}], " ", 
       RowBox[{"j", "''"}]}], "}"}], " ", 
     RowBox[{"(", 
      RowBox[{"j", ",", " ", 
       RowBox[{"j", "'"}], ",", " ", 
       RowBox[{
        RowBox[{"j", "''"}], " ", "=", " ", "1"}], ",", " ", "2", ",", " ", 
       "3"}], ")"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"sigma", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"ReleaseHold", "[", 
        RowBox[{"SL31Instance", "[", 
         RowBox[{
          RowBox[{
          "SL31SymbolBoxes", "[", "\"\<\\\\sigma^{\\\\rm LL}_j\>\"", "]"}], ",",
           " ", 
          RowBox[{"{", 
           RowBox[{"\"\<j\>\"", " ", "->", " ", 
            RowBox[{"ToString", "[", "k", "]"}]}], "}"}]}], "]"}], "]"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"eps", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"ReleaseHold", "[", 
        RowBox[{"SL31Instance", "[", 
         RowBox[{
          RowBox[{
          "SL31SymbolBoxes", "[", "\"\<\\\\epsilon^{\\\\rm LL}_{jj'j''}\>\"", 
           "]"}], ",", "\n", "      ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\"\<j\>\"", " ", "->", " ", 
             RowBox[{"ToString", "[", "a", "]"}]}], ",", " ", 
            RowBox[{
             RowBox[{"SuperscriptBox", "[", 
              RowBox[{"\"\<j\>\"", ",", " ", "\"\<\[Prime]\>\""}], "]"}], " ",
              "->", " ", 
             RowBox[{"ToString", "[", "b", "]"}]}], ",", " ", 
            RowBox[{
             RowBox[{"SuperscriptBox", "[", 
              RowBox[{"\"\<j\>\"", ",", " ", "\"\<\[Prime]\[Prime]\>\""}], 
              "]"}], " ", "->", " ", 
             RowBox[{"ToString", "[", "c", "]"}]}]}], "}"}]}], "]"}], "]"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"b", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"c", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"{", 
    RowBox[{"sigma", ",", " ", 
     RowBox[{"eps", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "]"}], "]"}], ",", " ", 
     RowBox[{"eps", "[", 
      RowBox[{"[", 
       RowBox[{"2", ",", " ", "1", ",", " ", "3"}], "]"}], "]"}]}], 
    "}"}]}]}]], "Input",ExpressionUUID->"497f954f-26a7-480c-a71d-\
8dd7a9787334"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", 
     RowBox[{"values", ":", " ", 
      RowBox[{"inside", " ", "Block", " ", "only"}]}]}], ",", " ", 
    RowBox[{
    "so", " ", "that", " ", "the", " ", "symbols", " ", "stay", " ", "free", " ",
      "elsewhere"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"pauliValues", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "0"}], "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", 
           RowBox[{"-", "I"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"I", ",", " ", "0"}], "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", 
           RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check7", " ", "=", " ", 
     RowBox[{"Block", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          SubsuperscriptBox["\[Sigma]", "1", "LL"], " ", "=", " ", 
          RowBox[{"pauliValues", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
         RowBox[{
          SubsuperscriptBox["\[Sigma]", "2", "LL"], " ", "=", " ", 
          RowBox[{"pauliValues", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ",", "\n", "     ", 
         RowBox[{
          SubsuperscriptBox["\[Sigma]", "3", "LL"], " ", "=", " ", 
          RowBox[{"pauliValues", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], ",", " ", 
         RowBox[{
          SubscriptBox[
           TagBox[
            StyleBox["1",
             FontFamily->"Helvetica",
             FontSlant->"Plain"],
            "SL31SansSerif"], "2"], " ", "=", " ", 
          RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], "}"}], ",", "\n", 
       "   ", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"sum", ",", " ", "rule"}], "}"}], ",", "\n", "     ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{"the", " ", "sum", " ", "over", " ", "j", " ", "of", " ", 
            RowBox[{"sigma_j", " ", ".", " ", "sigma_j"}]}], ",", " ", 
           RowBox[{
           "written", " ", "with", " ", "the", " ", "three", " ", 
            "components"}]}], " ", "*)"}], "\n", "     ", 
         RowBox[{
          RowBox[{"sum", " ", "=", " ", 
           RowBox[{
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"sigma", "[", 
                RowBox[{"[", "j", "]"}], "]"}], " ", ".", " ", 
               RowBox[{"sigma", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}], " ", "-", " ", 
            RowBox[{"3", " ", 
             SubscriptBox[
              TagBox[
               StyleBox["1",
                FontFamily->"Helvetica",
                FontSlant->"Plain"],
               "SL31SansSerif"], "2"]}]}]}], ";", "\n", "     ", 
          RowBox[{"(*", " ", 
           RowBox[{
            RowBox[{
            "the", " ", "product", " ", "rule", " ", "for", " ", "all", " ", 
             "nine", " ", "pairs", " ", 
             RowBox[{"(", 
              RowBox[{"j", ",", " ", 
               RowBox[{"j", "'"}]}], ")"}]}], ",", " ", 
            RowBox[{
            "with", " ", "the", " ", "27", " ", "symbolized", " ", 
             "components", " ", "of", " ", "epsilon"}]}], " ", "*)"}], "\n", 
          "     ", 
          RowBox[{"rule", " ", "=", " ", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"sigma", "[", 
                RowBox[{"[", "j", "]"}], "]"}], " ", ".", " ", 
               RowBox[{"sigma", "[", 
                RowBox[{"[", "jp", "]"}], "]"}]}], " ", "-", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"KroneckerDelta", "[", 
                  RowBox[{"j", ",", " ", "jp"}], "]"}], " ", 
                 SubscriptBox[
                  TagBox[
                   StyleBox["1",
                    FontFamily->"Helvetica",
                    FontSlant->"Plain"],
                   "SL31SansSerif"], "2"]}], " ", "+", "\n", "           ", 
                RowBox[{"I", " ", 
                 RowBox[{"Sum", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"eps", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", ",", " ", "jp", ",", " ", "jpp"}], "]"}], 
                    "]"}], " ", "/.", " ", 
                    RowBox[{"Thread", "[", 
                    RowBox[{
                    RowBox[{"Flatten", "[", "eps", "]"}], " ", "->", " ", 
                    RowBox[{"Flatten", "[", 
                    RowBox[{"Normal", "[", 
                    RowBox[{"LeviCivitaTensor", "[", "3", "]"}], "]"}], 
                    "]"}]}], "]"}]}], ")"}], " ", 
                    RowBox[{"sigma", "[", 
                    RowBox[{"[", "jpp", "]"}], "]"}]}], ",", " ", 
                   RowBox[{"{", 
                    RowBox[{"jpp", ",", " ", "3"}], "}"}]}], "]"}]}]}], 
               ")"}]}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"j", ",", " ", "3"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"jp", ",", " ", "3"}], "}"}]}], "]"}]}], ";", "\n", 
          "     ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Max", "[", 
             RowBox[{"Abs", "[", "sum", "]"}], "]"}], ",", " ", 
            RowBox[{"Max", "[", 
             RowBox[{"Abs", "[", 
              RowBox[{"Flatten", "[", "rule", "]"}], "]"}], "]"}]}], 
           "}"}]}]}], "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"SL31Check", "[", 
     RowBox[{"\"\<S-7\>\"", ",", 
      " ", "\"\<sum over j of sigma^LL_j sigma^LL_j = 3 times the unit \
matrix, and sigma_j sigma_j' = delta_jj' + i sum_j'' epsilon_jj'j'' sigma_j'' \
for all nine pairs (components as symbolized symbols)\>\"", ",", "\n", "  ", 
      RowBox[{"check7", " ", "===", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0"}], "}"}]}], ",", " ", "check7"}], "]"}], 
    ";"}]}]}]], "Input",ExpressionUUID->"65119efa-d097-4427-b70e-\
6472926ed5c5"],

Cell[TextData[{
 "S-8, a double sum with a metric: the Minkowski square. The family ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "84950f66-d66e-45ec-a5bc-5bad4a52cdcb"],
 " (the coordinates of space-time, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["p", "TI"], "\[LongEqual]", "0", ",", "1", ",", "2", ",", "3"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6bc50581-0887-42cd-aabf-613967ab97bf"],
 ") and the metric ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Eta]", 
    RowBox[{
     StyleBox["p", "TI"], 
     SuperscriptBox[
      StyleBox["p", "TI"], "\[Prime]"]}], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d8f7c35d-a035-4ccd-9cd4-9eef484bc57b"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c443bbaf-657e-42fa-886f-bb4da8f9bf26"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["p", "TI"], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["p", "TI"], "\[Prime]"], "\[LongEqual]", "0"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2f4f62bc-5d9e-47d1-874d-36d7f392c24c"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f9a421e6-b258-4c2a-9239-0725bdb4a7d2"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["p", "TI"], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["p", "TI"], "\[Prime]"], "\[LongEqual]", "1", ",", "2", ",", 
    "3"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9a186d2a-475a-4162-a90d-18b6d15adea3"],
 ", zero otherwise) are symbolized component by component; the double sum ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["p", "TI"], ",", 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}],
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox["\[Eta]", 
     RowBox[{
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p", "TI"]], 
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     SuperscriptBox[
      StyleBox["p", "TI"], "\[Prime]"]]}], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bb69e7c6-a84f-4084-9d2c-5e8ab27afd58"],
 " is formed with the 16 components of the metric as free symbols, then the \
metric receives its values and the sum must become ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "0"], ")"}], "2"], "-", 
    UnderscriptBox["\[Sum]", 
     StyleBox["j", "TI"],
     LimitsPositioning->True], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["j", "TI"]], ")"}], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b4a0a273-b9f1-4f1e-b7ea-b6c34cdb1fde"],
 ", with the coordinate components remaining free symbols. The test is \
algebraic: ",
 StyleBox["Expand",
  FontFamily->"Source Code Pro"],
 " and a comparison of polynomials in the four coordinate symbols."
}], "Text",ExpressionUUID->"293d29d1-580f-4c89-8b1b-ee768c98f59d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"xs", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ReleaseHold", "[", 
      RowBox[{"SL31Instance", "[", 
       RowBox[{
        RowBox[{"SL31SymbolBoxes", "[", "\"\<x^p_{\\\\rm LL}\>\"", "]"}], ",",
         " ", 
        RowBox[{"{", 
         RowBox[{"\"\<p\>\"", " ", "->", " ", 
          RowBox[{"ToString", "[", "k", "]"}]}], "}"}]}], "]"}], "]"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"etas", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ReleaseHold", "[", 
      RowBox[{"SL31Instance", "[", 
       RowBox[{
        RowBox[{
        "SL31SymbolBoxes", "[", "\"\<\\\\eta^{\\\\rm LL}_{pp'}\>\"", "]"}], ",",
         " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\"\<p\>\"", " ", "->", " ", 
           RowBox[{"ToString", "[", "a", "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{"SuperscriptBox", "[", 
            RowBox[{"\"\<p\>\"", ",", " ", "\"\<\[Prime]\>\""}], "]"}], " ", "->",
            " ", 
           RowBox[{"ToString", "[", "b", "]"}]}]}], "}"}]}], "]"}], "]"}], ",",
      " ", 
     RowBox[{"{", 
      RowBox[{"a", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"b", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"quadratic", " ", "=", " ", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"etas", "[", 
       RowBox[{"[", 
        RowBox[{"a", ",", " ", "b"}], "]"}], "]"}], " ", 
      RowBox[{"xs", "[", 
       RowBox[{"[", "a", "]"}], "]"}], " ", 
      RowBox[{"xs", "[", 
       RowBox[{"[", "b", "]"}], "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"a", ",", " ", "4"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"b", ",", " ", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"minkowski", " ", "=", " ", 
   RowBox[{"Expand", "[", 
    RowBox[{"quadratic", " ", "/.", " ", 
     RowBox[{"Thread", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", "etas", "]"}], " ", "->", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{"DiagonalMatrix", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", 
           RowBox[{"-", "1"}], ",", " ", 
           RowBox[{"-", "1"}], ",", " ", 
           RowBox[{"-", "1"}]}], "}"}], "]"}], "]"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Length", "[", "quadratic", "]"}], ",", " ", "minkowski"}], 
  "}"}]}], "Input",ExpressionUUID->"a3c00979-efd3-4c84-a64e-1a282f8f17db"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-8\>\"", ",", 
    " ", "\"\<the double sum of eta^LL_pp' x^p x^p' over p, p' = 0..3 (16 + 4 \
symbolized components) is (x^0)^2 - (x^1)^2 - (x^2)^2 - (x^3)^2\>\"", ",", 
    "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"Expand", "[", 
       RowBox[{"minkowski", " ", "-", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"xs", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "^", "2"}], " ", "-", " ", 
          RowBox[{
           RowBox[{"xs", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "^", "2"}], " ", "-", " ", 
          RowBox[{
           RowBox[{"xs", "[", 
            RowBox[{"[", "3", "]"}], "]"}], "^", "2"}], " ", "-", " ", 
          RowBox[{
           RowBox[{"xs", "[", 
            RowBox[{"[", "4", "]"}], "]"}], "^", "2"}]}], ")"}]}], "]"}], " ",
       "===", " ", "0"}], " ", "&&", " ", 
     RowBox[{
      RowBox[{"Length", "[", "quadratic", "]"}], " ", "==", " ", "16"}]}], ",",
     " ", "minkowski"}], "]"}], ";"}]], "Input",ExpressionUUID->"f0b7c380-\
5dfd-413a-90a9-75b8aaf8d943"],

Cell[TextData[{
 "S-9, algebra with the symbols of the Higgs mechanism of the superfluid \
boson singlet state. The rest masses of the two charged vector bosons and of \
the vector boson of the fermion number are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["W",
        FontSlant->"Plain"]], ")"}], "2"], "\[LongEqual]", "2", 
    SubsuperscriptBox[
     StyleBox["Z", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["s",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["g", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["v",
        FontSlant->"Plain"]], ")"}], "2"], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["vac",
        FontSlant->"Plain"]], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d4b786a4-6ae1-4d72-9c1c-769f47319bdd"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["F",
        FontSlant->"Plain"]], ")"}], "2"], "\[LongEqual]", "8", 
    SubsuperscriptBox[
     StyleBox["Z", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["s",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["g", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["F",
        FontSlant->"Plain"]], ")"}], "2"], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["vac",
        FontSlant->"Plain"]], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6e8dfb94-0d77-45b9-8cc3-eabb515da473"],
 ", where ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["Z", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["s",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "75c214fa-04fe-40a2-a1eb-8debab3c1dce"],
 " is the stiffness of the space derivatives and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["v",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "38a3b08f-d74a-47f7-8884-b246dba3c15d"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["F",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ffb39215-bce1-412a-8f73-51cbcfccaef4"],
 " are the gauge couplings. The cell checks with ",
 StyleBox["Simplify",
  FontFamily->"Source Code Pro"],
 " that the ratio of the squared masses is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"4", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["g", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], 
        StyleBox["F",
         FontSlant->"Plain"]], "/", 
       SubsuperscriptBox[
        StyleBox["g", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], 
        StyleBox["v",
         FontSlant->"Plain"]]}], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a0ae8ca9-7caf-471d-a25b-915d9b8d4be2"],
 ", independent of the stiffness and of the gap, and with ",
 StyleBox["Solve",
  FontFamily->"Source Code Pro"],
 " that the gap can be recovered from ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["M", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["W",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "676fa611-bd27-43a9-ab8c-2959c1c54b67"],
 "."
}], "Text",ExpressionUUID->"79229ea7-990e-40d3-a715-9fc183f109d8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"massRules", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      SubsuperscriptBox["M", "LL", "W"], " ", "->", " ", 
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{"2", " ", 
         SubsuperscriptBox["Z", "LL", "s"]}], "]"}], " ", 
       SubsuperscriptBox["g", "LL", "v"], " ", 
       SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"]}]}], ",", "\n", 
     "   ", 
     RowBox[{
      SubsuperscriptBox["M", "LL", "F"], " ", "->", " ", 
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{"8", " ", 
         SubsuperscriptBox["Z", "LL", "s"]}], "]"}], " ", 
       SubsuperscriptBox["g", "LL", "F"], " ", 
       SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"]}]}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{"ratio", " ", "=", " ", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox["M", "LL", "F"], "/", 
       SubsuperscriptBox["M", "LL", "W"]}], ")"}], "^", "2"}], " ", "/.", " ",
     "massRules"}], "]"}]}]}], "Input",ExpressionUUID->"60d97832-4fdf-4f03-\
af86-1478c7d71531"],

Cell[BoxData[
 RowBox[{"gapFromMass", " ", "=", " ", 
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      SubsuperscriptBox["M", "LL", "W"], "^", "2"}], " ", "==", " ", 
     RowBox[{"2", " ", 
      SubsuperscriptBox["Z", "LL", "s"], " ", 
      RowBox[{
       SubsuperscriptBox["g", "LL", "v"], "^", "2"}], " ", 
      RowBox[{
       SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], "^", "2"}]}]}], ",",
     " ", 
    SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"]}], "]"}]}]], "Input",Exp\
ressionUUID->"f86bb65a-2a5f-4788-af2b-a54f5ea3aac4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-9\>\"", ",", 
    " ", "\"\<(M^F_LL / M^W_LL)^2 = 4 (g^F_LL / g^v_LL)^2 and the gap follows \
from M^W_LL (algebra with symbolized symbols)\>\"", ",", "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{"ratio", " ", "-", " ", 
        RowBox[{"4", " ", 
         RowBox[{
          RowBox[{
           SubsuperscriptBox["g", "LL", "F"], "^", "2"}], "/", 
          RowBox[{
           SubsuperscriptBox["g", "LL", "v"], "^", "2"}]}]}]}], "]"}], " ", "===",
       " ", "0"}], " ", "&&", " ", 
     RowBox[{
      RowBox[{"Length", "[", "gapFromMass", "]"}], " ", "==", " ", "2"}]}], ",",
     " ", "ratio"}], "]"}], ";"}]], "Input",ExpressionUUID->"b7f0df14-752b-\
4d01-bbf9-c86b217cb7b3"],

Cell[TextData[{
 "S-10, the longitudinal vector boson. For a plane wave of wave number ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["k", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["B",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d9dc734d-c497-4858-a6bf-c2135ee69ba5"],
 " and frequency ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Omega]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["B",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f7373224-3c08-4d98-9aba-9a1634deb7fc"],
 " the time component and the longitudinal component of a massive vector \
field obey two linear equations; their determinant is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox[
         StyleBox["k", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], 
         StyleBox["B",
          FontSlant->"Plain"]], ")"}], "2"], "+", 
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox[
         StyleBox["Z", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], 
         StyleBox["t",
          FontSlant->"Plain"]], "/", 
        SubsuperscriptBox[
         StyleBox["Z", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], 
         StyleBox["s",
          FontSlant->"Plain"]]}], ")"}], 
      SuperscriptBox[
       StyleBox["M", "TI"], "2"]}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox["\[Omega]", 
         StyleBox["LL",
          FontSlant->"Plain"], 
         StyleBox["B",
          FontSlant->"Plain"]], ")"}], "2"], "-", 
      SuperscriptBox[
       StyleBox["M", "TI"], "2"]}], ")"}], "-", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["k", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], 
        StyleBox["B",
         FontSlant->"Plain"]], 
       SubsuperscriptBox["\[Omega]", 
        StyleBox["LL",
         FontSlant->"Plain"], 
        StyleBox["B",
         FontSlant->"Plain"]]}], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "baadf6ed-4eb8-4afd-babc-053477322901"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["M", "TI"], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["W",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "54be214d-4353-4292-bb49-d7a936869fca"],
 ". The cell checks with ",
 StyleBox["Factor",
  FontFamily->"Source Code Pro"],
 " and ",
 StyleBox["Solve",
  FontFamily->"Source Code Pro"],
 " that it vanishes exactly for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[Omega]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["B",
        FontSlant->"Plain"]], ")"}], "2"], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["W",
        FontSlant->"Plain"]], ")"}], "2"], "+", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["Z", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["s",
        FontSlant->"Plain"]], "/", 
      SubsuperscriptBox[
       StyleBox["Z", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["t",
        FontSlant->"Plain"]]}], ")"}], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["k", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["B",
        FontSlant->"Plain"]], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3f78f81c-32cf-4f71-9980-d9ecbcb4b6e0"],
 ": the absorbed Goldstone boson moves with the velocity ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["Z", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["s",
        FontSlant->"Plain"]], "/", 
      SubsuperscriptBox[
       StyleBox["Z", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["t",
        FontSlant->"Plain"]]}], ")"}], 
    RowBox[{"1", "/", "2"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5dbc6f51-fcd2-430f-9e0f-dbac47005806"],
 "."
}], "Text",ExpressionUUID->"702359fb-ae89-45e9-994c-b43e237272c1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"det", " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SubsuperscriptBox["k", "LL", "B"], "^", "2"}], " ", "+", " ", 
        RowBox[{
         RowBox[{
          SubsuperscriptBox["Z", "LL", "t"], "/", 
          SubsuperscriptBox["Z", "LL", "s"]}], " ", 
         RowBox[{
          SubsuperscriptBox["M", "LL", "W"], "^", "2"}]}]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SubsuperscriptBox["\[Omega]", "LL", "B"], "^", "2"}], " ", "-", " ", 
        
        RowBox[{
         SubsuperscriptBox["M", "LL", "W"], "^", "2"}]}], ")"}]}], " ", "-", 
     "\n", "   ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox["k", "LL", "B"], " ", 
        SubsuperscriptBox["\[Omega]", "LL", "B"]}], ")"}], "^", "2"}]}]}], 
   ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Solve", " ", "needs", " ", "a", " ", "symbol", " ", "as", " ", 
    RowBox[{"unknown", ":", " ", 
     RowBox[{
     "the", " ", "square", " ", "of", " ", "the", " ", "frequency", " ", "is",
       " ", "called", " ", "w"}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{"root", " ", "=", " ", 
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"det", " ", "/.", " ", 
       RowBox[{
        SubsuperscriptBox["\[Omega]", "LL", "B"], " ", "->", " ", 
        RowBox[{"Sqrt", "[", "w", "]"}]}]}], ")"}], " ", "==", " ", "0"}], ",",
     " ", "w"}], "]"}]}]}], "Input",ExpressionUUID->"457e2881-c264-4390-901b-\
517a3e8ef940"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-10\>\"", ",", 
    " ", "\"\<the determinant of the time and longitudinal equations vanishes \
exactly at omega_B^2 = M_W^2 + (Z_s/Z_t) k_B^2\>\"", ",", "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", "root", "]"}], " ", "==", " ", "1"}], " ", "&&", 
     " ", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"w", " ", "/.", " ", 
          RowBox[{"First", "[", "root", "]"}]}], ")"}], " ", "-", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           SubsuperscriptBox["M", "LL", "W"], "^", "2"}], " ", "+", " ", 
          RowBox[{
           RowBox[{
            SubsuperscriptBox["Z", "LL", "s"], "/", 
            SubsuperscriptBox["Z", "LL", "t"]}], " ", 
           RowBox[{
            SubsuperscriptBox["k", "LL", "B"], "^", "2"}]}]}], ")"}]}], "]"}],
       " ", "===", " ", "0"}]}], ",", "\n", "  ", 
    RowBox[{"Factor", "[", "det", "]"}]}], "]"}], ";"}]], "Input",ExpressionUU\
ID->"11ec9323-06c5-499a-927f-0f61d853d7d6"],

Cell[TextData[{
 "S-11, the sum over the isospin index with the generators ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Iota]"], "\[LongEqual]", 
    SubsuperscriptBox["\[Tau]", "\[Iota]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "/", "2"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4befce1f-ba14-4104-9e7c-fc81aa79ab38"],
 ": the Casimir ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SubscriptBox[
       StyleBox["T", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]], ")"}], "2"], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", "\[Iota]",
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Iota]"], 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Iota]"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "598d5c81-395c-497c-824c-45a98b948570"],
 " of the isospin one-half is ",
 Cell[BoxData[
  FormBox[
   FractionBox["3", "4"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "aa50c3dc-4907-4802-af59-c3082c4fa118"],
 " times the unit matrix. The components ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Tau]", "1", 
     StyleBox["LL",
      FontSlant->"Plain"]], ",", 
    SubsuperscriptBox["\[Tau]", "2", 
     StyleBox["LL",
      FontSlant->"Plain"]], ",", 
    SubsuperscriptBox["\[Tau]", "3", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3bdb5033-cb4e-4eeb-8ef7-762d5357f0fa"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], ",", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "2"], ",", 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "3"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a1e31c0d-9ff9-448d-ab1d-0393337d325c"],
 " are symbolized; the generators are defined from the Pauli matrices by \
rules."
}], "Text",ExpressionUUID->"0fef1c47-214c-48a3-9fde-0f90781deda6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"taus", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ReleaseHold", "[", 
      RowBox[{"SL31Instance", "[", 
       RowBox[{
        RowBox[{
        "SL31SymbolBoxes", "[", "\"\<\\\\tau^{\\\\rm LL}_\\\\iota\>\"", "]"}],
         ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<\[Iota]\>\"", " ", "->", " ", 
          RowBox[{"ToString", "[", "k", "]"}]}], "}"}]}], "]"}], "]"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Ts", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ReleaseHold", "[", 
      RowBox[{"SL31Instance", "[", 
       RowBox[{
        RowBox[{
        "SL31SymbolBoxes", "[", "\"\<T^\\\\iota_{\\\\rm LL}\>\"", "]"}], ",", 
        " ", 
        RowBox[{"{", 
         RowBox[{"\"\<\[Iota]\>\"", " ", "->", " ", 
          RowBox[{"ToString", "[", "k", "]"}]}], "}"}]}], "]"}], "]"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"casimir", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Ts", "[", 
         RowBox[{"[", "k", "]"}], "]"}], " ", ".", " ", 
        RowBox[{"Ts", "[", 
         RowBox[{"[", "k", "]"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}], " ", "/.", " ", 
     RowBox[{"Thread", "[", 
      RowBox[{"Ts", " ", "->", " ", 
       RowBox[{"taus", "/", "2"}]}], "]"}]}], " ", "/.", " ", 
    RowBox[{"Thread", "[", 
     RowBox[{"taus", " ", "->", " ", "pauliValues"}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-11\>\"", ",", 
    " ", "\"\<the sum over iota of T^iota_LL T^iota_LL (with T = tau/2 for \
the symbolized components) is 3/4 times the unit matrix\>\"", ",", "\n", "  ", 
    RowBox[{"casimir", " ", "===", " ", 
     RowBox[{
      RowBox[{"3", "/", "4"}], " ", 
      RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], ",", " ", "casimir"}], 
   "]"}], ";"}]}], "Input",ExpressionUUID->"dcb03ed9-1d1c-4cf5-8f0a-\
9eafacf6be19"],

Cell["\<\
S-12, uniqueness of the plain-text names: no plain-text name of the registry \
belongs to two different entries (the programs and data files can therefore \
always be read back without ambiguity), and every name maps to one entry.\
\>", "Text",ExpressionUUID->"8e100da0-66d0-4f17-ad2a-2b612230546a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"nameToEntries", " ", "=", " ", 
   RowBox[{"GroupBy", "[", 
    RowBox[{
     RowBox[{"Flatten", "[", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{"e", ",", " ", 
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"#", " ", "->", " ", 
              RowBox[{"e", "[", "\"\<entry\>\"", "]"}]}], " ", "&"}], ",", 
            " ", 
            RowBox[{"e", "[", "\"\<names\>\"", "]"}]}], "]"}]}], "]"}], ",", 
        " ", "SL31Registry"}], "]"}], "]"}], ",", " ", 
     RowBox[{"First", " ", "->", " ", "Last"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"shared", " ", "=", " ", 
   RowBox[{"Select", "[", 
    RowBox[{"nameToEntries", ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", 
        RowBox[{"DeleteDuplicates", "[", "#", "]"}], "]"}], " ", ">", " ", 
       "1"}], " ", "&"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-12\>\"", ",", 
    " ", "\"\<no plain-text name is registered for two different entries\>\"",
     ",", "\n", "  ", 
    RowBox[{"shared", " ", "===", " ", 
     RowBox[{"<|", "|>"}]}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Length", "[", "nameToEntries", "]"}], ",", " ", 
      RowBox[{"Normal", "[", "shared", "]"}]}], "}"}]}], "]"}], 
  ";"}]}], "Input",ExpressionUUID->"ee6597c3-71c8-44f2-b454-b0775f28afb8"],

Cell[TextData[{
 "S-13, the kinds that are not symbolized. The imaginary unit ",
 Cell[BoxData[
  FormBox[
   StyleBox["i", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "49aa2f06-1034-45d3-bc56-1813aba64cef"],
 " is the Wolfram symbol ",
 StyleBox["I",
  FontFamily->"Source Code Pro"],
 "; the number sets ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[DoubleStruckCapitalR]",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bef902e3-82b3-4548-9ac3-2f7e42229a66"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[DoubleStruckCapitalC]",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8909e898-f39d-41b1-beb9-077f2079534a"],
 " are the Wolfram domains ",
 StyleBox["Reals",
  FontFamily->"Source Code Pro"],
 " and ",
 StyleBox["Complexes",
  FontFamily->"Source Code Pro"],
 " (which the Wolfram Language prints as double-struck letters); the \
operators correspond to Wolfram functions: tr is ",
 StyleBox["Tr",
  FontFamily->"Source Code Pro"],
 ", det is ",
 StyleBox["Det",
  FontFamily->"Source Code Pro"],
 ", diag is ",
 StyleBox["DiagonalMatrix",
  FontFamily->"Source Code Pro"],
 ", Re and Im are ",
 StyleBox["Re",
  FontFamily->"Source Code Pro"],
 " and ",
 StyleBox["Im",
  FontFamily->"Source Code Pro"],
 ", the tensor product ",
 Cell[BoxData[
  FormBox["\[CircleTimes]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8c61218e-81fe-42db-a413-40955bf9338d"],
 " is ",
 StyleBox["KroneckerProduct",
  FontFamily->"Source Code Pro"],
 ", the transpose ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["", 
    StyleBox["T", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6ce2205a-192d-4af5-b0c7-45fec5daa07d"],
 " is ",
 StyleBox["Transpose",
  FontFamily->"Source Code Pro"],
 ". The test checks each correspondence on the Pauli matrices."
}], "Text",ExpressionUUID->"0defb365-1d48-4e6a-af78-964308925930"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"p1", " ", "=", " ", 
   RowBox[{"pauliValues", "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";", " ", 
  RowBox[{"p2", " ", "=", " ", 
   RowBox[{"pauliValues", "[", 
    RowBox[{"[", "2", "]"}], "]"}]}], ";", " ", 
  RowBox[{"p3", " ", "=", " ", 
   RowBox[{"pauliValues", "[", 
    RowBox[{"[", "3", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"correspondences", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"I", "^", "2"}], " ", "==", " ", 
      RowBox[{"-", "1"}]}], ",", " ", 
     RowBox[{"Element", "[", 
      RowBox[{
       RowBox[{"Sqrt", "[", "2", "]"}], ",", " ", "Reals"}], "]"}], ",", " ", 
     
     RowBox[{"Element", "[", 
      RowBox[{"I", ",", " ", "Complexes"}], "]"}], ",", " ", 
     RowBox[{"!", " ", 
      RowBox[{"Element", "[", 
       RowBox[{"I", ",", " ", "Reals"}], "]"}]}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"Tr", "[", "p3", "]"}], " ", "==", " ", "0"}], ",", " ", 
     RowBox[{
      RowBox[{"Det", "[", "p1", "]"}], " ", "==", " ", 
      RowBox[{"-", "1"}]}], ",", " ", 
     RowBox[{
      RowBox[{"DiagonalMatrix", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", 
         RowBox[{"-", "1"}]}], "}"}], "]"}], " ", "==", " ", "p3"}], ",", " ", 
     RowBox[{
      RowBox[{"Re", "[", "p2", "]"}], " ", "==", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}]}], ",", " ", 
     RowBox[{
      RowBox[{"Im", "[", "p2", "]"}], " ", "==", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", 
          RowBox[{"-", "1"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "0"}], "}"}]}], "}"}]}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"p1", ",", " ", "p3"}], "]"}], " ", ".", " ", 
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"p1", ",", " ", "p3"}], "]"}]}], " ", "==", " ", 
      RowBox[{"IdentityMatrix", "[", "4", "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{"Transpose", "[", "p2", "]"}], " ", "==", " ", 
      RowBox[{"-", "p2"}]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-13\>\"", ",", 
    " ", "\"\<the imaginary unit, the number sets and the operators \
correspond to I, Reals, Complexes, Tr, Det, DiagonalMatrix, Re, Im, \
KroneckerProduct, Transpose\>\"", ",", "\n", "  ", 
    RowBox[{"And", " ", "@@", " ", "correspondences"}], ",", " ", 
    "correspondences"}], "]"}], ";"}]}], "Input",ExpressionUUID->"0739b65c-\
8695-4ce3-9006-f0079de904c8"],

Cell[TextData[{
 "S-15, the reader of formulas (section I.3). (a) Eighteen formulas whose \
reading is known are converted and their readings on one line are compared \
with the known readings; among them are the cases that the TeX importer of \
the Wolfram Language reads wrongly (a fraction with arguments without braces, \
and ",
 StyleBox["\\hbar",
  FontFamily->"Source Code Pro"],
 "). (b) Every formula in the meanings of the registry is converted: the \
reader must report no problem, the number of fraction boxes must equal the \
number of the commands ",
 StyleBox["\\frac",
  FontFamily->"Source Code Pro"],
 " and ",
 StyleBox["\\tfrac",
  FontFamily->"Source Code Pro"],
 " in the TeX, the number of root boxes must equal the number of the commands \
",
 StyleBox["\\sqrt",
  FontFamily->"Source Code Pro"],
 ", and no fraction box may have an empty numerator or denominator. (c) A \
name is not a product: the boxes of ",
 StyleBox["x5",
  FontFamily->"Source Code Pro"],
 " must be the letter, the character ",
 StyleBox["\\[InvisibleSpace]",
  FontFamily->"Source Code Pro"],
 " and the number, and the boxes of ",
 StyleBox["5x",
  FontFamily->"Source Code Pro"],
 " the number and the letter with nothing between them (a product, between \
whose factors the front end puts its thin space); the last number of the \
result counts the names of this kind in the meanings of the registry (the \
three coordinates ",
 StyleBox["x5",
  FontFamily->"Source Code Pro"],
 ", ",
 StyleBox["x6",
  FontFamily->"Source Code Pro"],
 ", ",
 StyleBox["x7",
  FontFamily->"Source Code Pro"],
 ")."
}], "Text",ExpressionUUID->"ed5cf79c-40ae-4000-8a9b-b02c3e70c1ae"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"cases15", " ", "=", " ", 
   RowBox[{"{", "\n", "   ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<\\\\tfrac12\\\\ell^{\\\\rm x}_{\\\\rm LL}g^{\\\\rm \
v}_{\\\\rm LL}\>\"", ",", 
       " ", "\"\<frac{1}{2}\[ScriptL]_{LL}^{x}g_{LL}^{v}\>\""}], "}"}], ",", 
     "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"\"\<Q_{\\\\rm LL}=-\\\\tfrac12\>\"", ",", 
       " ", "\"\<Q_{LL}=-frac{1}{2}\>\""}], "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"\"\<\\\\cos(\\\\tfrac12\\\\vartheta^{\\\\rm B}_{\\\\rm \
LL})\>\"", ",", " ", "\"\<cos(frac{1}{2}\[CurlyTheta]_{LL}^{B})\>\""}], "}"}],
      ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"\"\<-\\\\tfrac{15}8\\\\int_{q_{\\\\rm LL}<\\\\Lambda_{\\\\rm \
LL}}d^3q_{\\\\rm LL}\>\"", ",", 
       " ", "\"\<-frac{15}{8}\[Integral]_{q_{LL}<\[CapitalLambda]_{LL}}d^{3}q_\
{LL}\>\""}], "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"\"\<\\\\tfrac i2(y^+_{\\\\rm LL}-y^-_{\\\\rm LL})\>\"", ",", 
       " ", "\"\<frac{i}{2}(y_{LL}^{+}-y_{LL}^{-})\>\""}], "}"}], ",", "\n", 
     "   ", 
     RowBox[{"{", 
      RowBox[{"\"\<\\\\frac{r^{\\\\rm W}_{\\\\rm LL}}{2\\\\ell^{\\\\rm x}_{\\\
\\rm LL}}\\\\beta_{\\\\rm LL}\>\"", ",", 
       " ", "\"\<frac{r_{LL}^{W}}{2\[ScriptL]_{LL}^{x}}\[Beta]_{LL}\>\""}], 
      "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"\"\<\\\\sqrt2\\\\,\\\\ell^{\\\\rm x}_{\\\\rm LL}\>\"", ",", 
       " ", "\"\<sqrt{2}\[ScriptL]_{LL}^{x}\>\""}], "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"\"\<\\\\sqrt{2n^{\\\\rm cpx}_{\\\\rm LL}}\>\"", ",", 
       " ", "\"\<sqrt{2n_{LL}^{cpx}}\>\""}], "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"\"\<5\\\\times10^{-11}\>\"", ",", 
       " ", "\"\<5\[Times]10^{-11}\>\""}], "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"\"\<(q_{\\\\rm LL}^2+(M^{\\\\rm q}_{\\\\rm LL})^2)^{-7/2}\>\"",
        ",", " ", "\"\<(q_{LL}^{2}+(M_{LL}^{q})^{2})^{-7/2}\>\""}], "}"}], ",",
      "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"\"\<\\\\mathbf e_p\>\"", ",", " ", "\"\<<bf:e>_{p}\>\""}], 
      "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"\"\<\\\\mathsf K^3_{\\\\rm LL}\>\"", ",", 
       " ", "\"\<<sf:K>_{LL}^{3}\>\""}], "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"\"\<\\\\bar\\\\Psi_{\\\\rm LL}\>\"", ",", 
       " ", "\"\<over{\[CapitalPsi]}{_}_{LL}\>\""}], "}"}], ",", "\n", "   ", 
     
     RowBox[{"{", 
      RowBox[{"\"\<\\\\lvert\\\\vec d_{\\\\rm LL}\\\\rvert^2\>\"", ",", 
       " ", "\"\<|over{d}{\[RightVector]}_{LL}|^{2}\>\""}], "}"}], ",", "\n", 
     "   ", 
     RowBox[{"{", 
      RowBox[{"\"\<\\\\sum_{p=0}^3\\\\xi^{\\\\rm LL}_p(\\\\mathbf \
b)\\\\mathbf e_p\>\"", ",", 
       " ", "\"\<\[Sum]_{p=0}^{3}\[Xi]_{p}^{LL}(<bf:b>)<bf:e>_{p}\>\""}], 
      "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"\"\<\\\\begin{pmatrix}0&-i\\\\\\\\i&0\\\\end{pmatrix}\>\"", ",",
        " ", "\"\<(grid[0&-i;i&0])\>\""}], "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"\"\<\\\\hbar\>\"", ",", " ", "\"\<\[HBar]\>\""}], "}"}], ",", 
     "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"\"\<x5,x6,x7\>\"", ",", " ", "\"\<x5,x6,x7\>\""}], "}"}]}], 
    "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"readings15", " ", "=", " ", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"SL31FormulaReading", "[", 
        RowBox[{"SL31TeXFormula", "[", 
         RowBox[{"First", "[", "#", "]"}], "]"}], "]"}], " ", "&"}], ",", " ",
       "cases15"}], "]"}]}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "every", " ", "formula", " ", "of", " ", "the", " ", "meanings", " ", "of",
     " ", "the", " ", "registry"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"meaningFormulas", " ", "=", " ", 
   RowBox[{"DeleteDuplicates", "[", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"SL31TextFormulas", "[", 
         RowBox[{"StringReplace", "[", 
          RowBox[{
           RowBox[{"#", "[", "\"\<meaning\>\"", "]"}], ",", " ", 
           RowBox[{"\"\<\\\\_\>\"", " ", "->", " ", "\"\<_\>\""}]}], "]"}], 
         "]"}], " ", "&"}], ",", " ", "SL31Registry"}], "]"}], "]"}], "]"}]}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{"problems15", " ", "=", " ", 
   RowBox[{"Flatten", "[", 
    RowBox[{"Map", "[", 
     RowBox[{"SL31TeXFormulaProblems", ",", " ", "meaningFormulas"}], "]"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"boxes15", " ", "=", " ", 
   RowBox[{"Map", "[", 
    RowBox[{"SL31TeXFormula", ",", " ", "meaningFormulas"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fractions15", " ", "=", " ", 
   RowBox[{"Cases", "[", 
    RowBox[{"boxes15", ",", " ", "_FractionBox", ",", " ", "Infinity"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"counts15", " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Total", "[", 
       RowBox[{"StringCount", "[", 
        RowBox[{"meaningFormulas", ",", " ", 
         RowBox[{
         "RegularExpression", "[", "\"\<\\\\\\\\[td]?frac(?![A-Za-z])\>\"", 
          "]"}]}], "]"}], "]"}], ",", " ", 
      RowBox[{"Length", "[", "fractions15", "]"}], ",", "\n", "   ", 
      RowBox[{"Total", "[", 
       RowBox[{"StringCount", "[", 
        RowBox[{"meaningFormulas", ",", " ", 
         RowBox[{
         "RegularExpression", "[", "\"\<\\\\\\\\sqrt(?![A-Za-z])\>\"", 
          "]"}]}], "]"}], "]"}], ",", " ", 
      RowBox[{"Count", "[", 
       RowBox[{"boxes15", ",", " ", 
        RowBox[{"_SqrtBox", " ", "|", " ", "_RadicalBox"}], ",", " ", 
        "Infinity"}], "]"}]}], "}"}]}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"a", " ", "name", " ", "and", " ", "a", " ", 
    RowBox[{"product", ":", " ", 
     RowBox[{
     "the", " ", "boxes", " ", "of", " ", "x5", " ", "and", " ", "of", " ", 
      "5", "x"}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"names15", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"SL31TeXFormula", "[", "\"\<x5\>\"", "]"}], " ", "===", " ", 
     RowBox[{"RowBox", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"StyleBox", "[", 
         RowBox[{"\"\<x\>\"", ",", " ", "\"\<TI\>\""}], "]"}], ",", 
        " ", "\"\<\[InvisibleSpace]\>\"", ",", " ", "\"\<5\>\""}], "}"}], 
      "]"}]}], " ", "&&", "\n", "   ", 
    RowBox[{
     RowBox[{"SL31TeXFormula", "[", "\"\<5x\>\"", "]"}], " ", "===", " ", 
     RowBox[{"RowBox", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<5\>\"", ",", " ", 
        RowBox[{"StyleBox", "[", 
         RowBox[{"\"\<x\>\"", ",", " ", "\"\<TI\>\""}], "]"}]}], "}"}], 
      "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-15\>\"", ",", 
    " ", "\"\<the reader of formulas reads 18 formulas of known reading \
correctly, converts every formula of the meanings of the registry without a \
problem, with one fraction box for every fraction command and one root box \
for every root command, and sets a number that directly follows a letter as \
part of a name (x5), not as a factor\>\"", ",", "\n", "  ", 
    RowBox[{
     RowBox[{"readings15", " ", "===", " ", 
      RowBox[{"cases15", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], " ", "&&", " ", 
     RowBox[{"problems15", " ", "===", " ", 
      RowBox[{"{", "}"}]}], " ", "&&", " ", 
     RowBox[{
      RowBox[{"counts15", "[", 
       RowBox[{"[", "1", "]"}], "]"}], " ", "==", " ", 
      RowBox[{"counts15", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], " ", "&&", " ", 
     RowBox[{
      RowBox[{"counts15", "[", 
       RowBox[{"[", "3", "]"}], "]"}], " ", "==", " ", 
      RowBox[{"counts15", "[", 
       RowBox[{"[", "4", "]"}], "]"}]}], " ", "&&", "\n", "   ", 
     RowBox[{"FreeQ", "[", 
      RowBox[{"fractions15", ",", " ", 
       RowBox[{
        RowBox[{"FractionBox", "[", 
         RowBox[{"\"\<\>\"", ",", " ", "_"}], "]"}], " ", "|", " ", 
        RowBox[{"FractionBox", "[", 
         RowBox[{"_", ",", " ", "\"\<\>\""}], "]"}]}]}], "]"}], " ", "&&", 
     " ", "names15"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Length", "[", "cases15", "]"}], ",", " ", 
      RowBox[{"Count", "[", 
       RowBox[{
        RowBox[{"MapThread", "[", 
         RowBox[{"SameQ", ",", " ", 
          RowBox[{"{", 
           RowBox[{"readings15", ",", " ", 
            RowBox[{"cases15", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], "}"}]}], "]"}], 
        ",", " ", "True"}], "]"}], ",", " ", 
      RowBox[{"Length", "[", "meaningFormulas", "]"}], ",", " ", 
      RowBox[{"Length", "[", "problems15", "]"}], ",", " ", "counts15", ",", 
      "\n", "   ", 
      RowBox[{"Count", "[", 
       RowBox[{
       "boxes15", ",", " ", "\"\<\[InvisibleSpace]\>\"", ",", " ", 
        "Infinity"}], "]"}]}], "}"}]}], "]"}], ";"}]}], "Input",ExpressionUUID\
->"2ac2457b-1146-4b38-8796-1a306aa6e655"],

Cell["I.8 The complete table of the symbols", "Section",ExpressionUUID->"b630adb6-661d-481b-8bfa-db1c0f437198"],

Cell["\<\
The table below shows every entry of the registry, group by group: the \
printed symbols (as the notebook now displays them), the plain-text names and \
the meaning. In the meanings the formulas are shown in their printed form, \
converted by the reader of formulas of section I.3, and the names of programs \
and of functions are set in the code typeface.\
\>", "Text",ExpressionUUID->"cee34490-162c-440b-ad5e-9949757c7b19"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "the", " ", "meaning", " ", "as", " ", "an", " ", "inline", " ", "text", " ", 
     RowBox[{"cell", ":", " ", 
      RowBox[{
      "the", " ", "formulas", " ", "between", " ", "dollar", " ", "signs", " ",
        "are", " ", "converted", " ", "by", " ", "the", "\n", "   ", "reader",
        " ", "of", " ", "formulas", " ", 
       RowBox[{"(", 
        RowBox[{"section", " ", "I", ".3"}], ")"}], " ", "and", " ", "the", " ",
        "code", " ", "between", " ", "backquotes", " ", "is", " ", "set", " ",
        "in", " ", "the", " ", "code", " ", "typeface"}]}]}], ";", "\n", 
    "   ", 
    RowBox[{
    "an", " ", "underscore", " ", "written", " ", "as", " ", "a", " ", 
     "backslash", " ", "and", " ", "an", " ", "underscore", " ", "in", " ", 
     "the", " ", "registry", " ", "is", " ", "an", " ", "underscore"}]}], " ",
    "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"textWithMath", "[", "t_String", "]"}], " ", ":=", " ", 
     RowBox[{"RawBoxes", "[", 
      RowBox[{"SL31TextBoxes", "[", 
       RowBox[{
        RowBox[{"StringReplace", "[", 
         RowBox[{"t", ",", " ", 
          RowBox[{"\"\<\\\\_\>\"", " ", "->", " ", "\"\<_\>\""}]}], "]"}], ",",
         " ", 
        RowBox[{"FontSize", " ", "->", " ", "9.5"}], ",", " ", 
        RowBox[{"FontFamily", " ", "->", " ", "\"\<Source Sans Pro\>\""}]}], 
       "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"one", " ", "row", " ", "of", " ", "the", " ", 
