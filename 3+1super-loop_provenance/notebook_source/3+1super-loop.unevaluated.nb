                    RowBox[{"Norm", "[", "rhs", "]"}]}], ")"}]}]}], 
                 "]"}]}]}]}], "]"}]}], ",", "\n", "    ", 
           RowBox[{"{", 
            RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
