                  RowBox[{"afAt", "[", 
                   RowBox[{"x", ",", " ", "q"}], "]"}]}], "]"}]}], ";", "\n", 
               "     ", 
               RowBox[{"lhs", " ", "=", " ", 
                RowBox[{"npq", " ", "-", " ", "nqp"}]}], ";", "\n", "     ", 
               RowBox[{"(*", " ", 
                RowBox[{
                 RowBox[{"R_pq", " ", "=", " ", 
                  RowBox[{
                   RowBox[{"d_p", " ", "Gamma_q"}], " ", "-", " ", 
                   RowBox[{"d_q", " ", "Gamma_p"}], " ", "+", " ", 
                   RowBox[{"[", 
                    RowBox[{"Gamma_p", ",", " ", "Gamma_q"}], "]"}]}]}], ";", 
                 " ", 
                 RowBox[{
                 "the", " ", "derivatives", " ", "are", " ", "exact", " ", 
                  RowBox[{"(", 
                   RowBox[{"the", " ", "fields", " ", "are", " ", "linear"}], 
                   ")"}]}]}], " ", "*)"}], "\n", "     ", 
               RowBox[{"dgq", " ", "=", " ", 
