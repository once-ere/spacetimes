                    RowBox[{"i", ",", " ", 
                    RowBox[{"p", " ", "+", " ", "1"}], ",", " ", 
                    RowBox[{"q", " ", "+", " ", "1"}]}], "]"}], "]"}], " ", "+",
                    " ", 
                   RowBox[{"Sum", "[", 
                    RowBox[{
                    RowBox[{"gv", " ", 
                    RowBox[{"t2eps3", "[", 
                    RowBox[{"i", ",", " ", "k3", ",", " ", "l3"}], "]"}], " ", 
                    RowBox[{"ap", "[", 
                    RowBox[{"[", "k3", "]"}], "]"}], " ", 
