            RowBox[{"fro", "[", 
             RowBox[{"sq", " ", "-", " ", "rhs"}], "]"}]}], "]"}]}], ";", 
         "\n", "   ", 
         RowBox[{"md", " ", "=", " ", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{"I", " ", 
             RowBox[{"kv", "[", 
              RowBox[{"[", 
               RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}], " ", 
