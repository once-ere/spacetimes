     RowBox[{
     "the", " ", "Weyl", " ", "isodoublet", " ", "of", " ", "a", " ", 
      "spinor", " ", "charge", " ", "y", " ", 
      RowBox[{"e4", ":", " ", 
       RowBox[{
        RowBox[{"psi", "'"}], 
        RowBox[{"(", "y", ")"}]}]}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"eps2", "^", 
       RowBox[{"-", "1"}]}], " ", "M_LL", 
      RowBox[{
       RowBox[{"(", "y", ")"}], "^", "T"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"rows", ":", " ", 
         RowBox[{"Weyl", " ", "index"}]}], ",", " ", 
        RowBox[{"columns", ":", " ", "isospin"}]}], ")"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2psiPrime", "[", "y_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"t2inv2", "[", "t2eps2", "]"}], " ", ".", " ", 
      RowBox[{"Transpose", "[", 
       RowBox[{"t2mq", "[", "y", "]"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "Dirac", " ", "isodoublet", " ", "of", " ", "two", " ", 
      "spinor", " ", 
      RowBox[{"charges", ":", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"components", " ", "1"}], ".."}], "4", " ", "are", " ", 
        "the", " ", "rows", " ", "of", " ", 
        RowBox[{"psi", "'"}], 
        RowBox[{"(", "y", ")"}]}]}]}], ",", " ", 
     RowBox[{
      RowBox[{"5", ".."}], "8", " ", "those", " ", "of", " ", 
      RowBox[{"psi", "'"}], 
      RowBox[{"(", "b", ")"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2diracFromCharges", "[", 
      RowBox[{"y_", ",", " ", "b_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{"t2psiPrime", "[", "y", "]"}], "]"}], ",", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{"t2psiPrime", "[", "b", "]"}], "]"}]}], "]"}]}], ";"}], "\n", 
   
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"the", " ", "Cayley"}], "-", 
      RowBox[{"Dickson", " ", "product", " ", 
       RowBox[{"(", 
        RowBox[{"a", " ", "+", " ", 
         RowBox[{"b", " ", "e4"}]}], ")"}], 
       RowBox[{"(", 
        RowBox[{"c", " ", "+", " ", 
         RowBox[{"d", " ", "e4"}]}], ")"}]}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"a", " ", "c"}], " ", "-", " ", 
        RowBox[{"conj", 
         RowBox[{"(", "d", ")"}], " ", "b"}]}], ")"}], " ", "+", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"d", " ", "a"}], " ", "+", " ", 
         RowBox[{"b", " ", "conj", 
          RowBox[{"(", "c", ")"}]}]}], ")"}], " ", "e4"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2bioctMul", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a_", ",", " ", "b_"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"cq_", ",", " ", "d_"}], "}"}]}], "]"}], " ", ":=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"t2bqMul", "[", 
         RowBox[{"a", ",", " ", "cq"}], "]"}], " ", "-", " ", 
        RowBox[{"t2bqMul", "[", 
         RowBox[{
          RowBox[{"t2bqConj", "[", "d", "]"}], ",", " ", "b"}], "]"}]}], ",", 
       " ", 
       RowBox[{
        RowBox[{"t2bqMul", "[", 
         RowBox[{"d", ",", " ", "a"}], "]"}], " ", "+", " ", 
        RowBox[{"t2bqMul", "[", 
         RowBox[{"b", ",", " ", 
          RowBox[{"t2bqConj", "[", "cq", "]"}]}], "]"}]}]}], "}"}]}], 
    ";"}]}]}]], "Input",ExpressionUUID->"51eba1b7-c734-4b3a-bf80-\
6475ac900621"],

Cell["\<\
The basic matrices, labelled with their registered symbols (they are exact: \
integers and the imaginary unit):\
\>", "Text",ExpressionUUID->"79662dff-276a-4c4f-b064-962ff0a3227c"],

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"{", "\n", "   ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SubsuperscriptBox["\[Sigma]", "0", "LL"], ",", " ", 
       RowBox[{"MatrixForm", "[", 
        RowBox[{"t2sigma", "[", "0", "]"}], "]"}], ",", " ", 
       SubsuperscriptBox["\[Sigma]", "1", "LL"], ",", " ", 
       RowBox[{"MatrixForm", "[", 
        RowBox[{"t2sigma", "[", "1", "]"}], "]"}], ",", "\n", "    ", 
       SubsuperscriptBox["\[Sigma]", "2", "LL"], ",", " ", 
       RowBox[{"MatrixForm", "[", 
        RowBox[{"t2sigma", "[", "2", "]"}], "]"}], ",", " ", 
       SubsuperscriptBox["\[Sigma]", "3", "LL"], ",", " ", 
       RowBox[{"MatrixForm", "[", 
        RowBox[{"t2sigma", "[", "3", "]"}], "]"}]}], "}"}], ",", "\n", "   ", 
     
     RowBox[{"{", 
      RowBox[{
       SubsuperscriptBox["\[Gamma]", "LL", "0"], ",", " ", 
       RowBox[{"MatrixForm", "[", 
        RowBox[{"t2gamma", "[", "0", "]"}], "]"}], ",", " ", 
       SubsuperscriptBox["\[Gamma]", "LL", "1"], ",", " ", 
       RowBox[{"MatrixForm", "[", 
        RowBox[{"t2gamma", "[", "1", "]"}], "]"}], ",", "\n", "    ", 
       SubsuperscriptBox["\[Gamma]", "LL", "2"], ",", " ", 
       RowBox[{"MatrixForm", "[", 
        RowBox[{"t2gamma", "[", "2", "]"}], "]"}], ",", " ", 
       SubsuperscriptBox["\[Gamma]", "LL", "3"], ",", " ", 
       RowBox[{"MatrixForm", "[", 
        RowBox[{"t2gamma", "[", "3", "]"}], "]"}]}], "}"}], ",", "\n", "   ", 
     
     RowBox[{"{", 
      RowBox[{
       SubsuperscriptBox["\[Gamma]", "LL", "ch"], ",", " ", 
       RowBox[{"MatrixForm", "[", "t2gammaCh", "]"}], ",", " ", 
       SubscriptBox["C", "LL"], ",", " ", 
       RowBox[{"MatrixForm", "[", "t2cconj", "]"}], ",", "\n", "    ", 
       SubscriptBox["\[Beta]", "LL"], ",", " ", 
       RowBox[{"MatrixForm", "[", "t2beta", "]"}], ",", " ", 
       SubscriptBox[
        TagBox[
         StyleBox["E",
          FontFamily->"Helvetica",
          FontSlant->"Plain"],
         "SL31SansSerif"], "LL"], ",", " ", 
       RowBox[{"MatrixForm", "[", "t2eps2", "]"}]}], "}"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"Spacings", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2"}], "}"}]}], ",", " ", 
   RowBox[{"Alignment", " ", "->", " ", "Center"}]}], "]"}]], "Input",Expressi\
onUUID->"c5c10699-bddf-4967-9d9d-293dfcfd5d9e"],

Cell["II.1.4 The lattice operator (t2core/src/lattice.rs)", "Subsection",ExpressionUUID->"44511b2d-f00f-49ec-a87b-3970f0a5515e"],

Cell[TextData[{
 "The solvers discretize space on a lattice of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["x",
      FontSlant->"Plain"]], "\[Times]", 
    SubsuperscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["y",
      FontSlant->"Plain"]], "\[Times]", 
    SubsuperscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["z",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9c2d9f7b-91ab-4d5f-a5ad-65bbcde21678"],
 " sites with the spacing ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[ScriptL]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["x",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e2d9341c-874d-4774-8d76-d017d10199b2"],
 " (called ell in the code). A site ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["s", "TI"], "\[RightVector]"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["s", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "1"], ",", 
      SubsuperscriptBox[
       StyleBox["s", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "2"], ",", 
      SubsuperscriptBox[
       StyleBox["s", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "73c23822-a2fd-48fb-a550-d1393a0873ab"],
 " has integer coordinates counted from 0, and the code gives it the number \
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["s", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], "+", 
    SubsuperscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["x",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["s", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "2"], "+", 
      SubsuperscriptBox[
       StyleBox["n", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["y",
        FontSlant->"Plain"]], 
      SubsuperscriptBox[
       StyleBox["s", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6ae88ba4-9adc-437a-a9bd-bb39e9f00f87"],
 "; ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    OverscriptBox["\[Delta]", "\[RightVector]"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "89f826c1-41f6-40fa-86b2-42467860b7df"],
 " is the step to the next site in the direction ",
 Cell[BoxData[
  FormBox[
   StyleBox["j", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "038cab1b-170b-4841-b9fa-dee674f3fe91"],
 ". On every site a mode has 16 complex components: the particle part ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Psi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b70fdbdb-a1e6-4dff-a9d9-614f048a9147"],
 " (8 components) and the hole part ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Psi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["h",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "992fdae6-8568-4a58-840d-ae7dce3af6a1"],
 " (8). The gauge fields live on the links: the link from ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox[
     StyleBox["s", "TI"], "\[RightVector]"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "568f4665-3318-4684-aaff-25ecd31cabd5"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["s", "TI"], "\[RightVector]"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "+", 
    SubsuperscriptBox[
     OverscriptBox["\[Delta]", "\[RightVector]"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["j", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "911fecc7-74c5-4b24-8600-baca3dd5cbcb"],
 " carries the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Times]", "2"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bd66befa-2350-4585-8ea7-4d15780b20bb"],
 " isospin matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["U",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["j", "TI"]}], 
     StyleBox["link",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["s", "TI"], "\[RightVector]"], 
      StyleBox["LL",
       FontSlant->"Plain"]], ")"}], "\[LongEqual]", 
    StyleBox["exp",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       StyleBox["i", "TI"]}], 
      SubsuperscriptBox["\[ScriptL]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["x",
        FontSlant->"Plain"]], 
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox[
         StyleBox["g", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], 
         StyleBox["v",
          FontSlant->"Plain"]], 
        SubscriptBox[
         StyleBox["a",
          FontFamily->"Helvetica",
          FontSlant->"Plain"], 
         RowBox[{
          StyleBox["LL",
           FontSlant->"Plain"], ",", 
          StyleBox["j", "TI"]}]], "+", 
        SubsuperscriptBox[
         StyleBox["g", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], 
         StyleBox["F",
          FontSlant->"Plain"]], 
        SubsuperscriptBox[
         StyleBox["A", "TI"], 
         RowBox[{
          StyleBox["LL",
           FontSlant->"Plain"], ",", 
          StyleBox["j", "TI"]}], 
         StyleBox["F",
          FontSlant->"Plain"]], 
        SubsuperscriptBox["\[Sigma]", "0", 
         StyleBox["LL",
          FontSlant->"Plain"]]}], ")"}]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0529ff3b-42c6-493d-a95a-d8cae1f9d2f9"],
 " with the isospin potential ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["a",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["j", "TI"]}]], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", "\[Iota]",
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["j", "TI"]}], "\[Iota]"], 
    SubsuperscriptBox["\[Tau]", "\[Iota]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "/", "2"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "efabb24f-94c5-4aac-80f6-1d791095ef9a"],
 ". Because ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       UnderscriptBox["\[Sum]", "\[Iota]",
        LimitsPositioning->True], "\[ThinSpace]", 
       SubsuperscriptBox[
        StyleBox["A", "TI"], 
        RowBox[{
         StyleBox["LL",
          FontSlant->"Plain"], ",", 
         StyleBox["j", "TI"]}], "\[Iota]"], 
       SubsuperscriptBox["\[Tau]", "\[Iota]", 
        StyleBox["LL",
         FontSlant->"Plain"]]}], ")"}], "2"], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      SubsuperscriptBox[
       OverscriptBox[
        StyleBox["A", "TI"], "\[RightVector]"], 
       RowBox[{
        StyleBox["LL",
         FontSlant->"Plain"], ",", 
        StyleBox["j", "TI"]}], 
       StyleBox["v",
        FontSlant->"Plain"]], "\[RightBracketingBar]"}], "2"], 
    SubsuperscriptBox["\[Sigma]", "0", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7ece8ae5-a7c9-4452-95a3-dd3da7edf318"],
 ", with the length ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftBracketingBar]", 
    SubsuperscriptBox[
     OverscriptBox[
      StyleBox["A", "TI"], "\[RightVector]"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["j", "TI"]}], 
     StyleBox["v",
      FontSlant->"Plain"]], "\[RightBracketingBar]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b83555ed-2145-483b-aea7-4b377c204351"],
 " of the isospin vector ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     OverscriptBox[
      StyleBox["A", "TI"], "\[RightVector]"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["j", "TI"]}], 
     StyleBox["v",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["A", "TI"], 
       RowBox[{
        StyleBox["LL",
         FontSlant->"Plain"], ",", 
        StyleBox["j", "TI"]}], "1"], ",", 
      SubsuperscriptBox[
       StyleBox["A", "TI"], 
       RowBox[{
        StyleBox["LL",
         FontSlant->"Plain"], ",", 
        StyleBox["j", "TI"]}], "2"], ",", 
      SubsuperscriptBox[
       StyleBox["A", "TI"], 
       RowBox[{
        StyleBox["LL",
         FontSlant->"Plain"], ",", 
        StyleBox["j", "TI"]}], "3"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "da693e4e-9eae-4f42-9b9e-1d1de65c7a79"],
 ", the exponential has the closed form ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      RowBox[{"-", 
       StyleBox["i", "TI"]}], 
      SubsuperscriptBox["\[ScriptL]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["x",
        FontSlant->"Plain"]], 
      SubsuperscriptBox[
       StyleBox["g", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["F",
        FontSlant->"Plain"]], 
      SubsuperscriptBox[
       StyleBox["A", "TI"], 
       RowBox[{
        StyleBox["LL",
         FontSlant->"Plain"], ",", 
        StyleBox["j", "TI"]}], 
       StyleBox["F",
        FontSlant->"Plain"]]}]], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["cos",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       RowBox[{
        FractionBox["1", "2"], 
        SubsuperscriptBox["\[ScriptL]", 
         StyleBox["LL",
          FontSlant->"Plain"], 
         StyleBox["x",
          FontSlant->"Plain"]], 
        SubsuperscriptBox[
         StyleBox["g", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], 
         StyleBox["v",
          FontSlant->"Plain"]], 
        RowBox[{"\[LeftBracketingBar]", 
         SubsuperscriptBox[
          OverscriptBox[
           StyleBox["A", "TI"], "\[RightVector]"], 
          RowBox[{
           StyleBox["LL",
            FontSlant->"Plain"], ",", 
           StyleBox["j", "TI"]}], 
          StyleBox["v",
           FontSlant->"Plain"]], "\[RightBracketingBar]"}]}], ")"}], 
      SubsuperscriptBox["\[Sigma]", "0", 
       StyleBox["LL",
        FontSlant->"Plain"]], "-", 
      StyleBox["i", "TI"], "\[ThinSpace]", 
      StyleBox["sin",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       RowBox[{
        FractionBox["1", "2"], 
        SubsuperscriptBox["\[ScriptL]", 
         StyleBox["LL",
          FontSlant->"Plain"], 
         StyleBox["x",
          FontSlant->"Plain"]], 
        SubsuperscriptBox[
         StyleBox["g", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], 
         StyleBox["v",
          FontSlant->"Plain"]], 
        RowBox[{"\[LeftBracketingBar]", 
         SubsuperscriptBox[
          OverscriptBox[
           StyleBox["A", "TI"], "\[RightVector]"], 
          RowBox[{
           StyleBox["LL",
            FontSlant->"Plain"], ",", 
           StyleBox["j", "TI"]}], 
          StyleBox["v",
           FontSlant->"Plain"]], "\[RightBracketingBar]"}]}], ")"}], "\[ThinSpace]", 
      UnderscriptBox["\[Sum]", "\[Iota]",
       LimitsPositioning->True], "\[ThinSpace]", 
      SubsuperscriptBox[
       StyleBox["A", "TI"], 
       RowBox[{
        StyleBox["LL",
         FontSlant->"Plain"], ",", 
        StyleBox["j", "TI"]}], "\[Iota]"], 
      SubsuperscriptBox["\[Tau]", "\[Iota]", 
       StyleBox["LL",
        FontSlant->"Plain"]], "/", 
      RowBox[{"\[LeftBracketingBar]", 
       SubsuperscriptBox[
        OverscriptBox[
         StyleBox["A", "TI"], "\[RightVector]"], 
        RowBox[{
         StyleBox["LL",
          FontSlant->"Plain"], ",", 
         StyleBox["j", "TI"]}], 
        StyleBox["v",
         FontSlant->"Plain"]], "\[RightBracketingBar]"}]}], ")"}]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3105148a-1b9a-4d06-a3cf-8885eb9fdf9f"],
 ", which ",
 StyleBox["t2link",
  FontFamily->"Source Code Pro"],
 " evaluates. The particle row of the lattice Dirac-Bogoliubov-de Gennes \
operator ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[ScriptCapitalH]",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["lat",
