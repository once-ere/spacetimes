                    RowBox[{"p", " ", "+", " ", "1"}]}], "]"}], "]"}], " ", "-",
                  " ", 
                 RowBox[{"f1", "[", 
                  RowBox[{"[", 
                   RowBox[{
                    RowBox[{"p", " ", "+", " ", "1"}], ",", " ", 
                    RowBox[{"q", " ", "+", " ", "1"}]}], "]"}], "]"}]}]}], ";",
                "\n", "     ", 
               RowBox[{"curv", " ", "=", " ", 
                RowBox[{
                 RowBox[{"t2lift4", "[", "rr", "]"}], " ", "-", " ", 
                 RowBox[{"I", " ", 
                  RowBox[{"gauge8", "[", 
                   RowBox[{
                   "gv", ",", " ", "gf", ",", " ", "fv", ",", " ", "ff"}], 
                   "]"}]}]}]}], ";", "\n", "     ", 
               RowBox[{"rhs", " ", "=", " ", 
                RowBox[{"curv", " ", ".", " ", "psi"}]}], ";", "\n", "     ", 
               
               RowBox[{"worst6", " ", "=", " ", 
                RowBox[{"Max", "[", 
                 RowBox[{"worst6", ",", " ", 
                  RowBox[{
