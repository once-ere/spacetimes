        RowBox[{"vv_", "?", "MatrixQ"}], ",", " ", 
        RowBox[{"rtol_", "?", "NumericQ"}], ",", " ", 
        RowBox[{"atol_", "?", "NumericQ"}]}], "]"}], "[", "sol_", "]"}], " ", 
     ":=", "\n", "  ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"grid", " ", "=", " ", 
          RowBox[{"Flatten", "[", 
           RowBox[{"sol", "[", "\"\<Grid\>\"", "]"}], "]"}]}], ",", " ", 
         RowBox[{"vals", " ", "=", " ", 
          RowBox[{"sol", "[", "\"\<ValuesOnGrid\>\"", "]"}]}], ",", " ", 
         RowBox[{"nc", " ", "=", " ", 
          RowBox[{"Length", "[", "ev", "]"}]}], ",", " ", "npts", ",", " ", 
         RowBox[{"ratio", " ", "=", " ", "0."}], ",", " ", 
         RowBox[{"emax", " ", "=", " ", "0."}], ",", " ", 
         RowBox[{"nmax", " ", "=", " ", "0."}], ",", " ", "idx", ",", " ", 
         "wgrid", ",", " ", "coef", ",", " ", "err", ",", " ", "nrm"}], "}"}],
        ",", "\n", "   ", 
       RowBox[{
        RowBox[{"npts", " ", "=", " ", 
         RowBox[{"Length", "[", "grid", "]"}]}], ";", "\n", "   ", 
        RowBox[{"Do", "[", "\n", "    ", 
         RowBox[{
          RowBox[{
           RowBox[{"idx", " ", "=", " ", 
            RowBox[{"Range", "[", 
             RowBox[{"first", ",", " ", 
              RowBox[{"Min", "[", 
               RowBox[{
                RowBox[{"first", " ", "+", " ", "2000"}], ",", " ", "npts"}], 
               "]"}]}], "]"}]}], ";", "\n", "    ", 
           RowBox[{"wgrid", " ", "=", " ", 
            RowBox[{
             RowBox[{"vals", "[", 
              RowBox[{"[", 
               RowBox[{"idx", ",", " ", 
                RowBox[{"1", " ", ";;", " ", "nc"}]}], "]"}], "]"}], " ", "+",
              " ", 
             RowBox[{"I", " ", 
              RowBox[{"vals", "[", 
               RowBox[{"[", 
                RowBox[{"idx", ",", " ", 
                 RowBox[{
                  RowBox[{"nc", " ", "+", " ", "1"}], " ", ";;", " ", 
                  RowBox[{"2", " ", "nc"}]}]}], "]"}], "]"}]}]}]}], ";", "\n",
            "    ", 
           RowBox[{"coef", " ", "=", " ", 
            RowBox[{"wgrid", " ", ".", " ", 
             RowBox[{"Conjugate", "[", "vv", "]"}]}]}], ";", "\n", "    ", 
           RowBox[{"err", " ", "=", " ", 
            RowBox[{"Map", "[", 
             RowBox[{"Norm", ",", " ", 
              RowBox[{
               RowBox[{"Rest", "[", "coef", "]"}], " ", "-", " ", 
               RowBox[{
                RowBox[{"Most", "[", "coef", "]"}], " ", 
                RowBox[{"Exp", "[", 
                 RowBox[{
                  RowBox[{"-", "I"}], " ", 
                  RowBox[{"Outer", "[", 
                   RowBox[{"Times", ",", " ", 
                    RowBox[{"Differences", "[", 
                    RowBox[{"grid", "[", 
                    RowBox[{"[", "idx", "]"}], "]"}], "]"}], ",", " ", "ev"}],
                    "]"}]}], "]"}]}]}]}], "]"}]}], ";", "\n", "    ", 
           RowBox[{"nrm", " ", "=", " ", 
            RowBox[{"Map", "[", 
             RowBox[{"Norm", ",", " ", "wgrid"}], "]"}]}], ";", "\n", "    ", 
           
           RowBox[{"ratio", " ", "=", " ", 
            RowBox[{"Max", "[", 
             RowBox[{"ratio", ",", " ", 
              RowBox[{"Max", "[", 
               RowBox[{"err", "/", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"rtol", " ", 
                   RowBox[{"Most", "[", "nrm", "]"}]}], " ", "+", " ", 
                  RowBox[{"atol", " ", 
                   RowBox[{"Sqrt", "[", 
                    RowBox[{"2.", " ", "nc"}], "]"}]}]}], ")"}]}], "]"}]}], 
             "]"}]}], ";", "\n", "    ", 
           RowBox[{"emax", " ", "=", " ", 
            RowBox[{"Max", "[", 
             RowBox[{"emax", ",", " ", 
              RowBox[{"Max", "[", "err", "]"}]}], "]"}]}], ";", "\n", "    ", 
           
           RowBox[{"nmax", " ", "=", " ", 
            RowBox[{"Max", "[", 
             RowBox[{"nmax", ",", " ", 
              RowBox[{"Max", "[", "nrm", "]"}]}], "]"}]}]}], ",", "\n", 
          "    ", 
          RowBox[{"{", 
           RowBox[{"first", ",", " ", "1", ",", " ", 
            RowBox[{"npts", " ", "-", " ", "1"}], ",", " ", "2000"}], "}"}]}],
          "]"}], ";", "\n", "   ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<largestRatio\>\"", " ", "->", " ", "ratio"}], ",", " ", 
          RowBox[{"\"\<largestLocalError\>\"", " ", "->", " ", "emax"}], ",", 
          " ", 
          RowBox[{"\"\<largestNorm\>\"", " ", "->", " ", "nmax"}]}], 
         "|>"}]}]}], "]"}]}], ";"}]}]}]], "Input",ExpressionUUID->"b3249477-\
d416-4202-a0eb-180d56f4012c"],

Cell[TextData[{
 "Check T2-IDA has two parts. Part (a) shows what the two tolerances mean, on \
the equation whose solution is the decaying exponential function ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["exp",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{"-", 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "0"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fc292a63-45f1-43d4-a6e4-a5ba885e6c3f"],
 " (the derivative of the unknown is minus the unknown, the initial value is \
1), integrated from 0 to 25 with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["tol",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox["10", 
     RowBox[{"-", "8"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a558ebfd-d8ee-42d0-bbb5-eb4ed0cd3c6d"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["tol",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox["10", 
     RowBox[{"-", "10"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c7591c76-50d3-4579-bb19-963737b523a6"],
 ". The solution falls from 1 to about ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "11"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "142a2922-c117-4b07-8f00-fda7e4881437"],
 ". While it is much larger than ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["tol",
      FontSlant->"Plain"]], "/", 
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["tol",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox["10", 
     RowBox[{"-", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "19ecf2e5-cfda-4c12-abff-593dbdba6ed9"],
 ", the tolerance of a step is ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["tol",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5985e92e-338d-40f5-bc3f-6d1abb57e321"],
 " times the modulus of the solution; when it is much smaller, the tolerance \
is ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["tol",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0dff3ccd-7e6b-45f2-b5cd-e5629f4f93a0"],
 ". The check requires that the exact local error of every internal step is \
at most the tolerance of the step, and that in each of the two regimes the \
largest ratio of the local error to the tolerance exceeds 1/128. The second \
requirement shows that the tolerances are the stated ones and not smaller \
ones: by its rule for the doubling of a step, IDA at the order 5 doubles the \
step as soon as its estimate falls below 1/128 of the tolerance. Part (b) \
tests ",
 StyleBox["t2evolveIDA",
  FontFamily->"Source Code Pro"],
 " and ",
 StyleBox["t2localErrorsIDA",
  FontFamily->"Source Code Pro"],
 " on a Hermitian ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Times]", "2"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "432e46e7-91f4-42f4-a54c-c7705c0a21c3"],
 " matrix, integrated from 0 to 10 with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["tol",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox["10", 
     RowBox[{"-", "10"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "146bb720-33c9-49f2-9fc2-9ec5087572c0"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["tol",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox["10", 
     RowBox[{"-", "12"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5f16f4e0-1707-4fcf-9587-700f5b3feb19"],
 " and compared at 21 output times with the solution by the matrix \
exponential (",
 StyleBox["MatrixExp",
  FontFamily->"Source Code Pro"],
 "): every ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Delta]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["loc",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b9e35825-4b0c-44be-939c-399c4cbe6136"],
 " is at most ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["loc",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "146e4ae0-e2eb-4dd7-b85b-78d8d5bcf261"],
 ", the largest deviation at the output times is at most ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["out",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f098deaa-9fab-4763-9f10-e89bc214814a"],
 ", and the states of ",
 StyleBox["NDSolve",
  FontFamily->"Source Code Pro"],
 " are the cubic Hermite polynomials of the stored values and derivatives \
(tolerance ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "12"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "642180a9-2707-4880-85d4-9391b5ebfac6"],
 ")."
}], "Text",ExpressionUUID->"a2f6fd74-d1d9-4025-b9ba-2642d5b6a568"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"T2", "-", 
      RowBox[{"IDA", " ", 
       RowBox[{"(", "a", ")"}]}]}], ":", " ", 
     RowBox[{
     "the", " ", "local", " ", "errors", " ", "that", " ", "IDA", " ", 
      "accepts", " ", "on", " ", "the", " ", "decaying", " ", 
      "exponential"}]}], ",", " ", 
    RowBox[{"rtol", " ", "=", " ", 
     RowBox[{
      RowBox[{"1", "e"}], "-", "8"}]}], ",", " ", 
    RowBox[{"atol", " ", "=", " ", 
     RowBox[{
      RowBox[{"1", "e"}], "-", "10"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rtolDecay", ",", " ", "atolDecay"}], "}"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"1.*^-8", ",", " ", "1.*^-10"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"solDecay", " ", "=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"yD", ",", " ", "tD"}], "}"}], ",", " ", 
       RowBox[{"NDSolveValue", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"yD", "'"}], "[", "tD", "]"}], " ", "==", " ", 
            RowBox[{"-", 
             RowBox[{"yD", "[", "tD", "]"}]}]}], ",", " ", 
           RowBox[{
            RowBox[{"yD", "[", "0", "]"}], " ", "==", " ", "1."}]}], "}"}], ",",
          " ", "yD", ",", " ", 
         RowBox[{"{", 
          RowBox[{"tD", ",", " ", "0", ",", " ", "25"}], "}"}], ",", " ", 
         RowBox[{"Method", " ", "->", " ", "\"\<IDA\>\""}], ",", "\n", 
         "     ", 
         RowBox[{"PrecisionGoal", " ", "->", " ", 
          RowBox[{"-", 
           RowBox[{"Log10", "[", "rtolDecay", "]"}]}]}], ",", " ", 
         RowBox[{"AccuracyGoal", " ", "->", " ", 
          RowBox[{"-", 
           RowBox[{"Log10", "[", "atolDecay", "]"}]}]}]}], "]"}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"gridDecay", " ", "=", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{"solDecay", "[", "\"\<Grid\>\"", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"valsDecay", " ", "=", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{"solDecay", "[", "\"\<ValuesOnGrid\>\"", "]"}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "exact", " ", "local", " ", "error", " ", "of", " ", "every",
       " ", 
      RowBox[{"step", ":", " ", 
       RowBox[{
       "the", " ", "computed", " ", "value", " ", "at", " ", "its", " ", 
        "end", " ", "minus", " ", "the", " ", "exact", " ", "solution", " ", 
        "from", " ", "the", " ", "computed", " ", "value", "\n", "   ", "at", 
        " ", "its", " ", "beginning"}]}]}], ";", " ", 
     RowBox[{
      RowBox[{
      "and", " ", "its", " ", "ratio", " ", "to", " ", "the", " ", 
       "tolerance", " ", "rtol"}], " ", "|", "value", "|", " ", 
      RowBox[{
       RowBox[{"+", " ", "atol"}], " ", "of", " ", "the", " ", "step"}]}]}], 
    " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"localDecay", " ", "=", " ", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"Rest", "[", "valsDecay", "]"}], " ", "-", " ", 
       RowBox[{
        RowBox[{"Most", "[", "valsDecay", "]"}], " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"-", 
          RowBox[{"Differences", "[", "gridDecay", "]"}]}], "]"}]}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ratioDecay", " ", "=", " ", 
     RowBox[{"localDecay", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"rtolDecay", " ", 
         RowBox[{"Abs", "[", 
          RowBox[{"Most", "[", "valsDecay", "]"}], "]"}]}], " ", "+", " ", 
        "atolDecay"}], ")"}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"the", " ", "two", " ", 
       RowBox[{"regimes", ":", " ", 
        RowBox[{"the", " ", "solution", " ", "above", " ", "100", " ", 
         RowBox[{"atol", "/", "rtol"}]}]}]}], " ", "=", " ", 
      RowBox[{
      "1", " ", "never", " ", "holds", " ", "after", " ", "the", " ", "start",
        " ", 
       RowBox[{"(", 
        RowBox[{
        "the", " ", "solution", " ", "is", " ", "at", " ", "most", " ", "1"}],
         ")"}]}]}], ",", " ", 
     RowBox[{
      RowBox[{
      "so", " ", "the", "\n", "   ", "relative", " ", "regime", " ", "is", " ",
        "taken", " ", "as", " ", "the", " ", "solution", " ", "above", " ", 
       "10", " ", 
       RowBox[{"atol", "/", "rtol"}]}], " ", "=", " ", "0.1"}], ",", " ", 
     RowBox[{
      RowBox[{
      "the", " ", "absolute", " ", "regime", " ", "as", " ", "the", " ", 
       "solution", " ", "below", "\n", "   ", 
       RowBox[{"atol", "/", 
        RowBox[{"(", 
         RowBox[{"10", " ", "rtol"}], ")"}]}]}], " ", "=", " ", "0.001"}]}], 
    " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"relDecay", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Pick", "[", 
       RowBox[{"ratioDecay", ",", " ", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#", " ", ">", " ", 
            RowBox[{"10", " ", 
             RowBox[{"atolDecay", "/", "rtolDecay"}]}]}], " ", "&"}], ",", 
          " ", 
          RowBox[{"Abs", "[", 
           RowBox[{"Most", "[", "valsDecay", "]"}], "]"}]}], "]"}]}], "]"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"absDecay", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Pick", "[", 
       RowBox[{"ratioDecay", ",", " ", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#", " ", "<", " ", 
            RowBox[{"atolDecay", "/", 
             RowBox[{"(", 
              RowBox[{"10", " ", "rtolDecay"}], ")"}]}]}], " ", "&"}], ",", 
          " ", 
          RowBox[{"Abs", "[", 
           RowBox[{"Most", "[", "valsDecay", "]"}], "]"}]}], "]"}]}], "]"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"T2", "-", 
      RowBox[{"IDA", " ", 
       RowBox[{"(", "b", ")"}]}]}], ":", " ", 
     RowBox[{
     "t2evolveIDA", " ", "on", " ", "a", " ", "Hermitian", " ", "2", " ", "x",
       " ", "2", " ", "matrix", " ", "against", " ", "the", " ", "matrix", " ",
       "exponential"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"hmTwo", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0.3", ",", " ", 
         RowBox[{"0.5", " ", "-", " ", 
          RowBox[{"0.2", " ", "I"}]}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"0.5", " ", "+", " ", 
          RowBox[{"0.2", " ", "I"}]}], ",", " ", 
         RowBox[{"-", "0.7"}]}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"w0Two", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"0.6", ",", " ", 
       RowBox[{"0.8", " ", "I"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"toutsTwo", " ", "=", " ", 
     RowBox[{"Range", "[", 
      RowBox[{"0.", ",", " ", "10.", ",", " ", "0.5"}], "]"}]}], ";"}], "\n", 
   
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"evTwo", ",", " ", "vvTwo"}], "}"}], " ", "=", " ", 
     RowBox[{"t2eigh", "[", "hmTwo", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rtolTwo", ",", " ", "atolTwo"}], "}"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"1.*^-10", ",", " ", "1.*^-12"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"runTwo", " ", "=", " ", 
     RowBox[{"t2evolveIDA", "[", 
      RowBox[{
      "hmTwo", ",", " ", "w0Two", ",", " ", "toutsTwo", ",", " ", "rtolTwo", ",",
        " ", "atolTwo", ",", " ", 
       RowBox[{"t2localErrorsIDA", "[", 
        RowBox[{
        "evTwo", ",", " ", "vvTwo", ",", " ", "rtolTwo", ",", " ", 
         "atolTwo"}], "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"devTwo", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Norm", "[", 
          RowBox[{"#1", " ", "-", " ", 
           RowBox[{
            RowBox[{"MatrixExp", "[", 
             RowBox[{
              RowBox[{"-", "I"}], " ", "hmTwo", " ", "#2"}], "]"}], " ", ".", 
            " ", "w0Two"}]}], "]"}], " ", "&"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"runTwo", "[", "\"\<states\>\"", "]"}], ",", " ", 
          "toutsTwo"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"blocTwo", " ", "=", " ", 
     RowBox[{
      RowBox[{"rtolTwo", " ", 
       RowBox[{"runTwo", "[", 
        RowBox[{"[", 
         RowBox[{"\"\<analysis\>\"", ",", " ", "\"\<largestNorm\>\""}], "]"}],
         "]"}]}], " ", "+", " ", 
      RowBox[{"atolTwo", " ", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"2.", " ", "2"}], "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"berrTwo", " ", "=", " ", 
     RowBox[{
      RowBox[{"runTwo", "[", "\"\<steps\>\"", "]"}], " ", "blocTwo"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"boutTwo", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", " ", "+", " ", 
         RowBox[{
          RowBox[{"runTwo", "[", "\"\<hmax\>\"", "]"}], " ", 
          RowBox[{
           RowBox[{"Max", "[", 
            RowBox[{"Abs", "[", "evTwo", "]"}], "]"}], "/", "4"}]}]}], ")"}], 
       " ", "berrTwo"}], " ", "+", " ", 
      RowBox[{
       RowBox[{"runTwo", "[", "\"\<hmax\>\"", "]"}], " ", 
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"runTwo", "[", "\"\<residualAt\>\"", "]"}], "]"}], "/", 
        "4"}]}], " ", "+", "\n", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"runTwo", "[", "\"\<hmax\>\"", "]"}], " ", 
           RowBox[{"Max", "[", 
            RowBox[{"Abs", "[", "evTwo", "]"}], "]"}]}], ")"}], "^", "4"}], "/",
         "384"}], " ", 
       RowBox[{"runTwo", "[", 
        RowBox[{"[", 
         RowBox[{"\"\<analysis\>\"", ",", " ", "\"\<largestNorm\>\""}], "]"}],
         "]"}]}]}]}], ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<T2-IDA\>\"", ",", 
     " ", "\"\<the integrator IDA of SUNDIALS, used through NDSolve with \
Method -> \\\"IDA\\\": (a) on the decaying exponential (rtol = 1e-8, atol = \
1e-10, x_LL^0 from 0 to 25) the exact local error of every internal step is \
at most the tolerance rtol |value| + atol of the step, and the largest ratio \
of the local error to this tolerance exceeds 1/128 both while the solution is \
above 10 atol/rtol and after it has fallen below atol/(10 rtol): the \
tolerances of IDA are 10^-PrecisionGoal and 10^-AccuracyGoal; (b) on a \
Hermitian 2 x 2 matrix (rtol = 1e-10, atol = 1e-12, 21 output times up to 10) \
every local error is at most budget_step = rtol (norm of the state) + atol \
sqrt(4), the largest deviation from the solution by MatrixExp is at most \
budget_out, and the states of NDSolve are the cubic Hermite polynomials of \
the stored values and derivatives (tolerance 1e-12)\>\"", ",", "\n", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"Max", "[", "ratioDecay", "]"}], " ", "<=", " ", "1"}], " ", "&&",
       " ", 
      RowBox[{"relDecay", " ", ">", " ", 
       RowBox[{"1", "/", "128"}]}], " ", "&&", " ", 
      RowBox[{"absDecay", " ", ">", " ", 
       RowBox[{"1", "/", "128"}]}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"runTwo", "[", 
        RowBox[{"[", 
         RowBox[{"\"\<analysis\>\"", ",", " ", "\"\<largestRatio\>\""}], 
         "]"}], "]"}], " ", "<=", " ", "1"}], " ", "&&", " ", 
      RowBox[{"devTwo", " ", "<=", " ", "boutTwo"}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"Max", "[", 
        RowBox[{"runTwo", "[", "\"\<hermiteAt\>\"", "]"}], "]"}], " ", "<", 
       " ", "1*^-12"}]}], ",", "\n", "  ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<(a) \>\"", ",", " ", 
        RowBox[{"Length", "[", "localDecay", "]"}], ",", 
        " ", "\"\< steps, largest ratio of a local error to its tolerance \
\>\"", ",", " ", 
        RowBox[{"NumberForm", "[", 
         RowBox[{
          RowBox[{"Max", "[", "ratioDecay", "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"4", ",", " ", "3"}], "}"}]}], "]"}], ",", 
        " ", "\"\< (relative regime \>\"", ",", " ", 
        RowBox[{"NumberForm", "[", 
         RowBox[{"relDecay", ",", " ", 
          RowBox[{"{", 
           RowBox[{"4", ",", " ", "3"}], "}"}]}], "]"}], ",", "\n", 
        "    ", "\"\<, absolute regime \>\"", ",", " ", 
        RowBox[{"NumberForm", "[", 
         RowBox[{"absDecay", ",", " ", 
          RowBox[{"{", 
           RowBox[{"4", ",", " ", "3"}], "}"}]}], "]"}], ",", 
        " ", "\"\<); (b) \>\"", ",", " ", 
        RowBox[{"runTwo", "[", "\"\<steps\>\"", "]"}], ",", 
        " ", "\"\< steps, \>\"", ",", " ", 
        RowBox[{"runTwo", "[", "\"\<evaluations\>\"", "]"}], ",", 
        " ", "\"\< evaluations, largest local_error/budget_step \>\"", ",", 
        "\n", "    ", 
        RowBox[{"NumberForm", "[", 
         RowBox[{
          RowBox[{"runTwo", "[", 
           RowBox[{"[", 
            RowBox[{"\"\<analysis\>\"", ",", " ", "\"\<largestRatio\>\""}], 
            "]"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"4", ",", " ", "3"}], "}"}]}], "]"}], ",", 
        " ", "\"\<, largest deviation \>\"", ",", " ", 
        RowBox[{"ScientificForm", "[", 
         RowBox[{"devTwo", ",", " ", "2"}], "]"}], ",", 
        " ", "\"\< <= budget_out \>\"", ",", " ", 
        RowBox[{"ScientificForm", "[", 
         RowBox[{"boutTwo", ",", " ", "2"}], "]"}], ",", "\n", 
        "    ", "\"\<, Hermite polynomials within \>\"", ",", " ", 
        RowBox[{"ScientificForm", "[", 
         RowBox[{
          RowBox[{"Max", "[", 
           RowBox[{"runTwo", "[", "\"\<hermiteAt\>\"", "]"}], "]"}], ",", " ",
           "2"}], "]"}]}], "}"}], "]"}]}], "]"}]}]}]], "Input",ExpressionUUID->\
"cfc96568-c663-4c5e-ae5a-34ce579c2c8d"],

Cell["\<\
II.2 Item [1]: the field equations on the 3+1 manifold, and the checks GS-1 \
to GS-16 (program t2_fields)\
\>", "Section",ExpressionUUID->"a41b69ea-0231-4bbe-8ab4-9c05b7c744fa"],

Cell[TextData[{
 "The program t2_fields (t2fields/src/main.rs) builds every matrix of the \
field equations of the self-interacting spinor field ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8df02b95-2cac-451a-b9cf-77ec32ca778b"],
 " on ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["\[DoubleStruckCapitalR]",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    RowBox[{"1", ",", "3"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e72c63e0-9031-4020-a0b9-c479a4bcf5c5"],
 " and checks every statement made about them: checks GS-1 to GS-16. The \
rewriting below keeps the order of the original program, because the random \
numbers are drawn in that order from one generator with the seed 2026111707. \
Every check prints one line with PASS or FAIL; the statement is that of the \
original report, and the numbers in the details are the Wolfram Language \
results, followed (where the original report gives them) by the values of the \
original report."
}], "Text",ExpressionUUID->"cb4cc167-7fc2-44ec-8020-43b540c862cd"],

Cell[TextData[{
 "The physics in brief. The covariant derivative is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Del]", 
     StyleBox["p", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubscriptBox["\[PartialD]", 
     StyleBox["p", "TI"]], "+", 
    SubsuperscriptBox["\[CapitalGamma]", 
     StyleBox["p", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "-", 
    StyleBox["i", "TI"], 
    SubscriptBox[
     StyleBox["A",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e6c1cc36-d87a-4fa1-87b8-201cef80c2ef"],
 ", with the spin connection ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalGamma]", 
     StyleBox["p", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["s",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["u",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["LL",
        FontSlant->"Plain"], ",", 
       StyleBox["p", "TI"]}], "\[Omega]"], ")"}], "\[CircleTimes]", 
    SubsuperscriptBox["\[Sigma]", "0", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "77f9f701-0f6c-46eb-ae5e-9ac9f9839c5d"],
 " (the Lorentz connection ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["u",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], "\[Omega]"], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", 
     StyleBox["j", "TI"],
     LimitsPositioning->True], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["\[Omega]", 
       RowBox[{
        StyleBox["LL",
         FontSlant->"Plain"], ",", 
        StyleBox["p", "TI"]}], 
       StyleBox["j", "TI"]], 
      SubsuperscriptBox[
       StyleBox["J", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["j", "TI"]], "+", 
      SubsuperscriptBox["\[CurlyPi]", 
       RowBox[{
        StyleBox["LL",
         FontSlant->"Plain"], ",", 
        StyleBox["p", "TI"]}], 
       StyleBox["j", "TI"]], 
      SubsuperscriptBox[
       StyleBox["K", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["j", "TI"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9c9156f0-2f89-42a7-937f-cfa385d9e4ad"],
 ", an element of the Lorentz algebra of the super-loop, acting on the Dirac \
index) and the gauge matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["A",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}]], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["v",
      FontSlant->"Plain"]], "\[ThinSpace]", 
    UnderscriptBox["\[Sum]", "\[Iota]",
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], "\[Iota]"], 
    SubsuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Iota]"], "+", 
    SubsuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["LL",
       FontSlant->"Plain"], ",", 
      StyleBox["p", "TI"]}], 
     StyleBox["F",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "8"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "508776b7-03e1-49a7-a23c-632ff64f5160"],
 " of the isospin group and of the fermion number. The mean-field \
(Dirac-Bogoliubov-de Gennes) equations couple the particle part ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Psi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "117004fc-c51c-4258-abaa-25d75edd40cd"],
 " and the hole part ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Psi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["h",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "28b3b761-f7a8-44db-8de2-0a7e796f83b7"],
 " of a mode through the pairing block ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["P",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", "\[Iota]",
     LimitsPositioning->True], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Iota]"], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["K",
        FontFamily->"Helvetica",
        FontSlant->"Plain"], 
       StyleBox["LL",
        FontSlant->"Plain"], "\[Iota]"], ")"}], "\[Dagger]"]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3725ba69-0198-4aa3-a491-7401d73e9a41"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["d", "TI"], "\[RightVector]"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["d", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "1"], ",", 
      SubsuperscriptBox[
       StyleBox["d", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "2"], ",", 
      SubsuperscriptBox[
       StyleBox["d", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "40777d4a-4341-48c8-bdd7-1f81cd59cdcb"],
 " is the order parameter."
}], "Text",ExpressionUUID->"e80adf52-b7b1-4cd2-9ad1-12a504840d8e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "the", " ", "seed", " ", "of", " ", "the", " ", "program", " ", 
    "t2_fields", " ", "and", " ", "the", " ", "tolerance", " ", "of", " ", 
    "the", " ", "exact", " ", "relations"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"t2Seed", "[", "2026111707", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"tol", " ", "=", " ", "1*^-12"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", "Frobenius", " ", "norm"}], ",", " ", 
     RowBox[{
     "the", " ", "name", " ", "used", " ", "in", " ", "the", " ", "Rust", " ",
       "code"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"fro", "[", "m_", "]"}], " ", ":=", " ", 
     RowBox[{"Norm", "[", 
      RowBox[{"m", ",", " ", "\"\<Frobenius\>\""}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "the", " ", "four", " ", "Dirac", " ", "matrices", " ", "of", " ", "the", 
     " ", "canonical", " ", "frame"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"t2gamma", "[", "p", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], 
    ";"}]}]}]], "Input",ExpressionUUID->"32438af8-65a6-4898-bacd-\
9a38ecfed263"],

Cell["GS-1 and GS-2: the Dirac matrices and the Lorentz generators", \
"Subsection",ExpressionUUID->"4411a144-93ef-41f5-bc97-1e78b960afba"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"GS", "-", "1"}], ":", " ", 
      RowBox[{"Clifford", " ", "relations", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"gamma", "^", "p"}], ",", " ", 
         RowBox[{"gamma", "^", "q"}]}], "}"}]}]}], " ", "=", " ", 
     RowBox[{"2", " ", 
      RowBox[{"eta", "^", "pq"}], " ", "1", "_", "4"}]}], ",", " ", 
    RowBox[{"and", " ", "the", " ", "forms", " ", "of", " ", "gamma_ch"}], ",",
     " ", "C", ",", " ", 
    RowBox[{"alpha", "^", "j"}], ",", " ", 
    RowBox[{"the", " ", "frame", " ", "and", " ", "eps2"}]}], " ", "*)"}], 
  "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"cliff", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"fro", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"g", "[", 
            RowBox[{"[", 
             RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}], " ", ".", " ", 
           RowBox[{"g", "[", 
            RowBox[{"[", 
             RowBox[{"q", " ", "+", " ", "1"}], "]"}], "]"}]}], " ", "+", " ", 
          RowBox[{
           RowBox[{"g", "[", 
            RowBox[{"[", 
             RowBox[{"q", " ", "+", " ", "1"}], "]"}], "]"}], " ", ".", " ", 
           RowBox[{"g", "[", 
            RowBox[{"[", 
             RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}]}], " ", "-", " ", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"p", " ", "==", " ", "q"}], ",", " ", 
             RowBox[{"2", " ", 
              RowBox[{"t2eta", "[", "p", "]"}]}], ",", " ", "0"}], "]"}], " ", 
           RowBox[{"IdentityMatrix", "[", "4", "]"}]}]}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"q", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}], "]"}]}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"gchOk", " ", "=", " ", 
     RowBox[{
      RowBox[{"fro", "[", 
       RowBox[{"t2gammaCh", " ", "-", " ", 
        RowBox[{"DiagonalMatrix", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", " ", 
           RowBox[{"-", "1"}], ",", " ", "1", ",", " ", "1"}], "}"}], "]"}]}],
        "]"}], " ", "<", " ", "tol"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"cOk", " ", "=", " ", 
     RowBox[{
      RowBox[{"fro", "[", 
       RowBox[{"t2cconj", " ", "-", " ", 
        RowBox[{"ArrayFlatten", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"t2eps2", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", 
             RowBox[{"-", "t2eps2"}]}], "}"}]}], "}"}], "]"}]}], "]"}], " ", "<",
       " ", "tol"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"alOk", " ", "=", " ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"Range", "[", "3", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"fro", "[", 
          RowBox[{
           RowBox[{"t2alpha", "[", "#", "]"}], " ", "-", " ", 
           RowBox[{"ArrayFlatten", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", 
                 RowBox[{"t2sigma", "[", "#", "]"}]}], ",", " ", "0"}], "}"}],
               ",", " ", 
              RowBox[{"{", 
               RowBox[{"0", ",", " ", 
                RowBox[{"t2sigma", "[", "#", "]"}]}], "}"}]}], "}"}], "]"}]}],
           "]"}], " ", "<", " ", "tol"}], " ", "&"}]}], "]"}]}], ";"}], "\n", 
   
   RowBox[{
    RowBox[{"frameOk", " ", "=", " ", 
     RowBox[{
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", " ", "3"}], "]"}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"fro", "[", 
            RowBox[{
             RowBox[{"t2mq", "[", 
              RowBox[{"t2canonicalFrame", "[", 
               RowBox[{"[", 
                RowBox[{"#", " ", "+", " ", "1"}], "]"}], "]"}], "]"}], " ", "-",
              " ", 
             RowBox[{"t2sigma", "[", "#", "]"}]}], "]"}], " ", "<", " ", 
           "tol"}], " ", "&&", "\n", "      ", 
          RowBox[{
           RowBox[{"fro", "[", 
            RowBox[{
             RowBox[{"t2mq", "[", 
              RowBox[{"t2bqConj", "[", 
               RowBox[{"t2canonicalFrame", "[", 
                RowBox[{"[", 
                 RowBox[{"#", " ", "+", " ", "1"}], "]"}], "]"}], "]"}], 
              "]"}], " ", "-", " ", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"#", " ", "==", " ", "0"}], ",", " ", "1", ",", " ", 
                RowBox[{"-", "1"}]}], "]"}], " ", 
              RowBox[{"t2sigma", "[", "#", "]"}]}]}], "]"}], " ", "<", " ", 
           "tol"}]}], " ", "&"}]}], "]"}], " ", "&&", "\n", "   ", 
      RowBox[{
       RowBox[{"fro", "[", 
        RowBox[{
         RowBox[{"t2mq", "[", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "0", ",", " ", 
            RowBox[{"-", "1"}], ",", " ", "0"}], "}"}], "]"}], " ", "-", " ", 
         "t2eps2"}], "]"}], " ", "<", " ", "tol"}]}]}], ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<GS-1\>\"", ",", 
     " ", "\"\<the Dirac matrices are built from the frame of R^(1,3)_LL; \
Clifford relations; gamma_ch = diag(-1,-1,1,1), C_LL = diag(eps2, -eps2), \
alpha^j = diag(-sigma_j, sigma_j), eps2 = M_LL(-e2)\>\"", ",", "\n", "  ", 
     RowBox[{
      RowBox[{"cliff", " ", "<", " ", "tol"}], " ", "&&", " ", "gchOk", " ", "&&",
       " ", "cOk", " ", "&&", " ", "alOk", " ", "&&", " ", "frameOk"}], ",", 
     " ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<largest deviation of the Clifford relations \>\"", ",", 
        " ", "cliff", ",", " ", "\"\< (original: 0.0e0)\>\""}], "}"}], 
      "]"}]}], "]"}]}]}]], "Input",ExpressionUUID->"8b9b8038-0d97-467d-b57f-\
7ab7975dad12"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"GS", "-", "2"}], ":", " ", 
     RowBox[{"the", " ", "Lorentz", " ", "generators", " ", "sgen", 
      RowBox[{"(", 
       RowBox[{"J", "^", "j"}], ")"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"sgen", 
      RowBox[{"(", 
       RowBox[{"K", "^", "j"}], ")"}]}], ";", " ", 
     RowBox[{"the", " ", "27", " ", "relations", " ", "of", " ", "so", 
      RowBox[{"(", 
       RowBox[{"3", ",", "1"}], ")"}]}], ";", " ", 
     RowBox[{"the", " ", "24", " ", "intertwining", " ", "relations"}]}]}], 
   " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"sj", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"t2spinGen", "[", 
        RowBox[{"t2jgen", "[", "j", "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sk", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"t2spinGen", "[", 
        RowBox[{"t2kgen", "[", "j", "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"comm", "[", 
      RowBox[{"a_", ",", " ", "b_"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"a", " ", ".", " ", "b"}], " ", "-", " ", 
      RowBox[{"b", " ", ".", " ", "a"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"genOk", " ", "=", " ", 
     RowBox[{"And", " ", "@@", " ", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"k", " ", "=", " ", 
              RowBox[{
               RowBox[{"Mod", "[", 
                RowBox[{"j", ",", " ", "3"}], "]"}], " ", "+", " ", "1"}]}], ",",
              " ", 
             RowBox[{"l", " ", "=", " ", 
              RowBox[{
               RowBox[{"Mod", "[", 
                RowBox[{
                 RowBox[{"j", " ", "+", " ", "1"}], ",", " ", "3"}], "]"}], 
               " ", "+", " ", "1"}]}]}], "}"}], ",", "\n", "      ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"fro", "[", 
               RowBox[{
                RowBox[{"sj", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], " ", "-", " ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"g", "[", 
                   RowBox[{"[", 
                    RowBox[{"k", " ", "+", " ", "1"}], "]"}], "]"}], " ", ".",
                   " ", 
                  RowBox[{"g", "[", 
                   RowBox[{"[", 
                    RowBox[{"l", " ", "+", " ", "1"}], "]"}], "]"}]}], "/", 
                 "2"}]}], "]"}], " ", "<", " ", "tol"}], ",", " ", 
             RowBox[{
              RowBox[{"fro", "[", 
               RowBox[{
                RowBox[{"sk", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], " ", "-", " ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"g", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], " ", ".", " ", 
                  RowBox[{"g", "[", 
                   RowBox[{"[", 
                    RowBox[{"j", " ", "+", " ", "1"}], "]"}], "]"}]}], "/", 
                 "2"}]}], "]"}], " ", "<", " ", "tol"}], ",", "\n", "       ", 
             RowBox[{
              RowBox[{"fro", "[", 
               RowBox[{
                RowBox[{"sj", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], " ", "-", " ", 
                RowBox[{"ArrayFlatten", "[", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"-", "I"}], "/", "2"}], " ", 
                    RowBox[{"t2sigma", "[", "j", "]"}]}], ",", " ", "0"}], 
                    "}"}], ",", " ", 
                   RowBox[{"{", 
                    RowBox[{"0", ",", " ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"-", "I"}], "/", "2"}], " ", 
                    RowBox[{"t2sigma", "[", "j", "]"}]}]}], "}"}]}], "}"}], 
                 "]"}]}], "]"}], " ", "<", " ", "tol"}], ",", "\n", "       ", 
             RowBox[{
              RowBox[{"fro", "[", 
               RowBox[{
                RowBox[{"sk", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], " ", "-", " ", 
                RowBox[{"ArrayFlatten", "[", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"-", "1"}], "/", "2"}], " ", 
                    RowBox[{"t2sigma", "[", "j", "]"}]}], ",", " ", "0"}], 
                    "}"}], ",", " ", 
                   RowBox[{"{", 
                    RowBox[{"0", ",", " ", 
                    RowBox[{
                    RowBox[{"1", "/", "2"}], " ", 
                    RowBox[{"t2sigma", "[", "j", "]"}]}]}], "}"}]}], "}"}], 
                 "]"}]}], "]"}], " ", "<", " ", "tol"}]}], "}"}]}], "]"}], ",",
          " ", 
         RowBox[{"{", 
          RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rel", " ", "=", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"lj", " ", "=", " ", 
             RowBox[{"Sum", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"t2eps3", "[", 
                 RowBox[{"a", ",", " ", "b", ",", " ", "c"}], "]"}], " ", 
                RowBox[{"sj", "[", 
                 RowBox[{"[", "c", "]"}], "]"}]}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"c", ",", " ", "3"}], "}"}]}], "]"}]}], ",", " ", 
            RowBox[{"lk", " ", "=", " ", 
             RowBox[{"Sum", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"t2eps3", "[", 
                 RowBox[{"a", ",", " ", "b", ",", " ", "c"}], "]"}], " ", 
                RowBox[{"sk", "[", 
                 RowBox[{"[", "c", "]"}], "]"}]}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"c", ",", " ", "3"}], "}"}]}], "]"}]}]}], "}"}], ",", 
          "\n", "      ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"fro", "[", 
              RowBox[{
               RowBox[{"comm", "[", 
                RowBox[{
                 RowBox[{"sj", "[", 
                  RowBox[{"[", "a", "]"}], "]"}], ",", " ", 
                 RowBox[{"sj", "[", 
                  RowBox[{"[", "b", "]"}], "]"}]}], "]"}], " ", "-", " ", 
               "lj"}], "]"}], " ", "<", " ", "tol"}], ",", " ", 
            RowBox[{
             RowBox[{"fro", "[", 
              RowBox[{
               RowBox[{"comm", "[", 
                RowBox[{
                 RowBox[{"sj", "[", 
                  RowBox[{"[", "a", "]"}], "]"}], ",", " ", 
                 RowBox[{"sk", "[", 
                  RowBox[{"[", "b", "]"}], "]"}]}], "]"}], " ", "-", " ", 
               "lk"}], "]"}], " ", "<", " ", "tol"}], ",", " ", 
            RowBox[{
             RowBox[{"fro", "[", 
              RowBox[{
               RowBox[{"comm", "[", 
                RowBox[{
                 RowBox[{"sk", "[", 
                  RowBox[{"[", "a", "]"}], "]"}], ",", " ", 
                 RowBox[{"sk", "[", 
                  RowBox[{"[", "b", "]"}], "]"}]}], "]"}], " ", "+", " ", 
               "lj"}], "]"}], " ", "<", " ", "tol"}]}], "}"}]}], "]"}], ",", 
        " ", 
        RowBox[{"{", 
         RowBox[{"a", ",", " ", "3"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"b", ",", " ", "3"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"intertw", " ", "=", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"s", " ", "=", " ", 
             RowBox[{"t2spinGen", "[", "u", "]"}]}], ",", " ", 
            RowBox[{"v", " ", "=", " ", 
             RowBox[{"t2vecAction", "[", "u", "]"}]}]}], "}"}], ",", "\n", 
          "      ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"fro", "[", 
              RowBox[{
               RowBox[{"comm", "[", 
                RowBox[{
                 RowBox[{"g", "[", 
                  RowBox[{"[", 
                   RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}], ",", " ", 
                 "s"}], "]"}], " ", "-", " ", 
               RowBox[{"Sum", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"v", "[", 
                   RowBox[{"[", 
                    RowBox[{
                    RowBox[{"p", " ", "+", " ", "1"}], ",", " ", 
                    RowBox[{"q", " ", "+", " ", "1"}]}], "]"}], "]"}], " ", 
                  RowBox[{"g", "[", 
                   RowBox[{"[", 
                    RowBox[{"q", " ", "+", " ", "1"}], "]"}], "]"}]}], ",", 
                 " ", 
                 RowBox[{"{", 
                  RowBox[{"q", ",", " ", "0", ",", " ", "3"}], "}"}]}], 
                "]"}]}], "]"}], " ", "<", " ", "tol"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], 
         "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"j", ",", " ", "3"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"u", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"t2jgen", "[", "j", "]"}], ",", " ", 
            RowBox[{"t2kgen", "[", "j", "]"}]}], "}"}]}], "}"}]}], "]"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<GS-2\>\"", ",", 
     " ", "\"\<the Lorentz generators of the super-loop on the Dirac spinor, \
sgen(J^j) = diag(-i sigma_j/2, -i sigma_j/2) = gamma^j' gamma^j''/2, \
sgen(K^j) = diag(-sigma_j/2, sigma_j/2) = gamma^0 gamma^j/2; the 27 relations \
of so(3,1); 24 intertwining relations [gamma^p, sgen(u)] = sum V(u)[p][q] \
gamma^q\>\"", ",", "\n", "  ", 
     RowBox[{"genOk", " ", "&&", " ", 
      RowBox[{"(", 
       RowBox[{"And", " ", "@@", " ", "rel"}], ")"}], " ", "&&", " ", 
      RowBox[{"(", 
       RowBox[{"And", " ", "@@", " ", "intertw"}], ")"}]}], ",", " ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Length", "[", "rel", "]"}], ",", 
        " ", "\"\< commutation relations, \>\"", ",", " ", 
        RowBox[{"Length", "[", "intertw", "]"}], ",", 
        " ", "\"\< intertwining relations (original: 27 and 24)\>\""}], "}"}],
       "]"}]}], "]"}]}]}]], "Input",ExpressionUUID->"1c80df09-ff81-475a-b54e-\
b9f271d30d1c"],

Cell["\<\
GS-3 and GS-4: finite transformations, isospin and the pair matrices\
\>", "Subsection",ExpressionUUID->"a8035de4-086f-4abc-90f4-03267f2cd628"],

Cell[TextData[{
 "GS-3 is the change of representation of the gauge group ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SL", "TI"], 
    RowBox[{"(", 
     RowBox[{"2", ",", 
      StyleBox["\[DoubleStruckCapitalC]",
       FontSlant->"Plain"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "350ea037-0aba-4690-8d97-39cfd973abe2"],
 ": for a unit bi-quaternion ",
 Cell[BoxData[
  FormBox[
   StyleBox["g",
    FontWeight->"Bold",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b9e449f9-93d1-4d4e-9c7d-8c934f44975a"],
 " the spinor matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["S",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[LongEqual]", 
    StyleBox["diag",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      RowBox[{"(", 
       OverscriptBox[
        StyleBox["g",
         FontWeight->"Bold",
         FontSlant->"Plain"], "~"], ")"}], ",", 
      SubscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      RowBox[{"(", 
       StyleBox["g",
        FontWeight->"Bold",
        FontSlant->"Plain"], ")"}]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6f354d6d-93bd-47de-bac7-7803146c8f78"],
 ", with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], "~"], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      SuperscriptBox[
       StyleBox["g",
        FontWeight->"Bold",
        FontSlant->"Plain"], "\[Dagger]"], ")"}], 
     RowBox[{"-", "1"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "21010e69-8c51-4a21-ae10-14937b08edd9"],
 " and so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     OverscriptBox[
      StyleBox["g",
       FontWeight->"Bold",
       FontSlant->"Plain"], "~"], ")"}], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["M", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"]], 
       SuperscriptBox[
        RowBox[{"(", 
         StyleBox["g",
          FontWeight->"Bold",
          FontSlant->"Plain"], ")"}], "\[Dagger]"]}], ")"}], 
     RowBox[{"-", "1"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3e721505-1030-498c-851c-ad1800c7b4d4"],
 ", satisfies ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["S",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      StyleBox["g",
       FontWeight->"Bold",
       FontSlant->"Plain"], ")"}], 
     RowBox[{"-", "1"}]], 
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p", "TI"]], 
    SubscriptBox[
     StyleBox["S",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", 
     SuperscriptBox[
      StyleBox["p", "TI"], "\[Prime]"],
     LimitsPositioning->True], 
    SubscriptBox[
     RowBox[{"[", 
      RowBox[{
       SubscriptBox[
        StyleBox["L",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["LL",
         FontSlant->"Plain"]], 
       RowBox[{"(", 
        StyleBox["g",
         FontWeight->"Bold",
         FontSlant->"Plain"], ")"}]}], "]"}], 
     RowBox[{
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], 
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     SuperscriptBox[
      StyleBox["p", "TI"], "\[Prime]"]]}], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "cebb7551-5834-4363-a251-1c47dd624a77"],
 " with the real Lorentz matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"[", 
      RowBox[{
       SubscriptBox[
        StyleBox["L",
         FontFamily->"Helvetica",
         FontSlant->"Plain"], 
        StyleBox["LL",
         FontSlant->"Plain"]], 
       RowBox[{"(", 
        StyleBox["g",
         FontWeight->"Bold",
         FontSlant->"Plain"], ")"}]}], "]"}], 
     RowBox[{
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}]], "\[LongEqual]", 
    FractionBox["1", "2"], 
    StyleBox["Re",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["\[Sigma]", 
       StyleBox["p", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      SubscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      RowBox[{"(", 
       StyleBox["g",
        FontWeight->"Bold",
        FontSlant->"Plain"], ")"}], 
      SubsuperscriptBox["\[Sigma]", 
       SuperscriptBox[
        StyleBox["p", "TI"], "\[Prime]"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      SubscriptBox[
       StyleBox["M", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      SuperscriptBox[
       RowBox[{"(", 
        StyleBox["g",
         FontWeight->"Bold",
         FontSlant->"Plain"], ")"}], "\[Dagger]"]}], ")"}]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "465106e3-7f83-44c8-8e89-1e1c37d0f197"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["S",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p", "TI"]], 
    RowBox[{"[", 
     StyleBox["f",
      FontWeight->"Bold",
      FontSlant->"Plain"], "]"}], 
    SubscriptBox[
     StyleBox["S",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", 
      StyleBox["g",
       FontWeight->"Bold",
       FontSlant->"Plain"], ")"}], 
     RowBox[{"-", "1"}]], "\[LongEqual]", 
    SubsuperscriptBox["\[Gamma]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["p", "TI"]], 
    RowBox[{"[", 
     RowBox[{
      OverscriptBox[
       StyleBox["g",
        FontWeight->"Bold",
        FontSlant->"Plain"], "~"], 
      StyleBox["f",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      SuperscriptBox[
       OverscriptBox[
        StyleBox["g",
         FontWeight->"Bold",
         FontSlant->"Plain"], "~"], "\[Dagger]"]}], "]"}]}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0c8fa830-589d-4e91-a673-1ebc73d8aabc"],
 " for random Hermitian frames ",
 Cell[BoxData[
  FormBox[
   StyleBox["f",
    FontWeight->"Bold",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9ceb1b4e-77e6-4152-a099-74faf4fd23dd"],
 ". GS-4 checks the isospin algebra, the antisymmetry and the invariance of \
the pair matrices ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "\[Iota]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0504f324-adc5-4d61-a2de-2c6de9737e49"],
 ", and that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["T", "TI"]], 
    SubsuperscriptBox[
     StyleBox["K",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[Iota]"], 
    SubscriptBox["\[CapitalPsi]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9fda3559-04a0-4f65-a4c4-3683594b8a74"],
 " for a commuting (c-number) spinor, for which the antisymmetric matrix \
gives zero."
}], "Text",ExpressionUUID->"d98f1485-17b6-49c6-97e9-cee606a9fc30"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"GS", "-", "3"}], ":", " ", 
      RowBox[{
       RowBox[{"200", " ", "random", " ", "unit", " ", "bi"}], "-", 
       "quaternions"}]}], ";", " ", 
     RowBox[{"for", " ", "each"}]}], ",", " ", 
    RowBox[{"a", " ", "random", " ", "Hermitian", " ", "frame", " ", 
     RowBox[{"(", 
      RowBox[{
      "the", " ", "random", " ", "numbers", " ", "in", " ", "the", " ", 
       "order", " ", "of", " ", "t2_fields"}], ")"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"worst3", " ", "=", " ", "0."}], ";", " ", 
    RowBox[{"worst3b", " ", "=", " ", "0."}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "mg", ",", " ", "s4", ",", " ", "s4i", ",", " ", "l", ",", " ", "f", 
          ",", " ", "gf", ",", " ", "mgt", ",", " ", "f2", ",", " ", "gf2"}], 
         "}"}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{"mg", " ", "=", " ", 
          RowBox[{"t2randSL2C", "[", "]"}]}], ";", "\n", "   ", 
         RowBox[{"s4", " ", "=", " ", 
          RowBox[{"t2spinRep", "[", "mg", "]"}]}], ";", "\n", "   ", 
         RowBox[{"s4i", " ", "=", " ", 
          RowBox[{"ArrayFlatten", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"ConjugateTranspose", "[", "mg", "]"}], ",", " ", 
               "0"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"0", ",", " ", 
               RowBox[{"t2inv2", "[", "mg", "]"}]}], "}"}]}], "}"}], "]"}]}], 
         ";", "\n", "   ", 
         RowBox[{"worst3", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"worst3", ",", " ", 
            RowBox[{"fro", "[", 
             RowBox[{
              RowBox[{"s4", " ", ".", " ", "s4i"}], " ", "-", " ", 
              RowBox[{"IdentityMatrix", "[", "4", "]"}]}], "]"}]}], "]"}]}], ";",
          "\n", "   ", 
         RowBox[{"l", " ", "=", " ", 
          RowBox[{"t2lmat", "[", "mg", "]"}]}], ";", "\n", "   ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{"worst3", " ", "=", " ", 
            RowBox[{"Max", "[", 
             RowBox[{"worst3", ",", " ", 
              RowBox[{"fro", "[", 
               RowBox[{
                RowBox[{"s4i", " ", ".", " ", 
                 RowBox[{"g", "[", 
                  RowBox[{"[", 
                   RowBox[{"p", " ", "+", " ", "1"}], "]"}], "]"}], " ", ".", 
                 " ", "s4"}], " ", "-", " ", 
                RowBox[{"Sum", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"l", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"p", " ", "+", " ", "1"}], ",", " ", 
                    RowBox[{"q", " ", "+", " ", "1"}]}], "]"}], "]"}], " ", 
                   RowBox[{"g", "[", 
                    RowBox[{"[", 
                    RowBox[{"q", " ", "+", " ", "1"}], "]"}], "]"}]}], ",", 
                  " ", 
                  RowBox[{"{", 
                   RowBox[{"q", ",", " ", "0", ",", " ", "3"}], "}"}]}], 
                 "]"}]}], "]"}]}], "]"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}], ";", 
         "\n", "   ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"the", " ", "frame", " ", "f_p"}], " ", "=", " ", 
            RowBox[{
             RowBox[{"x0", " ", "e0"}], " ", "+", " ", 
             RowBox[{"i", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"x1", " ", "e1"}], " ", "+", " ", 
                RowBox[{"x2", " ", "e2"}], " ", "+", " ", 
                RowBox[{"x3", " ", "e3"}]}], ")"}]}]}]}], ",", " ", 
           RowBox[{
           "real", " ", "x", " ", "drawn", " ", "p", " ", "by", " ", "p"}]}], 
          " ", "*)"}], "\n", "   ", 
         RowBox[{"f", " ", "=", " ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Module", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"x0", " ", "=", " ", 
                RowBox[{"t2Unit", "[", "]"}]}], "}"}], ",", " ", 
              RowBox[{"Prepend", "[", 
               RowBox[{
                RowBox[{"Table", "[", 
                 RowBox[{
                  RowBox[{"I", " ", 
                   RowBox[{"t2Unit", "[", "]"}]}], ",", " ", 
                  RowBox[{"{", "3", "}"}]}], "]"}], ",", " ", "x0"}], "]"}]}],
              "]"}], ",", " ", 
            RowBox[{"{", "4", "}"}]}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"gf", " ", "=", " ", 
          RowBox[{"t2gammasFromFrame", "[", "f", "]"}]}], ";", "\n", "   ", 
         RowBox[{"mgt", " ", "=", " ", 
          RowBox[{"t2inv2", "[", 
           RowBox[{"ConjugateTranspose", "[", "mg", "]"}], "]"}]}], ";", "\n",
          "   ", 
         RowBox[{"f2", " ", "=", " ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"With", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"x", " ", "=", " ", 
                RowBox[{"t2coords", "[", 
                 RowBox[{"mgt", " ", ".", " ", 
                  RowBox[{"t2mq", "[", 
                   RowBox[{"f", "[", 
                    RowBox[{"[", "p", "]"}], "]"}], "]"}], " ", ".", " ", 
                  RowBox[{"ConjugateTranspose", "[", "mgt", "]"}]}], "]"}]}], 
               "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"x", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
                RowBox[{"I", " ", 
                 RowBox[{"x", "[", 
                  RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", 
                RowBox[{"I", " ", 
                 RowBox[{"x", "[", 
                  RowBox[{"[", "3", "]"}], "]"}]}], ",", " ", 
                RowBox[{"I", " ", 
                 RowBox[{"x", "[", 
                  RowBox[{"[", "4", "]"}], "]"}]}]}], "}"}]}], "]"}], ",", 
            " ", 
            RowBox[{"{", 
             RowBox[{"p", ",", " ", "4"}], "}"}]}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"gf2", " ", "=", " ", 
          RowBox[{"t2gammasFromFrame", "[", "f2", "]"}]}], ";", "\n", "   ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{"worst3b", " ", "=", " ", 
            RowBox[{"Max", "[", 
             RowBox[{"worst3b", ",", " ", 
              RowBox[{"fro", "[", 
               RowBox[{
                RowBox[{"s4", " ", ".", " ", 
                 RowBox[{"gf", "[", 
                  RowBox[{"[", "p", "]"}], "]"}], " ", ".", " ", "s4i"}], " ",
                 "-", " ", 
                RowBox[{"gf2", "[", 
                 RowBox[{"[", "p", "]"}], "]"}]}], "]"}]}], "]"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"p", ",", " ", "4"}], "}"}]}], "]"}]}]}], "]"}], ",", 
      "\n", "  ", 
      RowBox[{"{", "200", "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<GS-3\>\"", ",", 
     " ", "\"\<the gauge group SL(2,C) as a change of representation: \
Sspin^-1 gamma^p Sspin = sum Lmat[p][q] gamma^q and Sspin gamma^p[f] Sspin^-1 \
= gamma^p[gLt f gLt^dag] for 200 random gL and random Hermitian frames \
(tolerance 1e-10)\>\"", ",", "\n", "  ", 
     RowBox[{
      RowBox[{"worst3", " ", "<", " ", "1*^-10"}], " ", "&&", " ", 
      RowBox[{"worst3b", " ", "<", " ", "1*^-10"}]}], ",", " ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<largest deviations \>\"", ",", " ", "worst3", ",", 
        " ", "\"\< and \>\"", ",", " ", "worst3b", ",", 
        " ", "\"\< (original: 5.8e-14 and 6.6e-14)\>\""}], "}"}], "]"}]}], 
    "]"}]}]}]], "Input",ExpressionUUID->"793cc29f-59e4-4fa4-b59a-\
e60e79259e4a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"GS", "-", "4"}], ":", " ", "isospin"}], ",", " ", 
    RowBox[{
    "Lorentz", " ", "invariance", " ", "and", " ", "isospin", " ", 
     "covariance", " ", "of", " ", "the", " ", "pair", " ", "matrices"}], ",",
     " ", 
    RowBox[{
     RowBox[{"the", " ", "c"}], "-", 
     RowBox[{"number", " ", "spinor"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"t", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"t2tiso", "[", "i", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"k", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"t2kpair", "[", "i", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"isoOk", " ", "=", " ", 
     RowBox[{
      RowBox[{"And", " ", "@@", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"fro", "[", 
            RowBox[{
             RowBox[{"comm", "[", 
              RowBox[{
               RowBox[{"t", "[", 
                RowBox[{"[", "a", "]"}], "]"}], ",", " ", 
               RowBox[{"t", "[", 
                RowBox[{"[", "b", "]"}], "]"}]}], "]"}], " ", "-", " ", 
             RowBox[{"Sum", "[", 
              RowBox[{
               RowBox[{"I", " ", 
                RowBox[{"t2eps3", "[", 
                 RowBox[{"a", ",", " ", "b", ",", " ", "c"}], "]"}], " ", 
                RowBox[{"t", "[", 
                 RowBox[{"[", "c", "]"}], "]"}]}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"c", ",", " ", "3"}], "}"}]}], "]"}]}], "]"}], " ", "<",
            " ", "tol"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"a", ",", " ", "3"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"b", ",", " ", "3"}], "}"}]}], "]"}], "]"}]}], " ", "&&", 
      "\n", "   ", 
      RowBox[{"And", " ", "@@", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"fro", "[", 
             RowBox[{"comm", "[", 
              RowBox[{
               RowBox[{"t", "[", 
                RowBox[{"[", "a", "]"}], "]"}], ",", " ", 
               RowBox[{"t2lift4", "[", 
                RowBox[{"sj", "[", 
                 RowBox[{"[", "u", "]"}], "]"}], "]"}]}], "]"}], "]"}], " ", "<",
             " ", "tol"}], " ", "&&", " ", 
           RowBox[{
            RowBox[{"fro", "[", 
             RowBox[{"comm", "[", 
              RowBox[{
               RowBox[{"t", "[", 
                RowBox[{"[", "a", "]"}], "]"}], ",", " ", 
               RowBox[{"t2lift4", "[", 
                RowBox[{"sk", "[", 
                 RowBox[{"[", "u", "]"}], "]"}], "]"}]}], "]"}], "]"}], " ", "<",
             " ", "tol"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"a", ",", " ", "3"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"u", ",", " ", "3"}], "}"}]}], "]"}], "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"kkOk", " ", "=", " ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{"k", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"fro", "[", 
          RowBox[{"#", " ", "+", " ", 
           RowBox[{"Transpose", "[", "#", "]"}]}], "]"}], " ", "<", " ", 
         "tol"}], " ", "&"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"worst4", " ", "=", " ", "0."}], ";", " ", 
    RowBox[{"cnum", " ", "=", " ", "0."}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "mg", ",", " ", "s8", ",", " ", "th", ",", " ", "u2", ",", " ", "u8",
           ",", " ", "r", ",", " ", "psi"}], "}"}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{"mg", " ", "=", " ", 
          RowBox[{"t2randSL2C", "[", "]"}]}], ";", "\n", "   ", 
         RowBox[{"s8", " ", "=", " ", 
          RowBox[{"t2lift4", "[", 
           RowBox[{"t2spinRep", "[", "mg", "]"}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"th", " ", "=", " ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"3", " ", 
             RowBox[{"t2Unit", "[", "]"}]}], ",", " ", 
            RowBox[{"{", "3", "}"}]}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"u2", " ", "=", " ", 
          RowBox[{"t2su2", "[", "th", "]"}]}], ";", " ", 
         RowBox[{"u8", " ", "=", " ", 
          RowBox[{"t2lift2", "[", "u2", "]"}]}], ";", " ", 
         RowBox[{"r", " ", "=", " ", 
          RowBox[{"t2adjoint", "[", "u2", "]"}]}], ";", "\n", "   ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{"worst4", " ", "=", " ", 
            RowBox[{"Max", "[", 
             RowBox[{"worst4", ",", " ", 
              RowBox[{"fro", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Transpose", "[", "s8", "]"}], " ", ".", " ", 
                 RowBox[{"k", "[", 
                  RowBox[{"[", "a", "]"}], "]"}], " ", ".", " ", "s8"}], " ", 
                "-", " ", 
                RowBox[{"k", "[", 
                 RowBox[{"[", "a", "]"}], "]"}]}], "]"}], ",", "\n", "      ", 
              RowBox[{"fro", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Transpose", "[", "u8", "]"}], " ", ".", " ", 
                 RowBox[{"k", "[", 
                  RowBox[{"[", "a", "]"}], "]"}], " ", ".", " ", "u8"}], " ", 
                "-", " ", 
                RowBox[{"Sum", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"r", "[", 
                    RowBox[{"[", 
                    RowBox[{"a", ",", " ", "b"}], "]"}], "]"}], " ", 
                   RowBox[{"k", "[", 
                    RowBox[{"[", "b", "]"}], "]"}]}], ",", " ", 
                  RowBox[{"{", 
                   RowBox[{"b", ",", " ", "3"}], "}"}]}], "]"}]}], "]"}]}], 
             "]"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"a", ",", " ", "3"}], "}"}]}], "]"}], ";", "\n", "   ", 
         RowBox[{"psi", " ", "=", " ", 
          RowBox[{"t2RndVec", "[", "8", "]"}]}], ";", "\n", "   ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{"cnum", " ", "=", " ", 
            RowBox[{"Max", "[", 
             RowBox[{"cnum", ",", " ", 
              RowBox[{"Abs", "[", 
               RowBox[{"psi", " ", ".", " ", 
                RowBox[{"k", "[", 
                 RowBox[{"[", "a", "]"}], "]"}], " ", ".", " ", "psi"}], 
               "]"}]}], "]"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"a", ",", " ", "3"}], "}"}]}], "]"}]}]}], "]"}], ",", 
      "\n", "  ", 
      RowBox[{"{", "100", "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<GS-4\>\"", ",", 
     " ", "\"\<isospin T^iota obeys [T^a, T^b] = i eps T^c and commutes with \
the Lorentz generators; the pair matrices Kch_iota are antisymmetric, Lorentz \
invariant and an isospin vector (100 random gL and U); Psi^T Kch Psi = 0 for \
a c-number spinor (tolerance 1e-10)\>\"", ",", "\n", "  ", 
     RowBox[{"isoOk", " ", "&&", " ", "kkOk", " ", "&&", " ", 
      RowBox[{"worst4", " ", "<", " ", "1*^-10"}], " ", "&&", " ", 
      RowBox[{"cnum", " ", "<", " ", "1*^-12"}]}], ",", " ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<largest deviation \>\"", ",", " ", "worst4", ",", 
        " ", "\"\<; largest |Psi^T Kch Psi| \>\"", ",", " ", "cnum", ",", 
        " ", "\"\< (original: 5.2e-15; 3.0e-16)\>\""}], "}"}], "]"}]}], 
    "]"}]}]}]], "Input",ExpressionUUID->"ff5865fc-cc81-4a51-8e87-\
4d0b8d96bc16"],

Cell["\<\
GS-5 and GS-6: gauge covariance and curvature of the covariant derivative\
\>", "Subsection",ExpressionUUID->"11316c34-5c42-44d8-a3de-892b18ad9b35"],

Cell[TextData[{
 "Fields linear in the coordinates ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "0"], ",", 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "1"], ",", 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "2"], ",", 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4efbfa35-b87f-4728-ae9f-23f0ba844c20"],
 " are drawn at random: the isospin potentials ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["A", "TI"], 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}], "\[Iota]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e94b4f89-e969-4e31-b5e8-09cb923d5937"],
 ", the fermion-number potentials ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["A", "TI"], 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}], 
    StyleBox["F",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3c8e0b55-1a5c-4a73-8f22-72ed56d232de"],
 " and the Lorentz connection with the rotation components ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Omega]", 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}], 
    StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e79f7b2d-9aca-405e-a429-ed833cdcf581"],
 " and the boost components ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CurlyPi]", 
    RowBox[{
     StyleBox["LL",
      FontSlant->"Plain"], ",", 
     StyleBox["p", "TI"]}], 
    StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c0c518e4-63bf-4420-bfbb-dd741f1d8237"],
 "; the spinor field ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPsi]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "308bc383-2fb0-4f74-8b13-fad4f7b9b6eb"],
 " is a sum of three plane waves. A gauge transformation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["\[ScriptCapitalU]",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    StyleBox["exp",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["i", "TI"], 
      SubsuperscriptBox["\[Theta]", 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["F",
        FontSlant->"Plain"]]}], ")"}], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["S",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[CircleTimes]", 
    SubscriptBox[
     StyleBox["U",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5e1d8b80-f51b-45e1-b9a5-be89d5bf2ffe"],
 " is applied, whose phase ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Theta]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["F",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "29982554-2ebe-4d59-84da-9ca5876e3a3b"],
 ", isospin rotation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["U",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    StyleBox["exp",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["i", "TI"], "\[ThinSpace]", 
      UnderscriptBox["\[Sum]", "\[Iota]",
       LimitsPositioning->True], "\[ThinSpace]", 
      SubsuperscriptBox["\[Theta]", 
       StyleBox["LL",
        FontSlant->"Plain"], "\[Iota]"], 
      SubsuperscriptBox["\[Tau]", "\[Iota]", 
       StyleBox["LL",
        FontSlant->"Plain"]], "/", "2"}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "9502fe21-b11f-4e22-937a-991b13ea9f59"],
 " and unit bi-quaternion ",
 Cell[BoxData[
  FormBox[
   StyleBox["g",
    FontWeight->"Bold",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4ab7b135-f977-4cf2-8bfe-bce7ec0a1bbd"],
 " (with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["g",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "\[LongEqual]", 
    StyleBox["exp",
     FontSlant->"Plain"], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["M", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["u",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f08f9731-39a8-42c9-96fa-917408ef4771"],
 " for a Lorentz generator ",
 Cell[BoxData[
