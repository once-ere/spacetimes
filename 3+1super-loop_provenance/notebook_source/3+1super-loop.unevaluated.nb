        OverscriptBox["d", "\[RightVector]"], "LL", "tr"], ",", "\n", "  ", 
       SubsuperscriptBox["H", "LL", "vac"], ",", " ", 
       TagBox[
        RowBox[{"U", 
         SubsuperscriptBox[
          RowBox[{"(", "1", ")"}], "LL", "Q"]}],
        "SL31Name",
        SyntaxForm->"symbol"], ",", " ", 
       TagBox[
        RowBox[{"S", "O", "(", "3", ")"}],
        "SL31Name",
        SyntaxForm->"symbol"], ",", " ", 
       TagBox[
        RowBox[{"O", "(", "2", ")"}],
        "SL31Name",
        SyntaxForm->"symbol"], ",", " ", 
       SubsuperscriptBox["\[CurlyTheta]", 
        RowBox[{"LL", ",", "0"}], "G"], ",", " ", 
       SubsuperscriptBox["\[CurlyTheta]", 
        RowBox[{"LL", ",", "1"}], "G"], ",", "\n", "  ", 
       SubsuperscriptBox["\[CurlyTheta]", 
        RowBox[{"LL", ",", "2"}], "G"], ",", " ", 
       SubsuperscriptBox["\[CurlyTheta]", "LL", "G"], ",", " ", 
       SubsuperscriptBox["\[CurlyPhi]", "LL", "G"], ",", " ", 
       SubsuperscriptBox[
        TagBox[
         StyleBox["U",
          FontFamily->"Helvetica",
          FontSlant->"Plain"],
         "SL31SansSerif"], "LL", "G"], ",", " ", 
       SubsuperscriptBox["h", "LL", "a"], ",", " ", 
       SubsuperscriptBox["c", 
        RowBox[{"LL", ",", "1"}], "n"], ",", "\n", "  ", 
       SubsuperscriptBox["c", 
        RowBox[{"LL", ",", "2"}], "n"], ",", " ", 
       SubsuperscriptBox["\[CurlyRho]", "LL", "n"], ",", " ", 
       SubsuperscriptBox["\[CapitalOmega]", "LL", "H"], ",", " ", 
       SubsuperscriptBox["\[Lambda]", "LL", "H"], ",", " ", 
       SubsuperscriptBox["\[ScriptCapitalL]", "LL", "kin"], ",", " ", 
       SubsuperscriptBox[
        TagBox[
         StyleBox["N",
          FontFamily->"Helvetica",
          FontSlant->"Plain"],
         "SL31SansSerif"], "LL", "g"], ",", "\n", "  ", 
       SubsuperscriptBox[
        TagBox[
         StyleBox["N",
          FontFamily->"Helvetica",
          FontSlant->"Plain"],
         "SL31SansSerif"], "LL", "v"], ",", " ", 
       SubsuperscriptBox[
        OverscriptBox["w", "\[RightVector]"], "LL", "n"], ",", " ", 
       SubsuperscriptBox["E", "LL", "c"], ",", " ", 
       SubsuperscriptBox[
        OverscriptBox["a", "\[RightVector]"], "LL", "F"], ",", " ", 
       SubsuperscriptBox[
        OverscriptBox["u", "\[RightVector]"], "LL", "f"], ",", " ", 
       SubsuperscriptBox[
        OverscriptBox["u", "\[RightVector]"], "LL", 
        RowBox[{"f", "\[Prime]"}]], ",", "\n", "  ", 
       SubsuperscriptBox["\[Delta]", "LL", "f"], ",", " ", 
       SubsuperscriptBox[
        TagBox[
         StyleBox["H",
          FontFamily->"Helvetica",
          FontSlant->"Plain"],
         "SL31SansSerif"], "LL", "f"], ",", " ", 
       SubsuperscriptBox[
        TagBox[
         StyleBox["H",
          FontFamily->"Helvetica",
          FontSlant->"Plain"],
         "SL31SansSerif"], "LL", 
        RowBox[{"f", "\[Prime]"}]], ",", " ", 
       SubsuperscriptBox["\[Chi]", "LL", "f"], ",", " ", 
       SubsuperscriptBox["\[CapitalGamma]", "LL", "f"], ",", " ", 
       SubsuperscriptBox["\[CapitalGamma]", "LL", "G"], ",", "\n", "  ", 
       SubsuperscriptBox["\[CapitalGamma]", "LL", "m"], ",", " ", 
       SubscriptBox["\[CapitalUpsilon]", "LL"], ",", " ", 
       SubsuperscriptBox["\[CapitalUpsilon]", "LL", 
        RowBox[{"(", "1", ")"}]], ",", " ", 
       SubsuperscriptBox["c", "LL", "w"], ",", " ", 
       SubsuperscriptBox[
        OverscriptBox["d", "\[RightVector]"], "LL", "u"], ",", " ", 
       SubsuperscriptBox["V", 
        RowBox[{"LL", ",", "p"}], "F"], ",", "\n", "  ", 
       SubsuperscriptBox["V", 
        RowBox[{"LL", ",", "p"}], "\[Iota]"], ",", " ", 
       SubsuperscriptBox["W", 
        RowBox[{"LL", ",", "p"}], "\[PlusMinus]"], ",", " ", 
       SubsuperscriptBox[
        TagBox[
         StyleBox["M",
          FontFamily->"Helvetica",
          FontSlant->"Plain"],
         "SL31SansSerif"], "LL", "t"], ",", " ", 
       SubsuperscriptBox[
        TagBox[
         StyleBox["M",
          FontFamily->"Helvetica",
          FontSlant->"Plain"],
         "SL31SansSerif"], "LL", "s"], ",", " ", 
       SubsuperscriptBox["M", "LL", "W"], ",", " ", 
       SubsuperscriptBox["M", "LL", "F"], ",", "\n", "  ", 
       SubsuperscriptBox["\[Theta]", "LL", "mix"], ",", " ", 
       SubsuperscriptBox["\[ScriptCapitalL]", "LL", 
        RowBox[{"(", "2", ")"}]]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"SL31Check", "[", 
     RowBox[{"\"\<S-14\>\"", ",", 
      " ", "\"\<every symbol typed in its printed form is read as one atomic \
symbol, the one created from its registry TeX\>\"", ",", "\n", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "typed", "]"}], " ", "==", " ", 
        RowBox[{"Length", "[", "symbolTable", "]"}]}], " ", "&&", " ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{"typed", ",", " ", "AtomQ"}], "]"}], " ", "&&", " ", 
       RowBox[{"typed", " ", "===", " ", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"ReleaseHold", "[", 
            RowBox[{"#", "[", "\"\<symbol\>\"", "]"}], "]"}], " ", "&"}], ",",
           " ", "symbolTable"}], "]"}]}]}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Length", "[", "typed", "]"}], ",", " ", 
        RowBox[{"Count", "[", 
         RowBox[{"typed", ",", " ", 
          RowBox[{"_", "?", "AtomQ"}]}], "]"}], ",", " ", 
        RowBox[{"Length", "[", "symbolTable", "]"}]}], "}"}]}], "]"}], 
    ";"}]}]}]], "Input",ExpressionUUID->"f72db0ed-b0dd-45f6-9d85-\
55db77481e9a"],

Cell["\<\
S-3, uniqueness: different printed forms give different symbols. If two \
different boxes had received the same name, two printed symbols would have \
become one Wolfram symbol. The test compares the number of different boxes \
with the number of different symbols, and also checks the comparison that the \
Notation package itself makes: it removes style boxes (StyleBox, \
AdjustmentBox, FrameBox) before it compares input with a symbolized box, so \
the boxes must still be different after this removal. (TeX items with the \
same boxes, listed in section I.6, are one symbol by construction.)\
\>", "Text",ExpressionUUID->"3e784211-4c6e-4f14-97bf-8ff523eeabc1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"strip", "[", "b_", "]"}], " ", ":=", " ", 
   RowBox[{"b", " ", "//.", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"StyleBox", "[", 
        RowBox[{"x_", ",", " ", "___"}], "]"}], " ", ":>", " ", "x"}], ",", 
      " ", 
      RowBox[{
       RowBox[{"AdjustmentBox", "[", 
        RowBox[{"x_", ",", " ", "___"}], "]"}], " ", ":>", " ", "x"}], ",", 
      " ", 
      RowBox[{
       RowBox[{"FrameBox", "[", 
        RowBox[{"x_", ",", " ", "___"}], "]"}], " ", ":>", " ", "x"}]}], 
     "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"syms", " ", "=", " ", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"#", "[", "\"\<symbol\>\"", "]"}], " ", "&"}], ",", " ", 
     "symbolTable"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-3\>\"", ",", 
    " ", "\"\<different boxes give different symbols, and the boxes stay \
different after the removal of style boxes\>\"", ",", "\n", "  ", 
    RowBox[{
     RowBox[{"Length", "[", 
      RowBox[{"DeleteDuplicates", "[", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", "\"\<boxes\>\"", "]"}], " ", "&"}], ",", " ", 
         "symbolTable"}], "]"}], "]"}], "]"}], " ", "==", " ", 
     RowBox[{"Length", "[", 
      RowBox[{"DeleteDuplicates", "[", "syms", "]"}], "]"}], " ", "==", "\n", 
     "   ", 
     RowBox[{"Length", "[", 
      RowBox[{"DeleteDuplicates", "[", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"strip", "[", 
           RowBox[{"#", "[", "\"\<boxes\>\"", "]"}], "]"}], " ", "&"}], ",", 
         " ", "symbolTable"}], "]"}], "]"}], "]"}], " ", "==", " ", 
     RowBox[{"Length", "[", "symbolTable", "]"}]}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Length", "[", "symbolTable", "]"}], ",", " ", 
      RowBox[{"Length", "[", 
       RowBox[{"DeleteDuplicates", "[", "syms", "]"}], "]"}], ",", " ", 
      RowBox[{"Length", "[", 
       RowBox[{"DeleteDuplicates", "[", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"strip", "[", 
            RowBox[{"#", "[", "\"\<boxes\>\"", "]"}], "]"}], " ", "&"}], ",", 
          " ", "symbolTable"}], "]"}], "]"}], "]"}]}], "}"}]}], "]"}], 
  ";"}]}], "Input",ExpressionUUID->"4f62070e-8911-4345-940c-c25c9f4bd484"],

Cell[TextData[{
 "S-4, the round trip: a symbol, printed again, gives exactly the box it was \
made from (",
 StyleBox["ToBoxes[symbol, StandardForm]",
  FontFamily->"Source Code Pro"],
 "). This is the other half of the symbolization: input box to symbol (S-2) \
and symbol to output box (S-4)."
}], "Text",ExpressionUUID->"5f11e2f2-fa07-4047-859c-509ee7c18d7e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"roundTrip", " ", "=", " ", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{"r", ",", " ", 
       RowBox[{"Replace", "[", 
        RowBox[{
         RowBox[{"r", "[", "\"\<symbol\>\"", "]"}], ",", " ", 
         RowBox[{
          RowBox[{"HoldComplete", "[", "s_", "]"}], " ", ":>", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"ToBoxes", "[", 
             RowBox[{
              RowBox[{"Unevaluated", "[", "s", "]"}], ",", " ", 
              "StandardForm"}], "]"}], " ", "===", " ", 
            RowBox[{"r", "[", "\"\<boxes\>\"", "]"}]}], ")"}]}]}], "]"}]}], 
      "]"}], ",", " ", "symbolTable"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-4\>\"", ",", 
    " ", "\"\<every symbol prints as the box it was made from\>\"", ",", " ", 
    
    RowBox[{"And", " ", "@@", " ", "roundTrip"}], ",", " ", 
    RowBox[{"Count", "[", 
     RowBox[{"roundTrip", ",", " ", "True"}], "]"}]}], "]"}], ";"}]}], "Input",\
ExpressionUUID->"b725be42-77ac-4d80-84ed-b531259080af"],

Cell[TextData[{
 "S-5, TeX: with its ",
 StyleBox["TraditionalForm",
  FontFamily->"Source Code Pro"],
 " rule, every symbol is written in TeX from its displayed boxes; the \
internal name, with its separator character, does not appear."
}], "Text",ExpressionUUID->"74742138-d376-4749-889d-4fedd60ce8ec"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"texOut", " ", "=", " ", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{"r", ",", " ", 
       RowBox[{"Replace", "[", 
        RowBox[{
         RowBox[{"r", "[", "\"\<symbol\>\"", "]"}], ",", " ", 
         RowBox[{
          RowBox[{"HoldComplete", "[", "s_", "]"}], " ", ":>", " ", 
          RowBox[{"ToString", "[", 
           RowBox[{"TeXForm", "[", 
            RowBox[{"Unevaluated", "[", "s", "]"}], "]"}], "]"}]}]}], "]"}]}],
       "]"}], ",", " ", "symbolTable"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-5\>\"", ",", 
    " ", "\"\<the TeX of every symbol is written from its printed form, \
without the internal name\>\"", ",", "\n", "  ", 
    RowBox[{"AllTrue", "[", 
     RowBox[{"texOut", ",", " ", 
      RowBox[{
       RowBox[{"!", " ", 
        RowBox[{"StringContainsQ", "[", 
         RowBox[{"#", ",", " ", 
          
          RowBox[{"\"\<UnderBracket\>\"", " ", "|", 
           " ", "\"\<\[UnderBracket]\>\""}]}], "]"}]}], " ", "&"}]}], "]"}], ",",
     " ", 
    RowBox[{"Count", "[", 
     RowBox[{"texOut", ",", " ", 
      RowBox[{"x_", " ", "/;", " ", 
       RowBox[{"!", " ", 
        RowBox[{"StringContainsQ", "[", 
         RowBox[{"x", ",", " ", "\"\<UnderBracket\>\""}], "]"}]}]}]}], 
     "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{"TableForm", "[", 
  RowBox[{
   RowBox[{"Take", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", "\"\<tex\>\"", "]"}], " ", "&"}], ",", " ", 
          "symbolTable"}], "]"}], ",", " ", "texOut"}], "}"}], "]"}], ",", 
     " ", "8"}], "]"}], ",", " ", 
   RowBox[{"TableHeadings", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"None", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<registry TeX\>\"", ",", 
        " ", "\"\<TeXForm of the symbol\>\""}], "}"}]}], "}"}]}]}], 
  "]"}]}], "Input",ExpressionUUID->"95a4451e-5152-40ba-9a2f-338d66264f06"],

Cell[TextData[{
 "S-6, arithmetic with symbols and values: the coupling ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubscriptBox[
     StyleBox["G", "TI"], "LL"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"a55dba7c-753c-43e9-8046-9c6f75527b41"]], "InlineFormula",
  ExpressionUUID->"5822461d-3a0e-4f97-80f8-87d3993e3155"],
 ", the mass ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubscriptBox[
     StyleBox["m", "TI"], "LL"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"85d591df-418c-468b-8f46-bffb95f2d7c0"]], "InlineFormula",
  ExpressionUUID->"fb911ba7-4593-4b86-bd57-6ed5173264a6"],
 " and the cutoff ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubscriptBox["\[CapitalLambda]", "LL"], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"e509d38a-f623-4c14-a8da-66b0e644bfdc"]], 
  "InlineFormula",ExpressionUUID->"c5459255-916e-409b-8349-8c5c0b0d5f62"],
 " of the spinor charges receive the values used throughout Test 2 (",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["m", "TI"], "LL"], "\[LongEqual]", "0.2"}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"f21e73c7-4097-4c5b-abda-5c9b816f9074"]], 
  "InlineFormula",ExpressionUUID->"55275bcd-479b-4d26-ad82-124c232f9132"],
 ", ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox["\[CapitalLambda]", "LL"], "\[LongEqual]", "1"}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "53da4943-262a-4ce0-b12f-5ca62d5cbae0"]], "InlineFormula",ExpressionUUID->
  "09cd436a-35cb-4156-b098-712161e4a725"],
 ", ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["G", "TI"], "LL"], "\[LongEqual]", "22.5"}], TraditionalForm]],
    "InlineFormula",ExpressionUUID->"3199030b-57cf-4179-a94e-bb54311cc6ff"]], 
  "InlineFormula",ExpressionUUID->"6de14178-a385-4569-8b77-b19f2a4169d2"],
 ", units in which the cutoff is 1). The gap of the condensed vacuum at zero \
chemical potential solves the gap equation ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{"1", "/", 
     SubscriptBox[
      StyleBox["G", "TI"], "LL"], "\[LongEqual]", 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[CapitalLambda]", "LL"], 
       SubscriptBox[
        StyleBox["E", "TI"], "\[CapitalLambda]"], "-", 
       SuperscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox[
          StyleBox["M", "TI"], "LL", "q"], ")"}], "2"], " ", "arsinh", 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["\[CapitalLambda]", "LL"], "/", 
         SubsuperscriptBox[
          StyleBox["M", "TI"], "LL", "q"]}], ")"}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"2", 
       SuperscriptBox["\[Pi]", "2"]}], ")"}]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"dc758e94-ad70-43b2-b5a0-3bcc3ebcbd69"]], 
  "InlineFormula",ExpressionUUID->"d0e3b8a2-a528-48c1-995f-9991996cb363"],
 " with ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["M", "TI"], "LL", "q"], ")"}], "2"], "\[LongEqual]", 
     SubsuperscriptBox[
      StyleBox["m", "TI"], "LL", "2"], "+", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], ")"}], "2"]}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "13562953-a2e6-446e-982f-fbfafba0ce64"]], "InlineFormula",ExpressionUUID->
  "e825f656-c31d-4b8a-9a5e-ff62bb711a9d"],
 " and ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["E", "TI"], "\[CapitalLambda]"], "\[LongEqual]", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox["\[CapitalLambda]", "LL", "2"], "+", 
        SuperscriptBox[
         RowBox[{"(", 
          SubsuperscriptBox[
           StyleBox["M", "TI"], "LL", "q"], ")"}], "2"]}], ")"}], 
      RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"b11021ff-5ade-4475-812b-e4d8e8420597"]], "InlineFormula",
  ExpressionUUID->"c75b5691-b905-478d-b266-56393cd93f5c"],
 ". The cell writes this equation with the symbolized symbols, gives them \
values only inside ",
 StyleBox["Block",
  FontFamily->"Source Code Pro"],
 " (so that they stay free symbols outside), solves for the gap with ",
 StyleBox["FindRoot",
  FontFamily->"Source Code Pro"],
 ", and compares with the value 0.2094933033 found by the Rust program of \
Test 2. It also checks the derived masses ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{"2", 
     SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"460a3922-aec4-4f24-8911-c666907210af"]], 
  "InlineFormula",ExpressionUUID->"0a0aa34f-583a-46e9-8553-881b32a1734c"],
 " and ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{"2", 
     SubsuperscriptBox[
      StyleBox["M", "TI"], "LL", "q"]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"42a66b68-4ca2-4dcf-bf10-084898262053"]], "InlineFormula",
  ExpressionUUID->"2a420408-c804-4fca-9222-93a4411c1f52"],
 "."
}], "Text",ExpressionUUID->"84a08166-be7e-42a9-bbe7-72dbff4b1d12"],

Cell[BoxData[
 RowBox[{"gapEquation", " ", "=", " ", 
  RowBox[{
   RowBox[{"1", "/", 
    SubscriptBox["G", "LL"]}], " ", "==", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[CapitalLambda]", "LL"], " ", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{
          SubscriptBox["\[CapitalLambda]", "LL"], "^", "2"}], " ", "+", " ", 
         RowBox[{
          SubscriptBox["m", "LL"], "^", "2"}], " ", "+", " ", 
         RowBox[{
          SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], "^", "2"}]}], 
        "]"}]}], " ", "-", "\n", "     ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SubscriptBox["m", "LL"], "^", "2"}], " ", "+", " ", 
         RowBox[{
          SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], "^", "2"}]}], 
        ")"}], " ", 
       RowBox[{"ArcSinh", "[", 
        RowBox[{
         SubscriptBox["\[CapitalLambda]", "LL"], "/", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{
            SubscriptBox["m", "LL"], "^", "2"}], " ", "+", " ", 
           RowBox[{
            SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], "^", "2"}]}], 
          "]"}]}], "]"}]}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"2", " ", 
      RowBox[{"Pi", "^", "2"}]}], ")"}]}]}]}]], "Input",ExpressionUUID->\
"2ac49782-f68d-4b29-bd7d-493f743b202a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"exact", " ", "values", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"45", "/", "2"}], ",", " ", 
       RowBox[{"1", "/", "5"}], ",", " ", "1"}], ")"}]}], ",", " ", 
    RowBox[{
    "so", " ", "that", " ", "FindRoot", " ", "can", " ", "work", " ", "with", 
     " ", "30", " ", "digits"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"gapValue", " ", "=", " ", 
     RowBox[{"Block", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          SubscriptBox["G", "LL"], " ", "=", " ", 
          RowBox[{"45", "/", "2"}]}], ",", " ", 
         RowBox[{
          SubscriptBox["m", "LL"], " ", "=", " ", 
          RowBox[{"1", "/", "5"}]}], ",", " ", 
         RowBox[{
          SubscriptBox["\[CapitalLambda]", "LL"], " ", "=", " ", "1"}]}], 
        "}"}], ",", "\n", "   ", 
       RowBox[{
        SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], " ", "/.", " ", 
        RowBox[{"FindRoot", "[", 
         RowBox[{"gapEquation", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], ",", " ", 
            "0.2"}], "}"}], ",", " ", 
          RowBox[{"WorkingPrecision", " ", "->", " ", "30"}], ",", " ", 
          RowBox[{"AccuracyGoal", " ", "->", " ", "20"}]}], "]"}]}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"SL31Check", "[", 
     RowBox[{"\"\<S-6\>\"", ",", 
      " ", "\"\<the gap equation written with the symbols gives the gap of \
the condensed vacuum 0.2094933033 at G = 22.5, m = 0.2, cutoff 1; 2 Delta_vac \
= 0.4189866 and 2 M_q = 0.5792666\>\"", ",", "\n", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"gapValue", " ", "-", " ", "0.2094933033"}], "]"}], " ", "<",
         " ", "1*^-10"}], " ", "&&", " ", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"2", " ", "gapValue"}], " ", "-", " ", "0.4189866"}], "]"}],
         " ", "<", " ", "1*^-7"}], " ", "&&", " ", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"2", " ", 
           RowBox[{"Sqrt", "[", 
            RowBox[{"0.04", " ", "+", " ", 
             RowBox[{"gapValue", "^", "2"}]}], "]"}]}], " ", "-", " ", 
          "0.5792666"}], "]"}], " ", "<", " ", "1*^-7"}]}], ",", "\n", "  ", 
      RowBox[{"N", "[", 
       RowBox[{"gapValue", ",", " ", "12"}], "]"}]}], "]"}], 
    ";"}]}]}]], "Input",ExpressionUUID->"0892d621-2f0c-4480-9daf-\
1d0f9449f3c0"],

Cell[TextData[{
 "S-7, sums over a family of symbols: the Pauli matrices. The registry symbol \
",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[Sigma]", 
     StyleBox["j", "TI"], "LL"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"a114fdab-bf3e-4819-af8b-5f6715e9fa05"]], "InlineFormula",
  ExpressionUUID->"d9824efe-675a-423b-8e1e-74968fc4d86f"],
 " is a family with the running index ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     StyleBox["j", "TI"], "\[LongEqual]", "1", ",", "2", ",", "3"}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "7199ade0-a0ae-43c6-9663-000b0d88b5ce"]], "InlineFormula",ExpressionUUID->
  "f15c802d-2182-4f76-92e6-32b9d05f9c31"],
 ". A symbolized symbol is indivisible, so the index letter inside it cannot \
be replaced by a number in a sum. The components are therefore separate \
symbols: ",
 StyleBox["LL[tex, \"j\" -> \"1\"]",
  FontFamily->"Source Code Pro"],
 " (written in the input cells as the printed component ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[Sigma]", "1", "LL"], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"825f4156-1050-45ea-8169-74007b23c568"]], 
  "InlineFormula",ExpressionUUID->"6a1e580f-b3b2-4901-9a67-3b7b574a938e"],
 ") symbolizes and returns the component with ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     StyleBox["j", "TI"], "\[LongEqual]", "1"}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"81878fb2-8c66-48f8-b65f-68cd38fb1726"]], 
  "InlineFormula",ExpressionUUID->"80be38f8-5827-473d-85a8-6c774ae5f047"],
 ". The cell gives the three components the Pauli matrices as values, \
together with the identity ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubscriptBox[
     StyleBox["1",
      FontFamily->"Helvetica",
      FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"833b636d-243c-45f3-8ecf-53a06914189d"]], "InlineFormula",
  ExpressionUUID->"2c002305-2e85-4197-8fad-cfd88ea36ac3"],
 ", and checks two identities that involve sums over the index: ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     UnderscriptBox["\[Sum]", 
      StyleBox["j", "TI"],
      LimitsPositioning->True], 
     SubsuperscriptBox["\[Sigma]", 
      StyleBox["j", "TI"], "LL"], 
     SubsuperscriptBox["\[Sigma]", 
      StyleBox["j", "TI"], "LL"], "\[LongEqual]", 
     RowBox[{"3", " "}], 
     SubscriptBox[
      StyleBox["1",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"ca879031-fb8c-493b-9ed6-94ddbe843461"]], "InlineFormula",
  ExpressionUUID->"133b402e-c7a2-4dd8-b932-fcdc5e1c2150"],
 ", and the product rule ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubsuperscriptBox["\[Sigma]", 
      StyleBox["j", "TI"], "LL"], 
     SubsuperscriptBox["\[Sigma]", 
      SuperscriptBox[
       StyleBox["j", "TI"], "\[Prime]"], "LL"], "\[LongEqual]", 
     SubscriptBox["\[Delta]", 
      RowBox[{
       StyleBox["j", "TI"], 
       SuperscriptBox[
        StyleBox["j", "TI"], "\[Prime]"]}]], 
     SubscriptBox[
      StyleBox["1",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], "2"], "+", 
     StyleBox["i", "TI"], 
     UnderscriptBox["\[Sum]", 
      SuperscriptBox[
       StyleBox["j", "TI"], "\[Prime]\[Prime]"],
      LimitsPositioning->True], 
     SubsuperscriptBox["\[Epsilon]", 
      RowBox[{
       StyleBox["j", "TI"], 
       SuperscriptBox[
        StyleBox["j", "TI"], "\[Prime]"], 
       SuperscriptBox[
        StyleBox["j", "TI"], "\[Prime]\[Prime]"]}], "LL"], 
     SubsuperscriptBox["\[Sigma]", 
      SuperscriptBox[
       StyleBox["j", "TI"], "\[Prime]\[Prime]"], "LL"]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"bc167ff1-c88f-403d-a818-f2b51ac4f833"]], 
  "InlineFormula",ExpressionUUID->"818347ce-7525-4633-85ca-0de967126f0d"],
 ", in which the 27 components of the symbol ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[Epsilon]", 
     RowBox[{
      StyleBox["j", "TI"], 
      SuperscriptBox[
       StyleBox["j", "TI"], "\[Prime]"], 
      SuperscriptBox[
       StyleBox["j", "TI"], "\[Prime]\[Prime]"]}], "LL"], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"5616a617-12b5-4dcc-874f-efd36b2e6488"]], 
  "InlineFormula",ExpressionUUID->"7a6a6e07-7962-45f9-9654-b25a3c9603eb"],
 " (the totally antisymmetric symbol with ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubsuperscriptBox["\[Epsilon]", "123", "LL"], "\[LongEqual]", "1"}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "f8bd5b84-6bd7-45dd-ae92-48ee39d5c8b3"]], "InlineFormula",ExpressionUUID->
  "ebac63a9-30d2-4edc-a279-3fd5292b5c3e"],
 ") are symbolized and given their values."
}], "Text",ExpressionUUID->"e2e0fcab-79f0-4db5-8d7c-99fb1182c700"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"symbolize", " ", "the", " ", "components", " ", 
     RowBox[{"sigma", "^", "LL_"}], "1"}], ",", " ", 
    RowBox[{
     RowBox[{"sigma", "^", "LL_"}], "2"}], ",", " ", 
    RowBox[{
     RowBox[{"sigma", "^", "LL_"}], "3", " ", "and", " ", 
     RowBox[{"epsilon", "^", "LL_"}], 
     RowBox[{"{", 
      RowBox[{"j", " ", 
       RowBox[{"j", "'"}], " ", 
       RowBox[{"j", "''"}]}], "}"}], " ", 
     RowBox[{"(", 
      RowBox[{"j", ",", " ", 
       RowBox[{"j", "'"}], ",", " ", 
       RowBox[{
        RowBox[{"j", "''"}], " ", "=", " ", "1"}], ",", " ", "2", ",", " ", 
       "3"}], ")"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"sigma", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"ReleaseHold", "[", 
        RowBox[{"SL31Instance", "[", 
         RowBox[{
          RowBox[{
          "SL31SymbolBoxes", "[", "\"\<\\\\sigma^{\\\\rm LL}_j\>\"", "]"}], ",",
           " ", 
          RowBox[{"{", 
           RowBox[{"\"\<j\>\"", " ", "->", " ", 
            RowBox[{"ToString", "[", "k", "]"}]}], "}"}]}], "]"}], "]"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"eps", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"ReleaseHold", "[", 
        RowBox[{"SL31Instance", "[", 
         RowBox[{
          RowBox[{
          "SL31SymbolBoxes", "[", "\"\<\\\\epsilon^{\\\\rm LL}_{jj'j''}\>\"", 
           "]"}], ",", "\n", "      ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\"\<j\>\"", " ", "->", " ", 
             RowBox[{"ToString", "[", "a", "]"}]}], ",", " ", 
            RowBox[{
             RowBox[{"SuperscriptBox", "[", 
              RowBox[{"\"\<j\>\"", ",", " ", "\"\<\[Prime]\>\""}], "]"}], " ",
              "->", " ", 
             RowBox[{"ToString", "[", "b", "]"}]}], ",", " ", 
            RowBox[{
             RowBox[{"SuperscriptBox", "[", 
              RowBox[{"\"\<j\>\"", ",", " ", "\"\<\[Prime]\[Prime]\>\""}], 
              "]"}], " ", "->", " ", 
             RowBox[{"ToString", "[", "c", "]"}]}]}], "}"}]}], "]"}], "]"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"b", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"c", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"{", 
    RowBox[{"sigma", ",", " ", 
     RowBox[{"eps", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "]"}], "]"}], ",", " ", 
     RowBox[{"eps", "[", 
      RowBox[{"[", 
       RowBox[{"2", ",", " ", "1", ",", " ", "3"}], "]"}], "]"}]}], 
    "}"}]}]}]], "Input",ExpressionUUID->"fd2d4d37-23f4-4094-be9f-\
3237312ed918"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", 
     RowBox[{"values", ":", " ", 
      RowBox[{"inside", " ", "Block", " ", "only"}]}]}], ",", " ", 
    RowBox[{
    "so", " ", "that", " ", "the", " ", "symbols", " ", "stay", " ", "free", " ",
      "elsewhere"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"pauliValues", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "0"}], "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", 
           RowBox[{"-", "I"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"I", ",", " ", "0"}], "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", 
           RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check7", " ", "=", " ", 
     RowBox[{"Block", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          SubsuperscriptBox["\[Sigma]", "1", "LL"], " ", "=", " ", 
          RowBox[{"pauliValues", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
         RowBox[{
          SubsuperscriptBox["\[Sigma]", "2", "LL"], " ", "=", " ", 
          RowBox[{"pauliValues", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ",", "\n", "     ", 
         RowBox[{
          SubsuperscriptBox["\[Sigma]", "3", "LL"], " ", "=", " ", 
          RowBox[{"pauliValues", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], ",", " ", 
         RowBox[{
          SubscriptBox[
           TagBox[
            StyleBox["1",
             FontFamily->"Helvetica",
             FontSlant->"Plain"],
            "SL31SansSerif"], "2"], " ", "=", " ", 
          RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], "}"}], ",", "\n", 
       "   ", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"sum", ",", " ", "rule"}], "}"}], ",", "\n", "     ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{"the", " ", "sum", " ", "over", " ", "j", " ", "of", " ", 
            RowBox[{"sigma_j", " ", ".", " ", "sigma_j"}]}], ",", " ", 
           RowBox[{
           "written", " ", "with", " ", "the", " ", "three", " ", 
            "components"}]}], " ", "*)"}], "\n", "     ", 
         RowBox[{
          RowBox[{"sum", " ", "=", " ", 
           RowBox[{
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"sigma", "[", 
                RowBox[{"[", "j", "]"}], "]"}], " ", ".", " ", 
               RowBox[{"sigma", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}], " ", "-", " ", 
            RowBox[{"3", " ", 
             SubscriptBox[
              TagBox[
               StyleBox["1",
                FontFamily->"Helvetica",
                FontSlant->"Plain"],
               "SL31SansSerif"], "2"]}]}]}], ";", "\n", "     ", 
          RowBox[{"(*", " ", 
           RowBox[{
            RowBox[{
            "the", " ", "product", " ", "rule", " ", "for", " ", "all", " ", 
             "nine", " ", "pairs", " ", 
             RowBox[{"(", 
              RowBox[{"j", ",", " ", 
               RowBox[{"j", "'"}]}], ")"}]}], ",", " ", 
            RowBox[{
            "with", " ", "the", " ", "27", " ", "symbolized", " ", 
             "components", " ", "of", " ", "epsilon"}]}], " ", "*)"}], "\n", 
          "     ", 
          RowBox[{"rule", " ", "=", " ", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"sigma", "[", 
                RowBox[{"[", "j", "]"}], "]"}], " ", ".", " ", 
               RowBox[{"sigma", "[", 
                RowBox[{"[", "jp", "]"}], "]"}]}], " ", "-", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"KroneckerDelta", "[", 
                  RowBox[{"j", ",", " ", "jp"}], "]"}], " ", 
                 SubscriptBox[
                  TagBox[
                   StyleBox["1",
                    FontFamily->"Helvetica",
                    FontSlant->"Plain"],
                   "SL31SansSerif"], "2"]}], " ", "+", "\n", "           ", 
                RowBox[{"I", " ", 
                 RowBox[{"Sum", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"eps", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", ",", " ", "jp", ",", " ", "jpp"}], "]"}], 
                    "]"}], " ", "/.", " ", 
                    RowBox[{"Thread", "[", 
                    RowBox[{
                    RowBox[{"Flatten", "[", "eps", "]"}], " ", "->", " ", 
                    RowBox[{"Flatten", "[", 
                    RowBox[{"Normal", "[", 
                    RowBox[{"LeviCivitaTensor", "[", "3", "]"}], "]"}], 
                    "]"}]}], "]"}]}], ")"}], " ", 
                    RowBox[{"sigma", "[", 
                    RowBox[{"[", "jpp", "]"}], "]"}]}], ",", " ", 
                   RowBox[{"{", 
                    RowBox[{"jpp", ",", " ", "3"}], "}"}]}], "]"}]}]}], 
               ")"}]}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"j", ",", " ", "3"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"jp", ",", " ", "3"}], "}"}]}], "]"}]}], ";", "\n", 
          "     ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Max", "[", 
             RowBox[{"Abs", "[", "sum", "]"}], "]"}], ",", " ", 
            RowBox[{"Max", "[", 
             RowBox[{"Abs", "[", 
              RowBox[{"Flatten", "[", "rule", "]"}], "]"}], "]"}]}], 
           "}"}]}]}], "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"SL31Check", "[", 
     RowBox[{"\"\<S-7\>\"", ",", 
      " ", "\"\<sum over j of sigma^LL_j sigma^LL_j = 3 times the unit \
matrix, and sigma_j sigma_j' = delta_jj' + i sum_j'' epsilon_jj'j'' sigma_j'' \
for all nine pairs (components as symbolized symbols)\>\"", ",", "\n", "  ", 
      RowBox[{"check7", " ", "===", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0"}], "}"}]}], ",", " ", "check7"}], "]"}], 
    ";"}]}]}]], "Input",ExpressionUUID->"49de098b-87dd-45cb-bf4d-\
b61b9ecaa929"],

Cell[TextData[{
 "S-8, a double sum with a metric: the Minkowski square. The family ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["x", "TI"], "LL", 
     StyleBox["p", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "c8d644cf-bda5-46ac-b6d2-c0221cbf6824"]], "InlineFormula",ExpressionUUID->
  "a9a162e4-462b-41c3-b0d2-ff1f20519a44"],
 " (the coordinates of space-time, ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     StyleBox["p", "TI"], "\[LongEqual]", "0", ",", "1", ",", "2", ",", "3"}],
     TraditionalForm]], "InlineFormula",ExpressionUUID->
   "56a07a2b-edf0-4a17-ac07-1b72593bd8dd"]], "InlineFormula",ExpressionUUID->
  "2e4b5e01-5d34-41ba-91bd-508beb844e0c"],
 ") and the metric ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[Eta]", 
     RowBox[{
      StyleBox["p", "TI"], 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]}], "LL"], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"cc5003f3-7dba-44ff-82f5-8dfe3840c9b3"]], 
  "InlineFormula",ExpressionUUID->"45ab12bd-5515-4ef2-9b3c-654bd38b5836"],
 " (",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{"+", "1"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "4a41c4fe-06f6-4402-a505-b07bb62da3c9"]], "InlineFormula",ExpressionUUID->
  "87568784-2007-417a-93fd-3a75280b7499"],
 " for ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     StyleBox["p", "TI"], "\[LongEqual]", 
     SuperscriptBox[
      StyleBox["p", "TI"], "\[Prime]"], "\[LongEqual]", "0"}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "d069bbdc-8333-4371-877e-d341ece586ee"]], "InlineFormula",ExpressionUUID->
  "cbc93e9b-6638-4e9a-84b5-4ba77af3f9f4"],
 ", ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "2c1b643d-04ff-4470-8cd1-0f817b2cc060"]], "InlineFormula",ExpressionUUID->
  "3daff5ef-8e09-47aa-85ad-08b1ad2e47a1"],
 " for ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     StyleBox["p", "TI"], "\[LongEqual]", 
     SuperscriptBox[
      StyleBox["p", "TI"], "\[Prime]"], "\[LongEqual]", "1", ",", "2", ",", 
     "3"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "7004add2-ea7d-4a9b-933c-47acac383cd6"]], "InlineFormula",ExpressionUUID->
  "34f7a8d6-0d1e-4387-b7f9-4bf5be0159c0"],
 ", zero otherwise) are symbolized component by component; the double sum ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{
       StyleBox["p", "TI"], ",", 
       SuperscriptBox[
        StyleBox["p", "TI"], "\[Prime]"]}],
      LimitsPositioning->True], 
     SubsuperscriptBox["\[Eta]", 
      RowBox[{
       StyleBox["p", "TI"], 
       SuperscriptBox[
        StyleBox["p", "TI"], "\[Prime]"]}], "LL"], 
     SubsuperscriptBox[
      StyleBox["x", "TI"], "LL", 
      StyleBox["p", "TI"]], 
     SubsuperscriptBox[
      StyleBox["x", "TI"], "LL", 
      SuperscriptBox[
       StyleBox["p", "TI"], "\[Prime]"]]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"397535ef-4c2f-4222-b7ec-cfb9020a13e1"]], 
  "InlineFormula",ExpressionUUID->"c81af694-c483-455d-8147-dc4cb38aa05a"],
 " is formed with the 16 components of the metric as free symbols, then the \
metric receives its values and the sum must become ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["x", "TI"], "LL", "0"], ")"}], "2"], "-", 
     UnderscriptBox["\[Sum]", 
      StyleBox["j", "TI"],
      LimitsPositioning->True], 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["x", "TI"], "LL", 
        StyleBox["j", "TI"]], ")"}], "2"]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"95d76b91-ec68-4b91-8e18-8032c2f00cd7"]], 
  "InlineFormula",ExpressionUUID->"bb214078-8bac-413e-8cd0-073cc551b666"],
 ", with the coordinate components remaining free symbols. The test is \
algebraic: ",
 StyleBox["Expand",
  FontFamily->"Source Code Pro"],
 " and a comparison of polynomials in the four coordinate symbols."
}], "Text",ExpressionUUID->"0c26e581-0a2b-443b-bf39-c44e555c4e7f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"xs", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ReleaseHold", "[", 
      RowBox[{"SL31Instance", "[", 
       RowBox[{
        RowBox[{"SL31SymbolBoxes", "[", "\"\<x^p_{\\\\rm LL}\>\"", "]"}], ",",
         " ", 
        RowBox[{"{", 
         RowBox[{"\"\<p\>\"", " ", "->", " ", 
          RowBox[{"ToString", "[", "k", "]"}]}], "}"}]}], "]"}], "]"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"etas", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ReleaseHold", "[", 
      RowBox[{"SL31Instance", "[", 
       RowBox[{
        RowBox[{
        "SL31SymbolBoxes", "[", "\"\<\\\\eta^{\\\\rm LL}_{pp'}\>\"", "]"}], ",",
         " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\"\<p\>\"", " ", "->", " ", 
           RowBox[{"ToString", "[", "a", "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{"SuperscriptBox", "[", 
            RowBox[{"\"\<p\>\"", ",", " ", "\"\<\[Prime]\>\""}], "]"}], " ", "->",
            " ", 
           RowBox[{"ToString", "[", "b", "]"}]}]}], "}"}]}], "]"}], "]"}], ",",
      " ", 
     RowBox[{"{", 
      RowBox[{"a", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"b", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"quadratic", " ", "=", " ", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"etas", "[", 
       RowBox[{"[", 
        RowBox[{"a", ",", " ", "b"}], "]"}], "]"}], " ", 
      RowBox[{"xs", "[", 
       RowBox[{"[", "a", "]"}], "]"}], " ", 
      RowBox[{"xs", "[", 
       RowBox[{"[", "b", "]"}], "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"a", ",", " ", "4"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"b", ",", " ", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"minkowski", " ", "=", " ", 
   RowBox[{"Expand", "[", 
    RowBox[{"quadratic", " ", "/.", " ", 
     RowBox[{"Thread", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", "etas", "]"}], " ", "->", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{"DiagonalMatrix", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", 
           RowBox[{"-", "1"}], ",", " ", 
           RowBox[{"-", "1"}], ",", " ", 
           RowBox[{"-", "1"}]}], "}"}], "]"}], "]"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Length", "[", "quadratic", "]"}], ",", " ", "minkowski"}], 
  "}"}]}], "Input",ExpressionUUID->"863a11bb-e72e-4f41-b172-57e8632539b4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-8\>\"", ",", 
    " ", "\"\<the double sum of eta^LL_pp' x^p x^p' over p, p' = 0..3 (16 + 4 \
symbolized components) is (x^0)^2 - (x^1)^2 - (x^2)^2 - (x^3)^2\>\"", ",", 
    "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"Expand", "[", 
       RowBox[{"minkowski", " ", "-", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"xs", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "^", "2"}], " ", "-", " ", 
          RowBox[{
           RowBox[{"xs", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "^", "2"}], " ", "-", " ", 
          RowBox[{
           RowBox[{"xs", "[", 
            RowBox[{"[", "3", "]"}], "]"}], "^", "2"}], " ", "-", " ", 
          RowBox[{
           RowBox[{"xs", "[", 
            RowBox[{"[", "4", "]"}], "]"}], "^", "2"}]}], ")"}]}], "]"}], " ",
       "===", " ", "0"}], " ", "&&", " ", 
     RowBox[{
      RowBox[{"Length", "[", "quadratic", "]"}], " ", "==", " ", "16"}]}], ",",
     " ", "minkowski"}], "]"}], ";"}]], "Input",ExpressionUUID->"46ca9a4b-\
f781-4e66-b1c7-d3c288295a92"],

Cell[TextData[{
 "S-9, algebra with the symbols of the Higgs mechanism of the superfluid \
boson singlet state. The rest masses of the two charged vector bosons and of \
the vector boson of the fermion number are ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["M", "TI"], "LL", "W"], ")"}], "2"], "\[LongEqual]", "2", 
     SubsuperscriptBox[
      StyleBox["Z", "TI"], "LL", "s"], 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["g", "TI"], "LL", "v"], ")"}], "2"], 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], ")"}], "2"]}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "968acf34-a127-4218-9a9c-fbaeb61b4333"]], "InlineFormula",ExpressionUUID->
  "f8b82437-f665-44bd-aac9-bcbe85917960"],
 " and ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["M", "TI"], "LL", "F"], ")"}], "2"], "\[LongEqual]", "8", 
     SubsuperscriptBox[
      StyleBox["Z", "TI"], "LL", "s"], 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["g", "TI"], "LL", "F"], ")"}], "2"], 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], ")"}], "2"]}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "decf5db8-eabc-46dd-967a-66adb677d694"]], "InlineFormula",ExpressionUUID->
  "1173f863-2c2e-453c-a8c0-d02023962205"],
 ", where ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["Z", "TI"], "LL", "s"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"6fdf3cc2-30f2-42b3-8cf1-3a2c4c639339"]], "InlineFormula",
  ExpressionUUID->"bd32dcf3-8e31-4620-99f0-8933b2a82e24"],
 " is the stiffness of the space derivatives and ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["g", "TI"], "LL", "v"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"92b2e5e3-ec2d-4229-be84-cc3d7a7e6cca"]], "InlineFormula",
  ExpressionUUID->"a2a05a4a-4670-4d94-9c04-6fa38d819757"],
 ", ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["g", "TI"], "LL", "F"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"08c37452-b139-4aa4-a2da-ad7e119b853c"]], "InlineFormula",
  ExpressionUUID->"aacb4ca9-e3c5-40b6-afe0-7cedcc00db1c"],
 " are the gauge couplings. The cell checks with ",
 StyleBox["Simplify",
  FontFamily->"Source Code Pro"],
 " that the ratio of the squared masses is ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{"4", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox[
         StyleBox["g", "TI"], "LL", "F"], "/", 
        SubsuperscriptBox[
         StyleBox["g", "TI"], "LL", "v"]}], ")"}], "2"]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"416988bd-1426-4a43-a1a5-1f312ffbe7a4"]], 
  "InlineFormula",ExpressionUUID->"44e02964-850d-40bd-b60b-60872fce3325"],
 ", independent of the stiffness and of the gap, and with ",
 StyleBox["Solve",
  FontFamily->"Source Code Pro"],
 " that the gap can be recovered from ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["M", "TI"], "LL", "W"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"ca876a8c-1a83-4055-acdb-8105f69329cc"]], "InlineFormula",
  ExpressionUUID->"85e2bd47-68b9-43c5-aef9-d17812cfdbc0"],
 "."
}], "Text",ExpressionUUID->"519ac147-0376-4726-9a12-a0f16d81f691"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"massRules", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      SubsuperscriptBox["M", "LL", "W"], " ", "->", " ", 
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{"2", " ", 
         SubsuperscriptBox["Z", "LL", "s"]}], "]"}], " ", 
       SubsuperscriptBox["g", "LL", "v"], " ", 
       SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"]}]}], ",", "\n", 
     "   ", 
     RowBox[{
      SubsuperscriptBox["M", "LL", "F"], " ", "->", " ", 
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{"8", " ", 
         SubsuperscriptBox["Z", "LL", "s"]}], "]"}], " ", 
       SubsuperscriptBox["g", "LL", "F"], " ", 
       SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"]}]}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{"ratio", " ", "=", " ", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox["M", "LL", "F"], "/", 
       SubsuperscriptBox["M", "LL", "W"]}], ")"}], "^", "2"}], " ", "/.", " ",
     "massRules"}], "]"}]}]}], "Input",ExpressionUUID->"bf25ff6a-1c78-4359-\
99a3-ca20cc2a30a5"],

Cell[BoxData[
 RowBox[{"gapFromMass", " ", "=", " ", 
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      SubsuperscriptBox["M", "LL", "W"], "^", "2"}], " ", "==", " ", 
     RowBox[{"2", " ", 
      SubsuperscriptBox["Z", "LL", "s"], " ", 
      RowBox[{
       SubsuperscriptBox["g", "LL", "v"], "^", "2"}], " ", 
      RowBox[{
       SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"], "^", "2"}]}]}], ",",
     " ", 
    SubsuperscriptBox["\[CapitalDelta]", "LL", "vac"]}], "]"}]}]], "Input",Exp\
ressionUUID->"28ea27a0-6055-40c5-a473-ea3c7f60a89a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-9\>\"", ",", 
    " ", "\"\<(M^F_LL / M^W_LL)^2 = 4 (g^F_LL / g^v_LL)^2 and the gap follows \
from M^W_LL (algebra with symbolized symbols)\>\"", ",", "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{"ratio", " ", "-", " ", 
        RowBox[{"4", " ", 
         RowBox[{
          RowBox[{
           SubsuperscriptBox["g", "LL", "F"], "^", "2"}], "/", 
          RowBox[{
           SubsuperscriptBox["g", "LL", "v"], "^", "2"}]}]}]}], "]"}], " ", "===",
       " ", "0"}], " ", "&&", " ", 
     RowBox[{
      RowBox[{"Length", "[", "gapFromMass", "]"}], " ", "==", " ", "2"}]}], ",",
     " ", "ratio"}], "]"}], ";"}]], "Input",ExpressionUUID->"8e739e88-6e33-\
4b79-8345-36c8f8aaa155"],

Cell[TextData[{
 "S-10, the longitudinal vector boson. For a plane wave of wave number ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["k", "TI"], "LL", "B"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"95e46b53-92f4-49be-9859-c3cb2764c5e3"]], "InlineFormula",
  ExpressionUUID->"09db7436-fbce-4e4a-9a12-2dac0b057600"],
 " and frequency ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[Omega]", "LL", "B"], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"2d1e58b3-ce73-464c-90a8-13713793878d"]], 
  "InlineFormula",ExpressionUUID->"be54b622-796f-49c6-8ccc-27d10621a898"],
 " the time component and the longitudinal component of a massive vector \
field obey two linear equations; their determinant is ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox[
          StyleBox["k", "TI"], "LL", "B"], ")"}], "2"], "+", 
       RowBox[{"(", 
        RowBox[{
         SubsuperscriptBox[
          StyleBox["Z", "TI"], "LL", "t"], "/", 
         SubsuperscriptBox[
          StyleBox["Z", "TI"], "LL", "s"]}], ")"}], 
       SuperscriptBox[
        StyleBox["M", "TI"], "2"]}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox["\[Omega]", "LL", "B"], ")"}], "2"], "-", 
       SuperscriptBox[
        StyleBox["M", "TI"], "2"]}], ")"}], "-", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox[
         StyleBox["k", "TI"], "LL", "B"], 
        SubsuperscriptBox["\[Omega]", "LL", "B"]}], ")"}], "2"]}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "84cc07e7-e138-49d3-ac56-f74a4e20d21e"]], "InlineFormula",ExpressionUUID->
  "402e3997-39ba-4e6f-af01-b622cfb4a162"],
 " with ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     StyleBox["M", "TI"], "\[LongEqual]", 
     SubsuperscriptBox[
      StyleBox["M", "TI"], "LL", "W"]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"240c633b-18dc-430d-8d16-ce88affaea39"]], "InlineFormula",
  ExpressionUUID->"1bc77972-6ab7-418f-be05-31f671d8e50e"],
 ". The cell checks with ",
 StyleBox["Factor",
  FontFamily->"Source Code Pro"],
 " and ",
 StyleBox["Solve",
  FontFamily->"Source Code Pro"],
 " that it vanishes exactly for ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox["\[Omega]", "LL", "B"], ")"}], "2"], "\[LongEqual]", 
     
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["M", "TI"], "LL", "W"], ")"}], "2"], "+", 
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["Z", "TI"], "LL", "s"], "/", 
       SubsuperscriptBox[
        StyleBox["Z", "TI"], "LL", "t"]}], ")"}], 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        StyleBox["k", "TI"], "LL", "B"], ")"}], "2"]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"31b07844-5881-4d82-97ce-39e4f8e435a8"]], 
  "InlineFormula",ExpressionUUID->"a0803680-ad2b-4e0c-a66f-aeae8cd900d7"],
 ": the absorbed Goldstone boson moves with the velocity ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["Z", "TI"], "LL", "s"], "/", 
       SubsuperscriptBox[
        StyleBox["Z", "TI"], "LL", "t"]}], ")"}], 
     RowBox[{"1", "/", "2"}]], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"edbe0705-fb5a-4132-857b-f887d4f8dd30"]], "InlineFormula",
  ExpressionUUID->"2abcdd2d-8d34-4237-b42b-76c09c604e0d"],
 "."
}], "Text",ExpressionUUID->"48633993-d49d-43d4-a4dc-2d50d571c5fd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"det", " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SubsuperscriptBox["k", "LL", "B"], "^", "2"}], " ", "+", " ", 
        RowBox[{
         RowBox[{
          SubsuperscriptBox["Z", "LL", "t"], "/", 
          SubsuperscriptBox["Z", "LL", "s"]}], " ", 
         RowBox[{
          SubsuperscriptBox["M", "LL", "W"], "^", "2"}]}]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SubsuperscriptBox["\[Omega]", "LL", "B"], "^", "2"}], " ", "-", " ", 
        
        RowBox[{
         SubsuperscriptBox["M", "LL", "W"], "^", "2"}]}], ")"}]}], " ", "-", 
     "\n", "   ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox["k", "LL", "B"], " ", 
        SubsuperscriptBox["\[Omega]", "LL", "B"]}], ")"}], "^", "2"}]}]}], 
   ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Solve", " ", "needs", " ", "a", " ", "symbol", " ", "as", " ", 
    RowBox[{"unknown", ":", " ", 
     RowBox[{
     "the", " ", "square", " ", "of", " ", "the", " ", "frequency", " ", "is",
       " ", "called", " ", "w"}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{"root", " ", "=", " ", 
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"det", " ", "/.", " ", 
       RowBox[{
        SubsuperscriptBox["\[Omega]", "LL", "B"], " ", "->", " ", 
        RowBox[{"Sqrt", "[", "w", "]"}]}]}], ")"}], " ", "==", " ", "0"}], ",",
     " ", "w"}], "]"}]}]}], "Input",ExpressionUUID->"b47e4db6-e7d4-4419-8735-\
ab1b52dfd051"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-10\>\"", ",", 
    " ", "\"\<the determinant of the time and longitudinal equations vanishes \
exactly at omega_B^2 = M_W^2 + (Z_s/Z_t) k_B^2\>\"", ",", "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", "root", "]"}], " ", "==", " ", "1"}], " ", "&&", 
     " ", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"w", " ", "/.", " ", 
          RowBox[{"First", "[", "root", "]"}]}], ")"}], " ", "-", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           SubsuperscriptBox["M", "LL", "W"], "^", "2"}], " ", "+", " ", 
          RowBox[{
           RowBox[{
            SubsuperscriptBox["Z", "LL", "s"], "/", 
            SubsuperscriptBox["Z", "LL", "t"]}], " ", 
           RowBox[{
            SubsuperscriptBox["k", "LL", "B"], "^", "2"}]}]}], ")"}]}], "]"}],
       " ", "===", " ", "0"}]}], ",", "\n", "  ", 
    RowBox[{"Factor", "[", "det", "]"}]}], "]"}], ";"}]], "Input",ExpressionUU\
ID->"18ef37d2-ed0b-42a8-8063-486c2eacaaf0"],

Cell[TextData[{
 "S-11, the sum over the isospin index with the generators ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubsuperscriptBox[
      StyleBox["T", "TI"], "LL", "\[Iota]"], "\[LongEqual]", 
     SubsuperscriptBox["\[Tau]", "\[Iota]", "LL"], "/", "2"}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "2233aeda-1fd6-4525-8540-5d6431bfe59d"]], "InlineFormula",ExpressionUUID->
  "d0b725d5-ebaf-44c3-bcc4-cedcd36cf946"],
 ": the Casimir ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       SubscriptBox[
        StyleBox["T", "TI"], "LL"], ")"}], "2"], "\[LongEqual]", 
     UnderscriptBox["\[Sum]", "\[Iota]",
      LimitsPositioning->True], 
     SubsuperscriptBox[
      StyleBox["T", "TI"], "LL", "\[Iota]"], 
     SubsuperscriptBox[
      StyleBox["T", "TI"], "LL", "\[Iota]"]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"1b37f32b-d1ae-4228-adad-504775384782"]], 
  "InlineFormula",ExpressionUUID->"f6f45457-07f7-4800-9a1f-e2eff33322a7"],
 " of the isospin one-half is ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    FractionBox["3", "4"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "cc8e10f2-537e-4f51-b504-1d1b5cf01837"]], "InlineFormula",ExpressionUUID->
  "eb559f58-0172-4d46-8dda-f3f38245baac"],
 " times the unit matrix. The components ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubsuperscriptBox["\[Tau]", "1", "LL"], ",", 
     SubsuperscriptBox["\[Tau]", "2", "LL"], ",", 
     SubsuperscriptBox["\[Tau]", "3", "LL"]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"db3f93ab-6c8e-42fb-8877-dfcef84509d0"]], 
  "InlineFormula",ExpressionUUID->"d9711485-7622-4e59-b40e-c50d6404d67e"],
 " and ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    RowBox[{
     SubsuperscriptBox[
      StyleBox["T", "TI"], "LL", "1"], ",", 
     SubsuperscriptBox[
      StyleBox["T", "TI"], "LL", "2"], ",", 
     SubsuperscriptBox[
      StyleBox["T", "TI"], "LL", "3"]}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"d7c03f90-e1bd-41aa-87c8-8c4c92c43bd0"]], "InlineFormula",
  ExpressionUUID->"d18eadbb-a50c-49ef-8565-3b4616f52403"],
 " are symbolized; the generators are defined from the Pauli matrices by \
rules."
}], "Text",ExpressionUUID->"5cbe7f70-ecc3-4041-8bb6-caa437c28d67"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"taus", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ReleaseHold", "[", 
      RowBox[{"SL31Instance", "[", 
       RowBox[{
        RowBox[{
        "SL31SymbolBoxes", "[", "\"\<\\\\tau^{\\\\rm LL}_\\\\iota\>\"", "]"}],
         ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<\[Iota]\>\"", " ", "->", " ", 
          RowBox[{"ToString", "[", "k", "]"}]}], "}"}]}], "]"}], "]"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Ts", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ReleaseHold", "[", 
      RowBox[{"SL31Instance", "[", 
       RowBox[{
        RowBox[{
        "SL31SymbolBoxes", "[", "\"\<T^\\\\iota_{\\\\rm LL}\>\"", "]"}], ",", 
        " ", 
        RowBox[{"{", 
         RowBox[{"\"\<\[Iota]\>\"", " ", "->", " ", 
          RowBox[{"ToString", "[", "k", "]"}]}], "}"}]}], "]"}], "]"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"casimir", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Ts", "[", 
         RowBox[{"[", "k", "]"}], "]"}], " ", ".", " ", 
        RowBox[{"Ts", "[", 
         RowBox[{"[", "k", "]"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}], " ", "/.", " ", 
     RowBox[{"Thread", "[", 
      RowBox[{"Ts", " ", "->", " ", 
       RowBox[{"taus", "/", "2"}]}], "]"}]}], " ", "/.", " ", 
    RowBox[{"Thread", "[", 
     RowBox[{"taus", " ", "->", " ", "pauliValues"}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-11\>\"", ",", 
    " ", "\"\<the sum over iota of T^iota_LL T^iota_LL (with T = tau/2 for \
the symbolized components) is 3/4 times the unit matrix\>\"", ",", "\n", "  ", 
    RowBox[{"casimir", " ", "===", " ", 
     RowBox[{
      RowBox[{"3", "/", "4"}], " ", 
      RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], ",", " ", "casimir"}], 
   "]"}], ";"}]}], "Input",ExpressionUUID->"cb882e29-b568-4033-a991-\
9c6b749910a6"],

Cell["\<\
S-12, uniqueness of the plain-text names: no plain-text name of the registry \
belongs to two different entries (the programs and data files can therefore \
always be read back without ambiguity), and every name maps to one entry.\
\>", "Text",ExpressionUUID->"c6198d64-6e63-4e8f-bd94-07f72e882cdd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"nameToEntries", " ", "=", " ", 
   RowBox[{"GroupBy", "[", 
    RowBox[{
     RowBox[{"Flatten", "[", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{"e", ",", " ", 
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"#", " ", "->", " ", 
              RowBox[{"e", "[", "\"\<entry\>\"", "]"}]}], " ", "&"}], ",", 
            " ", 
            RowBox[{"e", "[", "\"\<names\>\"", "]"}]}], "]"}]}], "]"}], ",", 
        " ", "SL31Registry"}], "]"}], "]"}], ",", " ", 
     RowBox[{"First", " ", "->", " ", "Last"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"shared", " ", "=", " ", 
   RowBox[{"Select", "[", 
    RowBox[{"nameToEntries", ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", 
        RowBox[{"DeleteDuplicates", "[", "#", "]"}], "]"}], " ", ">", " ", 
       "1"}], " ", "&"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-12\>\"", ",", 
    " ", "\"\<no plain-text name is registered for two different entries\>\"",
     ",", "\n", "  ", 
    RowBox[{"shared", " ", "===", " ", 
     RowBox[{"<|", "|>"}]}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Length", "[", "nameToEntries", "]"}], ",", " ", 
      RowBox[{"Normal", "[", "shared", "]"}]}], "}"}]}], "]"}], 
  ";"}]}], "Input",ExpressionUUID->"d6adfed5-fcd7-4c50-af3c-bf0c2a921d69"],

Cell[TextData[{
 "S-13, the kinds that are not symbolized. The imaginary unit ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    StyleBox["i", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "1ff238ca-8c5d-4431-9b2c-880d60c4c3b0"]], "InlineFormula",ExpressionUUID->
  "6ab60427-e9da-4a99-a89b-5f9a0da4b4cb"],
 " is the Wolfram symbol ",
 StyleBox["I",
  FontFamily->"Source Code Pro"],
 "; the number sets ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    StyleBox["\[DoubleStruckCapitalR]",
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "2a273b24-96b0-46ec-857a-78b1e98dff83"]], "InlineFormula",ExpressionUUID->
  "398bf380-499e-487e-a6a5-740255e69ee5"],
 " and ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    StyleBox["\[DoubleStruckCapitalC]",
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "589deb97-e87d-4daa-baf1-df465f68e0b1"]], "InlineFormula",ExpressionUUID->
  "3ed80c2a-d705-4e30-a1cf-874fa72b051d"],
 " are the Wolfram domains ",
 StyleBox["Reals",
  FontFamily->"Source Code Pro"],
 " and ",
 StyleBox["Complexes",
  FontFamily->"Source Code Pro"],
 " (which the Wolfram Language prints as double-struck letters); the \
operators correspond to Wolfram functions: tr is ",
 StyleBox["Tr",
  FontFamily->"Source Code Pro"],
 ", det is ",
 StyleBox["Det",
  FontFamily->"Source Code Pro"],
 ", diag is ",
 StyleBox["DiagonalMatrix",
  FontFamily->"Source Code Pro"],
 ", Re and Im are ",
 StyleBox["Re",
  FontFamily->"Source Code Pro"],
 " and ",
 StyleBox["Im",
  FontFamily->"Source Code Pro"],
 ", the tensor product ",
 Cell[BoxData[Cell[BoxData[
   FormBox["\[CircleTimes]", TraditionalForm]], "InlineFormula",
   ExpressionUUID->"1dbf6579-c1ee-4eb3-bf33-434d167b62b5"]], "InlineFormula",
  ExpressionUUID->"11f3d9d5-52e5-40df-abea-7c67ffa57999"],
 " is ",
 StyleBox["KroneckerProduct",
  FontFamily->"Source Code Pro"],
 ", the transpose ",
 Cell[BoxData[Cell[BoxData[
   FormBox[
    SuperscriptBox["\[Null]", 
     StyleBox["T", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "e9ebc37e-27f4-475b-bb7b-d4488fd3a0d5"]], "InlineFormula",ExpressionUUID->
  "21cd613f-5e2b-42e0-bf95-ee86140aa151"],
 " is ",
 StyleBox["Transpose",
  FontFamily->"Source Code Pro"],
 ". The test checks each correspondence on the Pauli matrices."
}], "Text",ExpressionUUID->"d82e5a60-07c8-46bb-98cd-229e4f911b56"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"p1", " ", "=", " ", 
   RowBox[{"pauliValues", "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";", " ", 
  RowBox[{"p2", " ", "=", " ", 
   RowBox[{"pauliValues", "[", 
    RowBox[{"[", "2", "]"}], "]"}]}], ";", " ", 
  RowBox[{"p3", " ", "=", " ", 
   RowBox[{"pauliValues", "[", 
    RowBox[{"[", "3", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"correspondences", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"I", "^", "2"}], " ", "==", " ", 
      RowBox[{"-", "1"}]}], ",", " ", 
     RowBox[{"Element", "[", 
      RowBox[{
       RowBox[{"Sqrt", "[", "2", "]"}], ",", " ", "Reals"}], "]"}], ",", " ", 
     
     RowBox[{"Element", "[", 
      RowBox[{"I", ",", " ", "Complexes"}], "]"}], ",", " ", 
     RowBox[{"!", " ", 
      RowBox[{"Element", "[", 
       RowBox[{"I", ",", " ", "Reals"}], "]"}]}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"Tr", "[", "p3", "]"}], " ", "==", " ", "0"}], ",", " ", 
     RowBox[{
      RowBox[{"Det", "[", "p1", "]"}], " ", "==", " ", 
      RowBox[{"-", "1"}]}], ",", " ", 
     RowBox[{
      RowBox[{"DiagonalMatrix", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", 
         RowBox[{"-", "1"}]}], "}"}], "]"}], " ", "==", " ", "p3"}], ",", " ", 
     RowBox[{
      RowBox[{"Re", "[", "p2", "]"}], " ", "==", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}]}], ",", " ", 
     RowBox[{
      RowBox[{"Im", "[", "p2", "]"}], " ", "==", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", 
          RowBox[{"-", "1"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "0"}], "}"}]}], "}"}]}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"p1", ",", " ", "p3"}], "]"}], " ", ".", " ", 
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"p1", ",", " ", "p3"}], "]"}]}], " ", "==", " ", 
      RowBox[{"IdentityMatrix", "[", "4", "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{"Transpose", "[", "p2", "]"}], " ", "==", " ", 
      RowBox[{"-", "p2"}]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SL31Check", "[", 
   RowBox[{"\"\<S-13\>\"", ",", 
    " ", "\"\<the imaginary unit, the number sets and the operators \
correspond to I, Reals, Complexes, Tr, Det, DiagonalMatrix, Re, Im, \
KroneckerProduct, Transpose\>\"", ",", "\n", "  ", 
    RowBox[{"And", " ", "@@", " ", "correspondences"}], ",", " ", 
    "correspondences"}], "]"}], ";"}]}], "Input",ExpressionUUID->"175c00b6-\
9961-465d-967d-3d5c9fd143da"],

Cell["I.8 The complete table of the symbols", "Section",ExpressionUUID->"1d20bded-0f0d-4dbe-be05-b38c902c2a5a"],

Cell["\<\
The table below shows every entry of the registry, group by group: the \
printed symbols (as the notebook now displays them), the plain-text names and \
the meaning. In the meanings the TeX between dollar signs is shown in its \
printed form.\
\>", "Text",ExpressionUUID->"9ca04b1d-5c11-4a96-965a-b9d345a313f1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"the", " ", "meaning", " ", "as", " ", "text", " ", "with", " ", 
    RowBox[{"formulas", ":", " ", 
     RowBox[{
     "TeX", " ", "between", " ", "dollar", " ", "signs", " ", "is", " ", 
      "converted", " ", "by", " ", "the", " ", "Wolfram", " ", "TeX", " ", 
      "importer"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"textWithMath", "[", "t_String", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "r", "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"r", " ", "=", " ", 
         RowBox[{"StringReplace", "[", 
          RowBox[{
           RowBox[{"StringReplace", "[", 
            RowBox[{"t", ",", " ", 
             RowBox[{"\"\<\\\\_\>\"", " ", "->", " ", "\"\<_\>\""}]}], "]"}], 
           ",", " ", 
           RowBox[{
            RowBox[{"\"\<$\>\"", " ", "~~", " ", 
             RowBox[{"Shortest", "[", "m__", "]"}], " ", "~~", 
             " ", "\"\<$\>\""}], " ", ":>", " ", 
            RowBox[{"With", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"c", " ", "=", " ", 
                RowBox[{"Cases", "[", 
                 RowBox[{
                  RowBox[{"Quiet", "[", 
                   RowBox[{"ImportString", "[", 
                    RowBox[{
                    
                    RowBox[{"\"\<$\>\"", " ", "<>", " ", "m", " ", "<>", 
                    " ", "\"\<$\>\""}], ",", " ", "\"\<TeX\>\""}], "]"}], 
                   "]"}], ",", " ", 
                  RowBox[{
                   RowBox[{"Cell", "[", 
                    RowBox[{
                    RowBox[{"BoxData", "[", "f_FormBox", "]"}], ",", 
                    " ", "\"\<InlineFormula\>\"", ",", " ", "___"}], "]"}], 
                   " ", ":>", " ", "f"}], ",", " ", "Infinity"}], "]"}]}], 
               "}"}], ",", "\n", "        ", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"c", " ", "===", " ", 
                 RowBox[{"{", "}"}]}], ",", " ", 
                
                RowBox[{"\"\<$\>\"", " ", "<>", " ", "m", " ", "<>", 
                 " ", "\"\<$\>\""}], ",", " ", 
                RowBox[{"RawBoxes", "[", 
                 RowBox[{"First", "[", "c", "]"}], "]"}]}], "]"}]}], 
             "]"}]}]}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Head", "[", "r", "]"}], " ", "===", " ", 
           "StringExpression"}], ",", " ", 
          RowBox[{"Row", "[", 
           RowBox[{"List", " ", "@@", " ", "r"}], "]"}], ",", " ", "r"}], 
         "]"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"one", " ", "row", " ", "of", " ", "the", " ", 
      RowBox[{"table", ":", " ", 
       RowBox[{"the", " ", "printed", " ", "symbols", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"a", " ", "Pane", " ", "of", " ", "fixed", " ", "width"}], ",",
           " ", 
          RowBox[{
          "in", " ", "which", " ", "the", " ", "list", " ", "of", " ", 
           "symbols", "\n", "   ", "may", " ", "break", " ", "after", " ", 
           "a", " ", "comma"}]}], ")"}]}]}]}], ",", " ", 
     RowBox[{
      RowBox[{"the", " ", "plain"}], "-", 
      RowBox[{"text", " ", "names"}]}], ",", " ", 
     RowBox[{
      RowBox[{
      "and", " ", "the", " ", "meaning", " ", "in", " ", "the", " ", "text", " ",
        "font"}], ";", " ", 
      RowBox[{"the", " ", "three", "\n", "   ", "widths", " ", 
       RowBox[{"(", 
        RowBox[{"125", " ", "+", " ", "95", " ", "+", " ", 
         RowBox[{"290", " ", 
          RowBox[{"printer", "'"}], "s", " ", "points"}]}], ")"}], " ", "let",
        " ", "the", " ", "table", " ", "fit", " ", "the", " ", "width", " ", 
       "of", " ", "a", " ", "printed", " ", "page"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"symbolRow", "[", "e_", "]"}], " ", ":=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Pane", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"StringContainsQ", "[", 
            RowBox[{
             RowBox[{"e", "[", "\"\<symbol\>\"", "]"}], ",", 
             " ", "\"\<$\>\""}], "]"}], ",", "\n", "      ", 
           RowBox[{"Row", "[", 
            RowBox[{"Riffle", "[", 
             RowBox[{
              RowBox[{"Map", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"RawBoxes", "[", 
                  RowBox[{"SL31TeXToBoxes", "[", "#", "]"}], "]"}], " ", 
                 "&"}], ",", "\n", "        ", 
                RowBox[{"Flatten", "[", 
                 RowBox[{"Map", "[", 
                  RowBox[{"SL31SplitTeX", ",", " ", 
                   RowBox[{"StringCases", "[", 
                    RowBox[{
                    RowBox[{"e", "[", "\"\<symbol\>\"", "]"}], ",", " ", 
                    RowBox[{
                    RowBox[{"\"\<$\>\"", " ", "~~", " ", 
                    RowBox[{"Shortest", "[", "x__", "]"}], " ", "~~", 
                    " ", "\"\<$\>\""}], " ", ":>", " ", "x"}]}], "]"}]}], 
                  "]"}], "]"}]}], "]"}], ",", " ", "\"\<, \>\""}], "]"}], 
            "]"}], ",", "\n", "      ", 
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"e", "[", "\"\<symbol\>\"", "]"}], ",", " ", "9"}], 
            "]"}]}], "]"}], ",", " ", "125"}], "]"}], ",", "\n", "   ", 
       RowBox[{"Pane", "[", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"StringRiffle", "[", 
            RowBox[{
             RowBox[{"e", "[", "\"\<names\>\"", "]"}], ",", 
             " ", "\"\< \>\""}], "]"}], ",", " ", 
           RowBox[{"FontFamily", " ", "->", " ", "\"\<Source Code Pro\>\""}], 
           ",", " ", "8"}], "]"}], ",", " ", "95"}], "]"}], ",", "\n", "   ", 
       
       RowBox[{"Pane", "[", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"textWithMath", "[", 
            RowBox[{"e", "[", "\"\<meaning\>\"", "]"}], "]"}], ",", " ", 
           "9.5", ",", " ", 
           RowBox[{
           "FontFamily", " ", "->", " ", "\"\<Source Sans Pro\>\""}]}], "]"}],
          ",", " ", "290"}], "]"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"groupTable", "[", "g_", "]"}], " ", ":=", " ", 
     RowBox[{"Grid", "[", 
      RowBox[{
       RowBox[{"Prepend", "[", 
        RowBox[{
         RowBox[{"Map", "[", 
          RowBox[{"symbolRow", ",", " ", 
           RowBox[{"Select", "[", 
            RowBox[{"SL31Registry", ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"#", "[", "\"\<group\>\"", "]"}], " ", "===", " ", 
               "g"}], " ", "&"}]}], "]"}]}], "]"}], ",", "\n", "    ", 
         RowBox[{
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{"#", ",", " ", "Bold", ",", " ", 
             RowBox[{
             "FontFamily", " ", "->", " ", "\"\<Source Sans Pro\>\""}]}], 
            "]"}], " ", "&"}], " ", "/@", " ", 
          RowBox[{"{", 
           
           RowBox[{"\"\<symbol\>\"", ",", " ", "\"\<plain-text names\>\"", ",",
             " ", "\"\<meaning\>\""}], "}"}]}]}], "]"}], ",", "\n", "   ", 
       RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
       RowBox[{"Alignment", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"Left", ",", " ", "Top"}], "}"}]}], ",", " ", 
       RowBox[{"Background", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"None", ",", " ", 
          RowBox[{"{", "LightGray", "}"}]}], "}"}]}], ",", " ", 
       RowBox[{"Spacings", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "0.6"}], "}"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"groups", " ", "=", " ", 
     RowBox[{"DeleteDuplicates", "[", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", "\"\<group\>\"", "]"}], " ", "&"}], ",", " ", 
        "SL31Registry"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{"Length", "[", "groups", "]"}]}]}]], "Input",ExpressionUUID->\
"3202009d-b782-4ae7-bef7-ade637612b98"],

