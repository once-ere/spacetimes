        "SL31Name",
        SyntaxForm->"symbol"], ",", " ", 
       TagBox[
        RowBox[{"S", "O", "(", "3", ")"}],
        "SL31Name",
        SyntaxForm->"symbol"], ",", " ", 
       TagBox[
        RowBox[{"O", "(", "2", ")"}],
        "SL31Name",
        SyntaxForm->"symbol"], ",", " ", 
       SubsuperscriptBox["\[CurlyTheta]", 
