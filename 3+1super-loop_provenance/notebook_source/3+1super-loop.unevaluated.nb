          " ", "\"\<$\\\\Psi_{{\\\\rm LL},1},\\\\dots,\\\\Psi_{{\\\\rm \
LL},8}$; $\\\\Psi^\\\\pm_{\\\\rm LL}$; $\\\\bar\\\\Psi_{\\\\rm LL}$\>\""}], ",",
          " ", 
         RowBox[{"\"\<names\>\"", " ", "->", " ", 
