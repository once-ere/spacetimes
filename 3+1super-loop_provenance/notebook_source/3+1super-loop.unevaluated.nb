      RowBox[{"t2gamma", "[", "0", "]"}], " ", ".", " ", 
      RowBox[{"t2gamma", "[", "j", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"t2beta", " ", "=", " ", 
