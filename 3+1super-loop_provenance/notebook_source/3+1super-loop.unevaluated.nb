     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"#", "[", "\"\<name\>\"", "]"}], ",", " ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"#", "[", "\"\<pass\>\"", "]"}], ",", " ", "\"\<PASS\>\"",
             ",", " ", "\"\<FAIL\>\""}], "]"}], ",", " ", 
          RowBox[{"#", "[", "\"\<statement\>\"", "]"}]}], "}"}], " ", "&"}], ",",
        " ", "SL31`Test`$Results"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"#", ",", " ", "Bold"}], "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<test\>\"", ",", " ", "\"\<result\>\"", ",", 
        " ", "\"\<statement\>\""}], "}"}]}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}]], "Input",Expression\
UUID->"0501f4bf-c033-465a-9d1d-934da2b8a971"],

