                    RowBox[{"w1", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"3", " ", "+", " ", "j"}], ",", " ", 
                    RowBox[{"p", " ", "+", " ", "1"}], ",", " ", 
                    RowBox[{"q", " ", "+", " ", "1"}]}], "]"}], "]"}], ",", 
                    " ", 
                    RowBox[{"{", 
                    RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}], "}"}]}], ";",
                "\n", "     ", 
