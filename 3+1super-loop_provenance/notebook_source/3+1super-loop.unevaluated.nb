       "cases15"}], "]"}]}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "every", " ", "formula", " ", "of", " ", "the", " ", "meanings", " ", "of",
     " ", "the", " ", "registry"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"meaningFormulas", " ", "=", " ", 
