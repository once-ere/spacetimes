   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<AS-3\>\"", ",", 
     " ", "\"\<the Bogoliubov modes of the uniform polar superfluid dvec = \
(0, 0, Delta) (case B): Kch_3 h(q) = conj(h(-q)) Kch_3, so that for an \
eigenvector chi_pw of h(q) with the energy +eps or -eps the hole vector Kch_3 \
chi_pw is an eigenvector of conj(h(-q)) with the same energy; Ppair = Delta \
Kch_3^dag couples (chi_pw, 0) only to (0, Kch_3 chi_pw), and (cos theta_B \
chi_pw, sin theta_B Kch_3 chi_pw) with cos^2 theta_B = (1 + (+-eps - \
mu)/E)/2, sin^2 theta_B = (1 - (+-eps - mu)/E)/2, E = ((+-eps - mu)^2 + \
Delta^2)^(1/2), is an eigenvector of H_BdG(q) with the energy E, which is E^- \
for the positive branch +eps and E^+ for the negative branch -eps (50 random \
momenta, chemical potentials and gaps, m = 0.4; tolerance 1e-12); on the \
lattice (periodic chain of 32 sites, dx = 0.5, r_W = 1, m = 0.4, mu = 0.6, \
Delta = 0.3) the 16 eigenvalues of the lattice operator on the plane wave of \
each allowed momentum are +-E^- and +-E^+ with eps_lat in place of eps, each \
four times (tolerance 1e-12)\>\"", ",", "\n", "  ", 
     RowBox[{
      RowBox[{"as3Dev", " ", "<", " ", "1*^-12"}], " ", "&&", " ", 
      RowBox[{"as3DevLat", " ", "<", " ", "1*^-12"}]}], ",", "\n", "  ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<largest deviations \>\"", ",", " ", 
        RowBox[{"asSci", "[", "as3Dev", "]"}], ",", 
        " ", "\"\< (continuum), \>\"", ",", " ", 
        RowBox[{"asSci", "[", "as3DevLat", "]"}], ",", 
        " ", "\"\< (lattice) (original: 6.7e-15, 1.2e-14)\>\""}], "}"}], 
      "]"}]}], "]"}]}]}]], "Input",ExpressionUUID->"7b15dc14-77f3-4a06-92b2-\
7fa006abc7b9"],

Cell[TextData[{
 StyleBox["A particle injected into the superfluid oscillates into a hole \
(check AS-4).",
  FontWeight->"Bold"],
 " Start with the particle ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubsuperscriptBox["\[Chi]", 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["pw",
       FontSlant->"Plain"]], ",", "0"}], ")"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f201f773-fda3-43f6-9848-e12b3864a9b0"],
 " of the positive energy ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CurlyEpsilon]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e7282220-751c-4d25-b6a8-03ecfe412811"],
 ". Its evolution stays in the plane of the two vectors ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubsuperscriptBox["\[Chi]", 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["pw",
       FontSlant->"Plain"]], ",", "0"}], ")"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a3744e66-d3d5-4eec-a0f9-c85b3c277021"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", 
     SubsuperscriptBox[
      StyleBox["K",
       FontFamily->"Helvetica",
       FontSlant->"Plain"], 
      StyleBox["LL",
       FontSlant->"Plain"], "3"], 
     SubsuperscriptBox["\[Chi]", 
      StyleBox["LL",
       FontSlant->"Plain"], 
      StyleBox["pw",
       FontSlant->"Plain"]]}], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7e460c75-663b-4c08-ad7f-052f4aff29eb"],
 ", in which the operator is the matrix displayed above with the upper sign. \
The square of that matrix is ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox[
      StyleBox["E", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], "-"], ")"}], "2"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5236c8c5-8ae2-4627-9d84-d0638745ed09"],
 " times the unit matrix, so its exponential with the factor ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     StyleBox["i", "TI"]}], 
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "0"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b81d7681-2a7f-4382-aefc-2753089d6922"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["cos",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "-"], 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "0"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bfda4bb9-c31e-43c9-90e7-1823e4e1d779"],
 " times the unit matrix minus ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["i", "TI"], "\[ThinSpace]", 
    StyleBox["sin",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "-"], 
      SubsuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "0"]}], ")"}], "/", 
    SubsuperscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "-"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f5ed1007-d85a-49b5-badb-8a8161e06f8e"],
 " times the matrix itself, and the mode is"
}], "Text",ExpressionUUID->"52fabdbb-6da1-49bb-bc80-eb1d912a4e70"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["\[Psi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p",
     FontSlant->"Plain"]], "\[LongEqual]", 
   RowBox[{"(", 
    RowBox[{
     StyleBox["cos",
      FontSlant->"Plain"], 
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["E", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], "-"], 
       SubsuperscriptBox[
        StyleBox["x", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], "0"]}], ")"}], "-", 
     StyleBox["i", "TI"], "\[ThinSpace]", 
     FractionBox[
      RowBox[{
       SubscriptBox["\[CurlyEpsilon]", 
        StyleBox["LL",
         FontSlant->"Plain"]], "-", 
       SubscriptBox["\[Mu]", 
        StyleBox["LL",
         FontSlant->"Plain"]]}], 
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "-"]], "\[ThinSpace]", 
     StyleBox["sin",
      FontSlant->"Plain"], 
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["E", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], "-"], 
       SubsuperscriptBox[
        StyleBox["x", "TI"], 
        StyleBox["LL",
         FontSlant->"Plain"], "0"]}], ")"}]}], ")"}], 
   SubsuperscriptBox["\[Chi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["pw",
     FontSlant->"Plain"]]}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"a3329bc8-95d3-4d64-9213-cc5e07f57556"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["\[Psi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["h",
     FontSlant->"Plain"]], "\[LongEqual]", 
   RowBox[{"-", 
    StyleBox["i", "TI"]}], "\[ThinSpace]", 
   FractionBox[
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], 
    SubsuperscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "-"]], "\[ThinSpace]", 
   StyleBox["sin",
    FontSlant->"Plain"], 
   RowBox[{"(", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["E", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], "-"], 
     SubsuperscriptBox[
      StyleBox["x", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], "0"]}], ")"}], "\[ThinSpace]", 
   SubsuperscriptBox[
    StyleBox["K",
     FontFamily->"Helvetica",
     FontSlant->"Plain"], 
    StyleBox["LL",
     FontSlant->"Plain"], "3"], 
   SubsuperscriptBox["\[Chi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["pw",
     FontSlant->"Plain"]]}], TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"91ed703e-ab07-4e68-8087-0c71894995a3"],

Cell["(both times the plane wave). The probability of the hole is", "Text",ExpressionUUID->"5fb17028-2017-47a9-b57c-5d3a00260a6e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["P", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["h",
     FontSlant->"Plain"]], 
   RowBox[{"(", 
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "0"], ")"}], "\[LongEqual]", 
   SuperscriptBox[
    RowBox[{"(", 
     FractionBox[
      SubscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "-"]], ")"}], "2"], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["sin",
     FontSlant->"Plain"], "2"], 
   RowBox[{"(", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["E", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], "-"], 
     SubsuperscriptBox[
      StyleBox["x", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], "0"]}], ")"}]}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"f328f22a-e778-4645-9339-7a5274c67818"],

Cell[TextData[{
 "A bare particle is not a stationary state of the superfluid: the pair field \
converts it into a hole and back, with the angular frequency ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    SubsuperscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "-"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "fe014b3e-eb08-4aaa-9e8d-955538864270"],
 " and the largest hole probability ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"]], "/", 
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "-"]}], ")"}], "2"], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ecd1c82a-883f-428d-8546-545bee042f14"],
 ", which is 1 at the Fermi momentum and small far from it (the Rabi \
oscillation of a system with two states). Check AS-4 takes a ring of 16 sites \
with the parameters and the pair field of AS-3 and the positive-energy plane \
wave of isospin up at the allowed momentum number 1, integrates the lattice \
equations to the 101 output times ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "0"], "\[LongEqual]", "0", ",", "0.2", ",", 
    "\[Ellipsis]", ",", "20"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "960ce581-50ec-47b4-b04c-aff1e4772028"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[ScriptL]", 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["t",
      FontSlant->"Plain"]], "\[LongEqual]", "0.2"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "911955bf-4dcf-4fb0-bf84-906717cf75f2"],
 "), and compares the whole state with this solution, in which ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CurlyEpsilon]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["lat",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5bdeecc7-d754-4157-bdcf-85567f425eae"],
 " stands in place of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CurlyEpsilon]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0c25efd6-0128-46ee-ab1c-d6ce6dec96de"],
 ". The integrator, its tolerances and the requirements are those of check \
AS-2 (here the particle components with isospin down and the hole components \
with isospin up are exactly zero at all times, again half of the real \
unknowns). Figure 4(b) shows the probability of the hole."
}], "Text",ExpressionUUID->"e609d496-b169-4f07-a927-73c030b81438"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"AS", "-", "4"}], ":", " ", 
    RowBox[{
    "a", " ", "chain", " ", "of", " ", "16", " ", "sites", " ", "with", " ", 
     "the", " ", "uniform", " ", "pair", " ", "field", " ", 
     RowBox[{"(", 
      RowBox[{"0", ",", " ", "0", ",", " ", "Delta"}], ")"}], " ", "and", " ",
      "the", " ", "parameters", " ", "of", " ", "case", " ", "B"}]}], " ", 
   "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"as4N", " ", "=", " ", "16"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as4Lat", " ", "=", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<n\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"as4N", ",", " ", "1", ",", " ", "1"}], "}"}]}], ",", " ", 
       RowBox[{"\"\<ell\>\"", " ", "->", " ", "asBEll"}], ",", " ", 
       RowBox[{"\"\<periodic\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"True", ",", " ", "False", ",", " ", "False"}], "}"}]}], ",",
        " ", 
       RowBox[{"\"\<wilson\>\"", " ", "->", " ", "1.0"}], ",", " ", 
       RowBox[{"\"\<mass\>\"", " ", "->", " ", "mass"}], ",", " ", 
       RowBox[{"\"\<mu\>\"", " ", "->", " ", "asBMu"}]}], "|>"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as4Fields", " ", "=", " ", 
     RowBox[{"t2trivialFields", "[", "as4N", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"as4Fields", "[", 
        RowBox[{"[", 
         RowBox[{"\"\<d\>\"", ",", " ", "site"}], "]"}], "]"}], " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{"0.", ",", " ", "0.", ",", " ", "asBDelta"}], "}"}]}], ",", 
      " ", 
      RowBox[{"{", 
       RowBox[{"site", ",", " ", "as4N"}], "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "allowed", " ", "momentum", " ", "number", " ", "1"}], ";", 
     " ", 
     RowBox[{"chi_pw", ":", " ", 
      RowBox[{
      "the", " ", "Dirac", " ", "spinor", " ", "of", " ", "the", " ", 
       "largest", " ", "eigenvalue", " ", "eps_lat", " ", "with", " ", 
       "isospin", " ", "up"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"as4Q", " ", "=", " ", 
     RowBox[{"t2chainMomentum", "[", 
      RowBox[{"1", ",", " ", "as4N", ",", " ", "asBEll"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"as4E4", ",", " ", "as4V4"}], "}"}], " ", "=", " ", 
     RowBox[{"t2eigh", "[", 
      RowBox[{"t2hLatPlane", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"as4Q", ",", " ", "0.", ",", " ", "0."}], "}"}], ",", " ", 
        "asBEll", ",", " ", "mass", ",", " ", "1.0", ",", " ", 
        "asChainActive"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as4Eps", " ", "=", " ", 
     RowBox[{"as4E4", "[", 
      RowBox[{"[", "4", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as4Chi", " ", "=", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"as4V4", "[", 
           RowBox[{"[", 
            RowBox[{"a", ",", " ", "4"}], "]"}], "]"}], ",", " ", "0."}], 
         "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"a", ",", " ", "4"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as4KChi", " ", "=", " ", 
     RowBox[{"asK3", " ", ".", " ", "as4Chi"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"eps_lat", " ", "-", " ", 
     RowBox[{"mu", " ", "and", " ", "the", " ", "quasi"}], "-", 
     RowBox[{"particle", " ", "energy", " ", 
      RowBox[{"E", "^", "-"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"as4X", " ", "=", " ", 
     RowBox[{"as4Eps", " ", "-", " ", "asBMu"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as4E", " ", "=", " ", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"as4X", "^", "2"}], " ", "+", " ", 
       RowBox[{"asBDelta", "^", "2"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "exact", " ", "solution", " ", "at", " ", "the", " ", "time",
       " ", 
      RowBox[{"x0", ":", " ", 
       RowBox[{
       "the", " ", "particle", " ", "part", " ", "and", " ", "the", " ", 
        "hole", " ", "part"}]}]}], ",", " ", 
     RowBox[{"times", " ", "the", " ", "plane", " ", "wave"}]}], " ", "*)"}], 
   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"as4Exact", "[", 
      RowBox[{"x0_", "?", "NumericQ"}], "]"}], " ", ":=", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"cp", " ", "=", " ", 
          RowBox[{
           RowBox[{"Cos", "[", 
            RowBox[{"as4E", " ", "x0"}], "]"}], " ", "-", " ", 
           RowBox[{"I", " ", 
            RowBox[{"(", 
             RowBox[{"as4X", "/", "as4E"}], ")"}], " ", 
            RowBox[{"Sin", "[", 
             RowBox[{"as4E", " ", "x0"}], "]"}]}]}]}], ",", " ", 
         RowBox[{"ch", " ", "=", " ", 
          RowBox[{
           RowBox[{"-", "I"}], " ", 
           RowBox[{"(", 
            RowBox[{"asBDelta", "/", "as4E"}], ")"}], " ", 
           RowBox[{"Sin", "[", 
            RowBox[{"as4E", " ", "x0"}], "]"}]}]}]}], "}"}], ",", "\n", "   ", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"phaseSite", " ", "=", " ", 
              RowBox[{"Exp", "[", 
               RowBox[{"I", " ", "as4Q", " ", "asBEll", " ", "site"}], 
               "]"}]}], "}"}], ",", " ", 
            RowBox[{"Join", "[", 
             RowBox[{
              RowBox[{"cp", " ", "phaseSite", " ", "as4Chi"}], ",", " ", 
              RowBox[{"ch", " ", "phaseSite", " ", "as4KChi"}]}], "]"}]}], 
           "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"site", ",", " ", "0", ",", " ", 
            RowBox[{"as4N", " ", "-", " ", "1"}]}], "}"}]}], "]"}], "]"}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", "101", " ", "output", " ", "times", " ", "0"}], ",", 
     " ", "0.2", ",", " ", "...", ",", " ", 
     RowBox[{"20", ";", " ", 
      RowBox[{
       RowBox[{
       "the", " ", "integration", " ", "by", " ", "IDA", " ", "with", " ", 
        "the", " ", "tolerances", " ", "of", " ", "AS"}], "-", "2"}]}]}], " ",
     "*)"}], "\n", 
   RowBox[{
    RowBox[{"as4Touts", " ", "=", " ", 
     RowBox[{"0.2", " ", 
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", " ", "100"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as4H", " ", "=", " ", 
     RowBox[{"t2dense", "[", 
      RowBox[{"as4Lat", ",", " ", "as4Fields"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as4Run", " ", "=", " ", 
     RowBox[{"t2evolveIDAChecked", "[", 
      RowBox[{"as4H", ",", " ", 
       RowBox[{"as4Exact", "[", "0.", "]"}], ",", " ", "as4Touts", ",", " ", 
       "as2Rtol", ",", " ", "as2Atol"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as4ExactStates", " ", "=", " ", 
     RowBox[{"Map", "[", 
      RowBox[{"as4Exact", ",", " ", "as4Touts"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as4Deviations", " ", "=", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"AssociationQ", "[", "as4Run", "]"}], ",", " ", 
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Norm", "[", 
           RowBox[{"#1", " ", "-", " ", "#2"}], "]"}], " ", "&"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"as4Run", "[", "\"\<states\>\"", "]"}], ",", " ", 
           "as4ExactStates"}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"{", "Infinity", "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as4Norm", " ", "=", " ", 
     RowBox[{"Norm", "[", 
      RowBox[{"as4Exact", "[", "0.", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"as4Dev", " ", "=", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"AssociationQ", "[", "as4Run", "]"}], ",", " ", 
       RowBox[{"Max", "[", 
        RowBox[{"as4Deviations", "/", 
         RowBox[{"Map", "[", 
          RowBox[{"Norm", ",", " ", "as4ExactStates"}], "]"}]}], "]"}], ",", 
       " ", "Infinity"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "the", " ", "probability", " ", "of", " ", "the", " ", "hole", " ", "of", 
     " ", "a", " ", 
     RowBox[{"state", ":", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
        "the", " ", "part", " ", "of", " ", "its", " ", "squared", " ", 
         "norm", " ", "in", " ", "the", " ", "hole", " ", "components", " ", 
         "9"}], ".."}], "16", " ", "of", " ", "every", " ", "site"}]}]}], " ",
     "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"as4Phole", "[", "w_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{"Partition", "[", 
            RowBox[{"w", ",", " ", "16"}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", 
             RowBox[{"9", " ", ";;", " ", "16"}]}], "]"}], "]"}], "]"}], 
         "]"}], "^", "2"}], "]"}], "/", 
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{"Abs", "[", "w", "]"}], "^", "2"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"the", " ", "rows", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x", "^", "0"}], ",", " ", 
       RowBox[{"P_hole", " ", "of", " ", "the", " ", "integration"}], ",", 
       " ", 
       RowBox[{"P_hole", " ", "exact"}]}], "}"}], " ", "of", " ", "Figure", " ",
      "4", 
     RowBox[{"(", "b", ")"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"as4RabiRows", " ", "=", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"AssociationQ", "[", "as4Run", "]"}], ",", "\n", "   ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"as4Touts", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
           RowBox[{"as4Phole", "[", 
            RowBox[{"as4Run", "[", 
             RowBox[{"[", 
              RowBox[{"\"\<states\>\"", ",", " ", "i"}], "]"}], "]"}], "]"}], 
           ",", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"asBDelta", "/", "as4E"}], ")"}], "^", "2"}], " ", 
            RowBox[{
             RowBox[{"Sin", "[", 
              RowBox[{"as4E", " ", 
               RowBox[{"as4Touts", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "^", "2"}]}]}], 
          "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", 
           RowBox[{"Length", "[", "as4Touts", "]"}]}], "}"}]}], "]"}], ",", 
       " ", 
       RowBox[{"{", "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"SL31Check", "[", 
    RowBox[{"\"\<AS-4\>\"", ",", 
     " ", "\"\<the particle-hole (Rabi) oscillation of a particle injected \
into the uniform polar superfluid (case B): on a periodic chain of 16 sites \
(dx = 0.5, r_W = 1, m = 0.4, mu = 0.6) with the pair field dvec = (0, 0, \
0.3), the positive-energy lattice plane wave chi_pw of isospin up at the \
momentum 2 pi/(16 dx) evolves as (cos(E^- x_LL^0) - i ((eps_lat - mu)/E^-) \
sin(E^- x_LL^0)) (chi_pw, 0) - i (Delta/E^-) sin(E^- x_LL^0) (0, Kch_3 \
chi_pw), with E^- = ((eps_lat - mu)^2 + Delta^2)^(1/2): the probability of \
the hole is P_hole = (Delta/E^-)^2 sin^2(E^- x_LL^0); the integration of the \
lattice equations by IDA (SUNDIALS, through NDSolve with Method -> \
\\\"IDA\\\", in place of CVODE of the original program; rtol = 1e-12, atol = \
1e-14) agrees with this exact solution at the 101 output times x_LL^0 = 0, \
0.2, ..., 20: (1) the relative deviation of the whole state stays below 1e-9, \
the tolerance of the original check; (2) the states at the output times are \
the cubic Hermite polynomials of the stored values and derivatives (tolerance \
1e-12), and the largest deviation is at most the bound that follows from the \
measured exact local errors of the internal steps, (1 + h_IDA E_max/4) (sum \
of local_error) + h_IDA deriv_residual/4 + (h_IDA E_max)^4/384 (norm of the \
state); the numbers of steps and of evaluations of IDA and the largest ratio \
local_error/budget_step, with budget_step = rtol (norm of the state) + atol \
sqrt(512), are stated\>\"", ",", "\n", "  ", 
     RowBox[{
      RowBox[{"AssociationQ", "[", "as4Run", "]"}], " ", "&&", " ", 
      RowBox[{"as4Dev", " ", "<", " ", "1*^-9"}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"as4Run", "[", "\"\<hermite\>\"", "]"}], " ", "<", " ", 
       "1*^-12"}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"Max", "[", "as4Deviations", "]"}], " ", "<=", " ", 
       RowBox[{"as4Run", "[", "\"\<bsum\>\"", "]"}]}]}], ",", "\n", "  ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"AssociationQ", "[", "as4Run", "]"}], ",", "\n", "   ", 
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<largest relative deviation \>\"", ",", " ", 
          RowBox[{"asSci", "[", "as4Dev", "]"}], ",", 
          " ", "\"\< <= bound/(norm of the state) \>\"", ",", " ", 
          RowBox[{"asSci", "[", 
           RowBox[{
            RowBox[{"as4Run", "[", "\"\<bsum\>\"", "]"}], "/", "as4Norm"}], 
           "]"}], ",", 
          " ", "\"\<; (sum of local_error)/(norm of the state) \>\"", ",", 
          " ", 
          RowBox[{"asSci", "[", 
           RowBox[{
            RowBox[{"as4Run", "[", "\"\<sumloc\>\"", "]"}], "/", "as4Norm"}], 
           "]"}], ",", "\n", 
          "     ", "\"\<; largest local_error/budget_step \>\"", ",", " ", 
          RowBox[{"asSci", "[", 
           RowBox[{"as4Run", "[", "\"\<ratio\>\"", "]"}], "]"}], ",", "\n", 
          "     ", "\"\<; IDA: N_steps \>\"", ",", " ", 
          RowBox[{"as4Run", "[", "\"\<steps\>\"", "]"}], ",", 
          " ", "\"\<, N_evals \>\"", ",", " ", 
          RowBox[{"as4Run", "[", "\"\<evaluations\>\"", "]"}], ",", 
          " ", "\"\<, largest h_IDA \>\"", ",", " ", 
          RowBox[{"asSci", "[", 
           RowBox[{"as4Run", "[", "\"\<hmax\>\"", "]"}], "]"}], ",", 
          " ", "\"\<, largest deriv_residual \>\"", ",", " ", 
          RowBox[{"asSci", "[", 
           RowBox[{"as4Run", "[", "\"\<residual\>\"", "]"}], "]"}], ",", "\n",
           "     ", "\"\<, Hermite polynomials within \>\"", ",", " ", 
          RowBox[{"asSci", "[", 
           RowBox[{"as4Run", "[", "\"\<hermite\>\"", "]"}], "]"}], ",", 
          " ", "\"\<, E_max \>\"", ",", " ", 
          RowBox[{"asFix", "[", 
           RowBox[{
            RowBox[{"as4Run", "[", "\"\<emax\>\"", "]"}], ",", " ", "4"}], 
           "]"}], ",", " ", "\"\<; eps_lat = \>\"", ",", " ", 
          RowBox[{"asFix", "[", 
           RowBox[{"as4Eps", ",", " ", "6"}], "]"}], ",", 
          " ", "\"\<, E^- = \>\"", ",", " ", 
          RowBox[{"asFix", "[", 
           RowBox[{"as4E", ",", " ", "6"}], "]"}], ",", "\n", 
          "     ", "\"\<, largest P_hole = (Delta/E^-)^2 = \>\"", ",", " ", 
          RowBox[{"asFix", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"asBDelta", "/", "as4E"}], ")"}], "^", "2"}], ",", " ", 
            "6"}], "]"}], ",", "\n", 
          "     ", "\"\< (original program, CVODE: largest relative deviation \
4.7e-10, 486 steps, 963 evaluations of the right side; eps_lat = 0.943799, \
E^- = 0.456287, largest P_hole = 0.432281)\>\""}], "}"}], "]"}], ",", "\n", 
       "   ", "\"\<the integration by IDA failed\>\""}], "]"}]}], 
    "]"}]}]}]], "Input",ExpressionUUID->"89992390-3caa-4950-beab-\
d943e8e5fea3"],

Cell[TextData[{
 StyleBox["The gap equation in closed form (check AS-5).",
  FontWeight->"Bold"],
 " The pair field of a stationary state must be the one that its own modes \
produce. For the uniform polar state this self-consistency condition is the \
gap equation: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "202969ae-102a-4248-8d94-cbf665594f4d"],
 " equals the integral of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "/", 
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "+"], "+", "1", "/", 
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "-"]}], ")"}], "\[ThinSpace]", 
    SuperscriptBox[
     StyleBox["d", "TI"], "3"], 
    SubscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "/", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"2", "\[Pi]"}], ")"}], "3"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "57881c1c-38a9-463e-a50f-ef9103fbe799"],
 " over the momenta with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "<", 
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "46f89a0c-dcd4-4275-a1d0-3c84a185c9ac"],
 " (check GS-9), with the coupling ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["G", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bcb68e12-b1a4-46b7-bfd8-6a1d50ee6949"],
 " of the contact interaction and the momentum cutoff ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalLambda]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a5b0b78c-4e8e-42f0-8e2a-d70c111ada2b"],
 ". For massless spinor charges (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bfe0791e-4b91-4b93-9f39-205f24506c69"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CurlyEpsilon]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "625648ab-83c7-4d10-b7c0-33a8bb84a912"],
 ") the integral can be done. The integrand depends only on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["q", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c2da174a-7e5f-400e-bbb5-b732a097bb80"],
 ", so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["d", "TI"], "3"], 
    SubscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "/", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"2", "\[Pi]"}], ")"}], "3"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "c7f1808d-e430-41a1-95de-350108d06763"],
 " becomes ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "2"], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "/", 
    RowBox[{"(", 
     RowBox[{"2", 
      SuperscriptBox["\[Pi]", "2"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d639659e-dee4-4fdd-bbf1-2448a857b349"],
 ", and one needs antiderivatives of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "2"], "/", 
    SubsuperscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[PlusMinus]"]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f9af5888-176c-4616-a1c0-a7976a20de4b"],
 ". They are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]], "\[MinusPlus]", "3", 
      SubscriptBox["\[Mu]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}], 
    SubsuperscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[PlusMinus]"], "+", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["\[Mu]", 
       StyleBox["LL",
        FontSlant->"Plain"], "2"], "-", 
      FractionBox["1", "2"], 
      SubsuperscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"], "2"]}], ")"}], "\[ThinSpace]", 
    StyleBox["arsinh",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SubscriptBox[
         StyleBox["q", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"]], "\[PlusMinus]", 
        SubscriptBox["\[Mu]", 
         StyleBox["LL",
          FontSlant->"Plain"]]}], ")"}], "/", 
      SubscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f0f504e7-e66d-4362-b524-3408776fd25a"],
 ", as differentiation shows: the derivative with respect to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["q", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "040aa65e-717a-435d-b18f-ccd7179c70d7"],
 ", multiplied by ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["LL",
     FontSlant->"Plain"], "\[PlusMinus]"], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8e743eed-4233-407c-b03a-19998f1138aa"],
 ", is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], 
    SuperscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "\[PlusMinus]"], ")"}], "2"], "+", 
    FractionBox["1", "2"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]], "\[MinusPlus]", "3", 
      SubscriptBox["\[Mu]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"]], "\[PlusMinus]", 
      SubscriptBox["\[Mu]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}], "+", 
    SubsuperscriptBox["\[Mu]", 
     StyleBox["LL",
      FontSlant->"Plain"], "2"], "-", 
    FractionBox["1", "2"], 
    SubsuperscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"], "2"], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2a6554f0-354b-4011-9eaf-93388b741c69"],
 ". At ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "db4c81be-43e9-451e-b392-9049375b0528"],
 " the two antiderivatives cancel each other (there ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "+"], "\[LongEqual]", 
    SubsuperscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "-"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a0dae546-7474-47e7-a833-c1b32dd29938"],
 ", and the function arsinh is odd), so the integral is the sum of the two \
antiderivatives at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "6a4e691e-1876-4966-8271-c4867862e625"],
 ", divided by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    SuperscriptBox["\[Pi]", "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "84e31d76-97f3-450a-8423-c892ba1c082d"],
 ". The gap equation is therefore (the sum has two terms, one with the upper \
signs and one with the lower signs)"
}], "Text",ExpressionUUID->"620e7038-056c-474b-8218-8f61bb1de093"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox["1", 
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]]], "\[LongEqual]", 
   FractionBox["1", 
    RowBox[{"4", 
     SuperscriptBox["\[Pi]", "2"]}]], "\[ThinSpace]", 
   UnderscriptBox["\[Sum]", "\[PlusMinus]",
    LimitsPositioning->True], 
   RowBox[{"[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[CapitalLambda]", 
        StyleBox["LL",
         FontSlant->"Plain"]], "\[MinusPlus]", "3", 
       SubscriptBox["\[Mu]", 
        StyleBox["LL",
         FontSlant->"Plain"]]}], ")"}], "\[ThinSpace]", 
     SubsuperscriptBox[
      StyleBox["E", "TI"], 
      StyleBox["LL",
       FontSlant->"Plain"], "\[PlusMinus]"], 
     RowBox[{"(", 
      SubscriptBox["\[CapitalLambda]", 
       StyleBox["LL",
        FontSlant->"Plain"]], ")"}], "+", 
     RowBox[{"(", 
      RowBox[{"2", 
       SubsuperscriptBox["\[Mu]", 
        StyleBox["LL",
         FontSlant->"Plain"], "2"], "-", 
       SubsuperscriptBox["\[CapitalDelta]", 
        StyleBox["LL",
         FontSlant->"Plain"], "2"]}], ")"}], "\[ThinSpace]", 
     StyleBox["arsinh",
      FontSlant->"Plain"], 
     FractionBox[
      RowBox[{
       SubscriptBox["\[CapitalLambda]", 
        StyleBox["LL",
         FontSlant->"Plain"]], "\[PlusMinus]", 
       SubscriptBox["\[Mu]", 
        StyleBox["LL",
         FontSlant->"Plain"]]}], 
      SubscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"]]]}], "]"}]}], TraditionalForm]], "DisplayFormula",\

 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"98f636a3-570d-4811-ab01-2b8051a4445c"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[PlusMinus]"], 
    RowBox[{"(", 
     SubscriptBox["\[CapitalLambda]", 
      StyleBox["LL",
       FontSlant->"Plain"]], ")"}], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["\[CapitalLambda]", 
           StyleBox["LL",
            FontSlant->"Plain"]], "\[PlusMinus]", 
          SubscriptBox["\[Mu]", 
           StyleBox["LL",
            FontSlant->"Plain"]]}], ")"}], "2"], "+", 
       SubsuperscriptBox["\[CapitalDelta]", 
        StyleBox["LL",
         FontSlant->"Plain"], "2"]}], ")"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b1e1e491-5b77-4702-962b-66cd39a052ea"],
 ". At ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Mu]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "eaac3cea-64c9-4efa-bcb8-2d2c31ac4ebe"],
 " the right side is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[CapitalLambda]", 
       StyleBox["LL",
        FontSlant->"Plain"]], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         SubsuperscriptBox["\[CapitalLambda]", 
          StyleBox["LL",
           FontSlant->"Plain"], "2"], "+", 
         SubsuperscriptBox["\[CapitalDelta]", 
          StyleBox["LL",
           FontSlant->"Plain"], "2"]}], ")"}], 
       RowBox[{"1", "/", "2"}]], "-", 
      SubsuperscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"], "2"], "\[ThinSpace]", 
      StyleBox["arsinh",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[CapitalLambda]", 
         StyleBox["LL",
          FontSlant->"Plain"]], "/", 
        SubscriptBox["\[CapitalDelta]", 
         StyleBox["LL",
          FontSlant->"Plain"]]}], ")"}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"2", 
      SuperscriptBox["\[Pi]", "2"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "18ae0345-8d39-4269-ad7b-2bad4793ac8e"],
 ", which decreases from ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"], "2"], "/", 
    RowBox[{"(", 
     RowBox[{"2", 
      SuperscriptBox["\[Pi]", "2"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8a42f955-e07d-4c3a-99eb-5a6b8257dc9a"],
 " as ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalDelta]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ca8ced35-8ac3-450e-90bb-72638ac35a6a"],
 " grows: at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Mu]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "21f62f30-9543-454d-9167-dd7c710f4615"],
 " a gap exists only above the critical coupling ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["crit",
      FontSlant->"Plain"]], "\[LongEqual]", "2", 
    SuperscriptBox["\[Pi]", "2"], "/", 
    SubsuperscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "0da27866-b486-4ea7-b0b9-0570dc94ed8b"],
 " (below it the vacuum stays normal, above it the vacuum itself condenses). \
For ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Mu]", 
     StyleBox["LL",
      FontSlant->"Plain"]], ">", "0"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "55a350a5-27ab-4b00-839c-19f69d06d617"],
 " the arsinh terms grow like ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["ln",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{"1", "/", 
      SubscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "52b566e8-815f-49e8-87a0-77a363e02883"],
 " as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[RightArrow]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "2f5256ae-c8b0-4f7a-978d-9694678a74a1"],
 ", with the coefficient ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    SubsuperscriptBox["\[Mu]", 
     StyleBox["LL",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "593a2006-45e1-4467-a782-ae608d5549be"],
 " (the Fermi surface), so a solution exists for every attractive coupling. \
With ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "\[PlusMinus]"], 
    RowBox[{"(", 
     SubscriptBox["\[CapitalLambda]", 
      StyleBox["LL",
       FontSlant->"Plain"]], ")"}], "\[RightArrow]", 
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[PlusMinus]", 
    SubscriptBox["\[Mu]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dab1b27f-5607-4705-944e-cdb82aa7b458"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["arsinh",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[CapitalLambda]", 
         StyleBox["LL",
          FontSlant->"Plain"]], "\[PlusMinus]", 
        SubscriptBox["\[Mu]", 
         StyleBox["LL",
          FontSlant->"Plain"]]}], ")"}], "/", 
      SubscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}], "\[RightArrow]", 
    StyleBox["ln",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{"2", 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[CapitalLambda]", 
         StyleBox["LL",
          FontSlant->"Plain"]], "\[PlusMinus]", 
        SubscriptBox["\[Mu]", 
         StyleBox["LL",
          FontSlant->"Plain"]]}], ")"}], "/", 
      SubscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3c9e0f6d-22a3-4829-b229-1dd21bc5cf34"],
 " the gap equation becomes ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["\[CapitalLambda]", 
       StyleBox["LL",
        FontSlant->"Plain"], "2"], "-", "3", 
      SubsuperscriptBox["\[Mu]", 
       StyleBox["LL",
        FontSlant->"Plain"], "2"], "+", 
      SubsuperscriptBox["\[Mu]", 
       StyleBox["LL",
        FontSlant->"Plain"], "2"], "\[ThinSpace]", 
      StyleBox["ln",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       RowBox[{"4", 
        RowBox[{"(", 
         RowBox[{
          SubsuperscriptBox["\[CapitalLambda]", 
           StyleBox["LL",
            FontSlant->"Plain"], "2"], "-", 
          SubsuperscriptBox["\[Mu]", 
           StyleBox["LL",
            FontSlant->"Plain"], "2"]}], ")"}], "/", 
        SubsuperscriptBox["\[CapitalDelta]", 
         StyleBox["LL",
          FontSlant->"Plain"], "2"]}], ")"}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"2", 
      SuperscriptBox["\[Pi]", "2"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a1c4bba0-4e8e-4f7f-b070-f07677f05ab3"],
 ", whose solution is the weak-coupling gap of the theory of Bardeen, Cooper \
and Schrieffer (BCS),"
}], "Text",ExpressionUUID->"43129657-c82a-4925-9802-a55e84150297"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[CapitalDelta]", 
    StyleBox["LL",
     FontSlant->"Plain"]], "\[LongEqual]", "2", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["\[CapitalLambda]", 
       StyleBox["LL",
        FontSlant->"Plain"], "2"], "-", 
      SubsuperscriptBox["\[Mu]", 
       StyleBox["LL",
        FontSlant->"Plain"], "2"]}], ")"}], 
    RowBox[{"1", "/", "2"}]], "\[ThinSpace]", 
   StyleBox["exp",
    FontSlant->"Plain"], 
   RowBox[{"(", 
    RowBox[{"-", 
     FractionBox["3", "2"]}], ")"}], "\[ThinSpace]", 
   StyleBox["exp",
    FontSlant->"Plain"], 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       SuperscriptBox["\[Pi]", "2"], 
       SubsuperscriptBox["\[Mu]", 
        StyleBox["LL",
         FontSlant->"Plain"], "2"]]}], 
     RowBox[{"(", 
      RowBox[{
       FractionBox["1", 
        SubscriptBox[
         StyleBox["G", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"]]], "-", 
       FractionBox["1", 
        SubsuperscriptBox[
         StyleBox["G", "TI"], 
         StyleBox["LL",
          FontSlant->"Plain"], 
         StyleBox["crit",
          FontSlant->"Plain"]]]}], ")"}]}], ")"}]}], 
  TraditionalForm]], "DisplayFormula",
 FontFamily->"Times",
 FontSize->1.25 
  Inherited,ExpressionUUID->"aa370571-8a14-4883-a31e-92f332b5b500"],

Cell[TextData[{
 "which is exponentially small in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "70b70265-e084-43a4-8e40-b7b482bab28d"],
 ". The terms neglected in this limit are of the order ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"], "2"], "\[ThinSpace]", 
    StyleBox["ln",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[CapitalLambda]", 
       StyleBox["LL",
        FontSlant->"Plain"]], "/", 
      SubscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bae63e3f-1c47-49fe-9896-09838efd6a54"],
 "; carried through the solution, they give the BCS form a relative error of \
the size ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"], "2"], "/", 
      RowBox[{"(", 
       RowBox[{"2", 
        SubsuperscriptBox["\[Mu]", 
         StyleBox["LL",
          FontSlant->"Plain"], "2"]}], ")"}]}], ")"}], "\[ThinSpace]", 
    StyleBox["ln",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[CapitalLambda]", 
       StyleBox["LL",
        FontSlant->"Plain"]], "/", 
      SubscriptBox["\[CapitalDelta]", 
       StyleBox["LL",
        FontSlant->"Plain"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7bd827a7-f6c2-46f9-b315-1811abab0b50"],
 ". Check AS-5 has four parts, all with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalLambda]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "f2115847-a86b-4b23-a085-38a34acd05c0"],
 ": (1) the closed form against a numerical quadrature of the integral, for \
six pairs of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Mu]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "49bef2e0-436e-449d-8968-e7c080282b37"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalDelta]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b646de55-7462-4a22-9266-8896e5d9a8ec"],
 "; (2) the critical coupling; (3) the gaps that the closed form gives by \
bisection, inserted in the integral computed by quadrature, for the three \
chemical potentials ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Mu]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0", ",", "0.3", ",", "0.6"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "ec019549-9b18-46f3-9c9d-dc1841f5bfb9"],
 " and the four couplings ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "/", 
    SubsuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["crit",
      FontSlant->"Plain"]], "\[LongEqual]", "0.6", ",", "1.2", ",", "1.8", ",",
     "2.4"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "621018ad-b9ff-48fa-95f0-9a0b8c2acf1d"],
 " (of these twelve cases eleven have a gap; at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Mu]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "3c6b4030-625e-4eda-8047-376724166c5b"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.6", "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["crit",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "8503aeb0-4bd2-4074-aa4a-e470c23f424f"],
 " there is none); (4) the BCS form at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Mu]", 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", "0.3"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b041e498-6fb7-405d-8b99-be398067e53c"],
 ", whose relative deviation must be smaller than twice the size of the \
leading correction. The quadrature is the Gauss-Legendre rule with 32 nodes \
on every panel of a division of the interval from 0 to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalLambda]", 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "4718909a-2318-4b8f-9165-5f0ed59a5a8c"],
 ". The function ",
 StyleBox["t2gaussLegendre",
  FontFamily->"Source Code Pro"],
 " computes the nodes, which are the zeros of the Legendre polynomial of the \
degree 32, by Newton's method, and their weights; with them the rule is exact \
for every polynomial up to the degree 63. The panels are 64 equal ones, \
refined towards the Fermi momentum ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["k", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["F",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SubscriptBox["\[Mu]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "dff3e426-c0d5-4648-a258-37d2b2230ca5"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SubsuperscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "-"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "b9428a67-450f-4a66-9254-52bb41c40c51"],
 " has its sharp maximum ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["LL",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a4bead07-3c62-4579-a17b-f5167ff4af4c"],
 " (function ",
 StyleBox["t2gapIntegralQuad",
  FontFamily->"Source Code Pro"],
 "). Figure 4(c) shows the gap as a function of the coupling."
}], "Text",ExpressionUUID->"05ac766f-4faa-4e2d-ae1d-a6dfe8022319"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"the", " ", "Gauss"}], "-", 
      RowBox[{"Legendre", " ", "nodes", " ", "and", " ", "weights", " ", 
       RowBox[{"on", " ", "[", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "1"}], "]"}]}]}], ":", " ", 
     RowBox[{
      RowBox[{"Newton", "'"}], "s", " ", "method", " ", "on", " ", "the", " ",
       "Legendre", " ", "polynomial", " ", "of", " ", "the", " ", "degree", " ",
       "nodes"}]}], ",", "\n", "   ", 
    RowBox[{
     RowBox[{
     "which", " ", "is", " ", "computed", " ", "with", " ", "its", " ", 
      "three"}], "-", 
     RowBox[{"term", " ", "recurrence", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{
         "leg0", " ", "is", " ", "the", " ", "polynomial", " ", "of", " ", 
          "the", " ", "degree", " ", "j"}], " ", "+", " ", "1"}], ",", " ", 
        RowBox[{"leg1", " ", "of", " ", "the", " ", "degree", " ", "j"}]}], 
       ")"}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"t2gaussLegendre", "[", "nodes_Integer", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"nodeX", " ", "=", " ", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0.", ",", " ", "nodes"}], "]"}]}], ",", " ", 
         RowBox[{"nodeW", " ", "=", " ", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0.", ",", " ", "nodes"}], "]"}]}], ",", " ", "z", ",", 
         " ", "zOld", ",", " ", "leg0", ",", " ", "leg1", ",", " ", "leg2", ",",
          " ", "deriv"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"Do", "[", "\n", "    ", 
         RowBox[{
          RowBox[{
           RowBox[{"z", " ", "=", " ", 
            RowBox[{"Cos", "[", 
             RowBox[{"Pi", " ", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"i", " ", "+", " ", "0.75"}], ")"}], "/", 
               RowBox[{"(", 
                RowBox[{"nodes", " ", "+", " ", "0.5"}], ")"}]}]}], "]"}]}], ";",
            "\n", "    ", 
           RowBox[{"Do", "[", "\n", "     ", 
            RowBox[{
             RowBox[{
              RowBox[{"leg0", " ", "=", " ", "1."}], ";", " ", 
              RowBox[{"leg1", " ", "=", " ", "0."}], ";", "\n", "     ", 
              RowBox[{"Do", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"leg2", " ", "=", " ", "leg1"}], ";", " ", 
                 RowBox[{"leg1", " ", "=", " ", "leg0"}], ";", " ", 
                 RowBox[{"leg0", " ", "=", " ", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"2.", " ", "j"}], " ", "+", " ", "1."}], ")"}], " ",
                     "z", " ", "leg1"}], " ", "-", " ", 
                    RowBox[{"j", " ", "leg2"}]}], ")"}], "/", 
                   RowBox[{"(", 
                    RowBox[{"j", " ", "+", " ", "1."}], ")"}]}]}]}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"j", ",", " ", "0", ",", " ", 
                  RowBox[{"nodes", " ", "-", " ", "1"}]}], "}"}]}], "]"}], ";",
               "\n", "     ", 
              RowBox[{"deriv", " ", "=", " ", 
               RowBox[{"nodes", " ", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"z", " ", "leg0"}], " ", "-", " ", "leg1"}], ")"}],
                  "/", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"z", " ", "z"}], " ", "-", " ", "1."}], 
                  ")"}]}]}]}], ";", "\n", "     ", 
              RowBox[{"zOld", " ", "=", " ", "z"}], ";", "\n", "     ", 
              RowBox[{"z", " ", "=", " ", 
               RowBox[{"zOld", " ", "-", " ", 
                RowBox[{"leg0", "/", "deriv"}]}]}], ";", "\n", "     ", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Abs", "[", 
                  RowBox[{"z", " ", "-", " ", "zOld"}], "]"}], " ", "<", " ", 
                 "1.*^-15"}], ",", " ", 
                RowBox[{"Break", "[", "]"}]}], "]"}]}], ",", "\n", "     ", 
             RowBox[{"{", "100", "}"}]}], "]"}], ";", "\n", "    ", 
           RowBox[{"(*", " ", 
            RowBox[{
             RowBox[{
             "the", " ", "derivative", " ", "at", " ", "the", " ", 
              "converged", " ", "node"}], ",", " ", 
             RowBox[{"for", " ", "the", " ", "weight"}]}], " ", "*)"}], "\n", 
           "    ", 
           RowBox[{"leg0", " ", "=", " ", "1."}], ";", " ", 
           RowBox[{"leg1", " ", "=", " ", "0."}], ";", "\n", "    ", 
           RowBox[{"Do", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"leg2", " ", "=", " ", "leg1"}], ";", " ", 
              RowBox[{"leg1", " ", "=", " ", "leg0"}], ";", " ", 
              RowBox[{"leg0", " ", "=", " ", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"2.", " ", "j"}], " ", "+", " ", "1."}], ")"}], " ",
                    "z", " ", "leg1"}], " ", "-", " ", 
                  RowBox[{"j", " ", "leg2"}]}], ")"}], "/", 
                RowBox[{"(", 
                 RowBox[{"j", " ", "+", " ", "1."}], ")"}]}]}]}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"j", ",", " ", "0", ",", " ", 
               RowBox[{"nodes", " ", "-", " ", "1"}]}], "}"}]}], "]"}], ";", 
           "\n", "    ", 
           RowBox[{"deriv", " ", "=", " ", 
            RowBox[{"nodes", " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
