          RowBox[{"psiAt", "[", "x", "]"}]}], ";", "\n", "   ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"p", " ", "==", " ", "q"}], ",", " ", 
              RowBox[{"Continue", "[", "]"}]}], "]"}], ";", "\n", "    ", 
            RowBox[{"Module", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
               "nq", ",", " ", "np", ",", " ", "npq", ",", " ", "nqp", ",", 
                " ", "lhs", ",", " ", "dgq", ",", " ", "dgp", ",", " ", "rr", 
                ",", " ", "ap", ",", " ", "aq", ",", " ", "fv", ",", " ", 
                "ff", ",", " ", "curv", ",", " ", "rhs"}], "}"}], ",", "\n", 
              "     ", 
              RowBox[{
               RowBox[{
