       RowBox[{"-", 
        RowBox[{"xi", "[", 
         RowBox[{"[", "3", "]"}], "]"}]}], ",", " ", 
       RowBox[{"-", 
        RowBox[{"xi", "[", 
         RowBox[{"[", "4", "]"}], "]"}]}]}], "}"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"the", " ", "canonical", " ", "frame", " ", "of", " ", 
