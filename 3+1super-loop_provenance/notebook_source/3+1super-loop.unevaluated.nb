      RowBox[{
       RowBox[{"t2cconj", " ", ".", " ", "t2gammaCh"}], ",", " ", 
       RowBox[{"t2eps2", " ", ".", " ", 
        RowBox[{"t2sigma", "[", "i", "]"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2kpairPs", "[", "i_Integer", "]"}], " ", ":=", " ", 
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{"t2cconj", ",", " ", 
       RowBox[{"t2eps2", " ", ".", " ", 
        RowBox[{"t2sigma", "[", "i", "]"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"the", " ", "pair", " ", "potential", " ", "P_LL"}], " ", "=", 
     " ", 
     RowBox[{"sum_iota", " ", 
      RowBox[{"d", "^", "iota"}], " ", 
      RowBox[{"Kch_iota", "^", "dag"}], " ", 
      RowBox[{"(", 
       RowBox[{"8", " ", "x", " ", "8"}], ")"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2pairPotential", "[", "d_List", "]"}], " ", ":=", " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"d", "[", 
         RowBox[{"[", "i", "]"}], "]"}], " ", 
        RowBox[{"ConjugateTranspose", "[", 
         RowBox[{"t2kpair", "[", "i", "]"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"a", " ", "random", " ", "unit", " ", "bi"}], "-", 
       RowBox[{
       "quaternion", " ", "as", " ", "its", " ", "matrix", " ", "in", " ", 
        "SL", 
        RowBox[{"(", 
         RowBox[{"2", ",", "C"}], ")"}]}]}], ":", " ", 
      RowBox[{"four", " ", "random", " ", "complex", " ", "entries"}]}], ",", 
     " ", 
     RowBox[{
      RowBox[{"accepted", " ", "if"}], "\n", "   ", "|", "det", "|", " ", 
      RowBox[{">", " ", "0.1"}]}], ",", " ", 
     RowBox[{
     "then", " ", "divided", " ", "by", " ", "the", " ", "square", " ", 
      "root", " ", "of", " ", "the", " ", "determinant"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2randSL2C", "[", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "d"}], "}"}], ",", "\n", "   ", 
       RowBox[{"While", "[", 
        RowBox[{"True", ",", "\n", "    ", 
         RowBox[{
          RowBox[{"m", " ", "=", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"t2UnitC", "[", "]"}], ",", " ", 
               RowBox[{"t2UnitC", "[", "]"}]}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"t2UnitC", "[", "]"}], ",", " ", 
               RowBox[{"t2UnitC", "[", "]"}]}], "}"}]}], "}"}]}], ";", "\n", 
          "    ", 
          RowBox[{"d", " ", "=", " ", 
           RowBox[{"t2det2", "[", "m", "]"}]}], ";", "\n", "    ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", "d", "]"}], " ", ">", " ", "0.1"}], ",", " ", 
            RowBox[{"Return", "[", 
             RowBox[{
              RowBox[{"m", " ", 
               RowBox[{"(", 
                RowBox[{"1", "/", 
                 RowBox[{"t2csqrt", "[", "d", "]"}]}], ")"}]}], ",", " ", 
              "Module"}], "]"}]}], "]"}]}]}], "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"the", " ", "SU", 
     RowBox[{"(", "2", ")"}], " ", "matrix", " ", "exp", 
     RowBox[{"(", 
      RowBox[{"i", " ", "sum_iota", " ", "th_iota", " ", 
       RowBox[{"tau_iota", "/", "2"}]}], ")"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2su2", "[", "th_List", "]"}], " ", ":=", " ", 
     RowBox[{"t2expm", "[", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{"I", " ", 
         RowBox[{
          RowBox[{"th", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "/", "2"}], " ", 
         RowBox[{"t2sigma", "[", "i", "]"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", "3"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"the", " ", "rotation", " ", "R", 
       RowBox[{"(", "U", ")"}]}], ":", " ", 
      RowBox[{"U", " ", "tau_iota", " ", 
       RowBox[{"U", "^", "dag"}]}]}], " ", "=", " ", 
     RowBox[{"sum_kappa", " ", "tau_kappa", " ", 
      RowBox[{
       RowBox[{"R", "[", "kappa", "]"}], "[", "iota", "]"}]}]}], " ", "*)"}], 
   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2adjoint", "[", "u_", "]"}], " ", ":=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Re", "[", 
         RowBox[{"Tr", "[", 
          RowBox[{
           RowBox[{"t2sigma", "[", "k", "]"}], " ", ".", " ", "u", " ", ".", 
           " ", 
           RowBox[{"t2sigma", "[", "i", "]"}], " ", ".", " ", 
           RowBox[{"ConjugateTranspose", "[", "u", "]"}]}], "]"}], "]"}], "/",
         "2"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"the", " ", "Levi"}], "-", 
      RowBox[{
      "Civita", " ", "symbol", " ", "for", " ", "indices", " ", "1"}]}], ",", 
     " ", "2", ",", " ", 
     RowBox[{
      RowBox[{"3", " ", "and", " ", "the", " ", "metric", " ", "diag", 
       RowBox[{"(", 
        RowBox[{"1", ",", " ", 
         RowBox[{"-", "1"}], ",", " ", 
         RowBox[{"-", "1"}], ",", " ", 
         RowBox[{"-", "1"}]}], ")"}], " ", "for", " ", "p"}], " ", "=", " ", 
      RowBox[{
       RowBox[{"0", ".."}], "3"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2eps3", "[", 
      RowBox[{"i_", ",", " ", "j_", ",", " ", "k_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Signature", "[", 
      RowBox[{"{", 
       RowBox[{"i", ",", " ", "j", ",", " ", "k"}], "}"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2eta", "[", "p_", "]"}], " ", ":=", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"p", " ", "==", " ", "0"}], ",", " ", "1", ",", " ", 
       RowBox[{"-", "1"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"the", " ", "bi"}], "-", 
       RowBox[{"quaternion", " ", "b", " ", "with", " ", "M_LL", 
        RowBox[{"(", "b", ")"}]}]}], " ", "=", " ", "m"}], ",", " ", 
     RowBox[{
      RowBox[{
      "and", " ", "the", " ", "product", " ", "and", " ", "the", " ", 
       "conjugations", " ", "of", " ", "bi"}], "-", "quaternions"}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2bqFrom", "[", "m_", "]"}], " ", ":=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"m", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], " ", "+", " ", 
          RowBox[{"m", "[", 
           RowBox[{"[", 
            RowBox[{"2", ",", " ", "2"}], "]"}], "]"}]}], ")"}], "/", "2"}], ",",
        " ", 
       RowBox[{"I", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"m", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", " ", "2"}], "]"}], "]"}], " ", "+", " ", 
           RowBox[{"m", "[", 
            RowBox[{"[", 
             RowBox[{"2", ",", " ", "1"}], "]"}], "]"}]}], ")"}], "/", 
         "2"}]}], ",", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"m", "[", 
           RowBox[{"[", 
            RowBox[{"2", ",", " ", "1"}], "]"}], "]"}], " ", "-", " ", 
          RowBox[{"m", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", " ", "2"}], "]"}], "]"}]}], ")"}], "/", "2"}], ",",
        " ", 
       RowBox[{"I", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"m", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], " ", "-", " ", 
           RowBox[{"m", "[", 
            RowBox[{"[", 
             RowBox[{"2", ",", " ", "2"}], "]"}], "]"}]}], ")"}], "/", 
         "2"}]}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2bqMul", "[", 
      RowBox[{"x_", ",", " ", "y_"}], "]"}], " ", ":=", " ", 
     RowBox[{"t2bqFrom", "[", 
      RowBox[{
       RowBox[{"t2mq", "[", "x", "]"}], " ", ".", " ", 
       RowBox[{"t2mq", "[", "y", "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2bqStar", "[", "x_", "]"}], " ", ":=", " ", 
     RowBox[{"Conjugate", "[", "x", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2bqDag", "[", "x_", "]"}], " ", ":=", " ", 
     RowBox[{"Conjugate", "[", 
      RowBox[{"t2bqConj", "[", "x", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "Weyl", " ", "isodoublet", " ", "of", " ", "a", " ", 
      "spinor", " ", "charge", " ", "y", " ", 
      RowBox[{"e4", ":", " ", 
       RowBox[{
        RowBox[{"psi", "'"}], 
        RowBox[{"(", "y", ")"}]}]}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"eps2", "^", 
       RowBox[{"-", "1"}]}], " ", "M_LL", 
      RowBox[{
       RowBox[{"(", "y", ")"}], "^", "T"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"rows", ":", " ", 
         RowBox[{"Weyl", " ", "index"}]}], ",", " ", 
        RowBox[{"columns", ":", " ", "isospin"}]}], ")"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2psiPrime", "[", "y_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"t2inv2", "[", "t2eps2", "]"}], " ", ".", " ", 
      RowBox[{"Transpose", "[", 
       RowBox[{"t2mq", "[", "y", "]"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "Dirac", " ", "isodoublet", " ", "of", " ", "two", " ", 
      "spinor", " ", 
      RowBox[{"charges", ":", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"components", " ", "1"}], ".."}], "4", " ", "are", " ", 
        "the", " ", "rows", " ", "of", " ", 
        RowBox[{"psi", "'"}], 
        RowBox[{"(", "y", ")"}]}]}]}], ",", " ", 
     RowBox[{
      RowBox[{"5", ".."}], "8", " ", "those", " ", "of", " ", 
      RowBox[{"psi", "'"}], 
      RowBox[{"(", "b", ")"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2diracFromCharges", "[", 
      RowBox[{"y_", ",", " ", "b_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{"t2psiPrime", "[", "y", "]"}], "]"}], ",", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{"t2psiPrime", "[", "b", "]"}], "]"}]}], "]"}]}], ";"}], "\n", 
   
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"the", " ", "Cayley"}], "-", 
      RowBox[{"Dickson", " ", "product", " ", 
       RowBox[{"(", 
        RowBox[{"a", " ", "+", " ", 
         RowBox[{"b", " ", "e4"}]}], ")"}], 
       RowBox[{"(", 
        RowBox[{"c", " ", "+", " ", 
         RowBox[{"d", " ", "e4"}]}], ")"}]}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"a", " ", "c"}], " ", "-", " ", 
        RowBox[{"conj", 
         RowBox[{"(", "d", ")"}], " ", "b"}]}], ")"}], " ", "+", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"d", " ", "a"}], " ", "+", " ", 
         RowBox[{"b", " ", "conj", 
          RowBox[{"(", "c", ")"}]}]}], ")"}], " ", "e4"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"t2bioctMul", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a_", ",", " ", "b_"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"cq_", ",", " ", "d_"}], "}"}]}], "]"}], " ", ":=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"t2bqMul", "[", 
         RowBox[{"a", ",", " ", "cq"}], "]"}], " ", "-", " ", 
        RowBox[{"t2bqMul", "[", 
         RowBox[{
          RowBox[{"t2bqConj", "[", "d", "]"}], ",", " ", "b"}], "]"}]}], ",", 
       " ", 
       RowBox[{
        RowBox[{"t2bqMul", "[", 
         RowBox[{"d", ",", " ", "a"}], "]"}], " ", "+", " ", 
        RowBox[{"t2bqMul", "[", 
         RowBox[{"b", ",", " ", 
          RowBox[{"t2bqConj", "[", "cq", "]"}]}], "]"}]}]}], "}"}]}], 
    ";"}]}]}]], "Input",ExpressionUUID->"d9dd3f1c-cf66-4a71-b2c9-\
6fd2f2c1e328"],

Cell["\<\
The basic matrices, labelled with their registered symbols (they are exact: \
integers and the imaginary unit):\
\>", "Text",ExpressionUUID->"fd6ec922-1f22-4a97-8aa3-d153bcefd7d1"],

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"{", "\n", "   ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SubsuperscriptBox["\[Sigma]", "0", "LL"], ",", " ", 
       RowBox[{"MatrixForm", "[", 
        RowBox[{"t2sigma", "[", "0", "]"}], "]"}], ",", " ", 
       SubsuperscriptBox["\[Sigma]", "1", "LL"], ",", " ", 
       RowBox[{"MatrixForm", "[", 
        RowBox[{"t2sigma", "[", "1", "]"}], "]"}], ",", "\n", "    ", 
       SubsuperscriptBox["\[Sigma]", "2", "LL"], ",", " ", 
       RowBox[{"MatrixForm", "[", 
        RowBox[{"t2sigma", "[", "2", "]"}], "]"}], ",", " ", 
       SubsuperscriptBox["\[Sigma]", "3", "LL"], ",", " ", 
       RowBox[{"MatrixForm", "[", 
        RowBox[{"t2sigma", "[", "3", "]"}], "]"}]}], "}"}], ",", "\n", "   ", 
     
     RowBox[{"{", 
      RowBox[{
       SubsuperscriptBox["\[Gamma]", "LL", "0"], ",", " ", 
       RowBox[{"MatrixForm", "[", 
        RowBox[{"t2gamma", "[", "0", "]"}], "]"}], ",", " ", 
       SubsuperscriptBox["\[Gamma]", "LL", "1"], ",", " ", 
       RowBox[{"MatrixForm", "[", 
        RowBox[{"t2gamma", "[", "1", "]"}], "]"}], ",", "\n", "    ", 
       SubsuperscriptBox["\[Gamma]", "LL", "2"], ",", " ", 
       RowBox[{"MatrixForm", "[", 
        RowBox[{"t2gamma", "[", "2", "]"}], "]"}], ",", " ", 
       SubsuperscriptBox["\[Gamma]", "LL", "3"], ",", " ", 
       RowBox[{"MatrixForm", "[", 
        RowBox[{"t2gamma", "[", "3", "]"}], "]"}]}], "}"}], ",", "\n", "   ", 
     
     RowBox[{"{", 
      RowBox[{
       SubsuperscriptBox["\[Gamma]", "LL", "ch"], ",", " ", 
       RowBox[{"MatrixForm", "[", "t2gammaCh", "]"}], ",", " ", 
       SubscriptBox["C", "LL"], ",", " ", 
       RowBox[{"MatrixForm", "[", "t2cconj", "]"}], ",", "\n", "    ", 
       SubscriptBox["\[Beta]", "LL"], ",", " ", 
       RowBox[{"MatrixForm", "[", "t2beta", "]"}], ",", " ", 
       SubscriptBox[
        TagBox[
         StyleBox["E",
          FontFamily->"Helvetica",
          FontSlant->"Plain"],
         "SL31SansSerif"], "LL"], ",", " ", 
       RowBox[{"MatrixForm", "[", "t2eps2", "]"}]}], "}"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"Spacings", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2"}], "}"}]}], ",", " ", 
   RowBox[{"Alignment", " ", "->", " ", "Center"}]}], "]"}]], "Input",Expressi\
onUUID->"bce02321-bbb5-4758-a261-5aaecec3fc16"],

Cell["II.1.4 The lattice operator (t2core/src/lattice.rs)", "Subsection",ExpressionUUID->"ed344d37-dc21-4852-b926-63724fc42fdc"],

Cell[TextData[{
 "The solvers discretize space on a lattice of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["x",
      FontSlant->"Plain"]], "\[Times]", 
    SubsuperscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["y",
      FontSlant->"Plain"]], "\[Times]", 
    SubsuperscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["z",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "d4c69202-99cc-4cb8-8639-ad13011812f3"],
 " sites with the spacing ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[ScriptL]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["x",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "7e3f7e79-af37-4b1c-922e-5735a1b66a9d"],
 " (called ell in the code). A site ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["s", "TI"], "\[RightVector]"], 
     StyleBox["LL",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["s", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "1"], ",", 
      SubsuperscriptBox[
       StyleBox["s", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "2"], ",", 
      SubsuperscriptBox[
       StyleBox["s", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "a5e1c644-30ba-41b9-84a3-91c002c10d33"],
 " has integer coordinates counted from 0, and the code gives it the number \
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["s", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], "1"], "+", 
    SubsuperscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["LL",
      FontSlant->"Plain"], 
     StyleBox["x",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["s", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "2"], "+", 
      SubsuperscriptBox[
       StyleBox["n", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], 
       StyleBox["y",
        FontSlant->"Plain"]], 
      SubsuperscriptBox[
       StyleBox["s", "TI"], 
       StyleBox["LL",
        FontSlant->"Plain"], "3"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "5c6563f1-9549-4a6f-9257-e823b0e956a1"],
 "; ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    OverscriptBox["\[Delta]", "\[RightVector]"], 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "591f7503-faca-402c-974d-5ec174f40677"],
 " is the step to the next site in the direction ",
 Cell[BoxData[
  FormBox[
   StyleBox["j", "TI"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "efffdd01-db80-4510-96f8-df4a4ac957ed"],
 ". On every site a mode has 16 complex components: the particle part ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Psi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["p",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "bfb596eb-ce08-4398-b4a3-4d362b723372"],
 " (8 components) and the hole part ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Psi]", 
    StyleBox["LL",
     FontSlant->"Plain"], 
    StyleBox["h",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
  "e2367a32-61d9-4289-a5af-e84afb92368b"],
 " (8). The gauge fields live on the links: the link from ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox[
     StyleBox["s", "TI"], "\[RightVector]"], 
    StyleBox["LL",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",
  FontSize->1.1 Inherited,ExpressionUUID->
